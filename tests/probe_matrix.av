// The metamorphic probe matrix (learned from
// Valk's tests/probe/gen.py). Each static rule of the checker comes
// as a pair: an unsafe program (the compiler must refuse it, with
// the rule's words) and its safe twin (the compiler must accept
// it). The marked statement or expression of both is rewritten
// under every syntactic wrapper below, each program is checked by
// `avant dump` (the whole front end, the lowering and the MIR
// verifier; no link), and each verdict is one row of a table:
//
//   AVANT_COMPILER=./bin/avant-c-llvm ./bin/avant-c-llvm run tests/probe_matrix.av
//
// writes tests/probe/matrix.txt (bless it only after reading its diff);
// with an argument (`... run tests/probe_matrix.av -- OUT`) it writes OUT,
// which tests/cases/test_probe_matrix.av compares with the checked-in
// table row by row. A row's class is `ok` (the verdict the pair asks
// for), `hole` (an unsafe program accepted), `refused` (a safe program
// rejected) or `other` (an unsafe program rejected for another reason
// than the rule's). A row that is not `ok` is a finding, to be reported
// by whoever blessed it.
//
// A new rule joins by adding one `rule(...)` below: its name, its kind
// (`stmt`: the marked text is a statement; `expr`: an expression of the
// type it names), the site (a program with `@` where the wrapped text
// goes), the unsafe and the safe text, the words of the rule's error, and
// the site of the safe twin when the twin differs by its site rather
// than by its text.

import std.fs
import std.process

lib probe_rt {
  fun avant_tmp_dir: String
}

class PRule {
  pub name: String = ""
  pub kind: String = ""
  pub ty: String = ""
  pub site: String = ""
  pub safe_site: String = ""
  pub unsafe_text: String = ""
  pub safe_text: String = ""
  pub needle: String = ""
}

fn rule(name: String, kind: String, ty: String, site: String, safe_site: String, unsafe_text: String, safe_text: String, needle: String): PRule {
  r = PRule.new()
  r.name = name
  r.kind = kind
  r.ty = ty
  r.site = site
  r.safe_site = safe_site
  if safe_site.size == 0 {
    r.safe_site = site
  }
  r.unsafe_text = unsafe_text
  r.safe_text = safe_text
  r.needle = needle
  r
}

// The declarations every program shares: an error type and a function
// that can fail (the README's parse_age), and opaque values for the
// wrappers' conditions.
fn prelude_decls: String {
  "class ParseError: Error {\n  message: String\n\n  fn initialize(message: String) {\n    self.message = message\n  }\n}\n\nfn parse_age(s: String): Int | ParseError {\n  n = s.to_i() ?? return ParseError.new(\"not a number: \${s}\")\n  n\n}\n\nfn probe_cond: Bool {\n  process.args().size > 0\n}\n\nfn probe_k: Int {\n  process.args().size\n}\n\nfn probe_maybe: Int? {\n  if process.args().size > 0 {\n    return 1\n  }\n  nil\n}\n"
}

// The rules the README states that one program pair
// can show. Left out for now: the never-read locals
// and the walk's mutation rules (not built yet).
//
// A rule whose programs need the task runtime (`spawn`, `.parallel`,
// `std.sync`) is written as any other: its site
// declares what the task needs (the import, the class, the values it
// captures), and its marked text starts the task and joins it (a `spawn`
// block ends with an Int, its handle is joined), so each wrapper wraps the
// whole task. The matrix checks with `avant dump`, which never links or
// runs a program, so a static rule needs no runtime at all; a rule that
// shows only when the program runs (a trap, such as `.join` reached from a
// pool worker through a call) is a test case, not a row
// (tests/cases/test_safety.av, test_threads_llvm.av).
//
// Wrappers: a statement under `if`, `else`, a `switch` arm, `while`,
// `for`, a lambda's body, a builtin's block (`each`) and a binding chain
// (`if v = ..., cond`); an expression as the value of an `if` expression,
// a `switch` expression, a lambda, inside a binding chain's body, a
// method call's argument, an interpolation, a `for` body, a builtin's
// block and the fallback of `??`; a statement in an arm of a `switch`
// over a union's members and an expression as such a switch's value
// . Left out: `?? return` (it ends the function and wraps
// no expression of its own; the fallback row covers the operand of
// `??`) and a bare block (the language has none).
fn rules: Array(PRule) {
  xs: Array(PRule) = []
  main_site = "fn main {\n@\n}\n"
  // README "Errors cannot be dropped".
  xs.push(rule("discard-error", "stmt", "", main_site, "", "parse_age(\"1\")", "_ = parse_age(\"1\")", "drops a value that can be an error"))
  // README "x? compiles only where the failure can be returned".
  xs.push(rule("question-unreturnable", "expr", "Int", "fn site: Int {\n@\n  0\n}\n\nfn main {\n  puts(site())\n}\n", "fn site: Int | ParseError {\n@\n  0\n}\n\nfn main {\n  _ = site()\n}\n", "parse_age(\"1\")?", "parse_age(\"1\")?", "postfix ? on Int | ParseError would return ParseError"))
  // README "Field initialization", rule 3: a field without a default or a
  // zero is set on every path before it is read.
  xs.push(rule("field-read-before-set", "expr", "Int", "class Probe {\n  xs: Array(Int)\n\n  fn initialize {\n@\n    self.xs = []\n  }\n}\n\nfn main {\n  p = Probe.new()\n}\n", "class Probe {\n  xs: Array(Int)\n\n  fn initialize {\n    self.xs = []\n@\n  }\n}\n\nfn main {\n  p = Probe.new()\n}\n", "self.xs.size", "self.xs.size", "xs of Probe"))
  // README "Methods and self": a field is written only as self.x = ...
  xs.push(rule("bare-field-write", "stmt", "", "class Probe {\n  x: Int = 0\n\n  fn bump {\n@\n  }\n}\n\nfn main {\n  p = Probe.new()\n  p.bump()\n  puts(p.x)\n}\n", "", "x = 1", "self.x = 1", "x is a field of Probe"))
  // README "for": the loop variable cannot be assigned.
  xs.push(rule("for-variable-assign", "stmt", "", "fn main {\n  for i in 0..3 {\n@\n  }\n}\n", "", "i = 5", "puts(i)", "cannot assign to i"))
  // README "for": over an Array of structs the loop variable is the
  // element itself; the walked array keeps its size and order through its
  // own name, and the place is not captured.
  xs.push(rule("place-walk-change", "stmt", "", "struct PP {\n  x: Int\n  y: Int\n}\n\nfn main {\n  xs = [PP { x: 1, y: 2 }]\n  ys: Array(PP) = []\n  for p in xs {\n@\n  }\n  puts(xs[0].x + ys.size)\n}\n", "", "xs.push(p)", "ys.push(p)", "cannot push xs while walking it"))
  xs.push(rule("place-each-walk-change", "stmt", "", "struct PP {\n  x: Int\n  y: Int\n}\n\nfn main {\n  xs = [PP { x: 1, y: 2 }]\n  ys: Array(PP) = []\n  xs.each { |p|\n@\n  }\n  puts(xs[0].x + ys.size)\n}\n", "", "xs.push(p)", "ys.push(p)", "cannot push xs while walking it"))
  xs.push(rule("place-capture", "stmt", "", "struct PP {\n  x: Int\n  y: Int\n}\n\nfn main {\n  xs = [PP { x: 1, y: 2 }]\n  ys: Array(PP) = []\n  for p in xs {\n@\n  }\n  puts(xs[0].x + ys.size)\n}\n", "", "f = { || p.x }\nputs(f())", "w = p\nf = { || w.x }\nputs(f())", "a lambda cannot capture p"))
  // README "Visibility": a field without pub is private to its module.
  xs.push(rule("private-field", "expr", "Int", "import probe_mod\n\nfn main {\n  pb = PBox.new()\n@\n}\n", "", "pb.secret", "pb.open", "is private to module probe_mod"))
  // README "Numbers": values of different number types do not mix.
  // README "Channel and Mutex": inside `with` the
  // guarded value is never an argument, a stored value or a captured name.
  xs.push(rule("mutex-guard-escape", "stmt", "", "import std.sync\n\nclass PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  m = sync.Mutex(PBox).new(PBox.new())\n  keep: Array(PBox) = []\n  m.with { |b|\n@\n  }\n  puts(keep.size)\n}\n", "", "keep.push(b)", "keep.push(PBox.new())", "Mutex.with: "))
  // README "Channel and Mutex": Mutex(T).new
  // consumes the name it is given, and nothing from outside is stored
  // into the guarded value.
  xs.push(rule("mutex-new-consumed", "stmt", "", "import std.sync\n\nclass PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  b = PBox.new()\n  m = sync.Mutex(PBox).new(b)\n@\n}\n", "", "b.n += 1", "m.with { |x| x.n += 1 }", "was consumed by Mutex(PBox).new"))
  xs.push(rule("mutex-with-inward", "stmt", "", "import std.sync\n\nclass PBox {\n  pub n: Int = 0\n  pub child: PBox? = nil\n}\n\nfn main {\n  m = sync.Mutex(PBox).new(PBox.new())\n  mine = PBox.new()\n@\n  puts(mine.n)\n}\n", "", "m.with { |b| b.child = mine }", "m.with { |b| b.child = PBox.new() }", "comes from outside it"))
  // README "Channel and Mutex": no method of
  // a class a Mutex guards keeps a reference from outside.
  xs.push(rule("mutex-guarded-method", "stmt", "", "import std.sync\n\nclass PBad {\n  pub child: PBad? = nil\n\n  fn adopt(x: PBad) {\n    self.child = x\n  }\n}\n\nclass PGood {\n  pub child: PGood? = nil\n\n  fn grow {\n    self.child = PGood.new()\n  }\n}\n\nfn main {\n@\n}\n", "", "pm = Mutex(PBad).new(PBad.new())\npm.with { |b| b.child = nil }", "pm = Mutex(PGood).new(PGood.new())\npm.with { |b| b.grow() }", "PBad.adopt stores a parameter"))
  // README "Spawn" and "What may cross a task": a
  // task captures by copy what may cross, never assigns a captured name,
  // and a captured Array is read-only on both sides until the join.
  tsite = "class PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  pb = PBox.new()\n@\n  puts(pb.n)\n}\n"
  // A class's object moves into a task only from a local whose every
  // value is new: a parameter's is the caller's too.
  psite = "class PBox {\n  pub n: Int = 0\n}\n\nfn run(pb: PBox) {\n@\n}\n\nfn main {\n  run(PBox.new())\n}\n"
  xs.push(rule("spawn-capture-class", "stmt", "", psite, "", "ph = spawn { pb.n }\nputs(ph.join() ?? -1)", "pn = pb.n\nph = spawn { pn }\nputs(ph.join() ?? -1)", "spawn cannot capture pb: its type, PBox, cannot be shared with another task"))
  xs.push(rule("spawn-assign-capture", "stmt", "", tsite, "", "pk = 1\nph = spawn {\n  pk = 2\n  pk\n}\nputs(ph.join() ?? -1)", "pk = 1\nph = spawn {\n  pj = 2\n  pj + pk\n}\nputs(ph.join() ?? -1)", "spawn cannot assign to pk"))
  xs.push(rule("spawn-array-mutate", "stmt", "", tsite, "", "pxs = [1, 2]\nph = spawn {\n  pxs.push(3)\n  pxs.size\n}\nputs(ph.join() ?? -1)", "pxs = [1, 2]\nph = spawn {\n  pxs.size\n}\nputs(ph.join() ?? -1)", "spawn cannot mutate captured Array pxs"))
  xs.push(rule("spawn-sender-mutate", "stmt", "", tsite, "", "pxs = [1, 2]\nph = spawn { pxs.size }\npxs.push(3)\nputs(ph.join() ?? -1)", "pxs = [1, 2]\nph = spawn { pxs.size }\nputs(ph.join() ?? -1)\npxs.push(3)", "cannot mutate pxs while a spawn using it is running"))
  // A zero-argument mutator written without parentheses is a mutation.
  xs.push(rule("handler-capture-class", "stmt", "", "import std.http\n\nclass PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  pb = PBox.new()\n  if server = http.listen(0) {\n@\n    server.close()\n  }\n  puts(pb.n)\n}\n", "", "server.get(\"/\") { |req| Response.text(\"\${pb.n}\") }", "pn = pb.n\nserver.get(\"/\") { |req| Response.text(\"\${pn}\") }", "an HTTP handler cannot capture pb: its type, PBox, cannot cross"))
  xs.push(rule("handler-assign-capture", "stmt", "", "import std.http\n\nclass PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  pb = PBox.new()\n  if server = http.listen(0) {\n@\n    server.close()\n  }\n  puts(pb.n)\n}\n", "", "pk = 1\nserver.get(\"/\") { |req|\n  pk = 2\n  Response.text(\"\${pk}\")\n}", "pk = 1\nserver.get(\"/\") { |req|\n  pj = 2\n  Response.text(\"\${pj + pk}\")\n}", "an HTTP handler cannot assign to pk"))
  xs.push(rule("handler-array-mutate", "stmt", "", "import std.http\n\nclass PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  pb = PBox.new()\n  if server = http.listen(0) {\n@\n    server.close()\n  }\n  puts(pb.n)\n}\n", "", "pxs = [1, 2]\nserver.get(\"/\") { |req|\n  pxs.push(3)\n  Response.text(\"\${pxs.size}\")\n}", "pxs = [1, 2]\nserver.get(\"/\") { |req|\n  Response.text(\"\${pxs.size}\")\n}", "an HTTP handler cannot mutate captured Array pxs"))
  xs.push(rule("handler-sender-mutate", "stmt", "", "import std.http\n\nclass PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  pb = PBox.new()\n  if server = http.listen(0) {\n@\n    server.close()\n  }\n  puts(pb.n)\n}\n", "", "pxs = [1, 2]\nserver.get(\"/\") { |req| Response.text(\"\${pxs.size}\") }\npxs.push(3)", "pxs = [1, 2]\npxs.push(3)\nserver.get(\"/\") { |req| Response.text(\"\${pxs.size}\") }", "cannot mutate pxs: an HTTP handler registered above reads it"))
  xs.push(rule("spawn-sender-mutate-bare", "stmt", "", tsite, "", "pxs = [1, 2]\nph = spawn { pxs.size }\npxs.clear()\nputs(ph.join() ?? -1)", "pxs = [1, 2]\nph = spawn { pxs.size }\nputs(ph.join() ?? -1)\npxs.clear()", "cannot mutate pxs while a spawn using it is running"))
  xs.push(rule("spawn-array-mutate-bare", "stmt", "", tsite, "", "pxs = [2, 1]\nph = spawn {\n  pxs.sort()\n  pxs.size\n}\nputs(ph.join() ?? -1)", "pxs = [2, 1]\nph = spawn {\n  pys = pxs.sorted()\n  pys.size\n}\nputs(ph.join() ?? -1)", "spawn cannot mutate captured Array pxs"))
  // A captured Array is shared with the task, so its elements cross in
  // turn: an Array of a class is refused, an Array
  // of Mutexes is not.
  xs.push(rule("spawn-capture-array-class", "stmt", "", tsite, "", "pxs = [pb]\nph = spawn {\n  pc = pxs[0]\n  pc.n += 1\n  0\n}\nputs(ph.join() ?? -1)", "pxs = [pb.n]\nph = spawn {\n  pc = pxs[0]\n  pc + 1\n}\nputs(ph.join() ?? -1)", "its elements (PBox) cannot cross to another task"))
  // README "Parallel": its block captures by the same rule.
  xs.push(rule("parallel-capture-class", "stmt", "", tsite, "", "pys = [1, 2].parallel { |x| x + pb.n }\nputs(pys.size)", "pn = pb.n\npys = [1, 2].parallel { |x| x + pn }\nputs(pys.size)", ".parallel cannot capture pb: its type, PBox, cannot cross to another task"))
  // A `.parallel` block's messages name `.parallel`, not spawn.
  xs.push(rule("parallel-assign-capture", "stmt", "", tsite, "", "pk = 1\npys = [1, 2].parallel { |x|\n  pk = x\n  pk\n}\nputs(pys.size)", "pk = 1\npys = [1, 2].parallel { |x|\n  pj = x\n  pj + pk\n}\nputs(pys.size)", ".parallel cannot assign to pk: each body has its own copy"))
  xs.push(rule("parallel-array-mutate", "stmt", "", tsite, "", "pxs = [1, 2]\npys = [1, 2].parallel { |x|\n  pxs.push(x)\n  pxs.size\n}\nputs(pys.size)", "pxs = [1, 2]\npys = [1, 2].parallel { |x|\n  pxs.size + x\n}\nputs(pys.size)", ".parallel cannot mutate captured Array pxs; it is read-only while the bodies run"))
  // A captured Hash is shared and read-only as a captured Array is, and
  // its values cross in turn.
  xs.push(rule("spawn-hash-mutate", "stmt", "", tsite, "", "phh = [\"a\": 1]\nph = spawn {\n  phh[\"b\"] = 2\n  phh.size\n}\nputs(ph.join() ?? -1)", "phh = [\"a\": 1]\nph = spawn {\n  (phh[\"a\"] ?? 0) + phh.size\n}\nputs(ph.join() ?? -1)", "spawn cannot mutate captured Hash phh"))
  xs.push(rule("spawn-hash-sender-mutate", "stmt", "", tsite, "", "phh = [\"a\": 1]\nph = spawn { phh.size }\nphh.delete(\"a\")\nputs(ph.join() ?? -1)", "phh = [\"a\": 1]\nph = spawn { phh.size }\nputs(ph.join() ?? -1)\nphh.delete(\"a\")", "cannot mutate phh while a spawn using it is running"))
  xs.push(rule("parallel-hash-mutate", "stmt", "", tsite, "", "phh = [\"a\": 1]\npys = [1, 2].parallel { |x|\n  phh.clear()\n  x\n}\nputs(pys.size)", "phh = [\"a\": 1]\npys = [1, 2].parallel { |x|\n  x + (phh[\"a\"] ?? 0)\n}\nputs(pys.size)", ".parallel cannot mutate captured Hash phh; it is read-only while the bodies run"))
  xs.push(rule("spawn-capture-hash-class", "stmt", "", tsite, "", "phh = [\"a\": pb]\nph = spawn { phh.size }\nputs(ph.join() ?? -1)", "phh = [\"a\": pb.n]\nph = spawn { phh.size }\nputs(ph.join() ?? -1)", "its keys or values (PBox) cannot cross to another task"))
  // README "Channel and Mutex": the value of `with`, when it is used, is
  // a plain value.
  xs.push(rule("mutex-with-value", "stmt", "", "import std.sync\n\nclass PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  m = sync.Mutex(PBox).new(PBox.new())\n@\n}\n", "", "pv = m.with { |b| b }\nputs(pv.n)", "pv = m.with { |b| b.n }\nputs(pv)", "Mutex.with's value cannot be PBox"))
  // README "Clone": a deep copy, refused for a type holding a function value.
  xs.push(rule("clone-fn-field", "stmt", "", "class PBox {\n  pub n: Int = 0\n  pub xs: Array(Int) = []\n}\n\nclass PFn {\n  pub f: fn(Int): Int\n\n  fn initialize(self.f) {\n  }\n}\n\nfn twice(n: Int): Int {\n  n * 2\n}\n\nfn main {\n  pb = PBox.new()\n  pq = PFn.new(twice)\n@\n}\n", "", "pc = pq.clone()\nputs(pc.f(1))", "pc = pb.clone()\nputs(pc.n)", "cannot clone PFn: a function value (PFn.f)"))
  // README "If": conditions are Bool, there is no truthiness.
  xs.push(rule("if-non-bool", "stmt", "", main_site, "", "if probe_k() {\n  puts(1)\n}", "if probe_k() > 0 {\n  puts(1)\n}", "if condition must be Bool"))
  // README "Line breaks": a line that starts with `-` or `[`
  // begins a statement, and one whose value nobody uses is an error
  // that says how to continue the line before.
  xs.push(rule("dangling-minus", "stmt", "", main_site, "", "pt = probe_k()\n- 1\nputs(pt)", "pt = probe_k() -\n  1\nputs(pt)", "this line starts with `-`"))
  xs.push(rule("dangling-bracket", "stmt", "", main_site, "", "pt = probe_k()\n[pt, 1]\nputs(pt)", "pt = [probe_k(),\n  1]\nputs(pt.size)", "this line starts with `[`"))
  // A C function writes a local through &x, never a field, an element or a value.
  csite = "lib pc {\n  struct PPair {\n    a: Int32\n  }\n  fun out_i(p: Ptr(Int32))\n  fun mk: Ptr(PPair)\n}\n\nfn main {\n@\n}\n"
  xs.push(rule("c-out-local", "stmt", "", csite, "", "pp = pc.mk()\npc.out_i(&pp.a)", "pn: Int32 = 0\npc.out_i(&pn)", "&x takes a local"))
  xs.push(rule("number-mix", "expr", "Int", "fn main {\n  pa: Int32 = 1\n  pn = 2\n@\n}\n", "", "pa + pn", "pn + pn", "binary operator expects matching types"))
  // README "Enums" and "Switch".
  esite = "enum Tok { a, b }\n\nenum PE: Error { bad }\n\nfn ef(n: Int): Int | PE {\n  if n > 0 {\n    return PE.bad\n  }\n  n\n}\n\nfn main {\n  t = Tok.from_i(probe_k()) ?? Tok.a\n@\n}\n"
  xs.push(rule("enum-switch-missing", "stmt", "", esite, "", "switch t {\n  case a { puts(1) }\n}", "switch t {\n  case a { puts(1) }\n  case b { puts(2) }\n}", "switch over Tok does not cover b"))
  xs.push(rule("enum-from-int", "stmt", "", esite, "", "pt: Tok = 1\nputs(pt)", "pt: Tok = Tok.from_i(1) ?? Tok.a\nputs(pt)", "cannot assign Int to Tok"))
  xs.push(rule("enum-qualified-label", "stmt", "", esite, "", "switch t {\n  case Tok.a { puts(1) }\n  case b { puts(2) }\n}", "switch t {\n  case a { puts(1) }\n  case b { puts(2) }\n}", "write the member without its type in a case label"))
  xs.push(rule("enum-else-beside-full", "stmt", "", esite, "", "switch t {\n  case a { puts(1) }\n  case b { puts(2) }\n  else { puts(3) }\n}", "switch t {\n  case a { puts(1) }\n  case b { puts(2) }\n}", "every member of Tok is named; remove the else"))
  xs.push(rule("enum-error-dropped", "stmt", "", esite, "", "ef(1)", "_ = ef(1)", "drops a value that can be an error"))
  // README "Switch" over a union.
  usite = "class Oops: Error {\n  pub message: String = \"oops\"\n}\n\nfn uf(n: Int): Int | Oops | Nil {\n  if n > 1 {\n    return Oops.new()\n  }\n  if n > 0 {\n    return nil\n  }\n  n\n}\n\nfn main {\n  u = uf(probe_k())\n@\n}\n"
  xs.push(rule("union-switch-missing", "stmt", "", usite, "", "switch u {\n  case n: Int { puts(n) }\n  case nil { puts(0) }\n}", "switch u {\n  case n: Int { puts(n) }\n  case nil { puts(0) }\n  case Oops { puts(1) }\n}", "does not cover Oops"))
  xs.push(rule("union-binding-outside-arm", "stmt", "", usite, "", "switch u {\n  case n: Int { puts(n) }\n  else { puts(0) }\n}\nputs(n)", "switch u {\n  case n: Int { puts(n) }\n  else { puts(0) }\n}\nputs(1)", "unknown name n"))
  xs.push(rule("union-case-nil-without-nil", "stmt", "", usite, "", "w: Int | String = 1\nswitch w {\n  case nil { puts(0) }\n  else { puts(1) }\n}", "w: Int | String | Nil = 1\nswitch w {\n  case nil { puts(0) }\n  else { puts(1) }\n}", "has no nil member"))
  xs.push(rule("union-label-not-member", "stmt", "", usite, "", "switch u {\n  case f: Float64 { puts(f) }\n  else { puts(0) }\n}", "switch u {\n  case f: Int { puts(f) }\n  else { puts(0) }\n}", "is not a member of"))
  // README "Reading the error itself": the else
  // guard's block leaves, it reads a value that can fail, and its own
  // name is not bound inside it; a return in a builtin's value block has
  // the function's result type.
  xs.push(rule("guard-must-leave", "stmt", "", main_site, "", "n = parse_age(\"1\") else e {\n  puts(e.message)\n}\nputs(n)", "n = parse_age(\"1\") else e {\n  puts(e.message)\n  return\n}\nputs(n)", "the block of else e must leave"))
  xs.push(rule("guard-no-failure", "stmt", "", main_site, "", "n = probe_k() else e {\n  return\n}\nputs(n)", "n = parse_age(\"1\") else e {\n  return\n}\nputs(n)", "else e needs a value that can fail"))
  xs.push(rule("guard-reads-own-name", "stmt", "", main_site, "", "n = parse_age(\"1\") else e {\n  puts(n)\n  return\n}\nputs(n)", "n = parse_age(\"1\") else e {\n  puts(e.message)\n  return\n}\nputs(n)", "unknown name n"))
  xs.push(rule("value-block-return-type", "stmt", "", "fn site: Int {\n@\n  0\n}\n\nfn main {\n  puts(site())\n}\n", "", "if [1].any { |x|\n  if x > 0 {\n    return \"one\"\n  }\n  false\n} {\n  puts(1)\n}", "if [1].any { |x|\n  if x > 0 {\n    return 1\n  }\n  false\n} {\n  puts(1)\n}", "return type is String, expected Int"))
  // README "Constants" and "Literals": a constant is not
  // assigned and holds a scalar, a module has no
  // variables, and a literal (or a constant written in)
  // that does not fit its type is refused at every width.
  ksite = "const limit = 3\n\nconst big = 3000000000\n\nfn main {\n@\n}\n"
  xs.push(rule("const-assigned", "stmt", "", ksite, "", "limit = 4", "puts(limit)", "limit is a constant and cannot be assigned"))
  xs.push(rule("const-non-scalar", "stmt", "", "const name = \"x\"\n\nfn main {\n@\n}\n", "const name = 'x'\n\nfn main {\n@\n}\n", "puts(name)", "puts(name)", "a String is not one yet"))
  xs.push(rule("module-state", "stmt", "", "count = 0\n\nfn main {\n@\n}\n", "const count = 0\n\nfn main {\n@\n}\n", "puts(count)", "puts(count)", "a module has no variables"))
  xs.push(rule("const-does-not-fit", "stmt", "", ksite, "", "fitv: Int32 = big\nputs(fitv)", "fitv: Int = big\nputs(fitv)", "the constant big = 3000000000 does not fit in Int32"))
  xs.push(rule("literal-fit-int32", "stmt", "", main_site, "", "fitv: Int32 = 2147483648\nputs(fitv)", "fitv: Int32 = 2147483647\nputs(fitv)", "integer literal does not fit in Int32"))
  xs.push(rule("literal-fit-uint32", "stmt", "", main_site, "", "fitv: UInt32 = 4294967296\nputs(fitv)", "fitv: UInt32 = 4294967295\nputs(fitv)", "integer literal does not fit in UInt32"))
  xs.push(rule("literal-fit-int", "stmt", "", main_site, "", "fitv = 9223372036854775808\nputs(fitv)", "fitv = 9223372036854775807\nputs(fitv)", "integer literal does not fit in Int"))
  xs.push(rule("literal-fit-uint64", "stmt", "", main_site, "", "fitv = 18446744073709551616u64\nputs(fitv)", "fitv = 18446744073709551615u64\nputs(fitv)", "integer literal does not fit in UInt64"))
  // A statement with no effect computes a value nobody uses: an error
  // anywhere; `_ =` drops one on purpose.
  esite = "fn main {\n  ev = probe_k()\n@\n  puts(ev)\n}\n"
  xs.push(rule("no-effect", "stmt", "", esite, "", "ev + 1", "_ = ev + 1", "this line computes a value and drops it"))
  // README "Switch" over integers and Bool: no two
  // labels share a value, a label fits the value's type,
  // and a Bool switch without else names true and false.
  rsite = "const lo = 1\n\nfn main {\n  rv = probe_k()\n  rb = rv > 0\n  rw: Int32 = 1\n@\n}\n"
  xs.push(rule("range-overlap", "stmt", "", rsite, "", "switch rv {\n  case 0..=9 { puts(1) }\n  case 5 { puts(2) }\n  else { puts(3) }\n}", "switch rv {\n  case 0..=9 { puts(1) }\n  case 10 { puts(2) }\n  else { puts(3) }\n}", "case 5 overlaps case 0..=9"))
  xs.push(rule("range-const-overlap", "stmt", "", rsite, "", "switch rv {\n  case lo..=4 { puts(1) }\n  case 2 { puts(2) }\n  else { puts(3) }\n}", "switch rv {\n  case lo..=4 { puts(1) }\n  case 5 { puts(2) }\n  else { puts(3) }\n}", "case 2 overlaps case lo..=4"))
  xs.push(rule("label-outside-type", "stmt", "", rsite, "", "switch rw {\n  case 3000000000 { puts(1) }\n  else { puts(2) }\n}", "switch rw {\n  case 2147483647 { puts(1) }\n  else { puts(2) }\n}", "case label 3000000000 does not fit in Int32"))
  xs.push(rule("bool-switch-missing", "stmt", "", rsite, "", "switch rb {\n  case true { puts(1) }\n}", "switch rb {\n  case true { puts(1) }\n  case false { puts(2) }\n}", "switch over Bool does not cover false"))
  xs.push(rule("bool-int-label", "stmt", "", rsite, "", "switch rb {\n  case 1 { puts(1) }\n  case false { puts(2) }\n}", "switch rb {\n  case true { puts(1) }\n  case false { puts(2) }\n}", "write `case true`"))
  // README "Opening an optional" and "Compile errors": an
  // optional is opened or tested, never compared with nil or
  // used as its value; a call gives what its function takes.
  osite = "fn ptwo(a: Int, b: Int): Int {\n  a + b\n}\n\nfn main {\n  px: Int? = probe_k()\n@\n}\n"
  xs.push(rule("nil-compare", "stmt", "", osite, "", "puts(px == nil)", "if _ = px {\n  puts(1)\n} else {\n  puts(0)\n}", "an optional is never compared with nil"))
  xs.push(rule("optional-as-value", "stmt", "", osite, "", "puts(px + 1)", "puts((px ?? 0) + 1)", "open it with `if v = px`"))
  xs.push(rule("arg-count", "stmt", "", osite, "", "puts(ptwo(1))", "puts(ptwo(1, 2))", "ptwo takes 2 arguments, given 1"))
  // README "Overloads and defaults": a name is given only to a parameter
  // with a default; "Structs": a literal leaves out only the fields that
  // declare a default.
  dsite = "fn pwide(s: String, width: Int = 8): Int {\n  s.size + width\n}\n\nstruct PO {\n  a: Int\n  b: Int = 2\n}\n\nfn main {\n@\n}\n"
  xs.push(rule("named-without-default", "stmt", "", dsite, "", "puts(pwide(s: \"a\"))", "puts(pwide(\"a\", width: 3))", "s of pwide has no default, so it is passed by position"))
  xs.push(rule("literal-missing-field", "stmt", "", dsite, "", "puts(PO { b: 1 }.b)", "puts(PO { a: 1 }.b)", "missing field a"))
  // README "Conversions", "Operator methods", "Arrays" and "Bounds": an
  // integer and a Float64 neither mix nor compare (the conversion is
  // written); a compound assignment through a type's operator reads its
  // place without side effects; contains compares by the element's ==;
  // a generic type's bound holds for its argument.
  nsite = "struct PF {\n  f: fn(): Int\n}\n\nstruct PV {\n  x: Int\n\n  fn +(o: PV): PV {\n    PV { x: x + o.x }\n  }\n}\n\ninterface PRanked {\n  fn rank: Int\n}\n\nstruct PCard: PRanked {\n  n: Int\n\n  fn rank: Int {\n    n\n  }\n}\n\nclass PTop(T: PRanked) {\n  best: T\n\n  fn initialize(best: T) {\n    self.best = best\n  }\n}\n\nfn main {\n  nf = 1.5\n  ni = probe_k()\n  nvs = [PV { x: 1 }]\n  nhs = [PF { f: () { 1 } }]\n@\n}\n"
  xs.push(rule("int-float-mix", "stmt", "", nsite, "", "puts(nf * ni)", "puts(nf * ni.to_f())", "an integer and a Float64 do not mix"))
  xs.push(rule("int-float-compare", "stmt", "", nsite, "", "puts(ni == nf)", "puts(ni.to_f() == nf)", "cannot compare Int with Float64"))
  xs.push(rule("compound-method-place", "stmt", "", nsite, "", "nvs[probe_k() - probe_k()] += PV { x: 1 }", "nvs[0] += PV { x: 1 }", "needs a place read without side effects"))
  xs.push(rule("contains-without-eq", "stmt", "", nsite, "", "puts(nhs.has(nhs[0]))", "puts(nvs.has(nvs[0]))", "has compares the elements with =="))
  xs.push(rule("type-bound", "stmt", "", nsite, "", "puts(PTop.new(ni).best)", "puts(PTop.new(PCard { n: ni }).best.n)", "Int does not implement PRanked"))
  // README "Output": the writers print what interpolation prints, an
  // optional opened first; exit takes an Int, and a guard may end with it.
  xs.push(rule("print-optional", "stmt", "", osite, "", "puts(px)", "puts(px ?? 0)", "puts cannot print Int?: it holds nil"))
  xs.push(rule("print-no-text", "stmt", "", osite, "", "eputs([px ?? 0])", "eputs(\"\${[px ?? 0].size}\")", "eputs cannot print Array(Int)"))
  xs.push(rule("exit-status-type", "stmt", "", osite, "", "exit(\"1\")", "exit(px ?? 1)", "expected Int, got String"))
  xs.push(rule("guard-ends-with-exit", "stmt", "", main_site, "", "n = parse_age(\"1\") else e {\n  eputs(e.message)\n}\nputs(n)", "n = parse_age(\"1\") else e {\n  eputs(e.message)\n  exit(2)\n}\nputs(n)", "the block of else e must leave"))
  // README "Errors": a failure-or-nothing result, `Void | E`, is an error
  // a statement may not drop, and an else guard without a name is its
  // guard only.
  vsite = "class POops: Error {\n  pub message: String = \"oops\"\n}\n\nfn pvoid(n: Int): Void | POops {\n  if n > 1 {\n    return POops.new()\n  }\n}\n\nfn main {\n@\n}\n"
  xs.push(rule("void-result-dropped", "stmt", "", vsite, "", "pvoid(probe_k())", "_ = pvoid(probe_k())", "drops a value that can be an error (Void | POops)"))
  xs.push(rule("void-guard-value", "stmt", "", vsite, "", "parse_age(\"1\") else e {\n  exit(1)\n}", "pvoid(probe_k()) else e {\n  exit(1)\n}", "an else guard without a name to assign"))
  // README "Channel and Mutex": a recover function captures only plain
  // values, and m.recover(v) consumes v as Mutex(T).new(v) does.
  xs.push(rule("mutex-recover-capture", "stmt", "", "import std.sync\n\nfn main {\n  k = probe_k()\n  ks = [k]\n@\n}\n", "", "pm = Mutex(Int).new(0, recover: { || ks[0] })\nputs(pm.poisoned())", "pm = Mutex(Int).new(0, recover: { || k })\nputs(pm.poisoned())", "recover function cannot capture ks"))
  xs.push(rule("mutex-recover-consumed", "stmt", "", "import std.sync\n\nclass PBox {\n  pub n: Int = 0\n}\n\nfn main {\n  m = sync.Mutex(PBox).new(PBox.new())\n  b = PBox.new()\n  m.recover(b)\n@\n}\n", "", "b.n += 1", "m.with { |x| x.n += 1 }", "was consumed by Mutex(PBox).recover"))
  // Every method call takes parentheses; a builtin read-only property
  // takes none.
  csite = "fn main {\n  pxs = [3, 1, 2]\n  ps = \"ab\"\n@\n  puts(pxs[0])\n}\n"
  xs.push(rule("method-call-parens", "stmt", "", csite, "", "pxs.sort", "pxs.sort()", "a method call takes parentheses: write sort()"))
  xs.push(rule("method-value-parens", "expr", "Int", csite, "", "pxs.sum", "pxs.sum()", "a method call takes parentheses: write sum()"))
  // expect opens an optional, not a result that can fail with an error.
  esite = "fn main {\n  px: Int? = probe_k()\n  why = \"set\"\n@\n}\n"
  xs.push(rule("expect-optional-only", "stmt", "", esite, "", "pv = parse_age(why).expect(why)\nputs(pv)", "pv = px.expect(why)\nputs(pv)", "expect opens an optional (T?)"))
  // pop gives an optional; unary minus has no unsigned operand.
  xs.push(rule("pop-is-optional", "stmt", "", csite, "", "pn: Int = pxs.pop()\nputs(pn)", "pn: Int = pxs.pop() ?? 0\nputs(pn)", "cannot assign Int? to Int"))
  xs.push(rule("negate-unsigned", "stmt", "", csite, "", "pu = 3u64\nputs(-pu)", "pu = 3u64\nputs(0u64 &- pu)", "unary minus of an unsigned value"))
  xs.push(rule("property-no-parens", "expr", "Int", csite, "", "ps.size()", "ps.size", "size is read without parentheses: write .size"))
  // README "Key and value types": a struct key's derived hash comes from
  // its fields, so a Float64 field is refused; a value is not optional.
  hsite = "struct PKf {\n  x: Float64\n}\n\nstruct PKe {\n  x: Int\n\n  fn equals(o: PKe): Bool {\n    true\n  }\n\n  fn hash(h: Hasher) {\n  }\n}\n\nstruct PKi {\n  x: Int\n}\n\nfn main {\n@\n}\n"
  xs.push(rule("hash-key-float-field", "stmt", "", hsite, "", "ph = Hash(PKf, Int).new()\nputs(ph.size)", "ph = Hash(PKi, Int).new()\nputs(ph.size)", "a Hash key cannot hold a Float64"))
  xs.push(rule("hash-value-optional", "stmt", "", hsite, "", "ph = Hash(Int, String?).new()\nputs(ph.size)", "ph = Hash(Int, String).new()\nputs(ph.size)", "a Hash value cannot be optional"))
  // README "Hashes": a missing key's default is `h[k] ?? d` (no get_or);
  // a hash literal's entries share the first's types, and `[:]` needs a
  // declared type. README "Sets": a set has no [ ].
  xs.push(rule("hash-get-or", "stmt", "", hsite, "", "ph = [\"a\": 1]\nputs(ph.get_or(\"a\", 0))", "ph = [\"a\": 1]\nputs(ph[\"a\"] ?? 0)", "Hash has no get_or: write h[k] ?? default"))
  xs.push(rule("hash-literal-untyped", "stmt", "", hsite, "", "ph = [:]\nputs(ph.size)", "ph: Hash(String, Int) = [:]\nputs(ph.size)", "an empty hash literal needs a type"))
  xs.push(rule("hash-literal-value", "stmt", "", hsite, "", "ph = [\"a\": 1, \"b\": \"x\"]\nputs(ph.size)", "ph = [\"a\": 1, \"b\": 2]\nputs(ph.size)", "hash literal value is String, expected Int"))
  xs.push(rule("set-no-index", "stmt", "", hsite, "", "pt = Set(Int).new()\nputs(pt[1])", "pt = Set(Int).new()\nputs(pt.has(1))", "a Set has no [ ]"))
  xs
}

// The module private-field imports.
fn probe_mod_src: String {
  "pub class PBox {\n  secret: Int = 1\n  pub open: Int = 2\n}\n"
}

fn stmt_wrappers: Array(String) {
  ["plain", "if", "else", "switch-arm", "union-arm", "while", "for", "lambda", "builtin-block", "binding-chain"]
}

fn expr_wrappers: Array(String) {
  ["plain", "if-expr", "switch-expr", "union-switch-expr", "lambda", "binding-chain", "call-arg", "interpolation", "for", "builtin-block", "qq-fallback"]
}

fn ind(s: String, pad: String): String {
  out = ""
  lines = s.split("\n")
  for i in 0..lines.size {
    if i > 0 {
      out = "${out}\n"
    }
    out = "${out}${pad}${lines[i]}"
  }
  out
}

// A statement under a wrapper, at two spaces.
fn wrap_stmt(w: String, s: String): String {
  if w == "plain" {
    return ind(s, "  ")
  }
  if w == "if" {
    return "  if probe_cond() {\n${ind(s, "    ")}\n  }"
  }
  if w == "else" {
    return "  if probe_cond() {\n    puts(0)\n  } else {\n${ind(s, "    ")}\n  }"
  }
  if w == "switch-arm" {
    return "  switch probe_k() {\n    case 1 {\n${ind(s, "      ")}\n    }\n    else {\n      puts(0)\n    }\n  }"
  }
  if w == "union-arm" {
    return "  switch probe_maybe() {\n    case pw: Int {\n${ind(s, "      ")}\n    }\n    case nil {\n      puts(0)\n    }\n  }"
  }
  if w == "while" {
    return "  while probe_cond() {\n${ind(s, "    ")}\n    break\n  }"
  }
  if w == "for" {
    return "  for q in 0..2 {\n${ind(s, "    ")}\n  }"
  }
  if w == "lambda" {
    return "  pf = { ||\n${ind(s, "    ")}\n    0\n  }\n  puts(pf())"
  }
  if w == "builtin-block" {
    return "  [1, 2].each { |q|\n${ind(s, "    ")}\n  }"
  }
  if w == "binding-chain" {
    return "  if pv = probe_maybe(), pv > 0 {\n${ind(s, "    ")}\n  }"
  }
  "  (unknown wrapper ${w})"
}

// An expression of type ty under a wrapper, used, at two spaces.
fn wrap_expr(w: String, e: String): String {
  use = "  puts(\"\${px}\")"
  if w == "plain" {
    return "  px = ${e}\n${use}"
  }
  if w == "if-expr" {
    return "  px = if probe_cond() {\n    ${e}\n  } else {\n    ${e}\n  }\n${use}"
  }
  if w == "switch-expr" {
    return "  px = switch probe_k() {\n    case 1 {\n      ${e}\n    }\n    else {\n      ${e}\n    }\n  }\n${use}"
  }
  if w == "union-switch-expr" {
    return "  px = switch probe_maybe() {\n    case pw: Int {\n      ${e}\n    }\n    case nil {\n      ${e}\n    }\n  }\n${use}"
  }
  if w == "lambda" {
    return "  pf = { || ${e} }\n  px = pf()\n${use}"
  }
  if w == "binding-chain" {
    return "  if pv = probe_maybe(), pv > 0 {\n    px = ${e}\n    puts(\"\${px}\")\n  }"
  }
  if w == "call-arg" {
    return "  px = ProbeCall.new().pass(${e})\n${use}"
  }
  if w == "interpolation" {
    return "  px = \"<\${${e}}>\"\n${use}"
  }
  if w == "for" {
    return "  for q in 0..2 {\n    puts(\"\${${e}}\")\n  }"
  }
  if w == "builtin-block" {
    return "  [1, 2].each { |q| puts(\"\${${e}}\") }"
  }
  if w == "qq-fallback" {
    return "  px = probe_opt() ?? ${e}\n${use}"
  }
  "  (unknown wrapper ${w})"
}

// The helpers an expression wrapper of type ty needs.
fn expr_decls(ty: String): String {
  "class ProbeCall {\n  pub fn pass(v: ${ty}): ${ty} {\n    v\n  }\n}\n\nfn probe_opt: ${ty}? {\n  nil\n}\n"
}

fn fill(site: String, body: String): String {
  out = ""
  lines = site.split("\n")
  for i in 0..lines.size {
    if i > 0 {
      out = "${out}\n"
    }
    if lines[i] == "@" {
      out = "${out}${body}"
    } else {
      out = "${out}${lines[i]}"
    }
  }
  out
}

fn program(r: PRule, w: String, safe: Bool): String {
  text = r.unsafe_text
  site = r.site
  if safe {
    text = r.safe_text
    site = r.safe_site
  }
  body = ""
  decls = prelude_decls()
  if r.kind == "stmt" {
    body = wrap_stmt(w, text)
  } else {
    body = wrap_expr(w, text)
    decls = "${decls}\n${expr_decls(r.ty)}"
  }
  filled = fill(site, body)
  // An import stays the program's first line.
  if filled.size > 7 && str_slice(filled, 0, 7) == "import " {
    nl = 0
    while filled[nl] != 10 {
      nl += 1
    }
    return "${str_slice(filled, 0, nl + 1)}\n${decls}\n${str_slice(filled, nl + 1, filled.size)}\nimport std.process\n"
  }
  // The opaque values read process.args(): its import goes last, so no
  // line moves.
  "${decls}\n${filled}\nimport std.process\n"
}

// The index of needle in hay at or after from, or -1; no allocation per
// position (the stress pass collects at every allocation).
fn find_at(hay: String, needle: String, from: Int): Int {
  if needle.size == 0 {
    return from
  }
  i = from
  while i + needle.size <= hay.size {
    k = 0
    while k < needle.size && hay[i + k] == needle[k] {
      k += 1
    }
    if k == needle.size {
      return i
    }
    i += 1
  }
  -1
}

// The first error line of a log ("" when none).
fn first_error(log: String): String {
  at = find_at(log, "error[", 0)
  if at < 0 {
    return ""
  }
  e = at
  while e < log.size && log[e] != 10 {
    e += 1
  }
  str_slice(log, at, e)
}

// The dumps of the rows n (1-based) with n % parts == part: each row's
// exit status goes to p<n>.code beside its log. The rows are
// independent programs, so `parts` tasks run them at once (the pool
// runs as many as the process has CPUs); main reads every row back in
// order, so the table is the same as one serial pass.
fn dump_part(compiler: String, dir: String, total: Int, parts: Int, part: Int): Int {
  done = 0
  for n in 1..total + 1 {
    if n % parts == part {
      src = "${dir}/p${n}.av"
      log = "${dir}/p${n}.log"
      code = run_out(compiler, ["dump", src], log) ?? -1
      _ = fs.write("${dir}/p${n}.code", "${code}")
      done += 1
    }
  }
  done
}

fn main: Int {
  compiler = process.env("AVANT_COMPILER") ?? ""
  if compiler.size == 0 {
    puts("tests/probe_matrix.av: AVANT_COMPILER is not set")
    return 1
  }
  root = process.env("AVANT_ROOT") ?? "."
  out_path = "${root}/tests/probe/matrix.txt"
  av = process.args()
  if av.size > 1 {
    out_path = av[1]
  }
  dir = probe_rt.avant_tmp_dir()
  _ = fs.write("${dir}/probe_mod.av", probe_mod_src())
  // Every program first, with what its row prints.
  names: Array(String) = []
  needles: Array(String) = []
  safes: Array(Bool) = []
  n = 0
  for r in rules() {
    ws = stmt_wrappers()
    if r.kind == "expr" {
      ws = expr_wrappers()
    }
    for w in ws {
      for v in 0..2 {
        safe = v == 1
        variant = "unsafe"
        if safe {
          variant = "safe"
        }
        n += 1
        _ = fs.write("${dir}/p${n}.av", program(r, w, safe))
        names.push("${r.name} ${w} ${variant}")
        needles.push(r.needle)
        safes.push(safe)
      }
    }
  }
  total = n
  parts = 8
  hs: Array(JoinHandle(Int)) = []
  for k in 0..parts {
    part = k
    hs.push(spawn { dump_part(compiler, dir, total, parts, part) })
  }
  ran = 0
  for h in hs {
    ran += h.join() ?? 0
  }
  if ran != total {
    puts("tests/probe_matrix.av: ${ran} of ${total} programs were checked")
    return 1
  }
  table = buf_new()
  table.push_str("# The probe matrix (tests/probe_matrix.av writes it; tests/cases/test_probe_matrix.av compares it).\n")
  table.push_str("# rule wrapper variant verdict class | first error line\n")
  for i in 0..total {
    m = i + 1
    log = "${dir}/p${m}.log"
    code = fs.read("${dir}/p${m}.code") ?? "-1"
    text = fs.read(log) ?? ""
    err = first_error(text)
    safe = safes[i]
    verdict = "accepted"
    if code != "0" {
      verdict = "refused"
    }
    cls = "ok"
    if safe && code != "0" {
      cls = "refused"
    } else if !safe && code == "0" {
      cls = "hole"
    } else if !safe && find_at(text, needles[i], 0) < 0 {
      cls = "other"
    }
    if code != "0" && code != "1" {
      verdict = "status-${code}"
    }
    table.push_str("${names[i]} ${verdict} ${cls} | ${err}\n")
    if code == "0" {
      _ = fs.write(log, "")
    }
  }
  if r = fs.write(out_path, table.to_s()) {
    return 0
  }
  puts("tests/probe_matrix.av: cannot write ${out_path}")
  1
}

// Runs the program with its stdout and stderr both written to the file
// out, in the order it wrote them (through sh's redirection, which is
// what the file then holds): the exit status, or the failure to start sh.
fn run_out(program: String, args: Array(String), out: String): Int | ProcessError {
  sh_args = ["-c", "out=$1; shift; exec \"$@\" > \"$out\" 2>&1", "sh", out, program]
  for a in args {
    sh_args.push(a)
  }
  process.run("/bin/sh", sh_args)
}
