fn str_eq(a: String, b: String): Bool {
  if a.size != b.size {
    return false
  }
  i = 0
  while i < a.size {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn str_has(hay: String, needle: String): Bool {
  if needle.size > hay.size {
    return false
  }
  if needle.size == 0 {
    return true
  }
  i = 0
  while i + needle.size <= hay.size {
    if str_eq(str_slice(hay, i, i + needle.size), needle) {
      return true
    }
    i = i + 1
  }
  false
}

fn str_ends(s: String, suf: String): Bool {
  if suf.size > s.size {
    return false
  }
  str_eq(str_slice(s, s.size - suf.size, s.size), suf)
}

fn fmt_counts(bad: Int, ok: Int): String {
  total = bad + ok
  if bad == 0 {
    return "${ok} passed, ${total} total"
  }
  if ok == 0 {
    return "${bad} failed, ${total} total"
  }
  "${bad} failed, ${ok} passed, ${total} total"
}

fn nth_line(s: String, n: Int): String {
  start = 0
  i = 0
  line = 0
  while i < s.size {
    if s[i] == 10 {
      if line == n {
        return str_slice(s, start, i)
      }
      line = line + 1
      start = i + 1
    }
    i = i + 1
  }
  if line == n {
    return str_slice(s, start, s.size)
  }
  ""
}

fn count_lines(s: String): Int {
  n = 0
  i = 0
  while i < s.size {
    if s[i] == 10 {
      n = n + 1
    }
    i = i + 1
  }
  n
}

fn xml_escape(s: String): String {
  b = buf_new()
  i = 0
  while i < s.size {
    c = s[i]
    if c == 38 {
      b.push_str("&amp;")
    } else if c == 60 {
      b.push_str("&lt;")
    } else if c == 62 {
      b.push_str("&gt;")
    } else if c == 34 {
      b.push_str("&quot;")
    } else if c == 39 {
      b.push_str("&apos;")
    } else {
      b.push_byte(c)
    }
    i = i + 1
  }
  b.to_s
}

fn junit_path: String {
  if v = env_get("AVANT_JUNIT") {
    if str_eq(v, "0") {
      return ""
    }
    if v.size > 0 {
      return v
    }
  }
  "junit.xml"
}

fn avant_test_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  "."
}

class Checks {
  passed: Int = 0
  failed: Int = 0
  suites_ok: Int = 0
  suites_bad: Int = 0
  suite_name: String = ""
  suite_failed_at: Int = 0
  started: Int = 0
  lines: Array(String)
  junit_class: Array(String)
  junit_name: Array(String)
  junit_fail: Array(Int)
  junit_detail: Array(String)

  fn initialize {
    ls: Array(String) = []
    self.lines = ls
    jc: Array(String) = []
    self.junit_class = jc
    jn: Array(String) = []
    self.junit_name = jn
    jf: Array(Int) = []
    self.junit_fail = jf
    jd: Array(String) = []
    self.junit_detail = jd
  }

  fn record_case(ok: Bool, name: String, detail: String) {
    self.junit_class.push(self.suite_name)
    self.junit_name.push(name)
    if ok {
      self.junit_fail.push(0)
    } else {
      self.junit_fail.push(1)
    }
    self.junit_detail.push(detail)
  }

  fn flush_suite {
    if self.suite_name.size == 0 {
      return
    }
    nfail = self.failed - self.suite_failed_at
    if nfail == 0 {
      puts(" PASS  ${self.suite_name}")
      self.suites_ok = self.suites_ok + 1
    } else {
      puts(" FAIL  ${self.suite_name}")
      self.suites_bad = self.suites_bad + 1
    }
    i = 0
    while i < self.lines.size {
      puts(self.lines[i])
      i = i + 1
    }
    empty: Array(String) = []
    self.lines = empty
    self.suite_name = ""
  }

  fn suite(name: String) {
    self.flush_suite()
    self.suite_name = name
    self.suite_failed_at = self.failed
  }

  fn expect(cond: Bool, msg: String) {
    if cond {
      self.passed = self.passed + 1
      self.lines.push("    ✓ ${msg}")
      self.record_case(true, msg, "")
    } else {
      self.failed = self.failed + 1
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
      self.record_case(false, msg, msg)
    }
  }

  fn eq_int(got: Int, want: Int, msg: String) {
    if got == want {
      self.passed = self.passed + 1
      self.lines.push("    ✓ ${msg}")
      self.record_case(true, msg, "")
    } else {
      self.failed = self.failed + 1
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
      self.lines.push("    got ${got}, want ${want}")
      self.lines.push("")
      self.record_case(false, msg, "got ${got}, want ${want}")
    }
  }

  fn eq_str(got: String, want: String, msg: String) {
    if str_eq(got, want) {
      self.passed = self.passed + 1
      self.lines.push("    ✓ ${msg}")
      self.record_case(true, msg, "")
    } else {
      self.failed = self.failed + 1
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
      self.lines.push("    got ${got}, want ${want}")
      self.lines.push("")
      self.record_case(false, msg, "got ${got}, want ${want}")
    }
  }

  fn write_junit(ms: Int) {
    path = junit_path()
    if path.size == 0 {
      return
    }
    total = self.passed + self.failed
    sec = ms / 1000
    b = buf_new()
    b.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    b.push_str("<testsuites tests=\"")
    b.push_fmt_i(total)
    b.push_str("\" failures=\"")
    b.push_fmt_i(self.failed)
    b.push_str("\" time=\"")
    b.push_fmt_i(sec)
    b.push_str("\">\n")
    i = 0
    while i < self.junit_name.size {
      class_name = self.junit_class[i]
      j = i
      n = 0
      bad = 0
      while j < self.junit_name.size {
        if str_eq(self.junit_class[j], class_name) {
          n = n + 1
          if self.junit_fail[j] != 0 {
            bad = bad + 1
          }
          j = j + 1
        } else {
          break
        }
      }
      b.push_str("  <testsuite name=\"")
      b.push_str(xml_escape(class_name))
      b.push_str("\" tests=\"")
      b.push_fmt_i(n)
      b.push_str("\" failures=\"")
      b.push_fmt_i(bad)
      b.push_str("\">\n")
      k = i
      while k < j {
        b.push_str("    <testcase name=\"")
        b.push_str(xml_escape(self.junit_name[k]))
        b.push_str("\" classname=\"")
        b.push_str(xml_escape(class_name))
        b.push_str("\"")
        if self.junit_fail[k] != 0 {
          b.push_str(">\n      <failure message=\"")
          b.push_str(xml_escape(self.junit_detail[k]))
          b.push_str("\"/>\n    </testcase>\n")
        } else {
          b.push_str("/>\n")
        }
        k = k + 1
      }
      b.push_str("  </testsuite>\n")
      i = j
    }
    b.push_str("</testsuites>\n")
    dummy = file_write(path, b.to_s)
  }

  fn finish {
    self.flush_suite()
    ms = now_ms() - self.started
    puts("")
    puts("Test Suites: ${fmt_counts(self.suites_bad, self.suites_ok)}")
    puts("Tests:       ${fmt_counts(self.failed, self.passed)}")
    puts("Time:        ${ms} ms")
    puts("Ran all test suites.")
    self.write_junit(ms)
  }
}

fn empty_strs: Array(String) {
  a: Array(String) = []
  a
}

fn chmod_x(path: String) {
  args: Array(String) = []
  args.push("+x")
  args.push(path)
  dummy = process_run("/bin/chmod", args)
}

fn compile_av(compiler: String, src: String, bin: String, log: String): Int {
  args: Array(String) = []
  args.push("compile")
  args.push(src)
  args.push(bin)
  process_run_out(compiler, args, log)
}

fn compile_av_flags(compiler: String, src: String, bin: String, log: String, extra: Array(String)): Int {
  args: Array(String) = []
  args.push("compile")
  args.push(src)
  args.push(bin)
  i = 0
  while i < extra.size {
    args.push(extra[i])
    i = i + 1
  }
  process_run_out(compiler, args, log)
}

fn dump_av(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(src)
  process_run_out(compiler, args, log)
}

fn dump_lex(dumper: String, flag: String, src: String, log: String): Int {
  args: Array(String) = []
  if flag.size > 0 {
    args.push(flag)
  }
  args.push(src)
  process_run_out(dumper, args, log)
}

fn run_av_bin(bin: String, log: String): Int {
  process_run_out(bin, empty_strs(), log)
}

fn run_av_cmd(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("run")
  args.push(src)
  process_run_out(compiler, args, log)
}

fn run_av_cmd_flags(compiler: String, src: String, log: String, extra: Array(String)): Int {
  args: Array(String) = []
  args.push("run")
  args.push(src)
  i = 0
  while i < extra.size {
    args.push(extra[i])
    i = i + 1
  }
  process_run_out(compiler, args, log)
}

fn compile_av_cov(compiler: String, src: String, bin: String, log: String): Int {
  args: Array(String) = []
  args.push("compile")
  args.push("--coverage")
  args.push(src)
  args.push(bin)
  process_run_out(compiler, args, log)
}

fn dump_av_cov(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push("--coverage")
  args.push(src)
  process_run_out(compiler, args, log)
}

fn write_tmp(stamp: Int, name: String, body: String): String {
  path = "/tmp/avant-s10-${stamp}-${name}"
  dummy = file_write(path, body)
  path
}
