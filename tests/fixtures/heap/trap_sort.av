// A comparator that traps stops the program in the middle of the sort,
// with its message and position, exit status 1: here at its 5,000th
// comparison, inside a merge of 1,000 elements.

fn main {
  xs: Array(Int) = []
  for i in 0..1000 {
    xs.push((i * 7919) % 1000)
  }
  calls = 0
  xs.sort((a, b) {
    calls += 1
    if calls == 5000 {
      panic("comparator stopped at ${calls}")
    }
    a < b
  })
  puts("not reached")
}
