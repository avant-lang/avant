// C36 (Stage 28 W14a2, D204): the header bit MARKED was both the full
// collection's mark and the young collection's "already scanned this
// cycle". A full collection left it set on every survivor, so the next
// young collection read it as scanned and skipped a mature or large
// object named by a root, breaking R1' (gc-design.md §1.3). An array
// literal relies on R1': its buffer is filled without a barrier (the
// fresh-store exemption) while a root slot names it. Here each literal
// runs a full and then a young collection in the middle of its fill,
// after young strings were stored: before the fix the young collection
// did not scan the buffer, those strings were not copied, and the
// buffer named freed nursery memory. Default environment, all three
// modes: 40 bad elements in part 1 and 1,919 bad fields in part 2
// (1,376 under AVANT_YOUNG_MB=1); AVANT_GC_VERIFY=1 printed 3,920 lost
// field reference lines; AVANT_NURSERY=0 runs no young collection, so
// it was right. Part 1's buffer is a block object tenured by two young
// collections before the stores; part 2's is a large object (34
// elements of a 256-byte struct), mature from birth. Every line prints
// 0.

lib gc {
  fun avant_gc_collect()
  fun avant_gc_collect_young()
}

fn s(k: Int): String {
  "elem-${k}"
}

// Collections inside the fill. Their results are string literals (not
// heap objects), so the buffer holds no young object when it tenures and
// is not remembered.
fn young(k: Int): String {
  gc.avant_gc_collect_young()
  "young"
}

fn full(k: Int): String {
  gc.avant_gc_collect()
  "full"
}

fn fill(r: Int): Array(String) {
  ["first", young(r + 1), young(r + 2), s(r + 3), s(r + 4), full(r + 5), young(r + 6), s(r + 7), s(r + 8)]
}

fn want(r: Int, k: Int): String {
  if k == 0 {
    return "first"
  }
  if k == 1 || k == 2 || k == 6 {
    return "young"
  }
  if k == 5 {
    return "full"
  }
  "elem-${r + k}"
}

fn churn(n: Int): Int {
  keep: Array(String) = []
  for k in 0..n {
    keep.push("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz-${k}")
  }
  keep.size
}

fn part1: Int {
  bad = 0
  for r in 0..20 {
    a = fill(r * 10)
    j = churn(2000)
    if j != 2000 {
      bad += 1
    }
    for k in 0..a.size {
      if a[k] != want(r * 10, k) {
        bad += 1
      }
    }
  }
  bad
}

struct Wide {
  f0: String
  f1: String
  f2: String
  f3: String
  f4: String
  f5: String
  f6: String
  f7: String
  f8: String
  f9: String
  f10: String
  f11: String
  f12: String
  f13: String
  f14: String
  f15: String
  f16: String
  f17: String
  f18: String
  f19: String
  f20: String
  f21: String
  f22: String
  f23: String
  f24: String
  f25: String
  f26: String
  f27: String
  f28: String
  f29: String
  f30: String
  f31: String
}

fn w(k: Int): Wide {
  Wide {
    f0: "w-${k}-0",
    f1: "w-${k}-1",
    f2: "w-${k}-2",
    f3: "w-${k}-3",
    f4: "w-${k}-4",
    f5: "w-${k}-5",
    f6: "w-${k}-6",
    f7: "w-${k}-7",
    f8: "w-${k}-8",
    f9: "w-${k}-9",
    f10: "w-${k}-10",
    f11: "w-${k}-11",
    f12: "w-${k}-12",
    f13: "w-${k}-13",
    f14: "w-${k}-14",
    f15: "w-${k}-15",
    f16: "w-${k}-16",
    f17: "w-${k}-17",
    f18: "w-${k}-18",
    f19: "w-${k}-19",
    f20: "w-${k}-20",
    f21: "w-${k}-21",
    f22: "w-${k}-22",
    f23: "w-${k}-23",
    f24: "w-${k}-24",
    f25: "w-${k}-25",
    f26: "w-${k}-26",
    f27: "w-${k}-27",
    f28: "w-${k}-28",
    f29: "w-${k}-29",
    f30: "w-${k}-30",
    f31: "w-${k}-31",
  }
}

fn wfull(k: Int): Wide {
  gc.avant_gc_collect()
  w(k)
}

fn wyoung(k: Int): Wide {
  gc.avant_gc_collect_young()
  w(k)
}

fn wide_bad(x: Wide, k: Int): Int {
  bad = 0
  if x.f0 != "w-${k}-0" {
    bad += 1
  }
  if x.f1 != "w-${k}-1" {
    bad += 1
  }
  if x.f2 != "w-${k}-2" {
    bad += 1
  }
  if x.f3 != "w-${k}-3" {
    bad += 1
  }
  if x.f4 != "w-${k}-4" {
    bad += 1
  }
  if x.f5 != "w-${k}-5" {
    bad += 1
  }
  if x.f6 != "w-${k}-6" {
    bad += 1
  }
  if x.f7 != "w-${k}-7" {
    bad += 1
  }
  if x.f8 != "w-${k}-8" {
    bad += 1
  }
  if x.f9 != "w-${k}-9" {
    bad += 1
  }
  if x.f10 != "w-${k}-10" {
    bad += 1
  }
  if x.f11 != "w-${k}-11" {
    bad += 1
  }
  if x.f12 != "w-${k}-12" {
    bad += 1
  }
  if x.f13 != "w-${k}-13" {
    bad += 1
  }
  if x.f14 != "w-${k}-14" {
    bad += 1
  }
  if x.f15 != "w-${k}-15" {
    bad += 1
  }
  if x.f16 != "w-${k}-16" {
    bad += 1
  }
  if x.f17 != "w-${k}-17" {
    bad += 1
  }
  if x.f18 != "w-${k}-18" {
    bad += 1
  }
  if x.f19 != "w-${k}-19" {
    bad += 1
  }
  if x.f20 != "w-${k}-20" {
    bad += 1
  }
  if x.f21 != "w-${k}-21" {
    bad += 1
  }
  if x.f22 != "w-${k}-22" {
    bad += 1
  }
  if x.f23 != "w-${k}-23" {
    bad += 1
  }
  if x.f24 != "w-${k}-24" {
    bad += 1
  }
  if x.f25 != "w-${k}-25" {
    bad += 1
  }
  if x.f26 != "w-${k}-26" {
    bad += 1
  }
  if x.f27 != "w-${k}-27" {
    bad += 1
  }
  if x.f28 != "w-${k}-28" {
    bad += 1
  }
  if x.f29 != "w-${k}-29" {
    bad += 1
  }
  if x.f30 != "w-${k}-30" {
    bad += 1
  }
  if x.f31 != "w-${k}-31" {
    bad += 1
  }
  bad
}

// The buffer is 34 x 256 bytes: a large object, mature from birth.
fn wide_fill(r: Int): Array(Wide) {
  [w(r + 0), w(r + 1), wfull(r + 2), wyoung(r + 3), w(r + 4), w(r + 5), w(r + 6), w(r + 7), w(r + 8), w(r + 9), w(r + 10), w(r + 11), w(r + 12), w(r + 13), w(r + 14), w(r + 15), w(r + 16), w(r + 17), w(r + 18), w(r + 19), w(r + 20), w(r + 21), w(r + 22), w(r + 23), w(r + 24), w(r + 25), w(r + 26), w(r + 27), w(r + 28), w(r + 29), w(r + 30), w(r + 31), w(r + 32), w(r + 33)]
}

fn part2: Int {
  bad = 0
  for r in 0..20 {
    a = wide_fill(r * 100)
    j = churn(2000)
    if j != 2000 {
      bad += 1
    }
    for k in 0..a.size {
      bad += wide_bad(a[k], r * 100 + k)
    }
  }
  bad
}

fn main {
  puts("block buffer bad: ${part1()}")
  puts("large buffer bad: ${part2()}")
}
