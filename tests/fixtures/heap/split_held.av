// C35 (Stage 28 W13b, D204): avant_str_split, avant_str_fields and
// chars_build (String.chars, Bytes.chars) kept their fresh strings only
// in a malloc'ed items[] array while each string was made by dup_bytes,
// whose own avant_gc_defer_enter was an outermost one. Under
// AVANT_NURSERY=0 an outermost enter may run a full collection, which
// does not see items[], so it swept the strings made before it and the
// array came back naming freed lines that later allocations reused. Each
// part here splits a 3,000-part text many times, with a varying amount
// of other allocation between, so full collections land inside the
// helpers, and checks every part. Before the fix AVANT_NURSERY=0 printed
// thousands of bad parts (split alone: 18,956 in the W13b probe); the
// default environment never collected inside the helpers before Stage
// 28 W16a (since W16a they collect at their own allocations). Every line
// prints 0.

fn text_of(sep: String): String {
  b = buf_new()
  for i in 0..3000 {
    if i > 0 {
      b.push_str(sep)
    }
    b.push_str("word-number-")
    b.push_fmt_i(i)
  }
  b.to_s
}

fn letters(n: Int): String {
  b = buf_new()
  for i in 0..n {
    b.push_byte(97 + i % 26)
  }
  b.to_s
}

fn junk(r: Int): Int {
  keep: Array(String) = []
  k = 0
  while k < 500 + r * 37 % 2900 {
    keep.push("zzzzzzzzzzzzzzzzzzzz-${k}")
    k = k + 1
  }
  keep.size
}

fn check(parts: Array(String)): Int {
  bad = 0
  if parts.size != 3000 {
    return 3000
  }
  for k in 0..3000 {
    if parts[k] != "word-number-${k}" {
      bad = bad + 1
    }
  }
  bad
}

fn chars_bad(cs: Array(String), text: String): Int {
  bad = 0
  if cs.size != text.size {
    return text.size
  }
  for k in 0..cs.size {
    if cs[k].size != 1 || cs[k][0] != text[k] {
      bad = bad + 1
    }
  }
  bad
}

fn main {
  text = text_of(" ")
  spaced = text_of("  \t ")
  short = letters(3000)
  rounds = 700
  // Every round runs in every environment. Under AVANT_GC_STRESS=1 every
  // part's allocation runs a young collection; since card marking (Stage
  // 28 W16t, O64) each one scans only the cards of the array being filled
  // that its last stores marked, not the whole array, so the 700 rounds
  // no longer need the cap the stress mode had (W16a: 3 rounds, with the
  // junk moved before each helper).
  split_bad = 0
  fields_bad = 0
  chars = 0
  n = 0
  for r in 0..rounds {
    parts = text.split(" ")
    n = n + junk(r)
    split_bad = split_bad + check(parts)
  }
  for r in 0..rounds {
    fs = spaced.fields()
    n = n + junk(r)
    fields_bad = fields_bad + check(fs)
  }
  for r in 0..rounds {
    cs = short.chars
    n = n + junk(r)
    chars = chars + chars_bad(cs, short)
  }
  puts("split bad: ${split_bad}")
  puts("fields bad: ${fields_bad}")
  puts("chars bad: ${chars}")
  puts("junk: ${n}")
}
