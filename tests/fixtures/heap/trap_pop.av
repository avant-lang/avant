// pop on an empty array (Stage 28 W10b, C9): pop reads the element at
// size - 1, so an empty array traps as indexing it there does, with the
// index trap's message ("index -1 out of bounds (size 0)") and exit
// status 1, on both back ends. Until W10b an array of non-references
// segfaulted (the runtime's pop slot was null) and an array of
// references yielded a null reference.

struct Pair {
  a: Int
  b: String
}

fn main {
  ns = [1, 2]
  puts(ns.pop + ns.pop)
  ps: Array(Pair) = [Pair { a: 3, b: "p" }]
  q = ps.pop()
  puts("${q.a} ${q.b}")
  ss = ["s"]
  puts(ss.pop)
  puts(ns.size + ps.size + ss.size)
  puts(ns.pop)
  puts("not reached")
}
