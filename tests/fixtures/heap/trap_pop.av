// pop gives the last element as an optional, nil on an empty array; the
// trapping form is xs.pop().expect("why"), which stops the program with
// its message and position, exit status 1. (An array of non-references
// once segfaulted on an empty pop, and an array of references yielded a
// null reference.)

struct Pair {
  a: Int
  b: String
}

fn main {
  ns = [1, 2]
  puts(ns.pop().expect("ns has two") + ns.pop().expect("ns has one"))
  ps: Array(Pair) = [Pair { a: 3, b: "p" }]
  q = ps.pop().expect("ps has one")
  puts("${q.a} ${q.b}")
  ss = ["s"]
  puts(ss.pop() ?? "none")
  puts(ss.pop() ?? "none")
  puts(ns.size + ps.size + ss.size)
  puts(ns.pop().expect("ns is not empty"))
  puts("not reached")
}
