// A row read in a loop at an index past the outer array traps at its own
// check, on the loop's first iteration, as it did before rows were
// loaded once before the loop: index 3 out of bounds (size 3).

fn total(g: Array(Array(Int)), y: Int, w: Int): Int {
  n = 0
  for x in 0..w {
    n += g[y][x]
  }
  n
}

fn main {
  g = Array(Array(Int)).new(3, (i) { Array(Int).new(4, (j) { i + j }) })
  puts(total(g, 2, 4))
  puts(total(g, 3, 4))
}
