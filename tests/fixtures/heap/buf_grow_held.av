// A growth frees the old storage at once (Stage 28 W18M, O109;
// avant_gc_large_drop) only when no root names it. `b[3] += grow_it(b, n)`
// reads the place (the data pointer, held in a root slot across the call)
// before the call that grows b: the old storage must stay until the store
// lands in it (where it is lost, as it always was: the language evaluates
// the place first), so the program prints what it printed before the
// drop, and the later growths free their old storage (los_drops).
fn grow_it(b: Buf, n: Int): Int {
  i = 0
  while i < n {
    b.push_byte(98)
    i = i + 1
  }
  5
}

fn main {
  b = buf_new()
  i = 0
  while i < 7000 {
    b.push_byte(97)
    i = i + 1
  }
  b[3] += grow_it(b, 20000)
  puts("${b[3]} ${b.size} ${b[7001]}")
}
