// A JoinHandle joined twice or more returns
// the same result every time (future semantics). Once a spawn stopped pinning its task,
// the join freed the task, so a second join read freed memory and freed
// it again. Handles in an array, in a class field and in a local are
// joined two or three times, with young and full collections and
// allocation between the joins (under AVANT_YOUNG_MB=1 the handles move
// between joins). No pin is left after the joins (that fix's gain). Prints
// the sums, the bad count and the pins left.

lib gc_rt {
  fun avant_pin_count: Int
  fun avant_gc_collect
  fun avant_gc_collect_young
}

class Holder {
  h: JoinHandle(Int)

  fn initialize(h: JoinHandle(Int)) {
    self.h = h
  }
}

fn work(n: Int): Int {
  acc = 0
  for i in 0..n {
    acc = acc &+ i * 3
  }
  acc + n
}

// Strings and arrays made and dropped, so young collections run.
fn churn(rounds: Int): Int {
  total = 0
  for r in 0..rounds {
    keep: Array(String) = []
    for i in 0..200 {
      keep.push("churn-${r}-${i}")
    }
    total += keep[r % 200].size
  }
  total
}

fn main {
  base = gc_rt.avant_pin_count()
  bad = 0

  // Handles in an array, each joined three times.
  hs: Array(JoinHandle(Int)) = []
  for i in 0..16 {
    n = 1000 + i * 7
    hs.push(spawn { work(n) })
  }
  first: Array(Int) = []
  s1 = 0
  i = 0
  while i < hs.size {
    v = hs[i].join() ?? -1
    first.push(v)
    s1 += v
    i += 1
  }
  churn(300)
  gc_rt.avant_gc_collect_young()
  s2 = 0
  for i in 0..hs.size {
    v = hs[i].join() ?? -1
    if v != first[i] {
      bad += 1
    }
    s2 += v
  }
  gc_rt.avant_gc_collect()
  s3 = 0
  i = 0
  while i < hs.size {
    v = hs[i].join() ?? -1
    if v != first[i] || v != work(1000 + i * 7) {
      bad += 1
    }
    s3 += v
    i += 1
  }
  puts("array: ${s1} ${s2} ${s3}")

  // A handle in a class field, joined twice with collections between.
  tag = "field"
  holder = Holder.new(spawn { work(500) + tag.size })
  a = holder.h.join() ?? -1
  churn(300)
  gc_rt.avant_gc_collect_young()
  gc_rt.avant_gc_collect()
  b = holder.h.join() ?? -1
  if a != b {
    bad += 1
  }
  puts("field: ${a} ${b}")

  // A local handle joined twice, and a second join of a task that had
  // long finished before its first join.
  h = spawn { 42 }
  churn(100)
  x = h.join() ?? -1
  y = h.join() ?? -1
  z = h.join() ?? -1
  if x != 42 || y != 42 || z != 42 {
    bad += 1
  }
  puts("local: ${x} ${y} ${z}")

  // Many handles, each joined twice in a row.
  t = 0
  for i in 0..200 {
    s = "task-${i}"
    k = spawn { s.size }
    p = k.join() ?? -1
    q = k.join() ?? -1
    if p != q {
      bad += 1
    }
    t = t + p + q
  }
  puts("loop: ${t}")
  puts("bad: ${bad}")
  puts("pins left: ${gc_rt.avant_pin_count() - base}")
}
