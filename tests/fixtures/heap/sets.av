// Set(T): add says whether the element was new, has whether it is
// there, delete whether it was (as a statement and as a value), size,
// clear, each, values and `for`; elements of every kind a Hash key takes (Int,
// Int32, String, an enum, a small and a wide struct). A set grows past
// several resizes and loses elements by delete; a set of fresh Strings
// is built while the collector runs (the fixture runs under the
// collector's modes); a set is a field, a parameter, a Hash's value and
// an Array's element, shared as a Hash is. The walks' results are sums
// or sorted, so they do not depend on the walk's order.

enum Dir { north, east, south, west }

struct Cell {
  x: Int32
  y: Int32
}

struct Spot {
  name: String
  at: Int
}

class Seen {
  pub names: Set(String) = Set(String).new()
}

fn check(what: String, ok: Bool) {
  if !ok {
    puts("FAIL ${what}")
  }
}

fn has(s: Set(T), x: T): Bool {
  s.has(x)
}

fn ints {
  s = Set(Int).new()
  fresh = 0
  i = 0
  while i < 5000 {
    if s.add(i * 7 % 3001) {
      fresh += 1
    }
    i += 1
  }
  check("ints fresh", fresh == s.size)
  gone = 0
  i = 0
  while i < 3001 {
    if i % 3 == 0 && s.delete(i) {
      gone += 1
    }
    i += 1
  }
  s.delete(1)
  check("ints deleted", !s.has(1) && !s.has(3) && s.has(2))
  t = 0
  s.each { |v| t += v }
  xs = s.values()
  xs.sort()
  puts("ints ${fresh} ${gone} ${s.size} ${t} ${xs[0]} ${xs[xs.size - 1]}")
}

fn narrow {
  s = Set(Int32).new()
  for v in [3, -1, 3, 40000, -1] {
    s.add(v.to_i32())
  }
  puts("narrow ${s.size} ${s.has(-1.to_i32())} ${s.has(4.to_i32())}")
}

fn words {
  s = Set(String).new()
  i = 0
  while i < 4000 {
    s.add("w${i % 1500}")
    i += 1
  }
  hits = 0
  i = 0
  while i < 2000 {
    if s.has("w${i}") {
      hits += 1
    }
    i += 1
  }
  check("words new", !s.add("w7") && s.add("new"))
  puts("words ${s.size} ${hits}")
}

fn kinds {
  dirs = Set(Dir).new()
  dirs.add(Dir.east)
  dirs.add(Dir.west)
  dirs.add(Dir.east)
  cells = Set(Cell).new()
  y = 0
  while y < 60 {
    x = 0
    while x < 60 {
      cells.add(Cell { x: x.to_i32(), y: (y / 2).to_i32() })
      x += 1
    }
    y += 1
  }
  spots = Set(Spot).new()
  spots.add(Spot { name: "a", at: 1 })
  spots.add(Spot { name: "a", at: 2 })
  spots.add(Spot { name: "${"a"}", at: 1 })
  check("spot", spots.has(Spot { name: "a", at: 2 }))
  puts("kinds ${dirs.size} ${dirs.has(Dir.north)} ${cells.size} ${spots.size}")
}

fn shared {
  seen = Seen.new()
  seen.names.add("x")
  by = Hash(String, Set(Int)).new()
  by["odd"] = Set(Int).new()
  by["even"] = Set(Int).new()
  for i in 0..100 {
    if i % 2 == 1 {
      if s = by["odd"] {
        s.add(i)
      }
    } else if s = by["even"] {
      s.add(i)
    }
  }
  all = [seen.names, Set(String).new()]
  all[1].add("y")
  odd = by["odd"] ?? Set(Int).new()
  puts("shared ${has(seen.names, "x")} ${odd.size} ${has(odd, 3)} ${all[1].size}")
  odd.clear()
  puts("cleared ${(by["odd"] ?? Set(Int).new()).size}")
}

// A set from an array literal where the type says Set, `[]` the empty
// one, `for` over a set, and a set returned and passed.
fn evens(n: Int): Set(Int) {
  s: Set(Int) = []
  for i in 0..n {
    s.add(i * 2)
  }
  s
}

fn count_in(s: Set(String), words: Array(String)): Int {
  n = 0
  for w in words {
    if s.has(w) {
      n += 1
    }
  }
  n
}

fn literals {
  primes: Set(Int) = [2, 3, 5, 7, 5, 3]
  t = 0
  for p in primes {
    t += p
  }
  names: Set(String) = ["ann", "bo", "${"ann"}"]
  e = evens(50)
  sum = 0
  for v in e {
    if v % 4 == 0 {
      sum += v
    }
  }
  puts("literals ${primes.size} ${t} ${names.size} ${count_in(names, ["bo", "cy", "ann"])} ${count_in([], ["bo"])} ${e.size} ${sum}")
}

fn main {
  literals()
  ints()
  narrow()
  words()
  kinds()
  shared()
}
