// A run of stores past a Buf's end traps at the first store whose index
// is outside it, with its own message, after the bytes before it were
// written: index 5 out of bounds (size 5).

fn put4(dst: Buf, di: Int) {
  dst[di] = 65
  dst[di + 1] = 66
  dst[di + 2] = 67
  dst[di + 3] = 68
}

fn main {
  b = Buf.new(5, 46)
  put4(b, 0)
  puts(b.to_s())
  put4(b, 2)
  puts(b.to_s())
}
