// Arrays of Int64, UInt64, Float64, and Bool on the new back end (Stage
// 28 W6c), and arrays built by push in a for over a range.

fn show(xs: Array(Int)): String {
  out = ""
  i = 0
  while i < xs.size {
    out = out + "${xs[i]} "
    i = i + 1
  }
  out
}

fn wides {
  ls = [10i64, -20i64, 30i64]
  ls.push(5i64)
  ls.sort
  puts(ls[0])
  puts(ls.sum)
  puts(ls.contains(30i64))
  ls[1] += 1000000000000i64
  puts(ls[1])

  us = [3u64, 1u64, 2u64]
  us.sort()
  puts(us[0])
  puts(us.sum)
  puts(us.pop)

  fs = [2.5, -1.25, 9.0]
  fs.push(0.5)
  fs.sort
  puts(fs[0])
  puts(fs.sum)
  puts(fs.contains(9.0))
  fs[2] = fs[2] * 2.0
  puts(fs[2])
  puts(fs.pop)

  bs = [true, false, true]
  bs.push(false)
  puts(bs.size)
  puts(bs.contains(false))
  bs.sort
  puts(bs[0])
  puts(bs[3])
  bs.fill(true)
  puts(bs[1])
  bs.reverse()
  puts(bs.pop)
}

fn grids {
  grid = Array(Int).new(0)
  for r in 0..4 {
    grid.push(r * 10)
  }
  puts(show(grid))
  n = 0
  for g in grid {
    if g > 15 {
      n = n + 1
    }
  }
  puts(n)
}

fn main {
  wides()
  grids()
}
