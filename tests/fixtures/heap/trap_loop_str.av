// A bounds trap below zero in a versioned loop over a string (Stage 28
// W9b, mir.md W9b): the variable starts at -2, so the guard's lower test
// fails and the checked copy traps on the first iteration that reads
// s[i - 1] with i - 1 < 0: index -1 out of bounds (size 5), after the
// line the first iteration prints.

fn main {
  s = "hello"
  n = s.size
  i = -2
  while i < n {
    if i >= 0 {
      puts(s[i])
    } else {
      puts(i)
    }
    puts(s[i + 1])
    i = i + 1
  }
}
