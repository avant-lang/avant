// gc-design.md §5.4 (Stage 28 W15a1): a no-GC region that alone
// allocates more than AVANT_HEAP_MAX_MB. No collection may run inside a
// region (C32), so its allocation proceeds past the limit and the full
// collection runs after the region; when the region by itself is over
// the limit, no collection after it could bring the heap back under it,
// and the program dies with "heap limit in a no-GC region (<function>)".
// Until Stage 28 W16a avant_str_split held its parts in one such region
// (C35's fix); since W16a it roots them (RC1, runtime/avant_gc.h) and
// needs none, so the region is opened here through the ABI names user C
// has (avant_gc_defer_enter/leave, RC4's region), around the same split.
// The live set outside the split is small: 300,000 one-letter words
// (600 KB of text) split into 300,000 strings and their array, about
// 10 MB in the region. Under AVANT_HEAP_MAX_MB=4 it dies so; without a
// limit it prints the part count.

lib gc_rt {
  fun avant_gc_defer_enter
  fun avant_gc_defer_leave
}

fn main {
  b = buf_new()
  for i in 0..300000 {
    b.push_str("x ")
  }
  text = b.to_s
  gc_rt.avant_gc_defer_enter()
  parts = text.split(" ")
  gc_rt.avant_gc_defer_leave()
  puts("parts: ${parts.size}")
}
