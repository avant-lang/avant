// Stores at di, di + 1, di + 2 and di + 3 of one Buf are proved together
// by one test before them; the bytes are those each store writes.

fn fill(dst: Buf, n: Int) {
  di = 0
  k = 0
  while di + 3 < n {
    dst[di] = 65 + k % 26
    dst[di + 1] = 97 + k % 26
    dst[di + 2] = 48 + k % 10
    dst[di + 3] = 45
    di += 4
    k += 1
  }
}

fn sum4(xs: Array(Int), i: Int): Int {
  xs[i] + xs[i + 1] * 10 + xs[i + 2] * 100 + xs[i - 1] * 1000
}

fn main {
  b = Buf.new(22, 0)
  fill(b, 22)
  puts(b.to_s())
  xs = [1, 2, 3, 4, 5, 6]
  puts(sum4(xs, 1))
  puts(sum4(xs, 3))
}
