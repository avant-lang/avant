// A derived clone recurses once per node: a list of 1,000,000 nodes is
// deeper than the stack holds, and the stack overflow names Node.clone.
class Node {
  v: Int = 0
  next: Node? = nil
}

fn main {
  head = Node.new()
  i = 0
  while i < 1000000 {
    n = Node.new()
    n.v = i
    n.next = head
    head = n
    i += 1
  }
  puts("built")
  c = head.clone()
  puts(c.v)
}
