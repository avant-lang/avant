// Slices of the four sequences: `xs[a..b]`, `xs[a..]`, `xs[..b]`,
// `xs[a..=b]`, `xs.slice(...)` and `try_slice`, `dup`; each a copy of the
// receiver's type. The array slices of references are kept past their
// sources through collections (the run goldens' collector modes).

class Node {
  pub id: Int = 0

  fn initialize(id: Int) {
    self.id = id
  }
}

fn arrays {
  xs = [5, 3, 8, 1, 9, 2]
  a = xs[1..3]
  b = xs[2..]
  c = xs[..2]
  d = xs[1..=3]
  e = xs[..]
  puts("arrays ${a.size} ${a[0]} ${b.size} ${b[0]} ${c[1]} ${d.size} ${d[2]} ${e.size} ${xs[6..].size} ${xs[3..3].size}")
  f = xs.slice(4)
  g = xs.slice(0, 1)
  g.push(70)
  puts("slice ${f[1]} ${g.size} ${xs[1]}")
  h = xs.dup()
  h[0] = 50
  puts("dup ${xs[0]} ${h[0]} ${h.size}")
  t1 = xs.try_slice(2, 4) ?? [-1]
  t2 = xs.try_slice(4, 2) ?? [-1]
  t3 = xs.try_slice(7) ?? [-1]
  t4 = xs.try_slice(-1, 2) ?? [-1]
  puts("try ${t1.size} ${t2[0]} ${t3[0]} ${t4[0]} ${(xs.try_slice(6) ?? [-1]).size}")
  empty: Array(Int) = []
  puts("empty ${empty[..].size} ${empty[0..0].size}")
}

fn refs {
  kept: Array(Array(Node)) = []
  i = 0
  while i < 200 {
    row: Array(Node) = []
    j = 0
    while j < 20 {
      row.push(Node.new(i * 100 + j))
      j += 1
    }
    kept.push(row[5..15])
    i += 1
  }
  junk = 0
  k = 0
  while k < 20000 {
    s = "${k}"
    junk += s.size
    k += 1
  }
  total = 0
  for r in kept {
    total += r[0].id + r[r.size - 1].id
  }
  puts("refs ${kept.size} ${kept[0].size} ${kept[199][0].id} ${total} ${junk}")
  words = ["a", "bb", "ccc", "dddd"]
  ws = words[1..]
  puts("strs ${ws[2]} ${words.dup()[0]}")
}

fn strings {
  t = "hello world"
  puts("${t[6..]}|${t[..5]}|${t[2..4]}|${t[0..=0]}|${t.slice(6)}|${t.slice(0, 2)}")
  puts("${t.try_slice(3, 99) ?? "none"}|${t.try_slice(3) ?? "none"}|${t.try_slice(11) ?? "none"}|${t[11..].size}")
  long = "abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij"
  part = long[10..]
  puts("${part.size} ${part[..4]}")
  bs = "abcdef".bytes
  puts("bytes ${bs[2..4] == "cd".bytes} ${bs[4..].size} ${bs[..1] == "a".bytes} ${(bs.try_slice(5, 9) ?? "-".bytes) == "-".bytes} ${bs.slice(3).size}")
}

fn bufs {
  b = Buf.new()
  b.push_str("xyz123")
  tail = b[3..]
  head = b[..3]
  puts("buf ${tail.to_s()} ${head.to_s()} ${b[1..=2].to_s()} ${b.slice(5).to_s()} ${(b.try_slice(2, 1) ?? Buf.new()).size}")
  tail.push_byte(33)
  puts("${b.to_s()} ${tail.to_s()}")
  b.push_str(tail)
  b.push_str("!".bytes)
  b.push_bytes(head)
  b.push_str(b)
  puts(b.to_s())
}

fn main {
  arrays()
  refs()
  strings()
  bufs()
}
