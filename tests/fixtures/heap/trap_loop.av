// A bounds trap inside a loop that loop versioning versions (Stage 28
// W9b, mir.md W9b): the guard fails (n - 1 + 1 is past the array), the
// checked copy runs, and the trap comes at the same iteration with the
// old message, after the same lines: index 6 out of bounds (size 6).

fn main {
  xs = [10, 20, 30, 40, 50, 60]
  n = xs.size
  i = 0
  while i < n {
    puts(xs[i] + xs[i + 1])
    i = i + 1
  }
}
