// The inner index of a row read in a loop runs past the row: the trap
// comes at the same iteration with the same message, after the same
// lines: index 4 out of bounds (size 4).

fn main {
  g = Array(Array(Int)).new(2, (i) { Array(Int).new(4, (j) { i * 4 + j }) })
  y = 1
  for x in 0..5 {
    puts(g[y][x])
  }
}
