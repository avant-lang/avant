// The builtins that give T? over an Array of a union: get, first, last,
// find, min_by, max_by, try_delete_at, pop and index_of, on a full and an
// empty array.
fn show(v: Int | String): String {
  switch v {
    case n: Int { "i${n}" }
    case s: String { "s${s}" }
  }
}

fn main {
  xs: Array(Int | String) = [1, "two", 3, "four"]
  if v = xs.get(1) {
    puts(show(v))
  }
  if v = xs.first() {
    puts(show(v))
  }
  if v = xs.last() {
    puts(show(v))
  }
  if v = xs.find((x) { show(x).size > 2 }) {
    puts(show(v))
  }
  if v = xs.min_by((x) { show(x).size }) {
    puts(show(v))
  }
  if v = xs.max_by((x) { show(x).size }) {
    puts(show(v))
  }
  if v = xs.try_delete_at(0) {
    puts(show(v))
  }
  if v = xs.pop() {
    puts(show(v))
  }
  puts(xs.index_of((x) { show(x) == "i3" }) ?? -1)
  ys: Array(Int | String) = []
  if v = ys.first() {
    puts(show(v))
  } else {
    puts("none")
  }
  if v = ys.pop() {
    puts(show(v))
  } else {
    puts("none")
  }
  puts(xs.size)
}
