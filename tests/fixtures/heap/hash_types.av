// Hash(K, V) for every key and value type: integer keys of each width
// (negative Int32 keys, UInt64 keys above Int's range), Bool and enum
// keys (a one-, a two- and a four-byte enum), String keys; integer, Bool,
// Float64, enum and String values. Each table grows past several
// resizes, loses keys by delete (as a statement and as a value), takes
// them back, and is walked by each, keys and values; `h[k] ?? d`, has_key,
// inc and clear on each kind. The walks' results are sums or sorted, so
// they do not depend on the walk's order.

enum Color { red, green, blue }

enum Wide { low = -70000, mid = 0, high = 70000 }

enum Port { http = 80, alt = 8080, top = 65535 }

fn check(what: String, ok: Bool) {
  if !ok {
    puts("FAIL ${what}")
  }
}

fn int32_keys {
  h = Hash(Int32, Int32).new()
  i = 0
  while i < 3000 {
    k = (i - 1500).to_i32()
    h[k] = (i * 3).to_i32()
    i += 1
  }
  check("int32 size", h.size == 3000)
  check("int32 neg", (h[-1500.to_i32()] ?? 0.to_i32()) == 0.to_i32())
  check("int32 last", (h[1499.to_i32()] ?? 0.to_i32()) == 8997.to_i32())
  check("int32 absent", !h.has_key(1500.to_i32()))
  // Delete every even key, as a statement and as a value.
  i = 0
  gone = 0
  while i < 3000 {
    k = (i - 1500).to_i32()
    if i % 4 == 0 {
      h.delete(k)
    } else if i % 4 == 2 {
      if v = h.delete(k) {
        gone += v.to_i()
      }
    }
    i += 1
  }
  check("int32 deleted", h.size == 1500)
  sum = 0
  h.each { |k, v|
    sum += v.to_i() - 3 * (k.to_i() + 1500)
  }
  check("int32 each", sum == 0)
  ks = h.keys()
  ks.sort()
  check("int32 keys", ks.size == 1500 && ks[0] == -1499.to_i32() && ks[ks.size - 1] == 1499.to_i32())
  vs = h.values()
  vt = 0
  for v in vs {
    vt += v.to_i()
  }
  puts("int32 ${h.size} ${gone} ${vt}")
  // The counting idiom on a narrow key and value: get, then set.
  c = Hash(Int32, Int32).new()
  for j in 0..100 {
    g = (j % 7).to_i32()
    if n = c.get(g) {
      c[g] = n + 1.to_i32()
    } else {
      c[g] = 1.to_i32()
    }
  }
  puts("bump ${c[0.to_i32()] ?? 0.to_i32()} ${c[6.to_i32()] ?? 0.to_i32()} ${c.size}")
  puts("inc ${c.inc(0.to_i32())} ${c.inc(9.to_i32(), 5.to_i32())} ${c[8.to_i32()] ?? -1.to_i32()}")
}

fn wide_keys {
  u = Hash(UInt64, Int).new()
  big = 18446744073709551615u64
  u[big] = 1
  u[big - 1u64] = 2
  u[0u64] = 3
  u[9223372036854775808u64] = 4
  check("u64 big", (u[big] ?? 0) == 1 && (u[0u64] ?? 0) == 3)
  check("u64 top bit", (u[9223372036854775808u64] ?? 0) == 4)
  t = 0
  u.each { |k, v|
    t += v
  }
  puts("u64 ${u.size} ${t}")
  w = Hash(UInt32, UInt32).new()
  for i in 0..500 {
    w[(4294967295 - i).to_u32()] = i.to_u32()
  }
  check("u32 top", (w[4294967295.to_u32()] ?? 1.to_u32()) == 0.to_u32())
  check("u32 low", (w[(4294967295 - 499).to_u32()] ?? 0.to_u32()) == 499.to_u32())
  puts("u32 ${w.size} ${w.inc(7.to_u32())}")
  n = Hash(Int, Int).new()
  n[-9223372036854775807 - 1] = 1
  n[9223372036854775807] = 2
  n[-1] = 3
  n[4294967296] = 4
  check("int extremes", (n[-9223372036854775807 - 1] ?? 0) == 1 && (n[9223372036854775807] ?? 0) == 2)
  check("int wide", (n[4294967296] ?? 0) == 4 && !n.has_key(0))
  puts("int ${n.size}")
}

fn small_keys {
  b = Hash(Bool, String).new()
  b[true] = "yes"
  b[false] = "no"
  b[true] = "still yes"
  puts("bool ${b.size} ${b[true] ?? ""} ${b[false] ?? ""}")
  b.delete(false)
  puts("bool ${b.size} ${b.has_key(false)} ${b[false] ?? "none"}")
  e = Hash(Color, Int).new()
  e[Color.red] = 1
  e[Color.blue] = 3
  e.inc(Color.blue)
  puts("color ${e.size} ${e[Color.blue] ?? 0} ${e.has_key(Color.green)}")
  wd = Hash(Wide, Wide).new()
  wd[Wide.low] = Wide.high
  wd[Wide.high] = Wide.low
  wd[Wide.mid] = Wide.mid
  if x = wd[Wide.low] {
    puts("wide ${x} ${wd.size}")
  }
  p = Hash(Port, Int32).new()
  p[Port.http] = 1.to_i32()
  p[Port.top] = 2.to_i32()
  p.inc(Port.alt, 7.to_i32())
  p.delete(Port.http)
  puts("port ${p.size} ${p[Port.top] ?? 0.to_i32()} ${p[Port.alt] ?? 0.to_i32()} ${p.has_key(Port.http)}")
}

fn values_of_every_kind {
  f = Hash(String, Float64).new()
  f["pi"] = 3.25
  f["e"] = 2.5
  f["neg"] = -0.125
  t = 0.0
  f.each { |k, v|
    t += v
  }
  puts("float ${f["pi"] ?? 0.0} ${f["none"] ?? 1.5} ${t}")
  if v = f.delete("e") {
    puts("float gone ${v} ${f.size}")
  }
  bv = Hash(Int, Bool).new()
  for i in 0..50 {
    bv[i] = i % 3 == 0
  }
  trues = 0
  for v in bv.values() {
    if v {
      trues += 1
    }
  }
  puts("bools ${bv.size} ${trues} ${bv[3] ?? false} ${bv[4] ?? true}")
  cv = Hash(String, Color).new()
  cv["sky"] = Color.blue
  cv["leaf"] = Color.green
  puts("colors ${cv["sky"] ?? Color.red} ${cv["rose"] ?? Color.red}")
  sv = Hash(Int, String).new()
  for i in 0..2000 {
    sv[i] = "v${i}"
  }
  i = 0
  while i < 2000 {
    if i % 3 != 0 {
      sv.delete(i)
    }
    i += 1
  }
  check("int-string kept", (sv[999] ?? "") == "v999" && (sv[1998] ?? "") == "v1998" && !sv.has_key(1000))
  total = 0
  sv.each { |k, v|
    check("int-string pair", v == "v${k}")
    total += k
  }
  puts("int-string ${sv.size} ${total}")
  sv.clear()
  sv[1] = "again"
  puts("int-string after clear ${sv.size} ${sv[1] ?? ""}")
}

fn string_keys {
  h = Hash(String, Int32).new()
  for i in 0..1000 {
    h["k${i}"] = i.to_i32()
  }
  for i in 0..1000 {
    if i % 2 == 1 {
      h.delete("k${i}")
    }
  }
  for i in 0..1000 {
    if i % 4 == 1 {
      h["k${i}"] = (i * 2).to_i32()
    }
  }
  check("string-int32 size", h.size == 750)
  check("string-int32 back", (h["k5"] ?? 0.to_i32()) == 10.to_i32() && !h.has_key("k7"))
  ks = h.keys()
  ks.sort()
  puts("string-int32 ${h.size} ${ks[0]} ${ks[ks.size - 1]} ${h.inc("k0", 3.to_i32())}")
  ss = Hash(String, String).new()
  ss["a"] = "x"
  ss["a"] = "y"
  ss["b"] = "z"
  vs = ss.values()
  vs.sort()
  puts("string-string ${ss.size} ${vs[0]} ${vs[1]}")
}

fn main {
  int32_keys()
  wide_keys()
  small_keys()
  values_of_every_kind()
  string_keys()
}
