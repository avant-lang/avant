// A recursion too deep for the main thread's stack: one line names the
// stack overflow, the function and the thread, after what the program
// printed, and the program ends with status 1 (before, a bare SIGSEGV,
// and the printed line was lost in stdout's buffer).
fn depth(n: Int): Int {
  if n == 0 {
    return 0
  }
  d = depth(n - 1)
  d + 1 + ((d + n) & 1)
}

fn main {
  puts("start")
  puts(depth(100000000))
}
