// A hash walk reads the table in place: deleting the visited key is
// allowed and every later step reads a live entry with its own value
// (never an invented 0 or ""), across growth and the collector's moves.

fn main {
  h = Hash(String, Int).new()
  h["a"] = 1
  h["b"] = 2
  h["c"] = 3
  h["d"] = 4
  seen = 0
  sum = 0
  h.each (k, v) {
    seen += 1
    sum += v
    if v % 2 == 0 {
      h.delete(k)
    }
  }
  puts("visited ${seen}, sum ${sum}, size ${h.size}")
  s = Hash(String, String).new()
  s["x"] = "one"
  s["y"] = "two"
  s["z"] = "three"
  n = 0
  empty = 0
  for k, v in s {
    n += 1
    if v.size == 0 {
      empty += 1
    }
    s.delete(k)
  }
  puts("visited ${n}, empty values ${empty}, size ${s.size}")
  m = Hash(Int, Int).new()
  for j in 0..1000 {
    m[j] = j + 1
  }
  zeros = 0
  visits = 0
  for k, v in m {
    visits += 1
    if v != k + 1 {
      zeros += 1
    }
    if k % 3 != 0 {
      m.delete(k)
    }
  }
  m.delete_if((k, v) { k % 2 == 0 })
  puts("visited ${visits} of 1000, wrong values ${zeros}, size ${m.size}")
}
