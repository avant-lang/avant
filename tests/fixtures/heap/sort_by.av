// sort_by sorts in place by a key computed once per element, stably;
// binary_search finds an element of a sorted array: the first equal one,
// or nil.

struct P {
  name: String
  age: Int
}

struct V {
  major: Int
  minor: Int

  fn compare(other: V): Int {
    if self.major != other.major {
      return self.major - other.major
    }
    self.minor - other.minor
  }
}

fn by_len(s: String): Int {
  s.size
}

fn main {
  ps = [P { name: "c", age: 3 }, P { name: "a", age: 1 }, P { name: "b", age: 3 }, P { name: "d", age: 2 }]
  calls = 0
  ps.sort_by((p) {
    calls += 1
    p.age
  })
  for p in ps {
    print(p.name)
  }
  puts()
  puts(calls)
  ws = ["pear", "fig", "banana", "kiwi"]
  ws.sort_by(by_len)
  puts(ws.join(","))
  ws.sort_by (w) { w }
  puts(ws.join(","))
  fs = [2.5, -1.0, 3.0]
  fs.sort_by((f) { 0.0 - f })
  puts(fs[0])
  e: Array(Int) = []
  e.sort_by((x) { x })
  puts(e.size)
  vs = [V { major: 2, minor: 0 }, V { major: 1, minor: 5 }, V { major: 1, minor: 2 }]
  ns = [0, 1, 2]
  ns.sort_by((i) { vs[i] })
  puts("${ns[0]}${ns[1]}${ns[2]}")
  xs = [1, 3, 3, 5, 9]
  puts(xs.binary_search(3) ?? -1)
  puts(xs.binary_search(4) ?? -1)
  puts(xs.binary_search(9) ?? -1)
  puts(xs.binary_search(0) ?? -1)
  puts(xs.binary_search(10) ?? -1)
  puts(ws.binary_search("kiwi") ?? -1)
  puts([0.5, 1.5].binary_search(1.5) ?? -1)
  puts([0.5, 0.0 / 0.0].binary_search(0.0 / 0.0) ?? -1)
  sorted_vs = vs.sorted()
  puts(sorted_vs.binary_search(V { major: 1, minor: 5 }) ?? -1)
  puts(sorted_vs.binary_search(V { major: 3, minor: 0 }) ?? -1)
  none: Array(Int) = []
  puts(none.binary_search(1) ?? -1)
}
