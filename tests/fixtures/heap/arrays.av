// Arrays of scalars on the new back end (Stage 28 W6c): literals, typed
// empty arrays, Array(T).new, indexing and index stores (plain and
// compound), size, push, pop, and every member without a block (sort,
// sorted, reverse, contains, sum, fill, clear, reserve) on Int, Int64,
// UInt64, Float64, and Bool elements, in their call and field forms;
// for over an array and a range; the old back end's evaluation orders
// (pinned by printing arguments).

fn say(s: String, v: Int): Int {
  puts(s)
  v
}

fn pick(s: String, xs: Array(Int)): Array(Int) {
  puts(s)
  xs
}

fn total(xs: Array(Int)): Int {
  t = 0
  for x in xs {
    t = t + x
  }
  t
}

fn show(xs: Array(Int)): String {
  out = ""
  i = 0
  while i < xs.size {
    out = out + "${xs[i]} "
    i = i + 1
  }
  out
}

fn make(n: Int): Array(Int) {
  xs = Array(Int).new(n)
  for i in 0..n {
    xs[i] = i * i
  }
  xs
}



fn main {
  xs = [5, 3, 9, 1, 7]
  puts(show(xs))
  puts(xs.size)
  puts(total(xs))
  xs.push(4)
  xs.push(say("push-arg", 8))
  puts(show(xs))
  puts(xs.pop)
  puts(xs.pop())
  xs.sort
  puts(show(xs))
  ys = xs.sorted
  ys.reverse
  puts(show(ys))
  puts(show(xs))
  puts(xs.contains(9))
  puts(xs.contains(10))
  puts(xs.sum)
  xs[0] += 100
  xs[1] -= 1
  xs[2] *= 3
  puts(show(xs))
  pick("recv", xs)[say("ix", 3)] = say("val", 42)
  puts(pick("recv2", xs)[say("ix2", 3)])
  pick("recv3", xs).reserve(say("n", 64))
  puts(xs.size)
  zs = make(6)
  puts(show(zs))
  zs.fill(7)
  puts(show(zs))
  zs.clear
  puts(zs.size)
  zs.push(1)
  zs.clear()
  puts(zs.size)
  e: Array(Int) = []
  puts(e.size)
  e.push(3)
  puts(e[0])
}
