// O688 (D371, Stage 29 W8Cb): a send of an Array copies it, at every
// level of an array of arrays, so the receiver owns an independent
// array: the sender writes after each send, and the receiver, which
// reads only after those writes, sees the values as sent.
import std.sync

fn main {
  flat = Channel(Array(Int)).new(2)
  nested = Channel(Array(Array(Int))).new(2)
  words = Channel(Array(String)).new(2)
  go = Channel(Int).new
  h = spawn {
    _ = go.recv
    got = 0
    if xs = flat.recv {
      got += xs[0] + xs.size
    }
    if ys = nested.recv {
      got += ys[0][0] * 10 + ys[1].size * 100
    }
    if ws = words.recv {
      if ws[1] == "b" {
        got += 1000
      }
    }
    got
  }
  xs = [1, 2, 3]
  flat.send(xs)
  xs[0] = 99
  xs.push(4)
  ys = [[5, 6], [7]]
  nested.send(ys)
  ys[0][0] = 77
  ys[1].push(8)
  ys.push([9])
  ws = ["a", "b"]
  words.send(ws)
  ws[1] = "z"
  go.send(1)
  // 1 + 3 (flat), 5 * 10 + 1 * 100 (nested), 1000 (words)
  puts(h.join ?? -1)
  puts(xs[0])
  puts(ys[0][0])
  // Many sends, the sender reusing one buffer: every value arrives as sent.
  many = Channel(Array(Int)).new(8)
  sum = spawn {
    total = 0
    while got = many.recv {
      total += got[0] * got.size
    }
    total
  }
  buf = [0, 0]
  for i in 1..1001 {
    buf[0] = i
    many.send(buf)
    buf[0] = -1
  }
  many.close
  puts(sum.join ?? -1)
}
