// As many consumers as the
// pool runs at once are spawned first and wait in recv, then one
// producer is spawned. A waiting task lets the pool start one more
// worker, so the producer runs and the program ends. Before, the
// producer never started and the program hung with no message. The
// number of consumers is the pool's bound (an argument overrides it;
// tests/cases/test_threads.av runs it with --avant-threads=1, 2, 4 and 16),
// and a Mutex waiter is counted the same way.
import std.sync

lib c {
  fun usleep(micros: UInt32): Int32
}

fn consumer(ch: Channel(Int)): Int {
  got = 0
  while v = ch.recv() {
    got += v
  }
  got
}

fn main {
  n = pool_size()
  args = argv()
  if args.size > 1 {
    n = args[1].to_i() ?? n
  }
  ch = Channel(Int).new(1)
  tasks: Array(JoinHandle(Int)) = []
  for i in 0..n {
    tasks.push(spawn {
      consumer(ch)
    })
  }
  // Let the consumers reach their recv before the producer is queued.
  wait: UInt32 = 200000
  _ = c.usleep(wait)
  producer = spawn {
    for i in 0..n {
      _ = ch.send(1)
    }
    ch.close()
    0
  }
  _ = producer.join()
  total = 0
  for t in tasks {
    total += t.join() ?? -1
  }
  puts(total == n)
  // Mutex waiters: tasks waiting for the lock while its holder waits on
  // a channel that a queued task fills.
  m = Mutex(Int).new(0)
  gate = Channel(Int).new()
  holder = spawn {
    m.with (x) {
      x += gate.recv() ?? 0
    }
    0
  }
  _ = c.usleep(wait)
  lockers: Array(JoinHandle(Int)) = []
  for i in 0..n {
    lockers.push(spawn {
      m.with (x) { x += 1 }
      0
    })
  }
  _ = c.usleep(wait)
  opener = spawn {
    _ = gate.send(100)
    0
  }
  _ = opener.join()
  _ = holder.join()
  for l in lockers {
    _ = l.join()
  }
  final = m.with (x) { x }
  puts(final == 100 + n)
}
