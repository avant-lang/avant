// The runtime's thread-local references are roots of
// every thread's collections, not only of the collecting thread's. Each
// of six tasks parses a JSON text through the runtime's entry alone
// (avant_json.c keeps the parse's pool in a thread-local slot until a
// Json value takes it, and here none does), so the slot is the pool's
// only reference while the task churns young strings and objects beside
// the main thread and the other tasks, and most collections run on
// another thread. Each task also parses a JSON document per round through
// std.json and reads a field and a string back. Every value is checked,
// and the program prints 0 wrong reads in every environment. With
// gc_each_runtime_root walking only the collecting thread's slots (the
// code before threads stopped for a collection), the verifier reports
// the slot, or a value reads back wrong.

import std.json

lib jroot {
  fun avant_json_parse(text: String, max_depth: Int, max_bytes: Int, max_entries: Int): Ptr(Void)
}

class Cell {
  v: Int
  s: String

  fn initialize(v: Int, s: String) {
    self.v = v
    self.s = s
  }
}

fn churn(id: Int, r: Int, n: Int): Int {
  keep: Array(Cell) = []
  bad = 0
  for i in 0..n {
    keep.push(Cell.new(i, "c${id}-${r}-${i}"))
    if keep.size > 40 {
      if keep[0].s.size < 5 {
        bad += 1
      }
      keep.clear()
    }
  }
  bad
}

fn work(id: Int, rounds: Int): Int {
  bad = 0
  for r in 0..rounds {
    _ = jroot.avant_json_parse("{\"w\": ${id}, \"r\": ${r}}", 256, -1, -1)
    bad += churn(id, r, 300)
    if doc = json.Json.parse("{\"id\": ${id}, \"round\": ${r}, \"name\": \"t${id}\"}") {
      bad += churn(id, r, 50)
      if n = doc.int("round") {
        if n != r {
          bad += 1
        }
      } else {
        bad += 1
      }
      if s = doc.str("name") {
        if s != "t${id}" {
          bad += 1
        }
      } else {
        bad += 1
      }
    } else {
      bad += 1
    }
  }
  bad
}

fn main {
  hs: Array(JoinHandle(Int)) = []
  for k in 0..6 {
    id = k
    hs.push(spawn { work(id, 40) })
  }
  mbad = 0
  for r in 0..120 {
    mbad += churn(99, r, 200)
  }
  wbad = 0
  hs.each (h) { wbad = wbad + (h.join() ?? -1) }
  puts("task bad reads: ${wbad}")
  puts("main bad reads: ${mbad}")
}
