// An Array a running task reads cannot change until the task
// ends: the checker refuses a change through the
// captured name, and at run time every other path (an alias, a call, a
// field holding the array) stops the program with a trap, status 1,
// naming the operation; in the task the trap ends the task, and the
// program prints the join's error and ends with status 1. The argument
// names the case; without one (the run goldens) it is sender-alias.
// Run by tests/cases/test_safety.av.
//
// In the sender's cases the task waits on a channel that is never sent
// to, so it is still running when the sender makes its change.

import std.sync

struct P {
  n: Int
}

// A method that changes its receiver writes the element it is called on
// directly, through a field's method, through a
// bare call of another such method.
struct Pos {
  x: Int

  fn move(d: Int) {
    self.x += d
  }
}

struct Q {
  n: Int
  pos: Pos

  fn bump {
    self.n = self.n + 1
  }

  fn shift {
    pos.move(1)
  }

  fn twice {
    bump()
    self.bump()
  }

  fn get: Int {
    self.n + pos.x
  }
}

// The sender's change to an element of a captured Array(Q), through a
// call: kind names the method.
fn change_q(kind: String, qs: Array(Q)) {
  if kind == "method" {
    qs[0].bump()
  } else if kind == "method-held" {
    qs[0].shift()
  } else if kind == "method-bare" {
    qs[0].twice()
  } else if kind == "method-field" {
    qs[0].pos.move(2)
  }
}

class Holder {
  pub xs: Array(Int) = []
}

fn grow(a: Array(Int)) {
  a.push(9)
}

fn bump(ps: Array(P)) {
  ps[0].n = 5
}

// The sender's change, through an alias, a call or a field; kind names
// the operation.
fn change(kind: String, xs: Array(Int)) {
  ys = xs
  if kind == "sender-alias" || kind == "push" {
    ys.push(4)
  } else if kind == "sender-call" {
    grow(xs)
  } else if kind == "sender-field" {
    ho = Holder.new()
    ho.xs = xs
    ho.xs.push(3)
  } else if kind == "pop" {
    _ = ys.pop()
  } else if kind == "clear" {
    ys.clear()
  } else if kind == "fill" {
    ys.fill(0)
  } else if kind == "sort" {
    ys.sort()
  } else if kind == "sort-block" {
    ys.sort { |a, b| a < b }
  } else if kind == "reverse" {
    ys.reverse()
  } else if kind == "reserve" {
    ys.reserve(100)
  } else if kind == "store" {
    ys[0] = 7
  } else if kind == "store-op" {
    ys[1] += 1
  }
}

fn main: Int {
  a = argv()
  kind = "sender-alias"
  if a.size > 1 {
    kind = a[a.size - 1]
  }
  puts("before")
  gate = Channel(Int).new()
  xs = [3, 1, 2]
  if kind == "task-alias" || kind == "task-call" || kind == "task-field" {
    // The task changes what it captured, through another path.
    h = spawn {
      if kind == "task-alias" {
        ys = xs
        ys.push(3)
      } else if kind == "task-call" {
        grow(xs)
      } else {
        ho = Holder.new()
        ho.xs = xs
        ho.xs.clear()
      }
      xs.size
    }
    // The trap ends the task (the runtime prints it), and its join gives
    // the trap.
    vh = h.join() else e {
      return 1
    }
    puts(vh)
    return 0
  }
  if kind == "element-field" {
    ps = [P { n: 1 }]
    h1 = spawn {
      _ = gate.recv()
      ps[0].n
    }
    bump(ps)
    gate.send(1)
    puts(h1.join() ?? -1)
    return 0
  }
  if kind == "method" || kind == "method-held" || kind == "method-bare" || kind == "method-field" {
    qs = [Q { n: 1, pos: Pos { x: 0 } }]
    h3 = spawn {
      _ = gate.recv()
      qs[0].get()
    }
    change_q(kind, qs)
    gate.send(1)
    puts(h3.join() ?? -1)
    return 0
  }
  if kind == "task-method" {
    // The task changes an element of what it captured through a call.
    qs2 = [Q { n: 1, pos: Pos { x: 0 } }]
    h4 = spawn {
      change_q("method", qs2)
      qs2[0].get()
    }
    // The trap ends the task (the runtime prints it), and its join gives
    // the trap.
    vh4 = h4.join() else e {
      return 1
    }
    puts(vh4)
    return 0
  }
  if kind == "nested" {
    xss = [[1, 2], [3]]
    h2 = spawn {
      _ = gate.recv()
      xss[0].size
    }
    inner = xss[0]
    inner.push(5)
    gate.send(1)
    puts(h2.join() ?? -1)
    return 0
  }
  if kind == "parallel" {
    ws = [1, 2, 3, 4]
    rs = [1, 2].parallel { |i| grow_and_size(ws, i) }
    puts(rs[0])
    return 0
  }
  h = spawn {
    _ = gate.recv()
    xs.size
  }
  change(kind, xs)
  gate.send(1)
  puts(h.join() ?? -1)
  0
}

fn grow_and_size(ws: Array(Int), i: Int): Int {
  if i == 2 {
    ws.push(i)
  }
  ws.size
}
