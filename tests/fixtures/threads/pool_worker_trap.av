// .join and .parallel reached through a call from a pool
// worker: they work, the joined task or the queued bodies running on
// the joining worker when no other worker took them. The argument says
// which: join or parallel. Run by tests/cases/test_safety.av; without
// an argument (the run goldens) it is parallel.

fn doubled(xs: Array(Int)): Int {
  ys = xs.parallel (x) { x * 2 }
  ys[0]
}

fn joined: Int {
  h = spawn { 1 }
  h.join() ?? -1
}

fn main: Int {
  a = process.args()
  kind = "parallel"
  if a.size > 1 {
    kind = a[a.size - 1]
  }
  puts("before")
  xs = [1, 2, 3]
  t = spawn {
    n = 0
    if kind == "join" {
      n = joined()
    } else {
      n = doubled(xs)
    }
    n
  }
  v = t.join() else e {
    return 1
  }
  puts(v)
  0
}

// Imported last, so no line the goldens name moves.
import std.process
