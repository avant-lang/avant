// .join and .parallel reached through a call from a pool
// worker. The checker refuses them written in a spawn block
// or a .parallel body; reached through a call, they trap: the
// trap ends the task, and the program prints the join's
// error, status 1. The argument says which: join or parallel.
// "before" comes first: a trap flushes stdout before it
// writes its line. Run by tests/cases/test_safety.av; without
// an argument (the run goldens) it is parallel.

fn doubled(xs: Array(Int)): Int {
  ys = xs.parallel (x) { x * 2 }
  ys[0]
}

fn joined: Int {
  h = spawn { 1 }
  h.join() ?? -1
}

fn main: Int {
  a = argv()
  kind = "parallel"
  if a.size > 1 {
    kind = a[a.size - 1]
  }
  puts("before")
  xs = [1, 2, 3]
  t = spawn {
    n = 0
    if kind == "join" {
      n = joined()
    } else {
      n = doubled(xs)
    }
    n
  }
  // The trap ends the task (the runtime prints it); its join gives the
  // trap.
  v = t.join() else e {
    return 1
  }
  puts(v)
  0
}
