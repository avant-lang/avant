// A Channel's or a Mutex's gate holds no memory outside its object:
// the runtime keeps state for a gate only while a thread uses it.
// Before, every gate was a C mutex and condition that nothing freed,
// about 94 bytes each: 300,000 channels and as many mutexes grew the
// peak RSS by about 56 MB. The program makes them in a loop, each
// dropped at once, and prints whether the peak RSS (VmHWM) grew by
// less than 8 MB between the first 10,000 rounds and the end.

import std.sync

fn peak_kb: Int {
  if t = file_read("/proc/self/status") {
    for line in t.split("\n") {
      if line.size > 6 && str_slice(line, 0, 6) == "VmHWM:" {
        kb = 0
        for i in 6..line.size {
          d = line[i]
          if d >= 48 && d <= 57 {
            kb = kb * 10 + d - 48
          }
        }
        return kb
      }
    }
  }
  0
}

fn round(i: Int): Int {
  ch = Channel(Int).new(1)
  ch.send(i)
  got = ch.recv() ?? 0
  m = Mutex(Int).new(got)
  m.with (n) {
    n += 1
  }
  m.with (n) { n }
}

fn main {
  total = 0
  for i in 0..10000 {
    total += round(i)
  }
  early = peak_kb()
  for i in 10000..300000 {
    total += round(i)
  }
  puts(total)
  puts(peak_kb() - early < 8192)
}
