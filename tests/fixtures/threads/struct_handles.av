// A struct whose fields are a Mutex, a Channel and plain values crosses
// to a task as a copy that shares the handles: captured by spawn and
// .parallel, held in an Array they capture, sent on a Channel.
import std.sync

struct Ports {
  hits: sync.Mutex(Int)
  done: sync.Channel(Int)
  name: String
}

struct Pair {
  ports: Ports
  weight: Int
}

fn main {
  p = Ports { hits: sync.Mutex(Int).new(0), done: sync.Channel(Int).new(4), name: "p" }
  hs: Array(JoinHandle(Void)) = []
  for i in 0..4 {
    hs.push(spawn {
      p.hits.with((n) { n += 1 })
      _ = p.done.send(i)
    })
  }
  for h in hs {
    _ = h.join()
  }
  puts(p.hits.with((n) { n }))
  total = 0
  for i in 0..4 {
    total += p.done.recv() ?? 0
  }
  puts(total)
  pairs = [Pair { ports: p, weight: 2 }, Pair { ports: p, weight: 3 }]
  r = [0, 1].parallel((i) {
    pairs[i].ports.hits.with((n) { n += pairs[i].weight })
    pairs[i].weight
  })
  puts(r[0] + r[1])
  puts(p.hits.with((n) { n }))
  ch = sync.Channel(Ports).new(1)
  _ = ch.send(p)
  if got = ch.recv() {
    got.hits.with((n) { n += 100 })
    puts("${got.name} ${p.hits.with((n) { n })}")
  }
}
