// s.lines(): a line ends at "\n" or "\r\n" (the ending not kept); a
// final ending adds no empty line, and a "\r" alone ends no line.

fn show(xs: Array(String)): String {
  parts: Array(String) = []
  for x in xs {
    parts.push("<" + x.replace("\r", "\\r") + ">")
  }
  "${xs.size} " + parts.join("")
}

fn main {
  puts(show("a\nb\n".lines()))
  puts(show("a\r\nb".lines()))
  puts(show("".lines()))
  puts(show("\n".lines()))
  puts(show("\n\n".lines()))
  puts(show("\r\n".lines()))
  puts(show("one".lines()))
  puts(show("a\rb\nc".lines()))
  puts(show("a\r\r\nb\r".lines()))
  puts(show("x\n\ny\r\n\r\nz\n".lines()))
  text = "GET /index.html HTTP/1.1\r\nHost: example.org\r\nAccept: */*\r\n\r\n"
  for line in text.lines() {
    puts("[" + line + "]")
  }
}
