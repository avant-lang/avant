// The strict float shape: what to_f and a slice's parse read as a number,
// and what they read as absent, on both sides of the exact fast parse.

fn main {
  xs = ["1", "-1", "+1.5", "1.", ".5", "1e5", "1e", "1e+", "1e-3", "1E22", "1e23", "123456789012345678", "1234567890123456789012x", "12345678901234567890.5e3", "0.000000000000000000001", "1e1001", "1e-1001", "1e99999999999", "1e0000000000000000000005", "00000000000000000000001.5", "1.5x", "1.5e3x", "-", "+", "", "e5", "1..2", "1.2.3", "9007199254740993", "4.9e-324", "1.7976931348623157e308", "1.8e308", "0", "-0", "0e0", "1_0", " 1", "1 "]
  for s in xs {
    if v = s.to_f() {
      puts("${s} -> ${v}")
    } else {
      puts("${s} -> absent")
    }
    t = "<${s}>"
    if w = str_to_f_slice(t, 1, t.size - 1) {
      puts("  slice ${w}")
    } else {
      puts("  slice absent")
    }
  }
}
