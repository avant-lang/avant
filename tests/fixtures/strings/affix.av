// delete_prefix and delete_suffix: the string without the given start or
// end, or the string unchanged when it does not have it.

fn main {
  puts("/users/".delete_suffix("/"))
  puts("/users".delete_suffix("/"))
  puts("//".delete_suffix("/"))
  puts("/".delete_suffix("/").size)
  puts("v1.2".delete_prefix("v"))
  puts("1.2".delete_prefix("v"))
  puts("abc".delete_prefix(""))
  puts("abc".delete_suffix(""))
  puts("ab".delete_prefix("abc"))
  puts("ab".delete_suffix("abc"))
  puts("abab".delete_prefix("ab"))
  puts("file.tar.gz".delete_suffix(".gz").delete_suffix(".tar"))
  origin = "  HTTPS://Example.ORG/  "
  puts(origin.strip().to_ascii_lower().delete_suffix("/"))
  long = "https://example.org/a/path/long/enough/for/the/slice/to/be/a/view/"
  trimmed = long.delete_prefix("https://").delete_suffix("/")
  puts(trimmed)
  puts(trimmed.size)
  puts(long.delete_prefix("http://") == long)
}
