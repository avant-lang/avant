// The String methods that build a new string (replace, repeat, pad_left,
// pad_right), split with a limit and an array's join.

fn show(xs: Array(String)): String {
  "[" + xs.join("|") + "]"
}

fn building {
  puts("a-b-c".replace("-", ", "))
  puts("aaa".replace("a", "bb"))
  puts("aaaa".replace("aa", "b"))
  puts("no match".replace("x", "y"))
  puts("x".replace("x", ""))
  puts("ab".repeat(3))
  puts("ab".repeat(0).size)
  puts("7".pad_left(3, '0'))
  puts("ab".pad_right(5, '.') + "|")
  puts("abc".pad_left(2))
  puts("[" + "x".pad_left(4) + "]")
}

fn splitting {
  puts(show("k=v=w".split("=", 2)))
  puts(show("a,b,c".split(",", 1)))
  puts(show("a,b,c".split(",", 3)))
  puts(show("a,b,c".split(",", 9)))
  puts(show(",a,".split(",", 2)))
  words: Array(String) = []
  puts(show(words))
  puts(["one"].join(", "))
  puts(["x", "y", "z"].join(""))
  puts(["", ""].join("-"))
}

fn main {
  building()
  splitting()
}
