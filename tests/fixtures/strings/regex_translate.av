  q22 = "[\\W]"
  q22 = q22 + ""
  if lit = regex.Regex.compile("[\\W]") {
    if dyn = regex.Regex.compile(q22) {
      differ = compare(q22, lit, dyn, differ)
      cases += texts().size
    }
  }
  q23 = "x\\e"
  q23 = q23 + ""
  if lit = regex.Regex.compile("x\\e") {
    if dyn = regex.Regex.compile(q23) {
      differ = compare(q23, lit, dyn, differ)
