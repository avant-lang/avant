import std.regex

// A literal pattern is compiled into the program as a scanner; the same
// pattern built at run time is PCRE2's. The translation of each pattern
// for the scanner must keep PCRE2's meaning: a class's letters match
// their other case only when the pattern is caseless, an escape the
// translation does not know (\x41, \A, \z, \h, \v, \e, \Q, a negated
// escape inside a class) and the anchors ^ and $ keep the pattern on
// PCRE2, and a pattern whose every match starts with one byte gives the
// same answers when the scanner skips to that byte.

fn answers(r: regex.Regex, s: String): String {
  b = Buf.new()
  if m = r.find(s) {
    b.push_str("find ${m.start}..${m.end}")
    if sp = m.span(1) {
      b.push_str(" g1 ${sp.lo}..${sp.hi}")
    }
  } else {
    b.push_str("find nil")
  }
  if m = r.find(s, 2) {
    b.push_str(" from2 ${m.start}..${m.end}")
  } else {
    b.push_str(" from2 nil")
  }
  b.push_str(" all")
  it = r.matches(s)
  while m = it.next() {
    b.push_str(" ${m.start}..${m.end}")
  }
  b.push_str(" count ${r.count(s)}")
  b.to_s()
}

fn show(s: String): String {
  b = Buf.new()
  for i in 0..s.size {
    c = s[i]
    if c < 32 {
      b.push_str("\\x")
      b.push_str("${c}")
    } else {
      b.push_byte(c)
    }
  }
  b.to_s()
}

fn texts: Array(String) {
  t: Array(String) = []
  t.push("ab")
  t.push("AB")
  t.push("aab")
  t.push("xAb")
  t.push("aBb")
  t.push("a.b")
  t.push("ABC")
  t.push("abc")
  t.push("12ab")
  t.push("  x")
  t.push("ab-")
  t.push("x\x1b")
  t.push("\x08")
  t.push("{{a}}{b}}{{c")
  t.push("{{a\x00b}} {{ x }}")
  t.push("{X {x")
  t.push("a\nb")
  t.push("x^ab")
  t.push("ab$x")
  t.push("A")
  t.push("x41")
  t.push("aZ")
  t.push("5")
  t.push("\t")
  t.push("\x0b")
  t.push("\x0c")
  t.push("1.25 .5")
  t.push("xy xZ XY")
  t.push("abbbc")
  t.push("")
  t
}

fn compare(name: String, lit: regex.Regex, dyn: regex.Regex, d: Int): Int {
  differ = d
  for s in texts() {
    a = answers(lit, s)
    w = answers(dyn, s)
    if a != w {
      puts("${name} on ${show(s)}:")
      puts("  literal ${a}")
      puts("  runtime ${w}")
      differ += 1
    }
  }
  differ
}

fn main {
  cases = 0
  differ = 0
  q0 = "[a]"
  q0 = q0 + ""
  if lit = regex.Regex.compile("[a]") {
    if dyn = regex.Regex.compile(q0) {
      differ = compare(q0, lit, dyn, differ)
      cases += texts().size
    }
  }
  q1 = "[a-c]+"
  q1 = q1 + ""
  if lit = regex.Regex.compile("[a-c]+") {
    if dyn = regex.Regex.compile(q1) {
      differ = compare(q1, lit, dyn, differ)
      cases += texts().size
    }
  }
  q2 = "[a-c]+"
  q2 = q2 + ""
  if lit = regex.Regex.compile("[a-c]+", true) {
    if dyn = regex.Regex.compile(q2, true) {
      differ = compare(q2, lit, dyn, differ)
      cases += texts().size
    }
  }
  q3 = "[^a-c]+"
  q3 = q3 + ""
  if lit = regex.Regex.compile("[^a-c]+") {
    if dyn = regex.Regex.compile(q3) {
      differ = compare(q3, lit, dyn, differ)
      cases += texts().size
    }
  }
  q4 = "[^a-c]+"
  q4 = q4 + ""
  if lit = regex.Regex.compile("[^a-c]+", true) {
    if dyn = regex.Regex.compile(q4, true) {
      differ = compare(q4, lit, dyn, differ)
      cases += texts().size
    }
  }
  q5 = "x[yz]"
  q5 = q5 + ""
  if lit = regex.Regex.compile("x[yz]") {
    if dyn = regex.Regex.compile(q5) {
      differ = compare(q5, lit, dyn, differ)
      cases += texts().size
    }
  }
  q6 = "x[yz]"
  q6 = q6 + ""
  if lit = regex.Regex.compile("x[yz]", true) {
    if dyn = regex.Regex.compile(q6, true) {
      differ = compare(q6, lit, dyn, differ)
      cases += texts().size
    }
  }
  q7 = "a.*?b"
  q7 = q7 + ""
  if lit = regex.Regex.compile("a.*?b") {
    if dyn = regex.Regex.compile(q7) {
      differ = compare(q7, lit, dyn, differ)
      cases += texts().size
    }
  }
  q8 = "a.*?b"
  q8 = q8 + ""
  if lit = regex.Regex.compile("a.*?b", true) {
    if dyn = regex.Regex.compile(q8, true) {
      differ = compare(q8, lit, dyn, differ)
      cases += texts().size
    }
  }
  q9 = "a.*?bc"
  q9 = q9 + ""
  if lit = regex.Regex.compile("a.*?bc") {
    if dyn = regex.Regex.compile(q9) {
      differ = compare(q9, lit, dyn, differ)
      cases += texts().size
    }
  }
  q10 = "\\{\\{(.*?)\\}\\}"
  q10 = q10 + ""
  if lit = regex.Regex.compile("\\{\\{(.*?)\\}\\}") {
    if dyn = regex.Regex.compile(q10) {
      differ = compare(q10, lit, dyn, differ)
      cases += texts().size
    }
  }
  q11 = "ab"
  q11 = q11 + ""
  if lit = regex.Regex.compile("ab") {
    if dyn = regex.Regex.compile(q11) {
      differ = compare(q11, lit, dyn, differ)
      cases += texts().size
    }
  }
  q12 = "ab"
  q12 = q12 + ""
  if lit = regex.Regex.compile("ab", true) {
    if dyn = regex.Regex.compile(q12, true) {
      differ = compare(q12, lit, dyn, differ)
      cases += texts().size
    }
  }
  q13 = "{x"
  q13 = q13 + ""
  if lit = regex.Regex.compile("{x", true) {
    if dyn = regex.Regex.compile(q13, true) {
      differ = compare(q13, lit, dyn, differ)
