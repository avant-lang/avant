  }
  q28 = "[[:digit:]]"
  q28 = q28 + ""
  if lit = regex.Regex.compile("[[:digit:]]") {
    if dyn = regex.Regex.compile(q28) {
      differ = compare(q28, lit, dyn, differ)
      cases += texts().size
    }
  }
  q29 = "a\\Qb"
  q29 = q29 + ""
  if lit = regex.Regex.compile("a\\Qb") {
    if dyn = regex.Regex.compile(q29) {
      differ = compare(q29, lit, dyn, differ)
      cases += texts().size
    }
  }
  q30 = "\\h"
  q30 = q30 + ""
  if lit = regex.Regex.compile("\\h") {
    if dyn = regex.Regex.compile(q30) {
      differ = compare(q30, lit, dyn, differ)
      cases += texts().size
    }
  }
  q31 = "\\v"
  q31 = q31 + ""
  if lit = regex.Regex.compile("\\v") {
    if dyn = regex.Regex.compile(q31) {
      differ = compare(q31, lit, dyn, differ)
      cases += texts().size
    }
  }
  q32 = "[\\v]"
  q32 = q32 + ""
  if lit = regex.Regex.compile("[\\v]") {
    if dyn = regex.Regex.compile(q32) {
      differ = compare(q32, lit, dyn, differ)
      cases += texts().size
    }
  }
  q33 = "^ab"
  q33 = q33 + ""
  if lit = regex.Regex.compile("^ab") {
    if dyn = regex.Regex.compile(q33) {
      differ = compare(q33, lit, dyn, differ)
      cases += texts().size
    }
  }
  q34 = "ab$"
  q34 = q34 + ""
  if lit = regex.Regex.compile("ab$") {
    if dyn = regex.Regex.compile(q34) {
      differ = compare(q34, lit, dyn, differ)
      cases += texts().size
    }
  }
  puts("${cases} cases, ${differ} differ")
}
