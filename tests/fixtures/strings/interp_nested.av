// A string that interpolates inside an interpolation, to any depth.

fn label(n: Int): String {
  "#${n}"
}

fn nesting {
  x = 3
  puts("a ${"b ${x} c"} d")
  puts("${label(x)} and ${"${"deep ${x + 1}"}"}")
  names = ["ann", "bo"]
  puts("names: ${names[1]}, first ${"<${names[0]}>"}")
  xs = [1, 2, 3]
  puts("any ${"over five: ${xs.any((v) { v > 5 })}"}, found ${xs.find((v) { v > 1 }) ?? 0}")
}

fn main {
  nesting()
}
