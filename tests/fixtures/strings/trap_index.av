// A string index out of bounds on the new back end (Stage 28 W6a): the
// output before the trap, then `index 5 out of bounds (size 3)` on stderr
// and exit 1.

fn opaque(n: Int): Int {
  a = now_us()
  b = now_us()
  if b - a > 1000000000 {
    return n &+ b
  }
  n
}

fn main {
  s = "a${opaque(12)}"
  puts(s[2])
  puts(s[opaque(5)])
  puts("not reached")
}
