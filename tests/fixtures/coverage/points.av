// Coverage points on both back ends (Stage 28 W8b, audit 5): built with
// AVANT_COVERAGE=1, the slot map and the counts (lcov) are the same under
// both back ends. Statements, function entries (functions, methods,
// constructors' initialize), both arms of if (with and without else, and
// if bindings), while bodies, switch arms (one label each) with and
// without else, both paths of && and ||, value blocks, lambda bodies (in
// the old back end's thunk order, after the functions), spawn and
// .parallel bodies, and Mutex.with blocks. Also an ordinary program.

class Counter {
  n: Int

  fn initialize(n: Int) {
    self.n = n
  }

  fn grow(by: Int): Int {
    if by > 0 {
      self.n = self.n + by
    }
    self.n
  }
}

class Mutex(T) {
  cell: T
  gate: UInt64

  fn initialize(value: T) {
    self.cell = value
    self.gate = avant_gate_new()
  }
}

fn classify(n: Int): String {
  switch n % 3 {
    case 0 {
      "zero"
    }
    case 1 {
      "one"
    }
    else {
      "two"
    }
  }
}

fn tag(n: Int): Int {
  r = 0
  switch n {
    case 1 {
      r = 10
    }
    case 2 {
      r = 20
    }
  }
  r
}

// A loop that does not index an array: the old back end emits a second,
// versioned copy of an indexing loop in a program that spawns (loops.av,
// trick #11), which doubles its slots; the new back end does not.
fn find(n: Int, want: Int): Int? {
  i = 0
  while i < n {
    if i * 2 == want {
      return i
    }
    i = i + 1
  }
  nil
}

fn both(a: Bool, b: Bool): Int {
  r = 0
  if a && b {
    r = r + 1
  }
  if a || b {
    r = r + 2
  }
  r
}

fn unused(n: Int): Int {
  n * 2
}

fn main {
  c = Counter.new(1)
  puts(c.grow(2))
  puts(c.grow(0))
  puts(classify(3))
  puts(classify(4))
  puts(classify(5))
  puts(tag(1))
  puts(tag(5))
  xs = [4, 5, 6]
  if at = find(5, 6) {
    puts(at)
  } else {
    puts(-1)
  }
  if at2 = find(3, 9) {
    puts(at2)
  }
  puts(both(true, false))
  puts(both(true, true))
  puts(both(false, false))
  add: fn(Int): Int = { |x| x + 1 }
  twice: fn(Int): Int = { |x|
    y = add(x)
    add(y)
  }
  puts(twice(3))
  total = 0
  xs.each { |x|
    if x > 4 {
      total = total + x
    }
  }
  puts(total)
  puts(xs.any { |x| x > 5 })
  h = spawn {
    s = 0
    i = 0
    while i < 3 {
      s = s + i
      i = i + 1
    }
    s
  }
  ys = xs.parallel { |x|
    z = x * 2
    z + 1
  }
  m = Mutex(Int).new(1)
  got = m.with { |v|
    v = v + 1
    v
  }
  puts(h.join)
  puts(ys[2])
  puts(got)
}
