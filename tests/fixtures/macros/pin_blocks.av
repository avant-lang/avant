// Stage 29 W1a (O131): a `pin` block inside a quote and inside a spawn.
// Quote hygiene renames the names a `pin` body assigns (before, the
// quote's `tmp` was the paste site's, and the second line printed 2), and the
// spawn walker sees the names a `pin` body reads (before, `base` was not
// captured and the back end stopped with L0001).

class Holder {
  n: Int = 1
}

fn main {
  tmp = 1
  h = Holder.new
  quote {
    pin(h) {
      tmp = 2
      puts(tmp)
    }
  }
  puts(tmp)
  base = 40
  t = spawn {
    r = 0
    hh = Holder.new
    pin(hh) {
      r = base + 2
    }
    r
  }
  puts(t.join)
}
