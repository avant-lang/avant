// A loop-heavy scalar program (Stage 28 W5b, measured): Collatz step
// counts below a bound, with checked Int arithmetic in the inner loop.

fn steps(start: Int): Int {
  n = start.to_i
  c = 0
  while n != 1 {
    if n % 2 == 0 {
      n = n / 2
    } else {
      n = 3 * n + 1
    }
    c = c + 1
  }
  c
}

fn main {
  best = 0
  at = 0
  total = 0
  i = 1
  while i < 1000000 {
    s = steps(i)
    total = total + s
    if s > best {
      best = s
      at = i
    }
    i = i + 1
  }
  puts(at)
  puts(best)
  puts(total)
}
