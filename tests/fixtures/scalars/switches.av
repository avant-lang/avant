// switch on the new back end (Stage 28 W5b): as a statement and as a
// value, on Int and Bool (the checker's discriminants), with several labels per arm, with and
// without else, and inside a loop with break.

fn name(n: Int): String {
  switch n {
    case 0 {
      "zero"
    }
    case 1, 2, 3 {
      "small"
    }
    else {
      "big"
    }
  }
}

fn wide(n: Int): Int {
  switch n {
    case 2000000000 {
      1
    }
    case -1 {
      2
    }
    else {
      3
    }
  }
}

fn main {
  i = 0
  while i < 6 {
    puts(name(i))
    switch i {
      case 4 {
        puts("four")
      }
      case 5 {
        puts("five, stop")
        break
      }
    }
    i = i + 1
  }
  puts(wide(2000000000))
  puts(wide(-1))
  puts(wide(7))
  b = i > 3
  v = switch b {
    case 1 {
      10
    }
    else {
      20
    }
  }
  puts(v)
  x = 1
  y = x + switch i {
    case 5 {
      x = 100
      1
    }
    else {
      2
    }
  }
  puts(y)
  puts(x)
}
