// == and != on Bool operands (Stage 28 W18F): every pair, values from
// comparisons, a stored result, and use in conditions.

fn flip(b: Bool): Bool {
  !b
}

fn main {
  t = true
  f = false
  puts(t == t)
  puts(t == f)
  puts(f == t)
  puts(f == f)
  puts(t != t)
  puts(t != f)
  puts(f != t)
  puts(f != f)
  a = 3
  b = 4
  same = (a < b) == (b > a)
  puts(same)
  differ = (a < b) != (a > b)
  puts(differ)
  if flip(t) == f {
    puts("flip")
  }
  n = 0
  i = 0
  while i < 10 {
    if (i % 2 == 0) != (i % 3 == 0) {
      n += 1
    }
    i += 1
  }
  puts(n)
  xs = [true, false, true]
  puts(xs[0] == xs[2])
  puts(xs[1] != false)
}
