// Functions and calls on the new back end (Stage 28 W5b): recursion,
// mutual recursion, several return paths, void functions, overloads
// (mangled with their parameter types), and literal strings passed and
// returned.

fn fib(n: Int): Int {
  if n < 2 {
    return n
  }
  fib(n - 1) + fib(n - 2)
}

fn is_even(n: Int): Bool {
  if n == 0 {
    return true
  }
  is_odd(n - 1)
}

fn is_odd(n: Int): Bool {
  if n == 0 {
    return false
  }
  is_even(n - 1)
}

fn show(n: Int) {
  puts(n)
}

fn show(s: String) {
  puts(s)
}

fn show(f: Float64) {
  puts(f)
}

fn pick(c: Bool, a: String, b: String): String {
  if c {
    return a
  }
  b
}

fn early(n: Int): Int {
  i = 0
  while true {
    if i * i >= n {
      return i
    }
    i = i + 1
  }
  n
}

fn main {
  puts(fib(20))
  puts(is_even(10))
  puts(is_odd(7))
  show(42)
  show("forty-two")
  show(4.2)
  puts(pick(true, "yes", "no"))
  puts(pick(false, "yes", "no"))
  puts(early(50))
}
