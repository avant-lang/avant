// % (C4, W11b): MIN % -1 is 0 for Int (the remainder is
// exact; only / of (MIN, -1) overflows); % by zero traps: `avant runtime:
// division by zero`, exit 1.

fn rem(a: Int, b: Int): Int {
  a % b
}

fn main {
  puts(rem(-7, 3))
  puts(rem(-7, -1))
  puts(rem(-2147483647 - 1, -1))
  puts(rem(7, 0))
  puts("not reached")
}
