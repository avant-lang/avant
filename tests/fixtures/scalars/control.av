// Control flow on the new back end (Stage 28 W5b): if/else chains, while,
// for over a range, break and continue, nested loops, and short-circuit &&
// and || whose right side prints when it runs.

fn says(tag: Int, v: Bool): Bool {
  puts(tag)
  v
}

fn classify(n: Int): Int {
  if n < 0 {
    return -1
  } else if n == 0 {
    return 0
  } else if n < 10 {
    return 1
  }
  2
}

fn main {
  puts(classify(-3))
  puts(classify(0))
  puts(classify(7))
  puts(classify(70))
  i = 0
  total = 0
  while i < 10 {
    i = i + 1
    if i == 3 {
      continue
    }
    if i == 8 {
      break
    }
    total = total + i
  }
  puts(total)
  sum = 0
  for j in 0..5 {
    if j == 2 {
      continue
    }
    sum = sum + j * j
  }
  puts(sum)
  rows = 0
  for r in 1..4 {
    c = 0
    while true {
      c = c + 1
      if c > r {
        break
      }
      rows = rows + c
    }
  }
  puts(rows)
  puts(says(1, false) && says(2, true))
  puts(says(3, true) && says(4, false))
  puts(says(5, true) || says(6, true))
  puts(says(7, false) || says(8, true))
  flag = true
  if !flag || says(9, true) {
    puts(10)
  }
  n = 27
  steps = 0
  while n != 1 {
    if n % 2 == 0 {
      n = n / 2
    } else {
      n = 3 * n + 1
    }
    steps += 1
  }
  puts(steps)
}
