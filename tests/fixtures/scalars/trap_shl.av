// C1 (W11b): Int << 32 traps (the amount is outside 0..31): `avant
// runtime: shift amount 32 out of range for Int (0..31)`, exit 1.
// n, unknown to every optimizer: the other branch (two clock reads a
// thousand seconds apart) never runs.
fn opaque(n: Int): Int {
  a = now_us()
  b = now_us()
  if b &- a > 1000000000 {
    return n &+ b.wrap_i
  }
  n
}

fn main {
  k = opaque(0)
  puts(1 << (31 + k))
  puts(1 << (32 + k))
  puts("not reached")
}
