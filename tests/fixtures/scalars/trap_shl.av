// C1 (W11b): Int << 64 traps (the amount is outside 0..63; Int is 64-bit
// since Stage 29 W-INT1): `avant runtime: shift amount 64 out of range for
// Int (0..63)`, exit 1.
// n, unknown to every optimizer: the other branch (two clock reads a
// thousand seconds apart) never runs.
fn opaque(n: Int): Int {
  a = now_us()
  b = now_us()
  if b &- a > 1000000000 {
    return n &+ b.wrap_i
  }
  n
}

fn main {
  k = opaque(0)
  puts(1 << (63 + k))
  puts(1 << (64 + k))
  puts("not reached")
}
