// C2 (W11b): Float64.to_i of 9223372036854775808.0 (Int.MAX + 1; Int is
// 64-bit since Stage 29 W-INT1) traps: `avant runtime: to_i of Float64
// 9223372036854776000.0 out of range for Int` (its shortest text), exit 1;
// the largest double below it converts.

// n, unknown to every optimizer: the other branch (two clock reads a
// thousand seconds apart) never runs.
fn opaque(n: Int): Int {
  a = now_us()
  b = now_us()
  if b &- a > 1000000000 {
    return n &+ b.wrap_i
  }
  n
}

fn ti(x: Float64): Int {
  x.to_i
}

fn main {
  one = opaque(1).to_f
  puts(ti(9223372036854774784.0 * one))
  puts(ti(9223372036854775808.0 * one))
  puts("not reached")
}
