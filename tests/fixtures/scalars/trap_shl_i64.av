// C1 (W11b): Int64 << 64 traps: `avant runtime: shift amount 64 out of
// range for Int64 (0..63)`, exit 1.
// n, unknown to every optimizer: the other branch (two clock reads a
// thousand seconds apart) never runs.
fn opaque(n: Int): Int {
  a = now_us()
  b = now_us()
  if b &- a > 1000000000 {
    return n &+ b.wrap_i
  }
  n
}

fn main {
  k = opaque(0).to_i64
  puts(1i64 << (63i64 + k))
  puts(1i64 << (64i64 + k))
  puts("not reached")
}
