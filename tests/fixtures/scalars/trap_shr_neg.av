// C1 (W11b): a negative amount traps: Int >> -1 gives `avant runtime:
// shift amount -1 out of range for Int (0..31)`, exit 1.
// n, unknown to every optimizer: the other branch (two clock reads a
// thousand seconds apart) never runs.
fn opaque(n: Int): Int {
  a = now_us()
  b = now_us()
  if b &- a > 1000000000 {
    return n &+ b.wrap_i
  }
  n
}

fn main {
  k = opaque(0)
  puts(-8 >> (1 + k))
  puts(-8 >> (k - 1))
  puts("not reached")
}
