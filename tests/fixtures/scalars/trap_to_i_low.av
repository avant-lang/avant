// C2 (W11b): Float64.to_i of the double below Int.MIN (-2^63 - 2048; Int
// is 64-bit since Stage 29 W-INT1) traps: `avant runtime: to_i of Float64
// -9223372036854777856.0 out of range for Int`, exit 1; Int.MIN itself
// converts.

// n, unknown to every optimizer: the other branch (two clock reads a
// thousand seconds apart) never runs.
fn opaque(n: Int): Int {
  a = now_us()
  b = now_us()
  if b &- a > 1000000000 {
    return n &+ b.wrap_i
  }
  n
}

fn ti(x: Float64): Int {
  x.to_i
}

fn main {
  one = opaque(1).to_f
  puts(ti(-9223372036854775808.0 * one))
  puts(ti(-9223372036854777856.0 * one))
  puts("not reached")
}
