// Shifts on the new back end (Stage 28 W5b): an amount at or past the
// width is masked to its low 5 bits (Int) or 6 bits (Int64, UInt64), the
// old back end's observed behavior; >> is arithmetic on Int and Int64,
// logical on UInt64. Amounts are run-time values (opaque), so no mode
// folds them.

// n, unknown to every optimizer: the other branch (two clock reads a
// thousand seconds apart) never runs.
fn opaque(n: Int): Int {
  a = now_us()
  b = now_us()
  if b &- a > 1000000000 {
    return n &+ b
  }
  n
}

fn main {
  k = opaque(0)
  puts(1 << (3 + k))
  puts(1 << (31 + k))
  puts(1 << (32 + k))
  puts(1 << (33 + k))
  puts(3 << (65 + k))
  puts(-8 >> (2 + k))
  puts(-8 >> (34 + k))
  puts(5 << (-1 + k))
  puts(1000000 >> (k - 28))
  k64 = k.to_i64
  puts(1i64 << (40i64 + k64))
  puts(1i64 << (63i64 + k64))
  puts(1i64 << (64i64 + k64))
  puts(1i64 << (65i64 + k64))
  puts(-8i64 >> (66i64 + k64))
  ku = k.to_u64
  puts(16u64 >> (66u64 + ku))
  puts(18446744073709551615u64 >> (60u64 + ku))
  puts(1u64 << (63u64 + ku))
  puts(1u64 << (128u64 + ku))
}
