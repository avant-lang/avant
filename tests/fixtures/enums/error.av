// An enum marked Error is a failure type:
// `?`, if-assign and `??` read it by the one rule, `_ =` discards it, and
// its message is the member's name unless the enum defines `fn message`.

enum ParseError: Error { empty, not_a_number }

enum NetError: Error {
  refused
  timed_out

  fn message: String {
    switch self {
      case refused { "connection refused" }
      case timed_out { "timed out" }
    }
  }
}

fn parse_digit(s: String): Int | ParseError {
  if s.size == 0 {
    return ParseError.empty
  }
  c = s[0]
  if c < 48 || c > 57 {
    return ParseError.not_a_number
  }
  c - 48
}

fn twice(s: String): Int | ParseError {
  d = parse_digit(s)?
  d * 2
}

fn connect(n: Int): String | NetError {
  if n == 1 {
    return NetError.refused
  }
  if n == 2 {
    return NetError.timed_out
  }
  "connected"
}

fn kind(e: ParseError): String {
  switch e {
    case empty { "nothing to read" }
    case not_a_number { "not a digit" }
  }
}

fn main {
  puts(parse_digit("7") ?? -1)
  puts(parse_digit("x") ?? -1)
  if v = twice("4") {
    puts(v)
  }
  puts(twice("") ?? -1)
  _ = parse_digit("")
  switch parse_digit("") {
    case Int { }
    case e: ParseError {
      puts(e)
      puts("failed: ${e}")
      puts(e.message())
      puts(e.name())
      puts(kind(e))
    }
  }
  switch parse_digit("?") {
    case Int { }
    case e2: ParseError { puts(kind(e2)) }
  }
  switch parse_digit("3") {
    case Int { puts("no failure") }
    case ParseError { puts("failed") }
  }
  puts(connect(0) ?? "no")
  switch connect(1) {
    case String { }
    case n: NetError {
      puts("${n}")
      puts(n.name())
    }
  }
  switch connect(2) {
    case String { }
    case n2: NetError {
      puts(n2.message())
      puts(n2.to_i())
    }
  }
}
