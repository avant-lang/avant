// Stage 29 W5a1 (D292, D320, D358): an enum's values, its numbers, the
// functions every enum has, printing, equality, and an enum in a field,
// an array, a struct, a class and an optional.

pub enum Tok {
  eof
  name
  number
}

enum Status { ok = 200, created, not_found = 404 }

enum Neg { low = -2, mid, high = 300, }

struct Cell {
  tok: Tok
  n: Int
}

class Reader {
  pub tok: Tok = Tok.eof
  pub last: Tok

  fn initialize {
    self.last = Tok.number
  }
}

fn pick(b: Bool): Tok? {
  if b {
    return Tok.number
  }
  nil
}

fn main {
  t = Tok.name
  puts("${t}")
  puts(t.to_i)
  if u = Tok.from_i(2) {
    puts(u == Tok.number)
  }
  if _ = Tok.from_i(7) {
    puts("7 is a member")
  } else {
    puts("7 is no member")
  }
  puts((Tok.from_name("eof") ?? Tok.name) == Tok.eof)
  puts(Tok.from_name("Eof") ?? Tok.number)
  puts(Status.created.to_i)
  puts(Status.not_found)
  puts(Tok.members.size)
  puts(t)
  puts(t.name)
  puts(t != Tok.eof)
  for m in Tok.members() {
    puts("${m} ${m.to_i}")
  }
  puts(Neg.mid.to_i)
  puts(Neg.high)
  puts((Neg.from_i(300) ?? Neg.low) == Neg.high)
  puts(Neg.from_i(-2) ?? Neg.high)
  xs = [Tok.number, Tok.eof]
  xs.push(Tok.name)
  puts(xs[2])
  ys = Array(Tok).new(2, Tok.number)
  puts("${ys[0]} ${ys[1]}")
  c = Cell { tok: Tok.name, n: 3 }
  puts("${c.tok} ${c.n}")
  r = Reader.new
  r.tok = Tok.name
  puts("${r.tok} ${r.last}")
  if p = pick(true) {
    puts(p)
  }
  puts(pick(false) ?? Tok.eof)
  puts(Tok.from_name("number") ?? Tok.eof)
  // An enum is a number: a task copies it at send.
  j = spawn { t.to_i + 40 }
  puts(j.join ?? -1)
  u: Int | Tok = Tok.eof
  us = [u, 3]
  puts(us.size)
}
