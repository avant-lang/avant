// Loop exits the checker accepts: `break` in a `for` with no `while`
// around it, a lambda given to a builtin that ends its element's turn
// by its value, and `break`/`continue` of a loop inside a lambda body
// inside an outer loop. The rejected form (a lambda body is not inside
// the loop around it) is refuse_break.av.

fn first_big(xs: Array(Int)): Int {
  found = -1
  for x in xs {
    if x > 10 {
      found = x
      break
    }
  }
  found
}

fn main {
  puts(first_big([3, 12, 40]))
  seen = 0
  h = Hash(String, Int).new()
  h["a"] = 1
  h["b"] = 2
  for k, v in h {
    seen += v
    break
  }
  puts(seen)
  hit = [1, 2, 3].any (x) {
    if x == 9 {
      return false
    }
    x == 2
  }
  puts(hit)
  total = 0
  for i in 0..3 {
    f: fn(Int): Int = (n: Int) {
      s = 0
      j = 0
      while j < 10 {
        j += 1
        if j == 2 {
          continue
        }
        if j > n {
          break
        }
        s += j
      }
      s
    }
    total += f(i + 3)
  }
  puts(total)
}
