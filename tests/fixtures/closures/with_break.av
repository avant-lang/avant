// A `Mutex.with` lambda that returns early inside a `while`, and the
// loop left by `break` after it: the lock is released on every way out
// of the lambda, so the next `with` finds the lock free.
// tests/cases/test_frontend.av runs it under the collector's modes.

import std.sync

fn run: Int {
  m = sync.Mutex(Int).new(0)
  i = 0
  while i < 3 {
    stop = m.with((x): Bool {
      x += 1
      if i == 1 {
        return true
      }
      false
    })
    if stop {
      break
    }
    i += 1
  }
  m.with (x) { x }
}

fn main {
  puts(run())
  puts(run())
}
