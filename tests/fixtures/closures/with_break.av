// `break` inside a `Mutex.with` block inside a `while`. Stage 28 W10b
// refused it: the lock was released only at the block's end, and the
// program hung on the next `with`. Since Stage 29 W8Ca (O263, O313) the
// lock is released on every way out of the block, so `break` leaves the
// block and the loop, and the next `with` finds the lock free.
// tests/cases/test_frontend.av runs it under the collector's modes.

import std.sync

fn run: Int {
  m = Mutex(Int).new(0)
  i = 0
  while i < 3 {
    m.with { |x|
      x += 1
      if i == 1 {
        break
      }
    }
    i += 1
  }
  m.with { |x| x }
}

fn main {
  puts(run())
  puts(run())
}
