// O129 (Stage 28 W18C): C threads that exit inside an Avant callback (the
// callback calls C that opens its own frame, registers 1 MiB of root slots
// and calls pthread_exit). The thread's exit unregisters it (D265) and now
// also frees every frame avant_gc_enter allocated on it, those still on its
// chain included: 64 such threads grow the resident set by about 64 MiB at
// the base and by little after. Built with `--cc tests/fixtures/ffi/ffi.c`.

lib ox {
  fun ox_run(f: fn(Int): Int, n: Int): Int
  fun ox_exit_here(k: Int): Int
}

fn cb(k: Int): Int {
  s = "cb-${k}"
  ox.ox_exit_here(k) + s.size
}

fn main {
  grew = ox.ox_run(cb, 64)
  puts("64 threads exited inside a callback; their frames freed: ${grew < 16384}")
}
