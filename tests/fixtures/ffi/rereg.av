// O70 (Stage 29 W1b): a thread that unregisters holds no heap reference,
// in the runtime's thread-local slots either. A C thread
// (tests/fixtures/ffi/ffi.c, rereg_start) calls `step(0)`, which leaves a
// fresh key in hash_last_key()'s slot and nowhere else, unregisters
// itself, and waits while the main thread collects (the key is garbage
// now); then it calls `step(1)`, which registers it again and collects on
// that thread. Unregistering clears the slot, so `step(1)` reads an empty
// key. Before, the slot still named the freed key: the second
// registration's collections marked it (the verifier reports a lost
// reference) and hash_last_key() read freed memory.
lib fc {
  fun rereg_start(f: fn(Int): Int)
  fun rereg_wait
  fun rereg_finish: Int
  fun avant_gc_collect
}

fn churn(n: Int): Int {
  keep: Array(String) = []
  bad = 0
  for i in 0..n {
    keep.push("churn-${i}")
    if keep.size > 50 {
      if keep[0].size < 7 {
        bad += 1
      }
      keep.clear
    }
  }
  bad
}

fn step(mode: Int): Int {
  if mode == 0 {
    h = Hash(String, Int).new
    text = "xx-rereg-key-xx"
    if h.inc_slice(text, 3, text.size - 3) != 1 {
      return 1
    }
    if hash_last_key() != "rereg-key" {
      return 1
    }
    return 0
  }
  bad = churn(2000)
  fc.avant_gc_collect()
  bad += churn(2000)
  fc.avant_gc_collect()
  if hash_last_key() != "" {
    bad += 1
  }
  bad
}

fn main {
  fc.rereg_start(step)
  fc.rereg_wait()
  bad = churn(5000)
  fc.avant_gc_collect()
  bad += churn(5000)
  fc.avant_gc_collect()
  cbad = fc.rereg_finish()
  puts("main bad: ${bad}")
  puts("thread bad: ${cbad}")
}
