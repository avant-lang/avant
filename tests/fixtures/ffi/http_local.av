// std.http without the network and without threads: the whole module
// lowers on the new back end (its `lib` block, the C callbacks the
// server hands to uSockets, `Ptr(Void)` fields), and the parts that
// need no socket run: responses built in code, and the header set
// such a response will send read through the C helpers (its
// Content-Type and X-One; the Content-Length it was given is the
// server's own and dropped). The server, the client, and WebSockets
// need a second thread or process (test_std_http.av).

import std.http

fn main {
  r = Response.text("hello", 201).header("X-One", "1").header("Content-Length", "9")
  puts(r.status)
  puts(r.body.size)
  puts(r.headers().count())
  b = Response.bytes("raw".bytes)
  puts(b.status)
}
