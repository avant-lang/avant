// fn main: Void | E that succeeds exits 0, by its end or by a bare return.

enum Bad: Error { empty, long }

fn first(s: String): Int | Bad {
  if s.size == 0 {
    return Bad.empty
  }
  s[0]
}

fn main: Void | Bad {
  puts(first("a")?)
  if first("b")? == 98 {
    return
  }
  puts("not reached")
}
