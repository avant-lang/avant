// fn main: Int | E: an Int is the status; a
// failure prints its text to stderr and exits 1.

enum Bad: Error { empty, long }

fn len(s: String): Int | Bad {
  if s.size == 0 {
    return Bad.empty
  }
  if s.size > 3 {
    return Bad.long
  }
  s.size
}

fn main: Int | Bad {
  puts(len("ab")?)
  n = len("abcdef")?
  puts("not reached ${n}")
  0
}
