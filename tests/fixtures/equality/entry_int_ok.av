// fn main: Int | E that succeeds: its Int is the exit status.

class Oops: Error {
  message: String

  fn initialize(message: String) {
    self.message = message
  }
}

fn half(n: Int): Int | Oops {
  if n % 2 != 0 {
    return Oops.new("odd")
  }
  n / 2
}

fn main: Int | Oops {
  puts("half")
  half(6)?
}
