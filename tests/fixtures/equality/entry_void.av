// fn main: Void | E: a failure passed up by ?
// prints its text to stderr after the program's output and exits 1.

class Oops: Error {
  message: String

  fn initialize(message: String) {
    self.message = message
  }
}

fn check(n: Int): Int | Oops {
  if n > 2 {
    return Oops.new("too big: ${n}")
  }
  n
}

fn main: Void | Oops {
  for i in 0..5 {
    v = check(i)?
    puts("ok ${v}")
  }
  puts("not reached")
}
