// One text for every scalar: to_s is the interpolation's text; a union prints its member;
// puts of every integer type through the runtime.

enum Color { red, green }

class Oops: Error {
  message: String

  fn initialize(message: String) {
    self.message = message
  }
}

fn pick(n: Int): Int | String | Float64 {
  if n == 0 {
    return 7
  }
  if n == 1 {
    return "seven"
  }
  7.5
}

fn parse(n: Int): Int | Oops {
  if n < 0 {
    return Oops.new("negative ${n}")
  }
  n * 2
}

fn mood(n: Int): Bool | Color {
  if n > 0 {
    return Color.green
  }
  false
}

fn main {
  puts(42.to_s())
  puts((-7).to_s())
  big: UInt64 = 18446744073709551615u64
  puts(big.to_s())
  w: Int32 = -2147483648
  puts(w.to_s())
  u: UInt32 = 4294967295
  puts(u.to_s())
  puts(1.5.to_s())
  puts(0.1.to_s())
  puts(true.to_s())
  puts(false.to_s())
  puts("same".to_s())
  puts(42.to_s() == "${42}")
  puts("${pick(0)}")
  for i in 0..3 {
    puts("pick ${i}: ${pick(i)}")
  }
  puts("${parse(4)} ${parse(-1)}")
  puts("${mood(1)} ${mood(0)}")
  puts(9223372036854775807)
  puts(-9223372036854775807 - 1)
  puts(0)
  puts(w)
  puts(u)
  puts(big)
  puts_u(-1)
  puts_u(w)
  n: Int32 = -1
  puts_u(n)
}
