// Layouts and type maps on the new back end (Stage 28 W6b): the values
// read back after collections prove the maps trace what the layouts
// hold. Union fields are laid out as tag then payloads at their own
// alignment (W1b), `nil` defaults and `nil` stores build the nil member;
// a class whose reference is past word 63 needs avant_type_map_at; Bool,
// Int, Float64 fields mix alignments; an empty class; a struct
// holding a class reference inside a class; ids in program order.
// Run under AVANT_GC_VERIFY=1 and AVANT_YOUNG_MB=1 it must print the same.

class Empty {
}

class Node {
  v: Int
  next: Node? = nil
  label: String = "node"
}

class Mixed {
  flag: Bool
  u: Int | String = 0
  n: Int
  big: Int
  on: Bool
  f: Float64
  s: String
  opt: String? = nil
}

class Wide {
  w0: Int
  w1: Int
  w2: Int
  w3: Int
  w4: Int
  w5: Int
  w6: Int
  w7: Int
  w8: Int
  w9: Int
  w10: Int
  w11: Int
  w12: Int
  w13: Int
  w14: Int
  w15: Int
  w16: Int
  w17: Int
  w18: Int
  w19: Int
  w20: Int
  w21: Int
  w22: Int
  w23: Int
  w24: Int
  w25: Int
  w26: Int
  w27: Int
  w28: Int
  w29: Int
  w30: Int
  w31: Int
  w32: Int
  w33: Int
  w34: Int
  w35: Int
  w36: Int
  w37: Int
  w38: Int
  w39: Int
  w40: Int
  w41: Int
  w42: Int
  w43: Int
  w44: Int
  w45: Int
  w46: Int
  w47: Int
  w48: Int
  w49: Int
  w50: Int
  w51: Int
  w52: Int
  w53: Int
  w54: Int
  w55: Int
  w56: Int
  w57: Int
  w58: Int
  w59: Int
  w60: Int
  w61: Int
  w62: Int
  w63: Int
  w64: Int
  w65: Int
  w66: Int
  w67: Int
  w68: Int
  w69: Int
  name: String
}

struct Ref {
  tag: Int
  node: Node
  text: String
}

class Box {
  first: Bool
  r: Ref
  last: String

  fn initialize(r: Ref) {
    self.r = r
  }
}

fn junk(i: Int): Int {
  // Allocates enough to run young collections between the stores and the
  // reads below.
  s = 0
  k = 0
  while k < 200 {
    e = Empty.new
    n = Node.new
    n.v = k
    n.label = "j${i}-${k}"
    s = s &+ n.label.size
    k = k + 1
  }
  s
}

fn main {
  total = 0
  i = 0
  while i < 2000 {
    m = Mixed.new
    m.flag = i % 2 == 0
    m.n = i
    m.big = i.to_i * 1000000000
    m.on = true
    m.f = 1.5
    m.s = "mixed-${i}"
    m.opt = nil
    w = Wide.new
    w.w69 = 7
    w.name = "wide-${i}"
    nd = Node.new
    nd.v = i
    nd.label = "inner-${i}"
    b = Box.new(Ref { tag: i, node: nd, text: "ref-${i}" })
    b.last = "last-${i}"
    total = total &+ junk(i)
    if m.s.size != 6 + "${i}".size || w.name.size != 5 + "${i}".size {
      puts("bad string at ${i}")
    }
    if b.r.node.label.size != 6 + "${i}".size || b.r.text.size != 4 + "${i}".size || b.last.size != 5 + "${i}".size {
      puts("bad box at ${i}")
    }
    if b.r.node.v != i || b.r.tag != i || m.n != i || w.w69 != 7 {
      puts("bad scalar at ${i}")
    }
    total = total &+ m.s.size &+ w.name.size &+ b.r.node.label.size
    i = i + 1
  }
  puts(total)
}
