// Not yet on the new back end (Stage 28 W6b): a bare T stored into a T?
// field of a struct literal needs a union value (W7), so the new back end
// stops with L0001; the old back end fails to compile it at all (myc-llvm,
// W1b record, mir.md section 14). No `fn main`, so the differential's
// fixtures set leaves it out; test_objects.av checks the refusal.

class Node {
  v: Int
}

struct Slot {
  k: Int
  node: Node?
}

fn run {
  n = Node.new
  s = Slot { k: 1, node: n }
  puts(s.k)
}
