// D280 (Stage 28 W18F): a line whose first token is `[`, `-` or `+`
// begins a new statement; it never continues the line before. A line
// continues when the line before ends with an operator or an open
// bracket, or when it starts with `.`, `?` or another infix operator.

fn pair(a: String, b: String): Array(String) {
  bb = b
  [a, bb]
}

fn neg(x: Int): Int {
  y = x * 2
  -y
}

fn first(xs: Array(Int)): Int {
  xs[0]
}

fn main {
  a = "x"
  bb = "y"
  [a, bb].each { |s| puts(s) }
  ps = pair("p", "q")
  puts(ps.size)
  puts(ps[1])
  puts(neg(4))
  total = 1 +
  2
  puts(total)
  diff = 10 -
  3
  puts(diff)
  xs = [
  1,
  -2,
  3
  ]
  puts(xs[1])
  puts(first([
  7,
  8
  ]))
  grouped = (4 +
  5) * 2
  puts(grouped)
  m = xs[0] * 3
  * 2
  puts(m)
  ok = xs[0] == 1
  && xs[2] == 3
  puts(ok)
  y = -5
  z = y
  .abs
  puts(z)
  n = 0
  [1, 2, 3].each { |v| n += v }
  puts(n)
}
