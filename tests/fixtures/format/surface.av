fn fact(n :Int):Int{
	if n<=1{return 1}
	n*fact(n-1)
}



pub struct Vec2: Show+Eq(Vec2){
x:Int
y:Int
fn +(other:Vec2):Vec2{
Vec2{x:x+other.x,y:y+other.y}
}
}

pub interface Show{
fn to_s:String
}

pub class Counter{
value:Int=0
fn initialize(value:Int){
self.value=value
}
fn inc:Int{
value+=1
value-=1
value*=2
value/=2
value
}
}

lib math{
fun sqr(n:Int):Int
}

fn (c:Counter) scaled(s:Float64):Counter{
Counter.new(1)
}

fn show(v:T:Show):String{
v.to_s
}

fn map(xs:Array(T),f:fn(T):U):Array(U){
ys:Array(U)=[]
xs.each{|x|ys.push(f(x))}
ys
}

comptime{
for f in T.fields{
quote{
fn #(f.name):#(f.type){
self.#(f.name)
}
}
}
}

