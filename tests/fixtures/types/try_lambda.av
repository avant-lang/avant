// Stage 29 W1a (A3): a postfix `?` in a lambda returns from the lambda, so
// it is checked against the lambda's result, not the enclosing function's.

fn opt(s: String): Int? {
  if s.size > 0 {
    return s.size
  }
  nil
}

fn twice(s: String): Int? {
  n = opt(s)?
  n * 2
}

fn main {
  f: fn(String): Int? = { |s| opt(s)? + 1 }
  if v = f("abc") {
    puts("f(abc) = ${v}")
  }
  if v = f("") {
    puts("wrong: f() = ${v}")
  } else {
    puts("f() = nil")
  }
  if v = twice("ab") {
    puts("twice(ab) = ${v}")
  }
  if v = twice("") {
    puts("wrong: twice() = ${v}")
  } else {
    puts("twice() = nil")
  }
}
