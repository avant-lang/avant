// The union member-order probe (Stage 28 W7a, D192, mir.md section 14):
// two modules each define `Node`. Members are sorted by shown name and
// both show as `Node`, so the stable sort keeps the written order:
// `order_a.Node | order_b.Node` has tags a = 0, b = 1, and
// `order_b.Node | order_a.Node` has b = 0, a = 1. The checker's same_as
// compares union members by position, so the two are different types,
// and ty_assignable lets a value cross between them. The new back end
// re-tags it (`retag`); the old back end does not convert a union into
// another union (emit_coerce wraps members only), gives both orders the
// same myc layout name `U_Node_Node`, and fails to compile `via_ba`
// (myc-llvm: `ptr<b__Node> = ptr<a__Node>`). Expected difference
// (tools/backend-diff.sh); the proposed checker fix is a module-qualified
// sort key, so both orders build one member list.

import order_a
import order_b

fn ab(n: Int): order_a.Node | order_b.Node {
  if n > 0 {
    return order_a.mk_a(n)
  }
  order_b.mk_b("bee")
}

fn ba(n: Int): order_b.Node | order_a.Node {
  ab(n)
}

fn via_ab(n: Int): String | order_b.Node {
  x = ab(n)?
  "a=${x.v}"
}

fn via_ba(n: Int): String | order_b.Node {
  x = ba(n)?
  "a=${x.v}"
}

fn main {
  if r = via_ab(5) {
    puts(r)
  } else {
    puts("ab: the failure side")
  }
  if r2 = via_ba(5) {
    puts(r2)
  } else {
    puts("ba: the failure side")
  }
  if r3 = via_ba(-1) {
    puts(r3)
  } else {
    puts("ba(-1): the failure side")
  }
}
