// Stage 29 W1a (A5): one rule for empty parentheses. A method or builtin
// without arguments may be called with or without `()`, and `Buf.new` is
// `buf_new()`. Each line prints the field form and the call form.

class Box {
  n: Int = 4
  fn twice: Int { self.n * 2 }
}

fn main {
  s = "  a b  "
  puts("${s.size} ${s.size()}")
  puts("[${s.strip}] [${s.strip()}]")
  puts("[${s.strip_left}] [${s.strip_left()}]")
  puts("[${s.strip_right}] [${s.strip_right()}]")
  puts("${s.fields.size} ${s.fields().size()}")
  puts("${s.bytes.size} ${s.bytes().size()}")
  puts("${s.chars.size} ${s.chars().size()}")
  n = "42"
  puts("${n.to_i} ${n.to_i()} ${n.to_f} ${n.to_f()}")
  by = "xyz".bytes
  puts("${by.size} ${by.size()} ${by.chars.size} ${by.chars().size} ${by.to_buf.size} ${by.to_buf().size}")
  xs = [3, 1, 2]
  puts("${xs.size} ${xs.size()} ${xs.sum} ${xs.sum()}")
  if m = xs.min {
    puts("min ${m}")
  }
  if m = xs.min() {
    puts("min() ${m}")
  }
  if m = xs.max {
    puts("max ${m}")
  }
  if m = xs.max() {
    puts("max() ${m}")
  }
  ys = xs.sorted
  zs = xs.sorted()
  puts("${ys[0]} ${zs[0]}")
  xs.sort
  puts(xs[0])
  xs.reverse
  puts(xs[0])
  xs.sort()
  xs.reverse()
  puts(xs[0])
  puts("${xs.pop} ${xs.pop()}")
  xs.clear
  ws = [5]
  ws.clear()
  puts("${xs.size} ${ws.size()}")
  h = Hash(String, Int).new
  h["k"] = 1
  puts("${h.size} ${h.size()} ${h.keys.size} ${h.keys().size} ${h.values.size} ${h.values().size}")
  h.clear
  g = Hash(Int, Int).new
  g[1] = 2
  g.clear()
  puts("${h.size} ${g.size()}")
  b = Buf.new
  b.push_str("hey")
  c = Buf.new(64)
  c.push_str("you")
  d = buf_new()
  d.push_str("!")
  puts("${b.to_s} ${b.to_s()} ${c.to_s} ${d.to_s} ${b.size} ${b.size()} ${b.to_bytes.size} ${b.to_bytes().size}")
  b.clear
  c.clear()
  puts("${b.size} ${c.size}")
  i = -3
  puts("${i.abs} ${i.abs()} ${i.to_f} ${i.to_f()} ${i.to_i} ${i.to_i()}")
  puts("${i.to_i64} ${i.to_i64()} ${i.abs.to_u64.to_i64} ${i.abs.to_u64()}")
  f = 2.25
  puts("${f.sqrt} ${f.sqrt()} ${f.floor} ${f.floor()} ${f.to_i} ${f.to_i()}")
  puts("${(0.0 - f).abs} ${(0.0 - f).abs()} ${(0.0).exp} ${(0.0).exp()}")
  t = spawn { 6 }
  u = spawn { 7 }
  puts("${t.join} ${u.join()}")
  bx = Box.new
  puts("${bx.twice} ${bx.twice()}")
}
