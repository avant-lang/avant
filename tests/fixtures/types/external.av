// Methods on another module's types on the new back end (Stage 28
// W7a): `fn (b: shapes.Box) area` and `fn (g: shapes.Bag) first` are
// external methods (`av.external/shapes.Box.area`), the struct receiver
// by address, the class receiver by reference.

import shapes

fn (b: shapes.Box) area: Int {
  b.w * b.h
}

fn (b: shapes.Box) grow(k: Int) {
  b.w = b.w + k
}

fn (g: shapes.Bag) first: String? {
  if g.count == 0 {
    return nil
  }
  g.items[0]
}

fn main {
  b = shapes.mk_box(2, 3)
  puts(b.area)
  b.grow(4)
  puts(b.area())
  g = shapes.Bag.new
  puts(g.first ?? "empty")
  g.add("x")
  g.add("y")
  puts(g.first ?? "empty")
  puts(g.count)
}
