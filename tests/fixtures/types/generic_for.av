// Stage 29 W1a (review 5, defect 1): `for` inside generic functions and
// methods. An instance of a generic function lost the loop's set-up
// statements, so `for x in xs` named an undeclared `__for0_i` and
// `for i in 0..n` an undeclared `i`.

fn total(xs: Array(T)): Int {
  n = 0
  for i in 0..xs.size {
    for x in xs {
      if i == 0 {
        continue
      }
      n += 1
    }
  }
  n
}

class Bag(T) {
  items: Array(T)
  fn initialize(items: Array(T)) {
    self.items = items
  }
  fn count: Int {
    n = 0
    for x in self.items {
      n += 1
    }
    n
  }
}

fn main {
  puts(total([1, 2, 3]))
  puts(total(["a", "b"]))
  b = Bag(String).new(["x", "y"])
  puts(b.count)
}
