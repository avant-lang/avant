// A module for tests/fixtures/types/external.av (Stage 28 W7a): its types
// get methods defined in another module.

pub struct Box {
  w: Int
  h: Int
}

pub class Bag {
  items: Array(String)

  pub fn initialize {
    self.items = []
  }

  pub fn add(s: String) {
    items.push(s)
  }

  pub fn count: Int {
    items.size
  }
}

pub fn mk_box(w: Int, h: Int): Box {
  Box { w: w, h: h }
}
