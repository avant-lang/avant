// A module for tests/fixtures/types/order.av (Stage 28 W7a).

// Marked Error (D292, Stage 29 W4a): in order.av's `order_a.Node |
// order_b.Node` it is the failure `?` passes up.
pub class Node: Error {
  name: String

  pub fn initialize(name: String) {
    self.name = name
  }

  pub fn message: String {
    name
  }
}

pub fn mk_b(s: String): Node {
  Node.new(s)
}
