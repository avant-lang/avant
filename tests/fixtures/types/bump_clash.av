// O33 (Stage 28 W18C): a class with an instance method `bump` whose bump
// constructor is also called. Both were named `T.bump` (the checker's
// ty_owned_symbol(T, "bump") for both), so the MIR module defined the
// symbol twice and the method calls reached the constructor (the MIR
// verifier refused the module: V20, V7). The constructor is `T#bump` now.
// tests/fixtures/types/bump_method.av has the method on one class and the
// constructor on another.

class Counter {
  n: Int

  fn initialize(n: Int) {
    self.n = n
  }

  fn bump: Int {
    self.n = self.n + 1
    self.n
  }
}

fn main {
  c = Counter.new(1)
  puts(c.bump)
  if d = Counter.bump(10) {
    puts(d.n)
    puts(d.bump)
  } else {
    puts("no bump")
  }
  puts(c.bump)
}
