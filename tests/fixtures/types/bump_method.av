// A method named `bump` called on a value: `k.bump(2)` is
// the method (the checker once took every `.bump(...)` call for the
// bump constructor: `unknown type k`; the constructor itself is gone
// now). Field and implicit-field receivers too.
// tests/fixtures/ffi/layout.av has the `Ptr(Rec)` receiver case.

class Counter {
  n: Int = 0

  fn bump(by: Int): Int {
    self.n += by
    n
  }
}

class Leaf {
  v: Int

  fn initialize(v: Int) {
    self.v = v
  }
}

class Holder {
  c: Counter

  fn initialize {
    self.c = Counter.new()
  }

  fn twice(by: Int): Int {
    c.bump(by)
    self.c.bump(by)
  }
}

fn main {
  k = Counter.new()
  puts(k.bump(2))
  puts(k.bump(3))
  h = Holder.new()
  puts(h.twice(4))
  lf = Leaf.new(9)
  puts(lf.v)
}
