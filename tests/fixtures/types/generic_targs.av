// O32 (Stage 29 W1b): an instance of a generic function whose type
// parameter is bound by nothing in its parameters (here only by the
// result's expected type) still gets its `[targs]` symbol suffix, so the
// two instances are two functions (tests/goldens/types/generic_targs.mir:
// fresh[Int] and fresh[String]); before W10b's 12ad9a2 their symbols
// collided.
fn fresh: Array(T) {
  xs: Array(T) = []
  xs
}

fn main {
  a: Array(Int) = fresh()
  a.push(4)
  b: Array(String) = fresh()
  b.push("x")
  b.push("y")
  puts(a.size)
  puts(b.size)
  puts(b[1])
}
