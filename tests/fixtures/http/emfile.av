import std.http
import std.sync
import std.fs
import std.process

// accept failing for want of descriptors (EMFILE): run by
// tests/cases/test_std_http_safety.av with raw_client.py mode emfile.
// With an argument (a path) it writes its port there, takes every free
// descriptor (dup), and serves while a task measures the process's CPU
// time over a second in which a client's connection waits in the
// backlog; then it gives the descriptors back, the connection is
// accepted and answered, and the program prints the CPU time it saw.
// The loop polled the listening socket again at once after each failed
// accept, a busy loop: about a second of CPU in that second. Without an
// argument (the run goldens) it stops.

lib c {
  fun dup(fd: Int32): Int32
  fun close(fd: Int32): Int32
  fun clock: Int
  fun usleep(micros: UInt32): Int32
}

fn sleep_ms(ms: Int) {
  _ = c.usleep((ms * 1000).to_u32())
}

fn main: Int {
  a = process.args()
  if opened = http.listen(0, "127.0.0.1", 1048576, 1) {
    server = opened.memory_ceiling(0)
    server.get("/ping", (req) {
      http.Response.text("pong")
    })
    server.get("/__stop", (req) {
      server.close()
      http.Response.text("bye")
    })
    if a.size > 1 {
      if wrote = fs.write(a[1], "${server.port()}\n") {
      }
      fds: Array(Int) = []
      zero: Int32 = 0
      while true {
        fd = c.dup(zero)
        if fd < zero {
          break
        }
        fds.push(fd.to_i())
      }
      cpu = sync.Channel(Int).new(1)
      task = spawn {
        sleep_ms(300)
        c0 = c.clock()
        sleep_ms(1000)
        c1 = c.clock()
        for fd in fds {
          _ = c.close(fd.to_i32())
        }
        cpu.send((c1 - c0) / 1000)
        0
      }
      server.serve()
      _ = task.join()
      ms = cpu.recv() ?? -1
      if ms < 300 {
        puts("cpu while accept failed: under 300 ms")
      } else {
        puts("cpu while accept failed: ${ms} ms")
      }
      return 0
    }
    server.close()
    puts("closed")
    return 0
  }
  puts("listen failed")
  1
}
