import std.http
import std.sync

// A received request's headers (and its peer, which travels with them)
// are read while its handler runs: the connection's buffer then holds
// the next requests. Inside the handler they read as always, the same
// values each time; the header set a handler took (req.headers())
// stays readable after it; a request built in memory keeps its own.
// A read of a kept request after its handler returned traps, naming
// the program's call: in a later handler (the request answered 500,
// the server goes on) or in a task that took it from the handler
// through a Mutex (the task ends trapped). The server has one loop, so the later handler's
// dispatch is on the same thread as the kept request's. The first
// argument names the late read: header, headers, peer or task;
// without one (the run goldens) it is header. Run by
// tests/cases/test_std_http_safety.av once per kind.
fn main: Int {
  a = process.args()
  kind = "header"
  if a.size > 1 {
    kind = a[a.size - 1]
  }
  built = http.Request.build("GET", "/b?x=1", [http.Header { name: "X-Tag", value: "built" }])
  puts("built: ${built.header("x-tag") ?? "none"} ${built.headers().count()} '${built.peer()}'")
  if opened = http.listen(0, "127.0.0.1", 1048576, 1) {
    server = opened
    kept = sync.Mutex(Array(http.Request)).new([])
    taken = sync.Channel(http.Headers).new(4)
    go = sync.Channel(Int).new(4)
    server.get("/keep", (req) {
      first = req.header("X-Tag") ?? "none"
      second = req.header("x-tag") ?? "none"
      all = req.headers()
      taken.send(all)
      kept.with((xs) { xs.push(req) })
      Response.text("kept ${first} ${second} ${all.get("X-Tag") ?? "none"} ${req.peer()}")
    })
    server.get("/late", (req) {
      if kind == "task" {
        go.send(1)
        return Response.text("went")
      }
      k = kept.with((xs): http.Request? { xs.get(0) }) ?? return Response.text("nothing kept", 500)
      if kind == "headers" {
        return Response.text("read ${k.headers().count()}")
      } else if kind == "peer" {
        return Response.text("read ${k.peer()}")
      }
      Response.text("read ${k.header("X-Tag") ?? "none"}")
    })
    server.get("/taken", (req) {
      hs = taken.recv() ?? return Response.text("nothing taken", 500)
      Response.text("taken ${hs.get("X-Tag") ?? "none"} ${req.header("X-Tag") ?? "none"}")
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    // The task that keeps a request: it takes it once its handler has
    // returned (the next request's handler says so) and reads it.
    keeper = spawn {
      if kind == "task" {
        _ = go.recv()
        if k = kept.with((xs): http.Request? { xs.get(0) }) {
          puts("task read: ${k.header("X-Tag") ?? "none"}")
        }
      }
      0
    }
    client = spawn {
      for path in ["/keep", "/late", "/taken"] {
        if resp = http.get("http://127.0.0.1:${port}${path}", true, 5000, headers: ["X-Tag": "t${path.size}"]) {
          puts("${path}: ${resp.status} ${resp.body_text() ?? "?"}")
        } else {
          puts("${path}: no answer")
        }
      }
      if resp = http.get("http://127.0.0.1:${port}/__stop", true, 5000) {
      }
      0
    }
    server.serve()
    _ = client.join()
    puts("keeper joined: ${keeper.join() ?? -1}")
    return 0
  }
  puts("listen failed")
  1
}

// Imported last, so no line the goldens name moves.
import std.process

type Response = http.Response
