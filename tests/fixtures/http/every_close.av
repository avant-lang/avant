import std.http
import std.sync

// Server.every and Server.on_close. A timer every 20 ms counts its
// runs, traps on its third and panics on its fourth: each is printed
// and the server goes on, so the timer runs again. A task closes the
// server after 400 ms, through its closer; the two close hooks run
// then, in their order, on the thread that called serve, after the
// loops stopped and before serve returns. A server closed without
// serving runs its hooks in close, and one its closer stopped before it
// served runs them in serve, which returns at once. The run goldens run
// it as it is.

lib c {
  fun usleep(micros: UInt32): Int32
}

fn sleep_ms(ms: Int) {
  _ = c.usleep((ms * 1000).to_u32())
}

fn at(xs: Array(Int), i: Int): Int {
  xs[i]
}

fn main: Int {
  if opened = http.listen(0, "127.0.0.1", 1048576, 2) {
    server = opened
    runs = sync.Mutex(Int).new(0)
    xs = [1, 2]
    server.every(20, () {
      n = runs.with((v) {
        v += 1
        v
      })
      if n == 3 {
        _ = at(xs, 5)
      }
      if n == 4 {
        panic("the timer panicked on run ${n}")
      }
    })
    server.on_close(() {
      n = runs.with((v) { v })
      if n > 5 {
        puts("hook 1: the timer ran on after its trap")
      } else {
        puts("hook 1: the timer ran ${n} times")
      }
    })
    server.on_close(() {
      puts("hook 2")
    })
    // The task stops the server through its closer, which crosses to
    // a task where the Server cannot.
    closer = server.closer()
    stopper = spawn {
      sleep_ms(400)
      closer.close()
    }
    server.serve()
    puts("served")
    _ = stopper.join()
  }
  if quiet = http.listen(0) {
    quiet.on_close(() {
      puts("closed without serving")
    })
    quiet.close()
    quiet.close()
    quiet.serve()
  }
  if early = http.listen(0) {
    early.on_close(() {
      puts("stopped by its closer before serving")
    })
    closer = early.closer()
    closer.close()
    early.serve()
    closer.close()
    early.close()
  }
  0
}
