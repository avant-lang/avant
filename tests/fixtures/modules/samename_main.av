// Stage 29 W1a (review 5, defect 2): two imported modules both export
// `class Node` with field defaults. Before, both classes' defaults stayed
// untyped, and the back end stopped with L0001 ("an untyped expression").

import samename_a
import samename_b

fn main {
  a = samename_a.Node.new
  b = samename_b.Node.new
  puts(a.v)
  puts(b.v)
  puts(b.w)
}
