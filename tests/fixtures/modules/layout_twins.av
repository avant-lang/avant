// Two modules' C layouts of one name, Pair: each module's Ptr(Pair) is
// its own layout, a field of one and a method of the other's pointer
// both named n.
import layout_a
import layout_b

fn main {
  puts(layout_a.read(layout_a.make()))
  puts(layout_b.read(layout_b.make()))
  puts(layout_a.make().twice())
}
