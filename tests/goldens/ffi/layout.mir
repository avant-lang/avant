module layout
file 0 "layout.av"

layout %layout.Owner = class { 0 rec: ptr %layout.Rec, 1 tag: ref str }  size 16 align 8 id 1
layout %layout.Rec = clayout { 0 id: i32, 1 name: ref str, 2 on: bool, 3 at: %layout.Pt, 4 big: i64, 5 link: ptr }  size 56 align 8
layout %layout.Pt = clayout { 0 x: f64, 1 y: f64 }  size 16 align 8
layout %elems(String) = elems { 0: ref str }  size 8 align 8 id 65535
layout %Array(String) = array { 0 data: ref %elems(String), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022

const str.0 = "the field at read or written through a NULL Ptr(Rec) (a pointer C may leave NULL is declared Ptr(Rec)? and tested: if p = ...)"
const str.1 = "the field id read or written through a NULL Ptr(Rec) (a pointer C may leave NULL is declared Ptr(Rec)? and tested: if p = ...)"
const str.2 = "the field big read or written through a NULL Ptr(Rec) (a pointer C may leave NULL is declared Ptr(Rec)? and tested: if p = ...)"
const str.3 = "rec "
const str.4 = "churn "
const str.5 = " "
const str.6 = "more text to fill the nursery"
const str.7 = "the field on read or written through a NULL Ptr(Rec) (a pointer C may leave NULL is declared Ptr(Rec)? and tested: if p = ...)"
const str.8 = "name-"
const str.9 = "on-the-heap"
const str.10 = "the field name read or written through a NULL Ptr(Rec) (a pointer C may leave NULL is declared Ptr(Rec)? and tested: if p = ...)"
const str.11 = "lay.ffi_rec_name"
const str.12 = "the C field Rec.name is NULL (declare it String? to read NULL as nil)"
const str.13 = "round "
const str.14 = "/40"
const str.15 = "the field link read or written through a NULL Ptr(Rec) (a pointer C may leave NULL is declared Ptr(Rec)? and tested: if p = ...)"
const str.16 = "owner"
const str.17 = "!"

typemap 1022 %Array(*) stride 0 bits [0x1]
typemap 1021 %Buf stride 0 bits [0x1]
typemap 1023 %Hash stride 0 bits [0x7]
typemap 1 %layout.Owner stride 0 bits [0x2]

