(program (fn parse_id (param raw Int) Int? (if (binary 45 (name raw) (int 0)) (return (nil))) (expr (name raw))) (fn bump (param id Int) Int? (assign 42 (name n) (try (call parse_id (name id)))) (expr (binary 37 (name n) (int 1)))) (fn main (if-assign x (call bump (int 40)) (expr (call puts (name x)))) (if-assign y (call bump (unary 38 (int 1))) (expr (call puts (name y))) (else (expr (call puts (int 0))))) (expr (call puts (expr)))))
