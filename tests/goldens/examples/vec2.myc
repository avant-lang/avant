STRUCT :Vec2
  TYPE :f64
  TYPE :f64
ENDSTRUCT

FUNC :length2
  ARGS
    TYPE :Vec2
  RETURN
    TYPE :f64
  BODY
    CALL :avant_gc_enter
    PARAM 0
    LOCAL :v :Vec2
    STORE
    LOCAL :v :Vec2
    FIELD 0
    LOCAL :__t2 :f64
    STORE
    LOCAL :v :Vec2
    FIELD 0
    LOCAL :__t2
    BINARY :mul
    LOCAL :__t1 :f64
    STORE
    LOCAL :v :Vec2
    FIELD 1
    LOCAL :__t3 :f64
    STORE
    LOCAL :v :Vec2
    FIELD 1
    LOCAL :__t3
    BINARY :mul
    LOCAL :__t1
    BINARY :add
    CALL :avant_gc_leave
    RET
ENDFUNC

FUNC :main
  ARGS
    TYPE :i32
    TYPE :ptr<void>
  RETURN
    TYPE :i32
  BODY
    CALL :avant_gc_enter
    PUSH 1 :u64
    PUSH 1022 :u32
    CALL :avant_type_map
    PUSH 1 :u64
    PUSH 1021 :u32
    CALL :avant_type_map
    PUSH 7 :u64
    PUSH 1023 :u32
    CALL :avant_type_map
    PARAM 1
    PARAM 0
    CALL :avant_io_init_argv
    PUSH 3.0
    LOCAL :__t1 :f64
    STORE
    PUSH 4.0
    LOCAL :__t2 :f64
    STORE
    LOCAL :__t2
    LOCAL :__t1
    CREATE :Vec2
    LOCAL :v :Vec2
    STORE
    LOCAL :v :Vec2
    CALL :length2
    PUSH "%g\n"
    PRINTF 1
    CALL :avant_gc_leave
    PUSH 0
    RET
ENDFUNC

