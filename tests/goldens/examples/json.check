(program (fn main : Void (assign 42 (name doc : Ptr(Void)) (call json_parse (string {"n": 7, "name": "ada"} : String) : Ptr(Void))) (if-assign n (call json_int (name doc : Ptr(Void)) (string n : String) : Int?) (expr (call puts (name n : Int) : Void))) (if-assign name (call json_str (name doc : Ptr(Void)) (string name : String) : String?) (expr (call puts (name name : String) : Void)))))
