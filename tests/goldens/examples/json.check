(program (fn main : Void (if-assign doc (call parse (field (name std.json : ?) Json : ?) (string {"n": 7, "name": "ada"} : String) : Json | JsonError) (if-assign n (call int (name doc : Json) (string n : String) : Int?) (expr (call puts (name n : Int) : Void))) (if-assign name (call str (name doc : Json) (string name : String) : String?) (expr (call puts (name name : String) : Void))))))
