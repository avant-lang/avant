FUNC :main
  ARGS
    TYPE :i32
    TYPE :ptr<void>
  RETURN
    TYPE :i32
  BODY
    CALL :avant_gc_enter
    PUSH 1 :u64
    PUSH 1022 :u32
    CALL :avant_type_map
    PUSH 1 :u64
    PUSH 1021 :u32
    CALL :avant_type_map
    PUSH 7 :u64
    PUSH 1023 :u32
    CALL :avant_type_map
    PARAM 1
    PARAM 0
    CALL :avant_io_init_argv
    PUSH "{\"n\": 7, \"name\": \"ada\"}"
    CALL :avant_json_parse
    LOCAL :doc :ptr<void>
    STORE
    PUSH 0
    LOCAL :__t1 :i32
    STORE
    PUSH "n"
    LOCAL :__t2 :ptr<u8>
    STORE
    LOCAL :doc :ptr<void>
    LOCAL :__t3 :ptr<void>
    STORE
    LOCAL :__t1
    ADDR
    LOCAL :__t2
    LOCAL :__t3
    CALL :avant_json_get_int
    LOCAL :__t4 :i32
    STORE
    LOCAL :__t1
    PUSH 1
    BINARY :eq
    IF
      THEN
        LOCAL :__t4
        LOCAL :__t6 :i32
        STORE
        LOCAL :__t6
        PUSH 0
        CREATE :U_Int_Nil
        LOCAL :__t5 :U_Int_Nil
        STORE
      ELSE
        PUSH 0
        LOCAL :__t7 :i32
        STORE
        PUSH 0
        PUSH 1
        CREATE :U_Int_Nil
        LOCAL :__t5 :U_Int_Nil
        STORE
    ENDIF
    LOCAL :__t5
    LOCAL :__t8 :U_Int_Nil
    STORE
    LOCAL :__t8
    FIELD 0
    PUSH 1
    BINARY :not_eq
    IF
      THEN
        LOCAL :__t8
        FIELD 1
        LOCAL :n :i32
        STORE
        LOCAL :n :i32
        PUSH "%d\n"
        PRINTF 1
    ENDIF
    PUSH 0
    LOCAL :__t9 :i32
    STORE
    PUSH "name"
    LOCAL :__t10 :ptr<u8>
    STORE
    LOCAL :doc :ptr<void>
    LOCAL :__t11 :ptr<void>
    STORE
    LOCAL :__t9
    ADDR
    LOCAL :__t10
    LOCAL :__t11
    CALL :avant_json_get_str
    LOCAL :__t12 :ptr<u8>
    STORE
    LOCAL :__t12
    ADDR
    CALL :avant_gc_root
    LOCAL :__t9
    PUSH 1
    BINARY :eq
    IF
      THEN
        LOCAL :__t12
        LOCAL :__t14 :ptr<u8>
        STORE
        LOCAL :__t14
        ADDR
        CALL :avant_gc_root
        LOCAL :__t14
        PUSH 1
        CREATE :U_Nil_String
        LOCAL :__t13 :U_Nil_String
        STORE
      ELSE
        PUSH 0
        LOCAL :__t15 :i32
        STORE
        PUSH 0
        AS :ptr<u8>
        PUSH 0
        CREATE :U_Nil_String
        LOCAL :__t13 :U_Nil_String
        STORE
    ENDIF
    LOCAL :__t13
    LOCAL :__t16 :U_Nil_String
    STORE
    LOCAL :__t16
    FIELD 1
    ADDR
    CALL :avant_gc_root
    LOCAL :__t16
    FIELD 0
    PUSH 0
    BINARY :not_eq
    IF
      THEN
        LOCAL :__t16
        FIELD 1
        LOCAL :name :ptr<u8>
        STORE
        LOCAL :name
        ADDR
        CALL :avant_gc_root
        LOCAL :name :ptr<u8>
        PUSH "%s\n"
        PRINTF 1
    ENDIF
    CALL :avant_gc_leave
    PUSH 0
    RET
ENDFUNC

