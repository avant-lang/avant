(program (fn parse_id : Int? (param raw : Int) (if (binary 45 (name raw : Int) (int 0 : Int) : Bool) (return (nil : Nil))) (expr (name raw : Int))) (fn bump : Int? (param id : Int) (assign 42 (name n : Int) (try (call parse_id (name id : Int) : Int?) : Int)) (expr (binary 37 (name n : Int) (int 1 : Int) : Int))) (fn main : Void (if-assign x (call bump (int 40 : Int) : Int?) (expr (call puts (name x : Int) : Void))) (if-assign y (call bump (unary 38 (int 1 : Int) : Int) : Int?) (expr (call puts (name y : Int) : Void)) (else (expr (call puts (int 0 : Int) : Void)))) (expr (call puts (expr : String) : Void))))
