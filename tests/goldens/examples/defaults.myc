    PUSH 2 :u32
    CALL :avant_type_map
    PARAM 1
    PARAM 0
    CALL :avant_io_init_argv
    CALL :CalcNode__new
    LOCAL :n :ptr<CalcNode>
    STORE
    LOCAL :n
    ADDR
    CALL :avant_gc_root
    LOCAL :n :ptr<CalcNode>
    DEREF
    FIELD 0
    PUSH "%d\n"
    PRINTF 1
    LOCAL :n :ptr<CalcNode>
    DEREF
    FIELD 1
    CALL :avant_str_size
    PUSH "%d\n"
    PRINTF 1
    LOCAL :n :ptr<CalcNode>
    DEREF
    FIELD 2
    PUSH "%d\n"
    PRINTF 1
    PUSH 5
    CALL :Named__new
    LOCAL :m :ptr<Named>
    STORE
    LOCAL :m
    ADDR
    CALL :avant_gc_root
    LOCAL :m :ptr<Named>
    DEREF
    FIELD 0
    PUSH "%d\n"
    PRINTF 1
    LOCAL :m :ptr<Named>
    DEREF
    FIELD 1
    CALL :avant_str_size
    PUSH "%d\n"
    PRINTF 1
    CALL :avant_gc_leave
    PUSH 0
    RET
ENDFUNC

