module layouts
file 0 "layouts.av"

layout %layouts.Empty = class { }  size 0 align 1 id 1
layout %layouts.Node = class { 0 v: i64, 1 next: ref %layouts.Node, 2 label: ref str }  size 24 align 8 id 2
layout %layouts.Mixed = class { 0 flag: bool, 1 u: %(Int|String), 2 n: i64, 3 big: i64, 4 on: bool, 5 f: f64, 6 s: ref str, 7 opt: ref str }  size 80 align 8 id 3
layout %layouts.Wide = class { 0 w0: i64, 1 w1: i64, 2 w2: i64, 3 w3: i64, 4 w4: i64, 5 w5: i64, 6 w6: i64, 7 w7: i64, 8 w8: i64, 9 w9: i64, 10 w10: i64, 11 w11: i64, 12 w12: i64, 13 w13: i64, 14 w14: i64, 15 w15: i64, 16 w16: i64, 17 w17: i64, 18 w18: i64, 19 w19: i64, 20 w20: i64, 21 w21: i64, 22 w22: i64, 23 w23: i64, 24 w24: i64, 25 w25: i64, 26 w26: i64, 27 w27: i64, 28 w28: i64, 29 w29: i64, 30 w30: i64, 31 w31: i64, 32 w32: i64, 33 w33: i64, 34 w34: i64, 35 w35: i64, 36 w36: i64, 37 w37: i64, 38 w38: i64, 39 w39: i64, 40 w40: i64, 41 w41: i64, 42 w42: i64, 43 w43: i64, 44 w44: i64, 45 w45: i64, 46 w46: i64, 47 w47: i64, 48 w48: i64, 49 w49: i64, 50 w50: i64, 51 w51: i64, 52 w52: i64, 53 w53: i64, 54 w54: i64, 55 w55: i64, 56 w56: i64, 57 w57: i64, 58 w58: i64, 59 w59: i64, 60 w60: i64, 61 w61: i64, 62 w62: i64, 63 w63: i64, 64 w64: i64, 65 w65: i64, 66 w66: i64, 67 w67: i64, 68 w68: i64, 69 w69: i64, 70 name: ref str }  size 568 align 8 id 4
layout %layouts.Box = class { 0 first: bool, 1 r: %layouts.Ref, 2 last: ref str }  size 40 align 8 id 5
layout %(Int|String) = union { 0 tag: i32, 1 m0: i64, 2 m1: ref str }  size 24 align 8
layout %layouts.Ref = struct { 0 tag: i64, 1 node: ref %layouts.Node, 2 text: ref str }  size 24 align 8

const str.0 = "j"
const str.1 = "-"
const str.2 = "mixed-"
const str.3 = "wide-"
const str.4 = "inner-"
const str.5 = "ref-"
const str.6 = "last-"
const str.7 = "bad string at "
const str.8 = "bad box at "
const str.9 = "bad scalar at "
const str.10 = "%lld\0A"
const str.11 = "node"
const str.12 = ""

typemap 1022 %Array(*) stride 0 bits [0x1]
typemap 1021 %Buf stride 0 bits [0x1]
typemap 1023 %Hash stride 0 bits [0x7]
typemap 1 %layouts.Empty stride 0 bits [0x0]
typemap 2 %layouts.Node stride 0 bits [0x6]
typemap 3 %layouts.Mixed stride 0 bits [0x308]
typemap 4 %layouts.Wide stride 0 bits [0x0, 0x40]
