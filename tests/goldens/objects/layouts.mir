layout %layouts.Box = class { 0 first: bool, 1 r: %layouts.Ref, 2 last: ref str }  size 40 align 8 id 5
layout %(Int|String) = union { 0 tag: i32, 1 m0: i32, 2 m1: ref str }  size 16 align 8
layout %layouts.Ref = struct { 0 tag: i32, 1 node: ref %layouts.Node, 2 text: ref str }  size 24 align 8

const str.0 = "j"
const str.1 = "-"
const str.2 = "mixed-"
const str.3 = "wide-"
const str.4 = "last-"
