module layouts
file 0 "layouts.av"

layout %layouts.Empty = class { }  size 0 align 1 id 1
layout %layouts.Node = class { 0 v: i32, 1 next: ref %layouts.Node, 2 label: ref str }  size 24 align 8 id 2
layout %layouts.Mixed = class { 0 flag: bool, 1 u: %(Int|String), 2 n: i32, 3 big: i64, 4 on: bool, 5 f: f64, 6 s: ref str, 7 opt: ref str }  size 72 align 8 id 3
