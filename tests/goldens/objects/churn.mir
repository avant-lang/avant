module churn
file 0 "churn.av"

layout %churn.Leaf = class { 0 v: i32, 1 s: ref str }  size 16 align 8 id 1
layout %churn.Holder = class { 0 id: i32, 1 direct: ref %churn.Leaf, 2 slot: %churn.Slot, 3 opt: ref %churn.Leaf, 4 note: ref str }  size 56 align 8 id 2
layout %churn.Root = class { 0 h0: ref %churn.Holder, 1 h1: ref %churn.Holder, 2 h2: ref %churn.Holder }  size 24 align 8 id 3
layout %churn.Slot = struct { 0 k: i32, 1 leaf: ref %churn.Leaf, 2 name: ref str }  size 24 align 8

const str.0 = "name-"
const str.1 = "adopted-"
const str.2 = "slot-"
const str.3 = "copy-"
const str.4 = "%d\0A"
const str.5 = "%s\0A"
const str.6 = "refill-"
const str.7 = "leaf-"
const str.8 = ""
const str.9 = "none"

typemap 1022 %Array(*) stride 0 bits [0x1]
typemap 1021 %Buf stride 0 bits [0x1]
typemap 1023 %Hash stride 0 bits [0x7]
typemap 1 %churn.Leaf stride 0 bits [0x2]
typemap 2 %churn.Holder stride 0 bits [0x7a]
typemap 3 %churn.Root stride 0 bits [0x7]

