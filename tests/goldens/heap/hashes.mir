module hashes
file 0 "hashes.av"

layout %Hash = hash { 0 keys: ref, 1 vals: ref, 2 state: ref, 3 size: i32, 4 cap: i32, 5 key_kind: i32, 6 val_kind: i32 }  size 40 align 8 id 1023
layout %elems(String) = elems { 0: ref str }  size 8 align 8 id 65535
layout %Array(String) = array { 0 data: ref %elems(String), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %elems(Int) = elems { 0: i32 }  size 4 align 4
layout %Array(Int) = array { 0 data: ref %elems(Int), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %(Nil|Int) = union { 0 tag: i32, 1 m0: i32 }  size 8 align 4
layout %elems(u8) = elems { 0: u8 }  size 1 align 1
layout %Buf = buf { 0 data: ref %elems(u8), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1021

