layout %Array(Array(Int)) = array { 0 data: ref %elems(Array(Int)), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %Hash = hash { 0 keys: ref, 1 vals: ref, 2 state: ref, 3 size: i32, 4 cap: i32, 5 key_kind: i32, 6 val_kind: i32 }  size 40 align 8 id 1023
layout %elems(churn.Holder) = elems { 0: ref %churn.Holder }  size 8 align 8 id 65535
layout %Array(churn.Holder) = array { 0 data: ref %elems(churn.Holder), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022

const str.0 = "j"
const str.1 = "leaf-"
const str.2 = "t"
const str.3 = "?"
const str.4 = "v-"
const str.5 = "n"
const str.6 = "x"
const str.7 = ""
const str.8 = "f"
const str.9 = "v-k"
const str.10 = "k"
const str.11 = "c"
const str.12 = "%lld\0A"

typemap 1022 %Array(*) stride 0 bits [0x1]
typemap 1021 %Buf stride 0 bits [0x1]
typemap 1023 %Hash stride 0 bits [0x7]
typemap 1 %churn.Leaf stride 0 bits [0x2]
typemap 2 %churn.Holder stride 0 bits [0x7e]
typemap 3 %churn.Root stride 0 bits [0x1]
typemap 4 %elems(churn.Slot) stride 3 bits [0x6]

