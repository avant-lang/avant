module churn
file 0 "churn.av"

layout %churn.Leaf = class { 0 v: i64, 1 s: ref str }  size 16 align 8 id 1
layout %churn.Holder = class { 0 id: i64, 1 leaves: ref %Array(churn.Leaf), 2 slots: ref %Array(churn.Slot), 3 names: ref %Array(String), 4 rows: ref %Array(Array(Int)), 5 h: ref %Hash, 6 counts: ref %Hash }  size 56 align 8 id 2
