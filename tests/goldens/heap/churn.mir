layout %elems(churn.Leaf) = elems { 0: ref %churn.Leaf }  size 8 align 8 id 65535
layout %Array(churn.Leaf) = array { 0 data: ref %elems(churn.Leaf), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %churn.Slot = struct { 0 k: i64, 1 leaf: ref %churn.Leaf, 2 tag: ref str }  size 24 align 8
layout %elems(churn.Slot) = elems { 0: %churn.Slot }  size 24 align 8 id 4
layout %Array(churn.Slot) = array { 0 data: ref %elems(churn.Slot), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %elems(String) = elems { 0: ref str }  size 8 align 8 id 65535
