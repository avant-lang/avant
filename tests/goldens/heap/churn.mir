module churn
file 0 "churn.av"

layout %churn.Leaf = class { 0 v: i32, 1 s: ref str }  size 16 align 8 id 1
layout %churn.Holder = class { 0 id: i32, 1 leaves: ref %Array(churn.Leaf), 2 slots: ref %Array(churn.Slot), 3 names: ref %Array(String), 4 rows: ref %Array(Array(Int)), 5 h: ref %Hash, 6 counts: ref %Hash }  size 56 align 8 id 2
layout %churn.Root = class { 0 holders: ref %Array(churn.Holder) }  size 8 align 8 id 3
layout %elems(churn.Leaf) = elems { 0: ref %churn.Leaf }  size 8 align 8 id 65535
layout %Array(churn.Leaf) = array { 0 data: ref %elems(churn.Leaf), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %churn.Slot = struct { 0 k: i32, 1 leaf: ref %churn.Leaf, 2 tag: ref str }  size 24 align 8
layout %elems(churn.Slot) = elems { 0: %churn.Slot }  size 24 align 8 id 4
layout %Array(churn.Slot) = array { 0 data: ref %elems(churn.Slot), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %elems(String) = elems { 0: ref str }  size 8 align 8 id 65535
layout %Array(String) = array { 0 data: ref %elems(String), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %elems(Int) = elems { 0: i32 }  size 4 align 4
layout %Array(Int) = array { 0 data: ref %elems(Int), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %elems(Array(Int)) = elems { 0: ref %Array(Int) }  size 8 align 8 id 65535
layout %Array(Array(Int)) = array { 0 data: ref %elems(Array(Int)), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022
layout %Hash = hash { 0 keys: ref, 1 vals: ref, 2 state: ref, 3 size: i32, 4 cap: i32, 5 key_kind: i32, 6 val_kind: i32 }  size 40 align 8 id 1023
layout %elems(churn.Holder) = elems { 0: ref %churn.Holder }  size 8 align 8 id 65535
layout %Array(churn.Holder) = array { 0 data: ref %elems(churn.Holder), 1 size: i32, 2 cap: i32 }  size 16 align 8 id 1022

const str.0 = "j"
const str.1 = "leaf-"
const str.2 = "t"
const str.3 = "?"
const str.4 = "v-"
const str.5 = "n"
const str.6 = "x"
const str.7 = "f"
const str.8 = "v-k"
const str.9 = "k"
const str.10 = "c"
const str.11 = "%d\0A"

typemap 1022 %Array(*) stride 0 bits [0x1]
typemap 1021 %Buf stride 0 bits [0x1]
typemap 1023 %Hash stride 0 bits [0x7]
typemap 1 %churn.Leaf stride 0 bits [0x2]
typemap 2 %churn.Holder stride 0 bits [0x7e]
typemap 3 %churn.Root stride 0 bits [0x1]
typemap 4 %elems(churn.Slot) stride 3 bits [0x6]

