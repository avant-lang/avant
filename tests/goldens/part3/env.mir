  let _7: %(Nil|String)
  let _8: i32
  let _9: bool
  let _10: ref str
  let _11 (s): ref str
  let _12: i32
  let _13: bool
  let _14: i32
  let _15: i32

bb0:
  _4 = zero   @1:1
  gc.enter   @1:1
  gc.roots _2, _4   @1:1
  call __avant_type_maps() nocollect   @1:1
  call avant_io_init_argv(copy _1, copy _2) collects   @1:1
  _3 = const i32 0   @2:10
  _4 = addr.raw _3   @2:10
  _5 = call avant_env_get(const str.0, copy _4) collects   @2:10
  _6 = eq copy _3, const i32 1   @2:10
  branch copy _6, bb1, bb2   @2:10

bb1:
  _7 = union %(Nil|String) tag 1 (copy _5)   @2:10
  goto bb3   @2:10

bb2:
  _7 = union %(Nil|String) tag 0   @2:10
  goto bb3   @2:10

bb3:
  _8 = copy _7.0   @2:3
  _9 = ne copy _8, const i32 0   @2:3
  branch copy _9, bb4, bb5   @2:3

bb4:
  _10 = copy _7.1   @2:3
  _11 = copy _10   @2:3
  _12 = call avant_str_size(copy _11) nocollect   @3:11
  _13 = gt copy _12, const i32 0   @3:17
  _14 = cast copy _13 to i32   @3:5
  call printf(const str.1, copy _14) nocollect   @3:5
  goto bb6   @2:3

bb5:
  _15 = cast const bool false to i32   @5:5
  call printf(const str.1, copy _15) nocollect   @5:5
  goto bb6   @2:3

bb6:
  _0 = const i32 0   @1:1
  gc.leave   @1:1
  return   @1:1
}
