module env
file 0 "env.av"

layout %(Nil|String) = union { 0 tag: i32, 1 m0: ref str }  size 16 align 8

const str.0 = "PATH"
const str.1 = "%d\0A"

typemap 1022 %Array(*) stride 0 bits [0x1]
typemap 1021 %Buf stride 0 bits [0x1]
typemap 1023 %Hash stride 0 bits [0x7]

extern __avant_type_maps() -> void never
extern avant_env_get(ref str, ptr) -> ref str collects
extern avant_io_init_argv(i32, ptr) -> void collects
extern avant_str_size(ref str) -> i32 never
extern printf(ref str, ...) -> i32 never

fn main(_1: i32, _2: ptr) -> i32 frame extern @env.av:1:1 {
  let _0: i32
  let _1 (argc): i32
  let _2 (argv): ptr slot
  let _3: i32
  let _4: ptr i32 slot
  let _5: ref str
