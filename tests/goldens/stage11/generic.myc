FUNC :main
  ARGS
    TYPE :i32
    TYPE :ptr<void>
  RETURN
    TYPE :i32
  BODY
    CALL :avant_gc_enter
    PUSH 1 :u64
    PUSH 1022 :u32
    CALL :avant_type_map
    PUSH 1 :u64
    PUSH 1021 :u32
    CALL :avant_type_map
    PUSH 7 :u64
    PUSH 1023 :u32
    CALL :avant_type_map
    PARAM 1
    PARAM 0
    CALL :avant_io_init_argv
    PUSH 9
    CALL :id__Int
    PUSH "%d\n"
    PRINTF 1
    PUSH "xy"
    CALL :id__String
    CALL :avant_str_size
    PUSH "%d\n"
    PRINTF 1
    PUSH 2
    AS :u64
    SIZEOF :i32
    BINARY :mul
    PUSH 0 :u32
    STACK :swap2
    CALL :avant_alloc
    AS :ptr<i32>
    LOCAL :__t1 :ptr<i32>
    STORE
    LOCAL :__t1
    ADDR
    CALL :avant_gc_root
    PUSH 8
    PUSH 0
    LOCAL :__t1
    BINARY :add
    DEREF
    STORE
    PUSH 1
    PUSH 1
    LOCAL :__t1
    BINARY :add
    DEREF
    STORE
    PUSH 2
    LOCAL :__t2 :i32
    STORE
    PUSH 1022 :u32
    SIZEOF :Array_Int
    CALL :avant_alloc
    AS :ptr<Array_Int>
    LOCAL :__t3 :ptr<Array_Int>
    STORE
    LOCAL :__t3
    ADDR
    CALL :avant_gc_root
    LOCAL :__t1
    LOCAL :__t3
    DEREF
    FIELD 0
    STORE
    LOCAL :__t2
    LOCAL :__t3
    DEREF
    FIELD 1
    STORE
    LOCAL :__t2
    LOCAL :__t3
    DEREF
    FIELD 2
    STORE
    LOCAL :__t3
    CALL :avant_barrier
    LOCAL :__t3
    LOCAL :xs :ptr<Array_Int>
    STORE
    LOCAL :xs
    ADDR
    CALL :avant_gc_root
    LOCAL :xs :ptr<Array_Int>
    CALL :first__Int
    PUSH "%d\n"
    PRINTF 1
    PUSH 0
    LOCAL :__t4 :i32
    STORE
    LOCAL :__t4
    CREATE :Box
    LOCAL :b :Box
    STORE
    PUSH 11
    LOCAL :b :Box
    ADDR
    CALL :Box__wrap__Int
    PUSH "%d\n"
    PRINTF 1
    CALL :avant_gc_leave
    PUSH 0
    RET
ENDFUNC

