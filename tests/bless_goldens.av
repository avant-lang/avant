// Regenerate tests/goldens from compiler B (D48).
//   AVANT_COMPILER=./bin/avant-av-b ./bin/avant-av-b run tests/bless_goldens.av

lib bless_rt {
  fun avant_tmp_dir: String
}

// The private scratch directory (D127), removed when this tool exits.
fn scratch: String {
  bless_rt.avant_tmp_dir()
}

fn str_eq(a: String, b: String): Bool {
  if a.size != b.size {
    return false
  }
  i = 0
  while i < a.size {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn avant_test_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  "."
}

fn mkdir_p(path: String) {
  args: Array(String) = []
  args.push("-p")
  args.push(path)
  dummy = process_run("/bin/mkdir", args)
}

fn dump_av(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(src)
  process_run_out(compiler, args, log)
}

// A hidden front-end dump of the compiler under test (D137): flag is
// --tokens, --ast, or --check.
fn dump_layer(compiler: String, flag: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(flag)
  args.push(src)
  process_run_out(compiler, args, log)
}

fn bless_fail(msg: String) {
  puts("FAIL  tests/bless_goldens.av")
  puts(msg)
}

fn bless_layer(compiler: String, flag: String, src: String, dest: String, tag: String): Bool {
  code = dump_layer(compiler, flag, src, dest)
  if code != 0 {
    bless_fail("dump ${tag} exited ${code}")
    if err = file_read(dest) {
      puts(err)
    }
    return false
  }
  if file_exists(dest) {
    return true
  }
  bless_fail("dump ${tag} wrote nothing")
  false
}

fn bless_myc(compiler: String, src: String, dest: String, tag: String): Bool {
  code = dump_av(compiler, src, dest)
  if code != 0 {
    bless_fail("dump ${tag} exited ${code}")
    if err = file_read(dest) {
      puts(err)
    }
    return false
  }
  if file_exists(dest) {
    return true
  }
  bless_fail("dump ${tag} wrote nothing")
  false
}

// The MIR the new back end prints (Stage 28 W5b, D171): `avant dump`
// under AVANT_BACKEND=llvm, into tests/goldens/<stem>.mir.
fn bless_mir(compiler: String, root: String, src_rel: String, stem: String): Bool {
  args: Array(String) = []
  args.push("AVANT_BACKEND=llvm")
  args.push(compiler)
  args.push("dump")
  args.push("${root}/${src_rel}")
  dest = "${root}/tests/goldens/${stem}.mir"
  code = process_run_out("/usr/bin/env", args, dest)
  if code != 0 {
    bless_fail("dump ${stem}.mir exited ${code}")
    if err = file_read(dest) {
      puts(err)
    }
    return false
  }
  true
}

// The .mir goldens of the scalar subset (tests/cases/test_scalars.av) and
// of the string subset (tests/cases/test_strings.av, Stage 28 W6a), and
// of the object subset (tests/cases/test_objects.av, Stage 28 W6b), and
// of the heap subset (tests/cases/test_heap.av, Stage 28 W6c).
fn bless_mir_all(compiler: String, root: String): Bool {
  mkdir_p("${root}/tests/goldens/scalars")
  names = ["calls", "control", "conv", "floats", "ints", "loop_sum", "run_status", "shifts", "status", "switches", "trap_add", "trap_div", "trap_neg", "trap_rem", "trap_u64"]
  i = 0
  while i < names.size {
    if bless_mir(compiler, root, "tests/fixtures/scalars/${names[i]}.av", "scalars/${names[i]}") {
    } else {
      return false
    }
    i = i + 1
  }
  mkdir_p("${root}/tests/goldens/strings")
  sn = ["churn", "concat", "interp", "members", "trap_index"]
  i = 0
  while i < sn.size {
    if bless_mir(compiler, root, "tests/fixtures/strings/${sn[i]}.av", "strings/${sn[i]}") {
    } else {
      return false
    }
    i = i + 1
  }
  mkdir_p("${root}/tests/goldens/objects")
  on = ["churn", "classes", "layouts", "structs"]
  i = 0
  while i < on.size {
    if bless_mir(compiler, root, "tests/fixtures/objects/${on[i]}.av", "objects/${on[i]}") {
    } else {
      return false
    }
    i = i + 1
  }
  mkdir_p("${root}/tests/goldens/heap")
  hn = ["arrays", "churn", "elems", "hashes", "refs"]
  i = 0
  while i < hn.size {
    if bless_mir(compiler, root, "tests/fixtures/heap/${hn[i]}.av", "heap/${hn[i]}") {
    } else {
      return false
    }
    i = i + 1
  }
  ex = ["hello", "fact", "switch"]
  i = 0
  while i < ex.size {
    if bless_mir(compiler, root, "examples/${ex[i]}.av", "examples/${ex[i]}") {
    } else {
      return false
    }
    i = i + 1
  }
  true
}

// A program that imports has no --check golden (D142).
fn bless_imports(compiler: String, root: String, src_rel: String, stem: String): Bool {
  src = "${root}/${src_rel}"
  base = "${root}/tests/goldens/${stem}"
  if bless_layer(compiler, "--tokens", src, "${base}.tok", "${stem}.tok") {
  } else {
    return false
  }
  if bless_layer(compiler, "--ast", src, "${base}.ast", "${stem}.ast") {
  } else {
    return false
  }
  bless_myc(compiler, src, "${base}.myc", "${stem}.myc")
}

fn bless_all(compiler: String, root: String, src_rel: String, stem: String): Bool {
  src = "${root}/${src_rel}"
  base = "${root}/tests/goldens/${stem}"
  if bless_layer(compiler, "--tokens", src, "${base}.tok", "${stem}.tok") {
  } else {
    return false
  }
  if bless_layer(compiler, "--ast", src, "${base}.ast", "${stem}.ast") {
  } else {
    return false
  }
  if bless_layer(compiler, "--check", src, "${base}.check", "${stem}.check") {
  } else {
    return false
  }
  bless_myc(compiler, src, "${base}.myc", "${stem}.myc")
}

fn main {
  if compiler = env_get("AVANT_COMPILER") {
    if file_exists(compiler) {
    } else {
      bless_fail("AVANT_COMPILER does not exist: ${compiler}")
      return
    }
    root = avant_test_root()
    mkdir_p("${root}/tests/goldens/examples")
    mkdir_p("${root}/tests/goldens/part3")
    mkdir_p("${root}/tests/goldens/overloading")
    mkdir_p("${root}/tests/goldens/modules")
    mkdir_p("${root}/tests/goldens/macros")
    ok = true
    if bless_all(compiler, root, "examples/hello.av", "examples/hello") {
    } else { ok = false }
    if ok {
      if bless_all(compiler, root, "examples/fact.av", "examples/fact") {
      } else { ok = false }
    }
