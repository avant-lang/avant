// Regenerate the dump goldens of tests/goldens that tests/goldens/list.txt
// lists (D48; one list with the test files since O355, Stage 29 W5d2):
//   AVANT_COMPILER=./bin/avant-c-llvm ./bin/avant-c-llvm run tests/bless_goldens.av
// The run goldens (tests/goldens/runs/) are tools/run-goldens.sh --bless.

lib bless_rt {
  fun avant_tmp_dir: String
}

// The private scratch directory (D127), removed when this tool exits.
fn scratch: String {
  bless_rt.avant_tmp_dir()
}

fn avant_test_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  "."
}

fn mkdir_p(path: String) {
  args: Array(String) = []
  args.push("-p")
  args.push(path)
  _ = process_run("/bin/mkdir", args)
}

// The back end's IR, the MIR `avant dump` prints (D171; the goldens
// of the old back end retired with it, Stage 28 W11).
fn dump_av(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("-u")
  args.push("AVANT_BACKEND")
  args.push(compiler)
  args.push("dump")
  args.push(src)
  process_run_out("/usr/bin/env", args, log) ?? -1
}

// A hidden front-end dump of the compiler under test (D137): flag is
// --tokens, --ast, or --check.
fn dump_layer(compiler: String, flag: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(flag)
  args.push(src)
  process_run_out(compiler, args, log) ?? -1
}

fn bless_fail(msg: String) {
  puts("FAIL  tests/bless_goldens.av")
  puts(msg)
}

fn bless_layer(compiler: String, flag: String, src: String, dest: String, tag: String): Bool {
  code = dump_layer(compiler, flag, src, dest)
  if code != 0 {
    bless_fail("dump ${tag} exited ${code}")
    if err = file_read(dest) {
      puts(err)
    }
    return false
  }
  if file_exists(dest) {
    return true
  }
  bless_fail("dump ${tag} wrote nothing")
  false
}

fn bless_dump(compiler: String, src: String, dest: String, tag: String): Bool {
  code = dump_av(compiler, src, dest)
  if code != 0 {
    bless_fail("dump ${tag} exited ${code}")
    if err = file_read(dest) {
      puts(err)
    }
    return false
  }
  if file_exists(dest) {
    return true
  }
  bless_fail("dump ${tag} wrote nothing")
  false
}

// The library directory a compiler built by tools/letters.sh reads (the
// `lib: PATH` line of COMPILER.versions.txt, O617), "" without one.
fn lib_dir_of(compiler: String): String {
  if t = file_read("${compiler}.versions.txt") {
    for line in t.split("\n") {
      if line.size > 5 && str_slice(line, 0, 5) == "lib: " {
        return str_slice(line, 5, line.size)
      }
    }
  }
  ""
}

// text with every "LIB/" written "lib/", as tests/cases/test_threads_llvm.av
// compares a MIR dump that names a std file.
fn lib_relative(text: String, libdir: String): String {
  if libdir.size == 0 {
    return text
  }
  prefix = "${libdir}/"
  out = buf_new()
  i = 0
  while i < text.size {
    if i + prefix.size <= text.size && str_slice(text, i, i + prefix.size) == prefix {
      out.push_str("lib/")
      i += prefix.size
    } else {
      out.push_byte(text[i])
      i += 1
    }
  }
  out.to_s
}

// The MIR (D171): `avant dump` into tests/goldens/STEM.mir, a std file
// named relative to the checkout.
fn bless_mir(compiler: String, src: String, dest: String, tag: String): Bool {
  if bless_dump(compiler, src, dest, tag) {
  } else {
    return false
  }
  libdir = lib_dir_of(compiler)
  if libdir.size > 0 {
    if text = file_read(dest) {
      rel = lib_relative(text, libdir)
      if rel != text {
        if (file_write(dest, rel) ?? -1) != rel.size {
          bless_fail("cannot write ${dest}")
          return false
        }
      }
    }
  }
  true
}

// One row of tests/goldens/list.txt (O355, Stage 29 W5d2): TEST STEM
// SOURCE LAYERS, every layer it names. The list is the test files' too
// (tests/cases/harness.av golden_rows), so what is checked is what is
// blessed.
fn bless_row(compiler: String, root: String, stem: String, src_rel: String, layers: Array(String)): Bool {
  src = "${root}/${src_rel}"
  base = "${root}/tests/goldens/${stem}"
  mkdir_p(path_dirname(base))
  for layer in layers {
    ok = true
    if layer == "tok" {
      ok = bless_layer(compiler, "--tokens", src, "${base}.tok", "${stem}.tok")
    } else if layer == "ast" {
      ok = bless_layer(compiler, "--ast", src, "${base}.ast", "${stem}.ast")
    } else if layer == "check" {
      ok = bless_layer(compiler, "--check", src, "${base}.check", "${stem}.check")
    } else if layer == "mir" {
      ok = bless_mir(compiler, src, "${base}.mir", "${stem}.mir")
    } else {
      bless_fail("tests/goldens/list.txt: ${stem}: unknown layer ${layer}")
      ok = false
    }
    if !ok {
      return false
    }
  }
  true
}

fn path_dirname(p: String): String {
  at = -1
  for i in 0..p.size {
    if p[i] == 47 {
      at = i
    }
  }
  if at <= 0 {
    return "."
  }
  str_slice(p, 0, at)
}

fn main {
  if compiler = env_get("AVANT_COMPILER") {
    if !file_exists(compiler) {
      bless_fail("AVANT_COMPILER does not exist: ${compiler}")
      return
    }
    root = avant_test_root()
    list = "${root}/tests/goldens/list.txt"
    if text = file_read(list) {
      n = 0
      for line in text.split("\n") {
        if line.size == 0 || line[0] == 35 {
          continue
        }
        words: Array(String) = []
        for w in line.split(" ") {
          if w.size > 0 {
            words.push(w)
          }
        }
        if words.size != 4 {
          bless_fail("${list}: a row is TEST STEM SOURCE LAYERS: ${line}")
          return
        }
        if bless_row(compiler, root, words[1], words[2], words[3].split(",")) {
        } else {
          return
        }
        n += 1
      }
      puts("PASS  tests/bless_goldens.av (${n} rows of ${list})")
    } else {
      bless_fail("cannot read ${list}")
    }
  } else {
    bless_fail("AVANT_COMPILER is not set")
  }
}
