// Regenerate tests/goldens from compiler B (D48).
//   AVANT_COMPILER=./bin/avant-av-b ./bin/avant-av-b run tests/bless_goldens.av

fn str_eq(a: String, b: String): Bool {
  if a.size != b.size {
    return false
  }
  i = 0
  while i < a.size {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn avant_test_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  "."
}

fn mkdir_p(path: String) {
  args: Array(String) = []
  args.push("-p")
  args.push(path)
  dummy = process_run("/bin/mkdir", args)
}

fn chmod_x(path: String) {
  args: Array(String) = []
  args.push("+x")
  args.push(path)
  dummy = process_run("/bin/chmod", args)
}

fn compile_av(compiler: String, src: String, bin: String, log: String): Int {
  args: Array(String) = []
  args.push("compile")
  args.push(src)
  args.push(bin)
  process_run_out(compiler, args, log)
}

fn dump_av(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(src)
  process_run_out(compiler, args, log)
}

fn dump_lex(dumper: String, flag: String, src: String, log: String): Int {
  args: Array(String) = []
  if flag.size > 0 {
    args.push(flag)
  }
  args.push(src)
  process_run_out(dumper, args, log)
}

fn bless_fail(msg: String) {
  puts("FAIL  tests/bless_goldens.av")
  puts(msg)
}

fn bless_layer(dumper: String, flag: String, src: String, dest: String, tag: String): Bool {
  code = dump_lex(dumper, flag, src, dest)
  if code != 0 {
    bless_fail("dump ${tag} exited ${code}")
    if err = file_read(dest) {
      puts(err)
    }
    return false
  }
  if file_exists(dest) {
    return true
  }
  bless_fail("dump ${tag} wrote nothing")
  false
}

fn bless_myc(compiler: String, src: String, dest: String, tag: String): Bool {
  code = dump_av(compiler, src, dest)
  if code != 0 {
    bless_fail("dump ${tag} exited ${code}")
    if err = file_read(dest) {
      puts(err)
    }
    return false
  }
  if file_exists(dest) {
    return true
  }
  bless_fail("dump ${tag} wrote nothing")
  false
}

fn bless_all(dumper: String, compiler: String, root: String, src_rel: String, stem: String): Bool {
  src = "${root}/${src_rel}"
  base = "${root}/tests/goldens/${stem}"
  if bless_layer(dumper, "", src, "${base}.tok", "${stem}.tok") {
  } else {
    return false
  }
  if bless_layer(dumper, "--ast", src, "${base}.ast", "${stem}.ast") {
  } else {
    return false
  }
  if bless_layer(dumper, "--check", src, "${base}.check", "${stem}.check") {
  } else {
    return false
  }
  bless_myc(compiler, src, "${base}.myc", "${stem}.myc")
}

fn main {
  if compiler = env_get("AVANT_COMPILER") {
    if file_exists(compiler) {
    } else {
      bless_fail("AVANT_COMPILER does not exist: ${compiler}")
      return
    }
    root = avant_test_root()
    mkdir_p("${root}/tests/goldens/examples")
    mkdir_p("${root}/tests/goldens/part3")
    mkdir_p("${root}/tests/goldens/overloading")
    mkdir_p("${root}/tests/goldens/modules")
    mkdir_p("${root}/tests/goldens/macros")
    stamp = now_ms()
    dumper = "/tmp/avant-s14-${stamp}-lex-dump"
    dlog = "/tmp/avant-s14-${stamp}-lex-dump.log"
    dcode = compile_av(compiler, "${root}/compiler/lex_dump.av", dumper, dlog)
    if dcode != 0 {
      bless_fail("compile lex_dump failed (${dcode})")
      if err = file_read(dlog) {
        puts(err)
      }
      return
    }
    if file_exists(dumper) {
    } else {
      bless_fail("lex_dump bin missing")
      if err = file_read(dlog) {
        puts(err)
      }
      return
    }
    chmod_x(dumper)
    ok = true
    if bless_all(dumper, compiler, root, "examples/hello.av", "examples/hello") {
    } else { ok = false }
