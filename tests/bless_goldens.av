      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "tests/fixtures/macros/method.av", "macros/method") {
      } else { ok = false }
    }
    if ok {
      modules_src = "${root}/tests/fixtures/modules/main.av"
      modules_golden = "${root}/tests/goldens/modules/main"
      if bless_layer(compiler, "--tokens", modules_src, "${modules_golden}.tok", "modules/main.tok") {
      } else { ok = false }
      if ok {
        if bless_layer(compiler, "--ast", modules_src, "${modules_golden}.ast", "modules/main.ast") {
        } else { ok = false }
      }
      if ok {
        if bless_myc(compiler, modules_src, "${modules_golden}.myc", "modules/main.myc") {
        } else { ok = false }
      }
    }
    if ok {
      hello_src = "${root}/tests/goldens/examples/hello.myc"
      hello_dst = "${root}/tests/goldens/hello.myc"
      if ir = file_read(hello_src) {
        dummy = file_write(hello_dst, ir)
      } else {
        bless_fail("read examples/hello.myc")
        ok = false
      }
    }
    if ok {
      if bless_mir_all(compiler, root) {
      } else { ok = false }
    }
    if ok {
      puts("PASS  tests/bless_goldens.av")
