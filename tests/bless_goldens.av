      } else { ok = false }
    }
    if ok {
      if bless_imports(compiler, root, "examples/json.av", "examples/json") {
      } else { ok = false }
    }
    if ok {
      if bless_imports(compiler, root, "examples/http.av", "examples/http") {
      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "examples/spawn.av", "examples/spawn") {
      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "examples/matmul.av", "examples/matmul") {
      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "tests/fixtures/part3/chr.av", "part3/chr") {
      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "tests/fixtures/part3/slice.av", "part3/slice") {
      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "tests/fixtures/part3/index.av", "part3/index") {
      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "tests/fixtures/part3/buf.av", "part3/buf") {
      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "tests/fixtures/part3/conv.av", "part3/conv") {
      } else { ok = false }
    }
    if ok {
      if bless_all(compiler, root, "tests/fixtures/part3/exists.av", "part3/exists") {
