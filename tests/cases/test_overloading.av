import harness

fn greet(name: String, times: Int = 1): Int {
  times
}

fn show(n: Int): Int {
  n
}

fn show(s: String): Int {
  s.size
}

fn id(x: T): T {
  x
}

fn first(xs: Array(T)): T {
  xs[0]
}

struct Vec {
  x: Int
  y: Int

  fn +(other: Vec): Vec {
    Vec { x: x + other.x, y: y + other.y }
  }

  fn wrap(v: T): T {
    v
  }
}

fn (a: Vec) *(s: Int): Vec {
  Vec { x: a.x * s, y: a.y * s }
}

fn test_overloading(c: Checks) {
  c.suite("tests/cases/test_overloading.av")
  c.eq_int(greet("hi"), 1, "default arg")
  c.eq_int(greet("hi", 4), 4, "explicit default arg")
  c.eq_int(show(7), 7, "overload Int")
  c.eq_int(show("ab"), 2, "overload String")
  c.eq_int(id(9), 9, "generic id Int")
  c.eq_int(id("xy").size, 2, "generic id String")
  xs: Array(Int) = [8, 1]
  c.eq_int(first(xs), 8, "generic first")
  a = Vec { x: 1, y: 2 }
  b = Vec { x: 3, y: 4 }
  s = a + b
  c.eq_int(s.x, 4, "operator + x")
  c.eq_int(s.y, 6, "operator + y")
  p = a * 3
  c.eq_int(p.x, 3, "operator * x")
  c.eq_int(p.y, 6, "operator * y")
  c.eq_int(a.wrap(11), 11, "generic method")
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_overloading(c)
  c.finish
}
