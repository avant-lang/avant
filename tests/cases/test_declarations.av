import harness
import backends

// Declarations: one spelling for a function without parameters, named
// arguments for parameters with defaults, struct fields with defaults,
// field parameters of initialize, grouping parentheses in types and an
// optional fn value. Each program is compiled in parallel; a refused one
// must leave no binary, say the expected words and point at the expected
// line and column; an accepted one must print what it should.

class RCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  pub ok: Bool = false
  pub status: Int = 0
  pub err: String = ""
}

fn refused(tag: String, src: String, needle: String, pos: String): RCase {
  f = RCase.new
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f
}

fn accepted(tag: String, src: String, out: String): RCase {
  f = RCase.new
  f.tag = tag
  f.src = src
  f.want = out
  f.ok = true
  f
}

// An accepted program that exits with status and writes err to stderr.
fn exits(tag: String, src: String, out: String, status: Int, err: String): RCase {
  f = accepted(tag, src, out)
  f.status = status
  f.err = err
  f
}

fn cases: Array(RCase) {
  xs: Array(RCase) = []
  // One declaration for a function without parameters
  xs.push(accepted("no-params", "fn answer: Int {\n  42\n}\nstruct P {\n  x: Int\n  fn twice: Int {\n    x * 2\n  }\n  fn self.origin: P {\n    P { x: 0 }\n  }\n}\nfn main {\n  puts(answer())\n  puts(P { x: 4 }.twice())\n  puts(P.origin().x)\n}\n", "42\n8\n0\n"))
  xs.push(refused("empty-parens", "fn answer(): Int {\n  42\n}\nfn main {\n  puts(answer())\n}\n", "a fn without parameters is declared without parentheses: write fn answer, not fn answer()", "1:11"))
  xs.push(refused("empty-parens-main", "fn main() {\n  puts(1)\n}\n", "write fn main, not fn main()", "1:9"))
  xs.push(refused("empty-parens-method", "struct P {\n  x: Int\n  fn twice(): Int {\n    x * 2\n  }\n}\nfn main { }\n", "write fn twice, not fn twice()", "3:12"))
  xs.push(refused("empty-parens-type-fn", "struct P {\n  x: Int\n  fn self.origin(): P {\n    P { x: 0 }\n  }\n}\nfn main { }\n", "write fn self.origin, not fn self.origin()", "3:18"))
  xs.push(refused("empty-parens-external", "struct P {\n  x: Int\n}\nfn (p: P) twice(): Int {\n  p.x * 2\n}\nfn main { }\n", "write fn twice, not fn twice()", "4:17"))
  xs.push(refused("empty-parens-interface", "interface Sized {\n  fn size(): Int\n}\nfn main { }\n", "write fn size, not fn size()", "2:11"))
  xs.push(refused("empty-parens-fun", "lib c {\n  fun getpid(): Int32\n}\nfn main { }\n", "a fun without parameters is declared without parentheses: write fun getpid, not fun getpid()", "2:14"))
  xs.push(accepted("fun-no-parens", "lib c {\n  fun getpid: Int32\n}\nfn main {\n  puts(c.getpid() > 0)\n}\n", "true\n"))
  // A call whose lambda argument is checked after the others takes its defaults
  xs.push(accepted("lambda-arg-defaults", "fn apply(f: fn(Int): Int, n: Int = 1, extra: Int = 0): Int {\n  f(n) + extra\n}\nfn main {\n  puts(apply({ |v| v * 10 }))\n  puts(apply({ |v| v * 10 }, 2))\n}\n", "10\n20\n"))
  // Named arguments for parameters with defaults
  pad = "fn pad(s: String, width: Int = 8, fill: String = \".\"): String {\n  out = s\n  while out.size < width {\n    out = out + fill\n  }\n  out\n}\n"
  xs.push(accepted("named", "${pad}fn main {\n  puts(pad(\"ab\", fill: \"*\"))\n  puts(pad(\"ab\", 4, fill: \"-\"))\n  puts(pad(\"ab\", fill: \"+\", width: 5))\n  puts(pad(\"ab\", width: 3))\n}\n", "ab******\nab--\nab+++\nab.\n"))
  // The written arguments are evaluated left to right as written, then the defaults.
  xs.push(accepted("named-order", "fn note(tag: String, n: Int): Int {\n  puts(tag)\n  n\n}\nfn three(a: Int, b: Int = note(\"default b\", 10), c: Int = 100, d: Int = note(\"default d\", 1000)): Int {\n  a + b + c + d\n}\nfn main {\n  puts(three(note(\"a\", 1), d: note(\"d\", 4), c: note(\"c\", 3)))\n}\n", "a\nd\nc\ndefault b\n18\n"))
  xs.push(accepted("named-reads-earlier", "fn span(a: Int, b: Int = a + 1, c: Int = b * 2): Int {\n  a * 100 + b * 10 + c\n}\nfn main {\n  puts(span(1, c: 5))\n  puts(span(1, b: 4))\n}\n", "125\n148\n"))
  xs.push(accepted("named-forms", "fn wrap(x: T, times: Int = 1): Array(T) {\n  out: Array(T) = []\n  for i in 0..times {\n    out.push(x)\n  }\n  out\n}\nfn apply(f: fn(Int): Int, n: Int = 1, extra: Int = 0): Int {\n  f(n) + extra\n}\nstruct Pt {\n  x: Int\n  y: Int\n  fn shifted(dx: Int = 0, dy: Int = 0): Pt {\n    Pt { x: x + dx, y: y + dy }\n  }\n  fn self.make(x: Int, y: Int = 3): Pt {\n    Pt { x: x, y: y }\n  }\n}\nfn (p: Pt) scaled(k: Int = 2, off: Int = 0): Int {\n  p.x * k + off\n}\nclass Conn {\n  host: String\n  port: Int\n  fn initialize(host: String, port: Int = 80) {\n    self.host = host\n    self.port = port\n  }\n}\nfn main {\n  puts(wrap(\"a\", times: 3).size)\n  puts(apply({ |v| v * 10 }))\n  puts(apply({ |v| v * 10 }, extra: 5, n: 2))\n  p = Pt { x: 1, y: 7 }\n  q = p.shifted(dy: 1)\n  puts(\"\${q.x} \${q.y}\")\n  puts(Pt.make(2, y: 8).y)\n  puts(p.scaled(off: 1))\n  puts(Conn.new(\"h\", port: 8080).port)\n  puts(Conn.new(\"h\").port)\n}\n", "3\n10\n25\n1 8\n8\n3\n8080\n80\n"))
  xs.push(refused("named-unknown", "${pad}fn main {\n  puts(pad(\"a\", wide: 3))\n}\n", "pad has no parameter named wide", "9:23"))
  xs.push(refused("named-no-default", "${pad}fn main {\n  puts(pad(s: \"a\"))\n}\n", "s of pad has no default, so it is passed by position: a name is given only to a parameter with a default", "9:8"))
  xs.push(refused("named-by-position", "${pad}fn main {\n  puts(pad(\"a\", 3, width: 4))\n}\n", "width is already given by position (argument 2 of pad)", "9:27"))
  xs.push(refused("named-twice", "${pad}fn main {\n  puts(pad(\"a\", fill: \"x\", fill: \"y\"))\n}\n", "fill is named twice", "9:34"))
  xs.push(refused("named-then-positional", "${pad}fn main {\n  puts(pad(\"a\", fill: \"x\", 3))\n}\n", "a positional argument cannot follow a named one: write the positional arguments first", "9:28"))
  xs.push(refused("named-wrong-type", "${pad}fn main {\n  puts(pad(\"a\", width: \"x\"))\n}\n", "expected Int, got String", "9:24"))
  xs.push(refused("named-builtin", "fn main {\n  xs = [1]\n  xs.push(v: 2)\n}\n", "push takes its arguments by position (v: is a named argument)", "3:14"))
  xs.push(refused("named-fn-value", "fn main {\n  f = { |x: Int| x }\n  puts(f(x: 1))\n}\n", "a fn value takes its arguments by position (x: is a named argument)", "3:13"))
  xs.push(refused("named-overload", "fn show(n: Int, width: Int = 4): String {\n  \"\${n}\"\n}\nfn show(s: String): String {\n  s\n}\nfn main {\n  puts(show(\"a\", width: 2))\n}\n", "show has no parameter named width", "8:25"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(RCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/decl-${f.tag}.av"
    _ = file_write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/decl-${f.tag}.bin", "${dir}/decl-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job(dir, "decl-${f2.tag}.bin", "decl-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/decl-${f3.tag}.log")
    if f3.ok {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.eq_int(runs[k].code, f3.status, "${f3.tag}: exit ${f3.status}")
      c.eq_str(log_text("${dir}/decl-${f3.tag}.run.out"), f3.want, "${f3.tag}: stdout")
      c.eq_str(log_text("${dir}/decl-${f3.tag}.run.err"), f3.err, "${f3.tag}: stderr")
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !file_exists("${dir}/decl-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(str_has(log, f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(str_has(log, "decl-${f3.tag}.av:${f3.pos}\n"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_declarations.av")
  if compiler = env_get("AVANT_COMPILER") {
    run_cases(c, compiler, scratch_dir(), cases())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
