import harness
import backends
import std.fs
import std.process

// The compiler's safety rules of this wave. Each program
// is compiled in parallel; a refused one must leave no binary, say the
// expected words and point at the expected line and column; an accepted
// one (the neighbouring legal forms) must print what it should.
//   - `Mutex.with`: the block's value leaves the lock, so it cannot
//     be, or hold, a reference to mutable state (a class handed out this
//     way was changed by two tasks at once, and updates were lost).
//   - `Mutex.with`'s statements: the guarded
//     value and every reference reached from it may only be a receiver
//     or an operand whose result is a plain value, never an argument, a
//     stored value or a captured name (race3: `keep.push(b)`, `out =
//     b.inner` and a function that stores it lost updates); a store into
//     the guarded value itself, and a name the block declares, keep it
//     under the lock and are allowed.
//   - Channel(T) and Mutex(T) are
//     std.sync's; a Channel of any T (a class, another Channel, a
//     Mutex); a send carries what may cross a task; the gate
//     builtins are the standard library's only.
//   - `Mutex.with` as a statement ends
//     without a value (its block's last expression is dropped, so a
//     reference there leaves nothing); `return`, `break`, `continue` and
//     `?` leave the block, the lock released (threads/with_exits.av runs
//     them across tasks); a returned reference obeys the statements' rule.
//   - `Mutex(T).new(v)` consumes v (a later
//     use is refused, and so is every way v could have been shared
//     before: an alias, an argument, a capture, a value from outside
//     stored into it, a value it holds that was not new, the call in a
//     loop around it); a field, an element, a parameter or a call's
//     result is refused as the argument; inside `with`, a value from
//     outside is not stored into the guarded value.
//   - `return` in a spawn or `.parallel`
//     block is refused by name (it was a type mismatch, and a bare
//     `return` stopped the compiler in the MIR verifier).
//   - a `for` variable is not assignable: `x = ...`
//     and `x += ...` on a range's counter or an array's element. Over an
//     Array of structs the variable is the element itself, so a field
//     written through it (`p.x = 1`, `p.pos.x += 1`) changes the element
//     (tests/cases/test_places.av has the place's rules). A class
//     element's field, a path through a reference, an index, and a name
//     the body binds anew stay legal.
//   - `Array(T).new(n, value)` is refused when T is, or
//     holds, a reference to an object that can change (every element
//     would be that one object), and `Array(T).new(n) { |i| ... }` builds
//     each element (tests/fixtures/heap/build.av runs it under the
//     collector's modes).
//   - a method whose parameters all have defaults, called
//     without parentheses, is the call with them (the build stopped in
//     the MIR verifier); a type-level function's defaults are checked and
//     typed like any argument. Defaults across modules are
//     tests/cases/test_modules.av's.

class RCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  pub ok: Bool = false
}

fn refused(tag: String, src: String, needle: String, pos: String): RCase {
  f = RCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f
}

fn accepted(tag: String, src: String, out: String): RCase {
  f = RCase.new()
  f.tag = tag
  f.src = src
  f.want = out
  f.ok = true
  f
}

fn mutex_cases: Array(RCase) {
  xs: Array(RCase) = []
  xs.push(refused("mutex-value-class", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  leaked = m.with { |b| b }\n  puts(leaked.n)\n}\n", "Mutex.with's value cannot be Box: it may be the guarded value or a part of it, which the lock no longer protects outside the block; end the block with a plain value (a number, a Bool, a String, Bytes, a struct or an optional of those, a Channel or a Mutex)", "16:25"))
  xs.push(refused("mutex-value-part", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  part = m.with { |b|\n    b.n += 1\n    b.inner\n  }\n  puts(part.n)\n}\n", "Mutex.with's value cannot be Inner: ", "18:6"))
  xs.push(refused("mutex-value-optional", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  nx = m.with { |b| b.next }\n  puts(1)\n}\n", "Mutex.with's value cannot be Box?: ", "16:22"))
  xs.push(refused("mutex-value-array", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Array(Int)).new([1, 2])\n  xs = m.with { |a| a }\n  puts(xs.size)\n}\n", "Mutex.with's value cannot be Array(Int): ", "16:21"))
  xs.push(accepted("mutex-value-fresh-array", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Int).new(1)\n  xs = m.with((n) { [n, n] })\n  puts(xs.size)\n}\n", "2\n"))
  xs.push(refused("mutex-value-hash", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Hash(String, Int)).new(Hash(String, Int).new())\n  h = m.with { |t| t }\n  puts(h.size)\n}\n", "Mutex.with's value cannot be Hash(String, Int): ", "16:20"))
  xs.push(refused("mutex-value-buf", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Buf).new(Buf.new())\n  b = m.with { |t| t }\n  puts(b.size)\n}\n", "Mutex.with's value cannot be Buf: ", "16:20"))
  xs.push(refused("mutex-value-struct-holding", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nstruct Wrap {\n  b: Box\n}\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  w = m.with { |b| Wrap { b: b } }\n  puts(w.b.n)\n}\n", "Mutex.with's value cannot be Wrap: ", "19:20"))
  xs.push(accepted("mutex-value-new-object", "import std.sync\n\nclass Session {\n  pub n: Int\n  pub tags: Array(String) = []\n  fn initialize(n: Int) {\n    self.n = n\n  }\n}\n\nclass Box {\n  pub items: Array(Int) = []\n  pub owner: Session = Session.new(0)\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  s = m.with((b) {\n    b.items.push(4)\n    Session.new(b.items.size)\n  })\n  t = m.with((b): Session {\n    if b.items.size > 3 {\n      return Session.new(0)\n    }\n    switch b.items.size {\n      case 1 { Session.new(10) }\n      else { b.owner.clone() }\n    }\n  })\n  puts(s.n)\n  puts(t.n)\n}\n", "1\n10\n"))
  xs.push(refused("mutex-value-call-result", "import std.sync\n\nclass Session {\n  pub n: Int\n  pub peer: Session? = nil\n  fn initialize(n: Int) {\n    self.n = n\n  }\n}\n\nclass Box {\n  pub owner: Session = Session.new(0)\n}\n\nfn keep(s: Session): Session {\n  w = Session.new(1)\n  w.peer = s\n  w\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  s = m.with((b) { keep(b.owner) })\n  puts(s.n)\n}\n", "Mutex.with's value cannot be Session: ", "23:20"))
  xs.push(refused("mutex-value-new-holding-guarded", "import std.sync\n\nclass Session {\n  pub n: Int\n  pub peer: Box? = nil\n  fn initialize(n: Int, peer: Box?) {\n    self.n = n\n    self.peer = peer\n  }\n}\n\nclass Box {\n  pub n: Int = 0\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  s = m.with((b) { Session.new(1, b) })\n  puts(s.n)\n}\n", "Mutex.with's value cannot be Session: ", "18:27"))
  xs.push(refused("mutex-value-statement", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  m.with { |b|\n    b\n  }\n  puts(1)\n}\n", "this line computes a value and drops it", "17:5"))
  xs.push(accepted("mutex-value-plain", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nstruct Pt {\n  x: Int\n  name: String\n}\nstruct Maybe {\n  x: Int?\n}\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  a = m.with { |b|\n    b.n += 1\n    b.n\n  }\n  s = m.with { |b| \"n=\${b.n}\" }\n  hm = sync.Mutex(Hash(String, Int)).new(Hash(String, Int).new())\n  o = hm.with { |h|\n    h[\"a\"] = 5\n    h.get(\"a\")\n  }\n  o2 = hm.with { |h| h.get(\"b\") }\n  mm = sync.Mutex(sync.Mutex(Int)).new(sync.Mutex(Int).new(1))\n  inner = mm.with { |x| x }\n  p = m.with { |b| Pt { x: b.n, name: \"p\" } }\n  q = m.with { |b| Maybe { x: nil } }\n  by = m.with { |b| \"ab\".bytes }\n  f = m.with { |b| 1.5 }\n  t = m.with { |b| b.n == 1 }\n  puts(a)\n  puts(s)\n  puts(o ?? 7)\n  puts(o2 ?? -1)\n  puts(inner.with { |x| x })\n  puts(\"\${p.name} \${p.x}\")\n  puts(q.x ?? 9)\n  puts(by.size)\n  puts(f)\n  puts(t)\n}\n", "1\nn=1\n5\n-1\n1\np 1\n9\n2\n1.5\ntrue\n"))
  xs.push(accepted("mutex-value-copy-out", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub xs: Array(Int) = []\n}\n\nfn main {\n  m = sync.Mutex(Array(Int)).new([1, 2, 3])\n  snap: Array(Int) = []\n  m.with { |xs|\n    xs.each { |x| snap.push(x) }\n  }\n  puts(snap.size)\n}\n", "3\n"))
  xs
}

fn guard_cases: Array(RCase) {
  xs: Array(RCase) = []
  xs.push(refused("guard-push", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Box) = []\n  m.with { |b|\n    keep.push(b)\n  }\n  puts(keep.size)\n}\n", "Mutex.with: this argument is the guarded value or a reference reached from it (Box); inside the block it may only be a receiver or an operand whose result is a plain value, never an argument, a stored value or a captured name, since the lock protects it only until the block ends", "26:15"))
  xs.push(refused("guard-store-part", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  out = Inner.new()\n  m.with { |b|\n    out = b.inner\n  }\n  puts(out.n)\n}\n", "Mutex.with: the value stored into out, declared before the block, is the guarded value or a reference reached from it (Inner)", "26:12"))
  xs.push(refused("guard-callee-stores", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn stash(keep: Array(Box), b: Box) {\n  keep.push(b)\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Box) = []\n  m.with { |b|\n    stash(keep, b)\n  }\n  puts(keep.size)\n}\n", "Mutex.with: this argument is the guarded value or a reference reached from it (Box)", "30:17"))
  xs.push(refused("guard-alias", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Inner) = []\n  m.with { |b|\n    c = b.inner\n    c.n += 1\n    keep.push(c)\n  }\n  puts(keep.size)\n}\n", "Mutex.with: this argument is the guarded value or a reference reached from it (Inner)", "28:15"))
  xs.push(refused("guard-for", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Inner) = []\n  m.with { |b|\n    for it in b.items {\n      keep.push(it)\n    }\n  }\n  puts(keep.size)\n}\n", "Mutex.with: this argument is the guarded value or a reference reached from it (Inner)", "27:17"))
  xs.push(refused("guard-each", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Inner) = []\n  m.with { |b|\n    b.items.each { |it| keep.push(it) }\n  }\n  puts(keep.size)\n}\n", "Mutex.with: this argument is the guarded value or a reference reached from it (Inner)", "26:35"))
  xs.push(refused("guard-if-assign", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Box) = []\n  m.with { |b|\n    if nx = b.next {\n      keep.push(nx)\n    }\n  }\n  puts(keep.size)\n}\n", "Mutex.with: this argument is the guarded value or a reference reached from it (Box)", "27:17"))
  xs.push(refused("guard-struct", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Wrap) = []\n  m.with { |b|\n    w = Wrap { inner: b.inner }\n    keep.push(w)\n  }\n  puts(keep.size)\n}\n", "Mutex.with: this field's value is the guarded value or a reference reached from it (Inner)", "26:24"))
  xs.push(refused("guard-array-literal", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  m.with { |b|\n    pair = [b, Box.new()]\n    puts(pair.size)\n  }\n  puts(1)\n}\n", "Mutex.with: this element is the guarded value or a reference reached from it (Box)", "25:13"))
  xs.push(refused("guard-outer-field", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  h = Holder.new()\n  m.with { |b|\n    h.box = b\n  }\n  puts(1)\n}\n", "Mutex.with: the value stored into a field or element of an object that is not the guarded one is the guarded value or a reference reached from it (Box)", "26:13"))
  xs.push(refused("guard-block-local", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Box) = []\n  m.with { |b|\n    t: Box? = nil\n    t = b.next\n    if x = t {\n      keep.push(x)\n    }\n  }\n  puts(keep.size)\n}\n", "Mutex.with: the value stored into t, which holds a value not reached from the guarded one, is the guarded value or a reference reached from it (Box?)", "27:10"))
  xs.push(refused("guard-map-value", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  keep: Array(Inner) = []\n  m.with { |b|\n    keep = Array(Inner).new(2) { |k| b.inner }\n  }\n  puts(keep.size)\n}\n", "Mutex.with: the block's value is the guarded value or a reference reached from it (Inner)", "26:39"))
  xs.push(refused("guard-lambda-place", "import std.sync\n\nclass Inner {\n  pub n: Int = 0\n}\n\nclass Box {\n  pub n: Int = 0\n  pub inner: Inner = Inner.new()\n  pub next: Box? = nil\n  pub items: Array(Inner) = []\n}\n\nstruct Wrap {\n  inner: Inner\n}\n\nclass Holder {\n  pub box: Box? = nil\n}\n\nfn main {\n  m = sync.Mutex(Box).new(Box.new())\n  m.with { |b|\n    f = { |k: Int| b.n + k }\n    f(1)\n  }\n  puts(1)\n}\n", "Mutex.with: the guarded value b cannot be captured by a lambda or a spawn block, which may run after the lock is released", "25:20"))
