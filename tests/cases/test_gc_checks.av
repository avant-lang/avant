import harness
import backends

// Stage 28 W14b1: the collector's checks and the small defects.
//
// heap/limit_defer.av (C32): a split near AVANT_HEAP_MAX_MB used to run
// a full collection inside its defer region and lose parts (or die at a
// large allocation there); it runs under the limit in four environments.
//
// heap/task_pins.av (C28): every spawn used to leave its task object
// pinned; after 200 spawns and joins no pin is left.
//
// heap/task_records.av (R1, Stage 28 W16b): a spawn's capture record is
// the task's root until the task returns, not a pin until the join; 200
// never-joined spawns of 256 KiB captures run under AVANT_HEAP_MAX_MB=32
// (before R1 their pinned records exceeded it), plainly and under
// AVANT_GC_VERIFY=1, and leave no pin.
//
// heap/join_twice.av (C38, D225): a JoinHandle joined two and three
// times returns the same result every time, with young and full
// collections between the joins, in five environments (default,
// AVANT_GC_VERIFY=1, AVANT_YOUNG_MB=1, AVANT_NURSERY=0,
// AVANT_GC_STRESS=1); since C28 a second join freed the task again.
//
// heap/inc_slice_mature.av (C34) and heap/array_reserve_mature.av (the
// array_grow barrier, W13b) under AVANT_GC_STRESS=1 (W14b1's minimal
// stress mode: a young collection at every outermost defer entry and at
// every runtime C allocation): the known stdout, no stderr. The C35
// fixture (split_held.av) is too slow for the default suite under
// stress (178 s); the gate's AVANT_GC_STRESS=1 pass runs it.
//
// heap/churn.av under AVANT_NURSERY=0 with AVANT_GC_STATS=1 (O9, C33):
// nothing is remembered without a nursery (rem_adds=0, rem_now=0; it
// ended with 142,894 entries before).
//
// The settings' one rule (W14b2, O40; runtime/avant_gc.h): a switch
// that is neither 0 nor 1, a number that is not one, and a retired knob
// are each reported once on stderr at start-up, and the program runs
// as with the default (heap/task_pins.av's known stdout).
//
// heap/limit_region.av (gc-design.md §5.4, Stage 28 W15a1; W16a: the
// region opened through the ABI names around a split): a split
// whose region alone allocates more than AVANT_HEAP_MAX_MB=4 dies with
// "heap limit in a no-GC region (...)"; without a limit it prints its
// part count.
//
// heap/limit_defer.av at AVANT_HEAP_MAX_MB=8 (C39, Stage 28 W15a2): its
// live set and its copy room do not fit, and the program used to neither
// die nor finish (a heap-limit full collection per allocation); now two
// heap-limit full collections running, each after less than one block of
// allocation, end it with "heap limit", in the default environment and
// under AVANT_YOUNG_MB=1.

fn test_gc_checks(c: Checks, compiler: String, root: String, dir: String) {
  names = ["limit_defer", "task_pins", "task_records", "inc_slice_mature", "array_reserve_mature", "churn", "join_twice", "limit_region"]
  jobs: Array(HJob) = []
  p = 0
  while p < names.size {
    jobs.push(compile_job("", compiler, "${root}/tests/fixtures/heap/${names[p]}.av", "${dir}/${names[p]}", "${dir}/${names[p]}.log"))
    p += 1
  }
  run_waves(jobs)
  p = 0
  while p < names.size {
    c.eq_int(jobs[p].code, 0, "${names[p]}.av: compiles")
    p += 1
  }
  // [program, key, environment, stdout]
  progs: Array(String) = []
  keys: Array(String) = []
  envs: Array(String) = []
  wants: Array(String) = []
  // The heap-limit runs keep an outer AVANT_GC_STRESS (VALK-TM, O602:
  // 0.6 to 6.9 s each with it), except the one under AVANT_GC_VERIFY=1:
  // with the stress mode it did not end in 600 s (a whole-heap check at
  // each of 400,000 pushes' collections). The stress runs leave out an
  // outer AVANT_GC_VERIFY (a whole-heap check at each of millions of
  // collections).
  lenvs = ["AVANT_HEAP_MAX_MB=24", "-u AVANT_GC_STRESS AVANT_HEAP_MAX_MB=24 AVANT_GC_VERIFY=1", "AVANT_HEAP_MAX_MB=24 AVANT_NURSERY=0", "AVANT_HEAP_MAX_MB=32 AVANT_NURSERY=0"]
  e = 0
  while e < lenvs.size {
    progs.push("limit_defer")
    keys.push("limit_defer.g${e}")
    envs.push(lenvs[e])
    wants.push("split bad: 0\nlive bad: 0\n")
    e += 1
  }
  progs.push("limit_region")
  keys.push("limit_region.g0")
  envs.push("")
  wants.push("parts: 300001\n")
  progs.push("task_pins")
  keys.push("task_pins.g0")
  envs.push("")
  wants.push("sum: 1490\npins left: 0\n")
  renvs = ["AVANT_HEAP_MAX_MB=32", "AVANT_HEAP_MAX_MB=32 AVANT_GC_VERIFY=1"]
  e = 0
  while e < renvs.size {
    progs.push("task_records")
    keys.push("task_records.r${e}")
    envs.push(renvs[e])
    wants.push("sum ok: true\njoined: 200\npins left: 0\n")
    e += 1
  }
  jenvs = ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  e = 0
  while e < jenvs.size {
    progs.push("join_twice")
    keys.push("join_twice.g${e}")
    envs.push(jenvs[e])
    wants.push("array: 26602720 26602720 26602720\nfield: 374755 374755\nlocal: 42 42 42\nloop: 2980\nbad: 0\npins left: 0\n")
    e += 1
  }
  progs.push("inc_slice_mature")
  keys.push("inc_slice_mature.stress")
  envs.push("-u AVANT_GC_VERIFY AVANT_GC_STRESS=1")
  wants.push("0\n0\n0\n")
  progs.push("array_reserve_mature")
  keys.push("array_reserve_mature.stress")
  envs.push("-u AVANT_GC_VERIFY AVANT_GC_STRESS=1")
  wants.push("0\n0\n")
  runs: Array(HJob) = []
  k = 0
  while k < progs.size {
    runs.push(run_job_env(dir, progs[k], keys[k], envs[k]))
    k += 1
  }
  runs.push(run_job_env(dir, "churn", "churn.o9", "AVANT_NURSERY=0 AVANT_GC_STATS=1"))
  senvs = ["AVANT_GC_VERIFY=yes", "AVANT_YOUNG_MB=1x", "AVANT_GC_COPY_RESERVE=0"]
  serrs = ["avant runtime: warning: AVANT_GC_VERIFY=yes is not 0 or 1; the default applies\n", "avant runtime: warning: AVANT_YOUNG_MB=1x is not a number from 0 to 1073741824; the default applies\n", "avant runtime: warning: AVANT_GC_COPY_RESERVE is retired and has no effect\n"]
  e = 0
  while e < senvs.size {
    runs.push(run_job_env(dir, "task_pins", "task_pins.s${e}", senvs[e]))
    e += 1
  }
  // heap/limit_region.av (gc-design.md §5.4, Stage 28 W15a1): a split
  // that alone allocates more than the limit dies naming the region.
  runs.push(run_job_env(dir, "limit_region", "limit_region.l", "AVANT_HEAP_MAX_MB=4"))
  // C39: near-limit thrash ends in "heap limit".
  tenvs = ["AVANT_HEAP_MAX_MB=8", "AVANT_HEAP_MAX_MB=8 AVANT_YOUNG_MB=1"]
  e = 0
  while e < tenvs.size {
    runs.push(run_job_env(dir, "limit_defer", "limit_defer.t${e}", tenvs[e]))
    e += 1
  }
  run_waves(runs)
  k = 0
  while k < progs.size {
    what = "plain"
    if envs[k].size > 0 {
      what = "under ${envs[k]}"
    }
    c.eq_int(runs[k].code, 0, "${progs[k]}.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/${keys[k]}.out"), wants[k], "${progs[k]}.av ${what}: the known stdout")
    c.eq_str(log_text("${dir}/${keys[k]}.err"), "", "${progs[k]}.av ${what}: no stderr (no verifier report)")
    k += 1
  }
  stats = log_text("${dir}/churn.o9.err")
  c.eq_int(runs[progs.size].code, 0, "churn.av under AVANT_NURSERY=0: exit 0")
  outer = gc_env_outer("AVANT_NURSERY AVANT_GC_STATS")
  if outer.size > 0 {
    c.skip("churn.av under AVANT_NURSERY=0: nothing remembered", "outer ${outer}")
  } else {
    c.expect(str_has(stats, " rem_adds=0 ") && str_has(stats, " rem_now=0 "), "churn.av under AVANT_NURSERY=0: nothing remembered (rem_adds=0, rem_now=0)")
  }
  e = 0
  while e < senvs.size {
    c.eq_int(runs[progs.size + 1 + e].code, 0, "task_pins.av under ${senvs[e]}: exit 0")
    c.eq_str(log_text("${dir}/task_pins.s${e}.out"), "sum: 1490\npins left: 0\n", "task_pins.av under ${senvs[e]}: the known stdout")
    c.eq_str(log_text("${dir}/task_pins.s${e}.err"), serrs[e], "task_pins.av under ${senvs[e]}: one start-up warning")
    e += 1
  }
  lr = runs[progs.size + 1 + senvs.size]
  c.expect(lr.code != 0, "limit_region.av under AVANT_HEAP_MAX_MB=4: fails")
  c.expect(str_has(log_text("${dir}/limit_region.l.err"), "avant runtime: heap limit in a no-GC region ("), "limit_region.av under AVANT_HEAP_MAX_MB=4: heap limit in a no-GC region")
  e = 0
  while e < tenvs.size {
    tr = runs[progs.size + 2 + senvs.size + e]
    c.expect(tr.code != 0, "limit_defer.av under ${tenvs[e]}: fails")
    c.eq_str(log_text("${dir}/limit_defer.t${e}.err"), "avant runtime: heap limit\n", "limit_defer.av under ${tenvs[e]}: heap limit")
    e += 1
  }
}

// The number after ` KEY=` in an AVANT_GC_STATS=1 line, or -1.
fn stat_value(text: String, key: String): Int {
  parts = text.split(" ")
  for p in parts {
    if p.size > key.size + 1 && str_slice(p, 0, key.size + 1) == "${key}=" {
      return str_slice(p, key.size + 1, p.size).strip.to_i ?? -1
    }
  }
  -1
}

// O360 (Stage 29 W-FIX1b): an object with no payload takes one word
// (W-INT1's fix, which had no test). heap/empty_payload.av allocates
// EMPTY_PAYLOAD_EXTRA steps of two empty objects (`Array(T).new(0)`'s
// buffer with a run-time size, an empty class) and two array headers:
// 100,000 more steps are exactly 8,000,000 more allocated bytes, in the
// inline build and in the call-form build, under every collector mode.
// (Until the Valk stage's VALK-A2, O197, an empty array literal had a
// buffer too, a third empty object: 9,600,000; with the emitter's two
// guards removed the inline build's four runs then gave 7,200,000.) The program also keeps, moves and uses empty
// objects at every position of a block and prints 0.
fn test_empty_payload(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job("", compiler, "${root}/tests/fixtures/heap/empty_payload.av", "${dir}/empty_payload", "${dir}/empty_payload.log"))
  jobs.push(compile_job("AVANT_LLVM_CALL_FORMS=1", compiler, "${root}/tests/fixtures/heap/empty_payload.av", "${dir}/empty_payload_calls", "${dir}/empty_payload_calls.log"))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "empty_payload.av: compiles")
  c.eq_int(jobs[1].code, 0, "empty_payload.av: compiles with the call forms")
  bins = ["empty_payload", "empty_payload_calls"]
  envs = ["-u AVANT_GC_STRESS", "-u AVANT_GC_STRESS AVANT_GC_VERIFY=1", "-u AVANT_GC_STRESS AVANT_YOUNG_MB=1", "-u AVANT_GC_STRESS AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for b in 0..bins.size {
    for e in 0..envs.size {
      runs.push(run_job_env(dir, bins[b], "${bins[b]}.a${e}", "${envs[e]} AVANT_GC_STATS=1 EMPTY_PAYLOAD_EXTRA=1000"))
      runs.push(run_job_env(dir, bins[b], "${bins[b]}.b${e}", "${envs[e]} AVANT_GC_STATS=1 EMPTY_PAYLOAD_EXTRA=101000"))
    }
  }
  run_waves(runs)
  k = 0
  for b in 0..bins.size {
    for e in 0..envs.size {
      what = "${bins[b]} under '${envs[e]}'"
      c.eq_int(runs[k].code, 0, "${what}: exit 0")
      c.eq_int(runs[k + 1].code, 0, "${what}, 100,000 more steps: exit 0")
      c.eq_str(log_text("${dir}/${bins[b]}.b${e}.out"), "0\n", "${what}: every empty object survives its moves")
      small = stat_value(log_text("${dir}/${bins[b]}.a${e}.err"), "alloc")
      large = stat_value(log_text("${dir}/${bins[b]}.b${e}.err"), "alloc")
      c.expect(small > 0, "${what}: the statistics line has alloc=")
      c.eq_int(large - small, 8000000, "${what}: 100,000 steps of two empty objects and two array headers allocate 8,000,000 bytes")
      k += 2
    }
  }
}

// O207 (Stage 29 W-FIX1c): AVANT_GC_STRESS=1 reaches generated code's
// allocations. heap/stress_inline.av makes 40,000 allocations, all
// generated code's and nothing else (1,440,000 bytes exactly). With
// every collector variable unset it runs no collection, and the inline
// build takes its allocations on the inline path (at least 39,000 of
// the 40,000); under AVANT_GC_STRESS=1 every allocation is a stress
// point: at least 40,000 collections, in the inline build and in the
// call-form build, and the same output. Before W-FIX1c the stress runs
// made 0 collections, as the default ones. Since the Valk stage's
// VALK-A2 (O599) the inline build's allocations also run the inline
// sequence under the stress mode (avant_alloc_slow collects, makes room
// for the object and answers null; the module's __avant_alloc_slow then
// runs the sequence): at least 39,000 of the 40,000, where W-FIX1c's
// form ran none.
fn test_stress_inline(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job("", compiler, "${root}/tests/fixtures/heap/stress_inline.av", "${dir}/stress_inline", "${dir}/stress_inline.log"))
  jobs.push(compile_job("AVANT_LLVM_CALL_FORMS=1", compiler, "${root}/tests/fixtures/heap/stress_inline.av", "${dir}/stress_inline_calls", "${dir}/stress_inline_calls.log"))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "stress_inline.av: compiles")
  c.eq_int(jobs[1].code, 0, "stress_inline.av: compiles with the call forms")
  clean = "-u AVANT_YOUNG_MB -u AVANT_HEAP_MAX_MB -u AVANT_HEAP_RESERVE_GB -u AVANT_NURSERY -u AVANT_GC_DEFRAG -u AVANT_GC_VERIFY -u AVANT_GC_STRESS AVANT_GC_STATS=1"
  bins = ["stress_inline", "stress_inline_calls"]
  runs: Array(HJob) = []
  for b in 0..bins.size {
    runs.push(run_job_env(dir, bins[b], "${bins[b]}.plain", clean))
    runs.push(run_job_env(dir, bins[b], "${bins[b]}.stress", "${clean} AVANT_GC_STRESS=1"))
  }
  run_waves(runs)
  for b in 0..bins.size {
    what = bins[b]
    plain = log_text("${dir}/${what}.plain.err")
    stress = log_text("${dir}/${what}.stress.err")
    c.eq_int(runs[b * 2].code, 0, "${what}: exit 0")
    c.eq_int(runs[b * 2 + 1].code, 0, "${what} under AVANT_GC_STRESS=1: exit 0")
    c.eq_str(log_text("${dir}/${what}.plain.out"), "stress_inline: 0 bad\n", "${what}: the known stdout")
    c.eq_str(log_text("${dir}/${what}.stress.out"), "stress_inline: 0 bad\n", "${what} under AVANT_GC_STRESS=1: the known stdout")
    c.eq_int(stat_value(plain, "alloc"), 1440000, "${what}: 40,000 allocations of generated code and no other (1,440,000 bytes)")
    c.eq_int(stat_value(stress, "alloc"), 1440000, "${what} under AVANT_GC_STRESS=1: the same allocations")
    c.eq_int(stat_value(plain, "collections"), 0, "${what}: no collection in the default environment")
    c.expect(stat_value(stress, "collections") >= 40000, "${what} under AVANT_GC_STRESS=1: a collection at every allocation (at least 40,000)")
  }
  c.expect(stat_value(log_text("${dir}/stress_inline.stress.err"), "inline_allocs") >= 39000, "stress_inline under AVANT_GC_STRESS=1: its allocations run the inline sequence, each after its collection")
  c.eq_int(stat_value(log_text("${dir}/stress_inline_calls.stress.err"), "inline_allocs"), 0, "stress_inline_calls under AVANT_GC_STRESS=1: the call-form build has no inline allocation")
  c.expect(stat_value(log_text("${dir}/stress_inline.plain.err"), "inline_allocs") >= 39000, "stress_inline: its allocations take the inline path in the default environment")
  c.eq_int(stat_value(log_text("${dir}/stress_inline_calls.plain.err"), "inline_allocs"), 0, "stress_inline_calls: the call-form build has no inline allocation")
}

// O551 (Stage 29 W-FIX1c): avant_alloc's own guard (a 0-byte request
// takes one word), which generated code never reaches, and the layout it
// makes impossible, reached on purpose. ffi/empty_end.av (its C half in
// ffi/ffi.c) asks avant_alloc for 0 bytes from C: once anywhere, and
// with exactly one word left in the last block of the heap's highest
// chunk, then keeps the object in a rooted holder across a young
// collection. Every environment prints `empty_end: 0 bad`. With every
// collector variable unset the position must be reached (at least once;
// twice today), so a change of the allocator's order that loses the
// layout fails here instead of passing with nothing checked. With
// avant_alloc's line removed the default run prints `6 bad`: 3 objects
// not one word, 2 with a block's first address as their payload
// address, 1 the holder still names by its old copy after the
// collection (splus_new_addr leaves an address at the end of the
// committed heap unchanged).
fn test_empty_end(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/empty_end.av", "${dir}/empty_end", "${dir}/empty_end.log", ["--cc", "${root}/tests/fixtures/ffi/ffi.c"]))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "empty_end.av: compiles")
  envs = ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for e in 0..envs.size {
    runs.push(run_job_env(dir, "empty_end", "empty_end.g${e}", envs[e]))
  }
  runs.push(run_job_env(dir, "empty_end", "empty_end.clean", "-u AVANT_YOUNG_MB -u AVANT_HEAP_MAX_MB -u AVANT_HEAP_RESERVE_GB -u AVANT_NURSERY -u AVANT_GC_DEFRAG -u AVANT_GC_VERIFY -u AVANT_GC_STRESS -u AVANT_GC_STATS EMPTY_END_REPORT=1"))
  run_waves(runs)
  for e in 0..envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "empty_end.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/empty_end.g${e}.out"), "empty_end: 0 bad\n", "empty_end.av ${what}: an empty object takes one word and survives its move")
    c.eq_str(log_text("${dir}/empty_end.g${e}.err"), "", "empty_end.av ${what}: no stderr (no verifier report)")
  }
  clean = log_text("${dir}/empty_end.clean.out")
  c.eq_int(runs[envs.size].code, 0, "empty_end.av, every collector variable unset: exit 0")
  c.expect(str_has(clean, "empty_end: 0 bad\n"), "empty_end.av, every collector variable unset: 0 bad")
  c.expect(str_has(clean, "\nreached ") && !str_has(clean, "\nreached 0,"), "empty_end.av, every collector variable unset: the position is reached (one word left in the last block of the highest chunk)")
}

// O585 (the Valk stage, VALK-T; D342 Q6): the field rule and its check.
// ffi/field_rule.av (its C half in ffi/ffi.c) keeps a pointer buffer that
// names another by its start across a young collection: `field_rule: 1`
// and no stderr in every environment. With FIELD_RULE_BREAK=1 a slot is
// given an address inside the other buffer, which the rule forbids in a
// field: under AVANT_GC_VERIFY=1 (alone, with a small young budget, with
// the nursery off, under the stress mode) the program must stop before
// the collection traces the field, naming the rule and the holder. The
// breaking form is never run without the verifier (the traces trust the
// rule). With the check removed from the verifier the breaking runs exit
// 0 with no report.
fn test_field_rule(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/field_rule.av", "${dir}/field_rule", "${dir}/field_rule.log", ["--cc", "${root}/tests/fixtures/ffi/ffi.c"]))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "field_rule.av: compiles")
  envs = ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  brks = ["AVANT_GC_VERIFY=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_NURSERY=0", "AVANT_GC_VERIFY=1 AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for e in 0..envs.size {
    runs.push(run_job_env(dir, "field_rule", "field_rule.g${e}", envs[e]))
  }
  for e in 0..brks.size {
    runs.push(run_job_env(dir, "field_rule", "field_rule.b${e}", "FIELD_RULE_BREAK=1 ${brks[e]}"))
  }
  run_waves(runs)
  for e in 0..envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "field_rule.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/field_rule.g${e}.out"), "field_rule: 1\n", "field_rule.av ${what}: a field naming an object's start survives the collection")
    c.eq_str(log_text("${dir}/field_rule.g${e}.err"), "", "field_rule.av ${what}: no stderr (no verifier report)")
  }
  for e in 0..brks.size {
    err = log_text("${dir}/field_rule.b${e}.err")
    c.expect(runs[envs.size + e].code != 0, "field_rule.av, a field holding an address inside an object, under ${brks[e]}: the program stops")
    c.expect(str_has(err, "avant gc verify: field rule: holder ") && str_has(err, "an address inside object "), "field_rule.av, a field holding an address inside an object, under ${brks[e]}: the verifier names the rule and the holder")
    c.eq_str(log_text("${dir}/field_rule.b${e}.out"), "", "field_rule.av, a field holding an address inside an object, under ${brks[e]}: stopped before the collection ended")
  }
}

// A chain of remembered old objects (the Valk stage, VALK-T):
// heap/rem_chain.av makes a list of 200,000 nodes old, writes a young
// object into every node (each node is remembered and names a young
// object) and runs a young collection with the list's head in a root.
// Every environment prints `200000 200000` with no stderr. Before the
// fix the young trace called itself once per node of such a chain and
// the program ended with exit 139 (a stack overflow) plainly, at 1 MB
// and under the verifier.
fn test_rem_chain(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  no_flags: Array(String) = []
  jobs.push(compile_job_flags("", compiler, "${root}/tests/fixtures/heap/rem_chain.av", "${dir}/rem_chain", "${dir}/rem_chain.log", no_flags))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "rem_chain.av: compiles")
  envs = ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for e in 0..envs.size {
    runs.push(run_job_env(dir, "rem_chain", "rem_chain.g${e}", envs[e]))
  }
  run_waves(runs)
  for e in 0..envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "rem_chain.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/rem_chain.g${e}.out"), "200000 200000\n", "rem_chain.av ${what}: every node of the remembered chain keeps its young object")
    c.eq_str(log_text("${dir}/rem_chain.g${e}.err"), "", "rem_chain.av ${what}: no stderr (no verifier report)")
  }
}

// O610 (the Valk stage, VALK-T2): the verifier's check of the
// generational invariant itself. ffi/rem_invariant.av (its C half in
// ffi/ffi.c) stores a young string into a Cell two young collections
// promoted, behind avant_barrier: `rem_invariant: young-2 24` and no
// stderr in every environment. With REM_INVARIANT_BREAK=1 the store has no
// barrier: the Cell is in a slot of main, so the collection's trace scans
// it and the output is the same, and under AVANT_GC_VERIFY=1 (alone, with
// a small young budget, under the stress mode) the verifier must report
// the holder as not remembered. With the nursery off nothing is young and
// nothing is reported. Before VALK-T2 the breaking runs printed no report.
fn test_rem_invariant(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/rem_invariant.av", "${dir}/rem_invariant", "${dir}/rem_invariant.log", ["--cc", "${root}/tests/fixtures/ffi/ffi.c"]))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "rem_invariant.av: compiles")
  envs = ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  brks = ["AVANT_GC_VERIFY=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for e in 0..envs.size {
    runs.push(run_job_env(dir, "rem_invariant", "rem_invariant.g${e}", envs[e]))
  }
  for e in 0..brks.size {
    // An outer AVANT_NURSERY=0 pass would leave nothing young to report.
    runs.push(run_job_env(dir, "rem_invariant", "rem_invariant.b${e}", "-u AVANT_NURSERY REM_INVARIANT_BREAK=1 ${brks[e]}"))
  }
  runs.push(run_job_env(dir, "rem_invariant", "rem_invariant.n0", "REM_INVARIANT_BREAK=1 AVANT_GC_VERIFY=1 AVANT_NURSERY=0"))
  run_waves(runs)
  for e in 0..envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "rem_invariant.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/rem_invariant.g${e}.out"), "rem_invariant: young-2 24\n", "rem_invariant.av ${what}: the Cell keeps the string stored behind a barrier")
    c.eq_str(log_text("${dir}/rem_invariant.g${e}.err"), "", "rem_invariant.av ${what}: no stderr (no verifier report)")
  }
  for e in 0..brks.size {
    err = log_text("${dir}/rem_invariant.b${e}.err")
    c.eq_str(log_text("${dir}/rem_invariant.b${e}.out"), "rem_invariant: young-2 24\n", "rem_invariant.av, a store with no barrier, under ${brks[e]}: the trace still reaches the field (a root names the holder)")
    c.expect(str_has(err, "avant gc verify: missing barrier: holder ") && str_has(err, "not remembered"), "rem_invariant.av, a store with no barrier, under ${brks[e]}: the verifier reports the holder that is not remembered")
  }
  c.eq_str(log_text("${dir}/rem_invariant.n0.out"), "rem_invariant: young-2 24\n", "rem_invariant.av, a store with no barrier, under AVANT_GC_VERIFY=1 AVANT_NURSERY=0: the same output")
  c.eq_str(log_text("${dir}/rem_invariant.n0.err"), "", "rem_invariant.av, a store with no barrier, under AVANT_GC_VERIFY=1 AVANT_NURSERY=0: nothing is young, nothing is reported")
}

// O629 (the Valk stage, VALK-A2; D352): a C function's `String` result that
// names the inside of a heap object. ffi/str_interior.av stores `strchr`
// of a heap string in a field and runs young collections and a full one.
// The result passes through avant_c_str (compiler/mir/lower_ffi.av,
// runtime/avant_str.c), which returns a copy for an address inside a heap
// object, so the field holds an object's start: every environment prints
// the text before and after the collections and nothing on stderr. Without
// the copy the field holds an address inside the string, and under
// AVANT_GC_VERIFY=1 the program stops with "field rule" (the form the
// check below would then see: a non-zero exit and that report).
fn test_str_interior(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job("", compiler, "${root}/tests/fixtures/ffi/str_interior.av", "${dir}/str_interior", "${dir}/str_interior.log"))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "str_interior.av: compiles")
  envs = ["", "AVANT_GC_VERIFY=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_NURSERY=0", "AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1", "AVANT_GC_VERIFY=1 AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for e in 0..envs.size {
    runs.push(run_job_env(dir, "str_interior", "str_interior.g${e}", envs[e]))
  }
  run_waves(runs)
  for e in 0..envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "str_interior.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/str_interior.g${e}.out"), "str_interior: =value=7 =value=7 1\n", "str_interior.av ${what}: the field holding a C function's String result reads the same after the collections")
    c.eq_str(log_text("${dir}/str_interior.g${e}.err"), "", "str_interior.av ${what}: no stderr (no field-rule report)")
  }
}

// The late start bits (the Valk stage, VALK-A2, M7; O584, O615):
// ffi/late_starts.av (its C half in ffi/ffi.c). An object the inline
// allocation path made has no start bit until something needs it; C holds
// an address inside one in a root slot across a young collection, asks
// avant_is_heap of one, pins one, pins one across a young collection, and
// asks avant_is_heap of the survivors a young collection left in place
// (in the holes of old blocks; past the copy's budget after a hold), among C allocations in the same hole and a
// string the runtime shortens in place. Every environment prints the
// same line with no stderr: under AVANT_GC_VERIFY=1 the eager comparison
// (runtime/avant_gc_verify.c, gc_verify_starts_*) runs at every collection
// and stops the program at a difference, and under AVANT_GC_STRESS=1 a
// collection runs before every allocation. With gc_lazy_touch made a
// no-op the program prints `late_starts: 164970 0 0 0 800 200 6 1 500`
// (avant_is_heap and the pins do not find the objects) and the verifier
// reports "young object not promoted"; with the bit of a survivor left in
// place not set it prints `... 126 199 ...` and the verifier stops it
// with "start bits: an object that survived a collection in place has no
// start bit" (the record of VALK-A2, the planted defects).
fn test_late_starts(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/late_starts.av", "${dir}/late_starts", "${dir}/late_starts.log", ["--cc", "${root}/tests/fixtures/ffi/ffi.c"]))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "late_starts.av: compiles")
  envs = ["", "AVANT_GC_VERIFY=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1", "AVANT_GC_VERIFY=1 AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for e in 0..envs.size {
    runs.push(run_job_env(dir, "late_starts", "late_starts.g${e}", envs[e]))
  }
  run_waves(runs)
  for e in 0..envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "late_starts.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/late_starts.g${e}.out"), "late_starts: 164970 10 10 10 800 200 6 1 500\n", "late_starts.av ${what}: the inside addresses, avant_is_heap and the pins find the inline path's objects, before and after a collection")
    c.eq_str(log_text("${dir}/late_starts.g${e}.err"), "", "late_starts.av ${what}: no stderr (the eager comparison is silent)")
  }
}

// O197 (the Valk stage, VALK-A2): an array known to be empty where it is
// made (`[]`, `Array(T).new(0)`) is its header alone; the first push makes
// its buffer. heap/empty_arrays.av runs the array operations on such
// arrays (before a push, after one, after a clear), as literals, as
// class-field defaults, nested, and 20,000 of them kept across
// collections and then filled: every environment prints what a compiler
// that gave each empty array a buffer printed, with no stderr. And the
// program allocates 1,280,144 bytes where it allocated 1,600,320: each of
// its 20,011 empty arrays is 24 bytes, not 24 and 16.
fn test_empty_arrays(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job("", compiler, "${root}/tests/fixtures/heap/empty_arrays.av", "${dir}/empty_arrays", "${dir}/empty_arrays.log"))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "empty_arrays.av: compiles")
  want = "lit: size 0 sum 0 loop 0 each 0 has1 false any false all true\nsorted: size 0 sum 0 loop 0 each 0 has1 false any false all true\npushed: size 2 sum 4 loop 4 each 2 has1 true any true all true\nsorted still: size 0 sum 0 loop 0 each 0 has1 false any false all true\ncleared: size 0 sum 0 loop 0 each 0 has1 false any false all true\nagain: size 1 sum 7 loop 7 each 1 has1 false any true all true\nnew: size 0 sum 0 loop 0 each 0 has1 false any false all true\nreserved: size 0 sum 0 loop 0 each 0 has1 false any false all true\nnew pushed: size 1 sum 1 loop 1 each 1 has1 true any true all true\njoin [] size 0\njoin [xy] size 2\nfloats 0 0.0\nfloats 1 1.5\nstructs 0\nstructs 1 3\nnested 2 0 1 5\nbag 0 0\nbag 1 4 n\nkept 20000 0 6667\n"
  clean = "-u AVANT_YOUNG_MB -u AVANT_HEAP_MAX_MB -u AVANT_HEAP_RESERVE_GB -u AVANT_NURSERY -u AVANT_GC_DEFRAG -u AVANT_GC_VERIFY -u AVANT_GC_STRESS AVANT_GC_STATS=1"
  envs = ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for e in 0..envs.size {
    runs.push(run_job_env(dir, "empty_arrays", "empty_arrays.g${e}", envs[e]))
  }
  runs.push(run_job_env(dir, "empty_arrays", "empty_arrays.stats", clean))
  run_waves(runs)
  for e in 0..envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "empty_arrays.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/empty_arrays.g${e}.out"), want, "empty_arrays.av ${what}: every operation on an array with no buffer gives what it gave on an empty buffer")
    c.eq_str(log_text("${dir}/empty_arrays.g${e}.err"), "", "empty_arrays.av ${what}: no stderr")
  }
  c.eq_int(stat_value(log_text("${dir}/empty_arrays.stats.err"), "alloc"), 1280144, "empty_arrays.av: an empty array is one object of 24 bytes (1,280,144 bytes allocated; 1,600,320 with a buffer each)")
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_gc_checks.av")
  if compiler = env_get("AVANT_COMPILER") {
    test_gc_checks(c, compiler, avant_test_root(), scratch_dir())
    test_empty_payload(c, compiler, avant_test_root(), scratch_dir())
    test_stress_inline(c, compiler, avant_test_root(), scratch_dir())
    test_empty_end(c, compiler, avant_test_root(), scratch_dir())
    test_field_rule(c, compiler, avant_test_root(), scratch_dir())
    test_str_interior(c, compiler, avant_test_root(), scratch_dir())
    test_rem_chain(c, compiler, avant_test_root(), scratch_dir())
    test_rem_invariant(c, compiler, avant_test_root(), scratch_dir())
    test_late_starts(c, compiler, avant_test_root(), scratch_dir())
    test_empty_arrays(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
