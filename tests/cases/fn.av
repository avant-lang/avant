fn s19_inc(n: Int): Int {
  n + 1
}

fn s19_map(xs: Array(T), f: fn(T): U): Array(U) {
  ys: Array(U) = []
  xs.each { |x|
    ys.push(f(x))
  }
  ys
}

fn s19_add(n: Int): fn(Int): Int {
  { |x| x + n }
}

fn s19_pick(n: Int): Int {
  n + 1
}

fn s19_pick(s: String): Int {
  s.size
}

fn s19_take_int(f: fn(Int): Int): Int {
  f(10)
}

fn s19_take_str(f: fn(String): Int): Int {
  f("abcd")
}

class S19Box {
  f: fn(): Int

  fn initialize {
  }
}

fn s19_each_sum: Int {
  xs = [1, 2, 3]
  sum = 0
  xs.each { |i|
    sum = sum + i
  }
  sum
}

fn test_fn(c: Checks) {
  c.suite("tests/cases/fn.av")
  f: fn(Int): Int = s19_inc
  c.eq_int(f(2), 3, "named fn value")
  g: fn(Int): Int = { |n| n + 1 }
  c.eq_int(g(4), 5, "captureless lambda")
  ys = s19_map([1, 2, 3]) { |n| n + 1 }
  c.eq_int(ys.size, 3, "map size")
  c.eq_int(ys[0], 2, "map 0")
  c.eq_int(ys[1], 3, "map 1")
  c.eq_int(ys[2], 4, "map 2")
  mapped = s19_map([1, 2, 3], s19_inc)
  c.eq_int(mapped[2], 4, "map named fn")
  c.eq_int(s19_add(1)(2), 3, "capturing call")
  n = 1
  see: fn(): Int = { || n }
  n = 7
  c.eq_int(see(), 7, "assign after create")
  m = 1
  bump: fn(): Int = { ||
    m = m + 1
    m
  }
  c.eq_int(bump(), 2, "assign inside result")
  c.eq_int(m, 2, "assign inside visible")
  c.eq_int(s19_each_sum(), 6, "each stays inline")
  h = spawn { 4 }
  c.eq_int(h.join, 4, "spawn still runs")
  c.eq_int(s19_take_int(s19_pick), 11, "overload from fn type")
  c.eq_int(s19_take_str(s19_pick), 4, "overload string")
  k = 0
  rec: fn(): Int = { ||
    if k > 2 {
      return k
    }
    k = k + 1
    rec()
  }
  c.eq_int(rec(), 3, "recursive lambda")
  box = S19Box.new()
  box.f = { || 9 }
  c.eq_int((box.f)(), 9, "fn field")
  fs: Array(fn(): Int) = []
  fs.push({ || 8 })
  c.eq_int((fs[0])(), 8, "fn array element")
  msg = "ke" + "pt"
  read: fn(): String = { || msg }
  c.eq_str(read(), "kept", "capture string")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    src = "/tmp/avant-s19-${stamp}.av"
    bin = "/tmp/avant-s19-${stamp}"
    clog = "/tmp/avant-s19-${stamp}-compile.log"
    rlog = "/tmp/avant-s19-${stamp}-run.log"
    slog = "/tmp/avant-s19-${stamp}-stats.log"
    body = "class Node {\n  item: Int\n  left: Node\n  right: Node\n  fn initialize(item: Int) {\n    self.item = item\n  }\n}\nfn make(item: Int, depth: Int): Node {\n  n = Node.new(item)\n  if depth > 0 {\n    n.left = make(item * 2, depth - 1)\n    n.right = make(item * 2 + 1, depth - 1)\n  }\n  n\n}\nclass Hold {\n  f: fn(): String\n  g: fn(Int): Int\n  fn initialize {\n  }\n}\nfn ident(n: Int): Int {\n  n + 1\n}\nfn main {\n  h = Hold.new()\n  s = \"ke\" + \"pt\"\n  h.f = { || s }\n  h.g = ident\n  arr: Array(fn(): String) = []\n  arr.push({ || s })\n  i = 0\n  while i < 40 {\n    t = make(1, 10)\n    i = i + 1\n  }\n  puts((h.f)())\n  puts((arr[0])())\n  puts((h.g)(41))\n}\n"
    w = file_write(src, body)
    c.eq_int(w, 0, "write nursery fn")
    cc = compile_av(compiler, src, bin, clog)
    c.eq_int(cc, 0, "compile nursery fn")
    if file_exists(bin) {
      chmod_x(bin)
      cap: Array(String) = []
      cap.push("AVANT_NURSERY=1")
      cap.push("AVANT_HEAP_MAX_MB=3")
      cap.push(bin)
      rcode = process_run_out("/usr/bin/env", cap, rlog)
      c.eq_int(rcode, 0, "fn survives nursery")
      if out = file_read(rlog) {
        c.eq_str(out, "kept\nkept\n42\n", "fn values after collection")
      } else {
        c.expect(false, "read nursery fn stdout")
      }
      st: Array(String) = []
      st.push("AVANT_NURSERY=1")
      st.push("AVANT_HEAP_MAX_MB=3")
      st.push("AVANT_GC_STATS=1")
      st.push(bin)
      scode = process_run_out("/usr/bin/env", st, slog)
      c.eq_int(scode, 0, "fn nursery stats run")
      if stats = file_read(slog) {
        c.expect(str_has(stats, "young="), "gc stats printed")
        c.expect(!str_has(stats, "young=0 full"), "copying nursery ran")
        c.expect(str_has(stats, "kept"), "string intact in stats run")
      } else {
        c.expect(false, "read gc stats")
      }
    } else {
      c.expect(false, "nursery fn binary")
      if err = file_read(clog) {
        c.expect(false, err)
      }
    }
    each_src = "/tmp/avant-s19-${stamp}-each.av"
    each_log = "/tmp/avant-s19-${stamp}-each.log"
    each_body = "fn main {\n  xs = [1, 2, 3]\n  sum = 0\n  xs.each { |i| sum = sum + i }\n  puts(sum)\n}\n"
    dummy = file_write(each_src, each_body)
    d1 = dump_av(compiler, each_src, each_log)
    c.eq_int(d1, 0, "dump each")
    if each_ir = file_read(each_log) {
      c.expect(!str_has(each_ir, "__lam"), "each does not allocate a lambda")
    } else {
      c.expect(false, "read each dump")
    }
    lam_src = "/tmp/avant-s19-${stamp}-lam.av"
    lam_log = "/tmp/avant-s19-${stamp}-lam.log"
    lam_body = "fn main {\n  n = 1\n  f: fn(): Int = { || n }\n  puts(f())\n}\n"
    dummy2 = file_write(lam_src, lam_body)
    d2 = dump_av(compiler, lam_src, lam_log)
    c.eq_int(d2, 0, "dump closure")
    if lam_ir = file_read(lam_log) {
      c.expect(str_has(lam_ir, "__lam"), "closure has a thunk")
      c.expect(str_has(lam_ir, "INVOKE"), "closure calls with INVOKE")
    } else {
      c.expect(false, "read closure dump")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}
