import harness
import backends
import std.process

// A young collection keeps a pinned young object in place and treats
// it as a root whose fields are traced, copied, and updated, in
// every collection while it lives, not only the first; a young child
// stored into it later is found (the object is promoted in place, so
// the barrier remembers it). Before the fix the runtime's pinned
// young argv array lost its buffer (the compiler crashed compiling
// test_std_http.av under the new back end), and a `pin` block's
// value lost its fields. tests/fixtures/heap/pinned.av is compiled
// (--debug; once by both back ends) and runs plain, under
// AVANT_GC_VERIFY=1, AVANT_YOUNG_MB=1, both, and AVANT_NURSERY=0:
// the known stdout, no stderr (no verifier report), exit 0. (The old
// back end needed AVANT_GC_DEFRAG=0 under AVANT_NURSERY=0; it
// retired. The back end keeps every reference live across a
// collecting call in a slot, and runs without it.)
//
// tests/fixtures/heap/pin_fresh.av pins objects the inline allocation
// path has just built (in a program that spawns, whose inline sequence
// sets the start bits itself) and allocates inside each pin; compiled
// --debug and --release, it runs plain, under AVANT_GC_STRESS=1,
// AVANT_GC_VERIFY=1 and both: the known stdout, no stderr, exit 0.
// Before the pin synced the inline allocations first, the stress mode
// stopped it at the sync inside the first pin.

fn gc_envs: Array(String) {
  ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0"]
}

fn test_gc_pinned(c: Checks, compiler: String, root: String, dir: String) {
  src = "${root}/tests/fixtures/heap/pinned.av"
  want = "argv bad: 0\npin bad: 0\nkept bad: 0\n"
  bes = ["new"]
  jobs: Array(HJob) = []
  jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, src, "${dir}/pinned.new", "${dir}/pinned.new.log"))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "pinned.av: compiles under llvm")
  envs = gc_envs()
  runs: Array(HJob) = []
  b = 0
  while b < bes.size {
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "pinned.${bes[b]}", "pinned.${bes[b]}.g${e}", envs[e]))
      e += 1
    }
    b += 1
  }
  run_waves(runs)
  b = 0
  while b < bes.size {
    e = 0
    while e < envs.size {
      what = "plain"
      if envs[e].size > 0 {
        what = "under ${envs[e]}"
      }
      k = "pinned.${bes[b]}.g${e}"
      c.eq_int(runs[b * envs.size + e].code, 0, "pinned.av (${bes[b]} back end) ${what}: exit 0")
      c.eq_str(log_text("${dir}/${k}.out"), want, "pinned.av (${bes[b]} back end) ${what}: the known stdout")
      c.eq_str(log_text("${dir}/${k}.err"), "", "pinned.av (${bes[b]} back end) ${what}: no stderr (no verifier report)")
      e += 1
    }
    b += 1
  }
}

fn test_pin_fresh(c: Checks, compiler: String, root: String, dir: String) {
  src = "${root}/tests/fixtures/heap/pin_fresh.av"
  want = "bob x\n400\n2\n"
  modes = ["--debug", "--release"]
  envs = ["", "AVANT_GC_STRESS=1", "AVANT_GC_VERIFY=1", "AVANT_GC_STRESS=1 AVANT_GC_VERIFY=1"]
  jobs: Array(HJob) = []
  for m, mode in modes {
    args = ["compile", src, "${dir}/pin_fresh.m${m}", mode]
    jobs.push(env_job("", compiler, args, "${dir}/pin_fresh.m${m}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for m, mode in modes {
    c.eq_int(jobs[m].code, 0, "pin_fresh.av compiles with ${mode}")
    for e, env in envs {
      runs.push(run_job_env(dir, "pin_fresh.m${m}", "pin_fresh.m${m}.g${e}", env))
    }
  }
  run_waves(runs)
  for m, mode in modes {
    for e, env in envs {
      what = "plain"
      if env.size > 0 {
        what = "under ${env}"
      }
      k = "pin_fresh.m${m}.g${e}"
      c.eq_int(runs[m * envs.size + e].code, 0, "pin_fresh.av (${mode}) ${what}: exit 0")
      c.eq_str(log_text("${dir}/${k}.out"), want, "pin_fresh.av (${mode}) ${what}: the known stdout")
      c.eq_str(log_text("${dir}/${k}.err"), "", "pin_fresh.av (${mode}) ${what}: no stderr")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_gc_pinned.av")
  if compiler = process.env("AVANT_COMPILER") {
    test_gc_pinned(c, compiler, avant_test_root(), scratch_dir())
    test_pin_fresh(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
