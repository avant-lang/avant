import harness
import backends

// Stage 28 W8c (C29, D204): a young collection keeps a pinned young
// object in place and treats it as a root whose fields are traced,
// copied, and updated, in every collection while it lives, not only the
// first; a young child stored into it later is found (the object is
// promoted in place, so the barrier remembers it). Before the fix the
// runtime's pinned young argv array lost its buffer (the compiler
// crashed compiling test_std_http.av under the new back end, W8b), and
// a `pin` block's value lost its fields. tests/fixtures/heap/pinned.av
// is compiled by both back ends (--debug) and each program runs plain,
// under AVANT_GC_VERIFY=1, AVANT_YOUNG_MB=1, both, and AVANT_NURSERY=0:
// the same known stdout, no stderr (no verifier report), exit 0.
//
// The old back end's run under AVANT_NURSERY=0 also sets
// AVANT_GC_DEFRAG=0: there the full collection's mature defragmentation
// moves objects, and the old back end's code keeps a reference outside
// its root slots across a collecting call (a pre-existing old back end
// defect independent of C29, recorded in the W8c record; the new back
// end keeps every such reference in a slot, D165, and runs without it).

fn gc_envs: Array(String) {
  ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0"]
}

fn env_for(be: String, env: String): String {
  if str_eq(be, "old") && str_eq(env, "AVANT_NURSERY=0") {
    return "AVANT_NURSERY=0 AVANT_GC_DEFRAG=0"
  }
  env
}

fn test_gc_pinned(c: Checks, compiler: String, root: String, dir: String) {
  src = "${root}/tests/fixtures/heap/pinned.av"
  want = "argv bad: 0\npin bad: 0\nkept bad: 0\n"
  bes = ["old", "new"]
  jobs: Array(HJob) = []
  jobs.push(compile_job("", compiler, src, "${dir}/pinned.old", "${dir}/pinned.old.log"))
  jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, src, "${dir}/pinned.new", "${dir}/pinned.new.log"))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "pinned.av: compiles under myc")
  c.eq_int(jobs[1].code, 0, "pinned.av: compiles under llvm")
  envs = gc_envs()
  runs: Array(HJob) = []
  b = 0
  while b < bes.size {
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "pinned.${bes[b]}", "pinned.${bes[b]}.g${e}", env_for(bes[b], envs[e])))
      e = e + 1
    }
    b = b + 1
  }
  run_waves(runs)
  b = 0
  while b < bes.size {
    e = 0
    while e < envs.size {
      what = "plain"
      if envs[e].size > 0 {
        what = "under ${env_for(bes[b], envs[e])}"
      }
      k = "pinned.${bes[b]}.g${e}"
      c.eq_int(runs[b * envs.size + e].code, 0, "pinned.av (${bes[b]} back end) ${what}: exit 0")
      c.eq_str(log_text("${dir}/${k}.out"), want, "pinned.av (${bes[b]} back end) ${what}: the known stdout")
      c.eq_str(log_text("${dir}/${k}.err"), "", "pinned.av (${bes[b]} back end) ${what}: no stderr (no verifier report)")
      e = e + 1
    }
    b = b + 1
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_gc_pinned.av")
  if compiler = env_get("AVANT_COMPILER") {
    test_gc_pinned(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
