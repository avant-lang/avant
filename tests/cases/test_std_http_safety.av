import harness
import std.sync
import std.http

// Safety behaviours of std.http's server, each a defect
// that had no test: a client that closes with pipelined
// answers unread; answers larger than the socket takes
// at once, and answers piling up for a client that does
// not read; a timeout that closed busy connections;
// Content-Length lines that disagree; a request without
// Host or with two. The byte-level client is
// tests/fixtures/http/raw_client.py: it prints one line
// per mode. And of its client: a request larger than
// the socket takes at once; a peer that accepts and
// never answers, or never reads. And of WebSocket
// values whose connection is gone: a WsConn kept after
// its server, a copy of a closed WsConnection. And
// WebSocket connections opening and closing together on
// a server with more than one loop. And a route
// registered while the server serves. And a header that
// would split the answer. And a client that waited for
// the server to close after a complete response. And a
// WebSocket message the socket took in part. And the
// WebSocket client's handshake: one longer than 2048
// bytes, and one the socket takes in part. And the
// WebSocket client's deadlines under a step of the wall
// clock. And the client's request checks; a response
// literal and a status outside 200-599; a response with
// two Content-Length values; interim 1xx answers; a
// Host value that is not host[:port]; the write paths
// past the piece. And a client sending a request head, a
// body or reading an answer slowly. And a handler that traps.
// And the body budget, the connection limit, the shutdown
// deadline and the memory ceiling.

lib c {
  fun setenv(name: String, value: String, overwrite: Int32): Int32
  fun usleep(micros: UInt32): Int32
}

fn sleep_ms(ms: Int) {
  _ = c.usleep((ms * 1000).to_u32())
}

fn set_env(name: String, value: String) {
  one: Int32 = 1
  _ = c.setenv(name, value, one)
}

// This process's peak resident memory in kB (VmHWM), 0 when unreadable.
fn peak_rss_kb: Int {
  if text = file_read("/proc/self/status") {
    i = 0
    while i < count_lines(text) {
      line = nth_line(text, i)
      if line.size > 6 && str_slice(line, 0, 6) == "VmHWM:" {
        digits = buf_new()
        for k in 6..line.size {
          if line[k] >= 48 && line[k] <= 57 {
            digits.push_byte(line[k])
          }
        }
        return digits.to_s().to_i() ?? 0
      }
      i += 1
    }
  }
  0
}

fn raw_client(port: Int, root: String, stamp: Int, mode: String, arg: String): String {
  log = "${scratch()}/http-safety-${stamp}-${mode}-${arg}.log"
  args: Array(String) = []
  args.push("${root}/tests/fixtures/http/raw_client.py")
  args.push("${port}")
  args.push(mode)
  if arg.size > 0 {
    args.push(arg)
  }
  _ = process_run_out("/usr/bin/python3", args, log)
  if text = file_read(log) {
    return nth_line(text, 0)
  }
  ""
}

fn stop(port: Int) {
  if resp = Http.get("http://127.0.0.1:${port}/__stop") {
  }
}

fn close_unread_round(port: Int, out: Channel(String), root: String, stamp: Int): Int {
  out.send(raw_client(port, root, stamp, "close_unread", "2"))
  out.send(raw_client(port, root, stamp, "close_unread", "16"))
  out.send(raw_client(port, root, stamp, "close_unread", "2000"))
  out.send(raw_client(port, root, stamp, "lengths", ""))
  out.send(raw_client(port, root, stamp, "hosts", ""))
  stop(port)
  0
}

fn queue_round(port: Int, out: Channel(String), root: String, stamp: Int): Int {
  out.send(raw_client(port, root, stamp, "slow_big", ""))
  out.send(raw_client(port, root, stamp, "pile", ""))
  out.send(raw_client(port, root, stamp, "close_big", ""))
  out.send(raw_client(port, root, stamp, "half_close", ""))
  out.send(raw_client(port, root, stamp, "flood", ""))
  0
}

// "timed out in time" when the call failed as a timeout no earlier than
// its limit and within 1.5 s after it (the slack is for a loaded
// machine and the collector's check modes; alone it is a few ms).
fn timed(what: String, started: Int, limit: Int, message: String): String {
  took = now_ms() - started
  if message.contains("timed out") && took >= limit && took < limit + 1500 {
    return "${what}=timed out in time"
  }
  "${what}=${message} after ${took} ms, limit ${limit}"
}

// `timeout_ms` covered the connect only, so a peer that accepted
// and then stayed silent held the call for as long as it liked. It is
// a deadline for the whole call. The peer here is a listener that is
// never served: the kernel completes the connection, and nobody reads
// or answers. A GET, a POST whose 8 MiB the peer stops taking (the
// stalled peer) and a WebSocket handshake each end at their second.
fn timeout_round(port: Int, out: Channel(String)): Int {
  url = "http://127.0.0.1:${port}/"
  t0 = now_ms()
  switch Http.get(url, true, 1000) {
    case e: HttpError { out.send(timed("get", t0, 1000, e.message)) }
    case Response { out.send("get=answered") }
  }
  b = buf_new()
  for i in 0..8388608 {
    b.push_byte(97 + i % 26)
  }
  big = b.to_s()
  t0 = now_ms()
  switch Http.post(url, big, true, 1000) {
    case e: HttpError { out.send(timed("post", t0, 1000, e.message)) }
    case Response { out.send("post=answered") }
  }
  t0 = now_ms()
  switch Ws.connect("ws://127.0.0.1:${port}/", 1000) {
    case e: HttpError { out.send(timed("ws", t0, 1000, e.message)) }
    case WsConnection { out.send("ws=connected") }
  }
  0
}

fn post_big_round(port: Int, out: Channel(String), n: Int): Int {
  b = buf_new()
  for i in 0..n {
    b.push_byte(97 + i % 26)
  }
  if resp = Http.post("http://127.0.0.1:${port}/len", b.to_s()) {
    out.send("status ${resp.status}: ${String.from_utf8(resp.body) ?? "?"}")
  } else {
    out.send("HttpError")
  }
  // A body that is not valid UTF-8: it was sent as
  // nothing after a Content-Length of its size.
  raw = buf_new()
  raw.push_byte(255)
  raw.push_byte(0)
  raw.push_byte(65)
  raw.push_byte(254)
  hs: Array(Header) = []
  if resp = Http.request("POST", "http://127.0.0.1:${port}/raw", raw.to_s().bytes, hs, true, 4000) {
    out.send("status ${resp.status}: ${String.from_utf8(resp.body) ?? "?"}")
  } else {
    out.send("HttpError")
  }
  stop(port)
  0
}

// The client wrote its request once and ignored what the socket
// took, so a request larger than the socket's buffer was cut and the
// server waited for the rest until its idle timeout closed the
// connection. The rest is now sent as the socket becomes writable: the
// server receives every byte, in order. (The server's idle timeout is
// shortened so that a cut request fails this check in 8 s, not 30.)
fn client_cases(c: Checks) {
  set_env("AVANT_HTTP_IDLE_TIMEOUT_S", "8")
  listened = Http.listen(0, "127.0.0.1", 33554432, 1)
  set_env("AVANT_HTTP_IDLE_TIMEOUT_S", "")
  if opened = listened {
    server = opened
    server.post("/raw", (req) {
      sum = 0
      for i in 0..req.body.size {
        sum = sum * 7 + req.body[i]
      }
      Response.text("${req.body.size} bytes, sum ${sum}")
    })
    server.post("/len", (req) {
      body = req.body
      bad = 0
      for i in 0..body.size {
        if body[i] != 97 + i % 26 {
          bad += 1
        }
      }
      Response.text("${body.size} bytes, ${bad} out of place")
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    out = Channel(String).new(2)
    task = spawn {
      post_big_round(port, out, 8388608)
    }
    server.serve()
    c.eq_int(task.join() ?? -1, 0, "client post task")
    want: Array(String) = []
    want.push("status 200: 8388608 bytes, 0 out of place")
    want.push("status 200: 4 bytes, sum 88174")
    expect_lines(c, out, want, "the client's request body reaches the server whole and in order (8 MiB; 4 bytes not UTF-8):")
  } else {
    c.expect(false, "listen for the client's large request")
  }
}

// One client task of ws_route_cases. It opens `rounds`
// connections in turn, on /a and /b alternately, sends two messages on
// each and closes it; /a answers each message once, /b twice (its two
// routes, in the order they were registered). At the first answer that
// is missing or comes from the wrong route it sends what it saw to
// wrongs, stops (on the starting head a wrong route could leave every
// later answer missing, five seconds each) and returns 1.
fn ws_route_round(port: Int, t: Int, rounds: Int, done: Channel(Int), wrongs: Channel(String)): Int {
  wrong = ""
  k = 0
  while k < rounds && wrong.size == 0 {
    p = "a"
    if (t + k) % 2 == 1 {
      p = "b"
    }
    if conn = Ws.connect("ws://127.0.0.1:${port}/${p}", 5000) {
      m = 0
      while m < 2 && wrong.size == 0 {
        body = "${t}.${k}.${m}"
        want: Array(String) = []
        if p == "a" {
          want.push("a ${body}")
        } else {
          want.push("b1 ${body}")
          want.push("b2 ${body}")
        }
        if conn.send_text(body) {
          for w in want {
            if wrong.size == 0 {
              got = "nothing"
              if msg = conn.recv(5000) {
                got = msg.text() ?? "a binary message"
              }
              if got != w {
                wrong = "task ${t}, connection ${k} on /${p}: ${got} for ${w}"
              }
            }
          }
        } else {
          wrong = "task ${t}, connection ${k} on /${p}: the send failed"
        }
        m += 1
      }
      conn.close()
    } else {
      wrong = "task ${t}, connection ${k} on /${p}: the connect failed"
    }
    k += 1
  }
  if wrong.size > 0 {
    wrongs.send(wrong)
  }
  done.send(1)
  if wrong.size > 0 {
    return 1
  }
  0
}

// A server with more than one loop kept its open WebSocket
// connections' ids and paths in two arrays its loop threads shared
// with no lock; connections opening and closing together on different
// loops raced on them, and the server trapped (an index out of bounds)
// or ran a message on another connection's route. Each connection now
// carries its route in its own C record. Eight loops, eight client
// tasks opening and closing 200 connections each: every answer must
// come from the connection's own route.
fn ws_route_cases(c: Checks) {
  tasks = 8
  rounds = 200
  if opened = Http.listen(0, "127.0.0.1", 1048576, 8) {
    server = opened
    server.websocket("/b", (conn, msg) {
      _ = conn.send_text("b1 ${msg.text() ?? "?"}")
    })
    server.websocket("/a", (conn, msg) {
      _ = conn.send_text("a ${msg.text() ?? "?"}")
    })
    server.websocket("/b", (conn, msg) {
      _ = conn.send_text("b2 ${msg.text() ?? "?"}")
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    done = Channel(Int).new(tasks)
    wrongs = Channel(String).new(tasks)
    handles: Array(JoinHandle(Int)) = []
    for t in 0..tasks {
      handles.push(spawn {
        ws_route_round(port, t, rounds, done, wrongs)
      })
    }
    stopper = spawn {
      got = 0
      while got < tasks {
        if d = done.recv() {
          got += d
        }
      }
      stop(port)
      0
    }
    server.serve()
    failed = 0
    for h in handles {
      failed += h.join() ?? -1
    }
    _ = stopper.join()
    wrong = ""
    if failed > 0 {
      wrong = wrongs.recv() ?? "?"
    }
    c.eq_str(wrong, "", "WebSocket connections opening and closing together on 8 loops: the first answer missing or from another route")
  } else {
    c.expect(false, "listen for the multi-loop WebSocket route test")
  }
}

// A route registered while the server serves:
// the route tables are read by the loop threads with no lock, so every
// route method traps once `serve` runs. The fixture registers the route
// from a handler, on a loop thread, with each method in turn; each trap
// prints its line and fails its request (answered 500), and the server
// goes on to its stop.
fn route_serving_cases(c: Checks, root: String) {
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    bin = "${scratch()}/http-route-serving-${stamp}.bin"
    clog = "${scratch()}/http-route-serving-${stamp}.clog"
    code = compile_av(compiler, "${root}/tests/fixtures/http/route_while_serving.av", bin, clog)
    c.eq_int(code, 0, "the route-while-serving fixture compiles")
    kinds = ["get", "post", "put", "delete", "patch", "route", "websocket", "websocket_open", "websocket_close"]
    whats = ["route GET /x", "route POST /x", "route PUT /x", "route DELETE /x", "route PATCH /x", "route OPTIONS /x", "websocket route /w", "websocket_open route /w", "websocket_close route /w"]
    for i in 0..kinds.size {
      log = "${scratch()}/http-route-serving-${stamp}-${kinds[i]}.log"
      args: Array(String) = []
      args.push(kinds[i])
      status = process_run_out(bin, args, log) ?? -1
      text = file_read(log) ?? ""
      c.eq_int(status, 0, "Server.${kinds[i]} while serving: the server goes on, status 0")
      c.eq_str(text, "avant runtime: ${whats[i]} registered while the server is serving: register every route before serve\nanswered 500\n", "Server.${kinds[i]} while serving: the trap's line, the request answered 500")
    }
    // A limit is set before serving, like a route (from a handler, a
    // trap that fails its request); a negative one traps, before serving
    // a trap that ends the program.
    limits = ["head_timeout", "min_rate", "limit-negative", "rate-negative"]
    lines = [
      "avant runtime: Server.head_timeout called while the server is serving: set every limit before serve\nanswered 500\n",
      "avant runtime: Server.min_rate called while the server is serving: set every limit before serve\nanswered 500\n",
      "avant runtime: Server.head_timeout(-1): a limit is 0 (off) to 2147483647\n",
      "avant runtime: Server.min_rate(240, -5): a limit is 0 (off) to 2147483647\n"
    ]
    for i in 0..limits.size {
      log = "${scratch()}/http-route-serving-${stamp}-${limits[i]}.log"
      args: Array(String) = []
      args.push(limits[i])
      status = process_run_out(bin, args, log) ?? -1
      text = file_read(log) ?? ""
      want_status = 1
      if i < 2 {
        want_status = 0
      }
      c.eq_int(status, want_status, "Server ${limits[i]}: status ${want_status}")
      c.eq_str(text, lines[i], "Server ${limits[i]}: the trap's line")
    }
  } else {
    c.expect(false, "AVANT_COMPILER is set for the route-while-serving test")
  }
}

// Response.header with CR or LF in a value or a name that is not
// a token: appended as it came, it added header lines or a second
// answer (response splitting). `header` traps now. The fixture's
// handler sets the header its argument names, and a raw client
// reads what reaches the wire: the trap fails the request before
// any of its answer is written, so the answer is the 500 the server
// gives a handler that trapped, with none of the header. The valid
// case (a tab, a quote and bytes over 127 in the value, the token's
// punctuation in the name) is answered with the header as given.
fn header_split_cases(c: Checks, root: String) {
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    bin = "${scratch()}/http-header-split-${stamp}.bin"
    clog = "${scratch()}/http-header-split-${stamp}.clog"
    code = compile_av(compiler, "${root}/tests/fixtures/http/header_split.av", bin, clog)
    c.eq_int(code, 0, "the header-split fixture compiles")
    value_rule = "a header value holds no CR, LF or other control character but tab (RFC 9110)"
    name_rule = "is not a token: a header name is letters, digits and !#$%&'*+-.^_`|~ (RFC 9110)"
    status_rule = "is not 200 to 599: a handler gives the final answer, never an interim 1xx (RFC 9110)"
    kinds = ["crlf", "lf", "cr", "answer", "nul", "del", "name-crlf", "name-space", "name-colon", "name-empty", "status-99", "status-600", "status-neg", "status-big", "status-100", "status-101", "status-199", "ok", "status-200", "status-599"]
    lines = [
      "avant runtime: Response.header value of X-A holds a control character (byte 13 at 1): ${value_rule}\n",
      "avant runtime: Response.header value of X-A holds a control character (byte 10 at 1): ${value_rule}\n",
      "avant runtime: Response.header value of X-A holds a control character (byte 13 at 1): ${value_rule}\n",
      "avant runtime: Response.header value of X-A holds a control character (byte 13 at 1): ${value_rule}\n",
      "avant runtime: Response.header value of X-A holds a control character (byte 0 at 1): ${value_rule}\n",
      "avant runtime: Response.header value of X-A holds a control character (byte 127 at 1): ${value_rule}\n",
      "avant runtime: Response.header name \"X-A: 1\\r\\nSet-Cookie\" ${name_rule}\n",
      "avant runtime: Response.header name \"X A\" ${name_rule}\n",
      "avant runtime: Response.header name \"X-A:\" ${name_rule}\n",
      "avant runtime: Response.header name \"\" ${name_rule}\n",
      "avant runtime: a response's status 99 ${status_rule}\n",
      "avant runtime: a response's status 600 ${status_rule}\n",
      "avant runtime: a response's status -200 ${status_rule}\n",
      "avant runtime: a response's status 99999999999 ${status_rule}\n",
      "avant runtime: a response's status 100 ${status_rule}\n",
      "avant runtime: a response's status 101 ${status_rule}\n",
      "avant runtime: a response's status 199 ${status_rule}\n",
      "",
      "",
      ""
    ]
    for i in 0..kinds.size {
      kind = kinds[i]
      log = "${scratch()}/http-header-split-${stamp}-${kind}.log"
      port_file = "${scratch()}/http-header-split-${stamp}-${kind}.port"
      server = spawn {
        args: Array(String) = []
        args.push(kind)
        args.push(port_file)
        process_run_out(bin, args, log) ?? -1
      }
      wlog = "${scratch()}/http-header-split-${stamp}-${kind}.wire"
      pargs: Array(String) = []
      pargs.push("${root}/tests/fixtures/http/raw_client.py")
      pargs.push("0")
      pargs.push("header_split")
      pargs.push(port_file)
      _ = process_run_out("/usr/bin/python3", pargs, wlog)
      wire = nth_line(file_read(wlog) ?? "", 0)
      status = server.join() ?? -1
      text = file_read(log) ?? ""
      if kind == "ok" {
        c.eq_int(status, 0, "Response.header ${kind}: answered, status 0")
        c.eq_str(wire, "header_split=1 answer(s) 200 Content-Type: text/plain; charset=utf-8|X-Ok!#$%&'*+-.^_`|~: a\\tb \"c\" \\xc3\\xa9|Content-Length: 1|Connection: close", "Response.header ${kind}: the header on the wire as given")
      } else if kind == "status-200" || kind == "status-599" {
        // The ends of the range are answered.
        c.eq_int(status, 0, "a response's ${kind}: answered, status 0")
        c.eq_str(wire, "header_split=1 answer(s) ${str_slice(kind, 7, kind.size)} Content-Type: text/plain; charset=utf-8|Content-Length: 1|Connection: close", "a response's ${kind}: on the wire")
      } else {
        what = "Response.header ${kind}"
        if kind.size > 7 && str_slice(kind, 0, 7) == "status-" {
          what = "a response's ${kind}"
        }
        c.eq_int(status, 0, "${what}: the server goes on, status 0")
        c.eq_str(text, lines[i], "${what}: the trap's line")
        c.eq_str(wire, "header_split=1 answer(s) 500 Content-Type: text/plain|Content-Length: 21|Connection: close", "${what}: answered 500, none of the header on the wire")
      }
    }
  } else {
    c.expect(false, "AVANT_COMPILER is set for the header-split test")
  }
}

// `Response.head` was a public field,
// so a `Response { ... }` literal wrote any head bytes past
// Response.header's check (CR LF among them). The field is private: a
// literal outside std.http does not compile, and neither does reading
// the field; a response built by Response.text and `header` does.
fn response_literal_cases(c: Checks) {
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    srcs = [
      "import std.http\n\nfn main {\n  r = Response { status: 200, headers: Response.text(\"x\").headers, head: \"X: 1\\r\\n\\r\\nforged\", body: \"x\".bytes }\n  puts(r.status)\n}\n",
      "import std.http\n\nfn main {\n  puts(Response.text(\"x\").head)\n}\n",
      "import std.http\n\nfn main {\n  r = Response.text(\"x\", 201).header(\"X-A\", \"1\")\n  puts(r.status)\n}\n"
    ]
    names = ["literal", "read", "built"]
    for i in 0..srcs.size {
      src = "${scratch()}/http-response-${stamp}-${names[i]}.av"
      if wrote = file_write(src, srcs[i]) {
      }
      bin = "${scratch()}/http-response-${stamp}-${names[i]}.bin"
      clog = "${scratch()}/http-response-${stamp}-${names[i]}.clog"
      code = compile_av(compiler, src, bin, clog)
      text = file_read(clog) ?? ""
      if names[i] == "built" {
        c.eq_int(code, 0, "a response built by Response.text and header compiles")
      } else {
        c.expect(code != 0, "Response.head outside std.http (${names[i]}): a compile error")
        c.expect(text.contains("field head of Response is private to module std.http"), "Response.head outside std.http (${names[i]}): the field is private (${text})")
      }
    }
  } else {
    c.expect(false, "AVANT_COMPILER is set for the Response literal test")
  }
}

// The port a fixture server wrote to `path` ("PORT\n"), 0 when it has
// not within 10 s.
fn wait_port(path: String): Int {
  tries = 0
  while tries < 500 {
    if text = file_read(path) {
      if text.size > 1 && text[text.size - 1] == 10 {
        return str_slice(text, 0, text.size - 1).to_i() ?? 0
      }
    }
    sleep_ms(20)
    tries += 1
  }
  0
}

// The client read until the server closed, and looked at the
// response's length only then, so a server that answers completely and
// keeps the connection open (it ignores Connection: close) held the
// call until its deadline, which failed it as a timeout. The client
// stops at the end the framing gives: Content-Length, the last chunk
// and its trailers (also with a Content-Length beside it), a 204, a
// redirect's empty body; a body with neither still ends at the close.
// A 304's and a HEAD answer's Content-Length is not their body's (they
// have none): it made them invalid responses even from a server that
// closed.
// The fixture sends some answers in pieces 0.1 s apart (half a head,
// half a chunk size), so a client that stops too early is caught too.
fn client_framing_cases(c: Checks, root: String) {
  stamp = now_ms()
  port_file = "${scratch()}/http-keep-${stamp}.port"
  log = "${scratch()}/http-keep-${stamp}.log"
  server = spawn {
    args: Array(String) = []
    args.push("${root}/tests/fixtures/http/keep_server.py")
    args.push(port_file)
    args.push("30")
    process_run_out("/usr/bin/python3", args, log) ?? -1
  }
  port = wait_port(port_file)
  c.expect(port > 0, "the keep-open server is listening")
  paths = ["/cl", "/cl-late", "/chunked", "/chunked-late", "/both", "/204", "/304", "/head", "/redirect", "/close"]
  wants = ["200 hello", "200 hello", "200 hello", "200 hello", "200 hello", "204 ", "304 ", "200 ", "200 hello", "200 until close"]
  hs: Array(Header) = []
  for i in 0..paths.size {
    method = "GET"
    if paths[i] == "/head" {
      method = "HEAD"
    }
    t0 = now_ms()
    r = Http.request(method, "http://127.0.0.1:${port}${paths[i]}", "".bytes, hs, true, 4000)
    took = now_ms() - t0
    got = ""
    switch r {
      case e: HttpError { got = e.message }
      case resp: Response { got = "${resp.status} ${String.from_utf8(resp.body) ?? "?"}" }
    }
    c.eq_str(got, wants[i], "${method} ${paths[i]} from a server that keeps the connection open")
    c.expect(took < 2000, "${method} ${paths[i]} returns when the response is complete, not at the deadline (${took} ms)")
  }
  if resp = Http.get("http://127.0.0.1:${port}/__stop", true, 4000) {
  }
  c.eq_int(server.join() ?? -1, 0, "the keep-open server ends")
}

// The result of one client call as a line: "STATUS BODY" or the
// HttpError's message.
fn outcome(r: Response | HttpError): String {
  switch r {
    case e: HttpError { e.message }
    case resp: Response { "${resp.status} ${String.from_utf8(resp.body) ?? "?"}" }
  }
}

// The client wrote the method, the URL's
// target and each header into the request as given, so CR LF in any of
// them added request lines (the server here would have echoed an
// X-Injected line) or a second request. A request that breaks
// Response.header's rules (a method and a header name are tokens, a
// value holds no control character but tab) or holds a space or a
// control character in its URL is not sent: the call returns an
// HttpError naming the part and the byte. A valid request is sent as
// given, a tab in a value included; a caller's Content-Length and
// Connection are the client's own and are skipped, as Response.header
// skips them (a second Content-Length was a second reading of where
// the body ends).
fn client_request_cases(c: Checks, root: String) {
  stamp = now_ms()
  port_file = "${scratch()}/http-request-${stamp}.port"
  log = "${scratch()}/http-request-${stamp}.log"
  server = spawn {
    args: Array(String) = []
    args.push("${root}/tests/fixtures/http/keep_server.py")
    args.push(port_file)
    args.push("0")
    process_run_out("/usr/bin/python3", args, log) ?? -1
  }
  port = wait_port(port_file)
  c.expect(port > 0, "the echo server is listening")
  base = "http://127.0.0.1:${port}"
  token_rule = "letters, digits and !#$%&'*+-.^_`|~ (RFC 9110)"
  value_rule = "a header value holds no CR, LF or other control character but tab (RFC 9110)"
  url_rule = "a URL holds no space or control character (RFC 3986)"
  none: Array(Header) = []
  methods = ["GET\r\nX-Injected: 1\r\nX: GET", "GET /echo HTTP/1.1", "", "G${chr(127)}T"]
  method_wants = [
    "invalid request method (byte 13 at 3): a method is a token: ${token_rule}",
    "invalid request method (byte 32 at 3): a method is a token: ${token_rule}",
    "invalid request method (empty): a method is a token: ${token_rule}",
    "invalid request method (byte 127 at 1): a method is a token: ${token_rule}"
  ]
  for i in 0..methods.size {
    c.eq_str(outcome(Http.request(methods[i], "${base}/echo", "".bytes, none, false, 4000)), method_wants[i], "a request method that is not a token is refused (${i})")
  }
  at = base.size + 5
  tails = ["/echo\r\nX-Injected: 1", "/echo\nX-Injected: 1", "/echo x", "/echo?a=\tb", "/echo#\r\n"]
  tail_bytes = [13, 10, 32, 9, 13]
  tail_at = [at, at, at, at + 3, at + 1]
  for i in 0..tails.size {
    c.eq_str(outcome(Http.get("${base}${tails[i]}", false, 4000)), "invalid URL (byte ${tail_bytes[i]} at ${tail_at[i]}): ${url_rule}", "a URL with a control character or a space is refused (${i})")
  }
  c.eq_str(outcome(Http.get("http://127.0.0.1\r\nX-Injected: 1:${port}/echo", false, 4000)), "invalid URL (byte 13 at 16): ${url_rule}", "an authority with CR LF is refused")
  names = ["X-Injected: 1\r\nX-A", "X A", "", "X-${chr(195)}${chr(169)}"]
  name_wants = ["byte 58 at 10", "byte 32 at 1", "empty", "byte 195 at 2"]
  for i in 0..names.size {
    hs: Array(Header) = []
    hs.push(Header { name: "X-Ok", value: "1" })
    hs.push(Header { name: names[i], value: "1" })
    c.eq_str(outcome(Http.request("GET", "${base}/echo", "".bytes, hs, false, 4000)), "invalid request header name (header 1, ${name_wants[i]}): a header name is ${token_rule}", "a header name that is not a token is refused (${i})")
  }
  values = ["1\r\nX-Injected: 1", "1\nX-Injected: 1", "1\r", "a${chr(0)}b", chr(127), "a${chr(27)}b"]
  value_wants = ["byte 13 at 1", "byte 10 at 1", "byte 13 at 1", "byte 0 at 1", "byte 127 at 0", "byte 27 at 1"]
  for i in 0..values.size {
    hs: Array(Header) = []
    hs.push(Header { name: "X-A", value: values[i] })
    c.eq_str(outcome(Http.request("GET", "${base}/echo", "".bytes, hs, false, 4000)), "invalid request header value of X-A (${value_wants[i]}): ${value_rule}", "a header value with a control character is refused (${i})")
  }
  switch Ws.connect("ws://127.0.0.1:${port}/echo\r\nX-Injected: 1", 4000) {
    case e: HttpError { c.eq_str(e.message, "invalid URL (byte 13 at ${base.size + 3}): ${url_rule}", "Ws.connect refuses a URL with CR LF") }
    case WsConnection { c.expect(false, "Ws.connect refuses a URL with CR LF") }
  }
  ok: Array(Header) = []
  ok.push(Header { name: "X-Ok!#$%&'*+-.^_`|~", value: "a\tb \"c\" ${chr(195)}${chr(169)}" })
  ok.push(Header { name: "content-length", value: "0" })
  ok.push(Header { name: "Connection", value: "keep-alive" })
  c.eq_str(outcome(Http.request("POST", "${base}/echo", "abc".bytes, ok, false, 4000)), "200 POST /echo HTTP/1.1|Host: 127.0.0.1:${port}|X-Ok!#$%&'*+-.^_`|~: a\tb \"c\" ${chr(195)}${chr(169)}|Content-Length: 3|Connection: close", "a valid request is sent as given, without the caller's Content-Length and Connection")
  c.eq_str(outcome(Http.get("${base}/echo?q=%41~", false, 4000)), "200 GET /echo?q=%41~ HTTP/1.1|Host: 127.0.0.1:${port}|Content-Length: 0|Connection: close", "a valid target is sent as given")
  // A caller's Host was sent beside the URL's: two Host lines, which a
  // server refuses. It replaces the URL's, in any case of its name.
  for name in ["Host", "host", "HOST"] {
    vh: Array(Header) = []
    vh.push(Header { name: "X-A", value: "1" })
    vh.push(Header { name: name, value: "example.test:8080" })
    c.eq_str(outcome(Http.request("GET", "${base}/echo", "".bytes, vh, false, 4000)), "200 GET /echo HTTP/1.1|Host: example.test:8080|X-A: 1|Content-Length: 0|Connection: close", "a caller's ${name} replaces the URL's: one Host line")
  }
  bad_host: Array(Header) = []
  bad_host.push(Header { name: "Host", value: "a\r\nX-Injected: 1" })
  c.eq_str(outcome(Http.request("GET", "${base}/echo", "".bytes, bad_host, false, 4000)), "invalid request header value of Host (byte 13 at 1): ${value_rule}", "a caller's Host is checked as any value")
  // A caller's headers followed every redirect, to another authority
  // too: an Authorization, a Cookie or a Host set for this server
  // reached the one the redirect named. On a hop to another host or port
  // they are left out; the others are sent, and a redirect on the same
  // authority sends them all.
  creds: Array(Header) = []
  creds.push(Header { name: "Authorization", value: "Bearer secret" })
  creds.push(Header { name: "cookie", value: "s=1" })
  creds.push(Header { name: "Proxy-Authorization", value: "Basic x" })
  creds.push(Header { name: "X-Keep", value: "1" })
  creds.push(Header { name: "Host", value: "example.test" })
  c.eq_str(outcome(Http.request("GET", "${base}/to?http://127.0.0.1:${port}/echo", "".bytes, creds, true, 4000)), "200 GET /echo HTTP/1.1|Host: example.test|Authorization: Bearer secret|cookie: s=1|Proxy-Authorization: Basic x|X-Keep: 1|Content-Length: 0|Connection: close", "a redirect to the same authority is sent every header")
  c.eq_str(outcome(Http.request("GET", "${base}/to?/echo", "".bytes, creds, true, 4000)), "200 GET /echo HTTP/1.1|Host: example.test|Authorization: Bearer secret|cookie: s=1|Proxy-Authorization: Basic x|X-Keep: 1|Content-Length: 0|Connection: close", "a relative redirect is sent every header")
  other_file = "${scratch()}/http-request-${stamp}-other.port"
  other_log = "${scratch()}/http-request-${stamp}-other.log"
  other = spawn {
    args: Array(String) = []
    args.push("${root}/tests/fixtures/http/keep_server.py")
    args.push(other_file)
    args.push("0")
    process_run_out("/usr/bin/python3", args, other_log) ?? -1
  }
  other_port = wait_port(other_file)
  c.eq_str(outcome(Http.request("GET", "${base}/to?http://127.0.0.1:${other_port}/echo", "".bytes, creds, true, 4000)), "200 GET /echo HTTP/1.1|Host: 127.0.0.1:${other_port}|X-Keep: 1|Content-Length: 0|Connection: close", "a redirect to another port is another authority")
  c.eq_str(outcome(Http.request("GET", "${base}/to?http://127.0.0.1:${other_port}/to?http://127.0.0.1:${port}/echo", "".bytes, creds, true, 4000)), "200 GET /echo HTTP/1.1|Host: example.test|Authorization: Bearer secret|cookie: s=1|Proxy-Authorization: Basic x|X-Keep: 1|Content-Length: 0|Connection: close", "a redirect back to the first authority is sent every header again")
  if resp = Http.get("http://127.0.0.1:${other_port}/__stop", true, 4000) {
  }
  c.eq_int(other.join() ?? -1, 0, "the second echo server ends")
  if resp = Http.get("${base}/__stop", true, 4000) {
  }
  c.eq_int(server.join() ?? -1, 0, "the echo server ends")
}

// How the client reads a response: GET each path of
// tests/fixtures/http/keep_server.py (which closes after each answer
// here) and compare "STATUS BODY", or the error, with its want (a want
// ending in " from" gets the server's authority).
fn client_response_round(c: Checks, root: String, what: String, paths: Array(String), wants: Array(String)) {
  stamp = now_ms()
  port_file = "${scratch()}/http-response-${stamp}.port"
  log = "${scratch()}/http-response-${stamp}.log"
  server = spawn {
    args: Array(String) = []
    args.push("${root}/tests/fixtures/http/keep_server.py")
    args.push(port_file)
    args.push("0")
    process_run_out("/usr/bin/python3", args, log) ?? -1
  }
  port = wait_port(port_file)
  c.expect(port > 0, "the answering server is listening (${what})")
  for i in 0..paths.size {
    want = wants[i]
    if want.size > 5 && str_slice(want, want.size - 5, want.size) == " from" {
      want = "${want} 127.0.0.1:${port}"
    }
    c.eq_str(outcome(Http.get("http://127.0.0.1:${port}${paths[i]}", false, 4000)), want, "${what}: ${paths[i]}")
  }
  if resp = Http.get("http://127.0.0.1:${port}/__stop", true, 4000) {
  }
  c.eq_int(server.join() ?? -1, 0, "the answering server ends (${what})")
}

// A response with two Content-Length values
// was read by the first (RFC 9112 6.3: the user agent discards it, a
// proxy may have read the other). Every repeat is refused, identical
// or not, as a list in one line or as a folded line, the server's rule
// for requests; one value is read as before.
fn client_length_cases(c: Checks, root: String) {
  invalid = "invalid HTTP response body from"
  paths = ["/cl-differ", "/cl-differ-reversed", "/cl-same", "/cl-list", "/cl-folded", "/cl-bad", "/cl"]
  wants = [invalid, invalid, invalid, invalid, invalid, invalid, "200 hello"]
  client_response_round(c, root, "a response with more than one Content-Length is refused", paths, wants)
}

// An interim answer (100 Continue, 102, 103
// Early Hints) before the final one was returned as the response, the
// final answer's bytes as its body. The client reads past every interim
// answer (RFC 9110 15.2), also when one arrives in pieces; an interim
// answer and then the close is no response; a 101 is the answer still.
fn client_interim_cases(c: Checks, root: String) {
  paths = ["/100", "/103", "/1xx-many", "/1xx-split", "/1xx-only", "/101"]
  wants = ["200 hello", "200 hello", "201 hello", "200 hello", "invalid HTTP response from", "101 "]
  client_response_round(c, root, "interim answers are read past", paths, wants)
}

// A WebSocket message larger than the socket takes at once, sent from
// the handler (the owner thread's direct write) to a client that reads
// late: the socket took a part, the rest was refused
// by the send queue's 1 MiB bound and dropped, and `send_text` returned
// false with half a frame on the wire. The rest of a frame begun is
// queued whatever the bound now: the message arrives whole and the
// connection carries the next one. With `chunk` the server is
// created with AVANT_HTTP_WS_WRITE_CHUNK, an internal variable that
// shrinks the most one write hands the socket from 1 GiB: a message
// larger than it takes the path one of 1 GiB or more takes (its first
// write cut to the piece, the rest written a piece at a time), which
// the suite cannot afford at full size. Its defect, a 32-bit total that
// let a payload within 10 bytes of 2^31 pass a part for the whole
// frame, is shown at full size in the wave's record only.
fn ws_big_round(c: Checks, root: String, chunk: String, size: Int) {
  if chunk.size > 0 {
    set_env("AVANT_HTTP_WS_WRITE_CHUNK", chunk)
  }
  listened = Http.listen(0, "127.0.0.1", 1048576, 1)
  set_env("AVANT_HTTP_WS_WRITE_CHUNK", "")
  if opened = listened {
    server = opened
    big = Mutex(String).new("nothing")
    server.websocket("/ws-big", (conn, msg) {
      text = msg.text() ?? ""
      if text.size > 4 && str_slice(text, 0, 4) == "big " {
        n = str_slice(text, 4, text.size).to_i() ?? 0
        b = buf_new()
        for i in 0..n {
          b.push_byte(97 + i % 26)
        }
        sent = "${conn.send_text(b.to_s())}"
        big.with (v) { v = sent }
      } else {
        said = big.with (v) { v }
        _ = conn.send_text("the big send returned ${said}")
      }
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    stamp = now_ms()
    out = Channel(String).new(2)
    task = spawn {
      out.send(raw_client(port, root, stamp, "ws_big", "${size}"))
      stop(port)
      0
    }
    server.serve()
    c.eq_int(task.join() ?? -1, 0, "ws big-message task (${size} bytes)")
    want: Array(String) = []
    want.push("ws_big=whole,then the big send returned true")
    piece = "1 GiB"
    if chunk.size > 0 {
      piece = "${chunk} bytes"
    }
    expect_lines(c, out, want, "a WebSocket message of ${size} bytes the socket takes in part arrives whole (write piece ${piece}):")
  } else {
    c.expect(false, "listen for the large WebSocket message test")
  }
}

fn ws_big_cases(c: Checks, root: String) {
  ws_big_round(c, root, "", 8388608)
  ws_big_round(c, root, "65536", 1048581)
}

// Three write paths took a length past
// INT_MAX in an int or 32 bits: an answer's two parts handed to
// us_socket_write2 (which adds them in an int), the answer's
// Content-Length, and the WebSocket client's frame rest. The suite
// cannot afford 2 GiB; under AVANT_HTTP_WS_WRITE_CHUNK=65536 (read by
// the server at listen time and by each client call) the paths a
// length past the piece (1 GiB) takes run with one of 1 MiB: the
// answer written a piece at a time after its head, the client's
// request and the WebSocket client's message a piece at a time. Each
// arrives whole. (This shows the new paths; the defects themselves
// needed 2 GiB, too much for the suite.)
fn write_piece_cases(c: Checks) {
  n = 1048581
  b = buf_new()
  for i in 0..n {
    b.push_byte(97 + i % 26)
  }
  big = b.to_s()
  set_env("AVANT_HTTP_WS_WRITE_CHUNK", "65536")
  listened = Http.listen(0, "127.0.0.1", 4194304, 1, 4194304)
  if opened = listened {
    server = opened
    server.get("/big", (req) {
      Response.text(big)
    })
    server.post("/size", (req) {
      Response.text("${req.body.size} ${(String.from_utf8(req.body) ?? "?") == big}")
    })
    server.websocket("/ws", (conn, msg) {
      _ = conn.send_text("${msg.body.size} ${(msg.text() ?? "") == big}")
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    out = Channel(String).new(4)
    task = spawn {
      got = "no answer"
      if resp = Http.get("http://127.0.0.1:${port}/big", false, 10000) {
        got = "${resp.status} ${resp.body.size} ${(String.from_utf8(resp.body) ?? "") == big}"
      }
      out.send(got)
      hs: Array(Header) = []
      out.send(outcome(Http.request("POST", "http://127.0.0.1:${port}/size", big.bytes, hs, false, 10000)))
      ws = "no connection"
      if conn = Ws.connect("ws://127.0.0.1:${port}/ws", 10000) {
        ws = "not sent"
        if conn.send_text(big) {
          ws = "no answer"
          if msg = conn.recv(10000) {
            ws = msg.text() ?? "binary"
          }
        }
        conn.close()
      }
      out.send(ws)
      stop(port)
      0
    }
    server.serve()
    set_env("AVANT_HTTP_WS_WRITE_CHUNK", "")
    c.eq_int(task.join() ?? -1, 0, "write-piece task")
    want: Array(String) = []
    want.push("200 ${n} true")
    want.push("200 ${n} true")
    want.push("${n} true")
    expect_lines(c, out, want, "an answer, a request and a WebSocket client message past the write piece arrive whole:")
  } else {
    set_env("AVANT_HTTP_WS_WRITE_CHUNK", "")
    c.expect(false, "listen for the write-piece test")
  }
}

// Ws.connect with a target of `n` bytes against
// tests/fixtures/http/ws_target_server.py, which reads the handshake
// late with a small receive buffer: what the connection gave.
fn ws_target_round(root: String, n: Int, out: Channel(String)) {
  stamp = now_ms()
  port_file = "${scratch()}/ws-target-${stamp}-${n}.port"
  log = "${scratch()}/ws-target-${stamp}-${n}.log"
  server = spawn {
    args: Array(String) = []
    args.push("${root}/tests/fixtures/http/ws_target_server.py")
    args.push(port_file)
    process_run_out("/usr/bin/python3", args, log) ?? -1
  }
  port = wait_port(port_file)
  r = Ws.connect("ws://127.0.0.1:${port}/${repeat_byte(97, n)}", 5000)
  switch r {
    case e: HttpError { out.send("target ${n}: ${e.message}") }
    case conn: WsConnection {
      _ = conn.send_text("hi")
      if msg = conn.recv(5000) {
        out.send("target ${n}: ${msg.text() ?? "?"}")
      } else {
        out.send("target ${n}: connected, no answer")
      }
      conn.close()
    }
  }
  _ = server.join()
}

// The WebSocket client's handshake: it was formatted
// into 2048 bytes and copied by the length it would have had, so a
// target of a few thousand bytes overran the buffers and glibc stopped
// the program (SIGABRT). It is built to its length now. And it was
// written with one call whose count was ignored: a handshake the
// socket took in part was cut, and the call timed out. A 4 MiB target
// to a server that reads late is more than the socket takes at once;
// the rest is sent as the socket becomes writable.
fn ws_handshake_cases(c: Checks, root: String) {
  out = Channel(String).new(4)
  ws_target_round(root, 4000, out)
  ws_target_round(root, 4194304, out)
  want: Array(String) = []
  want.push("target 4000: target of 4001 bytes, message hi")
  want.push("target 4194304: target of 4194305 bytes, message hi")
  // A handshake the peer never takes (a listener that is never served)
  // is written as the socket allows, within the call's deadline.
  if quiet = Http.listen(0, "127.0.0.1", 1048576, 1) {
    long_url = "ws://127.0.0.1:${quiet.port()}/${repeat_byte(97, 4194304)}"
    t0 = now_ms()
    switch Ws.connect(long_url, 1000) {
      case e: HttpError { out.send(timed("ws-long", t0, 1000, e.message)) }
      case WsConnection { out.send("ws-long=connected") }
    }
    quiet.close()
  } else {
    out.send("no listener")
  }
  want.push("ws-long=timed out in time")
  expect_lines(c, out, want, "a WebSocket handshake longer than 2048 bytes:")
}

// The deadlines of Ws.connect and recv were
// read from the wall clock and waited for on it, so a step of the system
// clock during the wait moved them. A test cannot step the machine's
// clock; the fixture runs under the LD_PRELOAD shim
// tests/fixtures/http/clock_step.c instead, which answers
// clock_gettime(CLOCK_REALTIME) an hour early: a deadline read from the
// wall clock then lies an hour in the past and the wait ends at once
// (on the starting head both end after 0 ms). What this shows is that
// neither deadline is read from the wall clock any more; the kernel's
// side of a real step (the futex's clock) is CLOCK_MONOTONIC's by the
// condition variable's attribute, which the shim cannot reach.
// A WebSocket frame whose rest could not be
// copied (out of memory) after its first bytes were on the wire: the
// send returned false and left the connection open, so the next frame
// was read as the rest of its payload. The connection is closed now
// (1006 to the close handler) and every later send answers false; the
// server goes on. tests/fixtures/http/ws_cut.av runs under the
// LD_PRELOAD shim tests/fixtures/http/malloc_fail.c, which fails the
// fixture's large mallocs while its handler sends.
fn ws_cut_cases(c: Checks, root: String) {
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    bin = "${scratch()}/ws-cut-${stamp}.bin"
    so = "${scratch()}/malloc-fail-${stamp}.so"
    code = compile_av(compiler, "${root}/tests/fixtures/http/ws_cut.av", bin, "${scratch()}/ws-cut-${stamp}.clog")
    c.eq_int(code, 0, "the cut-frame fixture compiles")
    cargs: Array(String) = []
    cargs.push("cc")
    cargs.push("-shared")
    cargs.push("-fPIC")
    cargs.push("-o")
    cargs.push(so)
    cargs.push("${root}/tests/fixtures/http/malloc_fail.c")
    c.eq_int(process_run_out("/usr/bin/env", cargs, "${scratch()}/malloc-fail-${stamp}.cclog") ?? -1, 0, "the malloc-fail shim builds")
    port_file = "${scratch()}/ws-cut-${stamp}.port"
    log = "${scratch()}/ws-cut-${stamp}.log"
    server = spawn {
      args: Array(String) = []
      args.push("LD_PRELOAD=${so}")
      args.push(bin)
      args.push(port_file)
      process_run_out("/usr/bin/env", args, log) ?? -1
    }
    wlog = "${scratch()}/ws-cut-${stamp}.wire"
    pargs: Array(String) = []
    pargs.push("${root}/tests/fixtures/http/raw_client.py")
    pargs.push("0")
    pargs.push("ws_cut")
    pargs.push(port_file)
    _ = process_run_out("/usr/bin/python3", pargs, wlog)
    wire = nth_line(file_read(wlog) ?? "", 0)
    port = wait_port(port_file)
    stop(port)
    c.eq_int(server.join() ?? -1, 0, "the cut-frame server ends, status 0")
    c.eq_str(wire, "ws_cut=closed mid-frame; big false, after false, closed 1006", "a frame whose rest cannot be queued closes its connection")
  } else {
    c.expect(false, "AVANT_COMPILER is set for the cut-frame test")
  }
}

// accept failing for want of descriptors
// (EMFILE) left the listening socket readable, and the loop polled it
// again at once: a busy loop, a second of CPU in each second the
// shortage lasted. The socket is polled again at the loop's next sweep;
// once descriptors are free the waiting connection is answered.
fn emfile_cases(c: Checks, root: String) {
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    bin = "${scratch()}/emfile-${stamp}.bin"
    code = compile_av(compiler, "${root}/tests/fixtures/http/emfile.av", bin, "${scratch()}/emfile-${stamp}.clog")
    c.eq_int(code, 0, "the EMFILE fixture compiles")
    port_file = "${scratch()}/emfile-${stamp}.port"
    log = "${scratch()}/emfile-${stamp}.log"
    server = spawn {
      args: Array(String) = []
      args.push(port_file)
      process_run_out(bin, args, log) ?? -1
    }
    wlog = "${scratch()}/emfile-${stamp}.wire"
    pargs: Array(String) = []
    pargs.push("${root}/tests/fixtures/http/raw_client.py")
    pargs.push("0")
    pargs.push("emfile")
    pargs.push(port_file)
    _ = process_run_out("/usr/bin/python3", pargs, wlog)
    c.eq_str(nth_line(file_read(wlog) ?? "", 0), "emfile=answered", "a connection that waited while descriptors ran out is answered")
    c.eq_int(server.join() ?? -1, 0, "the EMFILE server ends, status 0")
    c.eq_str(file_read(log) ?? "", "cpu while accept failed: under 300 ms\n", "a failing accept does not spin the loop")
  } else {
    c.expect(false, "AVANT_COMPILER is set for the EMFILE test")
  }
}

fn ws_deadline_cases(c: Checks, root: String) {
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    bin = "${scratch()}/ws-deadlines-${stamp}.bin"
    so = "${scratch()}/clock-step-${stamp}.so"
    clog = "${scratch()}/ws-deadlines-${stamp}.clog"
    code = compile_av(compiler, "${root}/tests/fixtures/http/ws_deadlines.av", bin, clog)
    c.eq_int(code, 0, "the WebSocket deadline fixture compiles")
    cargs: Array(String) = []
    cargs.push("cc")
    cargs.push("-shared")
    cargs.push("-fPIC")
    cargs.push("-o")
    cargs.push(so)
    cargs.push("${root}/tests/fixtures/http/clock_step.c")
    cargs.push("-ldl")
    c.eq_int(process_run_out("/usr/bin/env", cargs, "${scratch()}/clock-step-${stamp}.cclog") ?? -1, 0, "the clock-step shim builds")
    args: Array(String) = []
    args.push("LD_PRELOAD=${so}")
    args.push(bin)
    log = "${scratch()}/ws-deadlines-${stamp}.log"
    status = process_run_out("/usr/bin/env", args, log) ?? -1
    c.eq_int(status, 0, "the WebSocket deadline fixture under a wall clock an hour back: status 0")
    c.eq_str(file_read(log) ?? "", "connect: in time\nrecv: in time\n", "Ws.connect's and recv's deadlines under a wall clock an hour back")
  } else {
    c.expect(false, "AVANT_COMPILER is set for the WebSocket deadline test")
  }
}

fn deadline_round(port: Int, out: Channel(String), root: String, stamp: Int): Int {
  out.send(raw_client(port, root, stamp, "trickle_head", ""))
  out.send(raw_client(port, root, stamp, "slow_body", ""))
  out.send(raw_client(port, root, stamp, "fast_body", ""))
  out.send(raw_client(port, root, stamp, "slow_read", ""))
  stop(port)
  0
}

// The idle timeout was the only deadline, and it started again at every
// byte: a client sending a byte now and then held a connection for
// good, and so did one sending a body or reading an answer as slowly.
// A request head has a time from its first byte (head_timeout), and a
// body and an answer's queued tail a minimum rate once a grace has
// passed (min_rate). The server here has a head timeout of 1 s and a
// rate of 1000 bytes a second after 0.5 s, so each round takes about
// that long; a body fast enough is answered although it takes longer
// than the grace.
fn deadline_cases(c: Checks, root: String) {
  stamp = now_ms()
  if opened = Http.listen(0, "127.0.0.1", 1048576, 1) {
    server = opened.head_timeout(1000).min_rate(1000, 500)
    huge = buf_new()
    for i in 0..33554432 {
      huge.push_byte(97 + i % 26)
    }
    huge_bytes = huge.to_s().bytes
    server.get("/ping", (req) {
      Response.text("pong")
    })
    server.post("/len", (req) {
      Response.text("${req.body.size} bytes")
    })
    server.get("/huge", (req) {
      Response.bytes(huge_bytes)
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    out = Channel(String).new(8)
    task = spawn {
      deadline_round(port, out, root, stamp)
    }
    server.serve()
    c.eq_int(task.join() ?? -1, 0, "deadline task")
    want: Array(String) = []
    want.push("trickle_head=408 in time")
    want.push("slow_body=408 in time")
    want.push("fast_body=answered 200: 40000 bytes")
    want.push("slow_read=cut")
    expect_lines(c, out, want, "a slow head, body or reader meets its deadline:")
  } else {
    c.expect(false, "listen for the deadline test")
  }
}

// A trap in a handler ended the server; it fails its request now. The
// fixture's routes each trap their own way (tests/fixtures/http/
// handler_trap.av; the program spawns nothing, so its recovery points
// come from std.http alone); a raw client asks each on one kept-alive
// connection and then asks again: 500, then the next answer. Each trap
// is printed when it happens, in order. A trap inside a C callback the
// handler made still ends the program, its request unanswered.
fn handler_trap_cases(c: Checks, root: String) {
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    bin = "${scratch()}/http-handler-trap-${stamp}.bin"
    clog = "${scratch()}/http-handler-trap-${stamp}.clog"
    code = compile_av(compiler, "${root}/tests/fixtures/http/handler_trap.av", bin, clog)
    c.eq_int(code, 0, "the handler-trap fixture compiles")
    modes = ["handler_trap", "callback_trap"]
    for mode in modes {
      log = "${scratch()}/http-handler-trap-${stamp}-${mode}.log"
      port_file = "${scratch()}/http-handler-trap-${stamp}-${mode}.port"
      server = spawn {
        args: Array(String) = []
        args.push(port_file)
        process_run_out(bin, args, log) ?? -1
      }
      wlog = "${scratch()}/http-handler-trap-${stamp}-${mode}.wire"
      pargs: Array(String) = []
      pargs.push("${root}/tests/fixtures/http/raw_client.py")
      pargs.push("0")
      pargs.push(mode)
      pargs.push(port_file)
      _ = process_run_out("/usr/bin/python3", pargs, wlog)
      wire = nth_line(file_read(wlog) ?? "", 0)
      status = server.join() ?? -1
      text = file_read(log) ?? ""
      if mode == "handler_trap" {
        c.eq_int(status, 0, "a handler's trap: the server goes on to its stop, status 0")
        c.eq_str(wire, "handler_trap=bounds:500,ok:200 ok,divide:500,ok:200 ok,grow:500,ok:200 ok,grow-hash:500,ok:200 ok,status:500,ok:200 ok,header:500,ok:200 ok,route:500,ok:200 ok,late:404,mutex:500,mutex-again:500,mutex-state:200 poisoned true: the mutex is poisoned: a task or an HTTP handler trapped while it held it, so its value may be half-changed,pin:500,pins:200 pins left 0, 188890,close:500 closed,1.0:500 closed,ws:1 hi,ws-trap:8 1011,ws-after:1 again,stop:200", "a handler's trap answers 500 and the server goes on")
        whats = [
          "index 7 out of bounds (size 3)",
          "division by zero",
          "push on an array a running task reads",
          "a store on a hash a running task reads",
          "a response's status 99 is not 200 to 599",
          "Response.header value of X-A holds a control character (byte 13 at 1)",
          "route GET /late registered while the server is serving",
          "index 9 out of bounds (size 3)",
          "Mutex.with on a poisoned mutex",
          "index 8 out of bounds (size 3)",
          "index 7 out of bounds (size 3)",
          "index 7 out of bounds (size 3)",
          "index 5 out of bounds (size 3)"
        ]
        lines = text.split("\n")
        c.eq_int(lines.size, whats.size + 2, "one line per trap, then served (${text})")
        for i in 0..whats.size {
          line = lines.get(i) ?? ""
          c.expect(line.contains("avant runtime: ${whats[i]}"), "trap ${i} printed in order: ${line}")
        }
        c.eq_str(lines.get(whats.size) ?? "", "served", "serve returned")
      } else {
        c.eq_int(status, 1, "a trap in a C callback inside a handler ends the program, status 1")
        c.eq_str(wire, "callback_trap=0 closed", "a trap in a C callback: the request unanswered")
        c.expect(text.contains("avant runtime: division by zero"), "a trap in a C callback: its line (${text})")
      }
    }
  } else {
    c.expect(false, "AVANT_COMPILER is set for the handler-trap test")
  }
}

fn limit_round(port: Int, out: Channel(String), root: String, stamp: Int, mode: String): Int {
  out.send(raw_client(port, root, stamp, mode, ""))
  stop(port)
  0
}

// The production limits beside the deadlines: a server-wide budget for
// the bodies waiting for their bytes (503 past it), a connection limit
// that closes the longest idle connection (or the new one, with none
// idle), a memory ceiling past which requests are answered 503, and a
// shutdown deadline after which `close` closes what it left to finish.
fn limit_cases(c: Checks, root: String) {
  stamp = now_ms()
  if opened = Http.listen(0, "127.0.0.1", 1048576, 1) {
    server = opened.body_budget(1000)
    server.post("/len", (req) {
      Response.text("${req.body.size} bytes")
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    out = Channel(String).new(2)
    task = spawn {
      limit_round(port, out, root, stamp, "budget")
    }
    server.serve()
    c.eq_int(task.join() ?? -1, 0, "budget task")
    want: Array(String) = []
    want.push("budget=second:503 closed,first:200,third:200")
    expect_lines(c, out, want, "the body budget answers 503 past it and is given back:")
  } else {
    c.expect(false, "listen for the body budget test")
  }
  if opened = Http.listen(0, "127.0.0.1", 1048576, 1) {
    server = opened.max_connections(3)
    server.get("/ping", (req) {
      Response.text("pong")
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    out = Channel(String).new(2)
    task = spawn {
      limit_round(port, out, root, stamp, "conn_limit")
    }
    server.serve()
    c.eq_int(task.join() ?? -1, 0, "connection limit task")
    want: Array(String) = []
    want.push("conn_limit=d:True,a closed:True,b:True,c:True,e closed:True")
    expect_lines(c, out, want, "the connection limit closes the longest idle connection, or the new one:")
  } else {
    c.expect(false, "listen for the connection limit test")
  }
  if opened = Http.listen(0, "127.0.0.1", 1048576, 1) {
    server = opened.shutdown_timeout(500)
    opened_ws = Channel(Int).new(1)
    server.websocket("/ws", (conn, msg) {
      _ = conn.send_message(msg)
    })
    server.websocket_open("/ws", (conn) {
      _ = opened_ws.send(1)
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    asked = Channel(Int).new(1)
    out = Channel(String).new(2)
    silent = spawn {
      out.send(raw_client(port, root, stamp, "ws_silent", ""))
      0
    }
    stopper = spawn {
      _ = opened_ws.recv()
      asked.send(now_ms())
      stop(port)
      0
    }
    server.serve()
    returned = now_ms()
    t_ask = asked.recv() ?? 0
    c.eq_int(stopper.join() ?? -1, 0, "shutdown stopper task")
    c.eq_int(silent.join() ?? -1, 0, "shutdown client task")
    took = returned - t_ask
    c.expect(took >= 400 && took < 3000, "serve returns at the shutdown deadline with a WebSocket client that never closes (${took} ms)")
    line = out.recv() ?? ""
    c.eq_str(line, "ws_silent=the server ended its side", "the silent client was sent the server's end")
  } else {
    c.expect(false, "listen for the shutdown deadline test")
  }
  if compiler = env_get("AVANT_COMPILER") {
    bin = "${scratch()}/http-ceiling-${stamp}.bin"
    clog = "${scratch()}/http-ceiling-${stamp}.clog"
    code = compile_av(compiler, "${root}/tests/fixtures/http/handler_trap.av", bin, clog)
    c.eq_int(code, 0, "the memory-ceiling fixture compiles")
    log = "${scratch()}/http-ceiling-${stamp}.log"
    port_file = "${scratch()}/http-ceiling-${stamp}.port"
    ceiling_server = spawn {
      args: Array(String) = []
      args.push("4")
      args.push(bin)
      args.push(port_file)
      args.push("ceiling")
      process_run_out("/usr/bin/timeout", args, log) ?? -1
    }
    wlog = "${scratch()}/http-ceiling-${stamp}.wire"
    pargs: Array(String) = []
    pargs.push("${root}/tests/fixtures/http/raw_client.py")
    pargs.push("0")
    pargs.push("ceiling")
    pargs.push(port_file)
    _ = process_run_out("/usr/bin/python3", pargs, wlog)
    c.eq_str(nth_line(file_read(wlog) ?? "", 0), "ceiling=503 closed", "past the memory ceiling a request is answered 503")
    c.eq_int(ceiling_server.join() ?? -1, 124, "the memory-ceiling server ends by its timeout")
  } else {
    c.expect(false, "AVANT_COMPILER is set for the memory-ceiling test")
  }
}

fn expect_lines(c: Checks, out: Channel(String), want: Array(String), what: String) {
  i = 0
  while i < want.size {
    if line = out.recv() {
      c.eq_str(line, want[i], "${what} ${i}")
    } else {
      c.expect(false, "${what} ${i} present")
    }
    i += 1
  }
}

fn test_std_http_safety(c: Checks, root: String) {
  c.suite("tests/cases/test_std_http_safety.av")
  stamp = now_ms()

  // The client closes with pipelined answers unread. The write
  // that meets the reset connection used to raise SIGPIPE, which ended
  // this process (status 141); now it fails quietly, the connection is
  // closed, and the server answers the next client. One loop, so every
  // answer of the connection is written by the same thread, in order.
  if opened = Http.listen(0, "127.0.0.1", 1048576, 1) {
    server = opened
    server.get("/ping", (req) {
      Response.text("pong")
    })
    server.post("/echo", (req) {
      Response.bytes(req.body)
    })
    server.get("/hidden", (req) {
      Response.text("smuggled")
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    out = Channel(String).new(8)
    handle = spawn {
      close_unread_round(port, out, root, stamp)
    }
    server.serve()
    c.eq_int(handle.join() ?? -1, 0, "close-unread task")
    want: Array(String) = []
    want.push("close_unread=alive")
    want.push("close_unread=alive")
    want.push("close_unread=alive")
    expect_lines(c, out, want, "a close with pipelined answers unread leaves the server alive:")
    // A second Content-Length with another value was accepted and
    // the first one won, so the rest of the body ran as a request of its
    // own (GET /hidden here). Disagreeing lines, and a folded one, are
    // 400 and close; so is every repeat, identical or not, as two lines
    // or as a list in one; one line is a value.
    lwant: Array(String) = []
    lwant.push("lengths=differ:400,differ-reversed:400,third-differs:400,case:400,folded:400,list:400,same:400,same-list:400,one:200")
    expect_lines(c, out, lwant, "Content-Length lines that disagree are refused:")
    // A request without Host, or with two, was answered (and
    // a request behind it too). RFC 9112 3.2: 400 for an HTTP/1.1
    // request without Host and for any request with more than one; the
    // connection is closed. And for a value that is not uri-host
    // [ ":" port ].
    hwant: Array(String) = []
    hwant.push("hosts=none:400,two:400,same:400,case:400,folded:400,ws-none:400,1.0-two:400,1.0-none:200,empty:200,bad-space:400,bad-at:400,bad-path:400,bad-query:400,bad-colons:400,bad-port-alpha:400,bad-pct-bad:400,bad-pct-hex:400,bad-v6-open:400,bad-v6-empty:400,bad-v6-tail:400,bad-v6-space:400,bad-quote:400,bad-high:400,ok-name:200,ok-port:200,ok-v4:200,ok-v6:200,ok-v6-bare:200,ok-pct:200,ok-subdelims:200,ok-port-empty:200,one:200")
    expect_lines(c, out, hwant, "a request without Host, or with two, is refused:")
  } else {
    c.expect(false, "listen for the close-unread test")
  }

  // The socket takes only part of an answer. The rest is queued
  // per connection and sent when the socket is writable again: no byte
  // is lost, answers stay in order, Connection: close waits for the
  // queue, and a client that does not read is not served or read
  // further, so the server's memory stays bounded.
  //
  // The 30-second timeout was armed once, when the connection was
  // accepted, so a busy keep-alive connection was closed like an idle
  // one. It is an idle timeout now: request bytes, and queued answer
  // bytes the client takes, start it again. The server is created with
  // the timeout shortened to 8 s by AVANT_HTTP_IDLE_TIMEOUT_S (an
  // internal variable for this test, read when the server is created);
  // the idle round takes that long, so it runs beside the queue round.
  set_env("AVANT_HTTP_IDLE_TIMEOUT_S", "8")
  listened = Http.listen(0, "127.0.0.1", 1048576, 1)
  set_env("AVANT_HTTP_IDLE_TIMEOUT_S", "")
  if opened = listened {
    server = opened
    big = buf_new()
    for i in 0..8388608 {
      big.push_byte(97 + i % 26)
    }
    big_bytes = big.to_s().bytes
    digits: Array(Bytes) = []
    for d in 0..10 {
      b = buf_new()
      for i in 0..65536 {
        b.push_byte(48 + d)
      }
      digits.push(b.to_s().bytes)
    }
    flood_hits = Mutex(Int).new(0)
    server.get("/big", (req) {
      Response.bytes(big_bytes)
    })
    server.get("/n", (req) {
      k = (req.query ?? "0").to_i() ?? 0
      Response.bytes(digits[k % 10])
    })
    server.get("/f", (req) {
      flood_hits.with (n) { n += 1 }
      Response.bytes(digits[1])
    })
    server.get("/ping", (req) {
      Response.text("pong")
    })
    server.get("/__stop", (req) {
      server.close()
      Response.text("bye")
    })
    port = server.port()
    out = Channel(String).new(8)
    idle_out = Channel(String).new(2)
    done = Channel(Int).new(2)
    // The client's deadline, against a listener that is never
    // served. Its three seconds run beside the idle round's eight; the
    // listener is closed after them, which also ends a client that did
    // not time out (the starting head's), so the check fails instead of
    // hanging.
    quiet = Http.listen(0, "127.0.0.1", 1048576, 1)
    quiet_port = 0
    if q = quiet {
      quiet_port = q.port()
    }
    timeout_out = Channel(String).new(4)
    timeout_task = spawn {
      timeout_round(quiet_port, timeout_out)
    }
    before_kb = peak_rss_kb()
    queue_task = spawn {
      r = queue_round(port, out, root, stamp)
      done.send(1)
      r
    }
    idle_task = spawn {
      idle_out.send(raw_client(port, root, stamp, "idle", ""))
      done.send(1)
      0
    }
    stopper = spawn {
      got = 0
      while got < 2 {
        if d = done.recv() {
          got += d
        }
      }
      stop(port)
      0
    }
    server.serve()
    if q = quiet {
      q.close()
    }
    c.eq_int(queue_task.join() ?? -1, 0, "output-queue task")
    c.eq_int(idle_task.join() ?? -1, 0, "idle-timeout task")
    c.eq_int(stopper.join() ?? -1, 0, "stopper task")
    c.eq_int(timeout_task.join() ?? -1, 0, "client-deadline task")
    twant: Array(String) = []
    twant.push("get=timed out in time")
    twant.push("post=timed out in time")
    twant.push("ws=timed out in time")
    expect_lines(c, timeout_out, twant, "the client's timeout_ms is a deadline for the whole call:")
    want: Array(String) = []
    want.push("slow_big=whole,then pong")
    want.push("pile=65 whole,in order")
    want.push("close_big=whole,then eof")
    want.push("half_close=2 whole,then eof")
    want.push("flood=held back")
    expect_lines(c, out, want, "an answer the socket takes in part is queued, not cut:")
    hit = flood_hits.with (n) { n }
    c.expect(hit > 0 && hit < 2000, "a client that reads nothing is served a bounded number of requests")
    c.expect(before_kb > 0 && peak_rss_kb() - before_kb < 65536, "a client that reads nothing does not grow the server's memory")
    idle_want: Array(String) = []
    idle_want.push("idle=idle closed,busy alive")
    expect_lines(c, idle_out, idle_want, "idle and stalled connections are closed, a busy one is not:")
  } else {
    c.expect(false, "listen for the output-queue and idle-timeout test")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_std_http_safety(c, avant_test_root())
  client_cases(c)
  ws_route_cases(c)
  route_serving_cases(c, avant_test_root())
  header_split_cases(c, avant_test_root())
  handler_trap_cases(c, avant_test_root())
  response_literal_cases(c)
  client_framing_cases(c, avant_test_root())
  client_request_cases(c, avant_test_root())
  client_length_cases(c, avant_test_root())
  client_interim_cases(c, avant_test_root())
  ws_big_cases(c, avant_test_root())
  write_piece_cases(c)
  deadline_cases(c, avant_test_root())
  limit_cases(c, avant_test_root())
  ws_handshake_cases(c, avant_test_root())
  ws_deadline_cases(c, avant_test_root())
  ws_cut_cases(c, avant_test_root())
  emfile_cases(c, avant_test_root())
  c.finish()
}
