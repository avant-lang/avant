import harness

// D127: one private scratch directory per process, nested through TMPDIR,
// removed at exit and on SIGINT, SIGTERM, and SIGHUP, kept by AVANT_KEEP_TMP.

fn scratch_child_src: String {
  b = buf_new()
  b.push_str("lib rt {\n  fun avant_tmp_dir: String\n}\n")
  b.push_str("fn main: Int {\n")
  b.push_str("  d = rt.avant_tmp_dir()\n")
  b.push_str("  dummy = file_write(\"\${d}/payload.txt\", \"x\")\n")
  b.push_str("  puts(d)\n")
  b.push_str("  mode = \"\"\n")
  b.push_str("  if v = env_get(\"SCRATCH_MODE\") {\n    mode = v\n  }\n")
  b.push_str("  if mode == \"fail\" {\n    return 3\n  }\n")
  // wait: block in a child (D131 forwards the signal to it), the child's
  // pid recorded next to the directory path so the test can check it.
  b.push_str("  if mode == \"wait\" {\n")
  b.push_str("    if out = env_get(\"SCRATCH_OUT\") {\n")
  b.push_str("      args: Array(String) = []\n")
  b.push_str("      args.push(\"-c\")\n")
  b.push_str("      args.push(\"echo $$ > \${out}.pid; exec sleep 30\")\n")
  b.push_str("      dummy2 = file_write(out, d)\n")
  b.push_str("      dummy3 = process_run(\"/bin/sh\", args)\n")
  b.push_str("    }\n")
  b.push_str("  }\n")
  b.push_str("  0\n")
  b.push_str("}\n")
  b.to_s
}

// The child's path line. A kept top-level directory's notice is written
// at exit, ahead of buffered stdout, so the path is the line starting "/".
fn first_line(path: String): String {
  if text = file_read(path) {
    n = count_lines(text)
    for i in 0..n {
      line = nth_line(text, i).strip()
      if line.size > 0 && line[0] == 47 {
        return line
      }
    }
  }
  ""
}

fn read_all(path: String): String {
  if text = file_read(path) {
    return text.strip()
  }
  ""
}

fn path_base(p: String): String {
  i = p.size - 1
  while i >= 0 {
    if p[i] == 47 {
      return str_slice(p, i + 1, p.size)
    }
    i -= 1
  }
  p
}

// Children start with keep off, so this file also passes under --keep-tmp;
// a test that wants keep passes AVANT_KEEP_TMP=1 after it.
fn run_env(env: Array(String), bin: String, log: String): Int {
  args: Array(String) = []
  args.push("AVANT_KEEP_TMP=")
  i = 0
  while i < env.size {
    args.push(env[i])
    i += 1
  }
  args.push(bin)
  process_run_out("/usr/bin/env", args, log) ?? -1
}

fn run_signalled(sig: String, bin: String, out: String, log: String): Int {
  args: Array(String) = []
  args.push("--preserve-status")
  args.push("-s")
  args.push(sig)
  args.push("1")
  // A test binary may start with SIGINT ignored (an asynchronous job of
  // sh), and an ignored signal is deliberately left ignored.
  args.push("/usr/bin/env")
  args.push("--default-signal=${sig}")
  args.push("AVANT_KEEP_TMP=")
  args.push("SCRATCH_MODE=wait")
  args.push("SCRATCH_OUT=${out}")
  args.push(bin)
  process_run_out("/usr/bin/timeout", args, log) ?? -1
}

fn test_scratch(c: Checks) {
  c.suite("tests/cases/test_scratch.av")
  root = scratch()
  c.eq_str(scratch(), root, "one directory per process")
  c.expect(str_has(path_base(root), "avant-"), "named avant-XXXXXX")
  c.eq_int(path_base(root).size, 12, "mkdtemp suffix")
  c.expect(file_exists(root), "directory exists")
  c.expect(file_exists("${root}/.avant-scratch"), "nesting marker")
  if t = env_get("TMPDIR") {
    c.eq_str(t, root, "TMPDIR exported to children")
  } else {
    c.expect(false, "TMPDIR exported to children")
  }
  d1 = scratch_dir()
  d2 = scratch_dir()
  c.expect(d1 != d2, "fresh directories differ")
  c.expect(file_exists(d1) && file_exists(d2), "fresh directories exist")
  c.expect(str_has(d1, "${root}/"), "fresh directory inside scratch")

  if compiler = env_get("AVANT_COMPILER") {
    work = scratch_dir()
    src = "${work}/child.av"
    _ = file_write(src, scratch_child_src())
    bin = "${work}/child.bin"
    code = compile_av(compiler, src, bin, "${work}/child.clog")
    c.eq_int(code, 0, "child compiles")
    chmod_x(bin)

    none: Array(String) = []
    ok_log = "${work}/ok.log"
    ok_code = run_env(none, bin, ok_log)
    ok_dir = first_line(ok_log)
    c.eq_int(ok_code, 0, "child exits 0")
    c.expect(str_has(ok_dir, "${root}/avant-"), "child nests inside parent")
    c.expect(!file_exists(ok_dir), "removed at normal exit")

    fail_env: Array(String) = []
    fail_env.push("SCRATCH_MODE=fail")
    fail_log = "${work}/fail.log"
    fail_code = run_env(fail_env, bin, fail_log)
    fail_dir = first_line(fail_log)
    c.eq_int(fail_code, 3, "error exit status kept")
    c.expect(fail_dir.size > 0 && !file_exists(fail_dir), "removed at error exit")

    sigs: Array(String) = []
    sigs.push("TERM")
    sigs.push("INT")
    sigs.push("HUP")
    want: Array(Int) = []
    want.push(143)
    want.push(130)
    want.push(129)
    k = 0
    while k < sigs.size {
      out = "${work}/sig-${sigs[k]}.path"
      sig_code = run_signalled(sigs[k], bin, out, "${work}/sig-${sigs[k]}.log")
      sig_dir = read_all(out)
      c.eq_int(sig_code, want[k], "SIG${sigs[k]} status kept")
      c.expect(sig_dir.size > 0 && !file_exists(sig_dir), "removed on SIG${sigs[k]}")
      child_pid = read_all("${out}.pid")
      gone_args: Array(String) = []
      gone_args.push("-c")
      gone_args.push("s=$(ps -o stat= -p ${child_pid} 2>/dev/null); case \"$s\" in ''|Z*) exit 0 ;; *) exit 1 ;; esac")
      c.expect(child_pid.size > 0, "SIG${sigs[k]} child recorded its pid")
      c.eq_int((process_run("/bin/sh", gone_args) ?? -1), 0, "SIG${sigs[k]} reaches the blocking child")
      k += 1
    }

    keep_env: Array(String) = []
    keep_env.push("AVANT_KEEP_TMP=1")
    keep_log = "${work}/keep.log"
    keep_code = run_env(keep_env, bin, keep_log)
    c.eq_int(keep_code, 0, "kept child exits 0")
    keep_dir = first_line(keep_log)
    c.expect(file_exists("${keep_dir}/payload.txt"), "AVANT_KEEP_TMP keeps the directory")
    keep_text = read_all(keep_log)
    c.expect(!str_has(keep_text, "kept temporary directory"), "nested keep is silent")

    top = scratch_dir()
    top_env: Array(String) = []
    top_env.push("AVANT_KEEP_TMP=1")
    top_env.push("TMPDIR=${top}")
    top_log = "${work}/top.log"
    top_code = run_env(top_env, bin, top_log)
    c.eq_int(top_code, 0, "top-level kept child exits 0")
    top_dir = first_line(top_log)
    c.expect(str_has(top_dir, "${top}/avant-"), "TMPDIR is the base")
    c.expect(file_exists(top_dir), "top-level keep keeps")
    c.expect(str_has(read_all(top_log), "avant: kept temporary directory ${top_dir}"), "top-level keep prints the path")

    std_src = "${work}/std_temp.av"
    std_body = "import std.testing\nfn main: Int {\n  t = Test.new\n  a = t.temp_dir\n  b = t.temp_dir\n  puts(a)\n  t.check(a != b, \"fresh per call\")\n  t.check(file_exists(a) && file_exists(b), \"created\")\n  t.check((file_write(\"\${a}/x.txt\", \"x\") ?? -1) == 1, \"writable\")\n  t.finish\n}\n"
    _ = file_write(std_src, std_body)
    std_bin = "${work}/std_temp.bin"
    std_code = compile_av(compiler, std_src, std_bin, "${work}/std_temp.clog")
    c.eq_int(std_code, 0, "std.testing temp_dir program compiles")
    chmod_x(std_bin)
    std_log = "${work}/std_temp.log"
    std_run = run_env(none, std_bin, std_log)
    std_text = read_all(std_log)
    c.eq_int(std_run, 0, "t.temp_dir checks pass")
    c.expect(str_has(std_text, "0 failed, 3 passed"), "t.temp_dir program reports its checks")
    std_dir = first_line(std_log)
    c.expect(str_has(std_dir, "${root}/avant-"), "t.temp_dir nests in the scratch directory")
    c.expect(std_dir.size > 0 && !file_exists(std_dir), "t.temp_dir removed at exit")

    // Q146/D131: an interrupted avant test stops its jobs and leaves nothing.
    proj = scratch_dir()
    mkdir_p("${proj}/tests")
    // Its own avant.toml (O116, Stage 29 W1b): with TMPDIR inside a
    // checkout, the runner's walk up from proj would find the checkout's.
    _ = file_write("${proj}/avant.toml", "[package]\nname = \"slow\"\nversion = \"0.1.0\"\n")
    // The job's sleep records its own pid (exec keeps it), so the check
    // looks at exactly that process.
    job_body = "fn main: Int {\n  args: Array(String) = []\n  args.push(\"-c\")\n  args.push(\"echo $$ > ${proj}/sleep.pid; echo 1 > ${proj}/started; exec sleep 30\")\n  dummy = process_run(\"/bin/sh\", args)\n  0\n}\n"
    _ = file_write("${proj}/tests/test_slow.av", job_body)
    abs_c = compiler_abs("scratch", compiler)
    isigs: Array(String) = []
    isigs.push("TERM")
    isigs.push("INT")
    iwant: Array(Int) = []
    iwant.push(143)
    iwant.push(130)
    q = 0
    while q < isigs.size {
      sig = isigs[q]
      base_dir = scratch_dir()
      rc = "${work}/int-${sig}.rc"
      script = "#!/bin/sh\ncd '${proj}' || exit 9\nrm -f started sleep.pid\nAVANT_KEEP_TMP= TMPDIR='${base_dir}' env --default-signal=${sig} '${abs_c}' test --jobs 2 > '${work}/int-${sig}.log' 2>&1 &\nr=$!\nn=0\nwhile [ ! -f started ] && [ $n -lt 600 ]; do sleep 0.05; n=$((n+1)); done\nkill -${sig} $r\nwait $r\necho $? > '${rc}'\n"
      sh_path = "${work}/int-${sig}.sh"
      _ = file_write(sh_path, script)
      sh_args: Array(String) = []
      sh_args.push(sh_path)
      _ = process_run("/bin/sh", sh_args)
      c.eq_int(nth_line(read_all(rc), 0).to_i ?? -1, iwant[q], "interrupted runner (SIG${sig}) exits ${iwant[q]}")
      // Gone, or a zombie about to be reaped, means stopped.
      spid = read_all("${proj}/sleep.pid")
      st_args: Array(String) = []
      st_args.push("-c")
      st_args.push("s=$(ps -o stat= -p ${spid} 2>/dev/null); case \"$s\" in ''|Z*) exit 0 ;; *) exit 1 ;; esac")
      stopped = process_run("/bin/sh", st_args) ?? -1
      c.expect(spid.size > 0, "SIG${sig} job recorded its sleep")
      c.eq_int(stopped, 0, "SIG${sig} stops the runner's jobs")
      left = dir_list(base_dir) ?? empty_strs()
      c.eq_int(left.size, 0, "SIG${sig} leaves nothing in TMPDIR")
      q += 1
    }

    unset_args: Array(String) = []
    unset_args.push("-u")
    unset_args.push("TMPDIR")
    unset_args.push("AVANT_KEEP_TMP=")
    unset_args.push(bin)
    unset_log = "${work}/unset.log"
    unset_code = process_run_out("/usr/bin/env", unset_args, unset_log) ?? -1
    unset_dir = first_line(unset_log)
    c.eq_int(unset_code, 0, "no TMPDIR exits 0")

    // O35 (Stage 29 W1b): a program that crashes after creating its
    // private directory (a compiler crash is the same runtime path) dies
    // by the signal and leaves nothing in TMPDIR.
    crash_src = "${work}/crash.av"
    _ = file_write(crash_src, "lib crash_c {\n  fun avant_tmp_dir: String\n  fun raise(sig: Int32): Int32\n  fun abort\n}\nfn main {\n  puts(crash_c.avant_tmp_dir())\n  if v = env_get(\"CRASH_SIG\") {\n    if v == \"abort\" {\n      crash_c.abort()\n    }\n    if v == \"pipe\" {\n      while true {\n        puts(\"more\")\n      }\n    }\n    puts(crash_c.raise((v.to_i ?? 0).to_i32))\n  }\n}\n")
    crash_bin = "${work}/crash.bin"
    c.eq_int(compile_av(compiler, crash_src, crash_bin, "${work}/crash.clog"), 0, "crash program compiles")
    crashes = ["11", "7", "8", "abort"]
    crash_names = ["SIGSEGV", "SIGBUS", "SIGFPE", "SIGABRT"]
    crash_codes = [139, 135, 136, 134]
    q = 0
    while q < crashes.size {
      cbase = "${work}/crash-base-${q}"
      mkdir_p(cbase)
      crc = "${work}/crash-${q}.rc"
      csh = "${work}/crash-${q}.sh"
      _ = file_write(csh, "#!/bin/sh\nAVANT_KEEP_TMP= TMPDIR='${cbase}' CRASH_SIG=${crashes[q]} '${crash_bin}' > '${work}/crash-${q}.log' 2>&1\necho $? > '${crc}'\n")
      ch_args: Array(String) = []
      ch_args.push(csh)
      _ = process_run("/bin/sh", ch_args)
      c.eq_int(nth_line(read_all(crc), 0).to_i ?? -1, crash_codes[q], "a program killed by ${crash_names[q]} still dies by it")
      cleft = dir_list(cbase) ?? empty_strs()
      c.eq_int(cleft.size, 0, "${crash_names[q]} leaves nothing in TMPDIR")
      q += 1
    }

    // O521 (Stage 29 W-FIX1e): a program whose standard output is a pipe
    // its reader closed (`prog | head`) dies by SIGPIPE, and SIGPIPE was
    // not among the signals that remove the directory. The program, then
    // `avant test` itself, each cut by `head -c 1`.
    pbase = "${work}/pipe-base"
    mkdir_p(pbase)
    prc = "${work}/pipe.rc"
    psh = "${work}/pipe.sh"
    _ = file_write(psh, "#!/bin/sh\n(AVANT_KEEP_TMP= TMPDIR='${pbase}' CRASH_SIG=pipe '${crash_bin}' 2> '${work}/pipe.log'; echo $? > '${prc}') | head -c 1 > /dev/null\n")
    p_args: Array(String) = []
    p_args.push(psh)
    _ = process_run("/bin/sh", p_args)
    c.eq_int(nth_line(read_all(prc), 0).to_i ?? -1, 141, "a program cut by a closed pipe still dies by SIGPIPE")
    pleft = dir_list(pbase) ?? empty_strs()
    c.eq_int(pleft.size, 0, "SIGPIPE leaves nothing in TMPDIR")
    loud = scratch_dir()
    mkdir_p("${loud}/tests")
    _ = file_write("${loud}/avant.toml", "[package]\nname = \"loud\"\nversion = \"0.1.0\"\n")
    _ = file_write("${loud}/tests/test_loud.av", "import std.testing\n\nfn main: Int {\n  t = Test.new\n  for i in 0..5000 {\n    t.check(true, \"one of 5000 checks whose output fills the pipe\")\n  }\n  t.finish\n}\n")
    rbase = "${work}/pipe-runner-base"
    mkdir_p(rbase)
    rrc = "${work}/pipe-runner.rc"
    rsh = "${work}/pipe-runner.sh"
    _ = file_write(rsh, "#!/bin/sh\ncd '${loud}' || exit 9\n(AVANT_KEEP_TMP= TMPDIR='${rbase}' '${abs_c}' test 2> '${work}/pipe-runner.log'; echo $? > '${rrc}') | head -c 1 > /dev/null\n")
    r_args: Array(String) = []
    r_args.push(rsh)
    _ = process_run("/bin/sh", r_args)
    c.eq_int(nth_line(read_all(rrc), 0).to_i ?? -1, 141, "avant test cut by a closed pipe dies by SIGPIPE")
    rleft = dir_list(rbase) ?? empty_strs()
    c.eq_int(rleft.size, 0, "avant test cut by a closed pipe leaves nothing in TMPDIR")
    c.expect(str_has(unset_dir, "/tmp/avant-"), "no TMPDIR falls back to /tmp")
    c.expect(!file_exists(unset_dir), "fallback directory removed")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_scratch(c)
  c.finish
}
