import harness
import std.fs
import std.process

// One private scratch directory per process, nested through TMPDIR,
// removed at exit and on SIGINT, SIGTERM, and SIGHUP, kept by AVANT_KEEP_TMP.

fn scratch_child_src: String {
  b = Buf.new()
  b.push_str("lib rt {\n  fun avant_tmp_dir: String\n}\n")
  b.push_str("fn main: Int {\n")
  b.push_str("  d = rt.avant_tmp_dir()\n")
  b.push_str("  dummy = fs.write(\"\${d}/payload.txt\", \"x\")\n")
  b.push_str("  puts(d)\n")
  b.push_str("  mode = \"\"\n")
  b.push_str("  if v = process.env(\"SCRATCH_MODE\") {\n    mode = v\n  }\n")
  b.push_str("  if mode == \"fail\" {\n    return 3\n  }\n")
  // wait: block in a child (an interrupted test forwards the signal to it), the child's
  // pid recorded next to the directory path so the test can check it.
  b.push_str("  if mode == \"wait\" {\n")
  b.push_str("    if out = process.env(\"SCRATCH_OUT\") {\n")
  b.push_str("      args: Array(String) = []\n")
  b.push_str("      args.push(\"-c\")\n")
  b.push_str("      args.push(\"echo $$ > \${out}.pid; exec sleep 30\")\n")
  b.push_str("      dummy2 = fs.write(out, d)\n")
  b.push_str("      dummy3 = process.run(\"/bin/sh\", args)\n")
  b.push_str("    }\n")
  b.push_str("  }\n")
  b.push_str("  0\n")
  b.push_str("}\n")
  b.push_str("import std.fs\nimport std.process\n")
  b.to_s()
}

// The child's path line. A kept top-level directory's notice is written
// at exit, ahead of buffered stdout, so the path is the line starting "/".
fn first_line(path: String): String {
  if text = fs.read(path) {
    n = count_lines(text)
    for i in 0..n {
      line = nth_line(text, i).strip()
      if line.size > 0 && line[0] == 47 {
        return line
      }
    }
  }
  ""
}

// A script run under timeout: timeout signals its
// whole process group, the script's pipeline included, so a child that
// loops is stopped and its check fails instead of hanging the suite. The
// script's own `$?` reports a child's signal as 128 + n (timeout's own
// status would not: it cannot re-raise a signal its parent ignored).
fn bounded_sh(script: String, secs: String): Array(String) {
  args: Array(String) = []
  args.push("-k")
  args.push("5")
  args.push(secs)
  args.push("/bin/sh")
  args.push(script)
  args
}

fn read_all(path: String): String {
  if text = fs.read(path) {
    return text.strip()
  }
  ""
}

fn path_base(p: String): String {
  i = p.size - 1
  while i >= 0 {
    if p[i] == 47 {
      return p[i + 1..]
    }
    i -= 1
  }
  p
}

// Children start with keep off, so this file also passes under --keep-tmp;
// a test that wants keep passes AVANT_KEEP_TMP=1 after it.
fn run_env(env: Array(String), bin: String, log: String): Int {
  args: Array(String) = []
  args.push("AVANT_KEEP_TMP=")
  args.concat(env)
  args.push(bin)
  run_out("/usr/bin/env", args, log) ?? -1
}

fn run_signalled(sig: String, bin: String, out: String, log: String): Int {
  // The signal is sent once the child has recorded its blocking child's
  // pid (at most 30 s later), not after a fixed second: on a loaded
  // machine the program had sometimes not started that child yet, and
  // the checks below found no pid. A test binary may start with SIGINT
  // ignored (an asynchronous job of sh), and an ignored signal is
  // deliberately left ignored: env restores the default.
  args: Array(String) = []
  args.push("-c")
  args.push("rm -f '${out}.pid'; /usr/bin/env --default-signal=${sig} AVANT_KEEP_TMP= SCRATCH_MODE=wait SCRATCH_OUT='${out}' '${bin}' & r=$!; n=0; while [ ! -s '${out}.pid' ] && [ $n -lt 600 ]; do sleep 0.05; n=$((n+1)); done; kill -${sig} $r; wait $r")
  run_out("/bin/sh", args, log) ?? -1
}

fn test_scratch(c: Checks) {
  c.suite("tests/cases/test_scratch.av")
  root = scratch()
  c.eq_str(scratch(), root, "one directory per process")
  c.expect(path_base(root).contains("avant-"), "named avant-XXXXXX")
  c.eq_int(path_base(root).size, 12, "mkdtemp suffix")
  c.expect(fs.exists(root), "directory exists")
  c.expect(fs.exists("${root}/.avant-scratch"), "nesting marker")
  if t = process.env("TMPDIR") {
    c.eq_str(t, root, "TMPDIR exported to children")
  } else {
    c.expect(false, "TMPDIR exported to children")
  }
  d1 = scratch_dir()
  d2 = scratch_dir()
  c.expect(d1 != d2, "fresh directories differ")
  c.expect(fs.exists(d1) && fs.exists(d2), "fresh directories exist")
  c.expect(d1.contains("${root}/"), "fresh directory inside scratch")

  if compiler = process.env("AVANT_COMPILER") {
    work = scratch_dir()
    src = "${work}/child.av"
    _ = fs.write(src, scratch_child_src())
    bin = "${work}/child.bin"
    code = compile_av(compiler, src, bin, "${work}/child.clog")
    c.eq_int(code, 0, "child compiles")
    chmod_x(bin)

    none: Array(String) = []
    ok_log = "${work}/ok.log"
    ok_code = run_env(none, bin, ok_log)
    ok_dir = first_line(ok_log)
    c.eq_int(ok_code, 0, "child exits 0")
    c.expect(ok_dir.contains("${root}/avant-"), "child nests inside parent")
    c.expect(!fs.exists(ok_dir), "removed at normal exit")

    fail_env: Array(String) = []
    fail_env.push("SCRATCH_MODE=fail")
    fail_log = "${work}/fail.log"
    fail_code = run_env(fail_env, bin, fail_log)
    fail_dir = first_line(fail_log)
    c.eq_int(fail_code, 3, "error exit status kept")
    c.expect(fail_dir.size > 0 && !fs.exists(fail_dir), "removed at error exit")

    sigs: Array(String) = []
    sigs.push("TERM")
    sigs.push("INT")
    sigs.push("HUP")
    want: Array(Int) = []
    want.push(143)
    want.push(130)
    want.push(129)
    k = 0
    while k < sigs.size {
      out = "${work}/sig-${sigs[k]}.path"
      sig_code = run_signalled(sigs[k], bin, out, "${work}/sig-${sigs[k]}.log")
      sig_dir = read_all(out)
      c.eq_int(sig_code, want[k], "SIG${sigs[k]} status kept")
      c.expect(sig_dir.size > 0 && !fs.exists(sig_dir), "removed on SIG${sigs[k]}")
      child_pid = read_all("${out}.pid")
      gone_args: Array(String) = []
      gone_args.push("-c")
      gone_args.push("s=$(ps -o stat= -p ${child_pid} 2>/dev/null); case \"$s\" in ''|Z*) exit 0 ;; *) exit 1 ;; esac")
      c.expect(child_pid.size > 0, "SIG${sigs[k]} child recorded its pid")
      c.eq_int((process.run("/bin/sh", gone_args) ?? -1), 0, "SIG${sigs[k]} reaches the blocking child")
      k += 1
    }

    keep_env: Array(String) = []
    keep_env.push("AVANT_KEEP_TMP=1")
    keep_log = "${work}/keep.log"
    keep_code = run_env(keep_env, bin, keep_log)
    c.eq_int(keep_code, 0, "kept child exits 0")
    keep_dir = first_line(keep_log)
    c.expect(fs.exists("${keep_dir}/payload.txt"), "AVANT_KEEP_TMP keeps the directory")
    keep_text = read_all(keep_log)
    c.expect(!keep_text.contains("kept temporary directory"), "nested keep is silent")

    top = scratch_dir()
    top_env: Array(String) = []
    top_env.push("AVANT_KEEP_TMP=1")
    top_env.push("TMPDIR=${top}")
    top_log = "${work}/top.log"
    top_code = run_env(top_env, bin, top_log)
    c.eq_int(top_code, 0, "top-level kept child exits 0")
    top_dir = first_line(top_log)
    c.expect(top_dir.contains("${top}/avant-"), "TMPDIR is the base")
    c.expect(fs.exists(top_dir), "top-level keep keeps")
    c.expect(read_all(top_log).contains("avant: kept temporary directory ${top_dir}"), "top-level keep prints the path")

    std_src = "${work}/std_temp.av"
    std_body = "import std.testing\nfn main: Int {\n  t = testing.Test.new()\n  a = t.temp_dir()\n  b = t.temp_dir()\n  puts(a)\n  t.check(a != b, \"fresh per call\")\n  t.check(fs.exists(a) && fs.exists(b), \"created\")\n  t.check((fs.write(\"\${a}/x.txt\", \"x\") ?? -1) == 1, \"writable\")\n  t.finish()\n}\nimport std.fs\n"
    _ = fs.write(std_src, std_body)
    std_bin = "${work}/std_temp.bin"
    std_code = compile_av(compiler, std_src, std_bin, "${work}/std_temp.clog")
    c.eq_int(std_code, 0, "std.testing temp_dir program compiles")
    chmod_x(std_bin)
    std_log = "${work}/std_temp.log"
    std_run = run_env(none, std_bin, std_log)
    std_text = read_all(std_log)
    c.eq_int(std_run, 0, "t.temp_dir checks pass")
    c.expect(std_text.contains("0 failed, 3 passed"), "t.temp_dir program reports its checks")
    std_dir = first_line(std_log)
    c.expect(std_dir.contains("${root}/avant-"), "t.temp_dir nests in the scratch directory")
    c.expect(std_dir.size > 0 && !fs.exists(std_dir), "t.temp_dir removed at exit")

    // An interrupted avant test stops its jobs and leaves nothing.
    proj = scratch_dir()
    mkdir_p("${proj}/tests")
    // Its own avant.toml: with TMPDIR inside a
    // checkout, the runner's walk up from proj would find the checkout's.
    _ = fs.write("${proj}/avant.toml", "[package]\nname = \"slow\"\nversion = \"0.1.0\"\n")
    // The job's sleep records its own pid (exec keeps it), so the check
    // looks at exactly that process.
    job_body = "fn main: Int {\n  args: Array(String) = []\n  args.push(\"-c\")\n  args.push(\"echo $$ > ${proj}/sleep.pid; echo 1 > ${proj}/started; exec sleep 30\")\n  dummy = process.run(\"/bin/sh\", args)\n  0\n}\nimport std.process\n"
    _ = fs.write("${proj}/tests/test_slow.av", job_body)
    abs_c = compiler_abs("scratch", compiler)
    isigs: Array(String) = []
    isigs.push("TERM")
    isigs.push("INT")
    iwant: Array(Int) = []
    iwant.push(143)
    iwant.push(130)
    for q, sig in isigs {
      base_dir = scratch_dir()
      rc = "${work}/int-${sig}.rc"
      script = "#!/bin/sh\ncd '${proj}' || exit 9\nrm -f started sleep.pid\nAVANT_KEEP_TMP= TMPDIR='${base_dir}' env --default-signal=${sig} '${abs_c}' test --jobs 2 > '${work}/int-${sig}.log' 2>&1 &\nr=$!\nn=0\nwhile [ ! -f started ] && [ $n -lt 600 ]; do sleep 0.05; n=$((n+1)); done\nkill -${sig} $r\nwait $r\necho $? > '${rc}'\n"
      sh_path = "${work}/int-${sig}.sh"
      _ = fs.write(sh_path, script)
      sh_args: Array(String) = []
      sh_args.push(sh_path)
      _ = process.run("/bin/sh", sh_args)
      c.eq_int(nth_line(read_all(rc), 0).to_i() ?? -1, iwant[q], "interrupted runner (SIG${sig}) exits ${iwant[q]}")
      // Gone, or a zombie about to be reaped, means stopped.
      spid = read_all("${proj}/sleep.pid")
      st_args: Array(String) = []
      st_args.push("-c")
      st_args.push("s=$(ps -o stat= -p ${spid} 2>/dev/null); case \"$s\" in ''|Z*) exit 0 ;; *) exit 1 ;; esac")
      stopped = process.run("/bin/sh", st_args) ?? -1
      c.expect(spid.size > 0, "SIG${sig} job recorded its sleep")
      c.eq_int(stopped, 0, "SIG${sig} stops the runner's jobs")
      left = fs.list(base_dir) ?? empty_strs()
      c.eq_int(left.size, 0, "SIG${sig} leaves nothing in TMPDIR")
    }

    unset_args: Array(String) = []
    unset_args.push("-u")
    unset_args.push("TMPDIR")
    unset_args.push("AVANT_KEEP_TMP=")
    unset_args.push(bin)
    unset_log = "${work}/unset.log"
    unset_code = run_out("/usr/bin/env", unset_args, unset_log) ?? -1
    unset_dir = first_line(unset_log)
    c.eq_int(unset_code, 0, "no TMPDIR exits 0")

    // A program that crashes after creating its
    // private directory (a compiler crash is the same runtime path) dies
    // by the signal and leaves nothing in TMPDIR.
    crash_src = "${work}/crash.av"
    _ = fs.write(crash_src, "lib crash_c {\n  fun avant_tmp_dir: String\n  fun raise(sig: Int32): Int32\n  fun abort\n}\nfn main {\n  puts(crash_c.avant_tmp_dir())\n  if v = process.env(\"CRASH_SIG\") {\n    if v == \"abort\" {\n      crash_c.abort()\n    }\n    if v == \"pipe\" {\n      while true {\n        puts(\"more\")\n      }\n    }\n    puts(crash_c.raise((v.to_i() ?? 0).to_i32()))\n  }\n}\nimport std.process\n")
    crash_bin = "${work}/crash.bin"
    c.eq_int(compile_av(compiler, crash_src, crash_bin, "${work}/crash.clog"), 0, "crash program compiles")
    crashes = ["11", "7", "8", "abort"]
    crash_names = ["SIGSEGV", "SIGBUS", "SIGFPE", "SIGABRT"]
    crash_codes = [139, 135, 136, 134]
    q = 0
    while q < crashes.size {
      cbase = "${work}/crash-base-${q}"
      mkdir_p(cbase)
      crc = "${work}/crash-${q}.rc"
      csh = "${work}/crash-${q}.sh"
      _ = fs.write(csh, "#!/bin/sh\nAVANT_KEEP_TMP= TMPDIR='${cbase}' CRASH_SIG=${crashes[q]} '${crash_bin}' > '${work}/crash-${q}.log' 2>&1\necho $? > '${crc}'\n")
      _ = process.run("/usr/bin/timeout", bounded_sh(csh, "60"))
      c.eq_int(nth_line(read_all(crc), 0).to_i() ?? -1, crash_codes[q], "a program killed by ${crash_names[q]} still dies by it")
      cleft = fs.list(cbase) ?? empty_strs()
      c.eq_int(cleft.size, 0, "${crash_names[q]} leaves nothing in TMPDIR")
      q += 1
    }

    // A program whose standard output is a pipe
    // its reader closed (`prog | head`) dies by SIGPIPE, and SIGPIPE was
    // not among the signals that remove the directory. The program, then
    // `avant test` itself, each cut by `head -c 1`.
    pbase = "${work}/pipe-base"
    mkdir_p(pbase)
    prc = "${work}/pipe.rc"
    psh = "${work}/pipe.sh"
    // Each run also starts with SIGPIPE ignored, as a
    // CI runner starts its jobs (sh passes an ignored signal on). The
    // runtime resets it to the default before main, so the program still
    // dies by it; before, the loop wrote to the closed pipe forever. Every
    // run is bounded (bounded_sh), so a regression fails instead of
    // hanging the suite.
    pipe_modes = ["", "trap '' PIPE\n"]
    pipe_names = ["", " (SIGPIPE ignored by the parent)"]
    pm = 0
    while pm < pipe_modes.size {
      pbase = "${work}/pipe-base-${pm}"
      mkdir_p(pbase)
      prc = "${work}/pipe-${pm}.rc"
      psh = "${work}/pipe-${pm}.sh"
      _ = fs.write(psh, "#!/bin/sh\n${pipe_modes[pm]}(AVANT_KEEP_TMP= TMPDIR='${pbase}' CRASH_SIG=pipe '${crash_bin}' 2> '${work}/pipe-${pm}.log'; echo $? > '${prc}') | head -c 1 > /dev/null\n")
      _ = process.run("/usr/bin/timeout", bounded_sh(psh, "60"))
      c.eq_int(nth_line(read_all(prc), 0).to_i() ?? -1, 141, "a program cut by a closed pipe still dies by SIGPIPE${pipe_names[pm]}")
      pleft = fs.list(pbase) ?? empty_strs()
      c.eq_int(pleft.size, 0, "SIGPIPE leaves nothing in TMPDIR${pipe_names[pm]}")
      pm += 1
    }
    loud = scratch_dir()
    mkdir_p("${loud}/tests")
    _ = fs.write("${loud}/avant.toml", "[package]\nname = \"loud\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${loud}/tests/test_loud.av", "import std.testing\n\nfn main: Int {\n  t = testing.Test.new()\n  for i in 0..5000 {\n    t.check(true, \"one of 5000 checks whose output fills the pipe\")\n  }\n  t.finish()\n}\n")
    pm = 0
    while pm < pipe_modes.size {
      rbase = "${work}/pipe-runner-base-${pm}"
      mkdir_p(rbase)
      rrc = "${work}/pipe-runner-${pm}.rc"
      rsh = "${work}/pipe-runner-${pm}.sh"
      _ = fs.write(rsh, "#!/bin/sh\ncd '${loud}' || exit 9\n${pipe_modes[pm]}(AVANT_KEEP_TMP= TMPDIR='${rbase}' '${abs_c}' test 2> '${work}/pipe-runner-${pm}.log'; echo $? > '${rrc}') | head -c 1 > /dev/null\n")
      _ = process.run("/usr/bin/timeout", bounded_sh(rsh, "300"))
      c.eq_int(nth_line(read_all(rrc), 0).to_i() ?? -1, 141, "avant test cut by a closed pipe dies by SIGPIPE${pipe_names[pm]}")
      rleft = fs.list(rbase) ?? empty_strs()
      c.eq_int(rleft.size, 0, "avant test cut by a closed pipe leaves nothing in TMPDIR${pipe_names[pm]}")
      pm += 1
    }

    // A write to standard output that fails (here
    // /dev/full, ENOSPC) is never silent: puts of a String, a Float64 or
    // a Bool stops the program at once, and a failed write left in the
    // buffer (an integer's puts) is found at exit; each names the stream
    // and the reason on stderr, exits 1 and removes the private directory.
    // The String loop ended only by the check: bounded, as above.
    full_src = "${work}/full.av"
    _ = fs.write(full_src, "lib full_c {\n  fun avant_tmp_dir: String\n}\nfn main {\n  _ = full_c.avant_tmp_dir()\n  v = process.env(\"FULL\") ?? \"\"\n  if v == \"loop\" {\n    while true {\n      puts(\"more\")\n    }\n  }\n  if v == \"float\" {\n    puts(1.5)\n  }\n  if v == \"bool\" {\n    puts(true)\n  }\n  if v == \"int\" {\n    puts(7)\n  }\n  puts(\"done\")\n}\nimport std.process\n")
    full_bin = "${work}/full.bin"
    c.eq_int(compile_av(compiler, full_src, full_bin, "${work}/full.clog"), 0, "the /dev/full program compiles")
    fulls = ["loop", "float", "bool", "int", "str"]
    fq = 0
    while fq < fulls.size {
      fbase = "${work}/full-base-${fq}"
      mkdir_p(fbase)
      frc = "${work}/full-${fq}.rc"
      fsh = "${work}/full-${fq}.sh"
      flog = "${work}/full-${fq}.log"
      _ = fs.write(fsh, "#!/bin/sh\nAVANT_KEEP_TMP= TMPDIR='${fbase}' FULL=${fulls[fq]} '${full_bin}' > /dev/full 2> '${flog}'\necho $? > '${frc}'\n")
      _ = process.run("/usr/bin/timeout", bounded_sh(fsh, "60"))
      c.eq_int(nth_line(read_all(frc), 0).to_i() ?? -1, 1, "a failed write to stdout (${fulls[fq]}) exits 1")
      c.expect(read_all(flog).contains("avant runtime: cannot write to standard output: No space left on device"), "a failed write to stdout (${fulls[fq]}) names the stream and the reason")
      fleft = fs.list(fbase) ?? empty_strs()
      c.eq_int(fleft.size, 0, "a failed write to stdout (${fulls[fq]}) leaves nothing in TMPDIR")
      fq += 1
    }
    c.expect(unset_dir.contains("/tmp/avant-"), "no TMPDIR falls back to /tmp")
    c.expect(!fs.exists(unset_dir), "fallback directory removed")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_scratch(c)
  c.finish()
}
