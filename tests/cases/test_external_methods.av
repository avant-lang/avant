import harness
import backends
import std.fs
import std.process

// External methods and names across modules. Each case is a program of
// one or more modules, written into a directory of its own and compiled
// in parallel with the others; an accepted one must print what it
// should, a refused one must leave no binary, say the expected words and
// point at the expected file, line and column.
//
// The rules tested here:
//   - A builtin type's own methods and fields keep their names: a method
//     of String, Bytes or Buf named like one of them (`to_s`, `chars`,
//     `size`) is refused where it is declared; it used to replace the
//     builtin or be silently ignored, depending on the name.
//   - An external method of String, Bytes or Buf is seen as a function
//     is: in its module and, when pub, in the modules that import it. A
//     private one used to be seen by every importer.
//   - Two modules may each add a method of one name to String, Bytes or
//     Buf: each module's calls reach the one it sees, and a call that sees
//     both (the two imported, or one imported and one of its own module)
//     is ambiguous, naming the modules. It used to be refused where the
//     second was declared.
//   - A pub method of a type the program declares is part of that type,
//     seen wherever the type is, so two modules' pub methods of one name
//     and parameters on it are refused where the second is declared,
//     naming the first's module; two private ones, each seen only in its
//     own module, are allowed (they were refused).
//   - An external method of a type the program declares has the implicit
//     receiver of an inherent method: a field is read bare, a method of
//     the type (its own or another external one) is called bare, a field
//     is written through the receiver's name, and a bare call that fits
//     both a method and a function is refused naming both. Bare calls
//     used to be unknown functions, and the messages named self.
//   - A function value may be qualified: `f = m.helper` is module m's
//     function helper as a value, picked among m's functions by the fn
//     type the context expects when there are several; a private one is
//     refused as at a call. Before, `m.helper` was a field read of a
//     module, and an ambiguous bare value could only be written as a
//     lambda calling the one meant.
//   - Two modules may each declare a generic class of one name, with
//     methods and external methods of the same names: each module builds
//     its own with `Cell.new(v)`, another module names one as
//     `ga.Cell(Int)`, a bare `Cell` that sees both is ambiguous, and every
//     call reaches its own module's method. These were `method
//     Cell.show is already defined`, `Cell needs type arguments` and the
//     ambiguity's message for a qualified name; two instances of one
//     such template shared their constructor's symbol.
//   - A program's method on an Array, a Hash or a Set: declared on a
//     receiver of the container's type (`fn (xs: Array(Int)) total`) or
//     on a generic pattern of it (`fn (xs: Array(T)) second: T?`), it
//     is called on every container its receiver fits; two of one name on
//     Array(Int) and Array(String) are two methods, a call on a receiver
//     no declaration fits names the receivers it is declared on, and the
//     container's builtin names are refused where declared. They were
//     refused as receivers (methods can only extend ...).
//   - A function's bare name followed by a block is a call with that
//     block, wherever a qualified name followed by one is
//     (`puts(twice { |x| x + 1 })` as `puts(m.twice { |x| x + 1 })`):
//     it was a parse error in an argument and a function value followed
//     by a separate lambda elsewhere. A trailing block starts on the
//     line its call ends on: a lambda on the next line is a value of its
//     own (after `b = self.base` it used to be taken as the block of a
//     call of base).

class MCase {
  pub tag: String = ""
  // Pairs of module name and source; the first module is the root.
  pub mods: Array(String) = []
  pub want: String = ""
  pub pos: String = ""
  pub ok: Bool = false
}

fn accepted(tag: String, mods: Array(String), out: String): MCase {
  f = MCase.new()
  f.tag = tag
  f.mods = mods
  f.want = out
  f.ok = true
  f
}

// pos is `module.av:line:column`.
fn refused(tag: String, mods: Array(String), needle: String, pos: String): MCase {
  f = MCase.new()
  f.tag = tag
  f.mods = mods
  f.want = needle
  f.pos = pos
  f
}

fn builtin_cases: Array(MCase) {
  xs: Array(MCase) = []
  xs.push(refused("builtin-to-s", ["main", "fn (s: String) to_s: String {\n  \"mine\"\n}\n\nfn main {\n  puts(\"abc\".to_s)\n}\n"], "to_s is a builtin of String: a method cannot replace it; give the method another name", "main.av:1:1"))
  xs.push(refused("builtin-chars", ["main", "fn (s: String) chars: Int {\n  5\n}\n\nfn main {\n  puts(1)\n}\n"], "chars is a builtin of String: a method cannot replace it", "main.av:1:1"))
  xs.push(refused("builtin-size", ["main", "fn main {\n  puts(1)\n}\n\nfn (b: Bytes) size: Int {\n  5\n}\n"], "size is a builtin of Bytes: a method cannot replace it", "main.av:5:1"))
  xs.push(refused("builtin-buf", ["main", "import ext\n\nfn main {\n  puts(1)\n}\n", "ext", "pub fn (b: Buf) to_s: String {\n  \"buf\"\n}\n"], "to_s is a builtin of Buf: a method cannot replace it", "ext.av:1:5"))
  xs.push(accepted("builtin-other-name", ["main", "fn (s: String) show: String {\n  \"<\${s.to_s()}>\"\n}\n\nfn (b: Buf) text: String {\n  b.to_s()\n}\n\nfn main {\n  puts(\"abc\".show())\n  b = Buf.new()\n  b.push_str(\"xy\")\n  puts(b.text())\n  puts(\"abc\".chars().size)\n}\n"], "<abc>\nxy\n3\n"))
  xs.push(refused("ext-private-imported", ["main", "import ext\n\nfn main {\n  puts(\"x\".quiet())\n}\n", "ext", "fn (s: String) quiet: String {\n  \"q\"\n}\n\npub fn (s: String) loud: String {\n  \"L\"\n}\n"], "method String.quiet of module ext is private to its module; mark it pub", "main.av:4:11"))
  xs.push(refused("ext-private-field-form", ["main", "import ext\n\nfn main {\n  puts(\"x\".quiet())\n}\n", "ext", "fn (s: String) quiet: String {\n  \"q\"\n}\n"], "method String.quiet of module ext is private to its module; mark it pub", "main.av:4:11"))
  xs.push(accepted("ext-pub-imported", ["main", "import ext\n\nfn main {\n  puts(\"x\".loud())\n  puts(ext.go())\n}\n", "ext", "fn (s: String) quiet: String {\n  \"q\"\n}\n\npub fn (s: String) loud: String {\n  \"L\${s.quiet()}\"\n}\n\npub fn go: String {\n  \"y\".quiet()\n}\n"], "Lq\nq\n"))
  xs
}

fn twin_cases: Array(MCase) {
  xs: Array(MCase) = []
  ma = "pub fn (s: String) shout: String {\n  \"ma \${s}\"\n}\n\npub fn go: String {\n  \"a\".shout()\n}\n"
  mb = "pub fn (s: String) shout: String {\n  \"mb \${s}\"\n}\n\npub fn go: String {\n  \"b\".shout()\n}\n"
  xs.push(accepted("twin-builtin-each-own", ["main", "import ma\nimport mb\n\nfn main {\n  puts(ma.go())\n  puts(mb.go())\n}\n", "ma", ma, "mb", mb], "ma a\nmb b\n"))
  xs.push(accepted("twin-builtin-one-imported", ["main", "import ma\nimport mid\n\nfn main {\n  puts(\"x\".shout())\n  puts(mid.go())\n}\n", "ma", ma, "mb", mb, "mid", "import mb\n\npub fn go: String {\n  \"m\".shout()\n}\n"], "ma x\nmb m\n"))
  xs.push(refused("twin-builtin-both-imported", ["main", "import ma\nimport mb\n\nfn main {\n  puts(\"x\".shout())\n}\n", "ma", ma, "mb", mb], "ambiguous call to String.shout: the methods of modules ma and mb both match, and a method call cannot name its module; call it from a module that imports only one of them", "main.av:5:11"))
  xs.push(refused("twin-builtin-own-and-imported", ["main", "import ma\n\nfn (s: String) shout: String {\n  s\n}\n\nfn main {\n  puts(\"x\".shout())\n}\n", "ma", ma], "the methods of modules ma and main both match", "main.av:8:11"))
  xs.push(accepted("twin-builtin-private", ["main", "import ext\n\nfn (s: String) quiet: String {\n  \"own\"\n}\n\nfn main {\n  puts(\"x\".quiet())\n  puts(ext.go())\n}\n", "ext", "fn (s: String) quiet: String {\n  \"q\"\n}\n\npub fn go: String {\n  \"y\".quiet()\n}\n"], "own\nq\n"))
  pt = "pub class Point {\n  pub x: Int = 1\n}\n"
  xs.push(refused("twin-type-pub", ["main", "import pa\nimport pb\n\nfn main {\n  puts(1)\n}\n", "p", pt, "pa", "import p\n\npub fn (q: Point) norm: Int {\n  q.x + 10\n}\n", "pb", "import p\n\npub fn (q: Point) norm: Int {\n  q.x + 20\n}\n"], "method Point.norm is already defined in module pa", "pb.av:3:5"))
  xs.push(refused("twin-type-pub-and-private", ["main", "import pa\nimport pb\n\nfn main {\n  puts(1)\n}\n", "p", pt, "pa", "import p\n\npub fn (q: Point) norm: Int {\n  q.x + 10\n}\n", "pb", "import p\n\nfn (q: Point) norm: Int {\n  q.x + 20\n}\n"], "method Point.norm is already defined in module pa", "pb.av:3:1"))
  xs.push(accepted("twin-type-private", ["main", "import p\nimport pa\nimport pb\n\nfn main {\n  puts(pa.ta())\n  puts(pb.tb())\n}\n", "p", pt, "pa", "import p\n\nfn (q: Point) norm: Int {\n  q.x + 10\n}\n\npub fn ta: Int {\n  Point.new().norm()\n}\n", "pb", "import p\n\nfn (q: Point) norm: Int {\n  q.x + 20\n}\n\npub fn tb: Int {\n  Point.new().norm()\n}\n"], "11\n21\n"))
  xs
}

fn receiver_cases: Array(MCase) {
  xs: Array(MCase) = []
  xs.push(accepted("receiver-bare", ["main", "class Cell(T) {\n  item: T\n\n  fn initialize(item: T) {\n    self.item = item\n  }\n\n  fn get: T {\n    item\n  }\n}\n\nfn (c: Cell(T)) twice: Array(T) {\n  [get(), item]\n}\n\nstruct V {\n  a: Int\n  b: Int\n\n  fn sum: Int {\n    a + b\n  }\n}\n\nfn (v: V) scaled(k: Int): Int {\n  m = 100\n  m * k + a + sum() + norm()\n}\n\nfn (v: V) norm: Int {\n  if b > 0 { b } else { 0 - b }\n}\n\nfn main {\n  puts(Cell.new(3).twice().size)\n  puts(V { a: 1, b: -2 }.scaled(2))\n}\n"], "2\n202\n"))
  pt = "class Point {\n  x: Int = 3\n  y: Int = 4\n\n  fn sum: Int {\n    x + y\n  }\n}\n\n"
  xs.push(refused("receiver-bare-write", ["main", "${pt}fn (p: Point) move {\n  x = 5\n}\n\nfn main {\n  Point.new().move()\n}\n"], "x is a field of Point; write p.x = ... to change the field, or choose another name for a local", "main.av:11:3"))
  xs.push(accepted("receiver-write-named", ["main", "${pt}fn (p: Point) move {\n  p.x = 5\n  p.y += sum()\n}\n\nfn main {\n  q = Point.new()\n  q.move()\n  puts(q.sum())\n}\n"], "18\n"))
  xs.push(refused("receiver-method-and-function", ["main", "${pt}fn sum: Int {\n  1\n}\n\nfn (p: Point) twice: Int {\n  sum() * 2\n}\n\nfn main {\n  puts(Point.new().twice())\n}\n"], "sum is both a method of Point and a function; write p.sum(...) for the method, or qualify the function", "main.av:15:3"))
  xs.push(accepted("receiver-qualified-function", ["main", "${pt}fn sum: Int {\n  1\n}\n\nfn (p: Point) both: Int {\n  p.sum() * 10 + main.sum()\n}\n\nfn main {\n  puts(Point.new().both())\n}\n"], "71\n"))
  xs.push(refused("receiver-lambda", ["main", "${pt}fn (p: Point) later: Int {\n  f = (k: Int) { k + x }\n  f(1)\n}\n\nfn main {\n  puts(Point.new().later())\n}\n"], "a lambda cannot capture the receiver p of an external method; copy it into a local first", "main.av:11:22"))
  xs.push(refused("receiver-private-field", ["main", "import geo\n\nfn (p: Spot) peek: Int {\n  x + 1\n}\n\nfn main {\n  puts(make().peek())\n}\n", "geo", "pub struct Spot {\n  x: Int\n}\n\npub fn make: Spot {\n  Spot { x: 1 }\n}\n"], "private", "main.av:4:3"))
  xs.push(accepted("receiver-other-module", ["main", "import geo\n\nfn (p: Spot) peek: Int {\n  x + far()\n}\n\nfn main {\n  puts(make().peek())\n}\n", "geo", "pub struct Spot {\n  pub x: Int\n\n  pub fn far: Int {\n    x * 10\n  }\n}\n\npub fn make: Spot {\n  Spot { x: 1 }\n}\n"], "11\n"))
  xs
}

fn value_cases: Array(MCase) {
  xs: Array(MCase) = []
  ma = "pub fn helper(a: Int): Int {\n  a + 1\n}\npub fn show(a: Int): String {\n  \"i\${a}\"\n}\npub fn show(s: String): String {\n  \"s\${s}\"\n}\nfn secret(a: Int): Int {\n  a\n}\npub fn same(x: T): T {\n  x\n}\n"
  mb = "pub fn helper(a: Int): Int {\n  a + 2\n}\n"
  xs.push(accepted("value-qualified", ["main", "import ma\nimport mb\n\nfn apply(f: fn(Int): Int, x: Int): Int {\n  f(x)\n}\n\nfn main {\n  f = ma.helper\n  g = mb.helper\n  puts(f(1) + g(1))\n  puts(apply(ma.helper, 10))\n  s: fn(String): String = ma.show\n  puts(s(\"x\"))\n  fs: Array(fn(Int): Int) = [ma.helper, mb.helper]\n  puts(fs[1](5))\n  puts(apply(main.twice, 4))\n}\n\nfn twice(a: Int): Int {\n  a * 2\n}\n", "ma", ma, "mb", mb], "5\n11\nsx\n7\n8\n"))
  xs.push(accepted("value-qualified-in-lambda", ["main", "import ma\n\nfn main {\n  run = (k: Int) {\n    f = ma.helper\n    f(k) * 10\n  }\n  puts(run(1))\n  ma = 3\n  puts(ma)\n}\n", "ma", ma], "20\n3\n"))
  xs.push(refused("value-qualified-private", ["main", "import ma\n\nfn main {\n  a = ma.secret\n  puts(1)\n}\n", "ma", ma], "function ma.secret is private to its module; mark it pub", "main.av:4:9"))
  xs.push(refused("value-qualified-overloads", ["main", "import ma\n\nfn main {\n  b = ma.show\n  puts(1)\n}\n", "ma", ma], "ambiguous function value ma.show: ma.show(a: Int): String and ma.show(s: String): String both match; give the value its fn type to pick one (f: fn(Int): String = ma.show)", "main.av:4:9"))
  xs.push(refused("value-qualified-generic", ["main", "import ma\n\nfn main {\n  c = ma.same\n  puts(1)\n}\n", "ma", ma], "generic function is not a value", "main.av:4:9"))
  xs.push(refused("value-two-modules-bare", ["main", "import ma\nimport mb\n\nfn main {\n  f = helper\n  puts(f(1))\n}\n", "ma", ma, "mb", mb], "ambiguous function value helper: ma.helper and mb.helper both match; write ma.helper or mb.helper", "main.av:5:7"))
  xs
}

fn generic_cases: Array(MCase) {
  xs: Array(MCase) = []
  ga = "pub class Cell(T) {\n  pub item: T\n\n  fn initialize(item: T) {\n    self.item = item\n  }\n\n  pub fn tag: String {\n    \"ga\"\n  }\n\n  pub fn swap(v: T): T {\n    old = item\n    self.item = v\n    old\n  }\n}\n\npub fn (c: Cell(T)) show: String {\n  \"ga-show\"\n}\n\npub fn (c: Cell(Int)) twice: Int {\n  c.item * 2\n}\n\npub fn mk(v: Int): Cell(Int) {\n  Cell.new(v)\n}\n\npub fn mks(v: String): Cell(String) {\n  Cell.new(v)\n}\n"
  gb = "pub class Cell(T) {\n  pub item: T\n  pub n: Int = 0\n\n  fn initialize(item: T) {\n    self.item = item\n  }\n\n  pub fn tag: String {\n    \"gb\"\n  }\n\n  pub fn swap(v: T): T {\n    self.n += 1\n    self.item = v\n    v\n  }\n}\n\npub fn (c: Cell(T)) show: String {\n  \"gb-show\"\n}\n\npub fn (c: Cell(Int)) twice: Int {\n  c.item * 20\n}\n\npub fn mk(v: Int): Cell(Int) {\n  Cell.new(v)\n}\n\npub fn mks(v: String): Cell(String) {\n  Cell.new(v)\n}\n"
  xs.push(accepted("generic-two-modules", ["main", "import ga\nimport gb\n\nfn main {\n  a = ga.mk(1)\n  b = gb.mk(2)\n  puts(\"\${a.tag()} \${b.tag()}\")\n  puts(\"\${a.show()} \${b.show()}\")\n  puts(\"\${a.twice()} \${b.twice()}\")\n  puts(\"\${a.swap(5)} \${b.swap(6)}\")\n  puts(\"\${a.item} \${b.item} \${b.n}\")\n  s = ga.mks(\"s\")\n  t = gb.mks(\"t\")\n  puts(\"\${s.tag()} \${t.tag()} \${s.show()} \${t.show()}\")\n}\n", "ga", ga, "gb", gb], "ga gb\nga-show gb-show\n2 40\n1 6\n5 6 1\nga gb ga-show gb-show\n"))
  xs.push(accepted("generic-qualified", ["main", "import ga\nimport gb\n\nfn main {\n  a = ga.Cell(Int).new(1)\n  b = gb.Cell(String).new(\"s\")\n  c: gb.Cell(Int) = gb.mk(4)\n  puts(\"\${a.tag()} \${a.show()} \${b.tag()} \${b.show()} \${c.twice()}\")\n}\n", "ga", ga, "gb", gb], "ga ga-show gb gb-show 80\n"))
  xs.push(refused("generic-bare-both", ["main", "import ga\nimport gb\n\nfn main {\n  a = Cell(Int).new(1)\n  puts(a.tag())\n}\n", "ga", ga, "gb", gb], "Cell is a type of both ga and gb: write ga.Cell or gb.Cell", "main.av:5:7"))
  xs.push(accepted("generic-bare-one", ["main", "import ga\nimport mid\n\nfn main {\n  a = Cell.new(1)\n  b: Cell(String) = Cell.new(\"x\")\n  puts(\"\${a.tag()} \${a.twice()} \${b.show()} \${mid.other()}\")\n}\n", "ga", ga, "gb", gb, "mid", "import gb\n\npub fn other: String {\n  mk(3).show()\n}\n"], "ga 2 ga-show gb-show\n"))
  xs
}

fn block_cases: Array(MCase) {
  xs: Array(MCase) = []
  xs.push(accepted("block-bare-name", ["main", "fn twice(f: fn(Int): Int): Int {\n  f(f(1))\n}\n\nfn apply(f: fn(Int): Int) {\n  puts(f(10))\n}\n\nfn main {\n  puts(twice (x) { x + 1 })\n  n = twice (x) { x * 3 }\n  puts(n)\n  apply (x) { x - 1 }\n  m: Int = twice (x) {\n    x + 100\n  }\n  puts(m)\n  ok = twice (x) { x + 2 }\n  puts(ok)\n}\n"], "3\n9\n9\n201\n5\n"))
  fa = "pub fn twice(f: fn(Int): Int): Int {\n  f(f(1))\n}\n"
  fb = "pub fn twice(f: fn(Int): Int): Int {\n  f(1)\n}\n"
  xs.push(accepted("block-bare-name-imported", ["main", "import fa\n\nfn main {\n  puts(twice (x) { x + 5 })\n  n = fa.twice (x) { x * 2 }\n  puts(n)\n}\n", "fa", fa], "11\n4\n"))
  xs.push(refused("block-bare-name-ambiguous", ["main", "import fa\nimport fb\n\nfn main {\n  n = twice (x) { x + 1 }\n  puts(n)\n}\n", "fa", fa, "fb", fb], "ambiguous call to twice: fa.twice and fb.twice both match", "main.av:5:7"))
  xs.push(accepted("block-next-line", ["main", "class Meth {\n  base: Int = 3\n\n  fn off(x: Int): fn(Int): Int {\n    b = self.base\n    (y) { y + x + b }\n  }\n}\n\nfn main {\n  puts(Meth.new().off(1)(2))\n}\n"], "6\n"))
  xs.push(refused("block-fn-value", ["main", "fn main {\n  f = (x: Int) { x + 1 }\n  puts(f { |y| y })\n}\n"], "a block in pipes is not Avant", "main.av:3:10"))
  xs
}

fn container_cases: Array(MCase) {
  xs: Array(MCase) = []
  xs.push(accepted("container-methods", ["main", "fn (xs: Array(T)) second: T? {\n  xs.get(1)\n}\n\nfn (xs: Array(Int)) total: Int {\n  t = 0\n  for x in xs {\n    t += x\n  }\n  t\n}\n\nfn (xs: Array(String)) total: Int {\n  t = 0\n  for x in xs {\n    t += x.size\n  }\n  t\n}\n\nfn (h: Hash(K, V)) has_all(ks: Array(K)): Bool {\n  for k in ks {\n    if !h.has(k) {\n      return false\n    }\n  }\n  true\n}\n\nfn (h: Hash(String, Int)) sum_values: Int {\n  t = 0\n  h.each (k, v) { t += v }\n  t\n}\n\nfn (s: Set(T)) add_all(xs: Array(T)): Int {\n  n = 0\n  for x in xs {\n    if s.add(x) {\n      n += 1\n    }\n  }\n  n\n}\n\nfn (xs: Array(T)) firsts(n: Int): Array(T) {\n  out: Array(T) = []\n  for x in xs {\n    if out.size < n {\n      out.push(x)\n    }\n  }\n  out\n}\n\nfn main {\n  puts([1, 2, 3].second() ?? -1)\n  puts([\"a\", \"bc\"].second() ?? \"-\")\n  puts(\"\${[4, 5].total()} \${[\"ab\", \"cde\"].total()}\")\n  h = [\"a\": 1, \"b\": 2]\n  puts(\"\${h.has_all([\"a\", \"b\"])} \${h.has_all([\"a\", \"z\"])} \${h.sum_values()}\")\n  s = Set(Int).new()\n  puts(s.add_all([1, 2, 2, 3]))\n  ys: Array(Int32) = [1, 2, 3]\n  puts(\"\${ys.firsts(2).size} \${[[1], [2, 3]].firsts(5)[1].size}\")\n}\n"], "2\nbc\n9 5\ntrue false 3\n3\n2 2\n"))
  xs.push(refused("container-builtin-name", ["main", "fn (xs: Array(Int)) push(v: Int) {\n}\n\nfn main {\n  puts(1)\n}\n"], "push is a builtin of Array: a method cannot replace it", "main.av:1:1"))
  xs.push(refused("container-builtin-name-hash", ["main", "fn main {\n  puts(1)\n}\n\nfn (h: Hash(K, V)) keys: Int {\n  1\n}\n"], "keys is a builtin of Hash: a method cannot replace it", "main.av:5:1"))
  xs.push(refused("container-other-receiver", ["main", "fn (xs: Array(Int)) total: Int {\n  xs.size\n}\n\nfn main {\n  puts([\"a\"].total())\n}\n"], "no method total on Array(String): total is declared on Array(Int)", "main.av:6:13"))
  xs.push(refused("container-twice", ["main", "fn (xs: Array(T)) total: Int {\n  1\n}\n\nfn (xs: Array(Int)) total: Int {\n  2\n}\n\nfn main {\n  puts([1].total())\n}\n"], "method Array.total is already defined", "main.av:5:1"))
  xs.push(accepted("container-imported", ["main", "import ea\n\nfn main {\n  puts([1, 2].total())\n  puts(ea.go())\n}\n", "ea", "pub fn (xs: Array(Int)) total: Int {\n  xs.size * 10\n}\n\npub fn go: Int {\n  [1].total()\n}\n"], "20\n10\n"))
  xs.push(refused("container-both-imported", ["main", "import ea\nimport eb\n\nfn main {\n  puts([1].total())\n}\n", "ea", "pub fn (xs: Array(Int)) total: Int {\n  xs.size * 10\n}\n\npub fn go: Int {\n  [1].total()\n}\n", "eb", "pub fn (xs: Array(Int)) total: Int {\n  xs.size * 20\n}\n"], "ambiguous call to Array(Int).total: the methods of modules ea and eb both match", "main.av:5:11"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(MCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    d = "${dir}/${f.tag}"
    mkdir_p(d)
    i = 0
    while i + 1 < f.mods.size {
      write_av(d, f.mods[i], f.mods[i + 1])
      i += 2
    }
    jobs.push(compile_job("", compiler, "${d}/${f.mods[0]}.av", "${d}/prog.bin", "${d}/prog.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job("${dir}/${f2.tag}", "prog.bin", "prog.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i2 in 0..cases.size {
    f3 = cases[i2]
    d3 = "${dir}/${f3.tag}"
    log = log_text("${d3}/prog.log")
    if f3.ok {
      c.eq_int(jobs[i2].code, 0, "${f3.tag}: compiles")
      if jobs[i2].code != 0 {
        puts(log)
      }
      c.eq_int(runs[k].code, 0, "${f3.tag}: exit 0")
      c.eq_str(log_text("${d3}/prog.run.out"), f3.want, "${f3.tag}: stdout")
      k += 1
    } else {
      c.expect(jobs[i2].code != 0 && !fs.exists("${d3}/prog.bin"), "${f3.tag}: refused")
      c.expect(log.contains(f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(log.contains("/${f3.pos}\n"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_external_methods.av")
  if compiler = process.env("AVANT_COMPILER") {
    all = builtin_cases()
    for t in twin_cases() {
      all.push(t)
    }
    for r in receiver_cases() {
      all.push(r)
    }
    for v in value_cases() {
      all.push(v)
    }
    for g in generic_cases() {
      all.push(g)
    }
    for b in block_cases() {
      all.push(b)
    }
    for k in container_cases() {
      all.push(k)
    }
    run_cases(c, compiler, scratch_dir(), all)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
