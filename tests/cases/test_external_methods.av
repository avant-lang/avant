import harness
import backends

// External methods and names across modules. Each case is a program of
// one or more modules, written into a directory of its own and compiled
// in parallel with the others; an accepted one must print what it
// should, a refused one must leave no binary, say the expected words and
// point at the expected file, line and column.
//
// The rules tested here:
//   - A builtin type's own methods and fields keep their names: a method
//     of String, Bytes or Buf named like one of them (`to_s`, `chars`,
//     `size`) is refused where it is declared; it used to replace the
//     builtin or be silently ignored, depending on the name.
//   - An external method of String, Bytes or Buf is seen as a function
//     is: in its module and, when pub, in the modules that import it. A
//     private one used to be seen by every importer.
//   - Two modules may each add a method of one name to String, Bytes or
//     Buf: each module's calls reach the one it sees, and a call that sees
//     both (the two imported, or one imported and one of its own module)
//     is ambiguous, naming the modules. It used to be refused where the
//     second was declared.
//   - A pub method of a type the program declares is part of that type,
//     seen wherever the type is, so two modules' pub methods of one name
//     and parameters on it are refused where the second is declared,
//     naming the first's module; two private ones, each seen only in its
//     own module, are allowed (they were refused).

class MCase {
  pub tag: String = ""
  // Pairs of module name and source; the first module is the root.
  pub mods: Array(String) = []
  pub want: String = ""
  pub pos: String = ""
  pub ok: Bool = false
}

fn accepted(tag: String, mods: Array(String), out: String): MCase {
  f = MCase.new
  f.tag = tag
  f.mods = mods
  f.want = out
  f.ok = true
  f
}

// pos is `module.av:line:column`.
fn refused(tag: String, mods: Array(String), needle: String, pos: String): MCase {
  f = MCase.new
  f.tag = tag
  f.mods = mods
  f.want = needle
  f.pos = pos
  f
}

fn builtin_cases: Array(MCase) {
  xs: Array(MCase) = []
  xs.push(refused("builtin-to-s", ["main", "fn (s: String) to_s: String {\n  \"mine\"\n}\n\nfn main {\n  puts(\"abc\".to_s)\n}\n"], "to_s is a builtin of String: a method cannot replace it; give the method another name", "main.av:1:1"))
  xs.push(refused("builtin-chars", ["main", "fn (s: String) chars: Int {\n  5\n}\n\nfn main {\n  puts(1)\n}\n"], "chars is a builtin of String: a method cannot replace it", "main.av:1:1"))
  xs.push(refused("builtin-size", ["main", "fn main {\n  puts(1)\n}\n\nfn (b: Bytes) size: Int {\n  5\n}\n"], "size is a builtin of Bytes: a method cannot replace it", "main.av:5:1"))
  xs.push(refused("builtin-buf", ["main", "import ext\n\nfn main {\n  puts(1)\n}\n", "ext", "pub fn (b: Buf) to_s: String {\n  \"buf\"\n}\n"], "to_s is a builtin of Buf: a method cannot replace it", "ext.av:1:5"))
  xs.push(accepted("builtin-other-name", ["main", "fn (s: String) show: String {\n  \"<\${s.to_s}>\"\n}\n\nfn (b: Buf) text: String {\n  b.to_s\n}\n\nfn main {\n  puts(\"abc\".show)\n  b = buf_new()\n  b.push_str(\"xy\")\n  puts(b.text)\n  puts(\"abc\".chars.size)\n}\n"], "<abc>\nxy\n3\n"))
  xs.push(refused("ext-private-imported", ["main", "import ext\n\nfn main {\n  puts(\"x\".quiet())\n}\n", "ext", "fn (s: String) quiet: String {\n  \"q\"\n}\n\npub fn (s: String) loud: String {\n  \"L\"\n}\n"], "method String.quiet of module ext is private to its module; mark it pub", "main.av:4:11"))
  xs.push(refused("ext-private-field-form", ["main", "import ext\n\nfn main {\n  puts(\"x\".quiet)\n}\n", "ext", "fn (s: String) quiet: String {\n  \"q\"\n}\n"], "method String.quiet of module ext is private to its module; mark it pub", "main.av:4:11"))
  xs.push(accepted("ext-pub-imported", ["main", "import ext\n\nfn main {\n  puts(\"x\".loud)\n  puts(ext.go())\n}\n", "ext", "fn (s: String) quiet: String {\n  \"q\"\n}\n\npub fn (s: String) loud: String {\n  \"L\${s.quiet}\"\n}\n\npub fn go: String {\n  \"y\".quiet\n}\n"], "Lq\nq\n"))
  xs
}

fn twin_cases: Array(MCase) {
  xs: Array(MCase) = []
  ma = "pub fn (s: String) shout: String {\n  \"ma \${s}\"\n}\n\npub fn go: String {\n  \"a\".shout\n}\n"
  mb = "pub fn (s: String) shout: String {\n  \"mb \${s}\"\n}\n\npub fn go: String {\n  \"b\".shout()\n}\n"
  xs.push(accepted("twin-builtin-each-own", ["main", "import ma\nimport mb\n\nfn main {\n  puts(ma.go())\n  puts(mb.go())\n}\n", "ma", ma, "mb", mb], "ma a\nmb b\n"))
  xs.push(accepted("twin-builtin-one-imported", ["main", "import ma\nimport mid\n\nfn main {\n  puts(\"x\".shout)\n  puts(mid.go())\n}\n", "ma", ma, "mb", mb, "mid", "import mb\n\npub fn go: String {\n  \"m\".shout\n}\n"], "ma x\nmb m\n"))
  xs.push(refused("twin-builtin-both-imported", ["main", "import ma\nimport mb\n\nfn main {\n  puts(\"x\".shout)\n}\n", "ma", ma, "mb", mb], "ambiguous call to String.shout: the methods of modules ma and mb both match, and a method call cannot name its module; call it from a module that imports only one of them", "main.av:5:11"))
  xs.push(refused("twin-builtin-own-and-imported", ["main", "import ma\n\nfn (s: String) shout: String {\n  s\n}\n\nfn main {\n  puts(\"x\".shout())\n}\n", "ma", ma], "the methods of modules ma and main both match", "main.av:8:11"))
  xs.push(accepted("twin-builtin-private", ["main", "import ext\n\nfn (s: String) quiet: String {\n  \"own\"\n}\n\nfn main {\n  puts(\"x\".quiet)\n  puts(ext.go())\n}\n", "ext", "fn (s: String) quiet: String {\n  \"q\"\n}\n\npub fn go: String {\n  \"y\".quiet\n}\n"], "own\nq\n"))
  pt = "pub class Point {\n  pub x: Int = 1\n}\n"
  xs.push(refused("twin-type-pub", ["main", "import pa\nimport pb\n\nfn main {\n  puts(1)\n}\n", "p", pt, "pa", "import p\n\npub fn (q: Point) norm: Int {\n  q.x + 10\n}\n", "pb", "import p\n\npub fn (q: Point) norm: Int {\n  q.x + 20\n}\n"], "method Point.norm is already defined in module pa", "pb.av:3:5"))
  xs.push(refused("twin-type-pub-and-private", ["main", "import pa\nimport pb\n\nfn main {\n  puts(1)\n}\n", "p", pt, "pa", "import p\n\npub fn (q: Point) norm: Int {\n  q.x + 10\n}\n", "pb", "import p\n\nfn (q: Point) norm: Int {\n  q.x + 20\n}\n"], "method Point.norm is already defined in module pa", "pb.av:3:1"))
  xs.push(accepted("twin-type-private", ["main", "import p\nimport pa\nimport pb\n\nfn main {\n  puts(pa.ta())\n  puts(pb.tb())\n}\n", "p", pt, "pa", "import p\n\nfn (q: Point) norm: Int {\n  q.x + 10\n}\n\npub fn ta: Int {\n  Point.new.norm\n}\n", "pb", "import p\n\nfn (q: Point) norm: Int {\n  q.x + 20\n}\n\npub fn tb: Int {\n  Point.new.norm()\n}\n"], "11\n21\n"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(MCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    d = "${dir}/${f.tag}"
    mkdir_p(d)
    i = 0
    while i + 1 < f.mods.size {
      write_av(d, f.mods[i], f.mods[i + 1])
      i += 2
    }
    jobs.push(compile_job("", compiler, "${d}/${f.mods[0]}.av", "${d}/prog.bin", "${d}/prog.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job("${dir}/${f2.tag}", "prog.bin", "prog.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i2 in 0..cases.size {
    f3 = cases[i2]
    d3 = "${dir}/${f3.tag}"
    log = log_text("${d3}/prog.log")
    if f3.ok {
      c.eq_int(jobs[i2].code, 0, "${f3.tag}: compiles")
      if jobs[i2].code != 0 {
        puts(log)
      }
      c.eq_int(runs[k].code, 0, "${f3.tag}: exit 0")
      c.eq_str(log_text("${d3}/prog.run.out"), f3.want, "${f3.tag}: stdout")
      k += 1
    } else {
      c.expect(jobs[i2].code != 0 && !file_exists("${d3}/prog.bin"), "${f3.tag}: refused")
      c.expect(str_has(log, f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(str_has(log, "/${f3.pos}\n"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_external_methods.av")
  if compiler = env_get("AVANT_COMPILER") {
    all = builtin_cases()
    for t in twin_cases() {
      all.push(t)
    }
    run_cases(c, compiler, scratch_dir(), all)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
