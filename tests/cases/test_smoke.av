import harness
import std.fs

fn fact(n: Int): Int {
  if n <= 1 { return 1 }
  n * fact(n - 1)
}

fn test_smoke(c: Checks) {
  c.suite("tests/cases/test_smoke.av")
  c.expect(true, "true")
  c.eq_int(1 + 1, 2, "1+1")
  c.eq_int(fact(5), 120, "fact(5)")
  c.eq_str("Hello" + " Avant", "Hello Avant", "concat")
  c.expect("ab" == "ab", "str_eq")
  c.expect(fs.exists("/"), "fs.exists /")
  if names = fs.list("/") {
    c.expect(names.size > 0, "fs.list /")
  } else {
    c.expect(false, "fs.list /")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_smoke(c)
  c.finish()
}
