import harness
import backends

// Stage 29 W5b2: literals and constants. Character literals and the
// String escapes (D293, D352, O287); binary, octal and digit separators,
// and a leading zero refused (D315, D352, O287, O493); a literal that
// does not fit, at every integer width and in every context that gives
// it a type (O455); module constants, `const` (D314, D315, D327 Q7), and
// no module-level mutable state (D352, O298). Each program is compiled
// in parallel; a refused one must leave no binary, say the expected
// words and point at the expected line and column; an accepted one must
// print what it should.

class LCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  pub ok: Bool = false
}

fn refused(tag: String, src: String, needle: String, pos: String): LCase {
  f = LCase.new
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f
}

fn accepted(tag: String, src: String, out: String): LCase {
  f = LCase.new
  f.tag = tag
  f.src = src
  f.want = out
  f.ok = true
  f
}

fn char_cases: Array(LCase) {
  xs: Array(LCase) = []
  xs.push(refused("char-empty", "fn main {\n  x = ''\n  puts(x)\n}\n", "empty character literal: a character literal holds one byte, as 'a'", "2:7"))
  xs.push(refused("char-two", "fn main {\n  x = 'ab'\n  puts(x)\n}\n", "a character literal holds one byte: write a String in double quotes for several", "2:7"))
  xs.push(refused("char-multibyte", "fn main {\n  x = 'é'\n  puts(x)\n}\n", "a character literal is one byte, and this character is 2 bytes in UTF-8: write it in a String", "2:7"))
  xs.push(refused("char-code-multibyte", "fn main {\n  x = '\\u{e9}'\n  puts(x)\n}\n", "a character literal is one byte, and this code point is 2 bytes in UTF-8: write it in a String", "2:7"))
  xs.push(refused("char-code-four", "fn main {\n  x = '\\u{1F600}'\n  puts(x)\n}\n", "this code point is 4 bytes in UTF-8", "2:7"))
  xs.push(refused("char-unterminated", "fn main {\n  x = 'a\n  puts(x)\n}\n", "unterminated character literal", "2:7"))
  xs.push(refused("char-escape-unknown", "fn main {\n  x = '\\e'\n  puts(x)\n}\n", "unknown character escape \\e; the escapes are \\n \\t \\r \\\\ \\0 \\xNN \\u{N} and \\'", "2:8"))
  xs.push(refused("char-escape-dquote", "fn main {\n  x = '\\\"'\n  puts(x)\n}\n", "unknown character escape \\\"", "2:8"))
  xs.push(refused("char-not-string", "fn main {\n  x = 'a'\n  s: String = x\n  puts(x)\n}\n", "cannot assign Int to String", "3:15"))
  xs.push(refused("str-escape-e", "fn main {\n  x = \"\\e\"\n  puts(x)\n}\n", "unknown string escape \\e; the escapes are \\n \\t \\r \\\\ \\0 \\xNN \\u{N} and \\\" \\\$", "2:8"))
  xs.push(refused("str-escape-squote", "fn main {\n  x = \"\\'\"\n  puts(x)\n}\n", "unknown string escape \\'", "2:8"))
  xs.push(refused("str-x-one-digit", "fn main {\n  x = \"\\x4\"\n  puts(x)\n}\n", "\\x takes two hex digits: \\x41", "2:8"))
  xs.push(refused("str-u-no-brace", "fn main {\n  x = \"\\u41\"\n  puts(x)\n}\n", "\\u takes a code point in braces: \\u{e9}", "2:8"))
  xs.push(refused("str-u-empty", "fn main {\n  x = \"\\u{}\"\n  puts(x)\n}\n", "\\u takes a code point in braces: \\u{e9}", "2:8"))
  xs.push(refused("str-u-too-big", "fn main {\n  x = \"\\u{110000}\"\n  puts(x)\n}\n", "\\u{...} is above 10FFFF, the last Unicode code point", "2:8"))
  xs.push(refused("str-u-seven", "fn main {\n  x = \"\\u{0000041}\"\n  puts(x)\n}\n", "\\u{...} is above 10FFFF", "2:8"))
  xs.push(refused("str-u-surrogate", "fn main {\n  x = \"\\u{d800}\"\n  puts(x)\n}\n", "\\u{...} names a surrogate (D800 to DFFF), which is not a character", "2:8"))
  xs.push(accepted("char-values", "fn main {\n  puts('a')\n  puts('A' + 1)\n  puts('\\n')\n  puts('\\t')\n  puts('\\r')\n  puts('\\'')\n  puts('\\\\')\n  puts('\\0')\n  puts('\\x41')\n  puts('\\xff')\n  puts('\\u{7f}')\n  puts('\"')\n  puts('\$')\n  puts(' ')\n}\n", "97\n66\n10\n9\n13\n39\n92\n0\n65\n255\n127\n34\n36\n32\n"))
  xs.push(accepted("char-adopts", "fn f(c: Int32): Int32 {\n  c + 1\n}\nfn main {\n  x: Int32 = 'z'\n  u: UInt32 = '0'\n  puts(f('a'))\n  puts(x - 'a')\n  puts(u)\n  bs: Array(Int32) = ['x', 'y']\n  puts(bs[1])\n}\n", "98\n25\n48\n121\n"))
  xs.push(accepted("char-bytes", "fn kind(c: Int): String {\n  switch c {\n    case '+', '-' { \"sign\" }\n    case '0' { \"zero\" }\n    else { \"other\" }\n  }\n}\nfn main {\n  s = \"a+0\"\n  puts(s[0] == 'a')\n  puts(kind(s[1]))\n  puts(kind(s[2]))\n  puts(kind('q'))\n  if s[1] >= '0' && s[1] <= '9' {\n    puts(\"digit\")\n  }\n}\n", "true\nsign\nzero\nother\n"))
  xs.push(accepted("str-escapes", "fn main {\n  a = \"a\\0b\"\n  puts(a.size)\n  puts(a[1])\n  puts(a == \"a\\0b\")\n  puts(a == \"a\\0c\")\n  puts(a == \"a\")\n  puts(\"\\x41\\x42\")\n  x = \"\\xff\"\n  puts(x.size)\n  puts(x[0])\n  e = \"caf\\u{e9}\"\n  puts(e.size)\n  puts(e == \"café\")\n  g = \"\\u{1F600}\"\n  puts(g.size)\n  puts(\"\${g[0]} \${g[3]}\")\n  n = 7\n  z = \"\${n}\\0\${n}\\0\"\n  puts(z.size)\n  puts(z[1])\n  puts(\"\\0\".size)\n  puts(\"\\0\\0\".size)\n  puts(\"\\u{41}\\u{0}\".size)\n}\n", "3\n0\ntrue\nfalse\nfalse\nAB\n1\n255\n5\ntrue\n4\n240 128\n4\n0\n1\n2\n2\n"))
  xs
}

fn number_cases: Array(LCase) {
  xs: Array(LCase) = []
  xs.push(refused("sep-end", "fn main {\n  x = 1_\n  puts(x)\n}\n", "a `_` in a number stands between two digits", "2:8"))
  xs.push(refused("sep-double", "fn main {\n  x = 1__000\n  puts(x)\n}\n", "a `_` in a number stands between two digits", "2:8"))
  xs.push(refused("sep-before-suffix", "fn main {\n  x = 1_u64\n  puts(x)\n}\n", "a `_` in a number stands between two digits", "2:8"))
  xs.push(refused("sep-before-point", "fn main {\n  x = 1_.5\n  puts(x)\n}\n", "a `_` in a number stands between two digits", "2:8"))
  xs.push(refused("sep-after-point", "fn main {\n  x = 1.5_\n  puts(x)\n}\n", "a `_` in a number stands between two digits", "2:10"))
  xs.push(refused("sep-exponent-end", "fn main {\n  x = 1e5_\n  puts(x)\n}\n", "a `_` in a number stands between two digits", "2:10"))
  xs.push(refused("sep-after-prefix", "fn main {\n  x = 0x_ff\n  puts(x)\n}\n", "a `_` in a number stands between two digits, not after 0x", "2:9"))
  xs.push(refused("sep-after-bin", "fn main {\n  x = 0b_1\n  puts(x)\n}\n", "a `_` in a number stands between two digits, not after 0b", "2:9"))
  xs.push(refused("bin-empty", "fn main {\n  x = 0b\n  puts(x)\n}\n", "binary literal needs a digit after 0b", "2:9"))
  xs.push(refused("oct-empty", "fn main {\n  x = 0o\n  puts(x)\n}\n", "octal literal needs a digit after 0o", "2:9"))
  xs.push(refused("hex-empty", "fn main {\n  x = 0x\n  puts(x)\n}\n", "hex literal needs a digit after 0x", "2:9"))
  xs.push(refused("bin-digit", "fn main {\n  x = 0b102\n  puts(x)\n}\n", "2 is not a binary digit", "2:11"))
  xs.push(refused("oct-digit", "fn main {\n  x = 0o78\n  puts(x)\n}\n", "8 is not an octal digit", "2:10"))
  xs.push(refused("bin-upper", "fn main {\n  x = 0B101\n  puts(x)\n}\n", "write the prefix in lower case: 0b", "2:7"))
  xs.push(refused("oct-upper", "fn main {\n  x = 0O17\n  puts(x)\n}\n", "write the prefix in lower case: 0o", "2:7"))
  xs.push(refused("leading-zero", "fn main {\n  x = 017\n  puts(x)\n}\n", "a number does not start with 0: write 17 for the decimal number, or 0o17 for an octal one", "2:7"))
  xs.push(refused("leading-zero-sep", "fn main {\n  x = 0_17\n  puts(x)\n}\n", "a number does not start with 0: write 17 for the decimal number, or 0o17 for an octal one", "2:7"))
  xs.push(refused("leading-zero-nine", "fn main {\n  x = 09\n  puts(x)\n}\n", "a number does not start with 0: write 9", "2:7"))
  xs.push(refused("leading-zeros", "fn main {\n  x = 00\n  puts(x)\n}\n", "a number does not start with 0: write 0 for the decimal number, or 0o0 for an octal one", "2:7"))
  xs.push(accepted("bases", "fn main {\n  puts(0b101)\n  puts(0o17)\n  puts(0o777)\n  puts(0xff)\n  puts(0XFF)\n  puts(0b1111_0000)\n  puts(0xdead_beef)\n  puts(0o7_7)\n  puts(0b1u64)\n  puts(0o1777777777777777777777u64)\n  puts(0b111111111111111111111111111111111111111111111111111111111111111)\n  x: Int32 = 0b1000\n  puts(x)\n  puts(-0b11)\n  puts(0)\n  puts(0.5)\n  puts(0e0)\n}\n", "5\n15\n511\n255\n255\n240\n3735928559\n63\n1\n18446744073709551615\n9223372036854775807\n8\n-3\n0\n0.5\n0.0\n"))
  xs.push(accepted("separators", "fn main {\n  puts(1_000_000)\n  puts(1_0)\n  puts(9_223_372_036_854_775_807)\n  puts(18_446_744_073_709_551_615u64)\n  puts(1_000.000_5)\n  puts(1_0e1_0)\n  puts(2.5e-1_0 > 0.0)\n  xs: Array(UInt32) = [4_000_000_000]\n  puts(xs[0])\n  puts(-1_000)\n}\n", "1000000\n10\n9223372036854775807\n18446744073709551615\n1000.0005\n100000000000.0\ntrue\n4000000000\n-1000\n"))
  xs
}

