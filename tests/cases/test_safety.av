import harness

fn expect_trap_waveb(c: Checks, compiler: String, stamp: Int64, tag: String, body: String, needle: String) {
  src = "${scratch()}/safety-waveb-${stamp}-${tag}.av"
  bin = "${scratch()}/safety-waveb-${stamp}-${tag}.bin"
  clog = "${scratch()}/safety-waveb-${stamp}-${tag}.clog"
  rlog = "${scratch()}/safety-waveb-${stamp}-${tag}.rlog"
  _ = file_write(src, body)
  code = compile_av(compiler, src, bin, clog)
  c.expect(code == 0, "${tag} compiles")
  c.expect(file_exists(bin), "${tag} bin exists")
  rcode = run_av_bin(bin, rlog)
  c.expect(rcode != 0, "${tag} exits non-zero")
  if err = file_read(rlog) {
    c.expect(str_has(err, needle), tag)
  } else {
    c.expect(false, tag)
  }
}

// A program the checker rejects: the compile exits non-zero, writes no
// binary, and its diagnostic names needle.
fn expect_compile_error(c: Checks, compiler: String, stamp: Int64, tag: String, body: String, needle: String) {
  src = "${scratch()}/safety-waveb-${stamp}-${tag}.av"
  bin = "${scratch()}/safety-waveb-${stamp}-${tag}.bin"
  clog = "${scratch()}/safety-waveb-${stamp}-${tag}.clog"
  _ = file_write(src, body)
  code = compile_av(compiler, src, bin, clog)
  c.expect(code != 0, "${tag} is a compile error")
  c.expect(!file_exists(bin), "${tag} writes no binary")
  if err = file_read(clog) {
    c.expect(str_has(err, needle), tag)
  } else {
    c.expect(false, tag)
  }
}

fn test_safety(c: Checks) {
  c.suite("tests/cases/test_safety.av")

  xs = [10, 20, 30]
  if v = xs.get(1) {
    c.eq_int(v, 20, "array get hit")
  } else {
    c.expect(false, "array get hit")
  }
  if v = xs.get(0) {
    c.eq_int(v, 10, "array get first")
  } else {
    c.expect(false, "array get first")
  }
  if v = xs.get(3) {
    c.expect(false, "array get oob is nil")
  } else {
    c.expect(true, "array get oob is nil")
  }
  if v = xs.get(-1) {
    c.expect(false, "array get neg is nil")
  } else {
    c.expect(true, "array get neg is nil")
  }

  s = "hi"
  if v = s.get(1) {
    c.eq_int(v, 105, "string get hit")
  } else {
    c.expect(false, "string get hit")
  }
  if v = s.get(2) {
    c.expect(false, "string get oob is nil")
  } else {
    c.expect(true, "string get oob is nil")
  }

  b = buf_new()
  b.push_byte(65)
  b.push_byte(66)
  if v = b.get(0) {
    c.eq_int(v, 65, "buf get hit")
  } else {
    c.expect(false, "buf get hit")
  }
  if v = b.get(2) {
    c.expect(false, "buf get oob is nil")
  } else {
    c.expect(true, "buf get oob is nil")
  }

  c.eq_int(40 + 2, 42, "checked add")
  c.eq_int(40 - 2, 38, "checked sub")
  c.eq_int(6 * 7, 42, "checked mul")
  c.eq_int(7 / 2, 3, "checked div")
  c.eq_int(7 % 2, 1, "checked rem")
  big = 2147483647
  c.eq_int(big &+ 1, 0 - 2147483647 - 1, "wrap add")
  low = 0 - 2147483647 - 1
  c.eq_int(low &- 1, 2147483647, "wrap sub")
  c.eq_int(65536 &* 65536, 0, "wrap mul")
  // C4 (W11b): MIN % -1 is 0 for Int and Int64; C1: shifts inside the range.
  minus_one = -1
  c.eq_int(low % minus_one, 0, "Int MIN % -1 is 0")
  low64 = 0i64 - 9223372036854775807i64 - 1i64
  c.expect(low64 % minus_one.to_i64 == 0i64, "Int64 MIN % -1 is 0")
  sh = 31
  c.eq_int(1 << sh, low, "Int << 31")
  c.eq_int(low >> sh, minus_one, "Int >> 31")

  shared = [1, 2, 3]
  h = spawn {
    shared[0] + shared[1] + shared[2]
  }
  c.eq_int(h.join, 6, "spawn reads shared array")
  shared.push(4)
  c.eq_int(shared.size, 4, "sender mutates after join")
  shared[0] = 99
  c.eq_int(shared[0], 99, "sender stores after join")

  seed_arr: Array(Int) = [1, 2]
  mu = Mutex.new(seed_arr)
  n = mu.with { |x|
    x.push(3)
    x.size
  }
  c.eq_int(n, 3, "mutex array push")
  m = mu.with { |x| x[2] }
  c.eq_int(m, 3, "mutex array read")

  ch: Channel(Array(Int)) = Channel.new(1)
  ch.send([9, 8])
  if got = ch.recv {
    c.eq_int(got[1], 8, "channel array")
  } else {
    c.expect(false, "channel array")
  }

  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()

    expect_trap_waveb(c, compiler, stamp, "oob-read", "fn main {\n  xs = [1, 2, 3]\n  puts(xs[10])\n}\n", "out of bounds")
    expect_trap_waveb(c, compiler, stamp, "oob-neg", "fn main {\n  xs = [1, 2, 3]\n  i = 0 - 1\n  puts(xs[i])\n}\n", "out of bounds")
    expect_trap_waveb(c, compiler, stamp, "oob-store", "fn main {\n  xs = [1, 2, 3]\n  xs[5] = 9\n  puts(xs[0])\n}\n", "out of bounds")
    expect_trap_waveb(c, compiler, stamp, "str-oob", "fn main {\n  s = \"hi\"\n  puts(s[10])\n}\n", "out of bounds")
    // C9 (W10b): pop on an empty array is the index trap at size - 1, for
    // Int, struct, and reference elements.
    expect_trap_waveb(c, compiler, stamp, "pop-empty-int", "fn main {\n  xs: Array(Int) = []\n  puts(xs.pop)\n}\n", "pop on an empty Array")
    expect_trap_waveb(c, compiler, stamp, "pop-empty-struct", "struct P {\n  a: Int\n  b: Int\n}\nfn main {\n  xs: Array(P) = []\n  q = xs.pop()\n  puts(q.a)\n}\n", "pop on an empty Array")
    expect_trap_waveb(c, compiler, stamp, "pop-empty-ref", "fn main {\n  xs = [\"a\"]\n  puts(xs.pop)\n  puts(xs.pop)\n}\n", "pop on an empty Array")
    expect_trap_waveb(c, compiler, stamp, "buf-oob", "fn main {\n  b = buf_new()\n  b.push_byte(1)\n  puts(b[5])\n}\n", "out of bounds")
    // D64 as amended (Stage 29 W1b): a value passed or stored as a C
    // scalar type that cannot hold it traps (D215); the C function is
    // never called. Compile errors: a C scalar type outside a `fun`
    // signature or a C layout's field, and in a C callback.
    expect_trap_waveb(c, compiler, stamp, "c-u8-arg", "lib c {\n  fun abs(x: UInt8): Int\n}\nfn main {\n  puts(c.abs(256))\n}\n", "avant runtime: 256 out of range for the C type UInt8 (0..255)")
    expect_trap_waveb(c, compiler, stamp, "c-i8-arg", "lib c {\n  fun abs(x: Int8): Int\n}\nfn main {\n  puts(c.abs(-129))\n}\n", "avant runtime: -129 out of range for the C type Int8 (-128..127)")
    expect_trap_waveb(c, compiler, stamp, "c-i16-arg", "lib c {\n  fun abs(x: Int16): Int\n}\nfn main {\n  puts(c.abs(40000))\n}\n", "avant runtime: 40000 out of range for the C type Int16 (-32768..32767)")
    expect_trap_waveb(c, compiler, stamp, "c-u16-arg", "lib c {\n  fun abs(x: UInt16): Int\n}\nfn main {\n  puts(c.abs(-1))\n}\n", "avant runtime: -1 out of range for the C type UInt16 (0..65535)")
    expect_trap_waveb(c, compiler, stamp, "c-u32-arg", "lib c {\n  fun labs(x: UInt32): Int64\n}\nfn main {\n  puts(c.labs(4294967296i64))\n}\n", "avant runtime: 4294967296 out of range for the C type UInt32 (0..4294967295)")
    expect_trap_waveb(c, compiler, stamp, "c-field-store", "lib c {\n  struct Px {\n    r: UInt8\n  }\n  fun calloc(n: Int64, size: Int64): Ptr(Px)\n}\nfn main {\n  p = c.calloc(1i64, 8i64)\n  p.r = 255\n  puts(p.r)\n  p.r += 1\n  puts(p.r)\n}\n", "avant runtime: 256 out of range for the C type UInt8 (0..255)")
    expect_compile_error(c, compiler, stamp, "c-scalar-local", "fn main {\n  x: UInt8 = 1\n  puts(x)\n}\n", "UInt8 is a C type: it is allowed in a `fun` signature and a C layout's field only (in Avant it is Int)")
    expect_compile_error(c, compiler, stamp, "c-scalar-param", "fn f(x: Float32): Int {\n  1\n}\nfn main {\n  puts(f(1.0))\n}\n", "Float32 is a C type: it is allowed in a `fun` signature and a C layout's field only (in Avant it is Float64)")
    expect_compile_error(c, compiler, stamp, "c-scalar-field", "struct S {\n  a: UInt32\n}\nfn main {\n  s = S { a: 1i64 }\n  puts(s.a)\n}\n", "UInt32 is a C type")
    expect_compile_error(c, compiler, stamp, "c-scalar-callback", "lib c {\n  fun qsort(p: Ptr(Void), n: Int64, s: Int64, f: fn(UInt8): Int)\n}\nfn main {\n  puts(1)\n}\n", "a C callback cannot take or return UInt8 yet; use its Avant type (Int)")
    expect_trap_waveb(c, compiler, stamp, "div-zero", "fn main {\n  x = 10\n  y = 0\n  puts(x / y)\n}\n", "division by zero")
    expect_trap_waveb(c, compiler, stamp, "rem-zero", "fn main {\n  x = 10\n  y = 0\n  puts(x % y)\n}\n", "division by zero")
    expect_trap_waveb(c, compiler, stamp, "overflow-add", "fn main {\n  x = 2147483647\n  y = 1\n  puts(x + y)\n}\n", "integer overflow")
    expect_trap_waveb(c, compiler, stamp, "overflow-mul", "fn main {\n  x = 100000\n  y = 100000\n  puts(x * y)\n}\n", "integer overflow")
    expect_trap_waveb(c, compiler, stamp, "overflow-compound", "fn main {\n  x = 2147483647\n  x += 1\n  puts(x)\n}\n", "integer overflow")
    expect_trap_waveb(c, compiler, stamp, "overflow-i64", "fn main {\n  x = 9223372036854775807i64\n  y = 1i64\n  puts(x + y)\n}\n", "integer overflow")
    expect_trap_waveb(c, compiler, stamp, "overflow-u64", "fn main {\n  x = 18446744073709551615u64\n  y = 1u64\n  puts(x + y)\n}\n", "integer overflow")
    expect_trap_waveb(c, compiler, stamp, "div-overflow", "fn main {\n  x = 0 - 2147483647 - 1\n  y = 0 - 1\n  puts(x / y)\n}\n", "integer overflow")
    // C1, C2 (W11b): a shift amount outside 0..width - 1 traps, as does
    // Float64.to_i without an Int result; a literal amount outside the
    // range is a compile error.
    expect_trap_waveb(c, compiler, stamp, "shift-wide", "fn main {\n  n = 32\n  puts(1 << n)\n}\n", "avant runtime: shift amount 32 out of range for Int (0..31)")
    expect_trap_waveb(c, compiler, stamp, "shift-neg", "fn main {\n  n = 0 - 1\n  puts(8 >> n)\n}\n", "avant runtime: shift amount -1 out of range for Int (0..31)")
    expect_trap_waveb(c, compiler, stamp, "shift-i64", "fn main {\n  n = 64i64\n  puts(1i64 << n)\n}\n", "avant runtime: shift amount 64 out of range for Int64 (0..63)")
    expect_trap_waveb(c, compiler, stamp, "shift-u64", "fn main {\n  n = 100u64\n  puts(1u64 >> n)\n}\n", "avant runtime: shift amount 100 out of range for UInt64 (0..63)")
    expect_trap_waveb(c, compiler, stamp, "to-i-nan", "fn main {\n  z = 0.0\n  puts((z / z).to_i)\n}\n", "avant runtime: to_i of Float64 nan out of range for Int")
    expect_trap_waveb(c, compiler, stamp, "to-i-big", "fn main {\n  x = 3.0e9\n  puts(x.to_i)\n}\n", "avant runtime: to_i of Float64 3000000000.0 out of range for Int")
    expect_compile_error(c, compiler, stamp, "shift-const-wide", "fn main {\n  x = 1\n  puts(x << 32)\n}\n", "shift amount 32 out of range for Int (0..31)")
    expect_compile_error(c, compiler, stamp, "shift-const-neg", "fn main {\n  x = 1\n  puts(x >> -1)\n}\n", "shift amount -1 out of range for Int (0..31)")
    expect_compile_error(c, compiler, stamp, "shift-const-u64", "fn main {\n  x = 1u64\n  puts(x << 64u64)\n}\n", "shift amount 64 out of range for UInt64 (0..63)")

    bad_src = "${scratch()}/safety-waveb-${stamp}-unknown.av"
    bad_bin = "${scratch()}/safety-waveb-${stamp}-unknown.bin"
    bad_log = "${scratch()}/safety-waveb-${stamp}-unknown.log"
    _ = file_write(bad_src, "fn main {\n  puts(nosuchfn(1))\n}\n")
    code_b = compile_av(compiler, bad_src, bad_bin, bad_log)
    c.expect(code_b != 0, "unknown-fn compile exits non-zero")
    c.expect(!file_exists(bad_bin), "unknown-fn bin absent")
    if err = file_read(bad_log) {
      c.expect(str_has(err, "unknown function"), "unknown-fn diagnostic")
    } else {
      c.expect(false, "unknown-fn diagnostic")
    }
    run_log = "${scratch()}/safety-waveb-${stamp}-unknown-run.log"
    code_r = run_av_cmd(compiler, bad_src, run_log)
    c.expect(code_r != 0, "unknown-fn run exits non-zero")

    hi_src = "${scratch()}/safety-waveb-${stamp}-hi.av"
    _ = file_write(hi_src, "fn main {\n  puts(\"hi\")\n}\n")
    dbg_bin = "${scratch()}/safety-waveb-${stamp}-hi-dbg.bin"
    dbg_log = "${scratch()}/safety-waveb-${stamp}-hi-dbg.log"
    dbg_flags: Array(String) = []
    dbg_flags.push("--debug")
    code_d = compile_av_flags(compiler, hi_src, dbg_bin, dbg_log, dbg_flags)
    c.expect(code_d == 0, "--debug compile exits zero")
    out_d = "${scratch()}/safety-waveb-${stamp}-hi-dbg.out"
    code_dr = run_av_bin(dbg_bin, out_d)
    c.expect(code_dr == 0, "--debug binary runs")
    if text = file_read(out_d) {
      c.expect(str_has(text, "hi"), "--debug binary output")
    } else {
      c.expect(false, "--debug binary output")
    }
    rel_bin = "${scratch()}/safety-waveb-${stamp}-hi-rel.bin"
    rel_log = "${scratch()}/safety-waveb-${stamp}-hi-rel.log"
    rel_flags: Array(String) = []
    rel_flags.push("--release")
    code_e = compile_av_flags(compiler, hi_src, rel_bin, rel_log, rel_flags)
    c.expect(code_e == 0, "--release compile exits zero")
    out_e = "${scratch()}/safety-waveb-${stamp}-hi-rel.out"
    code_er = run_av_bin(rel_bin, out_e)
    c.expect(code_er == 0, "--release binary runs")
    both_bin = "${scratch()}/safety-waveb-${stamp}-hi-both.bin"
    both_log = "${scratch()}/safety-waveb-${stamp}-hi-both.log"
    both_flags: Array(String) = []
    both_flags.push("--debug")
    both_flags.push("--release")
    code_f = compile_av_flags(compiler, hi_src, both_bin, both_log, both_flags)
    c.expect(code_f != 0, "--debug with --release exits non-zero")
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_safety(c)
  c.finish
}
