import harness
import std.fs
import std.process

fn run_format(compiler: String, cmd: String, src: String, log: String, flags: Array(String)): Int {
  args: Array(String) = []
  args.push(cmd)
  if src.size > 0 {
    args.push(src)
  }
  args.concat(flags)
  run_out(compiler, args, log) ?? -1
}

fn read_or_empty(path: String): String {
  if text = fs.read(path) {
    return text
  }
  ""
}

// The corpus pass (`format --write` or `--check` on the copied corpus).
// Under an outer AVANT_GC_STRESS (harness.gc_stress_outer) the
// formatter runs without it: with it this file took 71 s alone, 6 s
// without (the suite's bound of about 60 s a file); the formatter's own allocation
// under the stress mode is still run by the rest of this file.
fn format_corpus(compiler: String, dir: String, flag: String, log: String): Int {
  args: Array(String) = []
  if gc_stress_outer() {
    args.push("-u")
    args.push("AVANT_GC_STRESS")
  }
  args.push(compiler)
  args.push("format")
  args.push(dir)
  args.push(flag)
  run_out("/usr/bin/env", args, log) ?? -1
}

fn test_format(c: Checks) {
  c.suite("tests/cases/test_format.av")
  if compiler = process.env("AVANT_COMPILER") {
    c.expect(fs.exists(compiler), "AVANT_COMPILER exists")
    root = avant_test_root()
    stamp = now_ms()
    messy = "${root}/tests/fixtures/format/surface.av"
    want_path = "${root}/tests/fixtures/format/surface.want.av"
    log = "${scratch()}/format-${stamp}-surface.log"
    empty_flags: Array(String) = []
    code = run_format(compiler, "format", messy, log, empty_flags)
    c.eq_int(code, 0, "format surface exits 0")
    if got = fs.read(log) {
      if want = fs.read(want_path) {
        c.eq_str(got, want, "surface spacing")
        c.expect(got.contains("import zebra\nimport alpha"), "import order stays")
        c.expect(got.contains("fn (c: Counter) scaled"), "receiver keeps a space")
        c.expect(got.contains("f: fn(T): U"), "fn type stays tight")
        c.expect(got.contains("echo \\\${HOME}"), "string bytes stay")
        c.expect(got.contains("it costs $5"), "literal dollar stays")
        c.expect(got.contains("hello \${name}"), "interpolation is spaced")
        c.expect(got.contains("a \${x} b \${y} c"), "second interpolation is spaced")
        c.expect(got.contains("// file: fixture/demo.av\n"), "file directive line stays")
        c.expect(got.contains(" // file: inside.av\n"), "indented file directive stays")
        c.expect(got.contains("// greeting"), "comment stays")
        c.expect(got.contains("x = 1 //note"), "trailing comment stays")
        c.expect(got.contains("1 . 5"), "number dot number stays three tokens")
        c.expect(got.contains("n2 = 1.5"), "float token stays")
        c.expect(got.contains("! = 1"), "bang and eq stay apart")
        c.expect(got.contains("- = 1"), "minus and eq stay apart")
        c.expect(got.contains("ys: Array(Int) = []"), "array literal keeps a space")
        c.expect(got.contains("for i in 0..n {"), "for range spacing")
        c.expect(got.contains("for w in words {"), "for each spacing")
        c.expect(got.contains("pick = maybe ?? fallback"), "coalesce spacing")
        c.expect(got.contains("pin(s) {"), "pin spacing")
        c.expect(got.contains("  release(h.name)\n"), "release spacing")
        c.expect(got.contains("  j = (r % n) * 7919 % n\n"), "= keeps its space before a group")
        c.expect(got.contains("  j += (r % n)\n"), "+= keeps its space before a group")
        c.expect(got.contains("  j -= (r)\n"), "-= keeps its space before a group")
        c.expect(got.contains("  j *= (r)\n"), "*= keeps its space before a group")
        c.expect(got.contains("  k = a + (b * 2)\n"), "an operator keeps its space before a group")
        c.expect(got.contains("  eq = a == (b)\n"), "== keeps its space before a group")
        c.expect(got.contains("  and1 = ok && (a < b)\n"), "&& keeps its space before a group")
        c.expect(got.contains("  pair = foo(a, (b))\n"), "a comma keeps its space before a group")
        c.expect(got.contains("  pairs = [(a), (b)]\n"), "a group in an array literal")
        c.expect(got.contains("  if (a > b) { j = (a) }\n"), "a keyword keeps its space before a group")
        c.expect(got.contains("  neg = -(a)\n"), "prefix minus stays tight")
        c.expect(got.contains("raw = r\"C:\\tmp\\x\""), "raw string stays")
        c.expect(got.contains("xs[i] = f([])"), "index stays tight")
        c.expect(got.contains("} else {"), "same-line else gains spaces")
        c.expect(got.contains("}\n  else {"), "newline before else stays")
        c.expect(!got.contains("cannot read"), "format does not load imports")
      } else {
        c.expect(false, "read surface.want.av")
      }
    } else {
      c.expect(false, "read surface format")
    }

    check_flags: Array(String) = []
    check_flags.push("--check")
    check_log = "${scratch()}/format-${stamp}-check.log"
    check_code = run_format(compiler, "format", messy, check_log, check_flags)
    c.eq_int(check_code, 1, "check messy exits 1")
    if check_out = fs.read(check_log) {
      c.expect(check_out.contains("would change ${messy}"), "check reports drift")
    } else {
      c.expect(false, "read check log")
    }

    // The formatter keeps every line break, so the token that starts
    // each line, and with it where a statement begins, never changes.
    lead_src = "${scratch()}/format-${stamp}-lead.av"
    lead_log = "${scratch()}/format-${stamp}-lead.log"
    _ = fs.write(lead_src, "fn main {\nt = 1 +\n2\nxs = [\n1,\n-2\n]\n[1, 2].each (v) { puts(v) }\nm = t\n* 2\ny=-t\n-y\n}\n")
    lead_code = run_format(compiler, "format", lead_src, lead_log, empty_flags)
    c.eq_int(lead_code, 0, "format of lines that start with an operator exits 0")
    c.eq_str(read_or_empty(lead_log), "fn main {\n  t = 1 +\n  2\n  xs = [\n    1,\n    -2\n  ]\n  [1, 2].each (v) { puts(v) }\n  m = t\n  * 2\n  y = -t\n  -y\n}\n", "format keeps the first token of every line")
    // A block in pipes is not Avant, so the formatter gives `|` no
    // meaning as a lambda's parameters: it is spaced as the operator,
    // and a lambda's own parameters are in parentheses.
    pipes_src = "${scratch()}/format-${stamp}-pipes.av"
    pipes_log = "${scratch()}/format-${stamp}-pipes.log"
    _ = fs.write(pipes_src, "fn main {\nxs.each { |x| puts(x) }\nxs.each (x) { puts(x|1) }\n}\n")
    pipes_code = run_format(compiler, "format", pipes_src, pipes_log, empty_flags)
    c.eq_int(pipes_code, 0, "format of a block in pipes exits 0")
    c.eq_str(read_or_empty(pipes_log), "fn main {\n  xs.each { | x | puts(x) }\n  xs.each (x) { puts(x | 1) }\n}\n", "format gives pipes no lambda meaning")
    // `pub` before a field formats like `pub` before fn.
    pubf_src = "${scratch()}/format-${stamp}-pubf.av"
    pubf_log = "${scratch()}/format-${stamp}-pubf.log"
    _ = fs.write(pubf_src, "pub struct P {\n    pub   x :Int\nkept: Int = 2\n  pub fn get: Int { x }\n}\n")
    pubf_code = run_format(compiler, "format", pubf_src, pubf_log, empty_flags)
    c.eq_int(pubf_code, 0, "format pub fields exits 0")
    c.eq_str(read_or_empty(pubf_log), "pub struct P {\n  pub x: Int\n  kept: Int = 2\n  pub fn get: Int { x }\n}\n", "format pub fields")
    nl_log = "${scratch()}/format-${stamp}-newlines.log"
    nl_code = run_format(compiler, "format", "${root}/tests/fixtures/syntax/newlines.av", nl_log, check_flags)
    c.eq_int(nl_code, 0, "newlines fixture format exits 0")
    c.expect(read_or_empty(nl_log).contains("canonical"), "newlines fixture is canonical")

    canon_log = "${scratch()}/format-${stamp}-canon.log"
    canon_code = run_format(compiler, "f", want_path, canon_log, check_flags)
    c.eq_int(canon_code, 0, "f --check exits 0")
    if canon_out = fs.read(canon_log) {
      c.eq_str(canon_out, "canonical\n", "want file is canonical")
    } else {
      c.expect(false, "read canonical log")
    }

    copy = "${scratch()}/format-${stamp}-copy.av"
    if body = fs.read(want_path) {
      c.wrote(fs.write(copy, body), "write copy")
      write_flags: Array(String) = []
      write_flags.push("--write")
      write_log = "${scratch()}/format-${stamp}-write.log"
      write_code = run_format(compiler, "format", copy, write_log, write_flags)
      c.eq_int(write_code, 0, "write canonical exits 0")
      c.eq_str(read_or_empty(write_log), "", "write is silent")
      if again = fs.read(copy) {
        c.eq_str(again, body, "format is idempotent")
      } else {
        c.expect(false, "read written copy")
      }
      both: Array(String) = []
      both.push("--check")
      both.push("--write")
      both_log = "${scratch()}/format-${stamp}-both.log"
      dirty = "${scratch()}/format-${stamp}-dirty.av"
      c.wrote(fs.write(dirty, "fn main{\n}\n"), "write dirty")
      both_code = run_format(compiler, "format", dirty, both_log, both)
      c.eq_int(both_code, 1, "--check with --write is a usage error and exits 1")
      if still = fs.read(dirty) {
        c.eq_str(still, "fn main{\n}\n", "check does not write")
      } else {
        c.expect(false, "read dirty")
      }
    } else {
      c.expect(false, "read want for idempotence")
    }

    op_src = "${scratch()}/format-${stamp}-op.av"
    op_body = "fn (v:Vec2) +(other:Vec2):Vec2{\nv\n}\n"
    c.wrote(fs.write(op_src, op_body), "write operator receiver")
    op_log = "${scratch()}/format-${stamp}-op.log"
    op_code = run_format(compiler, "format", op_src, op_log, empty_flags)
    c.eq_int(op_code, 0, "format operator receiver")
    if op = fs.read(op_log) {
      c.eq_str(op, "fn (v: Vec2) +(other: Vec2): Vec2 {\n  v\n}\n", "operator receiver")
    } else {
      c.expect(false, "read operator receiver")
    }

    tab_src = "${scratch()}/format-${stamp}-tab.av"
    tab_body = "fn main {\n\tx = 1\n}\n"
    c.wrote(fs.write(tab_src, tab_body), "write tab")
    tab_log = "${scratch()}/format-${stamp}-tab.log"
    tab_code = run_format(compiler, "format", tab_src, tab_log, empty_flags)
    c.eq_int(tab_code, 0, "format tab")
    if tab = fs.read(tab_log) {
      c.eq_str(tab, "fn main {\n  x = 1\n}\n", "tab becomes two spaces")
    } else {
      c.expect(false, "read tab")
    }

    blank_src = "${scratch()}/format-${stamp}-blank.av"
    blank_body = "fn a {\n}\n\n\n\nfn b {\n}\n"
    c.wrote(fs.write(blank_src, blank_body), "write blanks")
    blank_log = "${scratch()}/format-${stamp}-blank.log"
    blank_code = run_format(compiler, "format", blank_src, blank_log, empty_flags)
    c.eq_int(blank_code, 0, "format blanks")
    if blanks = fs.read(blank_log) {
      c.eq_str(blanks, "fn a {\n}\n\nfn b {\n}\n", "blank lines collapse to one")
    } else {
      c.expect(false, "read blanks")
    }

    tail_src = "${scratch()}/format-${stamp}-tail.av"
    tail_body = "fn main {\n}"
    c.wrote(fs.write(tail_src, tail_body), "write no trailing newline")
    tail_flags: Array(String) = []
    tail_flags.push("--write")
    tail_log = "${scratch()}/format-${stamp}-tail.log"
    tail_code = run_format(compiler, "format", tail_src, tail_log, tail_flags)
    c.eq_int(tail_code, 0, "write no trailing newline exits 0")
    if tail = fs.read(tail_src) {
      c.eq_str(tail, "fn main {\n}", "author newline is kept")
    } else {
      c.expect(false, "read no trailing newline")
    }

    empty_src = "${scratch()}/format-${stamp}-empty.av"
    c.wrote(fs.write(empty_src, ""), "write empty")
    empty_log = "${scratch()}/format-${stamp}-empty.log"
    empty_code = run_format(compiler, "format", empty_src, empty_log, empty_flags)
    c.eq_int(empty_code, 0, "format empty")
    c.eq_str(read_or_empty(empty_log), "", "empty file prints nothing")

    bad_src = "${scratch()}/format-${stamp}-bad.av"
    bad_body = "fn main { @ }\n"
    c.wrote(fs.write(bad_src, bad_body), "write lex error")
    bad_log = "${scratch()}/format-${stamp}-bad.log"
    bad_flags: Array(String) = []
    bad_flags.push("--write")
    bad_code = run_format(compiler, "format", bad_src, bad_log, bad_flags)
    c.eq_int(bad_code, 1, "lex error exits 1")
    if bad = fs.read(bad_log) {
      c.expect(bad.contains("unexpected character"), "lex error diagnostic")
      c.expect(!bad.contains("would change"), "lex error is not a diff")
    } else {
      c.expect(false, "read lex error")
    }
    if bad_file = fs.read(bad_src) {
      c.eq_str(bad_file, bad_body, "lex error does not write")
    } else {
      c.expect(false, "read bad file")
    }

    str_src = "${scratch()}/format-${stamp}-str.av"
    c.wrote(fs.write(str_src, "fn main {\n  s = \"hi\n}\n"), "write unterminated string")
    str_log = "${scratch()}/format-${stamp}-str.log"
    str_code = run_format(compiler, "format", str_src, str_log, empty_flags)
    c.eq_int(str_code, 1, "unterminated string exits 1")
    if str_err = fs.read(str_log) {
      c.expect(str_err.contains("unterminated string"), "unterminated string diagnostic")
    } else {
      c.expect(false, "read unterminated string")
    }

    // A string that interpolates inside an interpolation is formatted
    // as written.
    nest_src = "${scratch()}/format-${stamp}-nest.av"
    nest_body = "fn main {\n  x = 1\n  s = \"a \${\"b \${x + 1}\"} c\"\n  puts(s)\n}\n"
    c.wrote(fs.write(nest_src, nest_body), "write nested interpolation")
    nest_log = "${scratch()}/format-${stamp}-nest.log"
    nest_code = run_format(compiler, "format", nest_src, nest_log, empty_flags)
    c.eq_int(nest_code, 0, "nested interpolation formats")
    if nest = fs.read(nest_src) {
      c.eq_str(nest, nest_body, "nested interpolation is kept as written")
    } else {
      c.expect(false, "read nested interpolation")
    }

    esc_src = "${scratch()}/format-${stamp}-esc.av"
    c.wrote(fs.write(esc_src, "fn main {\n  s = \"\\q\"\n}\n"), "write bad escape")
    esc_log = "${scratch()}/format-${stamp}-esc.log"
    esc_code = run_format(compiler, "format", esc_src, esc_log, empty_flags)
    c.eq_int(esc_code, 1, "bad escape exits 1")
    if esc = fs.read(esc_log) {
      c.expect(esc.contains("unknown string escape"), "bad escape diagnostic")
    } else {
      c.expect(false, "read bad escape")
    }

    dump_src = "${scratch()}/format-${stamp}-dump.av"
    dump_body = "fn main{\nputs( \"ok\" )\n}\n"
    c.wrote(fs.write(dump_src, dump_body), "write dump fixture")
    // The emitted .ll (no source locations, unlike the MIR dump; the old
    // back end's IR until it retired): formatting changes no code.
    before = "${scratch()}/format-${stamp}-before.ll"
    after = "${scratch()}/format-${stamp}-after.ll"
    before_code = emit_ll(compiler, dump_src, before, "${before}.log")
    c.eq_int(before_code, 0, "dump before format")
    dump_flags: Array(String) = []
    dump_flags.push("--write")
    dump_log = "${scratch()}/format-${stamp}-dump.log"
    dump_fmt = run_format(compiler, "format", dump_src, dump_log, dump_flags)
    c.eq_int(dump_fmt, 0, "format dump fixture")
    if dumped = fs.read(dump_src) {
      c.eq_str(dumped, "fn main {\n  puts(\"ok\")\n}\n", "dump fixture spacing")
    } else {
      c.expect(false, "read dump fixture")
    }
    after_code = emit_ll(compiler, dump_src, after, "${after}.log")
    c.eq_int(after_code, 0, "dump after format")
    if ir0 = fs.read(before) {
      if ir1 = fs.read(after) {
        c.eq_str(ir0, ir1, "the emitted .ll is unchanged")
      } else {
        c.expect(false, "read dump after")
      }
    } else {
      c.expect(false, "read dump before")
    }

    missing_log = "${scratch()}/format-${stamp}-missing.log"
    missing = "${scratch()}/format-${stamp}-missing.av"
    missing_code = run_format(compiler, "format", missing, missing_log, empty_flags)
    c.eq_int(missing_code, 1, "missing file exits 1")
    if missing_out = fs.read(missing_log) {
      c.expect(missing_out.contains("cannot read ${missing}"), "missing file diagnostic")
    } else {
      c.expect(false, "read missing log")
    }

    two_log = "${scratch()}/format-${stamp}-two.log"
    two_flags: Array(String) = []
    two_flags.push(want_path)
    two_code = run_format(compiler, "format", messy, two_log, two_flags)
    c.eq_int(two_code, 1, "two files without --check or --write exit 1")
    if two = fs.read(two_log) {
      c.expect(two.contains("format prints one file; use --check or --write"), "two files diagnostic")
    } else {
      c.expect(false, "read two files")
    }

    none_log = "${scratch()}/format-${stamp}-none.log"
    none_code = run_format(compiler, "format", "", none_log, empty_flags)
    c.eq_int(none_code, 1, "format with no file exits 1")
    if none = fs.read(none_log) {
      c.expect(none.contains("format needs a .av file"), "format needs a file")
      c.expect(none.contains("avant format PATH... [--check|--write]"), "usage lists format and names avant")
      c.expect(!none.contains("avant-av"), "usage does not say avant-av")
    } else {
      c.expect(false, "read usage")
    }

    // Several files and directories.
    many = "${scratch()}/format-${stamp}-many"
    mkdir_p("${many}/sub")
    mkdir_p("${many}/deps")
    mkdir_p("${many}/.hidden")
    _ = fs.write("${many}/a.av", "fn main {\n}\n")
    _ = fs.write("${many}/sub/b.av", "fn main{\n}\n")
    _ = fs.write("${many}/deps/c.av", "fn main{\n}\n")
    _ = fs.write("${many}/.hidden/d.av", "fn main{\n}\n")
    _ = fs.write("${many}/sub/e.av", "fn main{\n}\n")
    // Symbolic links to directories are not followed: one leads out of
    // the tree, one back into it (a cycle the walk must not enter).
    outside = "${scratch()}/format-${stamp}-outside"
    mkdir_p(outside)
    _ = fs.write("${outside}/x.av", "fn main{\n}\n")
    _ = process.run("/bin/ln", ["-s", outside, "${many}/linked"])
    _ = process.run("/bin/ln", ["-s", many, "${many}/sub/loop"])
    dir_log = "${scratch()}/format-${stamp}-dir.log"
    dir_code = run_format(compiler, "format", many, dir_log, check_flags)
    c.eq_int(dir_code, 1, "a directory with drift: --check exits 1")
    c.eq_str(read_or_empty(dir_log), "would change ${many}/sub/b.av\nwould change ${many}/sub/e.av\n", "a directory is walked in order, skipping deps, dot names and links to directories")
    pair_log = "${scratch()}/format-${stamp}-pair.log"
    pair_flags: Array(String) = []
    pair_flags.push("${many}/sub/b.av")
    pair_flags.push("--check")
    pair_code = run_format(compiler, "format", "${many}/a.av", pair_log, pair_flags)
    c.eq_int(pair_code, 1, "two files with one drift: --check exits 1")
    c.eq_str(read_or_empty(pair_log), "would change ${many}/sub/b.av\n", "two files: only the changed one is listed")
    mw_log = "${scratch()}/format-${stamp}-many-write.log"
    mw_flags: Array(String) = []
    mw_flags.push("--write")
    mw_code = run_format(compiler, "format", many, mw_log, mw_flags)
    c.eq_int(mw_code, 0, "a directory: --write exits 0")
    c.eq_str(read_or_empty("${many}/sub/b.av"), "fn main {\n}\n", "--write rewrites a walked file")
    c.eq_str(read_or_empty("${many}/deps/c.av"), "fn main{\n}\n", "--write skips deps")
    c.eq_str(read_or_empty("${outside}/x.av"), "fn main{\n}\n", "--write does not follow a link to a directory")
    mc_log = "${scratch()}/format-${stamp}-many-clean.log"
    mc_code = run_format(compiler, "format", many, mc_log, check_flags)
    c.eq_int(mc_code, 0, "a canonical directory: --check exits 0")
    c.eq_str(read_or_empty(mc_log), "canonical\n", "a canonical directory prints canonical")
    nd_log = "${scratch()}/format-${stamp}-notav.log"
    nd_code = run_format(compiler, "format", "${many}/missing.txt", nd_log, check_flags)
    c.eq_int(nd_code, 1, "a path that is neither .av nor a directory exits 1")

    // Two tokens printed side by side stay two tokens:
    // before, `. ..` became `...`, `? ?` became `??`, `! ==`
    // became `!==` (`!=` and `=`) and `- ==` became `-==`.
    join_src = "${scratch()}/format-${stamp}-join.av"
    c.wrote(fs.write(join_src, "fn main {\n  a = b . ..c\n  d = e ?? ? ?\n  f = ! ==\n  g = - ==\n  h = 5. ..k\n  m = n ?. ..<\n}\n"), "write joining tokens")
    join_log = "${scratch()}/format-${stamp}-join.log"
    join_code = run_format(compiler, "format", join_src, join_log, empty_flags)
    c.eq_int(join_code, 0, "joining tokens: format exits 0")
    c.eq_str(read_or_empty(join_log), "fn main {\n  a = b. ..c\n  d = e ??? ?\n  f = ! ==\n  g = - ==\n  h = 5. ..k\n  m = n?. ..<\n}\n", "tokens that would join keep a space between them")

    // The self-check: the canonical text is
    // lexed by the compiler's lexer and must give the source's tokens
    // and line breaks; AVANT_FORMAT_FAULT (the suite's only) breaks the
    // reprint on purpose, and the file is left as it is.
    fault_body = "fn main {\n  x = 1\n  puts(x)\n}\n"
    faults = ["line", "space"]
    fault_needles = ["a line break would become `x`", "`fn` would become `fnmain`"]
    for fi in 0..faults.size {
      fault = faults[fi]
      fault_src = "${scratch()}/format-${stamp}-fault-${fault}.av"
      c.wrote(fs.write(fault_src, fault_body), "write fault ${fault}")
      fault_log = "${scratch()}/format-${stamp}-fault-${fault}.log"
      fault_args = ["AVANT_FORMAT_FAULT=${fault}", compiler, "format", fault_src, "--write"]
      fault_code = run_out("/usr/bin/env", fault_args, fault_log) ?? -1
      c.eq_int(fault_code, 1, "self-check (${fault}): format exits 1")
      fault_out = read_or_empty(fault_log)
      c.expect(fault_out.contains("format would change this program"), "self-check (${fault}): the error says so")
      c.expect(fault_out.contains(fault_needles[fi]), "self-check (${fault}): the error names the token")
      c.eq_str(read_or_empty(fault_src), fault_body, "self-check (${fault}): the file is left as it is")
    }

    // The corpus formatted twice (Valk's fmt/corpus.sh): every
    // source of the repository is formatted, each through the
    // self-check, and the result formatted again changes nothing
    // (the one non-canonical source, surface.av, included).
    corpus = "${scratch()}/format-${stamp}-corpus"
    mkdir_p(corpus)
    tar_args = ["-c", "cd '${root}' && find compiler lib examples bench tests -name '*.av' | tar cf - -T - | tar xf - -C '${corpus}'"]
    tar_code = run_out("/bin/sh", tar_args, "${corpus}.tar.log") ?? -1
    c.eq_int(tar_code, 0, "copy the corpus")
    cw_log = "${scratch()}/format-${stamp}-corpus-write.log"
    cw_code = format_corpus(compiler, corpus, "--write", cw_log)
    c.eq_int(cw_code, 0, "the corpus: format --write exits 0 (every self-check holds)")
    c.eq_str(read_or_empty(cw_log), "", "the corpus: format --write reports nothing")
    cc_log = "${scratch()}/format-${stamp}-corpus-check.log"
    cc_code = format_corpus(compiler, corpus, "--check", cc_log)
    c.eq_int(cc_code, 0, "the corpus formatted twice: --check exits 0")
    c.eq_str(read_or_empty(cc_log), "canonical\n", "the corpus formatted twice: the second pass changes nothing")
    c.eq_str(read_or_empty("${corpus}/tests/fixtures/format/surface.av"), read_or_empty(want_path), "the corpus: surface.av formats to its golden")
    rm_rf(corpus)
    rm_f("${corpus}.tar.log")

    flag_log = "${scratch()}/format-${stamp}-flag.log"
    flag_flags: Array(String) = []
    flag_flags.push("--nope")
    flag_code = run_format(compiler, "format", want_path, flag_log, flag_flags)
    c.eq_int(flag_code, 1, "unknown flag exits 1")
    if flag = fs.read(flag_log) {
      c.expect(flag.contains("unknown format argument --nope"), "unknown flag diagnostic")
    } else {
      c.expect(false, "read unknown flag")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_format(c)
  c.finish()
}
