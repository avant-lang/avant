import harness

fn run_format(compiler: String, cmd: String, src: String, log: String, flags: Array(String)): Int {
  args: Array(String) = []
  args.push(cmd)
  if src.size > 0 {
    args.push(src)
  }
  i = 0
  while i < flags.size {
    args.push(flags[i])
    i += 1
  }
  process_run_out(compiler, args, log)
}

fn read_or_empty(path: String): String {
  if text = file_read(path) {
    return text
  }
  ""
}

fn test_format(c: Checks) {
  c.suite("tests/cases/test_format.av")
  if compiler = env_get("AVANT_COMPILER") {
    c.expect(file_exists(compiler), "AVANT_COMPILER exists")
    root = avant_test_root()
    stamp = now_ms()
    messy = "${root}/tests/fixtures/format/surface.av"
    want_path = "${root}/tests/fixtures/format/surface.want.av"
    log = "${scratch()}/format-${stamp}-surface.log"
    empty_flags: Array(String) = []
    code = run_format(compiler, "format", messy, log, empty_flags)
    c.eq_int(code, 0, "format surface exits 0")
    if got = file_read(log) {
      if want = file_read(want_path) {
        c.eq_str(got, want, "surface spacing")
        c.expect(str_has(got, "import zebra\nimport alpha"), "import order stays")
        c.expect(str_has(got, "fn (c: Counter) scaled"), "receiver keeps a space")
        c.expect(str_has(got, "f: fn(T): U"), "fn type stays tight")
        c.expect(str_has(got, "echo \\\${HOME}"), "string bytes stay")
        c.expect(str_has(got, "it costs $5"), "literal dollar stays")
        c.expect(str_has(got, "hello \${name}"), "interpolation is spaced")
        c.expect(str_has(got, "a \${x} b \${y} c"), "second interpolation is spaced")
        c.expect(str_has(got, "// file: fixture/demo.av\n"), "file directive line stays")
        c.expect(str_has(got, " // file: inside.av\n"), "indented file directive stays")
        c.expect(str_has(got, "// greeting"), "comment stays")
        c.expect(str_has(got, "x = 1 //note"), "trailing comment stays")
        c.expect(str_has(got, "1 . 5"), "number dot number stays three tokens")
        c.expect(str_has(got, "n2 = 1.5"), "float token stays")
        c.expect(str_has(got, "! = 1"), "bang and eq stay apart")
        c.expect(str_has(got, "- = 1"), "minus and eq stay apart")
        c.expect(str_has(got, "ys: Array(Int) = []"), "array literal keeps a space")
        c.expect(str_has(got, "for i in 0..n {"), "for range spacing")
        c.expect(str_has(got, "for w in words {"), "for each spacing")
        c.expect(str_has(got, "pick = maybe ?? fallback"), "coalesce spacing")
        c.expect(str_has(got, "pin(s) {"), "pin spacing")
        c.expect(str_has(got, "  release(h.name)\n"), "release spacing")
        c.expect(str_has(got, "  j = (r % n) * 7919 % n\n"), "= keeps its space before a group")
        c.expect(str_has(got, "  j += (r % n)\n"), "+= keeps its space before a group")
        c.expect(str_has(got, "  j -= (r)\n"), "-= keeps its space before a group")
        c.expect(str_has(got, "  j *= (r)\n"), "*= keeps its space before a group")
        c.expect(str_has(got, "  k = a + (b * 2)\n"), "an operator keeps its space before a group")
        c.expect(str_has(got, "  eq = a == (b)\n"), "== keeps its space before a group")
        c.expect(str_has(got, "  and1 = ok && (a < b)\n"), "&& keeps its space before a group")
        c.expect(str_has(got, "  pair = foo(a, (b))\n"), "a comma keeps its space before a group")
        c.expect(str_has(got, "  pairs = [(a), (b)]\n"), "a group in an array literal")
        c.expect(str_has(got, "  if (a > b) { j = (a) }\n"), "a keyword keeps its space before a group")
        c.expect(str_has(got, "  neg = -(a)\n"), "prefix minus stays tight")
        c.expect(str_has(got, "raw = r\"C:\\tmp\\x\""), "raw string stays")
        c.expect(str_has(got, "xs[i] = f([])"), "index stays tight")
        c.expect(str_has(got, "} else {"), "same-line else gains spaces")
        c.expect(str_has(got, "}\n  else {"), "newline before else stays")
        c.expect(!str_has(got, "cannot read"), "format does not load imports")
      } else {
        c.expect(false, "read surface.want.av")
      }
    } else {
      c.expect(false, "read surface format")
    }

    check_flags: Array(String) = []
    check_flags.push("--check")
    check_log = "${scratch()}/format-${stamp}-check.log"
    check_code = run_format(compiler, "format", messy, check_log, check_flags)
    c.eq_int(check_code, 1, "check messy exits 1 (D49, Stage 29 W1b)")
    if check_out = file_read(check_log) {
      c.expect(str_has(check_out, "would change ${messy}"), "check reports drift")
    } else {
      c.expect(false, "read check log")
    }

    // D280: the formatter keeps every line break, so the token that starts
    // each line, and with it where a statement begins, never changes.
    d280_src = "${scratch()}/format-${stamp}-d280.av"
    d280_log = "${scratch()}/format-${stamp}-d280.log"
    file_write(d280_src, "fn main {\nt = 1 +\n2\nxs = [\n1,\n-2\n]\n[1, 2].each { |v| puts(v) }\nm = t\n* 2\ny=-t\n-y\n}\n")
    d280_code = run_format(compiler, "format", d280_src, d280_log, empty_flags)
    c.eq_int(d280_code, 0, "format D280 lines exits 0")
    c.eq_str(read_or_empty(d280_log), "fn main {\n  t = 1 +\n  2\n  xs = [\n  1,\n  -2\n  ]\n  [1, 2].each { |v| puts(v) }\n  m = t\n  * 2\n  y = -t\n  -y\n}\n", "format keeps the first token of every line (D280)")
    // Stage 29 W3a (D299): `pub` before a field formats like `pub` before fn.
    pubf_src = "${scratch()}/format-${stamp}-pubf.av"
    pubf_log = "${scratch()}/format-${stamp}-pubf.log"
    file_write(pubf_src, "pub struct P {\n    pub   x :Int\nkept: Int = 2\n  pub fn get: Int { x }\n}\n")
    pubf_code = run_format(compiler, "format", pubf_src, pubf_log, empty_flags)
    c.eq_int(pubf_code, 0, "format pub fields exits 0")
    c.eq_str(read_or_empty(pubf_log), "pub struct P {\n  pub x: Int\n  kept: Int = 2\n  pub fn get: Int { x }\n}\n", "format pub fields")
    nl_log = "${scratch()}/format-${stamp}-newlines.log"
    nl_code = run_format(compiler, "format", "${root}/tests/fixtures/syntax/newlines.av", nl_log, check_flags)
    c.eq_int(nl_code, 0, "newlines fixture format exits 0")
    c.expect(str_has(read_or_empty(nl_log), "canonical"), "newlines fixture is canonical")

    canon_log = "${scratch()}/format-${stamp}-canon.log"
    canon_code = run_format(compiler, "f", want_path, canon_log, check_flags)
    c.eq_int(canon_code, 0, "f --check exits 0")
    if canon_out = file_read(canon_log) {
      c.eq_str(canon_out, "canonical\n", "want file is canonical")
    } else {
      c.expect(false, "read canonical log")
    }

    copy = "${scratch()}/format-${stamp}-copy.av"
    if body = file_read(want_path) {
      wcopy = file_write(copy, body)
      c.eq_int(wcopy, 0, "write copy")
      write_flags: Array(String) = []
      write_flags.push("--write")
      write_log = "${scratch()}/format-${stamp}-write.log"
      write_code = run_format(compiler, "format", copy, write_log, write_flags)
      c.eq_int(write_code, 0, "write canonical exits 0")
      c.eq_str(read_or_empty(write_log), "", "write is silent")
      if again = file_read(copy) {
        c.eq_str(again, body, "format is idempotent")
      } else {
        c.expect(false, "read written copy")
      }
      both: Array(String) = []
      both.push("--check")
      both.push("--write")
      both_log = "${scratch()}/format-${stamp}-both.log"
      dirty = "${scratch()}/format-${stamp}-dirty.av"
      wdirty = file_write(dirty, "fn main{\n}\n")
      c.eq_int(wdirty, 0, "write dirty")
      both_code = run_format(compiler, "format", dirty, both_log, both)
      c.eq_int(both_code, 1, "--check with --write is a usage error and exits 1")
      if still = file_read(dirty) {
        c.eq_str(still, "fn main{\n}\n", "check does not write")
      } else {
        c.expect(false, "read dirty")
      }
    } else {
      c.expect(false, "read want for idempotence")
    }

    op_src = "${scratch()}/format-${stamp}-op.av"
    op_body = "fn (v:Vec2) +(other:Vec2):Vec2{\nv\n}\n"
    wop = file_write(op_src, op_body)
    c.eq_int(wop, 0, "write operator receiver")
    op_log = "${scratch()}/format-${stamp}-op.log"
    op_code = run_format(compiler, "format", op_src, op_log, empty_flags)
    c.eq_int(op_code, 0, "format operator receiver")
    if op = file_read(op_log) {
      c.eq_str(op, "fn (v: Vec2) +(other: Vec2): Vec2 {\n  v\n}\n", "operator receiver")
    } else {
      c.expect(false, "read operator receiver")
    }

    tab_src = "${scratch()}/format-${stamp}-tab.av"
    tab_body = "fn main {\n\tx = 1\n}\n"
    wtab = file_write(tab_src, tab_body)
    c.eq_int(wtab, 0, "write tab")
    tab_log = "${scratch()}/format-${stamp}-tab.log"
    tab_code = run_format(compiler, "format", tab_src, tab_log, empty_flags)
    c.eq_int(tab_code, 0, "format tab")
    if tab = file_read(tab_log) {
      c.eq_str(tab, "fn main {\n  x = 1\n}\n", "tab becomes two spaces")
    } else {
      c.expect(false, "read tab")
    }

    blank_src = "${scratch()}/format-${stamp}-blank.av"
    blank_body = "fn a {\n}\n\n\n\nfn b {\n}\n"
    wblank = file_write(blank_src, blank_body)
    c.eq_int(wblank, 0, "write blanks")
    blank_log = "${scratch()}/format-${stamp}-blank.log"
    blank_code = run_format(compiler, "format", blank_src, blank_log, empty_flags)
    c.eq_int(blank_code, 0, "format blanks")
    if blanks = file_read(blank_log) {
      c.eq_str(blanks, "fn a {\n}\n\nfn b {\n}\n", "blank lines collapse to one")
    } else {
      c.expect(false, "read blanks")
    }

    tail_src = "${scratch()}/format-${stamp}-tail.av"
    tail_body = "fn main {\n}"
    wtail = file_write(tail_src, tail_body)
    c.eq_int(wtail, 0, "write no trailing newline")
    tail_flags: Array(String) = []
    tail_flags.push("--write")
    tail_log = "${scratch()}/format-${stamp}-tail.log"
    tail_code = run_format(compiler, "format", tail_src, tail_log, tail_flags)
    c.eq_int(tail_code, 0, "write no trailing newline exits 0")
    if tail = file_read(tail_src) {
      c.eq_str(tail, "fn main {\n}", "author newline is kept")
    } else {
      c.expect(false, "read no trailing newline")
    }

    empty_src = "${scratch()}/format-${stamp}-empty.av"
    wempty = file_write(empty_src, "")
    c.eq_int(wempty, 0, "write empty")
    empty_log = "${scratch()}/format-${stamp}-empty.log"
    empty_code = run_format(compiler, "format", empty_src, empty_log, empty_flags)
    c.eq_int(empty_code, 0, "format empty")
    c.eq_str(read_or_empty(empty_log), "", "empty file prints nothing")

    bad_src = "${scratch()}/format-${stamp}-bad.av"
    bad_body = "fn main { @ }\n"
    wbad = file_write(bad_src, bad_body)
    c.eq_int(wbad, 0, "write lex error")
    bad_log = "${scratch()}/format-${stamp}-bad.log"
    bad_flags: Array(String) = []
    bad_flags.push("--write")
    bad_code = run_format(compiler, "format", bad_src, bad_log, bad_flags)
    c.eq_int(bad_code, 1, "lex error exits 1")
    if bad = file_read(bad_log) {
      c.expect(str_has(bad, "unexpected character"), "lex error diagnostic")
      c.expect(!str_has(bad, "would change"), "lex error is not a diff")
    } else {
      c.expect(false, "read lex error")
    }
    if bad_file = file_read(bad_src) {
      c.eq_str(bad_file, bad_body, "lex error does not write")
    } else {
      c.expect(false, "read bad file")
    }

    str_src = "${scratch()}/format-${stamp}-str.av"
    wstr = file_write(str_src, "fn main {\n  s = \"hi\n}\n")
    c.eq_int(wstr, 0, "write unterminated string")
    str_log = "${scratch()}/format-${stamp}-str.log"
    str_code = run_format(compiler, "format", str_src, str_log, empty_flags)
    c.eq_int(str_code, 1, "unterminated string exits 1")
    if str_err = file_read(str_log) {
      c.expect(str_has(str_err, "unterminated string"), "unterminated string diagnostic")
    } else {
      c.expect(false, "read unterminated string")
    }

    nest_src = "${scratch()}/format-${stamp}-nest.av"
    nest_body = "fn main {\n  s = \"\${\"\${x}\"}\"\n}\n"
    wnest = file_write(nest_src, nest_body)
    c.eq_int(wnest, 0, "write nested interpolation")
    nest_log = "${scratch()}/format-${stamp}-nest.log"
    nest_code = run_format(compiler, "format", nest_src, nest_log, empty_flags)
    c.eq_int(nest_code, 1, "nested interpolation exits 1")
    if nest = file_read(nest_log) {
      c.expect(str_has(nest, "nested string interpolation"), "nested interpolation diagnostic")
    } else {
      c.expect(false, "read nested interpolation")
    }

    esc_src = "${scratch()}/format-${stamp}-esc.av"
    wesc = file_write(esc_src, "fn main {\n  s = \"\\q\"\n}\n")
    c.eq_int(wesc, 0, "write bad escape")
    esc_log = "${scratch()}/format-${stamp}-esc.log"
    esc_code = run_format(compiler, "format", esc_src, esc_log, empty_flags)
    c.eq_int(esc_code, 1, "bad escape exits 1")
    if esc = file_read(esc_log) {
      c.expect(str_has(esc, "unknown string escape"), "bad escape diagnostic")
    } else {
      c.expect(false, "read bad escape")
    }

    dump_src = "${scratch()}/format-${stamp}-dump.av"
    dump_body = "fn main{\nputs( \"ok\" )\n}\n"
    wdump = file_write(dump_src, dump_body)
    c.eq_int(wdump, 0, "write dump fixture")
    // The emitted .ll (no source locations, unlike the MIR dump; the old
    // back end's IR until Stage 28 W11): formatting changes no code.
    before = "${scratch()}/format-${stamp}-before.ll"
    after = "${scratch()}/format-${stamp}-after.ll"
    before_code = emit_ll(compiler, dump_src, before, "${before}.log")
    c.eq_int(before_code, 0, "dump before format")
    dump_flags: Array(String) = []
    dump_flags.push("--write")
    dump_log = "${scratch()}/format-${stamp}-dump.log"
    dump_fmt = run_format(compiler, "format", dump_src, dump_log, dump_flags)
    c.eq_int(dump_fmt, 0, "format dump fixture")
    if dumped = file_read(dump_src) {
      c.eq_str(dumped, "fn main {\n  puts(\"ok\")\n}\n", "dump fixture spacing")
    } else {
      c.expect(false, "read dump fixture")
    }
    after_code = emit_ll(compiler, dump_src, after, "${after}.log")
    c.eq_int(after_code, 0, "dump after format")
    if ir0 = file_read(before) {
      if ir1 = file_read(after) {
        c.eq_str(ir0, ir1, "the emitted .ll is unchanged")
      } else {
        c.expect(false, "read dump after")
      }
    } else {
      c.expect(false, "read dump before")
    }

    missing_log = "${scratch()}/format-${stamp}-missing.log"
    missing = "${scratch()}/format-${stamp}-missing.av"
    missing_code = run_format(compiler, "format", missing, missing_log, empty_flags)
    c.eq_int(missing_code, 1, "missing file exits 1")
    if missing_out = file_read(missing_log) {
      c.expect(str_has(missing_out, "cannot read ${missing}"), "missing file diagnostic")
    } else {
      c.expect(false, "read missing log")
    }

    two_log = "${scratch()}/format-${stamp}-two.log"
    two_flags: Array(String) = []
    two_flags.push(want_path)
    two_code = run_format(compiler, "format", messy, two_log, two_flags)
    c.eq_int(two_code, 1, "two files without --check or --write exit 1")
    if two = file_read(two_log) {
      c.expect(str_has(two, "format prints one file; use --check or --write"), "two files diagnostic")
    } else {
      c.expect(false, "read two files")
    }

    none_log = "${scratch()}/format-${stamp}-none.log"
    none_code = run_format(compiler, "format", "", none_log, empty_flags)
    c.eq_int(none_code, 1, "format with no file exits 1")
    if none = file_read(none_log) {
      c.expect(str_has(none, "format needs a .av file"), "format needs a file")
      c.expect(str_has(none, "avant format PATH... [--check|--write]"), "usage lists format and names avant")
      c.expect(!str_has(none, "avant-av"), "usage does not say avant-av")
    } else {
      c.expect(false, "read usage")
    }

    // D49 as amended (Stage 29 W1b): several files and directories.
    many = "${scratch()}/format-${stamp}-many"
    mkdir_p("${many}/sub")
    mkdir_p("${many}/deps")
    mkdir_p("${many}/.hidden")
    file_write("${many}/a.av", "fn main {\n}\n")
    file_write("${many}/sub/b.av", "fn main{\n}\n")
    file_write("${many}/deps/c.av", "fn main{\n}\n")
    file_write("${many}/.hidden/d.av", "fn main{\n}\n")
    file_write("${many}/sub/e.av", "fn main{\n}\n")
    dir_log = "${scratch()}/format-${stamp}-dir.log"
    dir_code = run_format(compiler, "format", many, dir_log, check_flags)
    c.eq_int(dir_code, 1, "a directory with drift: --check exits 1")
    c.eq_str(read_or_empty(dir_log), "would change ${many}/sub/b.av\nwould change ${many}/sub/e.av\n", "a directory is walked in order, skipping deps and dot names")
    pair_log = "${scratch()}/format-${stamp}-pair.log"
    pair_flags: Array(String) = []
    pair_flags.push("${many}/sub/b.av")
    pair_flags.push("--check")
    pair_code = run_format(compiler, "format", "${many}/a.av", pair_log, pair_flags)
    c.eq_int(pair_code, 1, "two files with one drift: --check exits 1")
    c.eq_str(read_or_empty(pair_log), "would change ${many}/sub/b.av\n", "two files: only the changed one is listed")
    mw_log = "${scratch()}/format-${stamp}-many-write.log"
    mw_flags: Array(String) = []
    mw_flags.push("--write")
    mw_code = run_format(compiler, "format", many, mw_log, mw_flags)
    c.eq_int(mw_code, 0, "a directory: --write exits 0")
    c.eq_str(read_or_empty("${many}/sub/b.av"), "fn main {\n}\n", "--write rewrites a walked file")
    c.eq_str(read_or_empty("${many}/deps/c.av"), "fn main{\n}\n", "--write skips deps")
    mc_log = "${scratch()}/format-${stamp}-many-clean.log"
    mc_code = run_format(compiler, "format", many, mc_log, check_flags)
    c.eq_int(mc_code, 0, "a canonical directory: --check exits 0")
    c.eq_str(read_or_empty(mc_log), "canonical\n", "a canonical directory prints canonical")
    nd_log = "${scratch()}/format-${stamp}-notav.log"
    nd_code = run_format(compiler, "format", "${many}/missing.txt", nd_log, check_flags)
    c.eq_int(nd_code, 1, "a path that is neither .av nor a directory exits 1")

    flag_log = "${scratch()}/format-${stamp}-flag.log"
    flag_flags: Array(String) = []
    flag_flags.push("--nope")
    flag_code = run_format(compiler, "format", want_path, flag_log, flag_flags)
    c.eq_int(flag_code, 1, "unknown flag exits 1")
    if flag = file_read(flag_log) {
      c.expect(str_has(flag, "unknown format argument --nope"), "unknown flag diagnostic")
    } else {
      c.expect(false, "read unknown flag")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_format(c)
  c.finish
}
