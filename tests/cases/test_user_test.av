import harness

fn ut_quote(s: String): String {
  b = buf_new()
  b.push_str("'")
  for i in 0..s.size {
    if s[i] == 39 {
      b.push_str("'\\''")
    } else {
      b.push_byte(s[i])
    }
  }
  b.push_str("'")
  b.to_s
}

fn ut_has(hay: String, needle: String): Bool {
  if needle.size == 0 {
    return true
  }
  if needle.size > hay.size {
    return false
  }
  last = hay.size - needle.size
  i = 0
  while i <= last {
    if str_slice(hay, i, i + needle.size) == needle {
      return true
    }
    i += 1
  }
  false
}

fn ut_starts(s: String, prefix: String): Bool {
  s.size >= prefix.size && str_slice(s, 0, prefix.size) == prefix
}

fn ut_sh(body: String, rc_path: String): Int {
  script = "${rc_path}.sh"
  _ = file_write(script, body) ?? return 1
  chmod_x(script)
  sh_args: Array(String) = []
  sh_args.push(script)
  _ = process_run("/bin/sh", sh_args)
  if text = file_read(rc_path) {
    t = text.strip()
    n = 0
    i = 0
    ok = true
    while i < t.size {
      c = t[i]
      if c < 48 || c > 57 {
        ok = false
      }
      if ok {
        n = n * 10 + (c - 48)
      }
      i += 1
    }
    if ok {
      return n
    }
  }
  1
}

fn ut_index(hay: String, needle: String): Int {
  if needle.size == 0 || needle.size > hay.size {
    return -1
  }
  last = hay.size - needle.size
  i = 0
  while i <= last {
    if str_slice(hay, i, i + needle.size) == needle {
      return i
    }
    i += 1
  }
  -1
}

fn ut_read_ms(path: String): Int {
  if text = file_read(path) {
    return text.strip().to_i ?? -1
  }
  -1
}

fn ut_fill(template: String, dir: String): String {
  parts = template.split("DIR")
  b = buf_new()
  for i in 0..parts.size {
    if i > 0 {
      b.push_str(dir)
    }
    b.push_str(parts[i])
  }
  b.to_s
}

fn test_user_test(c: Checks) {
  c.suite("tests/cases/test_user_test.av")
  if compiler = env_get("AVANT_COMPILER") {
    compiler = compiler_abs("user_test", compiler)
    stamp = now_ms()
    root = "${scratch()}/user_test-user-${stamp}"
    mkdir_p("${root}/proj/tests")
    mkdir_p("${root}/proj/std")
    mkdir_p("${root}/empty")
    mkdir_p("${root}/fetch")

    status_body = "fn main: Int {\n  7\n}\n"
    _ = file_write("${root}/status.av", status_body)
    status_log = "${root}/status.log"
    status_rc = "${root}/status.rc"
    status_sh = "#!/bin/sh\n${ut_quote(compiler)} run ${ut_quote(root)}/status.av -- > ${ut_quote(status_log)} 2>&1; echo $? > ${ut_quote(status_rc)}\n"
    c.eq_int(ut_sh(status_sh, status_rc), 7, "fn main: Int is the process status")

    run_body = "fn run: Int {\n  5\n}\n"
    _ = file_write("${root}/runint.av", run_body)
    run_rc = "${root}/runint.rc"
    run_sh = "#!/bin/sh\n${ut_quote(compiler)} run ${ut_quote(root)}/runint.av -- > ${ut_quote(root)}/runint.log 2>&1; echo $? > ${ut_quote(run_rc)}\n"
    c.eq_int(ut_sh(run_sh, run_rc), 5, "fn run: Int is the process status")

    bad_body = "fn main: String {\n  \"no\"\n}\n"
    _ = file_write("${root}/badret.av", bad_body)
    bad_log = "${root}/badret.log"
    bad_args: Array(String) = []
    bad_args.push("run")
    bad_args.push("${root}/badret.av")
    bad_args.push("--")
    bad_code = process_run_out(compiler, bad_args, bad_log) ?? -1
    c.expect(bad_code != 0, "fn main: String is rejected")
    if bad_text = file_read(bad_log) {
      c.expect(ut_has(bad_text, "the process status is Int"), "status error names Int")
    } else {
      c.expect(false, "status error names Int")
    }

    bare_body = "import std\nfn main {\n}\n"
    _ = file_write("${root}/bare.av", bare_body)
    bare_log = "${root}/bare.log"
    bare_args: Array(String) = []
    bare_args.push("run")
    bare_args.push("${root}/bare.av")
    bare_args.push("--")
    bare_code = process_run_out(compiler, bare_args, bare_log) ?? -1
    c.expect(bare_code != 0, "import std is rejected")
    if bare_text = file_read(bare_log) {
      c.expect(ut_has(bare_text, "import std needs a module"), "import std names the module")
    } else {
      c.expect(false, "import std names the module")
    }

    _ = file_write("${root}/empty/avant.toml", "[package]\nname = \"empty\"\nversion = \"0.1.0\"\n")
    empty_rc = "${root}/empty.rc"
    empty_sh = "#!/bin/sh\ncd ${ut_quote(root)}/empty && ${ut_quote(compiler)} test > ${ut_quote(root)}/empty.log 2>&1; echo $? > ${ut_quote(empty_rc)}\n"
    c.eq_int(ut_sh(empty_sh, empty_rc), 1, "empty selection exits 1")

    jobs_rc = "${root}/jobs.rc"
    jobs_sh = "#!/bin/sh\ncd ${ut_quote(root)}/empty && ${ut_quote(compiler)} test --jobs 0 > ${ut_quote(root)}/jobs.log 2>&1; echo $? > ${ut_quote(jobs_rc)}\n"
    c.eq_int(ut_sh(jobs_sh, jobs_rc), 1, "--jobs 0 is an error")

    typo_rc = "${root}/typo.rc"
    typo_sh = "#!/bin/sh\n${ut_quote(compiler)} run ${ut_quote(root)}/status.av --relase > ${ut_quote(root)}/typo.log 2>&1; echo $? > ${ut_quote(typo_rc)}\n"
    c.eq_int(ut_sh(typo_sh, typo_rc), 1, "a mistyped run flag is an error")

    _ = file_write("${root}/proj/vec.av", "pub fn origin: Int {\n  4\n}\nfn hidden: Int {\n  9\n}\n")
    _ = file_write("${root}/proj/std/testing.av", "pub fn fake: Int {\n  1\n}\n")
    _ = file_write("${root}/proj/avant.toml", "[package]\nname = \"proj\"\nversion = \"0.1.0\"\n\n[test]\nexclusive = [\"tests/test_mid.av\"]\n")
    imp_body = "import vec\nimport std.testing\nfn main: Int {\n  t = Test.new\n  t.check_eq(origin(), 4, \"origin\")\n  t.finish\n}\n"
    _ = file_write("${root}/proj/tests/test_import.av", imp_body)
    imp_rc = "${root}/import.rc"
    imp_sh = "#!/bin/sh\ncd ${ut_quote(root)}/proj && ${ut_quote(compiler)} test tests/test_import.av > ${ut_quote(root)}/import.log 2>&1; echo $? > ${ut_quote(imp_rc)}\n"
    c.eq_int(ut_sh(imp_sh, imp_rc), 0, "a test under tests/ imports the project")
    if imp_text = file_read("${root}/import.log") {
      c.expect(ut_has(imp_text, "PASS origin"), "imported pub name is visible")
    } else {
      c.expect(false, "imported pub name is visible")
    }

    hid_body = "import vec\nfn main: Int {\n  hidden()\n}\n"
    _ = file_write("${root}/proj/tests/hidden.av", hid_body)
    hid_log = "${root}/hidden.log"
    hid_args: Array(String) = []
    hid_args.push("run")
    hid_args.push("${root}/proj/tests/hidden.av")
    hid_args.push("--")
    hid_code = process_run_out(compiler, hid_args, hid_log) ?? -1
    c.expect(hid_code != 0, "a test does not see a private name")

    miss_body = "import std.testing\nfn main: Int {\n  t = Test.new\n  t.golden(\"missing-want.txt\", \"x\")\n  t.finish\n}\n"
    _ = file_write("${root}/proj/tests/test_miss.av", miss_body)
    miss_rc = "${root}/miss.rc"
    miss_sh = "#!/bin/sh\ncd ${ut_quote(root)}/proj && ${ut_quote(compiler)} test tests/test_miss.av > ${ut_quote(root)}/miss.log 2>&1; echo $? > ${ut_quote(miss_rc)}\n"
    c.eq_int(ut_sh(miss_sh, miss_rc), 1, "a missing golden file fails the test")
    c.expect(!file_exists("${root}/proj/missing-want.txt"), "golden does not create the expected file")

    // D84 (Stage 29 W1b): a failed check fails the process, whatever
    // main returns and whether finish runs: a void main, a main that
    // returns 0, and a check that fails on another thread.
    mkdir_p("${root}/d84/tests")
    _ = file_write("${root}/d84/avant.toml", "[package]\nname = \"d84\"\nversion = \"0.1.0\"\n")
    _ = file_write("${root}/d84/tests/test_void.av", "import std.testing\n\nfn main {\n  t = Test.new\n  t.check(1 == 2, \"one is two\")\n  puts(\"done\")\n}\n")
    _ = file_write("${root}/d84/tests/test_zero.av", "import std.testing\n\nfn main: Int {\n  t = Test.new\n  t.check_eq(1, 2, \"one is two\")\n  t.check(true, \"true holds\")\n  0\n}\n")
    _ = file_write("${root}/d84/tests/test_task.av", "import std.testing\n\nfn main: Int {\n  h = spawn {\n    u = Test.new\n    u.check(false, \"fails on a task\")\n    1\n  }\n  h.join\n  0\n}\n")
    _ = file_write("${root}/d84/tests/test_pass.av", "import std.testing\n\nfn main {\n  t = Test.new\n  t.check(true, \"true holds\")\n  puts(\"done\")\n}\n")
    d84_names = ["void", "zero", "task"]
    d84_fails = ["one is two", "one is two", "fails on a task"]
    i = 0
    while i < d84_names.size {
      nm = d84_names[i]
      d_rc = "${root}/d84-${nm}.rc"
      d_log = "${root}/d84-${nm}.log"
      d_sh = "#!/bin/sh\ncd ${ut_quote(root)}/d84 && ${ut_quote(compiler)} test tests/test_${nm}.av --junit ${ut_quote(root)}/d84-${nm}.xml > ${ut_quote(d_log)} 2>&1; echo $? > ${ut_quote(d_rc)}\n"
      c.eq_int(ut_sh(d_sh, d_rc), 1, "D84: a failed check in tests/test_${nm}.av fails the run")
      d_text = ""
      if t = file_read(d_log) {
        d_text = t
      }
      c.expect(ut_has(d_text, "FAIL ${d84_fails[i]}"), "D84: tests/test_${nm}.av ran its failing check")
      c.expect(ut_has(d_text, "FAIL tests/test_${nm}.av") && ut_has(d_text, "1 failed, 0 passed"), "D84: the runner reports tests/test_${nm}.av as failed")
      d_xml = ""
      if t = file_read("${root}/d84-${nm}.xml") {
        d_xml = t
      }
      c.expect(ut_has(d_xml, "failures=\"1\""), "D84: the JUnit report counts tests/test_${nm}.av as a failure")
      i += 1
    }
    dp_rc = "${root}/d84-pass.rc"
    dp_sh = "#!/bin/sh\ncd ${ut_quote(root)}/d84 && ${ut_quote(compiler)} test tests/test_pass.av > ${ut_quote(root)}/d84-pass.log 2>&1; echo $? > ${ut_quote(dp_rc)}\n"
    c.eq_int(ut_sh(dp_sh, dp_rc), 0, "D84: a void main whose checks pass still passes")

    // O520 (Stage 29 W-FIX1e): a test process that a signal killed, or
    // that exited with a status and no failed check, was reported as
    // `FAIL file` and nothing else. The FAIL line and the JUnit failure
    // say how it ended; a file whose parallel test was killed after the
    // serial part wrote a passing fragment is a failure in the report.
    mkdir_p("${root}/o520/tests")
    _ = file_write("${root}/o520/avant.toml", "[package]\nname = \"o520\"\nversion = \"0.1.0\"\n")
    sig_lib = "lib c {\n  fun raise(sig: Int32): Int32\n}\n\n"
    _ = file_write("${root}/o520/tests/test_sig.av", "import std.testing\n\n${sig_lib}fn main: Int {\n  t = Test.new\n  t.check(true, \"before the signal\")\n  sig: Int32 = 13\n  _ = c.raise(sig)\n  t.finish\n}\n")
    _ = file_write("${root}/o520/tests/test_exit.av", "import std.testing\n\nfn main: Int {\n  t = Test.new\n  t.check(true, \"holds\")\n  7\n}\n")
    _ = file_write("${root}/o520/tests/test_par.av", "import std.testing\n\n${sig_lib}fn main: Int {\n  t = Test.new\n  t.check(true, \"serial holds\")\n  t.parallel(\"dies\") {\n    sig: Int32 = 9\n    _ = c.raise(sig)\n    t.check(false, \"not reached\")\n  }\n  t.finish\n}\n")
    o520_names = ["sig", "exit", "par"]
    o520_why = ["the test process killed by signal 13 (Broken pipe)", "the test process exited with status 7", "the parallel test \"dies\" killed by signal 9 (Killed)"]
    o520_xml = [o520_why[0], o520_why[1], "the parallel test &quot;dies&quot; killed by signal 9 (Killed)"]
    i = 0
    while i < o520_names.size {
      nm = o520_names[i]
      o_rc = "${root}/o520-${nm}.rc"
      o_log = "${root}/o520-${nm}.log"
      o_sh = "#!/bin/sh\ncd ${ut_quote(root)}/o520 && ${ut_quote(compiler)} test tests/test_${nm}.av --junit ${ut_quote(root)}/o520-${nm}.xml > ${ut_quote(o_log)} 2>&1; echo $? > ${ut_quote(o_rc)}\n"
      c.eq_int(ut_sh(o_sh, o_rc), 1, "O520: tests/test_${nm}.av fails the run")
      o_text = file_read(o_log) ?? ""
      c.expect(ut_has(o_text, "FAIL tests/test_${nm}.av: ${o520_why[i]}\n"), "O520: the FAIL line of tests/test_${nm}.av says how it ended (${o520_why[i]})")
      o_xml = file_read("${root}/o520-${nm}.xml") ?? ""
      c.expect(ut_has(nth_line(o_xml, 1), "<testsuites tests=") && ut_has(nth_line(o_xml, 1), "failures=\"1\""), "O520: the JUnit report counts tests/test_${nm}.av as a failure")
      c.expect(ut_has(o_xml, "<failure message=\"${o520_xml[i]}\">"), "O520: the JUnit failure of tests/test_${nm}.av says how it ended")
      i += 1
    }

    // O596 (Stage 29 W-FIX1f): the JUnit report's fallback case put a
    // failed file's output in CDATA as it was, so an output holding
    // `]]>` ended the section early and the report did not parse. A
    // file without std.testing prints it and fails; Python's XML parser
    // must read the report and give the output back whole.
    mkdir_p("${root}/o596/tests")
    _ = file_write("${root}/o596/avant.toml", "[package]\nname = \"o596\"\nversion = \"0.1.0\"\n")
    o596_line = "before ]]> middle <tag/> & ]]]> ]]>]]> after"
    _ = file_write("${root}/o596/tests/test_cdata.av", "fn main: Int {\n  puts(\"${o596_line}\")\n  1\n}\n")
    o596_rc = "${root}/o596.rc"
    o596_sh = "#!/bin/sh\ncd ${ut_quote(root)}/o596 && ${ut_quote(compiler)} test tests/test_cdata.av --junit ${ut_quote(root)}/o596.xml > ${ut_quote(root)}/o596.log 2>&1; echo $? > ${ut_quote(o596_rc)}\n"
    c.eq_int(ut_sh(o596_sh, o596_rc), 1, "O596: a file whose output holds ]]> fails the run")
    o596_py = "import sys, xml.etree.ElementTree as E\nf = E.parse(sys.argv[1]).find('.//failure')\nsys.stdout.write(f.text if f is not None else '(no failure element)')\n"
    _ = file_write("${root}/o596.py", o596_py)
    o596_prc = "${root}/o596-parse.rc"
    o596_psh = "#!/bin/sh\n/usr/bin/python3 -I ${ut_quote(root)}/o596.py ${ut_quote(root)}/o596.xml > ${ut_quote(root)}/o596-parse.out 2>&1; echo $? > ${ut_quote(o596_prc)}\n"
    c.eq_int(ut_sh(o596_psh, o596_prc), 0, "O596: an XML parser reads the JUnit report of an output holding ]]>")
    c.expect(ut_has(file_read("${root}/o596-parse.out") ?? "", "${o596_line}\n"), "O596: the failure's text is the file's output, ]]> included")

    // O235 (Stage 29 W-FIX1f): `avant test --help` said `--junit PATH
    // one case per file`; the report has one case per check std.testing
    // records (write_junit takes its processes' fragments), one per file
    // that records none, and one for a failed file whose checks all
    // passed (O520).
    help_rc = "${root}/test-help.rc"
    help_sh = "#!/bin/sh\n${ut_quote(compiler)} test --help > ${ut_quote(root)}/test-help.log 2>&1; echo $? > ${ut_quote(help_rc)}\n"
    c.eq_int(ut_sh(help_sh, help_rc), 0, "O235: avant test --help exits 0")
    c.expect(ut_has(file_read("${root}/test-help.log") ?? "", "\n--junit PATH   write a JUnit report: one case per check std.testing records, one per file that records none, and one for a failed file whose checks all passed\n"), "O235: avant test --help says what --junit's cases are")

    // O569 (Stage 29 W-FIX1e): seven writes of the compiler printed
    // `cannot write PATH` and dropped the reason; each now prints it
    // (`cannot write PATH: REASON`), and a lost lcov report fails
    // `avant test --coverage`. A directory where a file is written, a
    // missing directory, or `ulimit -f 0` (SIGXFSZ ignored: every write
    // to a file fails with "File too large", for root too) makes each
    // fail. Output goes through a pipe: under the limit the compiler
    // could not write its stderr to a file either.
    w5 = "${root}/o569"
    mkdir_p("${w5}/p/tests")
    mkdir_p("${w5}/isdir")
    mkdir_p("${w5}/f/avant.lock")
    _ = file_write("${w5}/p/avant.toml", "[package]\nname = \"p\"\nversion = \"0.1.0\"\n")
    _ = file_write("${w5}/f/avant.toml", "[package]\nname = \"f\"\nversion = \"0.1.0\"\n")
    _ = file_write("${w5}/p/tests/test_ok.av", "import std.testing\n\nfn main: Int {\n  t = Test.new\n  t.check(true, \"holds\")\n  t.finish\n}\n")
    _ = file_write("${w5}/re.av", "import std.regex\n\nfn main {\n  if re = Regex.compile(\"a+\") {\n    puts(re.count(\"aa\"))\n  }\n}\n")
    _ = file_write("${w5}/ok.av", "fn main {\n  puts(1)\n}\n")
    _ = file_write("${w5}/fmt.av", "fn main {\n    puts(1)\n}\n")
    mkdir_p("${w5}/p/coverage/lcov.info")
    qc = ut_quote(compiler)
    qw = ut_quote(w5)
    limit = "trap '' XFSZ; ulimit -f 0; "
    w5_cmds = ["${qc} test tests/test_ok.av --junit ${qw}/isdir", "${qc} test --coverage tests/test_ok.av", "${limit}${qc} compile ${qw}/re.av ${qw}/re-bin", "${qc} __mir-build example ${qw}/mb --emit-ll ${qw}/nodir/k.ll", "${qc} __emit-ll ${qw}/ok.av ${qw}/nodir/e.ll", "${limit}${qc} format --write ${qw}/fmt.av", "${qc} fetch ${qw}/f"]
    w5_want = ["cannot write ${w5}/isdir: Is a directory\n", "cannot write coverage/lcov.info: Is a directory\n", "/re2c.re: File too large\n", "cannot write ${w5}/nodir/k.ll: No such file or directory\n", "cannot write ${w5}/nodir/e.ll: No such file or directory\n", "cannot write ${w5}/fmt.av: File too large\n", "avant fetch: cannot write ${w5}/f/avant.lock: Is a directory\n"]
    w5_what = ["the JUnit report", "the lcov report", "re2c's input", "the kept .ll", "__emit-ll's .ll", "format --write", "fetch's avant.lock"]
    i = 0
    while i < w5_cmds.size {
      w_rc = "${w5}/w-${i}.rc"
      w_log = "${w5}/w-${i}.log"
      w_sh = "#!/bin/sh\ncd ${qw}/p && { (${w5_cmds[i]}) < /dev/null 2>&1; echo $? > ${ut_quote(w_rc)}; } | cat > ${ut_quote(w_log)}\n"
      w_code = ut_sh(w_sh, w_rc)
      if i == 2 {
        // re2c's input is not fatal (the pattern stays on PCRE2); the
        // compile fails later, when LLVM cannot write the object.
        c.expect(w_code != 0, "O569: the compile under ulimit -f 0 fails")
      } else {
        c.eq_int(w_code, 1, "O569: a failed write of ${w5_what[i]} fails the command")
      }
      w_text = file_read(w_log) ?? ""
      c.expect(ut_has(w_text, w5_want[i]), "O569: a failed write of ${w5_what[i]} names its reason: ${w5_want[i].strip()}")
      i += 1
    }
    c.expect(ut_has(file_read("${w5}/w-2.log") ?? "", "re2c: cannot write "), "O569: re2c's failed input names re2c")

    // O534 (Stage 29 W-FIX1e): `avant version` (and `--version`) prints
    // the version and the commit from the build's record beside the
    // executable: EXE.versions.txt (tools/letters.sh writes it), else
    // versions.txt (a release archive, tools/package.sh). A copy of the
    // compiler in a directory of its own shows each case.
    vdir = "${root}/o534"
    mkdir_p(vdir)
    vexe = "${vdir}/avant"
    c.eq_int(copy_file(compiler, vexe), 0, "O534: the compiler copied")
    chmod_x(vexe)
    v_args = ["version"]
    c.eq_int(process_run_out(vexe, v_args, "${vdir}/none.log") ?? -1, 0, "O534: avant version without a record exits 0")
    v_none = file_read("${vdir}/none.log") ?? ""
    c.expect(ut_starts(v_none, "avant (version unknown: no versions.txt beside ") && ut_has(v_none, "/o534/avant)\n"), "O534: without a record avant version says the version is unknown and where it looked")
    _ = file_write("${vdir}/versions.txt", "tag: v9.8.7\navant: 0123456789abcdef0123456789abcdef01234567\nllvm: 20.1.2\nglibc-floor: 2.38\n")
    _ = process_run_out(vexe, v_args, "${vdir}/archive.log")
    c.eq_str(file_read("${vdir}/archive.log") ?? "", "avant 9.8.7 (commit 0123456789abcdef0123456789abcdef01234567)\n", "O534: a release archive's versions.txt gives the tag and the commit")
    _ = file_write("${vexe}.versions.txt", "version: 9.8.8\navant: fedcba9876543210fedcba9876543210fedcba98\ndirty: yes\nbuilt: tools/letters.sh c-llvm\n")
    _ = process_run_out(vexe, v_args, "${vdir}/record.log")
    c.eq_str(file_read("${vdir}/record.log") ?? "", "avant 9.8.8 (commit fedcba9876543210fedcba9876543210fedcba98, with uncommitted changes)\n", "O534: the compiler's own record comes first and says when the tree was dirty")
    _ = process_run_out(vexe, ["--version"], "${vdir}/dash.log")
    c.eq_str(file_read("${vdir}/dash.log") ?? "", file_read("${vdir}/record.log") ?? "?", "O534: avant --version prints what avant version prints")
    c.eq_int(process_run_out(vexe, ["version", "extra"], "${vdir}/extra.log") ?? -1, 1, "O534: avant version takes no arguments")
    rm_f(vexe)
    // The compiler under test, when tools/letters.sh built it, prints
    // avant.toml's version.
    if file_exists("${compiler}.versions.txt") {
      toml_version = ""
      for line in (file_read("${avant_test_root()}/avant.toml") ?? "").split("\n") {
        if toml_version.size == 0 && ut_starts(line, "version = \"") && line.size > 12 {
          toml_version = str_slice(line, 11, line.size - 1)
        }
      }
      _ = process_run_out(compiler, v_args, "${vdir}/self.log")
      c.expect(toml_version.size > 0 && ut_starts(file_read("${vdir}/self.log") ?? "", "avant ${toml_version} (commit "), "O534: the compiler under test prints avant.toml's version (${toml_version})")
    }

    fetch_body = "[package]\nname = \"fetch\"\nversion = \"0.1.0\"\n\n[test]\ndir = \"tests\"\nexclusive = [\"tests/test_bench.av\"]\n"
    _ = file_write("${root}/fetch/avant.toml", fetch_body)
    fetch_rc = "${root}/fetch.rc"
    fetch_sh = "#!/bin/sh\n${ut_quote(compiler)} fetch ${ut_quote(root)}/fetch > ${ut_quote(root)}/fetch.log 2>&1; echo $? > ${ut_quote(fetch_rc)}\n"
    c.eq_int(ut_sh(fetch_sh, fetch_rc), 0, "fetch accepts [test] and ignores it")

    shard_rc = "${root}/shard.rc"
    shard_sh = "#!/bin/sh\ncd ${ut_quote(root)}/proj && ${ut_quote(compiler)} test --shard 1/2 > ${ut_quote(root)}/shard.log 2>&1; echo $? > ${ut_quote(shard_rc)}\n"
    c.eq_int(ut_sh(shard_sh, shard_rc), 1, "--shard with an exclusive file is an error")
    if shard_text = file_read("${root}/shard.log") {
      c.expect(ut_has(shard_text, "exclusive"), "shard error names exclusive")
    } else {
      c.expect(false, "shard error names exclusive")
    }

    both_body = "[package]\nname = \"both\"\nversion = \"0.1.0\"\n\n[test]\ndir = \"tests\"\nentry = \"main.av\"\n"
    _ = file_write("${root}/both.toml", both_body)
    mkdir_p("${root}/both")
    _ = file_write("${root}/both/avant.toml", both_body)
    both_rc = "${root}/both.rc"
    both_sh = "#!/bin/sh\ncd ${ut_quote(root)}/both && ${ut_quote(compiler)} test > ${ut_quote(root)}/both.log 2>&1; echo $? > ${ut_quote(both_rc)}\n"
    c.eq_int(ut_sh(both_sh, both_rc), 1, "dir and entry together are an error")

    clock = "${root}/clock"
    mkdir_p("${clock}/tests")
    _ = file_write("${clock}/avant.toml", "[package]\nname = \"clock\"\nversion = \"0.1.0\"\n\n[test]\nexclusive = [\"tests/test_mid.av\"]\n")
    piece = "import std.testing\nfn meet(other: String, flag: String) {\n  args: Array(String) = []\n  args.push(\"0.05\")\n  i = 0\n  while i < 6000 {\n    if file_exists(other) {\n      dummy = file_write(flag, \"met\")\n      return\n    }\n    dummy = process_run(\"/bin/sleep\", args)\n    i = i + 1\n  }\n}\nfn stamp(path: String) {\n  dummy = file_write(path, \"\${now_ms()}\")\n}\nfn nap() {\n  args: Array(String) = []\n  args.push(\"1\")\n  dummy = process_run(\"/bin/sleep\", args)\n}\nfn main: Int {\n  t = Test.new\n  listing = false\n  if v = env_get(\"AVANT_TEST_LIST\") {\n    if v == \"1\" {\n      listing = true\n    }\n  }\n  selected = false\n  if v = env_get(\"AVANT_TEST_ONLY\") {\n    if v.size > 0 {\n      selected = true\n    }\n  }\n  if listing {\n  } else if selected {\n  } else {\n    stamp(\"DIR/NAME.start\")\n    meet(\"DIR/right.start\", \"DIR/NAME.met\")\n    stamp(\"DIR/NAME.end\")\n  }\n  t.parallel(\"pa\") {\n    stamp(\"DIR/NAME.pa.start\")\n    nap()\n    stamp(\"DIR/NAME.pa.end\")\n    nil\n  }\n  t.parallel(\"pb\") {\n    stamp(\"DIR/NAME.pb.start\")\n    nap()\n    stamp(\"DIR/NAME.pb.end\")\n    nil\n  }\n  t.finish\n}\n"
    left = ut_fill(piece, clock)
    left = ut_fill_name(left, "left")
    right_src = "import std.testing\nfn meet(other: String, flag: String) {\n  args: Array(String) = []\n  args.push(\"0.05\")\n  i = 0\n  while i < 6000 {\n    if file_exists(other) {\n      dummy = file_write(flag, \"met\")\n      return\n    }\n    dummy = process_run(\"/bin/sleep\", args)\n    i = i + 1\n  }\n}\nfn stamp(path: String) {\n  dummy = file_write(path, \"\${now_ms()}\")\n}\nfn nap() {\n  args: Array(String) = []\n  args.push(\"1\")\n  dummy = process_run(\"/bin/sleep\", args)\n}\nfn main: Int {\n  t = Test.new\n  listing = false\n  if v = env_get(\"AVANT_TEST_LIST\") {\n    if v == \"1\" {\n      listing = true\n    }\n  }\n  if listing {\n  } else {\n    stamp(\"${clock}/right.start\")\n    meet(\"${clock}/left.start\", \"${clock}/right.met\")\n    stamp(\"${clock}/right.end\")\n  }\n  t.finish\n}\n"
    mid_src = "import std.testing\nfn stamp(path: String) {\n  dummy = file_write(path, \"\${now_ms()}\")\n}\nfn nap() {\n  args: Array(String) = []\n  args.push(\"1\")\n  dummy = process_run(\"/bin/sleep\", args)\n}\nfn main: Int {\n  t = Test.new\n  listing = false\n  if v = env_get(\"AVANT_TEST_LIST\") {\n    if v == \"1\" {\n      listing = true\n    }\n  }\n  if listing {\n  } else {\n    stamp(\"${clock}/mid.start\")\n    nap()\n    stamp(\"${clock}/mid.end\")\n  }\n  t.finish\n}\n"
    _ = file_write("${clock}/tests/test_left.av", left)
    _ = file_write("${clock}/tests/test_right.av", right_src)
    _ = file_write("${clock}/tests/test_mid.av", mid_src)
    clock_rc = "${root}/clock.rc"
    clock_sh = "#!/bin/sh\ncd ${ut_quote(clock)} && ${ut_quote(compiler)} test --jobs 2 > ${ut_quote(root)}/clock.log 2>&1; echo $? > ${ut_quote(clock_rc)}\n"
    c.eq_int(ut_sh(clock_sh, clock_rc), 0, "overlap fixture exits 0")
    ls = ut_read_ms("${clock}/left.start")
    le = ut_read_ms("${clock}/left.end")
    rs = ut_read_ms("${clock}/right.start")
    re = ut_read_ms("${clock}/right.end")
    pas = ut_read_ms("${clock}/left.pa.start")
    pae = ut_read_ms("${clock}/left.pa.end")
    pbs = ut_read_ms("${clock}/left.pb.start")
    pbe = ut_read_ms("${clock}/left.pb.end")
    ms = ut_read_ms("${clock}/mid.start")
    me = ut_read_ms("${clock}/mid.end")
    c.expect(ls >= 0 && le >= ls && rs >= 0 && re >= rs, "serial intervals were recorded")
    // O86 (Stage 29 W1b): the two non-exclusive files meet. Each, once
    // running, waits (up to 300 s) until the other has started and records
    // that it saw it; both can only do so if their runs overlap, however
    // long the runner's compiles take. Before, each slept one second and
    // the intervals were compared, so under an outer AVANT_GC_STRESS the
    // stressed compiler's compile time decided the result and the check
    // was skipped there (Stage 28 W15a2).
    c.expect(file_exists("${clock}/left.met") && file_exists("${clock}/right.met"), "non-exclusive files overlap")
    c.expect(pas >= 0 && pae > pas && pbs >= 0 && pbe > pbs, "parallel intervals were recorded")
    c.expect(pas < pbe && pbs < pae, "parallel tests in one file overlap")
    c.expect(ms >= 0 && me > ms, "exclusive interval was recorded")
    left_hi = le
    if pae > left_hi {
      left_hi = pae
    }
    if pbe > left_hi {
      left_hi = pbe
    }
    right_hi = re
    c.expect(ms >= left_hi && ms >= right_hi, "exclusive file does not overlap other files")

    // [test] first (D136): with one job, the listed file compiles and runs
    // before the next file compiles (no phase barrier), so its ok line
    // comes before the broken file's FAIL line, though it sorts after it.
    order = "${root}/order"
    mkdir_p("${order}/tests")
    _ = file_write("${order}/avant.toml", "[package]\nname = \"order\"\nversion = \"0.1.0\"\n\n[test]\nfirst = [\"tests/test_z.av\"]\n")
    _ = file_write("${order}/tests/test_a.av", "fn main: Int {\n  missing_name()\n}\n")
    _ = file_write("${order}/tests/test_z.av", "import std.testing\nfn main: Int {\n  t = Test.new\n  t.check(true, \"z\")\n  t.finish\n}\n")
    order_rc = "${root}/order.rc"
    order_sh = "#!/bin/sh\ncd ${ut_quote(order)} && ${ut_quote(compiler)} test --jobs 1 > ${ut_quote(root)}/order.log 2>&1; echo $? > ${ut_quote(order_rc)}\n"
    c.eq_int(ut_sh(order_sh, order_rc), 1, "first fixture fails on its broken file")
    order_text = ""
    if ot = file_read("${root}/order.log") {
      order_text = ot
    }
    zi = ut_index(order_text, "ok tests/test_z.av")
    ai = ut_index(order_text, "FAIL tests/test_a.av")
    c.expect(zi >= 0 && ai > zi, "a first file runs before a later file compiles")

    nofirst = "${root}/nofirst"
    mkdir_p("${nofirst}/tests")
    _ = file_write("${nofirst}/avant.toml", "[package]\nname = \"nofirst\"\nversion = \"0.1.0\"\n\n[test]\nfirst = [\"tests/test_gone.av\"]\n")
    _ = file_write("${nofirst}/tests/test_here.av", "fn main: Int {\n  0\n}\n")
    nf_rc = "${root}/nofirst.rc"
    nf_sh = "#!/bin/sh\ncd ${ut_quote(nofirst)} && ${ut_quote(compiler)} test > ${ut_quote(root)}/nofirst.log 2>&1; echo $? > ${ut_quote(nf_rc)}\n"
    c.eq_int(ut_sh(nf_sh, nf_rc), 1, "a first path that is not a test is an error")
    nf_text = ""
    if nt = file_read("${root}/nofirst.log") {
      nf_text = nt
    }
    c.expect(ut_has(nf_text, "first path is not a selected test"), "first error names the path rule")
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn ut_fill_name(template: String, name: String): String {
  parts = template.split("NAME")
  b = buf_new()
  for i in 0..parts.size {
    if i > 0 {
      b.push_str(name)
    }
    b.push_str(parts[i])
  }
  b.to_s
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_user_test(c)
  c.finish
}
