import harness
import backends

// Stage 28 W8b: spawn, JoinHandle, the task pool, channels, `.parallel`,
// `Mutex.with`, and coverage on the new back end (AVANT_BACKEND=llvm,
// D176; stages/stage28/mir.md W8b). (a) Every program of the threads
// subset compiles (--debug) and its stdout, stderr, and exit status are
// its run golden (tests/goldens/runs, frozen from the old back end at
// W11; until then the two back ends were compared, D184); (b) the
// program prints the same under AVANT_GC_VERIFY=1, under
// AVANT_YOUNG_MB=1, under both, and under AVANT_NURSERY=0, and the
// verifier reports nothing; (c) `avant dump` under AVANT_BACKEND=llvm
// prints exactly tests/goldens/threads/<name>.mir (D171); (d) the
// program the old back end cannot compile (fresh.av, expected
// differences, D196), D191's probe (d191_probe.av, Stage 28 W17a) and
// every thread's runtime roots (runtime_roots.av, O70, Stage 29 W1b)
// print their known output on the new back end, plain and under the four
// GC environments; (e) a coverage build
// (AVANT_COVERAGE=1) of tests/fixtures/coverage/points.av writes the slot
// map and the counts (lcov) the old back end wrote (goldens frozen at
// W11). The outputs
// are deterministic: every task is joined, in order, before its result
// is printed. (test_std_http.av built by the new back end runs in
// test_std_http_llvm.av, which is exclusive: it uses the http test's
// ports.)

fn golden_names: Array(String) {
  ["channels", "fresh", "mutex", "parallel", "spawn"]
}

// The programs with a run golden from the old back end.
fn both_progs: Array(String) {
  ["tests/fixtures/threads/spawn.av", "tests/fixtures/threads/parallel.av", "tests/fixtures/threads/channels.av", "tests/fixtures/threads/mutex.av", "tests/fixtures/coverage/points.av", "examples/spawn.av"]
}

// The programs only the new back end compiles, with their output.
fn new_progs: Array(String) {
  ["tests/fixtures/threads/fresh.av", "tests/fixtures/threads/d191_probe.av", "tests/fixtures/threads/runtime_roots.av"]
}

fn new_wants: Array(String) {
  ["102 104 106 108\naa bbbb cccccc\ntrue\n9 tttt\n", "worker bad reads: 0\nmain bad reads: 0\nshared[199]: item-199\n", "task bad reads: 0\nmain bad reads: 0\n"]
}

fn gc_envs: Array(String) {
  ["AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0"]
}

// The .ll without its frame chain's two stores (Stage 28 W18): linking
// and unlinking a frame record are volatile stores into avant_gc_top,
// the only volatile stores the emitter writes.
fn without_frame_links(ll: String): String {
  lines = ll.split("\n")
  out = buf_new()
  for l in lines {
    if !(str_has(l, "store volatile ptr ") && str_has(l, ", ptr @avant_gc_top, align 8")) {
      out.push_str(l)
      out.push_str("\n")
    }
  }
  out.to_s
}

fn test_threads_llvm(c: Checks, compiler: String, root: String, dir: String) {
  progs = both_progs()
  np = new_progs()
  gn = golden_names()
  cov_src = "${root}/tests/fixtures/coverage/points.av"

  // Wave 1: the compiles, the dumps,
  // and the coverage builds (each with its own slot map).
  jobs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, "${root}/${progs[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log"))
    i += 1
  }
  i = 0
  while i < np.size {
    k = key_of(np[i])
    jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, "${root}/${np[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log"))
    i += 1
  }
  i = 0
  while i < gn.size {
    a: Array(String) = []
    a.push("dump")
    a.push("${root}/tests/fixtures/threads/${gn[i]}.av")
    jobs.push(env_job("AVANT_BACKEND=llvm", compiler, a, "${dir}/${gn[i]}.mir"))
    i += 1
  }
  jobs.push(compile_job("AVANT_COVERAGE=1 AVANT_COVERAGE_MAP=${dir}/cov-new.map AVANT_BACKEND=llvm", compiler, cov_src, "${dir}/cov.new", "${dir}/cov.new.log"))
  // Stage 28 W17b (D207 relaxed): no slot access is volatile, in a shared
  // module either; its only volatile access is the poll's flag load.
  vol_srcs = ["tests/fixtures/threads/spawn.av", "tests/fixtures/heap/loops.av"]
  i = 0
  while i < vol_srcs.size {
    a: Array(String) = []
    a.push("__emit-ll")
    a.push("${root}/${vol_srcs[i]}")
    a.push("${dir}/vol${i}.ll")
    jobs.push(env_job("AVANT_BACKEND=llvm", compiler, a, "${dir}/vol${i}.log"))
    i += 1
  }
  run_waves(jobs)
  i = 0
  while i < progs.size {
    c.eq_int(jobs[i].code, 0, "${progs[i]}: compiles under llvm")
    i += 1
  }
  base = progs.size
  i = 0
  while i < np.size {
    c.eq_int(jobs[base + i].code, 0, "${np[i]}: compiles under llvm")
    i += 1
  }
  base += np.size
  i = 0
  while i < gn.size {
    j = jobs[base + i]
    c.eq_int(j.code, 0, "${gn[i]}: dump under llvm exits 0")
    want = "(no golden)"
    if t = file_read("${root}/tests/goldens/threads/${gn[i]}.mir") {
      want = t
    }
    c.eq_str(log_text(j.log), want, "tests/fixtures/threads/${gn[i]}.av: the MIR dump is tests/goldens/threads/${gn[i]}.mir")
    i += 1
  }
  base += gn.size
  c.eq_int(jobs[base].code, 0, "coverage/points.av: a coverage build under llvm")
  c.eq_int(jobs[base + 1].code, 0, "threads/spawn.av: __emit-ll exits 0")
  c.eq_int(jobs[base + 2].code, 0, "heap/loops.av: __emit-ll exits 0")
  vol_shared = "(no .ll)"
  if t = file_read("${dir}/vol0.ll") {
    vol_shared = without_frame_links(t)
  }
  vol_single = "(no .ll) volatile"
  if t = file_read("${dir}/vol1.ll") {
    vol_single = without_frame_links(t)
  }
  c.expect(!str_has(vol_shared, "load volatile ptr") && !str_has(vol_shared, "store volatile") && str_has(vol_shared, "load volatile i32, ptr @avant_gc_requested"), "threads/spawn.av (shared): slot accesses are plain; the poll's flag load is volatile (the frame links aside)")
  c.expect(!str_has(vol_single, " volatile "), "heap/loops.av (single-threaded): no volatile access but the frame links")

  // Wave 2: every program, then the new ones under each GC environment,
  // then the coverage builds (each writes its own lcov).
  envs = gc_envs()
  per = 1 + envs.size
  runs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    runs.push(run_job(dir, "${k}.new", "${k}.b"))
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "${k}.new", "${k}.g${e}", envs[e]))
      e += 1
    }
    i += 1
  }
  nbase = runs.size
  i = 0
  while i < np.size {
    k = key_of(np[i])
    runs.push(run_job(dir, "${k}.new", "${k}.b"))
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "${k}.new", "${k}.g${e}", envs[e]))
      e += 1
    }
    i += 1
  }
  cbase = runs.size
  runs.push(run_job_env(dir, "cov.new", "cov.new.run", "AVANT_COVERAGE_LCOV=${dir}/cov-new.lcov AVANT_COVERAGE_REPORT=0"))
  run_waves(runs)
  i = 0
  while i < progs.size {
    p = progs[i]
    k = key_of(p)
    want_out = golden_out(root, p)
    want_err = golden_err(root, p)
    want_code = golden_status(root, p)
    c.eq_int(runs[per * i].code, want_code, "${p}: the golden exit status")
    c.eq_str(log_text("${dir}/${k}.b.out"), want_out, "${p}: the golden stdout")
    c.eq_str(log_text("${dir}/${k}.b.err"), want_err, "${p}: the golden stderr")
    e = 0
    while e < envs.size {
      c.eq_int(runs[per * i + 1 + e].code, want_code, "${p} under ${envs[e]}: the golden exit status")
      c.eq_str(log_text("${dir}/${k}.g${e}.out"), want_out, "${p} under ${envs[e]}: the golden stdout")
      c.eq_str(log_text("${dir}/${k}.g${e}.err"), want_err, "${p} under ${envs[e]}: the golden stderr (no verifier report)")
      e += 1
    }
    i += 1
  }
  wants = new_wants()
  i = 0
  while i < np.size {
    p = np[i]
    k = key_of(p)
    at = nbase + (1 + envs.size) * i
    c.eq_int(runs[at].code, 0, "${p} (new back end only): exit 0")
    c.eq_str(log_text("${dir}/${k}.b.out"), wants[i], "${p} (new back end only): the known stdout")
    c.eq_str(log_text("${dir}/${k}.b.err"), "", "${p} (new back end only): no stderr")
    e = 0
    while e < envs.size {
      c.eq_int(runs[at + 1 + e].code, 0, "${p} under ${envs[e]}: exit 0")
      c.eq_str(log_text("${dir}/${k}.g${e}.out"), wants[i], "${p} under ${envs[e]}: the known stdout")
      c.eq_str(log_text("${dir}/${k}.g${e}.err"), "", "${p} under ${envs[e]}: no stderr (no verifier report)")
      e += 1
    }
    i += 1
  }
  c.eq_int(runs[cbase].code, 0, "coverage/points.av under llvm: exit 0")
  // The slot map and the counts the old back end wrote, frozen at W11
  // (paths under the checkout written ROOT/ in the golden).
  gmap = str_replace_all(log_text("${root}/tests/goldens/runs/fixtures/coverage/points.map"), "ROOT/", "${root}/")
  c.expect(str_has(gmap, "avant-cov 1\n"), "coverage/points.av: the golden slot map is a slot map")
  c.eq_str(log_text("${dir}/cov-new.map"), gmap, "coverage/points.av: the golden slot map")
  glcov = log_text("${root}/tests/goldens/runs/fixtures/coverage/points.lcov")
  c.expect(str_has(glcov, "FNDA:"), "coverage/points.av: the golden counts have FNDA")
  c.eq_str(log_text("${dir}/cov-new.lcov"), glcov, "coverage/points.av: the golden counts (lcov)")
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_threads_llvm.av")
  if compiler = env_get("AVANT_COMPILER") {
    test_threads_llvm(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
