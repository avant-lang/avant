import harness
import std.fs
import std.process

// The release and wave tools under tools/, through the shell scripts in
// tests/tools/: each prints one line per check, `ok: NAME` or
// `FAIL: NAME: why`, or `skip: NAME: why` when this machine cannot run
// it (a skip says so in the report), and every NAME below is one check
// here, so a check that did not run fails too. They test shell tools, not the collector:
// under a GC environment pass they skip themselves (the default passes on
// B and C' run them).

fn tools_line(log: String, name: String): String {
  for line in log.split("\n") {
    if line == "ok: ${name}" {
      return "ok"
    }
    if line.contains("FAIL: ${name}: ") || line.contains("skip: ${name}: ") {
      return line
    }
  }
  "no line for ${name}"
}

// Each script's checks, from its log, after the script ended with code.
fn tools_checks(c: Checks, what: String, code: Int, log: String, names: Array(String)) {
  text = fs.read(log) ?? ""
  c.eq_int(code, 0, "${what}: the script ran to its end")
  c.expect(text.contains("\ndone\n") || (text.size >= 5 && text[..5] == "done\n"), "${what}: the script printed every check")
  for n in names {
    got = tools_line(text, n)
    msg = "${what}: ${n}"
    skip = "skip: ${n}: "
    if got.size > skip.size && got[..skip.size] == skip {
      c.skip(msg, got[skip.size..])
    } else {
      if got != "ok" {
        msg = "${msg} (${got})"
      }
      c.expect(got == "ok", msg)
    }
  }
}

fn test_tools(c: Checks) {
  c.suite("tests/cases/test_tools.av")
  outer = gc_env_outer("")
  if outer.size > 0 {
    c.skip("the tools' checks", "outer ${outer}: shell tools, run by the default passes")
    return
  }
  root = avant_test_root()
  jobs: Array(HJob) = []
  whats: Array(String) = []
  names: Array(Array(String)) = []
  // Two packages of one compiler are the same archive.
  if compiler = process.env("AVANT_COMPILER") {
    compiler = compiler_abs("tools", compiler)
    slash = 0
    for i in 0..compiler.size {
      if compiler[i] == 47 {
        slash = i
      }
    }
    re2c = "${compiler[..slash]}/re2c"
    c.expect(fs.exists(re2c), "package: the re2c beside the compiler under test exists (${re2c})")
    c.expect(fs.exists("${root}/runtime/build/avant-bind"), "package: runtime/build/avant-bind exists (sh runtime/build.sh)")
    w = "${scratch_dir()}/package"
    jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/package-repro.sh", compiler, re2c, w], "${w}.log"))
    whats.push("package.sh")
    names.push(["packaged", "same-sha256", "same-bytes", "sha256-file", "commit-time", "source-date-epoch", "epoch-changes-sha256", "bad-epoch"])
    // A layout that needs a newer x86-64 than the baseline is refused.
    iw = "${scratch_dir()}/isa-check"
    jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/isa-check.sh", compiler, iw], "${iw}.log"))
    whats.push("isa-check.sh")
    names.push(["baseline-passes", "vex-fails", "vex-named", "bmi-fails", "note-fails", "codec-allowed"])
    // The coverage report's lcov writer on a hand-made slot map.
    cw = "${scratch_dir()}/cov-lcov"
    jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/cov-lcov.sh", compiler, cw], "${cw}.log"))
    whats.push("avant_cov.c")
    names.push(["lcov-built", "lcov-exact"])
  } else {
    c.expect(false, "package: AVANT_COMPILER names the compiler under test")
  }
  // A stopped wave-final.sh leaves no process of its steps.
  wf = "${scratch_dir()}/wave-final"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/wave-final-stop.sh", wf], "${wf}.log"))
  whats.push("wave-final.sh")
  names.push(["run-ends", "step-status", "term-leaves-nothing", "term-status", "term-within-kill-after", "term-summary", "expire-leaves-nothing", "expire-status", "expire-summary", "runner-term-leaves-nothing", "runner-term-summary", "group-term-leaves-nothing", "group-term-summary", "escape-leaves-nothing", "escape-summary", "psfail-leaves-nothing", "psfail-summary", "slow-leaves-nothing", "slow-summary", "slow-rounds-by-clock"])
  // The suite's start order from a run's times.
  tow = "${scratch_dir()}/test-order"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/test-order.sh", tow], "${tow}.log"))
  whats.push("test-order.sh")
  names.push(["order-longest-first", "order-write", "order-check-stale", "order-check-current"])
  // The runtime-C rooting lint on a fake runtime: attribute-prefixed
  // definitions and asm forms.
  gcl = "${scratch_dir()}/gc-lint"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/gc-lint.sh", gcl], "${gcl}.log"))
  whats.push("gc-lint.sh")
  names.push(["lint-attribute-name", "lint-asm-not-function"])
  // CI step times per unit of runner speed.
  cis = "${scratch_dir()}/ci-steps"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/ci-steps.sh", cis], "${cis}.log"))
  whats.push("ci-steps.py")
  names.push(["ci-units-equal", "ci-ref-given", "ci-ref-step"])
  // The run goldens' per-program run limits.
  glw = "${scratch_dir()}/golden-limits"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/golden-limits.sh", glw], "${glw}.log"))
  whats.push("run-goldens.sh limits")
  names.push(["limit-own", "limit-mode", "limit-other-mode", "limit-summary"])
  // The suite passes' limits: a test file's own limit in one environment.
  slw = "${scratch_dir()}/suite-limits"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/suite-limits.sh", slw], "${slw}.log"))
  whats.push("suite-limit.sh")
  names.push(["suite-limit-plain", "suite-limit-own", "suite-limit-other-env", "suite-limit-words", "suite-limit-shard", "suite-limit-shard-plain", "suite-limit-default", "suite-limit-bad-seconds", "suite-limit-not-a-test", "suite-limit-repo"])
  // The whole suite under every collector mode, in steps of a shared run's
  // size (the stress pass in slices), on a fake checkout with a stub C'.
  smw = "${scratch_dir()}/suite-modes"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/suite-modes.sh", smw], "${smw}.log"))
  whats.push("suite-modes.sh")
  names.push(["modes-green", "modes-slices", "modes-one-slice", "modes-red", "modes-litter", "modes-depth", "modes-runner", "modes-limit", "modes-usage"])
  // The gate's sharded GC passes: SHARDS=N in a mode's entry.
  gsw = "${scratch_dir()}/gate-shards"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/gate-shards.sh", gsw], "${gsw}.log"))
  whats.push("gate.sh shards")
  names.push(["shards-passes", "shards-default-passes", "shards-labels", "shards-limit", "shards-one", "shards-sequential"])
  // The fixed point alone, and its use by `git bisect run` over merges.
  fpw = "${scratch_dir()}/fixed-point"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/fixed-point.sh", fpw], "${fpw}.log"))
  whats.push("fixed-point.sh")
  names.push(["fp-same", "fp-differ", "fp-build-fails", "fp-bisect"])
  // D' under the full stress mode, and the letters' step that builds it,
  // on a fake checkout with a stub seed and a stub C'.
  ds = "${scratch_dir()}/d-stress"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/d-stress.sh", ds], "${ds}.log"))
  whats.push("d-stress.sh")
  names.push(["stress-same", "stress-env", "stress-removed", "stress-kept", "stress-env-plain", "stress-differ", "stress-build-fails", "stress-timeout", "stress-no-c"])
  // The final evidence's provenance, litter and LR reference checks.
  wc = "${scratch_dir()}/wave-final-checks"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/wave-final-checks.sh", wc], "${wc}.log"))
  whats.push("wave-final.sh checks")
  names.push(["head-not-git", "head-clean", "tmp-gone-green", "tmp-new-red", "ref-other-machine", "ref-no-machine", "ref-cpu-parens", "ref-default", "ref-none", "runner-sides", "runner-lock-line", "runner-none", "runner-wall", "base-merge-base", "tmp-locale", "private-tmp", "private-tmp-paths", "cases-green", "cases-red", "cases-stdout", "cases-stop", "lock-old-form", "lock-old-form-runner", "lock-new-form-quiet", "lock-other-file", "group-one-call", "group-lines", "layout-marked", "layout-beyond", "layout-two-bases", "layout-same-built", "layout-built-differs", "twins-at-once", "twins-in-the-passes", "only-stats", "only-gate-no-build", "only-unknown", "beside-merged", "beside-differs", "beside-off", "neutral-count"])
  // The timing tools' undisturbed rule: the judge, the rounds' retries and
  // tables, the LR re-measure's counters.
  mt = "${scratch_dir()}/measure-rule"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/measure-rule.sh", mt], "${mt}.log"))
  whats.push("rounds.py and lr-table.sh")
  names.push(["judge-idle", "judge-timeshare", "judge-switches", "judge-outside", "judge-threads-own", "judge-threads-beyond", "judge-threads-unknown", "judge-threads-fewer", "threads-from-cfg", "rounds-counters", "rounds-retried", "rounds-kept-disturbed", "rounds-table-excludes", "rounds-table-lists", "rounds-lr-disturbed", "lr-columns", "lr-retried", "lr-table-notes", "lr-pure-measured", "lr-table-library", "lr-table-pure", "lr-table-clever", "lr-machine"])
  // The README facts diff: the same facts in other words, and each kind
  // of changed fact named.
  rf = "${scratch_dir()}/readme-facts"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/readme-facts.sh", rf], "${rf}.log"))
  whats.push("readme-facts.py")
  names.push(["facts-same", "facts-differ-status", "facts-span-lost", "facts-number-changed", "facts-link-new", "facts-code-block"])
  // The gate's document checks: each document's links, DESIGN.md's
  // included, and a README heading it links renamed fails them.
  gd = "${scratch_dir()}/gate-docs"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/gate-docs.sh", gd], "${gd}.log"))
  whats.push("gate.sh's document checks")
  names.push(["gate-links-readme", "gate-links-contributing", "gate-links-design", "gate-links-benchmarks", "design-links-pass", "design-renamed-heading-fails", "benchmarks-links-pass", "benchmarks-renamed-heading-fails"])
  // The base cache, the digests, the neutrality from a cache entry and
  // the per-commit check, on a fake repository with a stub compiler. It
  // runs with a runner, a map and a base harness that do not exist set,
  // as a caller's change-check would leave them: the script clears them.
  // The seed counts of a caller's change-check (CC_SEEDS, LA_SEEDS) are set
  // to values that would change every cell, and the script clears those.
  cc = "${scratch_dir()}/change-check"
  jobs.push(HJob.new("/usr/bin/env", ["CC_RUNNER=${cc}-no-runner", "TEST_MAP=${cc}-no-map", "CC_BASE_LANGARENA=${cc}-no-harness", "CC_SEEDS=0", "LA_SEEDS=12", "/bin/sh", "${root}/tests/tools/change-check.sh", cc], "${cc}.log"))
  whats.push("base-cache.sh and change-check.sh")
  names.push(["cache-build", "cache-reuse", "cache-partial", "cache-concurrent", "digests-normalized", "prune-dry-run", "prune-removes-unread", "prune-keeps-read", "prune-keeps-in-use", "prune-after-reader", "prune-days-checked", "cache-read-stamp", "map-pick-carried", "map-pick-widened", "map-pick-unmapped", "map-pick-common", "cache-la", "neutral-cache", "neutral-default-la", "check-first-kept", "check-kept", "check-rebuilt", "check-runtime", "check-failed", "check-worktree", "cache-la-base-refuses", "neutral-base-refuses", "check-base-refuses", "check-base-harness", "check-map", "check-goldens-example", "check-goldens-golden", "check-map-none", "check-map-auto", "check-runner", "la-count-seeds", "la-count-fixed-path", "check-hash-seeds", "check-hash-seeds-scope", "check-hash-seeds-forced"])
  // The runtime's link check: a hidden function another object calls and
  // the exports file does not list fails the build, named.
  rl = "${scratch_dir()}/runtime-link"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/runtime-link.sh", rl], "${rl}.log"))
  whats.push("runtime/link-check.sh")
  names.push(["hidden-unlisted-fails", "hidden-unlisted-named", "program-symbols-ignored", "hidden-listed-passes", "undefined-named"])
  // The layout flag, the layout re-timing (with stubs), the layout wrapper,
  // the spread across layouts and the rounds across layouts.
  ly = "${scratch_dir()}/layout"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/layout.sh", ly], "${ly}.log"))
  whats.push("layout-flag.py, layout-retime.sh, layout-cc.sh, layout-spread.py, rounds.py --layouts, layout-check.sh time and its sub-line build, layout-runtime.sh, la-mem.py, la-run.c")
  names.push(["flag-equal-counts", "flag-counts-moved", "flag-small", "retime-follows", "retime-overlap", "retime-real-timer", "retime-args", "cc-shifts", "cc-passthrough", "cc-bad-shift", "cc-runtime-shift", "cc-runtime-shift-hot", "rounds-layouts", "rounds-identical-skipped", "rounds-identical-timed", "rounds-reuse-within", "rounds-reuse-drift", "rounds-reuse-refused", "spread-verdicts", "spread-compare", "flag-spread", "check-rounds-many", "check-build-subline", "check-build-subline-checked", "check-build-subline-bad", "check-build-loops-bad", "cc-c-asm-same", "cc-c-shift", "cc-runtime", "check-build-runtime-moving", "check-build-runtime-fixed", "check-build-runtime-shift", "runtime-shift0-same", "mem-compare", "mem-method", "peak-exact", "peak-forks", "peak-threads", "run-path"])
  // Every LangArena program under every collector mode: a fake checkout
  // with a stub harness and a stub C'.
  lm = "${scratch_dir()}/la-modes"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/la-modes.sh", lm], "${lm}.log"))
  whats.push("la-modes.sh")
  names.push(["modes-all-correct", "modes-stress-output", "modes-verify-status", "modes-hash-seed", "modes-limit", "modes-compile-fails", "modes-slugs", "modes-runner", "modes-size", "modes-usage"])
  // The HTTP harness's build step and its base-against-final mode, with
  // stub servers and a stub load generator.
  hbw = "${scratch_dir()}/http-bench"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/http-bench.sh", hbw], "${hbw}.log"))
  whats.push("bench/http/run.sh")
  names.push(["http-no-build", "http-build-named", "http-crystal-flags", "http-versus-cells", "http-versus-order", "http-versus-ratio", "http-versus-usage"])
  // The LangArena spelling check: two fake harnesses through a stub C'.
  ls = "${scratch_dir()}/la-spelling"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/la-spelling.sh", ls], "${ls}.log"))
  whats.push("la-spelling.sh")
  names.push(["spelling-same", "spelling-differ", "spelling-only", "spelling-refused", "spelling-usage"])
  // The second half screened by instruction counts: stitched by the half's own builder.
  lh = "${scratch_dir()}/la-half"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/la-half.sh", lh], "${lh}.log"))
  whats.push("la-half.sh")
  names.push(["half-stitch", "half-stitch-short", "half-stitch-usage", "half-stitch-real", "half-table", "half-table-red", "half-screen"])
  // The lint's labels of the notes' other numbered lists.
  ll = "${scratch_dir()}/ledger-labels"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/ledger-labels.sh", ll], "${ll}.log"))
  whats.push("no-ledger-refs.sh")
  names.push(["labels-fail", "labels-each-reported", "names-left"])
  // The gate runs in a private /tmp: another lane's entry gone from
  // outside leaves it green, litter from inside makes it red. Where the
  // machine refuses the namespace, the gate snapshots the real /tmp:
  // green with nothing left, red on litter or on an entry gone.
  gt = "${scratch_dir()}/gate-private-tmp"
  jobs.push(HJob.new("/bin/sh", ["${root}/tests/tools/gate-private-tmp.sh", gt], "${gt}.log"))
  whats.push("gate.sh")
  names.push(["gone-pass-started", "gone-green", "gone-summary", "gone-private-line", "litter-red", "litter-named", "litter-entry", "litter-stays-private", "fallback-green", "fallback-summary", "fallback-mode-line", "fallback-litter-red", "fallback-litter-named", "fallback-litter-entry", "fallback-gone-started", "fallback-gone-red", "fallback-gone-named", "require-refuses", "bind-missing"])
  // The scripts at once: neither reads a clock the other could disturb
  // beyond wave-final-stop.sh's 10 s bound on a stop.
  run_jobs(jobs)
  for k in 0..jobs.size {
    tools_checks(c, whats[k], jobs[k].code, jobs[k].log, names[k])
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_tools(c)
  c.finish()
}
