import harness

// `release` (Stage 28 W16c, D266): the checker's refusals. Each program
// declares a C layout with a String, an Int, a Ptr(Void) and a nested
// layout without a String, and one with no String field at all.
fn release_src(body: String): String {
  "lib e {\n  struct In {\n    n: Int\n  }\n  struct H {\n    name: String\n    id: Int\n    link: Ptr(Void)\n    at: In\n  }\n  struct P {\n    x: Int\n    y: Float64\n  }\n  fun h_new: Ptr(H)\n  fun p_new: Ptr(P)\n  fun v_new: Ptr(Void)\n}\nfn main {\n${body}}\n"
}

fn release_refused(c: Checks, compiler: String, stamp: Int, tag: String, body: String, needle: String) {
  src = "${scratch()}/c_layout-${stamp}-release-${tag}.av"
  bin = "${scratch()}/c_layout-${stamp}-release-${tag}.bin"
  log = "${scratch()}/c_layout-${stamp}-release-${tag}.log"
  file_write(src, release_src(body))
  code = compile_av(compiler, src, bin, log)
  c.expect(code != 0 && !file_exists(bin), "release ${tag}: does not compile")
  if err = file_read(log) {
    c.expect(str_has(err, needle), "release ${tag}: ${needle}")
  } else {
    c.expect(false, "release ${tag}: the log")
  }
}

fn test_release_errors(c: Checks, compiler: String) {
  stamp = now_ms()
  release_refused(c, compiler, stamp, "avant-value", "  s = \"a\" + \"b\"\n  release(s)\n", "release takes the C field the value was stored in; for a scoped pin use pin(x) { }")
  release_refused(c, compiler, stamp, "scalar-field", "  h = e.h_new()\n  release(h.id)\n", "nothing to release: id is Int")
  release_refused(c, compiler, stamp, "ptr-field", "  h = e.h_new()\n  release(h.link)\n", "nothing to release: link is Ptr(Void)")
  release_refused(c, compiler, stamp, "nested-no-string", "  h = e.h_new()\n  release(h.at)\n", "nothing to release: at is In, which has no String field")
  release_refused(c, compiler, stamp, "ptr-void", "  v = e.v_new()\n  release(v)\n", "Avant knows no fields of Ptr(Void)")
  release_refused(c, compiler, stamp, "no-string-struct", "  p = e.p_new()\n  release(p)\n", "nothing to release: P has no String field")
  release_refused(c, compiler, stamp, "expression", "  h = e.h_new()\n  x = release(h.name)\n", "release is a statement, not a value")
  release_refused(c, compiler, stamp, "int", "  release(42)\n", "release takes a C-layout field or a Ptr to a C layout, got Int")
}

fn test_c_layout(c: Checks) {
  c.suite("tests/cases/test_c_layout.av")
  if compiler = env_get("AVANT_COMPILER") {
    root = avant_test_root()
    stamp = now_ms()
    flags: Array(String) = []
    flags.push("--cc")
    flags.push("${root}/examples/c/layout.c")
    log = "${scratch()}/c_layout-${stamp}-layout.txt"
    code = run_av_cmd_flags(compiler, "${root}/examples/layout.av", log, flags)
    c.eq_int(code, 0, "run layout.av")
    if got = file_read(log) {
      c.eq_str(got, "25\n25\nok\nok\nok\nok\n1\n5\n0\n6.5\n6\nok\nok\nok\n1\n2\n1\n4\n9\nok\nok\nok\nok\n1600000\n11\n99\n1.5\nhelloworld\nhelloworld\n7\n7\n", "layout.av stdout")
    } else {
      c.expect(false, "layout stdout")
    }
    csrc = "${scratch()}/c_layout-${stamp}-fields.c"
    asrc = "${scratch()}/c_layout-${stamp}-fields.av"
    clog = "${scratch()}/c_layout-${stamp}-fields.txt"
    file_write(csrc, "#include <stdlib.h>\ntypedef struct Point { int x; int y; } Point;\nPoint *point_new(int x, int y) {\n  Point *p = malloc(sizeof(Point));\n  p->x = x;\n  p->y = y;\n  return p;\n}\n")
    file_write(asrc, "lib math {\n  struct Point {\n    x: Int\n    y: Int\n  }\n  fun point_new(x: Int, y: Int): Ptr(Point)\n}\ncomptime {\n  for f in Point.fields {\n    quote {\n      fn #(f.name)(p: Ptr(Point)): #(f.type) {\n        p.#(f.name)\n      }\n    }\n  }\n}\nfn main {\n  p = math.point_new(3, 4)\n  puts(x(p))\n  puts(y(p))\n}\n")
    fflags: Array(String) = []
    fflags.push("--cc")
    fflags.push(csrc)
    fcode = run_av_cmd_flags(compiler, asrc, clog, fflags)
    c.eq_int(fcode, 0, "layout field walk compile")
    if fg = file_read(clog) {
      c.eq_str(fg, "3\n4\n", "layout field walk")
    } else {
      c.expect(false, "layout field walk stdout")
    }
    test_release_errors(c, compiler)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_c_layout(c)
  c.finish
}
