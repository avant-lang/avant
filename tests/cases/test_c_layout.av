import harness

fn test_c_layout(c: Checks) {
  c.suite("tests/cases/test_c_layout.av")
  if compiler = env_get("AVANT_COMPILER") {
    root = avant_test_root()
    stamp = now_ms()
    flags: Array(String) = []
    flags.push("--cc")
    flags.push("${root}/examples/c/layout.c")
    log = "/tmp/avant-c_layout-${stamp}-layout.txt"
    code = run_av_cmd_flags(compiler, "${root}/examples/layout.av", log, flags)
    c.eq_int(code, 0, "run layout.av")
    if got = file_read(log) {
      c.eq_str(got, "25\n25\nok\nok\nok\nok\n1\n5\n0\n6.5\n6\nok\nok\nok\n1\n2\n1\n4\n9\nok\nok\nok\nok\n1600000\n11\n99\n1.5\nhelloworld\nhelloworld\n7\n7\n", "layout.av stdout")
    } else {
      c.expect(false, "layout stdout")
    }
    csrc = "/tmp/avant-c_layout-${stamp}-fields.c"
    asrc = "/tmp/avant-c_layout-${stamp}-fields.av"
    clog = "/tmp/avant-c_layout-${stamp}-fields.txt"
    dummy = file_write(csrc, "#include <stdlib.h>\ntypedef struct Point { int x; int y; } Point;\nPoint *point_new(int x, int y) {\n  Point *p = malloc(sizeof(Point));\n  p->x = x;\n  p->y = y;\n  return p;\n}\n")
    dummy2 = file_write(asrc, "lib math {\n  struct Point {\n    x: Int\n    y: Int\n  }\n  fun point_new(x: Int, y: Int): Ptr(Point)\n}\ncomptime {\n  for f in Point.fields {\n    quote {\n      fn #(f.name)(p: Ptr(Point)): #(f.type) {\n        p.#(f.name)\n      }\n    }\n  }\n}\nfn main {\n  p = math.point_new(3, 4)\n  puts(x(p))\n  puts(y(p))\n}\n")
    fflags: Array(String) = []
    fflags.push("--cc")
    fflags.push(csrc)
    fcode = run_av_cmd_flags(compiler, asrc, clog, fflags)
    c.eq_int(fcode, 0, "layout field walk compile")
    if fg = file_read(clog) {
      c.eq_str(fg, "3\n4\n", "layout field walk")
    } else {
      c.expect(false, "layout field walk stdout")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  c = Checks.new()
  c.started = now_ms()
  test_c_layout(c)
  c.finish
}
