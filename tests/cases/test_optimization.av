import harness

fn expect_trap_opt(c: Checks, compiler: String, stamp: Int, tag: String, body: String, needle: String) {
  src = "/tmp/avant-optimization-wavek-${stamp}-${tag}.av"
  bin = "/tmp/avant-optimization-wavek-${stamp}-${tag}.bin"
  clog = "/tmp/avant-optimization-wavek-${stamp}-${tag}.clog"
  rlog = "/tmp/avant-optimization-wavek-${stamp}-${tag}.rlog"
  dummy = file_write(src, body)
  code = compile_av(compiler, src, bin, clog)
  c.expect(code == 0, "${tag} compiles")
  c.expect(file_exists(bin), "${tag} bin exists")
  rcode = run_av_bin(bin, rlog)
  c.expect(rcode != 0, "${tag} exits non-zero")
  if err = file_read(rlog) {
    c.expect(str_has(err, needle), tag)
  } else {
    c.expect(false, tag)
  }
}

fn test_optimization(c: Checks) {
  c.suite("tests/cases/test_optimization.av")

  limit = 3000000
  sqrt_limit = limit.to_f.sqrt.to_i
  c.eq_int(sqrt_limit, 1732, "sqrt cap value")
  acc = 0
  p = 2
  while p <= sqrt_limit {
    k = p * p
    while k <= limit {
      acc = acc + 1
      k = k + p
    }
    p = p + 1
  }
  c.eq_int(acc, 19603746, "sieve-like bounded loop count")
  c.eq_int(p, 1733, "sqrt-bounded loop exit")

  big = 2147483647
  sb = big.to_f.sqrt.to_i
  c.eq_int(sb, 46340, "sqrt of Int max floors to 46340")
  c.eq_int(sb * sb, 2147395600, "sqrt-bounded product fits Int")

  a = 40000
  b = 30000
  c.eq_int(a + b, 70000, "name plus name under caps")
  c.eq_int(a * b, 1200000000, "name times name under caps")
  tot = 0
  i = 0
  while i < 100 {
    tot += a
    i += 1
  }
  c.eq_int(tot, 4000000, "compound plus-eq under caps")
  c.eq_int(i, 100, "literal-capped loop count")

  n = 100
  d = 7
  c.eq_int(n / d, 14, "division by non-zero name divisor")
  c.eq_int(n % d, 2, "remainder by non-zero name divisor")
  q = 0
  if d > 0 {
    q = n / d
  }
  c.eq_int(q, 14, "division under positive divisor guard")

  x = 46340
  c.eq_int(x * x, 2147395600, "boundary product exactly fits")

  marr = [1, 3, 5, 2, 4, 6]
  mtmp = [0, 0, 0, 0, 0, 0]
  mi = 0
  while mi <= 5 {
    mtmp[mi] = marr[mi]
    mi = mi + 1
  }
  mi = 0
  mj = 3
  mk = 0
  while mi <= 2 && mj <= 5 {
    if mtmp[mi] <= mtmp[mj] {
      marr[mk] = mtmp[mi]
      mi = mi + 1
    } else {
      marr[mk] = mtmp[mj]
      mj = mj + 1
    }
    mk = mk + 1
  }
  while mi <= 2 {
    marr[mk] = mtmp[mi]
    mi = mi + 1
    mk = mk + 1
  }
  while mj <= 5 {
    marr[mk] = mtmp[mj]
    mj = mj + 1
    mk = mk + 1
  }
  c.eq_int(marr[0] + marr[1] * 10 + marr[2] * 100 + marr[3] * 1000 + marr[4] * 10000 + marr[5] * 100000, 654321, "two-pointer merge window over parameter bounds")

  nbrs = [10, 20, 30, 40]
  base = 0
  acc2 = 0
  k2 = 0
  while k2 < 4 {
    acc2 = acc2 + nbrs[base + k2]
    k2 = k2 + 1
  }
  c.eq_int(acc2, 100, "invariant-plus-induction index window")

  cells = [7, 8, 9]
  cell = 1
  acc3 = 0
  k3 = 0
  while k3 < 3 {
    acc3 = acc3 + cells[cell]
    k3 = k3 + 1
  }
  c.eq_int(acc3, 24, "loop-invariant index validated at entry")

  edge5 = [10, 20, 30, 40, 50]
  acc4 = 0
  bi2 = 0
  while bi2 < 4 {
    acc4 = acc4 + edge5[bi2 + 1]
    bi2 = bi2 + 1
  }
  c.eq_int(acc4, 140, "guarded index plus offset at size minus one boundary")

  bsrc = buf_new()
  bsrc.push_byte(255)
  bsrc.push_byte(0)
  bsrc.push_byte(65)
  bsrc.push_byte(255)
  bfreq: Array(Int) = []
  bfi = 0
  while bfi < 256 {
    bfreq.push(0)
    bfi = bfi + 1
  }
  bi3 = 0
  while bi3 < bsrc.size {
    bfreq[bsrc[bi3]] = bfreq[bsrc[bi3]] + 1
    bi3 = bi3 + 1
  }
  c.eq_int(bfreq[255], 2, "byte 255 into 256-entry table at boundary")
  c.eq_int(bfreq[0] * 10 + bfreq[65], 11, "byte table counts for 0 and 65")

  mvals = [511, 385]
  mtab: Array(Int) = []
  mti = 0
  while mti < 256 {
    mtab.push(mti)
    mti = mti + 1
  }
  macc = 0
  mi3 = 0
  while mi3 < 2 {
    macc = macc + mtab[mvals[mi3] & 255]
    mi3 = mi3 + 1
  }
  c.eq_int(macc, 384, "masked byte index sum")

  ssrc = buf_new()
  ssi = 0
  while ssi < 8 {
    ssrc.push_byte(255)
    ssi = ssi + 1
  }
  stab: Array(Int) = []
  sti = 0
  while sti < 2048 {
    stab.push(0)
    sti = sti + 1
  }
  si3 = 0
  while si3 < ssrc.size {
    stab[ssrc[si3] * 8 + 7] = stab[ssrc[si3] * 8 + 7] + 1
    si3 = si3 + 1
  }
  c.eq_int(stab[2047], 8, "scaled byte index at 2047 boundary")

  nsrc = buf_new()
  nsrc.push_byte(5)
  nsrc.push_byte(5)
  nsrc.push_byte(5)
  ntab: Array(Int) = []
  nti = 0
  while nti < 256 {
    ntab.push(nti)
    nti = nti + 1
  }
  nacc = 0
  ni3 = 0
  while ni3 < nsrc.size {
    nb = nsrc[ni3]
    nacc = nacc + ntab[nb]
    ni3 = ni3 + 1
  }
  c.eq_int(nacc, 15, "named byte index sum")

  dcmds = [43, 43, 43, 91, 62, 43, 60, 45, 93, 62, 46]
  djumps = [0, 0, 0, 8, 0, 0, 0, 0, 3, 0, 0]
  dtape = [0, 0, 0]
  dpos = 0
  dpc = 0
  dres = 0
  dn = dcmds.size
  while dpc < dn {
    dc = dcmds[dpc]
    if dc == 43 {
      dtape[dpos] = (dtape[dpos] + 1) & 255
    } else if dc == 45 {
      dtape[dpos] = (dtape[dpos] - 1) & 255
    } else if dc == 62 {
      dpos = dpos + 1
    } else if dc == 60 {
      dpos = dpos - 1
      if dpos < 0 {
        dpos = 0
      }
    } else if dc == 91 {
      if dtape[dpos] == 0 {
        dpc = djumps[dpc]
      }
    } else if dc == 93 {
      if dtape[dpos] != 0 {
        dpc = djumps[dpc]
      }
    } else if dc == 46 {
      dres = (dres << 2) &+ dtape[dpos]
    }
    dpc = dpc + 1
  }
  c.eq_int(dres, 3, "dispatch loop with validated jump table")

  ecmds = [91, 43, 93, 43, 46]
  ejumps = [2, 0, 0, 0, 0]
  etape = [0, 0]
  epos = 0
  epc = 0
  eres = 0
  en = ecmds.size
  while epc < en {
    ec = ecmds[epc]
    if ec == 43 {
      etape[epos] = (etape[epos] + 1) & 255
    } else if ec == 91 {
      if etape[epos] == 0 {
        epc = ejumps[epc]
      }
    } else if ec == 93 {
      if etape[epos] != 0 {
        epc = ejumps[epc]
      }
    } else if ec == 46 {
      eres = (eres << 2) &+ etape[epos]
    }
    epc = epc + 1
  }
  c.eq_int(eres, 1, "dispatch forward jump over validated table")
  c.eq_int(etape[0], 1, "dispatch forward jump tape result")

  fcmds = [43, 43, 91, 45, 93]
  fjumps = [0, 0, 4, 0, 2]
  ftape = [0, 0]
  fpos = 0
  fpc = 0
  fsteps = 0
  fn2 = fcmds.size
  while fpc < fn2 {
    fc = fcmds[fpc]
    if fc == 43 {
      ftape[fpos] = (ftape[fpos] + 1) & 255
    } else if fc == 45 {
      ftape[fpos] = (ftape[fpos] - 1) & 255
      fsteps = fsteps + 1
    } else if fc == 91 {
      if ftape[fpos] == 0 {
        fpc = fjumps[fpc]
      }
    } else if fc == 93 {
      if ftape[fpos] != 0 {
        fpc = fjumps[fpc]
      }
    }
    fpc = fpc + 1
  }
  c.eq_int(ftape[0], 0, "dispatch backward jump to size minus one boundary tape")
  c.eq_int(fsteps, 2, "dispatch backward jump to size minus one boundary steps")

  s127 = repeat_byte(97, 127)
  c.eq_int(s127.size, 127, "string length 127 below tagged threshold")
  c.eq_int(s127[126], 97, "string byte at 126")
  s128 = repeat_byte(97, 128)
  c.eq_int(s128.size, 128, "string length 128 above tagged threshold")
  c.eq_int(s128[127], 97, "string byte at 127 of 128")
  s129 = repeat_byte(97, 129)
  c.eq_int(s129.size, 129, "string length 129 above tagged threshold")
  c.eq_int(s129[128], 97, "string byte at 128 of 129")
  long_s = repeat_byte(98, 20000)
  c.eq_int(long_s.size, 20000, "long string length")
  c.eq_int(long_s[0], 98, "long string first byte")
  c.eq_int(long_s[19999], 98, "long string last byte")
  c.eq_str(str_slice(long_s, 19990, 20000), repeat_byte(98, 10), "long string tail slice")
  byte_sum = 0
  bi = 0
  while bi < long_s.size {
    byte_sum = byte_sum + long_s[bi]
    bi = bi + 1
  }
  c.eq_int(byte_sum, 1960000, "long string per-byte sum")
  churn = 0
  ci = 0
  while ci < 2000 {
    junk = repeat_byte(99, 500)
    churn = churn + junk.size
    ci = ci + 1
  }
  c.eq_int(churn, 1000000, "allocation churn total")
  c.eq_int(long_s.size, 20000, "long string length after churn")
  c.eq_int(long_s[19999], 98, "long string last byte after churn")
  c.eq_str(fmt_float("0.1".to_f, 10), "0.1000000000", "float parse 0.1")
  c.eq_str(fmt_float(str_to_f_slice("xx1.25yy", 2, 6), 10), "1.2500000000", "float slice parse 1.25")
  c.eq_str(fmt_float("1e3".to_f, 2), "1000.00", "float parse exponent")
  c.eq_str(fmt_float("123456789012345678".to_f, 2), "123456789012345680.00", "float parse long digits fallback")
  c.eq_str(fmt_float("-0.5".to_f, 10), "-0.5000000000", "float parse negative")

  decl_s = "abca"
  decl_t = "a"
  decl_m: Array(Int) = []
  decl_di = 0
  while decl_di < 4 {
    decl_m.push(0)
    decl_di = decl_di + 1
  }
  decl_hits = 0
  decl_i = 0
  while decl_i < 4 {
    decl_j = 0
    decl_fin = decl_i
    while decl_j <= decl_fin && decl_j < 4 {
      if decl_m[decl_j] == 0 && decl_s[decl_j] == decl_t[0] {
        decl_hits = decl_hits + 1
        decl_m[decl_j] = 1
      }
      decl_j = decl_j + 1
    }
    decl_i = decl_i + 1
  }
  c.eq_int(decl_hits, 2, "call-sized decline string loop computes")

  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()

    expect_trap_opt(c, compiler, stamp, "overflow-add-unbounded", "fn main {\n  x = 2147483647\n  y = 1\n  puts(x + y)\n}\n", "integer overflow")
    expect_trap_opt(c, compiler, stamp, "overflow-mul-capped-too-big", "fn main {\n  x = 50000\n  y = 50000\n  puts(x * y)\n}\n", "integer overflow")
    expect_trap_opt(c, compiler, stamp, "overflow-mul-boundary", "fn main {\n  x = 46341\n  puts(x * x)\n}\n", "integer overflow")
    expect_trap_opt(c, compiler, stamp, "overflow-compound-name", "fn main {\n  x = 2000000000\n  y = 2000000000\n  x += y\n  puts(x)\n}\n", "integer overflow")
    expect_trap_opt(c, compiler, stamp, "overflow-loop-carried", "fn main {\n  k = 46340 * 46340\n  p = 46340\n  i = 0\n  while i < 3 {\n    k = k + p\n    i = i + 1\n  }\n  puts(k)\n}\n", "integer overflow")
    expect_trap_opt(c, compiler, stamp, "overflow-guard-killed", "fn main {\n  k = 0\n  big = 2147483647\n  while k <= 10 {\n    k = big\n    puts(k + 1)\n    k = 11\n  }\n}\n", "integer overflow")
    expect_trap_opt(c, compiler, stamp, "div-zero-name", "fn main {\n  x = 10\n  y = 0\n  puts(x / y)\n}\n", "division by zero")
    expect_trap_opt(c, compiler, stamp, "rem-zero-name", "fn main {\n  x = 10\n  y = 0\n  puts(x % y)\n}\n", "division by zero")
    expect_trap_opt(c, compiler, stamp, "div-intmin-neg1", "fn main {\n  x = 0 - 2147483647 - 1\n  y = 0 - 1\n  puts(x / y)\n}\n", "integer overflow")
    expect_trap_opt(c, compiler, stamp, "window-bound-beyond-size", "fn main {\n  temp = [9, 9, 9, 1, 2]\n  arr = [0, 0, 0, 0, 0]\n  i = 0\n  j = 3\n  k = 0\n  while i <= 2 && j <= 9 {\n    if temp[i] <= temp[j] {\n      arr[k] = temp[i]\n      i = i + 1\n    } else {\n      arr[k] = temp[j]\n      j = j + 1\n    }\n    k = k + 1\n  }\n  puts(arr[0])\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "window-offset-at-size", "fn main {\n  a = [10, 20, 30, 40, 50]\n  acc = 0\n  i = 0\n  while i < 5 {\n    acc = acc + a[i + 1]\n    i = i + 1\n  }\n  puts(acc)\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "invariant-index-negative", "fn main {\n  a = [7, 8, 9]\n  cell = 0 - 1\n  k = 0\n  while k < 3 {\n    puts(a[cell])\n    k = k + 1\n  }\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "invariant-index-at-size", "fn main {\n  a = [7, 8, 9]\n  cell = 3\n  k = 0\n  while k < 3 {\n    puts(a[cell])\n    k = k + 1\n  }\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "byte-255-entry-table-traps", "fn main {\n  src = buf_new()\n  src.push_byte(255)\n  tab: Array(Int) = []\n  i = 0\n  while i < 255 {\n    tab.push(0)\n    i = i + 1\n  }\n  j = 0\n  while j < src.size {\n    tab[src[j]] = tab[src[j]] + 1\n    j = j + 1\n  }\n  puts(tab[0])\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "byte-array-load-declines-traps", "fn main {\n  arr = [300]\n  tab: Array(Int) = []\n  i = 0\n  while i < 256 {\n    tab.push(i)\n    i = i + 1\n  }\n  j = 0\n  while j < 1 {\n    nb = arr[j]\n    puts(tab[nb])\n    j = j + 1\n  }\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "byte-scaled-beyond-size-traps", "fn main {\n  src = buf_new()\n  src.push_byte(255)\n  tab: Array(Int) = []\n  i = 0\n  while i < 256 {\n    tab.push(0)\n    i = i + 1\n  }\n  j = 0\n  while j < src.size {\n    puts(tab[src[j] * 8])\n    j = j + 1\n  }\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "dispatch-jump-negative-traps", "fn main {\n  cmds = [91, 43, 93]\n  jumps = [0 - 5, 0, 0]\n  tape = [0, 0]\n  pos = 0\n  pc = 0\n  n = cmds.size\n  while pc < n {\n    c = cmds[pc]\n    if c == 91 {\n      if tape[pos] == 0 {\n        pc = jumps[pc]\n      }\n    }\n    pc = pc + 1\n  }\n  puts(tape[0])\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "dispatch-tape-beyond-size-traps", "fn main {\n  cmds = [62, 62, 43]\n  jumps = [0, 0, 0]\n  tape = [0]\n  pos = 0\n  pc = 0\n  n = cmds.size\n  while pc < n {\n    c = cmds[pc]\n    if c == 62 {\n      pos = pos + 1\n    } else if c == 43 {\n      tape[pos] = (tape[pos] + 1) & 255\n    } else if c == 91 {\n      if tape[pos] == 0 {\n        pc = jumps[pc]\n      }\n    }\n    pc = pc + 1\n  }\n  puts(tape[0])\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "dispatch-invalid-table-slow-tape-trap", "fn main {\n  cmds = [62, 43]\n  jumps = [0, 99]\n  tape = [0]\n  pos = 0\n  pc = 0\n  n = cmds.size\n  while pc < n {\n    c = cmds[pc]\n    if c == 62 {\n      pos = pos + 1\n    } else if c == 43 {\n      tape[pos] = (tape[pos] + 1) & 255\n    } else if c == 91 {\n      if tape[pos] == 0 {\n        pc = jumps[pc]\n      }\n    }\n    pc = pc + 1\n  }\n  puts(tape[0])\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "dispatch-entry-eq-n-slow-tape-traps", "fn main {\n  cmds = [62, 43]\n  jumps = [0, 2]\n  tape = [0]\n  pos = 0\n  pc = 0\n  n = cmds.size\n  while pc < n {\n    c = cmds[pc]\n    if c == 62 {\n      pos = pos + 1\n    } else if c == 43 {\n      tape[pos] = (tape[pos] + 1) & 255\n    } else if c == 91 {\n      if tape[pos] == 0 {\n        pc = jumps[pc]\n      }\n    }\n    pc = pc + 1\n  }\n  puts(tape[0])\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "dispatch-entry-at-bound-use-traps", "fn main {\n  cmds = [91, 43, 46]\n  jumps = [3, 0, 0]\n  tape = [0, 0]\n  pos = 0\n  pc = 0\n  n = cmds.size\n  while pc < n {\n    c = cmds[pc]\n    if c == 91 {\n      if tape[pos] == 0 {\n        pc = jumps[pc]\n      }\n    }\n    puts(cmds[pc])\n    pc = pc + 1\n  }\n}\n", "out of bounds")
    expect_trap_opt(c, compiler, stamp, "call-sized-decline-string-traps", "fn main {\n  s = \"abc\"\n  m = [0, 0, 0]\n  i = 0\n  acc = 0\n  while i < 3 {\n    j = 0\n    fin = i + 3\n    while j <= fin && j < 9 {\n      acc = acc + s[j] + m[j]\n      j = j + 1\n    }\n    i = i + 1\n  }\n  puts(acc)\n}\n", "out of bounds")
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_optimization(c)
  c.finish
}
