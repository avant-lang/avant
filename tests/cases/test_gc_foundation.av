import harness
import backends
import std.process

// The heap foundation's behavior.
//
// heap/fill_full_young.av: an array literal whose fill runs
// a full and then a young collection after young strings were stored.
// The full collection's MARKED bits used to survive into the young
// collection, which then skipped the buffer a root slot names, so
// the young strings were not copied (default environment: wrong
// elements; AVANT_GC_VERIFY=1 reported lost field references). Now
// full collections mark in a side bitmap and every mark a young
// collection sets is cleared when it ends.
//
// heap/full_default.av: reaches the full-collection trigger in the
// default environment (no suite program did before), with Json.parse
// on tenured texts between full collections (a json defect's default-mode
// exposure). A run with AVANT_GC_STATS=1 checks that full collections
// ran; one under AVANT_NURSERY=0 that the remembered set stays empty.
// Under an outer AVANT_GC_STRESS (the gate's stress pass) the program
// keeps the stress mode in every run that does not ask for the
// verifier (it ran without it once the minimal stress mode came, when it
// took more than 900 s under it, until card marking; 18 s now, 21 s
// with AVANT_YOUNG_MB=1), and the statistics run checks that it did:
// at least one collection for each of its 300,000 rounds.
//
// Each program runs plain and under each GC environment below: the known
// stdout, no stderr (no verifier report), exit 0.

fn gc_envs: Array(String) {
  ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "AVANT_GC_VERIFY=1 AVANT_NURSERY=0"]
}

// The number after `key=` in an AVANT_GC_STATS=1 line, or -1.
fn stat_int(text: String, key: String): Int {
  parts = text.split(" ")
  for p in parts {
    if p.size > key.size + 1 && str_slice(p, 0, key.size + 1) == "${key}=" {
      return str_slice(p, key.size + 1, p.size).strip().to_i() ?? -1
    }
  }
  -1
}

fn test_gc_foundation(c: Checks, compiler: String, root: String, dir: String) {
  names = ["fill_full_young", "full_default"]
  wants = ["block buffer bad: 0\nlarge buffer bad: 0\n", "json bad: 0\n"]
  jobs: Array(HJob) = []
  p = 0
  while p < names.size {
    jobs.push(compile_job("", compiler, "${root}/tests/fixtures/heap/${names[p]}.av", "${dir}/${names[p]}", "${dir}/${names[p]}.log"))
    p += 1
  }
  run_waves(jobs)
  envs = gc_envs()
  runs: Array(HJob) = []
  p = 0
  while p < names.size {
    c.eq_int(jobs[p].code, 0, "${names[p]}.av: compiles")
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, names[p], "${names[p]}.g${e}", envs[e]))
      e += 1
    }
    p += 1
  }
  runs.push(run_job_env(dir, "full_default", "full_default.stats", "AVANT_GC_STATS=1"))
  runs.push(run_job_env(dir, "full_default", "full_default.nursery0", "-u AVANT_GC_STRESS -u AVANT_YOUNG_MB AVANT_NURSERY=0 AVANT_GC_STATS=1"))
  run_waves(runs)
  p = 0
  while p < names.size {
    e = 0
    while e < envs.size {
      what = "plain"
      if envs[e].size > 0 {
        what = "under ${envs[e]}"
      }
      k = "${names[p]}.g${e}"
      c.eq_int(runs[p * envs.size + e].code, 0, "${names[p]}.av ${what}: exit 0")
      c.eq_str(log_text("${dir}/${k}.out"), wants[p], "${names[p]}.av ${what}: the known stdout")
      c.eq_str(log_text("${dir}/${k}.err"), "", "${names[p]}.av ${what}: no stderr (no verifier report)")
      e += 1
    }
    p += 1
  }
  stats = log_text("${dir}/full_default.stats.err")
  c.expect(stats.contains(" full="), "full_default.av: AVANT_GC_STATS=1 prints the statistics")
  outer = gc_env_outer("AVANT_GC_STATS")
  if outer.size > 0 {
    c.skip("full_default.av: full collections in the default environment", "outer ${outer}")
  } else {
    c.expect(!stats.contains(" full=0 "), "full_default.av: full collections in the default environment")
  }
  if outer == "AVANT_GC_STRESS" {
    c.expect(stat_int(stats, "collections") >= 300000, "full_default.av under the outer AVANT_GC_STRESS: it keeps the stress mode (at least a collection per round, 300,000)")
  }
  // Checked against today's collector: with no young
  // generation nothing is remembered, so the remembered set stays empty
  // across full collections (it once grew to 1.6 M entries).
  n0 = log_text("${dir}/full_default.nursery0.err")
  c.expect(n0.contains(" rem_peak=0 ") && n0.contains(" rem_adds=0 ") && !n0.contains(" full=0 "), "full_default.av under AVANT_NURSERY=0: full collections and an empty remembered set")
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_gc_foundation.av")
  if compiler = process.env("AVANT_COMPILER") {
    test_gc_foundation(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
