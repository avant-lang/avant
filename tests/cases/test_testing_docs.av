import harness

fn td_quote(s: String): String {
  b = buf_new()
  b.push_str("'")
  for i in 0..s.size {
    if s[i] == 39 {
      b.push_str("'\\''")
    } else {
      b.push_byte(s[i])
    }
  }
  b.push_str("'")
  b.to_s
}

fn td_has(hay: String, needle: String): Bool {
  if needle.size == 0 {
    return true
  }
  if needle.size > hay.size {
    return false
  }
  last = hay.size - needle.size
  i = 0
  while i <= last {
    if str_slice(hay, i, i + needle.size) == needle {
      return true
    }
    i += 1
  }
  false
}

fn td_at(hay: String, needle: String): Int {
  if needle.size == 0 {
    return 0
  }
  if needle.size > hay.size {
    return -1
  }
  last = hay.size - needle.size
  i = 0
  while i <= last {
    if str_slice(hay, i, i + needle.size) == needle {
      return i
    }
    i += 1
  }
  -1
}

fn td_sh(body: String, rc_path: String): Int {
  script = "${rc_path}.sh"
  // A program under test that imports std.testing must not inherit the
  // runner's listing or name-file variables, or it would skip checks or
  // write its parallel names into this file's list.
  wrapped = "#!/bin/sh\nunset AVANT_TEST_LIST\nunset AVANT_TEST_ONLY\nunset AVANT_TEST_NAMES\n${body}"
  _ = file_write(script, wrapped) ?? return 1
  chmod_x(script)
  sh_args: Array(String) = []
  sh_args.push(script)
  _ = process_run("/bin/sh", sh_args)
  if text = file_read(rc_path) {
    t = text.strip()
    n = 0
    i = 0
    while i < t.size {
      c = t[i]
      if c < 48 || c > 57 {
        return 1
      }
      n = n * 10 + (c - 48)
      i += 1
    }
    return n
  }
  1
}

fn test_testing_docs(c: Checks) {
  c.suite("tests/cases/test_testing_docs.av")
  if compiler = env_get("AVANT_COMPILER") {
    compiler = compiler_abs("testing_docs", compiler)
    stamp = now_ms()
    dir = "${scratch()}/testing_docs-docs-${stamp}"
    mkdir_p(dir)

    greet_body = "import std.testing\n\nfn greet(name: String): String {\n  \"Hello, \${name}\"\n}\n\nfn main: Int {\n  t = Test.new\n  t.check(greet(\"Ada\") == \"Hello, Ada\", \"greet uses the name\")\n  t.check_eq(greet(\"\"), \"Hello, \", \"greet handles empty\")\n  t.finish\n}\n"
    _ = file_write("${dir}/test_greet.av", greet_body)
    greet_log = "${dir}/greet.log"
    greet_rc = "${dir}/greet.rc"
    greet_sh = "#!/bin/sh\ncd ${td_quote(dir)} && ${td_quote(compiler)} run test_greet.av -- > ${td_quote(greet_log)} 2>${td_quote(dir)}/greet.err; echo $? > ${td_quote(greet_rc)}\n"
    greet_code = td_sh(greet_sh, greet_rc)
    c.eq_int(greet_code, 0, "README greet test runs")
    if text = file_read(greet_log) {
      c.eq_str(text, "PASS greet uses the name\nPASS greet handles empty\n0 failed, 2 passed\n", "README greet test output")
    } else {
      c.expect(false, "README greet test output")
    }

    table_body = "import std.testing\n\nfn greet(name: String): String {\n  \"Hello, \${name}\"\n}\n\nfn main: Int {\n  t = Test.new\n  names = [\"Ada\", \"Bo\", \"Cy\"]\n  wants = [\"Hello, Ada\", \"Hello, Bo\", \"Hello, Cy\"]\n  for i in 0..names.size {\n    t.check(greet(names[i]) == wants[i], \"greet \${names[i]}\")\n  }\n  t.finish\n}\n"
    _ = file_write("${dir}/test_table.av", table_body)
    table_log = "${dir}/table.log"
    table_rc = "${dir}/table.rc"
    table_sh = "#!/bin/sh\ncd ${td_quote(dir)} && ${td_quote(compiler)} run test_table.av -- > ${td_quote(table_log)} 2>${td_quote(dir)}/table.err; echo $? > ${td_quote(table_rc)}\n"
    table_code = td_sh(table_sh, table_rc)
    c.eq_int(table_code, 0, "README table test runs")
    if text = file_read(table_log) {
      c.eq_str(text, "PASS greet Ada\nPASS greet Bo\nPASS greet Cy\n0 failed, 3 passed\n", "README table test output")
    } else {
      c.expect(false, "README table test output")
    }

    tmp_body = "import std.testing\n\nfn main: Int {\n  t = Test.new\n  dir = t.temp_dir\n  t.check((file_write(\"\${dir}/notes.txt\", \"hi\") ?? -1) == 2, \"write in temp_dir\")\n  t.finish\n}\n"
    _ = file_write("${dir}/test_tmp.av", tmp_body)
    tmp_log = "${dir}/tmp.log"
    tmp_rc = "${dir}/tmp.rc"
    tmp_sh = "#!/bin/sh\ncd ${td_quote(dir)} && ${td_quote(compiler)} run test_tmp.av -- > ${td_quote(tmp_log)} 2>${td_quote(dir)}/tmp.err; echo $? > ${td_quote(tmp_rc)}\n"
    tmp_code = td_sh(tmp_sh, tmp_rc)
    c.eq_int(tmp_code, 0, "README temp_dir test runs")
    if text = file_read(tmp_log) {
      c.eq_str(text, "PASS write in temp_dir\n0 failed, 1 passed\n", "README temp_dir test output")
    } else {
      c.expect(false, "README temp_dir test output")
    }

    par_body = "import std.testing\n\nfn main: Int {\n  t = Test.new\n  t.test(\"adds\") {\n    t.check(1 + 2 == 3, \"1+2\")\n  }\n  t.parallel(\"other\") {\n    t.check(true, \"other\")\n  }\n  t.finish\n}\n"
    _ = file_write("${dir}/test_parallel.av", par_body)
    par_log = "${dir}/parallel.log"
    par_rc = "${dir}/parallel.rc"
    par_sh = "#!/bin/sh\ncd ${td_quote(dir)} && ${td_quote(compiler)} test test_parallel.av > ${td_quote(par_log)} 2>&1; echo $? > ${td_quote(par_rc)}\n"
    par_code = td_sh(par_sh, par_rc)
    c.eq_int(par_code, 0, "README parallel test runs")
    if text = file_read(par_log) {
      add_at = td_at(text, "PASS 1+2")
      other_at = td_at(text, "PASS other")
      c.expect(add_at >= 0, "README parallel serial line")
      c.expect(other_at > add_at, "README parallel line follows serial")
    } else {
      c.expect(false, "README parallel test output")
    }

    // O320 (Stage 29 W-FIX1d): a test file run by `avant run`, or as a
    // compiled binary, skipped its t.parallel bodies without a word and
    // exited 0 with the serial checks alone. With no runner listening the
    // bodies now run in that process: the same checks every way.
    both_body = "import std.testing\n\nfn main: Int {\n  t = Test.new\n  t.check(1 + 1 == 2, \"serial\")\n  t.test(\"adds\") {\n    t.check(1 + 2 == 3, \"in a test body\")\n  }\n  t.parallel(\"first\") {\n    t.check(true, \"first a\")\n    t.check(true, \"first b\")\n  }\n  t.parallel(\"second\") {\n    t.check(2 * 2 == 4, \"second a\")\n  }\n  t.parallel(\"third\") {\n    t.check(true, \"third a\")\n    t.check(true, \"third b\")\n  }\n  t.finish\n}\n"
    mkdir_p("${dir}/both")
    _ = file_write("${dir}/both/test_both.av", both_body)
    both_rc = "${dir}/both.rc"
    bd = td_quote("${dir}/both")
    both_sh = "cd ${bd} || exit 1\n${td_quote(compiler)} test test_both.av > t.out 2>&1; t=$?\n${td_quote(compiler)} run test_both.av > r.out 2>&1; r=$?\n${td_quote(compiler)} compile test_both.av both.bin --debug > c.out 2>&1 && ./both.bin > b.out 2>&1; b=$?\nfor f in t r b; do grep -a '^ *PASS ' $f.out | sed 's/^ *//' | sort > $f.pass; done\necho \"$t $r $b\" > status.txt\necho 0 > ${td_quote(both_rc)}\n"
    c.eq_int(td_sh(both_sh, both_rc), 0, "a test file runs three ways")
    c.eq_str(file_read("${dir}/both/status.txt") ?? "", "0 0 0\n", "avant test, avant run and the binary all exit 0")
    want_pass = "PASS first a\nPASS first b\nPASS in a test body\nPASS second a\nPASS serial\nPASS third a\nPASS third b\n"
    c.eq_str(file_read("${dir}/both/t.pass") ?? "", want_pass, "avant test runs the seven checks")
    c.eq_str(file_read("${dir}/both/r.pass") ?? "", want_pass, "avant run runs the same seven checks, the parallel bodies' too")
    c.eq_str(file_read("${dir}/both/b.pass") ?? "", want_pass, "the compiled binary runs the same seven checks")
    if text = file_read("${dir}/both/r.out") {
      c.expect(td_at(text, "0 failed, 7 passed") >= 0, "avant run counts every check")
    } else {
      c.expect(false, "avant run counts every check")
    }

    // O416 (Stage 29 W-FIX1d): the two files a test process writes for
    // the runner. A failed write of either was dropped: a report without
    // this process's checks, or parallel bodies that never run, with
    // status 0. Each is given a path that is a directory (it cannot be
    // written, whoever runs the suite): the run fails and names the file
    // and the reason.
    lost_body = "import std.testing\n\nfn main: Int {\n  t = Test.new\n  t.check(true, \"serial\")\n  t.parallel(\"one\") {\n    t.check(true, \"in one\")\n  }\n  t.finish\n}\n"
    mkdir_p("${dir}/lost/isdir")
    _ = file_write("${dir}/lost/test_lost.av", lost_body)
    lost_rc = "${dir}/lost.rc"
    ld = td_quote("${dir}/lost")
    lost_sh = "cd ${ld} || exit 1\n${td_quote(compiler)} compile test_lost.av lost.bin --debug > c.out 2>&1 || exit 1\nAVANT_JUNIT_FRAGMENT=${ld}/isdir ./lost.bin > j.out 2>&1; j=$?\nAVANT_TEST_NAMES=${ld}/isdir ./lost.bin > n.out 2>&1; n=$?\necho \"$j $n\" > status.txt\necho 0 > ${td_quote(lost_rc)}\n"
    c.eq_int(td_sh(lost_sh, lost_rc), 0, "a test binary runs with unwritable runner files")
    c.eq_str(file_read("${dir}/lost/status.txt") ?? "", "1 1\n", "a lost JUnit fragment and a lost names file each fail the run")
    c.eq_str(file_read("${dir}/lost/j.out") ?? "", "PASS serial\nPASS in one\nFAIL the JUnit fragment was not written: cannot write ${dir}/lost/isdir: Is a directory\n0 failed, 2 passed\n", "a lost JUnit fragment is reported with its path and reason")
    c.eq_str(file_read("${dir}/lost/n.out") ?? "", "PASS serial\nFAIL the parallel names were not written, so the parallel tests cannot run: cannot write ${dir}/lost/isdir: Is a directory\n0 failed, 1 passed\n", "a lost names file is reported with its path and reason")

    _ = file_write("${dir}/want.txt", "Hello Avant\n")
    _ = file_write("${dir}/hello.want", "Hello Avant\n")
    _ = file_write("${dir}/hello.av", "fn main {\n  puts(\"Hello Avant\")\n}\n")
    _ = file_write("${dir}/bad.av", "fn main {\n  missing\n}\n")
    gold_body = "import std.testing\n\nfn main: Int {\n  t = Test.new\n  t.golden(\"want.txt\", \"Hello Avant\\n\")\n  t.run_golden(\"hello.av\", \"hello.want\")\n  t.rejects(\"bad.av\", \"unknown name\")\n  t.finish\n}\n"
    _ = file_write("${dir}/test_gold.av", gold_body)
    gold_log = "${dir}/gold.log"
    gold_rc = "${dir}/gold.rc"
    gold_sh = "#!/bin/sh\ncd ${td_quote(dir)} && ${td_quote(compiler)} test test_gold.av > ${td_quote(gold_log)} 2>&1; echo $? > ${td_quote(gold_rc)}\n"
    gold_code = td_sh(gold_sh, gold_rc)
    c.eq_int(gold_code, 0, "README golden test runs")
    if text = file_read(gold_log) {
      c.expect(td_has(text, "PASS golden want.txt"), "README golden check")
      c.expect(td_has(text, "PASS run_golden hello.av"), "README run_golden check")
      c.expect(td_has(text, "PASS rejects bad.av"), "README rejects check")
      c.expect(td_has(text, "ok test_gold.av"), "README golden file ok")
    } else {
      c.expect(false, "README golden test output")
    }

    arg_body = "fn main: Int {\n  args = argv()\n  if args.size > 1 {\n    puts(args[1])\n  }\n  0\n}\n"
    _ = file_write("${dir}/prog.av", arg_body)
    arg_log = "${dir}/arg.log"
    arg_rc = "${dir}/arg.rc"
    arg_sh = "#!/bin/sh\ncd ${td_quote(dir)} && ${td_quote(compiler)} run prog.av -- hello > ${td_quote(arg_log)} 2>${td_quote(dir)}/arg.err; echo $? > ${td_quote(arg_rc)}\n"
    arg_code = td_sh(arg_sh, arg_rc)
    c.eq_int(arg_code, 0, "README program arguments run")
    if text = file_read(arg_log) {
      c.eq_str(text, "hello\n", "README program arguments output")
    } else {
      c.expect(false, "README program arguments output")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_testing_docs(c)
  c.finish
}
