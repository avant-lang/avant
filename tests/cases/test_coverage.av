import harness

fn test_coverage(c: Checks) {
  c.suite("tests/cases/test_coverage.av")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    src = "/tmp/avant-coverage-${stamp}-cov.av"
    bin = "/tmp/avant-coverage-${stamp}-cov.bin"
    log = "/tmp/avant-coverage-${stamp}-cov.log"
    dump_log = "/tmp/avant-coverage-${stamp}-cov.myc"
    body = "fn covered(n: Int): Int {\n  r = 0\n  if n > 0 {\n    r = 1\n  } else {\n    r = 2\n  }\n  r\n}\nfn unused(n: Int): Int {\n  n + 1\n}\nfn main {\n  x = covered(1)\n}\n"
    w = file_write(src, body)
    c.eq_int(w, 0, "write coverage fixture")

    dump_code = dump_av_cov(compiler, src, dump_log)
    c.eq_int(dump_code, 0, "dump with AVANT_COVERAGE")
    if ir = file_read(dump_log) {
      c.expect(str_has(ir, "avant_cov_hit"), "dump IR has avant_cov_hit")
      c.expect(str_has(ir, "avant_cov_init"), "dump IR has avant_cov_init")
    } else {
      c.expect(false, "dump with AVANT_COVERAGE")
    }

    code = compile_av_cov(compiler, src, bin, log)
    c.eq_int(code, 0, "compile with AVANT_COVERAGE")
    c.expect(file_exists(bin), "coverage bin exists")
    chmod_x(bin)
    // The fixture writes its own lcov. The compiler's report is a different file.
    // native runs the suite with AVANT_COVERAGE_REPORT=0. Force the table here.
    fix_lcov = "/tmp/avant-coverage-${stamp}-fixture.lcov"
    cov_run: Array(String) = []
    cov_run.push("AVANT_COVERAGE_LCOV=${fix_lcov}")
    cov_run.push("AVANT_COVERAGE_REPORT=1")
    cov_run.push(bin)
    run_code = process_run_out("/usr/bin/env", cov_run, log)
    c.eq_int(run_code, 0, "run coverage fixture")
    if out = file_read(log) {
      c.expect(str_has(out, "% Stmts"), "coverage has % Stmts")
      c.expect(str_has(out, "% Branch"), "coverage has % Branch")
      c.expect(str_has(out, "% Funcs"), "coverage has % Funcs")
      c.expect(str_has(out, "% Lines"), "coverage has % Lines")
      c.expect(str_has(out, "Uncovered Line"), "coverage has Uncovered Line")
      c.expect(str_has(out, "All files"), "coverage has All files")
    } else {
      c.expect(false, "coverage table")
    }
    if lcov = file_read(fix_lcov) {
      c.expect(str_has(lcov, "TN:"), "lcov has TN:")
      c.expect(str_has(lcov, "SF:"), "lcov has SF:")
      c.expect(str_has(lcov, "DA:"), "lcov has DA:")
      c.expect(str_has(lcov, "end_of_record"), "lcov has end_of_record")
      c.expect(str_has(lcov, "SF:avant-coverage-${stamp}-cov.av\n"), "absolute path keeps its file name")
    } else {
      c.expect(false, "fixture lcov")
    }

    rel_dir = "covrel-coverage-${stamp}"
    rel_src = "${rel_dir}/sample.av"
    mkdir_rel: Array(String) = []
    mkdir_rel.push("-p")
    mkdir_rel.push(rel_dir)
    dummy_rel = process_run("/bin/mkdir", mkdir_rel)
    rel_w = file_write(rel_src, body)
    c.eq_int(rel_w, 0, "write relative coverage fixture")
    rel_bin = "/tmp/avant-coverage-${stamp}-covrel.bin"
    rel_log = "/tmp/avant-coverage-${stamp}-covrel.log"
    rel_code = compile_av_cov(compiler, rel_src, rel_bin, rel_log)
    c.eq_int(rel_code, 0, "compile relative coverage fixture")
    chmod_x(rel_bin)
    rel_lcov_path = "/tmp/avant-coverage-${stamp}-rel.lcov"
    rel_run: Array(String) = []
    rel_run.push("AVANT_COVERAGE_LCOV=${rel_lcov_path}")
    rel_run.push("AVANT_COVERAGE_REPORT=0")
    rel_run.push(rel_bin)
    rel_run_code = process_run_out("/usr/bin/env", rel_run, rel_log)
    c.eq_int(rel_run_code, 0, "run relative coverage fixture")
    if rel_out = file_read(rel_log) {
      if str_has(rel_out, "% Stmts") {
        c.expect(false, "REPORT=0 hides the table")
      } else {
        c.expect(true, "REPORT=0 hides the table")
      }
    } else {
      c.expect(false, "REPORT=0 log")
    }
    if rel_lcov = file_read(rel_lcov_path) {
      c.expect(str_has(rel_lcov, "SF:${rel_src}\n"), "relative SF keeps the directory")
    } else {
      c.expect(false, "relative lcov")
    }

    jdir = "/tmp/avant-coverage-${stamp}-jcases"
    mkdir_args: Array(String) = []
    mkdir_args.push("-p")
    mkdir_args.push(jdir)
    dummy_mkdir = process_run("/bin/mkdir", mkdir_args)
    jcase = "${jdir}/test_ok.av"
    jbody = "import std.testing\nfn main: Int {\n  t = Test.new\n  t.check(true, \"ok\")\n  t.finish\n}\n"
    jw = file_write(jcase, jbody)
    c.eq_int(jw, 0, "write junit mini case")
    junit = "/tmp/avant-coverage-${stamp}-junit.xml"
    jlog = "/tmp/avant-coverage-${stamp}-junit.log"
    env_args: Array(String) = []
    env_args.push("AVANT_ROOT=${avant_test_root()}")
    env_args.push("AVANT_COVERAGE_LCOV=0")
    env_args.push("AVANT_COVERAGE_REPORT=0")
    if myc = env_get("AVANT_MYC_LLVM") {
      env_args.push("AVANT_MYC_LLVM=${myc}")
    }
    env_args.push(compiler)
    env_args.push("test")
    env_args.push("--junit")
    env_args.push(junit)
    env_args.push(jdir)
    jcode = process_run_out("/usr/bin/env", env_args, jlog)
    c.eq_int(jcode, 0, "mini suite for junit")
    if jout = file_read(jlog) {
      c.expect(str_has(jout, "PASS ok"), "mini suite prints PASS")
      c.expect(str_has(jout, "ok ${jcase}"), "runner names the file")
    } else {
      c.expect(false, "mini suite log")
    }
    if xml = file_read(junit) {
      c.expect(str_has(xml, "<testsuites"), "junit has testsuites")
      c.expect(str_has(xml, "<testcase"), "junit has testcase")
      c.expect(str_has(xml, "name=\"${jcase}\""), "junit names the file")
      c.expect(str_has(xml, "classname=\"${jcase}\""), "junit classname is the file")
    } else {
      c.expect(false, "junit.xml")
    }

    abs_compiler = compiler_abs("coverage", compiler)
    flag_src = "/tmp/avant-coverage-${stamp}-flag.av"
    flag_w = file_write(flag_src, "fn main {\n  puts(1)\n}\n")
    c.eq_int(flag_w, 0, "write flag fixture")
    flag_log = "/tmp/avant-coverage-${stamp}-flag.log"
    flag_args: Array(String) = []
    flag_args.push("compile")
    flag_args.push(flag_src)
    flag_args.push("/tmp/avant-coverage-${stamp}-flag.bin")
    flag_args.push("--coverage")
    flag_code = process_run_out(abs_compiler, flag_args, flag_log)
    c.expect(flag_code != 0, "compile rejects --coverage")
    if flag_txt = file_read(flag_log) {
      c.expect(str_has(flag_txt, "unknown"), "compile names the unknown flag")
    } else {
      c.expect(false, "compile flag log")
    }
    dump_flag_args: Array(String) = []
    dump_flag_args.push("dump")
    dump_flag_args.push(flag_src)
    dump_flag_args.push("--coverage")
    dump_flag_log = "/tmp/avant-coverage-${stamp}-dump-flag.log"
    dump_flag_code = process_run_out(abs_compiler, dump_flag_args, dump_flag_log)
    c.expect(dump_flag_code != 0, "dump rejects --coverage")

    repo = compiler_abs("covrepo", ".")
    miss_root = "/tmp/avant-coverage-${stamp}-noroot"
    miss_mkdir: Array(String) = []
    miss_mkdir.push("-p")
    miss_mkdir.push(miss_root)
    dummy_miss = process_run("/bin/mkdir", miss_mkdir)
    miss_src = "/tmp/avant-coverage-${stamp}-stdimp.av"
    miss_w = file_write(miss_src, "import std.testing\nfn main: Int {\n  t = Test.new\n  t.check(true, \"x\")\n  t.finish\n}\n")
    c.eq_int(miss_w, 0, "write std import")
    miss_log = "/tmp/avant-coverage-${stamp}-stdmiss.log"
    miss_env: Array(String) = []
    miss_env.push("AVANT_ROOT=${miss_root}")
    if myc = env_get("AVANT_MYC_LLVM") {
      miss_env.push("AVANT_MYC_LLVM=${myc}")
    }
    miss_env.push(abs_compiler)
    miss_env.push("compile")
    miss_env.push(miss_src)
    miss_env.push("/tmp/avant-coverage-${stamp}-stdmiss.bin")
    miss_env.push("--debug")
    miss_code = process_run_out("/usr/bin/env", miss_env, miss_log)
    c.expect(miss_code != 0, "AVANT_ROOT without lib/std fails")
    if miss_txt = file_read(miss_log) {
      c.expect(str_has(miss_txt, "cannot find std.testing"), "missing std names the module")
    } else {
      c.expect(false, "missing std log")
    }

    walk_log = "/tmp/avant-coverage-${stamp}-stdwalk.log"
    walk_rc = "/tmp/avant-coverage-${stamp}-stdwalk.rc"
    walk_sh = "/tmp/avant-coverage-${stamp}-stdwalk.sh"
    walk_body = "#!/bin/sh\ncd /tmp\nunset AVANT_ROOT\n"
    if myc = env_get("AVANT_MYC_LLVM") {
      walk_body = "${walk_body}export AVANT_MYC_LLVM='${myc}'\n"
    }
    walk_body = "${walk_body}${abs_compiler} compile ${miss_src} /tmp/avant-coverage-${stamp}-stdwalk.bin --debug > ${walk_log} 2>&1\necho $? > ${walk_rc}\n"
    walk_w = file_write(walk_sh, walk_body)
    c.eq_int(walk_w, 0, "write std walk script")
    chmod_x(walk_sh)
    walk_run: Array(String) = []
    walk_run.push(walk_sh)
    dummy_walk = process_run("/bin/sh", walk_run)
    walk_code = 1
    if walk_text = file_read(walk_rc) {
      walk_code = 0
      wt = walk_text.strip()
      wi = 0
      while wi < wt.size {
        wc = wt[wi]
        if wc < 48 || wc > 57 {
          walk_code = 1
          break
        }
        walk_code = walk_code * 10 + (wc - 48)
        wi = wi + 1
      }
    }
    c.eq_int(walk_code, 0, "std walks up from the compiler")

    proj = "/tmp/avant-coverage-${stamp}-proj"
    proj_mkdir: Array(String) = []
    proj_mkdir.push("-p")
    proj_mkdir.push("${proj}/src")
    proj_mkdir.push("${proj}/tests")
    dummy_proj = process_run("/bin/mkdir", proj_mkdir)
    toml_w = file_write("${proj}/avant.toml", "[package]\nname = \"covproj\"\nversion = \"0.0.1\"\n\n[coverage]\ninclude = [\"src\"]\nexclude = [\"tests\"]\n")
    c.eq_int(toml_w, 0, "write coverage manifest")
    greet_w = file_write("${proj}/src/greet.av", "pub fn greet: Int {\n  1\n}\npub fn other: Int {\n  2\n}\n")
    c.eq_int(greet_w, 0, "write greet")
    unused_w = file_write("${proj}/src/unused.av", "// not loaded\nfn unused: Int {\n  3\n}\n")
    c.eq_int(unused_w, 0, "write unused")
    ta_w = file_write("${proj}/tests/test_a.av", "import src.greet\nimport std.testing\nfn main: Int {\n  t = Test.new\n  t.check(greet() == 1, \"greet\")\n  t.finish\n}\n")
    c.eq_int(ta_w, 0, "write test_a")
    tb_w = file_write("${proj}/tests/test_b.av", "import src.greet\nimport std.testing\nfn main: Int {\n  t = Test.new\n  t.check(other() == 2, \"other\")\n  t.finish\n}\n")
    c.eq_int(tb_w, 0, "write test_b")
    proj_log = "/tmp/avant-coverage-${stamp}-proj.log"
    proj_rc = "/tmp/avant-coverage-${stamp}-proj.rc"
    proj_sh = "/tmp/avant-coverage-${stamp}-proj.sh"
    proj_body = "#!/bin/sh\ncd ${proj}\nexport AVANT_ROOT='${repo}'\n"
    if myc = env_get("AVANT_MYC_LLVM") {
      proj_body = "${proj_body}export AVANT_MYC_LLVM='${myc}'\n"
    }
    proj_body = "${proj_body}${abs_compiler} test --coverage --jobs 2 > ${proj_log} 2>&1\necho $? > ${proj_rc}\n"
    proj_sw = file_write(proj_sh, proj_body)
    c.eq_int(proj_sw, 0, "write coverage project script")
    chmod_x(proj_sh)
    proj_run: Array(String) = []
    proj_run.push(proj_sh)
    dummy_proj_run = process_run("/bin/sh", proj_run)
    proj_code = 1
    if proj_text = file_read(proj_rc) {
      proj_code = 0
      pt = proj_text.strip()
      pi = 0
      while pi < pt.size {
        pc = pt[pi]
        if pc < 48 || pc > 57 {
          proj_code = 1
          break
        }
        proj_code = proj_code * 10 + (pc - 48)
        pi = pi + 1
      }
    }
    c.eq_int(proj_code, 0, "avant test --coverage")
    if proj_out = file_read(proj_log) {
      c.expect(str_has(proj_out, "0 failed, 2 passed"), "coverage run passes")
      c.expect(str_has(proj_out, "% Stmts"), "coverage table has % Stmts")
      c.expect(str_has(proj_out, "All files"), "coverage table has All files")
      c.expect(str_has(proj_out, "src/unused.av"), "unloaded file is in the table")
      c.expect(str_has(proj_out, "src/greet.av"), "imported file is in the table")
    } else {
      c.expect(false, "coverage project log")
    }
    if proj_lcov = file_read("${proj}/lcov.info") {
      c.expect(str_has(proj_lcov, "SF:src/greet.av\n"), "lcov has greet")
      c.expect(str_has(proj_lcov, "SF:src/unused.av\n"), "lcov has unused")
      c.expect(str_has(proj_lcov, "DA:"), "lcov has line records")
      if str_has(proj_lcov, "test_a.av") {
        c.expect(false, "exclude drops the test file")
      } else {
        c.expect(true, "exclude drops the test file")
      }
      if str_has(proj_lcov, "FNDA:0,greet") {
        c.expect(false, "merged greet was hit")
      } else {
        c.expect(str_has(proj_lcov, "greet"), "merged greet was hit")
      }
      if str_has(proj_lcov, "FNDA:0,other") {
        c.expect(false, "merged other was hit")
      } else {
        c.expect(str_has(proj_lcov, "other"), "merged other was hit")
      }
    } else {
      c.expect(false, "project lcov")
    }
    rm_lcov: Array(String) = []
    rm_lcov.push("-f")
    rm_lcov.push("${proj}/lcov.info")
    dummy_rm = process_run("/bin/rm", rm_lcov)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_coverage(c)
  c.finish
}
