import harness
import std.fs
import std.process

fn test_coverage(c: Checks) {
  c.suite("tests/cases/test_coverage.av")
  if compiler = process.env("AVANT_COMPILER") {
    stamp = now_ms()
    src = "${scratch()}/coverage-${stamp}-cov.av"
    bin = "${scratch()}/coverage-${stamp}-cov.bin"
    log = "${scratch()}/coverage-${stamp}-cov.log"
    dump_log = "${scratch()}/coverage-${stamp}-cov.mir"
    body = "fn covered(n: Int): Int {\n  r = 0\n  if n > 0 {\n    r = 1\n  } else {\n    r = 2\n  }\n  r\n}\nfn unused(n: Int): Int {\n  n + 1\n}\nfn main {\n  x = covered(1)\n}\n"
    c.wrote(fs.write(src, body), "write coverage fixture")

    dump_code = dump_av_cov(compiler, src, dump_log)
    c.eq_int(dump_code, 0, "dump with AVANT_COVERAGE")
    if ir = fs.read(dump_log) {
      c.expect(ir.contains("avant_cov_hit"), "dump IR has avant_cov_hit")
      c.expect(ir.contains("avant_cov_init"), "dump IR has avant_cov_init")
    } else {
      c.expect(false, "dump with AVANT_COVERAGE")
    }

    code = compile_av_cov(compiler, src, bin, log)
    c.eq_int(code, 0, "compile with AVANT_COVERAGE")
    c.expect(fs.exists(bin), "coverage bin exists")
    c.expect(fs.exists("${bin}.covmap"), "slot map defaults beside the binary")
    if ir_map = fs.read(dump_log) {
      c.expect(ir_map.contains("/coverage.map"), "dump keeps its slot map in the scratch directory")
    }
    // Into a missing directory: the slot map is written while the
    // program is lowered, so its directory is created before it (the map
    // beside the binary, and AVANT_COVERAGE_MAP; on both back ends until
    // the old one retired).
    backs = ["llvm"]
    for bk in backs {
      nd = "${scratch()}/coverage-${stamp}-newdir-${bk}"
      nd_args: Array(String) = []
      nd_args.push("AVANT_BACKEND=${bk}")
      nd_args.push("AVANT_COVERAGE=1")
      nd_args.push(compiler)
      nd_args.push("compile")
      nd_args.push(src)
      nd_args.push("${nd}/a/b/cov.bin")
      nd_code = run_out("/usr/bin/env", nd_args, "${nd}.log") ?? -1
      c.eq_int(nd_code, 0, "${bk}: compile with AVANT_COVERAGE into a missing directory")
      c.expect(fs.exists("${nd}/a/b/cov.bin"), "${bk}: the binary is in the created directory")
      if nm = fs.read("${nd}/a/b/cov.bin.covmap") {
        c.expect(nm.contains("covered"), "${bk}: the slot map is written beside it")
      } else {
        c.expect(false, "${bk}: the slot map is written beside it")
      }
      ex_args: Array(String) = []
      ex_args.push("AVANT_BACKEND=${bk}")
      ex_args.push("AVANT_COVERAGE=1")
      ex_args.push("AVANT_COVERAGE_MAP=${nd}/m/n/explicit.map")
      ex_args.push(compiler)
      ex_args.push("compile")
      ex_args.push(src)
      ex_args.push("${nd}/x/cov.bin")
      ex_code = run_out("/usr/bin/env", ex_args, "${nd}-explicit.log") ?? -1
      c.eq_int(ex_code, 0, "${bk}: compile with AVANT_COVERAGE_MAP in a missing directory")
      c.expect(fs.exists("${nd}/m/n/explicit.map"), "${bk}: AVANT_COVERAGE_MAP is written in the created directory")
      // The slot map cannot be written (its path is a directory,
      // which nobody can write as a file): the build fails and
      // says which file and why (the failure was dropped and a
      // binary without its map was built with status 0).
      mkdir_p("${nd}/isdir")
      lm_args: Array(String) = []
      lm_args.push("AVANT_BACKEND=${bk}")
      lm_args.push("AVANT_COVERAGE=1")
      lm_args.push("AVANT_COVERAGE_MAP=${nd}/isdir")
      lm_args.push(compiler)
      lm_args.push("compile")
      lm_args.push(src)
      lm_args.push("${nd}/lost/cov.bin")
      lm_code = run_out("/usr/bin/env", lm_args, "${nd}-lost.log") ?? -1
      c.eq_int(lm_code, 1, "${bk}: a coverage build whose slot map cannot be written fails")
      c.expect(!fs.exists("${nd}/lost/cov.bin"), "${bk}: and builds no binary")
      c.eq_str(fs.read("${nd}-lost.log") ?? "", "error: the coverage map was not written: cannot write ${nd}/isdir: Is a directory\n", "${bk}: and names the file and the reason")
    }
    chmod_x(bin)
    // The fixture writes its own lcov. The compiler's report is a different file.
    // native runs the suite with AVANT_COVERAGE_REPORT=0. Force the table here.
    fix_lcov = "${scratch()}/coverage-${stamp}-fixture.lcov"
    cov_run: Array(String) = []
    cov_run.push("AVANT_COVERAGE_LCOV=${fix_lcov}")
    cov_run.push("AVANT_COVERAGE_REPORT=1")
    cov_run.push(bin)
    run_code = run_out("/usr/bin/env", cov_run, log) ?? -1
    c.eq_int(run_code, 0, "run coverage fixture")
    if out = fs.read(log) {
      c.expect(out.contains("% Stmts"), "coverage has % Stmts")
      c.expect(out.contains("% Branch"), "coverage has % Branch")
      c.expect(out.contains("% Funcs"), "coverage has % Funcs")
      c.expect(out.contains("% Lines"), "coverage has % Lines")
      c.expect(out.contains("Uncovered Line"), "coverage has Uncovered Line")
      c.expect(out.contains("All files"), "coverage has All files")
    } else {
      c.expect(false, "coverage table")
    }
    if lcov = fs.read(fix_lcov) {
      c.expect(lcov.contains("TN:"), "lcov has TN:")
      c.expect(lcov.contains("SF:"), "lcov has SF:")
      c.expect(lcov.contains("DA:"), "lcov has DA:")
      c.expect(lcov.contains("end_of_record"), "lcov has end_of_record")
      c.expect(lcov.contains("SF:coverage-${stamp}-cov.av\n"), "absolute path keeps its file name")
    } else {
      c.expect(false, "fixture lcov")
    }

    // The relative-path fixture compiles from inside a
    // scratch directory, so the repository is never written.
    rel_cwd = scratch_dir()
    rel_dir = "covrel-coverage-${stamp}"
    rel_src = "${rel_dir}/sample.av"
    mkdir_p("${rel_cwd}/${rel_dir}")
    c.wrote(fs.write("${rel_cwd}/${rel_src}", body), "write relative coverage fixture")
    rel_bin = "${scratch()}/coverage-${stamp}-covrel.bin"
    rel_log = "${scratch()}/coverage-${stamp}-covrel.log"
    rel_args: Array(String) = []
    rel_args.push("-C")
    rel_args.push(rel_cwd)
    rel_args.push("AVANT_COVERAGE=1")
    rel_args.push(compiler_abs("coverage", compiler))
    rel_args.push("compile")
    rel_args.push(rel_src)
    rel_args.push(rel_bin)
    rel_code = run_out("/usr/bin/env", rel_args, rel_log) ?? -1
    c.eq_int(rel_code, 0, "compile relative coverage fixture")
    chmod_x(rel_bin)
    rel_lcov_path = "${scratch()}/coverage-${stamp}-rel.lcov"
    rel_run: Array(String) = []
    rel_run.push("AVANT_COVERAGE_LCOV=${rel_lcov_path}")
    rel_run.push("AVANT_COVERAGE_REPORT=0")
    rel_run.push(rel_bin)
    rel_run_code = run_out("/usr/bin/env", rel_run, rel_log) ?? -1
    c.eq_int(rel_run_code, 0, "run relative coverage fixture")
    if rel_out = fs.read(rel_log) {
      if rel_out.contains("% Stmts") {
        c.expect(false, "REPORT=0 hides the table")
      } else {
        c.expect(true, "REPORT=0 hides the table")
      }
    } else {
      c.expect(false, "REPORT=0 log")
    }
    if rel_lcov = fs.read(rel_lcov_path) {
      c.expect(rel_lcov.contains("SF:${rel_src}\n"), "relative SF keeps the directory")
    } else {
      c.expect(false, "relative lcov")
    }

    jdir = "${scratch()}/coverage-${stamp}-jcases"
    mkdir_p(jdir)
    jcase = "${jdir}/test_ok.av"
    jbody = "import std.testing\nfn main: Int {\n  t = Test.new()\n  t.check(true, \"ok\")\n  t.finish()\n}\n"
    c.wrote(fs.write(jcase, jbody), "write junit mini case")
    junit = "${scratch()}/coverage-${stamp}-junit.xml"
    jlog = "${scratch()}/coverage-${stamp}-junit.log"
    env_args: Array(String) = []
    env_args.push("AVANT_ROOT=${avant_test_root()}")
    env_args.push("AVANT_COVERAGE_LCOV=0")
    env_args.push("AVANT_COVERAGE_REPORT=0")
    env_args.push(compiler)
    env_args.push("test")
    env_args.push("--junit")
    env_args.push(junit)
    env_args.push(jdir)
    jcode = run_out("/usr/bin/env", env_args, jlog) ?? -1
    c.eq_int(jcode, 0, "mini suite for junit")
    if jout = fs.read(jlog) {
      c.expect(jout.contains("PASS ok"), "mini suite prints PASS")
      // The runner names a file relative to its working directory when the
      // file is inside it (TMPDIR inside the checkout).
      jname = jcase
      here = "${cwd_here()}/"
      if jcase.contains(here) && str_slice(jcase, 0, here.size) == here {
        jname = str_slice(jcase, here.size, jcase.size)
      }
      c.expect(jout.contains("ok ${jname}\n"), "runner names the file")
    } else {
      c.expect(false, "mini suite log")
    }
    if xml = fs.read(junit) {
      c.expect(xml.contains("<testsuites"), "junit has testsuites")
      c.expect(xml.contains("<testcase"), "junit has testcase")
      c.expect(xml.contains("name=\"ok\""), "junit names the check")
      c.expect(xml.contains("time=\""), "junit has durations")
    } else {
      c.expect(false, "junit.xml")
    }

    abs_compiler = compiler_abs("coverage", compiler)
    flag_src = "${scratch()}/coverage-${stamp}-flag.av"
    c.wrote(fs.write(flag_src, "fn main {\n  puts(1)\n}\n"), "write flag fixture")
    flag_log = "${scratch()}/coverage-${stamp}-flag.log"
    flag_args: Array(String) = []
    flag_args.push("compile")
    flag_args.push(flag_src)
    flag_args.push("${scratch()}/coverage-${stamp}-flag.bin")
    flag_args.push("--coverage")
    flag_code = run_out(abs_compiler, flag_args, flag_log) ?? -1
    c.expect(flag_code != 0, "compile rejects --coverage")
    if flag_txt = fs.read(flag_log) {
      c.expect(flag_txt.contains("unknown"), "compile names the unknown flag")
    } else {
      c.expect(false, "compile flag log")
    }
    dump_flag_args: Array(String) = []
    dump_flag_args.push("dump")
    dump_flag_args.push(flag_src)
    dump_flag_args.push("--coverage")
    dump_flag_log = "${scratch()}/coverage-${stamp}-dump-flag.log"
    dump_flag_code = run_out(abs_compiler, dump_flag_args, dump_flag_log) ?? -1
    c.expect(dump_flag_code != 0, "dump rejects --coverage")

    repo = compiler_abs("covrepo", ".")
    miss_root = "${scratch()}/coverage-${stamp}-noroot"
    mkdir_p(miss_root)
    miss_src = "${scratch()}/coverage-${stamp}-stdimp.av"
    c.wrote(fs.write(miss_src, "import std.testing\nfn main: Int {\n  t = Test.new()\n  t.check(true, \"x\")\n  t.finish()\n}\n"), "write std import")
    miss_log = "${scratch()}/coverage-${stamp}-stdmiss.log"
    miss_env: Array(String) = []
    miss_env.push("AVANT_ROOT=${miss_root}")
    miss_env.push(abs_compiler)
    miss_env.push("compile")
    miss_env.push(miss_src)
    miss_env.push("${scratch()}/coverage-${stamp}-stdmiss.bin")
    miss_env.push("--debug")
    miss_code = run_out("/usr/bin/env", miss_env, miss_log) ?? -1
    c.expect(miss_code != 0, "AVANT_ROOT without lib/std fails")
    if miss_txt = fs.read(miss_log) {
      c.expect(miss_txt.contains("cannot find std.testing"), "missing std names the module")
    } else {
      c.expect(false, "missing std log")
    }

    walk_log = "${scratch()}/coverage-${stamp}-stdwalk.log"
    walk_rc = "${scratch()}/coverage-${stamp}-stdwalk.rc"
    walk_sh = "${scratch()}/coverage-${stamp}-stdwalk.sh"
    walk_body = "#!/bin/sh\ncd /tmp\nunset AVANT_ROOT\n"
    walk_body = "${walk_body}${abs_compiler} compile ${miss_src} ${scratch()}/coverage-${stamp}-stdwalk.bin --debug > ${walk_log} 2>&1\necho $? > ${walk_rc}\n"
    c.wrote(fs.write(walk_sh, walk_body), "write std walk script")
    chmod_x(walk_sh)
    walk_run: Array(String) = []
    walk_run.push(walk_sh)
    _ = process.run("/bin/sh", walk_run)
    walk_code = 1
    if walk_text = fs.read(walk_rc) {
      walk_code = 0
      wt = walk_text.strip()
      for wc in wt.bytes {
        if wc < 48 || wc > 57 {
          walk_code = 1
          break
        }
        walk_code = walk_code * 10 + (wc - 48)
      }
    }
    c.eq_int(walk_code, 0, "std walks up from the compiler")

    proj = "${scratch()}/coverage-${stamp}-proj"
    mkdir_p("${proj}/src")
    mkdir_p("${proj}/tests")
    c.wrote(fs.write("${proj}/avant.toml", "[package]\nname = \"covproj\"\nversion = \"0.0.1\"\n\n[coverage]\ninclude = [\"src\"]\nexclude = [\"tests\"]\n"), "write coverage manifest")
    c.wrote(fs.write("${proj}/src/greet.av", "pub fn greet: Int {\n  1\n}\npub fn other: Int {\n  2\n}\n"), "write greet")
    c.wrote(fs.write("${proj}/src/unused.av", "// not loaded\nfn unused: Int {\n  3\n}\n"), "write unused")
    c.wrote(fs.write("${proj}/tests/test_a.av", "import src.greet\nimport std.testing\nfn main: Int {\n  t = Test.new()\n  t.check(greet() == 1, \"greet\")\n  t.finish()\n}\n"), "write test_a")
    c.wrote(fs.write("${proj}/tests/test_b.av", "import src.greet\nimport std.testing\nfn main: Int {\n  t = Test.new()\n  t.check(other() == 2, \"other\")\n  t.finish()\n}\n"), "write test_b")
    proj_log = "${scratch()}/coverage-${stamp}-proj.log"
    proj_rc = "${scratch()}/coverage-${stamp}-proj.rc"
    proj_sh = "${scratch()}/coverage-${stamp}-proj.sh"
    proj_body = "#!/bin/sh\ncd ${proj}\nexport AVANT_ROOT='${repo}'\n"
    proj_body = "${proj_body}${abs_compiler} test --coverage --jobs 2 > ${proj_log} 2>&1\necho $? > ${proj_rc}\n"
    c.wrote(fs.write(proj_sh, proj_body), "write coverage project script")
    chmod_x(proj_sh)
    proj_run: Array(String) = []
    proj_run.push(proj_sh)
    _ = process.run("/bin/sh", proj_run)
    proj_code = 1
    if proj_text = fs.read(proj_rc) {
      proj_code = 0
      pt = proj_text.strip()
      for pc in pt.bytes {
        if pc < 48 || pc > 57 {
          proj_code = 1
          break
        }
        proj_code = proj_code * 10 + (pc - 48)
      }
    }
    c.eq_int(proj_code, 0, "avant test --coverage")
    if proj_out = fs.read(proj_log) {
      c.expect(proj_out.contains("0 failed, 2 passed"), "coverage run passes")
      c.expect(proj_out.contains("% Stmts"), "coverage table has % Stmts")
      c.expect(proj_out.contains("All files"), "coverage table has All files")
      c.expect(proj_out.contains("src/unused.av"), "unloaded file is in the table")
      c.expect(proj_out.contains("src/greet.av"), "imported file is in the table")
    } else {
      c.expect(false, "coverage project log")
    }
    c.expect(!fs.exists("${proj}/lcov.info"), "no lcov.info beside the manifest")
    if proj_lcov = fs.read("${proj}/coverage/lcov.info") {
      c.expect(proj_lcov.contains("SF:src/greet.av\n"), "lcov has greet")
      c.expect(proj_lcov.contains("SF:src/unused.av\n"), "lcov has unused")
      c.expect(proj_lcov.contains("DA:"), "lcov has line records")
      if proj_lcov.contains("test_a.av") {
        c.expect(false, "exclude drops the test file")
      } else {
        c.expect(true, "exclude drops the test file")
      }
      if proj_lcov.contains("FNDA:0,greet") {
        c.expect(false, "merged greet was hit")
      } else {
        c.expect(proj_lcov.contains("greet"), "merged greet was hit")
      }
      if proj_lcov.contains("FNDA:0,other") {
        c.expect(false, "merged other was hit")
      } else {
        c.expect(proj_lcov.contains("other"), "merged other was hit")
      }
    } else {
      c.expect(false, "project lcov")
    }
    rm_rf("${proj}/coverage")
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_coverage(c)
  c.finish()
}
