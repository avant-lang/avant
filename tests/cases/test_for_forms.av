import harness
import backends

// The forms of `for` and its ranges. Each program is compiled in
// parallel; a refused one must leave no binary, say the expected words
// and point at the expected line and column.
//   - `...` is refused with the two ranges Avant has.

class PCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  // 1 accepted, 2 refused, 3 compiles and traps.
  pub kind: Int = 0
}

fn accepted(tag: String, src: String, out: String): PCase {
  f = PCase.new()
  f.tag = tag
  f.src = src
  f.want = out
  f.kind = 1
  f
}

fn refused(tag: String, src: String, needle: String, pos: String): PCase {
  f = PCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f.kind = 2
  f
}

fn traps(tag: String, src: String, needle: String): PCase {
  f = PCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.kind = 3
  f
}

fn cases: Array(PCase) {
  xs: Array(PCase) = []
  xs.push(refused("dots", "fn main {\n  for i in 1...3 {\n    puts(i)\n  }\n}\n", "`...` is not a range in Avant: write `..` (end excluded) or `..=` (end included)", "2:13"))
  xs.push(refused("dots-slice", "fn main {\n  s = \"abcdef\"\n  puts(s[1...3])\n}\n", "`...` is not a range in Avant", "3:11"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(PCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/ff-${f.tag}.av"
    _ = file_write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/ff-${f.tag}.bin", "${dir}/ff-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.kind != 2 {
      runs.push(run_job(dir, "ff-${f2.tag}.bin", "ff-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/ff-${f3.tag}.log")
    if f3.kind == 1 {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.eq_int(runs[k].code, 0, "${f3.tag}: exit 0")
      c.eq_str(log_text("${dir}/ff-${f3.tag}.run.out"), f3.want, "${f3.tag}: stdout")
      k += 1
    } else if f3.kind == 3 {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.expect(runs[k].code != 0, "${f3.tag}: fails")
      c.expect(str_has(log_text("${dir}/ff-${f3.tag}.run.err"), f3.want), "${f3.tag}: says ${f3.want}")
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !file_exists("${dir}/ff-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(str_has(log, f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(str_has(log, "ff-${f3.tag}.av:${f3.pos}\n"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_for_forms.av")
  if compiler = env_get("AVANT_COMPILER") {
    run_cases(c, compiler, scratch_dir(), cases())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
