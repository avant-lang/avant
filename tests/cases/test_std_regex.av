import harness
import std.regex
import std.fs
import std.process

type Match = regex.Match
type Regex = regex.Regex
type RegexError = regex.RegexError
type RegexErrorKind = regex.RegexErrorKind

lib c {
  fun setenv(name: String, value: String, overwrite: Int32): Int32
}

// The suite's view of the regex cache's table (not a library call).
lib recache {
  fun avant_regex_cache_holds(pat: String, flags: Int): Int
}

fn set_env(name: String, value: String) {
  one: Int32 = 1
  _ = c.setenv(name, value, one)
}

fn repeated(piece: String, n: Int, tail: String): String {
  b = Buf.new()
  for i in 0..n {
    b.push_str(piece)
  }
  b.push_str(tail)
  b.to_s()
}

fn rx_quote(s: String): String {
  b = Buf.new()
  b.push_str("'")
  for i in 0..s.size {
    if s[i] == 39 {
      b.push_str("'\\''")
    } else {
      b.push_byte(s[i])
    }
  }
  b.push_str("'")
  b.to_s()
}

fn rx_sh(cmd: String): Int {
  args: Array(String) = []
  args.push("-c")
  args.push(cmd)
  process.run("/bin/sh", args) ?? -1
}

// A child program with a literal pattern: compiled, then run, then
// run again by `avant run`. The compiler's re2c notes are
// diagnostics, on stderr (they were printed on stdout, where `avant
// run` put them ahead of the program's output): `compile_has` must be
// on the compile's stderr and on `avant run`'s, `compile_lacks` on
// neither stream, and stdout must hold no note: the compile prints
// only its own line, and `avant run` exactly the program's `out`.
fn regex_child(c: Checks, compiler: String, stamp: Int, tag: String, body: String, compile_has: String, compile_lacks: String, out: String) {
  src = "${scratch()}/regex-${stamp}-${tag}.av"
  bin = "${scratch()}/regex-${stamp}-${tag}.bin"
  clog = "${scratch()}/regex-${stamp}-${tag}.log"
  cout = "${scratch()}/regex-${stamp}-${tag}.cout"
  rlog = "${scratch()}/regex-${stamp}-${tag}.out"
  aout = "${scratch()}/regex-${stamp}-${tag}.aout"
  aerr = "${scratch()}/regex-${stamp}-${tag}.aerr"
  _ = fs.write(src, body)
  code = rx_sh("${rx_quote(compiler)} compile ${rx_quote(src)} ${rx_quote(bin)} --debug > ${rx_quote(cout)} 2> ${rx_quote(clog)} < /dev/null")
  c.eq_int(code, 0, "compile ${tag}")
  c.expect(fs.exists(bin), "${tag} bin")
  cstdout = fs.read(cout) ?? ""
  if err = fs.read(clog) {
    if compile_has.size > 0 {
      c.expect(err.contains(compile_has), "${tag} compile says ${compile_has} on stderr")
    }
    if compile_lacks.size > 0 {
      c.expect(!err.contains(compile_lacks) && !cstdout.contains(compile_lacks), "${tag} compile lacks ${compile_lacks}")
    }
  } else {
    if compile_has.size > 0 {
      c.expect(false, "${tag} compile log")
    }
  }
  c.expect(!cstdout.contains("re2c:"), "${tag} compile prints no re2c note on stdout")
  chmod_x(bin)
  run_code = run_av_bin(bin, rlog)
  c.eq_int(run_code, 0, "run ${tag}")
  if got = fs.read(rlog) {
    c.eq_str(got, out, "${tag} stdout")
  } else {
    c.expect(false, "${tag} stdout missing")
  }
  acode = rx_sh("${rx_quote(compiler)} run ${rx_quote(src)} > ${rx_quote(aout)} 2> ${rx_quote(aerr)} < /dev/null")
  c.eq_int(acode, 0, "avant run ${tag}")
  c.eq_str(fs.read(aout) ?? "", out, "${tag}: avant run's stdout is the program's output only")
  if compile_has.size > 0 {
    c.expect((fs.read(aerr) ?? "").contains(compile_has), "${tag}: avant run says ${compile_has} on stderr")
  }
}

// One run of a compiled child that must trap: exit status 1, `out` on
// stdout before the trap, `needle` on stderr (the log holds both).
fn regex_trap_run(c: Checks, bin: String, stamp: Int, tag: String, args: Array(String), out: String, needle: String) {
  rlog = "${scratch()}/regex-${stamp}-${tag}.out"
  code = run_out(bin, args, rlog) ?? -1
  c.eq_int(code, 1, "${tag}: exits 1")
  if got = fs.read(rlog) {
    c.eq_str(got, "${out}${needle}\n", "${tag}: output, then the trap")
  } else {
    c.expect(false, "${tag}: output missing")
  }
}

fn one_arg(a: String): Array(String) {
  xs: Array(String) = []
  xs.push(a)
  xs
}

fn must_compile(c: Checks, pat: String, caseless: Bool, label: String): Regex {
  if re = Regex.compile(pat, caseless) {
    return re
  }
  c.expect(false, "compile ${label}")
  must_compile(c, "a+", false, "fallback")
}

fn count_of(r: Int | RegexError): String {
  switch r {
    case n: Int { "count ${n}" }
    case e: RegexError { "error ${e.kind}: ${e.message}" }
  }
}

fn text_of(r: String | RegexError): String {
  switch r {
    case t: String { "text ${t}" }
    case e: RegexError { "error ${e.kind}: ${e.message}" }
  }
}

fn parts_of(r: Array(String) | RegexError): String {
  switch r {
    case ps: Array(String) {
      out = "parts"
      for i in 0..ps.size {
        if i == 0 {
          out = out + " " + ps[i]
        } else {
          out = out + "|" + ps[i]
        }
      }
      out
    }
    case e: RegexError { "error ${e.kind}: ${e.message}" }
  }
}

fn walk_of(it: regex.TryMatchIter): String {
  got = ""
  while m = it.next() {
    got = got + " ${m.start}..${m.end}"
  } else e {
    if err = e {
      got = got + " error ${err.kind}: ${err.message}"
    } else {
      got = got + " end"
    }
  }
  got
}

// The try_ twins of count, replace, replace_into, split and matches give
// a match that reaches a limit as a RegexError, as try_find does; the
// plain ones trap. `(a+)+b` finds "ab" at once and backtracks past a
// match limit of 1000 on twenty a's followed by a c (a b later in the
// text, so PCRE2's required-character check does not end the match
// first).
fn regex_try_forms(c: Checks) {
  pat = "(a+)+"
  pat = pat + "b"
  re = Regex.compile(pat, match_limit: 1000) ?? return c.expect(false, "compile the try_ pattern")
  ok = "ab-ab-x"
  bad = "ab-ab-" + repeated("a", 20, "c b")
  limit = "error match_limit: regex.Regex.try_"
  c.eq_str(count_of(re.try_count(ok)), "count 2", "try_count counts")
  c.eq_str(count_of(re.try_count("")), "count 0", "try_count of no match is 0")
  c.eq_str(count_of(re.try_count(bad)), "${limit}count: match limit exceeded (PCRE2 error -47)", "try_count at the limit is a RegexError")
  c.eq_str(text_of(re.try_replace(ok, "<$1>")), "text <a>-<a>-x", "try_replace replaces")
  c.eq_str(text_of(re.try_replace(bad, "<$1>")), "${limit}replace: match limit exceeded (PCRE2 error -47)", "try_replace at the limit is a RegexError")
  dst = Buf.new()
  dst.push_str("kept:")
  if err = re.try_replace_into(dst, bad, "<$1>") {
    c.eq_str("${err.kind}", "match_limit", "try_replace_into at the limit is a RegexError")
  } else {
    c.expect(false, "try_replace_into at the limit is a RegexError")
  }
  c.eq_str(dst.to_s(), "kept:", "and leaves its Buf as it was")
  if err = re.try_replace_into(dst, ok, "_") {
    c.expect(false, "try_replace_into appends: ${err}")
  }
  c.eq_str(dst.to_s(), "kept:_-_-x", "try_replace_into appends")
  c.eq_str(parts_of(re.try_split(ok)), "parts |-|-x", "try_split splits")
  c.eq_str(parts_of(re.try_split(bad)), "${limit}split: match limit exceeded (PCRE2 error -47)", "try_split at the limit is a RegexError")
  c.eq_str(walk_of(re.try_matches(ok)), " 0..2 3..5 end", "try_matches walks")
  c.eq_str(walk_of(re.try_matches(bad)), " 0..2 3..5 error match_limit: regex.Regex.try_matches: match limit exceeded (PCRE2 error -47)", "try_matches gives the matches before the failure, then the RegexError")
  it = re.try_matches(bad)
  _ = walk_of(it)
  c.eq_str(kind_of(it.next()), "nil", "a walk ends after its RegexError")
  c.eq_str(kind_of(re.try_find(bad, 6)), "error ${RegexErrorKind.match_limit.to_i()}", "try_find keeps its own name")
  c.eq_str(message_of(re.try_find(bad, 6)), "regex.Regex.try_find: match limit exceeded (PCRE2 error -47)", "try_find's message")
  re.close()
}

// Patterns held by Regex values that are never closed (a dropped Regex
// is not closed for the program) no longer keep the cache from others:
// with its 128 entries all held, a new pattern takes the place of the
// least recently used held one, which lives on outside the table. It used
// to be compiled uncached, and so compiled again at every compile.
fn regex_cache_held(c: Checks) {
  held: Array(Regex) = []
  for i in 0..128 {
    if r = Regex.compile("held${i}y+") {
      held.push(r)
    }
  }
  c.eq_int(held.size, 128, "128 patterns held")
  c.eq_int(recache.avant_regex_cache_holds("held127y+", 0), 1, "the table holds the last held pattern")
  fresh = must_compile(c, "fresh-after-held+", false, "a pattern after 128 held")
  c.eq_int(recache.avant_regex_cache_holds("fresh-after-held+", 0), 1, "a new pattern is cached although every entry is held")
  c.eq_int(recache.avant_regex_cache_holds("held0y+", 0), 0, "the least recently used held pattern left the table")
  if m = held[0].find("zheld0yyy") {
    c.eq_int(m.end, 9, "and still matches for the Regex holding it")
  } else {
    c.expect(false, "and still matches for the Regex holding it")
  }
  fresh.close()
  c.eq_int(recache.avant_regex_cache_holds("fresh-after-held+", 0), 1, "a closed cached pattern stays for the next compile")
  for r in held {
    r.close()
  }
}

fn kind_of(r: Match? | RegexError): String {
  switch r {
    case m: Match {
      return "match ${m.start}..${m.end}"
    }
    case e: RegexError {
      return "error ${e.kind.to_i()}"
    }
    else {
      return "nil"
    }
  }
}

fn message_of(r: Match? | RegexError): String {
  switch r {
    case e: RegexError {
      return e.message
    }
    else {
      return ""
    }
  }
}

// A match's failure is a value from try_find, and each Regex has its own
// limits. find, count, replace, split and matches trap at a limit (the
// child program below); try_find gives a RegexError whose kind is the
// limit reached, so a pattern or a text from outside need not end the
// program. There was no limit to set and no value to get: every failure
// was a trap.
fn regex_limits(c: Checks) {
  bt_pat = "(a+)+"
  bt_pat = bt_pat + "$"
  bt = must_compile(c, bt_pat, false, "backtracking")
  wild = repeated("a", 40, "b aaa")
  c.eq_str(kind_of(bt.try_find(wild)), "error ${RegexErrorKind.match_limit.to_i()}", "try_find past the match limit is a RegexError of kind match_limit")
  c.eq_str(message_of(bt.try_find(wild)), "regex.Regex.try_find: match limit exceeded (PCRE2 error -47)", "its message names the operation and PCRE2's reason")
  c.eq_str(kind_of(bt.try_find("xaay")), "nil", "try_find without a match is nil")
  c.eq_str(kind_of(bt.try_find("baa")), "match 1..3", "try_find with a match is the Match")
  c.eq_str(kind_of(bt.try_find("baa", 2)), "match 2..3", "try_find from an offset")
  // Twelve a's and a b take a few thousand steps: within the default
  // limit, past a limit of 1000 set on another compile of the pattern.
  short = repeated("a", 12, "b")
  c.eq_str(kind_of(bt.try_find(short)), "nil", "within the default match limit: no match")
  if tight = Regex.compile(bt_pat, match_limit: 1000) {
    c.eq_str(kind_of(tight.try_find(short)), "error ${RegexErrorKind.match_limit.to_i()}", "a match_limit of the Regex's own is reached")
    c.eq_str(kind_of(tight.try_find("baa")), "match 1..3", "and a short match is still found under it")
    tight.close()
  } else {
    c.expect(false, "compile with match_limit")
  }
  c.eq_str(kind_of(bt.try_find(short)), "nil", "the default compile of the same pattern keeps its own limit")
  bt.close()

  deep_pat = "((a)|(b))*"
  deep_pat = deep_pat + "c"
  deep_text = repeated("ab", 20000, "c")
  if small = Regex.compile(deep_pat, heap_limit: 262144) {
    c.eq_str(kind_of(small.try_find(deep_text)), "error ${RegexErrorKind.heap_limit.to_i()}", "a deep match past heap_limit (256 KiB) is a RegexError of kind heap_limit")
    c.eq_str(kind_of(small.try_find(repeated("ab", 200, "c"))), "match 0..401", "a shallow one is found under it")
    small.close()
  } else {
    c.expect(false, "compile with heap_limit")
  }
  if shallow = Regex.compile(deep_pat, depth_limit: 1000) {
    // The depth limit binds the interpreter: the JIT's stack is made
    // small here (the suite's internal variable) so the match reaches it.
    set_env("AVANT_RE_JIT_STACK_KB", "32")
    c.eq_str(kind_of(shallow.try_find(deep_text)), "error ${RegexErrorKind.depth_limit.to_i()}", "past depth_limit on the interpreter: a RegexError of kind depth_limit")
    set_env("AVANT_RE_JIT_STACK_KB", "")
    c.eq_str(kind_of(shallow.try_find(deep_text)), "match 0..40001", "the JIT's larger stack answers it")
    shallow.close()
  } else {
    c.expect(false, "compile with depth_limit")
  }
  dflt = must_compile(c, deep_pat, false, "deep default")
  c.eq_str(kind_of(dflt.try_find(deep_text)), "match 0..40001", "the default limits answer the deep match")
  dflt.close()

  // Limits past PCRE2's 32-bit fields are its largest.
  if huge = Regex.compile("x+", match_limit: 1 << 40, depth_limit: 1 << 40, heap_limit: 1 << 60) {
    c.eq_str(kind_of(huge.try_find("axx")), "match 1..3", "limits past 32 bits are the largest")
    huge.close()
  } else {
    c.expect(false, "compile with huge limits")
  }

  switch Regex.compile("(open") {
    case e: RegexError {
      c.expect(e.kind == RegexErrorKind.pattern, "a pattern that does not compile is of kind pattern")
    }
    case Regex {
      c.expect(false, "a pattern that does not compile is of kind pattern")
    }
  }
}

fn test_std_regex(c: Checks) {
  c.suite("tests/cases/test_std_regex.av")

  lit = must_compile(c, "a+", false, "literal")
  if m = lit.find("xxaa") {
    c.eq_int(m.start, 2, "literal start")
    c.eq_int(m.end, 4, "literal end")
    c.eq_str(m.group(0) ?? "", "aa", "literal group 0")
  } else {
    c.expect(false, "literal find")
  }
  if none = lit.find("xx") {
    c.expect(false, "no match is nil")
  } else {
    c.expect(true, "no match is nil")
  }
  if later = lit.find("xxaa", 3) {
    c.eq_int(later.start, 3, "find from offset")
  } else {
    c.expect(false, "find from offset")
  }
  lit.close()

  cap = must_compile(c, "x(y)", false, "capture")
  if m = cap.find("xy") {
    c.eq_str(m.group(1) ?? "", "y", "capture group")
    if sp = m.span(1) {
      c.eq_int(sp.lo, 1, "capture span lo")
      c.eq_int(sp.hi, 2, "capture span hi")
    } else {
      c.expect(false, "capture span")
    }
    if g5 = m.group(5) {
      c.expect(false, "group beyond count is nil")
    } else {
      c.expect(true, "group beyond count is nil")
    }
    c.eq_int(m.group_count(), 1, "group count")
  } else {
    c.expect(false, "capture find")
  }
  cap.close()

  word = must_compile(c, "bot", true, "caseless")
  if m = word.find("GoogleBot") {
    c.eq_int(m.start, 6, "caseless start")
  } else {
    c.expect(false, "caseless find")
  }
  word.close()

  braces = must_compile(c, "\\{\\{(.*?)\\}\\}", false, "braces")
  if m = braces.find("{{TITLE}}{{a}b}}") {
    c.eq_int(m.start, 0, "non-greedy start")
    c.eq_int(m.end, 9, "non-greedy end")
    c.eq_str(m.group(1) ?? "", "TITLE", "non-greedy group")
  } else {
    c.expect(false, "non-greedy find")
  }
  braces.close()

  built = "x"
  built = built + "(y)"
  dyn = must_compile(c, built, false, "computed")
  if m = dyn.find("zxy") {
    c.eq_int(m.start, 1, "computed start")
    c.eq_str(m.group(1) ?? "", "y", "computed group")
  } else {
    c.expect(false, "computed find")
  }
  dyn.close()

  counted = must_compile(c, "a+", false, "count")
  c.eq_int(counted.count("aa ba"), 2, "count")
  c.eq_int(counted.count("zz"), 0, "count none")
  counted.close()

  back = "(a)\\1"
  bref = must_compile(c, back, false, "backref")
  if m = bref.find("baa") {
    c.eq_int(m.start, 1, "backref start")
    c.eq_int(m.end, 3, "backref end")
  } else {
    c.expect(false, "backref find")
  }
  bref.close()

  if bad = Regex.compile("(unclosed") {
    c.expect(false, "bad pattern is RegexError")
    bad.close()
  } else {
    c.expect(true, "bad pattern is RegexError")
  }

  named = must_compile(c, "(?<word>[a-z]+)([0-9]+)", false, "named")
  if m = named.find("abc123") {
    c.eq_str(m.group("word") ?? "", "abc", "named group")
    c.eq_str(m.group(2) ?? "", "123", "named second group")
    if nope = m.group("missing") {
      c.expect(false, "missing name is nil")
    } else {
      c.expect(true, "missing name is nil")
    }
  } else {
    c.expect(false, "named find")
  }
  named.close()

  multi = must_compile(c, "(a)(b)?", false, "optional group")
  if m = multi.find("xa") {
    c.eq_str(m.group(1) ?? "", "a", "first of two groups")
    if g2 = m.group(2) {
      c.expect(false, "unmatched group is nil")
    } else {
      c.expect(true, "unmatched group is nil")
    }
    if sp2 = m.span(2) {
      c.expect(false, "unmatched span is nil")
    } else {
      c.expect(true, "unmatched span is nil")
    }
  } else {
    c.expect(false, "optional group find")
  }
  multi.close()

  iter_re = must_compile(c, "a+", false, "iterator")
  total = 0
  iter = iter_re.matches("aa ba aaa")
  for m in iter {
    total = total + (m.end - m.start)
  }
  c.eq_int(total, 6, "iterator total length")
  if extra = iter.next() {
    c.expect(false, "iterator stays done")
  } else {
    c.expect(true, "iterator stays done")
  }
  c.eq_str(iter_re.replace("aa ba", "<$0>"), "<aa> b<a>", "replace whole")
  c.eq_str(iter_re.replace("aa", "$$1"), "$1", "replace dollar escape")
  parts = iter_re.split("aa ba a")
  c.eq_int(parts.size, 4, "split size")
  c.eq_str(parts[1], " b", "split piece")
  dst = Buf.new()
  iter_re.replace_into(dst, "aa ba", "[$0]")
  c.eq_str(dst.to_s(), "[aa] b[a]", "replace_into")
  iter_re.close()

  swap = must_compile(c, "(a+)(b+)", false, "swap groups")
  c.eq_str(swap.replace("aabb", "$2$1"), "bbaa", "replace with groups")
  c.eq_str(swap.replace("aabb", r"${2}-${1}"), "bb-aa", "replace with braced groups")
  swap.close()

  shared_a = must_compile(c, "zz+", false, "shared a")
  shared_b = must_compile(c, "zz+", false, "shared b")
  shared_a.close()
  shared_a.close()
  if m = shared_b.find("azzz") {
    c.eq_int(m.end, 4, "shared pattern survives sibling close")
  } else {
    c.expect(false, "shared pattern survives sibling close")
  }
  // A use after close traps (test_system.av lib-regex-*).
  c.expect(shared_a.is_closed(), "closed regex says so")
  shared_b.close()

  // The open or closed state is one shared place: a copy of a
  // Regex is the same handle, so closing through any copy closes
  // them all, once. Each copy used to carry its own flag, and a
  // copy of a closed Regex read the released handle.
  twin_a = must_compile(c, "yy+", false, "twin a")
  twin_b = must_compile(c, "yy+", false, "twin b")
  twin_copy = twin_a
  c.expect(!twin_copy.is_closed(), "a copy of an open regex is open")
  twin_a.close()
  c.expect(twin_copy.is_closed(), "closing a regex closes its copies")
  twin_copy.close()
  twin_a.close()
  c.expect(!twin_b.is_closed(), "another compile of the same pattern stays open")
  if m = twin_b.find("ayyy") {
    c.eq_int(m.end, 4, "another compile of the same pattern still matches")
  } else {
    c.expect(false, "another compile of the same pattern still matches")
  }
  twin_b.close()

  // PCRE2's failures are not "no match". A
  // match that nests deeper than the JIT's 32 KiB stack is answered: by
  // the JIT on a larger stack, and past that by the interpreter (reached
  // here by shrinking that stack with the suite's internal variable
  // AVANT_RE_JIT_STACK_KB). It used to be nil, and count 0.
  deep_pat = "((a)|(b))*"
  deep_pat = deep_pat + "c"
  deep = must_compile(c, deep_pat, false, "deep")
  deep_text = repeated("ab", 20000, "c")
  if m = deep.find(deep_text) {
    c.eq_int(m.end - m.start, 40001, "a match deeper than the JIT's own stack is found")
  } else {
    c.expect(false, "a match deeper than the JIT's own stack is found")
  }
  c.eq_int(deep.count(deep_text), 1, "and counted")
  set_env("AVANT_RE_JIT_STACK_KB", "64")
  if m = deep.find(deep_text) {
    c.eq_int(m.end - m.start, 40001, "past the JIT's larger stack the interpreter finds it")
  } else {
    c.expect(false, "past the JIT's larger stack the interpreter finds it")
  }
  c.eq_int(deep.count(deep_text), 1, "and counts it")
  set_env("AVANT_RE_JIT_STACK_KB", "")
  deep.close()

  regex_limits(c)
  regex_try_forms(c)
  regex_cache_held(c)

  // Groups past the 63rd are read: the span pairs were capped at 64, so
  // they read as "did not take part".
  many = must_compile(c, repeated("(x)", 70, ""), false, "seventy groups")
  if m = many.find(repeated("x", 70, "")) {
    c.eq_int(m.group_count(), 70, "seventy groups counted")
    c.eq_str(m.group(63) ?? "nil", "x", "group 63")
    c.eq_str(m.group(64) ?? "nil", "x", "group 64 took part")
    c.eq_str(m.group(70) ?? "nil", "x", "group 70 took part")
    if sp = m.span(70) {
      c.eq_int(sp.lo, 69, "group 70 span")
    } else {
      c.expect(false, "group 70 span")
    }
  } else {
    c.expect(false, "seventy groups match")
  }
  many.close()

  scoped_len = 0
  if re = Regex.compile("q+") {
    re.scoped (r) {
      if m = r.find("aqq") {
        scoped_len = m.end
      }
    }
  }
  c.eq_int(scoped_len, 3, "scoped block result")

  if compiler = process.env("AVANT_COMPILER") {
    stamp = now_ms()
    literal = "import std.regex\nfn main {\n  if re = regex.Regex.compile(\"a+\") {\n    if m = re.find(\"xxaa\") {\n      puts(m.start)\n      puts(m.end)\n    }\n    re.close()\n  }\n}\n"
    regex_child(c, compiler, stamp, "regex-literal", literal, "", "stays on PCRE2", "2\n4\n")
    computed = "import std.regex\nfn main {\n  p = \"a\"\n  p = p + \"+\"\n  if re = regex.Regex.compile(p) {\n    if m = re.find(\"xxaa\") {\n      puts(m.start)\n      puts(m.end)\n    }\n    re.close()\n  }\n}\n"
    regex_child(c, compiler, stamp, "regex-computed", computed, "", "stays on PCRE2", "2\n4\n")
    unsupported = "import std.regex\nfn main {\n  if re = regex.Regex.compile(\"(a)\\\\1\") {\n    if m = re.find(\"baa\") {\n      puts(m.start)\n      puts(m.end)\n    }\n    re.close()\n  }\n}\n"
    regex_child(c, compiler, stamp, "regex-backref", unsupported, "stays on PCRE2", "", "1\n3\n")

    // Every use through a copy of a closed Regex traps, whichever
    // copy was closed and wherever the copy lives (a parameter, an array,
    // a MatchIter, a Match's named groups and its groups past the third).
    // "uncached" then fills the 128-entry cache with patterns in use, so
    // the pattern leaves the cache's table and is freed by close itself:
    // that run used to end in a segmentation fault.
    copies = "import std.regex\n\nfn shut(r: regex.Regex) {\n  r.close()\n}\n\nfn main {\n  args = process.args()\n  mode = \"\"\n  if args.size > 1 {\n    mode = args[1]\n  }\n  held: Array(regex.Regex) = []\n  p = \"(?<w>a+)(b)(c)(d)\"\n  if mode != \"names\" {\n    p = \"q\" + \"+z\"\n  }\n  if re = regex.Regex.compile(p) {\n    copy = re\n    if mode == \"uncached\" {\n      for i in 0..128 {\n        if r = regex.Regex.compile(\"h\${i}x+\") {\n          held.push(r)\n        }\n      }\n    }\n    if mode == \"copy-find\" || mode == \"uncached\" {\n      re.close()\n      puts(\"closed \${copy.is_closed()}\")\n      if m = copy.find(\"aqqz\") {\n        puts(m.start)\n      }\n    }\n    if mode == \"copy-close\" {\n      copy.close()\n      puts(\"closed \${re.is_closed()}\")\n      puts(re.count(\"qz qqz\"))\n    }\n    if mode == \"param\" {\n      shut(re)\n      puts(\"closed \${re.is_closed()}\")\n      puts(re.replace(\"qz\", \"x\"))\n    }\n    if mode == \"array\" {\n      xs: Array(regex.Regex) = []\n      xs.push(re)\n      re.close()\n      puts(\"closed \${xs[0].is_closed()}\")\n      puts(xs[0].split(\"aqzb\").size)\n    }\n    if mode == \"iter\" {\n      it = re.matches(\"qz qqz\")\n      if m = it.next() {\n        puts(m.end)\n      }\n      copy.close()\n      if m = it.next() {\n        puts(m.end)\n      }\n    }\n    if mode == \"names\" {\n      if m = re.find(\"xaabcd\") {\n        re.close()\n        puts(m.group(1) ?? \"?\")\n        puts(m.group(3) ?? \"?\")\n        if args.size > 2 {\n          puts(m.group(4) ?? \"?\")\n        } else {\n          puts(m.group(\"w\") ?? \"?\")\n        }\n      }\n    }\n  }\n  puts(held.size)\n}\nimport std.process\n"
    csrc = "${scratch()}/regex-${stamp}-copies.av"
    cbin = "${scratch()}/regex-${stamp}-copies.bin"
    _ = fs.write(csrc, copies)
    c.eq_int(compile_av(compiler, csrc, cbin, "${scratch()}/regex-${stamp}-copies.log"), 0, "compile closed-copies")
    chmod_x(cbin)
    // The trap names the program's call of the closed Regex.
    trap = "avant runtime: regex.Regex used after close at regex-${stamp}-copies.av:"
    regex_trap_run(c, cbin, stamp, "copy-find", one_arg("copy-find"), "closed true\n", "${trap}30:18")
    regex_trap_run(c, cbin, stamp, "uncached", one_arg("uncached"), "closed true\n", "${trap}30:18")
    regex_trap_run(c, cbin, stamp, "copy-close", one_arg("copy-close"), "closed true\n", "${trap}37:14")
    regex_trap_run(c, cbin, stamp, "param", one_arg("param"), "closed true\n", "${trap}42:14")
    regex_trap_run(c, cbin, stamp, "array", one_arg("array"), "closed true\n", "${trap}49:17")
    regex_trap_run(c, cbin, stamp, "iter", one_arg("iter"), "2\n", "${trap}57:16")
    regex_trap_run(c, cbin, stamp, "names", one_arg("names"), "aa\nc\n", "${trap}69:17")
    fourth = one_arg("names")
    fourth.push("4")
    regex_trap_run(c, cbin, stamp, "names-4", fourth, "aa\nc\n", "${trap}67:17")

    // A match that reaches PCRE2's match limit traps, naming the
    // operation: (a+)+$ on forty a's, a b and "aaa" has a match (the last
    // three a's), but the attempt at the first a backtracks past the
    // limit. It used to read as "no match": find nil, count 0, replace
    // and split the text unchanged, the iterator done.
    limits = "import std.regex\n\nfn main {\n  args = process.args()\n  mode = \"\"\n  if args.size > 1 {\n    mode = args[1]\n  }\n  p = \"(a+)+\"\n  p = p + \"\$\"\n  b = Buf.new()\n  for i in 0..40 {\n    b.push_str(\"a\")\n  }\n  b.push_str(\"b aaa\")\n  text = b.to_s()\n  if re = regex.Regex.compile(p) {\n    puts(\"start\")\n    if mode == \"find\" {\n      if m = re.find(text) {\n        puts(m.start)\n      } else {\n        puts(\"nil\")\n      }\n    }\n    if mode == \"count\" {\n      puts(re.count(text))\n    }\n    if mode == \"replace\" {\n      puts(re.replace(text, \"X\"))\n    }\n    if mode == \"split\" {\n      puts(re.split(text).size)\n    }\n    if mode == \"matches\" {\n      it = re.matches(text)\n      if m = it.next() {\n        puts(m.start)\n      } else {\n        puts(\"nil\")\n      }\n    }\n  }\n}\nimport std.process\n"
    lsrc = "${scratch()}/regex-${stamp}-limits.av"
    lbin = "${scratch()}/regex-${stamp}-limits.bin"
    _ = fs.write(lsrc, limits)
    c.eq_int(compile_av(compiler, lsrc, lbin, "${scratch()}/regex-${stamp}-limits.log"), 0, "compile limits")
    chmod_x(lbin)
    said = "match limit exceeded (PCRE2 error -47)"
    regex_trap_run(c, lbin, stamp, "limit-find", one_arg("find"), "start\n", "avant runtime: regex.Regex.find: ${said}")
    regex_trap_run(c, lbin, stamp, "limit-count", one_arg("count"), "start\n", "avant runtime: regex.Regex.count: ${said}")
    regex_trap_run(c, lbin, stamp, "limit-replace", one_arg("replace"), "start\n", "avant runtime: regex.Regex.replace: ${said}")
    regex_trap_run(c, lbin, stamp, "limit-split", one_arg("split"), "start\n", "avant runtime: regex.Regex.split: ${said}")
    regex_trap_run(c, lbin, stamp, "limit-matches", one_arg("matches"), "start\n", "avant runtime: regex.Regex.matches: ${said}")

    // A limit below 1 is a program error: compile traps, naming it and
    // the program's call.
    bad = "import std.regex\n\nfn main {\n  mode = process.args()[1]\n  puts(\"start\")\n  if mode == \"match\" {\n    _ = regex.Regex.compile(\"a+\", match_limit: 0)\n  }\n  if mode == \"depth\" {\n    _ = regex.Regex.compile(\"a+\", depth_limit: -3)\n  }\n  if mode == \"heap\" {\n    _ = regex.Regex.compile(\"a+\", false, 10, 10, 0)\n  }\n}\nimport std.process\n"
    bsrc = "${scratch()}/regex-${stamp}-badlimits.av"
    bbin = "${scratch()}/regex-${stamp}-badlimits.bin"
    _ = fs.write(bsrc, bad)
    c.eq_int(compile_av(compiler, bsrc, bbin, "${scratch()}/regex-${stamp}-badlimits.log"), 0, "compile bad limits")
    chmod_x(bbin)
    regex_trap_run(c, bbin, stamp, "bad-match-limit", one_arg("match"), "start\n", "avant runtime: regex.Regex.compile: match_limit must be at least 1 (got 0) at regex-${stamp}-badlimits.av:7:20")
    regex_trap_run(c, bbin, stamp, "bad-depth-limit", one_arg("depth"), "start\n", "avant runtime: regex.Regex.compile: depth_limit must be at least 1 (got -3) at regex-${stamp}-badlimits.av:10:20")
    regex_trap_run(c, bbin, stamp, "bad-heap-limit", one_arg("heap"), "start\n", "avant runtime: regex.Regex.compile: heap_limit must be at least 1 (got 0) at regex-${stamp}-badlimits.av:13:20")

    // A literal pattern with limits, named or not, is still re2c's
    // scanner (no note that it stays on PCRE2), and runs as without them.
    lit_limits = "import std.regex\nfn main {\n  if re = regex.Regex.compile(\"a+\", match_limit: 1000) {\n    if m = re.find(\"xxaa\") {\n      puts(m.start)\n      puts(m.end)\n    }\n    puts(re.count(\"aa b aaa\"))\n    re.close()\n  }\n  if re = regex.Regex.compile(\"b+\", true, 100, 100, 4096) {\n    puts(re.count(\"aBb b\"))\n    re.close()\n  }\n}\n"
    regex_child(c, compiler, stamp, "regex-literal-limits", lit_limits, "", "stays on PCRE2", "2\n4\n2\n2\n")

    // A text holding NUL bytes, before, inside and after a match, and a
    // view of one: every literal pattern's scanner (no note that it stays
    // on PCRE2) gives the answers of the same pattern built at run time
    // (PCRE2) for find, find from a position, every match, count, replace
    // and split, and never reads past the text's end (a class that matches
    // a NUL byte, such as [^a], ran past the terminator before).
    nul_src = fs.read("tests/fixtures/strings/regex_nul.av") ?? ""
    c.expect(nul_src.size > 0, "regex_nul.av read")
    regex_child(c, compiler, stamp, "regex-nul", nul_src, "", "stays on PCRE2", "[0-9]+ on ab\\0cd42: 5..7\n156 cases, 0 differ\n")

    // The translation keeps PCRE2's meaning: a class's letters take their
    // other case only in a caseless pattern, an escape it does not know
    // and the anchors keep the pattern on PCRE2 (each said on stderr), and
    // a pattern whose matches all start with one byte, scanned by skipping
    // to that byte, gives PCRE2's answers (a NUL byte in the text included).
    tr_src = fs.read("tests/fixtures/strings/regex_translate.av") ?? ""
    c.expect(tr_src.size > 0, "regex_translate.av read")
    regex_child(c, compiler, stamp, "regex-translate", tr_src, "re2c: pattern stays on PCRE2 (anchor): ^ab", "", "1050 cases, 0 differ\n")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_std_regex(c)
  c.finish()
}
