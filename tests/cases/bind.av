fn s23_run(compiler: String, cmd: String, log: String, flags: Array(String)): Int {
  args: Array(String) = []
  args.push(cmd)
  i = 0
  while i < flags.size {
    args.push(flags[i])
    i = i + 1
  }
  process_run_out(compiler, args, log)
}

fn s23_read(path: String): String {
  if text = file_read(path) {
    return text
  }
  ""
}

fn s23_body(text: String): String {
  i = 0
  while i < text.size {
    if text[i] == 10 {
      return str_slice(text, i + 1, text.size)
    }
    i = i + 1
  }
  text
}

fn s23_head(text: String): String {
  if text.size > 240 {
    return str_slice(text, 0, 240)
  }
  text
}

fn s23_has_lib(text: String): Bool {
  if text.size >= 4 {
    if str_eq(str_slice(text, 0, 4), "lib ") {
      return true
    }
  }
  str_has(text, "\nlib ")
}

fn test_bind(c: Checks) {
  c.suite("tests/cases/bind.av")
  if compiler = env_get("AVANT_COMPILER") {
    c.expect(file_exists(compiler), "AVANT_COMPILER exists")
    root = avant_test_root()
    stamp = now_ms()
    none: Array(String) = []
    stale_w = file_write("${root}/bin/avant-bind.src", "stale")
    c.eq_int(stale_w, 0, "stale stamp is written")

    add_h = "${root}/examples/c/add.h"
    add_log = "/tmp/avant-s23-${stamp}-add.log"
    add_flags: Array(String) = []
    add_flags.push(add_h)
    add_code = s23_run(compiler, "bind", add_log, add_flags)
    c.eq_int(add_code, 0, "bind add.h exits 0")
    add_txt = s23_read(add_log)
    c.expect(str_has(add_txt, "lib add {"), "default lib name is the header stem (${s23_head(add_txt)})")
    c.expect(str_has(add_txt, "fun avant_add(a: Int, b: Int): Int"), "avant_add")
    c.expect(str_has(add_txt, "fun avant_sentinel: Ptr(Void)"), "avant_sentinel")
    c.expect(str_has(add_txt, "fun avant_is_null(p: Ptr(Void)): Int"), "avant_is_null")
    c.expect(str_has(add_txt, "// generated by avant bind from ${add_h}"), "generated comment")

    over_log = "/tmp/avant-s23-${stamp}-over.log"
    over_flags: Array(String) = []
    over_flags.push("--lib")
    over_flags.push("math")
    over_flags.push(add_h)
    over_code = s23_run(compiler, "b", over_log, over_flags)
    c.eq_int(over_code, 0, "b --lib exits 0")
    over_txt = s23_read(over_log)
    c.expect(str_has(over_txt, "lib math {"), "--lib overrides the name")
    c.expect(!str_has(over_txt, "lib add {"), "--lib replaces the stem")

    eq_log = "/tmp/avant-s23-${stamp}-eq.log"
    eq_flags: Array(String) = []
    eq_flags.push("--lib=z")
    eq_flags.push("${root}/examples/c/zlib_version.h")
    eq_code = s23_run(compiler, "bind", eq_log, eq_flags)
    c.eq_int(eq_code, 0, "--lib= exits 0")
    eq_txt = s23_read(eq_log)
    c.expect(str_has(eq_txt, "lib z {"), "--lib= name")
    c.expect(str_has(eq_txt, "fun zlibVersion: String"), "zlibVersion")

    lay_log = "/tmp/avant-s23-${stamp}-lay.log"
    lay_flags: Array(String) = []
    lay_flags.push("${root}/examples/c/layout.h")
    lay_code = s23_run(compiler, "bind", lay_log, lay_flags)
    c.eq_int(lay_code, 0, "bind layout.h exits 0")
    lay_txt = s23_read(lay_log)
    if lay_src = file_read("${root}/examples/layout.av") {
      c.expect(str_has(lay_src, s23_body(lay_txt)), "layout.h body matches examples/layout.av")
    } else {
      c.expect(false, "read examples/layout.av")
    }

    anon_log = "/tmp/avant-s23-${stamp}-anon.log"
    anon_flags: Array(String) = []
    anon_flags.push("${root}/examples/c/layout_anon.h")
    anon_code = s23_run(compiler, "bind", anon_log, anon_flags)
    c.eq_int(anon_code, 0, "anon exits 0")
    anon_txt = s23_read(anon_log)
    c.expect(str_has(anon_txt, "struct Pair {"), "anonymous struct takes the typedef name")
    c.expect(str_has(anon_txt, "fun pair_ok: Int"), "anon function stays")

    pack_log = "/tmp/avant-s23-${stamp}-pack.log"
    pack_flags: Array(String) = []
    pack_flags.push("${root}/examples/c/layout_pack.h")
    pack_code = s23_run(compiler, "bind", pack_log, pack_flags)
    c.eq_int(pack_code, 0, "packed exits 0")
    pack_txt = s23_read(pack_log)
    c.expect(str_has(pack_txt, "packed"), "packed diagnostic")
    c.expect(str_has(pack_txt, "fun pack_f: Int"), "packed function stays")
    c.expect(!str_has(pack_txt, "struct Pack"), "packed record is skipped")

    bit_log = "/tmp/avant-s23-${stamp}-bit.log"
    bit_flags: Array(String) = []
    bit_flags.push("${root}/examples/c/layout_bit.h")
    bit_code = s23_run(compiler, "bind", bit_log, bit_flags)
    c.eq_int(bit_code, 0, "bitfield exits 0")
    bit_txt = s23_read(bit_log)
    c.expect(str_has(bit_txt, "bitfield"), "bitfield diagnostic")
    c.expect(str_has(bit_txt, "fun bits_f: Int"), "bitfield function stays")
    c.expect(!str_has(bit_txt, "struct Bits"), "bitfield record is skipped")

    two_log = "/tmp/avant-s23-${stamp}-two.log"
    two_flags: Array(String) = []
    two_flags.push("${root}/examples/c/layout_two.h")
    two_code = s23_run(compiler, "bind", two_log, two_flags)
    c.eq_int(two_code, 0, "two typedefs exits 0")
    two_txt = s23_read(two_log)
    c.expect(str_has(two_txt, "two typedefs"), "two typedefs diagnostic")
    c.expect(str_has(two_txt, "fun amb_f: Int"), "ambiguous function stays")
    c.expect(!str_has(two_txt, "struct "), "two typedefs skip the record")

    raw_log = "/tmp/avant-s23-${stamp}-raw.log"
    raw_flags: Array(String) = []
    raw_flags.push("${root}/examples/c/layout_uchar.h")
    raw_code = s23_run(compiler, "bind", raw_log, raw_flags)
    c.eq_int(raw_code, 0, "unsigned char exits 0")
    raw_txt = s23_read(raw_log)
    c.expect(str_has(raw_txt, "unsigned char*"), "unsigned char* diagnostic")
    c.expect(str_has(raw_txt, "fun raw_f: Int"), "unsigned char function stays")
    c.expect(!str_has(raw_txt, "struct Raw"), "unsigned char record is skipped")

    by_log = "/tmp/avant-s23-${stamp}-by.log"
    by_flags: Array(String) = []
    by_flags.push("${root}/examples/c/layout_byval.h")
    by_code = s23_run(compiler, "bind", by_log, by_flags)
    c.eq_int(by_code, 1, "by-value exits non-zero")
    by_txt = s23_read(by_log)
    c.expect(str_has(by_txt, "C struct passed by value is not supported"), "by-value diagnostic")
    c.expect(!str_has(by_txt, "struct Point"), "by-value hides the partial lib")
    c.expect(!s23_has_lib(by_txt), "by-value prints no lib")

    miss_log = "/tmp/avant-s23-${stamp}-miss.log"
    miss_flags: Array(String) = []
    miss_flags.push("/tmp/avant-s23-${stamp}-missing.h")
    miss_code = s23_run(compiler, "bind", miss_log, miss_flags)
    c.eq_int(miss_code, 0, "missing header exits 0")
    miss_txt = s23_read(miss_log)
    c.expect(str_has(miss_txt, "header is missing"), "missing header diagnostic")
    c.expect(!s23_has_lib(miss_txt), "missing header prints no lib")

    flag_log = "/tmp/avant-s23-${stamp}-flag.log"
    flag_flags: Array(String) = []
    flag_flags.push("--nope")
    flag_flags.push(add_h)
    flag_code = s23_run(compiler, "bind", flag_log, flag_flags)
    c.eq_int(flag_code, 0, "unknown flag exits 0")
    flag_txt = s23_read(flag_log)
    c.expect(str_has(flag_txt, "unknown bind argument --nope"), "unknown flag diagnostic")
    c.expect(!s23_has_lib(flag_txt), "unknown flag prints no lib")

    none_log = "/tmp/avant-s23-${stamp}-none.log"
    none_code = s23_run(compiler, "bind", none_log, none)
    c.eq_int(none_code, 0, "no header exits 0")
    none_txt = s23_read(none_log)
    c.expect(str_has(none_txt, "bind needs a C header"), "bind needs a header")
    c.expect(str_has(none_txt, "avant-av bind"), "usage lists bind")

    need_log = "/tmp/avant-s23-${stamp}-need.log"
    need_flags: Array(String) = []
    need_flags.push("--lib")
    need_code = s23_run(compiler, "b", need_log, need_flags)
    c.eq_int(need_code, 0, "--lib without a name exits 0")
    need_txt = s23_read(need_log)
    c.expect(str_has(need_txt, "--lib needs a name"), "--lib needs a name")

    many_log = "/tmp/avant-s23-${stamp}-many.log"
    many_flags: Array(String) = []
    many_flags.push(add_h)
    many_flags.push("${root}/examples/c/layout.h")
    many_code = s23_run(compiler, "bind", many_log, many_flags)
    c.eq_int(many_code, 0, "two headers exits 0")
    many_txt = s23_read(many_log)
    c.expect(str_has(many_txt, "bind takes one header"), "one header")
    c.expect(!s23_has_lib(many_txt), "two headers print no lib")

    u32_h = "/tmp/avant_s23_${stamp}_u32.h"
    dummy_u32 = file_write(u32_h, "unsigned int widen(unsigned int x);\nint add(int a, int b);\n")
    u32_log = "/tmp/avant-s23-${stamp}-u32.log"
    u32_flags: Array(String) = []
    u32_flags.push(u32_h)
    u32_code = s23_run(compiler, "bind", u32_log, u32_flags)
    c.eq_int(u32_code, 1, "unsigned 32-bit fun exits non-zero")
    u32_txt = s23_read(u32_log)
    c.expect(str_has(u32_txt, "unsigned 32-bit C type unsigned int has no Avant type"), "unsigned 32-bit fun diagnostic")
    c.expect(!s23_has_lib(u32_txt), "unsigned 32-bit fun prints no lib")

    u32f_h = "/tmp/avant_s23_${stamp}_u32f.h"
    dummy_u32f = file_write(u32f_h, "struct Counter { unsigned int n; int tag; };\nint get_tag(struct Counter *c);\n")
    u32f_log = "/tmp/avant-s23-${stamp}-u32f.log"
    u32f_flags: Array(String) = []
    u32f_flags.push(u32f_h)
    u32f_code = s23_run(compiler, "bind", u32f_log, u32f_flags)
    c.eq_int(u32f_code, 1, "unsigned 32-bit field exits non-zero")
    u32f_txt = s23_read(u32f_log)
    c.expect(str_has(u32f_txt, "unsigned 32-bit field has no Avant type"), "unsigned 32-bit field diagnostic")
    c.expect(!s23_has_lib(u32f_txt), "unsigned 32-bit field prints no lib")

    u64_h = "/tmp/avant_s23_${stamp}_u64.h"
    dummy_u64 = file_write(u64_h, "unsigned long long widen64(unsigned long long x);\n")
    u64_log = "/tmp/avant-s23-${stamp}-u64.log"
    u64_flags: Array(String) = []
    u64_flags.push(u64_h)
    u64_code = s23_run(compiler, "bind", u64_log, u64_flags)
    c.eq_int(u64_code, 0, "unsigned 64-bit fun exits 0")
    u64_txt = s23_read(u64_log)
    c.expect(str_has(u64_txt, "fun widen64(x: UInt64): UInt64"), "unsigned 64-bit maps to UInt64")

    gen_src = "/tmp/avant-s23-${stamp}-gen.av"
    gen_buf = buf_new()
    gen_buf.push_str(add_txt)
    gen_buf.push_str("\nfn main {\n  puts(add.avant_add(20, 22))\n}\n")
    gen_w = file_write(gen_src, gen_buf.to_s)
    c.eq_int(gen_w, 0, "write generated add program")
    gen_bin = "/tmp/avant-s23-${stamp}-gen.bin"
    gen_clog = "/tmp/avant-s23-${stamp}-gen-cc.log"
    gen_cc: Array(String) = []
    gen_cc.push("--cc")
    gen_cc.push("${root}/examples/c/add.c")
    gen_ccode = compile_av_flags(compiler, gen_src, gen_bin, gen_clog, gen_cc)
    c.eq_int(gen_ccode, 0, "compile generated add")
    if file_exists(gen_bin) {
      chmod_x(gen_bin)
      gen_rlog = "/tmp/avant-s23-${stamp}-gen-run.log"
      gen_rcode = run_av_bin(gen_bin, gen_rlog)
      c.eq_int(gen_rcode, 0, "run generated add")
      c.eq_str(s23_read(gen_rlog), "42\n", "generated add prints 42")
    } else {
      c.expect(false, "generated add binary")
    }

    myc_log = "/tmp/avant-s23-${stamp}-myc.log"
    myc_code = dump_av(compiler, "${root}/examples/add.av", myc_log)
    c.eq_int(myc_code, 0, "dump hand-written lib")
    if got = file_read(myc_log) {
      if want = file_read("${root}/tests/goldens/examples/add.myc") {
        c.eq_str(got, want, "hand-written lib myc dump is unchanged")
      } else {
        c.expect(false, "read add.myc golden")
      }
    } else {
      c.expect(false, "read add dump")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}
