import harness

// The codegen mode each verb selects (Wave I; Stage 28 W11 moved this off
// the old back end's argument log): `run` compiles --debug, a bare
// `compile` uses the default mode, `--release` and its alias `--final`
// the full optimization. The builds are deterministic, so the mode shows
// in the bytes: run's binary (kept with --keep-tmp) is compile --debug's,
// --final's is --release's, and debug, default, and release are three
// different programs. The fixture's helper is inlined only by --release.

fn tc_compile(compiler: String, src: String, bin: String, mode: String, log: String): Int {
  args: Array(String) = []
  args.push("compile")
  args.push(src)
  args.push(bin)
  if mode.size > 0 {
    args.push(mode)
  }
  process_run_out(compiler, args, log)
}

fn tc_bytes(path: String): String {
  if t = file_read(path) {
    return t
  }
  "(missing ${path})"
}

// cmp -s: the two files are byte-identical (binaries, so not through
// String).
fn tc_same(a: String, b: String): Bool {
  args: Array(String) = []
  args.push("-s")
  args.push(a)
  args.push(b)
  process_run("/usr/bin/cmp", args) == 0
}

// grep -qF: the binary contains the text (a symbol name).
fn tc_has(path: String, text: String): Bool {
  args: Array(String) = []
  args.push("-qF")
  args.push(text)
  args.push(path)
  process_run("/usr/bin/grep", args) == 0
}

// The directory `--keep-tmp` names on stderr, or "".
fn tc_kept_dir(log: String): String {
  text = tc_bytes(log)
  marker = "kept temporary directory "
  lines = text.split("\n")
  i = 0
  while i < lines.size {
    ln = lines[i]
    j = 0
    while j + marker.size <= ln.size {
      if str_slice(ln, j, j + marker.size) == marker {
        return str_slice(ln, j + marker.size, ln.size)
      }
      j = j + 1
    }
    i = i + 1
  }
  ""
}

fn test_toolchain(c: Checks) {
  c.suite("tests/cases/test_toolchain.av")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    base = "${scratch()}/toolchain-wavei-${stamp}"
    src = "${base}-hello.av"
    file_write(src, "fn helper_twice(n: Int): Int {\n  n * 2 + 1\n}\n\nfn main {\n  puts(helper_twice(20))\n}\n")

    code1 = tc_compile(compiler, src, "${base}-debug.bin", "--debug", "${base}-debug.log")
    code2 = tc_compile(compiler, src, "${base}-bare.bin", "", "${base}-bare.log")
    code3 = tc_compile(compiler, src, "${base}-release.bin", "--release", "${base}-release.log")
    code4 = tc_compile(compiler, src, "${base}-final.bin", "--final", "${base}-final.log")
    c.eq_int(code1, 0, "compile --debug exits zero")
    c.eq_int(code2, 0, "bare compile exits zero")
    c.eq_int(code3, 0, "compile --release exits zero")
    c.eq_int(code4, 0, "compile --final exits zero")
    debug = "${base}-debug.bin"
    bare = "${base}-bare.bin"
    optimized = "${base}-release.bin"
    c.expect(!tc_same(bare, debug), "bare compile does not use --debug codegen")
    c.expect(!tc_same(bare, optimized), "bare compile does not use --release codegen")
    c.expect(!tc_same(debug, optimized), "--debug and --release are different codegen")
    c.expect(tc_same("${base}-final.bin", optimized), "compile --final is --release")
    c.expect(tc_has(debug, "helper_twice"), "--debug keeps the helper")
    c.expect(tc_has(bare, "helper_twice"), "the default mode does not inline the helper")
    c.expect(!tc_has(optimized, "helper_twice"), "--release inlines the helper")

    // The CPU level (Stage 28 W18S, O140): an artifact defaults to v2
    // (--cpu=v2's bytes); every level is a program that records it; one
    // the machine lacks stops at startup with the flag to rebuild with;
    // the host's level is the highest that runs, and `run` uses it.
    lv = ["baseline", "v2", "v3", "v4"]
    host = "baseline"
    k = 0
    while k < lv.size {
      lbin = "${base}-cpu-${lv[k]}.bin"
      cargs: Array(String) = []
      cargs.push("compile")
      cargs.push(src)
      cargs.push(lbin)
      cargs.push("--debug")
      cargs.push("--cpu=${lv[k]}")
      c.eq_int(process_run_out(compiler, cargs, "${base}-cpu-${lv[k]}.log"), 0, "compile --cpu=${lv[k]} exits zero")
      c.expect(tc_has(lbin, "__avant_cpu_level"), "a --cpu=${lv[k]} program records its level")
      rcode = run_av_bin(lbin, "${base}-cpu-${lv[k]}.run")
      rout = tc_bytes("${base}-cpu-${lv[k]}.run")
      if rcode == 0 {
        c.expect(str_has(rout, "41\n"), "a --cpu=${lv[k]} program runs where the machine has it")
        host = lv[k]
      } else {
        c.eq_int(rcode, 1, "a --cpu=${lv[k]} program stops on a machine without it")
        c.expect(str_has(rout, "rebuild it with --cpu="), "the stop names the flag to rebuild with")
      }
      k = k + 1
    }
    c.expect(tc_same(debug, "${base}-cpu-v2.bin"), "an artifact's default level is v2")
    bad_code = process_run_out(compiler, ["compile", src, "${base}-cpu-bad.bin", "--cpu=v9"], "${base}-cpu-bad.log")
    c.eq_int(bad_code, 1, "an unknown --cpu is refused")
    c.expect(str_has(tc_bytes("${base}-cpu-bad.log"), "unknown CPU level v9"), "the refusal names the level")

    // --keep-tmp names the directory on stderr, when the compiler's
    // TMPDIR is not another avant's scratch directory (a fresh one here,
    // removed below).
    run_log = "${base}-run.log"
    run_tmp = "${base}-runtmp"
    mkdir_p(run_tmp)
    run_args: Array(String) = []
    run_args.push("-c")
    run_args.push("TMPDIR='${run_tmp}' exec '${compiler}' run --keep-tmp '${src}' > '${run_log}' 2>&1 < /dev/null")
    run_code = process_run("/bin/sh", run_args)
    c.eq_int(run_code, 0, "bare run exits zero")
    c.expect(str_has(tc_bytes(run_log), "41\n"), "bare run prints the program's output")
    kept = tc_kept_dir(run_log)
    c.expect(kept.size > 0, "run --keep-tmp names its directory")
    c.expect(tc_same("${kept}/run.bin", "${base}-cpu-${host}.bin"), "bare run uses --debug codegen at the machine's level")
    rm_rf(run_tmp)

    // A tool the compiler runs gets /dev/null as stdin (Wave D): piped
    // input reaches the program `avant run` starts, not a tool, and an
    // open pipe as stdin does not hold a compile. These go through sh
    // because they are about stdin plumbing.
    cat_src = "${base}-stdin.av"
    file_write(cat_src, "fn main {\n  puts(file_read(\"/dev/stdin\") ?? \"none\")\n}\n")
    pipe_out = "${base}-pipe.out"
    pipe_sh = "${base}-pipe.sh"
    file_write(pipe_sh, "printf 'piped input' | '${compiler}' run '${cat_src}' > '${pipe_out}' 2>&1\n")
    sh_args: Array(String) = []
    sh_args.push(pipe_sh)
    pipe_code = process_run("/bin/sh", sh_args)
    c.eq_int(pipe_code, 0, "avant run with piped stdin exits zero")
    if pt = file_read(pipe_out) {
      c.expect(str_has(pt, "piped input"), "piped stdin reaches the program avant run starts")
    } else {
      c.expect(false, "read the piped run output")
    }

    open_sh = "${base}-open.sh"
    open_bin = "${base}-open.bin"
    // The pipe's writer stays open until the compile is done (a flag
    // file), capped at 10 s so a regression cannot hang the suite: a
    // compile that waits for its stdin takes the whole cap.
    open_flag = "${base}-open.done"
    file_write(open_sh, "i=0; while [ ! -f '${open_flag}' ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done | { '${compiler}' compile '${src}' '${open_bin}' > /dev/null 2>&1; : > '${open_flag}'; }\n")
    open_args: Array(String) = []
    open_args.push(open_sh)
    started = now_ms()
    process_run("/bin/sh", open_args)
    c.expect(file_exists(open_bin), "a compile with an open pipe as stdin finishes")
    c.expect(now_ms() - started < 8000, "a compile does not wait for its stdin to close")
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_toolchain(c)
  c.finish
}
