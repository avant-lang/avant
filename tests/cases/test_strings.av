import harness
import backends

// Stage 28 W6a: heap strings on the new back end (AVANT_BACKEND=llvm,
// D176; stages/stage28/mir.md W6a). For every program of the string
// subset: (a) it compiles under both back ends (--debug), and the two
// programs' stdout, stderr, and exit status are equal (D184); (b) the new
// back end's program prints the same under AVANT_GC_VERIFY=1, under
// AVANT_YOUNG_MB=1 (a 1 MB nursery: many young collections), and under
// both, and the verifier reports nothing (stderr unchanged); for the
// fixtures with goldens, (c) `avant dump` under AVANT_BACKEND=llvm prints
// exactly tests/goldens/strings/<name>.mir (D171).

fn golden_progs: Array(String) {
  xs: Array(String) = []
  names = ["churn", "concat", "interp", "members", "trap_index"]
  i = 0
  while i < names.size {
    xs.push("tests/fixtures/strings/${names[i]}.av")
    i = i + 1
  }
  xs
}

fn other_progs: Array(String) {
  xs: Array(String) = []
  xs.push("tests/fixtures/overloading/overload.av")
  xs.push("tests/fixtures/part3/chr.av")
  xs.push("tests/fixtures/part3/index.av")
  xs.push("tests/fixtures/part3/interp.av")
  xs.push("tests/fixtures/part3/slice.av")
  xs
}

fn golden_of(rel: String): String {
  base = rel
  i = 0
  while i < rel.size {
    if rel[i] == 47 {
      base = str_slice(rel, i + 1, rel.size)
    }
    i = i + 1
  }
  "tests/goldens/strings/${str_slice(base, 0, base.size - 3)}.mir"
}

fn gc_envs: Array(String) {
  ["AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1"]
}

fn test_strings(c: Checks, compiler: String, root: String, dir: String) {
  gp = golden_progs()
  progs: Array(String) = []
  i = 0
  while i < gp.size {
    progs.push(gp[i])
    i = i + 1
  }
  op = other_progs()
  i = 0
  while i < op.size {
    progs.push(op[i])
    i = i + 1
  }

  // Wave 1: compiles under both back ends, and the dumps.
  jobs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    jobs.push(compile_job("", compiler, "${root}/${progs[i]}", "${dir}/${k}.old", "${dir}/${k}.old.log"))
    jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, "${root}/${progs[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log"))
    i = i + 1
  }
  i = 0
  while i < gp.size {
    k = key_of(gp[i])
    a: Array(String) = []
    a.push("dump")
    a.push("${root}/${gp[i]}")
    jobs.push(env_job("AVANT_BACKEND=llvm", compiler, a, "${dir}/${k}.mir"))
    i = i + 1
  }
  run_waves(jobs)
  i = 0
  while i < progs.size {
    p = progs[i]
    c.eq_int(jobs[2 * i].code, 0, "${p}: compiles under myc")
    c.eq_int(jobs[2 * i + 1].code, 0, "${p}: compiles under llvm")
    i = i + 1
  }
  base = 2 * progs.size
  i = 0
  while i < gp.size {
    j = jobs[base + i]
    c.eq_int(j.code, 0, "${gp[i]}: dump under llvm exits 0")
    want = "(no golden)"
    if t = file_read("${root}/${golden_of(gp[i])}") {
      want = t
    }
    c.eq_str(log_text(j.log), want, "${gp[i]}: the MIR dump is ${golden_of(gp[i])}")
    i = i + 1
  }

  // Wave 2: every program from both back ends, then the new one under
  // each GC environment.
  envs = gc_envs()
  per = 2 + envs.size
  runs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    runs.push(run_job(dir, "${k}.old", "${k}.a"))
    runs.push(run_job(dir, "${k}.new", "${k}.b"))
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "${k}.new", "${k}.g${e}", envs[e]))
      e = e + 1
    }
    i = i + 1
  }
  run_waves(runs)
  i = 0
  while i < progs.size {
    p = progs[i]
    k = key_of(p)
    want_out = log_text("${dir}/${k}.a.out")
    want_err = log_text("${dir}/${k}.a.err")
    c.eq_int(runs[per * i + 1].code, runs[per * i].code, "${p}: the same exit status")
    c.eq_str(log_text("${dir}/${k}.b.out"), want_out, "${p}: the same stdout")
    c.eq_str(log_text("${dir}/${k}.b.err"), want_err, "${p}: the same stderr")
    e = 0
    while e < envs.size {
      c.eq_int(runs[per * i + 2 + e].code, runs[per * i].code, "${p} under ${envs[e]}: the same exit status")
      c.eq_str(log_text("${dir}/${k}.g${e}.out"), want_out, "${p} under ${envs[e]}: the same stdout")
      c.eq_str(log_text("${dir}/${k}.g${e}.err"), want_err, "${p} under ${envs[e]}: the same stderr (no verifier report)")
      e = e + 1
    }
    i = i + 1
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_strings.av")
  if compiler = env_get("AVANT_COMPILER") {
    test_strings(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
