import harness
import std.zlib
import std.base64
import std.json

fn test_holes(c: Checks) {
  c.suite("tests/cases/test_holes.av")
  c.eq_str("aaa".bytes.to_base64, "YWFh", "to_base64")
  if dec = "aaa".bytes.to_base64.bytes.from_base64 {
    text = String.from_utf8(dec) ?? ""
    c.eq_str(text, "aaa", "from_base64")
  } else {
    c.expect(false, "from_base64")
  }
  bb = buf_new(8)
  if err = "aaa".bytes.to_base64_into(bb) {
    c.expect(false, "to_base64_into ${err.message}")
  } else {
    c.eq_str(bb.to_s, "YWFh", "to_base64_into")
  }
  db = buf_new(8)
  if err2 = bb.to_s.bytes.from_base64_into(db) {
    c.expect(false, "from_base64_into ${err2.message}")
  } else {
    c.eq_str(db.to_s, "aaa", "from_base64_into")
  }

  c.eq_int(re_count("a+", "aa ba", 0), 2, "re_count")
  c.eq_str(sha256("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256")
  raw = "hello".bytes
  if back = raw.compress.uncompress {
    text = String.from_utf8(back) ?? ""
    c.eq_str(text, "hello", "zlib roundtrip")
  } else {
    c.expect(false, "zlib roundtrip")
  }

  if doc = Json.parse("{\"coordinates\":[{\"x\":1.0,\"y\":2.0,\"z\":3.0}]}") {
    if coords = doc.get("coordinates") {
      if cell = coords.at(0) {
        if x = cell.f64("x") {
          if y = cell.f64("y") {
            if z = cell.f64("z") {
              c.eq_int((x + y + z).to_i, 6, "json walk")
            } else {
              c.expect(false, "json walk z")
            }
          } else {
            c.expect(false, "json walk y")
          }
        } else {
          c.expect(false, "json walk x")
        }
      } else {
        c.expect(false, "at")
      }
      sum = 0.0
      ci = 0
      while ci < coords.len {
        if cell2 = coords.at(ci) {
          sum = sum + (cell2.f64("x") ?? 0.0) + (cell2.f64("y") ?? 0.0) + (cell2.f64("z") ?? 0.0)
        }
        ci = ci + 1
      }
      c.eq_int(sum.to_i, 6, "coordinate sum")
    } else {
      c.expect(false, "get coordinates")
    }
  } else {
    c.expect(false, "parse")
  }

  hs = Hash(String, Int).new
  c.eq_int(hs.inc_slice("ab ab", 0, 2), 1, "inc_slice 1")
  c.eq_int(hs.inc_slice("ab ab", 3, 5), 2, "inc_slice 2")
  c.eq_int(hs.size, 1, "inc_slice size")
  c.eq_str(hash_last_key(), "ab", "hash_last_key")
  hs["ab"] = 9
  if v = hs.get_concat("a", "b") {
    c.eq_int(v, 9, "get_concat")
  } else {
    c.expect(false, "get_concat")
  }

  c.eq_int(str_to_f_slice("x=12.9,", 2, 6).to_i, 12, "str_to_f_slice")
  lo = wide_op(0, 0 - 1, 0, 1, 0)
  c.eq_int(lo, 0, "wide_op lo")
  c.eq_int(wide_hi(), 1, "wide_hi")
  cs = checksum_f64(1.0)
  c.expect(cs != 0, "checksum_f64")
  c.eq_int(sqrt(4.0).to_i, 2, "sqrt")
  jb = buf_new(64)
  gen = JsonBuilder.into(jb)
  gen.obj.key("coordinates").arr.end.set("info", "some info").end
  c.expect(jb.starts_with("{\"coordinates\":"), "json builder into")
  re = re_compile("a+", 0)
  c.eq_int(re_find(re, "xxaa", 0), 1, "re_find")
  c.eq_int(re_m0(), 2, "re_m0")
  c.eq_int(re_m1(), 4, "re_m1")
  cap = re_compile("x(y)", 0)
  c.eq_int(re_find(cap, "xy", 0), 1, "re_find cap")
  c.eq_int(re_c0(), 1, "re_c0")
  c.eq_int(re_c1(), 2, "re_c1")
  us = now_us()
  c.expect(us == us, "now_us")
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_holes(c)
  c.finish
}
