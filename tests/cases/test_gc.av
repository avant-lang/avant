import harness

fn test_gc(c: Checks) {
  c.suite("tests/cases/test_gc.av")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    src = "${scratch()}/gc-${stamp}-gc.av"
    dump = "${scratch()}/gc-${stamp}-gc.mir"
    body = "class Node {\n  item: Int\n  left: Node\n  right: Node\n  fn initialize(item: Int) {\n    self.item = item\n  }\n}\nclass Box {\n  n: Int\n  child: Box?\n  fn initialize(n: Int) {\n    self.n = n\n  }\n}\nfn main {\n  a = Node.new(1)\n  a.left = Node.new(42)\n  b = Box.new(1)\n  b.child = Box.new(2)\n  puts(a.left.item)\n}\n"
    w = file_write(src, body)
    c.eq_int(w, 0, "write gc fixture")
    code = dump_av(compiler, src, dump)
    c.eq_int(code, 0, "dump gc fixture")
    if ir = file_read(dump) {
      // The MIR (D171; the old back end's IR until W11).
      c.expect(str_has(ir, ".Box|Nil) = union"), "IR has Box? layout")
      c.expect(str_has(ir, ".Box stride 0 bits [0x4]"), "T? field type map")
      c.expect(str_has(ir, "extern avant_alloc("), "IR has avant_alloc")
      c.expect(str_has(ir, "= call avant_alloc("), "IR calls avant_alloc")
      c.expect(str_has(ir, "-> i32 frame extern"), "main has a root frame")
      c.expect(str_has(ir, " slot\n"), "IR keeps references in root slots")
      c.expect(str_has(ir, ".Node stride 0 bits [0x6]"), "IR has the class type maps")
      c.expect(str_has(ir, "  barrier copy "), "IR has the barrier")
      c.expect(!str_has(ir, "malloc"), "IR has no malloc")
    } else {
      c.expect(false, "dump gc fixture")
    }

    golden = "${avant_test_root()}/tests/goldens/examples/hello.mir"
    hello = "${avant_test_root()}/examples/hello.av"
    hello_dump = "${scratch()}/gc-${stamp}-hello-golden.mir"
    if file_exists(golden) {
      gcode = dump_av(compiler, hello, hello_dump)
      c.eq_int(gcode, 0, "dump hello golden")
      if got = file_read(hello_dump) {
        if want = file_read(golden) {
          c.eq_str(got, want, "hello dump matches golden")
        } else {
          c.expect(false, "read hello golden")
        }
      } else {
        c.expect(false, "dump hello golden")
      }
    } else {
      c.expect(false, "hello golden exists")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_gc(c)
  c.finish
}
