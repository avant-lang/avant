import harness

// The metamorphic probe matrix (Valk stage VALK-TM, L4): the compiler
// under test runs tests/probe_matrix.av, which checks every rule's unsafe
// program and safe twin under every wrapper, and each row it writes must
// equal the checked-in tests/probe/matrix.txt (one check per row; a
// changed verdict, class or first error line fails that row's check and
// names it). Rebless the table with tests/probe_matrix.av only after its
// diff is read.

fn rows_of(text: String): Array(String) {
  out: Array(String) = []
  for line in text.split("\n") {
    if line.size > 0 && line[0] != 35 {
      out.push(line)
    }
  }
  out
}

// "rule wrapper variant" of a row.
fn row_key(row: String): String {
  spaces = 0
  for i in 0..row.size {
    if row[i] == 32 {
      spaces += 1
      if spaces == 3 {
        return str_slice(row, 0, i)
      }
    }
  }
  row
}

fn test_probe_matrix(c: Checks) {
  c.suite("tests/cases/test_probe_matrix.av")
  if compiler = env_get("AVANT_COMPILER") {
    root = avant_test_root()
    got_path = "${scratch()}/matrix.txt"
    log = "${scratch()}/probe_matrix.log"
    code = process_run_out(compiler, ["run", "${root}/tests/probe_matrix.av", "--", got_path], log) ?? -1
    if code != 0 {
      c.eq_str(file_read(log) ?? "(no log)", "", "tests/probe_matrix.av runs (its log)")
    }
    c.eq_int(code, 0, "tests/probe_matrix.av runs")
    want = rows_of(file_read("${root}/tests/probe/matrix.txt") ?? "")
    got = rows_of(file_read(got_path) ?? "")
    c.eq_int(got.size, want.size, "the matrix has as many rows as tests/probe/matrix.txt")
    for i in 0..want.size {
      g = "(missing)"
      if i < got.size {
        g = got[i]
      }
      c.eq_str(g, want[i], "probe ${row_key(want[i])}")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_probe_matrix(c)
  c.finish
}
