import harness

fn diag_expect_multi(c: Checks, compiler: String, stamp: Int, tag: String, body: String, needles: Array(String)) {
  src = "/tmp/avant-diagnostics-waved-${stamp}-${tag}.av"
  bin = "/tmp/avant-diagnostics-waved-${stamp}-${tag}.bin"
  log = "/tmp/avant-diagnostics-waved-${stamp}-${tag}.log"
  dummy = file_write(src, body)
  code = compile_av(compiler, src, bin, log)
  c.expect(code != 0, "${tag} exits non-zero")
  c.expect(!file_exists(bin), "${tag} bin absent")
  if err = file_read(log) {
    i = 0
    while i < needles.size {
      c.expect(str_has(err, needles[i]), "${tag} reports ${needles[i]}")
      i = i + 1
    }
  } else {
    c.expect(false, "${tag} log readable")
  }
}

fn test_diagnostics(c: Checks) {
  c.suite("tests/cases/test_diagnostics.av")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()

    multi: Array(String) = []
    multi.push("unknown name nosuch1")
    multi.push("unknown name nosuch3")
    multi.push("error[E4001]")
    multi.push("^")
    multi.push("aborting due to")
    diag_expect_multi(c, compiler, stamp, "multi-stmt", "fn f(a: Int): Int {\n  x = nosuch1\n  y = 2\n  x + y\n}\nfn g(b: Int): Int {\n  nosuch3 + b\n}\nfn main {\n  puts(f(1) + g(2))\n}\n", multi)

    types: Array(String) = []
    types.push("unknown type Float")
    types.push("unknown name nosuch9")
    types.push("^")
    diag_expect_multi(c, compiler, stamp, "multi-type", "fn f: Int {\n  x: Float = 1\n  x\n}\nfn main {\n  puts(nosuch9)\n}\n", types)

    syntax: Array(String) = []
    syntax.push("error[E2")
    syntax.push("aborting due to")
    syntax.push("^")
    diag_expect_multi(c, compiler, stamp, "multi-syntax", "fn f(: Int {\n  1\n}\nfn main {\n  puts(1)\n}\n", syntax)

    lexed: Array(String) = []
    lexed.push("unterminated string")
    lexed.push("unexpected character")
    lexed.push("error[E1005]")
    lexed.push("error[E1006]")
    diag_expect_multi(c, compiler, stamp, "multi-lex", "fn main {\n  puts(\"hi)\n  x = 1 @ 2\n  puts(x)\n}\n", lexed)

    single: Array(String) = []
    single.push("error[E4001]: unknown name nosuch1")
    single.push("^")
    single.push("nosuch1")
    diag_expect_multi(c, compiler, stamp, "single-caret", "fn main {\n  puts(nosuch1)\n}\n", single)

    dir = "/tmp/avant-diagnostics-waved-${stamp}-mods"
    mkdir_p(dir)
    write_av(dir, "waved_a", "pub fn fa: Int {\n  nosuch_a\n}\n")
    write_av(dir, "waved_b", "pub fn fb: Int {\n  nosuch_b\n}\n")
    write_av(dir, "waved_main", "import waved_a\nimport waved_b\nfn main {\n  puts(fa() + fb())\n}\n")
    mbin = "${dir}/waved_main.bin"
    mlog = "${dir}/waved_main.log"
    mcode = compile_av(compiler, "${dir}/waved_main.av", mbin, mlog)
    c.expect(mcode != 0, "multi-import exits non-zero")
    c.expect(!file_exists(mbin), "multi-import bin absent")
    if err = file_read(mlog) {
      c.expect(str_has(err, "nosuch_a"), "multi-import reports first file")
      c.expect(str_has(err, "nosuch_b"), "multi-import reports second file")
      c.expect(str_has(err, "^"), "multi-import renders carets")
    } else {
      c.expect(false, "multi-import log readable")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  c = Checks.new()
  c.started = now_ms()
  test_diagnostics(c)
  c.finish
}
