fn ut_quote(s: String): String {
  b = buf_new()
  b.push_str("'")
  i = 0
  while i < s.size {
    if s[i] == 39 {
      b.push_str("'\\''")
    } else {
      b.push_byte(s[i])
    }
    i = i + 1
  }
  b.push_str("'")
  b.to_s
}

fn ut_has(hay: String, needle: String): Bool {
  if needle.size == 0 {
    return true
  }
  if needle.size > hay.size {
    return false
  }
  last = hay.size - needle.size
  i = 0
  while i <= last {
    if str_eq(str_slice(hay, i, i + needle.size), needle) {
      return true
    }
    i = i + 1
  }
  false
}

fn ut_sh(body: String, rc_path: String): Int {
  script = "${rc_path}.sh"
  w = file_write(script, body)
  if w != 0 {
    return 1
  }
  chmod_args: Array(String) = []
  chmod_args.push("+x")
  chmod_args.push(script)
  dummy = process_run("/bin/chmod", chmod_args)
  sh_args: Array(String) = []
  sh_args.push(script)
  dummy_sh = process_run("/bin/sh", sh_args)
  if text = file_read(rc_path) {
    t = text.strip()
    n = 0
    i = 0
    ok = true
    while i < t.size {
      c = t[i]
      if c < 48 || c > 57 {
        ok = false
      }
      if ok {
        n = n * 10 + (c - 48)
      }
      i = i + 1
    }
    if ok {
      return n
    }
  }
  1
}

fn ut_read_ms(path: String): Int {
  if text = file_read(path) {
    return text.strip().to_i
  }
  -1
}

fn ut_fill(template: String, dir: String): String {
  parts = template.split("DIR")
  b = buf_new()
  i = 0
  while i < parts.size {
    if i > 0 {
      b.push_str(dir)
    }
    b.push_str(parts[i])
    i = i + 1
  }
  b.to_s
}

fn test_user_test(c: Checks) {
  c.suite("tests/cases/user_test.av")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    root = "/tmp/avant-user-${stamp}"
    mkdir_args: Array(String) = []
    mkdir_args.push("-p")
    mkdir_args.push("${root}/proj/tests")
    mkdir_args.push("${root}/proj/std")
    mkdir_args.push("${root}/empty")
    mkdir_args.push("${root}/fetch")
    dummy_mk = process_run("/bin/mkdir", mkdir_args)

    status_body = "fn main: Int {\n  7\n}\n"
    dummy_st = file_write("${root}/status.av", status_body)
    status_log = "${root}/status.log"
    status_rc = "${root}/status.rc"
    status_sh = "#!/bin/sh\n${ut_quote(compiler)} run ${ut_quote(root)}/status.av -- > ${ut_quote(status_log)} 2>&1; echo $? > ${ut_quote(status_rc)}\n"
    c.eq_int(ut_sh(status_sh, status_rc), 7, "fn main: Int is the process status")

    run_body = "fn run: Int {\n  5\n}\n"
    dummy_rn = file_write("${root}/runint.av", run_body)
    run_rc = "${root}/runint.rc"
    run_sh = "#!/bin/sh\n${ut_quote(compiler)} run ${ut_quote(root)}/runint.av -- > ${ut_quote(root)}/runint.log 2>&1; echo $? > ${ut_quote(run_rc)}\n"
    c.eq_int(ut_sh(run_sh, run_rc), 5, "fn run: Int is the process status")

    bad_body = "fn main: String {\n  \"no\"\n}\n"
    dummy_bad = file_write("${root}/badret.av", bad_body)
    bad_log = "${root}/badret.log"
    bad_args: Array(String) = []
    bad_args.push("run")
    bad_args.push("${root}/badret.av")
    bad_args.push("--")
    bad_code = process_run_out(compiler, bad_args, bad_log)
    c.expect(bad_code != 0, "fn main: String is rejected")
    if bad_text = file_read(bad_log) {
      c.expect(ut_has(bad_text, "the process status is Int"), "status error names Int")
    } else {
      c.expect(false, "status error names Int")
    }

    bare_body = "import std\nfn main {\n}\n"
    dummy_bare = file_write("${root}/bare.av", bare_body)
    bare_log = "${root}/bare.log"
    bare_args: Array(String) = []
    bare_args.push("run")
    bare_args.push("${root}/bare.av")
    bare_args.push("--")
    bare_code = process_run_out(compiler, bare_args, bare_log)
    c.expect(bare_code != 0, "import std is rejected")
    if bare_text = file_read(bare_log) {
      c.expect(ut_has(bare_text, "import std needs a module"), "import std names the module")
    } else {
      c.expect(false, "import std names the module")
    }

    dummy_empty_toml = file_write("${root}/empty/avant.toml", "[package]\nname = \"empty\"\nversion = \"0.1.0\"\n")
    empty_rc = "${root}/empty.rc"
    empty_sh = "#!/bin/sh\ncd ${ut_quote(root)}/empty && ${ut_quote(compiler)} test > ${ut_quote(root)}/empty.log 2>&1; echo $? > ${ut_quote(empty_rc)}\n"
    c.eq_int(ut_sh(empty_sh, empty_rc), 1, "empty selection exits 1")

    jobs_rc = "${root}/jobs.rc"
    jobs_sh = "#!/bin/sh\ncd ${ut_quote(root)}/empty && ${ut_quote(compiler)} test --jobs 0 > ${ut_quote(root)}/jobs.log 2>&1; echo $? > ${ut_quote(jobs_rc)}\n"
    c.eq_int(ut_sh(jobs_sh, jobs_rc), 1, "--jobs 0 is an error")

    typo_rc = "${root}/typo.rc"
    typo_sh = "#!/bin/sh\n${ut_quote(compiler)} run ${ut_quote(root)}/status.av --relase > ${ut_quote(root)}/typo.log 2>&1; echo $? > ${ut_quote(typo_rc)}\n"
    c.eq_int(ut_sh(typo_sh, typo_rc), 1, "a mistyped run flag is an error")

    dummy_vec = file_write("${root}/proj/vec.av", "pub fn origin: Int {\n  4\n}\nfn hidden: Int {\n  9\n}\n")
    dummy_fake = file_write("${root}/proj/std/testing.av", "pub fn fake: Int {\n  1\n}\n")
    dummy_toml = file_write("${root}/proj/avant.toml", "[package]\nname = \"proj\"\nversion = \"0.1.0\"\n\n[test]\nexclusive = [\"tests/test_mid.av\"]\n")
    imp_body = "import vec\nimport std.testing\nfn main: Int {\n  t = Test.new\n  t.check_eq(origin(), 4, \"origin\")\n  t.finish\n}\n"
    dummy_imp = file_write("${root}/proj/tests/test_import.av", imp_body)
    imp_rc = "${root}/import.rc"
    imp_sh = "#!/bin/sh\ncd ${ut_quote(root)}/proj && ${ut_quote(compiler)} test tests/test_import.av > ${ut_quote(root)}/import.log 2>&1; echo $? > ${ut_quote(imp_rc)}\n"
    c.eq_int(ut_sh(imp_sh, imp_rc), 0, "a test under tests/ imports the project")
    if imp_text = file_read("${root}/import.log") {
      c.expect(ut_has(imp_text, "PASS origin"), "imported pub name is visible")
    } else {
      c.expect(false, "imported pub name is visible")
    }

    hid_body = "import vec\nfn main: Int {\n  hidden()\n}\n"
    dummy_hid = file_write("${root}/proj/tests/hidden.av", hid_body)
    hid_log = "${root}/hidden.log"
    hid_args: Array(String) = []
    hid_args.push("run")
    hid_args.push("${root}/proj/tests/hidden.av")
    hid_args.push("--")
    hid_code = process_run_out(compiler, hid_args, hid_log)
    c.expect(hid_code != 0, "a test does not see a private name")

    miss_body = "import std.testing\nfn main: Int {\n  t = Test.new\n  t.golden(\"missing-want.txt\", \"x\")\n  t.finish\n}\n"
    dummy_miss = file_write("${root}/proj/tests/test_miss.av", miss_body)
    miss_rc = "${root}/miss.rc"
    miss_sh = "#!/bin/sh\ncd ${ut_quote(root)}/proj && ${ut_quote(compiler)} test tests/test_miss.av > ${ut_quote(root)}/miss.log 2>&1; echo $? > ${ut_quote(miss_rc)}\n"
    c.eq_int(ut_sh(miss_sh, miss_rc), 1, "a missing golden file fails the test")
    c.expect(!file_exists("${root}/proj/missing-want.txt"), "golden does not create the expected file")

    fetch_body = "[package]\nname = \"fetch\"\nversion = \"0.1.0\"\n\n[test]\ndir = \"tests\"\nexclusive = [\"tests/test_bench.av\"]\n"
    dummy_fetch = file_write("${root}/fetch/avant.toml", fetch_body)
    fetch_rc = "${root}/fetch.rc"
    fetch_sh = "#!/bin/sh\n${ut_quote(compiler)} fetch ${ut_quote(root)}/fetch > ${ut_quote(root)}/fetch.log 2>&1; echo $? > ${ut_quote(fetch_rc)}\n"
    c.eq_int(ut_sh(fetch_sh, fetch_rc), 0, "fetch accepts [test] and ignores it")

    shard_rc = "${root}/shard.rc"
    shard_sh = "#!/bin/sh\ncd ${ut_quote(root)}/proj && ${ut_quote(compiler)} test --shard 1/2 > ${ut_quote(root)}/shard.log 2>&1; echo $? > ${ut_quote(shard_rc)}\n"
    c.eq_int(ut_sh(shard_sh, shard_rc), 1, "--shard with an exclusive file is an error")
    if shard_text = file_read("${root}/shard.log") {
      c.expect(ut_has(shard_text, "exclusive"), "shard error names exclusive")
    } else {
      c.expect(false, "shard error names exclusive")
    }

    both_body = "[package]\nname = \"both\"\nversion = \"0.1.0\"\n\n[test]\ndir = \"tests\"\nentry = \"main.av\"\n"
    dummy_both = file_write("${root}/both.toml", both_body)
    mkdir_both: Array(String) = []
    mkdir_both.push("-p")
    mkdir_both.push("${root}/both")
    dummy_both_mk = process_run("/bin/mkdir", mkdir_both)
    dummy_both_w = file_write("${root}/both/avant.toml", both_body)
    both_rc = "${root}/both.rc"
    both_sh = "#!/bin/sh\ncd ${ut_quote(root)}/both && ${ut_quote(compiler)} test > ${ut_quote(root)}/both.log 2>&1; echo $? > ${ut_quote(both_rc)}\n"
    c.eq_int(ut_sh(both_sh, both_rc), 1, "dir and entry together are an error")

    clock = "${root}/clock"
    mkdir_clock: Array(String) = []
    mkdir_clock.push("-p")
    mkdir_clock.push("${clock}/tests")
    dummy_clock = process_run("/bin/mkdir", mkdir_clock)
    dummy_clock_toml = file_write("${clock}/avant.toml", "[package]\nname = \"clock\"\nversion = \"0.1.0\"\n\n[test]\nexclusive = [\"tests/test_mid.av\"]\n")
    piece = "import std.testing\nfn stamp(path: String) {\n  dummy = file_write(path, \"\${now_ms()}\")\n}\nfn nap() {\n  args: Array(String) = []\n  args.push(\"1\")\n  dummy = process_run(\"/bin/sleep\", args)\n}\nfn main: Int {\n  t = Test.new\n  listing = false\n  if v = env_get(\"AVANT_TEST_LIST\") {\n    if v == \"1\" {\n      listing = true\n    }\n  }\n  selected = false\n  if v = env_get(\"AVANT_TEST_ONLY\") {\n    if v.size > 0 {\n      selected = true\n    }\n  }\n  if listing {\n  } else if selected {\n  } else {\n    stamp(\"DIR/NAME.start\")\n    nap()\n    stamp(\"DIR/NAME.end\")\n  }\n  t.parallel(\"pa\") {\n    stamp(\"DIR/NAME.pa.start\")\n    nap()\n    stamp(\"DIR/NAME.pa.end\")\n    nil\n  }\n  t.parallel(\"pb\") {\n    stamp(\"DIR/NAME.pb.start\")\n    nap()\n    stamp(\"DIR/NAME.pb.end\")\n    nil\n  }\n  t.finish\n}\n"
    left = ut_fill(piece, clock)
    left = ut_fill_name(left, "left")
    right_src = "import std.testing\nfn stamp(path: String) {\n  dummy = file_write(path, \"\${now_ms()}\")\n}\nfn nap() {\n  args: Array(String) = []\n  args.push(\"1\")\n  dummy = process_run(\"/bin/sleep\", args)\n}\nfn main: Int {\n  t = Test.new\n  listing = false\n  if v = env_get(\"AVANT_TEST_LIST\") {\n    if v == \"1\" {\n      listing = true\n    }\n  }\n  if listing {\n  } else {\n    stamp(\"${clock}/right.start\")\n    nap()\n    stamp(\"${clock}/right.end\")\n  }\n  t.finish\n}\n"
    mid_src = "import std.testing\nfn stamp(path: String) {\n  dummy = file_write(path, \"\${now_ms()}\")\n}\nfn nap() {\n  args: Array(String) = []\n  args.push(\"1\")\n  dummy = process_run(\"/bin/sleep\", args)\n}\nfn main: Int {\n  t = Test.new\n  listing = false\n  if v = env_get(\"AVANT_TEST_LIST\") {\n    if v == \"1\" {\n      listing = true\n    }\n  }\n  if listing {\n  } else {\n    stamp(\"${clock}/mid.start\")\n    nap()\n    stamp(\"${clock}/mid.end\")\n  }\n  t.finish\n}\n"
    dummy_left = file_write("${clock}/tests/test_left.av", left)
    dummy_right = file_write("${clock}/tests/test_right.av", right_src)
    dummy_mid = file_write("${clock}/tests/test_mid.av", mid_src)
    clock_rc = "${root}/clock.rc"
    clock_sh = "#!/bin/sh\ncd ${ut_quote(clock)} && ${ut_quote(compiler)} test --jobs 2 > ${ut_quote(root)}/clock.log 2>&1; echo $? > ${ut_quote(clock_rc)}\n"
    c.eq_int(ut_sh(clock_sh, clock_rc), 0, "overlap fixture exits 0")
    ls = ut_read_ms("${clock}/left.start")
    le = ut_read_ms("${clock}/left.end")
    rs = ut_read_ms("${clock}/right.start")
    re = ut_read_ms("${clock}/right.end")
    pas = ut_read_ms("${clock}/left.pa.start")
    pae = ut_read_ms("${clock}/left.pa.end")
    pbs = ut_read_ms("${clock}/left.pb.start")
    pbe = ut_read_ms("${clock}/left.pb.end")
    ms = ut_read_ms("${clock}/mid.start")
    me = ut_read_ms("${clock}/mid.end")
    c.expect(ls >= 0 && le > ls && rs >= 0 && re > rs, "serial intervals were recorded")
    c.expect(ls < re && rs < le, "non-exclusive files overlap")
    c.expect(pas >= 0 && pae > pas && pbs >= 0 && pbe > pbs, "parallel intervals were recorded")
    c.expect(pas < pbe && pbs < pae, "parallel tests in one file overlap")
    c.expect(ms >= 0 && me > ms, "exclusive interval was recorded")
    left_hi = le
    if pae > left_hi {
      left_hi = pae
    }
    if pbe > left_hi {
      left_hi = pbe
    }
    right_hi = re
    c.expect(ms >= left_hi && ms >= right_hi, "exclusive file does not overlap other files")
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn ut_fill_name(template: String, name: String): String {
  parts = template.split("NAME")
  b = buf_new()
  i = 0
  while i < parts.size {
    if i > 0 {
      b.push_str(name)
    }
    b.push_str(parts[i])
    i = i + 1
  }
  b.to_s
}
