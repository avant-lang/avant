import harness
import backends

// Stage 29 W4b1: honest defaults for numbers, parsing and printing (D293,
// D295; review 4's R1-R10). Each program is compiled in parallel; a
// refused one must leave no binary and say the expected words, an
// accepted one must print what it should, and a trapping one must print
// what it printed before the trap, exit 1 and name the trap on stderr.
//   - conversions between Int, Int64 and UInt64 keep the value or trap;
//     wrap_i, wrap_i64 and wrap_u64 reinterpret the bits (R1);
//   - abs, sum and Hash.inc follow D215; UInt64.abs is refused (R2);
//   - a byte stored outside 0..255 traps (R3).

class FCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub err: String = ""
  pub ok: Bool = false
  pub trap: Bool = false
}

fn refused(tag: String, src: String, needle: String): FCase {
  f = FCase.new
  f.tag = tag
  f.src = src
  f.want = needle
  f
}

fn accepted(tag: String, src: String, out: String): FCase {
  f = FCase.new
  f.tag = tag
  f.src = src
  f.want = out
  f.ok = true
  f
}

fn trapped(tag: String, src: String, out: String, needle: String): FCase {
  f = FCase.new
  f.tag = tag
  f.src = src
  f.want = out
  f.err = needle
  f.ok = true
  f.trap = true
  f
}

fn conv_cases: Array(FCase) {
  xs: Array(FCase) = []
  xs.push(accepted("conv-in-range", "fn main {\n  a: Int64 = 0i64 - 2147483648i64\n  b: Int64 = 2147483647i64\n  puts(a.to_i)\n  puts(b.to_i)\n  u: UInt64 = 2147483647u64\n  puts(u.to_i)\n  v: UInt64 = 9223372036854775807u64\n  puts(v.to_i64)\n  n = 7\n  puts(n.to_u64)\n  puts(n.to_i64)\n  m: Int64 = 9223372036854775807i64\n  puts(m.to_u64)\n  puts(n.to_i)\n  puts(m.to_i64)\n  puts(v.to_u64)\n}\n", "-2147483648\n2147483647\n2147483647\n9223372036854775807\n7\n7\n9223372036854775807\n7\n9223372036854775807\n9223372036854775807\n"))
  xs.push(accepted("conv-wrap", "fn main {\n  big = 5000000000\n  puts(big.wrap_i32)\n  n = -1\n  puts(n.wrap_u64)\n  puts(n.wrap_u32)\n  puts(n.wrap_i)\n  u: UInt64 = 18446744073709551615u64\n  puts(u.wrap_i32)\n  puts(u.wrap_i)\n  puts(u.wrap_u64)\n  h: UInt64 = 9223372036854775808u64\n  puts(h.wrap_i)\n  puts(3000000000.wrap_i32)\n  puts(big.wrap_u64())\n  w: Int32 = -2\n  puts(w.wrap_u32)\n  puts(w.wrap_u64)\n  v: UInt32 = 4294967295\n  puts(v.wrap_i32)\n  puts(v.wrap_i)\n}\n", "705032704\n18446744073709551615\n4294967295\n-1\n-1\n-1\n18446744073709551615\n-9223372036854775808\n-1294967296\n5000000000\n4294967294\n18446744073709551614\n-1\n4294967295\n"))
  // Int32 and UInt32 as everyday types (Stage 29 W-INT1, D314): arrays
  // (4 bytes an element), struct fields, arithmetic, literals adopting
  // either operand (D315) or the declared type, and the refusals.
  xs.push(accepted("int32-everyday", "struct P {\n  a: Int32\n  b: UInt32\n}\n\nfn half(x: Int32): Int32 {\n  x / 2\n}\n\nfn main {\n  xs: Array(Int32) = [5, -3, 9, 1]\n  xs.push(7)\n  xs.sort\n  puts(\"\${xs[0]} \${xs[4]} \${xs.size}\")\n  puts(xs.sum)\n  puts(xs.min ?? 0)\n  puts(xs.max ?? 0)\n  puts(xs.contains(9))\n  puts(xs.index_of(7) ?? -1)\n  zs = Array(Int32).new(3, 4)\n  zs.fill(-2)\n  puts(zs[2])\n  us: Array(UInt32) = [4000000000, 3, 4294967295]\n  us.sort\n  puts(\"\${us[0]} \${us[1]} \${us[2]}\")\n  puts(us.min ?? 0)\n  puts(us.max ?? 0)\n  puts(us.contains(4294967295))\n  puts(us.index_of(3) ?? -1)\n  p = P { a: -7, b: 7 }\n  puts(p.a + 1)\n  puts(1 + p.a)\n  puts(p.b * 2)\n  x: Int32 = 6 * 7\n  puts(half(x))\n  big: UInt64 = 1 + 18446744073709551614u64\n  puts(big)\n  y = 2 - p.a\n  puts(y)\n  q = 3000000000\n  puts(q * 3)\n  puts((q - 2900000000).to_i32)\n}\n", "-3 9 5\n19\n-3\n9\ntrue\n3\n-2\n3 4000000000 4294967295\n3\n4294967295\ntrue\n0\n-6\n-6\n14\n21\n18446744073709551615\n9\n9000000000\n100000000\n"))
  xs.push(refused("int32-index", "fn main {\n  xs = [1]\n  i: Int32 = 0\n  puts(xs[i])\n}\n", "expected Int, got Int32"))
  xs.push(refused("int32-mix", "fn main {\n  a: Int32 = 1\n  b = 2\n  puts(a + b)\n}\n", "expected Int32, got Int"))
  xs.push(refused("int32-literal-range", "fn main {\n  a: Int32 = 3000000000\n  puts(a)\n}\n", "integer literal does not fit in Int32"))
  xs.push(refused("uint32-negative-literal", "fn main {\n  a: UInt32 = -1\n  puts(a)\n}\n", "expected UInt32, got Int"))
  xs.push(accepted("conv-int32", "fn main {\n  a: Int32 = 7\n  puts(a.to_i + 3000000000)\n  b = 2147483647\n  puts(b.to_i32)\n  c: UInt32 = 4294967295\n  puts(c.to_i)\n  puts(c.to_u64)\n  d = -2147483648\n  puts(d.to_i32)\n  e: Int32 = -5\n  puts(e.to_i)\n  puts(e.abs)\n  f: UInt64 = 4294967295u64\n  puts(f.to_u32)\n}\n", "3000000007\n2147483647\n4294967295\n4294967295\n-2147483648\n-5\n5\n4294967295\n"))
  xs.push(trapped("conv-i-to-i32-high", "fn main {\n  puts(1)\n  big = 5000000000\n  puts(big.to_i32)\n}\n", "1\n", "avant runtime: to_i32 of Int 5000000000 out of range for Int32"))
  xs.push(trapped("conv-i-to-i32-low", "fn main {\n  x = -2147483649\n  puts(x.to_i32)\n}\n", "", "avant runtime: to_i32 of Int -2147483649 out of range for Int32"))
  xs.push(trapped("conv-i-to-u32", "fn main {\n  x = -1\n  puts(x.to_u32)\n}\n", "", "avant runtime: to_u32 of Int -1 out of range for UInt32"))
  xs.push(trapped("conv-u32-to-i32", "fn main {\n  x: UInt32 = 4294967295\n  puts(x.to_i32)\n}\n", "", "avant runtime: to_i32 of UInt32 4294967295 out of range for Int32"))
  xs.push(trapped("conv-i32-to-u32", "fn main {\n  x: Int32 = -3\n  puts(x.to_u32)\n}\n", "", "avant runtime: to_u32 of Int32 -3 out of range for UInt32"))
  xs.push(trapped("conv-i-to-u64", "fn main {\n  n = -1\n  puts(n.to_u64)\n}\n", "", "avant runtime: to_u64 of Int -1 out of range for UInt64"))
  xs.push(trapped("conv-i32-to-u64", "fn main {\n  n: Int32 = -3\n  puts(n.to_u64())\n}\n", "", "avant runtime: to_u64 of Int32 -3 out of range for UInt64"))
  xs.push(trapped("conv-u64-to-i", "fn main {\n  u: UInt64 = 18446744073709551615u64\n  puts(u.to_i)\n}\n", "", "avant runtime: to_i of UInt64 18446744073709551615 out of range for Int"))
  xs.push(trapped("conv-u64-to-i32", "fn main {\n  u: UInt64 = 2147483648u64\n  puts(u.to_i32)\n}\n", "", "avant runtime: to_i32 of UInt64 2147483648 out of range for Int32"))
  xs.push(refused("conv-wrap-args", "fn main {\n  puts(3.wrap_i(1))\n}\n", "Int.wrap_i takes no arguments"))
  xs.push(accepted("abs-ok", "fn main {\n  puts((0 - 5).abs)\n  puts((0 - 2147483647).abs)\n  puts((0i64 - 9223372036854775807i64).abs)\n  puts(4.abs())\n}\n", "5\n2147483647\n9223372036854775807\n4\n"))
  xs.push(trapped("abs-min", "fn main {\n  m: Int32 = -2147483648\n  puts(m.abs)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(trapped("abs-min-i64", "fn main {\n  m = 0i64 - 9223372036854775807i64 - 1i64\n  puts(m.abs)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(refused("abs-u64", "fn main {\n  x = 3u64\n  puts(x.abs)\n}\n", "abs of a UInt64 is the value itself"))
  xs.push(refused("abs-u64-call", "fn main {\n  x = 3u64\n  puts(x.abs())\n}\n", "abs of a UInt64 is the value itself"))
  xs.push(accepted("sum-ok", "fn main {\n  puts([2147483647, -1, 1].sum)\n  puts([9223372036854775807i64, 0i64 - 1i64].sum)\n  puts([18446744073709551614u64, 1u64].sum)\n  xs: Array(Int) = []\n  puts(xs.sum)\n}\n", "2147483647\n9223372036854775806\n18446744073709551615\n0\n"))
  xs.push(trapped("sum-int", "fn main {\n  puts([9223372036854775807, 1].sum)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(trapped("sum-int32", "fn main {\n  xs: Array(Int32) = [2147483647, 1]\n  puts(xs.sum)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(trapped("sum-uint32", "fn main {\n  xs: Array(UInt32) = [4294967295, 1]\n  puts(xs.sum)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(trapped("sum-int-low", "fn main {\n  puts([-9223372036854775807, -1, -1].sum)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(trapped("sum-int32-low", "fn main {\n  xs: Array(Int32) = [-2147483647, -1, -1]\n  puts(xs.sum)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(trapped("sum-i64", "fn main {\n  puts([9223372036854775807i64, 1i64].sum)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(trapped("sum-u64", "fn main {\n  puts([18446744073709551615u64, 1u64].sum)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(accepted("inc-ok", "fn main {\n  h = Hash(String, Int).new\n  h[\"a\"] = 2147483646\n  h.inc(\"a\")\n  puts(h.get(\"a\") ?? 0)\n  h.inc(\"b\", -2147483647)\n  h.inc(\"b\", -1)\n  puts(h.get(\"b\") ?? 0)\n  g = Hash(Int, Int).new\n  g.inc(4, 3)\n  g.inc(4)\n  puts(g.get(4) ?? 0)\n}\n", "2147483647\n-2147483648\n4\n"))
  xs.push(trapped("inc-str", "fn main {\n  h = Hash(String, Int).new\n  h[\"a\"] = 9223372036854775807\n  h.inc(\"a\")\n}\n", "", "avant runtime: integer overflow"))
  xs.push(trapped("inc-int-key", "fn main {\n  h = Hash(Int, Int).new\n  h.inc(1, -9223372036854775807)\n  h.inc(1, -2)\n}\n", "", "avant runtime: integer overflow"))
  xs.push(accepted("byte-ok", "fn main {\n  buf = buf_new()\n  buf.push_byte(0)\n  buf.push_byte(255)\n  buf[0] = 65\n  buf[1] -= 189\n  puts(buf.to_s)\n  puts(chr(66))\n  puts(repeat_byte(67, 3))\n  puts(repeat_byte(67, 0).size)\n  puts(bytes_to_str([68, 69]))\n}\n", "AB\nB\nCCC\n0\nDE\n"))
  xs.push(trapped("byte-push-high", "fn main {\n  buf = buf_new()\n  buf.push_byte(300)\n}\n", "", "avant runtime: byte 300 out of range (0..255)"))
  xs.push(trapped("byte-push-neg", "fn main {\n  buf = buf_new()\n  buf.push_byte(-1)\n}\n", "", "avant runtime: byte -1 out of range (0..255)"))
  xs.push(trapped("byte-index-store", "fn main {\n  buf = buf_new()\n  buf.push_byte(1)\n  buf[0] = 256\n}\n", "", "avant runtime: byte 256 out of range (0..255)"))
  xs.push(trapped("byte-index-compound", "fn main {\n  buf = buf_new()\n  buf.push_byte(200)\n  buf[0] += 56\n}\n", "", "avant runtime: byte 256 out of range (0..255)"))
  xs.push(trapped("byte-chr", "fn main {\n  puts(chr(300))\n}\n", "", "avant runtime: byte 300 out of range (0..255)"))
  xs.push(trapped("byte-repeat", "fn main {\n  puts(repeat_byte(321, 2))\n}\n", "", "avant runtime: byte 321 out of range (0..255)"))
  xs.push(trapped("byte-repeat-count", "fn main {\n  puts(repeat_byte(65, -3))\n}\n", "", "avant runtime: repeat_byte count -3 is negative"))
  xs.push(trapped("byte-bytes-to-str", "fn main {\n  puts(bytes_to_str([65, 66, 400, -1]))\n}\n", "", "avant runtime: byte 400 out of range (0..255)"))
  xs
}

fn slice_cases: Array(FCase) {
  xs: Array(FCase) = []
  xs.push(accepted("slice-ok", "fn main {\n  s = \"hello\"\n  puts(str_slice(s, 0, 5))\n  puts(str_slice(s, 1, 3))\n  puts(str_slice(s, 5, 5).size)\n  puts(str_slice(s, 2, 2).size)\n  b = s.bytes\n  puts(b.slice(1, 4).size)\n  buf = buf_new()\n  buf.push_slice(s, 3, 5)\n  puts(buf.to_s)\n  h = Hash(String, Int).new\n  h.inc_slice(\"abcd\", 1, 3)\n  puts(h.get(\"bc\") ?? 0)\n  puts(str_to_f_slice(\"x2.5y\", 1, 4) ?? 0.0)\n}\n", "hello\nel\n0\n0\n3\nlo\n1\n2.5\n"))
  xs.push(trapped("slice-past-end", "fn main {\n  puts(\"a\")\n  puts(str_slice(\"hello\", 2, 10))\n}\n", "a\n", "avant runtime: slice 2..10 out of range (size 5)"))
  xs.push(trapped("slice-reversed", "fn main {\n  puts(str_slice(\"hello\", 4, 2).size)\n}\n", "", "avant runtime: slice 4..2 out of range (size 5)"))
  xs.push(trapped("slice-negative", "fn main {\n  puts(str_slice(\"hello\", -1, 3))\n}\n", "", "avant runtime: slice -1..3 out of range (size 5)"))
  xs.push(trapped("slice-bytes", "fn main {\n  b = \"hello\".bytes\n  puts(b.slice(-3, 2).size)\n}\n", "", "avant runtime: slice -3..2 out of range (size 5)"))
  xs.push(trapped("slice-push", "fn main {\n  buf = buf_new()\n  buf.push_slice(\"hello\", 3, 99)\n}\n", "", "avant runtime: slice 3..99 out of range (size 5)"))
  xs.push(trapped("slice-inc", "fn main {\n  h = Hash(String, Int).new\n  h.inc_slice(\"abc\", 2, 4)\n}\n", "", "avant runtime: slice 2..4 out of range (size 3)"))
  xs.push(trapped("slice-get", "fn main {\n  h = Hash(String, String).new\n  h[\"a\"] = \"x\"\n  puts(h.get_slice(\"abc\", 1, 0) ?? \"none\")\n}\n", "", "avant runtime: slice 1..0 out of range (size 3)"))
  xs.push(trapped("slice-to-f", "fn main {\n  puts(str_to_f_slice(\"12\", 5, 9) ?? 0.0)\n}\n", "", "avant runtime: slice 5..9 out of range (size 2)"))
  xs
}

fn arraynew_cases: Array(FCase) {
  xs: Array(FCase) = []
  xs.push(accepted("anew-zero", "struct P {\n  a: Int\n  s: String\n}\nfn main {\n  xs = Array(Int).new(3)\n  puts(xs[2])\n  ss = Array(String).new(2)\n  puts(\"[\${ss[1]}]\")\n  o: String? = ss[0]\n  puts(o ?? \"nil\")\n  ps = Array(P).new(2)\n  puts(ps[1].s.size)\n  zs = Array(Int?).new(2)\n  puts(zs[0] ?? -7)\n  bs = Array(Bool).new(1)\n  puts(\"\${bs[0]}\")\n  fs = Array(Float64).new(1)\n  puts(\"\${fs[0] == 0.0}\")\n  e = Array(String).new(0)\n  puts(e.size)\n}\n", "0\n[]\n\n0\n-7\nfalse\ntrue\n0\n"))
  xs.push(accepted("anew-value", "class Node {\n  v: Int = 0\n}\nfn main {\n  n = Node.new\n  n.v = 5\n  ns = Array(Node).new(3, n)\n  puts(ns[2].v)\n  ns[0].v = 6\n  puts(ns[1].v)\n  fs = Array(Float64).new(2, 1.5)\n  puts(\"\${fs[1] == 1.5}\")\n  t = Array(String).new(3, \"x\")\n  puts(t[2])\n  aa = Array(Array(Int)).new(2, [1, 2])\n  puts(aa[1].size)\n  is = Array(Int).new(4, -1)\n  puts(is[3])\n  e = Array(Node).new(0, n)\n  puts(e.size)\n}\n", "5\n6\ntrue\nx\n2\n-1\n0\n"))
  xs.push(refused("anew-class", "class Node {\n  v: Int = 0\n}\nfn main {\n  xs = Array(Node).new(2)\n  puts(xs.size)\n}\n", "Array(Node).new(n) needs an element value: Node has no zero value; write Array(Node).new(n, value), or start from [] and push"))
  xs.push(refused("anew-array", "fn main {\n  xs = Array(Array(Int)).new(2)\n  puts(xs.size)\n}\n", "Array(Array(Int)).new(n) needs an element value"))
  xs.push(refused("anew-generic", "class Node {\n  v: Int = 0\n}\nfn make(n: Int, x: T): Array(T) {\n  Array(T).new(n)\n}\nfn main {\n  a = make(2, 5)\n  puts(a[1])\n  b = make(2, Node.new)\n  puts(b.size)\n}\n", "Array(Node).new(n) needs an element value"))
  xs.push(refused("anew-value-type", "fn main {\n  xs = Array(Int).new(2, \"a\")\n  puts(xs.size)\n}\n", "Array(Int).new's element value must be Int, got String"))
  xs.push(trapped("anew-negative", "fn main {\n  n = 0 - 5\n  xs = Array(Int).new(n)\n  puts(xs.size)\n}\n", "", "avant runtime: Array size -5 is negative"))
  xs
}

fn clock_cases: Array(FCase) {
  xs: Array(FCase) = []
  xs.push(accepted("clock-64", "fn main {\n  a: Int64 = now_us()\n  b = now_us()\n  puts(\"\${b >= a}\")\n  m: Int64 = now_ms()\n  puts(\"\${m > 0i64}\")\n  puts(\"\${a > 4294967296i64 || a > 0i64}\")\n}\n", "true\ntrue\ntrue\n"))
  xs.push(accepted("clock-int", "fn main {\n  x: Int = now_ms()\n  puts(x > 0)\n}\n", "true\n"))
  xs.push(accepted("array-nil-store", "fn main {\n  xs = Array(Array(Int)?).new(2)\n  xs[0] = [1]\n  xs[0] = nil\n  puts((xs[0] ?? [5, 6]).size)\n  ys = Array(String?).new(1, \"a\")\n  ys[0] = nil\n  puts(ys[0] ?? \"nil\")\n}\n", "2\nnil\n"))
  xs
}

fn print_cases: Array(FCase) {
  xs: Array(FCase) = []
  xs.push(accepted("print-float", "fn main {\n  puts(1.0 / 3.0)\n  puts(9007199254740993.0)\n  a = 0.1 + 0.2\n  puts(a)\n  puts(2.0)\n  puts(-2.5)\n  puts(100.0)\n  puts(1e20)\n  puts(1e21)\n  puts(1.5e-7)\n  puts(0.000001)\n  puts(123456789012345678.0)\n  puts(1.7976931348623157e308)\n  puts(5e-324)\n  z = 0.0\n  puts(z)\n  puts(-z)\n  puts(z / z)\n  puts(1.0 / z)\n  puts(-1.0 / z)\n  puts(sqrt(-1.0))\n}\n", "0.3333333333333333\n9007199254740992.0\n0.30000000000000004\n2.0\n-2.5\n100.0\n100000000000000000000.0\n1e21\n1.5e-7\n0.000001\n123456789012345680.0\n1.7976931348623157e308\n5e-324\n0.0\n-0.0\nnan\ninf\n-inf\nnan\n"))
  xs.push(accepted("print-float-interp", "fn main {\n  a = 0.1 + 0.2\n  puts(\"a=\${a} two=\${2.0} big=\${1234567.89} nan=\${0.0 / 0.0} e=\${1e-7}\")\n  x = 1.0 / 3.0\n  s = \"\${x}\"\n  puts((s.to_f ?? 0.0) == x)\n}\n", "a=0.30000000000000004 two=2.0 big=1234567.89 nan=nan e=1e-7\ntrue\n"))
  xs.push(accepted("print-bool", "fn main {\n  puts(true)\n  puts(false)\n  puts(1 < 2)\n  b = 3 == 4\n  puts(b)\n  puts(\"\${b} \${!b}\")\n}\n", "true\nfalse\ntrue\nfalse\nfalse true\n"))
  xs.push(accepted("print-fixed", "fn main {\n  puts(fmt_float(1.0 / 3.0, 3))\n  buf = buf_new()\n  buf.push_fmt_f(2.0, 2)\n  puts(buf.to_s)\n}\n", "0.333\n2.00\n"))
  xs.push(accepted("print-json", "import std.json\nfn main {\n  puts(Json.obj.set(\"pi\", 3.14159265358979).set(\"big\", 1234567.0).set(\"third\", 1.0 / 3.0).set(\"bad\", 0.0 / 0.0).set(\"ok\", true).end.to_s)\n  if j = Json.parse(\"[0.1, 2.0, 1e21, 1.5e-7, 100]\") {\n    puts(j.text)\n  }\n}\n", "{\"pi\":3.14159265358979,\"big\":1234567.0,\"third\":0.3333333333333333,\"bad\":null,\"ok\":true}\n[0.1,2.0,1e21,1.5e-7,100]\n"))
  xs
}

fn nan_cases: Array(FCase) {
  xs: Array(FCase) = []
  xs.push(accepted("nan-min-max", "fn main {\n  n = 0.0 / 0.0\n  puts([n, 1.0, -2.0].min ?? 9.0)\n  puts([1.0, n, -2.0].min ?? 9.0)\n  puts([1.0, -2.0, n].min ?? 9.0)\n  puts([n, n].min ?? 9.0)\n  puts([n, 1.0, -2.0].max ?? 9.0)\n  puts([1.0, n, -2.0].max ?? 9.0)\n  puts([1.0, -2.0, n].max ?? 9.0)\n  puts([1.0, -2.0].max ?? 9.0)\n  xs = [3.0, n, -1.0]\n  puts((xs.min ?? 9.0) == xs.sorted[0])\n}\n", "-2.0\n-2.0\n-2.0\nnan\nnan\nnan\nnan\n1.0\ntrue\n"))
  xs
}

fn parse_cases: Array(FCase) {
  xs: Array(FCase) = []
  xs.push(accepted("parse-strict", "fn show(s: String) {\n  i = \"-\"\n  if v = s.to_i {\n    i = \"\${v}\"\n  }\n  f = \"-\"\n  if w = s.to_f {\n    f = \"\${w}\"\n  }\n  puts(\"[\${s}] \${i} \${f}\")\n}\nfn main {\n  for s in [\"42\", \"-7\", \"+3\", \"007\", \"-0\", \"2147483647\", \"-2147483648\", \"2147483648\", \"3000000000\", \"9223372036854775807\", \"9223372036854775808\", \"-9223372036854775808\", \"99999999999999999999\", \"12abc\", \"  42\", \"42 \", \"0x1F\", \"\", \"-\", \"+\", \"1.5\", \"1e3\", \"1E-2\", \"-2.5e+3\", \"nan\", \"inf\", \"-inf\", \"1e999\", \"1.5xyz\", \".5\", \"5.\", \"1e\", \"1_000\"] {\n    show(s)\n  }\n}\n", "[42] 42 42.0\n[-7] -7 -7.0\n[+3] 3 3.0\n[007] 7 7.0\n[-0] 0 -0.0\n[2147483647] 2147483647 2147483647.0\n[-2147483648] -2147483648 -2147483648.0\n[2147483648] 2147483648 2147483648.0\n[3000000000] 3000000000 3000000000.0\n[9223372036854775807] 9223372036854775807 9223372036854776000.0\n[9223372036854775808] - 9223372036854776000.0\n[-9223372036854775808] -9223372036854775808 -9223372036854776000.0\n[99999999999999999999] - 100000000000000000000.0\n[12abc] - -\n[  42] - -\n[42 ] - -\n[0x1F] - -\n[] - -\n[-] - -\n[+] - -\n[1.5] - 1.5\n[1e3] - 1000.0\n[1E-2] - 0.01\n[-2.5e+3] - -2500.0\n[nan] - -\n[inf] - -\n[-inf] - -\n[1e999] - -\n[1.5xyz] - -\n[.5] - -\n[5.] - -\n[1e] - -\n[1_000] - -\n"))
  xs.push(accepted("parse-bases", "fn main {\n  puts(\"ff\".to_i(16) ?? -1)\n  puts(\"FF\".to_i(16) ?? -1)\n  puts(\"-z\".to_i(36) ?? -1)\n  puts(\"102\".to_i(2) ?? -1)\n  puts(\"777\".to_i(8) ?? -1)\n  puts(\"0x1F\".to_i(16) ?? -1)\n  puts(\"7fffffff\".to_i(16) ?? -1)\n  puts(\"80000000\".to_i(16) ?? -1)\n  puts(\"7fffffffffffffff\".to_i(16) ?? -1)\n  puts(\"8000000000000000\".to_i(16) ?? -1)\n  b = 2\n  puts(\"1011\".to_i(b) ?? -1)\n}\n", "255\n255\n-35\n-1\n511\n-1\n2147483647\n2147483648\n9223372036854775807\n-1\n11\n"))
  xs.push(accepted("parse-wide", "fn main {\n  puts(\"9223372036854775807\".to_i64 ?? 0i64)\n  puts(\"-9223372036854775808\".to_i64 ?? 0i64)\n  puts(\"9223372036854775808\".to_i64 ?? 0i64)\n  puts(\"18446744073709551615\".to_u64 ?? 0u64)\n  puts(\"18446744073709551616\".to_u64 ?? 7u64)\n  puts(\"-1\".to_u64 ?? 7u64)\n  puts(\"ffffffffffffffff\".to_u64(16) ?? 0u64)\n  puts(\"5000000000\".to_i64(10) ?? 0i64)\n}\n", "9223372036854775807\n-9223372036854775808\n0\n18446744073709551615\n7\n7\n18446744073709551615\n5000000000\n"))
  xs.push(accepted("parse-slice", "fn main {\n  puts(str_to_f_slice(\"x2.5y\", 1, 4) ?? -1.0)\n  puts(str_to_f_slice(\"x2.5y\", 0, 4) ?? -1.0)\n  puts(str_to_f_slice(\"x2.5y\", 2, 2) ?? -1.0)\n}\n", "2.5\n-1.0\n-1.0\n"))
  xs.push(accepted("parse-fallback", "fn main {\n  n = \"12x\".to_i ?? 0\n  puts(n)\n  if v = \"8\".to_i {\n    puts(v * 2)\n  }\n  x = \"0.5\".to_f ?? 1.0\n  puts(x)\n}\n", "0\n16\n0.5\n"))
  xs.push(refused("parse-base-literal", "fn main {\n  puts(\"1\".to_i(1) ?? 0)\n}\n", "the base of String.to_i must be in 2..36"))
  xs.push(refused("parse-base-37", "fn main {\n  puts(\"1\".to_u64(37) ?? 0u64)\n}\n", "the base of String.to_u64 must be in 2..36"))
  xs.push(refused("parse-to-f-base", "fn main {\n  puts(\"1\".to_f(10) ?? 0.0)\n}\n", "String.to_f takes no arguments"))
  xs.push(refused("parse-is-optional", "fn main {\n  n: Int = \"1\".to_i\n  puts(n)\n}\n", "cannot assign Int? to Int"))
  xs.push(trapped("parse-base-runtime", "fn main {\n  b = 40\n  puts(\"1\".to_i(b) ?? 0)\n}\n", "", "avant runtime: base 40 out of range (2..36)"))
  xs.push(accepted("json-int", "import std.json\nfn main {\n  if doc = Json.parse(\"{\\\"a\\\": 5000000000, \\\"b\\\": 3.7, \\\"c\\\": 1e300, \\\"d\\\": -2.9, \\\"e\\\": 42, \\\"f\\\": -2147483648, \\\"g\\\": 3.0, \\\"h\\\": 18446744073709551615}\") {\n    for k in [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\", \"g\", \"h\"] {\n      i = \"-\"\n      if v = doc.int(k) {\n        i = \"\${v}\"\n      }\n      puts(\"\${k} \${i}\")\n    }\n    if h = doc.get(\"h\") {\n      v = h.to_value\n      puts(\"\${v.kind} \${v.f64_val}\")\n    }\n  }\n}\n", "a 5000000000\nb -\nc -\nd -\ne 42\nf -2147483648\ng -\nh -\n4 18446744073709552000.0\n"))
  xs
}

fn small_cases: Array(FCase) {
  xs: Array(FCase) = []
  xs.push(accepted("puts-nul", "fn main {\n  s = \"a\${chr(0)}b\"\n  puts(s)\n  puts(s.size)\n}\n", "a${chr(0)}b\n3\n"))
  xs.push(accepted("precision", "fn main {\n  puts(fmt_float(1.0 / 3.0, 20))\n  buf = buf_new()\n  buf.push_fmt_f(2.5, 0)\n  buf.push_byte(32)\n  buf.push_fmt_f(0.1, 17)\n  puts(buf.to_s)\n}\n", "0.33333333333333331483\n2 0.10000000000000001\n"))
  xs.push(trapped("precision-neg", "fn main {\n  puts(fmt_float(1.0, -1))\n}\n", "", "avant runtime: precision -1 out of range (0..64)"))
  xs.push(trapped("precision-big", "fn main {\n  buf = buf_new()\n  buf.push_fmt_f(1.0, 65)\n}\n", "", "avant runtime: precision 65 out of range (0..64)"))
  xs.push(refused("float-literal-range", "fn main {\n  x = 1e400\n  puts(x)\n}\n", "float literal 1e400 is out of range for Float64"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(FCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/num-${f.tag}.av"
    _ = file_write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/num-${f.tag}.bin", "${dir}/num-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job(dir, "num-${f2.tag}.bin", "num-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/num-${f3.tag}.log")
    if f3.ok {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      out = log_text("${dir}/num-${f3.tag}.run.out")
      if f3.trap {
        c.eq_int(runs[k].code, 1, "${f3.tag}: exit 1")
        c.eq_str(out, f3.want, "${f3.tag}: stdout before the trap")
        err = log_text("${dir}/num-${f3.tag}.run.err")
        c.expect(str_has(err, f3.err), "${f3.tag}: stderr says ${f3.err}")
      } else {
        c.eq_int(runs[k].code, 0, "${f3.tag}: exit 0")
        c.eq_str(out, f3.want, "${f3.tag}: stdout")
      }
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !file_exists("${dir}/num-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(str_has(log, f3.want), "${f3.tag}: says ${f3.want}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_numbers.av")
  if compiler = env_get("AVANT_COMPILER") {
    all: Array(FCase) = []
    for f_conv_cases in conv_cases() {
      all.push(f_conv_cases)
    }
    for f_slice_cases in slice_cases() {
      all.push(f_slice_cases)
    }
    for f_arraynew_cases in arraynew_cases() {
      all.push(f_arraynew_cases)
    }
    for f_clock_cases in clock_cases() {
      all.push(f_clock_cases)
    }
    for f_print_cases in print_cases() {
      all.push(f_print_cases)
    }
    for f_nan_cases in nan_cases() {
      all.push(f_nan_cases)
    }
    for f_parse_cases in parse_cases() {
      all.push(f_parse_cases)
    }
    for f_small_cases in small_cases() {
      all.push(f_small_cases)
    }
    run_cases(c, compiler, scratch_dir(), all)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
