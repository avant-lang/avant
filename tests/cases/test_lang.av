import harness

fn add(a: Int, b: Int): Int {
  a + b
}

fn take_i64(v: Int64): Int {
  v.to_i
}

fn test_lang(c: Checks) {
  c.suite("tests/cases/test_lang.av")
  c.eq_int(7 & 5, 5, "bitwise and")
  c.expect(true && false || true, "logical")
  c.eq_int("abc"[0], 97, "string byte")
  c.eq_int("abc"[1], 98, "string byte 1")
  if v = "abc".get(3) {
    c.expect(false, "string get at end is nil")
  } else {
    c.expect(true, "string get at end is nil")
  }
  c.eq_str("item_${7}", "item_7", "prefix int interp")
  c.eq_str("n_${0 - 3}", "n_-3", "prefix negative interp")

  n = 0
  while n < 10 {
    if n == 3 {
      break
    }
    n = n + 1
  }
  c.eq_int(n, 3, "break")
  c.eq_int(8 >> 1, 4, "shift")

  x = 3
  y = 4
  h = spawn { add(x, y) }
  c.eq_int(h.join, 7, "spawn Int capture")

  inner = 0
  while inner < 5 {
    k = 0
    while k < 3 {
      if k == 1 {
        break
      }
      k = k + 1
    }
    inner = inner + 1
  }
  c.eq_int(inner, 5, "inner break")

  c.eq_int("42".to_i, 42, "to_i")

  p = 1
  q = p
  c.eq_int(q, 1, "int copy")

  xs: Array(Int) = [3, 1, 2]
  xs.sort
  c.eq_int(xs[0], 1, "sort lo")
  c.eq_int(xs[2], 3, "sort hi")

  wide = Array(Int).new(200)
  i = 0
  wide_sum = 0
  while i < 200 {
    wide[i] = 80 - (i * 13) % 180
    wide_sum = wide_sum + wide[i]
    i = i + 1
  }
  wide[0] = -2000000000
  wide[1] = 2000000000
  wide_sum = wide_sum - (80 - 0) - (80 - 13) + wide[0] + wide[1]
  wide.sort
  wide_got = 0
  wide_ok = 1
  i = 0
  while i < 200 {
    wide_got = wide_got + wide[i]
    if i > 0 {
      if wide[i] < wide[i - 1] {
        wide_ok = 0
      }
    }
    i = i + 1
  }
  c.eq_int(wide_ok, 1, "sort wide ordered")
  c.eq_int(wide_got, wide_sum, "sort wide sum")
  c.eq_int(wide[0], -2000000000, "sort wide lo")
  c.eq_int(wide[199], 2000000000, "sort wide hi")

  narrow = Array(Int).new(200)
  i = 0
  while i < 200 {
    narrow[i] = (i * 3) % 7 - 3
    i = i + 1
  }
  narrow.sort
  narrow_ok = 1
  i = 1
  while i < 200 {
    if narrow[i] < narrow[i - 1] {
      narrow_ok = 0
    }
    i = i + 1
  }
  c.eq_int(narrow_ok, 1, "sort narrow ordered")
  c.eq_int(narrow[0], -3, "sort narrow lo")
  c.eq_int(narrow[199], 3, "sort narrow hi")

  rev = Array(Int).new(600)
  i = 0
  while i < 600 {
    rev[i] = 600 - i
    i = i + 1
  }
  rev.sort
  c.eq_int(rev[0], 1, "sort reverse lo")
  c.eq_int(rev[599], 600, "sort reverse hi")

  hmap = Hash(Int, Int).new
  hmap[10] = 1
  if v = hmap.get(10) {
    hmap[10] = v + 1
  }
  hmap[20] = 3
  c.eq_int(hmap.size, 2, "Hash(Int, Int) size")
  hmap.clear
  c.eq_int(hmap.size, 0, "hash clear")
  hmap[10] = 4
  c.eq_int(hmap.size, 1, "hash after clear")
  if cleared_v = hmap.get(10) {
    c.eq_int(cleared_v, 4, "hash value after clear")
  } else {
    c.expect(false, "hash value after clear")
  }
  popped: Array(Int) = [1, 2]
  c.eq_int(popped.pop, 2, "Array.pop")

  cleared: Array(Int) = [1, 2, 3]
  cleared.clear
  cleared.reserve(8)
  cleared.push(7)
  cleared.push(9)
  c.eq_int(cleared.size, 2, "clear+reserve size")
  c.eq_int(cleared[0], 7, "clear+reserve 0")
  c.eq_int(cleared[1], 9, "clear+reserve 1")

  a64: Int64 = 1
  b64 = 2i64
  c.eq_int((a64 + b64).to_i, 3, "Int64 add")
  c.eq_int(take_i64(7), 7, "Int literal adopts Int64")
  filled = Array(Int).new(4)
  filled.fill(7)
  c.eq_int(filled[3], 7, "Array.fill")
  flags = Array(Bool).new(4)
  flags.fill(true)
  flags[0] = false
  nflags = 0
  if flags[1] {
    nflags = nflags + 1
  }
  if flags[2] {
    nflags = nflags + 1
  }
  if flags[3] {
    nflags = nflags + 1
  }
  c.eq_int(nflags, 3, "Array(Bool).fill")

  acc: UInt64 = 3000000000
  c.eq_str("${acc}", "3000000000", "UInt64 interp")

  b = buf_new()
  b.push_byte(97)
  b.push_str("b")
  b.push_fmt_i(12)
  c.eq_str(b.to_s, "ab12", "Buf")
  bi = buf_new()
  bi.push_byte(65)
  bi.push_byte(66)
  bi.push_byte(67)
  c.eq_int(bi[0], 65, "Buf index 0")
  c.eq_int(bi[1] + bi[2], 133, "Buf index sum")
  bf = buf_new(8)
  bf.push_fmt_f(3.14159, 2)
  c.eq_str(bf.to_s, "3.14", "Buf push_fmt_f")

  c.eq_str(chr(97) + chr(98), "ab", "chr")
  c.eq_str(repeat_byte(97, 3), "aaa", "repeat_byte")
  bytes: Array(Int) = [97, 98, 99]
  c.eq_str(bytes_to_str(bytes), "abc", "bytes_to_str")
  c.eq_str(str_slice("abcd", 1, 3), "bc", "str_slice")
  c.eq_str(fmt_float(1.0, 7), "1.0000000", "fmt_float")
  c.eq_int(exp(0.0).to_i, 1, "exp")
  c.eq_int((1.5e-01 * 20.0).to_i, 3, "float exponent")

  i = 0
  while i < 2 {
    typed: Array(Int) = []
    typed.push(i)
    i = i + 1
  }
  c.eq_int(i, 2, "while typed bind")

  s = switch true {
    case 0 { "no" }
    case 1 { "yes" }
    else { "other" }
  }
  c.eq_str(s, "yes", "Bool switch")

  miss = 0
  switch 9 {
    case 0 {
      miss = 1
    }
  }
  c.eq_int(miss, 0, "void switch miss")
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_lang(c)
  c.finish
}
