import harness
import std.fs
import std.process

quote {
  fn doubled(n: Int): Int {
    n + n
  }
}

quote {
  fn #("tripled")(n: Int): Int {
    n * 3
  }
}

struct Box {
  n: Int
  quote {
    fn doubled: Int {
      self.n + self.n
    }
  }
}

fn test_macros(c: Checks) {
  c.suite("tests/cases/test_macros.av")
  c.eq_int(doubled(21), 42, "quoted fn")
  c.eq_int(tripled(7), 21, "spliced name")
  tmp = 1
  quote {
    tmp = 2
    c.eq_int(tmp, 2, "quote local")
  }
  c.eq_int(tmp, 1, "outer local")
  b = Box { n: 3 }
  c.eq_int(b.doubled(), 6, "quoted method")

  if compiler = process.env("AVANT_COMPILER") {
    stamp = now_ms()
    dir = "${scratch()}/macros-${stamp}"
    mkdir_p(dir)

    write_av(dir, "fields", "struct Point {\n  x: Int\n  y: Int\n}\ncomptime {\n  for f in Point.fields {\n    quote {\n      fn #(f.name)(p: Point): #(f.type) {\n        p.#(f.name)\n      }\n    }\n  }\n}\nfn main {\n  p = Point { x: 3, y: 4 }\n  puts(x(p))\n  puts(y(p))\n}\n")
    fields_bin = "${dir}/fields.bin"
    fields_log = "${dir}/fields.log"
    fields_out = "${dir}/fields.out"
    fields_code = compile_av(compiler, "${dir}/fields.av", fields_bin, fields_log)
    c.eq_int(fields_code, 0, "field walk compile")
    c.expect(fs.exists(fields_bin), "field walk bin")
    chmod_x(fields_bin)
    run_av_bin(fields_bin, fields_out)
    if got = fs.read(fields_out) {
      c.eq_str(got, "3\n4\n", "field walk accessors")
    } else {
      c.expect(false, "field walk accessors")
    }

    // A walk over a generic type: f.type names the type's parameters, so
    // the functions it writes are generic and each instance reads its own
    // field types (Box(String), Box(Float64), Pair(Int, String)).
    write_av(dir, "generic_walk", "struct Box(T) {\n  value: T\n  count: Int\n}\nclass Pair(A, B) {\n  left: A\n  right: B\n  fn initialize(self.left, self.right) {\n  }\n}\ncomptime {\n  for f in Box.fields {\n    quote {\n      fn #(f.name)(b: Box(T)): #(f.type) {\n        b.#(f.name)\n      }\n    }\n  }\n}\ncomptime {\n  for f in Pair.fields {\n    quote {\n      fn #(f.name)(p: Pair(A, B)): #(f.type) {\n        p.#(f.name)\n      }\n    }\n  }\n}\nfn main {\n  a = Box { value: \"text\", count: 2 }\n  b = Box { value: 1.5, count: 3 }\n  puts(value(a) + \"!\")\n  puts(count(a) + count(b))\n  puts(value(b) * 2.0)\n  p = Pair.new(7, \"seven\")\n  puts(left(p) + 1)\n  puts(right(p).size)\n}\n")
    gen_bin = "${dir}/generic_walk.bin"
    gen_log = "${dir}/generic_walk.log"
    gen_out = "${dir}/generic_walk.out"
    c.eq_int(compile_av(compiler, "${dir}/generic_walk.av", gen_bin, gen_log), 0, "field walk over a generic type compiles")
    chmod_x(gen_bin)
    run_av_bin(gen_bin, gen_out)
    if got = fs.read(gen_out) {
      c.eq_str(got, "text!\n5\n3.0\n8\n5\n", "field walk over a generic type: each instance's field types")
    } else {
      c.expect(false, "field walk over a generic type: each instance's field types")
    }

    write_av(dir, "splice_out", "fn #(name): Int {\n  1\n}\nfn main {\n  puts(1)\n}\n")
    splice_bin = "${dir}/splice.bin"
    splice_log = "${dir}/splice.log"
    splice_code = compile_av(compiler, "${dir}/splice_out.av", splice_bin, splice_log)
    c.expect(splice_code != 0, "splice outside quote exits non-zero")
    c.expect(!fs.exists(splice_bin), "splice outside quote bin absent")
    if err = fs.read(splice_log) {
      c.expect(err.contains("splice #() only belongs in quote"), "splice outside quote")
    } else {
      c.expect(false, "splice outside quote")
    }

    write_av(dir, "bad_comptime", "comptime {\n  puts(1)\n}\nfn main {\n  puts(1)\n}\n")
    bad_bin = "${dir}/bad.bin"
    bad_log = "${dir}/bad.log"
    bad_code = compile_av(compiler, "${dir}/bad_comptime.av", bad_bin, bad_log)
    c.expect(bad_code != 0, "bad comptime exits non-zero")
    c.expect(!fs.exists(bad_bin), "bad comptime bin absent")
    if err = fs.read(bad_log) {
      c.expect(err.contains("a comptime block is a field walk: comptime { for f in Type.fields { quote { ... } } }"), "comptime field walk")
    } else {
      c.expect(false, "comptime field walk")
    }

    write_av(dir, "nested", "quote {\n  fn inner: Int {\n    quote {\n      1\n    }\n  }\n}\nfn main {\n  puts(1)\n}\n")
    nest_bin = "${dir}/nest.bin"
    nest_log = "${dir}/nest.log"
    nest_code = compile_av(compiler, "${dir}/nested.av", nest_bin, nest_log)
    c.expect(nest_code != 0, "nested quote exits non-zero")
    c.expect(!fs.exists(nest_bin), "nested quote bin absent")
    if err = fs.read(nest_log) {
      c.expect(err.contains("quote cannot nest"), "nested quote")
    } else {
      c.expect(false, "nested quote")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_macros(c)
  c.finish()
}
