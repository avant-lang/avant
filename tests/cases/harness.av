// One command for run_jobs: path and args, stdout and stderr to log.
pub class HJob {
  path: String = ""
  args: Array(String)
  log: String = ""
  pid: Int = 0
  code: Int = 127

  fn initialize(path: String, args: Array(String), log: String) {
    self.path = path
    self.args = args
    self.log = log
    self.pid = 0
    self.code = 127
  }
}

// Starts every job at once on the runtime job interface (D131, D138) and
// waits for all of them; each job's code is its exit status (127 when it
// could not start, 128+n for a signal).
pub fn run_jobs(jobs: Array(HJob)) {
  running = 0
  for j in jobs {
    j.pid = harness_rt.avant_job_start(j.path, j.args, j.log)
    if j.pid > 0 {
      running = running + 1
    } else {
      j.code = 127
    }
  }
  while running > 0 {
    got = harness_rt.avant_job_wait()
    if got < 0 {
      break
    }
    st = harness_rt.avant_job_status()
    for k in 0..jobs.size {
      if jobs[k].pid == got {
        jobs[k].code = st
      }
    }
    running = running - 1
  }
}

// The process's private scratch directory (D127): created on first use,
// removed when this test binary exits, nested inside the runner's.
pub fn scratch: String {
  harness_rt.avant_tmp_dir()
}

// A fresh, created directory inside scratch.
pub fn scratch_dir: String {
  harness_rt.avant_tmp_new_dir()
}

pub fn avant_test_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  "."
}

pub fn list_only: Bool {
  if v = env_get("AVANT_TEST_LIST") {
    if v == "1" {
      return true
    }
  }
  false
}

// The collector's environment variables (runtime/avant_gc.h lists them),
// for the suite run under one GC environment (Stage 28
// W12, O26: tools/gate.sh's GATE_GC_ENV runs one extra suite pass with it).
pub fn gc_env_names: Array(String) {
  ["AVANT_YOUNG_MB", "AVANT_HEAP_MAX_MB", "AVANT_HEAP_RESERVE_GB", "AVANT_NURSERY", "AVANT_GC_DEFRAG", "AVANT_GC_VERIFY", "AVANT_GC_STATS", "AVANT_GC_STRESS"]
}

// AVANT_GC_STRESS is set (non-empty) in this test's own environment (the
// gate's GATE_GC_ENV=AVANT_GC_STRESS=1 pass, Stage 28 W14b1): a young
// collection runs at every runtime helper's entry and at every runtime C
// allocation, so a compiler-sized job (the compiler compiling or dumping
// itself) or a verifier pass at every collection does not fit the
// suite's time. Checks that run those skip themselves under it; the gate
// builds and checks the compiler outside the GC environment.
pub fn gc_stress_outer: Bool {
  if v = env_get("AVANT_GC_STRESS") {
    return v.size > 0
  }
  false
}

// The names of the collector's environment variables set (non-empty) in
// this test's own environment and not among `stated` (the
// space-separated names a check sets itself for the program it runs),
// space-separated; "" when none. A check that asserts the default
// environment's GC numbers skips itself when this is not empty; a check
// whose program's output depends on the collector states the
// environment it needs instead (for example AVANT_NURSERY=1 for `bump`).
pub fn gc_env_outer(stated: String): String {
  names = gc_env_names()
  own = " ${stated} "
  out = ""
  for nm in names {
    if v = env_get(nm) {
      if v.size > 0 && !str_has(own, " ${nm} ") {
        if out.size > 0 {
          out = "${out} "
        }
        out = "${out}${nm}"
      }
    }
  }
  out
}

pub class Checks {
  passed: Int = 0
  failed: Int = 0
  suites_ok: Int = 0
  suites_bad: Int = 0
  suite_name: String = ""
  suite_failed_at: Int = 0
  started: Int = 0
  case_at: Int = 0
  lines: Array(String)
  rec_suite: Array(String)
  rec_name: Array(String)
  rec_ok: Array(Int)
  rec_ms: Array(Int)
  rec_at: Int = 0

  fn initialize {
    self.lines = []
    self.rec_suite = []
    self.rec_name = []
    self.rec_ok = []
    self.rec_ms = []
  }

  fn record(okv: Bool, msg: String) {
    now = now_ms()
    dur = 0
    if self.rec_at > 0 {
      dur = now - self.rec_at
    }
    self.rec_at = now
    self.rec_suite.push(self.suite_name)
    self.rec_name.push(msg)
    if okv {
      self.rec_ok.push(1)
    } else {
      self.rec_ok.push(0)
    }
    self.rec_ms.push(dur)
  }

  fn flush_suite {
    if self.suite_name.size == 0 {
      return
    }
    nfail = self.failed - self.suite_failed_at
    if nfail == 0 {
      puts(" PASS  ${self.suite_name}")
      self.suites_ok = self.suites_ok + 1
    } else {
      puts(" FAIL  ${self.suite_name}")
      self.suites_bad = self.suites_bad + 1
    }
    i = 0
    while i < self.lines.size {
      puts(self.lines[i])
      i = i + 1
    }
    self.lines = []
    self.suite_name = ""
  }

  pub fn suite(name: String) {
    self.flush_suite()
    self.suite_name = name
    self.suite_failed_at = self.failed
    self.case_at = now_ms()
    self.rec_at = now_ms()
  }

  fn junit_escape(s: String): String {
    b = buf_new()
    i = 0
    while i < s.size {
      c = s[i]
      if c == 38 {
        b.push_str("&amp;")
      } else if c == 60 {
        b.push_str("&lt;")
      } else if c == 62 {
        b.push_str("&gt;")
      } else if c == 34 {
        b.push_str("&quot;")
      } else if c == 39 {
        b.push_str("&apos;")
      } else {
        b.push_byte(c)
      }
      i = i + 1
    }
    b.to_s
  }

  fn junit_secs(ms: Int): String {
    whole = ms / 1000
    frac = ms % 1000
    fs = "${frac}"
    while fs.size < 3 {
      fs = "0${fs}"
    }
    "${whole}.${fs}"
  }

  fn write_junit {
    frag = ""
    if v = env_get("AVANT_JUNIT_FRAGMENT") {
      frag = v
    }
    if frag.size == 0 {
      return
    }
    if self.rec_name.size == 0 {
      return
    }
    b = buf_new()
    i = 0
    while i < self.rec_name.size {
      suite = self.rec_suite[i]
      j = i
      n = 0
      badn = 0
      total = 0
      while j < self.rec_name.size && self.rec_suite[j] == suite {
        n = n + 1
        total = total + self.rec_ms[j]
        if self.rec_ok[j] == 0 {
          badn = badn + 1
        }
        j = j + 1
      }
      b.push_str("<testsuite name=\"${self.junit_escape(suite)}\" tests=\"${n}\" failures=\"${badn}\" time=\"${self.junit_secs(total)}\">\n")
      for k in i..j {
        b.push_str("  <testcase name=\"${self.junit_escape(self.rec_name[k])}\" classname=\"${self.junit_escape(suite)}\" time=\"${self.junit_secs(self.rec_ms[k])}\"")
        if self.rec_ok[k] == 0 {
          b.push_str(">\n    <failure message=\"check failed\"/>\n  </testcase>\n")
        } else {
          b.push_str("/>\n")
        }
      }
      b.push_str("</testsuite>\n")
      i = j
    }
    dummy = file_write(frag, b.to_s)
  }

  pub fn expect(cond: Bool, msg: String) {
    self.record(cond, msg)
    if cond {
      self.passed = self.passed + 1
      self.lines.push("    ✓ ${msg}")
    } else {
      self.failed = self.failed + 1
      harness_rt.avant_test_fail()
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
    }
  }

  // A check not run, and why (it is neither passed nor failed, and the
  // JUnit report does not list it). Only an outer GC environment skips a
  // check (gc_env_outer); the default suite skips none.
  pub fn skip(msg: String, why: String) {
    self.lines.push("    ○ ${msg} (skipped: ${why})")
  }

  pub fn eq_int(got: Int, want: Int, msg: String) {
    self.record(got == want, msg)
    if got == want {
      self.passed = self.passed + 1
      self.lines.push("    ✓ ${msg}")
    } else {
      self.failed = self.failed + 1
      harness_rt.avant_test_fail()
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
      self.lines.push("    got ${got}, want ${want}")
      self.lines.push("")
    }
  }

  pub fn eq_str(got: String, want: String, msg: String) {
    self.record(got == want, msg)
    if got == want {
      self.passed = self.passed + 1
      self.lines.push("    ✓ ${msg}")
    } else {
      self.failed = self.failed + 1
      harness_rt.avant_test_fail()
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
      self.lines.push("    got ${got}, want ${want}")
      self.lines.push("")
    }
  }

  pub fn finish: Int {
    self.flush_suite()
    self.write_junit()
    ms = now_ms() - self.started
    puts("")
    puts("Test Suites: ${fmt_counts(self.suites_bad, self.suites_ok)}")
    puts("Tests:       ${fmt_counts(self.failed, self.passed)}")
    puts("Time:        ${ms} ms")
    puts("Ran all test suites.")
    if self.failed != 0 {
      return 1
    }
    if self.suites_bad != 0 {
      return 1
    }
    0
  }
}

