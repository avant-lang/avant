  args.push(src)
  process_run_out(compiler, args, log)
}

pub fn run_av_cmd_flags(compiler: String, src: String, log: String, extra: Array(String)): Int {
  args: Array(String) = []
  args.push("run")
  args.push(src)
  i = 0
  while i < extra.size {
    args.push(extra[i])
    i = i + 1
  }
  process_run_out(compiler, args, log)
}

pub fn compile_av_cov(compiler: String, src: String, bin: String, log: String): Int {
  args: Array(String) = []
  args.push("AVANT_COVERAGE=1")
  args.push(compiler)
  args.push("compile")
  args.push(src)
  args.push(bin)
  process_run_out("/usr/bin/env", args, log)
}

// The MIR with coverage on (as dump_av).
