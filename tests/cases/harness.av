// Runs the program with its stdout and stderr both written to the file
// out, in the order it wrote them (through sh's redirection, which is
// what the file then holds): the exit status, or the failure to start sh.
// Whether env(1)'s arguments are only assignments, `-u NAME` and `-C DIR`
// before a program that names a path: run_out then does their work in the
// shell and execs the program directly.
fn env_prefix_direct(args: Array(String)): Bool {
  i = 0
  while i < args.size {
    a = args[i]
    if (a == "-u" || a == "-C") && i + 1 < args.size {
      i += 2
    } else if is_assignment(a) {
      i += 1
    } else {
      return a.size > 0 && a[0] != 45 && a.contains("/")
    }
  }
  false
}

pub fn run_out(program: String, args: Array(String), out: String): Int | ProcessError {
  if program == "/usr/bin/env" && env_prefix_direct(args) {
    // env's assignments and `-u NAME` made by the shell itself, and the
    // program exec'd directly: env(1) would take a program path holding
    // '=' (a TMPDIR such as .../AVANT_NURSERY=0/...) for an assignment.
    script = "out=$1; shift; while [ $# -gt 0 ]; do case $1 in -u) unset \"$2\"; shift 2 ;; -C) cd \"$2\" || exit 127; shift 2 ;; [A-Za-z_]*=*) if expr \"x$1\" : 'x[A-Za-z_][A-Za-z0-9_]*=' > /dev/null; then export \"$1\"; shift; else break; fi ;; *) break ;; esac; done; exec \"$@\" > \"$out\" 2>&1"
    env_args = ["-c", script, "sh", out]
    for a in args {
      env_args.push(a)
    }
    return process.run("/bin/sh", env_args)
  }
  sh_args = ["-c", "out=$1; shift; exec \"$@\" > \"$out\" 2>&1", "sh", out, program]
  for a in args {
    sh_args.push(a)
  }
  process.run("/bin/sh", sh_args)
}

pub fn compile_av(compiler: String, src: String, bin: String, log: String): Int {
  args: Array(String) = []
  args.push("compile")
  args.push(src)
  args.push(bin)
  // Test programs are compiled fast (--debug); a bare compile is
  // --release. test_toolchain.av covers the verb defaults.
  args.push("--debug")
  run_out(compiler, args, log) ?? -1
}

pub fn compile_av_flags(compiler: String, src: String, bin: String, log: String, extra: Array(String)): Int {
  args: Array(String) = []
  args.push("compile")
  args.push(src)
  args.push(bin)
  has_codegen = false
  i = 0
  while i < extra.size {
    if extra[i] == "--debug" {
      has_codegen = true
    }
    if extra[i] == "--release" {
      has_codegen = true
    }
    if extra[i] == "--final" {
      has_codegen = true
    }
    args.push(extra[i])
    i += 1
  }
  if !has_codegen {
    args.push("--debug")
  }
  run_out(compiler, args, log) ?? -1
}

// `dump`: the MIR text, which the callers inspect (the old back
// end's IR until it retired).
pub fn dump_av(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(src)
  run_out(compiler, args, log) ?? -1
}

// `__emit-ll SRC OUT` (internal): the pre-optimization .ll
// the back end hands to LLVM, which carries no source location; its
// messages go to log.
pub fn emit_ll(compiler: String, src: String, out: String, log: String): Int {
  args: Array(String) = []
  args.push("__emit-ll")
  args.push(src)
  args.push(out)
  run_out(compiler, args, log) ?? -1
}

// A hidden front-end dump: flag is --tokens, --ast, or --check.
pub fn dump_layer(compiler: String, flag: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(flag)
  args.push(src)
  run_out(compiler, args, log) ?? -1
}

pub fn compiler_abs(tag: String, path: String): String {
  if path.size > 0 && path[0] == 47 {
    return path
  }
  here = cwd_here()
  if here == "." {
    return path
  }
  "${here}/${path}"
}

pub fn run_av_bin(bin: String, log: String): Int {
  run_out(bin, empty_strs(), log) ?? -1
}

pub fn run_av_cmd(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("run")
  args.push(src)
  run_out(compiler, args, log) ?? -1
}

pub fn run_av_cmd_flags(compiler: String, src: String, log: String, extra: Array(String)): Int {
  args: Array(String) = []
  args.push("run")
  args.push(src)
  args.concat(extra)
  run_out(compiler, args, log) ?? -1
}

pub fn compile_av_cov(compiler: String, src: String, bin: String, log: String): Int {
  args: Array(String) = []
  args.push("AVANT_COVERAGE=1")
  args.push(compiler)
  args.push("compile")
  args.push(src)
  args.push(bin)
  run_out("/usr/bin/env", args, log) ?? -1
}

// The MIR with coverage on (as dump_av).
pub fn dump_av_cov(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("AVANT_COVERAGE=1")
  args.push(compiler)
  args.push("dump")
  args.push(src)
  run_out("/usr/bin/env", args, log) ?? -1
}

pub fn write_tmp(stem: String, stamp: Int, name: String, body: String): String {
  path = "${scratch()}/${stem}-${stamp}-${name}"
  _ = fs.write(path, body)
  path
}

pub fn mkdir_p(path: String) {
  harness_rt.avant_fs_mkdir_p(path)
}

pub fn write_av(dir: String, name: String, body: String) {
  _ = fs.write("${dir}/${name}.av", body)
}

pub class Held {
  pub n: Int

  pub fn initialize(n: Int) {
    self.n = n
  }
}

pub struct Cell {
  pub n: Int
}

// A row of tests/goldens/list.txt: the one list of
// dump goldens, which tests/bless_goldens.av writes and the test file a
// row names checks.
pub class GoldenRow {
  pub stem: String
  pub src: String
  pub layers: Array(String)

  pub fn initialize(stem: String, src: String, layers: Array(String)) {
    self.stem = stem
    self.src = src
    self.layers = layers
  }

  // The stem's last part: tests/goldens/DIR/NAME is NAME.
  pub fn name: String {
    at = 0
    for i in 0..self.stem.size {
      if self.stem[i] == 47 {
        at = i + 1
      }
    }
    self.stem[at..]
  }

  pub fn has(layer: String): Bool {
    for l in self.layers {
      if l == layer {
        return true
      }
    }
    false
  }
}

// The rows of tests/goldens/list.txt that test (tests/cases/TEST.av)
// checks, in the list's order; an unreadable list, a malformed row or
// no row for test is a failed check, so a test never checks nothing.
pub fn golden_rows(c: Checks, test: String): Array(GoldenRow) {
  rows: Array(GoldenRow) = []
  path = "${avant_test_root()}/tests/goldens/list.txt"
  if text = fs.read(path) {
    for line in text.split("\n") {
      if line.size == 0 || line[0] == 35 {
        continue
      }
      words: Array(String) = []
      for w in line.split(" ") {
        if w.size > 0 {
          words.push(w)
        }
      }
      if words.size != 4 {
        c.expect(false, "${path}: a row is TEST STEM SOURCE LAYERS: ${line}")
        continue
      }
      if words[0] == test {
        rows.push(GoldenRow.new(words[1], words[2], words[3].split(",")))
      }
    }
  } else {
    c.expect(false, "read ${path}")
  }
  c.expect(rows.size > 0, "${path} lists goldens for ${test}")
  rows
}

// The names of test's rows (golden_rows), in order.
pub fn golden_names_of(c: Checks, test: String): Array(String) {
  names: Array(String) = []
  for r in golden_rows(c, test) {
    names.push(r.name())
  }
  names
}
