pub fn compile_av(compiler: String, src: String, bin: String, log: String): Int {
  args: Array(String) = []
  args.push("compile")
  args.push(src)
  args.push(bin)
  // Test programs are compiled fast (--debug); a bare compile uses the
  // default mode. test_toolchain.av covers the verb defaults.
  args.push("--debug")
  process_run_out(compiler, args, log)
}

pub fn compile_av_flags(compiler: String, src: String, bin: String, log: String, extra: Array(String)): Int {
  args: Array(String) = []
  args.push("compile")
  args.push(src)
  args.push(bin)
  has_codegen = false
  i = 0
  while i < extra.size {
    if extra[i] == "--debug" {
      has_codegen = true
    }
    if extra[i] == "--release" {
      has_codegen = true
    }
    if extra[i] == "--final" {
      has_codegen = true
    }
    args.push(extra[i])
    i = i + 1
  }
  if !has_codegen {
    args.push("--debug")
  }
  process_run_out(compiler, args, log)
}

// `dump`: the MIR text (D171), which the callers inspect (the old back
// end's IR until Stage 28 W11).
pub fn dump_av(compiler: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(src)
  process_run_out(compiler, args, log)
}

// `__emit-ll SRC OUT` (internal, Stage 28 W9): the pre-optimization .ll
// the back end hands to LLVM, which carries no source location; its
// messages go to log.
pub fn emit_ll(compiler: String, src: String, out: String, log: String): Int {
  args: Array(String) = []
  args.push("__emit-ll")
  args.push(src)
  args.push(out)
  process_run_out(compiler, args, log)
}

// A hidden front-end dump (D137): flag is --tokens, --ast, or --check.
pub fn dump_layer(compiler: String, flag: String, src: String, log: String): Int {
  args: Array(String) = []
  args.push("dump")
  args.push(flag)
  args.push(src)
  process_run_out(compiler, args, log)
}

pub fn compiler_abs(tag: String, path: String): String {
  if path.size > 0 && path[0] == 47 {
    return path
  }
  here = cwd_here()
  if here == "." {
    return path
  }
  "${here}/${path}"
}

pub fn run_av_bin(bin: String, log: String): Int {
  process_run_out(bin, empty_strs(), log)
}

pub fn run_av_cmd(compiler: String, src: String, log: String): Int {
