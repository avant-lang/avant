pub fn str_has(hay: String, needle: String): Bool {
  if needle.size > hay.size {
    return false
  }
  if needle.size == 0 {
    return true
  }
  i = 0
  while i + needle.size <= hay.size {
    if str_slice(hay, i, i + needle.size) == needle {
      return true
    }
    i = i + 1
  }
  false
}

fn fmt_counts(bad: Int, ok: Int): String {
  total = bad + ok
  if bad == 0 {
    return "${ok} passed, ${total} total"
  }
  if ok == 0 {
    return "${bad} failed, ${total} total"
  }
  "${bad} failed, ${ok} passed, ${total} total"
}

pub fn nth_line(s: String, n: Int): String {
  start = 0
  i = 0
  line = 0
  while i < s.size {
    if s[i] == 10 {
      if line == n {
        return str_slice(s, start, i)
      }
      line = line + 1
      start = i + 1
    }
    i = i + 1
  }
  if line == n {
    return str_slice(s, start, s.size)
  }
  ""
}

pub fn count_lines(s: String): Int {
  n = 0
  for i in 0..s.size {
    if s[i] == 10 {
      n = n + 1
    }
  }
  n
}

