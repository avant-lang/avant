// One command for run_jobs: path and args, stdout and stderr to log.
pub class HJob {
  path: String = ""
  pub args: Array(String)
  pub log: String = ""
  pid: Int = 0
  pub code: Int = 127

  fn initialize(path: String, args: Array(String), log: String) {
    self.path = path
    self.args = args
    self.log = log
    self.pid = 0
    self.code = 127
  }
}

// Starts every job at once on the runtime job interface and
// waits for all of them; each job's code is its exit status (127 when it
// could not start, 128+n for a signal).
pub fn run_jobs(jobs: Array(HJob)) {
  running = 0
  for j in jobs {
    j.pid = start_job(j)
    if j.pid > 0 {
      running += 1
    } else {
      j.code = 127
    }
  }
  while running > 0 {
    got = harness_rt.avant_job_wait()
    if got < 0 {
      break
    }
    st = harness_rt.avant_job_status()
    for k in 0..jobs.size {
      if jobs[k].pid == got {
        jobs[k].code = st
      }
    }
    running -= 1
  }
}

// A job through /usr/bin/env whose program names a path is started
// directly with the same environment changes (NAME=VALUE sets, `-u NAME`
// unsets): env takes any word holding '=' before the program for an
// assignment, so a program under a TMPDIR such as .../AVANT_NURSERY=0/...
// would not run (env would print the environment and exit 0). A bare
// program name, looked up on PATH, still goes through env.
// NAME=VALUE: a name of letters, digits and '_' before the first '='.
fn is_assignment(a: String): Bool {
  i = 0
  while i < a.size {
    c = a[i]
    if c == 61 {
      return i > 0
    }
    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95) {
      return false
    }
    i += 1
  }
  false
}

fn start_job(j: HJob): Int {
  if j.path != "/usr/bin/env" {
    return harness_rt.avant_job_start(j.path, j.args, j.log)
  }
  env: Array(String) = []
  i = 0
  while i < j.args.size {
    a = j.args[i]
    if a == "-u" && i + 1 < j.args.size {
      env.push(j.args[i + 1])
      i += 2
    } else if is_assignment(a) {
      env.push(a)
      i += 1
    } else {
      break
    }
  }
  if i >= j.args.size || !j.args[i].contains("/") {
    return harness_rt.avant_job_start(j.path, j.args, j.log)
  }
  rest: Array(String) = []
  k = i + 1
  while k < j.args.size {
    rest.push(j.args[k])
    k += 1
  }
  harness_rt.avant_job_start_env(j.args[i], rest, env, j.log)
}

// The process's private scratch directory: created on first use,
// removed when this test binary exits, nested inside the runner's.
pub fn scratch: String {
  harness_rt.avant_tmp_dir()
}

// A fresh, created directory inside scratch.
pub fn scratch_dir: String {
  harness_rt.avant_tmp_new_dir()
}

pub fn avant_test_root: String {
  if v = process.env("AVANT_ROOT") {
    return v
  }
  "."
}

pub fn list_only: Bool {
  if v = process.env("AVANT_TEST_LIST"), v == "1" {
    return true
  }
  false
}

// The collector's environment variables (runtime/avant_gc.h lists
// them), for the suite run under one GC environment
// (tools/gate.sh's GATE_GC_ENV runs one extra suite pass with it).
pub fn gc_env_names: Array(String) {
  ["AVANT_YOUNG_MB", "AVANT_HEAP_MAX_MB", "AVANT_HEAP_RESERVE_GB", "AVANT_NURSERY", "AVANT_GC_DEFRAG", "AVANT_GC_VERIFY", "AVANT_GC_STATS", "AVANT_GC_STRESS"]
}

// AVANT_GC_STRESS is set (non-empty) in this test's own
// environment (the gate's GATE_GC_ENV=AVANT_GC_STRESS=1 pass): a
// young collection runs at every runtime helper's entry and at
// every allocation (generated code's too),
// so a compiler-sized job (the compiler compiling or dumping
// itself) or a verifier pass at every collection does not fit the
// suite's time. Checks that run those skip themselves under it,
// or run their verifier jobs without it where it was measured too
// long (backends.av's run_job_env, test_gc_typemaps.av,
// test_gc_behavior.av, test_gc_checks.av's limit_defer.av); the
// gate builds and checks the compiler outside the GC environment.
pub fn gc_stress_outer: Bool {
  if v = process.env("AVANT_GC_STRESS") {
    return v.size > 0
  }
  false
}

// The names of the collector's environment variables set (non-empty) in
// this test's own environment and not among `stated` (the
// space-separated names a check sets itself for the program it runs),
// space-separated; "" when none. A check that asserts the default
// environment's GC numbers skips itself when this is not empty; a check
// whose program's output depends on the collector states the
// environment it needs instead (for example AVANT_NURSERY=1 for `bump`).
pub fn gc_env_outer(stated: String): String {
  names = gc_env_names()
  own = " ${stated} "
  out = ""
  for nm in names {
    if v = process.env(nm), v.size > 0 && !own.contains(" ${nm} ") {
      if out.size > 0 {
        out = "${out} "
      }
      out = "${out}${nm}"
    }
  }
  out
}

// Whether every NAME=VALUE word of `words` already holds in this test's own
// environment (a `-u` word never does): a program run with those words
// added runs in exactly the environment it gets without them, so one run
// serves both checks (the stress pass's "under AVANT_GC_STRESS=1" is its
// own environment).
pub fn env_holds(words: String): Bool {
  for w in words.split(" ") {
    if w.size == 0 {
      continue
    }
    eq = -1
    for i in 0..w.size {
      if eq < 0 && w[i] == 61 {
        eq = i
      }
    }
    if eq <= 0 {
      return false
    }
    if v = process.env(w[..eq]) {
      if v != w[eq + 1..] {
        return false
      }
    } else {
      return false
    }
  }
  true
}

// The length of the character XML 1.0 can carry that starts at byte i
// of s, or 0: tab, line feed, carriage return
// and UTF-8 characters from U+0020 on, except the surrogates, U+FFFE and
// U+FFFF. Every other byte (a control character such as a terminal
// colour's escape, a byte that is not UTF-8) is written as \xNN.
fn harness_xml_char_len(s: String, i: Int): Int {
  c = s[i]
  if c < 128 {
    if c >= 32 || c == 9 || c == 10 || c == 13 {
      return 1
    }
    return 0
  }
  n = 0
  lo = 128
  hi = 191
  if c >= 194 && c <= 223 {
    n = 2
  } else if c >= 224 && c <= 239 {
    n = 3
    if c == 224 {
      lo = 160
    } else if c == 237 {
      hi = 159
    }
  } else if c >= 240 && c <= 244 {
    n = 4
    if c == 240 {
      lo = 144
    } else if c == 244 {
      hi = 143
    }
  }
  if n == 0 || i + n > s.size {
    return 0
  }
  if s[i + 1] < lo || s[i + 1] > hi {
    return 0
  }
  for k in 2..n {
    if s[i + k] < 128 || s[i + k] > 191 {
      return 0
    }
  }
  if c == 239 && s[i + 1] == 191 && (s[i + 2] == 190 || s[i + 2] == 191) {
    return 0
  }
  n
}

pub class Checks {
  passed: Int = 0
  pub failed: Int = 0
  suites_ok: Int = 0
  suites_bad: Int = 0
  suite_name: String = ""
  suite_failed_at: Int = 0
  pub started: Int = 0
  case_at: Int = 0
  lines: Array(String) = []
  rec_suite: Array(String) = []
  rec_name: Array(String) = []
  rec_ok: Array(Int) = []
  rec_ms: Array(Int) = []
  rec_at: Int = 0

  fn record(okv: Bool, msg: String) {
    now = now_ms()
    dur = 0
    if self.rec_at > 0 {
      dur = (now - self.rec_at).to_i()
    }
    self.rec_at = now
    self.rec_suite.push(self.suite_name)
    self.rec_name.push(msg)
    if okv {
      self.rec_ok.push(1)
    } else {
      self.rec_ok.push(0)
    }
    self.rec_ms.push(dur)
  }

  fn flush_suite {
    if self.suite_name.size == 0 {
      return
    }
    nfail = self.failed - self.suite_failed_at
    if nfail == 0 {
      puts(" PASS  ${self.suite_name}")
      self.suites_ok += 1
    } else {
      puts(" FAIL  ${self.suite_name}")
      self.suites_bad += 1
    }
    i = 0
    while i < self.lines.size {
      puts(self.lines[i])
      i += 1
    }
    self.lines = []
    self.suite_name = ""
  }

  pub fn suite(name: String) {
    flush_suite()
    self.suite_name = name
    self.suite_failed_at = self.failed
    self.case_at = now_ms()
    self.rec_at = now_ms()
  }

  fn junit_escape(s: String): String {
    b = Buf.new()
    i = 0
    while i < s.size {
      c = s[i]
      n = harness_xml_char_len(s, i)
      if n == 0 {
        b.push_str("\\x")
        b.push_byte("0123456789abcdef"[c / 16])
        b.push_byte("0123456789abcdef"[c % 16])
      } else if n > 1 {
        b.push_slice(s, i, i + n)
        i += n - 1
      } else if c == 38 {
        b.push_str("&amp;")
      } else if c == 60 {
        b.push_str("&lt;")
      } else if c == 62 {
        b.push_str("&gt;")
      } else if c == 34 {
        b.push_str("&quot;")
      } else if c == 39 {
        b.push_str("&apos;")
      } else {
        b.push_byte(c)
      }
      i += 1
    }
    b.to_s()
  }

  fn junit_secs(ms: Int): String {
    whole = ms / 1000
    frac = ms % 1000
    fs = "${frac}"
    while fs.size < 3 {
      fs = "0${fs}"
    }
    "${whole}.${fs}"
  }

  fn write_junit {
    frag = ""
    if v = process.env("AVANT_JUNIT_FRAGMENT") {
      frag = v
    }
    if frag.size == 0 {
      return
    }
    if self.rec_name.size == 0 {
      return
    }
    b = Buf.new()
    i = 0
    while i < self.rec_name.size {
      suite = self.rec_suite[i]
      j = i
      n = 0
      badn = 0
      total = 0
      while j < self.rec_name.size && self.rec_suite[j] == suite {
        n += 1
        total += self.rec_ms[j]
        if self.rec_ok[j] == 0 {
          badn += 1
        }
        j += 1
      }
      b.push_str("<testsuite name=\"${junit_escape(suite)}\" tests=\"${n}\" failures=\"${badn}\" time=\"${junit_secs(total)}\">\n")
      for k in i..j {
        b.push_str("  <testcase name=\"${junit_escape(self.rec_name[k])}\" classname=\"${junit_escape(suite)}\" time=\"${junit_secs(self.rec_ms[k])}\"")
        if self.rec_ok[k] == 0 {
          b.push_str(">\n    <failure message=\"check failed\"/>\n  </testcase>\n")
        } else {
          b.push_str("/>\n")
        }
      }
      b.push_str("</testsuite>\n")
      i = j
    }
    _ = fs.write(frag, b.to_s())
  }

  pub fn expect(cond: Bool, msg: String) {
    record(cond, msg)
    if cond {
      self.passed += 1
      self.lines.push("    ✓ ${msg}")
    } else {
      self.failed += 1
      harness_rt.avant_test_fail()
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
    }
  }

  // A check not run, and why (it is neither passed nor failed, and the
  // JUnit report does not list it). Only an outer GC environment skips a
  // check (gc_env_outer); the default suite skips none.
  pub fn skip(msg: String, why: String) {
    self.lines.push("    ○ ${msg} (skipped: ${why})")
  }

  // A file the test writes: passes when file_write
  // succeeded; a failure shows its IoError.
  pub fn wrote(r: Int | IoError, msg: String) {
    switch r {
      case Int { self.expect(true, msg) }
      case e: IoError {
        self.expect(false, msg)
        self.lines.push("    ${e}")
        self.lines.push("")
      }
    }
  }

  pub fn eq_int(got: Int, want: Int, msg: String) {
    record(got == want, msg)
    if got == want {
      self.passed += 1
      self.lines.push("    ✓ ${msg}")
    } else {
      self.failed += 1
      harness_rt.avant_test_fail()
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
      self.lines.push("    got ${got}, want ${want}")
      self.lines.push("")
    }
  }

  pub fn eq_str(got: String, want: String, msg: String) {
    record(got == want, msg)
    if got == want {
      self.passed += 1
      self.lines.push("    ✓ ${msg}")
    } else {
      self.failed += 1
      harness_rt.avant_test_fail()
      self.lines.push("    ✕ ${msg}")
      self.lines.push("")
      self.lines.push("  ● ${self.suite_name} › ${msg}")
      self.lines.push("")
      self.lines.push("    got ${got}, want ${want}")
      self.lines.push("")
    }
  }

  pub fn finish: Int {
    flush_suite()
    write_junit()
    ms = now_ms() - self.started
    puts("")
    puts("Test Suites: ${fmt_counts(self.suites_bad, self.suites_ok)}")
    puts("Tests:       ${fmt_counts(self.failed, self.passed)}")
    puts("Time:        ${ms} ms")
    puts("Ran all test suites.")
    if self.failed != 0 {
      return 1
    }
    if self.suites_bad != 0 {
      return 1
    }
    0
  }
}

pub fn empty_strs: Array(String) {
  a: Array(String) = []
  a
}

