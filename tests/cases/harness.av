import std.fs
import std.process

fn fmt_counts(bad: Int, ok: Int): String {
  total = bad + ok
  if bad == 0 {
    return "${ok} passed, ${total} total"
  }
  if ok == 0 {
    return "${bad} failed, ${total} total"
  }
  "${bad} failed, ${ok} passed, ${total} total"
}

pub fn nth_line(s: String, n: Int): String {
  start = 0
  i = 0
  line = 0
  while i < s.size {
    if s[i] == 10 {
      if line == n {
        return s[start..i]
      }
      line += 1
      start = i + 1
    }
    i += 1
  }
  if line == n {
    return s[start..]
  }
  ""
}

pub fn count_lines(s: String): Int {
  n = 0
  for i in 0..s.size {
    if s[i] == 10 {
      n += 1
    }
  }
  n
}

