fn test_oracle(c: Checks) {
  c.suite("tests/cases/oracle.av")
  root = avant_test_root()
  c.expect(file_exists("${root}/src/cli.cr"), "recovery src/cli.cr")
  c.expect(file_exists("${root}/src/avant.cr"), "recovery src/avant.cr")
  c.expect(file_exists("${root}/src/avant/compiler.cr"), "recovery host compiler")
  c.expect(file_exists("${root}/compiler/main.av"), "identity compiler/main.av")
  c.expect(file_exists("${root}/compiler/lex_dump.av"), "identity lex_dump.av")
  c.expect(file_exists("${root}/tests/goldens/hello.myc"), "dump golden hello.myc")

  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    hello = "${root}/examples/hello.av"
    golden = "${root}/tests/goldens/hello.myc"
    hlog = "/tmp/avant-s16-${stamp}-hello.log"
    dump_path = "/tmp/avant-s16-${stamp}-hello.myc"

    hcode = run_av_cmd(compiler, hello, hlog)
    c.eq_int(hcode, 0, "identity runs hello")
    if hout = file_read(hlog) {
      c.eq_str(hout, "Hello Avant\n", "identity hello stdout")
    } else {
      c.expect(false, "read identity hello stdout")
    }

    dcode = dump_av(compiler, hello, dump_path)
    c.eq_int(dcode, 0, "identity dumps hello")
    if got = file_read(dump_path) {
      if want = file_read(golden) {
        c.eq_str(got, want, "identity dump matches golden")
      } else {
        c.expect(false, "read golden hello.myc")
      }
    } else {
      c.expect(false, "read identity hello dump")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}
