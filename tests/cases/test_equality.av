import harness
import backends
import std.fs
import std.process

// Equality and printing, the derived clone, entry points that fail, type names. Each program is
// compiled in parallel; a refused one must leave no binary, say the
// expected words and point at the expected line and column; an accepted
// one must print what it should. The programs that run at length
// (tests/fixtures/equality/) are checked by the run goldens in every
// collector mode; this file holds the rules' refusals, their accepted
// neighbours, and checks on the generated code:
//   - a program that compares and prints only scalars carries none of the
//     functions the checker writes for ==, and its integer puts is the
//     runtime's (avant_puts_i64), never printf;
//   - a struct's derived == is written once however often it is used;
//   - has and index_of of scalar elements call the runtime's search,
//     with no loop written through ==.

class RCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  pub ok: Bool = false
  pub status: Int = 0
  pub err: String = ""
}

fn refused(tag: String, src: String, needle: String, pos: String): RCase {
  f = RCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f
}

fn accepted(tag: String, src: String, out: String): RCase {
  f = RCase.new()
  f.tag = tag
  f.src = src
  f.want = out
  f.ok = true
  f
}

// An accepted program that exits with status and writes err to stderr.
fn exits(tag: String, src: String, out: String, status: Int, err: String): RCase {
  f = accepted(tag, src, out)
  f.status = status
  f.err = err
  f
}

fn cases: Array(RCase) {
  xs: Array(RCase) = []
  // == and the order
  pt = "struct P {\n  x: Int\n  y: Int\n}\n"
  xs.push(accepted("struct-eq", "${pt}fn main {\n  a = P { x: 1, y: 2 }\n  puts(a == P { x: 1, y: 2 })\n  puts(a != P { x: 1, y: 3 })\n}\n", "true\ntrue\n"))
  xs.push(accepted("struct-hash-field", "struct Bag {\n  n: Int\n  h: Hash(String, Int)\n}\nfn main {\n  a = Bag { n: 1, h: Hash(String, Int).new() }\n  puts(a == a)\n}\n", "true\n"))
  xs.push(refused("struct-fn-field", "struct Cb {\n  f: fn(Int): Int\n}\nfn same(n: Int): Int {\n  n\n}\nfn main {\n  c = Cb { f: same }\n  puts(c == c)\n}\n", "cannot compare Cb: fn(Int): Int (the field Cb.f) has no ==; define fn equals(other: Cb): Bool on Cb", "9:10"))
  xs.push(refused("struct-other-type", "${pt}fn main {\n  a = P { x: 1, y: 2 }\n  puts(a == 1)\n}\n", "cannot compare P with Int: == compares two values of one type", "7:10"))
  xs.push(refused("struct-no-order", "${pt}fn main {\n  a = P { x: 1, y: 2 }\n  puts(a < a)\n}\n", "P has no order: define fn compare(other: P): Int on it (negative, zero or positive: <, <=, >, >=, sort, min and max use it)", "7:10"))
  xs.push(refused("user-not-eq", "struct M {\n  c: Int\n  fn !=(o: M): Bool { c != o.c }\n}\nfn main { }\n", "!= is always !(a == b): define == only", "3:3"))
  xs.push(accepted("derived-order", "struct M {\n  c: Int\n  fn compare(o: M): Int { c - o.c }\n}\nfn main {\n  a = M { c: 1 }\n  b = M { c: 2 }\n  puts(\"\${a < b} \${a > b} \${a <= b} \${a >= b} \${b <= b} \${b >= b}\")\n}\n", "true false true false true true\n"))
  xs.push(accepted("class-identity", "class C {\n  n: Int = 0\n}\nfn main {\n  a = C.new()\n  b = C.new()\n  c = a\n  puts(\"\${a == b} \${a == c} \${a != b}\")\n}\n", "false true true\n"))
  xs.push(accepted("array-eq", "fn main {\n  puts([1, 2] == [1, 2])\n  puts([1, 2] != [2, 1])\n  puts([\"a\"] == [\"b\"])\n  puts([[1], [2]] == [[1], [2]])\n  puts([0.0 / 0.0] == [0.0 / 0.0])\n}\n", "true\ntrue\nfalse\ntrue\nfalse\n"))
  xs.push(accepted("array-hash-elems", "fn main {\n  a = [Hash(String, Int).new()]\n  puts(a == a)\n}\n", "true\n"))
  xs.push(refused("array-order", "fn main {\n  puts([1] < [2])\n}\n", "Array(Int) has no order: <, <=, > and >= compare numbers and Strings", "2:12"))
  xs.push(accepted("optional-eq", "fn main {\n  a: Int? = 1\n  b: Int? = 1\n  n: Int? = nil\n  puts(\"\${a == b} \${a == n} \${n == n} \${n != a}\")\n}\n", "true false true true\n"))
  xs.push(refused("optional-with-value", "fn main {\n  a: Int? = 1\n  puts(a == 1)\n}\n", "cannot compare Int? with Int: == compares two values of one type; open it with", "3:10"))
  xs.push(refused("optional-with-nil", "fn main {\n  a: Int? = 1\n  puts(a == nil)\n}\n", "a is Int? and an optional is never compared with nil", "3:10"))
  xs.push(refused("union-eq", "fn f(n: Int): Int | String {\n  if n > 0 {\n    return n\n  }\n  \"x\"\n}\nfn main {\n  puts(f(1) == f(2))\n}\n", "Int | String has no ==: take it apart with switch and compare its members", "8:13"))
  xs.push(accepted("hash-eq", "fn main {\n  h = Hash(String, Int).new()\n  puts(h == h)\n}\n", "true\n"))
  xs.push(refused("string-int", "fn main {\n  puts(\"a\" == 1)\n}\n", "cannot compare String with Int: == compares two values of one type", "2:12"))
  // An integer and a Float64 neither compare nor mix: the conversion is written
  xs.push(refused("int-float-eq", "fn main {\n  n = 3\n  x = 3.0\n  puts(n == x)\n}\n", "cannot compare Int with Float64: == compares two values of one type; convert one side: n.to_f, or x.to_i (which truncates)", "4:10"))
  xs.push(refused("float-int-less", "fn main {\n  n = 3\n  x = 2.5\n  puts(x < n)\n}\n", "cannot compare Float64 with Int: < compares two values of one type; convert one side: n.to_f, or x.to_i (which truncates)", "4:10"))
  xs.push(refused("float-int-times", "fn main {\n  x = 1.5\n  n = 2\n  puts(x * n)\n}\n", "binary operator expects matching types, got Float64 and Int: an integer and a Float64 do not mix; convert one side: n.to_f, or x.to_i (which truncates)", "4:10"))
  xs.push(refused("int32-float-plus", "fn main {\n  w: Int32 = 2\n  x = 1.5\n  puts(w + x)\n}\n", "binary operator expects matching types, got Int32 and Float64: an integer and a Float64 do not mix; convert one side: w.to_f, or x.to_i.to_i32 (which truncates)", "4:10"))
  xs.push(refused("float-literal-int", "fn main {\n  n = 2\n  puts(2.5 * n)\n}\n", "binary operator expects matching types, got Float64 and Int", "3:12"))
  xs.push(accepted("int-float-converted", "fn main {\n  n = 3\n  x = 2.5\n  w: Int32 = 2\n  puts(n.to_f() * x)\n  puts(n == x.to_i())\n  puts(x == 2)\n  puts(1 + 2.5)\n  puts(w + x.to_i().to_i32())\n}\n", "7.5\nfalse\nfalse\n3.5\n4\n"))
  xs.push(refused("bool-int", "fn main {\n  puts(true == 1)\n}\n", "cannot compare Bool with Int: == compares two values of one type", "2:13"))
  xs.push(accepted("eq-witness", "interface Eq(T) {\n  fn equals(other: T): Bool\n}\nstruct Id: Eq(Id) {\n  n: Int\n}\nfn same(a: T, b: T: Eq(T)): Bool {\n  a == b\n}\nfn main {\n  puts(same(Id { n: 1 }, Id { n: 1 }))\n  puts(same(Id { n: 1 }, Id { n: 2 }))\n}\n", "true\nfalse\n"))
  xs.push(accepted("eq-witness-missing", "interface Eq(T) {\n  fn equals(other: T): Bool\n}\nstruct Bag: Eq(Bag) {\n  h: Hash(String, Int)\n}\nfn main { }\n", ""))
  xs.push(accepted("equals-compare", "struct Ver {\n  major: Int\n  minor: Int\n\n  fn equals(other: Ver): Bool {\n    major == other.major && minor == other.minor\n  }\n\n  fn hash(h: Hasher) {\n    h.add(major)\n    h.add(minor)\n  }\n\n  fn compare(other: Ver): Int {\n    if major != other.major {\n      return major - other.major\n    }\n    minor - other.minor\n  }\n}\nfn main {\n  a = Ver { major: 1, minor: 2 }\n  b = Ver { major: 1, minor: 10 }\n  puts(\"\${a == b} \${a != b} \${a.equals(Ver { major: 1, minor: 2 })} \${a.compare(b) < 0}\")\n  puts(\"\${a < b} \${a <= b} \${a > b} \${a >= b} \${b >= b}\")\n  vs = [b, a, Ver { major: 0, minor: 9 }]\n  vs.sort()\n  lo = vs.min() ?? a\n  hi = vs.max() ?? a\n  puts(\"\${vs[0].minor} \${vs[2].minor} \${lo.minor} \${hi.minor} \${vs.has(a)} \${vs.index_of(b) ?? -1}\")\n}\n", "false true true true\ntrue true false false true\n9 10 9 10 true 2\n"))
  xs.push(accepted("ordered-bound", "interface Ordered(T) {\n  fn compare(other: T): Int\n}\ninterface Eq(T) {\n  fn equals(other: T): Bool\n}\nstruct M: Ordered(M) + Eq(M) {\n  c: Int\n\n  fn compare(o: M): Int {\n    c - o.c\n  }\n}\nfn least(xs: Array(T), seed: T: Ordered(T)): T {\n  m = seed\n  for x in xs {\n    if x < m {\n      m = x\n    }\n  }\n  m\n}\nfn count_of(xs: Array(T), w: T: Eq(T)): Int {\n  n = 0\n  for x in xs {\n    if x == w {\n      n += 1\n    }\n  }\n  n\n}\nfn main {\n  ms = [M { c: 4 }, M { c: 2 }, M { c: 4 }]\n  puts(\"\${least(ms, M { c: 9 }).c} \${count_of(ms, M { c: 4 })}\")\n}\n", "2 2\n"))
  xs.push(accepted("min-max-sort", "struct M {\n  c: Int\n  fn compare(o: M): Int { c - o.c }\n}\nfn main {\n  ms = [M { c: 3 }, M { c: 1 }, M { c: 2 }]\n  lo = ms.min() ?? M { c: 0 }\n  hi = ms.max() ?? M { c: 0 }\n  s = ms.sorted()\n  ms.sort()\n  puts(\"\${lo.c} \${hi.c} \${s[0].c}\${s[1].c}\${s[2].c} \${ms[0].c}\${ms[2].c}\")\n}\n", "1 3 123 13\n"))
  // contains and index_of compare by the element's ==
  xs.push(accepted("contains-by-eq", "struct P {\n  x: Int\n  y: Int\n}\n\nclass Name {\n  pub s: String\n\n  fn initialize(s: String) {\n    self.s = s\n  }\n\n  fn equals(o: Name): Bool {\n    s == o.s\n  }\n\n  fn hash(h: Hasher) {\n    h.add(s)\n  }\n}\n\nenum Tok { a, b, c }\n\nfn main {\n  ps = [P { x: 1, y: 2 }, P { x: 3, y: 4 }]\n  puts(\"\${ps.has(P { x: 3, y: 4 })} \${ps.has(P { x: 4, y: 3 })} \${ps.index_of(P { x: 3, y: 4 }) ?? -1}\")\n  ns = [Name.new(\"ada\"), Name.new(\"bo\")]\n  puts(\"\${ns.has(Name.new(\"bo\"))} \${ns.index_of(Name.new(\"cy\")) ?? -1}\")\n  grid = [[1, 2], [3]]\n  puts(\"\${grid.has([3])} \${grid.index_of([1, 2]) ?? -1}\")\n  opts: Array(Int?) = [nil, 5]\n  puts(\"\${opts.has(5)} \${opts.index_of(nil) ?? -1}\")\n  ts = [Tok.c, Tok.a]\n  puts(\"\${ts.has(Tok.a)} \${ts.has(Tok.b)} \${ts.index_of(Tok.a) ?? -1}\")\n  bs = [\"ab\".bytes, \"cd\".bytes]\n  puts(\"\${bs.has(\"cd\".bytes)} \${bs.index_of(\"ab\".bytes) ?? -1}\")\n  fs = [1.5, 0.0 / 0.0]\n  puts(\"\${fs.has(1.5)} \${fs.has(0.0 / 0.0)}\")\n}\n", "true false 1\ntrue -1\ntrue 0\ntrue 0\ntrue false 1\ntrue 0\ntrue false\n"))
  xs.push(accepted("contains-hash", "fn main {\n  hs = [Hash(String, Int).new()]\n  puts(hs.has(Hash(String, Int).new()))\n}\n", "true\n"))
  xs.push(accepted("index-of-struct-hash-field", "struct Bag {\n  h: Hash(String, Int)\n}\nfn main {\n  bs = [Bag { h: Hash(String, Int).new() }]\n  puts(bs.index_of(bs[0]) ?? -1)\n}\n", "0\n"))
  xs.push(refused("contains-buf", "fn main {\n  bs = [Buf.new()]\n  puts(bs.has(bs[0]))\n}\n", "has compares the elements with ==: Buf has no ==", "3:10"))
  // String order
  xs.push(accepted("string-order", "fn main {\n  puts(\"\${\"a\" < \"b\"} \${\"b\" < \"a\"} \${\"ab\" < \"abc\"} \${\"abc\" <= \"abc\"} \${\"B\" < \"a\"} \${\"z\" >= \"a\"} \${\"\" < \"a\"}\")\n}\n", "true false true true true true true\n"))
  xs.push(refused("string-minus", "fn main {\n  puts(\"a\" - \"b\")\n}\n", "unsupported operator on String (+ joins two Strings; ==, !=, <, <=, > and >= compare them)", "2:12"))
  // Printing
  xs.push(accepted("to-s", "fn main {\n  n: Int32 = -5\n  u: UInt64 = 18446744073709551615u64\n  puts(3.to_s() + n.to_s() + u.to_s() + 2.5.to_s() + true.to_s() + \"s\".to_s())\n}\n", "3-5184467440737095516152.5trues\n"))
  xs.push(refused("to-s-args", "fn main {\n  puts(3.to_s(2, 8))\n}\n", "Int.to_s takes no arguments, or one base (n.to_s(16))", "2:9"))
  xs.push(refused("to-s-args-float", "fn main {\n  puts(3.5.to_s(2))\n}\n", "Float64.to_s takes no arguments", "2:11"))
  xs.push(accepted("union-text", "class Oops: Error {\n  message: String\n  fn initialize(message: String) {\n    self.message = message\n  }\n}\nfn f(n: Int): Int | String | Oops {\n  if n == 0 {\n    return 5\n  }\n  if n == 1 {\n    return \"five\"\n  }\n  Oops.new(\"no\")\n}\nfn main {\n  puts(\"\${f(0)} \${f(1)} \${f(2)}\")\n}\n", "5 five no\n"))
  xs.push(refused("union-text-struct", "${pt}fn f(n: Int): Int | P {\n  if n > 0 {\n    return n\n  }\n  P { x: 1, y: 2 }\n}\nfn main {\n  puts(\"\${f(1)}\")\n}\n", "cannot interpolate Int | P: its member P has no text", "12:11"))
  xs.push(refused("optional-text", "fn main {\n  a: Int? = 1\n  puts(\"\${a}\")\n}\n", "cannot interpolate Int?: it holds nil; open it with `if v = a`", "3:11"))
  // fn main returning a failure
  oops = "class Oops: Error {\n  message: String\n  fn initialize(message: String) {\n    self.message = message\n  }\n}\nfn check(n: Int): Int | Oops {\n  if n > 1 {\n    return Oops.new(\"big \${n}\")\n  }\n  n\n}\n"
  xs.push(exits("main-void-fails", "${oops}fn main: Void | Oops {\n  puts(check(1)?)\n  puts(check(2)?)\n}\n", "1\n", 1, "big 2\n"))
  xs.push(exits("main-void-ok", "${oops}fn main: Void | Oops {\n  puts(check(0)?)\n  if check(1)? == 1 {\n    return\n  }\n  puts(9)\n}\n", "0\n", 0, ""))
  xs.push(exits("main-int-fails", "${oops}fn main: Int | Oops {\n  check(5)?\n}\n", "", 1, "big 5\n"))
  xs.push(exits("main-int-ok", "${oops}fn main: Int | Oops {\n  check(1)? + 2\n}\n", "", 3, ""))
  xs.push(exits("run-void-fails", "${oops}fn run: Void | Oops {\n  puts(check(3)?)\n}\n", "", 1, "big 3\n"))
  xs.push(refused("main-string-oops", "${oops}fn main: String | Oops {\n  \"x\"\n}\n", "fn main returns String | Oops; an entry point returns nothing, an Int (the process status), or either with failures marked Error (Void | E, Int | E)", "13:10"))
  xs.push(refused("main-not-error", "${pt}fn main: Void | P {\n}\n", "fn main returns Void | P; an entry point returns nothing, an Int (the process status), or either with failures marked Error (Void | E, Int | E): P is not marked Error", "5:17"))
  xs.push(refused("main-string", "fn main: String {\n  \"x\"\n}\n", "fn main returns String; an entry point returns nothing", "1:1"))
  xs.push(refused("main-void-nil", "${oops}fn main: Void | Oops {\n  a: Int? = nil\n  puts(a?)\n}\n", "postfix ? would return nil, but the function returns Void | Oops, which holds no nil; handle the nil with if-assign or ??", "15:9"))
  // nil typed by the other branches
  vt = "struct V {\n  x: Int\n}\n"
  xs.push(accepted("nil-if-join", "${vt}fn pick(n: Int): Int {\n  v = if n > 0 { V { x: n } } else { nil }\n  if got = v {\n    return got.x\n  }\n  -1\n}\nfn main {\n  puts(pick(4))\n  puts(pick(0))\n}\n", "4\n-1\n"))
  xs.push(accepted("nil-switch-join", "${vt}fn pick(n: Int): Int {\n  v = switch n {\n    case 0 { nil }\n    case 1 { V { x: 10 } }\n    else { nil }\n  }\n  if got = v {\n    return got.x\n  }\n  -1\n}\nfn main {\n  puts(pick(1))\n  puts(pick(2))\n}\n", "10\n-1\n"))
  xs.push(refused("nil-if-two-types", "fn main {\n  n = 1\n  v = if n > 0 { 1 } else if n < 0 { \"x\" } else { nil }\n}\n", "if branches have different types", "3:7"))
  // An enum's from_i with a value computed from a constant
  xs.push(accepted("from-i-const", "const base = 10\nenum S { a = base, b, c = 3 }\nfn main {\n  puts(S.from_i(11) ?? S.c)\n  puts(S.from_i(3) ?? S.a)\n  puts(S.from_i(0) ?? S.c)\n}\n", "b\nc\nc\n"))
  // clone: the derived deep copy, its refusals by field, and no clone of a type's own
  xs.push(refused("clone-fn-field", "class Cb {\n  f: fn(Int): Int\n  fn initialize(self.f) {\n  }\n}\nfn same(n: Int): Int {\n  n\n}\nfn main {\n  c = Cb.new(same)\n  d = c.clone()\n}\n", "cannot clone Cb: a function value (Cb.f) may capture mutable state, which the copy would share", "11:8"))
  xs.push(refused("clone-join-elem", "class Job {\n  h: JoinHandle(Int)?\n}\nfn main {\n  j = Job.new()\n  k = [j].clone()\n}\n", "cannot clone Array(Job): a JoinHandle (Job.h) is one task's result, waited for once", "6:10"))
  xs.push(refused("clone-union", "class Box {\n  n: Int = 0\n}\nclass Holder {\n  v: Int | Box = 0\n}\nfn main {\n  h = Holder.new()\n  g = h.clone()\n}\n", "cannot clone Holder: a union of several types that holds something to copy (Holder.v), Box | Int, is not copied yet", "9:8"))
  xs.push(refused("clone-buf", "class W {\n  b: Buf = buf_new()\n}\nfn main {\n  w = W.new()\n  x = w.clone()\n}\n", "cannot clone W: a Buf (W.b) is not copied yet", "6:8"))
  xs.push(refused("clone-own", "class C {\n  n: Int = 0\n\n  fn clone: C {\n    self\n  }\n}\nfn main { }\n", "clone is derived for every type, a deep copy that shares nothing mutable with the original: a method cannot replace it; give the method another name", "4:3"))
  xs.push(refused("clone-own-external", "struct P {\n  x: Int\n}\nfn (p: P) clone: P {\n  p\n}\nfn main { }\n", "clone is derived for every type", "4:1"))
  xs.push(refused("clone-argument", "class C {\n  n: Int = 0\n}\nfn main {\n  c = C.new()\n  d = c.clone(1)\n}\n", "clone takes no arguments", "6:8"))
  xs.push(refused("class-literal", "class C {\n  n: Int = 0\n}\nfn main {\n  c = C { n: 1 }\n}\n", "classes are constructed with C.new, not C { }", "5:7"))
  xs.push(accepted("clone-plain", "struct S {\n  n: Int\n  s: String\n}\nfn main {\n  x = 5.clone()\n  s = \"a\".clone()\n  p = S { n: 1, s: \"x\" }.clone()\n  o: Int? = 3\n  puts(\"\${x} \${s} \${p.n} \${o.clone() ?? 0}\")\n}\n", "5 a 1 3\n"))
  xs.push(accepted("clone-generic-class", "class Pair(T) {\n  a: T\n  b: Array(T) = []\n  fn initialize(self.a) {\n  }\n}\nfn main {\n  p = Pair(Int).new(1)\n  p.b.push(2)\n  q = p.clone()\n  q.b.push(3)\n  puts(\"\${p.b.size} \${q.b.size} \${q.a}\")\n}\n", "1 2 1\n"))
  // Type names
  xs.push(refused("struct-lower", "struct value {\n  n: Int\n}\nfn main { }\n", "the name of struct value is a type name, written with a capital first letter: write Value", "1:1"))
  xs.push(refused("class-lower", "class http_req {\n  n: Int = 0\n}\nfn main { }\n", "the name of class http_req is a type name, written with a capital first letter: write HttpReq", "1:1"))
  xs.push(refused("interface-lower", "interface shape {\n  fn area: Int\n}\nfn main { }\n", "the name of interface shape is a type name, written with a capital first letter: write Shape", "1:1"))
  xs.push(refused("layout-lower", "lib c {\n  struct timespec {\n    s: Int\n  }\n}\nfn main { }\n", "the name of C layout timespec is a type name, written with a capital first letter: write Timespec", "2:3"))
  xs.push(refused("enum-lower", "enum tok_kind { a }\nfn main { }\n", "an enum's name is a type name, written with a capital first letter: write TokKind", "1:6"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(RCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/eq-${f.tag}.av"
    _ = fs.write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/eq-${f.tag}.bin", "${dir}/eq-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job(dir, "eq-${f2.tag}.bin", "eq-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/eq-${f3.tag}.log")
    if f3.ok {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.eq_int(runs[k].code, f3.status, "${f3.tag}: exit ${f3.status}")
      c.eq_str(log_text("${dir}/eq-${f3.tag}.run.out"), f3.want, "${f3.tag}: stdout")
      c.eq_str(log_text("${dir}/eq-${f3.tag}.run.err"), f3.err, "${f3.tag}: stderr")
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !fs.exists("${dir}/eq-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(log.contains(f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(log.contains("eq-${f3.tag}.av:${f3.pos}\n"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

// The generated code: nothing written for == unless asked; integer puts
// through the runtime; a derived == written once.
fn check_ll(c: Checks, compiler: String, dir: String) {
  plain = "${dir}/eq-ll-plain.av"
  _ = fs.write(plain, "fn main {\n  n = 3\n  puts(n == 3)\n  puts(n)\n  w: Int32 = 2\n  puts(w)\n  puts(\"a\" == \"b\")\n}\n")
  c.eq_int(emit_ll(compiler, plain, "${dir}/eq-ll-plain.ll", "${dir}/eq-ll-plain.log"), 0, "ll-plain: emits")
  ll = log_text("${dir}/eq-ll-plain.ll")
  c.expect(!ll.contains("__avant_eq"), "ll-plain: no written ==")
  c.expect(ll.contains("@avant_puts_i64("), "ll-plain: an integer's puts is the runtime's")
  c.expect(!ll.contains("@printf("), "ll-plain: no printf")
  twice = "${dir}/eq-ll-twice.av"
  _ = fs.write(twice, "struct P {\n  x: Int\n}\nfn main {\n  a = P { x: 1 }\n  puts(a == a)\n  puts(a != a)\n  puts([a] == [a])\n}\n")
  c.eq_int(emit_ll(compiler, twice, "${dir}/eq-ll-twice.ll", "${dir}/eq-ll-twice.log"), 0, "ll-twice: emits")
  ll2 = log_text("${dir}/eq-ll-twice.ll")
  defs = 0
  for line in ll2.split("\n") {
    if line.contains("define ") && line.contains("P.==") {
      defs += 1
    }
  }
  c.eq_int(defs, 1, "ll-twice: one derived == for P")
  scal = "${dir}/eq-ll-search.av"
  _ = fs.write(scal, "fn main {\n  xs = [1, 2]\n  ss = [\"a\"]\n  puts(xs.has(2))\n  puts(ss.index_of(\"a\") ?? -1)\n}\n")
  c.eq_int(emit_ll(compiler, scal, "${dir}/eq-ll-search.ll", "${dir}/eq-ll-search.log"), 0, "ll-search: emits")
  ll3 = log_text("${dir}/eq-ll-search.ll")
  c.expect(ll3.contains("@avant_array_contains_i64(") && ll3.contains("@avant_array_index_str("), "ll-search: scalars keep the runtime's search")
  c.expect(!ll3.contains("__avant_contains") && !ll3.contains("__avant_index_of"), "ll-search: no loop written for scalars")
  // clone: nothing written for a program that clones nothing; a class's
  // derived clone written once however often it is cloned; an array of
  // numbers copied by the runtime's buffer copy, with no loop written.
  c.expect(!ll.contains("clone"), "ll-plain: no clone written")
  cl = "${dir}/eq-ll-clone.av"
  _ = fs.write(cl, "class Box {\n  n: Int = 0\n  xs: Array(Int) = []\n}\nfn main {\n  b = Box.new()\n  c = b.clone()\n  d = c.clone()\n  e = [b].clone()\n  puts(d.xs.size + e.size)\n}\n")
  c.eq_int(emit_ll(compiler, cl, "${dir}/eq-ll-clone.ll", "${dir}/eq-ll-clone.log"), 0, "ll-clone: emits")
  ll4 = log_text("${dir}/eq-ll-clone.ll")
  cdefs = 0
  for line in ll4.split("\n") {
    if line.contains("define ") && line.contains("Box.clone") {
      cdefs += 1
    }
  }
  c.eq_int(cdefs, 1, "ll-clone: one derived clone for Box")
  c.expect(ll4.contains("@avant_array_copy("), "ll-clone: an Array(Int) field is copied by the runtime")
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_equality.av")
  if compiler = process.env("AVANT_COMPILER") {
    run_cases(c, compiler, scratch_dir(), cases())
    check_ll(c, compiler, scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
