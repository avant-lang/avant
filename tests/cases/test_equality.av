import harness
import backends

// Equality and printing, entry points that fail, type names. Each program is
// compiled in parallel; a refused one must leave no binary, say the
// expected words and point at the expected line and column; an accepted
// one must print what it should. The programs that run at length
// (tests/fixtures/equality/) are checked by the run goldens in every
// collector mode; this file holds the rules' refusals, their accepted
// neighbours, and checks on the generated code:
//   - a program that compares only scalars carries none of the functions
//     the checker writes for ==;
//   - a struct's derived == is written once however often it is used.

class RCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  pub ok: Bool = false
  pub status: Int = 0
  pub err: String = ""
}

fn refused(tag: String, src: String, needle: String, pos: String): RCase {
  f = RCase.new
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f
}

fn accepted(tag: String, src: String, out: String): RCase {
  f = RCase.new
  f.tag = tag
  f.src = src
  f.want = out
  f.ok = true
  f
}

// An accepted program that exits with status and writes err to stderr.
fn exits(tag: String, src: String, out: String, status: Int, err: String): RCase {
  f = accepted(tag, src, out)
  f.status = status
  f.err = err
  f
}

fn cases: Array(RCase) {
  xs: Array(RCase) = []
  // Type names
  xs.push(refused("struct-lower", "struct value {\n  n: Int\n}\nfn main { }\n", "the name of struct value is a type name, written with a capital first letter: write Value", "1:1"))
  xs.push(refused("class-lower", "class http_req {\n  n: Int = 0\n}\nfn main { }\n", "the name of class http_req is a type name, written with a capital first letter: write HttpReq", "1:1"))
  xs.push(refused("interface-lower", "interface shape {\n  fn area: Int\n}\nfn main { }\n", "the name of interface shape is a type name, written with a capital first letter: write Shape", "1:1"))
  xs.push(refused("layout-lower", "lib c {\n  struct timespec {\n    s: Int\n  }\n}\nfn main { }\n", "the name of C layout timespec is a type name, written with a capital first letter: write Timespec", "2:3"))
  xs.push(refused("enum-lower", "enum tok_kind { a }\nfn main { }\n", "an enum's name is a type name, written with a capital first letter: write TokKind", "1:6"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(RCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/eq-${f.tag}.av"
    _ = file_write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/eq-${f.tag}.bin", "${dir}/eq-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job(dir, "eq-${f2.tag}.bin", "eq-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/eq-${f3.tag}.log")
    if f3.ok {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.eq_int(runs[k].code, f3.status, "${f3.tag}: exit ${f3.status}")
      c.eq_str(log_text("${dir}/eq-${f3.tag}.run.out"), f3.want, "${f3.tag}: stdout")
      c.eq_str(log_text("${dir}/eq-${f3.tag}.run.err"), f3.err, "${f3.tag}: stderr")
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !file_exists("${dir}/eq-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(str_has(log, f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(str_has(log, "eq-${f3.tag}.av:${f3.pos}\n"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_equality.av")
  if compiler = env_get("AVANT_COMPILER") {
    run_cases(c, compiler, scratch_dir(), cases())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
