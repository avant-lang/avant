import harness
import backends

// Stage 29 W4b2: honest defaults for processes, files, the exit status,
// the C boundary, traps and library errors (D295; review 4's R11, R12,
// R14-R16). Generated by the record's scripts/gen_system.py. Each program
// is compiled in parallel; a refused one must leave no binary and say the
// expected words, an accepted one must print what it should and exit with
// its status, and a trapping one must print what it printed before the
// trap, exit 1 and name the trap on stderr.
//   - file_read, file_write and dir_list give their result or an IoError; process_run and process_run_out the exit status or a ProcessError, with PATH lookup (R12)
//   - main's (or run's) Int result outside 0..255 traps; inside it is the exit status (R14)
//   - a C function declared : String that returns NULL traps naming it; String? reads NULL as nil (R15)
//   - every trap the compiler raises names its site (file:line:col), flushes stdout first, names its operation and type, and exits 1 (R16)
//   - JsonBuilder misuse and a closed Regex trap saying what failed; Json.parse and Regex.compile errors carry the library's reason and offset (R11)

class SCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub err: String = ""
  pub ok: Bool = false
  pub trap: Bool = false
  pub code: Int = 0
}

fn refused(tag: String, src: String, needle: String): SCase {
  f = SCase.new
  f.tag = tag
  f.src = src
  f.want = needle
  f
}

fn accepted(tag: String, src: String, out: String): SCase {
  f = SCase.new
  f.tag = tag
  f.src = src
  f.want = out
  f.ok = true
  f
}

fn exited(tag: String, src: String, out: String, code: Int, needle: String): SCase {
  f = accepted(tag, src, out)
  f.code = code
  f.err = needle
  f
}

fn trapped(tag: String, src: String, out: String, needle: String): SCase {
  f = exited(tag, src, out, 1, needle)
  f.trap = true
  f
}

fn io_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(accepted("io-read", "fn main {\n  if t = file_read(\"no-such-file.txt\") {\n    puts(t)\n  } else {\n    puts(\"absent\")\n  }\n  puts(file_read(\"/\") ?? \"a directory\")\n  _ = file_write(\"io-read.txt\", \"abc\")\n  puts(file_read(\"io-read.txt\") ?? \"?\")\n}\n", "absent\na directory\nabc\n"))
  xs.push(accepted("io-write", "fn io_failure(r: Int | IoError): IoError? {\n  _ = r?\n  nil\n}\n\nfn list_failure(r: Array(String) | IoError): IoError? {\n  _ = r?\n  nil\n}\n\nfn run_failure(r: Int | ProcessError): ProcessError? {\n  _ = r?\n  nil\n}\n\nfn show_run(r: Int | ProcessError) {\n  if n = r {\n    puts(\"exit \${n}\")\n  } else if e = run_failure(r) {\n    puts(\"errno \${e.errno} signal \${e.signal} output [\${e.output}]: \${e}\")\n  }\n}\n\nfn main {\n  r = file_write(\"no/such/dir/x.txt\", \"hi\")\n  if e = io_failure(r) {\n    puts(\"\${e.op} \${e.path} \${e.errno}\")\n    puts(\"\${e}\")\n  }\n  puts(file_write(\"io-write.txt\", \"hello\") ?? -1)\n  puts(file_write(\"io-write.txt\", \"\") ?? -1)\n  puts((file_read(\"io-write.txt\") ?? \"?\").size)\n  if e2 = io_failure(file_write(\"/\", \"x\")) {\n    puts(\"\${e2}\")\n  }\n}\n", "write no/such/dir/x.txt 2\ncannot write no/such/dir/x.txt: No such file or directory\n5\n0\n0\ncannot write /: Is a directory\n"))
  xs.push(accepted("io-propagate", "fn copy(from: String, to: String): Int | IoError {\n  text = file_read(from)?\n  file_write(to, text)?\n}\n\nfn main {\n  _ = file_write(\"io-prop.txt\", \"four\")\n  puts(copy(\"io-prop.txt\", \"io-prop2.txt\") ?? -1)\n  puts(copy(\"io-prop-missing.txt\", \"io-prop3.txt\") ?? -1)\n  puts(file_exists(\"io-prop3.txt\"))\n}\n", "4\n-1\nfalse\n"))
  xs.push(accepted("io-list", "fn io_failure(r: Int | IoError): IoError? {\n  _ = r?\n  nil\n}\n\nfn list_failure(r: Array(String) | IoError): IoError? {\n  _ = r?\n  nil\n}\n\nfn run_failure(r: Int | ProcessError): ProcessError? {\n  _ = r?\n  nil\n}\n\nfn show_run(r: Int | ProcessError) {\n  if n = r {\n    puts(\"exit \${n}\")\n  } else if e = run_failure(r) {\n    puts(\"errno \${e.errno} signal \${e.signal} output [\${e.output}]: \${e}\")\n  }\n}\n\nfn main {\n  if e = list_failure(dir_list(\"no-such-dir\")) {\n    puts(\"\${e.op}: \${e}\")\n  }\n  _ = file_write(\"io-list-file\", \"x\")\n  if e2 = list_failure(dir_list(\"io-list-file\")) {\n    puts(\"\${e2}\")\n  }\n  args = [\"-p\", \"io-list-dir\"]\n  _ = process_run(\"mkdir\", args)\n  _ = file_write(\"io-list-dir/b\", \"\")\n  _ = file_write(\"io-list-dir/a\", \"\")\n  _ = file_write(\"io-list-dir/.c\", \"\")\n  if names = dir_list(\"io-list-dir\") {\n    puts(names.size)\n    for n in names {\n      puts(n)\n    }\n  }\n}\n", "list: cannot list no-such-dir: No such file or directory\ncannot list io-list-file: Not a directory\n3\n.c\na\nb\n"))
  xs.push(accepted("proc-run", "fn io_failure(r: Int | IoError): IoError? {\n  _ = r?\n  nil\n}\n\nfn list_failure(r: Array(String) | IoError): IoError? {\n  _ = r?\n  nil\n}\n\nfn run_failure(r: Int | ProcessError): ProcessError? {\n  _ = r?\n  nil\n}\n\nfn show_run(r: Int | ProcessError) {\n  if n = r {\n    puts(\"exit \${n}\")\n  } else if e = run_failure(r) {\n    puts(\"errno \${e.errno} signal \${e.signal} output [\${e.output}]: \${e}\")\n  }\n}\n\nfn main {\n  none: Array(String) = []\n  show_run(process_run(\"/no/such/binary\", none))\n  show_run(process_run(\"no-such-program-w4b2\", [\"a\"]))\n  show_run(process_run(\"sh\", [\"-c\", \"exit 127\"]))\n  show_run(process_run(\"/bin/sh\", [\"-c\", \"kill -9 $$\"]))\n  show_run(process_run(\"/bin/sh\", [\"-c\", \"exit 137\"]))\n  show_run(process_run(\"true\", none))\n  show_run(process_run(\"false\", none))\n  _ = file_write(\"proc-run-data\", \"x\")\n  show_run(process_run(\"./proc-run-data\", none))\n}\n", "errno 2 signal 0 output []: cannot run /no/such/binary: No such file or directory\nerrno 2 signal 0 output []: cannot run no-such-program-w4b2: No such file or directory\nexit 127\nerrno 0 signal 9 output []: /bin/sh killed by signal 9 (Killed)\nexit 137\nexit 0\nexit 1\nerrno 13 signal 0 output []: cannot run ./proc-run-data: Permission denied\n"))
  xs.push(accepted("proc-run-out", "fn io_failure(r: Int | IoError): IoError? {\n  _ = r?\n  nil\n}\n\nfn list_failure(r: Array(String) | IoError): IoError? {\n  _ = r?\n  nil\n}\n\nfn run_failure(r: Int | ProcessError): ProcessError? {\n  _ = r?\n  nil\n}\n\nfn show_run(r: Int | ProcessError) {\n  if n = r {\n    puts(\"exit \${n}\")\n  } else if e = run_failure(r) {\n    puts(\"errno \${e.errno} signal \${e.signal} output [\${e.output}]: \${e}\")\n  }\n}\n\nfn main {\n  show_run(process_run_out(\"echo\", [\"out\", \"put\"], \"proc-out.txt\"))\n  puts(file_read(\"proc-out.txt\") ?? \"?\")\n  show_run(process_run_out(\"sh\", [\"-c\", \"echo err >&2; exit 3\"], \"proc-err.txt\"))\n  puts(file_read(\"proc-err.txt\") ?? \"?\")\n  show_run(process_run_out(\"true\", [\"x\"], \"no/such/dir/out.txt\"))\n}\n", "exit 0\nout put\n\nexit 3\nerr\n\nerrno 2 signal 0 output [no/such/dir/out.txt]: cannot run true: cannot open no/such/dir/out.txt: No such file or directory\n"))
  xs.push(accepted("proc-try", "fn build(n: Int): Int | ProcessError {\n  code = process_run(\"sh\", [\"-c\", \"exit \${n}\"])?\n  code * 10\n}\n\nfn main {\n  puts(build(4) ?? -1)\n  puts(process_run(\"no-such-program-w4b2\", [\"x\"]) ?? -1)\n}\n", "40\n-1\n"))
  xs.push(refused("io-dropped", "fn main {\n  file_write(\"x.txt\", \"y\")\n}\n", "this statement drops a value that can be an error (Int | IoError)"))
  xs.push(refused("proc-dropped", "fn main {\n  process_run(\"true\", [\"x\"])\n}\n", "this statement drops a value that can be an error (Int | ProcessError)"))
  xs.push(refused("io-as-int", "fn main {\n  n: Int = file_write(\"x.txt\", \"y\")\n  puts(n)\n}\n", "Int | IoError"))
  xs.push(refused("list-as-array", "fn main {\n  for n in dir_list(\".\") {\n    puts(n)\n  }\n}\n", "Array(String) | IoError"))
  xs
}

fn exit_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(exited("exit-255", "fn main: Int {\n  puts(\"x\")\n  255\n}\n", "x\n", 255, ""))
  xs.push(exited("exit-3-return", "fn main: Int {\n  n = argv().size\n  if n > 0 {\n    return 3\n  }\n  0\n}\n", "", 3, ""))
  xs.push(trapped("exit-256", "fn main: Int {\n  puts(\"before\")\n  256\n}\n", "before\n", "avant runtime: exit status 256 out of range (0..255)"))
  xs.push(trapped("exit-neg", "fn main: Int {\n  n = argv().size\n  if n > 0 {\n    return -1\n  }\n  0\n}\n", "", "avant runtime: exit status -1 out of range (0..255)"))
  xs.push(trapped("exit-if-tail", "fn main: Int {\n  n = argv().size\n  if n > 100 {\n    0\n  } else {\n    1000 + n\n  }\n}\n", "", "avant runtime: exit status 1001 out of range (0..255)"))
  xs.push(trapped("exit-switch-tail", "fn main: Int {\n  n = argv().size\n  switch n {\n    case 1 {\n      512\n    }\n    else {\n      0\n    }\n  }\n}\n", "", "avant runtime: exit status 512 out of range (0..255)"))
  xs.push(trapped("exit-run", "fn run: Int {\n  puts(\"run\")\n  300\n}\n", "run\n", "avant runtime: exit status 300 out of range (0..255)"))
  xs.push(exited("exit-run-ok", "fn run: Int {\n  7\n}\n", "", 7, ""))
  xs
}

fn cnull_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(accepted("cnull-present", "lib c {\n  fun getenv(name: String): String\n}\nfn main {\n  puts(c.getenv(\"PATH\").size > 0)\n}\n", "true\n"))
  xs.push(trapped("cnull-trap", "lib c {\n  fun getenv(name: String): String\n}\nfn main {\n  puts(\"before\")\n  v = c.getenv(\"NO_SUCH_VAR_W4B2\")\n  puts(v.size)\n}\n", "before\n", "avant runtime: C function c.getenv returned NULL for String (declare String?)"))
  xs.push(accepted("cnull-optional", "lib c {\n  fun getenv(name: String): String?\n}\nfn main {\n  if v = c.getenv(\"NO_SUCH_VAR_W4B2\") {\n    puts(v)\n  } else {\n    puts(\"nil\")\n  }\n  puts(c.getenv(\"NO_SUCH_VAR_W4B2\") ?? \"fallback\")\n}\n", "nil\nfallback\n"))
  xs
}

fn trap_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(trapped("trap-index", "fn main {\n  puts(\"a\")\n  xs = [1]\n  i = argv().size + 4\n  puts(xs[i])\n}\n", "a\n", "avant runtime: index 5 out of bounds (size 1) at sys-trap-index.av:5:10"))
  xs.push(trapped("trap-str-index", "fn main {\n  s = \"ab\"\n  i = argv().size + 6\n  puts(s[i])\n}\n", "", "avant runtime: index 7 out of bounds (size 2) at sys-trap-str-index.av:4:9"))
  xs.push(trapped("trap-add", "fn main {\n  a = 2147483647\n  b = argv().size\n  puts(a + b)\n}\n", "", "avant runtime: integer overflow in Int + at sys-trap-add.av:4:10"))
  xs.push(trapped("trap-sub", "fn main {\n  a = -2147483647\n  b = argv().size + 1\n  puts(a - b)\n}\n", "", "avant runtime: integer overflow in Int - at sys-trap-sub.av:4:10"))
  xs.push(trapped("trap-mul64", "fn main {\n  a: Int64 = 9223372036854775807i64\n  b = argv().size.to_i64 + 1i64\n  puts(a * b)\n}\n", "", "avant runtime: integer overflow in Int64 * at sys-trap-mul64.av:4:10"))
  xs.push(trapped("trap-u64-sub", "fn main {\n  a: UInt64 = 0u64\n  b = argv().size.to_u64 + 1u64\n  puts(a - b)\n}\n", "", "avant runtime: integer overflow in UInt64 - at sys-trap-u64-sub.av:4:10"))
  xs.push(trapped("trap-neg", "fn main {\n  a = -2147483647 - argv().size\n  puts(-a)\n}\n", "", "avant runtime: integer overflow in Int -x at sys-trap-neg.av:3:8"))
  xs.push(trapped("trap-div0", "fn main {\n  a = 7\n  b = argv().size - 1\n  puts(a / b)\n}\n", "", "avant runtime: division by zero in Int / at sys-trap-div0.av:4:10"))
  xs.push(trapped("trap-rem0", "fn main {\n  a = 7\n  b = argv().size - 1\n  puts(a % b)\n}\n", "", "avant runtime: division by zero in Int % at sys-trap-rem0.av:4:10"))
  xs.push(trapped("trap-div-min", "fn main {\n  a = -2147483647 - argv().size\n  b = 0 - argv().size\n  puts(a / b)\n}\n", "", "avant runtime: integer overflow in Int / at sys-trap-div-min.av:4:10"))
  xs.push(trapped("trap-pop", "fn main {\n  xs: Array(Int) = []\n  puts(\"p\")\n  puts(xs.pop)\n}\n", "p\n", "avant runtime: pop on an empty Array at sys-trap-pop.av:4:10"))
  xs.push(trapped("trap-convert", "fn main {\n  big: Int64 = 5000000000i64 + argv().size.to_i64\n  puts(big.to_i)\n}\n", "", "avant runtime: to_i of Int64 5000000001 out of range for Int at sys-trap-convert.av:3:11"))
  xs.push(trapped("trap-byte", "fn main {\n  b = buf_new()\n  b.push_byte(1)\n  b[0] = 299 + argv().size\n}\n", "", "avant runtime: byte 300 out of range (0..255) at sys-trap-byte.av:4:8"))
  xs.push(trapped("trap-shift", "fn main {\n  n = 31 + argv().size\n  puts(1 << n)\n}\n", "", "avant runtime: shift amount 32 out of range for Int (0..31) at sys-trap-shift.av:3:10"))
  xs.push(trapped("trap-f2i", "fn main {\n  x = 1e300 * argv().size.to_f\n  puts(x.to_i)\n}\n", "", "avant runtime: to_i of Float64 1e300 out of range for Int at sys-trap-f2i.av:3:9"))
  xs.push(trapped("trap-array-new", "fn main {\n  n = -4 - argv().size\n  xs = Array(Int).new(n)\n  puts(xs.size)\n}\n", "", "avant runtime: Array size -5 is negative at sys-trap-array-new.av:3:8"))
  xs.push(accepted("trap-order", "fn main {\n  args = argv()\n  if args.size > 1 {\n    puts(\"first\")\n    puts(\"second\")\n    xs = [1]\n    puts(xs[args.size + 3])\n  }\n  _ = process_run_out(args[0], [\"child\"], \"trap-order.txt\")\n  puts(file_read(\"trap-order.txt\") ?? \"?\")\n}\n", "first\nsecond\navant runtime: index 5 out of bounds (size 1) at sys-trap-order.av:7:12\n\n"))
  xs
}

fn lib_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(accepted("lib-json-error", "import std.json\nimport std.regex\n\nfn jfail(r: Json | JsonError): JsonError? {\n  _ = r?\n  nil\n}\n\nfn rfail(r: Regex | RegexError): RegexError? {\n  _ = r?\n  nil\n}\n\nfn main {\n  if e = jfail(Json.parse(\"{\\\"a\\\": 1,}\")) {\n    puts(\"\${e}\")\n    puts(e.offset)\n  }\n  if e2 = jfail(Json.parse(\"[1, 2\")) {\n    puts(e2.message)\n  }\n  if e3 = rfail(Regex.compile(\"(unclosed\")) {\n    puts(\"\${e3}\")\n    puts(e3.offset)\n  }\n  puts(JsonError.new(\"mine\").offset)\n}\n", "invalid JSON at byte 7: trailing comma is not allowed\n7\ninvalid JSON at byte 5: unexpected end of data\ninvalid regular expression at offset 9: missing closing parenthesis\n9\n-1\n"))
  xs.push(trapped("lib-builder-end", "import std.json\nfn main {\n  b = Json.arr\n  puts(b.end.to_s)\n  b.end\n}\n", "[]\n", "avant runtime: JsonBuilder.end: nothing open"))
  xs.push(trapped("lib-builder-key", "import std.json\nfn main {\n  b = Json.arr\n  b.key(\"x\")\n}\n", "", "avant runtime: JsonBuilder.key: not inside an object"))
  xs.push(trapped("lib-builder-key-top", "import std.json\nfn main {\n  b = JsonBuilder.new\n  b.key(\"x\")\n}\n", "", "avant runtime: JsonBuilder.key: not inside an object"))
  xs.push(trapped("lib-builder-open", "import std.json\nfn main {\n  b = Json.obj\n  b.key(\"a\").arr\n  puts(b.to_s)\n}\n", "", "avant runtime: JsonBuilder.to_s: 2 containers still open"))
  xs.push(accepted("lib-builder-ok", "import std.json\nfn main {\n  b = Json.obj\n  b.set(\"a\", 1)\n  b.key(\"xs\").arr.add(1).add(2).end\n  puts(b.end.to_s)\n}\n", "{\"a\":1,\"xs\":[1,2]}\n"))
  xs.push(trapped("lib-regex-closed-find", "import std.regex\nfn main {\n  if re = Regex.compile(\"a+\") {\n    re.close\n    puts(\"closed\")\n    if m = re.find(\"aa\") {\n      puts(m.start)\n    }\n  }\n}\n", "closed\n", "avant runtime: Regex used after close"))
  xs.push(trapped("lib-regex-closed-count", "import std.regex\nfn main {\n  if re = Regex.compile(\"b\") {\n    re.close\n    re.close\n    puts(re.count(\"bb\"))\n  }\n}\n", "", "avant runtime: Regex used after close"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(SCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/sys-${f.tag}.av"
    c.wrote(file_write(src, f.src), "${f.tag}: write")
    jobs.push(compile_job("", compiler, src, "${dir}/sys-${f.tag}.bin", "${dir}/sys-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job(dir, "sys-${f2.tag}.bin", "sys-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/sys-${f3.tag}.log")
    if f3.ok {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      out = log_text("${dir}/sys-${f3.tag}.run.out")
      c.eq_int(runs[k].code, f3.code, "${f3.tag}: exit ${f3.code}")
      if f3.trap {
        c.eq_str(out, f3.want, "${f3.tag}: stdout before the trap")
      } else {
        c.eq_str(out, f3.want, "${f3.tag}: stdout")
      }
      if f3.err.size > 0 {
        err = log_text("${dir}/sys-${f3.tag}.run.err")
        c.expect(str_has(err, f3.err), "${f3.tag}: stderr says ${f3.err}")
      }
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !file_exists("${dir}/sys-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(str_has(log, f3.want), "${f3.tag}: says ${f3.want}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_system.av")
  if compiler = env_get("AVANT_COMPILER") {
    all: Array(SCase) = []
    for f_io in io_cases() {
      all.push(f_io)
    }
    for f_exit in exit_cases() {
      all.push(f_exit)
    }
    for f_cnull in cnull_cases() {
      all.push(f_cnull)
    }
    for f_trap in trap_cases() {
      all.push(f_trap)
    }
    for f_lib in lib_cases() {
      all.push(f_lib)
    }
    run_cases(c, compiler, scratch_dir(), all)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
