import harness
import backends
import std.fs
import std.process

// Honest defaults for processes, files, the exit status,
// the C boundary, traps and library errors.
// Generated once by a script. Each program
// is compiled in parallel; a refused one must leave no binary and say the
// expected words, an accepted one must print what it should and exit with
// its status, and a trapping one must print what it printed before the
// trap, exit 1 and name the trap on stderr.
//   - file_read, file_write and dir_list give their result or an IoError; process_run and process_run_out the exit status or a ProcessError, with PATH lookup
//   - main's (or run's) Int result outside 0..255 traps; inside it is the exit status
//   - a C function declared : String that returns NULL traps naming it; String? reads NULL as nil
//   - every trap the compiler raises names its site (file:line:col), flushes stdout first, names its operation and type, and exits 1
//   - panic(message) is such a trap, raised by the program; it never returns, so it may follow ?? and end a block
//   - JsonBuilder misuse and a closed Regex trap saying what failed; Json.parse and Regex.compile errors carry the library's reason and offset
//   - Hash.delete gives the removed value or nil; String.chars traps on invalid UTF-8 as Bytes.chars does

class SCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub err: String = ""
  pub ok: Bool = false
  pub trap: Bool = false
  pub code: Int = 0
}

fn refused(tag: String, src: String, needle: String): SCase {
  f = SCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f
}

fn accepted(tag: String, src: String, out: String): SCase {
  f = SCase.new()
  f.tag = tag
  f.src = src
  f.want = out
  f.ok = true
  f
}

fn exited(tag: String, src: String, out: String, code: Int, needle: String): SCase {
  f = accepted(tag, src, out)
  f.code = code
  f.err = needle
  f
}

fn trapped(tag: String, src: String, out: String, needle: String): SCase {
  f = exited(tag, src, out, 1, needle)
  f.trap = true
  f
}

fn io_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(accepted("io-read", "fn main {\n  if t = fs.read(\"no-such-file.txt\") {\n    puts(t)\n  } else {\n    puts(\"absent\")\n  }\n  puts(fs.read(\"/\") ?? \"a directory\")\n  _ = fs.write(\"io-read.txt\", \"abc\")\n  puts(fs.read(\"io-read.txt\") ?? \"?\")\n}\nimport std.fs\n", "absent\na directory\nabc\n"))
  xs.push(accepted("io-write", "fn show_run(r: Int | ProcessError) {\n  switch r {\n    case n: Int { puts(\"exit \${n}\") }\n    case e: ProcessError { puts(\"errno \${e.errno} signal \${e.signal} output [\${e.output}]: \${e}\") }\n  }\n}\n\nfn main {\n  r = fs.write(\"no/such/dir/x.txt\", \"hi\")\n  switch r {\n    case e: IoError {\n      puts(\"\${e.op} \${e.path} \${e.errno}\")\n      puts(\"\${e}\")\n    }\n    case Int { }\n  }\n  puts(fs.write(\"io-write.txt\", \"hello\") ?? -1)\n  puts(fs.write(\"io-write.txt\", \"\") ?? -1)\n  puts((fs.read(\"io-write.txt\") ?? \"?\").size)\n  switch fs.write(\"/\", \"x\") {\n    case e2: IoError {\n      puts(\"\${e2}\")\n    }\n    case Int { }\n  }\n}\nimport std.fs\n", "write no/such/dir/x.txt 2\ncannot write no/such/dir/x.txt: No such file or directory\n5\n0\n0\ncannot write /: Is a directory\n"))
  xs.push(accepted("io-propagate", "fn copy(from: String, to: String): Int | IoError {\n  text = fs.read(from)?\n  fs.write(to, text)?\n}\n\nfn main {\n  _ = fs.write(\"io-prop.txt\", \"four\")\n  puts(copy(\"io-prop.txt\", \"io-prop2.txt\") ?? -1)\n  puts(copy(\"io-prop-missing.txt\", \"io-prop3.txt\") ?? -1)\n  puts(fs.exists(\"io-prop3.txt\"))\n}\nimport std.fs\n", "4\n-1\nfalse\n"))
  xs.push(accepted("io-list", "fn show_run(r: Int | ProcessError) {\n  switch r {\n    case n: Int { puts(\"exit \${n}\") }\n    case e: ProcessError { puts(\"errno \${e.errno} signal \${e.signal} output [\${e.output}]: \${e}\") }\n  }\n}\n\nfn main {\n  switch fs.list(\"no-such-dir\") {\n    case e: IoError {\n      puts(\"\${e.op}: \${e}\")\n    }\n    case Array(String) { }\n  }\n  _ = fs.write(\"io-list-file\", \"x\")\n  switch fs.list(\"io-list-file\") {\n    case e2: IoError {\n      puts(\"\${e2}\")\n    }\n    case Array(String) { }\n  }\n  args = [\"-p\", \"io-list-dir\"]\n  _ = process.run(\"mkdir\", args)\n  _ = fs.write(\"io-list-dir/b\", \"\")\n  _ = fs.write(\"io-list-dir/a\", \"\")\n  _ = fs.write(\"io-list-dir/.c\", \"\")\n  if names = fs.list(\"io-list-dir\") {\n    puts(names.size)\n    for n in names {\n      puts(n)\n    }\n  }\n}\nimport std.fs\nimport std.process\n", "list: cannot list no-such-dir: No such file or directory\ncannot list io-list-file: Not a directory\n3\n.c\na\nb\n"))
  xs.push(accepted("proc-run", "fn show_run(r: Int | ProcessError) {\n  switch r {\n    case n: Int { puts(\"exit \${n}\") }\n    case e: ProcessError { puts(\"errno \${e.errno} signal \${e.signal} output [\${e.output}]: \${e}\") }\n  }\n}\n\nfn main {\n  none: Array(String) = []\n  show_run(process.run(\"/no/such/binary\", none))\n  show_run(process.run(\"no-such-program-w4b2\", [\"a\"]))\n  show_run(process.run(\"sh\", [\"-c\", \"exit 127\"]))\n  show_run(process.run(\"/bin/sh\", [\"-c\", \"kill -9 $$\"]))\n  show_run(process.run(\"/bin/sh\", [\"-c\", \"exit 137\"]))\n  show_run(process.run(\"true\", none))\n  show_run(process.run(\"false\", none))\n  _ = fs.write(\"proc-run-data\", \"x\")\n  show_run(process.run(\"./proc-run-data\", none))\n}\nimport std.fs\nimport std.process\n", "errno 2 signal 0 output []: cannot run /no/such/binary: No such file or directory\nerrno 2 signal 0 output []: cannot run no-such-program-w4b2: No such file or directory\nexit 127\nerrno 0 signal 9 output []: /bin/sh killed by signal 9 (Killed)\nexit 137\nexit 0\nexit 1\nerrno 13 signal 0 output []: cannot run ./proc-run-data: Permission denied\n"))
  xs.push(accepted("proc-try", "fn build(n: Int): Int | ProcessError {\n  code = process.run(\"sh\", [\"-c\", \"exit \${n}\"])?\n  code * 10\n}\n\nfn main {\n  puts(build(4) ?? -1)\n  puts(process.run(\"no-such-program-w4b2\", [\"x\"]) ?? -1)\n}\nimport std.process\n", "40\n-1\n"))
  xs.push(refused("io-dropped", "fn main {\n  fs.write(\"x.txt\", \"y\")\n}\nimport std.fs\n", "this statement drops a value that can be an error (Int | IoError)"))
  xs.push(refused("proc-dropped", "fn main {\n  process.run(\"true\", [\"x\"])\n}\nimport std.process\n", "this statement drops a value that can be an error (Int | ProcessError)"))
  xs.push(refused("io-as-int", "fn main {\n  n: Int = fs.write(\"x.txt\", \"y\")\n  puts(n)\n}\nimport std.fs\n", "Int | IoError"))
  xs.push(refused("list-as-array", "fn main {\n  for n in fs.list(\".\") {\n    puts(n)\n  }\n}\nimport std.fs\n", "Array(String) | IoError"))
  xs
}

fn exit_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(exited("exit-255", "fn main: Int {\n  puts(\"x\")\n  255\n}\n", "x\n", 255, ""))
  xs.push(exited("exit-3-return", "fn main: Int {\n  n = process.args().size\n  if n > 0 {\n    return 3\n  }\n  0\n}\nimport std.process\n", "", 3, ""))
  xs.push(trapped("exit-256", "fn main: Int {\n  puts(\"before\")\n  256\n}\n", "before\n", "avant runtime: exit status 256 out of range (0..255)"))
  xs.push(trapped("exit-neg", "fn main: Int {\n  n = process.args().size\n  if n > 0 {\n    return -1\n  }\n  0\n}\nimport std.process\n", "", "avant runtime: exit status -1 out of range (0..255)"))
  xs.push(trapped("exit-if-tail", "fn main: Int {\n  n = process.args().size\n  if n > 100 {\n    0\n  } else {\n    1000 + n\n  }\n}\nimport std.process\n", "", "avant runtime: exit status 1001 out of range (0..255)"))
  xs.push(trapped("exit-switch-tail", "fn main: Int {\n  n = process.args().size\n  switch n {\n    case 1 {\n      512\n    }\n    else {\n      0\n    }\n  }\n}\nimport std.process\n", "", "avant runtime: exit status 512 out of range (0..255)"))
  xs.push(trapped("exit-run", "fn run: Int {\n  puts(\"run\")\n  300\n}\n", "run\n", "avant runtime: exit status 300 out of range (0..255)"))
  xs.push(exited("exit-run-ok", "fn run: Int {\n  7\n}\n", "", 7, ""))
  xs
}

fn cnull_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(accepted("cnull-present", "lib c {\n  fun getenv(name: String): String\n}\nfn main {\n  puts(c.getenv(\"PATH\").size > 0)\n}\n", "true\n"))
  xs.push(trapped("cnull-trap", "lib c {\n  fun getenv(name: String): String\n}\nfn main {\n  puts(\"before\")\n  v = c.getenv(\"NO_SUCH_VAR_W4B2\")\n  puts(v.size)\n}\n", "before\n", "avant runtime: C function c.getenv returned NULL for String (declare String?)"))
  xs.push(accepted("cnull-optional", "lib c {\n  fun getenv(name: String): String?\n}\nfn main {\n  if v = c.getenv(\"NO_SUCH_VAR_W4B2\") {\n    puts(v)\n  } else {\n    puts(\"nil\")\n  }\n  puts(c.getenv(\"NO_SUCH_VAR_W4B2\") ?? \"fallback\")\n}\n", "nil\nfallback\n"))
  xs
}

fn trap_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(trapped("trap-index", "fn main {\n  puts(\"a\")\n  xs = [1]\n  i = process.args().size + 4\n  puts(xs[i])\n}\nimport std.process\n", "a\n", "avant runtime: index 5 out of bounds (size 1) in main (sys-trap-index.av:1:1)"))
  xs.push(trapped("trap-str-index", "fn main {\n  s = \"ab\"\n  i = process.args().size + 6\n  puts(s[i])\n}\nimport std.process\n", "", "avant runtime: index 7 out of bounds (size 2) in main (sys-trap-str-index.av:1:1)"))
  xs.push(trapped("trap-add", "fn main {\n  a = 9223372036854775807\n  b = process.args().size\n  puts(a + b)\n}\nimport std.process\n", "", "avant runtime: integer overflow in main (sys-trap-add.av:1:1)"))
  xs.push(trapped("trap-sub", "fn main {\n  a = -9223372036854775807\n  b = process.args().size + 1\n  puts(a - b)\n}\nimport std.process\n", "", "avant runtime: integer overflow in main (sys-trap-sub.av:1:1)"))
  xs.push(trapped("trap-mul64", "fn main {\n  a: Int = 9223372036854775807\n  b = process.args().size.to_i() + 1\n  puts(a * b)\n}\nimport std.process\n", "", "avant runtime: integer overflow in main (sys-trap-mul64.av:1:1)"))
  xs.push(trapped("trap-u64-sub", "fn main {\n  a: UInt64 = 0u64\n  b = process.args().size.to_u64() + 1u64\n  puts(a - b)\n}\nimport std.process\n", "", "avant runtime: integer overflow in main (sys-trap-u64-sub.av:1:1)"))
  xs.push(trapped("trap-neg", "fn main {\n  a = -9223372036854775807 - process.args().size\n  puts(-a)\n}\nimport std.process\n", "", "avant runtime: integer overflow in main (sys-trap-neg.av:1:1)"))
  xs.push(trapped("trap-div0", "fn main {\n  a = 7\n  b = process.args().size - 1\n  puts(a / b)\n}\nimport std.process\n", "", "avant runtime: division by zero in main (sys-trap-div0.av:1:1)"))
  xs.push(trapped("trap-rem0", "fn main {\n  a = 7\n  b = process.args().size - 1\n  puts(a % b)\n}\nimport std.process\n", "", "avant runtime: division by zero in main (sys-trap-rem0.av:1:1)"))
  xs.push(trapped("trap-div-min", "fn main {\n  a = -9223372036854775807 - process.args().size\n  b = 0 - process.args().size\n  puts(a / b)\n}\nimport std.process\n", "", "avant runtime: integer overflow in main (sys-trap-div-min.av:1:1)"))
  xs.push(trapped("trap-pop", "fn main {\n  xs: Array(Int) = []\n  puts(\"p\")\n  puts(xs.pop().expect(\"xs has an element\"))\n}\n", "p\n", "avant runtime: xs has an element at sys-trap-pop.av:4:16"))
  xs.push(trapped("trap-convert", "fn main {\n  big = 5000000000 + process.args().size\n  puts(big.to_i32())\n}\nimport std.process\n", "", "avant runtime: to_i32 of Int 5000000001 out of range for Int32 at sys-trap-convert.av:3:11"))
  xs.push(trapped("trap-byte", "fn main {\n  b = buf_new()\n  b.push_byte(1)\n  b[0] = 299 + process.args().size\n}\nimport std.process\n", "", "avant runtime: byte 300 out of range (0..255) at sys-trap-byte.av:4:8"))
  xs.push(trapped("trap-shift", "fn main {\n  n = 63 + process.args().size\n  puts(1 << n)\n}\nimport std.process\n", "", "avant runtime: shift amount 64 out of range for Int (0..63) at sys-trap-shift.av:3:10"))
  xs.push(trapped("trap-f2i", "fn main {\n  x = 1e300 * process.args().size.to_f()\n  puts(x.to_i())\n}\nimport std.process\n", "", "avant runtime: to_i of Float64 1e300 out of range for Int at sys-trap-f2i.av:3:9"))
  xs.push(trapped("trap-array-new", "fn main {\n  n = -4 - process.args().size\n  xs = Array(Int).new(n)\n  puts(xs.size)\n}\nimport std.process\n", "", "avant runtime: Array size -5 is negative at sys-trap-array-new.av:3:8"))
  xs.push(trapped("trap-in-method", "class Heap {\n  xs: Array(Int) = []\n\n  fn at(i: Int): Int {\n    xs[i] + 1\n  }\n}\n\nfn twice(n: Int): Int {\n  n * 2\n}\n\nfn main {\n  h = Heap.new()\n  h.xs.push(1)\n  puts(twice(h.at(0)))\n  puts(twice(4611686018427387904 + process.args().size))\n}\nimport std.process\n", "4\n", "avant runtime: integer overflow in twice (sys-trap-in-method.av:9:1)"))
  xs.push(trapped("trap-in-method2", "class Heap {\n  xs: Array(Int) = []\n\n  fn at(i: Int): Int {\n    xs[i] + 1\n  }\n}\n\nfn main {\n  h = Heap.new()\n  puts(h.at(process.args().size + 1))\n}\nimport std.process\n", "", "avant runtime: index 2 out of bounds (size 0) in Heap.at (sys-trap-in-method2.av:4:3)"))
  xs.push(accepted("trap-order", "fn main {\n  args = process.args()\n  if args.size > 1 {\n    puts(\"first\")\n    puts(\"second\")\n    xs = [1]\n    puts(xs[args.size + 3])\n  }\n  _ = process.run(\"sh\", [\"-c\", \"\${args[0]} child > trap-order.txt 2>&1\"])\n  puts(fs.read(\"trap-order.txt\") ?? \"?\")\n}\nimport std.fs\nimport std.process\n", "first\nsecond\navant runtime: index 5 out of bounds (size 1) in main (sys-trap-order.av:1:1)\n\n"))
  xs
}

// panic(message): a trap the program raises, with the call's site; it never
// returns, so it ends a block, a switch arm or a guard's else, and stands
// after ?? as return does (exit too).
fn panic_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(trapped("panic-plain", "fn main {\n  puts(\"before\")\n  panic(\"the table is empty\")\n}\n", "before\n", "avant runtime: the table is empty at sys-panic-plain.av:3:3"))
  xs.push(trapped("panic-coalesce", "fn main {\n  s = \"4x\"\n  n = s.to_i() ?? panic(\"not a number: \${s}\")\n  puts(n)\n}\n", "", "avant runtime: not a number: 4x at sys-panic-coalesce.av:3:19"))
  xs.push(accepted("panic-coalesce-ok", "fn main {\n  n = \"42\".to_i() ?? panic(\"not a number\")\n  puts(n + 1)\n  xs = [1.5, 2.5]\n  puts(xs.get(1) ?? panic(\"no second\"))\n  n = process.args().size\n  v = if n > 0 { n * 2 } else { panic(\"no program name\") }\n  puts(v)\n}\nimport std.process\n", "43\n2.5\n2\n"))
  xs.push(trapped("panic-guard", "class Bad: Error {\n  message: String = \"no such key\"\n}\n\nfn find(k: Int): Int | Bad {\n  if k > 2 {\n    return Bad.new()\n  }\n  k * 10\n}\n\nfn main {\n  for k in 1..5 {\n    v = find(k) else e {\n      panic(\"key \${k}: \${e}\")\n    }\n    puts(v)\n  }\n}\n", "10\n20\n", "avant runtime: key 3: no such key at sys-panic-guard.av:15:7"))
  xs.push(trapped("panic-tail", "fn pick(n: Int): Int {\n  if n > 0 {\n    return n\n  }\n  panic(\"pick needs a positive number, got \${n}\")\n}\n\nfn kind(n: Int): String {\n  switch n {\n    case 1 { \"one\" }\n    case 2 { \"two\" }\n    else { panic(\"no kind for \${n}\") }\n  }\n}\n\nfn main {\n  puts(pick(3))\n  puts(kind(2))\n  puts(pick(1 - process.args().size))\n}\nimport std.process\n", "3\ntwo\n", "avant runtime: pick needs a positive number, got 0 at sys-panic-tail.av:5:3"))
  xs.push(accepted("panic-task", "fn main {\n  n = process.args().size\n  h = spawn {\n    if n > 0 {\n      panic(\"the task gave up\")\n    }\n    n\n  }\n  v = h.join() else e {\n    puts(\"joined: \${e.what}\")\n    return\n  }\n  puts(v)\n}\nimport std.process\n", "joined: the task gave up\n"))
  xs.push(exited("exit-coalesce", "fn main {\n  puts(\"start\")\n  n = \"seven\".to_i() ?? exit(4)\n  puts(n)\n}\n", "start\n", 4, ""))
  xs.push(refused("panic-not-string", "fn main {\n  panic(3)\n}\n", "expected String"))
  xs.push(refused("panic-no-message", "fn main {\n  panic()\n}\n", "panic takes one String, the message"))
  xs.push(refused("panic-after-dead", "fn f(n: Int): Int {\n  x = n.to_s() ?? panic(\"no\")\n  n\n}\nfn main {\n  puts(f(1))\n}\n", "?? needs a value that can fail (T? or T | E with E marked Error), got String"))
  xs
}

fn lib_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(accepted("lib-json-error", "import std.json\nimport std.regex\n\nfn main {\n  switch Json.parse(\"{\\\"a\\\": 1,}\") {\n    case e: JsonError {\n      puts(\"\${e}\")\n      puts(e.offset ?? -1)\n    }\n    case Json { }\n  }\n  switch Json.parse(\"[1, 2\") {\n    case e2: JsonError {\n      puts(e2.message)\n    }\n    case Json { }\n  }\n  switch Regex.compile(\"(unclosed\") {\n    case e3: RegexError {\n      puts(\"\${e3}\")\n      puts(e3.offset ?? -1)\n    }\n    case Regex { }\n  }\n  puts(JsonError.new(\"mine\").offset ?? -1)\n  puts(RegexError.new(\"mine\").offset ?? -1)\n}\n", "invalid JSON at byte 7: trailing comma is not allowed\n7\ninvalid JSON at byte 5: unexpected end of data\ninvalid regular expression at offset 9: missing closing parenthesis\n9\n-1\n-1\n"))
  xs.push(refused("lib-json-iter-gone", "import std.json\nfn main {\n  if v = Json.parse(\"[1]\") {\n    it = v.iter()\n  }\n}\n", "iter"))
  xs.push(refused("lib-json-f64s-gone", "import std.json\nfn main {\n  if v = Json.parse(\"[{\\\"x\\\": 1.5}]\") {\n    xs = v.f64s(\"x\")\n  }\n}\n", "f64s"))
  xs.push(refused("lib-json-offset-optional", "import std.json\nfn main {\n  e = JsonError.new(\"mine\")\n  n: Int = e.offset\n}\n", "Int?"))
  xs.push(refused("lib-json-arr-is-a-reader", "import std.json\nfn main {\n  b = Json.arr()\n}\n", "Json.arr is an instance method"))
  xs.push(trapped("lib-builder-end", "import std.json\nfn main {\n  b = Json.array()\n  puts(b.end().to_s())\n  b.end()\n}\n", "[]\n", "avant runtime: JsonBuilder.end: nothing open"))
  xs.push(trapped("lib-builder-nan", "import std.json\nfn main {\n  b = Json.array()\n  b.value(1.5).value(-0.0)\n  puts(b.end().to_s())\n  z = 0.0 * process.args().size.to_f()\n  c = Json.array()\n  c.value(z / z)\n}\nimport std.process\n", "[1.5,-0.0]\n", "avant runtime: JsonBuilder.value: nan is not a JSON number; write null or a string for it"))
  xs.push(trapped("lib-builder-inf", "import std.json\nfn main {\n  z = 0.0 * process.args().size.to_f()\n  b = Json.object()\n  b.key(\"x\").value(1.0 / z)\n}\nimport std.process\n", "", "avant runtime: JsonBuilder.value: inf is not a JSON number; write null or a string for it"))
  xs.push(trapped("lib-builder-neg-inf", "import std.json\nfn main {\n  z = 0.0 * process.args().size.to_f()\n  b = Json.array()\n  b.value(-1.0 / z)\n}\nimport std.process\n", "", "avant runtime: JsonBuilder.value: -inf is not a JSON number; write null or a string for it"))
  xs.push(trapped("lib-builder-key", "import std.json\nfn main {\n  b = Json.array()\n  b.key(\"x\")\n}\n", "", "avant runtime: JsonBuilder.key: not inside an object"))
  xs.push(trapped("lib-builder-key-top", "import std.json\nfn main {\n  b = JsonBuilder.new()\n  b.key(\"x\")\n}\n", "", "avant runtime: JsonBuilder.key: not inside an object"))
  xs.push(trapped("lib-builder-open", "import std.json\nfn main {\n  b = Json.object()\n  b.key(\"a\").arr()\n  puts(b.to_s())\n}\n", "", "avant runtime: JsonBuilder.to_s: 2 containers still open"))
  xs.push(accepted("lib-builder-ok", "import std.json\nfn main {\n  b = Json.object()\n  b.set(\"a\", 1)\n  b.key(\"xs\").arr().add(1).add(2).end()\n  puts(b.end().to_s())\n}\n", "{\"a\":1,\"xs\":[1,2]}\n"))
  xs.push(trapped("lib-regex-closed-find", "import std.regex\nfn main {\n  if re = Regex.compile(\"a+\") {\n    re.close()\n    puts(\"closed\")\n    if m = re.find(\"aa\") {\n      puts(m.start)\n    }\n  }\n}\n", "closed\n", "avant runtime: Regex used after close"))
  xs.push(trapped("lib-regex-closed-count", "import std.regex\nfn main {\n  if re = Regex.compile(\"b\") {\n    re.close()\n    re.close()\n    puts(re.count(\"bb\"))\n  }\n}\n", "", "avant runtime: Regex used after close"))
  xs
}

fn small_cases: Array(SCase) {
  xs: Array(SCase) = []
  xs.push(accepted("small-delete", "fn main {\n  h = Hash(String, Int).new()\n  h[\"a\"] = 7\n  if v = h.delete(\"a\") {\n    puts(v)\n  }\n  puts(h.delete(\"a\") ?? -1)\n  puts(h.size)\n  s = Hash(String, String).new()\n  s[\"k\"] = \"v\"\n  puts(s.delete(\"k\") ?? \"none\")\n  puts(s.delete(\"k\") ?? \"none\")\n  n = Hash(Int, Int).new()\n  n[3] = 9\n  n.delete(4)\n  puts(n.delete(3) ?? 0)\n  puts(n.has(3))\n}\n", "7\n-1\n0\nv\nnone\n9\nfalse\n"))
  xs.push(trapped("small-chars", "fn main {\n  puts(\"x\".chars().size)\n  s = \"a\${chr(255)}b\"\n  puts(s.chars().size)\n}\n", "1\n", "avant runtime: String.chars needs valid UTF-8"))
  xs.push(accepted("small-chars-ok", "fn main {\n  cs = \"héllo\".chars()\n  puts(cs.size)\n  puts(cs[1])\n}\n", "5\né\n"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(SCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/sys-${f.tag}.av"
    c.wrote(fs.write(src, f.src), "${f.tag}: write")
    jobs.push(compile_job("", compiler, src, "${dir}/sys-${f.tag}.bin", "${dir}/sys-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job(dir, "sys-${f2.tag}.bin", "sys-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/sys-${f3.tag}.log")
    if f3.ok {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      out = log_text("${dir}/sys-${f3.tag}.run.out")
      c.eq_int(runs[k].code, f3.code, "${f3.tag}: exit ${f3.code}")
      if f3.trap {
        c.eq_str(out, f3.want, "${f3.tag}: stdout before the trap")
      } else {
        c.eq_str(out, f3.want, "${f3.tag}: stdout")
      }
      if f3.err.size > 0 {
        err = log_text("${dir}/sys-${f3.tag}.run.err")
        c.expect(err.contains(f3.err), "${f3.tag}: stderr says ${f3.err}")
      }
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !fs.exists("${dir}/sys-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(log.contains(f3.want), "${f3.tag}: says ${f3.want}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_system.av")
  if compiler = process.env("AVANT_COMPILER") {
    all: Array(SCase) = []
    for f_io in io_cases() {
      all.push(f_io)
    }
    for f_exit in exit_cases() {
      all.push(f_exit)
    }
    for f_cnull in cnull_cases() {
      all.push(f_cnull)
    }
    for f_trap in trap_cases() {
      all.push(f_trap)
    }
    for f_panic in panic_cases() {
      all.push(f_panic)
    }
    for f_lib in lib_cases() {
      all.push(f_lib)
    }
    for f_small in small_cases() {
      all.push(f_small)
    }
    run_cases(c, compiler, scratch_dir(), all)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
