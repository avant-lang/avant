import harness
import backends

// The refusals of the sequence and array verbs: slices (`xs[a..b]`, the
// open and inclusive forms, `slice`, `try_slice`), the verbs that take a
// lambda (`find`, `index_of`, `min_by`, `max_by`, `delete_if`), `fill`,
// `unique`, `first`, and `push_str`'s argument. What they compute is in
// the run goldens of tests/fixtures/heap/slices.av, verbs.av and
// trap_slice.av. Each program is compiled in parallel; a refused one must
// leave no binary, say the expected words and point at the expected line
// and column.

class LCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  pub ok: Bool = false
}

fn refused(tag: String, src: String, needle: String, pos: String): LCase {
  f = LCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f
}

fn cases: Array(LCase) {
  xs: Array(LCase) = []
  xs.push(refused("slice-inclusive-open", "fn main {\n  xs = [1, 2]\n  puts(xs[1..=].size)\n}\n", "an inclusive slice needs its last index", "3:12"))
  xs.push(refused("slice-bounds", "fn main {\n  xs = [1, 2]\n  puts(xs[1.5..].size)\n}\n", "the bounds of a slice are Int, got Float64", "3:11"))
  xs.push(refused("slice-arity", "fn main {\n  s = \"abc\"\n  puts(s.slice(1, 2, 3))\n}\n", "slice takes start and stop, or start alone", "3:9"))
  xs.push(refused("find-pipes", "fn main {\n  xs = [1, 2]\n  puts(xs.find { |x| x > 1 } ?? 0)\n}\n", "find takes a lambda: write find((x) { ... })", "3:16"))
  xs.push(refused("find-break", "fn main {\n  xs = [1, 2]\n  puts(xs.find((x) {\n    if x > 1 {\n      break\n    }\n    true\n  }) ?? 0)\n}\n", "break inside a lambda given to find", "5:7"))
  xs.push(refused("find-predicate", "fn main {\n  xs = [1, 2]\n  puts(xs.find((x) { x }) ?? 0)\n}\n", "the predicate of find must give a Bool, got Int", "3:16"))
  xs.push(refused("min-by-key", "fn main {\n  xs = [1, 2]\n  puts(xs.min_by((x) { [x] }) ?? 0)\n}\n", "the key of min_by must be a number, a String or Bytes, got Array(Int)", "3:18"))
  xs.push(refused("delete-if-walk", "fn main {\n  xs = [1, 2, 3]\n  for x in xs {\n    xs.delete_if((y) { y == x })\n  }\n}\n", "cannot delete_if xs while walking it", "4:7"))
  xs.push(refused("fill-shared", "class Box {\n  pub n: Int = 0\n}\n\nfn main {\n  bs = [Box.new()]\n  bs.fill(Box.new())\n}\n", "fill(v) would put the same object in every element", "7:14"))
  xs.push(refused("unique-eq", "fn main {\n  bs = [Buf.new()]\n  puts(bs.unique().size)\n}\n", "unique compares the elements with ==: Buf has no ==", "3:10"))
  xs.push(refused("first-arguments", "fn main {\n  xs = [1, 2]\n  puts(xs.first(1) ?? 0)\n}\n", "first takes no arguments", "3:10"))
  xs.push(refused("push-str-type", "fn main {\n  b = Buf.new()\n  b.push_str(5)\n}\n", "push_str expects String, Bytes or Buf, got Int", "3:14"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(LCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/verb-${f.tag}.av"
    _ = file_write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/verb-${f.tag}.bin", "${dir}/verb-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.ok {
      runs.push(run_job(dir, "verb-${f2.tag}.bin", "verb-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/verb-${f3.tag}.log")
    if f3.ok {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.eq_int(runs[k].code, 0, "${f3.tag}: exit 0")
      c.eq_str(log_text("${dir}/verb-${f3.tag}.run.out"), f3.want, "${f3.tag}: stdout")
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !file_exists("${dir}/verb-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(str_has(log, f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(str_has(log, "verb-${f3.tag}.av:${f3.pos}"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_verbs.av")
  if compiler = env_get("AVANT_COMPILER") {
    run_cases(c, compiler, scratch_dir(), cases())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
