import harness
import backends
import std.fs
import std.process

// A program that crashes leaves nothing behind: a stack overflow (on the
// main thread, in a task, in a callback on a C thread) and a fault in C
// code (a null pointer on the same three threads, a bus error) each print
// one line after the program's output, end with their status (1 for the
// overflow; the fault's signal for a fault: 139, 135), and remove the
// program's private directory after stopping the children it waits on. The
// program makes its directory, starts two children (`sleep`), each from a
// task of its own, and crashes once both have written their pids and a
// quarter of a second more. The window cases crash instead while both tasks
// are between their fork and the runtime's next step (held there by a fork
// handler in the test's C code): a task claims the slot of the child it
// waits on before it forks, so the crash still finds and stops the child.
// Each check of a child waits up to ten seconds for it to be gone before it
// reads it alive. A trap
// stops them too, and so does every crash, trap or signal of a program
// that never made its directory (plain_cases).

fn program(dir: Bool): String {
  b = Buf.new()
  b.push_str("import std.fs\nimport std.process\nimport std.time\n\n")
  b.push_str("lib crash_c {\n  fun avant_tmp_dir: String\n  fun so_call_on_thread(f: fn(Int): Int): Int\n  fun crash_write_null(k: Int): Int\n  fun crash_bus: Int\n  fun crash_div(k: Int): Int\n  fun crash_ill: Int\n  fun crash_abort: Int\n  fun crash_fork_hold: Int\n  fun crash_fork_held: Int\n  fun crash_fork_go: Int\n}\n\n")
  b.push_str("lib sig_c {\n  fun kill(pid: Int32, sig: Int32): Int32\n  fun getpid: Int32\n}\n\n")
  b.push_str("fn depth(n: Int): Int {\n  if n == 0 {\n    return 0\n  }\n  d = depth(n - 1)\n  d + 1 + ((d + n) & 1)\n}\n\n")
  b.push_str("fn start(n: Int): Int {\n  xs = [n]\n  depth(xs[0])\n}\n\n")
  b.push_str("fn null_on_thread(n: Int): Int {\n  xs = [n]\n  crash_c.crash_write_null(xs[0] - n)\n}\n\n")
  b.push_str("fn main {\n  out = process.env(\"CRASH_OUT\") ?? \"\"\n  m = process.env(\"CRASH_MODE\") ?? \"\"\n  window = m.starts_with(\"window-\")\n  if window {\n    m = m[7..m.size]\n    _ = crash_c.crash_fork_hold()\n  }\n")
  if dir {
    b.push_str("  _ = fs.write(\"\${out}.dir\", crash_c.avant_tmp_dir())\n")
  }
  b.push_str("  child = spawn {\n    args = [\"-c\", \"echo $$ > \${out}.pid.part && mv \${out}.pid.part \${out}.pid && exec sleep 30\"]\n    process.run(\"/bin/sh\", args) ?? -1\n  }\n")
  b.push_str("  child2 = spawn {\n    args2 = [\"-c\", \"echo $$ > \${out}.pid2.part && mv \${out}.pid2.part \${out}.pid2 && exec sleep 30\"]\n    process.run(\"/bin/sh\", args2) ?? -1\n  }\n")
  b.push_str("  while !fs.exists(\"\${out}.pid\") || !fs.exists(\"\${out}.pid2\") || (window && crash_c.crash_fork_held() < 2) {\n    time.sleep_ms(10)\n  }\n  if window {\n    _ = crash_c.crash_fork_go()\n  } else {\n    time.sleep_ms(250)\n  }\n  puts(\"start\")\n")
  b.push_str("  if m == \"overflow\" {\n    puts(depth(100000000))\n  }\n")
  b.push_str("  if m == \"overflow-task\" {\n    h = spawn { depth(100000000) }\n    puts(h.join() ?? -1)\n  }\n")
  b.push_str("  if m == \"overflow-callback\" {\n    puts(crash_c.so_call_on_thread(start))\n  }\n")
  b.push_str("  if m == \"null\" {\n    puts(crash_c.crash_write_null(0))\n  }\n")
  b.push_str("  if m == \"null-task\" {\n    h2 = spawn { crash_c.crash_write_null(0) }\n    puts(h2.join() ?? -1)\n  }\n")
  b.push_str("  if m == \"null-callback\" {\n    puts(crash_c.so_call_on_thread(null_on_thread))\n  }\n")
  b.push_str("  if m == \"bus\" {\n    puts(crash_c.crash_bus())\n  }\n")
  b.push_str("  if m == \"div\" {\n    puts(crash_c.crash_div(0))\n  }\n")
  b.push_str("  if m == \"ill\" {\n    puts(crash_c.crash_ill())\n  }\n")
  b.push_str("  if m == \"abort\" {\n    puts(crash_c.crash_abort())\n  }\n")
  b.push_str("  if m == \"trap\" {\n    xs = [m.size]\n    puts(xs[m.size])\n  }\n")
  b.push_str("  if m == \"term\" {\n    puts(sig_c.kill(sig_c.getpid(), 15))\n  }\n")
  b.push_str("  puts(child.join() ?? -1)\n  puts(child2.join() ?? -1)\n}\n")
  b.to_s()
}

class Case {
  pub mode: String = ""
  pub code: Int = 0
  pub says: String = ""

  fn initialize(mode: String, code: Int, says: String) {
    self.mode = mode
    self.code = code
    self.says = says
  }
}

fn cases: Array(Case) {
  [
    Case.new("overflow", 1, "avant runtime: stack overflow in depth on the main thread: the calls nest too deep"),
    Case.new("overflow-task", 1, "avant runtime: stack overflow in depth in a task: the calls nest too deep"),
    Case.new("overflow-callback", 1, "avant runtime: stack overflow in depth in a callback on a C thread: the calls nest too deep"),
    Case.new("null", 139, "avant runtime: segmentation fault in main on the main thread: address 0x0 is not mapped (a null pointer, most likely in C code)"),
    Case.new("null-task", 139, "avant runtime: segmentation fault in main in a task: address 0x0 is not mapped (a null pointer, most likely in C code)"),
    Case.new("null-callback", 139, "avant runtime: segmentation fault in null_on_thread in a callback on a C thread: address 0x0 is not mapped (a null pointer, most likely in C code)"),
    Case.new("bus", 135, "avant runtime: bus error in main on the main thread: address 0x"),
    // C code's division by zero and illegal instruction print their line
    // too, after the program's output, and end by the signal; abort()
    // keeps the output and adds no line to its caller's own.
    Case.new("div", 136, "avant runtime: arithmetic fault"),
    Case.new("ill", 132, "avant runtime: illegal instruction"),
    Case.new("abort", 134, ""),
    // A trap ends the program with status 1 after its line.
    Case.new("trap", 1, "avant runtime: index 4 out of bounds (size 1)"),
    // Ended by SIGTERM: what it printed is kept, as for a crash, and the
    // signal ends it (128 + 15), saying nothing. (SIGINT is ignored in a
    // shell's background job, as these runs are: plain_signal_cases
    // sends it in the foreground.)
    Case.new("term", 143, ""),
    // The same ends while both tasks are starting their children: each
    // child exists and its task has not yet gone on from the fork (a fork
    // handler of the test's C code holds it there), and it is stopped too.
    Case.new("window-null", 139, "avant runtime: segmentation fault in main on the main thread: address 0x0 is not mapped (a null pointer, most likely in C code)"),
    Case.new("window-null-task", 139, "avant runtime: segmentation fault in main in a task: address 0x0 is not mapped (a null pointer, most likely in C code)"),
    Case.new("window-overflow", 1, "avant runtime: stack overflow in depth on the main thread: the calls nest too deep"),
    Case.new("window-trap", 1, "avant runtime: index 4 out of bounds (size 1)"),
    Case.new("window-term", 143, ""),
  ]
}

// The modes a program without its private directory is ended by: a
// crash, a trap and a signal stop its children all the same.
fn plain_cases: Array(Case) {
  [
    Case.new("null", 139, "avant runtime: segmentation fault in main on the main thread"),
    Case.new("overflow", 1, "avant runtime: stack overflow in depth on the main thread"),
    Case.new("trap", 1, "avant runtime: index 4 out of bounds (size 1)"),
    Case.new("term", 143, ""),
  ]
}

fn read_all(path: String): String {
  if text = fs.read(path) {
    return text
  }
  ""
}

// One case's run, in the background of the script: the program in an
// empty TMPDIR of its own (no core file: ulimit), its status, then
// whether the child it waited on is gone and what TMPDIR still holds.
fn case_lines(work: String, bin: String, name: String, mode: String): String {
  d = "${work}/${name}"
  "(mkdir -p '${d}.base' && cd '${d}.base' && ulimit -c 0 && env AVANT_KEEP_TMP= TMPDIR='${d}.base' CRASH_MODE=${mode} CRASH_OUT='${d}' '${bin}' > '${d}.out' 2> '${d}.err'; echo $? > '${d}.rc'; for f in pid pid2; do p=$(cat \"${d}.$f\" 2>/dev/null); s=x; i=0; while [ -n \"$p\" ] && [ $i -lt 100 ]; do s=$(ps -o stat= -p \"$p\" 2>/dev/null); case \"$s\" in ''|Z*) break ;; esac; i=$((i+1)); sleep 0.1; done; case \"$s\" in ''|Z*) echo gone ;; *) echo \"alive $p\"; [ -n \"$p\" ] && kill \"$p\" ;; esac; done > '${d}.child'; ls -A '${d}.base' > '${d}.left') &\n"
}

// A program that made no private directory, ended by SIGTERM or SIGINT
// with its output a file: the lines it printed are written before it
// dies by the signal.
fn plain_signal_cases(c: Checks, compiler: String, work: String) {
  src = "${work}/plain_sig.av"
  _ = fs.write(src, "lib sig_c {\n  fun kill(pid: Int32, sig: Int32): Int32\n  fun getpid: Int32\n}\n\nfn main {\n  args = process.args()\n  puts(\"start\")\n  if args[1] == \"15\" {\n    puts(sig_c.kill(sig_c.getpid(), 15))\n  } else {\n    puts(sig_c.kill(sig_c.getpid(), 2))\n  }\n}\nimport std.process\n")
  bin = "${work}/plain_sig.bin"
  c.eq_int(compile_av(compiler, src, bin, "${work}/plain_sig.clog"), 0, "the plain signal program compiles")
  for sig, code in [15: 143, 2: 130] {
    out = "${work}/plain_sig_${sig}.out"
    args = ["-c", "'${bin}' ${sig} > '${out}' 2> '${out}.err'; echo $? >> '${out}'"]
    _ = process.run("/bin/sh", args)
    c.eq_str(read_all(out), "start\n${code}\n", "a plain program ended by signal ${sig}: its output kept, status ${code}")
  }
}

fn test_crash_cleanup(c: Checks) {
  c.suite("tests/cases/test_crash_cleanup.av")
  if compiler = process.env("AVANT_COMPILER") {
    root = avant_test_root()
    work = scratch_dir()
    src = "${work}/crash.av"
    _ = fs.write(src, program(true))
    psrc = "${work}/plain.av"
    _ = fs.write(psrc, program(false))
    modes = ["--debug", "--release"]
    script = Buf.new()
    script.push_str("#!/bin/sh\n")
    for m in modes {
      bin = "${work}/crash${m}.bin"
      flags = [m, "--cc", "${root}/tests/fixtures/ffi/ffi.c"]
      c.eq_int(compile_av_flags(compiler, src, bin, "${work}/crash${m}.clog", flags), 0, "${m}: compiles")
      for k in cases() {
        script.push_str(case_lines(work, bin, "${k.mode}${m}", k.mode))
      }
      pbin = "${work}/plain${m}.bin"
      c.eq_int(compile_av_flags(compiler, psrc, pbin, "${work}/plain${m}.clog", flags), 0, "${m}: the program without its directory compiles")
      for pk in plain_cases() {
        script.push_str(case_lines(work, pbin, "plain-${pk.mode}${m}", pk.mode))
      }
    }
    script.push_str("wait\n")
    sh = "${work}/run.sh"
    _ = fs.write(sh, script.to_s())
    args = ["-k", "5", "120", "/bin/sh", sh]
    c.eq_int(process.run("timeout", args) ?? -1, 0, "the runs end")
    for m2 in modes {
      for k2 in cases() {
        d = "${work}/${k2.mode}${m2}"
        what = "${m2} ${k2.mode}"
        c.eq_str(read_all("${d}.rc").strip(), "${k2.code}", "${what}: status ${k2.code}")
        c.eq_str(read_all("${d}.out"), "start\n", "${what}: the output before the crash is kept")
        err = read_all("${d}.err")
        c.eq_str(err[0..err.size.min(k2.says.size)], k2.says, "${what}: says what crashed")
        dir = read_all("${d}.dir")
        c.expect(dir.size > 0 && !fs.exists(dir), "${what}: the private directory is removed")
        c.eq_str(read_all("${d}.left"), "", "${what}: nothing is left in TMPDIR")
        c.eq_str(read_all("${d}.child").strip(), "gone\ngone", "${what}: both children its tasks waited on are stopped")
      }
      for pk2 in plain_cases() {
        d2 = "${work}/plain-${pk2.mode}${m2}"
        what2 = "${m2} without its directory, ${pk2.mode}"
        c.eq_str(read_all("${d2}.rc").strip(), "${pk2.code}", "${what2}: status ${pk2.code}")
        c.eq_str(read_all("${d2}.out"), "start\n", "${what2}: the output before the end is kept")
        err2 = read_all("${d2}.err")
        c.eq_str(err2[0..err2.size.min(pk2.says.size)], pk2.says, "${what2}: says what ended it")
        c.expect(!fs.exists("${d2}.dir"), "${what2}: made no private directory")
        c.eq_str(read_all("${d2}.left"), "", "${what2}: nothing is left in TMPDIR")
        c.eq_str(read_all("${d2}.child").strip(), "gone\ngone", "${what2}: both children its tasks waited on are stopped")
      }
    }
    plain_signal_cases(c, compiler, work)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_crash_cleanup(c)
  c.finish()
}
