import harness
import std.json

fn churn(rounds: Int) {
  keep: Array(String) = []
  for r in 0..rounds {
    a: Array(String) = []
    for i in 0..500 {
      a.push("churn-${r}-${i}-abcdefghij0123456789")
    }
    keep.push(a[499])
    if keep.size > 20 {
      keep.clear()
    }
  }
}

// A walk is reachable only through an optional: arr and arr(key) give
// the elements of an array and nil for any other value, so a handler
// that sums {"numbers": "many"} learns that numbers is not a list. The
// walk (iter) used to give an iterator that ended at once on a string,
// a number, an object or null: a sum of 0, as for an empty list.
fn sum_numbers(body: String): String {
  doc = Json.parse(body) ?? return "not JSON"
  it = doc.arr("numbers") ?? return "not a list"
  sum = 0
  n = 0
  for v in it {
    sum += v.int() ?? 0
    n += 1
  }
  "${n} numbers, sum ${sum}"
}

fn json_walks(c: Checks) {
  c.eq_str(sum_numbers("{\"numbers\": [1, 2, 3]}"), "3 numbers, sum 6", "arr(key) walks an array member")
  c.eq_str(sum_numbers("{\"numbers\": []}"), "0 numbers, sum 0", "an empty array is an empty walk")
  c.eq_str(sum_numbers("{\"numbers\": \"many\"}"), "not a list", "arr(key) of a string is nil")
  c.eq_str(sum_numbers("{\"numbers\": 7}"), "not a list", "arr(key) of a number is nil")
  c.eq_str(sum_numbers("{\"numbers\": 7.5}"), "not a list", "arr(key) of a float is nil")
  c.eq_str(sum_numbers("{\"numbers\": {\"a\": 1, \"b\": 2}}"), "not a list", "arr(key) of an object is nil")
  c.eq_str(sum_numbers("{\"numbers\": null}"), "not a list", "arr(key) of null is nil")
  c.eq_str(sum_numbers("{\"numbers\": true}"), "not a list", "arr(key) of a Bool is nil")
  c.eq_str(sum_numbers("{\"count\": [1]}"), "not a list", "arr(key) of a missing member is nil")
  c.eq_str(sum_numbers("[1, 2]"), "not a list", "arr(key) on an array (no members) is nil")
  for text in ["\"many\"", "7", "2.5", "{\"a\": [1]}", "null", "false"] {
    if v = Json.parse(text) {
      if it = v.arr() {
        c.expect(false, "arr of ${text} is nil")
      } else {
        c.expect(true, "arr of ${text} is nil")
      }
    } else {
      c.expect(false, "parse ${text}")
    }
  }
  if v = Json.parse("[[1, 2], \"x\", [3]]") {
    it = v.arr() ?? return c.expect(false, "arr of an array")
    inner = 0
    lists = 0
    others = 0
    for e in it {
      if sub = e.arr() {
        lists += 1
        for x in sub {
          inner += x.int() ?? 0
        }
      } else {
        others += 1
      }
    }
    c.eq_int(lists, 2, "nested arrays walked")
    c.eq_int(others, 1, "the string element is not a list")
    c.eq_int(inner, 6, "nested elements summed")
  } else {
    c.expect(false, "parse nested")
  }
}

// at(i) and first read an object's members by position, as key_at(i)
// reads their names: a decoder of an object walks its members by index.
// They used to be nil on an object, as if it had no members.
fn json_positions(c: Checks) {
  doc = Json.parse("{\"a\": 1, \"b\": \"x\", \"c\": [true], \"a\": 2}") ?? return c.expect(false, "positions: parse")
  got = ""
  i = 0
  while i < doc.len() {
    k = doc.key_at(i) ?? "?"
    if v = doc.at(i) {
      got = got + " ${k}=${v.text()}"
    } else {
      got = got + " ${k}=nil"
    }
    i += 1
  }
  c.eq_str(got, " a=1 b=\"x\" c=[true] a=2", "at(i) on an object is member i's value, a repeated name too")
  if past = doc.at(4) {
    c.expect(false, "at past an object's last member is nil")
  } else {
    c.expect(true, "at past an object's last member is nil")
  }
  if neg = doc.at(-1) {
    c.expect(false, "at(-1) on an object is nil")
  } else {
    c.expect(true, "at(-1) on an object is nil")
  }
  if head = doc.first() {
    c.eq_int(head.int() ?? 0, 1, "first on an object is its first member's value")
  } else {
    c.expect(false, "first on an object is its first member's value")
  }
  for text in ["{}", "[]", "7", "\"s\"", "null"] {
    if v = Json.parse(text) {
      if e = v.at(0) {
        c.expect(false, "at(0) of ${text} is nil")
      } else {
        c.expect(true, "at(0) of ${text} is nil")
      }
      if f = v.first() {
        c.expect(false, "first of ${text} is nil")
      } else {
        c.expect(true, "first of ${text} is nil")
      }
    } else {
      c.expect(false, "positions: parse ${text}")
    }
  }
}

fn test_std_json(c: Checks) {
  c.suite("tests/cases/test_std_json.av")
  json_walks(c)
  json_positions(c)
  if doc = Json.parse("{\"n\": 7, \"name\": \"ada\", \"pi\": 3.5, \"ok\": true, \"tags\": [\"x\", \"y\"], \"point\": {\"x\": 1, \"y\": 2}, \"nothing\": null}") {
    if n = doc.int("n") {
      c.eq_int(n, 7, "int by key")
    } else {
      c.expect(false, "int by key")
    }
    if name = doc.str("name") {
      c.eq_str(name, "ada", "str by key")
    } else {
      c.expect(false, "str by key")
    }
    if pi = doc.f64("pi") {
      c.eq_int((pi * 10.0).to_i(), 35, "f64 by key")
    } else {
      c.expect(false, "f64 by key")
    }
    if ok = doc.bool("ok") {
      c.expect(ok, "bool by key")
    } else {
      c.expect(false, "bool by key")
    }
    if missing = doc.int("missing") {
      c.expect(false, "missing key is nil")
    } else {
      c.expect(true, "missing key is nil")
    }
    if wrong = doc.int("name") {
      c.expect(false, "wrong kind is nil")
    } else {
      c.expect(true, "wrong kind is nil")
    }
    if tags = doc.get("tags") {
      c.eq_int(tags.len(), 2, "array len")
      if first = tags.at(0) {
        if s = first.str() {
          c.eq_str(s, "x", "str by node")
        } else {
          c.expect(false, "str by node")
        }
      } else {
        c.expect(false, "at 0")
      }
      if oob = tags.at(9) {
        c.expect(false, "at out of range is nil")
      } else {
        c.expect(true, "at out of range is nil")
      }
    } else {
      c.expect(false, "get tags")
    }
    if point = doc.get("point") {
      if x = point.int("x") {
        c.eq_int(x, 1, "nested int")
      } else {
        c.expect(false, "nested int")
      }
      c.eq_int(point.len(), 2, "object len")
      if k0 = point.key_at(0) {
        c.eq_str(k0, "x", "key_at 0")
      } else {
        c.expect(false, "key_at 0")
      }
    } else {
      c.expect(false, "get point")
    }
    if nothing = doc.get("nothing") {
      c.expect(nothing.is_null(), "null kind")
    } else {
      c.expect(false, "get null")
    }
    value = doc.to_value()
    c.expect(value.kind == JsonKind.obj, "to_value object kind")
    if nv = value.get("n") {
      c.expect(nv.int_val == 7, "to_value int")
    } else {
      c.expect(false, "to_value int")
    }
    churn(30)
    if n2 = doc.int("n") {
      c.eq_int(n2, 7, "read after churn")
    } else {
      c.expect(false, "read after churn")
    }
  } else {
    c.expect(false, "parse object")
  }
  if bad = Json.parse("{not json") {
    c.expect(false, "invalid JSON is an error")
  } else {
    c.expect(true, "invalid JSON is an error")
  }
  if empty = Json.parse("") {
    c.expect(false, "empty input is an error")
  } else {
    c.expect(true, "empty input is an error")
  }
  built = Json.object()
  built.set("n", 7)
  built.set("name", "a\"b\\c\nd")
  built.key("tags").arr().add("x").add("y").end()
  built.key("point").obj().set("x", 1).set("y", 2).end()
  built.set("ok", true)
  built.set("pi", 3.5)
  built.set_null("nothing")
  built.end()
  if doc2 = Json.parse(built.to_s()) {
    if name2 = doc2.str("name") {
      c.eq_str(name2, "a\"b\\c\nd", "builder escapes strings")
    } else {
      c.expect(false, "builder escapes strings")
    }
    if tags2 = doc2.get("tags") {
      c.eq_int(tags2.len(), 2, "builder array")
    } else {
      c.expect(false, "builder array")
    }
    if n3 = doc2.int("n") {
      c.eq_int(n3, 7, "builder int")
    } else {
      c.expect(false, "builder int")
    }
  } else {
    c.expect(false, "parse built")
  }
  if arr = Json.parse("[10, 20, 30]") {
    if head = arr.first() {
      if hv = head.int() {
        c.eq_int(hv, 10, "first element")
      } else {
        c.expect(false, "first element")
      }
    } else {
      c.expect(false, "first element")
    }
    it = arr.arr() ?? return c.expect(false, "an array has its elements")
    total = 0
    count = 0
    walking = true
    while walking {
      if cell = it.next() {
        total = total + (cell.int() ?? 0)
        count += 1
      } else {
        walking = false
      }
    }
    c.eq_int(total, 60, "iterator sum")
    c.eq_int(count, 3, "iterator count")
    if extra = it.next() {
      c.expect(false, "iterator stays done")
    } else {
      c.expect(true, "iterator stays done")
    }
    if scalars = arr.f64s("x") {
      c.expect(false, "f64s on scalar elements is nil")
    } else {
      c.expect(true, "f64s on scalar elements is nil")
    }
  } else {
    c.expect(false, "parse array")
  }
  if objs = Json.parse("[{\"x\": 1.5}, {\"x\": 2.5}, {\"x\": 3.0}]") {
    if xs = objs.f64s("x") {
      c.eq_int(xs.size, 3, "f64s size")
      c.eq_int((xs[0] * 10.0).to_i(), 15, "f64s first")
      c.eq_int((xs[2] * 10.0).to_i(), 30, "f64s last")
    } else {
      c.expect(false, "f64s")
    }
    if badp = objs.f64s("missing") {
      c.expect(false, "f64s missing key is nil")
    } else {
      c.expect(true, "f64s missing key is nil")
    }
    if notarr = objs.int() {
      c.expect(false, "int on array is nil")
    } else {
      c.expect(true, "int on array is nil")
    }
  } else {
    c.expect(false, "parse objects")
  }
  dst = buf_new()
  dst.push_str("prefix:")
  into = JsonBuilder.into(dst)
  into.obj().set("a", 1).end()
  c.eq_str(dst.to_s(), "prefix:{\"a\":1}", "builder writes into caller Buf")
}

// What a value is, as an enum: Json.kind and
// JsonValue.kind are a JsonKind, printed by name and read by switch.
fn kind_word(k: JsonKind): String {
  switch k {
    case null { "nothing" }
    case bool, int, float { "scalar" }
    case str { "text" }
    case arr, obj { "nested" }
  }
}

fn test_json_kinds(c: Checks) {
  if doc = Json.parse("{\"a\": null, \"b\": true, \"c\": 1, \"d\": 1.5, \"e\": \"s\", \"f\": [1], \"g\": {}, \"h\": 18446744073709551615}") {
    names = ""
    words = ""
    values = ""
    for key in ["a", "b", "c", "d", "e", "f", "g", "h"] {
      if v = doc.get(key) {
        names = names + " ${v.kind()}"
        words = words + " " + kind_word(v.kind())
        values = values + " ${v.to_value().kind}"
      }
    }
    c.eq_str(names, " null bool int float str arr obj int", "Json.kind by name")
    c.eq_str(words, " nothing scalar scalar scalar text nested nested scalar", "Json.kind by switch")
    c.eq_str(values, " null bool int float str arr obj float", "JsonValue.kind: an integer beyond Int is a float")
    c.expect(doc.kind() == JsonKind.obj, "the document is an obj")
    c.eq_int(JsonKind.obj.to_i(), 7, "the runtime's codes")
    c.eq_int(JsonKind.members().size, 7, "seven kinds")
    c.expect(JsonValue.new().kind == JsonKind.null, "a new JsonValue is null")
  } else {
    c.expect(false, "parse kinds")
  }
}

// JsonValue's object members: a Hash by name, their names in the
// document's order; a repeated name keeps its first value.
fn test_json_members(c: Checks) {
  if doc = Json.parse("{\"b\": 1, \"a\": {\"c\": [1, 2]}, \"b\": 2, \"z\": \"s\"}") {
    v = doc.to_value()
    c.eq_int(v.keys.size, 3, "members: one name each")
    c.eq_str("${v.keys[0]}${v.keys[1]}${v.keys[2]}", "baz", "members: the document's order")
    c.eq_int(v.members.size, 3, "members: a Hash by name")
    if b = v.get("b") {
      c.eq_int(b.int_val, 1, "members: a repeated name keeps its first value")
    } else {
      c.expect(false, "members: get b")
    }
    if a = v.members["a"], cs = a.members["c"] {
      c.eq_int(cs.arr.size, 2, "members: a nested object's member")
    } else {
      c.expect(false, "members: the nested object")
    }
    if gone = v.get("missing") {
      c.expect(false, "members: a missing name is nil")
    }
  } else {
    c.expect(false, "members: parse")
  }
  text = Buf.new()
  text.push_str("{")
  i = 0
  while i < 3000 {
    if i > 0 {
      text.push_str(",")
    }
    text.push_str("\"k${i}\": ${i}")
    i += 1
  }
  text.push_str("}")
  if big = Json.parse(text.to_s()) {
    v = big.to_value()
    sum = 0
    i = 0
    while i < 3000 {
      if m = v.get("k${i}") {
        sum += m.int_val
      }
      i += 1
    }
    c.eq_int(sum, 4498500, "members: 3000 names found by the Hash")
    c.eq_str(v.keys[2999], "k2999", "members: the last name last")
  } else {
    c.expect(false, "members: parse the large object")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_std_json(c)
  test_json_kinds(c)
  test_json_members(c)
  c.finish()
}
