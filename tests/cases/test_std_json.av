import harness
import std.fs
import std.json
import std.process

type Json = json.Json
type JsonBuilder = json.JsonBuilder
type JsonKind = json.JsonKind
type JsonValue = json.JsonValue

fn churn(rounds: Int) {
  keep: Array(String) = []
  for r in 0..rounds {
    a: Array(String) = []
    for i in 0..500 {
      a.push("churn-${r}-${i}-abcdefghij0123456789")
    }
    keep.push(a[499])
    if keep.size > 20 {
      keep.clear()
    }
  }
}

// A walk is reachable only through an optional: arr and arr(key) give
// the elements of an array and nil for any other value, so a handler
// that sums {"numbers": "many"} learns that numbers is not a list. The
// walk (iter) used to give an iterator that ended at once on a string,
// a number, an object or null: a sum of 0, as for an empty list.
fn sum_numbers(body: String): String {
  doc = Json.parse(body) ?? return "not JSON"
  it = doc.arr("numbers") ?? return "not a list"
  sum = 0
  n = 0
  for v in it {
    sum += v.int() ?? 0
    n += 1
  }
  "${n} numbers, sum ${sum}"
}

fn json_walks(c: Checks) {
  c.eq_str(sum_numbers("{\"numbers\": [1, 2, 3]}"), "3 numbers, sum 6", "arr(key) walks an array member")
  c.eq_str(sum_numbers("{\"numbers\": []}"), "0 numbers, sum 0", "an empty array is an empty walk")
  c.eq_str(sum_numbers("{\"numbers\": \"many\"}"), "not a list", "arr(key) of a string is nil")
  c.eq_str(sum_numbers("{\"numbers\": 7}"), "not a list", "arr(key) of a number is nil")
  c.eq_str(sum_numbers("{\"numbers\": 7.5}"), "not a list", "arr(key) of a float is nil")
  c.eq_str(sum_numbers("{\"numbers\": {\"a\": 1, \"b\": 2}}"), "not a list", "arr(key) of an object is nil")
  c.eq_str(sum_numbers("{\"numbers\": null}"), "not a list", "arr(key) of null is nil")
  c.eq_str(sum_numbers("{\"numbers\": true}"), "not a list", "arr(key) of a Bool is nil")
  c.eq_str(sum_numbers("{\"count\": [1]}"), "not a list", "arr(key) of a missing member is nil")
  c.eq_str(sum_numbers("[1, 2]"), "not a list", "arr(key) on an array (no members) is nil")
  for text in ["\"many\"", "7", "2.5", "{\"a\": [1]}", "null", "false"] {
    if v = Json.parse(text) {
      if it = v.arr() {
        c.expect(false, "arr of ${text} is nil")
      } else {
        c.expect(true, "arr of ${text} is nil")
      }
    } else {
      c.expect(false, "parse ${text}")
    }
  }
  if v = Json.parse("[[1, 2], \"x\", [3]]") {
    it = v.arr() ?? return c.expect(false, "arr of an array")
    inner = 0
    lists = 0
    others = 0
    for e in it {
      if sub = e.arr() {
        lists += 1
        for x in sub {
          inner += x.int() ?? 0
        }
      } else {
        others += 1
      }
    }
    c.eq_int(lists, 2, "nested arrays walked")
    c.eq_int(others, 1, "the string element is not a list")
    c.eq_int(inner, 6, "nested elements summed")
  } else {
    c.expect(false, "parse nested")
  }
}

// at(i) and first read an object's members by position, as key_at(i)
// reads their names: a decoder of an object walks its members by index.
// They used to be nil on an object, as if it had no members.
fn json_positions(c: Checks) {
  doc = Json.parse("{\"a\": 1, \"b\": \"x\", \"c\": [true], \"a\": 2}") ?? return c.expect(false, "positions: parse")
  got = ""
  i = 0
  while i < doc.len() {
    k = doc.key_at(i) ?? "?"
    if v = doc.at(i) {
      got = got + " ${k}=${v.text()}"
    } else {
      got = got + " ${k}=nil"
    }
    i += 1
  }
  c.eq_str(got, " a=1 b=\"x\" c=[true] a=2", "at(i) on an object is member i's value, a repeated name too")
  if past = doc.at(4) {
    c.expect(false, "at past an object's last member is nil")
  } else {
    c.expect(true, "at past an object's last member is nil")
  }
  if neg = doc.at(-1) {
    c.expect(false, "at(-1) on an object is nil")
  } else {
    c.expect(true, "at(-1) on an object is nil")
  }
  if head = doc.first() {
    c.eq_int(head.int() ?? 0, 1, "first on an object is its first member's value")
  } else {
    c.expect(false, "first on an object is its first member's value")
  }
  for text in ["{}", "[]", "7", "\"s\"", "null"] {
    if v = Json.parse(text) {
      if e = v.at(0) {
        c.expect(false, "at(0) of ${text} is nil")
      } else {
        c.expect(true, "at(0) of ${text} is nil")
      }
      if f = v.first() {
        c.expect(false, "first of ${text} is nil")
      } else {
        c.expect(true, "first of ${text} is nil")
      }
    } else {
      c.expect(false, "positions: parse ${text}")
    }
  }
}

// A member is found by its name's bytes and size: a name holding a zero
// byte is not cut at it (by strlen the lookup found "a"). f64 is nil for
// anything but a number, a missing member included.
fn json_lookups(c: Checks) {
  doc = Json.parse("{\"a\\u0000b\": 1, \"a\": 2, \"s\": \"7\", \"i\": 3, \"n\": null}") ?? return c.expect(false, "lookups: parse")
  c.eq_int(doc.int("a\0b") ?? -1, 1, "a name with a zero byte is found whole")
  c.eq_int(doc.int("a") ?? -1, 2, "and the shorter name is another member")
  c.expect((doc.f64("i") ?? -1.0) == 3.0, "f64 of an integer member")
  c.expect((doc.f64("s") ?? -1.0) == -1.0, "f64 of a string is nil")
  c.expect((doc.f64("n") ?? -1.0) == -1.0, "f64 of null is nil")
  c.expect((doc.f64("missing") ?? -1.0) == -1.0, "f64 of a missing member is nil")
  c.expect((doc.f64() ?? -1.0) == -1.0, "f64 of an object is nil")
}

fn test_std_json(c: Checks) {
  c.suite("tests/cases/test_std_json.av")
  json_lookups(c)
  json_walks(c)
  json_positions(c)
  if doc = Json.parse("{\"n\": 7, \"name\": \"ada\", \"pi\": 3.5, \"ok\": true, \"tags\": [\"x\", \"y\"], \"point\": {\"x\": 1, \"y\": 2}, \"nothing\": null}") {
    if n = doc.int("n") {
      c.eq_int(n, 7, "int by key")
    } else {
      c.expect(false, "int by key")
    }
    if name = doc.str("name") {
      c.eq_str(name, "ada", "str by key")
    } else {
      c.expect(false, "str by key")
    }
    if pi = doc.f64("pi") {
      c.eq_int((pi * 10.0).to_i(), 35, "f64 by key")
    } else {
      c.expect(false, "f64 by key")
    }
    if ok = doc.bool("ok") {
      c.expect(ok, "bool by key")
    } else {
      c.expect(false, "bool by key")
    }
    if missing = doc.int("missing") {
      c.expect(false, "missing key is nil")
    } else {
      c.expect(true, "missing key is nil")
    }
    if wrong = doc.int("name") {
      c.expect(false, "wrong kind is nil")
    } else {
      c.expect(true, "wrong kind is nil")
    }
    if tags = doc.get("tags") {
      c.eq_int(tags.len(), 2, "array len")
      if first = tags.at(0) {
        if s = first.str() {
          c.eq_str(s, "x", "str by node")
        } else {
          c.expect(false, "str by node")
        }
      } else {
        c.expect(false, "at 0")
      }
      if oob = tags.at(9) {
        c.expect(false, "at out of range is nil")
      } else {
        c.expect(true, "at out of range is nil")
      }
    } else {
      c.expect(false, "get tags")
    }
    if point = doc.get("point") {
      if x = point.int("x") {
        c.eq_int(x, 1, "nested int")
      } else {
        c.expect(false, "nested int")
      }
      c.eq_int(point.len(), 2, "object len")
      if k0 = point.key_at(0) {
        c.eq_str(k0, "x", "key_at 0")
      } else {
        c.expect(false, "key_at 0")
      }
    } else {
      c.expect(false, "get point")
    }
    if nothing = doc.get("nothing") {
      c.expect(nothing.is_null(), "null kind")
    } else {
      c.expect(false, "get null")
    }
    value = doc.to_value()
    c.expect(value.kind == JsonKind.obj, "to_value object kind")
    if nv = value.get("n") {
      c.expect(nv.int_val == 7, "to_value int")
    } else {
      c.expect(false, "to_value int")
    }
    churn(30)
    if n2 = doc.int("n") {
      c.eq_int(n2, 7, "read after churn")
    } else {
      c.expect(false, "read after churn")
    }
  } else {
    c.expect(false, "parse object")
  }
  if bad = Json.parse("{not json") {
    c.expect(false, "invalid JSON is an error")
  } else {
    c.expect(true, "invalid JSON is an error")
  }
  if empty = Json.parse("") {
    c.expect(false, "empty input is an error")
  } else {
    c.expect(true, "empty input is an error")
  }
  built = Json.object()
  built.set("n", 7)
  built.set("name", "a\"b\\c\nd")
  built.key("tags").arr().add("x").add("y").end()
  built.key("point").obj().set("x", 1).set("y", 2).end()
  built.set("ok", true)
  built.set("pi", 3.5)
  built.set("nothing", nil)
  built.end()
  if doc2 = Json.parse(built.to_s()) {
    if name2 = doc2.str("name") {
      c.eq_str(name2, "a\"b\\c\nd", "builder escapes strings")
    } else {
      c.expect(false, "builder escapes strings")
    }
    if tags2 = doc2.get("tags") {
      c.eq_int(tags2.len(), 2, "builder array")
    } else {
      c.expect(false, "builder array")
    }
    if n3 = doc2.int("n") {
      c.eq_int(n3, 7, "builder int")
    } else {
      c.expect(false, "builder int")
    }
  } else {
    c.expect(false, "parse built")
  }
  if arr = Json.parse("[10, 20, 30]") {
    if head = arr.first() {
      if hv = head.int() {
        c.eq_int(hv, 10, "first element")
      } else {
        c.expect(false, "first element")
      }
    } else {
      c.expect(false, "first element")
    }
    it = arr.arr() ?? return c.expect(false, "an array has its elements")
    total = 0
    count = 0
    walking = true
    while walking {
      if cell = it.next() {
        total = total + (cell.int() ?? 0)
        count += 1
      } else {
        walking = false
      }
    }
    c.eq_int(total, 60, "iterator sum")
    c.eq_int(count, 3, "iterator count")
    if extra = it.next() {
      c.expect(false, "iterator stays done")
    } else {
      c.expect(true, "iterator stays done")
    }
  } else {
    c.expect(false, "parse array")
  }
  if objs = Json.parse("[{\"x\": 1.5}, {\"x\": 2.5}, {\"x\": 3.0}]") {
    // A numeric member of every element, by the walk: the general form.
    it = objs.arr() ?? return c.expect(false, "objects: arr")
    xs: Array(Float64) = []
    while e = it.next() {
      if x = e.f64("x") {
        xs.push(x)
      }
    }
    c.eq_int(xs.size, 3, "a member of each element")
    c.eq_int((xs[0] * 10.0).to_i(), 15, "the first element's member")
    c.eq_int((xs[2] * 10.0).to_i(), 30, "the last element's member")
    if notarr = objs.int() {
      c.expect(false, "int on array is nil")
    } else {
      c.expect(true, "int on array is nil")
    }
  } else {
    c.expect(false, "parse objects")
  }
  dst = Buf.new()
  dst.push_str("prefix:")
  into = JsonBuilder.into(dst)
  into.obj().set("a", 1).end()
  c.eq_str(dst.to_s(), "prefix:{\"a\":1}", "builder writes into caller Buf")
}

// What a value is, as an enum: Json.kind and
// JsonValue.kind are a JsonKind, printed by name and read by switch.
fn kind_word(k: JsonKind): String {
  switch k {
    case null { "nothing" }
    case bool, int, float { "scalar" }
    case str { "text" }
    case arr, obj { "nested" }
  }
}

fn test_json_kinds(c: Checks) {
  if doc = Json.parse("{\"a\": null, \"b\": true, \"c\": 1, \"d\": 1.5, \"e\": \"s\", \"f\": [1], \"g\": {}, \"h\": 18446744073709551615}") {
    names = ""
    words = ""
    values = ""
    for key in ["a", "b", "c", "d", "e", "f", "g", "h"] {
      if v = doc.get(key) {
        names = names + " ${v.kind()}"
        words = words + " " + kind_word(v.kind())
        values = values + " ${v.to_value().kind}"
      }
    }
    c.eq_str(names, " null bool int float str arr obj int", "Json.kind by name")
    c.eq_str(words, " nothing scalar scalar scalar text nested nested scalar", "Json.kind by switch")
    c.eq_str(values, " null bool int float str arr obj float", "JsonValue.kind: an integer beyond Int is a float")
    c.expect(doc.kind() == JsonKind.obj, "the document is an obj")
    c.eq_int(JsonKind.obj.to_i(), 7, "the runtime's codes")
    c.eq_int(JsonKind.members().size, 7, "seven kinds")
    c.expect(JsonValue.new().kind == JsonKind.null, "a new JsonValue is null")
  } else {
    c.expect(false, "parse kinds")
  }
}

// A JsonValue is written back by a JsonBuilder (value, add, set): the
// tree Json.to_value copies out of a document gives the document's text
// again, an object's members in their order, a repeated name once.
fn test_json_value_written(c: Checks) {
  text = "{\"n\":7,\"f\":1.5,\"s\":\"a\\\"b\",\"t\":true,\"z\":null,\"xs\":[1,[2,{}],[]],\"o\":{\"k\":\"v\"},\"big\":18446744073709551615}"
  doc = Json.parse(text) ?? return c.expect(false, "value written: parse")
  v = doc.to_value()
  b = JsonBuilder.new()
  b.value(v)
  c.eq_str(b.to_s(), "{\"n\":7,\"f\":1.5,\"s\":\"a\\\"b\",\"t\":true,\"z\":null,\"xs\":[1,[2,{}],[]],\"o\":{\"k\":\"v\"},\"big\":18446744073709552000.0}", "to_value written back (an integer beyond Int as its float)")
  dup = Json.parse("{\"a\":1,\"a\":2}") ?? return c.expect(false, "value written: parse dup")
  d = JsonBuilder.new()
  d.value(dup.to_value())
  c.eq_str(d.to_s(), "{\"a\":1}", "a repeated name written once, with its first value")
  out = Json.object()
  item = JsonValue.new()
  item.kind = JsonKind.str
  item.str_val = "x"
  out.set("one", item)
  out.key("list").arr().add(item).add(v.get("o") ?? item).end()
  out.end()
  c.eq_str(out.to_s(), "{\"one\":\"x\",\"list\":[\"x\",{\"k\":\"v\"}]}", "set and add take a JsonValue")
  hand = JsonValue.new()
  hand.kind = JsonKind.obj
  hand.members["z"] = item
  hand.members["a"] = JsonValue.new()
  h = JsonBuilder.new()
  h.value(hand)
  c.eq_str(h.to_s(), "{\"z\":\"x\",\"a\":null}", "a hand-built object written in the order of its members")
}

// to_value of a large object and a large array of containers, as an
// untrusted request body may be: each member and element is read once,
// in one pass (each used to be found again from the first, n*n/2 steps:
// 60,000 members took seconds). The members keep the document's order,
// a repeated name its first value and place, and nested values theirs.
fn test_json_value_large(c: Checks) {
  n = 60000
  t = Buf.new()
  t.push_str("{")
  for i in 0..n {
    t.push_str("\"k${i}\":[${i},{\"x\":${i}}],")
  }
  t.push_str("\"k5\":0}")
  doc = Json.parse(t.to_s()) ?? return c.expect(false, "large object: parse")
  v = doc.to_value()
  c.eq_int(v.members.size, n, "large object: one member per name")
  names = v.members.keys()
  c.eq_str("${names[0]} ${names[n - 1]}", "k0 k${n - 1}", "large object: the document's order")
  good = 0
  for i in 0..n {
    if m = v.get("k${i}"), m.arr.size == 2, m.arr[0].int_val == i, x = m.arr[1].get("x"), x.int_val == i {
      good += 1
    }
  }
  c.eq_int(good, n, "large object: every member's value, nested ones included")
  a = Buf.new()
  a.push_str("[")
  for i in 0..n {
    if i > 0 {
      a.push_str(",")
    }
    a.push_str("{\"i\":${i}}")
  }
  a.push_str("]")
  arr = Json.parse(a.to_s()) ?? return c.expect(false, "large array: parse")
  av = arr.to_value()
  c.eq_int(av.arr.size, n, "large array: every element")
  ok = 0
  for i in 0..av.arr.size {
    if e = av.arr[i].get("i"), e.int_val == i {
      ok += 1
    }
  }
  c.eq_int(ok, n, "large array: every element in order")
}

fn no_walk(w: json.JsonMembers?): Bool {
  if _ = w {
    return false
  }
  true
}

fn no_member(m: json.JsonMember?): Bool {
  if _ = m {
    return false
  }
  true
}

// Json.members: each member's name and value in the document's order, a
// repeated name given each time, nil for any value but an object; one
// step per member, so a large object's walk reads each member once.
fn test_json_member_walk(c: Checks) {
  doc = Json.parse("{\"b\": 1, \"a\": {\"c\": [1, 2], \"d\": {}}, \"b\": 2, \"z\": \"s\", \"e\": {}}") ?? return c.expect(false, "member walk: parse")
  seen = ""
  if ms = doc.members() {
    for m in ms {
      seen = seen + "${m.name}=${m.value.text()};"
    }
  } else {
    c.expect(false, "member walk: an object has members")
  }
  c.eq_str(seen, "b=1;a={\"c\":[1,2],\"d\":{}};b=2;z=\"s\";e={};", "member walk: the document's order, a repeated name each time")
  inner = ""
  if ms = doc.members("a") {
    for m in ms {
      inner = inner + "${m.name}:${m.value.len()};"
      if sub = m.value.members() {
        for x in sub {
          inner = inner + "!"
        }
      }
    }
  }
  c.eq_str(inner, "c:2;d:0;", "member walk: a nested object, an empty one walked as empty")
  empty = 0
  if ms = doc.members("e") {
    for m in ms {
      empty += 1
    }
  } else {
    empty = -1
  }
  c.eq_int(empty, 0, "member walk: an empty object has no member")
  if bare = Json.parse("{}"), ms = bare.members() {
    c.expect(no_member(ms.next()), "member walk: the empty document's walk ends at once")
  } else {
    c.expect(false, "member walk: {} is an object")
  }
  c.expect(no_walk(doc.members("b")), "member walk: nil for a number")
  c.expect(no_walk(doc.members("z")), "member walk: nil for a string")
  c.expect(no_walk(doc.members("missing")), "member walk: nil for a missing member")
  if arr = Json.parse("[{\"x\": 1}]") {
    c.expect(no_walk(arr.members()), "member walk: nil for an array")
  }
  if ms = doc.members() {
    n = 0
    while m = ms.next() {
      n += 1
    }
    c.expect(no_member(ms.next()), "member walk: nil again after the last")
    c.eq_int(n, 5, "member walk: five members")
  }
  // 60,000 members, each [i, {"x": i}], and a repeated name at the end:
  // a walk by key_at(i) and at(i) read 1.8 billion members here.
  n = 60000
  t = Buf.new()
  t.push_str("{")
  for i in 0..n {
    t.push_str("\"k${i}\":[${i},{\"x\":${i}}],")
  }
  t.push_str("\"k5\":0}")
  big = Json.parse(t.to_s()) ?? return c.expect(false, "large member walk: parse")
  good = 0
  count = 0
  last = ""
  if ms = big.members() {
    for m in ms {
      if count < n && m.name == "k${count}", first = m.value.first(), (first.int() ?? -1) == count, x = m.value.at(1), (x.int("x") ?? -1) == count {
        good += 1
      }
      last = "${m.name}=${m.value.text()}"
      count += 1
    }
  }
  c.eq_int(count, n + 1, "large member walk: every member, the repeated name too")
  c.eq_int(good, n, "large member walk: every name and value in order")
  c.eq_str(last, "k5=0", "large member walk: the repeated name last, with its own value")
}

// The readers' answers at Int's bounds and for each other kind: an
// integer read answers Int.min for "not an integer", so a real Int.min
// must read as itself, before and after a miss.
fn no_int(v: Int?): Bool {
  if _ = v {
    return false
  }
  true
}

fn no_str(v: String?): Bool {
  if _ = v {
    return false
  }
  true
}

fn no_bool(v: Bool?): Bool {
  if _ = v {
    return false
  }
  true
}

fn test_json_reader_answers(c: Checks) {
  doc = Json.parse("{\"lo\": -9223372036854775808, \"hi\": 9223372036854775807, \"over\": 9223372036854775808, \"under\": -9223372036854775809, \"f\": 1.5, \"s\": \"x\", \"t\": true, \"n\": null}") ?? return c.expect(false, "reader answers: parse")
  c.expect((doc.int("lo") ?? 0) == Int.min, "Int.min reads as itself")
  c.expect(no_int(doc.int("over")), "an integer above Int is nil")
  c.expect((doc.int("lo") ?? 0) == Int.min, "Int.min after a miss")
  c.expect(no_int(doc.int("under")), "an integer below Int is nil")
  c.expect((doc.int("hi") ?? 0) == Int.max, "Int.max")
  c.expect(no_int(doc.int("f")), "a fraction is not an Int")
  c.expect(no_int(doc.int("s")), "a string is not an Int")
  c.expect(no_int(doc.int("missing")), "a missing member is not an Int")
  if lo = doc.get("lo") {
    c.expect((lo.int() ?? 0) == Int.min, "Int.min by the value's own int")
    c.expect(no_str(lo.str()), "a number is not a String")
    c.expect(no_bool(lo.bool()), "a number is not a Bool")
  }
  c.eq_str(doc.str("s") ?? "?", "x", "a string")
  c.expect(no_str(doc.str("t")), "a Bool is not a String")
  c.expect(no_str(doc.str("n")), "null is not a String")
  c.expect(no_str(doc.str("missing")), "a missing member is not a String")
  c.expect(doc.bool("t") ?? false, "true")
  c.expect(no_bool(doc.bool("s")), "a string is not a Bool")
  c.expect(no_bool(doc.bool("n")), "null is not a Bool")
  c.expect(no_bool(doc.bool("missing")), "a missing member is not a Bool")
  c.eq_str(doc.key_at(0) ?? "?", "lo", "key_at's first name")
  c.eq_str(doc.key_at(7) ?? "?", "n", "key_at's last name")
  c.expect(no_str(doc.key_at(8)), "key_at past the last member")
  c.expect(no_str(doc.key_at(-1)), "key_at below the first member")
  if s = doc.get("s") {
    c.expect(no_str(s.key_at(0)), "key_at on a string")
  }
}

// JsonValue's object members: a Hash by name, in the document's order;
// a repeated name keeps its first value and place.
fn test_json_members(c: Checks) {
  if doc = Json.parse("{\"b\": 1, \"a\": {\"c\": [1, 2]}, \"b\": 2, \"z\": \"s\"}") {
    v = doc.to_value()
    names = v.members.keys()
    c.eq_int(names.size, 3, "members: one name each")
    c.eq_str("${names[0]}${names[1]}${names[2]}", "baz", "members: the document's order")
    c.eq_int(v.members.size, 3, "members: a Hash by name")
    if b = v.get("b") {
      c.eq_int(b.int_val, 1, "members: a repeated name keeps its first value")
    } else {
      c.expect(false, "members: get b")
    }
    if a = v.members["a"], cs = a.members["c"] {
      c.eq_int(cs.arr.size, 2, "members: a nested object's member")
    } else {
      c.expect(false, "members: the nested object")
    }
    if gone = v.get("missing") {
      c.expect(false, "members: a missing name is nil")
    }
  } else {
    c.expect(false, "members: parse")
  }
  text = Buf.new()
  text.push_str("{")
  i = 0
  while i < 3000 {
    if i > 0 {
      text.push_str(",")
    }
    text.push_str("\"k${i}\": ${i}")
    i += 1
  }
  text.push_str("}")
  if big = Json.parse(text.to_s()) {
    v = big.to_value()
    sum = 0
    i = 0
    while i < 3000 {
      if m = v.get("k${i}") {
        sum += m.int_val
      }
      i += 1
    }
    c.eq_int(sum, 4498500, "members: 3000 names found by the Hash")
    c.eq_str(v.members.keys()[2999], "k2999", "members: the last name last")
  } else {
    c.expect(false, "members: parse the large object")
  }
}

// A JsonBuilder's set, add and value take any value json.encode writes,
// written as it writes them: a struct by its pub fields, an Array, an
// optional, nil (where set_null and null were), alongside the scalars,
// a Json and another builder.
struct Pos {
  pub x: Int
  pub y: Int
}

fn test_builder_values(c: Checks) {
  maybe: Int? = nil
  b = Json.object()
  b.set("at", Pos { x: 1, y: 2 })
  b.set("path", [Pos { x: 0, y: 0 }])
  b.set("none", nil)
  b.set("maybe", maybe)
  b.set("n", 7)
  b.key("list").arr().add(1.5).add("s").add(nil).add([true]).end()
  b.end()
  c.eq_str(b.to_s(), "{\"at\":{\"x\":1,\"y\":2},\"path\":[{\"x\":0,\"y\":0}],\"none\":null,\"maybe\":null,\"n\":7,\"list\":[1.5,\"s\",null,[true]]}", "set and add take a struct, an Array, an optional and nil")
}

// The limits of a parse: max_depth (256 unless set) refuses arrays and
// objects nested deeper, at the bracket that goes past it; max_bytes and
// max_entries (none unless set) refuse a longer text or a document of
// more values (each member's name counted as one). Each is a JsonError
// naming it, never a trap; a parse used to take any depth.
fn parse_says(text: String, max_depth: Int, max_bytes: Int?, max_entries: Int?): String {
  if doc = Json.parse(text, max_depth: max_depth, max_bytes: max_bytes, max_entries: max_entries) {
    return "ok ${doc.len()}"
  } else e {
    return e.message
  }
}

fn test_json_limits(c: Checks) {
  deep = "[".repeat(300) + "]".repeat(300)
  if d = Json.parse(deep) {
    c.expect(false, "300 levels are over the default max_depth")
  } else e {
    c.eq_str(e.message, "JSON nested deeper than max_depth 256 at byte 256", "300 levels are over the default max_depth")
    c.eq_int(e.offset ?? -1, 256, "the offset of the bracket past the limit")
  }
  c.eq_str(parse_says("[".repeat(256) + "]".repeat(256), 256, nil, nil), "ok 1", "256 levels are within it")
  c.eq_str(parse_says(deep, 300, nil, nil), "ok 1", "max_depth raised")
  c.eq_str(parse_says("{\"a\": [[1]]}", 2, nil, nil), "JSON nested deeper than max_depth 2 at byte 7", "an object's member nested too deep")
  c.eq_str(parse_says("{\"a\": [1]}", 2, nil, nil), "ok 1", "an object holding an array: depth 2")
  c.eq_str(parse_says("7", 1, nil, nil), "ok 0", "a scalar has no depth")
  c.eq_str(parse_says("[1, 2, 3]", 256, nil, 3), "JSON document of 4 values is over max_entries 3", "max_entries counts the array too")
  c.eq_str(parse_says("[1, 2, 3]", 256, nil, 4), "ok 3", "within max_entries")
  c.eq_str(parse_says("{\"a\": 1}", 256, nil, 2), "JSON document of 3 values is over max_entries 2", "a member's name counts")
  c.eq_str(parse_says("[1, 2, 3]", 256, 8, nil), "JSON text of 9 bytes is over max_bytes 8", "max_bytes")
  c.eq_str(parse_says("[1, 2, 3]", 256, 9, nil), "ok 3", "within max_bytes")
  c.eq_str(parse_says("[1, 2", 256, 9, 100), "invalid JSON at byte 5: unexpected end of data", "a text within the limits that does not parse")
}

// A parse's pool is sized by yyjson's own bound and not zeroed: a
// 51-byte document's is the smallest large object, two pages (it was
// three, zeroed), and the values read back are the text's in every
// collector mode, after a large document's pages were freed (and
// poisoned, in the check modes) too.
fn test_json_pool(c: Checks) {
  if compiler = process.env("AVANT_COMPILER") {
    dir = scratch_dir()
    bin = "${dir}/json_pool.bin"
    c.eq_int(compile_av(compiler, "${avant_test_root()}/tests/fixtures/heap/json_pool.av", bin, "${dir}/json_pool.clog"), 0, "json_pool.av compiles")
    clean = "env -u AVANT_YOUNG_MB -u AVANT_HEAP_MAX_MB -u AVANT_NURSERY -u AVANT_GC_DEFRAG -u AVANT_GC_VERIFY -u AVANT_GC_STRESS -u AVANT_GC_STATS"
    // In the collector mode this file runs in (the gate runs it in each).
    out = "${dir}/json_pool"
    _ = process.run("/bin/sh", ["-c", "'${bin}' > '${out}.out' 2> '${out}.err'; echo $? > '${out}.rc'"])
    c.eq_str(fs.read("${out}.rc") ?? "", "0\n", "json_pool.av: exit 0")
    c.eq_str(fs.read("${out}.out") ?? "", "12000\n5000\n12 ada\n", "json_pool.av: the values parsed")
    c.eq_str(fs.read("${out}.err") ?? "", "", "json_pool.av: no stderr")
    st = "${dir}/json_pool.stats"
    _ = process.run("/bin/sh", ["-c", "${clean} AVANT_GC_STATS=1 '${bin}' small > /dev/null 2> '${st}'"])
    text = fs.read(st) ?? ""
    c.expect(text.contains(" los_allocs=1000 los_bytes=8192000 "), "a small document's pool is two pages, 1000 parses: ${text.size} bytes of statistics")
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_std_json(c)
  test_json_kinds(c)
  test_json_members(c)
  test_json_member_walk(c)
  test_json_reader_answers(c)
  test_json_value_large(c)
  test_json_value_written(c)
  test_json_limits(c)
  test_builder_values(c)
  test_json_pool(c)
  c.finish()
}
