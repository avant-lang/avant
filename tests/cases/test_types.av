import harness
import backends

// Stage 28 W7a: unions and T?, methods on any type, overloads, operator
// methods, generics as instantiated, and named interfaces on the new back
// end (AVANT_BACKEND=llvm, D176; stages/stage28/mir.md W7a). For every
// program of the types subset: (a) it compiles (--debug), and its
// stdout, stderr, and exit status are its run golden (tests/goldens/runs,
// frozen from the old back end at W11; until then the two back ends were
// compared, D184); (b) the program prints the same under
// AVANT_GC_VERIFY=1, under AVANT_YOUNG_MB=1, under both, and under
// AVANT_NURSERY=0, and the verifier reports nothing; for the fixtures
// with goldens, (c) `avant dump` under AVANT_BACKEND=llvm prints exactly
// tests/goldens/types/<name>.mir (D171). (d) The programs the old back
// end cannot compile (coerce.av: an expected difference, D196)
// print their known output on the new back end, plain and under the four
// GC environments.

fn golden_names: Array(String) {
  ["churn", "coerce", "generics", "generic_targs", "methods", "results", "unions", "opt_ref"]
}

// The programs with a run golden from the old back end.
fn both_progs: Array(String) {
  xs: Array(String) = []
  names = ["churn", "generics", "methods", "results", "unions", "external", "order", "self_array", "nil_tag", "try_lambda", "empty_parens", "generic_for", "generic_targs", "opt_ref"]
  i = 0
  while i < names.size {
    xs.push("tests/fixtures/types/${names[i]}.av")
    i += 1
  }
  xs.push("examples/errors.av")
  xs.push("tests/fixtures/modules/samename_main.av")
  xs.push("tests/fixtures/macros/pin_blocks.av")
  xs.push("tests/fixtures/overloading/generic.av")
  xs.push("tests/fixtures/overloading/operator.av")
  xs.push("tests/fixtures/part3/argv.av")
  xs.push("tests/fixtures/part3/env.av")
  xs.push("tests/fixtures/part3/exists.av")
  xs
}

// The programs only the new back end compiles, with their output.
fn new_progs: Array(String) {
  ["tests/fixtures/types/coerce.av"]
}

fn new_wants: Array(String) {
  ["2\nnil node\n5\n-1\ns\nnone\n7\n-1\nint 4\nnil\nint 3\nnil\noops\n0\n9\n"]
}

fn gc_envs: Array(String) {
  ["AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0"]
}

fn test_types(c: Checks, compiler: String, root: String, dir: String) {
  progs = both_progs()
  np = new_progs()
  gn = golden_names()

  // Wave 1: the compiles, and the dumps.
  jobs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, "${root}/${progs[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log"))
    i += 1
  }
  i = 0
  while i < np.size {
    k = key_of(np[i])
    jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, "${root}/${np[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log"))
    i += 1
  }
  i = 0
  while i < gn.size {
    a: Array(String) = []
    a.push("dump")
    a.push("${root}/tests/fixtures/types/${gn[i]}.av")
    jobs.push(env_job("AVANT_BACKEND=llvm", compiler, a, "${dir}/${gn[i]}.mir"))
    i += 1
  }
  run_waves(jobs)
  i = 0
  while i < progs.size {
    c.eq_int(jobs[i].code, 0, "${progs[i]}: compiles under llvm")
    i += 1
  }
  base = progs.size
  i = 0
  while i < np.size {
    c.eq_int(jobs[base + i].code, 0, "${np[i]}: compiles under llvm")
    i += 1
  }
  base += np.size
  i = 0
  while i < gn.size {
    j = jobs[base + i]
    c.eq_int(j.code, 0, "${gn[i]}: dump under llvm exits 0")
    want = "(no golden)"
    if t = file_read("${root}/tests/goldens/types/${gn[i]}.mir") {
      want = t
    }
    c.eq_str(log_text(j.log), want, "tests/fixtures/types/${gn[i]}.av: the MIR dump is tests/goldens/types/${gn[i]}.mir")
    i += 1
  }

  // Wave 2: every program, then the new ones under each GC environment.
  envs = gc_envs()
  per = 1 + envs.size
  runs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    runs.push(run_job(dir, "${k}.new", "${k}.b"))
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "${k}.new", "${k}.g${e}", envs[e]))
      e += 1
    }
    i += 1
  }
  nbase = runs.size
  i = 0
  while i < np.size {
    k = key_of(np[i])
    runs.push(run_job(dir, "${k}.new", "${k}.b"))
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "${k}.new", "${k}.g${e}", envs[e]))
      e += 1
    }
    i += 1
  }
  run_waves(runs)
  i = 0
  while i < progs.size {
    p = progs[i]
    k = key_of(p)
    want_out = golden_out(root, p)
    want_err = golden_err(root, p)
    want_code = golden_status(root, p)
    c.eq_int(runs[per * i].code, want_code, "${p}: the golden exit status")
    c.eq_str(log_text("${dir}/${k}.b.out"), want_out, "${p}: the golden stdout")
    c.eq_str(log_text("${dir}/${k}.b.err"), want_err, "${p}: the golden stderr")
    e = 0
    while e < envs.size {
      c.eq_int(runs[per * i + 1 + e].code, want_code, "${p} under ${envs[e]}: the golden exit status")
      c.eq_str(log_text("${dir}/${k}.g${e}.out"), want_out, "${p} under ${envs[e]}: the golden stdout")
      c.eq_str(log_text("${dir}/${k}.g${e}.err"), want_err, "${p} under ${envs[e]}: the golden stderr (no verifier report)")
      e += 1
    }
    i += 1
  }
  wants = new_wants()
  i = 0
  while i < np.size {
    p = np[i]
    k = key_of(p)
    at = nbase + (1 + envs.size) * i
    c.eq_int(runs[at].code, 0, "${p} (new back end only): exit 0")
    c.eq_str(log_text("${dir}/${k}.b.out"), wants[i], "${p} (new back end only): the known stdout")
    c.eq_str(log_text("${dir}/${k}.b.err"), "", "${p} (new back end only): no stderr")
    e = 0
    while e < envs.size {
      c.eq_int(runs[at + 1 + e].code, 0, "${p} under ${envs[e]}: exit 0")
      c.eq_str(log_text("${dir}/${k}.g${e}.out"), wants[i], "${p} under ${envs[e]}: the known stdout")
      c.eq_str(log_text("${dir}/${k}.g${e}.err"), "", "${p} under ${envs[e]}: no stderr (no verifier report)")
      e += 1
    }
    i += 1
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_types.av")
  if compiler = env_get("AVANT_COMPILER") {
    test_types(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
