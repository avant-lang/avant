import harness
import backends

// Stage 28 W8a: Avant's C interface on the new back end
// (AVANT_BACKEND=llvm, D176; stages/stage28/mir.md W8a): `lib`/`fun`
// calls with every conversion, `Ptr(T)`, C layouts, callbacks from C,
// pins, `--cc` and `--lib`, and the std modules that need no thread.
// (a) Every program of the ffi subset compiles (--debug, with its suite
// flags) and its stdout, stderr, and exit status are its run golden
// (tests/goldens/runs, frozen from the old back end at W11; until then
// the two back ends were compared, D184); (b) the program prints the
// same under AVANT_GC_VERIFY=1, under AVANT_YOUNG_MB=1, under
// both, and under AVANT_NURSERY=0, and the verifier reports nothing;
// (c) `avant dump` under AVANT_BACKEND=llvm prints exactly
// tests/goldens/ffi/<name>.mir (D171); (d) the programs the old back end
// gets wrong (byval.av: structs by value to C, C3; fresh.av: C20, C21;
// expected differences, D196), foreign.av (C threads calling Avant,
// Stage 28 W17b) and foreign_exit.av (C threads that call Avant and exit,
// Stage 28 W17c) print their known output on the new back end, plain and
// under the four GC environments; (e) the std module test
// programs (test_std_zlib, base64, json, regex) compiled by the new back
// end pass.

fn golden_names: Array(String) {
  ["byval", "callbacks", "calls", "fresh", "layout", "pins", "release"]
}

// The programs with a run golden from the old back end.
fn both_progs: Array(String) {
  xs: Array(String) = []
  names = ["calls", "callbacks", "layout", "pins", "http_local"]
  i = 0
  while i < names.size {
    xs.push("tests/fixtures/ffi/${names[i]}.av")
    i = i + 1
  }
  ex = ["add", "digest", "json", "layout", "sqrt", "zlib"]
  i = 0
  while i < ex.size {
    xs.push("examples/${ex[i]}.av")
    i = i + 1
  }
  xs
}

// The programs only the new back end runs correctly, with their output.
// foreign.av (Stage 28 W17b, O123): C threads calling an allocating
// callback while the main thread allocates (rule 4 of gc-design.md 4.4).
// foreign_exit.av (Stage 28 W17c, O126): waves of C threads that call an
// allocating callback and exit without unregistering, while the main
// thread collects (thread exit unregisters).
// cscalars.av (Stage 29 W1b, D64 as amended): every C scalar type as a
// `fun` parameter and result and a C layout's field, both directions.
// rereg.av (Stage 29 W1b, O70): a C thread that unregisters and calls
// back again starts with empty runtime-root slots.
// release.av (Stage 28 W16c, D266): the `release` statement on Q9's two
// cases (C keeps a pointer, C copies the struct), on fields C stored
// itself, on whole and nested structs, and in a bounded loop.
fn new_progs: Array(String) {
  ["tests/fixtures/ffi/byval.av", "tests/fixtures/ffi/fresh.av", "tests/fixtures/ffi/foreign.av", "tests/fixtures/ffi/foreign_exit.av", "tests/fixtures/ffi/rereg.av", "tests/fixtures/ffi/cscalars.av", "tests/fixtures/ffi/release.av"]
}

fn new_wants: Array(String) {
  ["42\n7\n9\n4\n6\n1\n3.25\n5\n1.5\n123\n15\n321\n5\n10\n15\n3008\n105\n11\n87615\n28\n1004\n6007890\n", "short abc\n0\n0\n1\n0\n1\n649351\n42\n0\n", "main bad: 0\ncallback bad: 0\n", "main bad: 0\ncallback bad: 0\n", "main bad: 0\nthread bad: 0\n", "-127\n127\n255\n0\n32767\n60000\n4294967295\n4294967295\n4294967296\n-128\n1.5\n100000001\n7.5\n16\n8\n12\n250 7 65535 -300 -5 4000000000 0.25\n1 9 65534 -32768 127 4294967295 1.5\n32904.5\n", "q9 pins: 3\nchurn true\nC's kept pointer reads the original: 1\nthe struct C copied reads the original: 1\nthe field reads the last value: 1\nafter release, pins: 0\nthe released field reads null from C: 1\nreleased twice, pins: 0\nchurn after release true\nnever stored: pins 0, note null 1\nC's own value kept: 1\nAvant's value overwritten by C, pins: 1\nreleased: pins 1, C's value kept 1\nstruct pins: 3\nnested released: pins 2, tag null 1, n 5\nstruct released: pins 0, name null 1, note null 1, id 9\ninside pin(s): pins 1\nafter pin(s): pins 0\nstored twice, one released: pins 1, note still reads it 1\nboth released: pins 0\na literal released: pins 0, name null 1\nbounded rounds ok: 400, pins 0\n"]
}

// release.av's bounded loop (Stage 28 W16c, D266): 400 fresh 256 KiB
// strings stored into a C field and released run under a 32 MB heap
// (without the release the program keeps them all and dies there).
fn release_envs: Array(String) {
  ["AVANT_HEAP_MAX_MB=32", "AVANT_HEAP_MAX_MB=32 AVANT_GC_VERIFY=1"]
}

// The std module tests, compiled by the new back end and run.
fn std_progs: Array(String) {
  ["tests/cases/test_std_zlib.av", "tests/cases/test_std_base64.av", "tests/cases/test_std_json.av", "tests/cases/test_std_regex.av"]
}

fn gc_envs: Array(String) {
  ["AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0"]
}

// The suite's compile flags of a program (tools/backend-diff.sh flags_of).
fn flags_of(rel: String, root: String): Array(String) {
  fl: Array(String) = []
  if str_has(rel, "tests/fixtures/ffi/") {
    fl.push("--cc")
    fl.push("${root}/tests/fixtures/ffi/ffi.c")
  } else if str_has(rel, "examples/add.av") {
    fl.push("--cc")
    fl.push("${root}/examples/c/add.c")
  } else if str_has(rel, "examples/layout.av") {
    fl.push("--cc")
    fl.push("${root}/examples/c/layout.c")
  } else if str_has(rel, "examples/zlib.av") {
    fl.push("--lib")
    fl.push("z")
  }
  fl
}

fn test_ffi_llvm(c: Checks, compiler: String, root: String, dir: String) {
  progs = both_progs()
  np = new_progs()
  sp = std_progs()
  gn = golden_names()

  // Wave 1: the compiles, and the dumps.
  jobs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    fl = flags_of(progs[i], root)
    jobs.push(compile_job_flags("AVANT_BACKEND=llvm", compiler, "${root}/${progs[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log", fl))
    i = i + 1
  }
  i = 0
  while i < np.size {
    k = key_of(np[i])
    jobs.push(compile_job_flags("AVANT_BACKEND=llvm", compiler, "${root}/${np[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log", flags_of(np[i], root)))
    i = i + 1
  }
  i = 0
  while i < sp.size {
    k = key_of(sp[i])
    jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, "${root}/${sp[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log"))
    i = i + 1
  }
  i = 0
  while i < gn.size {
    a: Array(String) = []
    a.push("dump")
    a.push("${root}/tests/fixtures/ffi/${gn[i]}.av")
    jobs.push(env_job("AVANT_BACKEND=llvm", compiler, a, "${dir}/${gn[i]}.mir"))
    i = i + 1
  }
  run_waves(jobs)
  i = 0
  while i < progs.size {
    c.eq_int(jobs[i].code, 0, "${progs[i]}: compiles under llvm")
    i = i + 1
  }
  base = progs.size
  i = 0
  while i < np.size + sp.size {
    p = ""
    if i < np.size {
      p = np[i]
    } else {
      p = sp[i - np.size]
    }
    c.eq_int(jobs[base + i].code, 0, "${p}: compiles under llvm")
    i = i + 1
  }
  base = base + np.size + sp.size
  i = 0
  while i < gn.size {
    j = jobs[base + i]
    c.eq_int(j.code, 0, "${gn[i]}: dump under llvm exits 0")
    want = "(no golden)"
    if t = file_read("${root}/tests/goldens/ffi/${gn[i]}.mir") {
      want = t
    }
    c.eq_str(log_text(j.log), want, "tests/fixtures/ffi/${gn[i]}.av: the MIR dump is tests/goldens/ffi/${gn[i]}.mir")
    i = i + 1
  }

  // Wave 2: every program, then the new ones under each GC environment.
  envs = gc_envs()
  per = 1 + envs.size
  runs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    runs.push(run_job(dir, "${k}.new", "${k}.b"))
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "${k}.new", "${k}.g${e}", envs[e]))
      e = e + 1
    }
    i = i + 1
  }
  nbase = runs.size
  i = 0
  while i < np.size {
    k = key_of(np[i])
    runs.push(run_job(dir, "${k}.new", "${k}.b"))
    e = 0
    while e < envs.size {
      runs.push(run_job_env(dir, "${k}.new", "${k}.g${e}", envs[e]))
      e = e + 1
    }
    i = i + 1
  }
  rbase = runs.size
  renvs = release_envs()
  e = 0
  while e < renvs.size {
    runs.push(run_job_env(dir, "${key_of("tests/fixtures/ffi/release.av")}.new", "${key_of("tests/fixtures/ffi/release.av")}.h${e}", renvs[e]))
    e = e + 1
  }
  sbase = runs.size
  i = 0
  while i < sp.size {
    k = key_of(sp[i])
    // From the suite's own directory, not dir: the regex test's child
    // compiles use AVANT_COMPILER, which may be relative.
    sa: Array(String) = []
    sa.push("-c")
    sa.push("exec env AVANT_ROOT=${root} ${dir}/${k}.new > ${dir}/${k}.b.out 2> ${dir}/${k}.b.err < /dev/null")
    runs.push(HJob.new("/bin/sh", sa, "${dir}/${k}.b.sh.log"))
    i = i + 1
  }
  run_waves(runs)
  i = 0
  while i < progs.size {
    p = progs[i]
    k = key_of(p)
    want_out = golden_out(root, p)
    want_err = golden_err(root, p)
    want_code = golden_status(root, p)
    c.eq_int(runs[per * i].code, want_code, "${p}: the golden exit status")
    c.eq_str(golden_view(p, log_text("${dir}/${k}.b.out")), want_out, "${p}: the golden stdout")
    c.eq_str(log_text("${dir}/${k}.b.err"), want_err, "${p}: the golden stderr")
    e = 0
    while e < envs.size {
      c.eq_int(runs[per * i + 1 + e].code, want_code, "${p} under ${envs[e]}: the golden exit status")
      c.eq_str(golden_view(p, log_text("${dir}/${k}.g${e}.out")), want_out, "${p} under ${envs[e]}: the golden stdout")
      c.eq_str(log_text("${dir}/${k}.g${e}.err"), want_err, "${p} under ${envs[e]}: the golden stderr (no verifier report)")
      e = e + 1
    }
    i = i + 1
  }
  wants = new_wants()
  i = 0
  while i < np.size {
    p = np[i]
    k = key_of(p)
    at = nbase + (1 + envs.size) * i
    c.eq_int(runs[at].code, 0, "${p} (new back end only): exit 0")
    c.eq_str(log_text("${dir}/${k}.b.out"), wants[i], "${p} (new back end only): the known stdout")
    c.eq_str(log_text("${dir}/${k}.b.err"), "", "${p} (new back end only): no stderr")
    e = 0
    while e < envs.size {
      c.eq_int(runs[at + 1 + e].code, 0, "${p} under ${envs[e]}: exit 0")
      c.eq_str(log_text("${dir}/${k}.g${e}.out"), wants[i], "${p} under ${envs[e]}: the known stdout")
      c.eq_str(log_text("${dir}/${k}.g${e}.err"), "", "${p} under ${envs[e]}: no stderr (no verifier report)")
      e = e + 1
    }
    i = i + 1
  }
  rk = key_of("tests/fixtures/ffi/release.av")
  e = 0
  while e < renvs.size {
    c.eq_int(runs[rbase + e].code, 0, "tests/fixtures/ffi/release.av under ${renvs[e]}: exit 0")
    c.eq_str(log_text("${dir}/${rk}.h${e}.out"), wants[np.size - 1], "tests/fixtures/ffi/release.av under ${renvs[e]}: the known stdout")
    c.eq_str(log_text("${dir}/${rk}.h${e}.err"), "", "tests/fixtures/ffi/release.av under ${renvs[e]}: no stderr")
    e = e + 1
  }
  i = 0
  while i < sp.size {
    c.eq_int(runs[sbase + i].code, 0, "${sp[i]} built by the llvm back end: passes")
    i = i + 1
  }
  // O138 (Stage 28 W18M): user C's root registration without its own
  // frame stops with the guard's message.
  g: Array(HJob) = []
  g.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/root_guard.av", "${dir}/root_guard", "${dir}/root_guard.log", flags_of("tests/fixtures/ffi/root_guard.av", root)))
  run_waves(g)
  c.eq_int(g[0].code, 0, "root_guard.av: compiles")
  gr: Array(HJob) = []
  gr.push(run_job_env(dir, "root_guard", "root_guard.r", ""))
  run_waves(gr)
  c.expect(gr[0].code != 0, "root_guard.av: rg_bad stops the program")
  c.expect(str_has(log_text("${dir}/root_guard.r.err"), "avant_gc_root_begin without avant_gc_enter: the innermost frame is a generated function's frame record"), "root_guard.av: the guard's message (after rg_good, with its own frame, returned 1)")
  // O145 (Stage 28 W18C): a C pointer from avant_buf_bytes kept across a
  // growth of its Buf faults under AVANT_GC_VERIFY=1 and is reported, for a
  // small Buf and a large one; plain, the program prints the same and
  // nothing else.
  bs: Array(HJob) = []
  bs.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/buf_stale.av", "${dir}/buf_stale", "${dir}/buf_stale.log", flags_of("tests/fixtures/ffi/buf_stale.av", root)))
  run_waves(bs)
  c.eq_int(bs[0].code, 0, "buf_stale.av: compiles")
  bsr: Array(HJob) = []
  bsr.push(run_job_env(dir, "buf_stale", "buf_stale.plain", "-u AVANT_GC_VERIFY"))
  bsr.push(run_job_env(dir, "buf_stale", "buf_stale.verify", "AVANT_GC_VERIFY=1"))
  run_waves(bsr)
  bs_want = "first 97 read 1 fresh 97 size 110\nfirst 97 read 1 fresh 97 size 39000\n"
  c.eq_int(bsr[0].code, 0, "buf_stale.av: exit 0")
  c.eq_str(log_text("${dir}/buf_stale.plain.out"), bs_want, "buf_stale.av: the known stdout")
  c.eq_str(log_text("${dir}/buf_stale.plain.err"), "", "buf_stale.av: no stderr")
  c.eq_int(bsr[1].code, 0, "buf_stale.av under AVANT_GC_VERIFY=1: exit 0")
  c.eq_str(log_text("${dir}/buf_stale.verify.out"), bs_want, "buf_stale.av under AVANT_GC_VERIFY=1: the known stdout")
  bs_err = log_text("${dir}/buf_stale.verify.err")
  bs_msg = "in a Buf's storage that a growth replaced after coll="
  c.eq_int(bs_err.split(bs_msg).size - 1, 2, "buf_stale.av under AVANT_GC_VERIFY=1: both stale reads reported (the small Buf and the large one)")
  c.expect(str_has(bs_err, "a pointer from avant_buf_bytes kept across a growth of its Buf"), "buf_stale.av under AVANT_GC_VERIFY=1: the report names avant_buf_bytes")
  // O134 (Stage 28 W18C): a struct C freed without `release` and a new one
  // at the same address; the values C still holds from the old struct stay
  // pinned (plain, under the stress mode's poison), and under
  // AVANT_GC_VERIFY=1 the store that found the field changed is reported.
  rr: Array(HJob) = []
  rr.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/release_reuse.av", "${dir}/release_reuse", "${dir}/release_reuse.log", flags_of("tests/fixtures/ffi/release_reuse.av", root)))
  run_waves(rr)
  c.eq_int(rr[0].code, 0, "release_reuse.av: compiles")
  rrr: Array(HJob) = []
  rr_envs = ["-u AVANT_GC_VERIFY", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1", "AVANT_GC_VERIFY=1"]
  e = 0
  while e < rr_envs.size {
    rrr.push(run_job_env(dir, "release_reuse", "release_reuse.r${e}", rr_envs[e]))
    e = e + 1
  }
  run_waves(rrr)
  rr_want = "stored again: pins 1, C's kept name reads the original 1, churn true\nreleased only: pins 2, C's kept name reads the original 1, churn true\n"
  e = 0
  while e < rr_envs.size {
    c.eq_int(rrr[e].code, 0, "release_reuse.av under '${rr_envs[e]}': exit 0")
    c.eq_str(log_text("${dir}/release_reuse.r${e}.out"), rr_want, "release_reuse.av under '${rr_envs[e]}': the known stdout (C's values from the old struct still read the original)")
    e = e + 1
  }
  c.eq_str(log_text("${dir}/release_reuse.r0.err"), "", "release_reuse.av: no stderr")
  rr_err = log_text("${dir}/release_reuse.r2.err")
  c.eq_int(rr_err.split("\n").size, 2, "release_reuse.av under AVANT_GC_VERIFY=1: one report line")
  c.expect(str_has(rr_err, "found it no longer holding the value Avant last stored there") && str_has(rr_err, "a missing `release`?"), "release_reuse.av under AVANT_GC_VERIFY=1: the store's report")
  // O125 (Stage 28 W18C): a task blocks 1.5 s in C without the native
  // transition while the main thread collects. The program is correct
  // (only slow); under AVANT_GC_VERIFY=1 with a 0.5 s bound the waiting
  // handshake reports the thread and its innermost Avant frame and keeps
  // waiting; with the default bound (10 s) it is silent.
  sj: Array(HJob) = []
  sj.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/stall.av", "${dir}/stall", "${dir}/stall.log", flags_of("tests/fixtures/ffi/stall.av", root)))
  run_waves(sj)
  c.eq_int(sj[0].code, 0, "stall.av: compiles")
  sr: Array(HJob) = []
  st_envs = ["-u AVANT_GC_VERIFY", "AVANT_GC_VERIFY=1", "AVANT_GC_VERIFY=1 AVANT_GC_VERIFY_STALL_MS=500"]
  e = 0
  while e < st_envs.size {
    sr.push(run_job_env(dir, "stall", "stall.r${e}", st_envs[e]))
    e = e + 1
  }
  run_waves(sr)
  e = 0
  while e < st_envs.size {
    c.eq_int(sr[e].code, 0, "stall.av under '${st_envs[e]}': exit 0")
    c.eq_str(log_text("${dir}/stall.r${e}.out"), "collected; the task blocked 1500 ms\n", "stall.av under '${st_envs[e]}': the known stdout")
    e = e + 1
  }
  c.eq_str(log_text("${dir}/stall.r0.err"), "", "stall.av: no stderr")
  c.eq_str(log_text("${dir}/stall.r1.err"), "", "stall.av under AVANT_GC_VERIFY=1 (the 10 s bound): no report")
  st_err = log_text("${dir}/stall.r2.err")
  c.expect(str_has(st_err, "avant gc verify: a collection has waited 0.5 s for thread ") && str_has(st_err, "to reach a safepoint; it is running, and its innermost Avant frame is a generated function's frame record") && str_has(st_err, "(the collection keeps waiting)"), "stall.av under a 0.5 s bound: the handshake's report")
  // O120 (Stage 28 W18C): one collection frees 400 large Bufs C still
  // points into; every run is held and protected, so C's reads through
  // the last 100 pointers are reported (past the old cap of 256 runs they
  // went unchecked), and the statistics line shows the 400 held runs. The
  // nursery is on and large, so one collection frees them all (with the
  // nursery off, earlier full collections free some, and a run goes back
  // at the next collection: C's read would be undefined).
  hj: Array(HJob) = []
  hj.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/held_caps.av", "${dir}/held_caps", "${dir}/held_caps.log", flags_of("tests/fixtures/ffi/held_caps.av", root)))
  run_waves(hj)
  c.eq_int(hj[0].code, 0, "held_caps.av: compiles")
  hr: Array(HJob) = []
  hr.push(run_job_env(dir, "held_caps", "held_caps.plain", "-u AVANT_GC_VERIFY"))
  hr.push(run_job_env(dir, "held_caps", "held_caps.verify", "AVANT_NURSERY=1 AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=64 AVANT_GC_STATS=1"))
  run_waves(hr)
  for e in 0..2 {
    c.eq_int(hr[e].code, 0, "held_caps.av run ${e}: exit 0")
  }
  c.eq_str(log_text("${dir}/held_caps.plain.out"), "kept 38800 read 100\n", "held_caps.av: the known stdout")
  c.eq_str(log_text("${dir}/held_caps.verify.out"), "kept 38800 read 100\n", "held_caps.av under AVANT_GC_VERIFY=1: the known stdout")
  hc_err = log_text("${dir}/held_caps.verify.err")
  c.eq_int(hc_err.split(" in a large run freed at coll=").size - 1, 32, "held_caps.av under AVANT_GC_VERIFY=1: the reads past the old cap are reported (the first 32 printed)")
  c.expect(str_has(hc_err, "verify_held_max=") && str_has(hc_err, "/400 verify_unprotected=0"), "held_caps.av under AVANT_GC_VERIFY=1: 400 runs held, none unprotected")
  // O129 (Stage 28 W18C): 64 C threads exit inside an Avant callback with a
  // user C frame (1 MiB of root slots) on their chain; the exit frees it
  // (about 64 MiB stayed resident at the base).
  xj: Array(HJob) = []
  xj.push(compile_job_flags("", compiler, "${root}/tests/fixtures/ffi/exit_inside.av", "${dir}/exit_inside", "${dir}/exit_inside.log", flags_of("tests/fixtures/ffi/exit_inside.av", root)))
  run_waves(xj)
  c.eq_int(xj[0].code, 0, "exit_inside.av: compiles")
  xr: Array(HJob) = []
  x_envs = ["-u AVANT_GC_VERIFY", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1"]
  e = 0
  while e < x_envs.size {
    xr.push(run_job_env(dir, "exit_inside", "exit_inside.r${e}", x_envs[e]))
    e = e + 1
  }
  run_waves(xr)
  e = 0
  while e < x_envs.size {
    c.eq_int(xr[e].code, 0, "exit_inside.av under '${x_envs[e]}': exit 0")
    c.eq_str(log_text("${dir}/exit_inside.r${e}.out"), "64 threads exited inside a callback; their frames freed: true\n", "exit_inside.av under '${x_envs[e]}': the frames are freed")
    c.eq_str(log_text("${dir}/exit_inside.r${e}.err"), "", "exit_inside.av under '${x_envs[e]}': no stderr")
    e = e + 1
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_ffi_llvm.av")
  if compiler = env_get("AVANT_COMPILER") {
    test_ffi_llvm(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
