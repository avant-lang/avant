import harness

fn prefix_at(s: String, at: Int, p: String): Bool {
  if at + p.size > s.size {
    return false
  }
  for j in 0..p.size {
    if s[at + j] != p[j] {
      return false
    }
  }
  true
}

// A check dump can carry the root as an absolute path in a diagnostic
// while the golden records it relative. Compare with the root spelled
// the golden's way.
fn strip_root(text: String, root: String): String {
  if root.size == 0 {
    return text
  }
  if root == "." {
    return text
  }
  prefix = "${root}/"
  out = buf_new()
  i = 0
  while i < text.size {
    if prefix_at(text, i, prefix) {
      out.push_str("./")
      i += prefix.size
    } else {
      out.push_byte(text[i])
      i += 1
    }
  }
  out.to_s
}

fn expect_file(c: Checks, got_path: String, want_path: String, msg: String, root: String) {
  if got = file_read(got_path) {
    if want = file_read(want_path) {
      c.eq_str(strip_root(got, root), want, msg)
    } else {
      c.expect(false, "read golden ${want_path}")
    }
  } else {
    c.expect(false, "read dump ${got_path}")
  }
}

fn check_layer(c: Checks, compiler: String, flag: String, src: String, golden: String, stamp: Int, key: String, root: String) {
  out = "${scratch()}/goldens-${stamp}-${key}.out"
  code = dump_layer(compiler, flag, src, out)
  c.eq_int(code, 0, "dump ${key}")
  expect_file(c, out, golden, key, root)
}

// The MIR layer (D171; the old back end's IR until Stage 28 W11).
fn dump_mir(c: Checks, compiler: String, src: String, golden: String, stamp: Int, key: String, root: String) {
  out = "${scratch()}/goldens-${stamp}-${key}.out"
  code = dump_av(compiler, src, out)
  c.eq_int(code, 0, "dump ${key}")
  expect_file(c, out, golden, key, root)
}

// Each row of tests/goldens/list.txt for this file (O355): every layer it
// names, dumped and compared with tests/goldens/STEM.<layer>. A program
// that imports std has no MIR layer: its MIR names the std files by the
// absolute path the compiler found them at (Stage 28 W11; json.av runs
// against its run golden, std.http is test_std_http_llvm.av).
fn dump_row(c: Checks, compiler: String, root: String, stamp: Int, row: GoldenRow) {
  src = "${root}/${row.src}"
  base = "${root}/tests/goldens/${row.stem}"
  kb = buf_new()
  for i in 0..row.stem.size {
    if row.stem[i] == 47 {
      kb.push_byte(45)
    } else {
      kb.push_byte(row.stem[i])
    }
  }
  key = kb.to_s
  layers = ["tok", "ast", "check"]
  flags = ["--tokens", "--ast", "--check"]
  for i in 0..layers.size {
    if row.has(layers[i]) {
      check_layer(c, compiler, flags[i], src, "${base}.${layers[i]}", stamp, "${key}-${layers[i]}", root)
    }
  }
  if row.has("mir") {
    dump_mir(c, compiler, src, "${base}.mir", stamp, "${key}-mir", root)
  }
}

// dump --check loads the program through the loader (O192, D352, Q159's
// A): an import is followed and checked, an error in an imported module
// fails the dump, and only the root file's declarations are printed.
fn check_through_loader(c: Checks, compiler: String, stamp: Int) {
  dir = "${scratch()}/goldens-${stamp}-loader"
  mkdir_p(dir)
  write_av(dir, "lmod", "pub fn lmod_value: Int {\n  41\n}\n")
  write_av(dir, "lroot", "import lmod\n\nfn main {\n  puts(lmod_value() + 1)\n}\n")
  out = "${dir}/lroot.check"
  c.eq_int(dump_layer(compiler, "--check", "${dir}/lroot.av", out), 0, "dump --check follows an import")
  got = file_read(out) ?? ""
  c.expect(str_has(got, "(fn main : Void"), "dump --check prints the root's main")
  c.expect(str_has(got, "(call lmod_value : Int)"), "dump --check types a call into the imported module")
  c.expect(!str_has(got, "(fn lmod_value"), "dump --check prints the root file only")
  write_av(dir, "lbad", "pub fn lbad_value: Int {\n  nosuch_name\n}\n")
  write_av(dir, "lroot2", "import lbad\n\nfn main {\n  puts(lbad_value())\n}\n")
  bad = "${dir}/lroot2.check"
  c.eq_int(dump_layer(compiler, "--check", "${dir}/lroot2.av", bad), 1, "dump --check fails on an error in an imported module")
  c.expect(str_has(file_read(bad) ?? "", "unknown name nosuch_name"), "dump --check reports the imported module's error")
  write_av(dir, "lroot3", "import lnone\n\nfn main {\n  puts(1)\n}\n")
  none = "${dir}/lroot3.check"
  c.eq_int(dump_layer(compiler, "--check", "${dir}/lroot3.av", none), 1, "dump --check fails on a missing import")
  c.expect(str_has(file_read(none) ?? "", "cannot find lnone.av"), "dump --check names the missing import")
}

fn test_goldens(c: Checks) {
  c.suite("tests/cases/test_goldens.av")
  if compiler = env_get("AVANT_COMPILER") {
    root = avant_test_root()
    stamp = now_ms()
    for row in golden_rows(c, "test_goldens") {
      dump_row(c, compiler, root, stamp, row)
    }
    check_through_loader(c, compiler, stamp)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_goldens(c)
  c.finish
}
