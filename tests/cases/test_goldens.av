import harness

fn expect_file(c: Checks, got_path: String, want_path: String, msg: String) {
  if got = file_read(got_path) {
    if want = file_read(want_path) {
      c.eq_str(got, want, msg)
    } else {
      c.expect(false, "read golden ${want_path}")
    }
  } else {
    c.expect(false, "read dump ${got_path}")
  }
}

fn dump_layer(c: Checks, dumper: String, flag: String, src: String, golden: String, stamp: Int, key: String) {
  out = "/tmp/avant-goldens-${stamp}-${key}.out"
  code = dump_lex(dumper, flag, src, out)
  c.eq_int(code, 0, "dump ${key}")
  expect_file(c, out, golden, key)
}

fn dump_myc(c: Checks, compiler: String, src: String, golden: String, stamp: Int, key: String) {
  out = "/tmp/avant-goldens-${stamp}-${key}.out"
  code = dump_av(compiler, src, out)
  c.eq_int(code, 0, "dump ${key}")
  expect_file(c, out, golden, key)
}

fn dump_all(c: Checks, dumper: String, compiler: String, root: String, stamp: Int, src_rel: String, stem: String, key: String) {
  src = "${root}/${src_rel}"
  base = "${root}/tests/goldens/${stem}"
  dump_layer(c, dumper, "", src, "${base}.tok", stamp, "${key}-tok")
  dump_layer(c, dumper, "--ast", src, "${base}.ast", stamp, "${key}-ast")
  dump_layer(c, dumper, "--check", src, "${base}.check", stamp, "${key}-check")
  dump_myc(c, compiler, src, "${base}.myc", stamp, "${key}-myc")
}

fn test_goldens(c: Checks) {
  c.suite("tests/cases/test_goldens.av")
  if compiler = env_get("AVANT_COMPILER") {
    root = avant_test_root()
    stamp = now_ms()
    dumper = "/tmp/avant-goldens-${stamp}-lex-dump"
    dlog = "/tmp/avant-goldens-${stamp}-lex-dump.log"
    dcode = compile_av(compiler, "${root}/compiler/lex_dump.av", dumper, dlog)
    c.eq_int(dcode, 0, "compile lex_dump")
    if file_exists(dumper) {
      chmod_x(dumper)
      dump_all(c, dumper, compiler, root, stamp, "examples/hello.av", "examples/hello", "hello")
      dump_all(c, dumper, compiler, root, stamp, "examples/fact.av", "examples/fact", "fact")
      dump_all(c, dumper, compiler, root, stamp, "examples/vec2.av", "examples/vec2", "vec2")
      dump_all(c, dumper, compiler, root, stamp, "examples/sieve.av", "examples/sieve", "sieve")
      dump_all(c, dumper, compiler, root, stamp, "examples/methods.av", "examples/methods", "methods")
      dump_all(c, dumper, compiler, root, stamp, "examples/trees.av", "examples/trees", "trees")
      dump_all(c, dumper, compiler, root, stamp, "examples/binarytrees.av", "examples/binarytrees", "binarytrees")
      dump_all(c, dumper, compiler, root, stamp, "examples/switch.av", "examples/switch", "switch")
      dump_all(c, dumper, compiler, root, stamp, "examples/defaults.av", "examples/defaults", "defaults")
      dump_all(c, dumper, compiler, root, stamp, "examples/sqrt.av", "examples/sqrt", "sqrt")
      dump_all(c, dumper, compiler, root, stamp, "examples/zlib.av", "examples/zlib", "zlib")
      dump_all(c, dumper, compiler, root, stamp, "examples/add.av", "examples/add", "add")
      dump_all(c, dumper, compiler, root, stamp, "examples/errors.av", "examples/errors", "errors")
      dump_all(c, dumper, compiler, root, stamp, "examples/collect.av", "examples/collect", "collect")
      dump_all(c, dumper, compiler, root, stamp, "examples/json.av", "examples/json", "json")
      dump_all(c, dumper, compiler, root, stamp, "examples/http.av", "examples/http", "http")
      dump_all(c, dumper, compiler, root, stamp, "examples/spawn.av", "examples/spawn", "spawn")
      dump_all(c, dumper, compiler, root, stamp, "examples/matmul.av", "examples/matmul", "matmul")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/chr.av", "part3/chr", "p3-chr")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/slice.av", "part3/slice", "p3-slice")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/index.av", "part3/index", "p3-index")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/buf.av", "part3/buf", "p3-buf")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/conv.av", "part3/conv", "p3-conv")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/exists.av", "part3/exists", "p3-exists")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/argv.av", "part3/argv", "p3-argv")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/env.av", "part3/env", "p3-env")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/interp.av", "part3/interp", "p3-interp")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/pop.av", "part3/pop", "p3-pop")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/part3/run.av", "part3/run", "p3-run")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/overloading/defaults.av", "overloading/defaults", "defaults")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/overloading/overload.av", "overloading/overload", "overload")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/overloading/operator.av", "overloading/operator", "operator")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/overloading/generic.av", "overloading/generic", "generic")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/macros/quote_fn.av", "macros/quote_fn", "quote")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/macros/splice_name.av", "macros/splice_name", "splice")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/macros/hygiene.av", "macros/hygiene", "hygiene")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/macros/fields.av", "macros/fields", "fields")
      dump_all(c, dumper, compiler, root, stamp, "tests/fixtures/macros/method.av", "macros/method", "method")
      modules_src = "${root}/tests/fixtures/modules/main.av"
      modules_golden = "${root}/tests/goldens/modules/main"
      dump_layer(c, dumper, "", modules_src, "${modules_golden}.tok", stamp, "modules-tok")
      dump_layer(c, dumper, "--ast", modules_src, "${modules_golden}.ast", stamp, "modules-ast")
      dump_myc(c, compiler, modules_src, "${modules_golden}.myc", stamp, "modules-myc")
      hello_g = "${root}/tests/goldens/hello.myc"
      hello_ex = "${root}/tests/goldens/examples/hello.myc"
      if hg = file_read(hello_g) {
        if ex = file_read(hello_ex) {
          c.eq_str(hg, ex, "hello.myc aliases examples/hello.myc")
        } else {
          c.expect(false, "read examples/hello.myc")
        }
      } else {
        c.expect(false, "read hello.myc")
      }
    } else {
      c.expect(false, "lex_dump bin")
      if err = file_read(dlog) {
        puts(err)
      }
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  c = Checks.new()
  c.started = now_ms()
  test_goldens(c)
  c.finish
}
