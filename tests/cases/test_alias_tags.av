import harness
import std.fs
import std.process

// What the LLVM emitter tells LLVM about memory and arithmetic
// (compiler/llvm/emit_core.av, ll_tbaa_tag; compiler/llvm/emit.av,
// ll_overflow). The type-based alias tags: an element access carries the
// element tag, an Array or Buf header's buffer reference and size their
// own tags, a local (an alloca, a collector's slot among them) its own,
// a class's or record's scalar field the tag of its byte offset (one
// type per offset under the object field type; a whole struct and a part
// an index reaches take the object field tag itself), and nothing else is tagged (Hash
// fields, an array's capacity, which is read atomically, raw pointers).
// A size's loads carry its range, a checked add of two values gives an
// add without signed wrap (one of a constant the intrinsic's value), and a wrapping operation keeps no such flag. Then
// the programs that store elements and fields
// while calls move their buffers and objects
// (tests/fixtures/heap/alias_moves.av, alias_fields.av) are built with
// --release, the mode whose optimizer uses these facts, and run under
// each collector mode: each output must be its run golden's.

fn tags_lines(text: String): Array(String) {
  out: Array(String) = []
  start = 0
  for i in 0..text.size {
    if text[i] == 10 {
      out.push(text[start..i])
      start = i + 1
    }
  }
  if start < text.size {
    out.push(text[start..])
  }
  out
}

// The number of lines holding both a and b.
fn tags_count(lines: Array(String), a: String, b: String): Int {
  n = 0
  for l in lines {
    if l.contains(a) && l.contains(b) {
      n += 1
    }
  }
  n
}

fn tags_array_src: String {
  "fn main {\n  flags = Array(Bool).new(100)\n  flags.fill(true)\n  step = flags.size / 50\n  k = 4\n  while k < flags.size {\n    flags[k] = false\n    k += step\n  }\n  n = 0\n  for i in 0..flags.size {\n    if flags[i] {\n      n += 1\n    }\n  }\n  xs: Array(Int) = []\n  xs.push(n)\n  puts(xs[0])\n}\n"
}

fn tags_other_src: String {
  "class Box {\n  v: Int\n\n  fn initialize(v: Int) {\n    self.v = v\n  }\n}\n\nfn main {\n  b = Box.new(1)\n  h: Hash(Int, Int) = Hash(Int, Int).new()\n  i = 0\n  while i < 10 {\n    b.v = b.v + i\n    h[i] = b.v\n    i += 1\n  }\n  puts(b.v + (h[3] ?? 0))\n}\n"
}

// A program that spawns (its module is shared), so an element store
// through another name tests the capacity word first (the frozen check).
fn tags_shared_src: String {
  "fn total(xs: Array(Int)): Int {\n  s = 0\n  for x in xs {\n    s += x\n  }\n  s\n}\n\nfn fill(ys: Array(Int), n: Int) {\n  for i in 0..n {\n    ys[i] = i\n  }\n}\n\nfn main {\n  xs = [1, 2, 3, 4]\n  h = spawn { total(xs) }\n  puts(h.join() ?? -1)\n  fill(xs, 4)\n  puts(total(xs))\n}\n"
}

// The frozen check reads an Array's capacity word with an atomic
// (monotonic) load and no tag: a task's end changes the word from
// another thread.
fn test_alias_tags_cap(c: Checks, p: AliasJobs) {
  ll = "${p.base}-shared.ll"
  c.wrote(p.wrote_shared, "write the shared probe")
  c.eq_int(p.jobs[2].code, 0, "the shared probe's .ll")
  if text = fs.read(ll) {
    lines = tags_lines(text)
    reads = 0
    atomic = 0
    tagged = 0
    for i in 0..lines.size - 1 {
      if lines[i].contains("getelementptr inbounds %\"Array(") && lines[i].contains(", i32 0, i32 2") && lines[i + 1].contains(" = load") {
        reads += 1
        if lines[i + 1].contains("load atomic i32, ptr %t") && lines[i + 1].contains(" monotonic, align 4") {
          atomic += 1
        }
        if lines[i + 1].contains("!tbaa") {
          tagged += 1
        }
      }
    }
    c.expect(reads >= 1, "the frozen check reads the capacity")
    c.eq_int(atomic, reads, "every capacity read is an atomic monotonic load")
    c.eq_int(tagged, 0, "a capacity read carries no tag")
  } else {
    c.expect(false, "read the shared probe's .ll")
  }
}

fn test_alias_tags_ll(c: Checks, p: AliasJobs) {
  ll = "${p.base}-array.ll"
  c.wrote(p.wrote_array, "write the array probe")
  c.eq_int(p.jobs[0].code, 0, "the array probe's .ll")
  if text = fs.read(ll) {
    lines = tags_lines(text)
    c.expect(text.contains("!1 = !{!\"avant alias\"}"), "the alias root")
    c.expect(text.contains("!3 = !{!2, !2, i64 0}"), "the element tag")
    c.expect(text.contains("!5 = !{!4, !4, i64 0}"), "the buffer reference tag")
    c.expect(text.contains("!7 = !{!6, !6, i64 0}"), "the size tag")
    c.expect(text.contains("!9 = !{!8, !8, i64 0}"), "the local tag")
    c.expect(tags_count(lines, "store i1 false, ptr %t", ", !tbaa !3") >= 1, "an element store carries the element tag")
    c.expect(tags_count(lines, "load i1, ptr %t", ", !tbaa !3") >= 1, "an element load carries the element tag")
    c.expect(tags_count(lines, "load ptr, ptr %t", ", !tbaa !5") >= 2, "the buffer reference's loads carry its tag")
    c.expect(tags_count(lines, "store ptr %t", ", !tbaa !5") >= 1, "the new array's buffer reference store carries its tag")
    c.expect(tags_count(lines, "load i32, ptr %t", ", !tbaa !7") >= 1, "the size's loads carry its tag")
    c.eq_int(tags_count(lines, "load i32, ptr %t", ", !tbaa !7, !range !12"), tags_count(lines, "load i32, ptr %t", ", !tbaa !7"), "every size load carries the size's range")
    c.expect(text.contains("!12 = !{i32 0, i32 -2147483648}"), "the size's range is [0, 2^31)")
    c.expect(tags_count(lines, "ptr %_", ", !tbaa !9") >= 4, "a local's accesses carry the local tag")
    c.eq_int(tags_count(lines, "ptr %_", "!tbaa") - tags_count(lines, "ptr %_", ", !tbaa !9"), 0, "a local's accesses carry no other tag")
    // A checked add of two values gives the plain add with no signed
    // wrap, after the overflow branch (k += step); one of a value and a
    // constant gives the intrinsic's own value (n += 1, the loops' steps).
    c.expect(tags_count(lines, " = add nsw i64 %t", ", %t") >= 1, "a checked add of two values is an add nsw")
    c.eq_int(tags_count(lines, " = add nsw i64 %t", "") - tags_count(lines, " = add nsw i64 %t", ", %t"), 0, "no checked add of a constant is an add nsw")
    c.expect(tags_count(lines, "@llvm.sadd.with.overflow.i64(i64 %t", ", i64 1)") >= 1, "the probe adds a constant")
    c.expect(tags_count(lines, "extractvalue { i64, i1 } %t", ", 0") >= 1, "a checked add of a constant gives the intrinsic's value")
    cap_reads = 0
    cap_tagged = 0
    for i in 0..lines.size - 1 {
      if lines[i].contains("getelementptr inbounds %\"Array(") && lines[i].contains(", i32 0, i32 2") {
        cap_reads += 1
        if lines[i + 1].contains("!tbaa") {
          cap_tagged += 1
        }
      }
    }
    c.expect(cap_reads >= 1, "the probe reaches the capacity")
    c.eq_int(cap_tagged, 0, "the capacity is not tagged")
  } else {
    c.expect(false, "read the array probe's .ll")
  }
  ll2 = "${p.base}-other.ll"
  c.wrote(p.wrote_other, "write the object and hash probe")
  c.eq_int(p.jobs[1].code, 0, "the object and hash probe's .ll")
  if text2 = fs.read(ll2) {
    lines2 = tags_lines(text2)
    // Box's one field is at byte offset 0: its tag is that offset's,
    // a type under the object field type (nodes !15 and !16).
    fields = 0
    tagged = 0
    for i in 0..lines2.size - 1 {
      if lines2[i].contains(".Box\", ptr %t") {
        fields += 1
        if lines2[i + 1].ends_with(", !tbaa !16") {
          tagged += 1
        }
      }
    }
    c.expect(fields >= 2, "the probe reaches an object's field")
    c.eq_int(tagged, fields, "each access to an object's field carries its offset's tag")
    c.expect(text2.contains("!11 = !{!10, !10, i64 0}"), "the object field tag")
    c.expect(text2.contains("!15 = !{!\"object field 0\", !10, i64 0}"), "offset 0's type, under the object field type")
    c.expect(text2.contains("!16 = !{!15, !15, i64 0}"), "offset 0's tag")
    c.eq_int(tags_count(lines2, "!tbaa", "") - tags_count(lines2, ", !tbaa !9", "") - tags_count(lines2, ", !tbaa !16", ""), 0, "only locals and object fields are tagged without an array")
  } else {
    c.expect(false, "read the object and hash probe's .ll")
  }
}

// Wrapping operations keep no flag: an add, subtract and multiply that
// wrap, with operands LLVM cannot fold, compared with an operand
// afterwards. A wrongly flagged one (nsw on `&+`) lets LLVM fold each
// compare to "no wrap".
fn tags_wrap_src: String {
  "fn main: Int {\n  n = process.args().size\n  x = 9223372036854775807 - n + 1\n  y = x &+ 1\n  if y > x {\n    puts(\"add: no wrap\")\n  } else {\n    puts(\"add: wrap\")\n  }\n  m = 4611686018427387904 + n - 1\n  z = m &* 4\n  if z > m {\n    puts(\"mul: no wrap\")\n  } else {\n    puts(\"mul: wrap\")\n  }\n  s = -9223372036854775807 - n\n  w = s &- 1\n  if w < s {\n    puts(\"sub: no wrap\")\n  } else {\n    puts(\"sub: wrap\")\n  }\n  0\n}\nimport std.process\n"
}

fn test_alias_tags_wrap(c: Checks, p: AliasJobs) {
  bin = "${p.base}-wrap"
  rlog = "${p.base}-wrap.out"
  c.wrote(p.wrote_wrap, "write the wrapping probe")
  c.eq_int(p.jobs[3].code, 0, "the wrapping probe compiles with --release")
  if !fs.exists(bin) {
    c.expect(false, "the wrapping probe's binary")
    return
  }
  c.eq_int(p.runs[0].code, 0, "the wrapping probe exits 0")
  c.eq_str(fs.read(rlog) ?? "", "add: wrap\nmul: wrap\nsub: wrap\n", "a wrapping add, multiply and subtract wrap in --release")
}

// name: alias_moves (elements), alias_fields (object fields) or
// slot_copies (frame slots read through their copies).
// The environments each fixture runs under (on top of the pass's own).
fn tags_move_envs: Array(String) {
  ["", "AVANT_GC_STRESS=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1", "AVANT_NURSERY=0", "AVANT_YOUNG_MB=1 AVANT_GC_VERIFY=1"]
}

fn tags_move_names: Array(String) {
  ["alias_moves", "alias_fields", "slot_copies"]
}

// The work of every check below, started in two waves: the three probes'
// .ll, the wrapping probe's and the three fixtures' --release compiles at
// once, then every run at once. A fixture's run under words its pass
// already sets is its plain run (env_holds): it runs once.
class AliasJobs {
  pub base: String = ""
  pub jobs: Array(HJob)
  pub runs: Array(HJob)
  // For fixture k and environment j, the index in runs of the run whose
  // output its checks read.
  pub run_of: Array(Int)
  pub wrote_array: Int | IoError = 0
  pub wrote_other: Int | IoError = 0
  pub wrote_shared: Int | IoError = 0
  pub wrote_wrap: Int | IoError = 0

  fn initialize(base: String) {
    self.base = base
    self.jobs = []
    self.runs = []
    self.run_of = []
  }
}

fn tags_start(compiler: String, stamp: Int): AliasJobs {
  root = avant_test_root()
  p = AliasJobs.new("${scratch()}/alias-tags-${stamp}")
  b = p.base
  p.wrote_array = fs.write("${b}-array.av", tags_array_src())
  p.wrote_other = fs.write("${b}-other.av", tags_other_src())
  p.wrote_shared = fs.write("${b}-shared.av", tags_shared_src())
  p.wrote_wrap = fs.write("${b}-wrap.av", tags_wrap_src())
  for n in ["array", "other", "shared"] {
    p.jobs.push(HJob.new(compiler, ["__emit-ll", "${b}-${n}.av", "${b}-${n}.ll"], "${b}-${n}.log"))
  }
  p.jobs.push(HJob.new(compiler, ["compile", "${b}-wrap.av", "${b}-wrap", "--release"], "${b}-wrap.clog"))
  for name in tags_move_names() {
    p.jobs.push(HJob.new(compiler, ["compile", "${root}/tests/fixtures/heap/${name}.av", "${b}-${name}", "--release"], "${b}-${name}.clog"))
  }
  run_jobs(p.jobs)
  if fs.exists("${b}-wrap") {
    chmod_x("${b}-wrap")
  }
  no_args: Array(String) = []
  p.runs.push(HJob.new("${b}-wrap", no_args, "${b}-wrap.out"))
  envs = tags_move_envs()
  for name in tags_move_names() {
    bin = "${b}-${name}"
    if fs.exists(bin) {
      chmod_x(bin)
    }
    plain = p.runs.size
    for j in 0..envs.size {
      if j > 0 && env_holds(envs[j]) {
        p.run_of.push(plain)
      } else {
        args: Array(String) = []
        for w in envs[j].split(" ") {
          if w.size > 0 {
            args.push(w)
          }
        }
        args.push(bin)
        p.run_of.push(p.runs.size)
        p.runs.push(HJob.new("/usr/bin/env", args, "${b}-${name}-${j}.out"))
      }
    }
  }
  run_jobs(p.runs)
  p
}

// name: alias_moves (elements), alias_fields (object fields) or
// slot_copies (frame slots read through their copies); k its place in
// tags_move_names.
fn test_alias_tags_moves(c: Checks, p: AliasJobs, k: Int, name: String) {
  root = avant_test_root()
  bin = "${p.base}-${name}"
  want = fs.read("${root}/tests/goldens/runs/fixtures/heap/${name}.out") ?? ""
  c.expect(want.size > 0, "${name}'s run golden")
  c.eq_int(p.jobs[4 + k].code, 0, "${name} compiles with --release")
  if !fs.exists(bin) {
    c.expect(false, "${name}'s binary")
    return
  }
  envs = tags_move_envs()
  for j in 0..envs.size {
    r = p.runs[p.run_of[k * envs.size + j]]
    mode = envs[j]
    if mode.size == 0 {
      mode = "the outer environment"
    }
    c.eq_int(r.code, 0, "${name} exits 0 under ${mode}")
    c.eq_str(fs.read(r.log) ?? "", want, "${name}'s output under ${mode}")
  }
}

fn test_alias_tags(c: Checks) {
  c.suite("tests/cases/test_alias_tags.av")
  if compiler = process.env("AVANT_COMPILER") {
    p = tags_start(compiler, now_ms())
    test_alias_tags_ll(c, p)
    test_alias_tags_cap(c, p)
    test_alias_tags_wrap(c, p)
    test_alias_tags_moves(c, p, 0, "alias_moves")
    test_alias_tags_moves(c, p, 1, "alias_fields")
    // The slots' register copies read again after collecting calls on
    // some paths only (heap/slot_copies.av), in --release under each mode.
    test_alias_tags_moves(c, p, 2, "slot_copies")
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_alias_tags(c)
  c.finish()
}
