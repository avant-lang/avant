import harness
import std.time

fn iso_of(text: String): String {
  if t = Time.parse_iso(text) {
    return t.iso()
  }
  "nil"
}

// std.time: the wall clock, RFC 3339 written and read (offsets,
// fractions, the calendar's edges, what is refused), the order of times
// and sleeping.
fn test_std_time(c: Checks) {
  c.suite("tests/cases/test_std_time.av")
  epoch = Time { sec: 0, nsec: 0 }
  c.eq_str(epoch.iso(), "1970-01-01T00:00:00Z", "the epoch")
  c.eq_str(Time { sec: 1, nsec: 500000000 }.iso(), "1970-01-01T00:00:01.5Z", "a half second")
  c.eq_str(Time { sec: 0, nsec: 1000 }.iso(), "1970-01-01T00:00:00.000001Z", "a microsecond")
  c.eq_str(Time { sec: 0, nsec: 999999999 }.iso(), "1970-01-01T00:00:00.999999999Z", "the last nanosecond")
  c.eq_str(Time { sec: -1, nsec: 0 }.iso(), "1969-12-31T23:59:59Z", "a second before the epoch")
  c.eq_str(Time { sec: 951782400, nsec: 0 }.iso(), "2000-02-29T00:00:00Z", "a leap day of a year divisible by 400")
  c.eq_str(Time { sec: 1794994200, nsec: 0 }.iso(), "2026-11-18T09:30:00Z", "a date of 2026")
  c.eq_str(Time { sec: 253402300799, nsec: 0 }.iso(), "9999-12-31T23:59:59Z", "the last second of year 9999")
  c.eq_str(Time { sec: -62135596800, nsec: 0 }.iso(), "0001-01-01T00:00:00Z", "year 1")
  if t = Time.parse_iso("2026-11-18T09:30:00Z") {
    c.eq_int(t.sec, 1794994200, "parse: seconds")
    c.eq_int(t.nsec, 0, "parse: no fraction")
  } else {
    c.expect(false, "parse: seconds")
  }
  c.eq_str(iso_of("2026-11-18T10:30:00+01:00"), "2026-11-18T09:30:00Z", "parse: a positive offset")
  c.eq_str(iso_of("2026-11-17T23:00:00-10:30"), "2026-11-18T09:30:00Z", "parse: a negative offset")
  c.eq_str(iso_of("2026-11-18t09:30:00.25z"), "2026-11-18T09:30:00.25Z", "parse: lower case t and z, a fraction")
  c.eq_str(iso_of("2026-11-18T09:30:00.1234567891Z"), "2026-11-18T09:30:00.123456789Z", "parse: more than nine digits are cut")
  c.eq_str(iso_of("1969-12-31T23:59:59.5Z"), "1969-12-31T23:59:59.5Z", "parse: before the epoch, with a fraction")
  c.eq_str(iso_of("2024-02-29T12:00:00Z"), "2024-02-29T12:00:00Z", "parse: a leap day")
  c.eq_str(iso_of("2023-02-29T12:00:00Z"), "nil", "parse: February 29 of a common year")
  c.eq_str(iso_of("1900-02-29T00:00:00Z"), "nil", "parse: February 29 of 1900")
  c.eq_str(iso_of("2026-13-01T00:00:00Z"), "nil", "parse: a month 13")
  c.eq_str(iso_of("2026-04-31T00:00:00Z"), "nil", "parse: April 31")
  c.eq_str(iso_of("2026-11-18T24:00:00Z"), "nil", "parse: an hour 24")
  c.eq_str(iso_of("2026-11-18T23:60:00Z"), "nil", "parse: a minute 60")
  c.eq_str(iso_of("2026-11-18T23:59:60Z"), "nil", "parse: a second 60")
  c.eq_str(iso_of("2026-11-18T09:30:00"), "nil", "parse: no zone")
  c.eq_str(iso_of("2026-11-18 09:30:00Z"), "nil", "parse: a space for T")
  c.eq_str(iso_of("2026-11-18T09:30:00.Z"), "nil", "parse: a point without digits")
  c.eq_str(iso_of("2026-11-18T09:30:00+0100"), "nil", "parse: an offset without its colon")
  c.eq_str(iso_of("2026-11-18T09:30:00Zx"), "nil", "parse: text after the zone")
  c.eq_str(iso_of("2026-1-18T09:30:00Z"), "nil", "parse: a one-digit month")
  c.eq_str(iso_of(""), "nil", "parse: empty")
  for s in [0, 1, -1, 86399, 86400, -86401, 1700000000, -2208988800, 4102444800] {
    t = Time { sec: s, nsec: 123 }
    if back = Time.parse_iso(t.iso()) {
      c.expect(back == t, "round trip at ${s}")
    } else {
      c.expect(false, "round trip at ${s}")
    }
  }
  a = Time { sec: 10, nsec: 5 }
  b = Time { sec: 10, nsec: 6 }
  e = Time { sec: 9, nsec: 999999999 }
  c.expect(a < b && e < a && !(b < a), "times are ordered by seconds, then nanoseconds")
  c.expect(a == Time { sec: 10, nsec: 5 } && a != b && a <= a && b >= a, "times compare")
  xs = [b, e, a]
  xs.sort()
  c.expect(xs[0] == e && xs[1] == a && xs[2] == b, "times sort")
  c.expect((xs.max() ?? epoch) == b, "the latest time")
  now = time.now()
  c.expect(now.sec > 1700000000 && now.nsec >= 0 && now.nsec < 1000000000, "the wall clock is after 2023")
  t0 = now_ms()
  time.sleep_ms(30)
  c.expect(now_ms() - t0 >= 30, "sleep_ms waits")
  time.sleep_ms(0)
  c.expect(time.now() >= now, "the clock went on")
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_std_time(c)
  c.finish()
}
