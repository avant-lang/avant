import harness

fn fail_log(c: Checks, log: String, msg: String) {
  c.expect(false, msg)
  if err = file_read(log) {
    puts(err)
  }
}

fn dump_args(src: String): Array(String) {
  a: Array(String) = []
  a.push("dump")
  a.push(src)
  a
}

// The compiler's fixed point (Stage 28 W9, D171): the next compiler is
// built by this one (C' from B, D' from C'), the hello golden is its MIR
// (examples/hello.mir), and the fixed point is the pre-optimization .ll
// of compiler/main.av (`avant __emit-ll`) from both, by digest. (The old
// back end's IR dumps were the fixed point until it retired at W11.)
fn fp_main_job(compiler: String, main_av: String, out: String): HJob {
  a: Array(String) = []
  a.push("__emit-ll")
  a.push(main_av)
  a.push(out)
  HJob.new(compiler, a, "${out}.log")
}

fn test_fixed_point(c: Checks) {
  c.suite("tests/cases/test_fixed_point.av")
  if gc_stress_outer() {
    c.skip("the next compiler, its fixed point and the compiler's dumps", "outer AVANT_GC_STRESS: compiler-sized jobs under a collection at every helper call; the gate checks them outside it")
    return
  }
  if compiler = env_get("AVANT_COMPILER") {
    root = avant_test_root()
    stamp = now_ms()
    hello = "${root}/examples/hello.av"
    golden = "${root}/tests/goldens/examples/hello.mir"
    ext = "ll"
    what = ".ll"
    main_av = "${root}/compiler/main.av"
    hello_b = "${scratch()}/fixed_point-${stamp}-hello-b.dump"
    hello_c = "${scratch()}/fixed_point-${stamp}-hello-c.dump"
    main_b = "${scratch()}/fixed_point-${stamp}-main-b.${ext}"
    main_c = "${scratch()}/fixed_point-${stamp}-main-c.${ext}"
    bin_c = "${scratch()}/fixed_point-${stamp}-c"
    clog = "${scratch()}/fixed_point-${stamp}-c.log"
    hlog = "${scratch()}/fixed_point-${stamp}-hello.log"

    // Two waves of concurrent work (D138). Wave 1, all with this
    // compiler: compile the next compiler, dump hello, dump the compiler.
    // (The compiler's dump under AVANT_GC_VERIFY=1 was a fourth job of
    // wave 1 until Stage 28 W16t: it is test_fixed_point_verify.av, O103.)
    // Wave 2, with the next compiler: dump hello, dump the compiler, run
    // hello. Checks are recorded afterwards in the order they always had.
    // One self-host link. Nursery is forced on so the long compile is the
    // collector proof, and --debug is the daily backend. The log is also
    // the compiler-sized DT_TEXTREL check. The compiler links the
    // in-process LLVM object (D172), as tools/letters.sh passes it.
    cenv: Array(String) = []
    cenv.push("AVANT_NURSERY=1")
    cenv.push(compiler)
    cenv.push("compile")
    cenv.push(main_av)
    cenv.push(bin_c)
    cenv.push("--debug")
    // The compiler stays on plain x86-64, as tools/letters.sh builds it
    // (O140), so the kept C equals the gate's C'.
    cenv.push("--cpu=baseline")
    cenv.push("${root}/runtime/build/avant_llvm.o")
    wave1: Array(HJob) = []
    wave1.push(HJob.new("/usr/bin/env", cenv, clog))
    wave1.push(HJob.new(compiler, dump_args(hello), hello_b))
    wave1.push(fp_main_job(compiler, main_av, main_b))
    run_jobs(wave1)
    ccode = wave1[0].code
    b_hello = wave1[1].code
    b_main = wave1[2].code

    c.eq_int(b_hello, 0, "dump hello")
    if got = file_read(hello_b) {
      if want = file_read(golden) {
        c.eq_str(got, want, "hello dump matches golden")
      } else {
        c.expect(false, "read the hello golden")
      }
    } else {
      fail_log(c, hello_b, "read hello dump")
    }

    c.eq_int(ccode, 0, "compile next compiler")
    if ccout = file_read(clog) {
      c.expect(!str_has(ccout, "DT_TEXTREL"), "compile next compiler has no TEXTREL warning")
    } else {
      c.expect(false, "compile next compiler has no TEXTREL warning")
    }
    if file_exists(bin_c) {
      chmod_x(bin_c)
      run_args: Array(String) = []
      run_args.push("run")
      run_args.push(hello)
      wave2: Array(HJob) = []
      wave2.push(HJob.new(bin_c, dump_args(hello), hello_c))
      wave2.push(fp_main_job(bin_c, main_av, main_c))
      wave2.push(HJob.new(bin_c, run_args, hlog))
      run_jobs(wave2)
      c_hello = wave2[0].code
      c_main = wave2[1].code
      hcode = wave2[2].code

      c.eq_int(c_hello, 0, "next dump hello")
      if got_c = file_read(hello_c) {
        if want = file_read(golden) {
          c.eq_str(got_c, want, "next hello dump matches golden")
        } else {
          c.expect(false, "read the hello golden")
        }
        if got_b = file_read(hello_b) {
          c.eq_str(got_c, got_b, "next hello dump matches this compiler")
        }
      } else {
        fail_log(c, hello_c, "read next hello dump")
      }

      c.eq_int(b_main, 0, "dump compiler ${what}")
      c.eq_int(c_main, 0, "next dump compiler ${what}")
      if ir_b = file_read(main_b) {
        if ir_c = file_read(main_c) {
          c.eq_str(sha256(ir_b), sha256(ir_c), "compiler ${what} digest matches next")
        } else {
          fail_log(c, main_c, "read next compiler ${what}")
        }
      } else {
        fail_log(c, main_b, "read compiler ${what}")
      }

      c.eq_int(hcode, 0, "next runs hello")
      if hout = file_read(hlog) {
        c.eq_str(hout, "Hello Avant\n", "next hello stdout")
      } else {
        c.expect(false, "read next hello stdout")
      }

      // Opt-in for gates (D138): keep this C, built by this compiler from
      // compiler/main.av, at AVANT_FIXED_POINT_KEEP, only when every check
      // passed. Internal; not a check.
      if keep = env_get("AVANT_FIXED_POINT_KEEP"), keep.size > 0 && c.failed == 0 && copy_file(bin_c, keep) != 0 {
        puts("AVANT_FIXED_POINT_KEEP: cannot copy the next compiler to ${keep}")
      }
    } else {
      fail_log(c, clog, "C bin exists")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_fixed_point(c)
  c.finish
}
