import harness
import backends
import std.process

// Per-function shape assertions on the allocation sequence
// (one assertion per property, learned from Valk's
// tests/codegen/run.sh): tests/fixtures/llvm/alloc_shape.av is emitted
// with `avant __emit-ll` (the pre-optimization .ll, the same in every
// mode) and each property is asserted on the one function that shows
// it, so a later change that regresses the shape fails here, not only
// in an instruction count. The fixture also runs (its output is
// checked), so the shapes asserted are the shapes of a correct program.
//
// The thread-local globals of the inline allocation path an unshared
// module reads (avant_gc_bump, avant_gc_limit, and avant_gc_top) and the
// ones a shared module reads (avant_gc_limit_mt, avant_gc_base,
// avant_gc_starts) are declared local-exec, and no thread-local is
// declared without a model. Neither names avant_gc_fast_ok or
// avant_gc_block, which the runtime no longer defines, nor
// avant_inline_allocs, which it no longer exports.
//
// A frame function with no root slot links no frame record
// (no %gcf, no frame-helper call): fresh_node, sum_nodes and Node.new
// here; `main` keeps its record, and so does the thunk C calls in
// tests/fixtures/ffi/first_frame.av (`check#cb`, the first-frame rule)
// while the functions it calls (`check`, `fill`) have none.
// tests/fixtures/ffi/frame_layout.av: a record holds its slot locals in
// place after { prev, desc }; desc is an inline map or a constant map's
// address; a record that is not a thread's first frame links inline.
//
// A constructor with an `initialize` and no field code
// is lowered at its call site (`pair` allocates inline and calls
// Tree.initialize, never Tree.new), and the stores of an initialize into
// its new object have no barrier test while no collecting call lies
// between the allocation and them (Tree.initialize: none; Named.initialize:
// one, the store after the string interpolation); the allocation's slow
// path barriers its result once (avant_barrier, the birth barrier).
// tests/fixtures/llvm/fresh_init.av runs both shapes under the
// collector's environments.
//
// The barrier's inline test of the holder's header flags is one
// masked compare (`and i16 flags, 0x8030`, then `icmp ugt` against 0x8000),
// not two tests and an `and` (link here).

// The text of the definition of SYM in the .ll text LL (from its `define`
// line to its closing brace), or "" when it is not defined.
fn ll_fn(ll: String, sym: String): String {
  key = "@\"${sym}\"("
  if sym == "main" {
    key = "@main("
  }
  lines = ll.split("\n")
  out = Buf.new()
  inside = false
  for line in lines {
    // a line that starts with `d`: a `define`, never a call
    if !inside && line.size > 7 && line[0] == 100 && line.contains(key) {
      inside = true
    }
    if inside {
      out.push_str(line)
      out.push_str("\n")
      if line == "}" {
        return out.to_s()
      }
    }
  }
  ""
}

fn count_of(hay: String, needle: String): Int {
  hay.split(needle).size - 1
}

fn test_alloc_shape(c: Checks, compiler: String, root: String, dir: String) {
  src = "${root}/tests/fixtures/llvm/alloc_shape.av"
  ll = "${dir}/alloc_shape.ll"
  c.eq_int(emit_ll(compiler, src, ll, "${dir}/alloc_shape.ll.log"), 0, "alloc_shape.av: __emit-ll")
  text = log_text(ll)
  c.eq_int(compile_av(compiler, src, "${dir}/alloc_shape", "${dir}/alloc_shape.log"), 0, "alloc_shape.av: compiles")
  c.eq_int(run_av_bin("${dir}/alloc_shape", "${dir}/alloc_shape.out"), 0, "alloc_shape.av: exit 0")
  c.eq_str(log_text("${dir}/alloc_shape.out"), "3\n6\npair\nn2 n1\n", "alloc_shape.av: output")

  // Local-exec thread-locals.
  for g in ["avant_gc_bump", "avant_gc_limit", "avant_gc_top"] {
    c.expect(text.contains("@${g} = external thread_local(localexec) global "), "thread-locals: @${g} is declared local-exec")
  }
  c.eq_int(count_of(text, " thread_local global "), 0, "thread-locals: no thread-local is declared without a model")
  fnode = ll_fn(text, "av.alloc_shape/Node.new")
  c.expect(fnode.contains("load ptr, ptr @avant_gc_bump") && fnode.contains("load ptr, ptr @avant_gc_limit"), "thread-locals: Node.new allocates inline (it reads the bump cursor and the limit)")

  // The inline path is
  // the limit compare, the cursor's store, the header and the zeroing. No
  // guard beside the limit (the runtime publishes a null limit when the
  // path may not run), no counter, no copy of the cursor in the block's
  // record, no start bit (an unshared module's: the runtime sets it late).
  for g in ["g_avant_shared", "avant_gc_fast_ok", "avant_gc_block", "avant_gc_base", "avant_gc_starts", "avant_gc_limit_mt", "avant_g_stats", "avant_since_gc", "avant_nursery_held", "avant_inline_allocs"] {
    c.expect(!text.contains("@${g}"), "inline path: an unshared module's .ll does not name @${g}")
  }
  c.eq_int(count_of(fnode, " = icmp "), 1, "inline path: Node.new's inline path has one compare, the cursor's new end against the limit")
  c.expect(fnode.contains(" = icmp ule i64 "), "inline path: the limit compare is unsigned at-or-below")
  c.expect(fnode.contains("call ptr @__avant_alloc_slow(") && !fnode.contains("@avant_alloc("), "slow call: Node.new's slow call is the module's __avant_alloc_slow")
  c.expect(text.contains("%s = call ptr @avant_alloc_slow(i64 %size, i32 %ty)") && text.contains("%again = icmp eq ptr %s, null") && text.contains("%bump = load ptr, ptr @avant_gc_bump, align 8"), "slow call: __avant_alloc_slow calls the runtime's avant_alloc_slow and, on its null answer, reads the cursor again for the inline allocation")
  c.expect(text.contains("define internal ptr @__avant_alloc_slow(i64 %size, i32 %ty) noinline "), "slow call: __avant_alloc_slow is one function of the module, never inlined")
  c.eq_int(count_of(fnode, " = and i1 "), 0, "inline path: Node.new's inline path joins no two conditions")
  c.eq_int(count_of(fnode, "load ptr, ptr @"), 2, "inline path: Node.new's inline path loads two globals, the cursor and the limit")
  c.eq_int(count_of(fnode, ", ptr @avant_gc_bump, align 8"), 2, "inline path: Node.new's inline path names the cursor twice, its load and its store")
  c.expect(!fnode.contains(", i64 32\n"), "inline path: Node.new's inline path keeps no copy of the cursor in the block's record (no address at offset 32)")
  c.eq_int(count_of(fnode, " = load i64, "), 0, "inline path: Node.new's inline path reads no counter and no start word")
  c.eq_int(count_of(fnode, " = lshr i64 ") + count_of(fnode, " = shl i64 "), 0, "start bits: Node.new's inline path computes no start bit")
  // A shared module's path reads its own limit and sets the start bit
  // itself (the late start bits are the single mutator's).
  ts = "${root}/tests/fixtures/threads/fresh.av"
  tll = "${dir}/threads_fresh.ll"
  c.eq_int(emit_ll(compiler, ts, tll, "${dir}/threads_fresh.ll.log"), 0, "threads/fresh.av: __emit-ll")
  ttext = log_text(tll)
  for g in ["avant_gc_bump", "avant_gc_limit_mt", "avant_gc_base", "avant_gc_starts"] {
    c.expect(ttext.contains("@${g} = external thread_local(localexec) global "), "inline path: a shared module declares @${g} local-exec")
  }
  for g in ["g_avant_shared", "avant_gc_fast_ok", "avant_gc_block", "avant_g_stats", "avant_since_gc", "avant_nursery_held", "avant_inline_allocs"] {
    c.expect(!ttext.contains("@${g}"), "inline path: a shared module's .ll does not name @${g}")
  }
  c.expect(!ttext.contains("@avant_gc_limit ") && !ttext.contains("@avant_gc_limit,"), "inline path: a shared module reads avant_gc_limit_mt, never avant_gc_limit")
  c.expect(ttext.contains("load ptr, ptr @avant_gc_starts") && ttext.contains(" = shl i64 1, "), "start bits: a shared module's inline path sets the start bit")

  // No frame record without a slot, but in a thread's first frame.
  for f in ["fresh_node", "sum_nodes", "Node.new"] {
    body = ll_fn(text, "av.alloc_shape/${f}")
    c.expect(body.size > 0, "frame records: ${f} is defined")
    c.expect(!body.contains("%gcf") && !body.contains("@__avant_frame_push") && !body.contains("@avant_gc_frame_enter"), "frame records: ${f} (no root slot) links no frame record")
  }
  mbody = ll_fn(text, "main")
  c.expect(mbody.contains("%gcf = alloca") && mbody.contains("call void @__avant_frame_push(ptr %gcf)"), "frame records: main keeps its frame record (a thread's first Avant frame)")
  ff = "${root}/tests/fixtures/ffi/first_frame.av"
  fll = "${dir}/first_frame.ll"
  c.eq_int(emit_ll(compiler, ff, fll, "${dir}/first_frame.ll.log"), 0, "first_frame.av: __emit-ll")
  ftext = log_text(fll)
  thunk = ll_fn(ftext, "av.first_frame/check#cb")
  c.expect(thunk.contains("%gcf = alloca { ptr, i64 }") && thunk.contains("call void @__avant_frame_push(ptr %gcf)"), "frame records: the C callback's thunk check#cb keeps a record with no slot (the first-frame rule)")
  for f in ["check", "fill"] {
    body = ll_fn(ftext, "av.first_frame/${f}")
    c.expect(body.size > 0 && !body.contains("%gcf"), "frame records: first_frame.av's ${f} (no root slot) links no frame record")
  }

  // The record holds its root words in place: { prev, desc } and the
  // slot locals after it, each named by its address in the record; desc
  // maps the root words inline up to 62 words, else names a constant map.
  // A function that is not a thread's first frame links and unlinks it
  // inline, with no runtime call and no test.
  fl = "${root}/tests/fixtures/ffi/frame_layout.av"
  flll = "${dir}/frame_layout.ll"
  c.eq_int(emit_ll(compiler, fl, flll, "${dir}/frame_layout.ll.log"), 0, "frame_layout.av: __emit-ll")
  ltext = log_text(flll)
  hm = ll_fn(ltext, "av.frame_layout/hold_m")
  c.expect(hm.contains("%gcf = alloca { ptr, i64, [2 x i64] }, align 8"), "frame records: hold_m's record is its header and its one slot of type M (two words) in place")
  c.expect(hm.contains("getelementptr inbounds i8, ptr %gcf, i64 16"), "frame records: hold_m's slot local is its address in the record")
  c.expect(hm.contains("store i64 5, ptr "), "frame records: hold_m's desc is the inline map 5 (word 1, M's string, is a root word)")
  c.expect(hm.contains("load ptr, ptr @avant_gc_top") && hm.contains("store volatile ptr %gcf, ptr @avant_gc_top"), "frame records: hold_m links its record inline")
  c.expect(!hm.contains("@__avant_frame_push") && !hm.contains("@__avant_frame_pop") && !hm.contains("@avant_gc_frame_enter") && !hm.contains("@avant_gc_frame_leave"), "frame records: hold_m (not a thread's first frame) calls no frame helper or runtime entry")
  hw = ll_fn(ltext, "av.frame_layout/hold_w")
  c.expect(hw.contains("%gcf = alloca { ptr, i64, [66 x i64] }, align 8"), "frame records: hold_w's record holds its W (64 words) and its M in place")
  c.expect(hw.contains("store ptr getelementptr (i8, ptr @__avant_frame_map."), "frame records: hold_w's desc names a constant map (66 words, over the inline map's 62)")
  c.expect(ltext.contains("{ i64 33, [33 x i32] [i32 1, i32 3, "), "frame records: hold_w's map lists its 33 root words")
  lm = ll_fn(ltext, "main")
  c.expect(lm.contains("call void @__avant_frame_push(ptr %gcf)") && lm.contains("call void @__avant_frame_pop(ptr %gcf)"), "frame records: main (a thread's first frame) links through the helpers")

  // The constructor at its call site, no barrier on the fresh object.
  tinit = ll_fn(text, "av.alloc_shape/Tree.initialize")
  c.expect(tinit.size > 0, "fresh stores: Tree.initialize is defined")
  c.eq_int(count_of(tinit, "@avant_barrier"), 0, "fresh stores: Tree.initialize stores into its new object with no barrier test")
  ninit = ll_fn(text, "av.alloc_shape/Named.initialize")
  c.eq_int(count_of(ninit, "call void @avant_barrier(ptr"), 1, "fresh stores: Named.initialize keeps one barrier test, the store after its collecting call")
  pbody = ll_fn(text, "av.alloc_shape/pair")
  c.expect(pbody.contains("load ptr, ptr @avant_gc_bump") && pbody.contains("call void @\"av.alloc_shape/Tree.initialize\"(") && !pbody.contains("@\"av.alloc_shape/Tree.new\""), "fresh stores: pair allocates inline and calls Tree.initialize, not Tree.new")
  c.eq_int(count_of(pbody, "call void @avant_barrier(ptr"), 1, "fresh stores: pair barriers the allocation's slow-path result once (the birth barrier)")

  // One masked compare.
  lbody = ll_fn(text, "av.alloc_shape/link")
  c.expect(lbody.contains(" = and i16 ") && lbody.contains(", -32720") && lbody.contains(" = icmp ugt i16 ") && lbody.contains(", -32768"), "barrier test: link's barrier test is flags & 0x8030 compared above 0x8000")
  c.eq_int(count_of(lbody, " = and i16 "), 1, "barrier test: link's barrier test has one mask, not two")
  c.eq_int(count_of(lbody, " = and i1 "), 0, "barrier test: link's barrier test joins no two conditions")

  // The fresh exemption at run time, plainly and under the collector's environments.
  fsrc = "${root}/tests/fixtures/llvm/fresh_init.av"
  c.eq_int(compile_av(compiler, fsrc, "${dir}/fresh_init", "${dir}/fresh_init.log"), 0, "fresh_init.av: compiles")
  fenvs = ["", "AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  for i in 0..fenvs.size {
    runs.push(run_job_env(dir, "fresh_init", "fresh_init.e${i}", fenvs[i]))
  }
  run_waves(runs)
  for i in 0..fenvs.size {
    what = "plain"
    if fenvs[i].size > 0 {
      what = "under ${fenvs[i]}"
    }
    c.eq_int(runs[i].code, 0, "fresh_init.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/fresh_init.e${i}.out"), "chains 100 1800378890\ntrees 81880\n", "fresh_init.av ${what}: the known stdout")
    c.eq_str(log_text("${dir}/fresh_init.e${i}.err"), "", "fresh_init.av ${what}: no stderr (no verifier report)")
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_alloc_shape.av")
  if compiler = process.env("AVANT_COMPILER") {
    test_alloc_shape(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
