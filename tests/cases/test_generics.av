import harness

struct Pair(A, B) {
  a: A
  b: B

  fn first: A {
    a
  }
}

class Box(T) {
  value: T

  fn initialize(value: T) {
    self.value = value
  }

  fn get: T {
    value
  }

  fn map(f: fn(T): U): Box(U) {
    Box.new(f(value))
  }
}

fn (b: Box(T)) len: Int {
  1
}

class Link(T) {
  value: T
  next: Link(T)?

  fn initialize(value: T) {
    self.value = value
  }
}

struct Hold(T) {
  xs: Array(T)
}

struct Node(T) {
  xs: Array(Node(T))
}

struct Tag(T) {
}

fn take(p: Pair(Int, String)): Int {
  p.a
}

fn bump(p: Pair(Int, Int)): Pair(Int, Int) {
  Pair { a: p.a + 1, b: p.b }
}

fn test_generics(c: Checks) {
  c.suite("tests/cases/test_generics.av")
  p = Pair { a: 1, b: "x" }
  c.eq_int(p.first, 1, "inferred pair")
  c.eq_str(p.b, "x", "pair string")
  q = Pair(Int, String) { a: 2, b: "y" }
  c.eq_int(q.a, 2, "explicit pair")
  nested = Pair { a: 3, b: Pair { a: 4, b: "z" } }
  c.eq_int(nested.a, 3, "nested outer")
  c.eq_int(nested.b.a, 4, "nested inner")
  c.eq_str(nested.b.b, "z", "nested string")
  c.eq_int(take(Pair { a: 5, b: "q" }), 5, "expected type fills args")
  b = Box.new(7)
  c.eq_int(b.get, 7, "box get")
  c.eq_int(b.len, 1, "external method")
  mapped = b.map { |n| n + 10 }
  c.eq_int(mapped.get, 17, "map block")
  named: fn(Int): Int = { |n| n + 1 }
  mapped2 = b.map(named)
  c.eq_int(mapped2.get, 8, "map fn value")
  s = Box.new("hi")
  c.eq_str(s.get, "hi", "box string")
  link = Link.new(3)
  c.eq_int(link.value, 3, "recursive class")
  h = Hold { xs: [8, 9] }
  c.eq_int(h.xs[0], 8, "array field 0")
  c.eq_int(h.xs[1], 9, "array field 1")
  node = Node(Int) { xs: [] }
  c.eq_int(node.xs.size, 0, "array of self is finite")
  tag = Tag(Int) { }
  c.eq_int(1, 1, "empty generic struct")
  left = Pair { a: 1, b: 2 }
  right = bump(left)
  c.eq_int(left.a, 1, "struct original")
  c.eq_int(right.a, 2, "struct copy")
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_generics(c)
  c.finish
}
