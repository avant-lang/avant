struct StdItem {
  key: Int
  tag: Int
}

fn std_expect_err(c: Checks, compiler: String, stamp: Int, tag: String, body: String, needle: String) {
  src = "/tmp/avant-wavee-${stamp}-${tag}.av"
  bin = "/tmp/avant-wavee-${stamp}-${tag}.bin"
  log = "/tmp/avant-wavee-${stamp}-${tag}.log"
  dummy = file_write(src, body)
  code = compile_av(compiler, src, bin, log)
  c.expect(code != 0, "${tag} exits non-zero")
  if err = file_read(log) {
    c.expect(str_has(err, needle), "${tag} reports ${needle}")
  } else {
    c.expect(false, "${tag} log readable")
  }
}

fn test_stdlib(c: Checks) {
  c.suite("tests/cases/stdlib.av")

  ints: Array(Int) = [5, 1, 4, 1, 3]
  ints.sort
  c.eq_int(ints[0], 1, "sort Int lo")
  c.eq_int(ints[4], 5, "sort Int hi")

  i64s: Array(Int64) = [9i64, 2i64, 5i64]
  i64s.sort
  c.eq_int(i64s[0].to_i, 2, "sort Int64 lo")
  c.eq_int(i64s[2].to_i, 9, "sort Int64 hi")

  u64s: Array(UInt64) = [9u64, 2u64, 5u64]
  u64s.sort
  c.eq_int(u64s[0].to_i, 2, "sort UInt64 lo")
  c.eq_int(u64s[2].to_i, 9, "sort UInt64 hi")

  floats: Array(Float64) = [3.5, 1.25, 2.75]
  floats.sort
  c.expect(floats[0] == 1.25, "sort Float64 lo")
  c.expect(floats[2] == 3.5, "sort Float64 hi")

  nan_arr: Array(Float64) = [2.0, 0.0 / 0.0, 1.0]
  nan_arr.sort
  c.expect(nan_arr[0] == 1.0, "sort Float64 NaN first sorted")
  c.expect(nan_arr[2] != nan_arr[2], "sort Float64 NaN last")

  words: Array(String) = ["pear", "apple", "fig"]
  words.sort
  c.eq_str(words[0], "apple", "sort String lo")
  c.eq_str(words[2], "pear", "sort String hi")

  bools: Array(Bool) = [true, false, true, false]
  bools.sort
  c.expect(!bools[0], "sort Bool lo")
  c.expect(bools[3], "sort Bool hi")

  orig: Array(Int) = [3, 1, 2]
  cp = orig.sorted
  c.eq_int(cp[0], 1, "sorted lo")
  c.eq_int(cp[2], 3, "sorted hi")
  c.eq_int(orig[0], 3, "sorted leaves original")

  items: Array(StdItem) = [StdItem { key: 3, tag: 30 }, StdItem { key: 1, tag: 10 }, StdItem { key: 2, tag: 20 }]
  items.sort { |a, b| a.key < b.key }
  c.eq_int(items[0].tag, 10, "sort comparator lo")
  c.eq_int(items[2].tag, 30, "sort comparator hi")

  rev: Array(Int) = [1, 2, 3]
  rev.reverse
  c.eq_int(rev[0], 3, "reverse lo")
  c.eq_int(rev[2], 1, "reverse hi")

  c.expect(ints.contains(4), "contains hit")
  c.expect(!ints.contains(9), "contains miss")
  if ix = ints.index_of(4) {
    c.eq_int(ix, 3, "index_of hit")
  } else {
    c.expect(false, "index_of hit")
  }
  if miss_ix = ints.index_of(9) {
    c.expect(false, "index_of miss is nil")
  } else {
    c.expect(true, "index_of miss is nil")
  }
  if mn = ints.min {
    c.eq_int(mn, 1, "min")
  } else {
    c.expect(false, "min")
  }
  if mx = ints.max {
    c.eq_int(mx, 5, "max")
  } else {
    c.expect(false, "max")
  }
  c.eq_int(ints.sum, 14, "sum Int")

  empty: Array(Int) = []
  if empty_mn = empty.min {
    c.expect(false, "min empty is nil")
  } else {
    c.expect(true, "min empty is nil")
  }
  c.eq_int(empty.sum, 0, "sum empty")

  parts = "a,,b,".split(",")
  c.eq_int(parts.size, 4, "split keeps empties size")
  c.eq_str(parts[0], "a", "split 0")
  c.eq_str(parts[1], "", "split empty field")
  c.eq_str(parts[3], "", "split trailing empty")

  csv = "one, two,three".split(", ")
  c.eq_int(csv.size, 2, "split multi-char size")
  c.eq_str(csv[0], "one", "split multi-char 0")

  flds = "  alpha  beta\tgamma\n".fields()
  c.eq_int(flds.size, 3, "fields size")
  c.eq_str(flds[0], "alpha", "fields 0")
  c.eq_str(flds[2], "gamma", "fields 2")
  c.eq_int("   ".fields().size, 0, "fields empty")

  c.eq_str("  hello \t\n".strip(), "hello", "strip")
  c.eq_str("  hello  ".strip_left(), "hello  ", "strip_left")
  c.eq_str("  hello  ".strip_right(), "  hello", "strip_right")
  c.eq_str("hello".strip(), "hello", "strip identity")

  h = Hash(String, Int).new
  h["b"] = 2
  h["a"] = 1
  c.expect(h.has_key("a"), "has_key hit")
  c.expect(!h.has_key("z"), "has_key miss")
  c.eq_int(h.get_or("z", 42), 42, "get_or miss")
  c.eq_int(h.get_or("a", 42), 1, "get_or hit")
  c.eq_int(h.inc("a"), 2, "inc existing")
  c.eq_int(h.inc("c", 5), 5, "inc new with amount")
  c.eq_int(h.keys.size, 3, "keys size")
  c.eq_int(h.values.sum, 9, "values sum")
  each_sum = 0
  each_n = 0
  h.each { |k, v| each_sum = each_sum + v
    each_n = each_n + 1 }
  c.eq_int(each_sum, 9, "hash each sum")
  c.eq_int(each_n, 3, "hash each count")

  hi = Hash(Int, Int).new
  hi[3] = 30
  hi[1] = 10
  c.eq_int(hi.keys.sorted[0], 1, "hash Int keys sorted")
  c.expect(hi.has_key(3), "hash Int has_key")
  c.eq_int(hi.inc(3, 2), 32, "hash Int inc")

  raw = "hello".bytes
  c.eq_int(raw.size, 5, "Bytes size")
  c.eq_int(raw[0], 104, "Bytes index")
  if bv = raw.get(1) {
    c.eq_int(bv, 101, "Bytes get")
  } else {
    c.expect(false, "Bytes get")
  }
  if oob = raw.get(9) {
    c.expect(false, "Bytes get oob nil")
  } else {
    c.expect(true, "Bytes get oob nil")
  }
  c.eq_int(raw.slice(1, 3)[0], 101, "Bytes slice")
  if s = String.from_utf8(raw) {
    c.eq_str(s, "hello", "from_utf8 valid")
  } else {
    c.expect(false, "from_utf8 valid")
  }

  bad_buf = buf_new()
  bad_buf.push_byte(104)
  bad_buf.push_byte(255)
  bad = bad_buf.to_bytes
  if bad_s = String.from_utf8(bad) {
    c.expect(false, "from_utf8 invalid nil")
  } else {
    c.expect(true, "from_utf8 invalid nil")
  }

  bb = buf_new()
  bb.push_bytes("hi".bytes)
  bb.push_byte(33)
  c.eq_str(bb.to_s, "hi!", "Buf push_bytes")
  c.eq_int(bb.to_bytes.size, 3, "Buf to_bytes size")
  c.eq_str("hi".bytes.to_buf.to_s, "hi", "Bytes to_buf")

  same_a = "same".bytes
  same_b = "same".bytes
  c.expect(same_a == same_b, "Bytes equality")
  c.expect(same_a != "diff".bytes, "Bytes inequality")

  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    std_expect_err(c, compiler, stamp, "sort-unsorted", "struct P {\n  x: Int\n}\nfn main {\n  xs: Array(P) = [P { x: 1 }]\n  xs.sort\n}\n", "Array.sort needs an ordered element type or a comparator block")
    std_expect_err(c, compiler, stamp, "sum-string", "fn main {\n  xs: Array(String) = [\"a\"]\n  puts(xs.sum)\n}\n", "Array.sum needs a numeric element type")
  }
}
