import harness
import backends
import std.fs
import std.process

// Bounds facts against every way an array's size, or an index, can
// change. An index the checker proves in range (`while i < xs.size {
// ... xs[i] ... }`) is read without its check, so the proof must end
// wherever the size may have changed. Each program here read a stale
// element, past the size or before the start, before the fix: it must
// compile, end with a failure and say which index.
//   - a pop or clear through another name for the same array; a call, a
//     method or a type's own method (`equals`, `compare`, `hash`, `to_s`)
//     given something that can lead to the array; a lambda made before
//     the loop; a call earlier in the same statement, in the loop's
//     condition, in an inner loop, an each block or a switch arm; a size
//     kept in a variable, a for loop over a range of the size; a Buf; a
//     popped class element
//   - a size relation after either side is assigned anew; an index or a
//     size updated with `+=` or `-=`; an index set to `n - 3`
//   - a lambda's body run after the loop; an index a lambda assigns
//   - a case binding that hides the array's name
//   - an index assigned in a switch arm or a value block
//   - kept: loops whose calls cannot reach the array (a function of an
//     Int, a push onto another array, a method of a class without such
//     an array) print what they should with no bounds check in main.

class BCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  // 3 compiles and traps, 4 kept: runs and main has no bounds check.
  pub kind: Int = 0
}

fn traps(tag: String, src: String, needle: String): BCase {
  f = BCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.kind = 3
  f
}

fn kept(tag: String, src: String, out: String): BCase {
  f = BCase.new()
  f.tag = tag
  f.src = src
  f.want = out
  f.kind = 4
  f
}

fn cases: Array(BCase) {
  xs: Array(BCase) = []
  xs.push(traps("call-through-another-name", "class Box {\n  pub xs: Array(Int) = []\n}\n\nfn drain(b: Box) {\n  b.xs.clear()\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  xs = b.xs\n  i = 0\n  total = 0\n  while i < xs.size {\n    drain(b)\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("pop-or-clear-through-a-copy", "fn main {\n  xs = [10, 11, 12, 13]\n  ys = xs\n  i = 0\n  total = 0\n  while i < xs.size {\n    ys.clear()\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("array-given-to-a-function", "fn empty(a: Array(Int)) {\n  a.clear()\n}\n\nfn main {\n  xs = [10, 11, 12, 13]\n  i = 0\n  total = 0\n  while i < xs.size {\n    empty(xs)\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("method-of-the-holder", "class Box {\n  pub xs: Array(Int) = []\n\n  fn drain {\n    self.xs.clear()\n  }\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  xs = b.xs\n  i = 0\n  total = 0\n  while i < xs.size {\n    b.drain()\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("lambda-made-before-the-loop", "fn main {\n  xs = [10, 11, 12, 13]\n  ys = xs\n  f = { || ys.clear() }\n  i = 0\n  total = 0\n  while i < xs.size {\n    f()\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("call-earlier-in-the-statement", "fn take(a: Array(Int)): Int {\n  a.clear()\n  1\n}\n\nfn main {\n  xs = [10, 11, 12, 13]\n  i = 0\n  total = 0\n  while i < xs.size {\n    total += take(xs) + xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("inner-loop-next-iteration", "fn main {\n  xs = [10, 11, 12, 13]\n  i = 3\n  total = 0\n  while i < xs.size {\n    j = 0\n    while j < 3 {\n      total += xs[i]\n      _ = xs.pop()\n      j += 1\n    }\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 3 out of bounds (size 3)"))
  xs.push(traps("size-in-a-variable-then-cleared", "fn main {\n  xs = [10, 11, 12, 13]\n  n = xs.size\n  xs.clear()\n  i = 0\n  total = 0\n  while i < n {\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("for-over-the-size", "class Box {\n  pub xs: Array(Int) = []\n}\n\nfn drain(b: Box) {\n  b.xs.clear()\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  xs = b.xs\n  total = 0\n  for i in 0..xs.size {\n    drain(b)\n    total += xs[i]\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("condition-that-shrinks", "fn shrink(a: Array(Int)): Bool {\n  a.clear()\n  true\n}\n\nfn main {\n  xs = [10, 11, 12, 13]\n  i = 0\n  total = 0\n  while i < xs.size && shrink(xs) {\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("lambda-body-after-the-loop", "fn main {\n  xs = [10, 11, 12, 13]\n  i = 0\n  f = { || 0 }\n  while i < xs.size {\n    if i == 3 {\n      f = { || xs[i] }\n    }\n    i += 1\n  }\n  xs.clear()\n  puts(\"read past the size: \${f()}\")\n}\n", "index 4 out of bounds (size 0)"))
  xs.push(traps("index-a-lambda-assigns", "fn main {\n  xs = [10, 11, 12, 13]\n  i = 0\n  back = { || i -= 1000 }\n  total = 0\n  while i < xs.size {\n    total += xs[i]\n    if i == 1 {\n      back()\n    }\n    i += 1\n  }\n  puts(\"read below the start: \${total}\")\n}\n", "index -998 out of bounds (size 4)"))
  xs.push(traps("each-block-next-iteration", "class Box {\n  pub xs: Array(Int) = []\n}\n\nfn drain(b: Box) {\n  b.xs.clear()\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  xs = b.xs\n  total = 0\n  i = 3\n  while i < xs.size {\n    [1, 2, 3].each { |y|\n      total += xs[i] + y\n      drain(b)\n    }\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 3 out of bounds (size 0)"))
  xs.push(traps("if-guard-then-call", "class Box {\n  pub xs: Array(Int) = []\n}\n\nfn drain(b: Box) {\n  b.xs.clear()\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  xs = b.xs\n  i = 2\n  if i < xs.size {\n    drain(b)\n    puts(\"read past the size: \${xs[i]}\")\n  }\n}\n", "index 2 out of bounds (size 0)"))
  xs.push(traps("buf-through-its-holder", "class Holder {\n  pub b: Buf = Buf.new()\n}\n\nfn reset(h: Holder) {\n  h.b.clear()\n}\n\nfn main {\n  h = Holder.new()\n  h.b.push_byte(65)\n  h.b.push_byte(66)\n  h.b.push_byte(67)\n  bb = h.b\n  i = 0\n  total = 0\n  while i < bb.size {\n    reset(h)\n    total += bb[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("popped-class-element", "class Node {\n  pub v: Int = 0\n}\n\nclass Box {\n  pub ns: Array(Node) = []\n}\n\nfn drain(b: Box) {\n  _ = b.ns.pop()\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..3 {\n    n = Node.new()\n    n.v = k + 10\n    b.ns.push(n)\n  }\n  ns = b.ns\n  i = 0\n  total = 0\n  while i < ns.size {\n    if i == 2 {\n      drain(b)\n    }\n    total += ns[i].v\n    i += 1\n  }\n  puts(\"read a popped slot: \${total}\")\n}\n", "index 2 out of bounds (size 2)"))
  xs.push(traps("interpolation-runs-to_s", "class Box {\n  pub xs: Array(Int) = []\n\n  fn to_s: String {\n    self.xs.clear()\n    \"box\"\n  }\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  xs = b.xs\n  i = 0\n  total = 0\n  while i < xs.size {\n    puts(\"\${b}\")\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("container-assigned-after-its-size", "fn main {\n  xs = [10, 11, 12, 13]\n  n = xs.size\n  xs = [20]\n  i = 0\n  total = 0\n  while i < n {\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 1 out of bounds (size 1)"))
  xs.push(traps("lambda-body-outer-range", "fn main {\n  k = 5\n  f = { || k * k }\n  k = 4611686018427387904\n  puts(\"overflowed: \${f()}\")\n}\n", "integer overflow"))
  xs.push(traps("size-variable-assigned-anew", "fn main {\n  n = 2\n  xs = Array(Int).new(n)\n  n = 6\n  i = 0\n  total = 0\n  while i < n {\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 2 out of bounds (size 2)"))
  xs.push(traps("size-variable-updated", "fn main {\n  n = 2\n  xs = Array(Int).new(n)\n  n += 4\n  i = 0\n  total = 0\n  while i < n {\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 2 out of bounds (size 2)"))
  xs.push(traps("index-decreased", "fn main {\n  xs = [10, 11, 12, 13]\n  i = 0\n  i -= 3\n  total = 0\n  while i < xs.size {\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read below the start: \${total}\")\n}\n", "index -3 out of bounds (size 4)"))
  xs.push(traps("index-set-below-zero", "fn main {\n  xs = [10, 11, 12, 13]\n  n = 0\n  i = n - 3\n  total = 0\n  while i < xs.size {\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read below the start: \${total}\")\n}\n", "index -3 out of bounds (size 4)"))
  xs.push(traps("switch-arm-clears", "fn main {\n  xs = [10, 11, 12, 13]\n  ys = xs\n  i = 0\n  total = 0\n  while i < xs.size {\n    v = switch i {\n      case 1 {\n        ys.clear()\n        xs[i]\n      }\n      else {\n        xs[i]\n      }\n    }\n    total += v\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 1 out of bounds (size 0)"))
  xs.push(traps("struct-eq-runs-a-method", "class Box {\n  pub xs: Array(Int) = []\n}\n\nstruct Key {\n  b: Box\n\n  fn equals(other: Key): Bool {\n    self.b.xs.clear()\n    true\n  }\n\n  fn hash(h: Hasher) {\n    h.add(1)\n  }\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  xs = b.xs\n  k1 = Key { b: b }\n  i = 0\n  total = 0\n  while i < xs.size {\n    if k1 == k1 {\n      total += xs[i]\n    }\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("sort-runs-a-method", "class Box {\n  pub xs: Array(Int) = []\n}\n\nclass Item {\n  pub b: Box\n  pub v: Int = 0\n\n  fn initialize(b: Box, v: Int) {\n    self.b = b\n    self.v = v\n  }\n\n  fn compare(other: Item): Int {\n    self.b.xs.clear()\n    self.v - other.v\n  }\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  items = [Item.new(b, 2), Item.new(b, 1)]\n  xs = b.xs\n  i = 0\n  total = 0\n  while i < xs.size {\n    items.sort()\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("hash-key-runs-a-method", "class Box {\n  pub xs: Array(Int) = []\n}\n\nstruct Key {\n  b: Box\n\n  fn equals(other: Key): Bool {\n    true\n  }\n\n  fn hash(h: Hasher) {\n    self.b.xs.clear()\n    h.add(1)\n  }\n}\n\nfn main {\n  b = Box.new()\n  for k in 0..4 {\n    b.xs.push(k + 10)\n  }\n  xs = b.xs\n  tbl = Hash(Key, Int).new()\n  key = Key { b: b }\n  i = 0\n  total = 0\n  while i < xs.size {\n    tbl[key] = i\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("switch-arm-assigns-the-index", "fn main {\n  xs = [10, 11, 12, 13]\n  k = 1\n  i = 0\n  v = switch k {\n    case 1 {\n      i = 0 - 3\n      0\n    }\n    else {\n      1\n    }\n  }\n  total = v\n  while i < xs.size {\n    total += xs[i]\n    i += 1\n  }\n  puts(\"read below the start: \${total}\")\n}\n", "index -3 out of bounds (size 4)"))
  xs.push(traps("value-block-assigns-the-index", "fn main {\n  xs = [10, 11, 12, 13]\n  i = 0\n  ok = [1].any { |y|\n    i = 0 - 3\n    y > 0\n  }\n  total = 0\n  if ok {\n    while i < xs.size {\n      total += xs[i]\n      i += 1\n    }\n  }\n  puts(\"read below the start: \${total}\")\n}\n", "index -3 out of bounds (size 4)"))
  xs.push(traps("case-binding-hides-the-array", "fn pick(n: Int): Array(Int) | String {\n  if n > 0 {\n    return [1]\n  }\n  \"none\"\n}\n\nfn main {\n  xs = [10, 11, 12, 13]\n  i = 3\n  total = 0\n  while i < xs.size {\n    switch pick(1) {\n      case xs: Array(Int) {\n        total += xs[i]\n      }\n      case s: String {\n        total += s.size\n      }\n    }\n    i += 1\n  }\n  puts(\"read past the size: \${total}\")\n}\n", "index 3 out of bounds (size 1)"))
  xs.push(kept("plain-calls-keep-the-proof", "fn sq(n: Int): Int {\n  n * n\n}\n\nfn main {\n  xs = [10, 11, 12, 13]\n  ys: Array(Int) = []\n  names = [\"a\"]\n  i = 0\n  total = 0\n  while i < xs.size {\n    total += sq(xs[i])\n    ys.push(xs[i])\n    names.clear()\n    total += xs[i]\n    i += 1\n  }\n  puts(total)\n}\n", "580\n"))
  xs.push(kept("calls-that-reach-no-such-array", "class Counter {\n  pub n: Int = 0\n  pub name: String = \"\"\n\n  fn bump(k: Int) {\n    self.n += k\n  }\n}\n\nfn weigh(xs: Array(String), k: Int): Int {\n  xs.size + k\n}\n\nfn main {\n  xs = [10, 11, 12, 13]\n  words = [\"a\", \"b\"]\n  c = Counter.new()\n  total = 0\n  for i in 0..xs.size {\n    c.bump(xs[i])\n    total += weigh(words, xs[i])\n    puts(\"\${c.n} \${xs[i]}\")\n  }\n  puts(total)\n}\n", "10 10\n21 11\n33 12\n46 13\n54\n"))
  xs
}

fn has_prefix(s: String, p: String): Bool {
  s.size >= p.size && str_slice(s, 0, p.size) == p
}

// The checks in main's MIR (`avant dump` prints each function after a
// line starting `fn NAME`).
fn checks_in_main(dump: String): Int {
  n = 0
  inside = false
  for line in dump.split("\n") {
    if has_prefix(line, "fn ") {
      inside = has_prefix(line, "fn main(")
    } else if inside && line.contains("check.bounds") {
      n += 1
    }
  }
  n
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(BCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/bf-${f.tag}.av"
    _ = fs.write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/bf-${f.tag}.bin", "${dir}/bf-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    runs.push(run_job(dir, "bf-${f2.tag}.bin", "bf-${f2.tag}.run"))
  }
  run_waves(runs)
  for i in 0..cases.size {
    f3 = cases[i]
    c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
    if f3.kind == 3 {
      c.expect(runs[i].code != 0, "${f3.tag}: fails")
      c.expect(log_text("${dir}/bf-${f3.tag}.run.err").contains(f3.want), "${f3.tag}: says ${f3.want}")
    } else {
      c.eq_int(runs[i].code, 0, "${f3.tag}: exit 0")
      c.eq_str(log_text("${dir}/bf-${f3.tag}.run.out"), f3.want, "${f3.tag}: stdout")
      log = "${dir}/bf-${f3.tag}.dump"
      c.eq_int(dump_av(compiler, "${dir}/bf-${f3.tag}.av", log), 0, "${f3.tag}: dumps")
      c.eq_int(checks_in_main(log_text(log)), 0, "${f3.tag}: no bounds check in main")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_bounds_facts.av")
  if compiler = process.env("AVANT_COMPILER") {
    run_cases(c, compiler, scratch_dir(), cases())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
