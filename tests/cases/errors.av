fn expect_err(c: Checks, compiler: String, stamp: Int, tag: String, body: String, needle: String) {
  src = "/tmp/avant-s10-${stamp}-${tag}.av"
  bin = "/tmp/avant-s10-${stamp}-${tag}.bin"
  log = "/tmp/avant-s10-${stamp}-${tag}.log"
  dummy = file_write(src, body)
  code = compile_av(compiler, src, bin, log)
  c.expect(!file_exists(bin), "${tag} bin absent")
  if err = file_read(log) {
    c.expect(str_has(err, needle), tag)
  } else {
    c.expect(false, tag)
  }
}

fn test_errors(c: Checks) {
  c.suite("tests/cases/errors.av")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    expect_err(c, compiler, stamp, "unknown-name", "fn main {\n  puts(x)\n}\n", "unknown name")
    expect_err(c, compiler, stamp, "no-entry", "fn fact(n: Int): Int {\n  n\n}\n", "main or fn run")
    expect_err(c, compiler, stamp, "if-bool", "fn main {\n  if 1 { puts(\"x\") }\n}\n", "if condition must be Bool")
    expect_err(c, compiler, stamp, "missing-return", "fn f: Int {\n}\nfn main {\n  puts(f())\n}\n", "missing return value")
    expect_err(c, compiler, stamp, "block-scope", "fn main {\n  if true {\n    y = 3\n  }\n  puts(y)\n}\n", "unknown name y")
    expect_err(c, compiler, stamp, "unknown-type", "fn main {\n  x: Float = 1\n  puts(1)\n}\n", "unknown type Float")
    expect_err(c, compiler, stamp, "non-trailing-default", "fn f(a: Int = 1, b: Int): Int {\n  a + b\n}\nfn main {\n  puts(1)\n}\n", "trailing")
    expect_err(c, compiler, stamp, "dup-overload", "fn show(n: Int): Int {\n  n\n}\nfn show(n: Int): String {\n  \"x\"\n}\nfn main {\n  puts(1)\n}\n", "already defined")
    expect_err(c, compiler, stamp, "ambiguous-call", "fn f(x: Int): Int {\n  x\n}\nfn f(x: Int, y: Int = 0): Int {\n  x + y\n}\nfn main {\n  puts(f(1))\n}\n", "ambiguous")
    expect_err(c, compiler, stamp, "empty-array", "fn main {\n  xs = []\n  puts(1)\n}\n", "empty array needs a type")
    expect_err(c, compiler, stamp, "class-struct", "class Counter {\n  value: Int\n  fn initialize(value: Int) { self.value = value }\n}\nfn main {\n  c = Counter { value: 1 }\n  puts(1)\n}\n", "constructed with Counter.new")
    expect_err(c, compiler, stamp, "struct-new", "struct Point {\n  x: Int\n}\nfn main {\n  p = Point.new()\n  puts(1)\n}\n", "structs are constructed")
    expect_err(c, compiler, stamp, "top-fun", "fun sqrt(x: Float64): Float64\nfn main {\n  puts(1)\n}\n", "fun belongs in a lib block")
    expect_err(c, compiler, stamp, "fun-body", "lib math {\n  fun sqrt(x: Float64): Float64 {\n    x\n  }\n}\nfn main {\n  puts(1)\n}\n", "no body")
    expect_err(c, compiler, stamp, "struct-default", "struct Point {\n  x: Int = 0\n}\nfn main {\n  puts(1)\n}\n", "struct fields have no defaults")
    expect_err(c, compiler, stamp, "dup-case", "fn main {\n  switch 1 {\n    case 1 {\n      puts(1)\n    }\n    case 1 {\n      puts(2)\n    }\n  }\n}\n", "duplicate case")
    expect_err(c, compiler, stamp, "switch-else", "fn f(n: Int): String {\n  switch n {\n    case 0 {\n      \"zero\"\n    }\n  }\n}\nfn main {\n  puts(f(0))\n}\n", "needs else")
    expect_err(c, compiler, stamp, "switch-str", "fn main {\n  switch \"x\" {\n    case 0 {\n      puts(1)\n    }\n  }\n}\n", "Int or Bool")
    expect_err(c, compiler, stamp, "field-default", "class Box {\n  n: Int = 1 + 2\n  fn initialize {\n  }\n}\nfn main {\n  puts(Box.new().n)\n}\n", "literal or nil")
    expect_err(c, compiler, stamp, "spawn-class", "class Box {\n  n: Int\n  fn initialize(n: Int) {\n    self.n = n\n  }\n}\nfn main {\n  b = Box.new(1)\n  h = spawn { b.n }\n  puts(h.join)\n}\n", "cannot capture")
    expect_err(c, compiler, stamp, "spawn-array-store", "fn main {\n  xs = [1, 2, 3]\n  h = spawn {\n    xs[0] = 9\n    1\n  }\n  puts(h.join)\n}\n", "read-only until join")
    expect_err(c, compiler, stamp, "spawn-array-push", "fn main {\n  xs = [1, 2, 3]\n  h = spawn {\n    xs.push(9)\n    1\n  }\n  puts(h.join)\n}\n", "read-only until join")
    expect_err(c, compiler, stamp, "sender-array-store", "fn main {\n  xs = [1, 2, 3]\n  h = spawn { xs[0] }\n  xs[1] = 9\n  puts(h.join)\n}\n", "join first")
    expect_err(c, compiler, stamp, "sender-array-push", "fn main {\n  xs = [1, 2, 3]\n  h = spawn { xs[0] }\n  xs.push(9)\n  puts(h.join)\n}\n", "join first")
    expect_err(c, compiler, stamp, "unterm", "fn main {\n  puts(\"hello)\n}\n", "unterminated")
    expect_err(c, compiler, stamp, "clayout-literal", "lib math {\n  struct Point {\n    x: Int\n    y: Int\n  }\n}\nfn main {\n  p = Point { x: 1, y: 2 }\n  puts(1)\n}\n", "Point is a C layout; use Ptr(Point)")
    expect_err(c, compiler, stamp, "clayout-ann", "lib math {\n  struct Point {\n    x: Int\n  }\n}\nfn main {\n  n: Point = 1\n  puts(1)\n}\n", "Point is a C layout; use Ptr(Point)")
    expect_err(c, compiler, stamp, "clayout-bind", "lib math {\n  struct Point {\n    x: Int\n  }\n  struct Nest {\n    a: Point\n  }\n  fun make: Ptr(Nest)\n}\nfn main {\n  n = math.make()\n  a = n.a\n  puts(1)\n}\n", "Point is a C layout; use Ptr(Point)")
    expect_err(c, compiler, stamp, "clayout-ret", "lib math {\n  struct Point {\n    x: Int\n  }\n}\nfn f: Point {\n  1\n}\nfn main {\n  puts(1)\n}\n", "Point is a C layout; use Ptr(Point)")
    expect_err(c, compiler, stamp, "clayout-field", "struct Vec2 {\n  x: Int\n  y: Int\n}\nlib math {\n  struct Point {\n    v: Vec2\n  }\n}\nfn main {\n  puts(1)\n}\n", "C layout fields must be C types, not Vec2")
    expect_err(c, compiler, stamp, "clayout-forward", "lib math {\n  struct Nest {\n    a: Point\n  }\n  struct Point {\n    x: Int\n  }\n}\nfn main {\n  puts(1)\n}\n", "Point is not a complete C layout yet")
    expect_err(c, compiler, stamp, "clayout-empty", "lib math {\n  struct Point {\n  }\n}\nfn main {\n  puts(1)\n}\n", "C layout needs a field")
    expect_err(c, compiler, stamp, "clayout-default", "lib math {\n  struct Point {\n    x: Int = 1\n  }\n}\nfn main {\n  puts(1)\n}\n", "C layout fields have no defaults")
    expect_err(c, compiler, stamp, "clayout-fn", "lib math {\n  struct Point {\n    fn f: Int {\n      1\n    }\n  }\n}\nfn main {\n  puts(1)\n}\n", "C layout fields are name: Type only")
    expect_err(c, compiler, stamp, "lib-class", "lib math {\n  class Foo {\n  }\n}\nfn main {\n  puts(1)\n}\n", "inside lib, write fun or struct")
    expect_err(c, compiler, stamp, "ptr-generic", "lib math {\n  struct Point {\n    x: Int\n  }\n}\nfn (p: Ptr(Point)) id(x: T): T {\n  x\n}\nfn main {\n  puts(1)\n}\n", "Ptr methods are not generic")
    expect_err(c, compiler, stamp, "ptr-int", "fn (p: Ptr(Int)) id: Int {\n  1\n}\nfn main {\n  puts(1)\n}\n", "methods on Ptr(Int) are not Stage 18 Ptr methods")
    expect_err(c, compiler, stamp, "opaque-field", "lib sqlite3 {\n  fun open: Ptr(Sqlite3)\n}\nfn main {\n  db = sqlite3.open()\n  puts(db.x)\n}\n", "no field x on Ptr(Sqlite3)")
    expect_err(c, compiler, stamp, "clayout-dup", "lib a {\n  struct Point {\n    x: Int\n  }\n}\nlib b {\n  struct Point {\n    y: Int\n  }\n}\nfn main {\n  puts(1)\n}\n", "Point is already defined")
    expect_err(c, compiler, stamp, "clayout-both", "lib math {\n  struct Point {\n    x: Int\n  }\n}\nfn (p: Ptr(Point)) x: Int {\n  1\n}\nfn main {\n  puts(1)\n}\n", "Point.x is both a field and a method")
    expect_err(c, compiler, stamp, "fn-ambig", "fn pick(n: Int): Int {\n  n\n}\nfn pick(s: String): Int {\n  s.size\n}\nfn main {\n  p = pick\n  puts(1)\n}\n", "ambiguous overload")
    expect_err(c, compiler, stamp, "fn-method", "struct P19 {\n  x: Int\n  fn add(n: Int): Int {\n    x + n\n  }\n}\nfn main {\n  p = P19 { x: 1 }\n  f = p.add\n  puts(1)\n}\n", "methods are not values")
    expect_err(c, compiler, stamp, "fn-cfun", "lib math {\n  fun apply: fn(Int): Int\n}\nfn main {\n  puts(1)\n}\n", "C function pointers are not supported")
    expect_err(c, compiler, stamp, "fn-generic", "fn id(x: T): T {\n  x\n}\nfn main {\n  f = id\n  puts(1)\n}\n", "generic function is not a value")
    expect_err(c, compiler, stamp, "fn-lam", "fn main {\n  g = { |n| n + 1 }\n  puts(1)\n}\n", "lambda parameter needs a type")
    expect_err(c, compiler, stamp, "fn-eq", "fn main {\n  f: fn(Int): Int = { |n| n }\n  g: fn(Int): Int = { |n| n }\n  if f == g {\n    puts(1)\n  }\n}\n", "cannot compare fn values")
    expect_err(c, compiler, stamp, "fn-lam-arity", "fn main {\n  f: fn(Int): Int = { |a, b| a }\n  puts(1)\n}\n", "lambda takes 1 arguments, got 2")
    expect_err(c, compiler, stamp, "fn-lam-ty", "fn main {\n  f: fn(Int): Int = { |n: String| 1 }\n  puts(1)\n}\n", "lambda parameter is String, expected Int")
    expect_err(c, compiler, stamp, "fn-call-arity", "fn main {\n  f: fn(Int): Int = { |n| n }\n  puts(f(1, 2))\n}\n", "takes 1 arguments, got 2")
    expect_err(c, compiler, stamp, "fn-call-ty", "fn main {\n  f: fn(Int): Int = { |n| n }\n  puts(f(\"ab\"))\n}\n", "expected Int, got String")
    expect_err(c, compiler, stamp, "fn-assign", "fn main {\n  g: fn(Int): Int = { |n| n }\n  f: fn(Int, String): Bool = g\n  puts(1)\n}\n", "expected fn(Int, String): Bool, got fn(Int): Int")
    expect_err(c, compiler, stamp, "fn-block", "fn main {\n  f: fn(Int): Int = { |n| n }\n  f(1) { |x| x }\n  puts(1)\n}\n", "function value does not take a block")
    expect_err(c, compiler, stamp, "fn-call-int", "fn main {\n  n = 1\n  puts((n)(2))\n}\n", "cannot call Int")
    expect_err(c, compiler, stamp, "fn-cret", "lib math {\n  fun make: fn(Int): Int\n}\nfn main {\n  puts(1)\n}\n", "C function pointers are not supported")
    expect_err(c, compiler, stamp, "fn-ne", "fn main {\n  f: fn(): Int = { || 1 }\n  g: fn(): Int = { || 2 }\n  if f != g {\n    puts(1)\n  }\n}\n", "cannot compare fn values")
    expect_err(c, compiler, stamp, "fn-ret", "fn main {\n  f: fn(Int): Int = { |n| n }\n  g: fn(Int): Bool = f\n  puts(1)\n}\n", "expected fn(Int): Bool, got fn(Int): Int")
    expect_err(c, compiler, stamp, "fn-param", "fn main {\n  f: fn(Int): Int = { |n| n }\n  g: fn(Bool): Int = f\n  puts(1)\n}\n", "expected fn(Bool): Int, got fn(Int): Int")
    expect_err(c, compiler, stamp, "fn-body", "fn main {\n  f: fn(): Bool = { || 1 }\n  puts(1)\n}\n", "last expression is Int, expected Bool")
    expect_err(c, compiler, stamp, "fn-retstmt", "fn main {\n  f: fn(): Bool = { ||\n    return 1\n  }\n  puts(1)\n}\n", "expected Bool, got Int")
    expect_err(c, compiler, stamp, "fn-void", "fn go(f: fn()) {\n  f()\n}\nfn main {\n  go() { || 1 }\n  puts(1)\n}\n", "unused Int value")
    expect_err(c, compiler, stamp, "fn-empty", "fn main {\n  f: fn(): Int = { || }\n  puts(1)\n}\n", "missing return value")
    expect_err(c, compiler, stamp, "fn-self", "struct S19Rec {\n  base: Int\n  fn off: fn(): Int {\n    { || base }\n  }\n}\nfn main {\n  puts(1)\n}\n", "a lambda cannot capture the method receiver")
    expect_err(c, compiler, stamp, "fn-selfdot", "struct S19Rec {\n  base: Int\n  fn off: fn(): Int {\n    { || self.base }\n  }\n}\nfn main {\n  puts(1)\n}\n", "a lambda cannot capture the method receiver")
    expect_err(c, compiler, stamp, "fn-spawn", "fn main {\n  f: fn(): Int = { || 1 }\n  h = spawn { f() }\n  puts(h.join)\n}\n", "spawn cannot capture")
    expect_err(c, compiler, stamp, "fn-lam-int", "fn main {\n  n: Int = { || 1 }\n  puts(n)\n}\n", "expected Int, got a lambda")
    expect_err(c, compiler, stamp, "fn-generic-want", "fn id(x: T): T {\n  x\n}\nfn main {\n  f: fn(Int): Int = id\n  puts(1)\n}\n", "generic function is not a value")
    expect_err(c, compiler, stamp, "gen-bare", "class Box(T) {\n  value: T\n  fn initialize(value: T) {\n    self.value = value\n  }\n}\nfn main {\n  x = Box\n  puts(1)\n}\n", "needs type arguments")
    expect_err(c, compiler, stamp, "gen-fresh", "class Box(Int) {\n  value: Int\n  fn initialize {\n  }\n}\nfn main {\n  puts(1)\n}\n", "must be a fresh name")
    expect_err(c, compiler, stamp, "gen-infer", "struct Tag(T) {\n}\nfn main {\n  t = Tag { }\n  puts(1)\n}\n", "cannot infer type argument")
    expect_err(c, compiler, stamp, "gen-infinite", "struct Node(T) {\n  next: Node(T)?\n}\nfn main {\n  n = Node(Int) { next: nil }\n  puts(1)\n}\n", "is infinite")
    expect_err(c, compiler, stamp, "gen-call", "class Box(T) {\n  value: T\n  fn initialize(value: T) {\n    self.value = value\n  }\n}\nfn main {\n  n = 1\n  x = Box(n)\n  puts(1)\n}\n", "type argument expected")
    expect_err(c, compiler, stamp, "gen-conflict", "struct Pair(A, B) {\n  a: A\n  b: B\n}\nfn main {\n  p: Pair(String, Int) = Pair { a: 1, b: \"x\" }\n  puts(1)\n}\n", "expected String, got Int")
    expect_err(c, compiler, stamp, "gen-lib", "lib math {\n  struct Point(T) {\n    x: Int\n  }\n}\nfn main {\n  puts(1)\n}\n", "lib structs take no type parameters")
    expect_err(c, compiler, stamp, "gen-comptime", "class Box(T) {\n  value: T\n  fn initialize(value: T) {\n    self.value = value\n  }\n}\ncomptime {\n  for f in Box.fields {\n    quote {\n      fn s20_walk: Int {\n        1\n      }\n    }\n  }\n}\nfn main {\n  puts(1)\n}\n", "cannot walk generic type")
    expect_err(c, compiler, stamp, "gen-deep", "class Box(T) {\n  value: T\n  fn initialize(value: T) {\n    self.value = value\n  }\n}\nstruct Evil(T) {\n  x: Evil(Box(T))\n}\nfn main {\n  e: Evil(Int)? = nil\n  puts(1)\n}\n", "type instantiation too deep")
    expect_err(c, compiler, stamp, "gen-invar", "class Box(T) {\n  value: T\n  fn initialize(value: T) {\n    self.value = value\n  }\n  fn get: T {\n    value\n  }\n}\nfn take(b: Box(Int)): Int {\n  b.get\n}\nfn main {\n  s = Box.new(\"hi\")\n  take(s)\n  puts(1)\n}\n", "expected Box(Int)")
    expect_err(c, compiler, stamp, "gen-arity", "struct Pair(A, B) {\n  a: A\n  b: B\n}\nfn main {\n  p = Pair(Int) { a: 1, b: 2 }\n  puts(1)\n}\n", "takes 2 type argument")
    expect_err(c, compiler, stamp, "gen-class-lit", "class Box(T) {\n  value: T\n  fn initialize(value: T) {\n    self.value = value\n  }\n}\nfn main {\n  b = Box(Int) { value: 1 }\n  puts(1)\n}\n", "constructed with Box(Int).new")
    expect_err(c, compiler, stamp, "spawn-struct-class", "class Box {\n  n: Int\n  fn initialize(n: Int) {\n    self.n = n\n  }\n}\nstruct Hold {\n  b: Box\n}\nfn main {\n  b = Box.new(1)\n  h = Hold { b: b }\n  t = spawn { h.b.n }\n  puts(t.join)\n}\n", "cannot capture")
    expect_err(c, compiler, stamp, "join-in-spawn", "fn main {\n  h = spawn { 1 }\n  t = spawn { h.join }\n  puts(t.join)\n}\n", "join inside a pool worker")
    expect_err(c, compiler, stamp, "parallel-in-spawn", "fn main {\n  xs = [1]\n  t = spawn {\n    ys = xs.parallel { |item| item }\n    1\n  }\n  puts(t.join)\n}\n", "parallel inside a pool worker")
    expect_err(c, compiler, stamp, "join-in-parallel", "fn main {\n  xs = [1]\n  ys = xs.parallel { |item|\n    h = spawn { 1 }\n    h.join\n  }\n  puts(ys[0])\n}\n", "join inside a pool worker")
    expect_err(c, compiler, stamp, "mutex-escape", "class Mutex(T) {\n  cell: T\n  gate: UInt64\n  fn initialize(value: T) {\n    self.cell = value\n    self.gate = 0u64\n  }\n}\nfn main {\n  mu = Mutex.new(1)\n  y = 0\n  n = mu.with { |x|\n    y = x\n    x\n  }\n  puts(n)\n}\n", "mutex place cannot escape")
    expect_err(c, compiler, stamp, "mutex-return", "class Mutex(T) {\n  cell: T\n  gate: UInt64\n  fn initialize(value: T) {\n    self.cell = value\n    self.gate = 0u64\n  }\n}\nfn main {\n  mu = Mutex.new(1)\n  n = mu.with { |x|\n    return x\n  }\n  puts(n)\n}\n", "return inside Mutex.with")
    expect_err(c, compiler, stamp, "iface-no-opt", "interface Show {\n  fn to_s: String\n}\nstruct Vec2 {\n  x: Int\n  fn to_s: String { \"v\" }\n}\nfn show(v: T: Show): String { v.to_s }\nfn main {\n  puts(show(Vec2 { x: 1 }))\n}\n", "does not implement")
    expect_err(c, compiler, stamp, "iface-missing", "interface Show {\n  fn to_s: String\n}\nstruct Vec2: Show {\n  x: Int\n}\nfn main {\n  puts(1)\n}\n", "missing to_s")
    expect_err(c, compiler, stamp, "iface-ret", "interface Show {\n  fn to_s: String\n}\nstruct Vec2: Show {\n  x: Int\n  fn to_s: Int { 1 }\n}\nfn main {\n  puts(1)\n}\n", "returns Int, expected String")
    expect_err(c, compiler, stamp, "iface-nil", "interface N {\n  fn f: Int?\n}\nstruct Vec2: N {\n  fn f: Int { 1 }\n}\nfn main {\n  puts(1)\n}\n", "returns Int, expected Int?")
    expect_err(c, compiler, stamp, "iface-param", "interface N {\n  fn f(n: Int): Int\n}\nstruct Vec2: N {\n  fn f(n: String): Int { n.size }\n}\nfn main {\n  puts(1)\n}\n", "parameter 1 is String, expected Int")
    expect_err(c, compiler, stamp, "iface-short", "interface N {\n  fn f(n: Int): Int\n}\nstruct Vec2: N {\n  fn f(n: Int, m: Int = 0): Int { n }\n}\nfn main {\n  puts(1)\n}\n", "missing f")
    expect_err(c, compiler, stamp, "iface-two", "interface Id {\n  fn id(x: U): U\n}\nstruct Vec2: Id {\n  x: Int\n  fn id(x: A): A { x }\n  fn id(x: B): B { x }\n}\nfn main {\n  puts(1)\n}\n", "ambiguous")
    expect_err(c, compiler, stamp, "iface-field", "interface Show {\n  fn to_s: String\n}\nstruct Vec2 {\n  s: Show\n}\nfn main {\n  puts(1)\n}\n", "is not a value type")
    expect_err(c, compiler, stamp, "iface-local", "interface Show {\n  fn to_s: String\n}\nfn main {\n  x: Show = 1\n  puts(1)\n}\n", "is not a value type")
    expect_err(c, compiler, stamp, "iface-array", "interface Show {\n  fn to_s: String\n}\nfn main {\n  xs: Array(Show) = []\n  puts(1)\n}\n", "is not a value type")
    expect_err(c, compiler, stamp, "iface-bare", "interface Enumerable(T) {\n  fn each(block: fn(T): Nil)\n}\nstruct Vec2: Enumerable {\n  x: Int\n}\nfn main {\n  puts(1)\n}\n", "needs type arguments")
    expect_err(c, compiler, stamp, "iface-free", "interface Eq(T) {\n  fn ==(other: T): Bool\n}\nstruct Vec2: Eq(T) {\n  x: Int\n}\nfn main {\n  puts(1)\n}\n", "unknown type T")
    expect_err(c, compiler, stamp, "iface-body", "interface Show {\n  fn to_s: String {\n    \"x\"\n  }\n}\nfn main {\n  puts(1)\n}\n", "interface methods have no body")
    expect_err(c, compiler, stamp, "iface-dup", "interface Show {\n  fn to_s: String\n}\nstruct Vec2: Show {\n  fn to_s: String { \"v\" }\n}\nVec2: Show\nfn main {\n  puts(1)\n}\n", "already implements")
    expect_err(c, compiler, stamp, "iface-empty", "interface Show() {\n  fn to_s: String\n}\nfn main {\n  puts(1)\n}\n", "type parameter list is empty")
    expect_err(c, compiler, stamp, "iface-builtin", "interface Enumerable(T) {\n  fn each(block: fn(T): Nil)\n}\nArray(Int): Enumerable(Int)\nfn main {\n  puts(1)\n}\n", "cannot opt into")
    expect_err(c, compiler, stamp, "iface-ptr-int", "interface Show {\n  fn to_s: String\n}\nfn (p: Ptr(Int)) to_s: String { \"n\" }\nPtr(Int): Show\nfn main {\n  puts(1)\n}\n", "not Stage 18")
    dir = "/tmp/avant-s21-${stamp}"
    s12_mkdir(dir)
    s12_write(dir, "s21priv", "pub interface Show {\n  fn to_s: String\n}\npub struct Hide {\n  n: Int\n  fn to_s: String { \"p\" }\n}\npub Hide: Show\n")
    s12_write(dir, "s21privmain", "import s21priv\nfn show(v: T: Show): String { v.to_s }\nfn main {\n  puts(show(Hide { n: 1 }))\n}\n")
    priv_bin = "${dir}/priv.bin"
    priv_log = "${dir}/priv.log"
    dummy_p = compile_av(compiler, "${dir}/s21privmain.av", priv_bin, priv_log)
    c.expect(!file_exists(priv_bin), "iface-private bin absent")
    if err = file_read(priv_log) {
      c.expect(str_has(err, "does not implement"), "iface-private")
    } else {
      c.expect(false, "iface-private")
    }
    s12_write(dir, "s21hid", "interface Show {\n  fn to_s: String\n}\npub struct Hide {\n  n: Int\n  pub fn to_s: String { \"h\" }\n}\npub Hide: Show\n")
    s12_write(dir, "s21hidmain", "import s21hid\nfn show(v: T: Show): String { v.to_s }\nfn main {\n  puts(show(Hide { n: 1 }))\n}\n")
    hid_bin = "${dir}/hid.bin"
    hid_log = "${dir}/hid.log"
    dummy_h = compile_av(compiler, "${dir}/s21hidmain.av", hid_bin, hid_log)
    c.expect(!file_exists(hid_bin), "iface-vis bin absent")
    if err = file_read(hid_log) {
      c.expect(str_has(err, "unknown type Show"), "iface-vis")
    } else {
      c.expect(false, "iface-vis")
    }
    s12_write(dir, "s21quiet", "pub interface Show {\n  fn to_s: String\n}\npub struct Hide {\n  n: Int\n  pub fn to_s: String { \"q\" }\n}\nHide: Show\n")
    s12_write(dir, "s21quietmain", "import s21quiet\nfn show(v: T: Show): String { v.to_s }\nfn main {\n  puts(show(Hide { n: 1 }))\n}\n")
    quiet_bin = "${dir}/quiet.bin"
    quiet_log = "${dir}/quiet.log"
    dummy_q = compile_av(compiler, "${dir}/s21quietmain.av", quiet_bin, quiet_log)
    c.expect(!file_exists(quiet_bin), "iface-opt-vis bin absent")
    if err = file_read(quiet_log) {
      c.expect(str_has(err, "does not implement"), "iface-opt-vis")
    } else {
      c.expect(false, "iface-opt-vis")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}
