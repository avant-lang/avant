import harness

interface Show {
  fn to_s: String
}

interface Eq(T) {
  fn ==(other: T): Bool
}

interface Enumerable(T) {
  fn each(block: fn(T): Nil)
}

interface Fold(T) {
  fn fold(init: U, f: fn(U, T): U): U
}

interface Full {
  fn take(n: Int, m: Int): Int
}

struct Vec: Show + Eq(Vec) {
  x: Int
  y: Int

  fn to_s: String {
    "vec"
  }

  fn ==(other: Vec): Bool {
    if x == other.x {
      return y == other.y
    }
    false
  }
}

struct Tag {
  n: Int
}

fn (v: Tag) to_s: String {
  "tag"
}

Tag: Show

struct Name: Show {
  fn to_s: String {
    "name"
  }
}

class Box(T): Enumerable(T) + Fold(T) {
  value: T

  fn initialize(value: T) {
    self.value = value
  }

  fn each(block: fn(T): Nil) {
    block(value)
    return
  }

  fn fold(init: U, f: fn(U, T): U): U {
    f(init, value)
  }

  fn to_s: String {
    "box"
  }
}

Box(Int): Show

struct Def: Full {
  fn take(n: Int, m: Int = 0): Int {
    n + m
  }
}

fn show(v: T: Show): String {
  v.to_s
}

fn same(a: T: Eq(T), b: T): Bool {
  if a == b {
    return true
  }
  false
}

fn both(v: T: Show + Eq(T)): String {
  v.to_s
}

fn sum(b: E: Fold(Int)): Int {
  b.fold(0) { |acc, x| acc + x }
}

fn word(b: E: Fold(String)): String {
  b.fold("") { |acc, x| x }
}

fn touch(b: E: Enumerable(Int)): Int {
  b.each { |x| nil }
  1
}

fn take(v: T: Full): Int {
  v.take(3, 4)
}

fn test_interfaces(c: Checks) {
  c.suite("tests/cases/test_interfaces.av")
  v = Vec { x: 1, y: 2 }
  w = Vec { x: 1, y: 2 }
  z = Vec { x: 3, y: 4 }
  c.eq_str(show(v), "vec", "show vec")
  c.eq_str(show(Name { }), "name", "show name")
  c.eq_str(show(Tag { n: 1 }), "tag", "external witness")
  c.expect(same(v, w), "eq same")
  c.expect(!same(v, z), "eq different")
  c.eq_str(both(v), "vec", "bound plus")
  b = Box.new(4)
  c.eq_str(show(b), "box", "later opt-in")
  c.eq_int(sum(b), 4, "fold int")
  c.eq_int(touch(b), 1, "each int")
  s = Box.new("hi")
  c.eq_str(word(s), "hi", "fold string")
  c.eq_int(touch(Box.new(9)), 1, "each on another box")
  c.eq_int(take(Def { }), 7, "default fills the full witness")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    dir = "/tmp/avant-interfaces-${stamp}"
    mkdir_p(dir)
    write_av(dir, "show", "pub interface Show {\n  fn to_s: String\n}\npub struct Tag {\n  n: Int\n}\npub fn (v: Tag) to_s: String {\n  \"tag\"\n}\npub Tag: Show\n")
    write_av(dir, "main", "import show\nfn present(v: T: Show): String {\n  v.to_s\n}\nfn main {\n  puts(present(Tag { n: 1 }))\n}\n")
    bin = "${dir}/ok.bin"
    log = "${dir}/ok.log"
    out = "${dir}/ok.out"
    code = compile_av(compiler, "${dir}/main.av", bin, log)
    c.eq_int(code, 0, "pub later opt-in")
    c.expect(file_exists(bin), "pub later opt-in bin")
    chmod_x(bin)
    run_code = run_av_bin(bin, out)
    c.eq_int(run_code, 0, "pub later opt-in run")
    if got = file_read(out) {
      c.eq_str(got, "tag\n", "imported show")
    } else {
      c.expect(false, "imported show")
    }

    csrc = "${dir}/point.c"
    asrc = "${dir}/point.av"
    clog = "${dir}/point.txt"
    dummy = file_write(csrc, "#include <stdlib.h>\ntypedef struct Point { int x; } Point;\nPoint *point_new(int x) {\n  Point *p = malloc(sizeof(Point));\n  p->x = x;\n  return p;\n}\n")
    dummy2 = file_write(asrc, "interface Show {\n  fn to_s: String\n}\nlib math {\n  struct Point {\n    x: Int\n  }\n  fun point_new(x: Int): Ptr(Point)\n}\nfn (p: Ptr(Point)) to_s: String {\n  \"pt\"\n}\nPtr(Point): Show\nfn present(v: T: Show): String {\n  v.to_s\n}\nfn main {\n  puts(present(math.point_new(1)))\n}\n")
    flags: Array(String) = []
    flags.push("--cc")
    flags.push(csrc)
    pcode = run_av_cmd_flags(compiler, asrc, clog, flags)
    c.eq_int(pcode, 0, "ptr opt-in")
    if pg = file_read(clog) {
      c.eq_str(pg, "pt\n", "ptr show")
    } else {
      c.expect(false, "ptr show")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  c = Checks.new()
  c.started = now_ms()
  test_interfaces(c)
  c.finish
}
