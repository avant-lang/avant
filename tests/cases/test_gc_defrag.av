import harness
import backends

// Stage 28 W11c (C31, D204): a full collection's defragmentation does not
// move a mature object that a word of the collecting thread's stack names.
// Before the fix it moved such an object, rewrote only the precise
// references to it, and freed its block while a runtime C helper still
// held it in its own frame: avant_str_concat's operands at the full
// collection the outermost avant_gc_defer_enter runs under
// AVANT_NURSERY=0 (closures/churn.av segfaulted in about 12% of runs), and
// avant_json_parse's text across the allocation of its pool, in every
// mode. tests/fixtures/heap/defrag_held.av makes both happen at many full
// collections; the stale reads usually hit still-intact freed memory, so
// the output alone rarely shows the defect, but AVANT_GC_VERIFY=1 reports
// every stack word, root, or field that still names a block being freed,
// at every such collection. So one run per environment is the regression
// test: with the old candidate rule the verified runs under
// AVANT_NURSERY=0 and AVANT_YOUNG_MB=1 report in 10 of 10 runs (W11c
// record). The program runs plain, under AVANT_GC_VERIFY=1, both
// verified environments, and AVANT_NURSERY=0: the known stdout, no
// stderr (no verifier report), exit 0. test_closures runs churn.av under
// AVANT_GC_VERIFY=1 AVANT_NURSERY=0 for the same reason.

fn gc_envs: Array(String) {
  ["", "AVANT_GC_VERIFY=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0", "AVANT_GC_VERIFY=1 AVANT_NURSERY=0"]
}

fn test_gc_defrag(c: Checks, compiler: String, root: String, dir: String) {
  src = "${root}/tests/fixtures/heap/defrag_held.av"
  want = "concat bad: 0\njson bad: 0\n"
  jobs: Array(HJob) = []
  jobs.push(compile_job("", compiler, src, "${dir}/defrag_held", "${dir}/defrag_held.log"))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "defrag_held.av: compiles")
  envs = gc_envs()
  runs: Array(HJob) = []
  e = 0
  while e < envs.size {
    runs.push(run_job_env(dir, "defrag_held", "defrag_held.g${e}", envs[e]))
    e += 1
  }
  run_waves(runs)
  e = 0
  while e < envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    k = "defrag_held.g${e}"
    c.eq_int(runs[e].code, 0, "defrag_held.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/${k}.out"), want, "defrag_held.av ${what}: the known stdout")
    c.eq_str(log_text("${dir}/${k}.err"), "", "defrag_held.av ${what}: no stderr (no verifier report)")
    e += 1
  }
}

// The number after `key=` in an AVANT_GC_STATS=1 line, or -1.
fn stat_int(text: String, key: String): Int {
  parts = text.split(" ")
  for p in parts {
    if p.size > key.size + 1 && str_slice(p, 0, key.size + 1) == "${key}=" {
      return str_slice(p, key.size + 1, p.size).strip.to_i ?? -1
    }
  }
  -1
}

// O202 (Stage 29 W-FIX1c): no evacuation without a gain.
// heap/defrag_gain.av (its comment has the three cases) prints the known
// stdout plainly and under each environment above. Then each case alone,
// with AVANT_GC_STATS=1 and every collector variable unset: 50 forced
// full collections of a heap that does not change evacuate fewer than 5
// blocks in all (0 today; 50 before W-FIX1c, one per collection); a
// heap of 4.6 MiB with two sparse blocks is not walked to gain one
// block (0 blocks evacuated; 2 with the one-block rule alone); and a
// fragmented heap is still evacuated (at least 60 blocks; 98 today, 100
// before).
fn test_defrag_gain(c: Checks, compiler: String, root: String, dir: String) {
  jobs: Array(HJob) = []
  jobs.push(compile_job("", compiler, "${root}/tests/fixtures/heap/defrag_gain.av", "${dir}/defrag_gain", "${dir}/defrag_gain.log"))
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "defrag_gain.av: compiles")
  envs = gc_envs()
  clean = "-u AVANT_YOUNG_MB -u AVANT_HEAP_MAX_MB -u AVANT_HEAP_RESERVE_GB -u AVANT_NURSERY -u AVANT_GC_DEFRAG -u AVANT_GC_VERIFY -u AVANT_GC_STRESS AVANT_GC_STATS=1"
  runs: Array(HJob) = []
  for e in 0..envs.size {
    runs.push(run_job_env(dir, "defrag_gain", "defrag_gain.g${e}", envs[e]))
  }
  runs.push(run_job_env(dir, "defrag_gain", "defrag_gain.steady", "${clean} DEFRAG_GAIN_CASE=steady"))
  runs.push(run_job_env(dir, "defrag_gain", "defrag_gain.fragmented", "${clean} DEFRAG_GAIN_CASE=fragmented"))
  runs.push(run_job_env(dir, "defrag_gain", "defrag_gain.tail", "${clean} DEFRAG_GAIN_CASE=tail"))
  run_waves(runs)
  for e in 0..envs.size {
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "defrag_gain.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/defrag_gain.g${e}.out"), "steady 20992\ntail 300512\nfragmented 33544192\n", "defrag_gain.av ${what}: the known stdout")
    c.eq_str(log_text("${dir}/defrag_gain.g${e}.err"), "", "defrag_gain.av ${what}: no stderr (no verifier report)")
  }
  steady = log_text("${dir}/defrag_gain.steady.err")
  frag = log_text("${dir}/defrag_gain.fragmented.err")
  c.eq_int(runs[envs.size].code, 0, "defrag_gain.av steady: exit 0")
  c.eq_int(runs[envs.size + 1].code, 0, "defrag_gain.av fragmented: exit 0")
  c.eq_int(stat_int(steady, "full"), 50, "defrag_gain.av steady: 50 full collections")
  ev = stat_int(steady, "def_evac_blocks")
  c.expect(ev >= 0 && ev < 5, "defrag_gain.av steady: a heap that does not change is not evacuated again at every full collection (fewer than 5 blocks in 50 collections)")
  c.expect(stat_int(frag, "def_evac_blocks") >= 60, "defrag_gain.av fragmented: a fragmented heap is still evacuated (at least 60 blocks)")
  c.eq_int(stat_int(frag, "def_evac_blocks"), stat_int(frag, "def_freed_blocks"), "defrag_gain.av fragmented: every evacuated block is freed")
  tail = log_text("${dir}/defrag_gain.tail.err")
  c.eq_int(runs[envs.size + 2].code, 0, "defrag_gain.av tail: exit 0")
  c.eq_int(stat_int(tail, "full"), 21, "defrag_gain.av tail: 21 full collections")
  c.eq_int(stat_int(tail, "def_evac_blocks"), 0, "defrag_gain.av tail: a heap of 146 blocks is not walked to gain one block")
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_gc_defrag.av")
  if compiler = env_get("AVANT_COMPILER") {
    test_gc_defrag(c, compiler, avant_test_root(), scratch_dir())
    test_defrag_gain(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish
}
