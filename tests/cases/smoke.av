fn fact(n: Int): Int {
  if n <= 1 { return 1 }
  n * fact(n - 1)
}

fn test_smoke(c: Checks) {
  c.suite("tests/cases/smoke.av")
  c.expect(true, "true")
  c.eq_int(1 + 1, 2, "1+1")
  c.eq_int(fact(5), 120, "fact(5)")
  c.eq_str("Hello" + " Avant", "Hello Avant", "concat")
  c.expect(str_eq("ab", "ab"), "str_eq")
  c.expect(file_exists("/"), "file_exists /")
  names = dir_list("/")
  c.expect(names.size > 0, "dir_list /")
}
