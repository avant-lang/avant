lib ffi_rt {
  fun avant_pin_count: Int
}

fn ffi_early(s: String): Int {
  pin(s) {
    if s.size > 2 {
      return 42
    }
  }
  0
}

fn test_ffi(c: Checks) {
  c.suite("tests/cases/ffi.av")
  base = ffi_rt.avant_pin_count()
  s = "hello" + "world"
  pin(s) {
    c.eq_int(s.size, 10, "pin body sees the value")
    c.eq_int(ffi_rt.avant_pin_count(), base + 1, "pin scope pins one payload")
    pin(s) {
      c.eq_int(ffi_rt.avant_pin_count(), base + 1, "nested pin of one payload shares the entry")
    }
    c.eq_int(ffi_rt.avant_pin_count(), base + 1, "inner unpin keeps the outer pin")
  }
  c.eq_int(ffi_rt.avant_pin_count(), base, "pin scope unpins on fallthrough")
  c.eq_int(ffi_early("abcd"), 42, "return inside pin")
  c.eq_int(ffi_rt.avant_pin_count(), base, "pin scope unpins on return")
  total = 0
  i = 0
  while i < 5 {
    pin(s) {
      if i == 2 {
        i = i + 1
        continue
      }
      if i == 4 {
        break
      }
      total = total + 1
    }
    i = i + 1
  }
  c.eq_int(total, 3, "break and continue cross the pin scope")
  c.eq_int(ffi_rt.avant_pin_count(), base, "pin scope unpins on break and continue")
  n = 0
  j = 0
  while j < 20000 {
    t = "pin-leak-probe-${j}"
    pin(t) {
      n = n + t.size
    }
    j = j + 1
  }
  c.expect(n > 0, "pin leak loop ran")
  c.eq_int(ffi_rt.avant_pin_count(), base, "pin scope does not leak over 20000 rounds")
  if compiler = env_get("AVANT_COMPILER") {
    root = avant_test_root()
    stamp = now_ms()

    cb_src = "/tmp/avant-waveg-${stamp}-cb.av"
    cb_bin = "/tmp/avant-waveg-${stamp}-cb"
    cb_clog = "/tmp/avant-waveg-${stamp}-cb-cc.log"
    cb_rlog = "/tmp/avant-waveg-${stamp}-cb-run.log"
    cb_body = "lib libc {\n  struct CInt {\n    v: Int\n  }\n  fun qsort(base: Ptr(CInt), nmemb: Int, size: Int, compar: fn(Ptr(CInt), Ptr(CInt)): Int)\n  fun cb_buf_new(n: Int): Ptr(CInt)\n  fun cb_buf_set(b: Ptr(CInt), i: Int, v: Int)\n  fun cb_buf_get(b: Ptr(CInt), i: Int): Int\n  fun cb_buf_free(b: Ptr(CInt))\n}\nfn cmp_asc(a: Ptr(CInt), b: Ptr(CInt)): Int {\n  if a.v < b.v {\n    return -1\n  }\n  if a.v > b.v {\n    return 1\n  }\n  0\n}\nfn cmp_desc(a: Ptr(CInt), b: Ptr(CInt)): Int {\n  if a.v > b.v {\n    return -1\n  }\n  if a.v < b.v {\n    return 1\n  }\n  0\n}\nfn show(buf: Ptr(CInt), n: Int): String {\n  out = \"\"\n  i = 0\n  while i < n {\n    out = \"\${out}\${libc.cb_buf_get(buf, i)}\"\n    i = i + 1\n  }\n  out\n}\nfn main {\n  n = 6\n  buf = libc.cb_buf_new(n)\n  vals = [5, 2, 9, 1, 7, 3]\n  i = 0\n  while i < n {\n    libc.cb_buf_set(buf, i, vals[i])\n    i = i + 1\n  }\n  libc.qsort(buf, n, 4, cmp_asc)\n  puts(show(buf, n))\n  libc.qsort(buf, n, 4, cmp_desc)\n  puts(show(buf, n))\n  libc.qsort(buf, n, 4, { |a: Ptr(CInt), b: Ptr(CInt)| a.v - b.v })\n  puts(show(buf, n))\n  libc.cb_buf_free(buf)\n}\n"
    cw = file_write(cb_src, cb_body)
    c.eq_int(cw, 0, "write callback proof")
    cb_flags: Array(String) = []
    cb_flags.push("--cc")
    cb_flags.push("${root}/examples/c/callback.c")
    cb_code = compile_av_flags(compiler, cb_src, cb_bin, cb_clog, cb_flags)
    c.eq_int(cb_code, 0, "compile callback proof")
    if file_exists(cb_bin) {
      chmod_x(cb_bin)
      cb_rcode = run_av_bin(cb_bin, cb_rlog)
      c.eq_int(cb_rcode, 0, "run callback proof")
      if out = file_read(cb_rlog) {
        c.eq_str(out, "123579\n975321\n123579\n", "qsort called the Avant comparators")
      } else {
        c.expect(false, "read callback stdout")
      }
    } else {
      c.expect(false, "callback binary exists")
    }

    cap_src = "/tmp/avant-waveg-${stamp}-cap.av"
    cap_bin = "/tmp/avant-waveg-${stamp}-cap"
    cap_log = "/tmp/avant-waveg-${stamp}-cap.log"
    cap_body = "lib libc {\n  struct CInt {\n    v: Int\n  }\n  fun qsort(base: Ptr(CInt), nmemb: Int, size: Int, compar: fn(Ptr(CInt), Ptr(CInt)): Int)\n  fun cb_buf_new(n: Int): Ptr(CInt)\n}\nfn main {\n  buf = libc.cb_buf_new(2)\n  bias = 3\n  libc.qsort(buf, 2, 4, { |a: Ptr(CInt), b: Ptr(CInt)| a.v - b.v + bias })\n}\n"
    dummy_cap = file_write(cap_src, cap_body)
    cap_code = compile_av(compiler, cap_src, cap_bin, cap_log)
    c.expect(cap_code != 0, "capturing callback does not compile")
    if cap_txt = file_read(cap_log) {
      c.expect(str_has(cap_txt, "C callback cannot capture bias"), "capturing callback diagnostic")
    } else {
      c.expect(false, "read capturing callback log")
    }

    var_src = "/tmp/avant-waveg-${stamp}-var.av"
    var_bin = "/tmp/avant-waveg-${stamp}-var"
    var_log = "/tmp/avant-waveg-${stamp}-var.log"
    var_body = "lib libc {\n  struct CInt {\n    v: Int\n  }\n  fun qsort(base: Ptr(CInt), nmemb: Int, size: Int, compar: fn(Ptr(CInt), Ptr(CInt)): Int)\n  fun cb_buf_new(n: Int): Ptr(CInt)\n}\nfn cmp_asc(a: Ptr(CInt), b: Ptr(CInt)): Int {\n  a.v - b.v\n}\nfn main {\n  buf = libc.cb_buf_new(2)\n  f = cmp_asc\n  libc.qsort(buf, 2, 4, f)\n}\n"
    dummy_var = file_write(var_src, var_body)
    var_code = compile_av(compiler, var_src, var_bin, var_log)
    c.expect(var_code != 0, "fn variable callback does not compile")
    if var_txt = file_read(var_log) {
      c.expect(str_has(var_txt, "C callback must be a function name"), "fn variable callback diagnostic")
    } else {
      c.expect(false, "read fn variable log")
    }

    pin_src = "/tmp/avant-waveg-${stamp}-pin.av"
    pin_bin = "/tmp/avant-waveg-${stamp}-pin"
    pin_log = "/tmp/avant-waveg-${stamp}-pin.log"
    dummy_pin = file_write(pin_src, "fn main {\n  pin(42) {\n    puts(\"no\")\n  }\n}\n")
    pin_code = compile_av(compiler, pin_src, pin_bin, pin_log)
    c.expect(pin_code != 0, "pin of an Int does not compile")
    if pin_txt = file_read(pin_log) {
      c.expect(str_has(pin_txt, "pin needs a heap value, got Int"), "pin diagnostic")
    } else {
      c.expect(false, "read pin log")
    }

    hello_src = "/tmp/avant-waveg-${stamp}-hello.av"
    dummy_hello = file_write(hello_src, "fn main {\n  puts(\"hi\")\n}\n")
    stock_dir = "/tmp/avant-waveg-${stamp}-stock"
    mkdir_args: Array(String) = []
    mkdir_args.push("-p")
    mkdir_args.push(stock_dir)
    dummy_mk = process_run("/bin/mkdir", mkdir_args)
    dummy_stock = file_write("${stock_dir}/myc-llvm", "#!/bin/sh\necho 'define i32 @main(i32 %0, ptr %1) { ret i32 0 }'\nexit 0\n")
    chmod_x("${stock_dir}/myc-llvm")
    stock_log = "/tmp/avant-waveg-${stamp}-stock.log"
    stock_args: Array(String) = []
    stock_args.push("PATH=${stock_dir}:/usr/bin:/bin")
    stock_args.push(compiler)
    stock_args.push("run")
    stock_args.push(hello_src)
    stock_code = process_run_out("/usr/bin/env", stock_args, stock_log)
    c.expect(stock_code != 0, "stock myc-llvm first on PATH fails")
    if stock_txt = file_read(stock_log) {
      c.expect(str_has(stock_txt, "does not accept the safepoints GC flags"), "stock myc-llvm diagnostic names the tried path")
    } else {
      c.expect(false, "read stock log")
    }

    miss_log = "/tmp/avant-waveg-${stamp}-miss.log"
    miss_args: Array(String) = []
    miss_args.push("AVANT_MYC_LLVM=/tmp/avant-waveg-missing/myc-llvm")
    miss_args.push(compiler)
    miss_args.push("run")
    miss_args.push(hello_src)
    miss_code = process_run_out("/usr/bin/env", miss_args, miss_log)
    c.expect(miss_code != 0, "missing AVANT_MYC_LLVM fails")
    if miss_txt = file_read(miss_log) {
      c.expect(str_has(miss_txt, "AVANT_MYC_LLVM points at a missing file"), "missing myc-llvm diagnostic")
    } else {
      c.expect(false, "read missing log")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}
