import harness
import std.fs
import std.process

// A module program that compiles and prints want.
fn mod_runs(c: Checks, compiler: String, dir: String, name: String, want: String, tag: String) {
  bin = "${dir}/${name}.bin"
  log = "${dir}/${name}.log"
  out = "${dir}/${name}.out"
  code = compile_av(compiler, "${dir}/${name}.av", bin, log)
  c.eq_int(code, 0, "${tag} compiles")
  chmod_x(bin)
  run_av_bin(bin, out)
  if got = fs.read(out) {
    c.eq_str(got, want, tag)
  } else {
    c.expect(false, tag)
  }
}

// A module program that fails to compile with needle.
fn mod_fails(c: Checks, compiler: String, dir: String, name: String, needle: String, tag: String) {
  bin = "${dir}/${name}.bin"
  log = "${dir}/${name}.log"
  code = compile_av(compiler, "${dir}/${name}.av", bin, log)
  c.expect(code != 0, "${tag} exits non-zero")
  c.expect(!fs.exists(bin), "${tag} bin absent")
  if err = fs.read(log) {
    c.expect(err.contains(needle), tag)
  } else {
    c.expect(false, tag)
  }
}

// Functions are scoped per module: two
// modules may export one name and signature; only an unqualified call
// that sees both is ambiguous, and its message names the qualified
// forms; `module.name()` picks one; as for types, a module's own
// function does not win over an imported one of the same signature.
fn test_fn_scopes(c: Checks, compiler: String, dir: String) {
  write_av(dir, "fa", "pub fn helper: Int { 1 }\nfn secret: Int { 7 }\npub fn pick(s: String): Int { s.size }\npub fn twice(f: fn(Int): Int): Int { f(f(1)) }\n")
  write_av(dir, "fb", "pub fn helper: Int { 2 }\npub fn pick(n: Int): Int { n }\npub fn twice(f: fn(Int): Int): Int { f(1) }\n")
  write_av(dir, "fboth", "import fa\nimport fb\nfn helper: Int { 3 }\nfn main {\n  puts(fa.helper() + fb.helper() * 10 + fboth.helper() * 100)\n  puts(pick(\"abc\") + pick(40))\n  puts(fa.twice { |x| x + 5 })\n  puts(fb.twice { |x| x + 5 })\n}\n")
  mod_runs(c, compiler, dir, "fboth", "321\n43\n11\n6\n", "same pub fn in two modules, qualified")
  write_av(dir, "funused", "import fa\nimport fb\nfn main {\n  puts(5)\n}\n")
  mod_runs(c, compiler, dir, "funused", "5\n", "same pub fn in two modules, unused")
  write_av(dir, "famb", "import fa\nimport fb\nfn main {\n  puts(helper())\n}\n")
  mod_fails(c, compiler, dir, "famb", "ambiguous call to helper: fa.helper and fb.helper both match; write fa.helper() or fb.helper()", "two imports ambiguous at the call")
  write_av(dir, "fown", "import fa\nfn helper: Int { 3 }\nfn main {\n  puts(helper())\n}\n")
  mod_fails(c, compiler, dir, "fown", "write fa.helper() or fown.helper()", "own and imported ambiguous, as for types")
  write_av(dir, "flam", "import fa\nimport fb\nfn main {\n  twice { |x| x + 1 }\n}\n")
  mod_fails(c, compiler, dir, "flam", "ambiguous call to twice: fa.twice and fb.twice both match", "block argument ambiguous at the call")
  write_av(dir, "fpriv", "import fa\nfn main {\n  puts(fa.secret())\n}\n")
  mod_fails(c, compiler, dir, "fpriv", "function fa.secret is private to its module; mark it pub", "qualified call to a private function")
  write_av(dir, "fnone", "import fa\nfn main {\n  puts(fa.nothing())\n}\n")
  mod_fails(c, compiler, dir, "fnone", "unknown function fa.nothing", "qualified call to no function")
  write_av(dir, "fseen", "import fa\nfn main {\n  puts(fb.helper())\n}\n")
  mod_fails(c, compiler, dir, "fseen", "fb.helper", "qualified call to a module not imported")
  write_av(dir, "fdup", "fn helper: Int { 1 }\nfn helper: Int { 2 }\nfn main {\n  puts(helper())\n}\n")
  mod_fails(c, compiler, dir, "fdup", "function helper is already defined", "one module defines a name twice")
}

// A project with one dependency as avant fetch leaves it, written by hand:
// the manifest names it, the lockfile pins a commit, and deps/NAME is a
// checkout at that commit (its .git/HEAD alone).
fn fake_fetched(dir: String, project: String, name: String) {
  sha = "58a9ab1a2db9803a031edf34adb9e16c74f9d126"
  git = "https://example.invalid/${name}.git"
  mkdir_p("${dir}/deps/${name}/.git")
  _ = fs.write("${dir}/avant.toml", "[package]\nname = \"${project}\"\nversion = \"0.1.0\"\n\n[dependencies]\n${name} = { git = \"${git}\", rev = \"v1\" }\n")
  _ = fs.write("${dir}/avant.lock", "version = 1\n\n[[package]]\nname = \"${name}\"\nsource = \"git+${git}#${sha}\"\nrev = \"v1\"\n")
  _ = fs.write("${dir}/deps/${name}/.git/HEAD", "${sha}\n")
}

fn test_modules(c: Checks) {
  c.suite("tests/cases/test_modules.av")
  if compiler = process.env("AVANT_COMPILER") {
    stamp = now_ms()
    dir = "${scratch()}/modules-${stamp}"
    mkdir_p(dir)

    write_av(dir, "vec", "pub struct Vec2 {\n  pub x: Int\n  pub y: Int\n}\npub fn origin: Vec2 {\n  Vec2 { x: 0, y: 0 }\n}\n")
    write_av(dir, "main", "import vec\nfn main {\n  v = origin()\n  puts(v.x)\n}\n")
    bin = "${dir}/ok.bin"
    log = "${dir}/ok.log"
    out = "${dir}/ok.out"
    code = compile_av(compiler, "${dir}/main.av", bin, log)
    c.eq_int(code, 0, "import pub names")
    c.expect(fs.exists(bin), "import pub names bin")
    chmod_x(bin)
    run_code = run_av_bin(bin, out)
    c.eq_int(run_code, 0, "import pub names run")
    if got = fs.read(out) {
      c.eq_str(got, "0\n", "imported origin")
    } else {
      c.expect(false, "imported origin")
    }

    write_av(dir, "util", "fn hidden: Int {\n  1\n}\npub fn shown: Int {\n  hidden()\n}\n")
    write_av(dir, "hide", "import util\nfn main {\n  puts(hidden())\n}\n")
    hide_bin = "${dir}/hide.bin"
    hide_log = "${dir}/hide.log"
    hide_code = compile_av(compiler, "${dir}/hide.av", hide_bin, hide_log)
    c.expect(hide_code != 0, "private helper exits non-zero")
    c.expect(!fs.exists(hide_bin), "private helper bin absent")
    if err = fs.read(hide_log) {
      c.expect(err.contains("unknown function hidden"), "private helper hidden")
    } else {
      c.expect(false, "private helper hidden")
    }

    write_av(dir, "ca", "import cb\npub fn from_a: Int { 1 }\n")
    write_av(dir, "cb", "import ca\npub fn from_b: Int { 1 }\n")
    write_av(dir, "cycle", "import ca\nfn main {\n  puts(from_a())\n}\n")
    cycle_bin = "${dir}/cycle.bin"
    cycle_log = "${dir}/cycle.log"
    cycle_code = compile_av(compiler, "${dir}/cycle.av", cycle_bin, cycle_log)
    c.expect(cycle_code != 0, "cycle exits non-zero")
    c.expect(!fs.exists(cycle_bin), "cycle bin absent")
    if err = fs.read(cycle_log) {
      c.expect(err.contains("import cycle"), "import cycle")
    } else {
      c.expect(false, "import cycle")
    }

    write_av(dir, "one", "pub class Box {\n  n: Int\n  fn initialize(n: Int) {\n    self.n = n\n  }\n  pub fn draw: Int { self.n }\n}\n")
    write_av(dir, "two", "pub class Box {\n  n: Int\n  fn initialize(n: Int) {\n    self.n = n\n  }\n  pub fn draw: Int { self.n + 10 }\n}\n")
    write_av(dir, "clash", "import one\nimport two\nfn main {\n  puts(1)\n}\n")
    clash_bin = "${dir}/clash.bin"
    clash_log = "${dir}/clash.log"
    clash_out = "${dir}/clash.out"
    clash_code = compile_av(compiler, "${dir}/clash.av", clash_bin, clash_log)
    c.eq_int(clash_code, 0, "two Box types compile")
    chmod_x(clash_bin)
    run_av_bin(clash_bin, clash_out)
    if got = fs.read(clash_out) {
      c.eq_str(got, "1\n", "two Box types unused")
    } else {
      c.expect(false, "two Box types unused")
    }
    write_av(dir, "bare", "import one\nimport two\nfn main {\n  b = Box.new(1)\n  puts(b.n)\n}\n")
    bare_bin = "${dir}/bare.bin"
    bare_log = "${dir}/bare.log"
    bare_code = compile_av(compiler, "${dir}/bare.av", bare_bin, bare_log)
    c.expect(bare_code != 0, "bare Box exits non-zero")
    c.expect(!fs.exists(bare_bin), "bare Box bin absent")
    if err = fs.read(bare_log) {
      c.expect(err.contains("Box is a type of both one and two: write one.Box or two.Box"), "bare Box ambiguous")
    } else {
      c.expect(false, "bare Box ambiguous")
    }
    write_av(dir, "qualbox", "import one\nimport two\nfn main {\n  a = one.Box.new(1)\n  b = two.Box.new(2)\n  puts(a.draw())\n  puts(b.draw())\n}\n")
    qb_bin = "${dir}/qualbox.bin"
    qb_log = "${dir}/qualbox.log"
    qb_out = "${dir}/qualbox.out"
    qb_code = compile_av(compiler, "${dir}/qualbox.av", qb_bin, qb_log)
    c.eq_int(qb_code, 0, "qualified Box types")
    chmod_x(qb_bin)
    run_av_bin(qb_bin, qb_out)
    if got = fs.read(qb_out) {
      c.eq_str(got, "1\n12\n", "qualified Box draw")
    } else {
      c.expect(false, "qualified Box draw")
    }

    write_av(dir, "show_int", "pub fn show(n: Int): Int {\n  n\n}\n")
    write_av(dir, "show_str", "pub fn show(s: String): Int {\n  s.size\n}\n")
    write_av(dir, "over", "import show_int\nimport show_str\nfn main {\n  puts(show(7))\n  puts(show(\"ab\"))\n}\n")
    over_bin = "${dir}/over.bin"
    over_log = "${dir}/over.log"
    over_out = "${dir}/over.out"
    over_code = compile_av(compiler, "${dir}/over.av", over_bin, over_log)
    c.eq_int(over_code, 0, "pub overloads")
    chmod_x(over_bin)
    run_av_bin(over_bin, over_out)
    if got = fs.read(over_out) {
      c.eq_str(got, "7\n2\n", "merged pub overloads")
    } else {
      c.expect(false, "merged pub overloads")
    }

    write_av(dir, "alpha", "pub fn value: Int { 1 }\n")
    write_av(dir, "beta", "pub class Value {\n  pub n: Int\n  fn initialize(n: Int) {\n    self.n = n\n  }\n}\n")
    write_av(dir, "qual", "import alpha\nimport beta\nfn main {\n  puts(alpha.value())\n  v = beta.Value.new(2)\n  puts(v.n)\n}\n")
    qual_bin = "${dir}/qual.bin"
    qual_log = "${dir}/qual.log"
    qual_out = "${dir}/qual.out"
    qual_code = compile_av(compiler, "${dir}/qual.av", qual_bin, qual_log)
    c.eq_int(qual_code, 0, "qualify clash")
    chmod_x(qual_bin)
    run_av_bin(qual_bin, qual_out)
    if got = fs.read(qual_out) {
      c.eq_str(got, "1\n2\n", "qualified clash")
    } else {
      c.expect(false, "qualified clash")
    }

    write_av(dir, "vec2", "pub struct Vec2 {\n  pub x: Int\n  pub y: Int\n}\n")
    write_av(dir, "ext", "import vec2\npub fn (v: Vec2) doubled: Vec2 {\n  Vec2 { x: v.x * 2, y: v.y * 2 }\n}\n")
    write_av(dir, "apply", "import vec2\nimport ext\nfn main {\n  v = Vec2 { x: 1, y: 3 }\n  w = v.doubled()\n  puts(w.x)\n  puts(w.y)\n}\n")
    apply_bin = "${dir}/apply.bin"
    apply_log = "${dir}/apply.log"
    apply_out = "${dir}/apply.out"
    apply_code = compile_av(compiler, "${dir}/apply.av", apply_bin, apply_log)
    c.eq_int(apply_code, 0, "external method")
    chmod_x(apply_bin)
    run_av_bin(apply_bin, apply_out)
    if got = fs.read(apply_out) {
      c.eq_str(got, "2\n6\n", "doubled")
    } else {
      c.expect(false, "doubled")
    }

    proj = "${dir}/proj"
    mkdir_p("${proj}/tests/math")
    mkdir_p("${proj}/http")
    _ = fs.write("${proj}/avant.toml", "[package]\nname = \"proj\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${proj}/vec.av", "pub struct Vec2 {\n  pub x: Int\n  pub y: Int\n}\n")
    _ = fs.write("${proj}/http/server.av", "pub class Server {\n  fn initialize {\n  }\n  pub fn port: Int { 80 }\n}\n")
    _ = fs.write("${proj}/tests/math/test_add.av", "import vec\nimport http.server\nfn main {\n  v = Vec2 { x: 1, y: 2 }\n  s = Server.new()\n  puts(v.x)\n  puts(s.port())\n}\n")
    nest_bin = "${dir}/nest.bin"
    nest_log = "${dir}/nest.log"
    nest_out = "${dir}/nest.out"
    nest_code = compile_av(compiler, "${proj}/tests/math/test_add.av", nest_bin, nest_log)
    c.eq_int(nest_code, 0, "nested import from tests/")
    chmod_x(nest_bin)
    run_av_bin(nest_bin, nest_out)
    if got = fs.read(nest_out) {
      c.eq_str(got, "1\n80\n", "unqualified nested names")
    } else {
      c.expect(false, "unqualified nested names")
    }

    dep_app = "${dir}/depapp"
    mkdir_p("${dep_app}/deps/greeter/http")
    fake_fetched(dep_app, "depapp", "greeter")
    _ = fs.write("${dep_app}/deps/greeter/avant.toml", "[package]\nname = \"greeter\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${dep_app}/deps/greeter/http/server.av", "pub fn listen: Int { 7 }\n")
    _ = fs.write("${dep_app}/main.av", "import http.server\nfn main {\n  puts(listen())\n}\n")
    dep_bin = "${dir}/dep.bin"
    dep_log = "${dir}/dep.log"
    dep_out = "${dir}/dep.out"
    dep_code = compile_av(compiler, "${dep_app}/main.av", dep_bin, dep_log)
    c.eq_int(dep_code, 0, "dep nested import")
    chmod_x(dep_bin)
    run_av_bin(dep_bin, dep_out)
    if got = fs.read(dep_out) {
      c.eq_str(got, "7\n", "dep nested listen")
    } else {
      c.expect(false, "dep nested listen")
    }

    sh = "${dir}/shadow"
    mkdir_p("${sh}/nest")
    _ = fs.write("${sh}/avant.toml", "[package]\nname = \"shadow\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${sh}/vec.av", "pub fn from_root: Int { 1 }\n")
    _ = fs.write("${sh}/nest/vec.av", "pub fn from_nest: Int { 2 }\n")
    _ = fs.write("${sh}/nest/main.av", "import vec\nfn main {\n  puts(1)\n}\n")
    sh_bin = "${dir}/shadow.bin"
    sh_log = "${dir}/shadow.log"
    sh_code = compile_av(compiler, "${sh}/nest/main.av", sh_bin, sh_log)
    c.expect(sh_code != 0, "shadow exits non-zero")
    c.expect(!fs.exists(sh_bin), "shadow bin absent")
    if err = fs.read(sh_log) {
      c.expect(err.contains("import vec is ambiguous"), "shadow names both")
      c.expect(err.contains("nest/vec.av"), "shadow beside path")
      c.expect(err.contains("/vec.av"), "shadow manifest path")
    } else {
      c.expect(false, "shadow names both")
    }

    cyc = "${dir}/cyc"
    mkdir_p("${cyc}/sub")
    _ = fs.write("${cyc}/avant.toml", "[package]\nname = \"cyc\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${cyc}/a.av", "import sub.b\npub fn from_a: Int { 1 }\n")
    _ = fs.write("${cyc}/sub/b.av", "import a\npub fn from_b: Int { from_a() }\n")
    _ = fs.write("${cyc}/main.av", "import a\nfn main {\n  puts(from_a())\n}\n")
    cyc_bin = "${dir}/cyc.bin"
    cyc_log = "${dir}/cyc.log"
    cyc_code = compile_av(compiler, "${cyc}/main.av", cyc_bin, cyc_log)
    c.expect(cyc_code != 0, "cross-dir cycle exits non-zero")
    c.expect(!fs.exists(cyc_bin), "cross-dir cycle bin absent")
    if err = fs.read(cyc_log) {
      c.expect(err.contains("import cycle"), "cross-dir cycle")
    } else {
      c.expect(false, "cross-dir cycle")
    }

    tw = "${dir}/twice"
    mkdir_p("${tw}/http")
    _ = fs.write("${tw}/avant.toml", "[package]\nname = \"twice\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${tw}/http/server.av", "pub fn listen: Int { 1 }\n")
    _ = fs.write("${tw}/http/client.av", "import server\nimport http.server\npub fn go: Int { listen() }\n")
    _ = fs.write("${tw}/main.av", "import http.client\nfn main {\n  puts(go())\n}\n")
    tw_bin = "${dir}/twice.bin"
    tw_log = "${dir}/twice.log"
    tw_code = compile_av(compiler, "${tw}/main.av", tw_bin, tw_log)
    c.expect(tw_code != 0, "two spellings exits non-zero")
    c.expect(!fs.exists(tw_bin), "two spellings bin absent")
    if err = fs.read(tw_log) {
      c.expect(err.contains("open the same file"), "two spellings")
    } else {
      c.expect(false, "two spellings")
    }

    rootp = "${dir}/rootprobe"
    mkdir_p("${rootp}/compiler/checker")
    mkdir_p("${rootp}/compiler/codegen")
    _ = fs.write("${rootp}/avant.toml", "[package]\nname = \"rootprobe\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${rootp}/compiler/loader.av", "pub fn answer: Int { 4 }\n")
    _ = fs.write("${rootp}/compiler/codegen/calls.av", "pub fn ring: Int { 3 }\n")
    _ = fs.write("${rootp}/compiler/checker/use.av", "import codegen.calls\nimport loader\npub fn go: Int { ring() + answer() }\n")
    _ = fs.write("${rootp}/compiler/main.av", "import checker.use\nfn main {\n  puts(go())\n}\n")
    rp_bin = "${dir}/rootprobe.bin"
    rp_log = "${dir}/rootprobe.log"
    rp_out = "${dir}/rootprobe.out"
    rp_code = compile_av(compiler, "${rootp}/compiler/main.av", rp_bin, rp_log)
    c.eq_int(rp_code, 0, "compilation root probe")
    chmod_x(rp_bin)
    run_av_bin(rp_bin, rp_out)
    if got = fs.read(rp_out) {
      c.eq_str(got, "7\n", "nested import under compiled file")
    } else {
      c.expect(false, "nested import under compiled file")
    }

    both = "${dir}/bothroot"
    mkdir_p("${both}/src/nest")
    _ = fs.write("${both}/avant.toml", "[package]\nname = \"bothroot\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${both}/vec.av", "pub fn from_manifest: Int { 1 }\n")
    _ = fs.write("${both}/src/vec.av", "pub fn from_root: Int { 2 }\n")
    _ = fs.write("${both}/src/nest/use.av", "import vec\npub fn go: Int { 1 }\n")
    _ = fs.write("${both}/src/main.av", "import nest.use\nfn main {\n  puts(go())\n}\n")
    both_bin = "${dir}/bothroot.bin"
    both_log = "${dir}/bothroot.log"
    both_code = compile_av(compiler, "${both}/src/main.av", both_bin, both_log)
    c.expect(both_code != 0, "root and manifest exits non-zero")
    c.expect(!fs.exists(both_bin), "root and manifest bin absent")
    if err = fs.read(both_log) {
      c.expect(err.contains("import vec is ambiguous"), "root and manifest")
      c.expect(err.contains("src/vec.av"), "root path")
      c.expect(err.contains("bothroot/vec.av"), "manifest path")
    } else {
      c.expect(false, "root and manifest")
    }

    spell = "${dir}/spell"
    mkdir_p("${spell}/compiler/checker")
    _ = fs.write("${spell}/avant.toml", "[package]\nname = \"spell\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${spell}/compiler/checker/facts.av", "pub fn n: Int { 1 }\n")
    _ = fs.write("${spell}/compiler/checker/use.av", "import facts\nimport checker.facts\npub fn go: Int { n() }\n")
    _ = fs.write("${spell}/compiler/main.av", "import checker.use\nfn main {\n  puts(go())\n}\n")
    spell_bin = "${dir}/spell.bin"
    spell_log = "${dir}/spell.log"
    spell_code = compile_av(compiler, "${spell}/compiler/main.av", spell_bin, spell_log)
    c.expect(spell_code != 0, "root two spellings exits non-zero")
    c.expect(!fs.exists(spell_bin), "root two spellings bin absent")
    if err = fs.read(spell_log) {
      c.expect(err.contains("open the same file"), "root two spellings")
    } else {
      c.expect(false, "root two spellings")
    }

    seal = "${dir}/seal"
    mkdir_p("${seal}/deps/lib")
    fake_fetched(seal, "seal", "lib")
    _ = fs.write("${seal}/deps/lib/avant.toml", "[package]\nname = \"lib\"\nversion = \"0.1.0\"\n")
    _ = fs.write("${seal}/hidden.av", "pub fn hidden: Int { 1 }\n")
    _ = fs.write("${seal}/deps/lib/greeter.av", "import hidden\npub fn go: Int { hidden() }\n")
    _ = fs.write("${seal}/main.av", "import greeter\nfn main {\n  puts(go())\n}\n")
    seal_bin = "${dir}/seal.bin"
    seal_log = "${dir}/seal.log"
    seal_code = compile_av(compiler, "${seal}/main.av", seal_bin, seal_log)
    c.expect(seal_code != 0, "dep does not see consumer exits non-zero")
    c.expect(!fs.exists(seal_bin), "dep does not see consumer bin absent")
    if err = fs.read(seal_log) {
      c.expect(err.contains("cannot find hidden.av"), "dep does not see consumer")
    } else {
      c.expect(false, "dep does not see consumer")
    }

    kw = "${dir}/kw"
    mkdir_p("${kw}/pkg")
    _ = fs.write("${kw}/pkg/spawn.av", "pub struct Node {\n  pub n: Int\n}\npub fn from_spawn: Int { 3 }\n")
    _ = fs.write("${kw}/other.av", "pub struct Node {\n  pub n: Int\n}\n")
    _ = fs.write("${kw}/main.av", "import pkg.spawn\nimport other\nfn main {\n  v = pkg.spawn.Node { n: 1 }\n  w = other.Node { n: 2 }\n  puts(v.n)\n  puts(w.n)\n  puts(from_spawn())\n}\n")
    kw_bin = "${dir}/kw.bin"
    kw_log = "${dir}/kw.log"
    kw_out = "${dir}/kw.out"
    kw_code = compile_av(compiler, "${kw}/main.av", kw_bin, kw_log)
    c.eq_int(kw_code, 0, "keyword after a dot")
    c.expect(fs.exists(kw_bin), "keyword after a dot bin")
    chmod_x(kw_bin)
    run_av_bin(kw_bin, kw_out)
    if got = fs.read(kw_out) {
      c.eq_str(got, "1\n2\n3\n", "keyword segment and qualifier")
    } else {
      c.expect(false, "keyword segment and qualifier")
    }

    member = "${dir}/member.av"
    _ = fs.write(member, "struct Box {\n  n: Int\n}\nfn main {\n  b = Box { n: 1 }\n  puts(b.for)\n}\n")
    member_bin = "${dir}/member.bin"
    member_log = "${dir}/member.log"
    member_code = compile_av(compiler, member, member_bin, member_log)
    c.expect(member_code != 0, "keyword member exits non-zero")
    c.expect(!fs.exists(member_bin), "keyword member bin absent")
    if err = fs.read(member_log) {
      c.expect(err.contains("no field for"), "keyword member is a name")
      c.expect(!err.contains("expected a name"), "keyword member is not a parse error")
    } else {
      c.expect(false, "keyword member is a name")
    }

    lead = "${dir}/lead.av"
    _ = fs.write(lead, "import spawn\nfn main {\n  puts(1)\n}\n")
    lead_bin = "${dir}/lead.bin"
    lead_log = "${dir}/lead.log"
    lead_code = compile_av(compiler, lead, lead_bin, lead_log)
    c.expect(lead_code != 0, "leading keyword import exits non-zero")
    c.expect(!fs.exists(lead_bin), "leading keyword import bin absent")
    if err = fs.read(lead_log) {
      c.expect(err.contains("expected a name, found `spawn`"), "leading keyword import")
    } else {
      c.expect(false, "leading keyword import")
    }

    decl = "${dir}/decl.av"
    _ = fs.write(decl, "fn spawn: Int { 1 }\nfn main {\n  puts(spawn())\n}\n")
    decl_bin = "${dir}/decl.bin"
    decl_log = "${dir}/decl.log"
    decl_code = compile_av(compiler, decl, decl_bin, decl_log)
    c.expect(decl_code != 0, "keyword function name exits non-zero")
    c.expect(!fs.exists(decl_bin), "keyword function name bin absent")
    if err = fs.read(decl_log) {
      c.expect(err.contains("expected function name"), "keyword function name")
    } else {
      c.expect(false, "keyword function name")
    }

    label = "${dir}/label.av"
    _ = fs.write(label, "struct Point {\n  x: Int\n}\nfn main {\n  p = Point { for: 1 }\n  puts(p.x)\n}\n")
    label_bin = "${dir}/label.bin"
    label_log = "${dir}/label.log"
    label_code = compile_av(compiler, label, label_bin, label_log)
    c.expect(label_code != 0, "keyword field label exits non-zero")
    c.expect(!fs.exists(label_bin), "keyword field label bin absent")
    if err = fs.read(label_log) {
      c.expect(err.contains("expected an expression, found `{`"), "keyword field label")
    } else {
      c.expect(false, "keyword field label")
    }

    write_av(dir, "solo", "fn main {\n  puts(1)\n}\n")
    solo_bin = "${dir}/solo.bin"
    solo_log = "${dir}/solo.log"
    solo_out = "${dir}/solo.out"
    solo_code = compile_av(compiler, "${dir}/solo.av", solo_bin, solo_log)
    c.eq_int(solo_code, 0, "single file")
    chmod_x(solo_bin)
    run_av_bin(solo_bin, solo_out)
    if got = fs.read(solo_out) {
      c.eq_str(got, "1\n", "single file no import")
    } else {
      c.expect(false, "single file no import")
    }
    test_fn_scopes(c, compiler, dir)
    test_field_privacy(c, compiler, dir)
    test_default_modules(c, compiler, dir)
    test_default_once(c, compiler, dir)
    test_generic_modules(c, compiler, dir)
    test_same_name_methods(c, compiler, dir)
    test_same_name_derived(c, compiler, dir)
    test_c_binding_twice(c, compiler, dir)
    test_ptr_crossing(c, compiler, dir)
    test_layout_twins(c, compiler, dir)
    test_last_name(c, compiler, dir)
    test_std_qualified(c, compiler, dir)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

// Fields are private unless `pub`: outside
// its type's module a field without `pub` cannot be read, written,
// or named in a literal; a comptime walk from another module sees
// only the `pub` fields. No build is exempt: the compiler's own
// layout (a checkout's `compiler/main.av` root) obeys the rule too
// (its bootstrap exemption ended with the v0.40.0 seed).
fn test_field_privacy(c: Checks, compiler: String, dir: String) {
  write_av(dir, "acct", "pub class Account {\n  amount: Int = 0\n  pub owner: String = \"\"\n  pub fn balance: Int { amount }\n  pub fn add(n: Int) { self.amount = amount + n }\n}\npub struct Span {\n  pub lo: Int\n  pub hi: Int\n}\npub struct Secret {\n  pub shown: Int\n  kept: Int\n}\npub fn secret(n: Int): Secret { Secret { shown: n, kept: n * 2 } }\npub fn (s: Secret) kept_twice: Int { s.kept * 2 }\n")
  write_av(dir, "pfok", "import acct\nfn main {\n  a = Account.new()\n  a.add(5)\n  a.owner = \"ann\"\n  puts(a.balance())\n  puts(a.owner)\n  s = Span { lo: 1, hi: 4 }\n  s.hi = 6\n  puts(s.hi - s.lo)\n  t = secret(3)\n  puts(t.shown + t.kept_twice())\n}\n")
  mod_runs(c, compiler, dir, "pfok", "5\nann\n5\n15\n", "pub fields across modules")
  write_av(dir, "pfread", "import acct\nfn main {\n  a = Account.new()\n  puts(a.amount)\n}\n")
  mod_fails(c, compiler, dir, "pfread", "field amount of Account is private to module acct; mark it pub", "read a private field")
  write_av(dir, "pfwrite", "import acct\nfn main {\n  a = Account.new()\n  a.amount = -100\n  puts(a.balance())\n}\n")
  mod_fails(c, compiler, dir, "pfwrite", "field amount of Account is private to module acct", "write a private field")
  write_av(dir, "pfcomp", "import acct\nfn main {\n  a = Account.new()\n  a.amount += 1\n  puts(a.balance())\n}\n")
  mod_fails(c, compiler, dir, "pfcomp", "field amount of Account is private to module acct", "compound-assign a private field")
  write_av(dir, "pflit", "import acct\nfn main {\n  s = Secret { shown: 1, kept: 2 }\n  puts(s.shown)\n}\n")
  mod_fails(c, compiler, dir, "pflit", "field kept of Secret is private to module acct", "name a private field in a literal")
  write_av(dir, "pflit2", "import acct\nfn main {\n  s = Secret { shown: 1 }\n  puts(s.shown)\n}\n")
  mod_fails(c, compiler, dir, "pflit2", "Secret has private fields (kept); a literal outside module acct cannot build it", "omit a private field in a literal")
  write_av(dir, "pfext", "import acct\npub fn (s: Secret) peek: Int { s.kept }\nfn main {\n  puts(secret(1).peek())\n}\n")
  mod_fails(c, compiler, dir, "pfext", "field kept of Secret is private to module acct", "external method in another module")
  write_av(dir, "gbox", "pub class Holder(T) {\n  item: T\n  pub tag: Int = 1\n  fn initialize(item: T) {\n    self.item = item\n  }\n  pub fn get: T { item }\n}\n")
  write_av(dir, "pfgen", "import gbox\nfn main {\n  h = Holder.new(\"x\")\n  puts(h.get())\n  puts(h.tag)\n  puts(h.item)\n}\n")
  mod_fails(c, compiler, dir, "pfgen", "field item of Holder(String) is private to module gbox", "private field of a generic class")
  write_av(dir, "pfgok", "import gbox\nfn main {\n  h = Holder.new(\"x\")\n  puts(h.get())\n  puts(h.tag)\n}\n")
  mod_runs(c, compiler, dir, "pfgok", "x\n1\n", "pub field of a generic class")
  write_av(dir, "pfwalk", "import acct\ncomptime {\n  for f in Secret.fields {\n    quote {\n      fn #(f.name)(s: Secret): #(f.type) {\n        s.#(f.name)\n      }\n    }\n  }\n}\nfn main {\n  puts(shown(secret(4)))\n}\n")
  mod_runs(c, compiler, dir, "pfwalk", "4\n", "comptime walk from another module sees the pub fields")
  write_av(dir, "pfwalk2", "import acct\ncomptime {\n  for f in Secret.fields {\n    quote {\n      fn #(f.name)(s: Secret): #(f.type) {\n        s.#(f.name)\n      }\n    }\n  }\n}\nfn main {\n  puts(kept(secret(4)))\n}\n")
  mod_fails(c, compiler, dir, "pfwalk2", "unknown function kept", "comptime walk from another module skips private fields")
  write_av(dir, "pfquote", "struct P {\n  pub quote {\n  }\n}\nfn main {\n  puts(1)\n}\n")
  mod_fails(c, compiler, dir, "pfquote", "pub in a type body prefixes fn or a field", "pub before a quote")

  boot = "${dir}/boot"
  mkdir_p("${boot}/compiler")
  mkdir_p("${boot}/runtime")
  _ = fs.write("${boot}/runtime/build.sh", "true\n")
  _ = fs.write("${boot}/compiler/ast.av", "pub struct Node {\n  n: Int\n}\n")
  _ = fs.write("${boot}/compiler/main.av", "import ast\nfn main {\n  v = Node { n: 7 }\n  puts(v.n)\n}\n")
  boot_bin = "${dir}/boot.bin"
  boot_log = "${dir}/boot.log"
  boot_code = compile_av(compiler, "${boot}/compiler/main.av", boot_bin, boot_log)
  c.expect(boot_code != 0, "a checkout's compiler/main.av is not exempt: exits non-zero")
  c.expect(!fs.exists(boot_bin), "a checkout's compiler/main.av is not exempt: bin absent")
  if err = fs.read(boot_log) {
    c.expect(err.contains("field n of Node is private to module ast"), "a checkout's compiler/main.av is not exempt")
  } else {
    c.expect(false, "a checkout's compiler/main.av is not exempt")
  }
}

// A parameter default belongs to its declaration: spliced into a
// call, it is checked in the callee's module, with none of the
// caller's names in scope, whatever the call's form: a qualified
// call, an unqualified one, a constructor, a method with and without
// parentheses, a type-level function. Before, only the qualified
// call did; the others reported `unknown function secret`, or called
// the calling module's function of that name. An earlier parameter
// named by a default is that parameter's value (test_default_once).
fn test_default_modules(c: Checks, compiler: String, dir: String) {
  write_av(dir, "dlib", "fn secret: Int {\n  7\n}\n\npub fn pick(n: Int = secret()): Int {\n  n\n}\n\npub fn span(a: Int, b: Int = a + secret()): Int {\n  a * 100 + b\n}\n\npub fn same(a: String, b: String = a): String {\n  \"\${a}\${b}\"\n}\n\npub class Box {\n  pub v: Int = 0\n\n  fn initialize(v: Int = secret()) {\n    self.v = v\n  }\n\n  pub fn plus(k: Int = secret()): Int {\n    v + k\n  }\n\n  pub fn self.make(k: Int = secret()): Int {\n    k\n  }\n}\n\npub struct Pt {\n  pub x: Int\n\n  pub fn far(k: Int = secret()): Int {\n    x + k\n  }\n}\n\npub fn (s: String) pad(k: Int = secret()): Int {\n  s.size + k\n}\n")
  write_av(dir, "dplain", "import dlib\n\nfn main {\n  puts(dlib.pick())\n  puts(pick())\n  b = Box.new()\n  puts(b.v)\n  puts(b.plus())\n  puts(b.plus())\n  puts(Box.make())\n  puts(Box.make())\n  p = Pt { x: 1 }\n  puts(p.far())\n  puts(\"ab\".pad())\n}\n")
  mod_runs(c, compiler, dir, "dplain", "7\n7\n7\n14\n14\n7\n7\n8\n9\n", "a default names a function private to its module: every call form")
  write_av(dir, "dsame", "import dlib\n\nfn secret: Int {\n  1000\n}\n\nfn mine: Int {\n  3\n}\n\nclass User {\n  n: Int = 0\n\n  fn secret: Int {\n    5000\n  }\n\n  fn go: Int {\n    pick() + Box.new().plus()\n  }\n}\n\nfn wrap(x: T): Int {\n  pick() + Box.new().v\n}\n\nfn main {\n  puts(dlib.pick())\n  puts(pick())\n  b = Box.new()\n  puts(b.v)\n  puts(b.plus())\n  puts(b.plus())\n  puts(Box.make())\n  puts(Box.make())\n  puts(User.new().go())\n  puts(wrap(1) + wrap(\"s\"))\n  secret = { |k: Int| k + 90000 }\n  puts(pick() + secret(1))\n  x = 4\n  puts(span(x + mine()))\n  puts(span(1, 2))\n  puts(same(\"ab\"))\n  puts(dsame.secret())\n}\n")
  mod_runs(c, compiler, dir, "dsame", "7\n7\n7\n14\n14\n7\n7\n21\n28\n90008\n714\n102\nabab\n1000\n", "the calling module's function, method and local of the same name do not capture a default")
}

// A default that names an earlier parameter reads that parameter's
// value: the argument as the call passes it, evaluated once, with the
// parameter's declared type. Before, a copy of the argument's expression
// stood in for the name: the argument ran once for its parameter and
// once more for each mention (`pair(tick(t))` left two ticks and
// returned 1102), and again each time a lambda in the default ran; a
// default that used an optional parameter as declared, or called a
// function with such a default of its own, did not compile. Every call
// path counts its ticks: functions unqualified, imported and qualified,
// two defaults in a row, a constructor, a method of a class and of a
// struct, a type-level function, a generic function's instance.
fn test_default_once(c: Checks, compiler: String, dir: String) {
  write_av(dir, "olib", "pub class Tally {\n  pub n: Int = 0\n}\n\npub fn tick(t: Tally): Int {\n  t.n += 1\n  t.n\n}\n\npub fn pair(a: Int, b: Int = a + 100): Int {\n  a * 1000 + b\n}\n\npub fn triple(a: Int, b: Int = a + 1, c: Int = a + b): Int {\n  a * 10000 + b * 100 + c\n}\n\npub fn outer(a: Int, b: Int = pair(a)): Int {\n  a * 100000 + b\n}\n\npub class Box {\n  pub v: Int\n  pub w: Int\n\n  pub fn initialize(v: Int, w: Int = v * 2) {\n    self.v = v\n    self.w = w\n  }\n\n  pub fn add(a: Int, b: Int = a + 100): Int {\n    self.v + a * 1000 + b\n  }\n\n  pub fn self.make(a: Int, b: Int = a + 100): Int {\n    a * 1000 + b\n  }\n}\n\npub struct Pt {\n  pub x: Int\n\n  pub fn shift(a: Int, b: Int = a + 100): Int {\n    self.x + a * 1000 + b\n  }\n}\n\npub fn same(a: T, b: T = a): T {\n  b\n}\n")
  write_av(dir, "oeval", "import olib\n\nfn pair2(a: Int, b: Int = a + 100): Int {\n  a * 1000 + b\n}\n\nfn opt(a: Int?, b: Int = a ?? 7): Int {\n  b\n}\n\nfn text(a: String, b: Int = a.size): Int {\n  b\n}\n\nfn apply(a: Int, f: fn(Int): Int = { |x| x + a }): Int {\n  f(1) + f(2)\n}\n\nfn shadow(a: Int, f: fn(Int): Int = { |a| a * 2 }): Int {\n  f(a + 1)\n}\n\nfn twice(a: Int, b: Int = apply(a)): Int {\n  a + b\n}\n\nfn main {\n  t = Tally.new()\n  puts(\"unqualified \${pair2(tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"imported \${pair(tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"qualified \${olib.pair(tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"two defaults \${triple(tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  b = Box.new(tick(t))\n  puts(\"constructor \${b.v} \${b.w} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"method \${b.add(tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"type-level \${Box.make(tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  p = Pt { x: 5 }\n  puts(\"struct method \${p.shift(tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"generic \${same(tick(t))} ticks \${t.n}\")\n  puts(\"literal \${pair2(7)} string \${text(\"abc\")}\")\n  t = Tally.new()\n  puts(\"both written \${pair2(tick(t), tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"lambda \${apply(tick(t) * 10)} ticks \${t.n}\")\n}\n")
  mod_runs(c, compiler, dir, "oeval", "unqualified 1101 ticks 1\nimported 1101 ticks 1\nqualified 1101 ticks 1\ntwo defaults 10203 ticks 1\nconstructor 1 2 ticks 1\nmethod 1102 ticks 1\ntype-level 1101 ticks 1\nstruct method 1106 ticks 1\ngeneric 1 ticks 1\nliteral 7107 string 3\nboth written 1002 ticks 2\nlambda 23 ticks 1\n", "an argument a default names is evaluated once on every call path")
  write_av(dir, "odecl", "import olib\n\nfn pair2(a: Int, b: Int = a + 100): Int {\n  a * 1000 + b\n}\n\nfn opt(a: Int?, b: Int = a ?? 7): Int {\n  b\n}\n\nfn text(a: String, b: Int = a.size): Int {\n  b\n}\n\nfn apply(a: Int, f: fn(Int): Int = { |x| x + a }): Int {\n  f(1) + f(2)\n}\n\nfn shadow(a: Int, f: fn(Int): Int = { |a| a * 2 }): Int {\n  f(a + 1)\n}\n\nfn twice(a: Int, b: Int = apply(a)): Int {\n  a + b\n}\n\nfn main {\n  t = Tally.new()\n  puts(\"nested \${outer(tick(t))} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"optional \${opt(tick(t))} \${opt(nil)} ticks \${t.n}\")\n  t = Tally.new()\n  run: fn(Int): Int = { |k|\n    apply(tick(t) * 10) + k\n  }\n  puts(\"inside a lambda \${run(1000)} ticks \${t.n}\")\n  t = Tally.new()\n  puts(\"lambda through a default \${twice(tick(t) * 10)} ticks \${t.n}\")\n  a = 99\n  puts(\"a block's own parameter \${shadow(5)}; the caller's a \${apply(3)} \${a}\")\n}\n")
  mod_runs(c, compiler, dir, "odecl", "nested 101101 ticks 1\noptional 1 7 ticks 1\ninside a lambda 1023 ticks 1\nlambda through a default 33 ticks 1\na block's own parameter 12; the caller's a 9 99\n", "a default reads its earlier parameter as declared: optional, through another default, in a lambda")
}

// An imported generic takes types of the module that uses it:
// before, `Box(Point)` with Box imported and Point declared here
// reported `unknown type Point`, because the instance's fields and
// methods read the argument's name again inside Box's module. An
// instance now carries each argument pinned to the type it named
// where it was written. Privacy holds where a name is written: a
// private type of another module is refused as an argument, an
// element type, or a part of a union or a function type.
fn test_generic_modules(c: Checks, compiler: String, dir: String) {
  write_av(dir, "gbx", "pub class Box(T) {\n  pub item: T\n\n  fn initialize(item: T) {\n    self.item = item\n  }\n\n  pub fn get: T {\n    item\n  }\n\n  pub fn set(v: T) {\n    self.item = v\n  }\n\n  pub fn pair: Duo(T, Int) {\n    Duo { a: item, b: 2 }\n  }\n\n  pub fn many(n: Int): Array(T) {\n    Array(T).new(n) { |i| item }\n  }\n}\n\npub struct Duo(A, B) {\n  pub a: A\n  pub b: B\n\n  pub fn first: A {\n    a\n  }\n}\n\npub fn wrap(x: T): Box(T) {\n  Box.new(x)\n}\n\npub fn firsts(xs: Array(T)): T {\n  xs[0]\n}\n\npub fn twice(x: T, f: fn(T): T): T {\n  f(f(x))\n}\n")
  write_av(dir, "gtag", "import gbx\n\npub struct Tag {\n  pub name: String\n}\n\nstruct Hidden {\n  pub n: Int\n}\n\npub fn tagged(name: String): Box(Tag) {\n  Box.new(Tag { name: name })\n}\n\npub fn hidden_n: Int {\n  h = Box.new(Hidden { n: 41 })\n  d = Duo { a: Hidden { n: 1 }, b: h.get() }\n  d.first().n + d.b.n\n}\n")
  write_av(dir, "gmain", "import gbx\n\npub struct Point {\n  x: Int\n  y: Int\n}\n\nstruct Local {\n  n: Int\n}\n\nclass Node {\n  v: Int = 0\n\n  fn initialize(v: Int) {\n    self.v = v\n  }\n}\n\nfn main {\n  b = Box(Point).new(Point { x: 1, y: 2 })\n  puts(b.item.x)\n  c = Box.new(Point { x: 3, y: 4 })\n  puts(c.get().y)\n  l = Box(Local).new(Local { n: 5 })\n  l.set(Local { n: 6 })\n  puts(l.get().n)\n  n = Box.new(Node.new(7))\n  puts(n.item.v)\n  d = Duo(Point, Local) { a: Point { x: 8, y: 0 }, b: Local { n: 9 } }\n  puts(d.first().x + d.b.n)\n  puts(l.pair().a.n + l.pair().b)\n  puts(l.many(3).size)\n  w = wrap(Local { n: 10 })\n  puts(w.get().n)\n  puts(firsts([Point { x: 11, y: 0 }]).x)\n  tw = twice(Local { n: 3 }) { |v| Local { n: v.n * 2 } }\n  puts(tw.n)\n  nested = Box(Box(Local)).new(Box.new(Local { n: 13 }))\n  puts(nested.get().get().n)\n  arr = Box(Array(Point)).new([Point { x: 14, y: 0 }])\n  puts(arr.item[0].x)\n  opt = Box(Local?).new(nil)\n  opt.set(Local { n: 15 })\n  if o = opt.get() {\n    puts(o.n)\n  }\n}\n")
  mod_runs(c, compiler, dir, "gmain", "1\n4\n6\n7\n17\n8\n3\n10\n11\n12\n13\n14\n15\n", "an imported generic class, struct and function take types of the importing module, pub and private")
  write_av(dir, "gthree", "import gbx\nimport gtag\n\nstruct Local {\n  n: Int\n}\n\nfn main {\n  t = tagged(\"a\")\n  puts(t.get().name)\n  u = Box(Tag).new(Tag { name: \"b\" })\n  puts(u.item.name)\n  both = Duo(Tag, Local) { a: Tag { name: \"c\" }, b: Local { n: 1 } }\n  puts(\"\${both.a.name}\${both.b.n}\")\n  puts(hidden_n())\n  puts(wrap(Tag { name: \"d\" }).get().name)\n}\n")
  mod_runs(c, compiler, dir, "gthree", "a\nb\nc1\n42\nd\n", "three modules: a generic of one, a type of another, a type of the root")
  write_av(dir, "gpriv1", "import gbx\nimport gtag\n\nfn main {\n  b = Box(Hidden).new(Hidden { n: 1 })\n  puts(b.item.n)\n}\n")
  mod_fails(c, compiler, dir, "gpriv1", "unknown type Hidden", "a private type of another module is not a type argument here")
  write_av(dir, "gpriv2", "import gbx\nimport gtag\n\nfn main {\n  xs: Array(Hidden) = []\n  puts(xs.size)\n}\n")
  mod_fails(c, compiler, dir, "gpriv2", "unknown type Hidden", "nor an element type")
  write_av(dir, "gpriv3", "import gbx\nimport gtag\n\nfn take(d: Duo(Int, Hidden)): Int {\n  d.a\n}\n\nfn main {\n  puts(1)\n}\n")
  mod_fails(c, compiler, dir, "gpriv3", "unknown type Hidden", "nor an argument of a generic struct in a signature")
  write_av(dir, "gpriv4", "import gbx\nimport gtag\n\nfn main {\n  f: fn(Int): Hidden? = nil\n  u: Int | Hidden = 1\n  puts(1)\n}\n")
  mod_fails(c, compiler, dir, "gpriv4", "unknown type Hidden", "nor a function type's result")
  write_av(dir, "gsame1", "pub struct Item {\n  pub v: Int\n}\n\npub fn one: Item {\n  Item { v: 1 }\n}\n")
  write_av(dir, "gsame2", "pub struct Item {\n  pub v: String\n}\n\npub fn two: Item {\n  Item { v: \"two\" }\n}\n")
  write_av(dir, "gsame", "import gbx\nimport gsame1\nimport gsame2\n\nfn main {\n  a = Box(gsame1.Item).new(one())\n  b = Box(gsame2.Item).new(two())\n  puts(\"\${a.get().v} \${b.get().v}\")\n  c = wrap(one())\n  d = wrap(two())\n  puts(\"\${c.item.v} \${d.item.v}\")\n}\n")
  mod_runs(c, compiler, dir, "gsame", "1 two\n1 two\n", "one generic over two types of the same name from two modules")
  write_av(dir, "gown", "import gbx\nimport gsame1\n\nstruct Item {\n  w: Int\n}\n\nfn main {\n  a = Box(gown.Item).new(gown.Item { w: 5 })\n  b = Box(gsame1.Item).new(one())\n  puts(a.item.w + b.item.v)\n}\n")
  mod_runs(c, compiler, dir, "gown", "6\n", "the root's own type and an imported one of the same name")
  write_av(dir, "gamb", "import gbx\nimport gsame1\nimport gsame2\n\nfn main {\n  a = Box(Item).new(one())\n  puts(a.get().v)\n}\n")
  mod_fails(c, compiler, dir, "gamb", "Item is a type of both gsame1 and gsame2: write gsame1.Item or gsame2.Item", "an argument two imports declare is ambiguous")
}

// Two modules declare a class Item and
// a struct Pt, each with methods, operators, a type-level function, a
// generic method and an external method of the same names; every call
// reaches its own module's. What the probe found, since fixed: a
// parameter of such a type (`fn +(o: Item)`) was `unknown type Item`
// (resolve_value_in_module looked the name up bare).
fn test_same_name_methods(c: Checks, compiler: String, dir: String) {
  write_av(dir, "sna", "pub class Item {\n  pub v: Int = 0\n\n  fn initialize(v: Int) {\n    self.v = v\n  }\n\n  pub fn label: String {\n    \"a\${v}\"\n  }\n\n  pub fn bump(n: Int): Int {\n    self.v += n\n    v\n  }\n\n  pub fn +(o: Item): Item {\n    Item.new(v + o.v)\n  }\n\n  pub fn equals(o: Item): Bool {\n    v == o.v\n  }\n\n  pub fn hash(h: Hasher) {\n    h.add(v)\n  }\n\n  pub fn self.zero: Item {\n    Item.new(0)\n  }\n\n  pub fn pick(x: T): T {\n    x\n  }\n}\n\npub struct Pt {\n  pub x: Int\n\n  pub fn far: Int {\n    x + 100\n  }\n\n  pub fn grow(k: Int) {\n    self.x += k\n  }\n}\n\npub fn (i: Item) ext: String {\n  \"ext-a\${i.v}\"\n}\n\npub fn make_a(v: Int): Item {\n  Item.new(v)\n}\n")
  write_av(dir, "snb", "pub class Item {\n  pub name: String = \"\"\n  pub w: Int = 7\n\n  fn initialize(name: String, w: Int) {\n    self.name = name\n    self.w = w\n  }\n\n  pub fn label: String {\n    \"b-\${name}\"\n  }\n\n  pub fn bump(n: Int): Int {\n    self.w -= n\n    w\n  }\n\n  pub fn +(o: Item): Item {\n    Item.new(\"\${name}\${o.name}\", w * o.w)\n  }\n\n  pub fn equals(o: Item): Bool {\n    name == o.name\n  }\n\n  pub fn hash(h: Hasher) {\n    h.add(name)\n  }\n\n  pub fn self.zero: Item {\n    Item.new(\"zero\", 0)\n  }\n\n  pub fn pick(x: T): T {\n    x\n  }\n}\n\npub struct Pt {\n  pub x: Int\n  pub y: Int\n\n  pub fn far: Int {\n    x * y\n  }\n\n  pub fn grow(k: Int) {\n    self.y += k\n  }\n}\n\npub fn (i: Item) ext: String {\n  \"ext-b\${i.name}\"\n}\n\npub fn make_b(name: String): Item {\n  Item.new(name, 2)\n}\n")
  write_av(dir, "snmain", "import sna\nimport snb\nfn main {\n  a = sna.Item.new(1)\n  b = snb.Item.new(\"x\", 3)\n  puts(a.label())\n  puts(b.label())\n  puts(a.label())\n  puts(b.label())\n  puts(a.bump(5))\n  puts(b.bump(1))\n  puts(a.ext())\n  puts(b.ext())\n  s = a + sna.Item.new(10)\n  puts(s.v)\n  t = b + snb.Item.new(\"y\", 5)\n  puts(\"\${t.name} \${t.w}\")\n  puts(a == sna.Item.new(6))\n  puts(b == snb.Item.new(\"x\", 0))\n  puts(sna.Item.zero().v)\n  puts(snb.Item.zero().name)\n  puts(a.pick(\"p\"))\n  puts(b.pick(4))\n  c = make_a(9)\n  d = make_b(\"q\")\n  puts(\"\${c.label()} \${d.label()}\")\n  as = [a, c]\n  bs = [b, d]\n  for i in as {\n    puts(i.label())\n  }\n  bs.each { |i| puts(i.label()) }\n  p = sna.Pt { x: 1 }\n  q = snb.Pt { x: 2, y: 3 }\n  puts(\"\${p.far()} \${q.far()}\")\n  p.grow(1)\n  q.grow(1)\n  puts(\"\${p.x} \${q.y}\")\n  ps = [snb.Pt { x: 5, y: 5 }]\n  ps[0].grow(2)\n  puts(ps[0].far())\n}\n")
  mod_runs(c, compiler, dir, "snmain", "a1\nb-x\na1\nb-x\n6\n2\next-a6\next-bx\n16\nxy 10\ntrue\ntrue\n0\nzero\np\n4\na9 b-q\na6\na9\nb-x\nb-q\n101 6\n2 4\n35\n", "two modules declare a class and a struct of one name with methods of the same names")
}

// Two modules each declare a struct or class of one name, and each type
// gets its own derived ==, hash, clone and order, its own initialize and
// its own fields: before, a derived method joined the first type of that
// name, so the other's == or clone was "no method", its key functions
// were not written, its order was another's, its initialize and fields
// were refused as if it had the first one's.
fn test_same_name_derived(c: Checks, compiler: String, dir: String) {
  write_av(dir, "dta", "pub struct Box {\n  pub x: Int\n}\n\npub class Bag {\n  pub n: Int = 0\n  pub xs: Array(Int) = []\n\n  pub fn initialize(self.n) {\n  }\n}\n\npub struct Key {\n  pub x: Int\n}\n\npub struct V {\n  pub n: Int\n\n  pub fn compare(other: V): Int {\n    n - other.n\n  }\n}\n\npub struct Rec {\n  pub n: Int\n\n  pub fn size: Int {\n    n\n  }\n}\n")
  write_av(dir, "dtb", "pub struct Box {\n  pub name: String\n  pub y: Int\n}\n\npub class Bag {\n  pub items: Array(String) = []\n  pub w: Int = 2\n}\n\npub struct Key {\n  pub x: Int\n\n  pub fn equals(other: Key): Bool {\n    true\n  }\n\n  pub fn hash(h: Hasher) {\n    h.add(0)\n  }\n}\n\npub struct V {\n  pub n: Int\n\n  pub fn compare(other: V): Int {\n    other.n - n\n  }\n}\n\npub struct Rec {\n  pub size: Int\n}\n\npub struct Outer {\n  pub inner: Key\n}\n")
  write_av(dir, "dtmain", "import dta\nimport dtb\n\nfn main {\n  puts(\"\${dta.Box { x: 1 } == dta.Box { x: 1 }} \${dtb.Box { name: \"p\", y: 2 } == dtb.Box { name: \"q\", y: 2 }}\")\n  a = dta.Bag.new(3)\n  a.xs.push(5)\n  b = dtb.Bag.new()\n  b.items.push(\"t\")\n  a2 = a.clone()\n  b2 = b.clone()\n  b2.items.push(\"u\")\n  puts(\"\${a2.n} \${a2.xs.size} \${b2.w} \${b.items.size} \${b2.items.size}\")\n  ha = Hash(dta.Key, Int).new()\n  ha[dta.Key { x: 1 }] = 10\n  ha[dta.Key { x: 2 }] = 20\n  hb = Hash(dtb.Key, Int).new()\n  hb[dtb.Key { x: 1 }] = 10\n  hb[dtb.Key { x: 2 }] = 20\n  ho = Hash(dtb.Outer, Int).new()\n  ho[dtb.Outer { inner: dtb.Key { x: 1 } }] = 1\n  ho[dtb.Outer { inner: dtb.Key { x: 2 } }] = 2\n  puts(\"\${ha.size} \${hb.size} \${ho.size} \${dta.Key { x: 1 } == dta.Key { x: 2 }} \${dtb.Key { x: 1 } == dtb.Key { x: 2 }}\")\n  xs = [dta.V { n: 3 }, dta.V { n: 1 }, dta.V { n: 2 }]\n  ys = [dtb.V { n: 3 }, dtb.V { n: 1 }, dtb.V { n: 2 }]\n  puts(\"\${xs.sorted()[0].n} \${ys.sorted()[0].n} \${dta.V { n: 1 } < dta.V { n: 2 }} \${dtb.V { n: 1 } < dtb.V { n: 2 }}\")\n  puts(\"\${dta.Rec { n: 3 }.size()} \${dtb.Rec { size: 4 }.size}\")\n}\n")
  mod_runs(c, compiler, dir, "dtmain", "true false\n3 1 2 1 2\n2 1 1 false true\n1 3 true false\n3 4\n", "two modules' types of one name each get their own derived methods")
}

// One C function bound twice with one signature: a program's own binding
// beside std.sync's, and two modules' bindings; each call goes through its
// own. Before, the second was refused as already bound.
fn test_c_binding_twice(c: Checks, compiler: String, dir: String) {
  write_av(dir, "cbsync", "// The program binds the runtime's avant_chosen_threads itself, as\n// std.sync does, with the same signature.\nimport std.sync\n\nlib task {\n  fun avant_chosen_threads: Int\n}\n\nfn main {\n  puts(task.avant_chosen_threads() == sync.pool_size())\n}\n")
  mod_runs(c, compiler, dir, "cbsync", "true\n", "a program binds a C function std.sync binds, with its signature")
  write_av(dir, "cbother", "lib oc {\n  fun abs(n: Int32): Int32\n}\n\npub fn mag(n: Int): Int {\n  oc.abs(n.to_i32()).to_i()\n}\n")
  write_av(dir, "cbmain", "// Two modules of the program bind one C function, each with the same\n// signature.\nimport cbother\n\nlib c {\n  fun abs(n: Int32): Int32\n}\n\nfn main {\n  puts(\"\${c.abs(-3)} \${cbother.mag(-4)}\")\n}\n")
  mod_runs(c, compiler, dir, "cbmain", "3 4\n", "two modules bind one C function with one signature")
}

// A Ptr to a C layout crosses a task only in the module whose lib block
// declares it: a program that imports the package cannot capture one.
fn test_ptr_crossing(c: Checks, compiler: String, dir: String) {
  write_av(dir, "xpkg", "// A package that binds C memory and shares it with its own tasks: a\n// Ptr to a C layout this module's lib block declares crosses here.\nlib ptrpkg {\n  struct Cell {\n    n: Int32\n  }\n  fun calloc(n: Int, size: Int): Ptr(Cell)\n  fun free(p: Ptr(Cell))\n  fun malloc(n: Int): Ptr(Void)\n}\n\npub fn shared_sum(k: Int): Int {\n  p = ptrpkg.calloc(1, Cell.size)\n  p.n = 41\n  h = spawn { p.n.to_i() + k }\n  r = h.join() ?? -1\n  ptrpkg.free(p)\n  r\n}\n\npub fn handed: Ptr(Cell) {\n  q = ptrpkg.calloc(1, Cell.size)\n  q.n = 7\n  h = spawn { q }\n  h.join() ?? q\n}\n")
  write_av(dir, "xuser", "import xpkg\n\nfn main {\n  p = xpkg.handed()\n  h = spawn { p.n.to_i() }\n  puts(h.join() ?? -1)\n}\n")
  mod_fails(c, compiler, dir, "xuser", "spawn cannot capture p: its type, Ptr(Cell), holds C memory, which crosses to another task only in the module whose lib block declares its C type", "a Ptr crosses a task only in its lib's module")
}

// Two modules' C layouts of one name: a method of one module's Ptr(Pair)
// is not the other's.
fn test_layout_twins(c: Checks, compiler: String, dir: String) {
  write_av(dir, "tla", "lib twina {\n  struct Pair {\n    n: Int32\n  }\n  fun calloc(n: Int, size: Int): Ptr(Pair)\n}\n\npub fn make: Ptr(Pair) {\n  p = twina.calloc(1, Pair.size)\n  p.n = 5\n  p\n}\n\npub fn read(p: Ptr(Pair)): Int {\n  p.n.to_i()\n}\n\npub fn (p: Ptr(Pair)) twice: Int {\n  p.n.to_i() * 2\n}\n")
  write_av(dir, "tlb", "lib twinb {\n  struct Pair {\n    k: Int32\n    j: Int32\n  }\n  fun malloc(size: Int): Ptr(Pair)\n}\n\npub fn make: Ptr(Pair) {\n  p = twinb.malloc(Pair.size)\n  p.k = 7\n  p.j = 8\n  p\n}\n\npub fn (p: Ptr(Pair)) n: Int {\n  99\n}\n\npub fn read(p: Ptr(Pair)): Int {\n  p.n()\n}\n")
  write_av(dir, "tlmain", "import tla\nimport tlb\n\nfn main {\n  q = tlb.make()\n  puts(q.twice())\n}\n")
  mod_fails(c, compiler, dir, "tlmain", "no method twice on Ptr(Pair)", "a method of one module's Ptr(Pair) is not another module's")
}

// A module's last name qualifies its names, as its whole name does
// (`import std.time`, then `time.now()`), in calls, function values,
// constants, types and struct literals. A local or a field of that name
// is the local or the field; a module named in whole by the name is that
// module; two imports ending in the name make it an error naming both.
fn test_last_name(c: Checks, compiler: String, dir: String) {
  mkdir_p("${dir}/ln/a")
  mkdir_p("${dir}/ln/b")
  write_av(dir, "ln/a/util", "pub const width = 3\n\npub fn who: Int {\n  1\n}\n\npub struct Box {\n  pub v: Int\n}\n\npub fn twice(x: Int): Int {\n  x * 2\n}\n")
  write_av(dir, "ln/b/util", "pub fn who: Int {\n  2\n}\n")
  write_av(dir, "ln/b/tool", "pub fn who: Int {\n  5\n}\n")
  write_av(dir, "ln/one", "import a.util\n\nfn get(x: util.Box): Int {\n  x.v\n}\n\nfn main {\n  b = util.Box { v: 4 }\n  f = util.twice\n  puts(util.who() + util.width + get(b) + f(10) + a.util.who())\n}\n")
  mod_runs(c, compiler, "${dir}/ln", "one", "29\n", "last name: util qualifies a.util's call, constant, type, literal and function value")
  write_av(dir, "ln/local", "import a.util\n\nfn main {\n  util = 7\n  puts(util)\n  puts(a.util.who())\n}\n")
  mod_runs(c, compiler, "${dir}/ln", "local", "7\n1\n", "last name: a local of the name is the local")
  write_av(dir, "ln/tool", "pub fn who: Int {\n  9\n}\n")
  write_av(dir, "ln/whole", "import tool\nimport b.tool\n\nfn main {\n  puts(tool.who() + b.tool.who())\n}\n")
  mod_runs(c, compiler, "${dir}/ln", "whole", "14\n", "last name: a module named tool in whole is tool; b.tool keeps its whole name")
  write_av(dir, "ln/clash", "import a.util\nimport b.util\n\nfn main {\n  puts(util.who())\n}\n")
  mod_fails(c, compiler, "${dir}/ln", "clash", "clash.av:5:8", "last name clash: the error points at the name")
  mod_fails(c, compiler, "${dir}/ln", "clash", "util is the last name of both a.util and b.util: write the whole name (a.util.… or b.util.…)", "last name clash: a call asks for the whole name")
  write_av(dir, "ln/clashty", "import a.util\nimport b.util\n\nfn f(x: util.Box): Int {\n  x.v\n}\n\nfn main {\n  puts(0)\n}\n")
  mod_fails(c, compiler, "${dir}/ln", "clashty", "util is the last name of both a.util and b.util", "last name clash: a type asks for the whole name")
  write_av(dir, "ln/bothok", "import a.util\nimport b.util\n\nfn main {\n  puts(a.util.who() + b.util.who())\n}\n")
  mod_runs(c, compiler, "${dir}/ln", "bothok", "3\n", "last name clash: the whole names still work")
  write_av(dir, "ln/unimported", "import a.util\n\nfn main {\n  puts(tool.who())\n}\n")
  mod_fails(c, compiler, "${dir}/ln", "unimported", "unknown name tool", "last name: a module not imported is not reached")
}

// A std module's functions are written with its name only (fs.read,
// std.fs.is_dir): a program's own function of the same name beside the
// import is its own, and a bare use of the module's is refused with the
// qualified spelling, at a call and as a function value.
fn test_std_qualified(c: Checks, compiler: String, dir: String) {
  write_av(dir, "stdown", "import std.fs\n\nfn read(path: String): String {\n  \"own \${path}\"\n}\n\nfn main {\n  puts(read(\"x\"))\n  puts(fs.read(\"/no/such/file\") ?? \"none\")\n  puts(std.fs.is_dir(\"/\"))\n  f = read\n  puts(f(\"y\"))\n  g = fs.is_dir\n  puts(g(\"/\"))\n}\n")
  mod_runs(c, compiler, dir, "stdown", "own x\nnone\ntrue\nown y\ntrue\n", "std qualifier: a program's own read beside import std.fs is its own; fs.read is the module's")
  write_av(dir, "stdbare", "import std.fs\n\nfn main {\n  puts(read(\"/\") ?? \"?\")\n}\n")
  mod_fails(c, compiler, dir, "stdbare", "stdbare.av:4:8", "std qualifier: the error points at the bare name")
  mod_fails(c, compiler, dir, "stdbare", "read needs its module's name: write fs.read; a std module's functions are not named bare", "std qualifier: a bare call is refused with fs.read")
  write_av(dir, "stdbareval", "import std.fs\n\nfn main {\n  f = is_dir\n  puts(f(\"/\"))\n}\n")
  mod_fails(c, compiler, dir, "stdbareval", "is_dir needs its module's name: write fs.is_dir", "std qualifier: a bare function value is refused")
  write_av(dir, "stdbareproc", "import std.process\n\nfn main {\n  puts(args().size)\n}\n")
  mod_fails(c, compiler, dir, "stdbareproc", "args needs its module's name: write process.args", "std qualifier: process.args, not a bare args")
  write_av(dir, "stdbaresync", "import std.sync\n\nfn main {\n  puts(pool_size())\n}\n")
  mod_fails(c, compiler, dir, "stdbaresync", "pool_size needs its module's name: write sync.pool_size", "std qualifier: sync.pool_size, not a bare pool_size")
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_modules(c)
  c.finish()
}
