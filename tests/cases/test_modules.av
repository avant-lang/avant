import harness

fn test_modules(c: Checks) {
  c.suite("tests/cases/test_modules.av")
  if compiler = env_get("AVANT_COMPILER") {
    stamp = now_ms()
    dir = "/tmp/avant-modules-${stamp}"
    mkdir_p(dir)

    write_av(dir, "vec", "pub struct Vec2 {\n  x: Int\n  y: Int\n}\npub fn origin: Vec2 {\n  Vec2 { x: 0, y: 0 }\n}\n")
    write_av(dir, "main", "import vec\nfn main {\n  v = origin()\n  puts(v.x)\n}\n")
    bin = "${dir}/ok.bin"
    log = "${dir}/ok.log"
    out = "${dir}/ok.out"
    code = compile_av(compiler, "${dir}/main.av", bin, log)
    c.eq_int(code, 0, "import pub names")
    c.expect(file_exists(bin), "import pub names bin")
    chmod_x(bin)
    run_code = run_av_bin(bin, out)
    c.eq_int(run_code, 0, "import pub names run")
    if got = file_read(out) {
      c.eq_str(got, "0\n", "imported origin")
    } else {
      c.expect(false, "imported origin")
    }

    write_av(dir, "util", "fn hidden: Int {\n  1\n}\npub fn shown: Int {\n  hidden()\n}\n")
    write_av(dir, "hide", "import util\nfn main {\n  puts(hidden())\n}\n")
    hide_bin = "${dir}/hide.bin"
    hide_log = "${dir}/hide.log"
    hide_code = compile_av(compiler, "${dir}/hide.av", hide_bin, hide_log)
    c.expect(!file_exists(hide_bin), "private helper bin absent")
    if err = file_read(hide_log) {
      c.expect(str_has(err, "unknown function hidden"), "private helper hidden")
    } else {
      c.expect(false, "private helper hidden")
    }

    write_av(dir, "ca", "import cb\npub fn from_a: Int { 1 }\n")
    write_av(dir, "cb", "import ca\npub fn from_b: Int { 1 }\n")
    write_av(dir, "cycle", "import ca\nfn main {\n  puts(from_a())\n}\n")
    cycle_bin = "${dir}/cycle.bin"
    cycle_log = "${dir}/cycle.log"
    dummy_c = compile_av(compiler, "${dir}/cycle.av", cycle_bin, cycle_log)
    c.expect(!file_exists(cycle_bin), "cycle bin absent")
    if err = file_read(cycle_log) {
      c.expect(str_has(err, "import cycle"), "import cycle")
    } else {
      c.expect(false, "import cycle")
    }

    write_av(dir, "one", "pub class Box {\n  n: Int\n  fn initialize(n: Int) {\n    self.n = n\n  }\n  pub fn draw: Int { self.n }\n}\n")
    write_av(dir, "two", "pub class Box {\n  n: Int\n  fn initialize(n: Int) {\n    self.n = n\n  }\n  pub fn draw: Int { self.n + 10 }\n}\n")
    write_av(dir, "clash", "import one\nimport two\nfn main {\n  puts(1)\n}\n")
    clash_bin = "${dir}/clash.bin"
    clash_log = "${dir}/clash.log"
    clash_out = "${dir}/clash.out"
    clash_code = compile_av(compiler, "${dir}/clash.av", clash_bin, clash_log)
    c.eq_int(clash_code, 0, "two Box types compile")
    chmod_x(clash_bin)
    dummy_k = run_av_bin(clash_bin, clash_out)
    if got = file_read(clash_out) {
      c.eq_str(got, "1\n", "two Box types unused")
    } else {
      c.expect(false, "two Box types unused")
    }
    write_av(dir, "bare", "import one\nimport two\nfn main {\n  b = Box.new(1)\n  puts(b.n)\n}\n")
    bare_bin = "${dir}/bare.bin"
    bare_log = "${dir}/bare.log"
    dummy_bare = compile_av(compiler, "${dir}/bare.av", bare_bin, bare_log)
    c.expect(!file_exists(bare_bin), "bare Box bin absent")
    if err = file_read(bare_log) {
      c.expect(str_has(err, "ambiguous name Box"), "bare Box ambiguous")
    } else {
      c.expect(false, "bare Box ambiguous")
    }
    write_av(dir, "qualbox", "import one\nimport two\nfn main {\n  a = one.Box.new(1)\n  b = two.Box.new(2)\n  puts(a.draw())\n  puts(b.draw())\n}\n")
    qb_bin = "${dir}/qualbox.bin"
    qb_log = "${dir}/qualbox.log"
    qb_out = "${dir}/qualbox.out"
    qb_code = compile_av(compiler, "${dir}/qualbox.av", qb_bin, qb_log)
    c.eq_int(qb_code, 0, "qualified Box types")
    chmod_x(qb_bin)
    dummy_qb = run_av_bin(qb_bin, qb_out)
    if got = file_read(qb_out) {
      c.eq_str(got, "1\n12\n", "qualified Box draw")
    } else {
      c.expect(false, "qualified Box draw")
    }

    write_av(dir, "show_int", "pub fn show(n: Int): Int {\n  n\n}\n")
    write_av(dir, "show_str", "pub fn show(s: String): Int {\n  s.size\n}\n")
    write_av(dir, "over", "import show_int\nimport show_str\nfn main {\n  puts(show(7))\n  puts(show(\"ab\"))\n}\n")
    over_bin = "${dir}/over.bin"
    over_log = "${dir}/over.log"
    over_out = "${dir}/over.out"
    over_code = compile_av(compiler, "${dir}/over.av", over_bin, over_log)
    c.eq_int(over_code, 0, "pub overloads")
    chmod_x(over_bin)
    dummy_r = run_av_bin(over_bin, over_out)
    if got = file_read(over_out) {
      c.eq_str(got, "7\n2\n", "merged pub overloads")
    } else {
      c.expect(false, "merged pub overloads")
    }

    write_av(dir, "alpha", "pub fn value: Int { 1 }\n")
    write_av(dir, "beta", "pub class value {\n  n: Int\n  fn initialize(n: Int) {\n    self.n = n\n  }\n}\n")
    write_av(dir, "qual", "import alpha\nimport beta\nfn main {\n  puts(alpha.value())\n  v = beta.value.new(2)\n  puts(v.n)\n}\n")
    qual_bin = "${dir}/qual.bin"
    qual_log = "${dir}/qual.log"
    qual_out = "${dir}/qual.out"
    qual_code = compile_av(compiler, "${dir}/qual.av", qual_bin, qual_log)
    c.eq_int(qual_code, 0, "qualify clash")
    chmod_x(qual_bin)
    dummy_q = run_av_bin(qual_bin, qual_out)
    if got = file_read(qual_out) {
      c.eq_str(got, "1\n2\n", "qualified clash")
    } else {
      c.expect(false, "qualified clash")
    }

    write_av(dir, "vec2", "pub struct Vec2 {\n  x: Int\n  y: Int\n}\n")
    write_av(dir, "ext", "import vec2\npub fn (v: Vec2) doubled: Vec2 {\n  Vec2 { x: v.x * 2, y: v.y * 2 }\n}\n")
    write_av(dir, "apply", "import vec2\nimport ext\nfn main {\n  v = Vec2 { x: 1, y: 3 }\n  w = v.doubled()\n  puts(w.x)\n  puts(w.y)\n}\n")
    apply_bin = "${dir}/apply.bin"
    apply_log = "${dir}/apply.log"
    apply_out = "${dir}/apply.out"
    apply_code = compile_av(compiler, "${dir}/apply.av", apply_bin, apply_log)
    c.eq_int(apply_code, 0, "external method")
    chmod_x(apply_bin)
    dummy_d = run_av_bin(apply_bin, apply_out)
    if got = file_read(apply_out) {
      c.eq_str(got, "2\n6\n", "doubled")
    } else {
      c.expect(false, "doubled")
    }

    proj = "${dir}/proj"
    mkdir_p("${proj}/tests/math")
    mkdir_p("${proj}/http")
    dummy_toml = file_write("${proj}/avant.toml", "[package]\nname = \"proj\"\nversion = \"0.1.0\"\n")
    dummy_vec = file_write("${proj}/vec.av", "pub struct Vec2 {\n  x: Int\n  y: Int\n}\n")
    dummy_srv = file_write("${proj}/http/server.av", "pub class Server {\n  fn initialize {\n  }\n  pub fn port: Int { 80 }\n}\n")
    dummy_test = file_write("${proj}/tests/math/test_add.av", "import vec\nimport http.server\nfn main {\n  v = Vec2 { x: 1, y: 2 }\n  s = Server.new\n  puts(v.x)\n  puts(s.port())\n}\n")
    nest_bin = "${dir}/nest.bin"
    nest_log = "${dir}/nest.log"
    nest_out = "${dir}/nest.out"
    nest_code = compile_av(compiler, "${proj}/tests/math/test_add.av", nest_bin, nest_log)
    c.eq_int(nest_code, 0, "nested import from tests/")
    chmod_x(nest_bin)
    dummy_nest = run_av_bin(nest_bin, nest_out)
    if got = file_read(nest_out) {
      c.eq_str(got, "1\n80\n", "unqualified nested names")
    } else {
      c.expect(false, "unqualified nested names")
    }

    dep_app = "${dir}/depapp"
    mkdir_p("${dep_app}/deps/greeter/http")
    dummy_dt = file_write("${dep_app}/avant.toml", "[package]\nname = \"depapp\"\nversion = \"0.1.0\"\n")
    dummy_gt = file_write("${dep_app}/deps/greeter/avant.toml", "[package]\nname = \"greeter\"\nversion = \"0.1.0\"\n")
    dummy_gs = file_write("${dep_app}/deps/greeter/http/server.av", "pub fn listen: Int { 7 }\n")
    dummy_dm = file_write("${dep_app}/main.av", "import http.server\nfn main {\n  puts(listen())\n}\n")
    dep_bin = "${dir}/dep.bin"
    dep_log = "${dir}/dep.log"
    dep_out = "${dir}/dep.out"
    dep_code = compile_av(compiler, "${dep_app}/main.av", dep_bin, dep_log)
    c.eq_int(dep_code, 0, "dep nested import")
    chmod_x(dep_bin)
    dummy_dep = run_av_bin(dep_bin, dep_out)
    if got = file_read(dep_out) {
      c.eq_str(got, "7\n", "dep nested listen")
    } else {
      c.expect(false, "dep nested listen")
    }

    sh = "${dir}/shadow"
    mkdir_p("${sh}/nest")
    dummy_sht = file_write("${sh}/avant.toml", "[package]\nname = \"shadow\"\nversion = \"0.1.0\"\n")
    dummy_shv = file_write("${sh}/vec.av", "pub fn from_root: Int { 1 }\n")
    dummy_shn = file_write("${sh}/nest/vec.av", "pub fn from_nest: Int { 2 }\n")
    dummy_shm = file_write("${sh}/nest/main.av", "import vec\nfn main {\n  puts(1)\n}\n")
    sh_bin = "${dir}/shadow.bin"
    sh_log = "${dir}/shadow.log"
    dummy_shc = compile_av(compiler, "${sh}/nest/main.av", sh_bin, sh_log)
    c.expect(!file_exists(sh_bin), "shadow bin absent")
    if err = file_read(sh_log) {
      c.expect(str_has(err, "import vec is ambiguous"), "shadow names both")
      c.expect(str_has(err, "nest/vec.av"), "shadow beside path")
      c.expect(str_has(err, "/vec.av"), "shadow manifest path")
    } else {
      c.expect(false, "shadow names both")
    }

    cyc = "${dir}/cyc"
    mkdir_p("${cyc}/sub")
    dummy_ct = file_write("${cyc}/avant.toml", "[package]\nname = \"cyc\"\nversion = \"0.1.0\"\n")
    dummy_ca = file_write("${cyc}/a.av", "import sub.b\npub fn from_a: Int { 1 }\n")
    dummy_cb = file_write("${cyc}/sub/b.av", "import a\npub fn from_b: Int { from_a() }\n")
    dummy_cm = file_write("${cyc}/main.av", "import a\nfn main {\n  puts(from_a())\n}\n")
    cyc_bin = "${dir}/cyc.bin"
    cyc_log = "${dir}/cyc.log"
    dummy_cc = compile_av(compiler, "${cyc}/main.av", cyc_bin, cyc_log)
    c.expect(!file_exists(cyc_bin), "cross-dir cycle bin absent")
    if err = file_read(cyc_log) {
      c.expect(str_has(err, "import cycle"), "cross-dir cycle")
    } else {
      c.expect(false, "cross-dir cycle")
    }

    tw = "${dir}/twice"
    mkdir_p("${tw}/http")
    dummy_tt = file_write("${tw}/avant.toml", "[package]\nname = \"twice\"\nversion = \"0.1.0\"\n")
    dummy_ts = file_write("${tw}/http/server.av", "pub fn listen: Int { 1 }\n")
    dummy_tc = file_write("${tw}/http/client.av", "import server\nimport http.server\npub fn go: Int { listen() }\n")
    dummy_tm = file_write("${tw}/main.av", "import http.client\nfn main {\n  puts(go())\n}\n")
    tw_bin = "${dir}/twice.bin"
    tw_log = "${dir}/twice.log"
    dummy_tw = compile_av(compiler, "${tw}/main.av", tw_bin, tw_log)
    c.expect(!file_exists(tw_bin), "two spellings bin absent")
    if err = file_read(tw_log) {
      c.expect(str_has(err, "open the same file"), "two spellings")
    } else {
      c.expect(false, "two spellings")
    }

    rootp = "${dir}/rootprobe"
    mkdir_p("${rootp}/compiler/checker")
    mkdir_p("${rootp}/compiler/codegen")
    dummy_rt = file_write("${rootp}/avant.toml", "[package]\nname = \"rootprobe\"\nversion = \"0.1.0\"\n")
    dummy_rl = file_write("${rootp}/compiler/loader.av", "pub fn answer: Int { 4 }\n")
    dummy_rc = file_write("${rootp}/compiler/codegen/calls.av", "pub fn ring: Int { 3 }\n")
    dummy_ru = file_write("${rootp}/compiler/checker/use.av", "import codegen.calls\nimport loader\npub fn go: Int { ring() + answer() }\n")
    dummy_rm = file_write("${rootp}/compiler/main.av", "import checker.use\nfn main {\n  puts(go())\n}\n")
    rp_bin = "${dir}/rootprobe.bin"
    rp_log = "${dir}/rootprobe.log"
    rp_out = "${dir}/rootprobe.out"
    rp_code = compile_av(compiler, "${rootp}/compiler/main.av", rp_bin, rp_log)
    c.eq_int(rp_code, 0, "compilation root probe")
    chmod_x(rp_bin)
    dummy_rp = run_av_bin(rp_bin, rp_out)
    if got = file_read(rp_out) {
      c.eq_str(got, "7\n", "nested import under compiled file")
    } else {
      c.expect(false, "nested import under compiled file")
    }

    both = "${dir}/bothroot"
    mkdir_p("${both}/src/nest")
    dummy_bt = file_write("${both}/avant.toml", "[package]\nname = \"bothroot\"\nversion = \"0.1.0\"\n")
    dummy_bv = file_write("${both}/vec.av", "pub fn from_manifest: Int { 1 }\n")
    dummy_bs = file_write("${both}/src/vec.av", "pub fn from_root: Int { 2 }\n")
    dummy_bn = file_write("${both}/src/nest/use.av", "import vec\npub fn go: Int { 1 }\n")
    dummy_bm = file_write("${both}/src/main.av", "import nest.use\nfn main {\n  puts(go())\n}\n")
    both_bin = "${dir}/bothroot.bin"
    both_log = "${dir}/bothroot.log"
    dummy_bc = compile_av(compiler, "${both}/src/main.av", both_bin, both_log)
    c.expect(!file_exists(both_bin), "root and manifest bin absent")
    if err = file_read(both_log) {
      c.expect(str_has(err, "import vec is ambiguous"), "root and manifest")
      c.expect(str_has(err, "src/vec.av"), "root path")
      c.expect(str_has(err, "bothroot/vec.av"), "manifest path")
    } else {
      c.expect(false, "root and manifest")
    }

    spell = "${dir}/spell"
    mkdir_p("${spell}/compiler/checker")
    dummy_st = file_write("${spell}/avant.toml", "[package]\nname = \"spell\"\nversion = \"0.1.0\"\n")
    dummy_sf = file_write("${spell}/compiler/checker/facts.av", "pub fn n: Int { 1 }\n")
    dummy_su = file_write("${spell}/compiler/checker/use.av", "import facts\nimport checker.facts\npub fn go: Int { n() }\n")
    dummy_sm = file_write("${spell}/compiler/main.av", "import checker.use\nfn main {\n  puts(go())\n}\n")
    spell_bin = "${dir}/spell.bin"
    spell_log = "${dir}/spell.log"
    dummy_sc = compile_av(compiler, "${spell}/compiler/main.av", spell_bin, spell_log)
    c.expect(!file_exists(spell_bin), "root two spellings bin absent")
    if err = file_read(spell_log) {
      c.expect(str_has(err, "open the same file"), "root two spellings")
    } else {
      c.expect(false, "root two spellings")
    }

    seal = "${dir}/seal"
    mkdir_p("${seal}/deps/lib")
    dummy_slt = file_write("${seal}/avant.toml", "[package]\nname = \"seal\"\nversion = \"0.1.0\"\n")
    dummy_sld = file_write("${seal}/deps/lib/avant.toml", "[package]\nname = \"lib\"\nversion = \"0.1.0\"\n")
    dummy_slh = file_write("${seal}/hidden.av", "pub fn hidden: Int { 1 }\n")
    dummy_slg = file_write("${seal}/deps/lib/greeter.av", "import hidden\npub fn go: Int { hidden() }\n")
    dummy_slm = file_write("${seal}/main.av", "import greeter\nfn main {\n  puts(go())\n}\n")
    seal_bin = "${dir}/seal.bin"
    seal_log = "${dir}/seal.log"
    dummy_slc = compile_av(compiler, "${seal}/main.av", seal_bin, seal_log)
    c.expect(!file_exists(seal_bin), "dep does not see consumer bin absent")
    if err = file_read(seal_log) {
      c.expect(str_has(err, "cannot find hidden.av"), "dep does not see consumer")
    } else {
      c.expect(false, "dep does not see consumer")
    }

    kw = "${dir}/kw"
    mkdir_p("${kw}/pkg")
    dummy_kf = file_write("${kw}/pkg/spawn.av", "pub struct Node {\n  n: Int\n}\npub fn from_spawn: Int { 3 }\n")
    dummy_ko = file_write("${kw}/other.av", "pub struct Node {\n  n: Int\n}\n")
    dummy_km = file_write("${kw}/main.av", "import pkg.spawn\nimport other\nfn main {\n  v = pkg.spawn.Node { n: 1 }\n  w = other.Node { n: 2 }\n  puts(v.n)\n  puts(w.n)\n  puts(from_spawn())\n}\n")
    kw_bin = "${dir}/kw.bin"
    kw_log = "${dir}/kw.log"
    kw_out = "${dir}/kw.out"
    kw_code = compile_av(compiler, "${kw}/main.av", kw_bin, kw_log)
    c.eq_int(kw_code, 0, "keyword after a dot")
    c.expect(file_exists(kw_bin), "keyword after a dot bin")
    chmod_x(kw_bin)
    dummy_kr = run_av_bin(kw_bin, kw_out)
    if got = file_read(kw_out) {
      c.eq_str(got, "1\n2\n3\n", "keyword segment and qualifier")
    } else {
      c.expect(false, "keyword segment and qualifier")
    }

    member = "${dir}/member.av"
    dummy_mf = file_write(member, "struct Box {\n  n: Int\n}\nfn main {\n  b = Box { n: 1 }\n  puts(b.for)\n}\n")
    member_bin = "${dir}/member.bin"
    member_log = "${dir}/member.log"
    dummy_mc = compile_av(compiler, member, member_bin, member_log)
    c.expect(!file_exists(member_bin), "keyword member bin absent")
    if err = file_read(member_log) {
      c.expect(str_has(err, "no field for"), "keyword member is a name")
      c.expect(!str_has(err, "expected 2"), "keyword member is not a parse error")
    } else {
      c.expect(false, "keyword member is a name")
    }

    lead = "${dir}/lead.av"
    dummy_lf = file_write(lead, "import spawn\nfn main {\n  puts(1)\n}\n")
    lead_bin = "${dir}/lead.bin"
    lead_log = "${dir}/lead.log"
    dummy_lc = compile_av(compiler, lead, lead_bin, lead_log)
    c.expect(!file_exists(lead_bin), "leading keyword import bin absent")
    if err = file_read(lead_log) {
      c.expect(str_has(err, "expected 2, found 19"), "leading keyword import")
    } else {
      c.expect(false, "leading keyword import")
    }

    decl = "${dir}/decl.av"
    dummy_df = file_write(decl, "fn spawn: Int { 1 }\nfn main {\n  puts(spawn())\n}\n")
    decl_bin = "${dir}/decl.bin"
    decl_log = "${dir}/decl.log"
    dummy_dc = compile_av(compiler, decl, decl_bin, decl_log)
    c.expect(!file_exists(decl_bin), "keyword function name bin absent")
    if err = file_read(decl_log) {
      c.expect(str_has(err, "expected function name"), "keyword function name")
    } else {
      c.expect(false, "keyword function name")
    }

    label = "${dir}/label.av"
    dummy_af = file_write(label, "struct Point {\n  x: Int\n}\nfn main {\n  p = Point { for: 1 }\n  puts(p.x)\n}\n")
    label_bin = "${dir}/label.bin"
    label_log = "${dir}/label.log"
    dummy_ac = compile_av(compiler, label, label_bin, label_log)
    c.expect(!file_exists(label_bin), "keyword field label bin absent")
    if err = file_read(label_log) {
      c.expect(str_has(err, "expected expression, found 28"), "keyword field label")
    } else {
      c.expect(false, "keyword field label")
    }

    write_av(dir, "solo", "fn main {\n  puts(1)\n}\n")
    solo_bin = "${dir}/solo.bin"
    solo_log = "${dir}/solo.log"
    solo_out = "${dir}/solo.out"
    solo_code = compile_av(compiler, "${dir}/solo.av", solo_bin, solo_log)
    c.eq_int(solo_code, 0, "single file")
    chmod_x(solo_bin)
    dummy_s = run_av_bin(solo_bin, solo_out)
    if got = file_read(solo_out) {
      c.eq_str(got, "1\n", "single file no import")
    } else {
      c.expect(false, "single file no import")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  c = Checks.new()
  c.started = now_ms()
  test_modules(c)
  c.finish
}
