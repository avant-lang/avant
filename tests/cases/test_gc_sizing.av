import harness
import backends
import std.process

// The young generation's policy. The budget's growth rule (runtime/avant_gc_collect.c, young_size):
// the budget doubles at the second budget collection in a row where more
// than YOUNG_GROW_PCT percent (70) of the young bytes survived. Growth at
// more than half held the peak of programs whose survival stays between
// half and two thirds while their live set grows (the budget, not their
// data, at the cap).
//
// heap/grow_survival.av keeps a fixed share of 1,500,000 small nodes in a
// chain. At its default share (45 percent; more than half of what each
// collection sees survives, with the copies of the last collection's
// survivors) the budget stays at its default, 4 MiB; at 95 percent it
// grows. Both run with AVANT_GC_STATS=1 (yng_max), and the default share
// runs plainly and under AVANT_GC_VERIFY=1 with its known stdout.
// The compile of heap/grow_survival.av, started with the other fixtures' at once.
fn test_gc_sizing_compile(compiler: String, root: String, dir: String): HJob {
  compile_job("", compiler, "${root}/tests/fixtures/heap/grow_survival.av", "${dir}/grow_survival", "${dir}/grow_survival.log")
}

// Its runs, started with the other fixtures' runs in one wave.
fn test_gc_sizing_runs(dir: String): Array(HJob) {
  envs = ["", "AVANT_GC_VERIFY=1"]
  runs: Array(HJob) = []
  e = 0
  while e < envs.size {
    if e > 0 && sizing_same_run(envs[e]) {
      runs.push(runs[0])
    } else {
      runs.push(run_job_env(dir, "grow_survival", "grow_survival.g${e}", envs[e]))
    }
    e += 1
  }
  clean = "-u AVANT_GC_VERIFY -u AVANT_YOUNG_MB -u AVANT_NURSERY -u AVANT_GC_STRESS AVANT_GC_STATS=1"
  runs.push(run_job_env(dir, "grow_survival", "grow_survival.mid", clean))
  runs.push(run_job_env(dir, "grow_survival", "grow_survival.high", "${clean} GROW_SURVIVAL_KEEP=95"))
  runs
}

// Its checks, read in the order they always were.
fn test_gc_sizing(c: Checks, compile: HJob, runs: Array(HJob), dir: String) {
  c.eq_int(compile.code, 0, "grow_survival.av: compiles")
  want = "kept: 675000\nwalked: 675000\nsum: 4500001 check: 3375001\n"
  want_high = "kept: 1425000\nwalked: 1425000\nsum: 4500001 check: 7124992\n"
  envs = ["", "AVANT_GC_VERIFY=1"]
  e = 0
  while e < envs.size {
    g = e
    if e > 0 && runs[e].log == runs[0].log {
      g = 0
    }
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "grow_survival.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/grow_survival.g${g}.out"), want, "grow_survival.av ${what}: the known stdout")
    c.eq_str(log_text("${dir}/grow_survival.g${g}.err"), "", "grow_survival.av ${what}: no stderr (no verifier report)")
    e += 1
  }
  mid = runs[envs.size]
  high = runs[envs.size + 1]
  c.eq_int(mid.code, 0, "grow_survival.av at 45 percent with AVANT_GC_STATS=1: exit 0")
  c.eq_str(log_text("${dir}/grow_survival.mid.out"), want, "grow_survival.av at 45 percent with AVANT_GC_STATS=1: the known stdout")
  c.eq_int(high.code, 0, "grow_survival.av at 95 percent: exit 0")
  c.eq_str(log_text("${dir}/grow_survival.high.out"), want_high, "grow_survival.av at 95 percent: the known stdout")
  m = stat_of(log_text("${dir}/grow_survival.mid.err"), "yng_max")
  h = stat_of(log_text("${dir}/grow_survival.high.err"), "yng_max")
  c.eq_int(m, 4194304, "grow_survival.av at 45 percent: the budget stays at 4 MiB (yng_max ${m})")
  c.expect(h > 4194304, "grow_survival.av at 95 percent: the budget grows (yng_max ${h})")
}

// heap/holder_cycle.av: a per-run Work of four buffers, allocated in a
// hole of a recycled block (the setup leaves the heap's blocks half full
// of long-lived nodes) with a young collection inside its initialize at
// most runs. Promoted where it lay at that first survival, each Work kept,
// once dead, the buffers stored into it after that through the
// remembered set, until they aged into mature space and a full
// collection freed them: 121 full collections, 924 MB of buffers
// promoted, 28 MB. A recycled block's survivors that fill at most one
// line are evacuated by an aging young collection (MIXED_EVAC_LINES), so
// the Work ages in a survivor block and dies young: no buffer is
// promoted and the setup's collection is the only full one. It runs
// plainly and under AVANT_GC_VERIFY=1 with its known stdout, and with
// AVANT_GC_STATS=1 (full, los_promoted_bytes).
// The compile of heap/holder_cycle.av, started with the other fixtures' at once.
fn test_holder_cycle_compile(compiler: String, root: String, dir: String): HJob {
  compile_job("", compiler, "${root}/tests/fixtures/heap/holder_cycle.av", "${dir}/holder_cycle", "${dir}/holder_cycle.log")
}

// Its runs, started with the other fixtures' runs in one wave.
fn test_holder_cycle_runs(dir: String): Array(HJob) {
  envs = ["", "AVANT_GC_VERIFY=1"]
  runs: Array(HJob) = []
  e = 0
  while e < envs.size {
    if e > 0 && sizing_same_run(envs[e]) {
      runs.push(runs[0])
    } else {
      runs.push(run_job_env(dir, "holder_cycle", "holder_cycle.g${e}", envs[e]))
    }
    e += 1
  }
  runs.push(run_job_env(dir, "holder_cycle", "holder_cycle.stats", "-u AVANT_GC_VERIFY -u AVANT_YOUNG_MB -u AVANT_NURSERY -u AVANT_GC_STRESS AVANT_GC_STATS=1"))
  runs
}

// Its checks, read in the order they always were.
fn test_holder_cycle(c: Checks, compile: HJob, runs: Array(HJob), dir: String) {
  c.eq_int(compile.code, 0, "holder_cycle.av: compiles")
  want = "kept: 200000\nsum: 542100\n"
  envs = ["", "AVANT_GC_VERIFY=1"]
  e = 0
  while e < envs.size {
    g = e
    if e > 0 && runs[e].log == runs[0].log {
      g = 0
    }
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "holder_cycle.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/holder_cycle.g${g}.out"), want, "holder_cycle.av ${what}: the known stdout")
    c.eq_str(log_text("${dir}/holder_cycle.g${g}.err"), "", "holder_cycle.av ${what}: no stderr (no verifier report)")
    e += 1
  }
  c.eq_int(runs[envs.size].code, 0, "holder_cycle.av with AVANT_GC_STATS=1: exit 0")
  st = log_text("${dir}/holder_cycle.stats.err")
  f = stat_of(st, "full")
  p = stat_of(st, "los_promoted_bytes")
  c.expect(f >= 1 && f <= 2, "holder_cycle.av: no full collection after the setup's (full ${f})")
  c.eq_int(p, 0, "holder_cycle.av: no buffer promoted (los_promoted_bytes ${p})")
}

// heap/stranded_set.av: a working set that young collections promote and
// that then dies, after which the program makes only short-lived garbage:
// its mature growth stops short of the full trigger. A full collection
// falls due once the bytes allocated since the last one pass
// max(ALLOC_FULL_MIN, ALLOC_FULL_PCT percent of the heap) while the mature
// growth since it passed ALLOC_FULL_GROWN_PCT percent of the trigger and
// stopped (runtime/avant_gc_internal.h),
// and it leaves young objects young; at times the program's old list is
// reachable only through a young holder, which that mark must follow.
// Before, the setup's collection was the only full one and the dead set
// stayed to the exit. It runs plainly, under AVANT_GC_VERIFY=1 and under
// AVANT_GC_STRESS=1 (without the verifier: the two together take minutes
// on its 300 MB of allocation) with its known stdout, and with
// AVANT_GC_STATS=1 (full_heap_goal).
// The compile of heap/stranded_set.av, started with the other fixtures' at once.
fn test_stranded_set_compile(compiler: String, root: String, dir: String): HJob {
  compile_job("", compiler, "${root}/tests/fixtures/heap/stranded_set.av", "${dir}/stranded_set", "${dir}/stranded_set.log")
}

// Its runs, started with the other fixtures' runs in one wave.
fn test_stranded_set_runs(dir: String): Array(HJob) {
  envs = ["", "AVANT_GC_VERIFY=1", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  e = 0
  while e < envs.size {
    if e > 0 && sizing_same_run(envs[e]) {
      runs.push(runs[0])
    } else {
      runs.push(run_job_env(dir, "stranded_set", "stranded_set.g${e}", envs[e]))
    }
    e += 1
  }
  runs.push(run_job_env(dir, "stranded_set", "stranded_set.stats", "-u AVANT_GC_VERIFY -u AVANT_YOUNG_MB -u AVANT_NURSERY -u AVANT_GC_STRESS AVANT_GC_STATS=1"))
  runs
}

// Its checks, read in the order they always were.
fn test_stranded_set(c: Checks, compile: HJob, runs: Array(HJob), dir: String) {
  c.eq_int(compile.code, 0, "stranded_set.av: compiles")
  want = "anchor: 100000\nwork: 135000\njunk: 50\n"
  envs = ["", "AVANT_GC_VERIFY=1", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  e = 0
  while e < envs.size {
    g = e
    if e > 0 && runs[e].log == runs[0].log {
      g = 0
    }
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "stranded_set.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/stranded_set.g${g}.out"), want, "stranded_set.av ${what}: the known stdout")
    c.eq_str(log_text("${dir}/stranded_set.g${g}.err"), "", "stranded_set.av ${what}: no stderr (no verifier report)")
    e += 1
  }
  c.eq_int(runs[envs.size].code, 0, "stranded_set.av with AVANT_GC_STATS=1: exit 0")
  st = log_text("${dir}/stranded_set.stats.err")
  g = stat_of(st, "full_heap_goal")
  c.expect(g >= 1, "stranded_set.av: a full collection falls due by allocation (full_heap_goal ${g})")
}

// A full collection the growth trigger asks for leaves a young buffer
// young: in tests/fixtures/heap/kept_buffer.av the trigger falls inside
// runs while each run's 1.2 MB string, held by its frame alone, is young
// (FULL_KEEP_LARGE in runtime/avant_gc_internal.h). With AVANT_GC_STATS=1
// the collections that left one young are counted and the peak of large
// objects stays at three strings (four when each full collection made
// one old); the known stdout plainly, under AVANT_GC_VERIFY=1 and under
// AVANT_GC_STRESS=1.
// The compile of heap/kept_buffer.av, started with the other fixtures' at once.
fn test_kept_buffer_compile(compiler: String, root: String, dir: String): HJob {
  compile_job("", compiler, "${root}/tests/fixtures/heap/kept_buffer.av", "${dir}/kept_buffer", "${dir}/kept_buffer.log")
}

// Its runs, started with the other fixtures' runs in one wave.
fn test_kept_buffer_runs(dir: String): Array(HJob) {
  envs = ["", "AVANT_GC_VERIFY=1", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  runs: Array(HJob) = []
  e = 0
  while e < envs.size {
    if e > 0 && sizing_same_run(envs[e]) {
      runs.push(runs[0])
    } else {
      runs.push(run_job_env(dir, "kept_buffer", "kept_buffer.g${e}", envs[e]))
    }
    e += 1
  }
  runs.push(run_job_env(dir, "kept_buffer", "kept_buffer.stats", "-u AVANT_GC_VERIFY -u AVANT_YOUNG_MB -u AVANT_NURSERY -u AVANT_GC_STRESS AVANT_GC_STATS=1"))
  runs
}

// Its checks, read in the order they always were.
fn test_kept_buffer(c: Checks, compile: HJob, runs: Array(HJob), dir: String) {
  c.eq_int(compile.code, 0, "kept_buffer.av: compiles")
  want = "anchor: 50000\nsum: 4843656\n"
  envs = ["", "AVANT_GC_VERIFY=1", "-u AVANT_GC_VERIFY AVANT_GC_STRESS=1"]
  e = 0
  while e < envs.size {
    g = e
    if e > 0 && runs[e].log == runs[0].log {
      g = 0
    }
    what = "plain"
    if envs[e].size > 0 {
      what = "under ${envs[e]}"
    }
    c.eq_int(runs[e].code, 0, "kept_buffer.av ${what}: exit 0")
    c.eq_str(log_text("${dir}/kept_buffer.g${g}.out"), want, "kept_buffer.av ${what}: the known stdout")
    c.eq_str(log_text("${dir}/kept_buffer.g${g}.err"), "", "kept_buffer.av ${what}: no stderr (no verifier report)")
    e += 1
  }
  c.eq_int(runs[envs.size].code, 0, "kept_buffer.av with AVANT_GC_STATS=1: exit 0")
  st = log_text("${dir}/kept_buffer.stats.err")
  k = stat_of(st, "full_kept_large")
  c.expect(k >= 20, "kept_buffer.av: the full collections leave the run's string young (full_kept_large ${k})")
  p = stat_of(st, "pk_large")
  c.expect(p > 0 && p < 4200000, "kept_buffer.av: no dead string old beside the live ones (pk_large ${p})")
}

// Whether a run under the words envs (on top of the pass's own) is the
// plain run: every word already holds in this pass (the verify pass's
// "under AVANT_GC_VERIFY=1"), and run_job_env adds no word of its own (it
// removes the stress mode from a verifier run under the stress pass).
fn sizing_same_run(envs: String): Bool {
  if gc_stress_outer() && envs.contains("AVANT_GC_VERIFY") {
    return false
  }
  env_holds(envs)
}

// The number after ` KEY=` in an AVANT_GC_STATS=1 line, or -1.
fn stat_of(text: String, key: String): Int {
  parts = text.split(" ")
  for p in parts {
    if p.size > key.size + 1 && p[..key.size + 1] == "${key}=" {
      return p[key.size + 1..].strip().to_i() ?? -1
    }
  }
  -1
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_gc_sizing.av")
  if compiler = process.env("AVANT_COMPILER") {
    // The four fixtures are independent: their compiles run at once, then
    // all their runs at once, and the checks are read in the old order.
    root = avant_test_root()
    dir = scratch_dir()
    compiles: Array(HJob) = []
    compiles.push(test_gc_sizing_compile(compiler, root, dir))
    compiles.push(test_holder_cycle_compile(compiler, root, dir))
    compiles.push(test_stranded_set_compile(compiler, root, dir))
    compiles.push(test_kept_buffer_compile(compiler, root, dir))
    run_waves(compiles)
    gs = test_gc_sizing_runs(dir)
    hc = test_holder_cycle_runs(dir)
    ss = test_stranded_set_runs(dir)
    kb = test_kept_buffer_runs(dir)
    all: Array(HJob) = []
    for list in [gs, hc, ss, kb] {
      for j in list {
        // A run that serves two checks (sizing_same_run) is listed twice.
        if all.size == 0 || all[all.size - 1].log != j.log {
          all.push(j)
        }
      }
    }
    run_waves(all)
    test_gc_sizing(c, compiles[0], gs, dir)
    test_holder_cycle(c, compiles[1], hc, dir)
    test_stranded_set(c, compiles[2], ss, dir)
    test_kept_buffer(c, compiles[3], kb, dir)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
