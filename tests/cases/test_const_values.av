import harness
import backends
import std.fs
import std.process

// Module constants whose value is not a scalar made of literals: a
// String, an array, a hash, a struct or class value, a call. Each is
// computed once before main, in the order they are written (a module's
// after those of the modules it imports), and read from its slot; a
// failure while computing one stops the program before main naming it;
// one that reads a value computed after it is refused. Each program is compiled in parallel; a refused
// one must say the expected words at the expected line and column, an
// accepted one print what it should, a stopped one exit 1 saying the
// expected words.

class KCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  // 0 refused, 1 runs and prints want, 2 stops with want on stderr.
  pub kind: Int = 0
}

fn refused(tag: String, src: String, needle: String, pos: String): KCase {
  f = KCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f
}

fn accepted(tag: String, src: String, out: String): KCase {
  f = KCase.new()
  f.tag = tag
  f.src = src
  f.want = out
  f.kind = 1
  f
}

fn stopped(tag: String, src: String, needle: String): KCase {
  f = KCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.kind = 2
  f
}

fn schema_src: String {
  "class Schema {\n  pub fields: Array(String) = []\n\n  pub fn str(name: String): Schema {\n    self.fields.push(name)\n    self\n  }\n\n  pub fn has(name: String): Bool {\n    self.fields.has(name)\n  }\n}\n\nconst schema = Schema.new().str(\"body\").str(\"title\")\n"
}

fn point_src: String {
  "struct Point {\n  x: Int\n  y: Int\n\n  fn len2: Int {\n    self.x * self.x + self.y * self.y\n  }\n\n  fn bump {\n    self.x += 1\n  }\n}\n\nconst origin = Point { x: 3, y: 4 }\n"
}

fn value_cases: Array(KCase) {
  xs: Array(KCase) = []
  xs.push(accepted("values", "const names = [\"ada\", \"bob\", \"cy\"]\nconst greeting = \"hello\"\nconst ages = [\"ada\": 36, \"bob\": 41]\nconst title = \"\${greeting}, \${names[1]}\"\nconst count = names.size * 10\nconst kib = 1 << 10\nconst port = \"8080\".to_i()\nconst tags = Set(String).new()\n\nfn main {\n  puts(title)\n  puts(ages[\"bob\"] ?? 0)\n  puts(count + kib)\n  puts(port + 1)\n  puts(tags.size)\n  for n in names {\n    puts(n)\n  }\n  f = (i: Int) { names[i].size }\n  puts(f(2))\n}\n", "hello, bob\n41\n1054\n8081\n0\nada\nbob\ncy\n2\n"))
  xs.push(accepted("objects", "${schema_src()}${point_src()}\nfn main {\n  puts(schema.has(\"title\"))\n  puts(schema.fields.size)\n  puts(origin.len2())\n  puts(origin.x + origin.y)\n  p = origin\n  p.bump()\n  puts(p.x)\n  puts(origin.x)\n}\n", "true\n2\n25\n7\n4\n3\n"))
  xs.push(accepted("order", "const first = [\"a\", \"b\"]\nconst second = first.size + 1\nconst third = make()\n\nfn make: String {\n  \"\${first[0]}\${second}\"\n}\n\nfn main {\n  puts(third)\n}\n", "a3\n"))
  xs.push(accepted("tasks", "const nums = [3, 1, 2]\n\nfn work(n: Int): Int {\n  nums[0] * n\n}\n\nfn main {\n  hs = [1, 2, 3].parallel (n) { work(n) + nums.size }\n  puts(hs[2])\n  h = spawn { nums[1] + nums[2] }\n  puts(h.join() ?? 0)\n}\n", "12\n3\n"))
  xs
}

fn start_cases: Array(KCase) {
  xs: Array(KCase) = []
  xs.push(refused("later", "const a = b.size\nconst b = [1]\n\nfn main {\n  puts(a)\n}\n", "this value reads the constant b, which is computed after it (declared at ", "1:11"))
  xs.push(refused("itself", "const a = [a.size]\n\nfn main {\n  puts(a)\n}\n", "the value of constant a reads a itself", "1:12"))
  xs.push(refused("through-fn", "const a = make()\nconst b = \"b\"\n\nfn make: String {\n  \"a\${b}\"\n}\n\nfn main {\n  puts(a)\n}\n", "the value of constant a reads the constant b through make, and b is computed after it", "1:7"))
  xs.push(refused("nil", "const n = nil\n\nfn main {\n  puts(1)\n}\n", "the value of constant n gives nothing: a constant names a value", "1:7"))
  xs.push(refused("void", "fn hi {\n  puts(1)\n}\n\nconst n = hi()\n\nfn main {\n  puts(1)\n}\n", "the value of constant n gives nothing", "5:7"))
  xs.push(refused("label", "const n = [1].size\n\nfn main {\n  switch 3 {\n    case n { puts(1) }\n    else { puts(2) }\n  }\n}\n", "the constant n is computed before main, not when compiling", "5:10"))
  xs.push(refused("unknown", "const a = zz + 1\n\nfn main {\n  puts(a)\n}\n", "unknown name zz", "1:11"))
  xs.push(stopped("trap", "fn pick(i: Int): String {\n  xs = [\"a\"]\n  xs[i]\n}\n\nconst bad = pick(3)\n\nfn main {\n  puts(\"main\")\n}\n", "index 3 out of bounds (size 1) in pick (kv-trap.av:1:1), computing the constant bad (kv-trap.av:6:7) before main"))
  xs.push(stopped("failure", "const port = \"80a\".to_i()\n\nfn main {\n  puts(port)\n}\n", "the constant port has no value: computed before main, its value is a failure (Nil) at kv-failure.av:1:7"))
  xs.push(stopped("error", "class Bad: Error {\n  pub message: String = \"bad\"\n}\n\nfn load: String | Bad {\n  Bad.new()\n}\n\nconst text = load()\n\nfn main {\n  puts(text)\n}\n", "the constant text has no value: computed before main, its value is a failure (Bad)"))
  xs
}

fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(KCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/kv-${f.tag}.av"
    _ = fs.write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/kv-${f.tag}.bin", "${dir}/kv-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.kind > 0 {
      runs.push(run_job(dir, "kv-${f2.tag}.bin", "kv-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/kv-${f3.tag}.log")
    if f3.kind == 1 {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.eq_int(runs[k].code, 0, "${f3.tag}: exit 0")
      c.eq_str(log_text("${dir}/kv-${f3.tag}.run.out"), f3.want, "${f3.tag}: stdout")
      k += 1
    } else if f3.kind == 2 {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.eq_int(runs[k].code, 1, "${f3.tag}: exit 1")
      c.eq_str(log_text("${dir}/kv-${f3.tag}.run.out"), "", "${f3.tag}: no stdout")
      c.expect(log_text("${dir}/kv-${f3.tag}.run.err").contains(f3.want), "${f3.tag}: says ${f3.want}")
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !fs.exists("${dir}/kv-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(log.contains(f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(log.contains("kv-${f3.tag}.av:${f3.pos}\n"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

// Across modules: an imported module's values are computed first, its
// pub ones read bare and qualified.
fn check_modules(c: Checks, compiler: String, dir: String) {
  d = "${dir}/kvmods"
  mkdir_p(d)
  _ = fs.write("${d}/kvbase.av", "pub const base = [\"a\", \"b\"]\npub const joined = base.join(\"+\")\n")
  _ = fs.write("${d}/kvmid.av", "import kvbase\n\npub const more = \"\${kvbase.joined}|\${joined}\"\n")
  _ = fs.write("${d}/kvmain.av", "import kvmid\nimport kvbase\n\nconst last = \"\${more}/\${base.size}\"\n\nfn main {\n  puts(kvmid.more)\n  puts(last)\n}\n")
  jobs: Array(HJob) = [compile_job("", compiler, "${d}/kvmain.av", "${d}/kvmain.bin", "${d}/kvmain.log")]
  run_waves(jobs)
  c.eq_int(jobs[0].code, 0, "modules: compiles")
  runs: Array(HJob) = [run_job(d, "kvmain.bin", "kvmain.run")]
  run_waves(runs)
  c.eq_str(log_text("${d}/kvmain.run.out"), "a+b|a+b\na+b|a+b/2\n", "modules: stdout")
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_const_values.av")
  if compiler = process.env("AVANT_COMPILER") {
    dir = scratch_dir()
    all: Array(KCase) = []
    all.concat(value_cases())
    all.concat(start_cases())
    run_cases(c, compiler, dir, all)
    check_modules(c, compiler, dir)
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
