fn run_cases(c: Checks, compiler: String, dir: String, cases: Array(PCase)) {
  jobs: Array(HJob) = []
  for f in cases {
    src = "${dir}/pl-${f.tag}.av"
    _ = file_write(src, f.src)
    jobs.push(compile_job("", compiler, src, "${dir}/pl-${f.tag}.bin", "${dir}/pl-${f.tag}.log"))
  }
  run_waves(jobs)
  runs: Array(HJob) = []
  for f2 in cases {
    if f2.kind != 2 {
      runs.push(run_job(dir, "pl-${f2.tag}.bin", "pl-${f2.tag}.run"))
    }
  }
  run_waves(runs)
  k = 0
  for i in 0..cases.size {
    f3 = cases[i]
    log = log_text("${dir}/pl-${f3.tag}.log")
    if f3.kind == 1 {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.eq_int(runs[k].code, 0, "${f3.tag}: exit 0")
      c.eq_str(log_text("${dir}/pl-${f3.tag}.run.out"), f3.want, "${f3.tag}: stdout")
      k += 1
    } else if f3.kind == 3 {
      c.eq_int(jobs[i].code, 0, "${f3.tag}: compiles")
      c.expect(runs[k].code != 0, "${f3.tag}: fails")
      c.expect(log_text("${dir}/pl-${f3.tag}.run.err").contains(f3.want), "${f3.tag}: says ${f3.want}")
      k += 1
    } else {
      c.expect(jobs[i].code != 0 && !file_exists("${dir}/pl-${f3.tag}.bin"), "${f3.tag}: refused")
      c.expect(log.contains(f3.want), "${f3.tag}: says ${f3.want}")
      c.expect(log.contains("pl-${f3.tag}.av:${f3.pos}\n"), "${f3.tag}: at ${f3.pos}")
    }
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_places.av")
  if compiler = env_get("AVANT_COMPILER") {
    run_cases(c, compiler, scratch_dir(), cases())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
