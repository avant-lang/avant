import harness
import backends

// The element as a place. A `for` variable over an Array of structs,
// and the parameter of `each`, `any` or `all` over one, is the element
// itself: a field written through it (`p.x = 1`, `p.pos.x += 1`) and a
// method that changes its receiver (`p.move(2)`) change the element in
// the array. Each program is compiled in parallel; an accepted one must
// print what it should, a refused one must leave no binary, say the
// expected words and point at the expected line and column, and one
// that traps must compile, end with a failure and say why.
//   - uses: fields, nested fields and methods through the place, in
//     `for`, `each`, `any` and `all`, in a method over a field (`self.ps`
//     and the bare `ps`); a read sees a write made through an index and
//     the reverse; a copy (`q = p`, an argument, a push) is a value of its
//     own; `p = q` stores the whole element (as `xs[i] = q`); writes
//     before `break`, `continue` and `return` stay; nested
//     walks of one array; an element holding references; another array
//     changed in the body, the walked array's variable assigned (the walk
//     goes on over the array it started with); a range's, an Int array's
//     and a class array's loops are as they were.
//   - traps: the walked array emptied through another name: the place's
//     next use stops on its bounds check instead of reading past the
//     elements.
//   - refused: a change of the walked array's size or order through its
//     own name (push, pop, clear, reserve, sort, reverse; a field path
//     too); a write through the place to an array a task reads, in the
//     task or beside it, as a write through the array's name is; the place captured by a lambda or a task (an assignment in a
//     lambda too); a loop variable that reuses an outer name (every
//     loop refuses it); a parameter
//     of each, any or all over plain values assigned; the parameters
//     that are copies (a comparator's, a Hash walk's, a .parallel
//     body's) written or given to a method that changes its receiver.
//   - a struct reached through an index or a field (`xs[i].x = v`,
//     `xs[i].move(2)`, `obj.pos.x = v`, `xs[i].pos.x = v`, `g[i][j].x =
//     v`) changes the stored struct; a Hash's value (`h[k].x = 1`,
//     `h[k].move(2)`) is refused, the message naming the form that works
//     (open it, change it, store it back), which runs.

class PCase {
  pub tag: String = ""
  pub src: String = ""
  pub want: String = ""
  pub pos: String = ""
  // 1 accepted, 2 refused, 3 compiles and traps.
  pub kind: Int = 0
}

fn accepted(tag: String, src: String, out: String): PCase {
  f = PCase.new()
  f.tag = tag
  f.src = src
  f.want = out
  f.kind = 1
  f
}

fn refused(tag: String, src: String, needle: String, pos: String): PCase {
  f = PCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.pos = pos
  f.kind = 2
  f
}

fn traps(tag: String, src: String, needle: String): PCase {
  f = PCase.new()
  f.tag = tag
  f.src = src
  f.want = needle
  f.kind = 3
  f
}

fn cases: Array(PCase) {
  xs: Array(PCase) = []
  xs.push(accepted("for-field", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }, Pos { x: 3, y: 4 }]\n  for p in xs {\n    p.x = 10\n    p.y += 1\n  }\n  puts(\"\${xs[0].x} \${xs[0].y} \${xs[1].x} \${xs[1].y}\")\n}\n", "10 3 10 5\n"))
  xs.push(accepted("for-method", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }, Pos { x: 3, y: 4 }]\n  for p in xs {\n    p.scale(10)\n  }\n  total = 0\n  for p in xs {\n    total += p.sum()\n  }\n  puts(\"\${xs[0].x} \${xs[1].y} \${total}\")\n}\n", "10 40 100\n"))
  xs.push(accepted("for-nested-field", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nstruct Body {\n  id: Int\n  pos: Pos\n}\n\nfn main {\n  bs = [Body { id: 1, pos: Pos { x: 1, y: 1 } }, Body { id: 2, pos: Pos { x: 2, y: 2 } }]\n  for b in bs {\n    b.pos.x += b.id * 100\n    b.pos.scale(2)\n  }\n  puts(\"\${bs[0].pos.x} \${bs[0].pos.y} \${bs[1].pos.x}\")\n}\n", "202 2 404\n"))
  xs.push(accepted("for-reads-the-element", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }, Pos { x: 3, y: 4 }]\n  for p in xs {\n    // a write through the index shows in the place, and the reverse\n    xs[0].x = 50\n    seen = p.x\n    p.y = 60\n    puts(\"\${seen} \${xs[0].y}\")\n  }\n}\n", "50 60\n3 60\n"))
  xs.push(accepted("for-copies-are-values", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn keep(p: Pos): Int {\n  p.scale(100)\n  p.x\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  kept: Array(Pos) = []\n  for p in xs {\n    q = p\n    q.x = 9\n    kept.push(p)\n    puts(keep(p))\n    p.y = 7\n  }\n  kept[0].x = 8\n  puts(\"\${xs[0].x} \${xs[0].y} \${kept[0].x} \${kept[0].y}\")\n}\n", "100\n1 7 8 2\n"))
  xs.push(accepted("for-exits", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn first_big(xs: Array(Pos)): Int {\n  for p in xs {\n    p.y = 1\n    if p.x > 2 {\n      p.x = 0\n      return 1\n    }\n  }\n  0\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 0 }, Pos { x: 3, y: 0 }, Pos { x: 5, y: 0 }]\n  for p in xs {\n    if p.x == 1 {\n      p.x = 11\n      continue\n    }\n    p.x += 100\n    break\n  }\n  puts(\"\${xs[0].x} \${xs[1].x} \${xs[2].x}\")\n  r = first_big(xs)\n  puts(\"\${r} \${xs[0].y} \${xs[1].y} \${xs[1].x} \${xs[2].y}\")\n}\n", "11 103 5\n1 1 0 103 0\n"))
  xs.push(accepted("for-nested-walks", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 0 }, Pos { x: 2, y: 0 }]\n  for p in xs {\n    for q in xs {\n      q.y += p.x\n    }\n  }\n  puts(\"\${xs[0].y} \${xs[1].y}\")\n}\n", "3 3\n"))
  xs.push(accepted("for-references-inside", "class Counter {\n  pub n: Int = 0\n}\n\nstruct Item {\n  name: String\n  hits: Counter\n  tags: Array(String)\n}\n\nfn main {\n  items = [Item { name: \"a\", hits: Counter.new(), tags: [] }, Item { name: \"b\", hits: Counter.new(), tags: [] }]\n  for it in items {\n    it.name = \"\${it.name}!\"\n    it.hits.n += 2\n    it.tags.push(it.name)\n  }\n  puts(\"\${items[0].name} \${items[1].name} \${items[1].hits.n} \${items[0].tags[0]}\")\n}\n", "a! b! 2 a!\n"))
  xs.push(accepted("for-self-field", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nclass Ship {\n  pub ps: Array(Pos) = []\n  ys: Array(Pos) = []\n\n  fn shift(dx: Int) {\n    for p in self.ps {\n      p.x += dx\n    }\n    for p in ps {\n      p.y += dx\n    }\n  }\n}\n\nfn main {\n  s = Ship.new()\n  s.ps.push(Pos { x: 1, y: 1 })\n  s.shift(5)\n  puts(\"\${s.ps[0].x} \${s.ps[0].y}\")\n}\n", "6 6\n"))
  xs.push(accepted("for-other-array-changes", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }, Pos { x: 3, y: 4 }]\n  out: Array(Pos) = []\n  old = xs\n  for p in xs {\n    out.push(p)\n    xs = []\n    p.x = 0\n  }\n  puts(\"\${old[0].x} \${old[1].x} \${out[1].x} \${xs.size}\")\n}\n", "0 0 3 0\n"))
  xs.push(accepted("for-other-elements", "struct P {\n  x: Int\n}\n\nfn main {\n  xs = [P { x: 1 }, P { x: 2 }, P { x: 3 }]\n  i = 0\n  for p in xs {\n    if i + 1 < xs.size {\n      xs[i + 1].x += p.x\n    }\n    i += 1\n  }\n  puts(\"\${xs[0].x} \${xs[1].x} \${xs[2].x}\")\n}\n", "1 3 6\n"))
  xs.push(accepted("for-plain-elements-unchanged", "class C {\n  pub n: Int = 0\n}\n\nfn main {\n  ns = [1, 2, 3]\n  for n in ns {\n    if ns.size < 5 {\n      ns.push(n)\n    }\n  }\n  cs = [C.new()]\n  for c in cs {\n    c.n = 4\n  }\n  puts(\"\${ns.size} \${cs[0].n}\")\n}\n", "5 4\n"))
  xs.push(accepted("each-place", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }, Pos { x: 3, y: 4 }]\n  xs.each { |p| p.x += 10 }\n  xs.each { |p|\n    p.scale(2)\n  }\n  puts(\"\${xs[0].x} \${xs[0].y} \${xs[1].x} \${xs[1].y}\")\n}\n", "22 4 26 8\n"))
  xs.push(accepted("any-all-place", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }, Pos { x: 3, y: 4 }]\n  hit = xs.any { |p|\n    p.y += 1\n    p.x > 2\n  }\n  every = xs.all { |p|\n    p.scale(3)\n    p.x > 0\n  }\n  puts(\"\${hit} \${every} \${xs[0].x} \${xs[0].y} \${xs[1].y}\")\n}\n", "true true 3 9 15\n"))
  xs.push(accepted("each-place-in-method", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nclass Ship {\n  pub ps: Array(Pos) = []\n\n  fn shift(dx: Int) {\n    self.ps.each { |p| p.x += dx }\n    ps.each { |p| p.y += dx }\n  }\n}\n\nfn main {\n  s = Ship.new()\n  s.ps.push(Pos { x: 1, y: 1 })\n  s.shift(5)\n  puts(\"\${s.ps[0].x} \${s.ps[0].y}\")\n}\n", "6 6\n"))
  xs.push(accepted("copies-that-read", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 3, y: 1 }, Pos { x: 1, y: 2 }]\n  xs.sort { |a, b| a.x < b.x }\n  h = Hash(String, Pos).new()\n  h[\"a\"] = Pos { x: 5, y: 6 }\n  total = 0\n  h.each { |k, v| total += v.sum() }\n  ys = xs.parallel { |p| p.sum() }\n  puts(\"\${xs[0].x} \${total} \${ys[0]} \${ys[1]}\")\n}\n", "1 11 3 4\n"))
  xs.push(traps("for-shrunk-through-another-name", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nclass Box {\n  pub ps: Array(Pos) = []\n}\n\nfn drain(b: Box) {\n  b.ps.clear()\n}\n\nfn main {\n  b = Box.new()\n  b.ps.push(Pos { x: 1, y: 2 })\n  ps = b.ps\n  for p in ps {\n    drain(b)\n    p.x = 9\n  }\n  puts(\"not reached\")\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(traps("each-shrunk-through-another-name", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }, Pos { x: 3, y: 4 }]\n  ys = xs\n  xs.each { |p|\n    _ = ys.pop()\n    _ = ys.pop()\n    puts(p.x)\n  }\n}\n", "index 0 out of bounds (size 0)"))
  xs.push(refused("for-walked-push", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    xs.push(Pos { x: 0, y: 0 })\n  }\n}\n", "cannot push xs while walking it: p is an element of xs, in place, and a change of its size or order would move it", "18:7"))
  xs.push(refused("for-walked-pop", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    _ = xs.pop()\n  }\n}\n", "cannot pop xs while walking it: p is an element of xs, in place, and a change of its size or order would move it", "18:11"))
  xs.push(refused("for-walked-clear", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    xs.clear()\n  }\n}\n", "cannot clear xs while walking it: p is an element of xs, in place, and a change of its size or order would move it", "18:7"))
  xs.push(refused("for-walked-reserve", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    xs.reserve(10)\n  }\n}\n", "cannot reserve xs while walking it: p is an element of xs, in place, and a change of its size or order would move it", "18:7"))
  xs.push(refused("for-walked-sort", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    xs.sort { |a, b| a.x < b.x }\n  }\n}\n", "cannot sort xs while walking it: p is an element of xs, in place, and a change of its size or order would move it", "18:13"))
  xs.push(refused("for-walked-reverse", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    xs.reverse()\n  }\n}\n", "cannot reverse xs while walking it: p is an element of xs, in place, and a change of its size or order would move it", "18:7"))
  xs.push(refused("each-walked-push", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  xs.each { |p| xs.push(p) }\n}\n", "cannot push xs while walking it: p is an element of xs", "17:19"))
  xs.push(refused("for-walked-field", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nclass Ship {\n  pub ps: Array(Pos) = []\n\n  fn grow {\n    for p in ps {\n      self.ps.push(p)\n    }\n  }\n}\n\nfn main {\n  s = Ship.new()\n  s.grow()\n}\n", "cannot push self.ps while walking it: p is an element of self.ps", "20:14"))
  xs.push(refused("for-walked-field-pop-bare", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nclass Ship {\n  pub ps: Array(Pos) = []\n\n  fn shrink {\n    self.ps.each { |p|\n      _ = ps.pop()\n    }\n  }\n}\n\nfn main {\n  s = Ship.new()\n  s.shrink()\n}\n", "cannot pop self.ps while walking it: p is an element of self.ps", "20:13"))
  xs.push(refused("for-place-in-lambda", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    f = { || p.x }\n    puts(f())\n  }\n}\n", "a lambda cannot capture p: p is an element of the walked array, in place, and the lambda could outlive the step; copy it first (q = p) and capture the copy", "18:14"))
  xs.push(refused("each-place-in-lambda", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  xs.each { |p|\n    f = { |k: Int| p.x = k }\n    f(3)\n  }\n}\n", "a lambda cannot capture p", "18:20"))
  xs.push(refused("for-place-in-spawn", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    h = spawn { p.x }\n    puts(h.join() ?? 0)\n  }\n}\n", "a task cannot capture p: p is an element of the walked array, in place; copy it first (q = p) and capture the copy", "18:17"))
  xs.push(accepted("for-place-assigned", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }, Pos { x: 3, y: 4 }]\n  for p in xs {\n    old = p\n    p = Pos { x: p.y, y: old.x }\n    p.x += 10\n  }\n  puts(\"\${xs[0].x} \${xs[0].y} \${xs[1].x} \${xs[1].y}\")\n}\n", "12 1 14 3\n"))
  xs.push(accepted("each-place-assigned", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  ys = [Pos { x: 7, y: 8 }]\n  xs.each { |p| p = ys[0] }\n  ys[0].x = 0\n  puts(\"\${xs[0].x} \${xs[0].y} \${ys[0].x}\")\n}\n", "7 8 0\n"))
  xs.push(refused("place-assigned-in-lambda", "struct Pos {\n  x: Int\n  y: Int\n\n  fn scale(k: Int) {\n    self.x *= k\n    self.y *= k\n  }\n\n  fn sum: Int {\n    self.x + self.y\n  }\n}\n\nfn main {\n  xs = [Pos { x: 1, y: 2 }]\n  for p in xs {\n    f = { || p = Pos { x: 0, y: 0 } }\n    f()\n  }\n}\n", "a lambda cannot capture p", "18:14"))
  xs.push(refused("each-copy-assigned", "fn main {\n  ns = [1, 2]\n  ns.each { |n| n = 3 }\n}\n", "cannot assign to n: a block parameter of each, any or all is a copy of the element, so the array would not change; store through an index (for i in 0..xs.size { xs[i] = ... })", "3:19"))
  xs.push(refused("any-copy-compound", "fn main {\n  ns = [1, 2]\n  hit = ns.any { |n|\n    n += 1\n    n > 2\n  }\n  puts(hit)\n}\n", "cannot assign to n: a block parameter of each, any or all is a copy", "4:7"))
