import harness

lib ffi_rt {
  fun avant_pin_count: Int
}

fn ffi_early(s: String): Int {
  pin(s) {
    if s.size > 2 {
      return 42
    }
  }
  0
}

fn test_ffi(c: Checks) {
  c.suite("tests/cases/test_ffi.av")
  base = ffi_rt.avant_pin_count()
  s = "hello" + "world"
  pin(s) {
    c.eq_int(s.size, 10, "pin body sees the value")
    c.eq_int(ffi_rt.avant_pin_count(), base + 1, "pin scope pins one payload")
    pin(s) {
      c.eq_int(ffi_rt.avant_pin_count(), base + 1, "nested pin of one payload shares the entry")
    }
    c.eq_int(ffi_rt.avant_pin_count(), base + 1, "inner unpin keeps the outer pin")
  }
  c.eq_int(ffi_rt.avant_pin_count(), base, "pin scope unpins on fallthrough")
  c.eq_int(ffi_early("abcd"), 42, "return inside pin")
  c.eq_int(ffi_rt.avant_pin_count(), base, "pin scope unpins on return")
  total = 0
  i = 0
  while i < 5 {
    pin(s) {
      if i == 2 {
        i += 1
        continue
      }
      if i == 4 {
        break
      }
      total += 1
    }
    i += 1
  }
  c.eq_int(total, 3, "break and continue cross the pin scope")
  c.eq_int(ffi_rt.avant_pin_count(), base, "pin scope unpins on break and continue")
  n = 0
  for j in 0..20000 {
    t = "pin-leak-probe-${j}"
    pin(t) {
      n += t.size
    }
  }
  c.expect(n > 0, "pin leak loop ran")
  c.eq_int(ffi_rt.avant_pin_count(), base, "pin scope does not leak over 20000 rounds")
  if compiler = env_get("AVANT_COMPILER") {
    root = avant_test_root()
    stamp = now_ms()

    cb_src = "${scratch()}/ffi-waveg-${stamp}-cb.av"
    cb_bin = "${scratch()}/ffi-waveg-${stamp}-cb"
    cb_clog = "${scratch()}/ffi-waveg-${stamp}-cb-cc.log"
    cb_rlog = "${scratch()}/ffi-waveg-${stamp}-cb-run.log"
    cb_body = "lib libc {\n  struct CInt {\n    v: Int32\n  }\n  fun qsort(base: Ptr(CInt), nmemb: Int, size: Int, compar: fn(Ptr(CInt), Ptr(CInt)): Int32)\n  fun cb_buf_new(n: Int32): Ptr(CInt)\n  fun cb_buf_set(b: Ptr(CInt), i: Int32, v: Int32)\n  fun cb_buf_get(b: Ptr(CInt), i: Int32): Int32\n  fun cb_buf_free(b: Ptr(CInt))\n}\nfn cmp_asc(a: Ptr(CInt), b: Ptr(CInt)): Int32 {\n  if a.v < b.v {\n    return -1\n  }\n  if a.v > b.v {\n    return 1\n  }\n  0\n}\nfn cmp_desc(a: Ptr(CInt), b: Ptr(CInt)): Int32 {\n  if a.v > b.v {\n    return -1\n  }\n  if a.v < b.v {\n    return 1\n  }\n  0\n}\nfn show(buf: Ptr(CInt), n: Int): String {\n  out = \"\"\n  i = 0\n  while i < n {\n    out = \"\${out}\${libc.cb_buf_get(buf, i.to_i32)}\"\n    i = i + 1\n  }\n  out\n}\nfn main {\n  n = 6\n  buf = libc.cb_buf_new(n.to_i32)\n  vals = [5, 2, 9, 1, 7, 3]\n  i = 0\n  while i < n {\n    libc.cb_buf_set(buf, i.to_i32, vals[i].to_i32)\n    i = i + 1\n  }\n  libc.qsort(buf, n, 4, cmp_asc)\n  puts(show(buf, n))\n  libc.qsort(buf, n, 4, cmp_desc)\n  puts(show(buf, n))\n  libc.qsort(buf, n, 4, { |a: Ptr(CInt), b: Ptr(CInt)| a.v - b.v })\n  puts(show(buf, n))\n  libc.cb_buf_free(buf)\n}\n"
    c.wrote(file_write(cb_src, cb_body), "write callback proof")
    cb_flags: Array(String) = []
    cb_flags.push("--cc")
    cb_flags.push("${root}/examples/c/callback.c")
    cb_code = compile_av_flags(compiler, cb_src, cb_bin, cb_clog, cb_flags)
    c.eq_int(cb_code, 0, "compile callback proof")
    if file_exists(cb_bin) {
      chmod_x(cb_bin)
      cb_rcode = run_av_bin(cb_bin, cb_rlog)
      c.eq_int(cb_rcode, 0, "run callback proof")
      if out = file_read(cb_rlog) {
        c.eq_str(out, "123579\n975321\n123579\n", "qsort called the Avant comparators")
      } else {
        c.expect(false, "read callback stdout")
      }
    } else {
      c.expect(false, "callback binary exists")
    }

    cap_src = "${scratch()}/ffi-waveg-${stamp}-cap.av"
    cap_bin = "${scratch()}/ffi-waveg-${stamp}-cap"
    cap_log = "${scratch()}/ffi-waveg-${stamp}-cap.log"
    cap_body = "lib libc {\n  struct CInt {\n    v: Int32\n  }\n  fun qsort(base: Ptr(CInt), nmemb: Int, size: Int, compar: fn(Ptr(CInt), Ptr(CInt)): Int32)\n  fun cb_buf_new(n: Int32): Ptr(CInt)\n}\nfn main {\n  buf = libc.cb_buf_new(2)\n  bias: Int32 = 3\n  libc.qsort(buf, 2, 4, { |a: Ptr(CInt), b: Ptr(CInt)| a.v - b.v + bias })\n}\n"
    _ = file_write(cap_src, cap_body)
    cap_code = compile_av(compiler, cap_src, cap_bin, cap_log)
    c.expect(cap_code != 0, "capturing callback does not compile")
    if cap_txt = file_read(cap_log) {
      c.expect(str_has(cap_txt, "C callback cannot capture bias"), "capturing callback diagnostic")
    } else {
      c.expect(false, "read capturing callback log")
    }

    var_src = "${scratch()}/ffi-waveg-${stamp}-var.av"
    var_bin = "${scratch()}/ffi-waveg-${stamp}-var"
    var_log = "${scratch()}/ffi-waveg-${stamp}-var.log"
    var_body = "lib libc {\n  struct CInt {\n    v: Int32\n  }\n  fun qsort(base: Ptr(CInt), nmemb: Int, size: Int, compar: fn(Ptr(CInt), Ptr(CInt)): Int32)\n  fun cb_buf_new(n: Int32): Ptr(CInt)\n}\nfn cmp_asc(a: Ptr(CInt), b: Ptr(CInt)): Int32 {\n  a.v - b.v\n}\nfn main {\n  buf = libc.cb_buf_new(2)\n  f = cmp_asc\n  libc.qsort(buf, 2, 4, f)\n}\n"
    _ = file_write(var_src, var_body)
    var_code = compile_av(compiler, var_src, var_bin, var_log)
    c.expect(var_code != 0, "fn variable callback does not compile")
    if var_txt = file_read(var_log) {
      c.expect(str_has(var_txt, "C callback must be a function name"), "fn variable callback diagnostic")
    } else {
      c.expect(false, "read fn variable log")
    }

    pin_src = "${scratch()}/ffi-waveg-${stamp}-pin.av"
    pin_bin = "${scratch()}/ffi-waveg-${stamp}-pin"
    pin_log = "${scratch()}/ffi-waveg-${stamp}-pin.log"
    _ = file_write(pin_src, "fn main {\n  pin(42) {\n    puts(\"no\")\n  }\n}\n")
    pin_code = compile_av(compiler, pin_src, pin_bin, pin_log)
    c.expect(pin_code != 0, "pin of an Int does not compile")
    if pin_txt = file_read(pin_log) {
      c.expect(str_has(pin_txt, "pin needs a heap value, got Int"), "pin diagnostic")
    } else {
      c.expect(false, "read pin log")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_ffi(c)
  c.finish
}
