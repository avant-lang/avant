import harness
import backends
import std.fs
import std.process

// Arrays, hashes, Buf, and Bytes on the new back end
// (AVANT_BACKEND=llvm). For every program of the heap subset:
// (a) it compiles (--debug), and a second time with the call
// forms of allocation and the barrier (AVANT_LLVM_CALL_FORMS=1;
// the default is the inline fast paths); every program's stdout,
// stderr, and exit status are its run golden
// (tests/goldens/runs, frozen from the old back end when it retired;
// until then the two back ends were compared); (b) both programs
// print the same under AVANT_GC_VERIFY=1, under AVANT_YOUNG_MB=1
// (a 1 MB nursery: many young collections), under both, and
// under AVANT_NURSERY=0 (full collections only), and the
// verifier reports nothing (stderr unchanged); for the fixtures
// with goldens, (c) `avant dump` under AVANT_BACKEND=llvm prints
// exactly tests/goldens/heap/<name>.mir. (The L0001 probe of
// this file, a `spawn` block, left once the back end lowered it:
// tests/fixtures/threads/spawn.av.)

// The fixtures with a MIR golden: tests/goldens/list.txt's rows for
// this file.
fn golden_progs(c: Checks): Array(String) {
  xs: Array(String) = []
  names = golden_names_of(c, "test_heap")
  i = 0
  while i < names.size {
    xs.push("tests/fixtures/heap/${names[i]}.av")
    i += 1
  }
  xs
}

fn other_progs: Array(String) {
  xs: Array(String) = []
  xs.push("tests/fixtures/heap/trap_index.av")
  xs.push("tests/fixtures/heap/trap_loop.av")
  xs.push("tests/fixtures/heap/trap_loop_str.av")
  xs.push("tests/fixtures/heap/trap_pop.av")
  xs.push("tests/fixtures/heap/each_delete.av")
  xs.push("tests/fixtures/heap/hash_churn.av")
  xs.push("tests/fixtures/heap/hash_types.av")
  xs.push("tests/fixtures/heap/hash_keys.av")
  xs.push("tests/fixtures/heap/hash_values.av")
  xs.push("tests/fixtures/heap/hash_literal.av")
  xs.push("tests/fixtures/heap/sets.av")
  xs.push("tests/fixtures/heap/slices.av")
  xs.push("tests/fixtures/heap/verbs.av")
  xs.push("tests/fixtures/heap/trap_slice.av")
  xs.push("tests/fixtures/heap/trap_index_from.av")
  xs.push("tests/fixtures/heap/trap_insert.av")
  xs.push("tests/fixtures/heap/own_hash.av")
  xs.push("tests/fixtures/heap/build.av")
  xs.push("tests/fixtures/heap/empty_payload.av")
  xs.push("examples/sieve.av")
  xs.push("tests/fixtures/modules/main.av")
  xs.push("tests/fixtures/part3/buf.av")
  xs.push("tests/fixtures/part3/pop.av")
  xs
}

fn golden_of(rel: String): String {
  base = rel
  i = 0
  while i < rel.size {
    if rel[i] == 47 {
      base = rel[i + 1..]
    }
    i += 1
  }
  "tests/goldens/heap/${base[..base.size - 3]}.mir"
}

fn gc_envs: Array(String) {
  ["AVANT_GC_VERIFY=1", "AVANT_YOUNG_MB=1", "AVANT_GC_VERIFY=1 AVANT_YOUNG_MB=1", "AVANT_NURSERY=0"]
}

fn test_heap(c: Checks, compiler: String, root: String, dir: String) {
  gp = golden_progs(c)
  progs = gp.dup()
  op = other_progs()
  progs.concat(op)

  // The first wave: the compiles and the dumps.
  jobs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    jobs.push(compile_job("AVANT_BACKEND=llvm", compiler, "${root}/${progs[i]}", "${dir}/${k}.new", "${dir}/${k}.new.log"))
    jobs.push(compile_job("AVANT_BACKEND=llvm AVANT_LLVM_CALL_FORMS=1", compiler, "${root}/${progs[i]}", "${dir}/${k}.cf", "${dir}/${k}.cf.log"))
    i += 1
  }
  i = 0
  while i < gp.size {
    k = key_of(gp[i])
    a: Array(String) = []
    a.push("dump")
    a.push("${root}/${gp[i]}")
    jobs.push(env_job("AVANT_BACKEND=llvm", compiler, a, "${dir}/${k}.mir"))
    i += 1
  }
  run_waves(jobs)
  i = 0
  while i < progs.size {
    p = progs[i]
    c.eq_int(jobs[2 * i].code, 0, "${p}: compiles under llvm")
    c.eq_int(jobs[2 * i + 1].code, 0, "${p}: compiles under llvm with the call forms")
    i += 1
  }
  base = 2 * progs.size
  i = 0
  while i < gp.size {
    j = jobs[base + i]
    c.eq_int(j.code, 0, "${gp[i]}: dump under llvm exits 0")
    want = "(no golden)"
    if t = fs.read("${root}/${golden_of(gp[i])}") {
      want = t
    }
    c.eq_str(log_text(j.log), want, "${gp[i]}: the MIR dump is ${golden_of(gp[i])}")
    i += 1
  }

  // The second wave: every program in both forms, then each under each GC
  // environment.
  envs = gc_envs()
  forms = ["new", "cf"]
  per = forms.size * (1 + envs.size)
  runs: Array(HJob) = []
  i = 0
  while i < progs.size {
    k = key_of(progs[i])
    f = 0
    while f < forms.size {
      runs.push(run_job(dir, "${k}.${forms[f]}", "${k}.${forms[f]}.b"))
      e = 0
      while e < envs.size {
        runs.push(run_job_env(dir, "${k}.${forms[f]}", "${k}.${forms[f]}.g${e}", envs[e]))
        e += 1
      }
      f += 1
    }
    i += 1
  }
  run_waves(runs)
  i = 0
  while i < progs.size {
    p = progs[i]
    k = key_of(p)
    want_out = golden_out(root, p)
    want_err = golden_err(root, p)
    want_code = golden_status(root, p)
    for f, fm in forms {
      at = per * i + f * (1 + envs.size)
      c.eq_int(runs[at].code, want_code, "${p} (${fm}): the golden exit status")
      c.eq_str(log_text("${dir}/${k}.${fm}.b.out"), want_out, "${p} (${fm}): the golden stdout")
      c.eq_str(log_text("${dir}/${k}.${fm}.b.err"), want_err, "${p} (${fm}): the golden stderr")
      e = 0
      while e < envs.size {
        c.eq_int(runs[at + 1 + e].code, want_code, "${p} (${fm}) under ${envs[e]}: the golden exit status")
        c.eq_str(log_text("${dir}/${k}.${fm}.g${e}.out"), want_out, "${p} (${fm}) under ${envs[e]}: the golden stdout")
        c.eq_str(log_text("${dir}/${k}.${fm}.g${e}.err"), want_err, "${p} (${fm}) under ${envs[e]}: the golden stderr (no verifier report)")
        e += 1
      }
    }
    i += 1
  }
}

fn test_main(c: Checks) {
  c.suite("tests/cases/test_heap.av")
  if compiler = process.env("AVANT_COMPILER") {
    test_heap(c, compiler, avant_test_root(), scratch_dir())
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_main(c)
  c.finish()
}
