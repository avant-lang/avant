import harness

fn invoke(compiler: String, cmd: String, log: String, flags: Array(String)): Int {
  args: Array(String) = []
  args.push(cmd)
  i = 0
  while i < flags.size {
    args.push(flags[i])
    i += 1
  }
  process_run_out(compiler, args, log) ?? -1
}

fn read(path: String): String {
  if text = file_read(path) {
    return text
  }
  ""
}

fn body(text: String): String {
  i = 0
  while i < text.size {
    if text[i] == 10 {
      return str_slice(text, i + 1, text.size)
    }
    i += 1
  }
  text
}

fn head(text: String): String {
  if text.size > 240 {
    return str_slice(text, 0, 240)
  }
  text
}

fn has_lib(text: String): Bool {
  if text.size >= 4 {
    if str_slice(text, 0, 4) == "lib " {
      return true
    }
  }
  str_has(text, "\nlib ")
}

fn test_bind(c: Checks) {
  c.suite("tests/cases/test_bind.av")
  if compiler = env_get("AVANT_COMPILER") {
    c.expect(file_exists(compiler), "AVANT_COMPILER exists")
    root = avant_test_root()
    stamp = now_ms()
    none: Array(String) = []
    // Where the helper comes from (D135, D141): a build product, found in
    // runtime/build/ inside a checkout and beside the compiler otherwise.
    // Each layout runs from a directory outside any checkout.
    abs_compiler = compiler_abs("bind", compiler)
    here = cwd_here()
    real_helper = "${here}/runtime/build/avant-bind"
    abs_h = "${here}/examples/c/add.h"
    lay = scratch_dir()
    mkdir_p("${lay}/rel")
    copy_file(abs_compiler, "${lay}/rel/avant")
    copy_file(real_helper, "${lay}/rel/avant-bind")
    mkdir_p("${lay}/co/bin")
    mkdir_p("${lay}/co/runtime/build")
    copy_file(abs_compiler, "${lay}/co/bin/avant")
    _ = file_write("${lay}/co/runtime/build/avant_rt.o", "")
    copy_file(real_helper, "${lay}/co/runtime/build/avant-bind")
    _ = file_write("${lay}/co/bin/avant-bind", "#!/bin/sh\necho STALE\nexit 3\n")
    chmod_x("${lay}/co/bin/avant-bind")
    mkdir_p("${lay}/none")
    copy_file(abs_compiler, "${lay}/none/avant")
    lay_runs: Array(String) = []
    lay_runs.push("${lay}/rel/avant")
    lay_runs.push("${lay}/co/bin/avant")
    lay_runs.push("${lay}/none/avant")
    lay_codes: Array(Int) = []
    lay_texts: Array(String) = []
    k = 0
    while k < lay_runs.size {
      la: Array(String) = []
      la.push("-u")
      la.push("AVANT_ROOT")
      la.push("-C")
      la.push(lay)
      la.push(lay_runs[k])
      la.push("bind")
      la.push(abs_h)
      la_log = "${lay}/run-${k}.log"
      lay_codes.push(process_run_out("/usr/bin/env", la, la_log) ?? -1)
      lay_texts.push(read(la_log))
      k += 1
    }
    c.expect(lay_codes[0] == 0 && str_has(lay_texts[0], "lib add {"), "a release layout finds avant-bind beside the compiler")
    c.expect(lay_codes[1] == 0 && str_has(lay_texts[1], "lib add {"), "a checkout uses runtime/build/avant-bind")
    c.expect(!str_has(lay_texts[1], "STALE"), "a checkout ignores an old avant-bind beside the compiler")
    c.expect(lay_codes[2] != 0, "bind without the helper fails")
    c.expect(str_has(lay_texts[2], "avant-bind not found") && str_has(lay_texts[2], "runtime/build.sh"), "bind without the helper says how to build it")

    add_h = "${root}/examples/c/add.h"
    add_log = "${scratch()}/bind-${stamp}-add.log"
    add_flags: Array(String) = []
    add_flags.push(add_h)
    add_code = invoke(compiler, "bind", add_log, add_flags)
    c.eq_int(add_code, 0, "bind add.h exits 0")
    add_txt = read(add_log)
    c.expect(str_has(add_txt, "lib add {"), "default lib name is the header stem (${head(add_txt)})")
    c.expect(str_has(add_txt, "fun avant_add(a: Int32, b: Int32): Int32"), "avant_add")
    c.expect(str_has(add_txt, "fun avant_sentinel: Ptr(Void)"), "avant_sentinel")
    c.expect(str_has(add_txt, "fun avant_is_null(p: Ptr(Void)): Int32"), "avant_is_null")
    c.expect(str_has(add_txt, "// generated by avant bind from ${add_h}"), "generated comment")

    over_log = "${scratch()}/bind-${stamp}-over.log"
    over_flags: Array(String) = []
    over_flags.push("--lib")
    over_flags.push("math")
    over_flags.push(add_h)
    over_code = invoke(compiler, "b", over_log, over_flags)
    c.eq_int(over_code, 0, "b --lib exits 0")
    over_txt = read(over_log)
    c.expect(str_has(over_txt, "lib math {"), "--lib overrides the name")
    c.expect(!str_has(over_txt, "lib add {"), "--lib replaces the stem")

    eq_log = "${scratch()}/bind-${stamp}-eq.log"
    eq_flags: Array(String) = []
    eq_flags.push("--lib=z")
    eq_flags.push("${root}/examples/c/zlib_version.h")
    eq_code = invoke(compiler, "bind", eq_log, eq_flags)
    c.eq_int(eq_code, 0, "--lib= exits 0")
    eq_txt = read(eq_log)
    c.expect(str_has(eq_txt, "lib z {"), "--lib= name")
    c.expect(str_has(eq_txt, "fun zlibVersion: String?"), "zlibVersion")

    lay_log = "${scratch()}/bind-${stamp}-lay.log"
    lay_flags: Array(String) = []
    lay_flags.push("${root}/examples/c/layout.h")
    lay_code = invoke(compiler, "bind", lay_log, lay_flags)
    c.eq_int(lay_code, 0, "bind layout.h exits 0")
    lay_txt = read(lay_log)
    if lay_src = file_read("${root}/examples/layout.av") {
      c.expect(str_has(lay_src, body(lay_txt)), "layout.h body matches examples/layout.av")
    } else {
      c.expect(false, "read examples/layout.av")
    }

    anon_log = "${scratch()}/bind-${stamp}-anon.log"
    anon_flags: Array(String) = []
    anon_flags.push("${root}/examples/c/layout_anon.h")
    anon_code = invoke(compiler, "bind", anon_log, anon_flags)
    c.eq_int(anon_code, 0, "anon exits 0")
    anon_txt = read(anon_log)
    c.expect(str_has(anon_txt, "struct Pair {"), "anonymous struct takes the typedef name")
    c.expect(str_has(anon_txt, "fun pair_ok: Int"), "anon function stays")

    pack_log = "${scratch()}/bind-${stamp}-pack.log"
    pack_flags: Array(String) = []
    pack_flags.push("${root}/examples/c/layout_pack.h")
    pack_code = invoke(compiler, "bind", pack_log, pack_flags)
    c.eq_int(pack_code, 0, "packed exits 0")
    pack_txt = read(pack_log)
    c.expect(str_has(pack_txt, "packed"), "packed diagnostic")
    c.expect(str_has(pack_txt, "fun pack_f: Int"), "packed function stays")
    c.expect(!str_has(pack_txt, "struct Pack"), "packed record is skipped")

    bit_log = "${scratch()}/bind-${stamp}-bit.log"
    bit_flags: Array(String) = []
    bit_flags.push("${root}/examples/c/layout_bit.h")
    bit_code = invoke(compiler, "bind", bit_log, bit_flags)
    c.eq_int(bit_code, 0, "bitfield exits 0")
    bit_txt = read(bit_log)
    c.expect(str_has(bit_txt, "bitfield"), "bitfield diagnostic")
    c.expect(str_has(bit_txt, "fun bits_f: Int"), "bitfield function stays")
    c.expect(!str_has(bit_txt, "struct Bits"), "bitfield record is skipped")

    two_log = "${scratch()}/bind-${stamp}-two.log"
    two_flags: Array(String) = []
    two_flags.push("${root}/examples/c/layout_two.h")
    two_code = invoke(compiler, "bind", two_log, two_flags)
    c.eq_int(two_code, 0, "two typedefs exits 0")
    two_txt = read(two_log)
    c.expect(str_has(two_txt, "two typedefs"), "two typedefs diagnostic")
    c.expect(str_has(two_txt, "fun amb_f: Int"), "ambiguous function stays")
    c.expect(!str_has(two_txt, "struct "), "two typedefs skip the record")

    raw_log = "${scratch()}/bind-${stamp}-raw.log"
    raw_flags: Array(String) = []
    raw_flags.push("${root}/examples/c/layout_uchar.h")
    raw_code = invoke(compiler, "bind", raw_log, raw_flags)
    c.eq_int(raw_code, 0, "unsigned char exits 0")
    raw_txt = read(raw_log)
    c.expect(str_has(raw_txt, "unsigned char*"), "unsigned char* diagnostic")
    c.expect(str_has(raw_txt, "fun raw_f: Int"), "unsigned char function stays")
    c.expect(!str_has(raw_txt, "struct Raw"), "unsigned char record is skipped")

    by_log = "${scratch()}/bind-${stamp}-by.log"
    by_flags: Array(String) = []
    by_flags.push("${root}/examples/c/layout_byval.h")
    by_code = invoke(compiler, "bind", by_log, by_flags)
    c.eq_int(by_code, 1, "by-value exits non-zero")
    by_txt = read(by_log)
    c.expect(str_has(by_txt, "C struct passed by value is not supported"), "by-value diagnostic")
    c.expect(!str_has(by_txt, "struct Point"), "by-value hides the partial lib")
    c.expect(!has_lib(by_txt), "by-value prints no lib")

    miss_log = "${scratch()}/bind-${stamp}-miss.log"
    miss_flags: Array(String) = []
    miss_flags.push("${scratch()}/bind-${stamp}-missing.h")
    miss_code = invoke(compiler, "bind", miss_log, miss_flags)
    c.eq_int(miss_code, 0, "missing header exits 0")
    miss_txt = read(miss_log)
    c.expect(str_has(miss_txt, "header is missing"), "missing header diagnostic")
    c.expect(!has_lib(miss_txt), "missing header prints no lib")

    flag_log = "${scratch()}/bind-${stamp}-flag.log"
    flag_flags: Array(String) = []
    flag_flags.push("--nope")
    flag_flags.push(add_h)
    flag_code = invoke(compiler, "bind", flag_log, flag_flags)
    c.eq_int(flag_code, 0, "unknown flag exits 0")
    flag_txt = read(flag_log)
    c.expect(str_has(flag_txt, "unknown bind argument --nope"), "unknown flag diagnostic")
    c.expect(!has_lib(flag_txt), "unknown flag prints no lib")

    none_log = "${scratch()}/bind-${stamp}-none.log"
    none_code = invoke(compiler, "bind", none_log, none)
    c.eq_int(none_code, 0, "no header exits 0")
    none_txt = read(none_log)
    c.expect(str_has(none_txt, "bind needs a C header"), "bind needs a header")
    c.expect(str_has(none_txt, "avant bind"), "usage lists bind")

    need_log = "${scratch()}/bind-${stamp}-need.log"
    need_flags: Array(String) = []
    need_flags.push("--lib")
    need_code = invoke(compiler, "b", need_log, need_flags)
    c.eq_int(need_code, 0, "--lib without a name exits 0")
    need_txt = read(need_log)
    c.expect(str_has(need_txt, "--lib needs a name"), "--lib needs a name")

    many_log = "${scratch()}/bind-${stamp}-many.log"
    many_flags: Array(String) = []
    many_flags.push(add_h)
    many_flags.push("${root}/examples/c/layout.h")
    many_code = invoke(compiler, "bind", many_log, many_flags)
    c.eq_int(many_code, 0, "two headers exits 0")
    many_txt = read(many_log)
    c.expect(str_has(many_txt, "bind takes one header"), "one header")
    c.expect(!has_lib(many_txt), "two headers print no lib")

    // D64 as amended (Stage 29 W1b): every C scalar type binds to its exact
    // Avant type (UInt32, Int8 ... Float32); before, one unsigned int,
    // float or uint8_t failed the whole header.
    u32_h = "${scratch()}/avant_bind_${stamp}_u32.h"
    _ = file_write(u32_h, "unsigned int widen(unsigned int x);\nint add(int a, int b);\n")
    u32_log = "${scratch()}/bind-${stamp}-u32.log"
    u32_flags: Array(String) = []
    u32_flags.push(u32_h)
    u32_code = invoke(compiler, "bind", u32_log, u32_flags)
    c.eq_int(u32_code, 0, "unsigned 32-bit fun exits 0")
    u32_txt = read(u32_log)
    c.expect(str_has(u32_txt, "fun widen(x: UInt32): UInt32"), "unsigned 32-bit maps to UInt32")
    c.expect(str_has(u32_txt, "fun add(a: Int32, b: Int32): Int32"), "the rest of the header binds")

    u32f_h = "${scratch()}/avant_bind_${stamp}_u32f.h"
    _ = file_write(u32f_h, "struct Counter { unsigned int n; int tag; };\nint get_tag(struct Counter *c);\n")
    u32f_log = "${scratch()}/bind-${stamp}-u32f.log"
    u32f_flags: Array(String) = []
    u32f_flags.push(u32f_h)
    u32f_code = invoke(compiler, "bind", u32f_log, u32f_flags)
    c.eq_int(u32f_code, 0, "unsigned 32-bit field exits 0")
    u32f_txt = read(u32f_log)
    c.expect(str_has(u32f_txt, "struct Counter {\n    n: UInt32\n    tag: Int32\n  }"), "unsigned 32-bit field maps to UInt32")

    mkdir_p("${scratch()}/bind-${stamp}-cs")
    sc_h = "${scratch()}/bind-${stamp}-cs/hdr_cs.h"
    _ = file_write(sc_h, "#include <stdint.h>\ntypedef struct CsPix {\n  uint8_t r;\n  uint8_t g;\n  uint16_t w;\n  int16_t h;\n  int8_t tag;\n  uint32_t id;\n  float gain;\n} CsPix;\nint8_t cs_neg_i8(int8_t x);\nunsigned char cs_inc_u8(unsigned char x);\nshort cs_neg_i16(short x);\nunsigned short cs_dbl_u16(unsigned short x);\nuint32_t cs_inc_u32(uint32_t x);\nfloat cs_half_f32(float x);\ndouble cs_sum(signed char a, uint8_t b, int16_t c, uint16_t d, uint32_t e, float f);\nCsPix *cs_pix_new(void);\nvoid cs_pix_fill(CsPix *p);\ndouble cs_pix_total(const CsPix *p);\n")
    sc_log = "${scratch()}/bind-${stamp}-cs.log"
    sc_flags: Array(String) = []
    sc_flags.push(sc_h)
    sc_code = invoke(compiler, "bind", sc_log, sc_flags)
    c.eq_int(sc_code, 0, "C scalar types: bind exits 0")
    sc_txt = read(sc_log)
    c.expect(str_has(sc_txt, "struct CsPix {\n    r: UInt8\n    g: UInt8\n    w: UInt16\n    h: Int16\n    tag: Int8\n    id: UInt32\n    gain: Float32\n  }"), "C scalar fields map to their exact types")
    c.expect(str_has(sc_txt, "fun cs_sum(a: Int8, b: UInt8, c: Int16, d: UInt16, e: UInt32, f: Float32): Float64"), "C scalar parameters map to their exact types")
    c.expect(str_has(sc_txt, "fun cs_half_f32(x: Float32): Float32"), "float maps to Float32")
    ld_h = "${scratch()}/avant_bind_${stamp}_ld.h"
    _ = file_write(ld_h, "long double half(long double x);\n")
    ld_log = "${scratch()}/bind-${stamp}-ld.log"
    ld_flags: Array(String) = []
    ld_flags.push(ld_h)
    ld_code = invoke(compiler, "bind", ld_log, ld_flags)
    c.eq_int(ld_code, 1, "long double has no Avant type: bind exits 1")
    c.expect(str_has(read(ld_log), "unsupported C type long double"), "long double diagnostic")
    // The generated text compiles against the C it describes and runs.
    sc_src = "${scratch()}/bind-${stamp}-cs.av"
    sc_buf = buf_new()
    sc_buf.push_str(sc_txt)
    sc_buf.push_str("\nfn main {\n  puts(hdr_cs.cs_neg_i8(-127))\n  puts(hdr_cs.cs_inc_u8(254))\n  puts(hdr_cs.cs_inc_u32(4294967294))\n  puts(hdr_cs.cs_half_f32(5.0))\n  puts(hdr_cs.cs_sum(-1, 2, -3, 4, 5, 0.5))\n  p = hdr_cs.cs_pix_new()\n  hdr_cs.cs_pix_fill(p)\n  puts(\"\${p.r} \${p.w} \${p.h} \${p.tag} \${p.id} \${p.gain}\")\n}\n")
    _ = file_write(sc_src, sc_buf.to_s)
    sc_bin = "${scratch()}/bind-${stamp}-cs.bin"
    sc_clog = "${scratch()}/bind-${stamp}-cs-cc.log"
    sc_cc: Array(String) = []
    sc_cc.push("--cc")
    sc_cc.push("${root}/tests/fixtures/ffi/ffi.c")
    c.eq_int(compile_av_flags(compiler, sc_src, sc_bin, sc_clog, sc_cc), 0, "the bound C scalar header compiles")
    if file_exists(sc_bin) {
      chmod_x(sc_bin)
      sc_rlog = "${scratch()}/bind-${stamp}-cs-run.log"
      c.eq_int(run_av_bin(sc_bin, sc_rlog), 0, "the bound C scalar program runs")
      c.eq_str(read(sc_rlog), "127\n255\n4294967295\n2.5\n7.5\n250 65535 -300 -5 4000000000 0.25\n", "the bound C scalar program reads C's values")
    } else {
      c.expect(false, "the bound C scalar program runs")
    }

    u64_h = "${scratch()}/avant_bind_${stamp}_u64.h"
    _ = file_write(u64_h, "unsigned long long widen64(unsigned long long x);\n")
    u64_log = "${scratch()}/bind-${stamp}-u64.log"
    u64_flags: Array(String) = []
    u64_flags.push(u64_h)
    u64_code = invoke(compiler, "bind", u64_log, u64_flags)
    c.eq_int(u64_code, 0, "unsigned 64-bit fun exits 0")
    u64_txt = read(u64_log)
    c.expect(str_has(u64_txt, "fun widen64(x: UInt64): UInt64"), "unsigned 64-bit maps to UInt64")

    gen_src = "${scratch()}/bind-${stamp}-gen.av"
    gen_buf = buf_new()
    gen_buf.push_str(add_txt)
    gen_buf.push_str("\nfn main {\n  puts(add.avant_add(20, 22))\n}\n")
    c.wrote(file_write(gen_src, gen_buf.to_s), "write generated add program")
    gen_bin = "${scratch()}/bind-${stamp}-gen.bin"
    gen_clog = "${scratch()}/bind-${stamp}-gen-cc.log"
    gen_cc: Array(String) = []
    gen_cc.push("--cc")
    gen_cc.push("${root}/examples/c/add.c")
    gen_ccode = compile_av_flags(compiler, gen_src, gen_bin, gen_clog, gen_cc)
    c.eq_int(gen_ccode, 0, "compile generated add")
    if file_exists(gen_bin) {
      chmod_x(gen_bin)
      gen_rlog = "${scratch()}/bind-${stamp}-gen-run.log"
      gen_rcode = run_av_bin(gen_bin, gen_rlog)
      c.eq_int(gen_rcode, 0, "run generated add")
      c.eq_str(read(gen_rlog), "42\n", "generated add prints 42")
    } else {
      c.expect(false, "generated add binary")
    }

    ir_log = "${scratch()}/bind-${stamp}-add.mir"
    ir_code = dump_av(compiler, "${root}/examples/add.av", ir_log)
    c.eq_int(ir_code, 0, "dump hand-written lib")
    if got = file_read(ir_log) {
      if want = file_read("${root}/tests/goldens/examples/add.mir") {
        c.eq_str(got, want, "hand-written lib MIR dump is unchanged")
      } else {
        c.expect(false, "read add.mir golden")
      }
    } else {
      c.expect(false, "read add dump")
    }
  } else {
    c.expect(false, "AVANT_COMPILER")
  }
}

fn main: Int {
  if list_only() {
    return 0
  }
  c = Checks.new()
  c.started = now_ms()
  test_bind(c)
  c.finish
}
