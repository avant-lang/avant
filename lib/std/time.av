// std.time: the wall clock, a point in time as a value, its RFC 3339
// text both ways, and sleeping.
//
// A `Time` is seconds and nanoseconds since 1970-01-01T00:00:00Z (UTC,
// no leap seconds, as the system clock counts): `time.now()` reads the
// wall clock; two times compare with ==, <, <= and the others, and sort
// in order; `t.iso()` writes RFC 3339 text in UTC
// (`2026-11-18T09:30:00Z`, with the fraction of a second when there is
// one), and `Time.parse_iso(s)` reads it back, any offset taken into
// account, or gives nil. Intervals are the monotonic `now_ms()` and
// `now_us()` of the prelude: the wall clock can be set back. Time zones
// and calendar arithmetic are not here.

lib time_os {
  fun avant_os_wall_ns: Int
  fun avant_os_sleep_ms(ms: Int)
}

pub struct Time {
  // Seconds since the epoch (negative before it).
  pub sec: Int
  // Nanoseconds within that second, 0 to 999_999_999.
  pub nsec: Int

  // RFC 3339 text: `YYYY-MM-DDTHH:MM:SS`, then a fraction of a second
  // (one to nine digits, more are cut), then `Z` or an offset `+HH:MM`
  // or `-HH:MM`; `t` and `z` may be lower case. nil for anything else,
  // or a field out of its range (a month 13, February 30, a second 60).
  pub fn self.parse_iso(text: String): Time? {
    if text.size < 20 {
      return nil
    }
    y = digits(text, 0, 4)
    mo = digits(text, 5, 2)
    d = digits(text, 8, 2)
    h = digits(text, 11, 2)
    mi = digits(text, 14, 2)
    s = digits(text, 17, 2)
    if y < 0 || mo < 0 || d < 0 || h < 0 || mi < 0 || s < 0 {
      return nil
    }
    if text[4] != '-' || text[7] != '-' || (text[10] != 'T' && text[10] != 't') || text[13] != ':' || text[16] != ':' {
      return nil
    }
    if mo < 1 || mo > 12 || d < 1 || d > month_days(y, mo) || h > 23 || mi > 59 || s > 59 {
      return nil
    }
    i = 19
    ns = 0
    if text[i] == '.' {
      i += 1
      start = i
      scale = 100000000
      while i < text.size && text[i] >= '0' && text[i] <= '9' {
        ns += (text[i] - '0') * scale
        scale /= 10
        i += 1
      }
      if i == start {
        return nil
      }
    }
    if i >= text.size {
      return nil
    }
    off = 0
    z = text[i]
    if z == 'Z' || z == 'z' {
      i += 1
    } else if z == '+' || z == '-' {
      oh = digits(text, i + 1, 2)
      om = digits(text, i + 4, 2)
      if oh < 0 || om < 0 || text[i + 3] != ':' || oh > 23 || om > 59 {
        return nil
      }
      off = oh * 3600 + om * 60
      if z == '-' {
        off = 0 - off
      }
      i += 6
    } else {
      return nil
    }
    if i != text.size {
      return nil
    }
    Time { sec: days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + s - off, nsec: ns }
  }

  // The RFC 3339 text of this time in UTC: `2026-11-18T09:30:00Z`, and
  // when nsec is not 0 its fraction, nine digits without the zeros that
  // end them (`.5`, `.000001`). Time.parse_iso reads it back exactly.
  pub fn iso: String {
    days = floor_div(sec, 86400)
    rem = sec - days * 86400
    out = Buf.new(32)
    civil(days, out)
    out.push_byte('T')
    pad(out, rem / 3600, 2)
    out.push_byte(':')
    pad(out, rem / 60 % 60, 2)
    out.push_byte(':')
    pad(out, rem % 60, 2)
    if nsec != 0 {
      out.push_byte('.')
      digit = 100000000
      left = nsec
      while left > 0 {
        out.push_byte('0' + left / digit)
        left = left % digit
        digit /= 10
      }
    }
    out.push_byte('Z')
    out.to_s()
  }

  // Seconds, then nanoseconds: the order of the times.
  fn compare(other: Time): Int {
    if sec != other.sec {
      if sec < other.sec {
        return -1
      }
      return 1
    }
    if nsec < other.nsec {
      return -1
    }
    if nsec > other.nsec {
      return 1
    }
    0
  }
}

// The wall clock, now.
pub fn now: Time {
  ns = time_os.avant_os_wall_ns()
  s = floor_div(ns, 1000000000)
  Time { sec: s, nsec: ns - s * 1000000000 }
}

// Sleeps ms milliseconds (0 or more); other tasks run meanwhile.
pub fn sleep_ms(ms: Int) {
  if ms < 0 {
    none: Int? = nil
    _ = none.expect("time.sleep_ms(ms) needs ms >= 0, got ${ms}")
    return
  }
  time_os.avant_os_sleep_ms(ms)
}

fn floor_div(a: Int, b: Int): Int {
  q = a / b
  if (a % b != 0) && ((a < 0) != (b < 0)) {
    return q - 1
  }
  q
}

// The n decimal digits of text at at, or -1.
fn digits(text: String, at: Int, n: Int): Int {
  if at < 0 || at + n > text.size {
    return -1
  }
  v = 0
  for i in at..at + n {
    c = text[i]
    if c < '0' || c > '9' {
      return -1
    }
    v = v * 10 + (c - '0')
  }
  v
}

fn leap(y: Int): Bool {
  y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)
}

fn month_days(y: Int, m: Int): Int {
  if m == 2 {
    if leap(y) {
      return 29
    }
    return 28
  }
  if m == 4 || m == 6 || m == 9 || m == 11 {
    return 30
  }
  31
}

// Days since 1970-01-01 of a date of the proleptic Gregorian calendar
// (Howard Hinnant's days_from_civil).
fn days_from_civil(y0: Int, m: Int, d: Int): Int {
  y = y0
  if m <= 2 {
    y -= 1
  }
  era = floor_div(y, 400)
  yoe = y - era * 400
  mp = (m + 9) % 12
  doy = (153 * mp + 2) / 5 + d - 1
  doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

// The date of a day since 1970-01-01, written as `YYYY-MM-DD` into out
// (Hinnant's civil_from_days).
fn civil(days: Int, out: Buf) {
  z = days + 719468
  era = floor_div(z, 146097)
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  y = yoe + era * 400
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  d = doy - (153 * mp + 2) / 5 + 1
  m = mp + 3
  if mp >= 10 {
    m = mp - 9
  }
  if m <= 2 {
    y += 1
  }
  if y < 0 {
    out.push_byte('-')
    y = 0 - y
  }
  pad(out, y, 4)
  out.push_byte('-')
  pad(out, m, 2)
  out.push_byte('-')
  pad(out, d, 2)
}

// n in at least width digits, zeros first.
fn pad(out: Buf, n: Int, width: Int) {
  w = 1
  v = n
  while v >= 10 {
    v /= 10
    w += 1
  }
  for i in w..width {
    out.push_byte('0')
  }
  out.push_fmt_i(n)
}
