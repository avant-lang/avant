lib avant_testing_io {
  fun write(fd: Int, buf: String, count: Int): Int
}

lib avant_testing_tmp {
  fun avant_tmp_new_dir: String
}

// A failed check fails the process (D84, runtime/avant_io.c): if the
// program would exit 0, it exits 1.
lib avant_testing_status {
  fun avant_test_fail
}

// File and process helpers in runtime/avant_io.c (D140). Internal.
lib avant_testing_fs {
  fun avant_fs_chmod_x(path: String): Int
  fun avant_process_run_split(path: String, args: Array(String), out: String, err: String): Int
}

fn testing_write(s: String) {
  line = "${s}\n"
  avant_testing_io.write(1, line, line.size)
}

fn testing_slice(s: String, start: Int, stop: Int): String {
  b = buf_new()
  b.push_slice(s, start, stop)
  b.to_s
}

fn testing_has(hay: String, needle: String): Bool {
  if needle.size == 0 {
    return true
  }
  if needle.size > hay.size {
    return false
  }
  last = hay.size - needle.size
  i = 0
  while i <= last {
    if testing_slice(hay, i, i + needle.size) == needle {
      return true
    }
    i += 1
  }
  false
}

fn testing_read(path: String): String {
  if text = file_read(path) {
    return text
  }
  ""
}

// Runs bin with args, stdout and stderr to their own files, and returns
// its status (D140): no sh script. /usr/bin/env -u keeps the runner's
// listing and selection variables away from the program it starts.
fn testing_run(bin: String, args: Array(String), out_path: String, err_path: String): Int {
  wrapped: Array(String) = []
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_LIST")
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_ONLY")
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_NAMES")
  wrapped.push(bin)
  i = 0
  while i < args.size {
    wrapped.push(args[i])
    i += 1
  }
  avant_testing_fs.avant_process_run_split("/usr/bin/env", wrapped, out_path, err_path)
}

pub class Test {
  passed: Int = 0
  failed: Int = 0
  depth: Int = 0
  mode: Int = 0
  dup: Bool = false
  only: String = ""
  names_path: String = ""
  names: Array(String)
  rec_name: Array(String)
  rec_ok: Array(Int)
  rec_ms: Array(Int)
  rec_at: Int64 = 0i64

  fn initialize {
    self.passed = 0
    self.failed = 0
    self.depth = 0
    self.mode = 0
    self.dup = false
    self.only = ""
    self.names_path = ""
    self.names = []
    self.rec_name = []
    self.rec_ok = []
    self.rec_ms = []
    self.rec_at = now_ms()
    if v = env_get("AVANT_TEST_ONLY"), v.size > 0 {
      self.mode = 2
      self.only = v
    }
    if v = env_get("AVANT_TEST_LIST") {
        if v == "1" {
        self.mode = 1
      }
    }
    if self.mode == 0 {
      if v = env_get("AVANT_TEST_NAMES"), v.size > 0 {
        self.names_path = v
      }
    }
  }

  fn quiet: Bool {
    if self.mode == 1 {
      return true
    }
    if self.mode == 2 && self.depth == 0 {
      return true
    }
    false
  }

  fn record(okv: Bool, name: String) {
    now = now_ms()
    dur = 0
    if self.rec_at > 0i64 {
      dur = (now - self.rec_at).to_i
    }
    self.rec_at = now
    self.rec_name.push(name)
    if okv {
      self.rec_ok.push(1)
    } else {
      self.rec_ok.push(0)
    }
    self.rec_ms.push(dur)
  }

  fn junit_escape(s: String): String {
    b = buf_new()
    i = 0
    while i < s.size {
      c = s[i]
      if c == 38 {
        b.push_str("&amp;")
      } else if c == 60 {
        b.push_str("&lt;")
      } else if c == 62 {
        b.push_str("&gt;")
      } else if c == 34 {
        b.push_str("&quot;")
      } else if c == 39 {
        b.push_str("&apos;")
      } else {
        b.push_byte(c)
      }
      i += 1
    }
    b.to_s
  }

  fn junit_secs(ms: Int): String {
    whole = ms / 1000
    frac = ms % 1000
    fs = "${frac}"
    while fs.size < 3 {
      fs = "0${fs}"
    }
    "${whole}.${fs}"
  }

  fn write_junit {
    if self.mode == 1 {
      return
    }
    frag = ""
    if v = env_get("AVANT_JUNIT_FRAGMENT") {
      frag = v
    }
    if frag.size == 0 {
      return
    }
    if self.rec_name.size == 0 {
      return
    }
    n = self.rec_name.size
    badn = 0
    total = 0
    for i in 0..n {
      total += self.rec_ms[i]
      if self.rec_ok[i] == 0 {
        badn += 1
      }
    }
    b = buf_new()
    b.push_str("<testsuite name=\"std.testing\" tests=\"${n}\" failures=\"${badn}\" time=\"${junit_secs(total)}\">\n")
    for i in 0..n {
      b.push_str("  <testcase name=\"${junit_escape(self.rec_name[i])}\" classname=\"std.testing\" time=\"${junit_secs(self.rec_ms[i])}\"")
      if self.rec_ok[i] == 0 {
        b.push_str(">\n    <failure message=\"check failed\"/>\n  </testcase>\n")
      } else {
        b.push_str("/>\n")
      }
    }
    b.push_str("</testsuite>\n")
    _ = file_write(frag, b.to_s)
  }

  fn pass_line(name: String) {
    self.passed += 1
    record(true, name)
    testing_write("PASS ${name}")
  }

  fn fail_line(name: String) {
    self.failed += 1
    avant_testing_status.avant_test_fail()
    record(false, name)
    testing_write("FAIL ${name}")
  }

  fn note_name(name: String): Bool {
    i = 0
    while i < self.names.size {
      if self.names[i] == name {
        return true
      }
      i += 1
    }
    self.names.push(name)
    false
  }

  // A new, empty directory for the test's files (D128, Go's t.TempDir).
  // Each call makes another. They live in the program's private scratch
  // directory and are removed when the program exits.
  pub fn temp_dir: String {
    avant_testing_tmp.avant_tmp_new_dir()
  }

  pub fn check(cond: Bool, name: String): Nil {
    if self.quiet {
      return nil
    }
    if cond {
      pass_line(name)
    } else {
      fail_line(name)
    }
    nil
  }

  pub fn check_eq(got: Int, want: Int, name: String): Nil {
    if self.quiet {
      return nil
    }
    if got == want {
      pass_line(name)
    } else {
      fail_line(name)
      testing_write("  got: ${got}")
      testing_write("  want: ${want}")
    }
    nil
  }

  pub fn check_eq(got: Bool, want: Bool, name: String): Nil {
    if self.quiet {
      return nil
    }
    if got == want {
      pass_line(name)
    } else {
      fail_line(name)
      testing_write("  got: ${got}")
      testing_write("  want: ${want}")
    }
    nil
  }

  pub fn check_eq(got: String, want: String, name: String): Nil {
    if self.quiet {
      return nil
    }
    if got == want {
      pass_line(name)
    } else {
      fail_line(name)
      testing_write("  got: ${got}")
      testing_write("  want: ${want}")
    }
    nil
  }

  pub fn test(name: String, body: fn(): Nil): Nil {
    if self.mode == 1 {
      return nil
    }
    if self.mode == 2 {
      return nil
    }
    self.depth += 1
    body()
    self.depth -= 1
    nil
  }

  fn remember_parallel(name: String): Bool {
    if name.size == 0 || testing_has(name, "\n") {
      self.dup = true
      testing_write("FAIL parallel name must be one line")
      return false
    }
    if note_name(name) {
      self.dup = true
      testing_write("FAIL duplicate parallel name ${name}")
      return false
    }
    true
  }

  fn write_parallel_names() {
    if self.names_path.size == 0 {
      return
    }
    b = buf_new()
    i = 0
    while i < self.names.size {
      b.push_str(self.names[i])
      b.push_str("\n")
      i += 1
    }
    _ = file_write(self.names_path, b.to_s)
  }

  pub fn parallel(name: String, body: fn(): Nil): Nil {
    if self.mode == 1 {
      if remember_parallel(name) {
        testing_write("AVANT_PARALLEL ${name}")
      }
      return nil
    }
    if self.mode == 2 {
      if name == self.only {
        self.depth += 1
        body()
        self.depth -= 1
      }
      return nil
    }
    if self.names_path.size > 0 && remember_parallel(name) {
      write_parallel_names()
    }
    nil
  }

  pub fn golden(path: String, got: String): Nil {
    if self.quiet {
      return nil
    }
    label = "golden ${path}"
    if text = file_read(path) {
      if text == got {
        pass_line(label)
      } else {
        fail_line(label)
        testing_write("  got: ${got}")
        testing_write("  want: ${text}")
      }
    } else {
      fail_line(label)
      testing_write("  missing ${path}")
    }
    nil
  }

  pub fn run_golden(program: String, want: String): Nil {
    if self.quiet {
      return nil
    }
    label = "run_golden ${program}"
    compiler = ""
    if c = env_get("AVANT_COMPILER") {
      compiler = c
    }
    if compiler.size == 0 {
      fail_line(label)
      testing_write("  AVANT_COMPILER is not set")
      return nil
    }
    base = "${self.temp_dir}/case"
    out = "${base}.bin"
    compile_log = "${base}.compile"
    args: Array(String) = []
    args.push("compile")
    args.push(program)
    args.push(out)
    args.push("--debug")
    code = process_run_out(compiler, args, compile_log) ?? -1
    if code != 0 {
      fail_line(label)
      testing_write("  compile failed")
      testing_write(testing_read(compile_log))
      return nil
    }
    avant_testing_fs.avant_fs_chmod_x(out)
    empty: Array(String) = []
    stdout_path = "${base}.out"
    stderr_path = "${base}.err"
    run_code = testing_run(out, empty, stdout_path, stderr_path)
    got = testing_read(stdout_path)
    if want_text = file_read(want) {
      if run_code != 0 {
        fail_line(label)
        testing_write("  exit ${run_code}")
        testing_write(testing_read(stderr_path))
        return nil
      }
      if got == want_text {
        pass_line(label)
      } else {
        fail_line(label)
        testing_write("  got: ${got}")
        testing_write("  want: ${want_text}")
      }
    } else {
      fail_line(label)
      testing_write("  missing ${want}")
    }
    nil
  }

  pub fn rejects(source: String, substring: String): Nil {
    if self.quiet {
      return nil
    }
    label = "rejects ${source}"
    compiler = ""
    if c = env_get("AVANT_COMPILER") {
      compiler = c
    }
    if compiler.size == 0 {
      fail_line(label)
      testing_write("  AVANT_COMPILER is not set")
      return nil
    }
    base = "${self.temp_dir}/case"
    out = "${base}.bin"
    stdout_path = "${base}.out"
    stderr_path = "${base}.err"
    args: Array(String) = []
    args.push("compile")
    args.push(source)
    args.push(out)
    args.push("--debug")
    code = testing_run(compiler, args, stdout_path, stderr_path)
    err = testing_read(stderr_path)
    if code == 0 {
      fail_line(label)
      testing_write("  compiled successfully")
      return nil
    }
    if testing_has(err, substring) {
      pass_line(label)
    } else {
      fail_line(label)
      testing_write("  diagnostic did not contain ${substring}")
      testing_write(err)
    }
    nil
  }

  pub fn finish: Int {
    write_junit()
    if self.mode == 1 {
      if self.dup {
        return 1
      }
      return 0
    }
    testing_write("${self.failed} failed, ${self.passed} passed")
    if self.failed > 0 || self.dup {
      return 1
    }
    0
  }
}
