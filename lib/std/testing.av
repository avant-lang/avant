import std.fs
import std.process

// The report's lines (runtime/avant_io.c, avant_test_write): all of a
// line to standard output, or the process stops with the stream and the
// reason, status 1, as `puts` does (before, a raw write(2) whose
// result was ignored).
lib avant_testing_io {
  fun avant_test_write(buf: String, count: Int)
}

lib avant_testing_tmp {
  fun avant_tmp_new_dir: String
}

// A failed check fails the process (runtime/avant_io.c): if the
// program would exit 0, it exits 1.
lib avant_testing_status {
  fun avant_test_fail
}

// File and process helpers in runtime/avant_io.c. Internal.
lib avant_testing_fs {
  fun avant_fs_chmod_x(path: String): Int
  fun avant_process_run_split(path: String, args: Array(String), out: String, err: String): Int
  fun avant_process_run_split_env(path: String, args: Array(String), env: Array(String), out: String, err: String): Int
}

// The length of the character XML 1.0 can carry that starts at byte i
// of s, or 0: tab, line feed, carriage return and UTF-8 characters from
// U+0020 on, except the surrogates, U+FFFE and U+FFFF. Every other byte
// (a control character such as a terminal colour's escape, a byte that
// is not UTF-8) is written as \xNN.
fn testing_xml_char_len(s: String, i: Int): Int {
  c = s[i]
  if c < 128 {
    if c >= 32 || c == 9 || c == 10 || c == 13 {
      return 1
    }
    return 0
  }
  n = 0
  lo = 128
  hi = 191
  if c >= 194 && c <= 223 {
    n = 2
  } else if c >= 224 && c <= 239 {
    n = 3
    if c == 224 {
      lo = 160
    } else if c == 237 {
      hi = 159
    }
  } else if c >= 240 && c <= 244 {
    n = 4
    if c == 240 {
      lo = 144
    } else if c == 244 {
      hi = 143
    }
  }
  if n == 0 || i + n > s.size {
    return 0
  }
  if s[i + 1] < lo || s[i + 1] > hi {
    return 0
  }
  for k in 2..n {
    if s[i + k] < 128 || s[i + k] > 191 {
      return 0
    }
  }
  if c == 239 && s[i + 1] == 191 && (s[i + 2] == 190 || s[i + 2] == 191) {
    return 0
  }
  n
}

fn testing_write(s: String) {
  line = "${s}\n"
  avant_testing_io.avant_test_write(line, line.size)
}

fn testing_read(path: String): String {
  if text = fs.read(path) {
    return text
  }
  ""
}

// Runs bin with args, stdout and stderr to their own files, and returns
// its status: no sh script. The runner's listing, selection and results
// variables are unset for the program it starts. A bin that names a path
// is started directly (env(1) would take a path holding '=' for an
// assignment and run nothing); a bare name is looked up on PATH by
// /usr/bin/env.
fn testing_run(bin: String, args: Array(String), out_path: String, err_path: String): Int {
  if bin.contains("/") {
    unset = ["AVANT_TEST_LIST", "AVANT_TEST_ONLY", "AVANT_TEST_NAMES", "AVANT_TEST_FILTER", "AVANT_TEST_MATCHES", "AVANT_TEST_RESULTS"]
    return avant_testing_fs.avant_process_run_split_env(bin, args, unset, out_path, err_path)
  }
  wrapped: Array(String) = []
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_RESULTS")
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_LIST")
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_ONLY")
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_NAMES")
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_FILTER")
  wrapped.push("-u")
  wrapped.push("AVANT_TEST_MATCHES")
  wrapped.push(bin)
  wrapped.concat(args)
  avant_testing_fs.avant_process_run_split("/usr/bin/env", wrapped, out_path, err_path)
}

pub class Test {
  passed: Int = 0
  failed: Int = 0
  depth: Int = 0
  mode: Int = 0
  dup: Bool = false
  lost: Bool = false
  only: String = ""
  names_path: String = ""
  filter: String = ""
  matches_path: String = ""
  matched: Int = 0
  names: Array(String)
  rec_name: Array(String)
  rec_ok: Array(Int)
  rec_ms: Array(Int)
  rec_at: Int = 0

  fn initialize {
    self.passed = 0
    self.failed = 0
    self.depth = 0
    self.mode = 0
    self.dup = false
    self.lost = false
    self.only = ""
    self.names_path = ""
    self.filter = ""
    self.matches_path = ""
    self.matched = 0
    self.names = []
    self.rec_name = []
    self.rec_ok = []
    self.rec_ms = []
    self.rec_at = now_ms()
    if v = process.env("AVANT_TEST_ONLY"), v.size > 0 {
      self.mode = 2
      self.only = v
    }
    if v = process.env("AVANT_TEST_LIST") {
      if v == "1" {
        self.mode = 1
      }
    }
    if self.mode == 0 {
      if v = process.env("AVANT_TEST_NAMES"), v.size > 0 {
        self.names_path = v
      }
      // `avant test --name PATTERN`: only the checks, `test` bodies and
      // `parallel` bodies whose names contain PATTERN run; a selected
      // body runs whole. The runner reads the file AVANT_TEST_MATCHES
      // names to tell a file where nothing matched.
      if v = process.env("AVANT_TEST_FILTER"), v.size > 0 {
        self.filter = v
      }
      if v = process.env("AVANT_TEST_MATCHES"), v.size > 0 {
        self.matches_path = v
      }
    }
  }

  // Whether `--name` selects what is named `name`: always inside a
  // selected body (depth > 0) and without a filter; at the top level when
  // the name contains the pattern, which counts as a match.
  fn picked(name: String): Bool {
    if self.filter.size == 0 || self.depth > 0 {
      return true
    }
    if name.contains(self.filter) {
      self.matched += 1
      return true
    }
    false
  }

  fn quiet: Bool {
    if self.mode == 1 {
      return true
    }
    if self.mode == 2 && self.depth == 0 {
      return true
    }
    false
  }

  fn record(okv: Bool, name: String) {
    now = now_ms()
    dur = 0
    if self.rec_at > 0 {
      dur = (now - self.rec_at).to_i()
    }
    self.rec_at = now
    self.rec_name.push(name)
    if okv {
      self.rec_ok.push(1)
    } else {
      self.rec_ok.push(0)
    }
    self.rec_ms.push(dur)
  }

  fn junit_escape(s: String): String {
    b = Buf.new()
    i = 0
    while i < s.size {
      c = s[i]
      n = testing_xml_char_len(s, i)
      if n == 0 {
        b.push_str("\\x")
        b.push_byte("0123456789abcdef"[c / 16])
        b.push_byte("0123456789abcdef"[c % 16])
      } else if n > 1 {
        b.push_slice(s, i, i + n)
        i += n - 1
      } else if c == 38 {
        b.push_str("&amp;")
      } else if c == 60 {
        b.push_str("&lt;")
      } else if c == 62 {
        b.push_str("&gt;")
      } else if c == 34 {
        b.push_str("&quot;")
      } else if c == 39 {
        b.push_str("&apos;")
      } else {
        b.push_byte(c)
      }
      i += 1
    }
    b.to_s()
  }

  fn junit_secs(ms: Int): String {
    whole = ms / 1000
    frac = ms % 1000
    fs = "${frac}"
    while fs.size < 3 {
      fs = "0${fs}"
    }
    "${whole}.${fs}"
  }

  fn write_junit {
    if self.mode == 1 {
      return
    }
    frag = ""
    if v = process.env("AVANT_JUNIT_FRAGMENT") {
      frag = v
    }
    if frag.size == 0 {
      return
    }
    if self.rec_name.size == 0 {
      return
    }
    n = self.rec_name.size
    badn = 0
    total = 0
    for i in 0..n {
      total += self.rec_ms[i]
      if self.rec_ok[i] == 0 {
        badn += 1
      }
    }
    b = Buf.new()
    b.push_str("<testsuite name=\"std.testing\" tests=\"${n}\" failures=\"${badn}\" time=\"${junit_secs(total)}\">\n")
    for i in 0..n {
      b.push_str("  <testcase name=\"${junit_escape(self.rec_name[i])}\" classname=\"std.testing\" time=\"${junit_secs(self.rec_ms[i])}\"")
      if self.rec_ok[i] == 0 {
        b.push_str(">\n    <failure message=\"check failed\"/>\n  </testcase>\n")
      } else {
        b.push_str("/>\n")
      }
    }
    b.push_str("</testsuite>\n")
    // The runner builds its report from these fragments: one that is
    // not written is a report without this process's checks, so the
    // run fails and says why (the failure was
    // dropped).
    _ = fs.write(frag, b.to_s()) else e {
      report_lost("the JUnit fragment was not written: ${e.message}")
      return
    }
  }

  // A write the runner depends on failed: the line, once per message
  // kind, and a failed run (`finish` returns 1, and the process cannot
  // exit 0).
  fn report_lost(what: String) {
    if !self.lost {
      testing_write("FAIL ${what}")
    }
    self.lost = true
    avant_testing_status.avant_test_fail()
  }

  fn pass_line(name: String) {
    self.passed += 1
    record(true, name)
    testing_write("PASS ${name}")
  }

  fn fail_line(name: String) {
    self.failed += 1
    avant_testing_status.avant_test_fail()
    record(false, name)
    testing_write("FAIL ${name}")
  }

  fn note_name(name: String): Bool {
    i = 0
    while i < self.names.size {
      if self.names[i] == name {
        return true
      }
      i += 1
    }
    self.names.push(name)
    false
  }

  // A new, empty directory for the test's files (Go's t.TempDir). Each
  // call makes another. They live in the program's private scratch
  // directory and are removed when the program exits.
  pub fn temp_dir: String {
    avant_testing_tmp.avant_tmp_new_dir()
  }

  pub fn check(cond: Bool, name: String): Nil {
    if self.quiet() || !picked(name) {
      return nil
    }
    if cond {
      pass_line(name)
    } else {
      fail_line(name)
    }
    nil
  }

  // got == want by the type's own ==; on failure both are printed as
  // interpolation prints them, so T is any type that has == and a text.
  pub fn check_eq(got: T, want: T, name: String): Nil {
    if self.quiet() || !picked(name) {
      return nil
    }
    if got == want {
      pass_line(name)
    } else {
      fail_line(name)
      testing_write("  got: ${got}")
      testing_write("  want: ${want}")
    }
    nil
  }

  pub fn test(name: String, body: fn(): Nil): Nil {
    if self.mode == 1 {
      return nil
    }
    if self.mode == 2 || !picked(name) {
      return nil
    }
    self.depth += 1
    body()
    self.depth -= 1
    nil
  }

  fn remember_parallel(name: String): Bool {
    if name.size == 0 || name.contains("\n") {
      self.dup = true
      testing_write("FAIL parallel name must be one line")
      return false
    }
    if note_name(name) {
      self.dup = true
      testing_write("FAIL duplicate parallel name ${name}")
      return false
    }
    true
  }

  fn write_parallel_names {
    if self.names_path.size == 0 {
      return
    }
    b = Buf.new()
    i = 0
    while i < self.names.size {
      b.push_str(self.names[i])
      b.push_str("\n")
      i += 1
    }
    // The runner starts the parallel bodies from this file: if it is
    // not written they never run, so the run fails and says why (the
    // failure was dropped).
    _ = fs.write(self.names_path, b.to_s()) else e {
      report_lost("the parallel names were not written, so the parallel tests cannot run: ${e.message}")
      return
    }
  }

  pub fn parallel(name: String, body: fn(): Nil): Nil {
    if self.mode == 1 {
      if remember_parallel(name) {
        testing_write("AVANT_PARALLEL ${name}")
      }
      return nil
    }
    if self.mode == 2 {
      if name == self.only {
        self.depth += 1
        body()
        self.depth -= 1
      }
      return nil
    }
    if !picked(name) {
      return nil
    }
    if self.names_path.size > 0 {
      if remember_parallel(name) {
        write_parallel_names()
      }
      return nil
    }
    // No runner is listening (`avant run`, or the compiled binary run
    // directly): nothing would start this body in a process of its
    // own, so it runs here, in source order. Before, it was skipped
    // without a word and `finish` reported the serial checks alone
    // with status 0. The names are checked as the runner checks
    // them.
    if remember_parallel(name) {
      self.depth += 1
      body()
      self.depth -= 1
    }
    nil
  }

  pub fn golden(path: String, got: String): Nil {
    label = "golden ${path}"
    if self.quiet() || !picked(label) {
      return nil
    }
    if text = fs.read(path) {
      if text == got {
        pass_line(label)
      } else {
        fail_line(label)
        testing_write("  got: ${got}")
        testing_write("  want: ${text}")
      }
    } else {
      fail_line(label)
      testing_write("  missing ${path}")
    }
    nil
  }

  pub fn run_golden(program: String, want: String): Nil {
    label = "run_golden ${program}"
    if self.quiet() || !picked(label) {
      return nil
    }
    compiler = ""
    if c = process.env("AVANT_COMPILER") {
      compiler = c
    }
    if compiler.size == 0 {
      fail_line(label)
      testing_write("  AVANT_COMPILER is not set")
      return nil
    }
    base = "${self.temp_dir()}/case"
    out = "${base}.bin"
    compile_log = "${base}.compile"
    args: Array(String) = []
    args.push("compile")
    args.push(program)
    args.push(out)
    args.push("--debug")
    code = run_out(compiler, args, compile_log) ?? -1
    if code != 0 {
      fail_line(label)
      testing_write("  compile failed")
      testing_write(testing_read(compile_log))
      return nil
    }
    avant_testing_fs.avant_fs_chmod_x(out)
    empty: Array(String) = []
    stdout_path = "${base}.out"
    stderr_path = "${base}.err"
    run_code = testing_run(out, empty, stdout_path, stderr_path)
    got = testing_read(stdout_path)
    if want_text = fs.read(want) {
      if run_code != 0 {
        fail_line(label)
        testing_write("  exit ${run_code}")
        testing_write(testing_read(stderr_path))
        return nil
      }
      if got == want_text {
        pass_line(label)
      } else {
        fail_line(label)
        testing_write("  got: ${got}")
        testing_write("  want: ${want_text}")
      }
    } else {
      fail_line(label)
      testing_write("  missing ${want}")
    }
    nil
  }

  pub fn rejects(source: String, substring: String): Nil {
    label = "rejects ${source}"
    if self.quiet() || !picked(label) {
      return nil
    }
    compiler = ""
    if c = process.env("AVANT_COMPILER") {
      compiler = c
    }
    if compiler.size == 0 {
      fail_line(label)
      testing_write("  AVANT_COMPILER is not set")
      return nil
    }
    base = "${self.temp_dir()}/case"
    out = "${base}.bin"
    stdout_path = "${base}.out"
    stderr_path = "${base}.err"
    args: Array(String) = []
    args.push("compile")
    args.push(source)
    args.push(out)
    args.push("--debug")
    code = testing_run(compiler, args, stdout_path, stderr_path)
    err = testing_read(stderr_path)
    if code == 0 {
      fail_line(label)
      testing_write("  compiled successfully")
      return nil
    }
    if err.contains(substring) {
      pass_line(label)
    } else {
      fail_line(label)
      testing_write("  diagnostic did not contain ${substring}")
      testing_write(err)
    }
    nil
  }

  pub fn finish: Int {
    write_junit()
    if self.matches_path.size > 0 && self.matched > 0 {
      switch fs.write(self.matches_path, "${self.matched}\n") {
        case Int { }
        case e: IoError { report_lost("the --name matches were not written: ${e.message}") }
      }
    }
    if self.mode == 1 {
      if self.dup {
        return 1
      }
      return 0
    }
    testing_write("${self.failed} failed, ${self.passed} passed")
    if self.failed > 0 || self.dup || self.lost {
      return 1
    }
    0
  }
}

// Runs the program with its stdout and stderr both written to the file
// out, in the order it wrote them (through sh's redirection, which is
// what the file then holds): the exit status, or the failure to start sh.
fn run_out(program: String, args: Array(String), out: String): Int | ProcessError {
  sh_args = ["-c", "out=$1; shift; exec \"$@\" > \"$out\" 2>&1", "sh", out, program]
  for a in args {
    sh_args.push(a)
  }
  process.run("/bin/sh", sh_args)
}
