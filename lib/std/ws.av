// std.ws: the WebSocket client. `ws.connect(url)` opens a connection to
// a ws:// URL (no TLS: a wss:// URL is an HttpError, never a silent
// downgrade); the connection is std.http's WsConnection, and a server's
// side is std.http's (server.ws). See std.http's WsConnection for its
// calls.
import std.http

// Connects and completes the handshake within timeout_ms milliseconds.
pub fn connect(url: String, timeout_ms: Int = 10000): http.WsConnection | http.HttpError {
  http.ws_connect(url, timeout_ms)
}
