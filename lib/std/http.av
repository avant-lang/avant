lib httpc {
  fun avant_http_take_status: Int
  fun avant_http_header_count(data: Bytes): Int
  fun avant_http_header_has(data: Bytes, name: String): Int
  fun avant_http_header_at(data: Bytes, name: String, index: Int): String
  fun avant_http_header_name_at(data: Bytes, index: Int): String
  fun avant_http_header_value_at(data: Bytes, index: Int): String
  fun avant_http_req_method(req: Ptr(Void)): String
  fun avant_http_req_target(req: Ptr(Void)): String
  fun avant_http_req_body(req: Ptr(Void)): Bytes
  fun avant_http_req_headers(req: Ptr(Void)): Bytes
  fun avant_http_req_respond(req: Ptr(Void), status: Int, head: String, body: Bytes)
  fun avant_http_listen(host: String, port: Int, max_body: Int, loops: Int, max_message: Int): Ptr(Void)
  fun avant_http_port(srv: Ptr(Void)): Int
  fun avant_http_serve(srv: Ptr(Void), state: HttpState, cb: fn(HttpState, Ptr(Void)), ws_cb: fn(HttpState, Ptr(Void))): Int
  fun avant_http_close(srv: Ptr(Void)): Int
  fun avant_http_route_while_serving(what: String)
  fun avant_http_req_is_ws(req: Ptr(Void)): Int
  fun avant_http_req_ws_upgrade(req: Ptr(Void), route: Int): Int
  fun avant_http_req_ws_id(req: Ptr(Void)): Int
  fun avant_http_req_ws_conn(req: Ptr(Void)): Ptr(Void)
  fun avant_ws_event_conn(ev: Ptr(Void)): Ptr(Void)
  fun avant_ws_send_text_direct(handle: Ptr(Void), id: Int, data: String): Int
  fun avant_ws_send_text_bytes_direct(handle: Ptr(Void), id: Int, data: Bytes): Int
  fun avant_ws_send_bytes_direct(handle: Ptr(Void), id: Int, data: Bytes): Int
  fun avant_ws_close_direct(handle: Ptr(Void), id: Int, code: Int, reason: String): Int
  fun avant_ws_event_kind(ev: Ptr(Void)): Int
  fun avant_ws_event_conn_id(ev: Ptr(Void)): Int
  fun avant_ws_event_route(ev: Ptr(Void)): Int
  fun avant_ws_event_path(ev: Ptr(Void)): String
  fun avant_ws_event_is_text(ev: Ptr(Void)): Int
  fun avant_ws_event_data(ev: Ptr(Void)): Bytes
  fun avant_ws_event_code(ev: Ptr(Void)): Int
  fun avant_ws_event_reason(ev: Ptr(Void)): String
  fun avant_ws_send_text_by_id(id: Int, data: String): Int
  fun avant_ws_send_text_bytes_by_id(id: Int, data: Bytes): Int
  fun avant_ws_send_bytes_by_id(id: Int, data: Bytes): Int
  fun avant_ws_close_by_id(id: Int, code: Int, reason: String): Int
  fun avant_ws_client_connect(host: String, port: Int, target: String, key: String, timeout_ms: Int): Int
  fun avant_ws_client_recv(id: Int, timeout_ms: Int): Bytes
  fun avant_ws_client_last_is_text: Int
  fun avant_ws_client_close_code(id: Int): Int
  fun avant_ws_client_send_text(id: Int, data: String): Int
  fun avant_ws_client_send_bytes(id: Int, data: Bytes): Int
  fun avant_ws_client_close(id: Int): Int
  fun avant_ws_client_key: String
  fun avant_http_fetch(host: String, port: Int, request: String, timeout_ms: Int): Bytes
  fun avant_http_resp_status(raw: Bytes): Int
  fun avant_http_resp_headers(raw: Bytes): Bytes
  fun avant_http_resp_body(raw: Bytes): Bytes
}

pub class HttpError: Error {
  pub message: String

  fn initialize(message: String) {
    self.message = message
  }
}

pub struct Header {
  pub name: String
  pub value: String
}

// The headers of a received message. This is one collector buffer the
// C side builds at parse time: a small offset table over the raw
// header block, so reading a header copies only that value. The set is
// immutable, keeps wire order and duplicates, and lookup never touches
// the process-wide Hash. Look headers up by name (case-insensitive,
// first value wins); `get_all` is for the rare repeated header.
pub struct Headers {
  data: Bytes

  pub fn count: Int {
    httpc.avant_http_header_count(self.data)
  }

  pub fn has(name: String): Bool {
    httpc.avant_http_header_has(self.data, name) != 0
  }

  pub fn get(name: String): String? {
    v = httpc.avant_http_header_at(self.data, name, 0)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn get_all(name: String): Array(String) {
    out: Array(String) = []
    i = 0
    while true {
      v = httpc.avant_http_header_at(self.data, name, i)
      if httpc.avant_http_take_status() != 0 {
        return out
      }
      out.push(v)
      i += 1
    }
    out
  }

  pub fn name_at(index: Int): String? {
    v = httpc.avant_http_header_name_at(self.data, index)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn value_at(index: Int): String? {
    v = httpc.avant_http_header_value_at(self.data, index)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }
}

fn empty_headers: Headers {
  Headers { data: "".bytes }
}

// A received request. `method`, `path` and `body` are values copied out
// of the socket buffer before the handler runs; `query` is the raw
// query string without the `?`, or nil when the target has none.
pub struct Request {
  pub method: String
  pub path: String
  pub query: String?
  pub headers: Headers
  pub body: Bytes
}

// A response, in both directions: a handler returns one, and the
// client returns one. `headers` is the received header set (empty for
// a response built in code); headers set with `header` are kept
// separately until the response is written. Content-Length and
// Connection are managed by the server and the client; setting them
// with `header` has no effect.
pub struct Response {
  pub status: Int
  pub headers: Headers
  pub head: String
  pub body: Bytes

  pub fn self.text(body: String, status: Int = 200): Response {
    Response { status: status, headers: empty_headers(), head: "Content-Type: text/plain; charset=utf-8\r\n", body: body.bytes }
  }

  pub fn self.bytes(body: Bytes, status: Int = 200): Response {
    Response { status: status, headers: empty_headers(), head: "Content-Type: application/octet-stream\r\n", body: body }
  }

  pub fn header(name: String, value: String): Response {
    if is_managed_header(name) {
      return self
    }
    Response { status: self.status, headers: self.headers, head: "${self.head}${name}: ${value}\r\n", body: self.body }
  }

  fn head_block: String {
    self.head
  }
}

fn is_managed_header(name: String): Bool {
  name_is(name, "content-length") || name_is(name, "connection")
}

fn name_is(name: String, lit: String): Bool {
  if name.size != lit.size {
    return false
  }
  for i in 0..name.size {
    a = name[i]
    b = lit[i]
    if a >= 65 && a <= 90 {
      a += 32
    }
    if a != b {
      return false
    }
  }
  true
}

// One WebSocket message. `body` is the one collector copy of the
// payload; `text` converts it on access, so a handler that echoes or
// forwards the message never pays for a string it does not read. A
// text message was validated as UTF-8 by the runtime before dispatch;
// `text` is nil for a binary message.
pub struct WsMessage {
  pub is_text: Bool
  pub body: Bytes

  pub fn is_binary: Bool {
    !self.is_text
  }

  pub fn text: String? {
    if self.is_text {
      return String.from_utf8(self.body)
    }
    nil
  }
}

// The crossable half of a WsConn: a bare connection id, the one field
// that may cross a `spawn` boundary (D35 copies scalars, not the
// pointer a WsConn also holds). Hand work to a task as a sender:
//
//   sender = conn.sender
//   spawn { sender.send_text(answer) }
//
// Sends through a sender find the connection by id in the runtime and
// behave exactly as sends through the WsConn.
pub struct WsSender {
  id: Int

  pub fn send_text(text: String): Bool {
    httpc.avant_ws_send_text_by_id(self.id, text) != 0
  }

  pub fn send_bytes(data: Bytes): Bool {
    httpc.avant_ws_send_bytes_by_id(self.id, data) != 0
  }

  pub fn send_message(msg: WsMessage): Bool {
    if msg.is_text {
      return httpc.avant_ws_send_text_bytes_by_id(self.id, msg.body) != 0
    }
    httpc.avant_ws_send_bytes_by_id(self.id, msg.body) != 0
  }

  pub fn close(code: Int = 1000, reason: String = ""): Bool {
    httpc.avant_ws_close_by_id(self.id, code, reason) != 0
  }
}

// A live WebSocket connection. The value is the connection's id and
// the address of its record in the runtime. The record is never freed
// and the runtime checks the id against it on every operation, so a
// value kept after its connection closed, or after `serve` returned,
// answers false and touches nothing else. The value itself stays on
// the loop thread (a raw pointer may not cross a `spawn` boundary);
// `sender` above is the half that may cross.
// `send_text` and `send_bytes` return false when the connection is
// closed or its bounded send queue is full. They may be called from
// any task: a send from a task other than the connection's loop thread
// is queued in C (1 MiB per connection) and written in order when the
// loop wakes. Ping is answered by the runtime, never delivered here;
// the close handshake is the runtime's, with the peer's code and
// reason delivered to the `websocket_close` handler.
pub struct WsConn {
  id: Int
  handle: Ptr(Void)

  pub fn sender: WsSender {
    WsSender { id: self.id }
  }

  pub fn send_text(text: String): Bool {
    httpc.avant_ws_send_text_direct(self.handle, self.id, text) != 0
  }

  pub fn send_bytes(data: Bytes): Bool {
    httpc.avant_ws_send_bytes_direct(self.handle, self.id, data) != 0
  }

  // Sends a received message onward with its kind preserved, without
  // materializing a string for a text message.
  pub fn send_message(msg: WsMessage): Bool {
    if msg.is_text {
      return httpc.avant_ws_send_text_bytes_direct(self.handle, self.id, msg.body) != 0
    }
    httpc.avant_ws_send_bytes_direct(self.handle, self.id, msg.body) != 0
  }

  pub fn close(code: Int = 1000, reason: String = ""): Bool {
    httpc.avant_ws_close_direct(self.handle, self.id, code, reason) != 0
  }
}

struct Route {
  method: String
  path: String
  handler: fn(Request): Response
}

// next is the index of the next route on the same path, -1 after the
// last: a message runs every route of its path, in the order they were
// registered, without comparing a path.
struct WsRoute {
  path: String
  handler: fn(WsConn, WsMessage)
  next: Int
}

struct WsOpenRoute {
  path: String
  handler: fn(WsConn)
}

struct WsCloseRoute {
  path: String
  handler: fn(WsConn, Int, String)
}

// The mutable half of a Server, held by reference so every copy of the
// Server value registers routes on, closes, and serves the same
// server. Not public: programs meet Server, not this.
class HttpState {
  routes: Array(Route) = []
  ws_routes: Array(WsRoute) = []
  ws_open_routes: Array(WsOpenRoute) = []
  ws_close_routes: Array(WsCloseRoute) = []
  closed: Bool = false
  serving: Bool = false
  bound_port: Int = 0

  // The route tables are read by every loop thread while `serve` runs,
  // with no lock, so a route added then is pushed onto an array the
  // loops are reading (Stage 29 W-FIX1f, O594: routes answered by
  // another route's handler, and crashes). Every route method checks
  // here, on the registering thread, and traps while serving: the
  // README's rule, register every route before `serve`. Nothing is
  // added to the request or message path.
  fn add(method: String, path: String, handler: fn(Request): Response) {
    if self.serving {
      httpc.avant_http_route_while_serving("route ${method} ${path}")
    }
    self.routes.push(Route { method: method, path: path, handler: handler })
  }

  fn add_ws(path: String, handler: fn(WsConn, WsMessage)) {
    if self.serving {
      httpc.avant_http_route_while_serving("websocket route ${path}")
    }
    k = self.ws_routes.size
    i = self.first_ws_route(path)
    if i >= 0 {
      while self.ws_routes[i].next >= 0 {
        i = self.ws_routes[i].next
      }
      self.ws_routes[i].next = k
    }
    self.ws_routes.push(WsRoute { path: path, handler: handler, next: -1 })
  }

  // The index of the first message route on path, -1 when it has none.
  fn first_ws_route(path: String): Int {
    i = 0
    while i < self.ws_routes.size {
      if self.ws_routes[i].path == path {
        return i
      }
      i += 1
    }
    -1
  }

  fn add_ws_open(path: String, handler: fn(WsConn)) {
    if self.serving {
      httpc.avant_http_route_while_serving("websocket_open route ${path}")
    }
    self.ws_open_routes.push(WsOpenRoute { path: path, handler: handler })
  }

  fn add_ws_close(path: String, handler: fn(WsConn, Int, String)) {
    if self.serving {
      httpc.avant_http_route_while_serving("websocket_close route ${path}")
    }
    self.ws_close_routes.push(WsCloseRoute { path: path, handler: handler })
  }

  fn has_ws_route(path: String): Bool {
    i = 0
    while i < self.ws_routes.size {
      if self.ws_routes[i].path == path {
        return true
      }
      i += 1
    }
    i = 0
    while i < self.ws_open_routes.size {
      if self.ws_open_routes[i].path == path {
        return true
      }
      i += 1
    }
    i = 0
    while i < self.ws_close_routes.size {
      if self.ws_close_routes[i].path == path {
        return true
      }
      i += 1
    }
    false
  }

  fn ws_open_dispatch(path: String, conn: WsConn) {
    i = 0
    while i < self.ws_open_routes.size {
      r = self.ws_open_routes[i]
      if r.path == path {
        (r.handler)(conn)
      }
      i += 1
    }
  }



  fn dispatch(req: Request): Response {
    i = 0
    while i < self.routes.size {
      r = self.routes[i]
      if r.method == req.method && r.path == req.path {
        return (r.handler)(req)
      }
      i += 1
    }
    Response.text("not found", 404)
  }
}

// The C loop calls this named function once per complete request. It
// is a plain function, not a closure: the server state arrives as its
// first argument, in the shape the C callback rule allows.
fn http_dispatch(state: HttpState, raw: Ptr(Void)) {
  target = httpc.avant_http_req_target(raw)
  path = target
  query: String? = nil
  q = 0
  while q < target.size {
    if target[q] == 63 {
      path = str_slice(target, 0, q)
      query = str_slice(target, q + 1, target.size)
      q = target.size
    } else {
      q += 1
    }
  }
  // A well-formed WebSocket handshake (validated in C) upgrades here
  // when a websocket route owns the path; without one it falls through
  // to ordinary routing and its 404. The connection's C record keeps
  // its path's first message route (O564: the loop threads share no
  // table of connections; the route tables are only read while serving).
  if httpc.avant_http_req_is_ws(raw) != 0 && state.has_ws_route(path) {
    if httpc.avant_http_req_ws_upgrade(raw, state.first_ws_route(path)) != 0 {
      wid = httpc.avant_http_req_ws_id(raw)
      whandle = httpc.avant_http_req_ws_conn(raw)
      conn = WsConn { id: wid, handle: whandle }
      state.ws_open_dispatch(path, conn)
    }
    return
  }
  // Without a query the path is the target; the slice above is the
  // only copy, so a plain request allocates no second string here.
  method = httpc.avant_http_req_method(raw)
  raw_headers = httpc.avant_http_req_headers(raw)
  req_body = httpc.avant_http_req_body(raw)
  req = Request {
    method: method,
    path: path,
    query: query,
    headers: Headers { data: raw_headers },
    body: req_body
  }
  resp = state.dispatch(req)
  // The response head and body travel into C as raw heap pointers; the
  // respond entry is no safepoint, so no thread collects while it writes
  // (Stage 28 W17a: until the handshake a defer region here and a second
  // one in the entry kept other loop threads' collections off, O111).
  httpc.avant_http_req_respond(raw, resp.status, resp.head_block, resp.body)
}

// The C loop calls this named function once per WebSocket message and
// once per connection close. Open is dispatched from http_dispatch at
// upgrade time instead. The first getter is the collector's heap-goal
// boundary for the message path, in the avant_http_req_target position.
fn ws_dispatch(state: HttpState, raw: Ptr(Void)) {
  kind = httpc.avant_ws_event_kind(raw)
  wid = httpc.avant_ws_event_conn_id(raw)
  whandle = httpc.avant_ws_event_conn(raw)
  conn = WsConn { id: wid, handle: whandle }
  if kind == 1 {
    // The route walk is inlined here rather than called as an
    // HttpState method: each Avant call is a collector frame entry, and
    // this path runs once per message. The first route comes from the
    // connection's own C record (set at the upgrade, O564), the rest by
    // each route's next: no path is compared.
    i = httpc.avant_ws_event_route(raw)
    if i >= 0 {
      is_text = httpc.avant_ws_event_is_text(raw) != 0
      data = httpc.avant_ws_event_data(raw)
      msg = WsMessage { is_text: is_text, body: data }
      while i >= 0 {
        r = state.ws_routes[i]
        (r.handler)(conn, msg)
        i = r.next
      }
    }
    return
  }
  if kind == 2 {
    path = httpc.avant_ws_event_path(raw)
    code = httpc.avant_ws_event_code(raw)
    reason = httpc.avant_ws_event_reason(raw)
    for rc in state.ws_close_routes {
      if rc.path == path {
        (rc.handler)(conn, code, reason)
      }
    }
  }
}

// A cleartext HTTP/1.1 server on uSockets with picohttpparser.
// Handlers must not block the event loop: a handler that blocks (a
// long computation, a blocking client call, a sleep) stalls every
// connection on the server. Hand CPU work to `spawn` and answer from
// there, or keep handlers to request-shaped work. Routes match exact
// paths only; there is no pattern router, no middleware, and no
// streaming: a request body is buffered whole, up to the server's
// body limit (1 MiB by default, set at listen time), and a larger
// body is answered 413 and the connection closed. A chunked request
// body is answered 411 in this wave. HTTP/1.1 connections are kept
// alive unless the client asks to close them (HTTP/1.0 the reverse),
// and pipelined requests are answered in order. There is no TLS: an
// `https` claim would be a lie, here and in the client below.
pub struct Server {
  handle: Ptr(Void)
  state: HttpState

  // The port the server is bound to. With port 0 at listen time this
  // is the ephemeral port the OS chose.
  pub fn port: Int {
    self.state.bound_port
  }

  pub fn get(path: String, handler: fn(Request): Response): Server {
    self.state.add("GET", path, handler)
    self
  }

  pub fn post(path: String, handler: fn(Request): Response): Server {
    self.state.add("POST", path, handler)
    self
  }

  pub fn put(path: String, handler: fn(Request): Response): Server {
    self.state.add("PUT", path, handler)
    self
  }

  pub fn delete(path: String, handler: fn(Request): Response): Server {
    self.state.add("DELETE", path, handler)
    self
  }

  pub fn patch(path: String, handler: fn(Request): Response): Server {
    self.state.add("PATCH", path, handler)
    self
  }

  pub fn route(method: String, path: String, handler: fn(Request): Response): Server {
    self.state.add(method, path, handler)
    self
  }

  // Registers a WebSocket route on an exact path. The handler runs on
  // a loop thread once per complete message (fragmentation is the
  // runtime's) and must not block the loop, in the rule for HTTP
  // handlers above. A message larger than the server's `max_message`
  // (1 MiB by default, set at listen time) is closed 1009 by the
  // runtime without reaching the handler.
  pub fn websocket(path: String, handler: fn(WsConn, WsMessage)): Server {
    self.state.add_ws(path, handler)
    self
  }

  pub fn websocket_open(path: String, handler: fn(WsConn)): Server {
    self.state.add_ws_open(path, handler)
    self
  }

  // The peer's close code and reason (1006 when the connection dropped
  // without a close frame). Runs once per connection.
  pub fn websocket_close(path: String, handler: fn(WsConn, Int, String)): Server {
    self.state.add_ws_close(path, handler)
    self
  }

  // Runs the event loop until `close` is called from another task.
  // Register every route before serving: the route tables are read by
  // the loop threads while `serve` blocks, and a route method called
  // while serving (from a handler) traps. Returns when the loop has
  // drained, after which the listen port is released.
  pub fn serve {
    if self.state.closed {
      return
    }
    self.state.serving = true
    pin(self.state) {
      httpc.avant_http_serve(self.handle, self.state, http_dispatch, ws_dispatch)
    }
    self.state.serving = false
  }

  // Stops the server: wakes the loop, closes the listen socket and
  // every open connection, and lets `serve` return. Open WebSocket
  // connections are sent a close frame with code 1001 first. Safe to
  // call more than once, and safe to call without ever serving, in
  // which case the port is released immediately. A server that is
  // never closed leaks its listen socket until the process exits;
  // there is no finalizer.
  pub fn close {
    if self.state.closed {
      return
    }
    self.state.closed = true
    httpc.avant_http_close(self.handle)
  }
}

struct UrlParts {
  host: String
  port: Int
  authority: String
  target: String
}

fn starts_with(s: String, prefix: String): Bool {
  if s.size < prefix.size {
    return false
  }
  str_slice(s, 0, prefix.size) == prefix
}

fn parse_port(text: String): Int {
  n = 0
  i = 0
  if text.size == 0 {
    return -1
  }
  while i < text.size {
    c = text[i]
    if c < 48 || c > 57 {
      return -1
    }
    n = n * 10 + (c - 48)
    if n > 65535 {
      return -1
    }
    i += 1
  }
  if n == 0 {
    return -1
  }
  n
}

// Splits an http:// URL. Returns nil for anything that is not a
// well-formed absolute http URL with a host; the caller turns that
// into an HttpError with a message.
fn http_parse_url(url: String): UrlParts? {
  rest = str_slice(url, 7, url.size)
  auth_end = rest.size
  i = 0
  while i < rest.size {
    c = rest[i]
    if c == 47 || c == 63 || c == 35 {
      auth_end = i
      i = rest.size
    } else {
      i += 1
    }
  }
  authority = str_slice(rest, 0, auth_end)
  tail = str_slice(rest, auth_end, rest.size)
  if authority.size == 0 {
    return nil
  }
  for at in 0..authority.size {
    if authority[at] == 64 {
      return nil
    }
  }
  host = authority
  port = 80
  if str_slice(authority, 0, 1) == "[" {
    close = 0
    j = 0
    while j < authority.size {
      if authority[j] == 93 {
        close = j
        j = authority.size
      } else {
        j += 1
      }
    }
    if close == 0 {
      return nil
    }
    host = str_slice(authority, 1, close)
    if close + 1 < authority.size {
      if authority[close + 1] != 58 {
        return nil
      }
      port = parse_port(str_slice(authority, close + 2, authority.size))
      if port < 0 {
        return nil
      }
    }
  } else {
    colon = -1
    for j in 0..authority.size {
      if authority[j] == 58 {
        colon = j
      }
    }
    if colon >= 0 {
      host = str_slice(authority, 0, colon)
      port = parse_port(str_slice(authority, colon + 1, authority.size))
      if port < 0 {
        return nil
      }
    }
  }
  if host.size == 0 {
    return nil
  }
  target = tail
  if target.size == 0 {
    target = "/"
  } else if str_slice(target, 0, 1) == "?" {
    target = "/${target}"
  }
  hash = 0
  while hash < target.size {
    if target[hash] == 35 {
      target = str_slice(target, 0, hash)
      hash = target.size
    } else {
      hash += 1
    }
  }
  UrlParts { host: host, port: port, authority: authority, target: target }
}

// RFC 3986 dot-segment removal, over `/`-separated segments.
fn remove_dot_segments(path: String): String {
  parts = path.split("/")
  kept: Array(String) = []
  for seg in parts {
    if seg == "." {
    } else if seg == ".." {
      if kept.size > 1 {
        kept.pop
      }
    } else {
      kept.push(seg)
    }
  }
  buf = buf_new()
  for i in 0..kept.size {
    if i > 0 {
      buf.push_str("/")
    }
    buf.push_str(kept[i])
  }
  out = buf.to_s
  if out.size == 0 {
    return "/"
  }
  if str_slice(out, 0, 1) != "/" {
    out = "/${out}"
  }
  out
}

// Resolves a redirect Location against the URL that produced it.
fn resolve_url(base: String, loc: String): String? {
  if starts_with(loc, "http://") {
    return loc
  }
  if starts_with(loc, "https://") {
    return nil
  }
  if starts_with(loc, "//") {
    return "http:${loc}"
  }
  parts = http_parse_url(base)
  if p = parts {
    origin = "http://${p.authority}"
    if starts_with(loc, "/") {
      return "${origin}${loc}"
    }
    if starts_with(loc, "?") {
      return "${origin}${p.target}${loc}"
    }
    if loc.size == 0 {
      return base
    }
    base_path = p.target
    qi = 0
    while qi < base_path.size {
      if base_path[qi] == 63 {
        base_path = str_slice(base_path, 0, qi)
        qi = base_path.size
      } else {
        qi += 1
      }
    }
    slash = -1
    for j in 0..base_path.size {
      if base_path[j] == 47 {
        slash = j
      }
    }
    merged = "${str_slice(base_path, 0, slash + 1)}${loc}"
    return "${origin}${remove_dot_segments(merged)}"
  }
  nil
}

// One exchange, no redirects. `deadline` is a reading of `now_ms()`:
// the exchange gets what is left until then when it starts.
fn http_fetch_once(method: String, url: String, body: Bytes, headers: Array(Header), deadline: Int): Response | HttpError {
  if starts_with(url, "https://") {
    return HttpError.new("https is not supported until the TLS wave")
  }
  if !starts_with(url, "http://") {
    return HttpError.new("only http:// URLs are supported")
  }
  parsed = http_parse_url(url)
  if p = parsed {
    buf = buf_new()
    buf.push_str(method)
    buf.push_str(" ")
    buf.push_str(p.target)
    buf.push_str(" HTTP/1.1\r\nHost: ")
    buf.push_str(p.authority)
    buf.push_str("\r\n")
    i = 0
    while i < headers.size {
      buf.push_str(headers[i].name)
      buf.push_str(": ")
      buf.push_str(headers[i].value)
      buf.push_str("\r\n")
      i += 1
    }
    buf.push_str("Content-Length: ${body.size}\r\nConnection: close\r\n\r\n")
    if body.size > 0 {
      text = String.from_utf8(body) ?? ""
      buf.push_str(text)
    }
    left = deadline - now_ms()
    if left <= 0 {
      return HttpError.new("request to ${p.authority} timed out")
    }
    raw = httpc.avant_http_fetch(p.host, p.port, buf.to_s, left)
    code = httpc.avant_http_take_status()
    if code == 1 {
      return HttpError.new("could not connect to ${p.authority}")
    }
    if code == 2 {
      return HttpError.new("request to ${p.authority} timed out")
    }
    if code != 0 {
      return HttpError.new("request to ${p.authority} failed")
    }
    status = httpc.avant_http_resp_status(raw)
    if httpc.avant_http_take_status() != 0 {
      return HttpError.new("invalid HTTP response from ${p.authority}")
    }
    resp_body = httpc.avant_http_resp_body(raw)
    if httpc.avant_http_take_status() != 0 {
      return HttpError.new("invalid HTTP response body from ${p.authority}")
    }
    resp_headers = httpc.avant_http_resp_headers(raw)
    return Response {
      status: status,
      headers: Headers { data: resp_headers },
      head: "",
      body: resp_body
    }
  }
  HttpError.new("invalid URL: ${url}")
}

// The client half of the module: one blocking request at a time on
// its own connection, in the shape of the fetch primitive below it.
// A call blocks the calling thread until the response is complete,
// so do not call it from a server handler; hand the work to `spawn`
// first. Redirects are followed at most five times when `follow` is
// set. There is no connection pooling and no TLS in this wave.
pub class Http {
  fn initialize {
  }

  // Binds a server now (so a bad port fails here, and an ephemeral
  // port is known through `server.port` before serving) and returns
  // it ready for routes. The body limit is in bytes; a larger request
  // body is answered 413. `loops` is the number of event loops (one
  // thread each, all bound to the same port); when it is 0 the
  // program's chosen thread count is used (the `--threads` value, or
  // the machine's thread count). Loops plus `spawn` workers can
  // oversubscribe the machine; that is the documented consequence of
  // one chosen count.
  pub fn self.listen(port: Int, host: String = "127.0.0.1", max_body: Int = 1048576, loops: Int = 0, max_message: Int = 1048576): Server | HttpError {
    handle = httpc.avant_http_listen(host, port, max_body, loops, max_message)
    if httpc.avant_http_take_status() != 0 {
      return HttpError.new("could not listen on ${host}:${port}")
    }
    state = HttpState.new
    state.bound_port = httpc.avant_http_port(handle)
    Server { handle: handle, state: state }
  }

  pub fn self.get(url: String, follow: Bool = true, timeout_ms: Int = 10000): Response | HttpError {
    hs: Array(Header) = []
    Http.request("GET", url, "".bytes, hs, follow, timeout_ms)
  }

  pub fn self.post(url: String, body: String, follow: Bool = true, timeout_ms: Int = 10000): Response | HttpError {
    hs: Array(Header) = []
    hs.push(Header { name: "Content-Type", value: "text/plain; charset=utf-8" })
    Http.request("POST", url, body.bytes, hs, follow, timeout_ms)
  }

  // `timeout_ms` is a deadline for the whole call: every redirect it
  // follows, each one's connect, request and complete response. When
  // it passes first the call returns an HttpError, whatever has
  // arrived. Zero or less means the default, 10000.
  pub fn self.request(method: String, url: String, body: Bytes, headers: Array(Header), follow: Bool = true, timeout_ms: Int = 10000): Response | HttpError {
    cur_method = method
    cur_url = url
    cur_body = body
    hops = 0
    limit = timeout_ms
    if limit <= 0 {
      limit = 10000
    }
    deadline = now_ms() + limit
    while true {
      resp = http_fetch_once(cur_method, cur_url, cur_body, headers, deadline)?
      redirect = resp.status == 301 || resp.status == 302 || resp.status == 303 || resp.status == 307 || resp.status == 308
      if !follow || !redirect {
        return resp
      }
      location = resp.headers.get("Location") ?? return resp
      hops += 1
      if hops > 5 {
        return HttpError.new("too many redirects")
      }
      next_url = resolve_url(cur_url, location) ?? return HttpError.new("invalid redirect location: ${location}")
      if resp.status == 303 || ((resp.status == 301 || resp.status == 302) && cur_method == "POST") {
        cur_method = "GET"
        cur_body = "".bytes
      }
      cur_url = next_url
    }
    HttpError.new("too many redirects")
  }
}

// A WebSocket client connection (the client half of wave 5C, Q134 B).
// `recv` blocks the calling thread until a message arrives, so do not
// call it from a server handler. There is no TLS: a `wss://` URL is an
// HttpError, never a silent downgrade. A connection that is never
// closed leaks its loop thread until the process exits; there is no
// finalizer.
// The value is the connection's id in the runtime, a number that is
// never given twice: after `close`, every copy of the value finds
// nothing there, so `send_text` and `send_bytes` return false, `recv`
// returns nil, `close_code` is 1006 and a second `close` does nothing,
// whatever connections were opened since.
pub struct WsConnection {
  id: Int

  pub fn send_text(text: String): Bool {
    httpc.avant_ws_client_send_text(self.id, text) != 0
  }

  pub fn send_bytes(data: Bytes): Bool {
    httpc.avant_ws_client_send_bytes(self.id, data) != 0
  }

  // The next message, or nil when the connection has closed. With a
  // timeout, nil also means the timeout passed; `close_code` says
  // which: it is 1006 until a close frame arrives.
  pub fn recv(timeout_ms: Int = -1): WsMessage? {
    data = httpc.avant_ws_client_recv(self.id, timeout_ms)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    is_text = httpc.avant_ws_client_last_is_text() != 0
    WsMessage { is_text: is_text, body: data }
  }

  pub fn close_code: Int {
    httpc.avant_ws_client_close_code(self.id)
  }

  // Safe to call more than once, through any copy: a second close
  // does nothing. A `recv` waiting in another task returns nil.
  pub fn close {
    httpc.avant_ws_client_close(self.id)
  }
}

pub class Ws {
  fn initialize {
  }

  pub fn self.connect(url: String, timeout_ms: Int = 10000): WsConnection | HttpError {
    if starts_with(url, "wss://") {
      return HttpError.new("wss is not supported until the TLS wave")
    }
    if !starts_with(url, "ws://") {
      return HttpError.new("only ws:// URLs are supported")
    }
    parsed = http_parse_url("http://${str_slice(url, 5, url.size)}")
    if p = parsed {
      key = httpc.avant_ws_client_key()
      id = httpc.avant_ws_client_connect(p.host, p.port, p.target, key, timeout_ms)
      code = httpc.avant_http_take_status()
      if code == 1 {
        return HttpError.new("could not connect to ${p.authority}")
      }
      if code == 2 {
        return HttpError.new("connection to ${p.authority} timed out")
      }
      if code != 0 {
        return HttpError.new("websocket handshake with ${p.authority} failed")
      }
      return WsConnection { id: id }
    }
    HttpError.new("invalid URL: ${url}")
  }
}

