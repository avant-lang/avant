pub class HttpError: Error {
  pub message: String

  fn initialize(message: String) {
    self.message = message
  }
}

pub struct Header {
  pub name: String
  pub value: String
}

// The headers of a received message. This is one collector buffer the
// C side builds at parse time: a small offset table over the raw
// header block, so reading a header copies only that value. The set is
// immutable, keeps wire order and duplicates, and lookup never touches
// the process-wide Hash. Look headers up by name (case-insensitive,
// first value wins); `get_all` is for the rare repeated header.
pub struct Headers {
  data: Bytes

  pub fn count: Int {
    httpc.avant_http_header_count(self.data)
  }

  pub fn has(name: String): Bool {
    httpc.avant_http_header_has(self.data, name) != 0
  }

  pub fn get(name: String): String? {
    v = httpc.avant_http_header_at(self.data, name, 0)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn get_all(name: String): Array(String) {
    out: Array(String) = []
    i = 0
    while true {
      v = httpc.avant_http_header_at(self.data, name, i)
      if httpc.avant_http_take_status() != 0 {
        return out
      }
      out.push(v)
      i += 1
    }
    out
  }

  pub fn name_at(index: Int): String? {
    v = httpc.avant_http_header_name_at(self.data, index)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn value_at(index: Int): String? {
    v = httpc.avant_http_header_value_at(self.data, index)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }
}

// Parameters in the form of a query string or of a form body
// (application/x-www-form-urlencoded): `a=1&b=x+y&c=%C3%A9`. Pieces are
// separated by `&`, a name from its value by the first `=` (a piece
// without one has an empty value), and empty pieces are skipped; `+` is
// a space and `%XX` a byte, a `%` without two hex digits is kept as it
// is, and bytes that are not UTF-8 read as U+FFFD (the WHATWG URL
// standard's reading). Names are compared exactly; wire order and
// repeats are kept.
pub struct Params {
  data: Bytes

  pub fn self.parse(text: String): Params {
    Params { data: httpc.avant_http_params_pack(text) }
  }

  pub fn count: Int {
    httpc.avant_http_header_count(self.data)
  }

  pub fn has(name: String): Bool {
    httpc.avant_http_param_has(self.data, name) != 0
  }

  // The first value of `name`, nil when there is none.
  pub fn get(name: String): String? {
    v = httpc.avant_http_param_at(self.data, name, 0)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn get_all(name: String): Array(String) {
    out: Array(String) = []
    i = 0
    while true {
      v = httpc.avant_http_param_at(self.data, name, i)
      if httpc.avant_http_take_status() != 0 {
        return out
      }
      out.push(v)
      i += 1
    }
    out
  }

  pub fn name_at(index: Int): String? {
    v = httpc.avant_http_header_name_at(self.data, index)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn value_at(index: Int): String? {
    v = httpc.avant_http_header_value_at(self.data, index)
    if httpc.avant_http_take_status() != 0 {
      return nil
    }
    v
  }
}

fn empty_headers: Headers {
  Headers { data: "".bytes }
}

// A header set from "Name: value\r\n" lines whose every line was checked
// as Response.header checks it.
fn headers_of(block: String): Headers {
  Headers { data: httpc.avant_http_headers_pack(block) }
}

struct TargetParts {
  path: String
  query: String?
}

// A request target split at its first `?`: the path, and the query
// without the `?` (nil when there is none).
fn split_target(target: String): TargetParts {
  q = 0
  while q < target.size {
    if target[q] == 63 {
      return TargetParts { path: target[..q], query: target[q + 1..] }
    }
    q += 1
  }
  TargetParts { path: target, query: nil }
}

// A received request. `method` and `path` are fields, read by every
// route match; the rest is read through methods, so that what is read
// lazily later changes no handler: `query()` is the raw query string
// without the `?` (nil when the target has none), `header(name)` the
// first value of a header, `headers()` all of them, `body()` the body,
// `peer()` the peer's address. Each is a value copied out of the socket
// buffer before the handler runs; the peer's address travels in the
// header set's block, and `peer()` makes its text.
pub struct Request {
  pub method: String
  pub path: String
  raw_query: String?
  hs: Headers
  data: Bytes
  seq: Int

  pub fn query: String? {
    self.raw_query
  }

  // The first value of the header `name` (in any case), nil when the
  // request has none.
  pub fn header(name: String): String? {
    self.hs.get(name)
  }

  pub fn headers: Headers {
    self.hs
  }

  // The query's parameters, decoded (Params); none without a query. The
  // query is parsed on each call.
  pub fn params: Params {
    Params.parse(self.raw_query ?? "")
  }

  // The first decoded value of the query parameter `name`, nil when the
  // query has none.
  pub fn param(name: String): String? {
    self.params().get(name)
  }

  pub fn body: Bytes {
    self.data
  }

  // The body as text, nil when its bytes are not valid UTF-8.
  pub fn body_text: String? {
    String.from_utf8(self.data)
  }

  // The address of the peer that sent the request: an IPv4 address in
  // dotted form ("127.0.0.1", also when a dual-stack listener received
  // it as an IPv4-mapped IPv6 address) or an IPv6 address ("::1"). The
  // port is not kept.
  pub fn peer: String {
    httpc.avant_http_headers_peer(self.hs.data)
  }

  // The reply of this request, for answering it later: the handler
  // hands it to a task and returns Response.later(); the task sends the
  // answer through it (HttpReply.send), from any thread. Called by the
  // request's own handler while it runs (anywhere else it traps); a
  // second call gives the same reply.
  pub fn reply: HttpReply {
    HttpReply { id: httpc.avant_http_req_reply(self.seq) }
  }

  // A request built in memory, as the server would hand it to a handler:
  // for a framework's or a program's tests, which call a handler or a
  // router with it. `target` is the path with an optional query (`/a?b`);
  // each header is checked as Response.header checks one (a name that is
  // not a token, or a value with a control character but tab, traps).
  // Its peer is "".
  pub fn self.build(method: String, target: String, headers: Array(Header) = [], body: Bytes = "".bytes): Request {
    block = Buf.new()
    for h in headers {
      httpc.avant_http_header_check(h.name, h.value)
      block.push_str("${h.name}: ${h.value}\r\n")
    }
    parts = split_target(target)
    Request { method: method, path: parts.path, raw_query: parts.query, hs: headers_of(block.to_s()), data: body, seq: 0 }
  }
}

// A response, in both directions: a handler returns one, and the
// client returns one. `headers()` is the received header set of a
// response the client returns, and the header lines of one built in
// code, the server's own Content-Length and Connection aside.
// Content-Length and Connection are managed by the server and the
// client; setting them with `header` has no effect. A response has one
// Content-Type, `ctype` (text/plain or application/octet-stream from
// `text` and `bytes`): `header` replaces it, and an empty value sends
// none. The other header lines set are kept in `head`, the received set
// in `hs`. All three are private: a response is built by `text` or
// `bytes` and `header`, so every line went through `header`'s check, and
// a `Response { ... }` literal outside this module does not compile. A
// handler's status outside 200-599 traps when the answer is written: a
// 1xx is an interim answer, never a handler's.
pub struct Response {
  pub status: Int
  hs: Headers
  ctype: String
  head: String
  pub body: Bytes
  deferred: Bool

  // The response's headers: those received, or those a built response
  // will send (its Content-Type first).
  pub fn headers: Headers {
    if self.ctype.size == 0 && self.head.size == 0 {
      return self.hs
    }
    if self.ctype.size == 0 {
      return headers_of(self.head)
    }
    headers_of("Content-Type: ${self.ctype}\r\n${self.head}")
  }

  // The body as text, nil when its bytes are not valid UTF-8.
  pub fn body_text: String? {
    String.from_utf8(self.body)
  }

  pub fn self.text(body: String, status: Int = 200): Response {
    Response { status: status, hs: empty_headers(), ctype: "text/plain; charset=utf-8", head: "", body: body.bytes, deferred: false }
  }

  pub fn self.bytes(body: Bytes, status: Int = 200): Response {
    Response { status: status, hs: empty_headers(), ctype: "application/octet-stream", head: "", body: body, deferred: false }
  }

  // What a handler returns when it answers later: it took the request's
  // reply (req.reply()) and handed it to a task, which sends the answer.
  // Pipelined requests behind it wait, so answers keep their order; an
  // answer that does not come within the server's reply_timeout is
  // answered 503 by the server.
  pub fn self.later: Response {
    Response { status: 0, hs: empty_headers(), ctype: "", head: "", body: "".bytes, deferred: true }
  }

  // A name that is not a token, or a value with a control character
  // other than tab (CR and LF among them), traps: appended as it
  // came, such a value added header lines or a second answer to the
  // response (response splitting). A Content-Type replaces the one the
  // response has (appended, it made a second Content-Type line).
  pub fn header(name: String, value: String): Response {
    httpc.avant_http_header_check(name, value)
    if is_managed_header(name) {
      return self
    }
    if name.eq_ignore_ascii_case("content-type") {
      return Response { status: self.status, hs: self.hs, ctype: value, head: self.head, body: self.body, deferred: false }
    }
    Response { status: self.status, hs: self.hs, ctype: self.ctype, head: "${self.head}${name}: ${value}\r\n", body: self.body, deferred: false }
  }
}

fn is_managed_header(name: String): Bool {
  name.eq_ignore_ascii_case("content-length") || name.eq_ignore_ascii_case("connection")
}

// One WebSocket message. `body` is the one collector copy of the
// payload; `text` converts it on access, so a handler that echoes or
// forwards the message never pays for a string it does not read. A
// text message was validated as UTF-8 by the runtime before dispatch;
// `text` is nil for a binary message.
pub struct WsMessage {
  pub is_text: Bool
  pub body: Bytes

  pub fn is_binary: Bool {
    !self.is_text
  }

  pub fn text: String? {
    if self.is_text {
      return String.from_utf8(self.body)
    }
    nil
  }
}

// Why a WebSocket send or close did not go: the connection is closed
// (or closing: a close was sent, or it was cut), or its send queue is
// full (a message that cannot go out at once and would leave more than
// 1 MiB waiting is refused whole; the client's queue, when no memory is
// left to hold it). A full queue is a slow reader: a program that may
// drop such a message writes `_ = conn.send_text(x)`.
pub enum WsSendError: Error {
  closed,
  full

  fn message: String {
    switch self {
      case closed { "the WebSocket connection is closed" }
      case full { "the WebSocket connection's send queue is full" }
    }
  }
}

// Why a send or close the runtime refused did not go: its answer 2 is
// a full queue, 0 a closed connection (1, sent, never comes here: a send
// that goes costs one compare).
fn ws_failed(code: Int): WsSendError {
  if code == 2 {
    return WsSendError.full
  }
  WsSendError.closed
}

// The crossable half of a WsConn: a bare connection id, the one field
// that may cross a `spawn` boundary (a spawn copies scalars, not the
// pointer a WsConn also holds). Hand work to a task as a sender:
//
//   sender = conn.sender
//   spawn { _ = sender.send_text(answer) }
//
// Sends through a sender find the connection by id in the runtime and
// behave exactly as sends through the WsConn.
pub struct WsSender {
  id: Int

  pub fn send_text(text: String): Void | WsSendError {
    sent = httpc.avant_ws_send_text_by_id(self.id, text)
    if sent != 1 {
      return ws_failed(sent)
    }
  }

  pub fn send_bytes(data: Bytes): Void | WsSendError {
    sent = httpc.avant_ws_send_bytes_by_id(self.id, data)
    if sent != 1 {
      return ws_failed(sent)
    }
  }

  pub fn send_message(msg: WsMessage): Void | WsSendError {
    if msg.is_text {
      sent = httpc.avant_ws_send_text_bytes_by_id(self.id, msg.body)
      if sent != 1 {
        return ws_failed(sent)
      }
      return
    }
    sent = httpc.avant_ws_send_bytes_by_id(self.id, msg.body)
    if sent != 1 {
      return ws_failed(sent)
    }
  }

  pub fn close(code: Int = 1000, reason: String = ""): Void | WsSendError {
    sent = httpc.avant_ws_close_by_id(self.id, code, reason)
    if sent != 1 {
      return ws_failed(sent)
    }
  }
}

// A live WebSocket connection. The value is the connection's id and
// the address of its record in the runtime. The record is never freed
// and the runtime checks the id against it on every operation, so a
// value kept after its connection closed, or after `serve` returned,
// answers WsSendError.closed and touches nothing else. The value itself stays on
// the loop thread (a raw pointer may not cross a `spawn` boundary);
// `sender` above is the half that may cross.
// `send_text`, `send_bytes`, `send_message` and `close` return a
// WsSendError when the connection is closed (`closed`) or its bounded
// send queue is full (`full`). They may be called from
// any task: a send from a task other than the connection's loop thread
// is queued in C (1 MiB per connection) and written in order when the
// loop wakes. Ping is answered by the runtime, never delivered here;
// the close handshake is the runtime's, with the peer's code and
// reason delivered to the `websocket_close` handler.
pub struct WsConn {
  id: Int
  handle: Ptr(Void)

  pub fn sender: WsSender {
    WsSender { id: self.id }
  }

  pub fn send_text(text: String): Void | WsSendError {
    sent = httpc.avant_ws_send_text_direct(self.handle, self.id, text)
    if sent != 1 {
      return ws_failed(sent)
    }
  }

  pub fn send_bytes(data: Bytes): Void | WsSendError {
    sent = httpc.avant_ws_send_bytes_direct(self.handle, self.id, data)
    if sent != 1 {
      return ws_failed(sent)
    }
  }

  // Sends a received message onward with its kind preserved, without
  // materializing a string for a text message.
  pub fn send_message(msg: WsMessage): Void | WsSendError {
    if msg.is_text {
      sent = httpc.avant_ws_send_text_bytes_direct(self.handle, self.id, msg.body)
      if sent != 1 {
        return ws_failed(sent)
      }
      return
    }
    sent = httpc.avant_ws_send_bytes_direct(self.handle, self.id, msg.body)
    if sent != 1 {
      return ws_failed(sent)
    }
  }

  pub fn close(code: Int = 1000, reason: String = ""): Void | WsSendError {
    sent = httpc.avant_ws_close_direct(self.handle, self.id, code, reason)
    if sent != 1 {
      return ws_failed(sent)
    }
  }
}

struct Route {
  method: String
  path: String
  handler: fn(Request): Response
}

// next is the index of the next route on the same path, -1 after the
// last: a message runs every route of its path, in the order they were
// registered, without comparing a path.
struct WsRoute {
  path: String
  handler: fn(WsConn, WsMessage)
  next: Int
}

struct WsOpenRoute {
  path: String
  handler: fn(WsConn, Request)
}

struct WsCloseRoute {
  path: String
  handler: fn(WsConn, Int, String)
}

struct Hook {
  handler: fn()
}

// The mutable half of a Server, held by reference so every copy of the
// Server value registers routes on, closes, and serves the same
// server. Not public: programs meet Server, not this.
class HttpState {
  routes: Array(Route) = []
  ws_routes: Array(WsRoute) = []
  ws_open_routes: Array(WsOpenRoute) = []
  ws_close_routes: Array(WsCloseRoute) = []
  fallbacks: Array(Route) = []
  timers: Array(Hook) = []
  close_hooks: Array(Hook) = []
  hooks_ran: Bool = false
  closed: Bool = false
  serving: Bool = false
  bound_port: Int = 0

  // The route tables are read by every loop thread while `serve` runs,
  // with no lock, so a route added then is pushed onto an array the
  // loops are reading (routes answered by another route's handler, and
  // crashes). Every route method checks here, on the registering
  // thread, and traps while serving: the README's rule, register every
  // route before `serve`. Nothing is added to the request or message
  // path.
  fn add(method: String, path: String, handler: fn(Request): Response) {
    if self.serving {
      httpc.avant_http_route_while_serving("route ${method} ${path}")
    }
    self.routes.push(Route { method: method, path: path, handler: handler })
  }

  fn set_fallback(handler: fn(Request): Response) {
    if self.serving {
      httpc.avant_http_route_while_serving("fallback route")
    }
    self.fallbacks.clear()
    self.fallbacks.push(Route { method: "", path: "", handler: handler })
  }

  fn add_timer(handler: fn()) {
    if self.serving {
      httpc.avant_http_route_while_serving("every timer")
    }
    self.timers.push(Hook { handler: handler })
  }

  fn add_close_hook(handler: fn()) {
    if self.serving {
      httpc.avant_http_route_while_serving("on_close hook")
    }
    self.close_hooks.push(Hook { handler: handler })
  }

  // The close hooks, once, in the order they were registered.
  fn run_close_hooks {
    if self.hooks_ran {
      return
    }
    self.hooks_ran = true
    for h in self.close_hooks {
      (h.handler)()
    }
  }

  fn add_ws(path: String, handler: fn(WsConn, WsMessage)) {
    if self.serving {
      httpc.avant_http_route_while_serving("websocket route ${path}")
    }
    k = self.ws_routes.size
    i = self.first_ws_route(path)
    if i >= 0 {
      while self.ws_routes[i].next >= 0 {
        i = self.ws_routes[i].next
      }
      self.ws_routes[i].next = k
    }
    self.ws_routes.push(WsRoute { path: path, handler: handler, next: -1 })
  }

  // The index of the first message route on path, -1 when it has none.
  fn first_ws_route(path: String): Int {
    i = 0
    while i < self.ws_routes.size {
      if self.ws_routes[i].path == path {
        return i
      }
      i += 1
    }
    -1
  }

  fn add_ws_open(path: String, handler: fn(WsConn, Request)) {
    if self.serving {
      httpc.avant_http_route_while_serving("websocket_open route ${path}")
    }
    self.ws_open_routes.push(WsOpenRoute { path: path, handler: handler })
  }

  fn add_ws_close(path: String, handler: fn(WsConn, Int, String)) {
    if self.serving {
      httpc.avant_http_route_while_serving("websocket_close route ${path}")
    }
    self.ws_close_routes.push(WsCloseRoute { path: path, handler: handler })
  }

  fn has_ws_route(path: String): Bool {
    i = 0
    while i < self.ws_routes.size {
      if self.ws_routes[i].path == path {
        return true
      }
      i += 1
    }
    i = 0
    while i < self.ws_open_routes.size {
      if self.ws_open_routes[i].path == path {
        return true
      }
      i += 1
    }
    i = 0
    while i < self.ws_close_routes.size {
      if self.ws_close_routes[i].path == path {
        return true
      }
      i += 1
    }
    false
  }

  fn has_ws_open_route(path: String): Bool {
    for r in self.ws_open_routes {
      if r.path == path {
        return true
      }
    }
    false
  }

  fn ws_open_dispatch(path: String, conn: WsConn, req: Request) {
    for r in self.ws_open_routes {
      if r.path == path {
        (r.handler)(conn, req)
      }
    }
  }

  // A request no route names (the C loop matched none): the fallback's,
  // or 404.
  fn unrouted(req: Request): Response {
    if self.fallbacks.size > 0 {
      return (self.fallbacks[0].handler)(req)
    }
    Response.text("not found", 404)
  }
}

// The request the C loop parsed, as a handler gets it, its method made
// from the request's bytes (a routed request's are its route's).
fn received_request(raw: Ptr(Void), path: String, query: String?): Request {
  method = httpc.avant_http_req_method(raw)
  raw_headers = httpc.avant_http_req_headers(raw)
  req_body = httpc.avant_http_req_body(raw)
  Request {
    method: method,
    path: path,
    raw_query: query,
    hs: Headers { data: raw_headers },
    data: req_body,
    seq: httpc.avant_http_req_seq(raw)
  }
}

// The C loop calls this named function once per complete request. It
// is a plain function, not a closure: the server state arrives as its
// first argument, in the shape the C callback rule allows.
fn http_dispatch(state: HttpState, raw: Ptr(Void)) {
  // The route, found in C on the request's own bytes (its method and
  // path, before anything is allocated), and whether the target has a
  // query and the request is a WebSocket handshake, in one word. A
  // routed request's method and path are its route's own strings, so
  // nothing is allocated for them.
  found = httpc.avant_http_req_route(raw)
  i = (found >> 2) - 1
  query: String? = nil
  if found & 1 != 0 {
    query = httpc.avant_http_req_query(raw)
  }
  // A well-formed WebSocket handshake (validated in C) upgrades here
  // when a websocket route owns the path; without one it falls through
  // to ordinary routing and its 404. The connection's C record keeps
  // its path's first message route (the loop threads share no table of
  // connections; the route tables are only read while serving).
  // The open handlers get the handshake request (its headers, a cookie
  // or an Authorization, and its peer), made only when the path has one.
  if found & 2 != 0 {
    path = httpc.avant_http_req_path(raw)
    if state.has_ws_route(path) {
      if httpc.avant_http_req_ws_upgrade(raw, state.first_ws_route(path)) != 0 {
        wid = httpc.avant_http_req_ws_id(raw)
        whandle = httpc.avant_http_req_ws_conn(raw)
        conn = WsConn { id: wid, handle: whandle }
        if state.has_ws_open_route(path) {
          state.ws_open_dispatch(path, conn, received_request(raw, path, query))
        }
      }
      return
    }
  }
  resp = if i >= 0 {
    r = state.routes[i]
    req = Request {
      method: r.method,
      path: r.path,
      raw_query: query,
      hs: Headers { data: httpc.avant_http_req_headers(raw) },
      data: httpc.avant_http_req_body(raw),
      seq: httpc.avant_http_req_seq(raw)
    }
    (r.handler)(req)
  } else {
    // No route: the method and path are made, for the fallback or 404.
    state.unrouted(received_request(raw, httpc.avant_http_req_path(raw), query))
  }
  if resp.deferred {
    // Answered later, through the reply a task holds.
    httpc.avant_http_req_later(raw)
    return
  }
  // The response head and body travel into C as raw heap pointers; the
  // respond entry is no safepoint, so no thread collects while it writes
  // (until the handshake a defer region here and a second one in the
  // entry kept other loop threads' collections off).
  httpc.avant_http_req_respond(raw, resp.status, resp.ctype, resp.head, resp.body)
}

// The C loop calls this named function each time a timer of `every`
// fires, on the server's first loop thread.
fn timer_dispatch(state: HttpState, raw: Ptr(Void)) {
  i = httpc.avant_http_timer_index(raw)
  (state.timers[i].handler)()
}

// The C loop calls this named function once per WebSocket message and
// once per connection close. Open is dispatched from http_dispatch at
// upgrade time instead. The first getter is the collector's heap-goal
// boundary for the message path, as avant_http_req_route is a batch's.
fn ws_dispatch(state: HttpState, raw: Ptr(Void)) {
  kind = httpc.avant_ws_event_kind(raw)
  wid = httpc.avant_ws_event_conn_id(raw)
  whandle = httpc.avant_ws_event_conn(raw)
  conn = WsConn { id: wid, handle: whandle }
  if kind == 1 {
    // The route walk is inlined here rather than called as an
    // HttpState method: each Avant call is a collector frame entry, and
    // this path runs once per message. The first route comes from the
    // connection's own C record (set at the upgrade), the rest by each
    // route's next: no path is compared.
    i = httpc.avant_ws_event_route(raw)
    if i >= 0 {
      is_text = httpc.avant_ws_event_is_text(raw) != 0
      data = httpc.avant_ws_event_data(raw)
      msg = WsMessage { is_text: is_text, body: data }
      while i >= 0 {
        r = state.ws_routes[i]
        (r.handler)(conn, msg)
        i = r.next
      }
    }
    return
  }
  if kind == 2 {
    path = httpc.avant_ws_event_path(raw)
    code = httpc.avant_ws_event_code(raw)
    reason = httpc.avant_ws_event_reason(raw)
    for rc in state.ws_close_routes {
      if rc.path == path {
        (rc.handler)(conn, code, reason)
      }
    }
  }
}

// Why a reply's answer was not sent: the reply has nothing left to
// answer, since its request was answered already (a send before, or
// the server's 503 at its reply_timeout) or its connection closed.
pub enum ReplyError: Error {
  gone

  fn message: String {
    "the request was answered already or its connection closed"
  }
}

// The reply of a request answered later (Request.reply): a number, so
// it crosses to any task, as WsSender does. `send` gives the answer, once;
// it is written by the connection's loop, in order with the requests
// pipelined behind it.
pub struct HttpReply {
  id: Int

  pub fn send(resp: Response): Void | ReplyError {
    if resp.deferred {
      httpc.avant_http_trap("http.HttpReply.send(Response.later()): a reply sends the final answer")
    }
    if httpc.avant_http_reply_send(self.id, resp.status, resp.ctype, resp.head, resp.body) == 0 {
      return ReplyError.gone
    }
  }
}

// Stops a server from any task (Server.closer). Closing a server that
// stopped already, or through a second copy, does nothing.
pub struct ServerCloser {
  id: Int

  pub fn close {
    if self.id != 0 {
      _ = httpc.avant_http_close_by_id(self.id)
    }
  }
}

// A cleartext HTTP/1.1 server on uSockets with picohttpparser.
// Handlers must not block the event loop: a handler that blocks (a
// long computation, a blocking client call, a sleep) stalls every
// connection on the server. Hand CPU work to `spawn` and answer from
// there, or keep handlers to request-shaped work. Routes match exact
// paths only; there is no pattern router, no middleware, and no
// streaming: a request body is buffered whole, up to the server's
// body limit (1 MiB by default, set at listen time), and a larger
// body is answered 413 and the connection closed. A chunked request
// body is answered 411 in this wave. HTTP/1.1 connections are kept
// alive unless the client asks to close them (HTTP/1.0 the reverse),
// and pipelined requests are answered in order. There is no TLS: an
// `https` claim would be a lie, here and in the client below.
pub struct Server {
  handle: Ptr(Void)
  state: HttpState

  // The port the server is bound to. With port 0 at listen time this
  // is the ephemeral port the OS chose.
  pub fn port: Int {
    self.state.bound_port
  }

  pub fn get(path: String, handler: fn(Request): Response): Server {
    self.state.add("GET", path, handler)
    self
  }

  pub fn post(path: String, handler: fn(Request): Response): Server {
    self.state.add("POST", path, handler)
    self
  }

  pub fn put(path: String, handler: fn(Request): Response): Server {
    self.state.add("PUT", path, handler)
    self
  }

  pub fn delete(path: String, handler: fn(Request): Response): Server {
    self.state.add("DELETE", path, handler)
    self
  }

  pub fn patch(path: String, handler: fn(Request): Response): Server {
    self.state.add("PATCH", path, handler)
    self
  }

  pub fn route(method: String, path: String, handler: fn(Request): Response): Server {
    self.state.add(method, path, handler)
    self
  }

  // The handler of every request no route names, by its method and path
  // (404 without one): a framework's router, given every request it has
  // to route (`/messages/42`). A second call replaces the first.
  pub fn fallback(handler: fn(Request): Response): Server {
    self.state.set_fallback(handler)
    self
  }

  // Runs `handler` every `ms` milliseconds while the server serves, the
  // first time `ms` after `serve` starts, on the server's first loop
  // thread: like a handler it must not block, what it captures is
  // checked as a handler's, and a trap in it is printed and the server
  // goes on. Registered before `serve`, like a route; `ms` is 1 or more.
  pub fn every(ms: Int, handler: fn()): Server {
    if ms < 1 {
      httpc.avant_http_trap("http.Server.every(${ms}): a period is 1 ms or more")
    }
    self.state.add_timer(handler)
    if !self.state.closed {
      _ = httpc.avant_http_add_timer(self.handle, ms)
    }
    self
  }

  // Runs `handler` once when the server stops: after `close`, on the
  // thread that called `serve`, when its loops have stopped and before
  // `serve` returns (in `close` itself for a server never served).
  // Hooks run in the order they were registered.
  pub fn on_close(handler: fn()): Server {
    self.state.add_close_hook(handler)
    self
  }

  // Registers a WebSocket route on an exact path. The handler runs on
  // a loop thread once per complete message (fragmentation is the
  // runtime's) and must not block the loop, in the rule for HTTP
  // handlers above. A message larger than the server's `max_message`
  // (1 MiB by default, set at listen time) is closed 1009 by the
  // runtime without reaching the handler.
  pub fn websocket(path: String, handler: fn(WsConn, WsMessage)): Server {
    self.state.add_ws(path, handler)
    self
  }

  // The handler runs once per connection, after the upgrade, with the
  // handshake request: its headers (a cookie, an Authorization), its
  // query and its peer, which a handler may check and close on.
  pub fn websocket_open(path: String, handler: fn(WsConn, Request)): Server {
    self.state.add_ws_open(path, handler)
    self
  }

  // The peer's close code and reason (1006 when the connection dropped
  // without a close frame). Runs once per connection.
  pub fn websocket_close(path: String, handler: fn(WsConn, Int, String)): Server {
    self.state.add_ws_close(path, handler)
    self
  }

  // The server's limits: each is on by default, set like a route
  // before `serve` (one set while serving traps), and 0 turns it off.
  // A negative value traps.
  //
  // A request head must be complete within `ms` milliseconds of its
  // first byte (10000 by default); a later one is answered 408 and the
  // connection closed. Without it a client sending a byte now and then
  // held a connection for good: the idle timeout starts again at every
  // byte.
  pub fn head_timeout(ms: Int): Server {
    self.set_limit("head_timeout", 1, ms, 0)
  }

  // A request body waiting for its bytes must receive them at
  // `bytes_per_second` on average over each `grace_ms` from when it
  // began to wait, else the request is answered 408 and the connection
  // closed; an answer the client is slow to read must leave at the same
  // rate, else its connection is closed (240 bytes a second over 5000
  // ms by default). The same for a WebSocket connection: a message
  // arriving in parts, and what its send queue holds, at that rate, else
  // the connection is closed. 0 bytes a second turns it off.
  pub fn min_rate(bytes_per_second: Int, grace_ms: Int = 5000): Server {
    self.set_limit("min_rate", 2, bytes_per_second, grace_ms)
  }

  // The bytes the bodies of all requests waiting for theirs may hold
  // together, each its Content-Length (268435456, 256 MiB, by default);
  // a body that would pass it is answered 503 and its connection
  // closed. A body that arrives with its head takes none.
  pub fn body_budget(bytes: Int): Server {
    self.set_limit("body_budget", 3, bytes, 0)
  }

  // The process's resident memory past which new requests are answered
  // 503 and their connections closed, read about once a second. By
  // default 90% of the container's memory limit (cgroup), or off when
  // the process runs under none.
  pub fn memory_ceiling(bytes: Int): Server {
    self.set_limit("memory_ceiling", 4, bytes, 0)
  }

  // The open connections (10000 by default, at most the file-descriptor
  // limit less a reserve): a connection past it closes the loop's
  // longest idle one, or, with none idle, is closed itself.
  pub fn max_connections(n: Int): Server {
    self.set_limit("max_connections", 5, n, 0)
  }

  // How long an HTTP connection may stay idle, with no request bytes
  // arriving and no answer bytes leaving, before it is closed (30000 ms
  // by default; at most 14280000). uSockets counts in 4-second ticks:
  // the close comes no earlier than `ms` and less than 8 s after it
  // (past 952000 ms, in minutes: less than 2 minutes after it).
  pub fn idle_timeout(ms: Int): Server {
    self.set_limit("idle_timeout", 7, ms, 0)
  }

  // How long a WebSocket connection may go without receiving anything
  // before the server pings it (30000 ms by default, at most 14280000,
  // counted as `idle_timeout` counts): a pong, or anything else that
  // arrives, starts it again; when it passes again with nothing
  // received the connection is closed (1006 to its close handler). A
  // peer gone without a FIN or a reset (a pulled cable, a NAT that
  // forgot the flow) is noticed so; one that answers pings stays.
  pub fn websocket_idle_timeout(ms: Int): Server {
    self.set_limit("websocket_idle_timeout", 8, ms, 0)
  }

  // How long `close` waits for the connections it leaves to finish (an
  // answer being sent, a WebSocket's closing handshake) before it closes
  // them, so `serve` returns by then (30000 ms by default).
  pub fn shutdown_timeout(ms: Int): Server {
    self.set_limit("shutdown_timeout", 6, ms, 0)
  }

  // How long a request answered later (Request.reply, Response.later)
  // may wait for its answer before the server answers it 503 (30000 ms
  // by default; read about once a second).
  pub fn reply_timeout(ms: Int): Server {
    self.set_limit("reply_timeout", 9, ms, 0)
  }

  fn set_limit(name: String, which: Int, a: Int, b: Int): Server {
    if self.state.serving {
      httpc.avant_http_limit_while_serving(name)
    }
    // A closed server's C record is gone (close released it, or serve
    // did when it returned): nothing is left to limit.
    if !self.state.closed {
      httpc.avant_http_set_limit(self.handle, name, which, a, b)
    }
    self
  }

  // Runs the event loop until `close` is called from another task.
  // Register every route before serving: the route tables are read by
  // the loop threads while `serve` blocks, and a route method called
  // while serving (from a handler) traps. Returns when the loop has
  // drained, after which the listen port is released.
  pub fn serve {
    if self.state.closed {
      return
    }
    self.state.serving = true
    // The C loop matches each request's route on its own bytes.
    for r in self.state.routes {
      httpc.avant_http_route_add(self.handle, r.method, r.path)
    }
    served = 0
    pin(self.state) {
      served = httpc.avant_http_serve(self.handle, self.state, http_dispatch, ws_dispatch, timer_dispatch)
    }
    self.state.serving = false
    if served == 2 {
      // A closer stopped it before it served: nothing ran, release it.
      _ = httpc.avant_http_close(self.handle)
    }
    // The C record is gone now (serve released it): a later close must
    // not reach it.
    self.state.closed = true
    self.state.run_close_hooks()
  }

  // A closer: a value that may cross to any task (a number, as WsSender
  // is) whose `close()` stops this server as `close` does. A task that
  // waits for a signal, a deadline or a message on a channel stops the
  // server through it; `spawn { server.close() }` is refused, since a
  // Server holds the routes' state.
  pub fn closer: ServerCloser {
    if self.state.closed {
      return ServerCloser { id: 0 }
    }
    ServerCloser { id: httpc.avant_http_closer_id(self.handle) }
  }

  // Stops the server: wakes the loop, closes the listen socket and
  // every open connection, and lets `serve` return. Open WebSocket
  // connections are sent a close frame with code 1001 first. Safe to
  // call more than once, and safe to call without ever serving, in
  // which case the port is released immediately. A server that is
  // never closed leaks its listen socket until the process exits;
  // there is no finalizer.
  pub fn close {
    if self.state.closed {
      return
    }
    self.state.closed = true
    httpc.avant_http_close(self.handle)
    if !self.state.serving {
      self.state.run_close_hooks()
    }
  }
}

struct UrlParts {
  host: String
  port: Int
  authority: String
  target: String
}

// A URL's port, 1 to 65535 in decimal digits; nil for anything else.
fn parse_port(text: String): Int? {
  n = 0
  if text.size == 0 {
    return nil
  }
  for i in 0..text.size {
    c = text[i]
    if c < 48 || c > 57 {
      return nil
    }
    n = n * 10 + (c - 48)
    if n > 65535 {
      return nil
    }
  }
  if n == 0 {
    return nil
  }
  n
}

// Splits an http:// URL. Returns nil for anything that is not a
// well-formed absolute http URL with a host; the caller turns that
// into an HttpError with a message.
fn http_parse_url(url: String): UrlParts? {
  rest = url[7..]
  auth_end = rest.size
  i = 0
  while i < rest.size {
    c = rest[i]
    if c == 47 || c == 63 || c == 35 {
      auth_end = i
      i = rest.size
    } else {
      i += 1
    }
  }
  authority = rest[..auth_end]
  tail = rest[auth_end..]
  if authority.size == 0 {
    return nil
  }
  for at in 0..authority.size {
    if authority[at] == 64 {
      return nil
    }
  }
  host = authority
  port = 80
  if authority[..1] == "[" {
    close = 0
    j = 0
    while j < authority.size {
      if authority[j] == 93 {
        close = j
        j = authority.size
      } else {
        j += 1
      }
    }
    if close == 0 {
      return nil
    }
    host = authority[1..close]
    if close + 1 < authority.size {
      if authority[close + 1] != 58 {
        return nil
      }
      port = parse_port(authority[close + 2..]) ?? return nil
    }
  } else {
    colon = -1
    for j in 0..authority.size {
      if authority[j] == 58 {
        colon = j
      }
    }
    if colon >= 0 {
      host = authority[..colon]
      port = parse_port(authority[colon + 1..]) ?? return nil
    }
  }
  if host.size == 0 {
    return nil
  }
  target = tail
  if target.size == 0 {
    target = "/"
  } else if target[..1] == "?" {
    target = "/${target}"
  }
  hash = 0
  while hash < target.size {
    if target[hash] == 35 {
      target = target[..hash]
      hash = target.size
    } else {
      hash += 1
    }
  }
  UrlParts { host: host, port: port, authority: authority, target: target }
}

// RFC 3986 dot-segment removal, over `/`-separated segments.
fn remove_dot_segments(path: String): String {
  parts = path.split("/")
  kept: Array(String) = []
  for seg in parts {
    if seg == "." {
    } else if seg == ".." {
      if kept.size > 1 {
        kept.pop()
      }
    } else {
      kept.push(seg)
    }
  }
  buf = Buf.new()
  for i in 0..kept.size {
    if i > 0 {
      buf.push_str("/")
    }
    buf.push_str(kept[i])
  }
  out = buf.to_s()
  if out.size == 0 {
    return "/"
  }
  if out[..1] != "/" {
    out = "/${out}"
  }
  out
}

// Resolves a redirect Location against the URL that produced it.
fn resolve_url(base: String, loc: String): String? {
  if loc.starts_with("http://") {
    return loc
  }
  if loc.starts_with("https://") {
    return nil
  }
  if loc.starts_with("//") {
    return "http:${loc}"
  }
  parts = http_parse_url(base)
  if p = parts {
    origin = "http://${p.authority}"
    if loc.starts_with("/") {
      return "${origin}${loc}"
    }
    if loc.starts_with("?") {
      return "${origin}${p.target}${loc}"
    }
    if loc.size == 0 {
      return base
    }
    base_path = p.target
    qi = 0
    while qi < base_path.size {
      if base_path[qi] == 63 {
        base_path = base_path[..qi]
        qi = base_path.size
      } else {
        qi += 1
      }
    }
    slash = -1
    for j in 0..base_path.size {
      if base_path[j] == 47 {
        slash = j
      }
    }
    merged = "${base_path[..slash + 1]}${loc}"
    return "${origin}${remove_dot_segments(merged)}"
  }
  nil
}

// "byte B at I" for the byte of `s` a check stopped at, "empty" past its end.
fn bad_byte(s: String, i: Int): String {
  if i >= s.size {
    return "empty"
  }
  "byte ${s[i]} at ${i}"
}

// A request body as the bytes sent: a String's bytes, or Bytes as they
// are (both types are accepted wherever a body is).
fn body_bytes(body: String | Bytes): Bytes {
  switch body {
    case s: String { s.bytes }
    case b: Bytes { b }
  }
}

// The headers that carry a credential for the server they were set
// for (RFC 9110 11.6.2, 11.7.2; RFC 6265 5.4).
fn is_credential_header(name: String): Bool {
  name.eq_ignore_ascii_case("authorization") || name.eq_ignore_ascii_case("proxy-authorization") || name.eq_ignore_ascii_case("cookie")
}

// Whether two parsed URLs name one authority: the host in any case and
// the port (80 when the URL names none).
fn same_authority(a: UrlParts?, b: UrlParts?): Bool {
  if x = a {
    if y = b {
      return x.port == y.port && x.host.size == y.host.size && ascii_lower(x.host) == ascii_lower(y.host)
    }
  }
  false
}

fn ascii_lower(s: String): String {
  buf = Buf.new()
  for i in 0..s.size {
    ch = s[i]
    if ch >= 65 && ch <= 90 {
      ch += 32
    }
    buf.push_byte(ch)
  }
  buf.to_s()
}

// The client's request checks: the method, the URL's target and each
// header were written into the request as given, so CR LF in any of
// them added request lines or a second request (request splitting). The
// rules are Response.header's: a method and a header name are tokens, a
// header value holds no control character but tab; and a URL holds no
// control character and no space. A request that breaks one is not
// sent: the call returns an HttpError naming the part and the byte, as
// for the client's other refusals.
fn request_refusal(method: String, url: String, headers: Array(Header)): HttpError? {
  token_rule = "letters, digits and !#$%&'*+-.^_`|~ (RFC 9110)"
  m = httpc.avant_http_token_bad(method)
  if m >= 0 {
    return HttpError.new("invalid request method (${bad_byte(method, m)}): a method is a token: ${token_rule}")
  }
  if refused = url_refusal(url) {
    return refused
  }
  for i, h in headers {
    n = httpc.avant_http_token_bad(h.name)
    if n >= 0 {
      return HttpError.new("invalid request header name (header ${i}, ${bad_byte(h.name, n)}): a header name is ${token_rule}")
    }
    v = httpc.avant_http_value_bad(h.value)
    if v >= 0 {
      return HttpError.new("invalid request header value of ${h.name} (${bad_byte(h.value, v)}): a header value holds no CR, LF or other control character but tab (RFC 9110)")
    }
  }
  nil
}

fn url_refusal(url: String): HttpError? {
  u = httpc.avant_http_url_bad(url)
  if u >= 0 {
    return HttpError.new("invalid URL (${bad_byte(url, u)}): a URL holds no space or control character (RFC 3986)")
  }
  nil
}

// One exchange, no redirects. `deadline` is a reading of `now_ms()`:
// the exchange gets what is left until then when it starts.
fn http_fetch_once(method: String, url: String, body: Bytes, headers: Array(Header), deadline: Int, idle_ms: Int): Response | HttpError {
  if refused = request_refusal(method, url, headers) {
    return refused
  }
  if url.starts_with("https://") {
    return HttpError.new("https is not supported yet: std.http speaks plain http:// only")
  }
  if !url.starts_with("http://") {
    return HttpError.new("only http:// URLs are supported")
  }
  parsed = http_parse_url(url)
  if p = parsed {
    buf = Buf.new()
    buf.push_str(method)
    buf.push_str(" ")
    buf.push_str(p.target)
    buf.push_str(" HTTP/1.1\r\nHost: ")
    // A caller's Host replaces the URL's (it reaches a virtual host by
    // address); its value was checked as any header's. Sent beside the
    // URL's, it made two Host lines, which a server refuses.
    host_value = p.authority
    for h in headers {
      if h.name.eq_ignore_ascii_case("host") {
        host_value = h.value
      }
    }
    buf.push_str(host_value)
    buf.push_str("\r\n")
    i = 0
    // Content-Length and Connection are the client's (the request's
    // length is its body's, and it closes after one exchange): a second
    // Content-Length line from the caller was a second reading of where
    // the body ends, as Response.header skips them.
    while i < headers.size {
      if !is_managed_header(headers[i].name) && !headers[i].name.eq_ignore_ascii_case("host") {
        buf.push_str(headers[i].name)
        buf.push_str(": ")
        buf.push_str(headers[i].value)
        buf.push_str("\r\n")
      }
      i += 1
    }
    buf.push_str("Content-Length: ${body.size}\r\nConnection: close\r\n\r\n")
    // The body's bytes as they are: it went through String.from_utf8,
    // so a body that is not valid UTF-8 was sent as nothing after a
    // Content-Length of its size, and the server waited for it until
    // the call's deadline.
    buf.push_bytes(body)
    left = deadline - now_ms()
    if left <= 0 {
      return HttpError.new("request to ${p.authority} timed out")
    }
    raw = httpc.avant_http_fetch(p.host, p.port, buf.to_s(), left, idle_ms)
    code = httpc.avant_http_take_status()
    if code == 1 {
      return HttpError.new("could not connect to ${p.authority}")
    }
    if code == 2 {
      return HttpError.new("request to ${p.authority} timed out")
    }
    if code == 3 {
      return HttpError.new("request to ${p.authority} stalled: nothing arrived or left for ${idle_ms} ms")
    }
    if code != 0 {
      return HttpError.new("request to ${p.authority} failed")
    }
    status = httpc.avant_http_resp_status(raw)
    if httpc.avant_http_take_status() != 0 {
      return HttpError.new("invalid HTTP response from ${p.authority}")
    }
    // The answer to HEAD has no body: its Content-Length is the length
    // a GET's would have (RFC 9112 6.3), and reading it as this body's
    // made every such answer invalid.
    resp_body = "".bytes
    if method != "HEAD" {
      resp_body = httpc.avant_http_resp_body(raw)
      if httpc.avant_http_take_status() != 0 {
        return HttpError.new("invalid HTTP response body from ${p.authority}")
      }
    }
    resp_headers = httpc.avant_http_resp_headers(raw)
    return Response {
      status: status,
      hs: Headers { data: resp_headers },
      ctype: "",
      head: "",
      body: resp_body,
      deferred: false
    }
  }
  HttpError.new("invalid URL: ${url}")
}

// The client half of the module: one blocking request at a time on
// its own connection, in the shape of the fetch primitive below it.
// A call blocks the calling thread until the response is complete,
// so do not call it from a server handler; hand the work to `spawn`
// first. Redirects are followed at most five times when `follow` is
// set. There is no connection pooling and no TLS in this wave.
// Binds a server now (so a bad port fails here, and an ephemeral
// port is known through `server.port` before serving) and returns
// it ready for routes. The body limit is in bytes; a larger request
// body is answered 413. `loops` is the number of event loops (one
// thread each, all bound to the same port); when it is 0 the
// thread pool's size is used (`--avant-threads=N` or std.sync's
// set_pool_size, else the CPUs; it is fixed from then on). Loops plus `spawn` workers can
// oversubscribe the machine; that is the documented consequence of
// one chosen count.
pub fn listen(port: Int, host: String = "127.0.0.1", max_body: Int = 1048576, loops: Int = 0, max_message: Int = 1048576): Server | HttpError {
  handle = httpc.avant_http_listen(host, port, max_body, loops, max_message)
  if httpc.avant_http_take_status() != 0 {
    return HttpError.new("could not listen on ${host}:${port}")
  }
  state = HttpState.new()
  state.bound_port = httpc.avant_http_port(handle)
  Server { handle: handle, state: state }
}

// A URL component percent-decoded, as a router decodes a path segment
// (`caf%C3%A9` is `café`): `%XX` is a byte, `+` stays `+`, a `%`
// without two hex digits is kept, and bytes that are not UTF-8 read as
// U+FFFD. For a query or a form body, Params.parse.
pub fn decode_component(text: String): String {
  httpc.avant_http_decode_component(text)
}

// `headers` on every client call: a Hash of names to values, sent in
// its order (a header that must repeat is one line with a comma list,
// RFC 9110 5.3; `request` also takes an Array(Header) for a line that
// must repeat as lines).
pub fn get(url: String, follow: Bool = true, timeout_ms: Int = 10000, idle_ms: Int = 0, headers: Hash(String, String) = [:]): Response | HttpError {
  request_lines("GET", url, "".bytes, header_lines(headers), follow, timeout_ms, idle_ms)
}

// The body is a String (sent as text/plain; charset=utf-8) or Bytes
// (application/octet-stream), its bytes as they are; a Content-Type in
// `headers` replaces that one.
pub fn post(url: String, body: String | Bytes, follow: Bool = true, timeout_ms: Int = 10000, idle_ms: Int = 0, headers: Hash(String, String) = [:]): Response | HttpError {
  hs: Array(Header) = []
  typed = false
  for name, _ in headers {
    if name.eq_ignore_ascii_case("content-type") {
      typed = true
    }
  }
  if !typed {
    switch body {
      case String { hs.push(Header { name: "Content-Type", value: "text/plain; charset=utf-8" }) }
      case Bytes { hs.push(Header { name: "Content-Type", value: "application/octet-stream" }) }
    }
  }
  for name, value in headers {
    hs.push(Header { name: name, value: value })
  }
  request_lines("POST", url, body, hs, follow, timeout_ms, idle_ms)
}

fn header_lines(headers: Hash(String, String)): Array(Header) {
  out: Array(Header) = []
  for name, value in headers {
    out.push(Header { name: name, value: value })
  }
  out
}

// `timeout_ms` is a deadline for the whole call: every redirect it
// follows, each one's connect, request and complete response. When
// it passes first the call returns an HttpError, whatever has
// arrived. Zero or less means the default, 10000. `idle_ms`, when
// more than 0, is a second limit: an exchange that sees no byte
// arrive or leave for that long (its connect included) ends with an
// HttpError, however much of the deadline is left, so a long transfer
// that moves can be given a large deadline and one that stalls is
// still cut soon (to within a quarter of `idle_ms`).
//
// A redirect to another authority (another host or port) is sent the
// caller's headers without its credentials and its Host: an
// Authorization, a Proxy-Authorization, a Cookie or a Host set for one
// server reached the server a redirect named, as browsers and curl
// never let them.
pub fn request(method: String, url: String, body: String | Bytes, headers: Hash(String, String), follow: Bool = true, timeout_ms: Int = 10000, idle_ms: Int = 0): Response | HttpError {
  request_lines(method, url, body, header_lines(headers), follow, timeout_ms, idle_ms)
}

// The same with the header lines as an Array, for a header that must be
// sent as repeated lines.
pub fn request(method: String, url: String, body: String | Bytes, headers: Array(Header), follow: Bool = true, timeout_ms: Int = 10000, idle_ms: Int = 0): Response | HttpError {
  request_lines(method, url, body, headers, follow, timeout_ms, idle_ms)
}

fn request_lines(method: String, url: String, body: String | Bytes, headers: Array(Header), follow: Bool, timeout_ms: Int, idle_ms: Int): Response | HttpError {
  cur_method = method
  cur_url = url
  cur_body = body_bytes(body)
  hops = 0
  limit = timeout_ms
  if limit <= 0 {
    limit = 10000
  }
  deadline = now_ms() + limit
  origin = http_parse_url(url)
  elsewhere: Array(Header) = []
  for h in headers {
    if !is_credential_header(h.name) && !h.name.eq_ignore_ascii_case("host") {
      elsewhere.push(h)
    }
  }
  while true {
    hop_headers = headers
    if hops > 0 && !same_authority(origin, http_parse_url(cur_url)) {
      hop_headers = elsewhere
    }
    resp = http_fetch_once(cur_method, cur_url, cur_body, hop_headers, deadline, idle_ms)?
    redirect = resp.status == 301 || resp.status == 302 || resp.status == 303 || resp.status == 307 || resp.status == 308
    if !follow || !redirect {
      return resp
    }
    location = resp.headers().get("Location") ?? return resp
    hops += 1
    if hops > 5 {
      return HttpError.new("too many redirects")
    }
    next_url = resolve_url(cur_url, location) ?? return HttpError.new("invalid redirect location: ${location}")
    if resp.status == 303 || ((resp.status == 301 || resp.status == 302) && cur_method == "POST") {
      cur_method = "GET"
      cur_body = "".bytes
    }
    cur_url = next_url
  }
  HttpError.new("too many redirects")
}
