lib rec {
  fun avant_regex_compile(pat: String, flags: Int, match_limit: Int, depth_limit: Int, heap_limit: Int): Ptr(Void)
  fun avant_regex_take_status: Int
  fun avant_regex_release(code: Ptr(Void))
  fun avant_regex_groups(code: Ptr(Void)): Int
  fun avant_regex_group_index(code: Ptr(Void), name: String): Int
  fun avant_regex_find(code: Ptr(Void), text: String, from: Int): Int
  fun avant_regex_span_pair(i: Int): Int
  fun avant_regex_span_at(code: Ptr(Void), text: String, from: Int, i: Int): Int
  fun avant_regex_count(code: Ptr(Void), text: String): Int
  fun avant_regex_try_count(code: Ptr(Void), text: String): Int
  fun avant_re2c_handle(id: Int): Ptr(Void)
  fun avant_regex_error_text: String
  fun avant_regex_error_offset: Int
  fun avant_regex_closed
  fun avant_regex_failed(op: Int)
  fun avant_regex_failure_kind: Int
  fun avant_regex_failure_text(op: Int): String
}

// Why a RegexError is: a pattern that does not compile, a match that
// reached one of its Regex's limits, or ran out of memory; `failed` is
// any other failure PCRE2 reports. The values are the runtime's codes
// (avant_regex_failure_kind).
pub enum RegexErrorKind {
  pattern = 1
  memory
  match_limit
  depth_limit
  heap_limit
  failed
}

// A pattern that does not compile: the message is PCRE2's, with
// the pattern offset it points at ("invalid regular expression at
// offset 3: missing closing parenthesis"); offset is nil when there
// is none. A match that failed (try_find): the operation and PCRE2's
// reason ("Regex.try_find: match limit exceeded (PCRE2 error -47)"),
// offset nil. kind says which.
pub class RegexError: Error {
  pub message: String
  pub offset: Int? = nil
  pub kind: RegexErrorKind = RegexErrorKind.pattern

  fn initialize(message: String, offset: Int? = nil, kind: RegexErrorKind = RegexErrorKind.pattern) {
    self.message = message
    self.offset = offset
    self.kind = kind
  }
}

fn regex_error(status: Int): RegexError {
  if status == 1 {
    off = rec.avant_regex_error_offset()
    return RegexError.new("invalid regular expression at offset ${off}: ${rec.avant_regex_error_text()}", off)
  }
  RegexError.new("regular expression compile ran out of memory", nil, RegexErrorKind.memory)
}

// The last match's failure on this thread, as a value; `op` names the
// try_ operation in its message: 0 try_find, 1 try_replace, 2 try_split,
// 3 try_matches, 4 try_count.
fn match_error(op: Int): RegexError {
  kind = RegexErrorKind.from_i(rec.avant_regex_failure_kind()) ?? RegexErrorKind.failed
  RegexError.new(rec.avant_regex_failure_text(op), nil, kind)
}

// Every operation on a closed Regex traps: a use after close is a
// program error, not an honest "no match".
fn regex_closed {
  rec.avant_regex_closed()
}

pub struct Span {
  pub lo: Int
  pub hi: Int
}

// Whether one compiled Regex is still open, in one shared place: a
// Regex is a struct, so each copy of it would carry a flag of its own,
// and a copy of a closed Regex went on to read the handle that close
// had released. Every copy of the value, and every Match it produced,
// points at this one object, the way a Server's copies share their
// HttpState.
//
// `op` is the operation in progress, for the trap of a PCRE2 failure: 0
// find, 1 replace, 2 split, 3 matches. replace, split and matches run on
// find; they say who they are here, so find itself stays the one hot
// path and takes no extra argument.
class RegexState {
  closed: Bool = false
  op: Int = 0
}

pub struct Match {
  text: String
  code: Ptr(Void)
  state: RegexState
  ngroups: Int
  at: Int
  pub start: Int
  pub end: Int
  g1lo: Int
  g1hi: Int
  g2lo: Int
  g2hi: Int
  g3lo: Int
  g3hi: Int

  fn group_lo(i: Int): Int {
    if i == 1 {
      return self.g1lo
    }
    if i == 2 {
      return self.g2lo
    }
    self.g3lo
  }

  fn group_hi(i: Int): Int {
    if i == 1 {
      return self.g1hi
    }
    if i == 2 {
      return self.g2hi
    }
    self.g3hi
  }

  pub fn span(i: Int): Span? {
    if i < 0 || i > self.ngroups {
      return nil
    }
    if i == 0 {
      return Span { lo: self.start, hi: self.end }
    }
    if i <= 3 {
      lo = group_lo(i)
      if lo < 0 {
        return nil
      }
      return Span { lo: lo, hi: group_hi(i) }
    }
    // Groups past the third are read from the pattern again: not after
    // its Regex was closed.
    if self.state.closed {
      regex_closed()
      return nil
    }
    v = rec.avant_regex_span_at(self.code, self.text, self.at, i)
    lo = pair_lo(v)
    if lo < 0 {
      return nil
    }
    Span { lo: lo, hi: pair_hi(v) }
  }

  pub fn group(i: Int): String? {
    if sp = span(i) {
      return self.text[sp.lo..sp.hi]
    }
    nil
  }

  pub fn group(name: String): String? {
    // The name is looked up in the pattern: not after its Regex was closed.
    if self.state.closed {
      regex_closed()
      return nil
    }
    idx = rec.avant_regex_group_index(self.code, name)
    if idx < 0 {
      return nil
    }
    group(idx)
  }

  pub fn group_count: Int {
    self.ngroups
  }
}

fn pair_lo(v: Int): Int {
  (v >> 32).to_i()
}

fn pair_hi(v: Int): Int {
  h = v & 4294967295
  if h >= 2147483648 {
    h -= 4294967296
  }
  h.to_i()
}

fn push_replacement(dst: Buf, repl: String, m: Match) {
  i = 0
  while i < repl.size {
    c = repl[i]
    if c == 36 && i + 1 < repl.size {
      n = repl[i + 1]
      if n == 36 {
        dst.push_byte(36)
        i += 2
      } else if n == 123 {
        j = i + 2
        while j < repl.size && repl[j] != 125 {
          j += 1
        }
        if j < repl.size && j > i + 2 {
          name = repl[i + 2..j]
          if is_digits(name) {
            if k = name.to_i(), g = m.group(k) {
              dst.push_str(g)
            }
          } else {
            if g = m.group(name) {
              dst.push_str(g)
            }
          }
          i = j + 1
        } else {
          dst.push_byte(c)
          i += 1
        }
      } else if n >= 48 && n <= 57 {
        if g = m.group(n - 48) {
          dst.push_str(g)
        }
        i += 2
      } else {
        dst.push_byte(c)
        i += 1
      }
    } else {
      dst.push_byte(c)
      i += 1
    }
  }
}

fn is_digits(s: String): Bool {
  if s.size == 0 {
    return false
  }
  for i in 0..s.size {
    if s[i] < 48 || s[i] > 57 {
      return false
    }
  }
  true
}

// A Regex is a value holding one hold on a compiled pattern, in the
// shape of Json: the struct form is what lets Regex | RegexError open
// with if-assign, since the error must be the union's one class.
// Copies of a Regex value are the same handle and share its open or
// closed state (RegexState): close it once, through any of them, and
// every copy is closed.
pub struct Regex {
  code: Ptr(Void)
  scan: Ptr(Void)
  ngroups: Int
  state: RegexState

  // Compiles `pattern` on PCRE2 with JIT. A pattern written as a string
  // literal may instead be compiled by re2c into a scanner; that path
  // exposes group 0 and group 1 only and has no named groups, so a
  // literal with named groups or more than one group stays on PCRE2.
  // PCRE2 backtracking can be catastrophic on adversarial patterns and
  // texts; the limits bound what one match may take: match_limit the
  // backtracking steps, depth_limit the interpreter's backtracking depth,
  // heap_limit the bytes of a deep match (the JIT's larger stack, the
  // interpreter's frames). A match that reaches one traps in find,
  // count, replace, split and matches, naming the operation (it is
  // never read as "no match"), and is a RegexError from try_find. A
  // limit below 1 traps. A scanner never backtracks: the limits bind
  // what runs on PCRE2.
  pub fn self.compile(pattern: String, caseless: Bool = false, match_limit: Int = 10000000, depth_limit: Int = 10000000, heap_limit: Int = 268435456): Regex | RegexError {
    flags = 0
    if caseless {
      flags = 1
    }
    code = rec.avant_regex_compile(pattern, flags, match_limit, depth_limit, heap_limit)
    status = rec.avant_regex_take_status()
    if status != 0 {
      return regex_error(status)
    }
    Regex { code: code, scan: code, ngroups: rec.avant_regex_groups(code), state: RegexState.new() }
  }

  // Releases this handle's hold on the compiled pattern. The C side may
  // keep the pattern in its bounded cache for the next compile; other
  // handles on the same pattern (other compiles of it) are unaffected.
  // Closing twice, through this value or a copy of it, is a no-op, and
  // every operation on a closed Regex, through any copy, traps; so do a
  // Match's named groups and its groups past the third.
  pub fn close {
    if self.state.closed {
      return
    }
    self.state.closed = true
    rec.avant_regex_release(self.code)
  }

  pub fn is_closed: Bool {
    self.state.closed
  }

  // Runs the block with this Regex and closes it on exit.
  pub fn scoped(body: fn(Regex)) {
    body(self)
    self.close()
  }

  // A PCRE2 failure that is not "no match" (its match, depth or heap
  // limit, no memory) traps, naming the operation in progress; it is
  // never nil. try_find gives it as a value. find builds its Match
  // itself rather than through found: through the helper Template::Regex
  // ran 4.4% more instructions.
  pub fn find(text: String, from: Int = 0): Match? {
    if self.state.closed {
      regex_closed()
      return nil
    }
    p0 = rec.avant_regex_find(self.scan, text, from)
    if p0 < 0 {
      if p0 != -1 {
        rec.avant_regex_failed(self.state.op)
      }
      return nil
    }
    p1 = -1
    p2 = -1
    p3 = -1
    if self.ngroups >= 1 {
      p1 = rec.avant_regex_span_pair(1)
    }
    if self.ngroups >= 2 {
      p2 = rec.avant_regex_span_pair(2)
    }
    if self.ngroups >= 3 {
      p3 = rec.avant_regex_span_pair(3)
    }
    Match {
      text: text,
      code: self.code,
      state: self.state,
      ngroups: self.ngroups,
      at: from,
      start: pair_lo(p0),
      end: pair_hi(p0),
      g1lo: pair_lo(p1),
      g1hi: pair_hi(p1),
      g2lo: pair_lo(p2),
      g2hi: pair_hi(p2),
      g3lo: pair_lo(p3),
      g3hi: pair_hi(p3)
    }
  }

  // find, with a failure as a RegexError (its kind the limit reached)
  // instead of a trap: for a pattern or a text from outside, where one
  // request must not end the program. nil is no match.
  pub fn try_find(text: String, from: Int = 0): Match? | RegexError {
    try_find_as(text, from, 0)
  }

  // try_find for the try_ operation `op` (match_error's codes), whose
  // name a failure's message gives.
  fn try_find_as(text: String, from: Int, op: Int): Match? | RegexError {
    if self.state.closed {
      regex_closed()
      return nil
    }
    p0 = rec.avant_regex_find(self.scan, text, from)
    if p0 < 0 {
      if p0 != -1 {
        return match_error(op)
      }
      return nil
    }
    found(text, from, p0)
  }

  // The try_ twins of count, replace, replace_into, split and matches:
  // a match that reaches a limit is a RegexError, as from try_find,
  // instead of a trap. For a pattern or a text from outside.
  pub fn try_count(text: String): Int | RegexError {
    if self.state.closed {
      regex_closed()
      return 0
    }
    n = rec.avant_regex_try_count(self.code, text)
    if n < 0 {
      return match_error(4)
    }
    n
  }

  pub fn try_replace(text: String, repl: String): String | RegexError {
    buf = Buf.new()
    if err = try_replace_buf(buf, text, repl) {
      return err
    }
    buf.to_s()
  }

  // On a failure dst is left as it was: the text is built apart and
  // appended once every match has been found.
  pub fn try_replace_into(dst: Buf, text: String, repl: String): RegexError? {
    buf = Buf.new()
    if err = try_replace_buf(buf, text, repl) {
      return err
    }
    dst.push_str(buf)
    nil
  }

  fn try_replace_buf(dst: Buf, text: String, repl: String): RegexError? {
    if self.state.closed {
      regex_closed()
      return nil
    }
    last = 0
    at = 0
    while at <= text.size {
      switch try_find_as(text, at, 1) {
        case e: RegexError {
          return e
        }
        case m: Match {
          dst.push_slice(text, last, m.start)
          push_replacement(dst, repl, m)
          last = m.end
          if m.end == m.start {
            if m.end < text.size {
              dst.push_slice(text, m.end, m.end + 1)
              last = m.end + 1
              at = m.end + 1
            } else {
              at = text.size + 1
            }
          } else {
            at = m.end
          }
        }
        else {
          break
        }
      }
    }
    dst.push_slice(text, last, text.size)
    nil
  }

  pub fn try_split(text: String): Array(String) | RegexError {
    parts: Array(String) = []
    if self.state.closed {
      regex_closed()
      return parts
    }
    last = 0
    at = 0
    while at <= text.size {
      switch try_find_as(text, at, 2) {
        case e: RegexError {
          return e
        }
        case m: Match {
          if m.end == m.start {
            at = m.end + 1
          } else {
            parts.push(text[last..m.start])
            last = m.end
            at = m.end
          }
        }
        else {
          break
        }
      }
    }
    parts.push(text[last..])
    parts
  }

  // Each match in turn, as matches gives them; a failure is the
  // RegexError of next, which then ends the walk:
  // `while m = it.next() { ... } else e { ... }`.
  pub fn try_matches(text: String): TryMatchIter {
    TryMatchIter.new(self, text)
  }

  // The Match of a find that succeeded: p0 is its packed whole span, the
  // groups are read from this thread's last match.
  fn found(text: String, from: Int, p0: Int): Match {
    p1 = -1
    p2 = -1
    p3 = -1
    if self.ngroups >= 1 {
      p1 = rec.avant_regex_span_pair(1)
    }
    if self.ngroups >= 2 {
      p2 = rec.avant_regex_span_pair(2)
    }
    if self.ngroups >= 3 {
      p3 = rec.avant_regex_span_pair(3)
    }
    Match {
      text: text,
      code: self.code,
      state: self.state,
      ngroups: self.ngroups,
      at: from,
      start: pair_lo(p0),
      end: pair_hi(p0),
      g1lo: pair_lo(p1),
      g1hi: pair_hi(p1),
      g2lo: pair_lo(p2),
      g2hi: pair_hi(p2),
      g3lo: pair_lo(p3),
      g3hi: pair_hi(p3)
    }
  }

  pub fn count(text: String): Int {
    if self.state.closed {
      regex_closed()
      return 0
    }
    rec.avant_regex_count(self.code, text)
  }

  pub fn matches(text: String): MatchIter {
    MatchIter.new(self, text)
  }

  // Replaces every non-overlapping match. In `repl`, `$1` to `$9`,
  // `${1}`, and `${name}` insert a group (nothing when the group did
  // not participate), and `$$` is a literal dollar.
  pub fn replace(text: String, repl: String): String {
    buf = Buf.new()
    replace_into(buf, text, repl)
    buf.to_s()
  }

  pub fn replace_into(dst: Buf, text: String, repl: String) {
    if self.state.closed {
      regex_closed()
      return
    }
    last = 0
    at = 0
    self.state.op = 1
    while at <= text.size {
      if m = find(text, at) {
        dst.push_slice(text, last, m.start)
        push_replacement(dst, repl, m)
        last = m.end
        if m.end == m.start {
          if m.end < text.size {
            dst.push_slice(text, m.end, m.end + 1)
            last = m.end + 1
            at = m.end + 1
          } else {
            at = text.size + 1
          }
        } else {
          at = m.end
        }
      } else {
        break
      }
    }
    self.state.op = 0
    dst.push_slice(text, last, text.size)
  }

  // Splits on every non-overlapping match, keeping empty pieces, in
  // the shape of String.split. Empty-width matches are not split
  // points; their bytes stay in the surrounding piece.
  pub fn split(text: String): Array(String) {
    parts: Array(String) = []
    if self.state.closed {
      regex_closed()
      return parts
    }
    last = 0
    at = 0
    self.state.op = 2
    while at <= text.size {
      if m = find(text, at) {
        if m.end == m.start {
          at = m.end + 1
        } else {
          parts.push(text[last..m.start])
          last = m.end
          at = m.end
        }
      } else {
        break
      }
    }
    self.state.op = 0
    parts.push(text[last..])
    parts
  }
}

pub class MatchIter {
  re: Regex
  text: String
  at: Int = 0
  done: Bool = false

  fn initialize(re: Regex, text: String) {
    self.re = re
    self.text = text
  }

  pub fn next: Match? {
    if self.done {
      return nil
    }
    self.re.state.op = 3
    found = self.re.find(self.text, self.at)
    self.re.state.op = 0
    if m = found {
      if m.end == m.start {
        self.at = m.end + 1
      } else {
        self.at = m.end
      }
      if self.at > self.text.size {
        self.done = true
      }
      return m
    }
    self.done = true
    nil
  }
}

pub class TryMatchIter {
  re: Regex
  text: String
  at: Int = 0
  done: Bool = false

  fn initialize(re: Regex, text: String) {
    self.re = re
    self.text = text
  }

  pub fn next: Match? | RegexError {
    if self.done {
      return nil
    }
    switch self.re.try_find_as(self.text, self.at, 3) {
      case e: RegexError {
        self.done = true
        return e
      }
      case m: Match {
        if m.end == m.start {
          self.at = m.end + 1
        } else {
          self.at = m.end
        }
        if self.at > self.text.size {
          self.done = true
        }
        return m
      }
      else {
        self.done = true
        return nil
      }
    }
  }
}

fn regex_from_re2c(id: Int, groups: Int, pattern: String, caseless: Bool, match_limit: Int, depth_limit: Int, heap_limit: Int): Regex | RegexError {
  flags = 0
  if caseless {
    flags = 1
  }
  code = rec.avant_regex_compile(pattern, flags, match_limit, depth_limit, heap_limit)
  status = rec.avant_regex_take_status()
  if status != 0 {
    return regex_error(status)
  }
  Regex { code: code, scan: rec.avant_re2c_handle(id), ngroups: groups, state: RegexState.new() }
}
