// std.sync: what tasks share.
//
//   Channel(T)   passes values from task to task. Channel(T).new is a
//                rendezvous channel (a send waits for its receive);
//                Channel(T).new(n) holds up to n values. send(value)
//                sends, recv returns T? (nil once the channel is closed
//                and empty, so `while v = ch.recv { ... }` drains it),
//                close closes it. send returns whether the value went
//                into the channel: on a closed channel it returns false
//                at once, buffered or not, full or not, and a send
//                waiting for room or for its receiver returns false when
//                the channel closes. The values sent before
//                the close stay for the receivers to drain.
//   Mutex(T)     guards one value. `m.with { |x| ... }` holds the lock
//                for the block, x naming the guarded value; the form is
//                the compiler's (checker.av check_mutex_with, the
//                lowering in mir/lower_task.av), on this class's two
//                fields, and its rules (what may leave the block, as
//                its value or by a statement) are checker/guard.av's.
//
// Both stand on the runtime's gates (runtime/avant_task.c): a gate is a
// word in the object's `gate` field, which the gate builtins take (the
// compiler passes the field's address); an uncontended lock and unlock
// are one atomic operation each on that word, and the runtime keeps
// state for a gate only while a thread waits on it, so nothing is
// allocated per object and nothing needs freeing. The gate builtins
// (avant_gate_new, lock, unlock, wait, broadcast) are names of `std`
// modules only.
//
// T is any type: the slots are T?, so a class or another Channel or
// Mutex is an element like an Int. What a send may carry is the rule
// for what crosses a task (checker/guard.av check_send).

pub class Channel(T) {
  slots: Array(T?)
  cap: Int
  count: Int
  head: Int
  closed: Bool
  has: Bool
  // A rendezvous channel's sends that put a value into cell, and its
  // receives that took one: a sender waits until its own value is taken.
  sent: Int
  taken: Int
  gate: UInt64
  cell: T?

  fn initialize(n: Int = 0) {
    self.cap = n
    self.gate = avant_gate_new()
    self.slots = Array(T?).new(n)
  }

  pub fn send(value: T): Bool {
    avant_gate_lock(gate)
    ok = false
    if cap == 0 {
      while has && !closed {
        avant_gate_wait(gate)
      }
      if !closed {
        self.cell = value
        self.has = true
        self.sent = sent + 1
        mine = sent
        avant_gate_broadcast(gate)
        while taken < mine && !closed {
          avant_gate_wait(gate)
        }
        if taken >= mine {
          ok = true
        } else {
          // Closed before a receiver took it: the value goes back.
          self.cell = nil
          self.has = false
          avant_gate_broadcast(gate)
        }
      }
    } else {
      while count == cap && !closed {
        avant_gate_wait(gate)
      }
      if !closed {
        slots[(head + count) % cap] = value
        self.count = count + 1
        avant_gate_broadcast(gate)
        ok = true
      }
    }
    avant_gate_unlock(gate)
    ok
  }

  pub fn recv: T? {
    avant_gate_lock(gate)
    got: T? = nil
    if cap == 0 {
      while !has && !closed {
        avant_gate_wait(gate)
      }
      if has {
        got = cell
        self.cell = nil
        self.has = false
        self.taken = taken + 1
        avant_gate_broadcast(gate)
      }
    } else {
      while count == 0 && !closed {
        avant_gate_wait(gate)
      }
      if count > 0 {
        got = slots[head]
        slots[head] = nil
        self.head = (head + 1) % cap
        self.count = count - 1
        avant_gate_broadcast(gate)
      }
    }
    avant_gate_unlock(gate)
    got
  }

  pub fn close {
    avant_gate_lock(gate)
    self.closed = true
    avant_gate_broadcast(gate)
    avant_gate_unlock(gate)
  }
}

pub class Mutex(T) {
  cell: T
  gate: UInt64
  // The function that rebuilds the value of a poisoned mutex
  // (`recover:`), or nil: read only when a lock finds the poison. Held
  // in an object of its own, so a mutex without one carries one word.
  heal: MutexHeal(T)? = nil

  fn initialize(value: T, recover: (fn(): T)? = nil) {
    self.cell = value
    self.gate = avant_gate_new()
    if f = recover {
      self.heal = MutexHeal(T).new(f)
    }
  }

  // Whether a task or an HTTP handler trapped while it held this mutex in `with`: its value
  // may be half-changed, so `with` on it traps and `try_with` gives a
  // MutexError, unless the mutex has a recover function.
  pub fn poisoned: Bool {
    avant_gate_poisoned(gate)
  }

  // Replaces the value and clears the poison, under the lock.
  pub fn recover(value: T) {
    avant_gate_lock(gate)
    self.cell = value
    avant_gate_clear_poison(gate)
    avant_gate_unlock(gate)
  }

  // Clears the poison, keeping the value as the trapped task left it.
  pub fn clear_poison {
    avant_gate_lock(gate)
    avant_gate_clear_poison(gate)
    avant_gate_unlock(gate)
  }

  // A `with` or `try_with` that finds the mutex poisoned calls this under
  // the lock (the lowering, mir/lower_task.av): with a recover function
  // the value is rebuilt and the poison cleared, and the block runs;
  // without one it returns false, and the lock traps or gives the error.
  // A trap inside the recover function leaves the mutex poisoned.
  pub fn __avant_heal: Bool {
    if h = heal {
      self.cell = h.rebuild()
      avant_gate_clear_poison(gate)
      return true
    }
    false
  }
}

// A Mutex's recover function.
class MutexHeal(T) {
  f: fn(): T

  fn initialize(f: fn(): T) {
    self.f = f
  }

  fn rebuild: T {
    g = f
    g()
  }
}

// What `m.try_with { }` gives on a poisoned mutex without a recover function.
pub enum MutexError: Error {
  poisoned
  pub fn message: String {
    "the mutex is poisoned: a task or an HTTP handler trapped while it held it, so its value may be half-changed"
  }
}

// The value `try_with` gives on a poisoned mutex (the lowering calls it).
pub fn __avant_mutex_poisoned: MutexError {
  MutexError.poisoned
}

// The thread pool's size: at most this many tasks run at once, and
// http.listen without loops: runs this many event loops. It is
// --avant-threads=N when the program was started with it, else the CPUs
// the process may use. set_pool_size(n) sets it, 1 to 1024, so a program
// that has its own option (--threads, a config file) passes the number
// on. The size is fixed once the pool starts (the first spawn or
// .parallel) or http.listen without loops: reads it; a set after that
// traps, as does a size out of range, so a program never runs on a size
// it did not get (runtime/avant_task.c, avant_set_pool_size).
lib pool_rt {
  fun avant_chosen_threads: Int
  fun avant_set_pool_size(n: Int)
}

pub fn pool_size: Int {
  pool_rt.avant_chosen_threads()
}

pub fn set_pool_size(n: Int) {
  pool_rt.avant_set_pool_size(n)
}
