lib jsonc {
  fun avant_json_parse(text: String, max_depth: Int, max_bytes: Int, max_entries: Int): Ptr(Void)
  fun avant_json_take_status: Int
  fun avant_json_take_pool: Bytes
  fun avant_json_root(doc: Ptr(Void)): Ptr(Void)
  fun avant_json_kind(node: Ptr(Void)): Int
  fun avant_json_get(node: Ptr(Void), key: String): Ptr(Void)?
  fun avant_json_at(node: Ptr(Void), index: Int): Ptr(Void)?
  fun avant_json_first(node: Ptr(Void)): Ptr(Void)?
  fun avant_json_next(node: Ptr(Void)): Ptr(Void)?
  fun avant_json_first_key(node: Ptr(Void)): Ptr(Void)?
  fun avant_json_obj_size(node: Ptr(Void)): Int
  fun avant_json_arr_size(node: Ptr(Void)): Int
  fun avant_json_len(node: Ptr(Void)): Int
  fun avant_json_as_int(node: Ptr(Void)): Int
  fun avant_json_obj_int(node: Ptr(Void), key: String): Int
  fun avant_json_as_f64(node: Ptr(Void)): Float64
  fun avant_json_obj_f64(node: Ptr(Void), key: String): Float64
  fun avant_json_as_bool(node: Ptr(Void)): Int
  fun avant_json_obj_bool(node: Ptr(Void), key: String): Int
  fun avant_json_as_str(node: Ptr(Void)): String
  fun avant_json_obj_str(node: Ptr(Void), key: String): String
  fun avant_json_key_at(node: Ptr(Void), index: Int): String
  fun avant_json_text(node: Ptr(Void)): String
  fun avant_json_error_text: String
  fun avant_json_error_offset: Int
  fun avant_json_error_count: Int
  fun avant_json_error_limit: Int
  fun avant_json_write_str(buf: Buf, s: String)
  fun avant_json_write_f64(buf: Buf, v: Float64): Int
  fun avant_json_ord_begin(node: Ptr(Void)): Int
  fun avant_json_ord_get(node: Ptr(Void), key: String): Ptr(Void)?
  fun avant_json_ord_int(node: Ptr(Void), key: String): Int
  fun avant_json_ord_f64(node: Ptr(Void), key: String): Float64
  fun avant_json_ord_bool(node: Ptr(Void), key: String): Int
  fun avant_json_ord_str(node: Ptr(Void), key: String): String
  fun avant_json_ord_mark(node: Ptr(Void)): Ptr(Void)
  fun avant_json_ord_resume(node: Ptr(Void), cur: Ptr(Void))
}

// What a JSON value is: Json.kind and JsonValue.kind. The values are
// the runtime's codes (avant_json_kind), whose 0 is "no value": a
// Json always holds one.
pub enum JsonKind {
  null = 1
  bool
  int
  float
  str
  arr
  obj
}

// A document that does not parse: the message says what yyjson found
// and where ("invalid JSON at byte 7: unexpected character"); offset is
// that byte offset, nil when the error has none.
pub class JsonError: Error {
  pub message: String
  pub offset: Int? = nil

  fn initialize(message: String, offset: Int? = nil) {
    self.message = message
    self.offset = offset
  }
}

fn json_error(code: Int): JsonError {
  if code == 1 {
    off = jsonc.avant_json_error_offset().to_i()
    return JsonError.new("invalid JSON at byte ${off}: ${jsonc.avant_json_error_text()}", off)
  }
  limit_error(code)
}

// A JSON value copied out of its document (Json.to_value). An object's
// members are in members, a Hash by name, in the document's order (a
// Hash keeps the order of insertion); a name that repeats keeps its
// first value and its first place, as get on the document does.
pub class JsonValue {
  pub kind: JsonKind = JsonKind.null
  pub int_val: Int = 0
  pub f64_val: Float64 = 0.0
  pub str_val: String = ""
  pub bool_val: Bool = false
  pub arr: Array(JsonValue) = []
  pub members: Hash(String, JsonValue) = Hash(String, JsonValue).new()

  pub fn get(key: String): JsonValue? {
    self.members[key]
  }
}

pub struct Json {
  node: Ptr(Void)
  pool: Bytes

  pub fn self.parse(text: String, max_depth: Int = 256, max_bytes: Int? = nil, max_entries: Int? = nil): Json | JsonError {
    doc = jsonc.avant_json_parse(text, parse_limit("max_depth", max_depth), parse_limit_or_none("max_bytes", max_bytes), parse_limit_or_none("max_entries", max_entries))
    code = jsonc.avant_json_take_status()
    if code != 0 {
      return json_error(code)
    }
    pool = jsonc.avant_json_take_pool()
    Json { node: jsonc.avant_json_root(doc), pool: pool }
  }

  // A JsonBuilder with an object open (Json.object) or an array open
  // (Json.array). The starts are not named obj and arr: arr is a parsed
  // value's elements, and a type-level function cannot share a method's
  // name and parameters.
  pub fn self.object: JsonBuilder {
    b = JsonBuilder.new()
    b.obj()
    b
  }

  pub fn self.array: JsonBuilder {
    b = JsonBuilder.new()
    b.arr()
    b
  }

  pub fn kind: JsonKind {
    // A Json's node is a value (get, at and the iterator give nil when
    // the runtime finds no node), so the fallback is never taken.
    JsonKind.from_i(jsonc.avant_json_kind(self.node)) ?? JsonKind.null
  }

  // The is_* tests compare the runtime's code with the member's value
  // rather than build a JsonKind? through kind: measured on a JSON walk,
  // +0.02% instructions this way against +6.7% through kind.
  pub fn is_null: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.null.to_i()
  }

  pub fn is_bool: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.bool.to_i()
  }

  pub fn is_int: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.int.to_i()
  }

  pub fn is_float: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.float.to_i()
  }

  pub fn is_str: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.str.to_i()
  }

  pub fn is_arr: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.arr.to_i()
  }

  pub fn is_obj: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.obj.to_i()
  }

  pub fn len: Int {
    jsonc.avant_json_len(self.node)
  }

  // The runtime gives a null node for a member, an element or a value
  // that is not there: Ptr(Void)?, nil.
  pub fn get(key: String): Json? {
    child_node = jsonc.avant_json_get(self.node, key) ?? return nil
    Json { node: child_node, pool: self.pool }
  }

  pub fn at(index: Int): Json? {
    child_node = jsonc.avant_json_at(self.node, index) ?? return nil
    Json { node: child_node, pool: self.pool }
  }

  pub fn first: Json? {
    child_node = jsonc.avant_json_first(self.node) ?? return nil
    Json { node: child_node, pool: self.pool }
  }

  // The elements of this value, when it is an array; nil for any other
  // value (an object, a string, a number, a Bool or null), so a walk
  // over what is not a list is never an empty walk.
  pub fn arr: JsonIter? {
    if jsonc.avant_json_kind(self.node) != JsonKind.arr.to_i() {
      return nil
    }
    JsonIter.new(self.node, self.pool, self.len())
  }

  // The elements of the member `key`, when it is there and is an array;
  // nil otherwise.
  pub fn arr(key: String): JsonIter? {
    child_node = jsonc.avant_json_get(self.node, key) ?? return nil
    if jsonc.avant_json_kind(child_node) != JsonKind.arr.to_i() {
      return nil
    }
    JsonIter.new(child_node, self.pool, jsonc.avant_json_len(child_node))
  }

  // The members of this value, when it is an object: each name with its
  // value, in the document's order, one step per member (key_at(i) and
  // at(i) each walk from the first member, so a loop over them reads
  // n*n/2). A name given twice is given twice, where get reads its first.
  // nil for any other value, as arr is.
  pub fn members: JsonMembers? {
    n = jsonc.avant_json_obj_size(self.node)
    if n < 0 {
      return nil
    }
    JsonMembers.new(self.node, self.pool, n)
  }

  // The members of the member `key`, when it is there and is an object;
  // nil otherwise.
  pub fn members(key: String): JsonMembers? {
    child_node = jsonc.avant_json_get(self.node, key) ?? return nil
    n = jsonc.avant_json_obj_size(child_node)
    if n < 0 {
      return nil
    }
    JsonMembers.new(child_node, self.pool, n)
  }

  pub fn key_at(index: Int): String? {
    key = jsonc.avant_json_key_at(self.node, index)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    key
  }

  pub fn int: Int? {
    v = jsonc.avant_json_as_int(self.node)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn int(key: String): Int? {
    v = jsonc.avant_json_obj_int(self.node, key)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  // The runtime gives NaN for a value that is not a number: a JSON
  // number is never NaN (the reader refuses NaN and the infinities), so
  // one call answers, with no status to take.
  pub fn f64: Float64? {
    v = jsonc.avant_json_as_f64(self.node)
    if v != v {
      return nil
    }
    v
  }

  pub fn f64(key: String): Float64? {
    v = jsonc.avant_json_obj_f64(self.node, key)
    if v != v {
      return nil
    }
    v
  }

  pub fn str: String? {
    v = jsonc.avant_json_as_str(self.node)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn str(key: String): String? {
    v = jsonc.avant_json_obj_str(self.node, key)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn bool: Bool? {
    v = jsonc.avant_json_as_bool(self.node)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v != 0
  }

  pub fn bool(key: String): Bool? {
    v = jsonc.avant_json_obj_bool(self.node, key)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v != 0
  }

  pub fn text: String {
    jsonc.avant_json_text(self.node)
  }

  pub fn to_value: JsonValue {
    v = JsonValue.new()
    v.kind = self.kind()
    if self.is_int() {
      // An integer beyond Int keeps its value as a float.
      if i = self.int() {
        v.int_val = i
      } else {
        v.kind = JsonKind.float
        v.f64_val = self.f64() ?? 0.0
      }
    } else if self.is_float() {
      v.f64_val = self.f64() ?? 0.0
    } else if self.is_str() {
      v.str_val = self.str() ?? ""
    } else if self.is_bool() {
      v.bool_val = self.bool() ?? false
    } else if self.is_arr() {
      // One sibling step per element: at(i) walks from the first element
      // when the array holds containers, so a loop over i read n*n/2.
      if elems = self.arr() {
        for child in elems {
          v.arr.push(child.to_value())
        }
      }
    } else if self.is_obj() {
      // One pass over the members, name then value, in the document's
      // order: key_at(i) and get(key) each walked from the first member,
      // so an object of n members (an untrusted request body) cost n*n
      // steps. The first of a repeated name keeps its value and place.
      n = self.len()
      key = jsonc.avant_json_first_key(self.node)
      i = 0
      while kn = key {
        name = jsonc.avant_json_as_str(kn)
        key = nil
        if vn = jsonc.avant_json_next(kn) {
          if !v.members.has(name) {
            child = Json { node: vn, pool: self.pool }
            v.members[name] = child.to_value()
          }
          i += 1
          if i < n {
            key = jsonc.avant_json_next(vn)
          }
        }
      }
    }
    v
  }
}

pub class JsonIter {
  arr: Ptr(Void)
  cur: Ptr(Void)
  idx: Int = 0
  max: Int = 0
  pool: Bytes

  fn initialize(arr: Ptr(Void), pool: Bytes, max: Int) {
    self.arr = arr
    self.cur = arr
    self.pool = pool
    self.max = max
  }

  pub fn next: Json? {
    if self.idx >= self.max {
      return nil
    }
    step: Ptr(Void)? = nil
    if self.idx == 0 {
      step = jsonc.avant_json_first(self.arr)
    } else {
      step = jsonc.avant_json_next(self.cur)
    }
    self.idx += 1
    node = step ?? return nil
    self.cur = node
    Json { node: node, pool: self.pool }
  }
}

// One member of an object, as Json.members gives it.
pub struct JsonMember {
  pub name: String
  pub value: Json
}

// An object's members in the document's order. The name node of the
// next member is held (the node after a name is its value, the node
// after that value the next name); the count of members left keeps the
// walk from stepping past the object's last value.
pub class JsonMembers {
  cur: Ptr(Void)
  left: Int = 0
  pool: Bytes

  fn initialize(obj: Ptr(Void), pool: Bytes, n: Int) {
    self.cur = obj
    self.pool = pool
    self.left = n
    if n > 0 {
      if first = jsonc.avant_json_first_key(obj) {
        self.cur = first
      } else {
        self.left = 0
      }
    }
  }

  pub fn next: JsonMember? {
    if self.left <= 0 {
      return nil
    }
    kn = self.cur
    vn = jsonc.avant_json_next(kn) ?? return nil
    self.left -= 1
    if self.left > 0 {
      if nk = jsonc.avant_json_next(vn) {
        self.cur = nk
      } else {
        self.left = 0
      }
    }
    JsonMember { name: jsonc.avant_json_as_str(kn), value: Json { node: vn, pool: self.pool } }
  }
}

// s as a JSON string, quoted: " and \ escaped, \n, \r and \t by their
// short escapes, any other byte below 0x20 as \u00XX, every other byte
// as it is. The runtime scans s once and copies its runs whole.
fn builder_escape(buf: Buf, s: String) {
  jsonc.avant_json_write_str(buf, s)
}

pub class JsonBuilder {
  buf: Buf = Buf.new()
  // The open containers, innermost last, each as its JsonKind's code
  // (JsonKind.obj or JsonKind.arr, to_i), and how many values each holds
  // so far. An Array(JsonKind) reads the same, but its push takes the
  // collector's write-barrier test that an Int's push does not: +0.8%
  // instructions on a builder loop.
  stack: Array(Int) = []
  counts: Array(Int) = []
  pending: Bool = false
  root_done: Bool = false

  pub fn self.into(dst: Buf): JsonBuilder {
    b = JsonBuilder.new()
    b.buf = dst
    b
  }

  fn before_value {
    if self.stack.size == 0 {
      self.root_done = true
      return
    }
    top = self.stack[self.stack.size - 1]
    if top == JsonKind.arr.to_i() {
      if self.counts[self.counts.size - 1] > 0 {
        self.buf.push_str(",")
      }
      self.counts[self.counts.size - 1] = self.counts[self.counts.size - 1] + 1
    } else {
      self.pending = false
    }
  }

  pub fn obj: JsonBuilder {
    self.before_value()
    self.buf.push_str("{")
    self.stack.push(JsonKind.obj.to_i())
    self.counts.push(0)
    self
  }

  pub fn arr: JsonBuilder {
    self.before_value()
    self.buf.push_str("[")
    self.stack.push(JsonKind.arr.to_i())
    self.counts.push(0)
    self
  }

  pub fn end: JsonBuilder {
    if self.stack.size == 0 {
      panic("json.JsonBuilder.end: nothing open")
      return self
    }
    top = self.stack[self.stack.size - 1]
    self.stack.pop()
    self.counts.pop()
    if top == JsonKind.obj.to_i() {
      self.buf.push_str("}")
    } else {
      self.buf.push_str("]")
    }
    self
  }

  pub fn key(name: String): JsonBuilder {
    if self.stack.size == 0 || self.stack[self.stack.size - 1] != JsonKind.obj.to_i() {
      panic("json.JsonBuilder.key: not inside an object")
      return self
    }
    if self.counts[self.counts.size - 1] > 0 {
      self.buf.push_str(",")
    }
    self.counts[self.counts.size - 1] = self.counts[self.counts.size - 1] + 1
    builder_escape(self.buf, name)
    self.buf.push_str(":")
    self.pending = true
    self
  }

  // A value of any type json.encode writes (an Int, a Float64, a String,
  // a Bool, nil, an optional, an Array, a Hash(String, V), a struct or a
  // class by its pub fields, an enum, a Json, a JsonValue, another
  // JsonBuilder), written as json.encode writes it, into this builder's
  // text; nil writes null (`set(name, nil)`, `add(nil)`).
  pub fn value(v: T): JsonBuilder {
    self.before_value()
    encode_into(self.buf, v)
    self
  }

  pub fn add(v: T): JsonBuilder {
    value(v)
  }

  pub fn set(name: String, v: T): JsonBuilder {
    key(name)
    value(v)
  }

  pub fn to_s: String {
    if self.stack.size > 0 {
      panic("json.JsonBuilder.to_s: ${self.stack.size} containers still open")
    }
    self.buf.to_s()
  }
}

// A parse's limit, checked (1 or more) and given to the runtime.
fn parse_limit(name: String, n: Int): Int {
  if n < 1 {
    panic("json.Json.parse: ${name} ${n} is below 1")
  }
  n
}

// An optional limit: -1, none, when it is nil.
fn parse_limit_or_none(name: String, n: Int?): Int {
  if v = n {
    return parse_limit(name, v)
  }
  -1
}

// A parse refused for a limit, or out of memory (json_error's codes 2
// to 5, the runtime's).
fn limit_error(code: Int): JsonError {
  limit = jsonc.avant_json_error_limit()
  if code == 3 {
    off = jsonc.avant_json_error_offset().to_i()
    return JsonError.new("JSON nested deeper than max_depth ${limit} at byte ${off}", off)
  }
  if code == 4 {
    return JsonError.new("JSON document of ${jsonc.avant_json_error_count()} values is over max_entries ${limit}")
  }
  if code == 5 {
    return JsonError.new("JSON text of ${jsonc.avant_json_error_count()} bytes is over max_bytes ${limit}")
  }
  JsonError.new("JSON parse ran out of memory")
}

// The typed decode and encode (json.decode, json.encode and
// json.encode_into) are written by the compiler for each type from its
// fields, in this module; these are the pieces that code calls. A
// function of this module named codec_* is lowered only when a call
// reaches it, so a program that never decodes nor encodes pays nothing
// for them.
//

// A decode error is built from the inside out: the value that fails
// gives ": expected an integer, found \"7\"", each container on the way
// up puts its step in front (".age", "[2]", ".items"), and the call's
// own function adds "at $": "at $.items[2].age: expected an integer,
// found a string". Nothing of the path is built until something fails.

// What a node holds, for a message: a scalar as its JSON text, a string,
// an array and an object by kind.
fn codec_found(n: Ptr(Void)): String {
  k = jsonc.avant_json_kind(n)
  if k == JsonKind.str.to_i() {
    return "a string"
  }
  if k == JsonKind.arr.to_i() {
    return "an array"
  }
  if k == JsonKind.obj.to_i() {
    return "an object"
  }
  jsonc.avant_json_text(n)
}

fn codec_wrong(n: Ptr(Void), want: String): JsonError {
  JsonError.new(": expected ${want}, found ${codec_found(n)}")
}

// A member's step in a path: `.name` for a name that reads as one,
// `["a b"]` (escaped as JSON) for any other.
fn codec_step(key: String): String {
  plain = key.size > 0
  for c in key.bytes {
    if !(c == 95 || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)) {
      plain = false
    }
  }
  if plain && !(key[0] >= 48 && key[0] <= 57) {
    return ".${key}"
  }
  b = Buf.new()
  b.push_str("[")
  builder_escape(b, key)
  b.push_str("]")
  b.to_s()
}

fn codec_at_key(e: JsonError, key: String): JsonError {
  e.message = codec_step(key) + e.message
  e
}

fn codec_at_index(e: JsonError, i: Int): JsonError {
  e.message = "[${i}]" + e.message
  e
}

fn codec_missing(key: String): JsonError {
  JsonError.new("${codec_step(key)}: missing member")
}

// The first member of the object j whose name is not one of known, as
// an error; nil when every name is known (a name given twice: the first
// is the one read, as get reads it).
fn codec_unknown(j: Json, known: Array(String)): JsonError? {
  key = jsonc.avant_json_first_key(j.node)
  i = 0
  while kn = key {
    k = jsonc.avant_json_as_str(kn)
    if !known.has(k) {
      return JsonError.new("${codec_step(k)}: unknown member (ignore_unknown: true skips unknown members)")
    }
    i += 1
    key = nil
    if i < jsonc.avant_json_len(j.node) {
      if vn = jsonc.avant_json_next(kn) {
        key = jsonc.avant_json_next(vn)
      }
    }
  }
  nil
}

fn codec_bad_member(s: String, names: String): JsonError {
  b = Buf.new()
  builder_escape(b, s)
  JsonError.new(": expected one of ${names}, found ${b.to_s()}")
}

// The error of a decode, as the program reads it.
fn codec_done(e: JsonError): JsonError {
  e.message = "at $" + e.message
  e
}

fn codec_dec_int(j: Json): Int | JsonError {
  v = jsonc.avant_json_as_int(j.node)
  if jsonc.avant_json_take_status() != 0 {
    return codec_wrong(j.node, "an integer")
  }
  v
}

fn codec_dec_f64(j: Json): Float64 | JsonError {
  v = jsonc.avant_json_as_f64(j.node)
  if v != v {
    return codec_wrong(j.node, "a number")
  }
  v
}

fn codec_dec_str(j: Json): String | JsonError {
  v = jsonc.avant_json_as_str(j.node)
  if jsonc.avant_json_take_status() != 0 {
    return codec_wrong(j.node, "a string")
  }
  v
}

fn codec_dec_bool(j: Json): Bool | JsonError {
  v = jsonc.avant_json_as_bool(j.node)
  if jsonc.avant_json_take_status() != 0 {
    return codec_wrong(j.node, "true or false")
  }
  v != 0
}

fn codec_dec_json(j: Json): Json | JsonError {
  j
}

fn codec_dec_value(j: Json): JsonValue | JsonError {
  j.to_value()
}

// The float's text written into b by the runtime, with no String made
// for it; NaN and the infinities have no JSON text, as for a JsonBuilder.
fn codec_enc_f64(b: Buf, v: Float64) {
  if jsonc.avant_json_write_f64(b, v) != 0 {
    panic("json.encode: ${v} is not a JSON number; write null or a string for it")
  }
}

fn codec_enc_bool(b: Buf, v: Bool) {
  if v {
    b.push_str("true")
  } else {
    b.push_str("false")
  }
}

// A JsonValue tree written as JSON text, an object's members in their
// order.
fn codec_enc_value(b: Buf, v: JsonValue) {
  switch v.kind {
    case null { b.push_str("null") }
    case bool { codec_enc_bool(b, v.bool_val) }
    case int { b.push_fmt_i(v.int_val) }
    case float { codec_enc_f64(b, v.f64_val) }
    case str { builder_escape(b, v.str_val) }
    case arr {
      b.push_str("[")
      i = 0
      for e in v.arr {
        if i > 0 {
          b.push_str(",")
        }
        codec_enc_value(b, e)
        i += 1
      }
      b.push_str("]")
    }
    case obj {
      b.push_str("{")
      first = true
      for k, m in v.members {
        if !first {
          b.push_str(",")
        }
        first = false
        builder_escape(b, k)
        b.push_str(":")
        codec_enc_value(b, m)
      }
      b.push_str("}")
    }
  }
}
