lib jsonc {
  fun avant_json_parse(text: String): Ptr(Void)
  fun avant_json_take_status: Int
  fun avant_json_take_pool: Bytes
  fun avant_json_root(doc: Ptr(Void)): Ptr(Void)
  fun avant_json_kind(node: Ptr(Void)): Int
  fun avant_json_get(node: Ptr(Void), key: String): Ptr(Void)
  fun avant_json_at(node: Ptr(Void), index: Int): Ptr(Void)
  fun avant_json_first(node: Ptr(Void)): Ptr(Void)
  fun avant_json_next(node: Ptr(Void)): Ptr(Void)
  fun avant_json_len(node: Ptr(Void)): Int
  fun avant_json_as_int(node: Ptr(Void)): Int
  fun avant_json_obj_int(node: Ptr(Void), key: String): Int
  fun avant_json_as_f64(node: Ptr(Void)): Float64
  fun avant_json_obj_f64(node: Ptr(Void), key: String): Float64
  fun avant_json_as_bool(node: Ptr(Void)): Int
  fun avant_json_obj_bool(node: Ptr(Void), key: String): Int
  fun avant_json_as_str(node: Ptr(Void)): String
  fun avant_json_obj_str(node: Ptr(Void), key: String): String
  fun avant_json_key_at(node: Ptr(Void), index: Int): String
  fun avant_json_text(node: Ptr(Void)): String
  fun avant_json_error_text: String
  fun avant_json_error_offset: Int
  fun avant_json_misuse(what: String)
}

// What a JSON value is: Json.kind and JsonValue.kind. The values are
// the runtime's codes (avant_json_kind), whose 0 is "no value": a
// Json always holds one.
pub enum JsonKind {
  null = 1
  bool
  int
  float
  str
  arr
  obj
}

// avant_json_kind of a node that is not there (a missing key, an index
// past the end, the end of an iteration).
const no_value = 0

// A document that does not parse: the message says what yyjson found
// and where ("invalid JSON at byte 7: unexpected character"); offset is
// that byte offset, nil when the error has none.
pub class JsonError: Error {
  pub message: String
  pub offset: Int? = nil

  fn initialize(message: String, offset: Int? = nil) {
    self.message = message
    self.offset = offset
  }
}

fn json_error(code: Int): JsonError {
  if code == 1 {
    off = jsonc.avant_json_error_offset().to_i()
    return JsonError.new("invalid JSON at byte ${off}: ${jsonc.avant_json_error_text()}", off)
  }
  JsonError.new("JSON parse ran out of memory")
}

// A JSON value copied out of its document (Json.to_value). An object's
// members are in members, by name, and their names in keys in the
// document's order; a name that repeats keeps its first value, as get on
// the document does.
pub class JsonValue {
  pub kind: JsonKind = JsonKind.null
  pub int_val: Int = 0
  pub f64_val: Float64 = 0.0
  pub str_val: String = ""
  pub bool_val: Bool = false
  pub arr: Array(JsonValue) = []
  pub keys: Array(String) = []
  pub members: Hash(String, JsonValue) = Hash(String, JsonValue).new()

  pub fn get(key: String): JsonValue? {
    self.members[key]
  }
}

pub struct Json {
  node: Ptr(Void)
  pool: Bytes

  pub fn self.parse(text: String): Json | JsonError {
    doc = jsonc.avant_json_parse(text)
    code = jsonc.avant_json_take_status()
    if code != 0 {
      return json_error(code)
    }
    pool = jsonc.avant_json_take_pool()
    Json { node: jsonc.avant_json_root(doc), pool: pool }
  }

  // A JsonBuilder with an object open (Json.object) or an array open
  // (Json.array). The starts are not named obj and arr: arr is a parsed
  // value's elements, and a type-level function cannot share a method's
  // name and parameters.
  pub fn self.object: JsonBuilder {
    b = JsonBuilder.new()
    b.obj()
    b
  }

  pub fn self.array: JsonBuilder {
    b = JsonBuilder.new()
    b.arr()
    b
  }

  pub fn kind: JsonKind {
    // A Json's node is a value (get, at and the iterator give nil for
    // no_value), so the fallback is never taken.
    JsonKind.from_i(jsonc.avant_json_kind(self.node)) ?? JsonKind.null
  }

  // The is_* tests compare the runtime's code with the member's value
  // rather than build a JsonKind? through kind: measured on a JSON walk,
  // +0.02% instructions this way against +6.7% through kind.
  pub fn is_null: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.null.to_i()
  }

  pub fn is_bool: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.bool.to_i()
  }

  pub fn is_int: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.int.to_i()
  }

  pub fn is_float: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.float.to_i()
  }

  pub fn is_str: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.str.to_i()
  }

  pub fn is_arr: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.arr.to_i()
  }

  pub fn is_obj: Bool {
    jsonc.avant_json_kind(self.node) == JsonKind.obj.to_i()
  }

  pub fn len: Int {
    jsonc.avant_json_len(self.node)
  }

  pub fn get(key: String): Json? {
    child_node = jsonc.avant_json_get(self.node, key)
    if jsonc.avant_json_kind(child_node) == no_value {
      return nil
    }
    Json { node: child_node, pool: self.pool }
  }

  pub fn at(index: Int): Json? {
    child_node = jsonc.avant_json_at(self.node, index)
    if jsonc.avant_json_kind(child_node) == no_value {
      return nil
    }
    Json { node: child_node, pool: self.pool }
  }

  pub fn first: Json? {
    child_node = jsonc.avant_json_first(self.node)
    if jsonc.avant_json_kind(child_node) == no_value {
      return nil
    }
    Json { node: child_node, pool: self.pool }
  }

  // The elements of this value, when it is an array; nil for any other
  // value (an object, a string, a number, a Bool or null), so a walk
  // over what is not a list is never an empty walk.
  pub fn arr: JsonIter? {
    if jsonc.avant_json_kind(self.node) != JsonKind.arr.to_i() {
      return nil
    }
    JsonIter.new(self.node, self.pool, self.len())
  }

  // The elements of the member `key`, when it is there and is an array;
  // nil otherwise.
  pub fn arr(key: String): JsonIter? {
    child_node = jsonc.avant_json_get(self.node, key)
    if jsonc.avant_json_kind(child_node) != JsonKind.arr.to_i() {
      return nil
    }
    JsonIter.new(child_node, self.pool, jsonc.avant_json_len(child_node))
  }

  pub fn key_at(index: Int): String? {
    key = jsonc.avant_json_key_at(self.node, index)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    key
  }

  pub fn int: Int? {
    v = jsonc.avant_json_as_int(self.node)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn int(key: String): Int? {
    v = jsonc.avant_json_obj_int(self.node, key)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn f64: Float64? {
    v = jsonc.avant_json_as_f64(self.node)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn f64(key: String): Float64? {
    v = jsonc.avant_json_obj_f64(self.node, key)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn str: String? {
    v = jsonc.avant_json_as_str(self.node)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn str(key: String): String? {
    v = jsonc.avant_json_obj_str(self.node, key)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v
  }

  pub fn bool: Bool? {
    v = jsonc.avant_json_as_bool(self.node)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v != 0
  }

  pub fn bool(key: String): Bool? {
    v = jsonc.avant_json_obj_bool(self.node, key)
    if jsonc.avant_json_take_status() != 0 {
      return nil
    }
    v != 0
  }

  pub fn text: String {
    jsonc.avant_json_text(self.node)
  }

  pub fn to_value: JsonValue {
    v = JsonValue.new()
    v.kind = self.kind()
    if self.is_int() {
      // An integer beyond Int keeps its value as a float.
      if i = self.int() {
        v.int_val = i
      } else {
        v.kind = JsonKind.float
        v.f64_val = self.f64() ?? 0.0
      }
    } else if self.is_float() {
      v.f64_val = self.f64() ?? 0.0
    } else if self.is_str() {
      v.str_val = self.str() ?? ""
    } else if self.is_bool() {
      v.bool_val = self.bool() ?? false
    } else if self.is_arr() {
      i = 0
      while i < self.len() {
        if child = at(i) {
          v.arr.push(child.to_value())
        }
        i += 1
      }
    } else if self.is_obj() {
      i = 0
      while i < self.len() {
        if key = key_at(i), child = get(key), !v.members.has(key) {
          v.keys.push(key)
          v.members[key] = child.to_value()
        }
        i += 1
      }
    }
    v
  }
}

pub class JsonIter {
  arr: Ptr(Void)
  cur: Ptr(Void)
  idx: Int = 0
  max: Int = 0
  pool: Bytes

  fn initialize(arr: Ptr(Void), pool: Bytes, max: Int) {
    self.arr = arr
    self.cur = arr
    self.pool = pool
    self.max = max
  }

  pub fn next: Json? {
    if self.idx >= self.max {
      return nil
    }
    if self.idx == 0 {
      self.cur = jsonc.avant_json_first(self.arr)
    } else {
      self.cur = jsonc.avant_json_next(self.cur)
    }
    self.idx += 1
    if jsonc.avant_json_kind(self.cur) == no_value {
      return nil
    }
    Json { node: self.cur, pool: self.pool }
  }
}

fn builder_escape(buf: Buf, s: String) {
  hex = "0123456789abcdef"
  buf.push_str("\"")
  for c in s.bytes {
    if c == 34 {
      buf.push_str("\\\"")
    } else if c == 92 {
      buf.push_str("\\\\")
    } else if c == 10 {
      buf.push_str("\\n")
    } else if c == 13 {
      buf.push_str("\\r")
    } else if c == 9 {
      buf.push_str("\\t")
    } else if c < 32 {
      buf.push_str("\\u00")
      buf.push_byte(hex[c / 16])
      buf.push_byte(hex[c % 16])
    } else {
      buf.push_byte(c)
    }
  }
  buf.push_str("\"")
}

pub class JsonBuilder {
  buf: Buf = buf_new()
  stack: Array(Int) = []
  counts: Array(Int) = []
  pending: Bool = false
  root_done: Bool = false

  pub fn self.into(dst: Buf): JsonBuilder {
    b = JsonBuilder.new()
    b.buf = dst
    b
  }

  fn before_value {
    if self.stack.size == 0 {
      self.root_done = true
      return
    }
    top = self.stack[self.stack.size - 1]
    if top == 2 {
      if self.counts[self.counts.size - 1] > 0 {
        self.buf.push_str(",")
      }
      self.counts[self.counts.size - 1] = self.counts[self.counts.size - 1] + 1
    } else {
      self.pending = false
    }
  }

  pub fn obj: JsonBuilder {
    self.before_value()
    self.buf.push_str("{")
    self.stack.push(1)
    self.counts.push(0)
    self
  }

  pub fn arr: JsonBuilder {
    self.before_value()
    self.buf.push_str("[")
    self.stack.push(2)
    self.counts.push(0)
    self
  }

  pub fn end: JsonBuilder {
    if self.stack.size == 0 {
      jsonc.avant_json_misuse("JsonBuilder.end: nothing open")
      return self
    }
    top = self.stack[self.stack.size - 1]
    self.stack.pop()
    self.counts.pop()
    if top == 1 {
      self.buf.push_str("}")
    } else {
      self.buf.push_str("]")
    }
    self
  }

  pub fn key(name: String): JsonBuilder {
    if self.stack.size == 0 || self.stack[self.stack.size - 1] != 1 {
      jsonc.avant_json_misuse("JsonBuilder.key: not inside an object")
      return self
    }
    if self.counts[self.counts.size - 1] > 0 {
      self.buf.push_str(",")
    }
    self.counts[self.counts.size - 1] = self.counts[self.counts.size - 1] + 1
    builder_escape(self.buf, name)
    self.buf.push_str(":")
    self.pending = true
    self
  }

  pub fn null: JsonBuilder {
    self.before_value()
    self.buf.push_str("null")
    self
  }

  pub fn value(v: Int): JsonBuilder {
    self.before_value()
    self.buf.push_fmt_i(v)
    self
  }

  pub fn value(v: Float64): JsonBuilder {
    self.before_value()
    d = v - v
    if d != 0.0 {
      self.buf.push_str("null")
    } else {
      self.buf.push_str("${v}")
    }
    self
  }

  pub fn value(v: String): JsonBuilder {
    self.before_value()
    builder_escape(self.buf, v)
    self
  }

  pub fn value(v: Bool): JsonBuilder {
    self.before_value()
    if v {
      self.buf.push_str("true")
    } else {
      self.buf.push_str("false")
    }
    self
  }

  pub fn value(v: Json): JsonBuilder {
    self.before_value()
    self.buf.push_str(v.text())
    self
  }

  pub fn value(v: JsonBuilder): JsonBuilder {
    self.before_value()
    self.buf.push_str(v.to_s())
    self
  }

  // A JsonValue tree (Json.to_value's, or one built by hand) written
  // back: an object's members in the order of its keys, each name's
  // value from members (a name in keys without a member is written as
  // null).
  pub fn value(v: JsonValue): JsonBuilder {
    switch v.kind {
      case null { self.null() }
      case bool { value(v.bool_val) }
      case int { value(v.int_val) }
      case float { value(v.f64_val) }
      case str { value(v.str_val) }
      case arr {
        self.arr()
        for e in v.arr {
          value(e)
        }
        self.end()
      }
      case obj {
        self.obj()
        for k in v.keys {
          key(k)
          if m = v.members[k] {
            value(m)
          } else {
            self.null()
          }
        }
        self.end()
      }
    }
  }

  pub fn add(v: Int): JsonBuilder {
    value(v)
  }

  pub fn add(v: Float64): JsonBuilder {
    value(v)
  }

  pub fn add(v: String): JsonBuilder {
    value(v)
  }

  pub fn add(v: Bool): JsonBuilder {
    value(v)
  }

  pub fn add(v: Json): JsonBuilder {
    value(v)
  }

  pub fn add(v: JsonBuilder): JsonBuilder {
    value(v)
  }

  pub fn add(v: JsonValue): JsonBuilder {
    value(v)
  }

  pub fn set(name: String, v: Int): JsonBuilder {
    key(name)
    value(v)
  }

  pub fn set(name: String, v: Float64): JsonBuilder {
    key(name)
    value(v)
  }

  pub fn set(name: String, v: String): JsonBuilder {
    key(name)
    value(v)
  }

  pub fn set(name: String, v: Bool): JsonBuilder {
    key(name)
    value(v)
  }

  pub fn set(name: String, v: Json): JsonBuilder {
    key(name)
    value(v)
  }

  pub fn set(name: String, v: JsonBuilder): JsonBuilder {
    key(name)
    value(v)
  }

  pub fn set(name: String, v: JsonValue): JsonBuilder {
    key(name)
    value(v)
  }

  pub fn set_null(name: String): JsonBuilder {
    key(name)
    self.null()
  }

  pub fn to_s: String {
    if self.stack.size > 0 {
      jsonc.avant_json_misuse("JsonBuilder.to_s: ${self.stack.size} containers still open")
    }
    self.buf.to_s()
  }
}
