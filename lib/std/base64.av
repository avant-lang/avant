lib base64c {
  fun avant_base64_encode(data: Bytes): String
  fun avant_base64_decode(data: Bytes): Bytes
  fun avant_base64_encode_into(data: Bytes, dst: Buf): Int
  fun avant_base64_decode_into(data: Bytes, dst: Buf): Int
  fun avant_base64_take_status: Int
  fun avant_base64url_encode(data: Bytes): String
  fun avant_base64url_decode(data: Bytes): Bytes
  fun avant_base64url_encode_into(data: Bytes, dst: Buf): Int
  fun avant_base64url_decode_into(data: Bytes, dst: Buf): Int
}

// Why a base64 call failed: the input is not Base64 data (invalid_data),
// or the result would not fit a Buf's size limit (too_large). The
// runtime's status codes are 1 and 2.
pub enum Base64Error: Error {
  invalid_data
  too_large

  pub fn message: String {
    switch self {
      case invalid_data { "invalid base64 data" }
      case too_large { "the base64 result would pass a Buf's size limit" }
    }
  }
}

fn base64_error(code: Int): Base64Error {
  if code == 1 {
    return Base64Error.invalid_data
  }
  Base64Error.too_large
}

pub fn (b: Bytes) to_base64: String {
  base64c.avant_base64_encode(b)
}

pub fn (b: Bytes) to_base64_into(dst: Buf): Base64Error? {
  code = base64c.avant_base64_encode_into(b, dst)
  if code != 0 {
    return base64_error(code)
  }
  nil
}

pub fn (b: Bytes) from_base64: Bytes | Base64Error {
  out = base64c.avant_base64_decode(b)
  code = base64c.avant_base64_take_status()
  if code != 0 {
    return base64_error(code)
  }
  out
}

pub fn (b: Bytes) from_base64_into(dst: Buf): Base64Error? {
  code = base64c.avant_base64_decode_into(b, dst)
  if code != 0 {
    return base64_error(code)
  }
  nil
}

// The URL-safe alphabet without padding (RFC 4648 section 5: `-` and `_`
// for `+` and `/`, no `=`), as JWT and URL tokens write it. The decoder
// takes the text with or without its padding, and refuses `+` and `/`.
pub fn (b: Bytes) to_base64_url: String {
  base64c.avant_base64url_encode(b)
}

pub fn (b: Bytes) to_base64_url_into(dst: Buf): Base64Error? {
  code = base64c.avant_base64url_encode_into(b, dst)
  if code != 0 {
    return base64_error(code)
  }
  nil
}

pub fn (b: Bytes) from_base64_url: Bytes | Base64Error {
  out = base64c.avant_base64url_decode(b)
  code = base64c.avant_base64_take_status()
  if code != 0 {
    return base64_error(code)
  }
  out
}

pub fn (b: Bytes) from_base64_url_into(dst: Buf): Base64Error? {
  code = base64c.avant_base64url_decode_into(b, dst)
  if code != 0 {
    return base64_error(code)
  }
  nil
}
