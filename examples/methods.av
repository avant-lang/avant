struct Point {
  x: Int
  y: Int

  fn sum: Int {
    x + y
  }
}

fn (p: Point) scaled(s: Int): Point {
  Point { x: p.x * s, y: p.y * s }
}

class Counter {
  value: Int

  fn initialize(value: Int) {
    self.value = value
  }

  fn inc: Int {
    value += 1
    value
  }
}

fn main {
  p = Point { x: 3, y: 4 }
  puts(p.sum)
  q = p.scaled(2)
  puts(q.x)
  c = Counter.new(10)
  d = c
  puts(c.inc)
  puts(d.value)
}
