fn name_of(kind: Int): String {
  switch kind {
    case 0 {
      "eof"
    }
    case 1, 2 {
      "ident-or-int"
    }
    else {
      "other"
    }
  }
}

fn main {
  puts(name_of(0))
  puts(name_of(1))
  puts(name_of(2))
  puts(name_of(9))
  n = 1
  label = switch n {
    case 0 {
      "zero"
    }
    else {
      "nonzero"
    }
  }
  puts(label)
}
