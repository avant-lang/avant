class Node {
  item: Int
  left: Node
  right: Node

  fn initialize(item: Int) {
    self.item = item
  }
}

fn make(item: Int, depth: Int): Node {
  n = Node.new(item)
  if depth > 0 {
    n.left = make(item * 2, depth - 1)
    n.right = make(item * 2 + 1, depth - 1)
  }
  n
}

fn check(n: Node, depth: Int): Int {
  if depth == 0 {
    return n.item
  }
  check(n.left, depth - 1) + check(n.right, depth - 1) + n.item
}

fn main {
  t = make(1, 3)
  puts(check(t, 3))
}
