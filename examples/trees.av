class Node {
  item: Int
  left: Node?
  right: Node?

  fn initialize(item: Int) {
    self.item = item
  }
}

fn make(item: Int, depth: Int): Node {
  n = Node.new(item)
  if depth > 0 {
    n.left = make(item * 2, depth - 1)
    n.right = make(item * 2 + 1, depth - 1)
  }
  n
}

fn check(n: Node): Int {
  if l = n.left {
    if r = n.right {
      return check(l) + check(r) + n.item
    }
  }
  n.item
}

fn main {
  t = make(1, 3)
  puts(check(t))
}
