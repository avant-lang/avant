import std.http

fn main {
  if server = http.listen(0) {
    server.get("/", (req) {
      server.close()
      http.Response.text("Hello Avant")
    })
    port = server.port()
    handle = spawn {
      if resp = http.get("http://127.0.0.1:${port}/") {
        puts(resp.body_text() ?? "")
      }
      0
    }
    server.serve()
    _ = handle.join()
  }
}
