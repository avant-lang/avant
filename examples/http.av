import std.http

fn main {
  if server = Http.listen(0) {
    server.get("/") { |req|
      server.close
      Response.text("Hello Avant")
    }
    port = server.port
    handle = spawn {
      if resp = Http.get("http://127.0.0.1:${port}/") {
        puts(String.from_utf8(resp.body) ?? "")
      }
      0
    }
    server.serve
    _ = handle.join
  }
}
