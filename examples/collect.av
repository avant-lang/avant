fn main {
  xs: Array(Int) = [1, 2]
  xs.push(3)
  sum = 0
  xs.each { |n| sum += n }
  puts(sum)
  puts(xs.size)

  h = ["a": 10, "b": 20]
  if v = h.get("a") {
    puts(v)
  }
  puts(h.size)

  seen = Set(String).new()
  for w in ["a", "b", "a"] {
    seen.add(w)
  }
  puts(seen.size)
  puts("hi " + "avant")
}
