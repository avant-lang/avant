class Node {
  item: Int
  left: Node
  right: Node

  fn initialize(item: Int) {
    self.item = item
  }
}

fn make(item: Int, depth: Int): Node {
  n = Node.new(item)
  if depth > 0 {
    n.left = make(item * 2, depth - 1)
    n.right = make(item * 2 + 1, depth - 1)
  }
  n
}

fn check(n: Node, depth: Int): Int {
  if depth == 0 {
    return n.item
  }
  check(n.left, depth - 1) + check(n.right, depth - 1) + n.item
}

fn pow2(n: Int): Int {
  p = 1
  i = 0
  while i < n {
    p = p * 2
    i = i + 1
  }
  p
}

fn main {
  min = 4
  max = 12
  sum = check(make(0, max + 1), max + 1)
  long_lived = make(0, max)
  d = min
  while d <= max {
    n = pow2(max - d + min)
    i = 0
    while i < n {
      t = make(i, d)
      sum = sum + check(t, d)
      i = i + 1
    }
    d = d + 1
  }
  puts(sum)
  puts(check(long_lived, max))
}
