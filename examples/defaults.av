class CalcNode {
  kind: Int = 0
  name: String = ""
  extra: Int = 1

  fn initialize {
  }
}

class Named {
  kind: Int = 0
  name: String = ""

  fn initialize(kind: Int) {
    self.kind = kind
  }
}

fn main {
  n = CalcNode.new()
  puts(n.kind)
  puts(n.name.size)
  puts(n.extra)
  m = Named.new(5)
  puts(m.kind)
  puts(m.name.size)
}
