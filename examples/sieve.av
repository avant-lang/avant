fn sieve(n: Int): Int {
  flags = Array(Int).new(n)
  i = 0
  while i < n {
    flags[i] = 1
    i = i + 1
  }
  flags[0] = 0
  if n > 1 {
    flags[1] = 0
  }
  p = 2
  while p * p < n {
    if flags[p] == 1 {
      k = p * p
      while k < n {
        flags[k] = 0
        k = k + p
      }
    }
    p = p + 1
  }
  count = 0
  i = 0
  while i < n {
    if flags[i] == 1 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

fn main {
  puts(sieve(100))
}
