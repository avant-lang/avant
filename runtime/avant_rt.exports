# The global symbols of runtime/build/avant_rt.o (Stage 28 W12; the
# surface reduced to its ABI in W14b2, gc-design.md section 1.8, O37).
#
# runtime/build.sh folds the core units (the collector's avant_gc_*.c
# and avant_rt_traps.c) into avant_rt.o and then keeps global only the
# symbols listed here (objcopy --keep-global-symbols): every other
# symbol the units share with each other is made local, so an internal
# function or variable can cross a unit boundary without becoming part
# of the object's surface. A new global symbol is added here on purpose,
# never by accident. `nm -g --defined-only` of the object prints exactly
# the names of both sections below, and runtime/build.sh checks it.
#
# The ABI: what generated code calls or reads (compiler/mir/runtime.av's
# call table, compiler/llvm/emit*.av) and what avant_rt.h declares for
# user C and the runtime's other objects. Default visibility. One symbol
# per line, sorted. avant_gc_root, avant_gc_reload, avant_gc_quiet_enter
# and avant_gc_quiet_leave are never emitted by the compiler and stay as
# deprecated entries (gc-design.md section 1.4, Q10).
avant_alloc
avant_alloc_in_mature
avant_barrier
avant_barrier_at
avant_bump_alloc
avant_checked_add_i64
avant_checked_add_u64
avant_checked_div_i64
avant_checked_div_u64
avant_checked_mul_i64
avant_checked_mul_u64
avant_checked_rem_i64
avant_checked_rem_u64
avant_checked_sub_i64
avant_checked_sub_u64
avant_g_stats
avant_gc_add_root
avant_gc_base
avant_gc_block
avant_gc_bump
avant_gc_collect
avant_gc_defer_enter
avant_gc_defer_leave
avant_gc_enter
avant_gc_fast_ok
avant_gc_heap_goal_collect
avant_gc_leave
avant_gc_limit
avant_gc_quiet_enter
avant_gc_quiet_leave
avant_gc_register_thread
avant_gc_reload
avant_gc_root
avant_gc_root_begin
avant_gc_starts
avant_gc_stats
avant_gc_unregister_thread
avant_inline_allocs
avant_is_heap
avant_is_young
avant_nursery_held
avant_nursery_reclaim
avant_pin
avant_pin_count
avant_since_gc
avant_trap_bounds
avant_trap_div_zero
avant_trap_overflow
avant_trap_shift
avant_trap_to_i
avant_type_map
avant_type_map_at
avant_unpin
avant_world_lock
avant_world_unlock
avant_young_bytes
g_avant_shared
g_avant_str_gen
#
# Runtime-internal: entries only the runtime's other objects (avant_str.o,
# avant_hash.o, ...) call. Global so those objects link against them,
# hidden visibility (no linked image exports them), declared by avant_gc.h
# only, never by avant_rt.h. runtime/build.sh checks the visibility of
# both sections. One symbol per line, sorted; this marker line starts the
# section:
# runtime-internal
avant_alloc_c
avant_gc_nogc_begin
avant_gc_nogc_end
avant_gc_quiet_defer_enter
avant_gc_safepoint_force
avant_gc_safepoint_slow
avant_gc_top
