// calc_ast_unhinted.av — bench/valk-gc/trees.
// Origin: langarena/tasks/calc_ast.av (Calculator::Ast), from the Avant LangArena harness
// (langarena 37367d3; tasks for kostya/LangArena, MIT, (c) 2026 Konstantin
// Makarchev; the Avant sources are the Avant project's).
// Changed: the hints removed and nothing else (the same algorithm as
// the hinted program): `import std.gc`, the `gc.collect()` after the text is
// generated, the `gc.hold { }` around each round and the `gc.collect()` at
// its end.
fn main {
  n = cfg_operations()
  text = calc_generate(n)
  count = calc_expr_count(n)
  sentinel = Nd.new(NdKind.number, 0, 0)
  exprs = Array(Nd).new(count, (i) { sentinel })
  acc: Int32 = 0
  total = cfg_warmup() + cfg_iterations()
  for t in 0..total {
    nread = calc_fill(text, exprs)
    acc = acc &+ nread.wrap_i32()
    if nread > 0 {
      last = exprs[nread - 1]
      if last.kind == NdKind.assignment {
        acc = acc &+ checksum_var(last.op.to_i()).wrap_i32()
      }
    }
    for i in 0..nread {
      exprs[i] = sentinel
    }
  }
  puts(acc.wrap_u32())
}
