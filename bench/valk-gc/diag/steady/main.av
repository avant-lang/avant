// A diagnostic program, not a benchmark row: scenario 2's loop with a
// settable number of forced collections K (first argument, default 500)
// and the kind of collection (second argument: 0 the runtime's complete
// collection, 1 std.gc's collection, 2 the runtime's young collection).
// The live list is 500,000 nodes, as in scenario 2. The difference of two
// runs with different K gives the instructions of one forced collection
// of an unchanged heap, without a clock:
//
//   avant compile bench/valk-gc/diag/steady/main.av steady --release
//   perf stat -e instructions:u ./steady 20500 2
//   perf stat -e instructions:u ./steady 500 2

import std.gc

lib gcrt {
  fun avant_gc_collect
  fun avant_gc_collect_young
}

class Node {
  next: Node?
}

class Globals {
  sink: Node?
}

fn chain(n: Int): Node {
  first = Node.new()
  prev = first
  i = 1
  while i < n {
    node = Node.new()
    prev.next = node
    prev = node
    i = i + 1
  }
  first
}

fn main: Int {
  args = argv()
  collects = 500
  young = 0
  if args.size > 1 {
    collects = args[1].to_i() ?? collects
  }
  if args.size > 2 {
    young = args[2].to_i() ?? young
  }
  g = Globals.new()
  live = 500000
  list = chain(live)
  if young == 2 {
    gcrt.avant_gc_collect_young()
  } else if young == 1 {
    gc.collect()
  } else {
    gcrt.avant_gc_collect()
  }
  c = 0
  while c < collects {
    g.sink = Node.new()
    if young == 2 {
      gcrt.avant_gc_collect_young()
    } else if young == 1 {
      gc.collect()
    } else {
      gcrt.avant_gc_collect()
    }
    c = c + 1
  }
  n = 0
  cur: Node? = list
  while node = cur {
    cur = node.next
    n = n + 1
  }
  puts("verify:   ${n == live}")
  0
}
