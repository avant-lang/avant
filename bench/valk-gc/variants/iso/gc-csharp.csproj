<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unmodified copy of ../../upstream/gc-csharp.csproj apart from this comment (Valk, examples/bench/gc, tag 0.8.5, MIT, (c) 2024 Lorenz Vandevelde): it builds the main.cs beside it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(GcTargetFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(GcTargetFramework)' != ''">$(GcTargetFramework)</TargetFramework>
    <AssemblyName>gc-csharp</AssemblyName>
    <RootNamespace>GcBench</RootNamespace>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
