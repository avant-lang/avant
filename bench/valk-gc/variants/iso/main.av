// GC microbenchmarks: the Avant port of Valk's suite, SCENARIO-ISOLATED,
// with an eighth scenario added by Avant.
//
// modified from ../../main.av: main takes scenario numbers (so one process
// can run one scenario: peak RSS, AVANT_GC_STATS and instruction counts
// then belong to it); an optional first word selects the row counted
// (`young`: gc.collect() in place of each forced full collection, as
// ../young/main.av; `hints`: as ../hints/main.av); scenario 8 (reverse a
// live list in place) is added and is NOT part of Valk's suite. With no
// argument it prints what ../../main.av prints. The headline rows are
// measured with ../../main.av, never with this file.
//
// Origin as ../../main.av: ported from Valk's examples/bench/gc/main.valk
// (https://github.com/valk-lang/valk, tag 0.8.5, commit 33224300; MIT,
// (c) 2024 Lorenz Vandevelde; the license is in ../../upstream/LICENSE).

import std.gc

lib gcrt {
  fun avant_gc_collect()
}

class Node {
  next: Node?

  fn len: Int {
    n: Node? = self
    c = 0
    while cur = n {
      n = cur.next
      c = c + 1
    }
    c
  }
}

class Tree {
  left: Tree?
  right: Tree?

  fn initialize(left: Tree? = nil, right: Tree? = nil) {
    self.left = left
    self.right = right
  }

  fn check: Int {
    res = 1
    if lt = self.left {
      res = res + lt.check
    }
    if rt = self.right {
      res = res + rt.check
    }
    res
  }
}

// Valk's globals g_sink and g_keep.
class Globals {
  sink: Node?
  keep: Node?
  // The row being counted (the first argument): young collections in
  // place of the forced full ones, or the two hints.
  young: Bool
  hints: Bool
}

fn build_tree(depth: Int): Tree {
  if depth <= 0 {
    return Tree.new
  }
  Tree.new(build_tree(depth - 1), build_tree(depth - 1))
}

fn chain(n: Int): Node {
  first = Node.new
  prev = first
  i = 1
  while i < n {
    node = Node.new
    prev.next = node
    prev = node
    i = i + 1
  }
  first
}

// The length of an optional chain (0 for nil): scenario 4 measures its
// list without binding it to a second local.
fn len_of(list: Node?): Int {
  if l = list {
    return l.len
  }
  0
}

fn print_time(us: Int) {
  puts("time_us:  ${us}")
  puts("time_ms:  ${us / 1000}")
}

fn mem_kb: Int {
  0
}

fn header(name: String) {
  puts("")
  puts("=== ${name} ===")
}

fn ok_fail(ok: Bool): String {
  if ok {
    return "OK"
  }
  "FAIL"
}

// A forced collection: the runtime's full collection, or std.gc's young
// collection in the `young` row.
fn collect(g: Globals) {
  if g.young {
    gc.collect()
  } else {
    gcrt.avant_gc_collect()
  }
}

fn collect_n(g: Globals, n: Int) {
  i = 0
  while i < n {
    collect(g)
    i = i + 1
  }
}

// chain(n) with no collection while it runs (the `hints` row).
fn chain_held(n: Int): Node {
  gc.hold {
    return chain(n)
  }
}

// 1) Objects that die at once: every allocation is real (stored into the
//    sink), only the last stays live.
fn bench_short_lived(g: Globals) {
  header("short-lived alloc")
  amount = 10000000
  root = Node.new

  start = now_us()
  i = amount
  while i > 0 {
    i = i - 1
    n = Node.new
    g.sink = n
    if i == 0 {
      root.next = n
    }
  }
  us = now_us() - start
  collect_n(g, 2)

  puts("objects:  ${amount}")
  print_time(us)
  puts("rate:     ${amount * 1000 / (us + 1)} allocs/ms")
  puts("mem_kb:   ${mem_kb()}")
  puts("verify:   ${root.len}")
}

// 2) Large stable live set; allocate one trigger object before each
//    forced collection.
fn bench_stable_collect(g: Globals) {
  header("stable-heap forced collects")
  live = 500000
  collects = 500
  list = chain(live)

  collect(g)

  start = now_us()
  c = 0
  while c < collects {
    g.sink = Node.new
    collect(g)
    c = c + 1
  }
  us = now_us() - start

  puts("live:     ${live}")
  puts("collects: ${collects}")
  print_time(us)
  puts("rate:     ${collects * 1000000 / (us + 1)} collects/s")
  puts("mem_kb:   ${mem_kb()}")
  puts("verify:   ${ok_fail(list.len == live)}")
}

// 3) Build a long-lived chain (each link is a store into the node before).
fn bench_build_chain(g: Globals) {
  header("build long-lived chain")
  amount = 5000000

  start = now_us()
  list = if g.hints {
    chain_held(amount)
  } else {
    chain(amount)
  }
  us = now_us() - start

  // Pin so the next scenario can drop it.
  g.keep = list

  puts("objects:  ${amount}")
  print_time(us)
  puts("rate:     ${amount * 1000 / (us + 1)} allocs/ms")
  puts("mem_kb:   ${mem_kb()}")
  puts("verify:   ${ok_fail(list.len == amount)}")
}

// 4) Drop a large graph and reclaim.
fn bench_free_chain(g: Globals) {
  header("free long-lived chain")
  list: Node? = g.keep
  amount = len_of(list)
  if amount == 0 {
    puts("skipped: no chain from build step")
    return
  }
  check = amount

  start = now_us()
  // Drop every root, this local included, before reclaiming.
  g.keep = nil
  list = nil
  collect_n(g, 4)
  us = now_us() - start

  puts("objects:  ${amount}")
  print_time(us)
  puts("mem_kb:   ${mem_kb()}")
  puts("verify:   ${check}")
}

// 5) Rotate a live list: the head goes to the tail, 50 times.
fn bench_mutate_links(g: Globals) {
  header("mutate live links")
  live = 200000
  rounds = 50
  list = chain(live)
  collect(g)

  start = now_us()
  r = 0
  while r < rounds {
    // Rotate: first -> end, second becomes the new head.
    head = list
    second = head.next ?? break
    head.next = nil
    tail = second
    while n = tail.next {
      tail = n
    }
    tail.next = head
    list = second
    r = r + 1
  }
  us = now_us() - start
  collect(g)

  puts("live:     ${live}")
  puts("rounds:   ${rounds}")
  print_time(us)
  puts("mem_kb:   ${mem_kb()}")
  puts("verify:   ${ok_fail(list.len == live)}")
}

// 6) Allocate short-lived garbage while a large live set stays rooted.
fn bench_churn_with_live(g: Globals) {
  header("short-lived churn with large live set")
  live = 500000
  churn = 5000000
  list = chain(live)
  collect(g)

  start = now_us()
  i = churn
  while i > 0 {
    i = i - 1
    n = Node.new
    g.sink = n
  }
  collect(g)
  us = now_us() - start

  puts("live:     ${live}")
  puts("churn:    ${churn}")
  print_time(us)
  puts("rate:     ${churn * 1000 / (us + 1)} allocs/ms")
  puts("mem_kb:   ${mem_kb()}")
  puts("verify:   ${ok_fail(list.len == live)}")
}

// 7) Build and discard trees.
fn bench_tree_churn(g: Globals) {
  header("tree churn")
  depth = 14
  trees = 400
  // nodes per full binary tree: 2^(depth+1) - 1
  nodes_per = (1 << (depth + 1)) - 1

  start = now_us()
  check = 0
  i = 0
  while i < trees {
    check = check + build_tree(depth).check
    if g.hints {
      gc.collect()
    }
    i = i + 1
  }
  collect(g)
  us = now_us() - start

  puts("depth:    ${depth}")
  puts("trees:    ${trees}")
  puts("nodes:    ~${trees * nodes_per}")
  print_time(us)
  puts("mem_kb:   ${mem_kb()}")
  puts("verify:   ${check}")
}

// 8) ADDED BY AVANT, not part of Valk's suite: reverse a live list in
//    place, 50 times. Scenario 5 with the rotation (2 stores a round)
//    replaced by a reversal (200,000 stores a round): it measures the
//    store of a reference into an old object, which scenario 5 does not.
fn bench_reverse_links(g: Globals) {
  header("reverse live links")
  live = 200000
  rounds = 50
  list = chain(live)
  collect(g)

  start = now_us()
  r = 0
  while r < rounds {
    prev: Node? = nil
    cur: Node? = list
    while c = cur {
      nxt = c.next
      c.next = prev
      prev = c
      cur = nxt
    }
    list = prev ?? break
    r = r + 1
  }
  us = now_us() - start
  collect(g)

  puts("live:     ${live}")
  puts("rounds:   ${rounds}")
  puts("stores:   ${live * rounds}")
  print_time(us)
  puts("mem_kb:   ${mem_kb()}")
  puts("verify:   ${ok_fail(list.len == live)}")
}

fn run_scenario(g: Globals, which: Int) {
  switch which {
    case 1 {
      bench_short_lived(g)
    }
    case 2 {
      bench_stable_collect(g)
    }
    case 3 {
      bench_build_chain(g)
    }
    case 4 {
      bench_free_chain(g)
    }
    case 5 {
      bench_mutate_links(g)
    }
    case 6 {
      bench_churn_with_live(g)
    }
    case 7 {
      bench_tree_churn(g)
    }
    case 8 {
      bench_reverse_links(g)
    }
  }
}

// Arguments: an optional row word (`young` or `hints`), then scenario
// numbers, run in the order given. No number: the seven of upstream, in
// upstream's order. 4 needs 3 before it (`3 4`); 0 runs nothing (the
// cost of starting and ending the program).
fn main: Int {
  args = argv()
  g = Globals.new
  first = 1
  if args.size > 1 {
    if args[1] == "young" {
      g.young = true
      first = 2
    } else if args[1] == "hints" {
      g.hints = true
      first = 2
    }
  }
  puts("Avant GC bench suite")
  puts("mem_kb before: ${mem_kb()}")

  if args.size <= first {
    which = 1
    while which <= 7 {
      run_scenario(g, which)
      which = which + 1
    }
  }
  i = first
  while i < args.size {
    run_scenario(g, args[i].to_i ?? 0)
    i = i + 1
  }

  puts("")
  puts("=== done ===")
  puts("mem_kb after: ${mem_kb()}")
  0
}
