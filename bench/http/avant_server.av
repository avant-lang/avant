import std.http

// Hello-world server for the five-language harness (bench/http/run.sh).
// GET / answers "hello"; GET /quit closes the server so the harness can
// stop it without signals. The harness runs one server at a time on
// port 18301.
fn main {
  if server = Http.listen(18301) {
    server.get("/") { |req|
      Response.text("hello")
    }
    server.get("/quit") { |req|
      server.close
      Response.text("bye")
    }
    server.serve
  }
}
