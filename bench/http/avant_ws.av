import std.http

// WebSocket echo server for the five-language harness (bench/http/run.sh).
// Text and binary messages are echoed verbatim on `/`. The harness runs
// one server at a time on port 18311 and stops it by signal.
fn main {
  if server = Http.listen(18311) {
    server.websocket("/") { |conn, msg|
      sent = conn.send_message(msg)
    }
    server.serve
  }
}
