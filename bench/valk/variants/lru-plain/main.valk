// Adapted from examples/bench/lru/main.valk of valk-lang/valk (https://github.com/valk-lang/valk),
// tag 0.8.5, commit 332243001c505373a8203cc60abaafcf188c4701.
// MIT, © 2024 Lorenz Vandevelde (the licence text is in ../LICENSE-valk).
//
// A labelled variant for Avant's bench/valk (levelled twin, D222): what the shipped
// program costs Valk when it does the map operations Go's and Rust's versions do.
//
// Changed: `LRU.put` only. The shipped file evicts with one call of
// `HashMap.get_or_replace` (a lookup, a removal and an insertion in one probe of the
// new key). Here `put` is again a lookup (`get`), and on a miss in a full cache a
// removal (`remove`) and an insertion (`set`): three plain map operations, as
// main.go (`c.keys[key]`, `delete`, `c.keys[key] = ele`) and main.rs (`get_mut`,
// `remove`, `insert`) do. This is the body `put` had in Valk's own file before
// commit 7dae2b32, which added `get_or_replace` to the library and to the benchmark.
// Everything else is the shipped file, byte for byte.

class Node {
    key: u32
    value: u32
    prev: ?Node
    next: ?Node
}

class LRU {
    capacity: uint
    entries: HashMap[u32, Node] (.{})
    head: ?Node
    tail: ?Node

    static fn new(capacity: uint) SELF {
        return SELF {capacity: capacity, entries: HashMap[u32, Node].new(capacity)}
    }

    fn move_to_back(node: Node) {
        if this.tail == node : return

        let prev = node.prev
        let next = node.next
        if isset(prev) : prev.next = next
        else : this.head = next
        if isset(next) : next.prev = prev

        let tail = this.tail
        node.prev = tail
        node.next = null
        if isset(tail) : tail.next = node
        else : this.head = node
        this.tail = node
    }

    fn get(key: u32) bool {
        let node = this.entries.get(key) ! return false
        this.move_to_back(node)
        return true
    }

    fn put(key: u32, value: u32) {
        this.entries.get(key) -> node {
            node.value = value
            this.move_to_back(node)
            return
        }

        if this.entries.length == this.capacity {
            let node = this.head
            if !isset(node) : panic("LRU has no entry to evict")
            this.entries.remove(node.key)
            node.key = key
            node.value = value
            this.move_to_back(node)
            this.entries.set(key, node)
            return
        }

        let node = Node {key: key, value: value, prev: this.tail}
        let tail = this.tail
        if isset(tail) : tail.next = node
        else : this.head = node
        this.tail = node
        this.entries.set(key, node)
    }
}

class LCG {
    seed: u32

    fn next() u32 {
        this.seed = (1_103_515_245 * this.seed + 12_345) % (1 << 31)
        return this.seed
    }
}

fn main(args: Array[String]) {
    let size : uint = 100
    let iterations : uint = 10_000
    args.get(1) -> value {
        let parsed = value.to_int() ! panic("Invalid size: %value")
        if parsed < 1 : panic("LRU size must be greater than zero")
        size = parsed.to(uint)
    }
    args.get(2) -> value {
        let parsed = value.to_int() ! panic("Invalid iteration count: %value")
        if parsed < 0 : panic("Iteration count cannot be negative")
        iterations = parsed.to(uint)
    }
    if size == 0 : panic("LRU size must be greater than zero")

    let modulo = size.to(u32) * 10
    let rng0 = LCG {}
    let rng1 = LCG {seed: 1}
    let cache = LRU.new(size)
    let hits : uint = 0
    let misses : uint = 0

    let i : uint = 0
    while i++<iterations {
        let key = rng0.next() % modulo
        cache.put(key, key)
        if cache.get(rng1.next() % modulo) : hits++
        else : misses++
    }

    println(hits)
    println(misses)
}
