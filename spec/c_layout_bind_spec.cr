require "./spec_helper"

def bind_run(header : String, lib_name : String) : {String, String, Bool}
  Avant::Bind.generate("#{__DIR__}/../examples/c/add.h", "add")
  output = IO::Memory.new
  error = IO::Memory.new
  status = Process.run(Avant::Bind::BIN, [lib_name, header], output: output, error: error)
  {output.to_s, error.to_s, status.success?}
end

describe "Stage 18 bind" do
  it "emits the layout grammar used by examples/layout.av" do
    text, err, ok = bind_run("#{__DIR__}/../examples/c/layout.h", "layout")
    ok.should be_true
    err.should eq("")
    body = text.sub(/\A\/\/ generated by avant bind from .+\n/, "")
    File.read("#{__DIR__}/../examples/layout.av").should contain(body)
  end

  it "names an anonymous struct by its typedef" do
    text, err, ok = bind_run("#{__DIR__}/../examples/c/layout_anon.h", "anon")
    ok.should be_true
    err.should eq("")
    text.should contain("struct Pair {\n    x: Int\n    y: Int\n  }")
    text.should contain("fun pair_ok: Int")
  end

  it "skips a packed record and still emits the function" do
    text, err, ok = bind_run("#{__DIR__}/../examples/c/layout_pack.h", "pack")
    ok.should be_true
    err.should contain("packed")
    text.should_not contain("struct Pack")
    text.should contain("fun pack_f: Int")
  end

  it "skips a bitfield record and still emits the function" do
    text, err, ok = bind_run("#{__DIR__}/../examples/c/layout_bit.h", "bits")
    ok.should be_true
    err.should contain("bitfield")
    text.should_not contain("struct Bits")
    text.should contain("fun bits_f: Int")
  end

  it "skips a record with two typedefs" do
    text, err, ok = bind_run("#{__DIR__}/../examples/c/layout_two.h", "two")
    ok.should be_true
    err.should contain("two typedefs")
    text.should_not contain("struct ")
    text.should contain("fun amb_f: Int")
  end

  it "skips unsigned char*" do
    text, err, ok = bind_run("#{__DIR__}/../examples/c/layout_uchar.h", "raw")
    ok.should be_true
    err.should contain("unsigned char*")
    text.should_not contain("struct Raw")
    text.should contain("fun raw_f: Int")
  end

  it "fails when a C struct is passed by value" do
    text, err, ok = bind_run("#{__DIR__}/../examples/c/layout_byval.h", "byval")
    ok.should be_false
    err.should contain("C struct passed by value is not supported")
    text.should contain("struct Point")
  end
end
