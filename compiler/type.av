import location
import diagnostic
import source
import token
import lexer

pub fn tyk_int: Int { 1 }
pub fn tyk_uint64: Int { 3 }
pub fn tyk_bool: Int { 4 }
pub fn tyk_float: Int { 5 }
pub fn tyk_string: Int { 6 }
pub fn tyk_void: Int { 7 }
pub fn tyk_nil: Int { 8 }
pub fn tyk_array: Int { 9 }
pub fn tyk_struct: Int { 10 }
pub fn tyk_class: Int { 11 }
pub fn tyk_ptr: Int { 12 }
pub fn tyk_union: Int { 13 }
pub fn tyk_hash: Int { 14 }
pub fn tyk_buf: Int { 15 }
pub fn tyk_join: Int { 16 }
pub fn tyk_opaque: Int { 17 }
pub fn tyk_var: Int { 18 }
pub fn tyk_module: Int { 19 }
pub fn tyk_clayout: Int { 20 }
pub fn tyk_fn: Int { 21 }
pub fn tyk_iface: Int { 22 }
pub fn tyk_bytes: Int { 23 }
// `Int` is 64-bit; Int32 and UInt32 are everyday value types (dense
// storage, C's int). Kind 2 was `Int64`, which named `Int` for one
// release and is gone (one spelling for each meaning).
pub fn tyk_int32: Int { 24 }
pub fn tyk_uint32: Int { 25 }
// An enumeration: a distinct type whose values are its members, each an
// integer (enum_vals) with a name (enum_names), in declaration order. Not
// an integer type: no arithmetic, no ordering, no conversion; `==` and
// `!=` compare two values of one enum.
pub fn tyk_enum: Int { 26 }
// The hasher a type's own `fn hash(h: Hasher)` is given: the runtime's,
// on the C stack for the call; it exists only as a parameter (no value of
// it is made, stored, returned or captured).
pub fn tyk_hasher: Int { 27 }

// An enum's members: names and values in declaration order, the values
// distinct (C's rule: one more than the previous member unless written).
pub class TyEnum {
  pub names: Array(String) = []
  pub vals: Array(Int) = []
  // A C enum (declared in a lib block): stored as C's int.
  pub c_int: Bool = false

  fn initialize {
  }
}

pub class TyField {
  pub name: String = ""
  pub ty: Ty
  // false for a field without `pub`; a C layout's fields are C's and
  // stay visible.
  pub vis: Bool = true
  // The field declares a default (a struct literal may leave it out):
  // a struct with such a field has no zero value of its own, since its
  // zero would not be the value a literal gives it.
  pub defaulted: Bool = false

  fn initialize(name: String, ty: Ty) {
    self.name = name
    self.ty = ty
  }
}

pub class Ty {
  // Sum type: `kind` is the variant tag (tyk_* values, long unchanged; the
  // runtime tag in emitted IR derives from it). Each variant owns a subset
  // of the payload fields below; the ty_* constructors in this file are
  // the only construction path, and agg shells get their `fields` filled
  // once by resolve before any read.
  pub kind: Int = 0
  pub name: String = ""
  label: String = ""
  pub origin: String = ""
  pub template: Bool = false
  pub inner: Ty? = nil
  pub key: Ty? = nil
  pub val: Ty? = nil
  pub members: Array(Ty) = []
  pub fields: Array(TyField) = []
  pub ty_args: Array(Ty) = []
  pub mod_name: String = ""
  pub emit_base: String = ""
  // A C scalar type: cs_* below, 0 for every other type. Such a Ty has its Avant
  // view's kind (an integer type or Float64) and its C name as label; it appears
  // only in a `fun` signature and a C layout's field, where the back end passes
  // and stores the C width and converts at the boundary.
  pub c_scalar: Int = 0
  // Marked `Error`: a class or struct declared `class E: Error`; in a
  // union it is a failure (ty_failures below). Set on the type's one Ty
  // when the resolver binds its declaration (resolve.av load_types,
  // instantiate_template), so every check sees it.
  pub error_mark: Bool = false
  // An enum's members (tyk_enum), nil for every other type.
  pub members_of: TyEnum? = nil

  fn initialize(kind: Int) {
    self.kind = kind
  }

  pub fn is_int: Bool { self.kind == tyk_int() }
  pub fn is_uint64: Bool { self.kind == tyk_uint64() }
  pub fn is_int32: Bool { self.kind == tyk_int32() }
  pub fn is_uint32: Bool { self.kind == tyk_uint32() }
  pub fn is_integer: Bool {
    if self.is_int() {
      return true
    }
    if self.is_int32() || self.is_uint32() {
      return true
    }
    self.is_uint64()
  }
  // An unsigned integer type (UInt64, UInt32).
  pub fn is_unsigned: Bool {
    self.is_uint64() || self.is_uint32()
  }
  // The width of an integer type in bits (Int is 64), else 0.
  pub fn int_width: Int {
    if self.is_int32() || self.is_uint32() {
      return 32
    }
    if self.is_integer() {
      return 64
    }
    0
  }
  pub fn is_bool: Bool { self.kind == tyk_bool() }
  pub fn is_float: Bool { self.kind == tyk_float() }
  pub fn is_string: Bool { self.kind == tyk_string() }
  pub fn is_void: Bool { self.kind == tyk_void() }
  pub fn is_array: Bool { self.kind == tyk_array() }
  pub fn is_struct: Bool { self.kind == tyk_struct() }
  pub fn is_class: Bool { self.kind == tyk_class() }
  pub fn is_ptr: Bool { self.kind == tyk_ptr() }
  pub fn is_nil: Bool { self.kind == tyk_nil() }
  // A union member that carries nothing: `Nil`, or the `Void` of a
  // failure-or-nothing result (`Void | E`). It takes a tag and no payload.
  pub fn no_payload: Bool { self.kind == tyk_nil() || self.kind == tyk_void() }
  pub fn is_union: Bool { self.kind == tyk_union() }
  pub fn is_hash: Bool { self.kind == tyk_hash() }
  // A Set(T): a hash of T to Bool named "Set" (ty_set), whose members
  // are the set's (add, contains, delete, ...), not the hash's.
  pub fn is_set: Bool { self.kind == tyk_hash() && self.name == "Set" }
  pub fn is_buf: Bool { self.kind == tyk_buf() }
  pub fn is_bytes: Bool { self.kind == tyk_bytes() }
  pub fn is_join: Bool { self.kind == tyk_join() }
  pub fn is_opaque: Bool { self.kind == tyk_opaque() }
  pub fn is_clayout: Bool { self.kind == tyk_clayout() }
  pub fn is_fn: Bool { self.kind == tyk_fn() }
  pub fn is_iface: Bool { self.kind == tyk_iface() }
  pub fn is_var: Bool { self.kind == tyk_var() }
  pub fn is_module: Bool { self.kind == tyk_module() }
  pub fn is_enum: Bool { self.kind == tyk_enum() }
  pub fn is_hasher: Bool { self.kind == tyk_hasher() }

  // An enum's member names and values (empty for any other type).
  pub fn enum_names: Array(String) {
    if m = self.members_of {
      return m.names
    }
    none: Array(String) = []
    none
  }
  pub fn enum_vals: Array(Int) {
    if m = self.members_of {
      return m.vals
    }
    none: Array(Int) = []
    none
  }

  // A C enum (declared in a lib block): C's int.
  pub fn enum_c_int: Bool {
    if m = self.members_of {
      return m.c_int
    }
    false
  }

  // The index of an enum's member named name, or -1.
  pub fn enum_index(name: String): Int {
    names = self.enum_names()
    for i in 0..names.size {
      if names[i] == name {
        return i
      }
    }
    -1
  }
  pub fn is_agg: Bool {
    if self.is_struct() {
      return true
    }
    self.is_class()
  }
  pub fn is_numeric: Bool {
    if self.is_integer() {
      return true
    }
    self.is_float()
  }

  pub fn field_named(name: String): Ty? {
    for f in self.fields {
      if f.name == name {
        return f.ty
      }
    }
    nil
  }

  pub fn field_index(name: String): Int {
    for i in 0..self.fields.size {
      f = self.fields[i]
      if f.name == name {
        return i
      }
    }
    -1
  }

  pub fn same_as(other: Ty): Bool {
    if self.kind != other.kind {
      return false
    }
    k = self.kind
    if k == tyk_int() {
      return true
    }
    if k == tyk_uint64() {
      return true
    }
    if k == tyk_int32() || k == tyk_uint32() {
      return true
    }
    if k == tyk_bool() {
      return true
    }
    if k == tyk_float() {
      return true
    }
    if k == tyk_string() {
      return true
    }
    if k == tyk_void() {
      return true
    }
    if k == tyk_nil() {
      return true
    }
    if k == tyk_buf() {
      return true
    }
    if k == tyk_hasher() {
      return true
    }
    if k == tyk_bytes() {
      return true
    }
    if k == tyk_array() {
      if a = self.inner, b = other.inner {
        return a.same_as(b)
      }
      return false
    }
    if k == tyk_ptr() {
      if a = self.inner, b = other.inner {
        // Ptr(UInt8) and Ptr(Int) point to elements of other widths,
        // though both read as Int.
        return a.c_scalar == b.c_scalar && a.same_as(b)
      }
      return false
    }
    if k == tyk_join() {
      if a = self.inner, b = other.inner {
        return a.same_as(b)
      }
      return false
    }
    if k == tyk_hash() {
      if self.name != other.name {
        return false
      }
      if ak = self.key, av = self.val, bk = other.key, bv = other.val, ak.same_as(bk) {
        return av.same_as(bv)
      }
      return false
    }
    if k == tyk_struct() {
      return same_agg(other)
    }
    if k == tyk_class() {
      return same_agg(other)
    }
    if k == tyk_enum() {
      return same_agg(other)
    }
    if k == tyk_opaque() {
      return self.name == other.name
    }
    if k == tyk_clayout() {
      return self.name == other.name
    }
    if k == tyk_var() {
      return self.name == other.name
    }
    if k == tyk_module() {
      return self.name == other.name
    }
    if k == tyk_union() {
      if self.members.size != other.members.size {
        return false
      }
      i = 0
      while i < self.members.size {
        if !self.members[i].same_as(other.members[i]) {
          return false
        }
        i += 1
      }
      return true
    }
    if k == tyk_iface() {
      if self.name == other.name && self.ty_args.size == other.ty_args.size {
        for i in 0..self.ty_args.size {
          if !self.ty_args[i].same_as(other.ty_args[i]) {
            return false
          }
        }
        return true
      }
      return false
    }
    if k == tyk_fn() {
      if self.members.size != other.members.size {
        return false
      }
      for i in 0..self.members.size {
        if !self.members[i].same_as(other.members[i]) {
          return false
        }
      }
      if a = self.inner, b = other.inner {
        return a.same_as(b)
      }
      return false
    }
    false
  }

  pub fn includes_member(other: Ty): Bool {
    for mem in self.members {
      if mem.same_as(other) {
        return true
      }
    }
    false
  }

  pub fn includes_nil: Bool {
    for mem in self.members {
      if mem.is_nil() {
        return true
      }
    }
    false
  }

  pub fn includes_void: Bool {
    for mem in self.members {
      if mem.is_void() {
        return true
      }
    }
    false
  }

  // The member that carries nothing (`Nil` or `Void`), or nil.
  pub fn empty_member: Ty? {
    for mem in self.members {
      if mem.no_payload() {
        return mem
      }
    }
    nil
  }

  pub fn tag_of(member: Ty): Int {
    for i in 0..self.members.size {
      if self.members[i].same_as(member) {
        return i
      }
    }
    0
  }

  pub fn payload_index(member: Ty): Int {
    n = 0
    for m in self.members {
      if !m.no_payload() {
        if m.same_as(member) {
          return n + 1
        }
        n += 1
      }
    }
    -1
  }

  pub fn payload_members: Array(Ty) {
    kept: Array(Ty) = []
    for m in self.members {
      if !m.no_payload() {
        kept.push(m)
      }
    }
    kept
  }

  pub fn is_nilable: Bool {
    if self.is_union() && self.includes_nil() {
      return self.members.size == 2
    }
    false
  }

  pub fn same_agg(other: Ty): Bool {
    if self.mod_name.size > 0 && other.mod_name.size > 0 && self.mod_name != other.mod_name {
      return false
    }
    if self.origin.size > 0 {
      if other.origin.size > 0 {
        if self.origin == other.origin && self.ty_args.size == other.ty_args.size {
          for i in 0..self.ty_args.size {
            if !self.ty_args[i].same_as(other.ty_args[i]) {
              return false
            }
          }
          return true
        }
        return false
      }
      return false
    }
    if other.origin.size > 0 {
      return false
    }
    self.name == other.name
  }

  pub fn show: String {
    if self.label.size > 0 {
      return self.label
    }
    k = self.kind
    if k == tyk_int() {
      return "Int"
    }
    if k == tyk_uint64() {
      return "UInt64"
    }
    if k == tyk_int32() {
      return "Int32"
    }
    if k == tyk_uint32() {
      return "UInt32"
    }
    if k == tyk_bool() {
      return "Bool"
    }
    if k == tyk_float() {
      return "Float64"
    }
    if k == tyk_string() {
      return "String"
    }
    if k == tyk_void() {
      return "Void"
    }
    if k == tyk_nil() {
      return "Nil"
    }
    if k == tyk_buf() {
      return "Buf"
    }
    if k == tyk_hasher() {
      return "Hasher"
    }
    if k == tyk_bytes() {
      return "Bytes"
    }
    if k == tyk_var() {
      return self.name
    }
    if k == tyk_module() {
      return "module ${self.name}"
    }
    if k == tyk_array() {
      buf = buf_new()
      buf.push_str("Array(")
      if e = self.inner {
        buf.push_str(e.show())
      }
      buf.push_str(")")
      return buf.to_s()
    }
    if k == tyk_hash() && self.name == "Set" {
      if ke = self.key {
        return "Set(${ke.show()})"
      }
      return "Set"
    }
    if k == tyk_hash() {
      buf = buf_new()
      buf.push_str("Hash(")
      if ke = self.key {
        buf.push_str(ke.show())
      }
      buf.push_str(", ")
      if va = self.val {
        buf.push_str(va.show())
      }
      buf.push_str(")")
      return buf.to_s()
    }
    if k == tyk_ptr() {
      buf = buf_new()
      buf.push_str("Ptr(")
      if e = self.inner {
        buf.push_str(e.show())
      }
      buf.push_str(")")
      return buf.to_s()
    }
    if k == tyk_join() {
      buf = buf_new()
      buf.push_str("JoinHandle(")
      if e = self.inner {
        buf.push_str(e.show())
      }
      buf.push_str(")")
      return buf.to_s()
    }
    if k == tyk_union() {
      return self.show_union()
    }
    if k == tyk_fn() {
      return self.show_fn()
    }
    self.name
  }

  pub fn show_fn: String {
    buf = buf_new()
    buf.push_str("fn(")
    i = 0
    while i < self.members.size {
      if i > 0 {
        buf.push_str(", ")
      }
      buf.push_str(self.members[i].show())
      i += 1
    }
    buf.push_str("): ")
    if r = self.inner {
      buf.push_str(r.show())
    } else {
      buf.push_str("Void")
    }
    buf.to_s()
  }

  pub fn show_union: String {
    if self.is_nilable() {
      non_nil = ty_without_nil(self)
      buf = buf_new()
      if non_nil.is_union() || non_nil.is_fn() {
        buf.push_str("(")
        buf.push_str(non_nil.show())
        buf.push_str(")?")
      } else {
        buf.push_str(non_nil.show())
        buf.push_str("?")
      }
      return buf.to_s()
    }
    buf = buf_new()
    i = 0
    while i < self.members.size {
      if i > 0 {
        buf.push_str(" | ")
      }
      buf.push_str(self.members[i].show())
      i += 1
    }
    buf.to_s()
  }
}

// The C scalar types: the C width and signedness of a `fun` parameter or result or a C layout's field, seen in Avant
// as their view type: Int8, Int16, UInt8 and UInt16 as Int, Float32 as Float64. UInt32 (5) and Int32 are everyday
// types: cs_uint32 stays only as a range kind (avant_trap_c_range). From C a value converts exactly; to C an integer
// outside the C type's range traps, and a Float64 rounds to the nearest Float32.
pub fn cs_int8: Int { 1 }
pub fn cs_int16: Int { 2 }
pub fn cs_uint8: Int { 3 }
pub fn cs_uint16: Int { 4 }
pub fn cs_uint32: Int { 5 }
pub fn cs_float32: Int { 6 }

pub fn c_scalar_name(k: Int): String {
  names = ["", "Int8", "Int16", "UInt8", "UInt16", "UInt32", "Float32"]
  if k < 1 || k >= names.size {
    return ""
  }
  names[k]
}

pub fn c_scalar_of(name: String): Int {
  k = 1
  while k <= 6 {
    if k != cs_uint32() && c_scalar_name(k) == name {
      return k
    }
    k += 1
  }
  0
}

pub fn ty_c_scalar(k: Int): Ty {
  if k == cs_uint32() {
    return Ty.new(tyk_uint32())
  }
  kind = tyk_int()
  if k == cs_float32() {
    kind = tyk_float()
  }
  t = Ty.new(kind)
  t.c_scalar = k
  t.label = c_scalar_name(k)
  t
}

// The Avant view of a C scalar type (a fresh plain integer or Float64);
// any other type is itself.
pub fn ty_c_view(t: Ty): Ty {
  if t.c_scalar == 0 {
    return t
  }
  Ty.new(t.kind)
}

// A C callback's type as Avant code sees it: each narrow C scalar of its
// parameters and result (Int8 ... Float32) its Avant view (Int,
// Float64); the thunk C calls converts at the boundary.
pub fn ty_cb_view(t: Ty): Ty {
  if !t.is_fn() {
    return t
  }
  ps: Array(Ty) = []
  for m in t.members {
    ps.push(ty_c_view(m))
  }
  v = Ty.new(tyk_fn())
  v.members = ps
  if r = t.inner {
    v.inner = ty_c_view(r)
  }
  v
}

// The integer conversions: to_i, to_i32, to_u64 and to_u32 keep the
// value or trap; wrap_i, wrap_i32, wrap_u64 and wrap_u32 take the
// two's-complement bits at the target's width (truncating, or
// extending by the source's sign). The result type, or nil.
pub fn int_conversion_ty(name: String): Ty? {
  if name == "to_i" || name == "wrap_i" {
    return Ty.new(tyk_int())
  }
  if name == "to_i32" || name == "wrap_i32" {
    return Ty.new(tyk_int32())
  }
  if name == "to_u64" || name == "wrap_u64" {
    return Ty.new(tyk_uint64())
  }
  if name == "to_u32" || name == "wrap_u32" {
    return Ty.new(tyk_uint32())
  }
  nil
}

// One integer spelling: `Int64`, the `i64` suffix, `to_i64` and
// `wrap_i64` named `Int`'s forms for one release and are refused with the
// form to write. The replacement of a removed conversion's name, or "".
pub fn removed_int_conversion(name: String): String {
  if name == "to_i64" {
    return "to_i"
  }
  if name == "wrap_i64" {
    return "wrap_i"
  }
  ""
}

pub fn removed_int_message(name: String, now: String): String {
  "${name} was removed: Int is the 64-bit integer (write ${now})"
}

pub fn ty_int: Ty { Ty.new(tyk_int()) }
pub fn ty_int32: Ty { Ty.new(tyk_int32()) }
pub fn ty_uint32: Ty { Ty.new(tyk_uint32()) }
pub fn ty_uint64: Ty { Ty.new(tyk_uint64()) }
pub fn ty_bool: Ty { Ty.new(tyk_bool()) }
pub fn ty_float: Ty { Ty.new(tyk_float()) }
pub fn ty_string: Ty { Ty.new(tyk_string()) }
pub fn ty_void: Ty { Ty.new(tyk_void()) }
pub fn ty_nil: Ty { Ty.new(tyk_nil()) }
pub fn ty_buf: Ty { Ty.new(tyk_buf()) }
pub fn ty_hasher: Ty { Ty.new(tyk_hasher()) }
pub fn ty_bytes: Ty { Ty.new(tyk_bytes()) }

pub fn ty_var(name: String): Ty {
  t = Ty.new(tyk_var())
  t.name = name
  t
}

pub fn ty_has_var(ty: Ty): Bool {
  if ty.is_var() {
    return true
  }
  if inner = ty.inner, ty_has_var(inner) {
    return true
  }
  if key = ty.key, ty_has_var(key) {
    return true
  }
  if val = ty.val, ty_has_var(val) {
    return true
  }
  for mem in ty.members {
    if ty_has_var(mem) {
      return true
    }
  }
  for ty_arg in ty.ty_args {
    if ty_has_var(ty_arg) {
      return true
    }
  }
  false
}

pub fn mangle_ty(ty: Ty): String {
  if ty.c_scalar > 0 {
    return c_scalar_name(ty.c_scalar)
  }
  k = ty.kind
  if k == tyk_int() {
    return "Int"
  }
  if k == tyk_uint64() {
    return "UInt64"
  }
  if k == tyk_int32() {
    return "Int32"
  }
  if k == tyk_uint32() {
    return "UInt32"
  }
  if k == tyk_bool() {
    return "Bool"
  }
  if k == tyk_float() {
    return "Float64"
  }
  if k == tyk_string() {
    return "String"
  }
  if k == tyk_void() {
    return "Void"
  }
  if k == tyk_nil() {
    return "Nil"
  }
  if k == tyk_buf() {
    return "Buf"
  }
  if k == tyk_hasher() {
    return "Hasher"
  }
  if k == tyk_bytes() {
    return "Bytes"
  }
  if k == tyk_array() {
    if e = ty.inner {
      return "Array_${mangle_ty(e)}"
    }
    return "Array"
  }
  if k == tyk_ptr() {
    if e = ty.inner {
      return "Ptr_${mangle_ty(e)}"
    }
    return "Ptr"
  }
  if k == tyk_join() {
    if e = ty.inner {
      return "JoinHandle_${mangle_ty(e)}"
    }
    return "JoinHandle"
  }
  if k == tyk_hash() && ty.name == "Set" {
    if ke = ty.key {
      return "Set_${mangle_ty(ke)}"
    }
    return "Set"
  }
  if k == tyk_hash() {
    buf = buf_new()
    buf.push_str("Hash")
    if ke = ty.key {
      buf.push_str("_")
      buf.push_str(mangle_ty(ke))
    }
    if va = ty.val {
      buf.push_str("_")
      buf.push_str(mangle_ty(va))
    }
    return buf.to_s()
  }
  if k == tyk_union() {
    buf = buf_new()
    for i in 0..ty.members.size {
      if i > 0 {
        buf.push_str("_")
      }
      buf.push_str(mangle_ty(ty.members[i]))
    }
    return buf.to_s()
  }
  if k == tyk_fn() {
    buf = buf_new()
    buf.push_str("Fn")
    for mem in ty.members {
      buf.push_str("_")
      buf.push_str(mangle_ty(mem))
    }
    buf.push_str("__")
    if r = ty.inner {
      buf.push_str(mangle_ty(r))
    } else {
      buf.push_str("Void")
    }
    return buf.to_s()
  }
  if ty.origin.size > 0 && ty.ty_args.size > 0 {
    buf = buf_new()
    base = ty.origin
    if ty.emit_base.size > 0 {
      base = ty.emit_base
    }
    buf.push_str(base)
    for ty_arg in ty.ty_args {
      buf.push_str("__")
      buf.push_str(mangle_ty(ty_arg))
    }
    return buf.to_s()
  }
  if ty.emit_base.size > 0 {
    return ty.emit_base
  }
  ty.name
}

pub fn mod_emit_prefix(mod_name: String): String {
  buf = buf_new()
  i = 0
  while i < mod_name.size {
    if mod_name[i] == 46 {
      buf.push_str("__")
    } else {
      buf.push_str(str_slice(mod_name, i, i + 1))
    }
    i += 1
  }
  buf.to_s()
}

pub fn ty_owned_symbol(ty: Ty, suffix: String): String {
  base = ty.name
  // An instance's name already carries its module and its arguments; its
  // emit_base is the template's, shared by every instance.
  if ty.emit_base.size > 0 && !(ty.origin.size > 0 && ty.ty_args.size > 0) {
    base = ty.emit_base
  }
  "${base}__${suffix}"
}

pub fn ty_module(name: String): Ty {
  t = Ty.new(tyk_module())
  t.name = name
  t
}

pub fn ty_array(elem: Ty): Ty {
  t = Ty.new(tyk_array())
  t.inner = elem
  t
}

pub fn ty_ptr(inner: Ty): Ty {
  t = Ty.new(tyk_ptr())
  t.inner = inner
  t
}

pub fn ty_join(result: Ty): Ty {
  t = Ty.new(tyk_join())
  t.inner = result
  t
}

pub fn ty_hash(key: Ty, val: Ty): Ty {
  t = Ty.new(tyk_hash())
  t.key = key
  t.val = val
  t
}

// Set(T): stored as a hash from T to Bool (a value of one byte nobody
// reads), so every layout, the runtime's entries and the collector's
// tracing are the hash's; the name keeps it a type of its own.
pub fn ty_set(elem: Ty, bool_ty: Ty): Ty {
  t = ty_hash(elem, bool_ty)
  t.name = "Set"
  t
}

// Why Hash(K, V) is not built for this key and value, or "" when it is.
// A key is an integer of any width, a Bool, an enum, a String or a
// struct of those: a value whose `==` a hash can agree with (a struct's
// fields and its own == are the checker's, hash_key_problem, once its
// fields and methods are known). A value is any of those, a Float64, a
// class, an Array, a Hash, Bytes, a Buf or any struct; not an optional
// (a missing key already reads as nil) nor another union, a function or
// a pointer. A type parameter is checked where it is bound.
pub fn hash_type_problem(k: Ty, v: Ty): String {
  if k.is_float() {
    return "a Hash key cannot be a Float64: its == follows IEEE 754 (NaN is not equal to itself, -0.0 equals 0.0), so no hash agrees with it; use an integer key (a fixed-point value, or an index)"
  }
  if !(k.is_integer() || k.is_bool() || k.is_enum() || k.is_string() || k.is_struct() || k.is_var()) {
    return "a Hash key is an integer, a Bool, an enum, a String or a struct of those, not ${k.show()}: ${hash_key_way(k, "key by")}"
  }
  if v.is_nilable() {
    return "a Hash value cannot be optional (${v.show()}): h[k] is already nil for a missing key, so a stored nil could not be told from it; store ${ty_without_nil(v).show()}, and delete the key for nil"
  }
  if !(v.is_integer() || v.is_bool() || v.is_float() || v.is_enum() || v.is_string() || v.is_class() || v.is_array() || v.is_hash() || v.is_bytes() || v.is_buf() || v.is_struct() || v.is_var()) {
    return "Hash values of type ${v.show()} are not built yet: a value is a number, a Bool, an enum, a String, a class, an Array, a Hash, Bytes, a Buf or a struct; a Hash from the key to an index into an Array(${v.show()}) does the same"
  }
  ""
}

// The refusal of a Hasher where it would outlive its call: what (a
// field, an Array, a function's result, ...) may not hold one.
pub fn hasher_held_text(what: String): String {
  "${what} cannot hold a Hasher: the runtime gives one to a hash method for the call only (fn hash(h: Hasher)), so it is a parameter and nothing else; add values to it there"
}

// A method name as messages show it: the equality registered as ==
// is written equals (checker/equality.av spell_protocols).
pub fn protocol_shown(name: String): String {
  if name == "==" {
    return "equals"
  }
  name
}

// The refusal of a Hasher made by the program.
pub fn hasher_made_text: String {
  "a Hasher cannot be made: the runtime gives one to a type's hash method (fn hash(h: Hasher)), which adds the values its equality compares"
}

// What to key by instead of a type no hash can take (the way forward of
// hash_type_problem's and set_type_problem's refusals): by is "key by"
// for a Hash, "store" for a Set.
pub fn hash_key_way(k: Ty, by: String): String {
  if k.is_nilable() {
    return "${by} ${ty_without_nil(k).show()} and keep the nil case beside it"
  }
  if k.is_class() {
    return "a class compares by identity, which no hash can follow while the collector moves objects, and a class's own == reads fields that can change while it is in the table; ${by} a value the object holds (an id or a name), or its index in an Array(${k.show()})"
  }
  if k.is_array() || k.is_bytes() || k.is_buf() {
    return "${by} a String or a struct made from its contents, or its index in an Array(${k.show()})"
  }
  "${by} an index into an Array(${k.show()}) that holds them"
}

// Why Set(T) is not built for this element, or "": its elements are a
// Hash's keys (hash_type_problem), checked by the same rule.
pub fn set_type_problem(e: Ty): String {
  if e.is_float() {
    return "a Set element cannot be a Float64: its == follows IEEE 754 (NaN is not equal to itself, -0.0 equals 0.0), so no hash agrees with it; store an integer (a fixed-point value, or an index)"
  }
  if !(e.is_integer() || e.is_bool() || e.is_enum() || e.is_string() || e.is_struct() || e.is_var()) {
    return "a Set element is an integer, a Bool, an enum, a String or a struct of those, not ${e.show()}: ${hash_key_way(e, "store")}"
  }
  ""
}

pub fn ty_named(kind: Int, name: String): Ty {
  t = Ty.new(kind)
  t.name = name
  t
}

pub fn ty_fn(params: Array(Ty), ret: Ty): Ty {
  t = Ty.new(tyk_fn())
  t.members = params
  t.inner = ret
  t
}

pub fn ty_app(kind: Int, name: String, origin: String, label: String, args: Array(Ty)): Ty {
  t = Ty.new(kind)
  t.name = name
  t.origin = origin
  t.label = label
  t.ty_args = args
  t.template = false
  t
}

pub fn ty_flatten_into(ty: Ty, into: Array(Ty)) {
  if ty.is_union() {
    i = 0
    while i < ty.members.size {
      ty_flatten_into(ty.members[i], into)
      i += 1
    }
  } else {
    into.push(ty)
  }
}

// Union member order: `Nil` first, so it always takes tag 0 and a zeroed
// `T?` (a field nothing assigned, a fresh buffer) reads as nil whatever T
// is called (before, `Abc?` and `Int?` read as present because their names
// sort before `Nil`). The other members by shown name; equal shown names
// (same-named types from different modules) are ordered by their
// module-qualified key, so both written orders build one member list.
pub fn ty_member_before(a: Ty, b: Ty): Bool {
  if a.is_nil() || b.is_nil() {
    return a.is_nil() && !b.is_nil()
  }
  // `Void` next, for the same reason: a zeroed `Void | E` is the success.
  if a.is_void() || b.is_void() {
    return a.is_void() && !b.is_void()
  }
  sa = a.show()
  sb = b.show()
  if str_lt(sa, sb) {
    return true
  }
  if sa == sb {
    return str_lt(ty_qual_key(a), ty_qual_key(b))
  }
  false
}

fn ty_qual_list(buf: Buf, tys: Array(Ty), sep: String) {
  i = 0
  while i < tys.size {
    if i > 0 {
      buf.push_str(sep)
    }
    buf.push_str(ty_qual_key(tys[i]))
    i += 1
  }
}

// The member-order tie-break key: `show` with every nominal type prefixed by
// its defining module.
pub fn ty_qual_key(ty: Ty): String {
  k = ty.kind
  buf = buf_new()
  if k == tyk_union() {
    ty_qual_list(buf, ty.members, "|")
    return buf.to_s()
  }
  if k == tyk_fn() {
    buf.push_str("fn(")
    ty_qual_list(buf, ty.members, ",")
    buf.push_str("):")
    if r = ty.inner {
      buf.push_str(ty_qual_key(r))
    }
    return buf.to_s()
  }
  if k == tyk_hash() && ty.name == "Set" {
    buf.push_str("Set(")
    if ke = ty.key {
      buf.push_str(ty_qual_key(ke))
    }
    buf.push_str(")")
    return buf.to_s()
  }
  if k == tyk_hash() {
    buf.push_str("Hash(")
    if ke = ty.key {
      buf.push_str(ty_qual_key(ke))
    }
    buf.push_str(",")
    if va = ty.val {
      buf.push_str(ty_qual_key(va))
    }
    buf.push_str(")")
    return buf.to_s()
  }
  if k == tyk_array() || k == tyk_ptr() || k == tyk_join() {
    if k == tyk_array() {
      buf.push_str("Array(")
    } else {
      if k == tyk_ptr() {
        buf.push_str("Ptr(")
      } else {
        buf.push_str("JoinHandle(")
      }
    }
    if e = ty.inner {
      buf.push_str(ty_qual_key(e))
    }
    buf.push_str(")")
    return buf.to_s()
  }
  if ty.mod_name.size > 0 {
    buf.push_str(ty.mod_name)
    buf.push_str(".")
  }
  if ty.origin.size > 0 && ty.ty_args.size > 0 {
    buf.push_str(ty.origin)
    buf.push_str("(")
    ty_qual_list(buf, ty.ty_args, ",")
    buf.push_str(")")
    return buf.to_s()
  }
  buf.push_str(ty.show())
  buf.to_s()
}

pub fn ty_union_build(types: Array(Ty)): Ty {
  flat: Array(Ty) = []
  i = 0
  while i < types.size {
    ty_flatten_into(types[i], flat)
    i += 1
  }
  uniq: Array(Ty) = []
  for t in flat {
    seen = false
    for j in 0..uniq.size {
      if uniq[j].same_as(t) {
        seen = true
      }
    }
    if !seen {
      uniq.push(t)
    }
  }
  i = 1
  while i < uniq.size {
    j = i
    while j > 0 {
      if ty_member_before(uniq[j], uniq[j - 1]) {
        tmp = uniq[j - 1]
        uniq[j - 1] = uniq[j]
        uniq[j] = tmp
        j -= 1
      } else {
        break
      }
    }
    i += 1
  }
  if uniq.size == 0 {
    return ty_nil()
  }
  if uniq.size == 1 {
    return uniq[0]
  }
  u = Ty.new(tyk_union())
  u.members = uniq
  u
}

pub fn ty_nilable(inner: Ty): Ty {
  parts: Array(Ty) = []
  parts.push(inner)
  parts.push(ty_nil())
  ty_union_build(parts)
}

// An optional reference: a union of exactly `Nil` and one reference type
// (a class, `String`, `Bytes`, `Array`, `Hash`, `Buf`, a `JoinHandle`)
// or a C pointer (`Ptr(T)`, the nullable pointer: `nil` is C's NULL)
// is that reference's one pointer, `nil` the null pointer; its reference
// member, or nil for any other type. Every other union keeps the
// tag-and-payloads layout. The back end's layouts (mir_opt_ref) and the
// rule for a `fun` signature (checker/register.av) read this one
// definition.
pub fn ty_opt_ref(t: Ty): Ty? {
  if !t.is_union() || t.members.size != 2 {
    return nil
  }
  for m in t.members {
    if !m.is_nil() && (m.is_class() || m.is_string() || m.is_bytes() || m.is_array() || m.is_hash() || m.is_buf() || m.is_join() || m.is_ptr()) {
      if t.includes_nil() {
        return m
      }
    }
  }
  nil
}

// What a Ptr may point to: C memory Avant can describe (a C layout, an
// opaque C type, Void), a C scalar (an element of a C array, read and
// written with p[i]), or a pointer (`T **`: Ptr(Ptr(T)?)). A type
// variable stands for one of them until it is instantiated.
pub fn ptr_pointee_ok(t: Ty): Bool {
  if t.is_void() || t.is_opaque() || t.is_clayout() || t.is_var() {
    return true
  }
  if t.is_integer() || t.is_uint64() || t.is_bool() || t.is_float() {
    return true
  }
  if t.is_ptr() {
    return true
  }
  if r = ty_opt_ref(t), r.is_ptr() {
    return true
  }
  false
}

// Whether p[i] reads and writes through a Ptr to t: a C scalar or a
// pointer (the elements C laid out one after another).
pub fn ptr_elem_ok(t: Ty): Bool {
  if t.is_integer() || t.is_uint64() || t.is_bool() || t.is_float() {
    return true
  }
  if t.is_ptr() {
    return true
  }
  if r = ty_opt_ref(t), r.is_ptr() {
    return true
  }
  false
}

// A C layout's field or element by the C rule: its size and its
// alignment in bytes (a C scalar its C width, an enum C's int, a string
// or a pointer one word, a nested layout its own). `L.size` is the size
// of a layout, known when compiling; the back end lays the layout out by
// the same rule (mir/types.av set_fields).
pub fn c_size_of(t: Ty): Int {
  if t.is_clayout() {
    off = 0
    al = 1
    for f in t.fields {
      fa = c_align_of(f.ty)
      off = ((off + fa - 1) / fa) * fa
      off += c_size_of(f.ty)
      if fa > al {
        al = fa
      }
    }
    return ((off + al - 1) / al) * al
  }
  if t.c_scalar > 0 {
    k = t.c_scalar
    if k == cs_int8() || k == cs_uint8() {
      return 1
    }
    if k == cs_int16() || k == cs_uint16() {
      return 2
    }
    return 4
  }
  if t.is_bool() {
    return 1
  }
  if t.is_int32() || t.is_uint32() || t.is_enum() {
    return 4
  }
  8
}

pub fn c_align_of(t: Ty): Int {
  if t.is_clayout() {
    al = 1
    for f in t.fields {
      fa = c_align_of(f.ty)
      if fa > al {
        al = fa
      }
    }
    return al
  }
  c_size_of(t)
}

pub fn ty_without_nil(ty: Ty): Ty {
  kept: Array(Ty) = []
  for m in ty.members {
    if !m.is_nil() {
      kept.push(m)
    }
  }
  ty_union_build(kept)
}

// The one failure rule: in a union the failures are `Nil` and every
// member marked `Error` (`class E: Error`); the rest is the success
// value, one type or a smaller union. A union with no success member but
// `Nil` (an optional error, `E?`, such as a `cause`) has `Nil` as its
// only failure for if-assign and `??`, so the error is the value read;
// postfix `?` refuses it (it would pass up the `nil`).
pub fn ty_is_failure(m: Ty): Bool {
  m.is_nil() || m.error_mark
}

pub fn ty_has_success(ty: Ty): Bool {
  for m in ty.members {
    if !ty_is_failure(m) {
      return true
    }
  }
  false
}

// The failure members of the union ty under the rule above (in member
// order; empty when ty has none).
pub fn ty_failures(ty: Ty): Array(Ty) {
  out: Array(Ty) = []
  if !ty.is_union() {
    return out
  }
  if !ty_has_success(ty) {
    if ty.includes_nil() {
      out.push(ty_nil())
    }
    return out
  }
  for m in ty.members {
    if ty_is_failure(m) {
      out.push(m)
    }
  }
  out
}

// The success part of the union ty: its members that are not failures,
// one type or a union; nil when ty has no failure or no success.
pub fn ty_success_part(ty: Ty): Ty? {
  fails = ty_failures(ty)
  if fails.size == 0 {
    return nil
  }
  kept: Array(Ty) = []
  for m in ty.members {
    failed = false
    for f in fails {
      if f.same_as(m) {
        failed = true
      }
    }
    if !failed {
      kept.push(m)
    }
  }
  if kept.size == 0 {
    return nil
  }
  ty_union_build(kept)
}

pub fn ty_assignable(got: Ty, want: Ty): Bool {
  if got.same_as(want) {
    return true
  }
  if want.is_union() && want.includes_member(got) {
    return true
  }
  if got.is_union() && want.is_union() {
    for mem in got.members {
      if !want.includes_member(mem) {
        return false
      }
    }
    return true
  }
  false
}

pub fn type_is_builtin(name: String): Bool {
  if name == "Int" {
    return true
  }
  if c_scalar_of(name) > 0 {
    return true
  }
  // `Int64` stays a reserved name: the resolver refuses it with the form
  // to write (one spelling for each meaning).
  if name == "Int64" {
    return true
  }
  if name == "UInt64" {
    return true
  }
  if name == "Int32" || name == "UInt32" {
    return true
  }
  if name == "Bool" {
    return true
  }
  if name == "Float64" {
    return true
  }
  if name == "String" {
    return true
  }
  if name == "Void" {
    return true
  }
  if name == "Array" {
    return true
  }
  if name == "Ptr" {
    return true
  }
  if name == "Hash" {
    return true
  }
  if name == "Set" {
    return true
  }
  if name == "Buf" {
    return true
  }
  if name == "Hasher" {
    return true
  }
  if name == "Bytes" {
    return true
  }
  if name == "Nil" {
    return true
  }
  name == "JoinHandle"
}

// Whether a value of type t has a natural zero.
pub fn ty_has_zero(t: Ty): Bool {
  if t.is_integer() || t.is_float() || t.is_bool() || t.is_string() {
    return true
  }
  if t.is_union() {
    return t.includes_nil()
  }
  if t.is_ptr() {
    return true
  }
  if t.is_struct() {
    for f in t.fields {
      if f.defaulted || !ty_has_zero(f.ty) {
        return false
      }
    }
    return true
  }
  false
}

// Whether a value of type t is, or holds, a reference to an object that
// can change: a class, an array, a hash, a Buf, or a struct or union
// holding one. Copies of such a value share the object. A String and
// Bytes cannot change; a number, a Bool, a function value, a pointer and
// a JoinHandle are not counted.
pub fn ty_holds_mutable_ref(t: Ty): Bool {
  if t.is_class() || t.is_array() || t.is_hash() || t.is_buf() {
    return true
  }
  if t.is_union() {
    for m in t.members {
      if ty_holds_mutable_ref(m) {
        return true
      }
    }
    return false
  }
  if t.is_struct() {
    for f in t.fields {
      if ty_holds_mutable_ref(f.ty) {
        return true
      }
    }
  }
  false
}

// Whether the zero of t needs a store (a String, or a struct holding
// one): the allocation's zero bytes are every other zero.
pub fn ty_zero_stores(t: Ty): Bool {
  if t.is_string() {
    return true
  }
  if t.is_struct() {
    for f in t.fields {
      if ty_zero_stores(f.ty) {
        return true
      }
    }
  }
  false
}

// Whether a value of t holds a Ptr: the type itself, a struct field, a
// union's member (an optional's value).
pub fn ty_holds_ptr(t: Ty): Bool {
  if t.is_ptr() {
    return true
  }
  if t.is_union() {
    for m in t.members {
      if ty_holds_ptr(m) {
        return true
      }
    }
    return false
  }
  if t.is_struct() {
    for f in t.fields {
      if ty_holds_ptr(f.ty) {
        return true
      }
    }
  }
  false
}
