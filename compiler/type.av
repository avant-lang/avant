import location
import diagnostic
import source
import token
import lexer

pub fn tyk_int: Int { 1 }
pub fn tyk_int64: Int { 2 }
pub fn tyk_uint64: Int { 3 }
pub fn tyk_bool: Int { 4 }
pub fn tyk_float: Int { 5 }
pub fn tyk_string: Int { 6 }
pub fn tyk_void: Int { 7 }
pub fn tyk_nil: Int { 8 }
pub fn tyk_array: Int { 9 }
pub fn tyk_struct: Int { 10 }
pub fn tyk_class: Int { 11 }
pub fn tyk_ptr: Int { 12 }
pub fn tyk_union: Int { 13 }
pub fn tyk_hash: Int { 14 }
pub fn tyk_buf: Int { 15 }
pub fn tyk_join: Int { 16 }
pub fn tyk_opaque: Int { 17 }
pub fn tyk_var: Int { 18 }
pub fn tyk_module: Int { 19 }
pub fn tyk_clayout: Int { 20 }
pub fn tyk_fn: Int { 21 }
pub fn tyk_iface: Int { 22 }
pub fn tyk_bytes: Int { 23 }

pub class TyField {
  name: String = ""
  ty: Ty

  fn initialize(name: String, ty: Ty) {
    self.name = name
    self.ty = ty
  }
}

pub class Ty {
  // Sum type: `kind` is the variant tag (tyk_* values, unchanged since
  // Stage 11; the runtime tag in emitted IR derives from it). Each variant
  // owns a subset of the payload fields below; the ty_* constructors in
  // this file are the only construction path, and agg shells get their
  // `fields` filled once by resolve before any read.
  kind: Int = 0
  name: String = ""
  label: String = ""
  origin: String = ""
  template: Bool = false
  inner: Ty? = nil
  key: Ty? = nil
  val: Ty? = nil
  members: Array(Ty)
  fields: Array(TyField)
  ty_args: Array(Ty)
  mod_name: String = ""
  emit_base: String = ""
  // A C scalar type (D64 as amended, Stage 29 W1b): cs_* below, 0 for
  // every other type. Such a Ty has its Avant view's kind (Int, Int64 or
  // Float64) and its C name as label; it appears only in a `fun` signature
  // and a C layout's field, where the back end passes and stores the C
  // width and converts at the boundary.
  c_scalar: Int = 0

  fn initialize(kind: Int) {
    self.kind = kind
    self.label = ""
    self.origin = ""
    self.mod_name = ""
    self.emit_base = ""
    self.template = false
    self.members = []
    self.fields = []
    self.ty_args = []
  }

  pub fn is_int: Bool { self.kind == tyk_int() }
  pub fn is_int64: Bool { self.kind == tyk_int64() }
  pub fn is_uint64: Bool { self.kind == tyk_uint64() }
  pub fn is_integer: Bool {
    if self.is_int {
      return true
    }
    if self.is_int64 {
      return true
    }
    self.is_uint64
  }
  pub fn is_bool: Bool { self.kind == tyk_bool() }
  pub fn is_float: Bool { self.kind == tyk_float() }
  pub fn is_string: Bool { self.kind == tyk_string() }
  pub fn is_void: Bool { self.kind == tyk_void() }
  pub fn is_array: Bool { self.kind == tyk_array() }
  pub fn is_struct: Bool { self.kind == tyk_struct() }
  pub fn is_class: Bool { self.kind == tyk_class() }
  pub fn is_ptr: Bool { self.kind == tyk_ptr() }
  pub fn is_nil: Bool { self.kind == tyk_nil() }
  pub fn is_union: Bool { self.kind == tyk_union() }
  pub fn is_hash: Bool { self.kind == tyk_hash() }
  pub fn is_buf: Bool { self.kind == tyk_buf() }
  pub fn is_bytes: Bool { self.kind == tyk_bytes() }
  pub fn is_join: Bool { self.kind == tyk_join() }
  pub fn is_opaque: Bool { self.kind == tyk_opaque() }
  pub fn is_clayout: Bool { self.kind == tyk_clayout() }
  pub fn is_fn: Bool { self.kind == tyk_fn() }
  pub fn is_iface: Bool { self.kind == tyk_iface() }
  pub fn is_var: Bool { self.kind == tyk_var() }
  pub fn is_module: Bool { self.kind == tyk_module() }
  pub fn is_agg: Bool {
    if self.is_struct {
      return true
    }
    self.is_class
  }
  pub fn is_numeric: Bool {
    if self.is_integer {
      return true
    }
    self.is_float
  }

  pub fn field_named(name: String): Ty? {
    for f in self.fields {
      if f.name == name {
        return f.ty
      }
    }
    nil
  }

  pub fn field_index(name: String): Int {
    for i in 0..self.fields.size {
      f = self.fields[i]
      if f.name == name {
        return i
      }
    }
    -1
  }

  pub fn same_as(other: Ty): Bool {
    if self.kind != other.kind {
      return false
    }
    k = self.kind
    if k == tyk_int() {
      return true
    }
    if k == tyk_int64() {
      return true
    }
    if k == tyk_uint64() {
      return true
    }
    if k == tyk_bool() {
      return true
    }
    if k == tyk_float() {
      return true
    }
    if k == tyk_string() {
      return true
    }
    if k == tyk_void() {
      return true
    }
    if k == tyk_nil() {
      return true
    }
    if k == tyk_buf() {
      return true
    }
    if k == tyk_bytes() {
      return true
    }
    if k == tyk_array() {
      if a = self.inner {
        if b = other.inner {
          return a.same_as(b)
        }
      }
      return false
    }
    if k == tyk_ptr() {
      if a = self.inner {
        if b = other.inner {
          return a.same_as(b)
        }
      }
      return false
    }
    if k == tyk_join() {
      if a = self.inner {
        if b = other.inner {
          return a.same_as(b)
        }
      }
      return false
    }
    if k == tyk_hash() {
      if ak = self.key {
        if av = self.val {
          if bk = other.key {
            if bv = other.val {
              if ak.same_as(bk) {
                return av.same_as(bv)
              }
            }
          }
        }
      }
      return false
    }
    if k == tyk_struct() {
      return self.same_agg(other)
    }
    if k == tyk_class() {
      return self.same_agg(other)
    }
    if k == tyk_opaque() {
      return self.name == other.name
    }
    if k == tyk_clayout() {
      return self.name == other.name
    }
    if k == tyk_var() {
      return self.name == other.name
    }
    if k == tyk_module() {
      return self.name == other.name
    }
    if k == tyk_union() {
      if self.members.size != other.members.size {
        return false
      }
      i = 0
      while i < self.members.size {
        if !self.members[i].same_as(other.members[i]) {
          return false
        }
        i = i + 1
      }
      return true
    }
    if k == tyk_iface() {
      if self.name == other.name && self.ty_args.size == other.ty_args.size {
        for i in 0..self.ty_args.size {
          if !self.ty_args[i].same_as(other.ty_args[i]) {
            return false
          }
        }
        return true
      }
      return false
    }
    if k == tyk_fn() {
      if self.members.size != other.members.size {
        return false
      }
      for i in 0..self.members.size {
        if !self.members[i].same_as(other.members[i]) {
          return false
        }
      }
      if a = self.inner {
        if b = other.inner {
          return a.same_as(b)
        }
      }
      return false
    }
    false
  }

  pub fn includes_member(other: Ty): Bool {
    for mem in self.members {
      if mem.same_as(other) {
        return true
      }
    }
    false
  }

  pub fn includes_nil: Bool {
    for mem in self.members {
      if mem.is_nil {
        return true
      }
    }
    false
  }

  pub fn tag_of(member: Ty): Int {
    for i in 0..self.members.size {
      if self.members[i].same_as(member) {
        return i
      }
    }
    0
  }

  pub fn payload_index(member: Ty): Int {
    n = 0
    for m in self.members {
      if !m.is_nil {
        if m.same_as(member) {
          return n + 1
        }
        n = n + 1
      }
    }
    -1
  }

  pub fn payload_members: Array(Ty) {
    kept: Array(Ty) = []
    for m in self.members {
      if !m.is_nil {
        kept.push(m)
      }
    }
    kept
  }

  pub fn is_nilable: Bool {
    if self.is_union && self.includes_nil {
      return self.members.size == 2
    }
    false
  }

  pub fn same_agg(other: Ty): Bool {
    if self.mod_name.size > 0 && other.mod_name.size > 0 && self.mod_name != other.mod_name {
      return false
    }
    if self.origin.size > 0 {
      if other.origin.size > 0 {
        if self.origin == other.origin && self.ty_args.size == other.ty_args.size {
          for i in 0..self.ty_args.size {
            if !self.ty_args[i].same_as(other.ty_args[i]) {
              return false
            }
          }
          return true
        }
        return false
      }
      return false
    }
    if other.origin.size > 0 {
      return false
    }
    self.name == other.name
  }

  pub fn show: String {
    if self.label.size > 0 {
      return self.label
    }
    k = self.kind
    if k == tyk_int() {
      return "Int"
    }
    if k == tyk_int64() {
      return "Int64"
    }
    if k == tyk_uint64() {
      return "UInt64"
    }
    if k == tyk_bool() {
      return "Bool"
    }
    if k == tyk_float() {
      return "Float64"
    }
    if k == tyk_string() {
      return "String"
    }
    if k == tyk_void() {
      return "Void"
    }
    if k == tyk_nil() {
      return "Nil"
    }
    if k == tyk_buf() {
      return "Buf"
    }
    if k == tyk_bytes() {
      return "Bytes"
    }
    if k == tyk_var() {
      return self.name
    }
    if k == tyk_module() {
      return "module ${self.name}"
    }
    if k == tyk_array() {
      buf = buf_new()
      buf.push_str("Array(")
      if e = self.inner {
        buf.push_str(e.show)
      }
      buf.push_str(")")
      return buf.to_s
    }
    if k == tyk_hash() {
      buf = buf_new()
      buf.push_str("Hash(")
      if ke = self.key {
        buf.push_str(ke.show)
      }
      buf.push_str(", ")
      if va = self.val {
        buf.push_str(va.show)
      }
      buf.push_str(")")
      return buf.to_s
    }
    if k == tyk_ptr() {
      buf = buf_new()
      buf.push_str("Ptr(")
      if e = self.inner {
        buf.push_str(e.show)
      }
      buf.push_str(")")
      return buf.to_s
    }
    if k == tyk_join() {
      buf = buf_new()
      buf.push_str("JoinHandle(")
      if e = self.inner {
        buf.push_str(e.show)
      }
      buf.push_str(")")
      return buf.to_s
    }
    if k == tyk_union() {
      return self.show_union
    }
    if k == tyk_fn() {
      return self.show_fn
    }
    self.name
  }

  pub fn show_fn: String {
    buf = buf_new()
    buf.push_str("fn(")
    i = 0
    while i < self.members.size {
      if i > 0 {
        buf.push_str(", ")
      }
      buf.push_str(self.members[i].show)
      i = i + 1
    }
    buf.push_str("): ")
    if r = self.inner {
      buf.push_str(r.show)
    } else {
      buf.push_str("Void")
    }
    buf.to_s
  }

  pub fn show_union: String {
    if self.is_nilable {
      non_nil = ty_without_nil(self)
      buf = buf_new()
      if non_nil.is_union {
        buf.push_str("(")
        buf.push_str(non_nil.show)
        buf.push_str(")?")
      } else {
        buf.push_str(non_nil.show)
        buf.push_str("?")
      }
      return buf.to_s
    }
    buf = buf_new()
    i = 0
    while i < self.members.size {
      if i > 0 {
        buf.push_str(" | ")
      }
      buf.push_str(self.members[i].show)
      i = i + 1
    }
    buf.to_s
  }
}

// The C scalar types (D64 as amended, Stage 29 W1b): the C width and
// signedness of a `fun` parameter or result or a C layout's field, seen in
// Avant as their view type: Int8, Int16, UInt8 and UInt16 as Int, UInt32
// as Int64, Float32 as Float64. From C a value converts exactly; to C an
// integer outside the C type's range traps (D215), and a Float64 rounds to
// the nearest Float32.
pub fn cs_int8: Int { 1 }
pub fn cs_int16: Int { 2 }
pub fn cs_uint8: Int { 3 }
pub fn cs_uint16: Int { 4 }
pub fn cs_uint32: Int { 5 }
pub fn cs_float32: Int { 6 }

pub fn c_scalar_name(k: Int): String {
  names = ["", "Int8", "Int16", "UInt8", "UInt16", "UInt32", "Float32"]
  if k < 1 || k >= names.size {
    return ""
  }
  names[k]
}

pub fn c_scalar_of(name: String): Int {
  k = 1
  while k <= 6 {
    if c_scalar_name(k) == name {
      return k
    }
    k = k + 1
  }
  0
}

pub fn ty_c_scalar(k: Int): Ty {
  kind = tyk_int()
  if k == cs_uint32() {
    kind = tyk_int64()
  } else if k == cs_float32() {
    kind = tyk_float()
  }
  t = Ty.new(kind)
  t.c_scalar = k
  t.label = c_scalar_name(k)
  t
}

// The Avant view of a C scalar type (a fresh plain Int, Int64 or Float64);
// any other type is itself.
pub fn ty_c_view(t: Ty): Ty {
  if t.c_scalar == 0 {
    return t
  }
  Ty.new(t.kind)
}

pub fn ty_int: Ty { Ty.new(tyk_int()) }
pub fn ty_int64: Ty { Ty.new(tyk_int64()) }
pub fn ty_uint64: Ty { Ty.new(tyk_uint64()) }
pub fn ty_bool: Ty { Ty.new(tyk_bool()) }
pub fn ty_float: Ty { Ty.new(tyk_float()) }
pub fn ty_string: Ty { Ty.new(tyk_string()) }
pub fn ty_void: Ty { Ty.new(tyk_void()) }
pub fn ty_nil: Ty { Ty.new(tyk_nil()) }
pub fn ty_buf: Ty { Ty.new(tyk_buf()) }
pub fn ty_bytes: Ty { Ty.new(tyk_bytes()) }

pub fn ty_var(name: String): Ty {
  t = Ty.new(tyk_var())
  t.name = name
  t
}

pub fn ty_has_var(ty: Ty): Bool {
  if ty.is_var {
    return true
  }
  if inner = ty.inner {
    if ty_has_var(inner) {
      return true
    }
  }
  if key = ty.key {
    if ty_has_var(key) {
      return true
    }
  }
  if val = ty.val {
    if ty_has_var(val) {
      return true
    }
  }
  for mem in ty.members {
    if ty_has_var(mem) {
      return true
    }
  }
  for ty_arg in ty.ty_args {
    if ty_has_var(ty_arg) {
      return true
    }
  }
  false
}

pub fn mangle_ty(ty: Ty): String {
  k = ty.kind
  if k == tyk_int() {
    return "Int"
  }
  if k == tyk_int64() {
    return "Int64"
  }
  if k == tyk_uint64() {
    return "UInt64"
  }
  if k == tyk_bool() {
    return "Bool"
  }
  if k == tyk_float() {
    return "Float64"
  }
  if k == tyk_string() {
    return "String"
  }
  if k == tyk_void() {
    return "Void"
  }
  if k == tyk_nil() {
    return "Nil"
  }
  if k == tyk_buf() {
    return "Buf"
  }
  if k == tyk_bytes() {
    return "Bytes"
  }
  if k == tyk_array() {
    if e = ty.inner {
      return "Array_${mangle_ty(e)}"
    }
    return "Array"
  }
  if k == tyk_ptr() {
    if e = ty.inner {
      return "Ptr_${mangle_ty(e)}"
    }
    return "Ptr"
  }
  if k == tyk_join() {
    if e = ty.inner {
      return "JoinHandle_${mangle_ty(e)}"
    }
    return "JoinHandle"
  }
  if k == tyk_hash() {
    buf = buf_new()
    buf.push_str("Hash")
    if ke = ty.key {
      buf.push_str("_")
      buf.push_str(mangle_ty(ke))
    }
    if va = ty.val {
      buf.push_str("_")
      buf.push_str(mangle_ty(va))
    }
    return buf.to_s
  }
  if k == tyk_union() {
    buf = buf_new()
    for i in 0..ty.members.size {
      if i > 0 {
        buf.push_str("_")
      }
      buf.push_str(mangle_ty(ty.members[i]))
    }
    return buf.to_s
  }
  if k == tyk_fn() {
    buf = buf_new()
    buf.push_str("Fn")
    for mem in ty.members {
      buf.push_str("_")
      buf.push_str(mangle_ty(mem))
    }
    buf.push_str("__")
    if r = ty.inner {
      buf.push_str(mangle_ty(r))
    } else {
      buf.push_str("Void")
    }
    return buf.to_s
  }
  if ty.origin.size > 0 && ty.ty_args.size > 0 {
    buf = buf_new()
    base = ty.origin
    if ty.emit_base.size > 0 {
      base = ty.emit_base
    }
    buf.push_str(base)
    for ty_arg in ty.ty_args {
      buf.push_str("__")
      buf.push_str(mangle_ty(ty_arg))
    }
    return buf.to_s
  }
  if ty.emit_base.size > 0 {
    return ty.emit_base
  }
  ty.name
}

pub fn mod_emit_prefix(mod_name: String): String {
  buf = buf_new()
  i = 0
  while i < mod_name.size {
    if mod_name[i] == 46 {
      buf.push_str("__")
    } else {
      buf.push_str(str_slice(mod_name, i, i + 1))
    }
    i = i + 1
  }
  buf.to_s
}

pub fn ty_owned_symbol(ty: Ty, suffix: String): String {
  base = ty.name
  if ty.emit_base.size > 0 {
    base = ty.emit_base
  }
  "${base}__${suffix}"
}

pub fn ty_module(name: String): Ty {
  t = Ty.new(tyk_module())
  t.name = name
  t
}

pub fn ty_array(elem: Ty): Ty {
  t = Ty.new(tyk_array())
  t.inner = elem
  t
}

pub fn ty_ptr(inner: Ty): Ty {
  t = Ty.new(tyk_ptr())
  t.inner = inner
  t
}

pub fn ty_join(result: Ty): Ty {
  t = Ty.new(tyk_join())
  t.inner = result
  t
}

pub fn ty_hash(key: Ty, val: Ty): Ty {
  t = Ty.new(tyk_hash())
  t.key = key
  t.val = val
  t
}

pub fn ty_named(kind: Int, name: String): Ty {
  t = Ty.new(kind)
  t.name = name
  t
}

pub fn ty_fn(params: Array(Ty), ret: Ty): Ty {
  t = Ty.new(tyk_fn())
  t.members = params
  t.inner = ret
  t
}

pub fn ty_app(kind: Int, name: String, origin: String, label: String, args: Array(Ty)): Ty {
  t = Ty.new(kind)
  t.name = name
  t.origin = origin
  t.label = label
  t.ty_args = args
  t.template = false
  t
}

pub fn ty_flatten_into(ty: Ty, into: Array(Ty)) {
  if ty.is_union {
    i = 0
    while i < ty.members.size {
      ty_flatten_into(ty.members[i], into)
      i = i + 1
    }
  } else {
    into.push(ty)
  }
}

// Union member order (D200, C15): `Nil` first, so it always takes tag 0 and
// a zeroed `T?` (a field nothing assigned, a fresh buffer) reads as nil
// whatever T is called (Stage 29 W1a, A1; before, `Abc?` and `Int?` read as
// present because their names sort before `Nil`). The other members by
// shown name; equal shown names (same-named types from different modules)
// are ordered by their module-qualified key, so both written orders build
// one member list.
pub fn ty_member_before(a: Ty, b: Ty): Bool {
  if a.is_nil || b.is_nil {
    return a.is_nil && !b.is_nil
  }
  sa = a.show
  sb = b.show
  if str_lt(sa, sb) {
    return true
  }
  if sa == sb {
    return str_lt(ty_qual_key(a), ty_qual_key(b))
  }
  false
}

fn ty_qual_list(buf: Buf, tys: Array(Ty), sep: String) {
  i = 0
  while i < tys.size {
    if i > 0 {
      buf.push_str(sep)
    }
    buf.push_str(ty_qual_key(tys[i]))
    i = i + 1
  }
}

// The member-order tie-break key: `show` with every nominal type prefixed by
// its defining module.
pub fn ty_qual_key(ty: Ty): String {
  k = ty.kind
  buf = buf_new()
  if k == tyk_union() {
    ty_qual_list(buf, ty.members, "|")
    return buf.to_s
  }
  if k == tyk_fn() {
    buf.push_str("fn(")
    ty_qual_list(buf, ty.members, ",")
    buf.push_str("):")
    if r = ty.inner {
      buf.push_str(ty_qual_key(r))
    }
    return buf.to_s
  }
  if k == tyk_hash() {
    buf.push_str("Hash(")
    if ke = ty.key {
      buf.push_str(ty_qual_key(ke))
    }
    buf.push_str(",")
    if va = ty.val {
      buf.push_str(ty_qual_key(va))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == tyk_array() || k == tyk_ptr() || k == tyk_join() {
    if k == tyk_array() {
      buf.push_str("Array(")
    } else {
      if k == tyk_ptr() {
        buf.push_str("Ptr(")
      } else {
        buf.push_str("JoinHandle(")
      }
    }
    if e = ty.inner {
      buf.push_str(ty_qual_key(e))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if ty.mod_name.size > 0 {
    buf.push_str(ty.mod_name)
    buf.push_str(".")
  }
  if ty.origin.size > 0 && ty.ty_args.size > 0 {
    buf.push_str(ty.origin)
    buf.push_str("(")
    ty_qual_list(buf, ty.ty_args, ",")
    buf.push_str(")")
    return buf.to_s
  }
  buf.push_str(ty.show)
  buf.to_s
}

pub fn ty_union_build(types: Array(Ty)): Ty {
  flat: Array(Ty) = []
  i = 0
  while i < types.size {
    ty_flatten_into(types[i], flat)
    i = i + 1
  }
  uniq: Array(Ty) = []
  for t in flat {
    seen = false
    for j in 0..uniq.size {
      if uniq[j].same_as(t) {
        seen = true
      }
    }
    if !seen {
      uniq.push(t)
    }
  }
  i = 1
  while i < uniq.size {
    j = i
    while j > 0 {
      if ty_member_before(uniq[j], uniq[j - 1]) {
        tmp = uniq[j - 1]
        uniq[j - 1] = uniq[j]
        uniq[j] = tmp
        j = j - 1
      } else {
        break
      }
    }
    i = i + 1
  }
  if uniq.size == 0 {
    return ty_nil()
  }
  if uniq.size == 1 {
    return uniq[0]
  }
  u = Ty.new(tyk_union())
  u.members = uniq
  u
}

pub fn ty_nilable(inner: Ty): Ty {
  parts: Array(Ty) = []
  parts.push(inner)
  parts.push(ty_nil())
  ty_union_build(parts)
}

pub fn ty_without_nil(ty: Ty): Ty {
  kept: Array(Ty) = []
  for m in ty.members {
    if !m.is_nil {
      kept.push(m)
    }
  }
  ty_union_build(kept)
}

pub fn if_assign_payload(ty: Ty): Ty? {
  if ty.is_union {
    if ty.includes_nil {
      success = ty_without_nil(ty)
      if success.is_union {
        return nil
      }
      return success
    }
    if ty.members.size == 2 {
      a = ty.members[0]
      b = ty.members[1]
      if a.is_class {
        if b.is_class {
          return nil
        }
        return b
      }
      if b.is_class {
        return a
      }
    }
  }
  nil
}

pub fn if_assign_failure(ty: Ty): Ty {
  if ty.includes_nil {
    return ty_nil()
  }
  for m in ty.members {
    if m.is_class {
      return m
    }
  }
  ty_nil()
}

pub fn ty_assignable(got: Ty, want: Ty): Bool {
  if got.same_as(want) {
    return true
  }
  if want.is_union && want.includes_member(got) {
    return true
  }
  if got.is_union && want.is_union {
    for mem in got.members {
      if !want.includes_member(mem) {
        return false
      }
    }
    return true
  }
  false
}

pub fn type_is_builtin(name: String): Bool {
  if name == "Int" {
    return true
  }
  if c_scalar_of(name) > 0 {
    return true
  }
  if name == "Int64" {
    return true
  }
  if name == "UInt64" {
    return true
  }
  if name == "Bool" {
    return true
  }
  if name == "Float64" {
    return true
  }
  if name == "String" {
    return true
  }
  if name == "Void" {
    return true
  }
  if name == "Array" {
    return true
  }
  if name == "Ptr" {
    return true
  }
  if name == "Hash" {
    return true
  }
  if name == "Buf" {
    return true
  }
  if name == "Bytes" {
    return true
  }
  if name == "Nil" {
    return true
  }
  name == "JoinHandle"
}
