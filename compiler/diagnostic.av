import location
import std.fs

pub fn diag_category(message: String): Int {
  if message.contains("unterminated") {
    return 5
  }
  if message.contains("unexpected character") {
    return 6
  }
  if message.contains("unknown") {
    return 1
  }
  if message.contains("already") {
    return 2
  }
  if message.contains("duplicate") {
    return 2
  }
  if message.contains("collides") {
    return 2
  }
  if message.contains("arguments") {
    return 3
  }
  if message.contains("argument") {
    return 3
  }
  if message.contains("expected") {
    return 4
  }
  if message.contains("missing return") {
    return 7
  }
  0
}

pub fn diag_code(phase: Int, message: String): String {
  cat = diag_category(message)
  "E${phase}00${cat}"
}

pub fn diag_line_text(text: String, want_line: Int): String {
  line = 1
  start = 0
  i = 0
  while i < text.size {
    if text[i] == 10 {
      if line == want_line {
        return text[start..i]
      }
      line += 1
      start = i + 1
    }
    i += 1
  }
  if line == want_line {
    return text[start..]
  }
  ""
}

pub class CompileError {
  loc: Location
  code: String = ""
  message: String = ""

  fn initialize(loc: Location, code: String, message: String) {
    self.loc = loc
    self.code = code
    self.message = message
  }

  pub fn show: String {
    "${self.loc.show()}: ${self.message}"
  }

  // An error in a generic instance's body, moved to the call that made
  // the instance: the note says which instance and, for code a program
  // can open, where in it.
  pub fn move_to(loc: Location, note: String) {
    if self.loc.path.size > 0 && self.loc.path != "<avant>" {
      self.message = "${self.message} (${note}, at ${self.loc.show()})"
    } else {
      self.message = "${self.message} (${note})"
    }
    self.loc = loc
  }

  pub fn render: String {
    buf = Buf.new()
    buf.push_str("error[${self.code}]: ${self.message}\n")
    buf.push_str("  --> ${self.loc.show()}\n")
    if self.loc.path.size > 0 {
      if text = fs.read(self.loc.path) {
        line_text = diag_line_text(text, self.loc.line())
        if line_text.size > 0 {
          num = "${self.loc.line()}"
          buf.push_str("${num} | ${line_text}\n")
          pad = Buf.new()
          for j in 0..num.size {
            pad.push_str(" ")
          }
          buf.push_str("${pad.to_s()} | ")
          for k in 1..self.loc.column() {
            buf.push_str(" ")
          }
          buf.push_str("^\n")
        }
      }
    }
    buf.to_s()
  }
}

pub class DiagBag {
  pub items: Array(CompileError) = []
  pub suppressed: Int = 0
  // Every push counts, kept, repeated or past the cap of 20: a mark is
  // this count, so an error since a mark is always seen. The shown items
  // stop growing at 20 and skip repeats, so their count cannot be a mark:
  // once it stopped, a parser loop that waits for an error to resync never
  // saw one and spun on the same token. before_items and before_suppressed
  // hold the state before each push, so truncate(mark) can undo a
  // speculative parse exactly.
  pub pushes: Int = 0
  before_items: Array(Int) = []
  before_suppressed: Array(Int) = []

  pub fn count: Int {
    self.items.size
  }

  // Undo every push after mark (a pushes value).
  pub fn truncate(mark: Int) {
    if self.pushes <= mark {
      return
    }
    keep = self.before_items[mark]
    while self.items.size > keep {
      self.items.pop()
    }
    self.suppressed = self.before_suppressed[mark]
    while self.before_items.size > mark {
      self.before_items.pop()
      self.before_suppressed.pop()
    }
    self.pushes = mark
  }

  pub fn total: Int {
    self.items.size + self.suppressed
  }

  // n errors another bag counted but this one did not get as items: each
  // is a push, so a mark sees it, and with hidden each is also one of the
  // errors past the cap ("and N more errors"); without, it is a repeat,
  // which is never shown twice.
  pub fn note(n: Int, hidden: Bool) {
    for k in 0..n {
      self.before_items.push(self.items.size)
      self.before_suppressed.push(self.suppressed)
      self.pushes += 1
      if hidden {
        self.suppressed += 1
      }
    }
  }

  pub fn is_empty: Bool {
    self.items.size == 0
  }

  pub fn push(e: CompileError) {
    self.before_items.push(self.items.size)
    self.before_suppressed.push(self.suppressed)
    self.pushes += 1
    for old in self.items {
      if old.loc.line() == e.loc.line() && old.loc.column() == e.loc.column() && old.loc.path == e.loc.path && old.code == e.code && old.message == e.message {
        return
      }
    }
    if self.items.size >= 20 {
      self.suppressed += 1
      return
    }
    self.items.push(e)
  }

  pub fn extend(other: DiagBag) {
    i = 0
    while i < other.items.size {
      push(other.items[i])
      i += 1
    }
    note(other.suppressed, true)
  }

  pub fn render_all: String {
    buf = Buf.new()
    i = 0
    while i < self.items.size {
      buf.push_str(self.items[i].render())
      buf.push_str("\n")
      i += 1
    }
    if self.items.size > 1 {
      buf.push_str("error: aborting due to ${self.items.size} previous errors\n")
    }
    if self.suppressed > 0 {
      buf.push_str("error: and ${self.suppressed} more errors (limit 20)\n")
    }
    buf.to_s()
  }
}
