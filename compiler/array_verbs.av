// What each builtin Array method that changes its array does to it: one
// row per method, read by every rule that asks (the task freeze and the
// walk's refusal, the Mutex rule, the bounds facts, a constant's
// refusal, the lowering's freeze test of a rewritten call). A method
// added here is seen by all of them; a method missing from here is a
// reader of its array for every one of them, so a new changing method
// belongs here first.
//
// The effects, as bits of a row:
//   shrinks  may lower the size (a proven index may be out of range after)
//   grows    may raise the size
//   moves    may move the elements' storage (a reallocation)
//   reorders changes which element is at which position
//   writes   overwrites elements in place
//   stores   stores its argument (or the argument's elements) in the array
// and, from bit 8 on, the runtime's name of the operation for a frozen
// array's trap plus one (avant_rt.h AVANT_FROZEN_*; 0: none).

pub fn av_shrinks: Int { 1 }
pub fn av_grows: Int { 2 }
pub fn av_moves: Int { 4 }
pub fn av_reorders: Int { 8 }
pub fn av_writes: Int { 16 }
pub fn av_stores: Int { 32 }

fn av_row(effects: Int, frozen_op: Int): Int {
  effects + (frozen_op + 1) * 256
}

// The row of the method name, or 0 for a method that only reads.
pub fn array_verb_row(name: String): Int {
  if name == "push" {
    return av_row(av_grows() + av_moves() + av_stores(), 0)
  }
  if name == "pop" {
    return av_row(av_shrinks(), 1)
  }
  if name == "clear" {
    return av_row(av_shrinks(), 2)
  }
  if name == "fill" {
    return av_row(av_writes() + av_stores(), 3)
  }
  if name == "sort" {
    return av_row(av_reorders() + av_writes(), 4)
  }
  if name == "sort_by" {
    return av_row(av_reorders() + av_writes(), 4)
  }
  if name == "reverse" {
    return av_row(av_reorders() + av_writes(), 5)
  }
  if name == "reserve" {
    return av_row(av_moves(), 6)
  }
  if name == "delete_if" {
    return av_row(av_shrinks() + av_reorders(), 8)
  }
  if name == "insert" {
    return av_row(av_grows() + av_moves() + av_reorders() + av_stores(), 9)
  }
  if name == "delete_at" {
    return av_row(av_shrinks() + av_reorders(), 10)
  }
  if name == "try_delete_at" {
    return av_row(av_shrinks() + av_reorders(), 10)
  }
  if name == "concat" {
    return av_row(av_grows() + av_moves() + av_stores(), 11)
  }
  if name == "shuffle" {
    return av_row(av_reorders() + av_writes(), 12)
  }
  0
}

// Whether the method name has any of the effects of bits.
pub fn array_verb_has(name: String, bits: Int): Bool {
  row = array_verb_row(name)
  (row & bits) != 0
}

// Whether the method name changes its array at all.
pub fn array_verb_changes(name: String): Bool {
  array_verb_row(name) != 0
}

// The runtime's operation for a frozen array's trap, or -1.
pub fn array_verb_frozen_op(name: String): Int {
  row = array_verb_row(name)
  row / 256 - 1
}

// The checker writes some methods as the call of a generic function
// whose first argument is the array (checker/verbs.av), named
// `__avant_` and the method: by the time a block is walked or lowered,
// `xs.shuffle(rng)` is `__avant_shuffle(xs, rng)`. The method such a
// call stands for when it changes its array, else "".
pub fn array_verb_of_template(callee: String): String {
  if callee.size <= 8 || !callee.starts_with("__avant_") {
    return ""
  }
  name = str_slice(callee, 8, callee.size)
  if array_verb_changes(name) {
    return name
  }
  ""
}
