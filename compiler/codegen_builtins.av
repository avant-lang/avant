pub fn (codegen_self: MycGen) emit_array_push(expr: Expr, ty: Ty) {
  if e = ty.inner {
    if e.is_int {
      if expr.args.size > 0 {
        codegen_self.emit_expr(expr.args[0])
        codegen_self.emit_coerce(expr_ty(expr.args[0]), e)
      }
      if recv = expr.receiver {
        codegen_self.emit_expr(recv)
      }
      codegen_self.line("CALL :avant_array_push_i32")
      return
    }
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
      codegen_self.emit_coerce(expr_ty(expr.args[0]), e)
    }
    val = codegen_self.new_temp
    em = ty_myc(e)
    codegen_self.line("LOCAL :${val} :${em}")
    codegen_self.line("STORE")
    codegen_self.ensure_root(val, e)
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    arr = codegen_self.new_temp
    m = ty_myc(ty)
    codegen_self.line("LOCAL :${arr} :${m}")
    codegen_self.line("STORE")
    codegen_self.ensure_root(arr, ty)
    tid = array_type_id(e)
    if heap_ptr_value(e) {
      codegen_self.line("PUSH ${tid} :u32")
      codegen_self.line("LOCAL :${val}")
      codegen_self.line("LOCAL :${arr}")
      codegen_self.line("CALL :avant_array_push_ptr")
      return
    }
    codegen_self.line("PUSH ${tid} :u32")
    codegen_self.line("SIZEOF :${em}")
    codegen_self.line("AS :u64")
    codegen_self.line("LOCAL :${arr}")
    codegen_self.line("CALL :avant_array_push_slot")
    codegen_self.line("AS :ptr<${em}>")
    codegen_self.line("LOCAL :${val}")
    codegen_self.line("STACK :swap2")
    codegen_self.line("DEREF")
    codegen_self.line("STORE")
  }
}

pub fn (codegen_self: MycGen) emit_array_each(expr: Expr, ty: Ty) {
  if b = expr.block {
    pname = b.params[0]
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    arr = codegen_self.new_temp
    m = ty_myc(ty)
    codegen_self.line("LOCAL :${arr} :${m}")
    codegen_self.line("STORE")
    codegen_self.ensure_root(arr, ty)
    i = codegen_self.new_temp
    codegen_self.line("PUSH 0")
    codegen_self.line("LOCAL :${i} :i32")
    codegen_self.line("STORE")
    codegen_self.line("LOOP")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("COND")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("LOCAL :${arr}")
    codegen_self.line("DEREF")
    codegen_self.line("FIELD 1")
    codegen_self.line("LOCAL :${i}")
    codegen_self.line("BINARY :less")
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("BODY")
    codegen_self.indent = codegen_self.indent + 1
    if e = ty.inner {
      em = ty_myc(e)
      buf = codegen_self.new_temp
      codegen_self.line("LOCAL :${arr}")
      codegen_self.line("DEREF")
      codegen_self.line("FIELD 0")
      codegen_self.line("LOCAL :${buf} :ptr<${em}>")
      codegen_self.line("STORE")
      codegen_self.line("LOCAL :${i}")
      codegen_self.line("LOCAL :${buf}")
      codegen_self.line("BINARY :add")
      codegen_self.line("DEREF")
      codegen_self.line("LOCAL :${pname} :${em}")
      codegen_self.line("STORE")
      codegen_self.ensure_root(pname, e)
    }
    codegen_self.emit_stmts(b.body, false)
    codegen_self.line("PUSH 1")
    codegen_self.line("LOCAL :${i}")
    codegen_self.line("BINARY :add")
    codegen_self.line("LOCAL :${i} :i32")
    codegen_self.line("STORE")
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("ENDLOOP")
  }
}

pub fn (codegen_self: MycGen) emit_int_convert(from: Ty, name: String) {
  if str_eq(name, "to_f") {
    codegen_self.line("AS :f64")
    return
  }
  if str_eq(name, "abs") {
    codegen_self.line("UNARY :abs")
    return
  }
  if str_eq(name, "to_i") {
    if from.is_int {
      return
    }
    codegen_self.line("AS :i32")
    return
  }
  if str_eq(name, "to_i64") {
    if from.is_int {
      codegen_self.line("TO :i64")
    } else if from.is_uint64 {
      codegen_self.line("AS :i64")
    }
    return
  }
  if str_eq(name, "to_u64") {
    if from.is_int {
      codegen_self.line("TO :i64")
      codegen_self.line("AS :u64")
    } else if from.is_int64 {
      codegen_self.line("AS :u64")
    }
  }
}

pub fn (codegen_self: MycGen) emit_float_field(expr: Expr) {
  if obj = expr.object {
    codegen_self.emit_expr(obj)
  }
  if str_eq(expr.ident, "sqrt") {
    codegen_self.line("UNARY :sqrt")
  } else if str_eq(expr.ident, "abs") {
    codegen_self.line("UNARY :abs")
  } else if str_eq(expr.ident, "floor") {
    codegen_self.line("UNARY :floor")
  } else if str_eq(expr.ident, "to_i") {
    codegen_self.line("UNARY :trunc")
    codegen_self.line("AS :i32")
  }
}

pub fn (codegen_self: MycGen) emit_int_field(expr: Expr) {
  if obj = expr.object {
    codegen_self.emit_expr(obj)
    codegen_self.emit_int_convert(expr_ty(obj), expr.ident)
  }
}

pub fn (codegen_self: MycGen) emit_float_method(expr: Expr) {
  if recv = expr.receiver {
    codegen_self.emit_expr(recv)
  }
  if str_eq(expr.callee, "sqrt") {
    codegen_self.line("UNARY :sqrt")
  } else if str_eq(expr.callee, "exp") {
    codegen_self.line("CALL :avant_exp")
  } else if str_eq(expr.callee, "abs") {
    codegen_self.line("UNARY :abs")
  } else if str_eq(expr.callee, "floor") {
    codegen_self.line("UNARY :floor")
  } else if str_eq(expr.callee, "to_i") {
    codegen_self.line("UNARY :trunc")
    codegen_self.line("AS :i32")
  }
}

pub fn (codegen_self: MycGen) emit_int_method(expr: Expr) {
  if recv = expr.receiver {
    codegen_self.emit_expr(recv)
    codegen_self.emit_int_convert(expr_ty(recv), expr.callee)
  }
}

pub fn (codegen_self: MycGen) emit_from_utf8(expr: Expr) {
  found = codegen_self.new_temp
  codegen_self.line("PUSH 0")
  codegen_self.line("LOCAL :${found} :i32")
  codegen_self.line("STORE")
  codegen_self.line("LOCAL :${found}")
  codegen_self.line("ADDR")
  if expr.args.size > 0 {
    codegen_self.emit_expr(expr.args[0])
  }
  codegen_self.line("CALL :avant_str_from_utf8")
  val_ty = ty_string()
  val = codegen_self.new_temp
  vm = ty_myc(val_ty)
  codegen_self.line("LOCAL :${val} :${vm}")
  codegen_self.line("STORE")
  codegen_self.ensure_root(val, val_ty)
  want = expr_ty(expr)
  wm = ty_myc(want)
  slot = codegen_self.new_temp
  codegen_self.line("LOCAL :${found}")
  codegen_self.line("PUSH 1")
  codegen_self.line("BINARY :eq")
  codegen_self.line("IF")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("THEN")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("LOCAL :${val}")
  codegen_self.emit_wrap_union(val_ty, want)
  codegen_self.line("LOCAL :${slot} :${wm}")
  codegen_self.line("STORE")
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ELSE")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.emit_zero(ty_nil())
  codegen_self.emit_wrap_union(ty_nil(), want)
  codegen_self.line("LOCAL :${slot} :${wm}")
  codegen_self.line("STORE")
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDIF")
  codegen_self.line("LOCAL :${slot}")
}

pub fn (codegen_self: MycGen) emit_bytes_method(expr: Expr) {
  if str_eq(expr.callee, "get") {
    if recv = expr.receiver {
      codegen_self.emit_string_get(recv, expr)
    }
    return
  }
  if str_eq(expr.callee, "slice") {
    if expr.args.size > 1 {
      codegen_self.emit_expr(expr.args[1])
    }
    stop = codegen_self.new_temp
    codegen_self.line("LOCAL :${stop} :i32")
    codegen_self.line("STORE")
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    start = codegen_self.new_temp
    codegen_self.line("LOCAL :${start} :i32")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    s = codegen_self.new_temp
    codegen_self.line("LOCAL :${s} :ptr<u8>")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${stop}")
    codegen_self.line("LOCAL :${start}")
    codegen_self.line("LOCAL :${s}")
    codegen_self.line("CALL :avant_str_slice")
    return
  }
  if str_eq(expr.callee, "to_buf") {
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    codegen_self.line("CALL :avant_bytes_to_buf")
    return
  }
  if str_eq(expr.callee, "chars") {
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    codegen_self.line("CALL :avant_bytes_chars")
    m = ty_myc(expr_ty(expr))
    codegen_self.line("AS :${m}")
    return
  }
  if recv = expr.receiver {
    codegen_self.emit_expr(recv)
  }
}

pub fn (codegen_self: MycGen) emit_string_method(expr: Expr) {
  if str_eq(expr.callee, "get") {
    if recv = expr.receiver {
      codegen_self.emit_string_get(recv, expr)
    }
    return
  }
  if str_eq(expr.callee, "split") {
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    sep = codegen_self.new_temp
    codegen_self.line("LOCAL :${sep} :ptr<u8>")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    s = codegen_self.new_temp
    codegen_self.line("LOCAL :${s} :ptr<u8>")
    codegen_self.line("STORE")
    codegen_self.ensure_root(s, ty_string())
    codegen_self.line("LOCAL :${sep}")
    codegen_self.line("LOCAL :${s}")
    codegen_self.line("CALL :avant_str_split")
    m = ty_myc(expr_ty(expr))
    codegen_self.line("AS :${m}")
    return
  }
  if str_eq(expr.callee, "fields") {
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    codegen_self.line("CALL :avant_str_fields")
    m = ty_myc(expr_ty(expr))
    codegen_self.line("AS :${m}")
    return
  }
  if str_eq(expr.callee, "strip") || str_eq(expr.callee, "strip_left") || str_eq(expr.callee, "strip_right") {
    mode = 0
    if str_eq(expr.callee, "strip_left") {
      mode = 1
    }
    if str_eq(expr.callee, "strip_right") {
      mode = 2
    }
    codegen_self.line("PUSH ${mode}")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    codegen_self.line("CALL :avant_str_strip")
    return
  }
  if str_eq(expr.callee, "bytes") {
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    return
  }
  if str_eq(expr.callee, "chars") {
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    codegen_self.line("CALL :avant_str_chars")
    m = ty_myc(expr_ty(expr))
    codegen_self.line("AS :${m}")
    return
  }
  if recv = expr.receiver {
    codegen_self.emit_expr(recv)
  }
  if str_eq(expr.callee, "to_f") {
    codegen_self.line("CALL :avant_str_to_f")
  } else if str_eq(expr.callee, "to_i") {
    codegen_self.line("CALL :avant_str_to_i")
  }
}

pub fn (codegen_self: MycGen) emit_buf_method(expr: Expr) {
  if str_eq(expr.callee, "get") {
    if recv = expr.receiver {
      codegen_self.emit_buf_get(recv, expr)
    }
    return
  }
  if str_eq(expr.callee, "push_bytes") {
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    s = codegen_self.new_temp
    codegen_self.line("LOCAL :${s} :ptr<u8>")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    buf = codegen_self.new_temp
    codegen_self.line("LOCAL :${buf} :ptr<void>")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${s}")
    codegen_self.line("LOCAL :${buf}")
    codegen_self.line("CALL :avant_buf_push_str")
    return
  }
  if str_eq(expr.callee, "to_bytes") {
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    codegen_self.line("CALL :avant_buf_to_str")
    return
  }
  if str_eq(expr.callee, "push_byte") {
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    b = codegen_self.new_temp
    codegen_self.line("LOCAL :${b} :i32")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    buf = codegen_self.new_temp
    codegen_self.line("LOCAL :${buf} :ptr<void>")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${b}")
    codegen_self.line("LOCAL :${buf}")
    codegen_self.line("CALL :avant_buf_push_byte")
    return
  }
  if str_eq(expr.callee, "push_str") {
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    s = codegen_self.new_temp
    codegen_self.line("LOCAL :${s} :ptr<u8>")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    buf = codegen_self.new_temp
    codegen_self.line("LOCAL :${buf} :ptr<void>")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${s}")
    codegen_self.line("LOCAL :${buf}")
    codegen_self.line("CALL :avant_buf_push_str")
    return
  }
  if str_eq(expr.callee, "push_slice") {
    if expr.args.size > 2 {
      codegen_self.emit_expr(expr.args[2])
    }
    stop = codegen_self.new_temp
    codegen_self.line("LOCAL :${stop} :i32")
    codegen_self.line("STORE")
    if expr.args.size > 1 {
      codegen_self.emit_expr(expr.args[1])
    }
    start = codegen_self.new_temp
    codegen_self.line("LOCAL :${start} :i32")
    codegen_self.line("STORE")
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    s = codegen_self.new_temp
    codegen_self.line("LOCAL :${s} :ptr<u8>")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    buf = codegen_self.new_temp
    codegen_self.line("LOCAL :${buf} :ptr<void>")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${stop}")
    codegen_self.line("LOCAL :${start}")
    codegen_self.line("LOCAL :${s}")
    codegen_self.line("LOCAL :${buf}")
    codegen_self.line("CALL :avant_buf_push_slice")
    return
  }
  if str_eq(expr.callee, "push_fmt_f") {
    if expr.args.size > 1 {
      codegen_self.emit_expr(expr.args[1])
    }
    prec = codegen_self.new_temp
    codegen_self.line("LOCAL :${prec} :i32")
    codegen_self.line("STORE")
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    v = codegen_self.new_temp
    codegen_self.line("LOCAL :${v} :f64")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    buf = codegen_self.new_temp
    codegen_self.line("LOCAL :${buf} :ptr<void>")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${prec}")
    codegen_self.line("LOCAL :${v}")
    codegen_self.line("LOCAL :${buf}")
    codegen_self.line("CALL :avant_buf_push_fmt_f")
    return
  }
  if str_eq(expr.callee, "push_fmt_i") {
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    n = codegen_self.new_temp
    codegen_self.line("LOCAL :${n} :i32")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    buf = codegen_self.new_temp
    codegen_self.line("LOCAL :${buf} :ptr<void>")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${n}")
    codegen_self.line("LOCAL :${buf}")
    codegen_self.line("CALL :avant_buf_push_fmt_i")
    return
  }
  if str_eq(expr.callee, "starts_with") {
    if expr.args.size > 0 {
      codegen_self.emit_expr(expr.args[0])
    }
    s = codegen_self.new_temp
    codegen_self.line("LOCAL :${s} :ptr<u8>")
    codegen_self.line("STORE")
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    buf = codegen_self.new_temp
    codegen_self.line("LOCAL :${buf} :ptr<void>")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${s}")
    codegen_self.line("LOCAL :${buf}")
    codegen_self.line("CALL :avant_buf_starts")
    codegen_self.line("PUSH 1")
    codegen_self.line("BINARY :eq")
    return
  }
  if str_eq(expr.callee, "to_s") {
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    codegen_self.line("CALL :avant_buf_to_str")
    return
  }
  if str_eq(expr.callee, "clear") {
    if recv = expr.receiver {
      codegen_self.emit_expr(recv)
    }
    codegen_self.line("CALL :avant_buf_clear")
  }
}
