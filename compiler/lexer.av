import location
import diagnostic
import source
import token

pub fn ch_is_digit(c: Int): Bool {
  c >= 48 && c <= 57
}

pub fn ch_is_alpha(c: Int): Bool {
  if c >= 65 && c <= 90 {
    return true
  }
  if c >= 97 && c <= 122 {
    return true
  }
  false
}

pub fn ch_is_ident_start(c: Int): Bool {
  if ch_is_alpha(c) {
    return true
  }
  c == 95
}

pub fn ch_is_ident_continue(c: Int): Bool {
  if ch_is_ident_start(c) {
    return true
  }
  ch_is_digit(c)
}

pub fn ch_is_hex(c: Int): Bool {
  if ch_is_digit(c) {
    return true
  }
  if c >= 97 && c <= 102 {
    return true
  }
  if c >= 65 && c <= 70 {
    return true
  }
  false
}

// A hex digit's value, else -1.
pub fn hex_val(c: Int): Int {
  if ch_is_digit(c) {
    return c - 48
  }
  if c >= 97 && c <= 102 {
    return c - 87
  }
  if c >= 65 && c <= 70 {
    return c - 55
  }
  -1
}

// The quote escapes of a String (34) or of a character literal (39).
pub fn escape_quotes(qc: Int): String {
  if qc == 39 {
    return "\\'"
  }
  "\\\" \\$"
}

// Appends code point v (a Unicode scalar value) to buf as UTF-8.
pub fn push_utf8(buf: Buf, v: Int) {
  if v < 128 {
    buf.push_byte(v)
  } else if v < 2048 {
    buf.push_byte(192 + v / 64)
    buf.push_byte(128 + v % 64)
  } else if v < 65536 {
    buf.push_byte(224 + v / 4096)
    buf.push_byte(128 + v / 64 % 64)
    buf.push_byte(128 + v % 64)
  } else {
    buf.push_byte(240 + v / 262144)
    buf.push_byte(128 + v / 4096 % 64)
    buf.push_byte(128 + v / 64 % 64)
    buf.push_byte(128 + v % 64)
  }
}

// The number of bytes of the UTF-8 sequence that lead byte c starts (1 for
// a byte that starts none).
pub fn utf8_len(c: Int): Int {
  if c >= 240 && c < 248 {
    return 4
  }
  if c >= 224 {
    return 3
  }
  if c >= 192 {
    return 2
  }
  1
}

pub class Lexer {
  source: Source
  // The source's text and its size, read once: every byte the lexer
  // looks at was a call for the text's size before (at_end, and the
  // bounds check of the index), two or three per byte in bump. The text
  // never changes while it is lexed.
  src_text: String = ""
  text_n: Int = 0
  path: String = ""
  pos: Int = 0
  line: Int = 1
  column: Int = 1
  queue: Array(Token)
  qpos: Int = 0
  intern_map: Hash(String, String)
  keywords: Hash(String, Int)
  failed: Bool = false
  pub err: CompileError? = nil
  pub errors: DiagBag
  str_kind: Int = 0
  str_frag: String = ""
  keep_comments: Bool = false
  // Set by read_escape when the escape was \u{N} (a code point, not a byte).
  esc_code: Bool = false
  // How many string interpolations are being lexed around the current
  // token. A string that opens an interpolation inside another one is
  // refused where it opens, before its own interpolation is lexed: lexing
  // into it first made each level one more recursion, and thousands of
  // nested levels overflowed the compiler's stack before the refusal.
  interp_depth: Int = 0

  fn initialize(source: Source) {
    self.source = source
    self.src_text = source.text
    self.text_n = source.text.size
    self.path = source.path
    self.pos = 0
    self.line = 1
    self.column = 1
    self.queue = []
    self.qpos = 0
    im = Hash(String, String).new()
    self.intern_map = im
    self.keywords = keyword_table()
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new()
    self.str_kind = 0
    self.str_frag = ""
    self.keep_comments = false
    self.interp_depth = 0
  }

  pub fn has_err: Bool {
    self.failed
  }

  pub fn err_count: Int {
    self.errors.pushes
  }

  pub fn new_err_since(mark: Int): Bool {
    self.errors.pushes > mark
  }

  pub fn at_end: Bool {
    self.pos >= self.text_n
  }

  pub fn here: Location {
    Location.new(self.path, self.line, self.column, self.pos)
  }

  pub fn peek: Int {
    if self.pos >= self.text_n {
      return 0
    }
    self.src_text[self.pos]
  }

  pub fn peek_at(n: Int): Int {
    p = self.pos + n
    if p >= self.text_n {
      return 0
    }
    self.src_text[p]
  }

  pub fn peek_next: Int {
    peek_at(1)
  }

  pub fn bump {
    if self.pos >= self.text_n {
      return
    }
    c = self.src_text[self.pos]
    self.pos += 1
    if c == 10 {
      self.line += 1
      self.column = 1
    } else {
      self.column += 1
    }
  }

  pub fn skip_spaces {
    while true {
      c = self.peek()
      if c == 32 || c == 9 || c == 13 {
        self.bump()
      } else {
        break
      }
    }
  }

  // After a refusal inside a string: the rest of the line is not lexed,
  // so a line of nested strings gives one error, not one per level.
  pub fn skip_to_line_end {
    while !self.at_end() && self.peek() != 10 {
      self.bump()
    }
  }

  pub fn skip_line_comment {
    if self.peek() == 47 {
      self.bump()
    }
    if self.peek() == 47 {
      self.bump()
    }
    if self.peek() == 32 && peek_at(1) == 102 && peek_at(2) == 105 && peek_at(3) == 108 && peek_at(4) == 101 && peek_at(5) == 58 && peek_at(6) == 32 {
      self.bump()
      self.bump()
      self.bump()
      self.bump()
      self.bump()
      self.bump()
      self.bump()
      start = self.pos
      while true {
        if self.at_end() {
          break
        }
        if self.peek() == 10 {
          break
        }
        self.bump()
      }
      self.path = intern_str(self.source.text[start..self.pos])
      self.line = 0
      self.column = 1
      return
    }
    while true {
      if self.at_end() {
        break
      }
      if self.peek() == 10 {
        break
      }
      self.bump()
    }
  }

  pub fn intern_str(s: String): String {
    if existing = self.intern_map.get(s) {
      return existing
    }
    self.intern_map[s] = s
    s
  }

  pub fn fail_tok(loc: Location, message: String): Token {
    e = CompileError.new(loc, diag_code(1, message), message)
    if self.errors.count() == 0 {
      self.err = e
    }
    self.failed = true
    self.errors.push(e)
    Token.new(tk_eof(), loc, "")
  }

  pub fn queue_empty: Bool {
    self.qpos >= self.queue.size
  }

  pub fn queue_take: Token {
    t = self.queue[self.qpos]
    self.qpos += 1
    t
  }

  // A string opened inside more interpolations than interp_limit: one
  // error at it, the rest of its line skipped, so each lexer level above
  // it returns at once (the lexer recurses once a level; without a bound,
  // some thousands of levels overflowed its stack).
  pub fn interp_too_deep(loc: Location): Token {
    self.skip_to_line_end()
    fail_tok(loc, "this program nests string interpolations deeper than ${interp_limit()} levels: give an inner string a name first (inner = \"...\${x}...\"), then interpolate the name")
  }

  pub fn queue_push(t: Token) {
    self.queue.push(t)
  }

  // The queued tokens from index from on, moved to the end of tokens in
  // order (an inner interpolated string's, read inside an outer
  // interpolation, belong there and not after the outer string).
  pub fn take_queued(tokens: Array(Token), from: Int) {
    tokens.concat(self.queue[from..])
    while self.queue.size > from {
      _ = self.queue.pop()
    }
  }

  pub fn read_ident: String {
    start = self.pos
    while ch_is_ident_continue(self.peek()) {
      self.bump()
    }
    self.source.text[start..self.pos]
  }

  pub fn exponent_ahead: Bool {
    c = self.peek()
    if c != 101 && c != 69 {
      return false
    }
    n = self.peek_next()
    if ch_is_digit(n) {
      return true
    }
    if n == 43 || n == 45 {
      return ch_is_digit(peek_at(2))
    }
    false
  }

  pub fn read_int_suffix: String {
    if self.peek() == 117 && self.peek_next() == 54 && peek_at(2) == 52 {
      if ch_is_ident_continue(peek_at(3)) {
        return ""
      }
      self.bump()
      self.bump()
      self.bump()
      return "u64"
    }
    if self.peek() == 105 && self.peek_next() == 54 && peek_at(2) == 52 {
      if ch_is_ident_continue(peek_at(3)) {
        return ""
      }
      self.bump()
      self.bump()
      self.bump()
      return "i64"
    }
    ""
  }

  // A digit of base 2, 8, 10 or 16.
  pub fn digit_of(c: Int, base: Int): Bool {
    if base == 16 {
      return ch_is_hex(c)
    }
    if base == 10 {
      return ch_is_digit(c)
    }
    c >= 48 && c < 48 + base
  }

  // The digits of one run (an integer part, a fraction, an exponent),
  // with `_` between two digits; false after an error.
  pub fn scan_digits(base: Int): Bool {
    while true {
      c = self.peek()
      if c == 95 {
        if !digit_of(self.peek_next(), base) {
          fail_tok(self.here(), "a `_` in a number stands between two digits")
          return false
        }
        self.bump()
        continue
      }
      if !digit_of(c, base) {
        return true
      }
      self.bump()
    }
    true
  }

  // A number's text without its separators (the formatter keeps them).
  pub fn number_text(start: Int): String {
    raw = self.source.text[start..self.pos]
    if self.keep_comments {
      return raw
    }
    b = Buf.new()
    for i in 0..raw.size {
      if raw[i] != 95 {
        b.push_byte(raw[i])
      }
    }
    b.to_s()
  }

  // 0x, 0b and 0o: a prefix in lower case (0X too, as before), at
  // least one digit after it, `_` only between digits; a decimal
  // digit that is no digit of the base is an error.
  pub fn read_prefixed(loc: Location, start: Int, base: Int, name: String, p: String): Token {
    self.bump()
    self.bump()
    if self.peek() == 95 {
      return fail_tok(self.here(), "a `_` in a number stands between two digits, not after ${p}")
    }
    if !digit_of(self.peek(), base) {
      return fail_tok(self.here(), "${name} literal needs a digit after ${p}")
    }
    if !scan_digits(base) {
      return Token.new(tk_eof(), loc, "")
    }
    if ch_is_digit(self.peek()) {
      article = "a"
      if base == 8 {
        article = "an"
      }
      return fail_tok(self.here(), "${chr(self.peek())} is not ${article} ${name} digit")
    }
    text = number_text(start)
    suffix = self.read_int_suffix()
    if suffix.size == 0 {
      return Token.new(tk_integer(), loc, intern_str(text))
    }
    Token.new(tk_integer(), loc, intern_str(text + suffix))
  }

  pub fn read_number(loc: Location): Token {
    start = self.pos
    if self.peek() == 48 {
      n = self.peek_next()
      if n == 120 || n == 88 {
        return read_prefixed(loc, start, 16, "hex", "0x")
      }
      if n == 98 {
        return read_prefixed(loc, start, 2, "binary", "0b")
      }
      if n == 111 {
        return read_prefixed(loc, start, 8, "octal", "0o")
      }
      if n == 66 || n == 79 {
        return fail_tok(loc, "write the prefix in lower case: 0${chr(n + 32)}")
      }
    }
    if !scan_digits(10) {
      return Token.new(tk_eof(), loc, "")
    }
    int_end = self.pos
    is_float = false
    if self.peek() == 46 && ch_is_digit(self.peek_next()) {
      is_float = true
      self.bump()
      if !scan_digits(10) {
        return Token.new(tk_eof(), loc, "")
      }
    }
    if self.exponent_ahead() {
      is_float = true
      self.bump()
      s = self.peek()
      if s == 43 || s == 45 {
        self.bump()
      }
      if !scan_digits(10) {
        return Token.new(tk_eof(), loc, "")
      }
    }
    text = number_text(start)
    if is_float {
      return Token.new(tk_float(), loc, intern_str(text))
    }
    if int_end - start > 1 && self.source.text[start] == 48 {
      digits = number_text(start)
      i = 0
      while i < digits.size - 1 && (digits[i] == 48 || digits[i] == 95) {
        i += 1
      }
      rest = digits[i..]
      octal = true
      for j in 0..rest.size {
        if rest[j] > 55 {
          octal = false
        }
      }
      if octal {
        return fail_tok(loc, "a number does not start with 0: write ${rest} for the decimal number, or 0o${rest} for an octal one")
      }
      return fail_tok(loc, "a number does not start with 0: write ${rest}")
    }
    suffix = self.read_int_suffix()
    if suffix.size == 0 {
      return Token.new(tk_integer(), loc, intern_str(text))
    }
    Token.new(tk_integer(), loc, intern_str(text + suffix))
  }

  // One escape after a backslash: \n \t \r \\ \0, \xNN (one byte, two hex
  // digits) and \u{N} (a code point, one to six hex digits; the caller
  // encodes it as UTF-8 and esc_code says so). In a String also \" and \$;
  // in a character literal (qc 39) \' instead. No \e (a GNU extension of
  // C).
  pub fn read_escape(qc: Int): Int {
    self.esc_code = false
    // The escape's backslash, which the caller consumed: errors point at it.
    at = Location.new(self.path, self.line, self.column - 1, self.pos - 1)
    if self.at_end() {
      fail_tok(at, "unterminated string escape")
      return 0
    }
    c = self.peek()
    self.bump()
    if c == 110 {
      return 10
    }
    if c == 116 {
      return 9
    }
    if c == 114 {
      return 13
    }
    if c == 92 {
      return 92
    }
    if c == 48 {
      return 0
    }
    if qc == 34 && (c == 34 || c == 36) {
      return c
    }
    if qc == 39 && c == 39 {
      return 39
    }
    if c == 120 {
      h1 = hex_val(self.peek())
      h2 = hex_val(self.peek_next())
      if h1 < 0 || h2 < 0 {
        fail_tok(at, "\\x takes two hex digits: \\x41")
        return 0
      }
      self.bump()
      self.bump()
      return h1 * 16 + h2
    }
    if c == 117 {
      return read_code_escape(at)
    }
    what = "string"
    if qc == 39 {
      what = "character"
    }
    fail_tok(at, "unknown ${what} escape \\" + chr(c) + "; the escapes are \\n \\t \\r \\\\ \\0 \\xNN \\u{N} and " + escape_quotes(qc))
    0
  }

  // \u{N}: one to six hex digits, a Unicode scalar value (not a surrogate,
  // at most 10FFFF).
  pub fn read_code_escape(at: Location): Int {
    if self.peek() != 123 {
      fail_tok(at, "\\u takes a code point in braces: \\u{e9}")
      return 0
    }
    self.bump()
    v = 0
    n = 0
    while hex_val(self.peek()) >= 0 {
      if n < 7 {
        v = v * 16 + hex_val(self.peek())
      }
      n += 1
      self.bump()
    }
    if self.peek() != 125 || n == 0 {
      fail_tok(at, "\\u takes a code point in braces: \\u{e9}")
      return 0
    }
    self.bump()
    if n > 6 || v > 1114111 {
      fail_tok(at, "\\u{...} is above 10FFFF, the last Unicode code point")
      return 0
    }
    if v >= 55296 && v <= 57343 {
      fail_tok(at, "\\u{...} names a surrogate (D800 to DFFF), which is not a character")
      return 0
    }
    self.esc_code = true
    v
  }

  // A character literal: 'a' is the Int byte value 97, with the escapes
  // of read_escape (\' for the quote); a character that is more than
  // one byte in UTF-8 is an error, and there is no Char type. The token
  // is an integer: its text the decimal value, or the source as written
  // for the formatter.
  pub fn read_char_token(loc: Location): Token {
    start = self.pos
    self.bump()
    c = self.peek()
    if self.at_end() || c == 10 {
      return fail_tok(loc, "unterminated character literal")
    }
    if c == 39 {
      self.bump()
      return fail_tok(loc, "empty character literal: a character literal holds one byte, as 'a'")
    }
    v = c
    if c == 92 {
      self.bump()
      mark = self.err_count()
      v = self.read_escape(39)
      if !new_err_since(mark) && self.esc_code && v > 127 {
        b = Buf.new()
        push_utf8(b, v)
        fail_tok(loc, "a character literal is one byte, and this code point is ${b.size} bytes in UTF-8: write it in a String")
      }
      if new_err_since(mark) {
        self.skip_char_rest()
        return Token.new(tk_eof(), loc, "")
      }
    } else if c >= 128 {
      n = utf8_len(c)
      i = 0
      while i < n && !self.at_end() {
        self.bump()
        i += 1
      }
      self.skip_char_rest()
      return fail_tok(loc, "a character literal is one byte, and this character is ${n} bytes in UTF-8: write it in a String")
    } else {
      self.bump()
    }
    if self.peek() != 39 {
      while !self.at_end() && self.peek() != 39 && self.peek() != 10 {
        self.bump()
      }
      if self.peek() == 39 {
        self.bump()
        return fail_tok(loc, "a character literal holds one byte: write a String in double quotes for several")
      }
      return fail_tok(loc, "unterminated character literal")
    }
    self.bump()
    if self.keep_comments {
      return Token.new(tk_integer(), loc, self.source.text[start..self.pos])
    }
    Token.new(tk_integer(), loc, intern_str("${v}"))
  }

  // After a character literal's error: up to its closing quote on the line.
  pub fn skip_char_rest {
    while !self.at_end() && self.peek() != 39 && self.peek() != 10 {
      self.bump()
    }
    if self.peek() == 39 {
      self.bump()
    }
  }

  pub fn read_string_body {
    buf = Buf.new()
    while true {
      if self.at_end() {
        fail_tok(self.here(), "unterminated string")
        self.str_frag = ""
        self.str_kind = 2
        return
      }
      c = self.peek()
      if c == 34 {
        self.bump()
        self.str_frag = intern_str(buf.to_s())
        self.str_kind = 0
        return
      }
      if c == 10 {
        fail_tok(self.here(), "unterminated string")
        self.str_frag = ""
        self.str_kind = 2
        return
      }
      if c == 92 {
        self.bump()
        mark = self.err_count()
        e = self.read_escape(34)
        if new_err_since(mark) {
          self.str_frag = ""
          self.str_kind = 2
          return
        }
        if self.esc_code {
          push_utf8(buf, e)
        } else {
          buf.push_byte(e)
        }
        continue
      }
      if c == 36 {
        if self.peek_next() == 123 {
          self.bump()
          self.bump()
          self.str_frag = intern_str(buf.to_s())
          self.str_kind = 1
          return
        }
        self.bump()
        buf.push_byte(c)
        continue
      }
      self.bump()
      buf.push_byte(c)
    }
  }

  pub fn is_raw_string_start: Bool {
    if self.peek() == 114 && self.peek_next() == 34 {
      return true
    }
    false
  }

  pub fn read_raw_string_body {
    buf = Buf.new()
    while true {
      if self.at_end() {
        fail_tok(self.here(), "unterminated string")
        self.str_frag = ""
        self.str_kind = 2
        return
      }
      c = self.peek()
      if c == 34 {
        self.bump()
        self.str_frag = intern_str(buf.to_s())
        self.str_kind = 0
        return
      }
      if c == 10 {
        fail_tok(self.here(), "unterminated string")
        self.str_frag = ""
        self.str_kind = 2
        return
      }
      self.bump()
      buf.push_byte(c)
    }
  }

  pub fn read_raw_string_token(loc: Location): Token {
    if self.keep_comments {
      return read_raw_string_token_format(loc)
    }
    self.bump()
    self.bump()
    mark = self.err_count()
    self.read_raw_string_body()
    if new_err_since(mark) {
      return Token.new(tk_eof(), loc, "")
    }
    Token.new(tk_string(), loc, intern_str(self.str_frag))
  }

  pub fn read_raw_string_token_format(loc: Location): Token {
    open_pos = self.pos
    self.bump()
    self.bump()
    self.read_raw_string_body()
    if self.has_err() {
      return Token.new(tk_eof(), loc, "")
    }
    raw = self.source.text[open_pos..self.pos]
    Token.new(tk_string(), loc, raw)
  }

  pub fn lex_interp_expr: Array(Token) {
    tokens: Array(Token) = []
    depth = 0
    mark0 = self.err_count()
    while true {
      if new_err_since(mark0) {
        return tokens
      }
      self.skip_spaces()
      if self.at_end() {
        fail_tok(self.here(), "unterminated string interpolation")
        return tokens
      }
      if self.peek() == 10 {
        loc = self.here()
        self.bump()
        last_nl = false
        if tokens.size > 0 {
          last = tokens[tokens.size - 1]
          if last.kind == tk_newline() {
            last_nl = true
          }
        }
        if !last_nl {
          tokens.push(Token.new(tk_newline(), loc, ""))
        }
        continue
      }
      if self.peek() == 47 && self.peek_next() == 47 {
        self.skip_line_comment()
        continue
      }
      qn = self.queue.size
      tok = self.read_token()
      if self.queue.size > qn {
        // A string that interpolates inside this interpolation: its
        // opening token, then the rest of its tokens, which
        // read_string_token queued, in order.
        tokens.push(tok)
        self.take_queued(tokens, qn)
        continue
      }
      if tok.kind == tk_l_brace() {
        depth += 1
        tokens.push(tok)
      } else if tok.kind == tk_r_brace() {
        if depth == 0 {
          return tokens
        }
        depth -= 1
        tokens.push(tok)
      } else {
        tokens.push(tok)
      }
    }
    tokens
  }

  pub fn lex_interpolation: Array(Token) {
    tokens: Array(Token) = []
    mark0 = self.err_count()
    while true {
      if new_err_since(mark0) {
        return tokens
      }
      expr = self.lex_interp_expr()
      if new_err_since(mark0) {
        return tokens
      }
      self.read_string_body()
      if new_err_since(mark0) {
        return tokens
      }
      if self.str_kind == 0 {
        tokens.concat(expr)
        tokens.push(Token.new(tk_interp_close(), self.here(), self.str_frag))
        return tokens
      }
      if self.str_kind == 1 {
        tokens.concat(expr)
        tokens.push(Token.new(tk_interp_mid(), self.here(), self.str_frag))
      }
    }
    tokens
  }

  pub fn read_string_token(loc: Location): Token {
    if self.keep_comments {
      return read_string_token_format(loc)
    }
    self.bump()
    mark = self.err_count()
    self.read_string_body()
    if new_err_since(mark) {
      return Token.new(tk_eof(), loc, "")
    }
    if self.str_kind == 0 {
      return Token.new(tk_string(), loc, intern_str(self.str_frag))
    }
    if self.str_kind == 1 {
      if self.interp_depth >= interp_limit() {
        return self.interp_too_deep(loc)
      }
      first_frag = self.str_frag
      self.interp_depth += 1
      rest = self.lex_interpolation()
      self.interp_depth -= 1
      first = Token.new(tk_interp_open(), loc, intern_str(first_frag))
      i = 0
      while i < rest.size {
        queue_push(rest[i])
        i += 1
      }
      return first
    }
    fail_tok(loc, "unterminated string")
  }

  pub fn read_ident_tok(loc: Location): Token {
    ident = self.read_ident()
    if k = self.keywords.get(ident) {
      return Token.new(k, loc, "")
    }
    Token.new(tk_ident(), loc, intern_str(ident))
  }

  pub fn read_token: Token {
    loc = self.here()
    c = self.peek()
    if self.is_raw_string_start() {
      return read_raw_string_token(loc)
    }
    if ch_is_digit(c) {
      return read_number(loc)
    }
    if ch_is_ident_start(c) {
      return read_ident_tok(loc)
    }
    switch c {
      case 123 {
        self.bump()
        Token.new(tk_l_brace(), loc, "")
      }
      case 125 {
        self.bump()
        Token.new(tk_r_brace(), loc, "")
      }
      case 40 {
        self.bump()
        Token.new(tk_l_paren(), loc, "")
      }
      case 41 {
        self.bump()
        Token.new(tk_r_paren(), loc, "")
      }
      case 91 {
        self.bump()
        Token.new(tk_l_bracket(), loc, "")
      }
      case 93 {
        self.bump()
        Token.new(tk_r_bracket(), loc, "")
      }
      case 44 {
        self.bump()
        Token.new(tk_comma(), loc, "")
      }
      case 58 {
        self.bump()
        Token.new(tk_colon(), loc, "")
      }
      case 124 {
        self.bump()
        kind = tk_pipe()
        if self.peek() == 124 {
          self.bump()
          kind = tk_pipe_pipe()
        } else if self.peek() == 61 {
          self.bump()
          kind = tk_pipe_eq()
        }
        Token.new(kind, loc, "")
      }
      case 38 {
        self.bump()
        kind = tk_amp()
        if self.peek() == 38 {
          self.bump()
          kind = tk_amp_amp()
        } else if self.peek() == 43 {
          self.bump()
          kind = tk_amp_plus()
          if self.peek() == 61 {
            self.bump()
            kind = tk_amp_plus_eq()
          }
        } else if self.peek() == 45 {
          self.bump()
          kind = tk_amp_minus()
          if self.peek() == 61 {
            self.bump()
            kind = tk_amp_minus_eq()
          }
        } else if self.peek() == 42 {
          self.bump()
          kind = tk_amp_star()
          if self.peek() == 61 {
            self.bump()
            kind = tk_amp_star_eq()
          }
        } else if self.peek() == 61 {
          self.bump()
          kind = tk_amp_eq()
        }
        Token.new(kind, loc, "")
      }
      case 94 {
        self.bump()
        kind = tk_caret()
        if self.peek() == 61 {
          self.bump()
          kind = tk_caret_eq()
        }
        Token.new(kind, loc, "")
      }
      case 126 {
        self.bump()
        Token.new(tk_tilde(), loc, "")
      }
      case 63 {
        self.bump()
        kind = tk_question()
        if self.peek() == 63 {
          self.bump()
          kind = tk_question_question()
        }
        Token.new(kind, loc, "")
      }
      case 46 {
        self.bump()
        kind = tk_dot()
        if self.peek() == 46 {
          self.bump()
          kind = tk_dot_dot()
          if self.peek() == 61 {
            self.bump()
            kind = tk_dot_dot_eq()
          } else if self.peek() == 46 {
            // Ruby's and Crystal's `...` excludes its end, CoffeeScript's
            // too: read here as `..` and `.`, a port would fail on a
            // confusing parse error, or as an inclusive range it would be
            // a silent off-by-one.
            return fail_tok(loc, "`...` is not a range in Avant: write `..` (end excluded) or `..=` (end included)")
          }
        }
        Token.new(kind, loc, "")
      }
      case 43 {
        self.bump()
        kind = tk_plus()
        if self.peek() == 61 {
          self.bump()
          kind = tk_plus_eq()
        }
        Token.new(kind, loc, "")
      }
      case 45 {
        self.bump()
        kind = tk_minus()
        if self.peek() == 61 {
          self.bump()
          kind = tk_minus_eq()
        }
        Token.new(kind, loc, "")
      }
      case 42 {
        self.bump()
        kind = tk_star()
        if self.peek() == 61 {
          self.bump()
          kind = tk_star_eq()
        }
        Token.new(kind, loc, "")
      }
      case 37 {
        self.bump()
        kind = tk_percent()
        if self.peek() == 61 {
          self.bump()
          kind = tk_percent_eq()
        }
        Token.new(kind, loc, "")
      }
      case 47 {
        self.bump()
        kind = tk_slash()
        if self.peek() == 61 {
          self.bump()
          kind = tk_slash_eq()
        }
        Token.new(kind, loc, "")
      }
      case 61 {
        self.bump()
        kind = tk_eq()
        if self.peek() == 61 {
          self.bump()
          kind = tk_eq_eq()
        }
        Token.new(kind, loc, "")
      }
      case 33 {
        self.bump()
        kind = tk_bang()
        if self.peek() == 61 {
          self.bump()
          kind = tk_not_eq()
        }
        Token.new(kind, loc, "")
      }
      case 60 {
        self.bump()
        kind = tk_less()
        if self.peek() == 61 {
          self.bump()
          kind = tk_less_eq()
        } else if self.peek() == 60 {
          self.bump()
          kind = tk_less_less()
          if self.peek() == 61 {
            self.bump()
            kind = tk_less_less_eq()
          }
        }
        Token.new(kind, loc, "")
      }
      case 62 {
        self.bump()
        kind = tk_greater()
        if self.peek() == 61 {
          self.bump()
          kind = tk_greater_eq()
        } else if self.peek() == 62 {
          self.bump()
          kind = tk_greater_greater()
          if self.peek() == 61 {
            self.bump()
            kind = tk_greater_greater_eq()
          }
        }
        Token.new(kind, loc, "")
      }
      case 34 {
        read_string_token(loc)
      }
      case 39 {
        read_char_token(loc)
      }
      case 35 {
        self.bump()
        Token.new(tk_pound(), loc, "")
      }
      else {
        self.bump()
        fail_tok(loc, "unexpected character " + chr(c))
      }
    }
  }

  // compile, run, and dump use tokenize. format uses tokenize_format.
  pub fn tokenize: Array(Token) {
    tokens: Array(Token) = []
    last_kind = -1
    while true {
      self.skip_spaces()
      if self.at_end() && self.queue_empty() {
        break
      }
      if self.queue_empty() {
        if self.peek() == 47 && self.peek_next() == 47 {
          self.skip_line_comment()
          continue
        }
        if self.peek() == 10 {
          loc = self.here()
          self.bump()
          if last_kind != tk_newline() {
            tokens.push(Token.new(tk_newline(), loc, ""))
            last_kind = tk_newline()
          }
          continue
        }
        before = self.pos
        mark = self.err_count()
        t = self.read_token()
        if t.kind == tk_eof() {
          if new_err_since(mark) {
            if self.pos == before && !self.at_end() {
              self.bump()
            }
            continue
          }
          break
        }
        tokens.push(t)
        last_kind = t.kind
      } else {
        t = self.queue_take()
        tokens.push(t)
        last_kind = t.kind
      }
    }
    tokens.push(Token.new(tk_eof(), self.here(), ""))
    tokens
  }

  pub fn only_ws_before(at: Int): Bool {
    i = at
    while i > 0 {
      c = self.source.text[i - 1]
      if c == 10 {
        return true
      }
      if c == 32 {
      } else if c == 9 {
      } else if c != 13 {
        return false
      }
      i -= 1
    }
    true
  }

  pub fn line_begin_at(at: Int): Int {
    i = at
    while i > 0 {
      if self.source.text[i - 1] == 10 {
        return i
      }
      i -= 1
    }
    0
  }

  pub fn comment_is_file_directive: Bool {
    if self.peek() != 47 {
      return false
    }
    if peek_at(1) != 47 {
      return false
    }
    if peek_at(2) != 32 {
      return false
    }
    if peek_at(3) != 102 {
      return false
    }
    if peek_at(4) != 105 {
      return false
    }
    if peek_at(5) != 108 {
      return false
    }
    if peek_at(6) != 101 {
      return false
    }
    if peek_at(7) != 58 {
      return false
    }
    peek_at(8) == 32
  }

  pub fn consume_comment_body {
    while true {
      if self.at_end() {
        return
      }
      c = self.peek()
      if c == 10 {
        return
      }
      if c == 13 {
        return
      }
      self.bump()
    }
  }

  pub fn read_format_comment: Token {
    loc = self.here()
    start = self.pos
    file_line = self.comment_is_file_directive()
    self.consume_comment_body()
    if file_line {
      path_at = start + 9
      if path_at < self.pos {
        self.path = intern_str(self.source.text[path_at..self.pos])
      } else {
        self.path = intern_str("")
      }
      self.line = 0
      self.column = 1
      if only_ws_before(start) {
        begin = line_begin_at(start)
        raw = self.source.text[begin..self.pos]
        return Token.new(tk_file_line(), loc, raw)
      }
      raw_mid = self.source.text[start..self.pos]
      return Token.new(tk_comment(), loc, raw_mid)
    }
    raw = self.source.text[start..self.pos]
    Token.new(tk_comment(), loc, raw)
  }

  pub fn read_string_token_format(loc: Location): Token {
    open_pos = self.pos
    self.bump()
    self.read_string_body()
    if self.has_err() {
      return Token.new(tk_eof(), loc, "")
    }
    if self.str_kind == 0 {
      raw = self.source.text[open_pos..self.pos]
      return Token.new(tk_string(), loc, raw)
    }
    if self.str_kind == 1 {
      if self.interp_depth >= interp_limit() {
        return self.interp_too_deep(loc)
      }
      raw_open = self.source.text[open_pos..self.pos]
      self.interp_depth += 1
      rest = self.lex_interpolation_format()
      self.interp_depth -= 1
      if self.has_err() {
        return Token.new(tk_eof(), loc, "")
      }
      i = 0
      while i < rest.size {
        queue_push(rest[i])
        i += 1
      }
      return Token.new(tk_interp_open(), loc, raw_open)
    }
    fail_tok(loc, "unterminated string")
  }

  pub fn lex_interp_expr_format: Array(Token) {
    tokens: Array(Token) = []
    depth = 0
    while true {
      if self.has_err() {
        return tokens
      }
      self.skip_spaces()
      if self.at_end() {
        fail_tok(self.here(), "unterminated string interpolation")
        return tokens
      }
      if self.peek() == 10 {
        loc = self.here()
        self.bump()
        tokens.push(Token.new(tk_newline(), loc, ""))
        continue
      }
      if self.peek() == 47 && self.peek_next() == 47 {
        tok = self.read_format_comment()
        tokens.push(tok)
        continue
      }
      qn = self.queue.size
      tok = self.read_token()
      if self.has_err() {
        return tokens
      }
      if self.queue.size > qn {
        tokens.push(tok)
        self.take_queued(tokens, qn)
        continue
      }
      if tok.kind == tk_l_brace() {
        depth += 1
        tokens.push(tok)
      } else if tok.kind == tk_r_brace() {
        if depth == 0 {
          return tokens
        }
        depth -= 1
        tokens.push(tok)
      } else {
        tokens.push(tok)
      }
    }
    tokens
  }

  pub fn lex_interpolation_format: Array(Token) {
    tokens: Array(Token) = []
    while true {
      if self.has_err() {
        return tokens
      }
      expr = self.lex_interp_expr_format()
      if self.has_err() {
        return tokens
      }
      body_start = self.pos
      self.read_string_body()
      if self.has_err() {
        return tokens
      }
      raw = self.source.text[body_start..self.pos]
      tokens.concat(expr)
      if self.str_kind == 0 {
        tokens.push(Token.new(tk_interp_close(), self.here(), raw))
        return tokens
      }
      if self.str_kind == 1 {
        tokens.push(Token.new(tk_interp_mid(), self.here(), raw))
      } else {
        return tokens
      }
    }
    tokens
  }

  pub fn tokenize_format: Array(Token) {
    self.keep_comments = true
    tokens: Array(Token) = []
    while true {
      if self.has_err() {
        break
      }
      self.skip_spaces()
      if self.at_end() && self.queue_empty() {
        break
      }
      if self.queue_empty() {
        if self.at_end() {
          break
        }
        if self.peek() == 47 && self.peek_next() == 47 {
          tok = self.read_format_comment()
          tokens.push(tok)
          continue
        }
        if self.peek() == 10 {
          loc = self.here()
          self.bump()
          tokens.push(Token.new(tk_newline(), loc, ""))
          continue
        }
        t = self.read_token()
        if self.has_err() {
          break
        }
        tokens.push(t)
      } else {
        t = self.queue_take()
        tokens.push(t)
      }
    }
    if self.has_err() {
      return tokens
    }
    tokens.push(Token.new(tk_eof(), self.here(), ""))
    tokens
  }
}

// How deep a string may interpolate inside interpolations: the parser's
// bound on nesting (parser.av nest_limit), which a deeper program meets
// there anyway.
pub fn interp_limit: Int {
  1000
}
