pub fn argv_user: Array(String) {
  args = argv()
  rest: Array(String) = []
  i = 1
  while i < args.size {
    rest.push(args[i])
    i = i + 1
  }
  rest
}

pub fn argv_drop_first(args: Array(String)): Array(String) {
  rest: Array(String) = []
  i = 1
  while i < args.size {
    rest.push(args[i])
    i = i + 1
  }
  rest
}

pub fn argv_filter_coverage(args: Array(String)): Array(String) {
  rest: Array(String) = []
  i = 0
  while i < args.size {
    if str_eq(args[i], "--coverage") {
    } else {
      rest.push(args[i])
    }
    i = i + 1
  }
  rest
}

pub fn show_usage {
  puts("Avant compiler")
  puts("")
  puts("  avant-av run FILE.av [--coverage] [--debug|--release] [--lib NAME] [--cc FILE.c]")
  puts("  avant-av dump FILE.av [--coverage]")
  puts("  avant-av compile FILE.av [OUT] [--coverage] [--debug|--release] [--lib NAME] [--cc FILE.c]")
  puts("  avant-av format FILE.av [--write] [--check]")
  puts("  avant-av bind [--lib NAME] HEADER.h")
  puts("  avant-av fetch [DIR] [--update]")
  puts("")
  puts("FILE.av is the program root. import name loads name.av beside it.")
  puts("--release is --final, the scored mode. --debug is the fast daily mode.")
}

pub fn driver_format(args: Array(String)) {
  split = take_av_files(args)
  if split.paths.size == 0 {
    diag_puts("format needs a .av file")
    show_usage()
    return
  }
  if split.paths.size > 1 {
    diag_puts("format takes one root .av (use import)")
    show_usage()
    return
  }
  path = split.paths[0]
  check = false
  write = false
  i = 0
  while i < split.rest.size {
    flag = split.rest[i]
    if str_eq(flag, "--check") {
      check = true
    } else if str_eq(flag, "--write") {
      write = true
    } else {
      diag_puts("unknown format argument ${flag}")
      show_usage()
      return
    }
    i = i + 1
  }
  if text = file_read(path) {
    got = format_source(path, text)
    if got.ok {
    } else {
      diag_puts(got.err)
      return
    }
    if check {
      if str_eq(text, got.text) {
        puts("canonical")
      } else {
        puts("would change ${path}")
      }
      return
    }
    if write {
      w = file_write(path, got.text)
      if w != 0 {
        diag_puts("cannot write ${path}")
        return
      }
      return
    }
    print_format(got.text)
  } else {
    diag_puts("cannot read ${path}")
    return
  }
}

pub fn driver_dump(args: Array(String)) {
  split = take_av_files(args)
  if split.paths.size == 0 {
    diag_puts("dump needs a .av file")
    show_usage()
    diag_exit(1)
  }
  if split.paths.size > 1 {
    diag_puts("dump takes one root .av (use import)")
    show_usage()
    diag_exit(1)
  }
  box = compile_av_paths(split.paths)
  if box.ok {
    print_ir(box.text)
    return
  }
  diag_exit(1)
}

pub fn driver_run(args: Array(String)) {
  split = take_av_files(args)
  if split.paths.size == 0 {
    diag_puts("run needs a .av file")
    show_usage()
    diag_exit(1)
  }
  if split.paths.size > 1 {
    diag_puts("run takes one root .av (use import)")
    show_usage()
    diag_exit(1)
  }
  job = parse_link(split.rest)
  if job.err.size > 0 {
    diag_puts(job.err)
    diag_exit(1)
  }
  box = compile_av_paths(split.paths)
  if box.ok {
    if box.re2c_obj.size > 0 {
      job.objects.push(box.re2c_obj)
    }
    code = invoke_myc(box.text, "r", job.objects, job.flags, "", box.quiet_leaves, job.codegen)
    if code != 0 {
      diag_exit(code)
    }
    return
  }
  diag_exit(1)
}

pub fn driver_compile(args: Array(String)) {
  split = take_av_files(args)
  if split.paths.size == 0 {
    diag_puts("compile needs a .av file")
    show_usage()
    diag_exit(1)
  }
  if split.paths.size > 1 {
    diag_puts("compile takes one root .av (use import)")
    show_usage()
    diag_exit(1)
  }
  last = split.paths[split.paths.size - 1]
  out_split = take_out_path(split.rest, last)
  if out_split.paths.size == 0 {
    diag_puts("compile needs an output path")
    diag_exit(1)
  }
  out_path = out_split.paths[0]
  job = parse_link(out_split.rest)
  if job.err.size > 0 {
    diag_puts(job.err)
    diag_exit(1)
  }
  box = compile_av_paths(split.paths)
  if box.ok {
    if box.re2c_obj.size > 0 {
      job.objects.push(box.re2c_obj)
    }
    code = invoke_myc(box.text, "c", job.objects, job.flags, out_path, box.quiet_leaves, job.codegen)
    if code != 0 {
      diag_puts("myc-llvm failed (${code})")
      diag_exit(1)
    }
    return
  }
  diag_exit(1)
}

pub fn driver_bind(args: Array(String)) {
  lib_name = ""
  header = ""
  i = 0
  while i < args.size {
    arg = args[i]
    if str_eq(arg, "--lib") {
      if i + 1 >= args.size {
        puts("--lib needs a name")
        show_usage()
        return
      }
      lib_name = args[i + 1]
      i = i + 2
    } else if str_starts(arg, "--lib=") {
      lib_name = str_slice(arg, 6, arg.size)
      i = i + 1
    } else if str_starts(arg, "-") {
      puts("unknown bind argument ${arg}")
      show_usage()
      return
    } else {
      if header.size > 0 {
        puts("bind takes one header")
        show_usage()
        return
      }
      header = arg
      i = i + 1
    }
  }
  if header.size == 0 {
    puts("bind needs a C header")
    show_usage()
    return
  }
  if lib_name.size == 0 {
    lib_name = bind_default_name(header)
  }
  if file_exists(header) {
  } else {
    puts("header is missing")
    return
  }
  got = bind_generate(lib_name, header)
  if got.ok {
    bind_emit(got.text)
    if got.err.size > 0 {
      bind_emit(got.err)
    }
    return
  }
  if got.err.size > 0 {
    diag_puts(got.err)
    diag_exit(1)
  }
  diag_puts("avant-bind failed")
  diag_exit(1)
}

pub fn driver_fetch(args: Array(String)) {
  dir = "."
  seen_dir = false
  update = false
  i = 0
  while i < args.size {
    arg = args[i]
    if str_eq(arg, "--update") {
      update = true
      i = i + 1
    } else if str_starts(arg, "-") {
      diag_puts("unknown fetch argument ${arg}")
      show_usage()
      diag_exit(1)
    } else {
      if seen_dir {
        diag_puts("fetch takes one directory")
        show_usage()
        diag_exit(1)
      }
      seen_dir = true
      dir = arg
      i = i + 1
    }
  }
  if pkg_fetch(dir, update) {
    return
  }
  diag_exit(1)
}

fn main {
  args = argv_filter_coverage(argv_user())
  if args.size == 0 {
    show_usage()
    return
  }
  command = args[0]
  if str_eq(command, "-h") {
    show_usage()
    return
  }
  if str_eq(command, "--help") {
    show_usage()
    return
  }
  if str_eq(command, "help") {
    show_usage()
    return
  }
  if str_eq(command, "dump") {
    driver_dump(argv_drop_first(args))
    return
  }
  if str_eq(command, "d") {
    driver_dump(argv_drop_first(args))
    return
  }
  if str_eq(command, "run") {
    driver_run(argv_drop_first(args))
    return
  }
  if str_eq(command, "r") {
    driver_run(argv_drop_first(args))
    return
  }
  if str_eq(command, "compile") {
    driver_compile(argv_drop_first(args))
    return
  }
  if str_eq(command, "format") {
    driver_format(argv_drop_first(args))
    return
  }
  if str_eq(command, "f") {
    driver_format(argv_drop_first(args))
    return
  }
  if str_eq(command, "c") {
    driver_compile(argv_drop_first(args))
    return
  }
  if str_eq(command, "fetch") {
    driver_fetch(argv_drop_first(args))
    return
  }
  if str_eq(command, "bind") {
    driver_bind(argv_drop_first(args))
    return
  }
  if str_eq(command, "b") {
    driver_bind(argv_drop_first(args))
    return
  }
  if str_ends(command, ".av") {
    driver_run(args)
    return
  }
  diag_puts("unknown command ${command}")
  show_usage()
  diag_exit(1)
}
