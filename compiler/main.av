pub fn argv_user: Array(String) {
  args = argv()
  rest: Array(String) = []
  for i in 1..args.size {
    rest.push(args[i])
  }
  rest
}

pub fn argv_drop_first(args: Array(String)): Array(String) {
  rest: Array(String) = []
  for i in 1..args.size {
    rest.push(args[i])
  }
  rest
}

pub fn show_usage {
  puts("Avant compiler")
  puts("")
  puts("  avant-av run [RUN-OPTIONS] FILE.av [-- PROGRAM-ARGS...]")
  puts("  avant-av test [TEST-OPTIONS] [PATH...]")
  puts("  avant-av dump FILE.av")
  puts("  avant-av compile FILE.av [OUT] [--debug|--release] [--lib NAME] [--cc FILE.c]")
  puts("  avant-av format FILE.av [--write] [--check]")
  puts("  avant-av bind [--lib NAME] HEADER.h")
  puts("  avant-av fetch [DIR] [--update]")
  puts("")
  puts("FILE.av is the program root. import name loads name.av beside it.")
  puts("Programs are compiled by the built-in LLVM back end (no external tools besides cc).")
  puts("With no flag, run uses --debug (fast) and compile uses the default optimization (kept artifacts).")
  puts("--release (or --final) is the scored mode (full optimization). --debug is the fast mode.")
  puts("AVANT_BACKEND=myc selects the old myc-llvm back end until it retires.")
  puts("Run options may sit before or after FILE.av. Arguments after -- belong to the program.")
  puts("test walks tests/ for test_*.av. Flags: --jobs N, --shard I/N, --junit PATH, --skip-exclusive, --coverage.")
  puts("--jobs defaults to the online processor count. --jobs 1 runs one file at a time. Alias: t.")
  puts("--keep-tmp keeps the private temporary directory of compile, run, test, fetch, or bind and prints its path.")
}

// --keep-tmp (D127) may sit anywhere before a literal --. It is taken out
// here, so no command's own parser sees it.
fn take_keep_tmp(args: Array(String)): Array(String) {
  rest: Array(String) = []
  program = false
  i = 0
  while i < args.size {
    a = args[i]
    if program {
      rest.push(a)
    } else if str_eq(a, "--") {
      program = true
      rest.push(a)
    } else if str_eq(a, "--keep-tmp") {
      tmp_keep()
    } else {
      rest.push(a)
    }
    i = i + 1
  }
  rest
}

// The commands that spawn children create the scratch directory first
// (Q138), so TMPDIR is exported before any child runs.
fn spawns_children(command: String): Bool {
  if str_eq(command, "run") || str_eq(command, "r") || str_eq(command, "test") || str_eq(command, "t") {
    return true
  }
  if str_eq(command, "compile") || str_eq(command, "c") || str_eq(command, "fetch") || str_eq(command, "bind") || str_eq(command, "b") {
    return true
  }
  str_ends(command, ".av")
}

pub fn driver_format(args: Array(String)) {
  split = take_av_files(args)
  if split.paths.size == 0 {
    diag_puts("format needs a .av file")
    show_usage()
    return
  }
  if split.paths.size > 1 {
    diag_puts("format takes one root .av (use import)")
    show_usage()
    return
  }
  path = split.paths[0]
  check = false
  write = false
  i = 0
  while i < split.rest.size {
    flag = split.rest[i]
    if str_eq(flag, "--check") {
      check = true
    } else if str_eq(flag, "--write") {
      write = true
    } else {
      diag_puts("unknown format argument ${flag}")
      show_usage()
      return
    }
    i = i + 1
  }
  if text = file_read(path) {
    got = format_source(path, text)
    if got.ok {
    } else {
      diag_puts(got.err)
      return
    }
    if check {
      if str_eq(text, got.text) {
        puts("canonical")
      } else {
        puts("would change ${path}")
      }
      return
    }
    if write {
      w = file_write(path, got.text)
      if w != 0 {
        diag_puts("cannot write ${path}")
        return
      }
      return
    }
    print_format(got.text)
  } else {
    diag_puts("cannot read ${path}")
    return
  }
}

// The hidden front-end dumps of one file (D137): tokens, AST, or the
// checked tree, read without the loader, for the goldens. Not in the usage
// text. The dumps are the bytes compiler/lex_dump.av printed; a front-end
// error goes to stderr with status 1, as in dump (D142), so a golden can
// never record one. A program that imports has no --check golden.
fn dump_layer_mode(arg: String): Bool {
  if str_eq(arg, "--tokens") {
    return true
  }
  if str_eq(arg, "--ast") {
    return true
  }
  str_eq(arg, "--check")
}

fn driver_dump_layer(mode: String, path: String) {
  if src = source_read(path) {
    lex = Lexer.new(src)
    tokens = lex.tokenize
    if e = lex.err {
      diag_puts(e.show)
      diag_exit(1)
    }
    if str_eq(mode, "--tokens") {
      dump_tokens(tokens)
      return
    }
    parser = Parser.new(src, tokens)
    program = parser.parse
    if e = parser.err {
      diag_puts(e.show)
      diag_exit(1)
    }
    if str_eq(mode, "--ast") {
      puts(dump_program(program))
      return
    }
    expander = Expander.new(src, program)
    dummy_e = expander.expand
    if e = expander.err {
      diag_puts(e.show)
      diag_exit(1)
    }
    checker = Checker.new(src, program)
    dummy = checker.check
    if e = checker.err {
      diag_puts(e.show)
      diag_exit(1)
    }
    puts(dump_typed_program(program))
    return
  }
  diag_puts("cannot read ${path}")
  diag_exit(1)
}

pub fn driver_dump(args: Array(String)) {
  if args.size > 0 && dump_layer_mode(args[0]) {
    if args.size != 2 {
      diag_puts("dump ${args[0]} takes one .av file")
      diag_exit(1)
    }
    driver_dump_layer(args[0], args[1])
    return
  }
  split = take_av_files(args)
  if split.paths.size == 0 {
    diag_puts("dump needs a .av file")
    show_usage()
    diag_exit(1)
  }
  if split.paths.size > 1 {
    diag_puts("dump takes one root .av (use import)")
    show_usage()
    diag_exit(1)
  }
  if split.rest.size > 0 {
    diag_puts("unknown dump argument ${split.rest[0]}")
    show_usage()
    diag_exit(1)
  }
  box = compile_av_paths(split.paths)
  if box.ok {
    if m = box.mir {
      // AVANT_BACKEND=llvm (D171): the final-stage MIR; a module the
      // verifier rejects is printed, then its errors, exit 1.
      print_ir(mir_print(m, true))
      bad = llvm_verify(m)
      if bad.size > 0 {
        diag_puts(bad)
        diag_exit(1)
      }
      return
    }
    print_ir(box.text)
    return
  }
  diag_exit(1)
}

// Stage 28 W6c: the inline allocation and barrier fast paths (mir.md
// 5.5, 5.6) are on in every mode. AVANT_LLVM_CALL_FORMS=1 (internal,
// like AVANT_BACKEND, D176) emits their call forms instead, so the
// suite can prove both forms (the program-level twin of __mir-build
// --call-forms).
fn llvm_inline_fast: Bool {
  if v = env_get("AVANT_LLVM_CALL_FORMS") {
    if str_eq(v, "1") {
      return false
    }
  }
  true
}

// The new back end's job for a link job (AVANT_BACKEND=llvm): the same
// mode, extra objects, and -l flags.
fn llvm_job_of(job: LinkJob): LlvmJob {
  lj = LlvmJob.new(job.codegen)
  lj.inline_fast = llvm_inline_fast()
  i = 0
  while i < job.objects.size {
    lj.objects.push(job.objects[i])
    i = i + 1
  }
  i = 0
  while i < job.flags.size {
    lj.flags.push(job.flags[i])
    i = i + 1
  }
  lj
}

pub fn driver_run(args: Array(String)) {
  split = split_run_args(args)
  if split.err.size > 0 {
    diag_puts(split.err)
    show_usage()
    diag_exit(1)
  }
  job = parse_link(split.link)
  if job.err.size > 0 {
    diag_puts(job.err)
    diag_exit(1)
  }
  job.codegen = verb_codegen(job.codegen, "run")
  paths: Array(String) = []
  paths.push(split.file)
  box = compile_av_paths(paths)
  if box.ok {
    if box.re2c_obj.size > 0 {
      job.objects.push(box.re2c_obj)
    }
    attach_std_link(box, job)
    // Compile, then run the program here with the user's stdin. myc-llvm's
    // own run mode is not used: the backend reads all of a non-terminal
    // stdin before it compiles, so piped input never reached the program
    // (Wave D). The backend gets /dev/null (tool_run).
    out = tmp_path("run.bin")
    if m = box.mir {
      err = llvm_build(m, llvm_job_of(job), out)
      if err.size > 0 {
        diag_puts(err)
        diag_exit(1)
      }
      dummy_chmod2 = fs_chmod_x(out)
      rc2 = process_run(out, split.program)
      diag_exit(rc2)
    }
    code = invoke_myc(box.text, "c", job.objects, job.flags, out, box.quiet_leaves, job.codegen, true)
    if code != 0 {
      diag_puts("myc-llvm failed (${code})")
      diag_exit(1)
    }
    dummy_chmod = fs_chmod_x(out)
    rc = process_run(out, split.program)
    diag_exit(rc)
  }
  diag_exit(1)
}

pub fn driver_compile(args: Array(String)) {
  split = take_av_files(args)
  if split.paths.size == 0 {
    diag_puts("compile needs a .av file")
    show_usage()
    diag_exit(1)
  }
  if split.paths.size > 1 {
    diag_puts("compile takes one root .av (use import)")
    show_usage()
    diag_exit(1)
  }
  last = split.paths[split.paths.size - 1]
  out_split = take_out_path(split.rest, last)
  if out_split.paths.size == 0 {
    diag_puts("compile needs an output path")
    diag_exit(1)
  }
  out_path = out_split.paths[0]
  job = parse_link(out_split.rest)
  if job.err.size > 0 {
    diag_puts(job.err)
    diag_exit(1)
  }
  job.codegen = verb_codegen(job.codegen, "compile")
  box = compile_av_paths(split.paths, coverage_map_beside(out_path))
  if box.ok {
    if box.re2c_obj.size > 0 {
      job.objects.push(box.re2c_obj)
    }
    attach_std_link(box, job)
    if m = box.mir {
      // The old driver's myc-llvm prints this line; the new driver
      // leaves it to its caller (D194).
      err = llvm_build(m, llvm_job_of(job), out_path)
      if err.size > 0 {
        diag_puts(err)
        diag_exit(1)
      }
      out_puts("compiled to ${out_path}")
      return
    }
    code = invoke_myc(box.text, "c", job.objects, job.flags, out_path, box.quiet_leaves, job.codegen, false)
    if code != 0 {
      diag_puts("myc-llvm failed (${code})")
      diag_exit(1)
    }
    return
  }
  diag_exit(1)
}

pub fn driver_bind(args: Array(String)) {
  lib_name = ""
  header = ""
  i = 0
  while i < args.size {
    arg = args[i]
    if str_eq(arg, "--lib") {
      if i + 1 >= args.size {
        puts("--lib needs a name")
        show_usage()
        return
      }
      lib_name = args[i + 1]
      i = i + 2
    } else if str_starts(arg, "--lib=") {
      lib_name = str_slice(arg, 6, arg.size)
      i = i + 1
    } else if str_starts(arg, "-") {
      puts("unknown bind argument ${arg}")
      show_usage()
      return
    } else {
      if header.size > 0 {
        puts("bind takes one header")
        show_usage()
        return
      }
      header = arg
      i = i + 1
    }
  }
  if header.size == 0 {
    puts("bind needs a C header")
    show_usage()
    return
  }
  if lib_name.size == 0 {
    lib_name = bind_default_name(header)
  }
  if file_exists(header) {
  } else {
    puts("header is missing")
    return
  }
  got = bind_generate(lib_name, header)
  if got.ok {
    bind_emit(got.text)
    if got.err.size > 0 {
      bind_emit(got.err)
    }
    return
  }
  if got.err.size > 0 {
    diag_puts(got.err)
    diag_exit(1)
  }
  diag_puts("avant-bind failed")
  diag_exit(1)
}

pub fn driver_fetch(args: Array(String)) {
  dir = "."
  seen_dir = false
  update = false
  i = 0
  while i < args.size {
    arg = args[i]
    if str_eq(arg, "--update") {
      update = true
      i = i + 1
    } else if str_starts(arg, "-") {
      diag_puts("unknown fetch argument ${arg}")
      show_usage()
      diag_exit(1)
    } else {
      if seen_dir {
        diag_puts("fetch takes one directory")
        show_usage()
        diag_exit(1)
      }
      seen_dir = true
      dir = arg
      i = i + 1
    }
  }
  if pkg_fetch(dir, update) {
    return
  }
  diag_exit(1)
}

// Internal (Stage 28 W2), not in the usage text: compiles a textual LLVM
// IR file to an object with the in-process LLVM (compiler/llvm/glue.av).
//   avant __llvm-obj IN.ll OUT.o [--debug|--release]
// No flag is compile's bare mode. Exit 0, or 1 with the message on stderr.
fn driver_llvm_obj(args: Array(String)) {
  codegen = "default"
  files: Array(String) = []
  i = 0
  while i < args.size {
    a = args[i]
    if str_eq(a, "--debug") {
      codegen = "debug"
    } else if str_eq(a, "--release") {
      codegen = "release"
    } else if str_starts(a, "-") {
      diag_puts("__llvm-obj: unknown flag ${a}")
      diag_exit(1)
    } else {
      files.push(a)
    }
    i = i + 1
  }
  if files.size != 2 {
    diag_puts("usage: avant __llvm-obj IN.ll OUT.o [--debug|--release]")
    diag_exit(1)
  }
  err = llvm_compile_file(files[0], codegen, files[1])
  if err.size > 0 {
    diag_puts(err)
    diag_exit(1)
  }
}

// Internal (Stage 28 W5a), not in the usage text: builds one of the
// builder-made MIR modules by name (llvm/emit_cases.av), verifies it at
// stage final, emits the .ll, compiles it with the in-process LLVM, and
// links it like a program (llvm/driver.av).
//   avant __mir-build NAME OUT [--debug|--release] [--emit-ll FILE]
//                    [--object] [--call-forms] [--time]
//   avant __mir-build --list
// No flag is compile's bare mode. --object stops at the object (OUT); a
// module without `main` needs it. --call-forms emits allocation and the
// barrier as calls. --time prints the phases' microseconds on stderr.
// Exit 0, or 1 with the message on stderr.
fn driver_mir_build(args: Array(String)) {
  job = LlvmJob.new("default")
  files: Array(String) = []
  object = false
  timed = false
  i = 0
  while i < args.size {
    a = args[i]
    if str_eq(a, "--list") {
      names = mir_build_names()
      k = 0
      while k < names.size {
        out_puts(names[k])
        k = k + 1
      }
      return
    } else if str_eq(a, "--debug") {
      job.codegen = "debug"
    } else if str_eq(a, "--release") {
      job.codegen = "release"
    } else if str_eq(a, "--emit-ll") && i + 1 < args.size {
      job.keep_ll = args[i + 1]
      i = i + 1
    } else if str_eq(a, "--object") {
      object = true
    } else if str_eq(a, "--call-forms") {
      job.inline_fast = false
    } else if str_eq(a, "--time") {
      timed = true
    } else if str_starts(a, "-") {
      diag_puts("__mir-build: unknown flag ${a}")
      diag_exit(1)
    } else {
      files.push(a)
    }
    i = i + 1
  }
  if files.size != 2 {
    diag_puts("usage: avant __mir-build NAME OUT [--debug|--release] [--emit-ll FILE] [--object] [--call-forms] [--time]")
    diag_exit(1)
  }
  if m = mir_build_module(files[0]) {
    err = ""
    has_main = false
    if g = m.func("main") {
      has_main = true
    }
    if object {
      err = llvm_object(m, job, files[1])
    } else if !has_main {
      err = "__mir-build: ${files[0]} has no main (use --object)"
    } else {
      err = llvm_build(m, job, files[1])
    }
    if timed {
      diag_puts("emit_us=${job.emit_us} compile_us=${job.compile_us} link_us=${job.link_us}")
    }
    if err.size > 0 {
      diag_puts(err)
      diag_exit(1)
    }
    return
  }
  diag_puts("__mir-build: no module named ${files[0]} (see --list)")
  diag_exit(1)
}

// Internal (Stage 28 W9), not in the usage text: writes the
// pre-optimization .ll that `compile` under AVANT_BACKEND=llvm hands to
// the in-process LLVM (the same lowering, verifier, emitter, and
// fast-path setting; the text does not depend on the mode, mir.md 11).
// The self-hosting fixed point compares it between two compilers (D171).
//   avant __emit-ll SRC.av OUT.ll
// Exit 0, or 1 with the message on stderr.
fn driver_emit_ll(args: Array(String)) {
  if args.size != 2 || !str_ends(args[0], ".av") {
    diag_puts("usage: avant __emit-ll SRC.av OUT.ll")
    diag_exit(1)
  }
  if !str_eq(backend_choice(), "llvm") {
    diag_puts("__emit-ll needs the llvm back end (AVANT_BACKEND unset or llvm)")
    diag_exit(1)
  }
  paths: Array(String) = []
  paths.push(args[0])
  box = compile_av_paths(paths)
  if box.ok {
    if m = box.mir {
      err = llvm_emit_ll(m, llvm_inline_fast(), args[1])
      if err.size > 0 {
        diag_puts(err)
        diag_exit(1)
      }
      return
    }
  }
  diag_exit(1)
}

fn main {
  args = take_keep_tmp(argv_user())
  if args.size == 0 {
    show_usage()
    return
  }
  command = args[0]
  if spawns_children(command) {
    dummy_tmp = tmp_dir()
  }
  if str_eq(command, "-h") {
    show_usage()
    return
  }
  if str_eq(command, "--help") {
    show_usage()
    return
  }
  if str_eq(command, "help") {
    show_usage()
    return
  }
  if str_eq(command, "dump") {
    driver_dump(argv_drop_first(args))
    return
  }
  if str_eq(command, "d") {
    driver_dump(argv_drop_first(args))
    return
  }
  if str_eq(command, "run") {
    driver_run(argv_drop_first(args))
    return
  }
  if str_eq(command, "r") {
    driver_run(argv_drop_first(args))
    return
  }
  if str_eq(command, "test") {
    driver_test(argv_drop_first(args))
    return
  }
  if str_eq(command, "t") {
    driver_test(argv_drop_first(args))
    return
  }
  if str_eq(command, "compile") {
    driver_compile(argv_drop_first(args))
    return
  }
  if str_eq(command, "format") {
    driver_format(argv_drop_first(args))
    return
  }
  if str_eq(command, "f") {
    driver_format(argv_drop_first(args))
    return
  }
  if str_eq(command, "c") {
    driver_compile(argv_drop_first(args))
    return
  }
  if str_eq(command, "fetch") {
    driver_fetch(argv_drop_first(args))
    return
  }
  if str_eq(command, "bind") {
    driver_bind(argv_drop_first(args))
    return
  }
  if str_eq(command, "b") {
    driver_bind(argv_drop_first(args))
    return
  }
  if str_eq(command, "__llvm-obj") {
    driver_llvm_obj(argv_drop_first(args))
    return
  }
  if str_eq(command, "__mir-build") {
    driver_mir_build(argv_drop_first(args))
    return
  }
  if str_eq(command, "__emit-ll") {
    driver_emit_ll(argv_drop_first(args))
    return
  }
  if str_eq(command, "__mir-selftest") {
    mir_selftest()
    return
  }
  if str_ends(command, ".av") {
    driver_run(args)
    return
  }
  diag_puts("unknown command ${command}")
  show_usage()
  diag_exit(1)
}
