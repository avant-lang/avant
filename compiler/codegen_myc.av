pub fn myc_id_part(s: String): String {
  buf = buf_new(s.size)
  i = 0
  while i < s.size {
    c = s[i]
    ok = false
    if c >= 48 {
      if c <= 57 {
        ok = true
      }
    }
    if c >= 65 {
      if c <= 90 {
        ok = true
      }
    }
    if c >= 97 {
      if c <= 122 {
        ok = true
      }
    }
    if ok {
      buf.push_byte(c)
    } else {
      buf.push_byte(95)
    }
    i = i + 1
  }
  buf.to_s
}

pub fn ty_myc_id(ty: Ty): String {
  if ty.is_struct {
    return ty.name
  }
  if ty.is_class {
    return ty.name
  }
  if ty.is_clayout {
    return ty.name
  }
  if ty.is_opaque {
    return ty.name
  }
  ty.show
}

pub fn ty_layout_myc(ty: Ty): String {
  if ty.is_array {
    if e = ty.inner {
      return "Array_${myc_id_part(ty_myc_id(e))}"
    }
    return "Array_"
  }
  if ty.is_union {
    buf = buf_new()
    buf.push_str("U_")
    i = 0
    while i < ty.members.size {
      if i > 0 {
        buf.push_str("_")
      }
      buf.push_str(myc_id_part(ty_myc_id(ty.members[i])))
      i = i + 1
    }
    return buf.to_s
  }
  ty.name
}

pub fn ty_self_ptr_myc(ty: Ty): String {
  "ptr<${ty_layout_myc(ty)}>"
}

pub fn fn_layout_name(ty: Ty): String {
  mangle_ty(ty)
}

pub fn fn_code_myc(ty: Ty): String {
  buf = buf_new()
  buf.push_str("fn<ptr<void>")
  i = 0
  while i < ty.members.size {
    buf.push_str(", ")
    buf.push_str(ty_myc(ty.members[i]))
    i = i + 1
  }
  buf.push_str(", ")
  if r = ty.inner {
    if r.is_void {
      buf.push_str("void")
    } else {
      buf.push_str(ty_myc(r))
    }
  } else {
    buf.push_str("void")
  }
  buf.push_str(">")
  buf.to_s
}

pub fn box_layout_name(ty: Ty): String {
  "Box_${mangle_ty(ty)}"
}

pub fn ty_myc(ty: Ty): String {
  k = ty.kind
  if k == tyk_int() {
    return "i32"
  }
  if k == tyk_int64() {
    return "i64"
  }
  if k == tyk_uint64() {
    return "u64"
  }
  if k == tyk_bool() {
    return "bool"
  }
  if k == tyk_float() {
    return "f64"
  }
  if k == tyk_string() {
    return "ptr<u8>"
  }
  if k == tyk_void() {
    return "void"
  }
  if k == tyk_nil() {
    return "i32"
  }
  if k == tyk_buf() {
    return "ptr<void>"
  }
  if k == tyk_hash() {
    return "ptr<void>"
  }
  if k == tyk_join() {
    return "ptr<void>"
  }
  if k == tyk_array() {
    return ty_self_ptr_myc(ty)
  }
  if k == tyk_class() {
    return ty_self_ptr_myc(ty)
  }
  if k == tyk_struct() {
    return ty_layout_myc(ty)
  }
  if k == tyk_clayout() {
    return ty.name
  }
  if k == tyk_union() {
    return ty_layout_myc(ty)
  }
  if k == tyk_ptr() {
    if inner = ty.inner {
      if inner.is_opaque {
        return "ptr<void>"
      }
      if inner.is_void {
        return "ptr<void>"
      }
      return "ptr<${ty_myc(inner)}>"
    }
    return "ptr<void>"
  }
  if k == tyk_fn() {
    return fn_layout_name(ty)
  }
  "void"
}

pub fn ty_has_heap(ty: Ty): Bool {
  if ty.is_fn {
    return true
  }
  if ty.is_class {
    return true
  }
  if ty.is_array {
    return true
  }
  if ty.is_string {
    return true
  }
  if ty.is_hash {
    return true
  }
  if ty.is_buf {
    return true
  }
  if ty.is_join {
    return true
  }
  if ty.is_union {
    i = 0
    while i < ty.members.size {
      m = ty.members[i]
      if m.is_nil {
      } else {
        if ty_has_heap(m) {
          return true
        }
      }
      i = i + 1
    }
    return false
  }
  if ty.is_struct {
    i = 0
    while i < ty.fields.size {
      if ty_has_heap(ty.fields[i].ty) {
        return true
      }
      i = i + 1
    }
  }
  false
}

pub fn heap_ptr_value(ty: Ty): Bool {
  if ty.is_class {
    return true
  }
  if ty.is_array {
    return true
  }
  if ty.is_string {
    return true
  }
  if ty.is_hash {
    return true
  }
  if ty.is_buf {
    return true
  }
  ty.is_join
}

pub fn scalar_array_elem(ty: Ty): Bool {
  if ty.is_integer {
    return true
  }
  if ty.is_bool {
    return true
  }
  ty.is_float
}

// Int, bool, and float stay in an i64. A class, array, string, hash,
// buffer, or join is one pointer word. A fn value is two words, and a
// struct element is inline, so neither is hoisted this way.
pub fn hoist_array_elem(ty: Ty): Bool {
  if scalar_array_elem(ty) {
    return true
  }
  pointer_root_ty(ty)
}

pub fn pointer_root_ty(ty: Ty): Bool {
  if ty.is_fn {
    return false
  }
  if scalar_array_elem(ty) {
    return false
  }
  heap_ptr_value(ty)
}

pub fn array_type_id(elem: Ty): Int {
  if elem.is_fn {
    return 65535
  }
  if heap_ptr_value(elem) {
    return 65535
  }
  0
}

// A store into a mature object can keep a young pointer. Node? is a
// union around a class pointer, so the field type itself is not a
// heap pointer. The payload word still is.
pub fn needs_heap_barrier(ty: Ty): Bool {
  if heap_ptr_value(ty) {
    return true
  }
  if ty.is_fn {
    return true
  }
  if ty.is_union {
    payloads = ty.payload_members
    i = 0
    while i < payloads.size {
      if needs_heap_barrier(payloads[i]) {
        return true
      }
      i = i + 1
    }
    return false
  }
  if ty.is_struct {
    i = 0
    while i < ty.fields.size {
      if needs_heap_barrier(ty.fields[i].ty) {
        return true
      }
      i = i + 1
    }
    return false
  }
  false
}

pub fn abi_align(ty: Ty): Int {
  if ty.is_fn {
    return 8
  }
  if ty.is_int {
    return 4
  }
  if ty.is_nil {
    return 4
  }
  if ty.is_int64 {
    return 8
  }
  if ty.is_uint64 {
    return 8
  }
  if ty.is_bool {
    return 1
  }
  if ty.is_union {
    best = 4
    payloads = ty.payload_members
    i = 0
    while i < payloads.size {
      a = abi_align(payloads[i])
      if a > best {
        best = a
      }
      i = i + 1
    }
    return best
  }
  if ty.is_struct {
    if ty.fields.size == 0 {
      return 1
    }
    best = 1
    i = 0
    while i < ty.fields.size {
      a = abi_align(ty.fields[i].ty)
      if a > best {
        best = a
      }
      i = i + 1
    }
    return best
  }
  8
}

pub fn abi_size(ty: Ty): Int {
  if ty.is_fn {
    return 16
  }
  if ty.is_int {
    return 4
  }
  if ty.is_nil {
    return 4
  }
  if ty.is_int64 {
    return 8
  }
  if ty.is_uint64 {
    return 8
  }
  if ty.is_bool {
    return 1
  }
  if ty.is_union {
    offset = 4
    payloads = ty.payload_members
    i = 0
    while i < payloads.size {
      fty = payloads[i]
      offset = align_up_i(offset, abi_align(fty))
      offset = offset + abi_size(fty)
      i = i + 1
    }
    return align_up_i(offset, abi_align(ty))
  }
  if ty.is_struct {
    offset = 0
    i = 0
    while i < ty.fields.size {
      fty = ty.fields[i].ty
      offset = align_up_i(offset, abi_align(fty))
      offset = offset + abi_size(fty)
      i = i + 1
    }
    return align_up_i(offset, abi_align(ty))
  }
  8
}

pub fn align_up_i(n: Int, align: Int): Int {
  (n + align - 1) / align * align
}

pub fn u64_pow2(word: Int): UInt64 {
  p = 1u64
  i = 0
  while i < word {
    p = p * 2u64
    i = i + 1
  }
  p
}

pub fn word_bit(offset: Int, bits: UInt64): UInt64 {
  word = offset / 8
  bits | u64_pow2(word)
}

pub fn add_ptr_bits(ty: Ty, offset: Int, bits: UInt64): UInt64 {
  if ty.is_fn {
    return word_bit(offset, bits)
  }
  if heap_ptr_value(ty) {
    return word_bit(offset, bits)
  }
  if ty.is_union {
    off = align_up_i(offset + 4, 8)
    payloads = ty.payload_members
    i = 0
    while i < payloads.size {
      m = payloads[i]
      off = align_up_i(off, abi_align(m))
      bits = add_ptr_bits(m, off, bits)
      off = off + abi_size(m)
      i = i + 1
    }
    return bits
  }
  if ty.is_struct {
    off = offset
    i = 0
    while i < ty.fields.size {
      fty = ty.fields[i].ty
      off = align_up_i(off, abi_align(fty))
      bits = add_ptr_bits(fty, off, bits)
      off = off + abi_size(fty)
      i = i + 1
    }
    return bits
  }
  bits
}

pub fn pointer_word_bits(ty: Ty): UInt64 {
  bits = 0u64
  offset = 0
  i = 0
  while i < ty.fields.size {
    fty = ty.fields[i].ty
    offset = align_up_i(offset, abi_align(fty))
    bits = add_ptr_bits(fty, offset, bits)
    offset = offset + abi_size(fty)
    i = i + 1
  }
  bits
}

pub fn myc_quote(value: String): String {
  buf = buf_new(value.size + 2)
  buf.push_byte(34)
  i = 0
  while i < value.size {
    c = value[i]
    if c == 10 {
      buf.push_str("\\n")
    } else if c == 9 {
      buf.push_str("\\t")
    } else if c == 13 {
      buf.push_str("\\r")
    } else if c == 34 {
      buf.push_str("\\\"")
    } else if c == 92 {
      buf.push_str("\\\\")
    } else {
      buf.push_byte(c)
    }
    i = i + 1
  }
  buf.push_byte(34)
  buf.to_s
}

pub fn myc_float_literal(text: String): String {
  epos = 0 - 1
  i = 0
  while i < text.size {
    c = text[i]
    if c == 101 || c == 69 {
      epos = i
    }
    i = i + 1
  }
  if epos < 0 {
    return text
  }
  head = str_slice(text, 0, epos)
  j = epos + 1
  neg = false
  if j < text.size {
    c = text[j]
    if c == 43 || c == 45 {
      if c == 45 {
        neg = true
      }
      j = j + 1
    }
  }
  while j < text.size && text[j] == 48 {
    j = j + 1
  }
  digits = str_slice(text, j, text.size)
  if digits.size == 0 {
    return "${head}e0"
  }
  if neg {
    return "${head}e-${digits}"
  }
  "${head}e${digits}"
}

pub fn myc_binop(op: Int): String {
  switch op {
    case 37 {
      "add"
    }
    case 38 {
      "sub"
    }
    case 39 {
      "mul"
    }
    case 40 {
      "div"
    }
    case 41 {
      "rem"
    }
    case 53 {
      "and"
    }
    case 51 {
      "or"
    }
    case 55 {
      "xor"
    }
    case 57 {
      "shl"
    }
    case 58 {
      "sar"
    }
    case 43 {
      "eq"
    }
    case 44 {
      "not_eq"
    }
    case 45 {
      "less"
    }
    case 46 {
      "less_eq"
    }
    case 47 {
      "more"
    }
    case 48 {
      "more_eq"
    }
    else {
      "add"
    }
  }
}

pub fn compound_to_binop(op: Int): Int {
  if op == 24 {
    return 37
  }
  if op == 25 {
    return 38
  }
  if op == 26 {
    return 39
  }
  if op == 27 {
    return 40
  }
  op
}

pub fn split_comma(s: String): Array(String) {
  out: Array(String) = []
  if s.size == 0 {
    return out
  }
  start = 0
  i = 0
  while i < s.size {
    if s[i] == 44 {
      out.push(str_slice(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(str_slice(s, start, s.size))
  out
}

pub fn expr_ty(e: Expr): Ty {
  if t = e.ty {
    return t
  }
  ty_void()
}

pub fn coverage_wanted: Bool {
  if v = env_get("AVANT_COVERAGE") {
    if v.size > 0 {
      if str_eq(v, "0") {
      } else {
        return true
      }
    }
  }
  args = argv()
  i = 0
  while i < args.size {
    if str_eq(args[i], "--coverage") {
      return true
    }
    i = i + 1
  }
  false
}

pub fn coverage_map_path: String {
  if v = env_get("AVANT_COVERAGE_MAP") {
    if v.size > 0 {
      return v
    }
  }
  stamp = now_ms()
  "/tmp/avant-cov-${stamp}.map"
}

pub class MycGen {
  program: Program
  resolver: TypeResolver
  functions: Array(FuncSig)
  fn_index: Hash(String, Int)
  rooted: Hash(String, Int)
  out: Buf
  indent: Int = 0
  temps: Int = 0
  c_main: Bool = false
  return_type: Ty
  array_tys: Array(Ty)
  union_tys: Array(Ty)
  methods: Array(FuncSig)
  method_index: Hash(String, Int)
  class_ids: Hash(String, Int)
  self_ty: Ty? = nil
  self_name: String = ""
  spawn_id: Int = 0
  pending: Array(Expr)
  cov: Bool = false
  cov_n: Int = 0
  cov_map_path: String = ""
  cov_kinds: Array(Int)
  cov_paths: Array(String)
  cov_lines: Array(Int)
  cov_names: Array(String)
  cov_line_slots: Hash(String, Int)
  lam_id: Int = 0
  lambdas: Array(Expr)
  fn_tys: Array(Ty)
  box_tys: Array(Ty)
  closure_names: Array(String)
  closure_bits: Array(UInt64)
  box_list: Array(String)
  box_ready: Hash(String, Int)
  cap_list: Array(String)
  cap_tys_now: Array(Ty)
  in_lambda: Bool = false
  env_layout: String = ""
  place_name: String = ""
  place_holder: String = ""
  place_field: Int = 0
  need_gate: Int = 0
  need_parallel: Int = 0
  cur_leaf: Int = 0
  numeric_leaves: Hash(String, Int)
  // 1 while quiet-leaf elimination is walking bodies. Calls that do not
  // move objects stay inside the set. Loop hoisting keeps the strict walk.
  leaf_walk: Int = 0
  leaf_open: Hash(String, Int)
  hoist_names: Array(String)
  hoist_bits: Array(String)
  hoist_ptrs: Array(String)
  hoist_ems: Array(String)
  root_loop: Int = 0
  early_indent: Int = 0
  early_out: Buf
  may_share: Bool = false

  fn initialize(program: Program) {
    self.program = program
    self.resolver = TypeResolver.new
    fns: Array(FuncSig) = []
    self.functions = fns
    fi = Hash(String, Int).new
    self.fn_index = fi
    rt = Hash(String, Int).new
    self.rooted = rt
    b = buf_new()
    self.out = b
    self.indent = 0
    self.temps = 0
    self.c_main = false
    self.return_type = ty_void()
    at: Array(Ty) = []
    self.array_tys = at
    ut: Array(Ty) = []
    self.union_tys = ut
    ms: Array(FuncSig) = []
    self.methods = ms
    mi = Hash(String, Int).new
    self.method_index = mi
    ci = Hash(String, Int).new
    self.class_ids = ci
    self.self_name = ""
    self.spawn_id = 0
    th: Array(Expr) = []
    self.pending = th
    self.cov = false
    self.cov_n = 0
    self.cov_map_path = ""
    ck: Array(Int) = []
    self.cov_kinds = ck
    cp: Array(String) = []
    self.cov_paths = cp
    cl: Array(Int) = []
    self.cov_lines = cl
    cn: Array(String) = []
    self.cov_names = cn
    ls = Hash(String, Int).new
    self.cov_line_slots = ls
    self.lam_id = 0
    lams: Array(Expr) = []
    self.lambdas = lams
    ftys: Array(Ty) = []
    self.fn_tys = ftys
    btys: Array(Ty) = []
    self.box_tys = btys
    cnames: Array(String) = []
    self.closure_names = cnames
    cbits: Array(UInt64) = []
    self.closure_bits = cbits
    boxes: Array(String) = []
    self.box_list = boxes
    br = Hash(String, Int).new
    self.box_ready = br
    caps: Array(String) = []
    self.cap_list = caps
    ctys: Array(Ty) = []
    self.cap_tys_now = ctys
    self.in_lambda = false
    self.env_layout = ""
    self.place_name = ""
    self.place_holder = ""
    self.place_field = 0
    self.need_gate = 0
    self.need_parallel = 0
    self.cur_leaf = 0
    leaves = Hash(String, Int).new
    self.numeric_leaves = leaves
    self.leaf_walk = 0
    opened = Hash(String, Int).new
    self.leaf_open = opened
    hn: Array(String) = []
    self.hoist_names = hn
    hb: Array(String) = []
    self.hoist_bits = hb
    hp: Array(String) = []
    self.hoist_ptrs = hp
    he: Array(String) = []
    self.hoist_ems = he
    self.root_loop = 0
    self.early_indent = 0
    eb = buf_new()
    self.early_out = eb
    self.may_share = false
  }

  pub fn cov_register(kind: Int, path: String, line: Int, name: String): Int {
    if self.cov {
    } else {
      return 0
    }
    slot = self.cov_n
    self.cov_n = slot + 1
    self.cov_kinds.push(kind)
    self.cov_paths.push(path)
    self.cov_lines.push(line)
    self.cov_names.push(name)
    slot
  }

  pub fn emit_cov_hit(slot: Int) {
    if self.cov {
      self.line("PUSH ${slot}")
      self.line("CALL :avant_cov_hit")
    }
  }

  pub fn cov_touch_line(loc: Location) {
    if self.cov {
    } else {
      return
    }
    key = "${loc.path}:${loc.line}"
    if slot = self.cov_line_slots.get(key) {
      self.emit_cov_hit(slot)
      return
    }
    slot = self.cov_register(4, loc.path, loc.line, "")
    self.cov_line_slots[key] = slot
    self.emit_cov_hit(slot)
  }

  pub fn cov_stmt(stmt: Stmt) {
    if self.cov {
    } else {
      return
    }
    loc = stmt.loc
    s = self.cov_register(1, loc.path, loc.line, "")
    self.emit_cov_hit(s)
    self.cov_touch_line(loc)
  }

  pub fn cov_func(fnn: Function) {
    if self.cov {
    } else {
      return
    }
    loc = fnn.loc
    name = fnn.name
    if fnn.owner.size > 0 {
      name = "${fnn.owner}.${fnn.name}"
    }
    s = self.cov_register(3, loc.path, loc.line, name)
    self.emit_cov_hit(s)
    self.cov_touch_line(loc)
  }

  pub fn cov_branch(loc: Location) {
    if self.cov {
    } else {
      return
    }
    s = self.cov_register(2, loc.path, loc.line, "")
    self.emit_cov_hit(s)
    self.cov_touch_line(loc)
  }

  pub fn emit_cov_init {
    if self.cov {
      q = myc_quote(self.cov_map_path)
      self.line("PUSH ${q}")
      self.line("CALL :avant_cov_init")
    }
  }

  pub fn write_cov_map {
    if self.cov {
    } else {
      return
    }
    buf = buf_new()
    buf.push_str("avant-cov 1\n")
    i = 0
    while i < self.cov_n {
      kind = self.cov_kinds[i]
      tag = "S"
      if kind == 2 {
        tag = "B"
      }
      if kind == 3 {
        tag = "F"
      }
      if kind == 4 {
        tag = "L"
      }
      buf.push_str(tag)
      buf.push_str("\t")
      buf.push_str(self.cov_paths[i])
      buf.push_str("\t")
      buf.push_fmt_i(self.cov_lines[i])
      buf.push_str("\t")
      buf.push_str(self.cov_names[i])
      buf.push_str("\n")
      i = i + 1
    }
    dummy = file_write(self.cov_map_path, buf.to_s)
  }

  pub fn line(text: String) {
    i = 0
    while i < self.indent {
      self.out.push_str("  ")
      i = i + 1
    }
    self.out.push_str(text)
    self.out.push_byte(10)
  }

  pub fn blank {
    self.out.push_byte(10)
  }

  pub fn new_temp: String {
    self.temps = self.temps + 1
    n = self.temps
    "__t${n}"
  }

  pub fn reset_rooted {
    rt = Hash(String, Int).new
    self.rooted = rt
    hn: Array(String) = []
    self.hoist_names = hn
    hb: Array(String) = []
    self.hoist_bits = hb
    hp: Array(String) = []
    self.hoist_ptrs = hp
    he: Array(String) = []
    self.hoist_ems = he
  }

  pub fn find_fn(name: String): FuncSig? {
    if id = self.fn_index.get(name) {
      return self.functions[id]
    }
    nil
  }

  pub fn has_fn(name: String): Bool {
    if id = self.fn_index.get(name) {
      return true
    }
    false
  }

  pub fn ext(name: String, args_s: String, ret: String) {
    self.line("FUNC :${name}")
    self.indent = self.indent + 1
    if ret.size > 0 {
      self.line("RETURN")
      self.indent = self.indent + 1
      self.line("TYPE :${ret}")
      self.indent = self.indent - 1
    }
    args = split_comma(args_s)
    if args.size > 0 {
      self.line("ARGS")
      self.indent = self.indent + 1
      i = 0
      while i < args.size {
        a = args[i]
        self.line("TYPE :${a}")
        i = i + 1
      }
      self.indent = self.indent - 1
    }
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
  }

  pub fn emit_runtime_decl {
    // Declaring avant_gc_root is what myc-llvm keys off, via --gc-root from
    // pipeline.av. The copying-nursery contract is avant-ledgers/stages/safepoints.md.
    self.ext("avant_alloc", "u64,u32", "ptr<void>")
    self.ext("avant_pin", "ptr<void>", "")
    self.ext("avant_gc_enter", "", "")
    self.ext("avant_gc_leave", "", "")
    self.ext("avant_gc_root", "ptr<void>", "")
    self.line("GLOBAL :g_avant_shared")
    self.indent = self.indent + 1
    self.line("TYPE :i32")
    self.indent = self.indent - 1
    self.line("ENDGLOBAL")
    self.ext("avant_gc_reload", "ptr<void>", "ptr<void>")
    self.ext("avant_type_map", "u32,u64", "")
    self.ext("avant_barrier", "ptr<void>", "")
    self.ext("avant_str_concat", "ptr<u8>,ptr<u8>", "ptr<u8>")
    self.ext("avant_str_cat_i32", "ptr<u8>,i32", "ptr<u8>")
    self.ext("avant_str_from_int", "i32", "ptr<u8>")
    self.ext("avant_str_from_i64", "i64", "ptr<u8>")
    self.ext("avant_str_from_u64", "u64", "ptr<u8>")
    self.ext("avant_str_from_float", "f64", "ptr<u8>")
    self.ext("avant_str_from_bool", "i32", "ptr<u8>")
    self.ext("avant_str_from_byte", "i32", "ptr<u8>")
    self.ext("avant_str_from_i32_bytes", "ptr<void>", "ptr<u8>")
    self.ext("avant_str_repeat_byte", "i32,i32", "ptr<u8>")
