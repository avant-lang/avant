    self.ext("avant_hash_set_str", "ptr<void>,ptr<u8>,ptr<u8>", "")
    self.ext("avant_hash_set_i32k_i32", "ptr<void>,i32,i32", "")
    self.ext("avant_hash_get_i32", "ptr<void>,ptr<u8>,ptr<i32>", "i32")
