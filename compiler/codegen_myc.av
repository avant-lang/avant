      self.emit_expr(expr.args[1])
    }
    key = self.new_temp
    self.line("LOCAL :${key} :ptr<u8>")
    self.line("STORE")
    if expr.args.size > 0 {
      self.emit_expr(expr.args[0])
    }
    arr = self.new_temp
    self.line("LOCAL :${arr} :ptr<void>")
