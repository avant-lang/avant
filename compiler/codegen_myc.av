import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import loader
import typed_ir
import codegen_types
import re2c_pat

pub class MycGen {
  program: Program
  resolver: TypeResolver
  functions: Array(FuncSig)
  fn_index: Hash(String, Int)
  rooted: Hash(String, Int)
  out: Buf
  indent: Int = 0
  temps: Int = 0
  c_main: Bool = false
  return_type: Ty
  array_tys: Array(Ty)
  union_tys: Array(Ty)
  methods: Array(FuncSig)
  method_index: Hash(String, Int)
  class_ids: Hash(String, Int)
  self_ty: Ty? = nil
  self_name: String = ""
  spawn_id: Int = 0
  pending: Array(Expr)
  cov: Bool = false
  cov_n: Int = 0
  cov_map_path: String = ""
  cov_kinds: Array(Int)
  cov_paths: Array(String)
  cov_lines: Array(Int)
  cov_names: Array(String)
  cov_line_slots: Hash(String, Int)
  lam_id: Int = 0
  lambdas: Array(Expr)
  fn_tys: Array(Ty)
  box_tys: Array(Ty)
  closure_names: Array(String)
  closure_bits: Array(UInt64)
  box_list: Array(String)
  box_ready: Hash(String, Int)
  cap_list: Array(String)
  cap_tys_now: Array(Ty)
  in_lambda: Bool = false
  env_layout: String = ""
  place_name: String = ""
  place_holder: String = ""
  place_field: Int = 0
  need_gate: Int = 0
  need_parallel: Int = 0
  cur_leaf: Int = 0
  quiet_guard: Int = 0
  numeric_leaves: Hash(String, Int)
  // 1 while quiet-leaf elimination is walking bodies. Calls that do not
  // move objects stay inside the set. Loop hoisting keeps the strict walk.
  leaf_walk: Int = 0
  leaf_open: Hash(String, Int)
  versioned: Array(String)
  hoist_names: Array(String)
  hoist_bits: Array(String)
  hoist_ptrs: Array(String)
  hoist_ems: Array(String)
  hoist_young: Array(String)
  // 1 while emitting the stable copy of a parallel loop. Hoisted
  // numeric buffers are not young, so indexes use the plain address.
  bits_only: Int = 0
  root_loop: Int = 0
  symbols: SymbolTable? = nil
  early_indent: Int = 0
  early_out: Buf
  early_names: Array(String)
  early_myc: Array(String)
  may_share: Bool = false
  pin_temps: Array(String)
  pin_loops: Array(Int)
  cb_names: Array(String)
  cb_targets: Array(String)
  cb_tys: Array(Ty)
  cb_lambda: Array(Int)

  fn initialize(program: Program) {
    self.program = program
    self.resolver = TypeResolver.new
    fns: Array(FuncSig) = []
    self.functions = fns
    fi = Hash(String, Int).new
    self.fn_index = fi
    rt = Hash(String, Int).new
    self.rooted = rt
    b = buf_new()
    self.out = b
    self.indent = 0
    self.temps = 0
    self.c_main = false
    self.return_type = ty_void()
    at: Array(Ty) = []
    self.array_tys = at
    ut: Array(Ty) = []
    self.union_tys = ut
    ms: Array(FuncSig) = []
    self.methods = ms
    mi = Hash(String, Int).new
    self.method_index = mi
    ci = Hash(String, Int).new
    self.class_ids = ci
    self.self_name = ""
    self.spawn_id = 0
    th: Array(Expr) = []
    self.pending = th
    self.cov = false
    self.cov_n = 0
    self.cov_map_path = ""
    ck: Array(Int) = []
    self.cov_kinds = ck
    cp: Array(String) = []
    self.cov_paths = cp
    cl: Array(Int) = []
    self.cov_lines = cl
    cn: Array(String) = []
    self.cov_names = cn
    ls = Hash(String, Int).new
    self.cov_line_slots = ls
    self.lam_id = 0
    lams: Array(Expr) = []
    self.lambdas = lams
    ftys: Array(Ty) = []
    self.fn_tys = ftys
    btys: Array(Ty) = []
    self.box_tys = btys
    cnames: Array(String) = []
    self.closure_names = cnames
    cbits: Array(UInt64) = []
    self.closure_bits = cbits
    boxes: Array(String) = []
    self.box_list = boxes
    br = Hash(String, Int).new
    self.box_ready = br
    caps: Array(String) = []
    self.cap_list = caps
    ctys: Array(Ty) = []
    self.cap_tys_now = ctys
    self.in_lambda = false
    self.env_layout = ""
    self.place_name = ""
    self.place_holder = ""
    self.place_field = 0
    self.need_gate = 0
    self.need_parallel = 0
    self.cur_leaf = 0
    self.quiet_guard = 0
    leaves = Hash(String, Int).new
    self.numeric_leaves = leaves
    self.leaf_walk = 0
    opened = Hash(String, Int).new
    self.leaf_open = opened
    vs: Array(String) = []
    self.versioned = vs
    hn: Array(String) = []
    self.hoist_names = hn
    hb: Array(String) = []
    self.hoist_bits = hb
    hp: Array(String) = []
    self.hoist_ptrs = hp
    he: Array(String) = []
    self.hoist_ems = he
    hy: Array(String) = []
    self.hoist_young = hy
    self.bits_only = 0
    self.root_loop = 0
    self.early_indent = 0
    eb = buf_new()
    self.early_out = eb
    en: Array(String) = []
    self.early_names = en
    emc: Array(String) = []
    self.early_myc = emc
    self.may_share = false
    self.symbols = nil
    pt: Array(String) = []
    self.pin_temps = pt
    pl: Array(Int) = []
    self.pin_loops = pl
    cbn: Array(String) = []
    self.cb_names = cbn
    cbt: Array(String) = []
    self.cb_targets = cbt
    cbty: Array(Ty) = []
    self.cb_tys = cbty
    cbl: Array(Int) = []
    self.cb_lambda = cbl
  }

  pub fn cov_register(kind: Int, path: String, line: Int, name: String): Int {
    if self.cov {
    } else {
      return 0
    }
    slot = self.cov_n
    self.cov_n = slot + 1
    self.cov_kinds.push(kind)
    self.cov_paths.push(path)
    self.cov_lines.push(line)
    self.cov_names.push(name)
    slot
  }

  pub fn emit_cov_hit(slot: Int) {
    if self.cov {
      self.line("PUSH ${slot}")
      self.line("CALL :avant_cov_hit")
    }
  }

  pub fn cov_touch_line(loc: Location) {
    if self.cov {
    } else {
      return
    }
    key = "${loc.path}:${loc.line}"
    if slot = self.cov_line_slots.get(key) {
      self.emit_cov_hit(slot)
      return
    }
    slot = self.cov_register(4, loc.path, loc.line, "")
    self.cov_line_slots[key] = slot
    self.emit_cov_hit(slot)
  }

  pub fn cov_stmt(stmt: Stmt) {
    if self.cov {
    } else {
      return
    }
    loc = stmt.loc
    s = self.cov_register(1, loc.path, loc.line, "")
    self.emit_cov_hit(s)
    self.cov_touch_line(loc)
  }

  pub fn cov_func(fnn: Function) {
    if self.cov {
    } else {
      return
    }
    loc = fnn.loc
    name = fnn.name
    if fnn.owner.size > 0 {
      name = "${fnn.owner}.${fnn.name}"
    }
    s = self.cov_register(3, loc.path, loc.line, name)
    self.emit_cov_hit(s)
    self.cov_touch_line(loc)
  }

  pub fn cov_branch(loc: Location) {
    if self.cov {
    } else {
      return
    }
    s = self.cov_register(2, loc.path, loc.line, "")
    self.emit_cov_hit(s)
    self.cov_touch_line(loc)
  }

  pub fn emit_cov_init {
    if self.cov {
      q = myc_quote(self.cov_map_path)
      self.line("PUSH ${q}")
      self.line("CALL :avant_cov_init")
    }
  }

  pub fn write_cov_map {
    if self.cov {
    } else {
      return
    }
    buf = buf_new()
    buf.push_str("avant-cov 1\n")
    i = 0
    while i < self.cov_n {
      kind = self.cov_kinds[i]
      tag = "S"
      if kind == 2 {
        tag = "B"
      }
      if kind == 3 {
        tag = "F"
      }
      if kind == 4 {
        tag = "L"
      }
      buf.push_str(tag)
      buf.push_str("\t")
      buf.push_str(self.cov_paths[i])
      buf.push_str("\t")
      buf.push_fmt_i(self.cov_lines[i])
      buf.push_str("\t")
      buf.push_str(self.cov_names[i])
      buf.push_str("\n")
      i = i + 1
    }
    dummy = file_write(self.cov_map_path, buf.to_s)
  }

  pub fn line(text: String) {
    i = 0
    while i < self.indent {
      self.out.push_str("  ")
      i = i + 1
    }
    self.out.push_str(text)
    self.out.push_byte(10)
  }

  pub fn blank {
    self.out.push_byte(10)
  }

  pub fn new_temp: String {
    self.temps = self.temps + 1
    n = self.temps
    "__t${n}"
  }

  pub fn reset_rooted {
    rt = Hash(String, Int).new
    self.rooted = rt
    hn: Array(String) = []
    self.hoist_names = hn
    hb: Array(String) = []
    self.hoist_bits = hb
    hp: Array(String) = []
    self.hoist_ptrs = hp
    he: Array(String) = []
    self.hoist_ems = he
    hy: Array(String) = []
    self.hoist_young = hy
    en: Array(String) = []
    self.early_names = en
    emc: Array(String) = []
    self.early_myc = emc
  }

  pub fn emit: String {
    self.cov = coverage_wanted()
    if self.cov {
      self.cov_map_path = coverage_map_path()
    }
    if s = self.symbols {
      self.resolver = s.resolver
      self.functions = s.functions
      self.fn_index = s.fn_index
      self.methods = s.methods
      self.method_index = s.method_index
    } else {
      self.resolver = load_types(self.program)
      self.collect_sigs
      self.collect_methods
    }
    self.mark_numeric_leaves
    self.may_share = self.program_may_share
    self.mark_quiet_leaves
    self.assign_class_ids
    self.collect_arrays
    self.emit_runtime_decl
    self.emit_lib_decls
    i = 0
    while i < self.program.structs.size {
      sdef = self.program.structs[i]
      if sdef.type_params.size > 0 {
      } else {
        if ty = self.resolver.get_named_for(sdef.mod_name, sdef.name) {
          self.emit_layout(ty)
        }
      }
      i = i + 1
    }
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if cdef.type_params.size > 0 {
      } else {
        if ty = self.resolver.get_named_for(cdef.mod_name, cdef.name) {
          self.emit_layout(ty)
        }
      }
      i = i + 1
    }
    i = 0
    while i < self.program.libs.size {
      lib_def = self.program.libs[i]
      j = 0
      while j < lib_def.layouts.size {
        lay = lib_def.layouts[j]
        if ty = self.resolver.get_named_for(lay.mod_name, lay.name) {
          self.emit_layout(ty)
        }
        j = j + 1
      }
      i = i + 1
    }
    i = 0
    while i < self.union_tys.size {
      self.emit_union_def(self.union_tys[i])
      i = i + 1
    }
    i = 0
    while i < self.array_tys.size {
      self.emit_array_def(self.array_tys[i])
      i = i + 1
    }
    self.line("STRUCT :AvantBuf")
    self.indent = self.indent + 1
    self.line("TYPE :ptr<u8>")
    self.line("TYPE :i32")
    self.line("TYPE :i32")
    self.indent = self.indent - 1
    self.line("ENDSTRUCT")
    self.blank
    i = 0
    while i < self.fn_tys.size {
      self.emit_fn_def(self.fn_tys[i])
      i = i + 1
    }
    i = 0
    while i < self.box_tys.size {
      self.emit_box_def(self.box_tys[i])
      i = i + 1
    }
    self.emit_env_defs
    i = 0
    while i < self.pending.size {
      pend = self.pending[i]
      if str_eq(pend.callee, "parallel") {
        self.emit_parallel_layout(pend)
      } else {
        self.emit_spawn_cap_layout(pend)
      }
      i = i + 1
    }
    fns = program_all_functions(self.program)
    i = 0
    while i < fns.size {
      self.emit_function(fns[i])
      i = i + 1
    }
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if cdef.type_params.size > 0 {
      } else {
        if ty = self.resolver.get_named_for(cdef.mod_name, cdef.name) {
          self.emit_constructor(ty)
          if self.class_uses_bump(cdef.name) {
            self.emit_bump_constructor(ty)
          }
        }
      }
      i = i + 1
    }
    self.cur_leaf = 0
    i = 0
    while i < self.pending.size {
      pend = self.pending[i]
      if str_eq(pend.callee, "parallel") {
        self.emit_parallel_thunk(pend)
      } else {
        self.emit_spawn_thunk(pend)
      }
      i = i + 1
    }
    i = 0
    while i < self.lambdas.size {
      self.emit_lambda_thunk(self.lambdas[i])
      i = i + 1
    }
    i = 0
    while i < fns.size {
      if fns[i].as_value {
        if fns[i].generic {
        } else {
          self.emit_fn_trampoline(fns[i])
        }
      }
      i = i + 1
    }
    i = 0
    while i < self.cb_names.size {
      self.emit_cb_thunk(i)
      i = i + 1
    }
    if self.has_fn("main") {
    } else {
      self.emit_wrapper_main
    }
    self.write_cov_map
    self.out.to_s
  }

  pub fn emit_function(fnn: Function) {
    self.cur_leaf = 0
    if fnn.generic {
      return
    }
    if self.owner_is_template(fnn.owner) {
      return
    }
    self.temps = 0
    self.c_main = false
    self.self_ty = nil
    self.self_name = ""
    if fn_is_method(fnn) {
      if sig = self.find_method_emit(fnn.emit_name) {
        self.return_type = sig.ret
        self.self_name = fn_self_name(fnn)
        got_owner = false
        owner = ty_void()
        if sig.node.owner_mod.size > 0 {
          if o = self.resolver.get_named_for(sig.node.owner_mod, sig.owner) {
            owner = o
            got_owner = true
          }
        }
        if got_owner {
        } else {
          if o2 = self.resolver.get_named(sig.owner) {
            owner = o2
            got_owner = true
          }
        }
        if got_owner {
          self.self_ty = owner
          self.emit_method_func(fnn, sig)
        } else {
          self.self_ty = nil
          self.emit_ptr_method_func(fnn, sig)
        }
      }
      self.self_ty = nil
      self.self_name = ""
      return
    }
    if sig = self.find_fn(fnn.emit_name) {
      self.return_type = sig.ret
      if str_eq(fnn.name, "main") {
        self.c_main = true
      }
      self.emit_plain_func(fnn, sig.params)
      self.c_main = false
    }
  }

  pub fn emit_return_header {
    if self.c_main {
      self.line("RETURN")
      self.indent = self.indent + 1
      self.line("TYPE :i32")
      self.indent = self.indent - 1
    } else {
      if self.return_type.is_void {
      } else {
        self.line("RETURN")
        self.indent = self.indent + 1
        m = ty_myc(self.return_type)
        self.line("TYPE :${m}")
        self.indent = self.indent - 1
      }
    }
  }

  pub fn arm_quiet_guard(body: Array(Stmt)) {
    // A quiet leaf does not collect. myc-llvm does not plant roots in
    // that frame, so the quiet enter/leave pair is only call overhead.
    self.quiet_guard = 0
  }

  pub fn emit_plain_func(fnn: Function, params: Array(Ty)) {
    self.cur_leaf = 0
    if v = self.numeric_leaves.get(fnn.emit_name) {
      self.cur_leaf = 1
    }
    self.begin_fn_frame(fnn.box_names)
    self.line("FUNC :${fnn.emit_name}")
    self.indent = self.indent + 1
    if self.c_main {
      self.line("ARGS")
      self.indent = self.indent + 1
      self.line("TYPE :i32")
      self.line("TYPE :ptr<void>")
      self.indent = self.indent - 1
      self.emit_return_header
      self.line("BODY")
      self.indent = self.indent + 1
      self.reset_rooted
      self.quiet_guard = 0
      if self.cur_leaf == 0 {
        self.line("CALL :avant_gc_enter")
      }
      self.emit_type_maps
      self.emit_init_argv
      self.emit_cov_init
      self.cov_func(fnn)
      self.emit_stmts(fnn.body, true)
      self.emit_gc_leave_if_fallthrough(fnn)
    } else {
      if fnn.params.size > 0 {
        self.line("ARGS")
        self.indent = self.indent + 1
        i = 0
        while i < params.size {
          m = ty_myc(params[i])
          self.line("TYPE :${m}")
          i = i + 1
        }
        self.indent = self.indent - 1
      }
      self.emit_return_header
      self.line("BODY")
      self.indent = self.indent + 1
      self.reset_rooted
      if self.cur_leaf == 0 {
        self.line("CALL :avant_gc_enter")
      }
      self.arm_quiet_guard(fnn.body)
      pnames: Array(String) = []
      i = 0
      while i < fnn.params.size {
        pnames.push(fnn.params[i].name)
        i = i + 1
      }
      self.emit_param_group(pnames, params, 0)
      self.cov_func(fnn)
      self.emit_stmts(fnn.body, true)
      self.emit_gc_leave_if_fallthrough(fnn)
    }
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
  }

  pub fn emit_method_func(fnn: Function, sig: FuncSig) {
    self.cur_leaf = 0
    if self.leaf_named(sig.mangled) {
      self.cur_leaf = 1
    }
    self.begin_fn_frame(fnn.box_names)
    mangled = sig.mangled
    self.line("FUNC :${mangled}")
    self.indent = self.indent + 1
    self.line("ARGS")
    self.indent = self.indent + 1
    if owner = self.self_ty {
      m = ty_self_ptr_myc(owner)
      self.line("TYPE :${m}")
    }
    i = 0
    while i < sig.params.size {
      m = ty_myc(sig.params[i])
      self.line("TYPE :${m}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.emit_return_header
    self.line("BODY")
    self.indent = self.indent + 1
    self.reset_rooted
    if self.cur_leaf == 0 {
      self.line("CALL :avant_gc_enter")
    }
    self.arm_quiet_guard(fnn.body)
    recv_name = fn_self_name(fnn)
    if owner = self.self_ty {
      m = ty_self_ptr_myc(owner)
      self.line("PARAM 0")
      self.line("LOCAL :${recv_name} :${m}")
      self.line("STORE")
    }
    pnames: Array(String) = []
    i = 0
    while i < fnn.params.size {
      pnames.push(fnn.params[i].name)
      i = i + 1
    }
    raws = self.emit_param_stores(pnames, sig.params, 1)
    if rooted = self.self_ty {
      self.ensure_root(recv_name, rooted)
    }
    self.emit_param_finish(pnames, sig.params, raws)
    self.cov_func(fnn)
    self.emit_stmts(fnn.body, true)
    self.emit_gc_leave_if_fallthrough(fnn)
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
    self.self_ty = nil
    self.self_name = ""
  }

  pub fn emit_ptr_method_func(fnn: Function, sig: FuncSig) {
    self.cur_leaf = 0
    if self.leaf_named(sig.mangled) {
      self.cur_leaf = 1
    }
    self.begin_fn_frame(fnn.box_names)
    recv_ty = ty_void()
    if r = fnn.receiver {
      recv_ty = self.resolver.resolve(r.type)
    }
    mrecv = ty_myc(recv_ty)
    mangled = sig.mangled
    recv_name = fn_self_name(fnn)
    self.line("FUNC :${mangled}")
    self.indent = self.indent + 1
    self.line("ARGS")
    self.indent = self.indent + 1
    self.line("TYPE :${mrecv}")
    i = 0
    while i < sig.params.size {
      m = ty_myc(sig.params[i])
      self.line("TYPE :${m}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.emit_return_header
    self.line("BODY")
    self.indent = self.indent + 1
    self.reset_rooted
    if self.cur_leaf == 0 {
      self.line("CALL :avant_gc_enter")
    }
    self.arm_quiet_guard(fnn.body)
    self.line("PARAM 0")
    self.line("LOCAL :${recv_name} :${mrecv}")
    self.line("STORE")
    pnames: Array(String) = []
    i = 0
    while i < fnn.params.size {
      pnames.push(fnn.params[i].name)
      i = i + 1
    }
    self.emit_param_group(pnames, sig.params, 1)
    self.cov_func(fnn)
    self.emit_stmts(fnn.body, true)
    self.emit_gc_leave_if_fallthrough(fnn)
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
    self.self_ty = nil
    self.self_name = ""
  }

  pub fn emit_named_args(names: Array(String), types: Array(Ty)) {
    if names.size <= 1 {
      i = 0
      while i < names.size {
        self.line("LOCAL :${names[i]}")
        i = i + 1
      }
      return
    }
    tmps: Array(String) = []
    i = 0
    while i < names.size {
      self.line("LOCAL :${names[i]}")
      tmp = self.new_temp
      m = ty_myc(types[i])
      self.line("LOCAL :${tmp} :${m}")
      self.line("STORE")
      self.ensure_root(tmp, types[i])
      tmps.push(tmp)
      i = i + 1
    }
    i = tmps.size - 1
    while i >= 0 {
      t = tmps[i]
      self.line("LOCAL :${t}")
      i = i - 1
    }
  }

  pub fn emit_field_defaults(ty: Ty) {
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if str_eq(cdef.name, ty.name) {
        j = 0
        while j < cdef.fields.size {
          field = cdef.fields[j]
          if default = field.default {
            field_ty = ty.fields[j].ty
            self.emit_expr(default)
            self.emit_coerce(expr_ty(default), field_ty)
            if needs_heap_barrier(field_ty) {
              val = self.new_temp
              m = ty_myc(field_ty)
              self.line("LOCAL :${val} :${m}")
              self.line("STORE")
              self.ensure_root(val, field_ty)
              self.line("LOCAL :self")
              self.line("CALL :avant_barrier")
              self.line("LOCAL :${val}")
              self.line("LOCAL :self")
              self.line("DEREF")
              self.line("FIELD ${j}")
              self.line("STORE")
            } else {
              self.line("LOCAL :self")
              self.line("DEREF")
              self.line("FIELD ${j}")
              self.line("STORE")
            }
          }
          j = j + 1
        }
        return
      }
      i = i + 1
    }
  }

  pub fn emit_constructor(ty: Ty) {
    self.cur_leaf = 0
    self.quiet_guard = 0
    self.temps = 0
    self.return_type = ty
    self.self_ty = nil
    self.self_name = ""
    none: Array(String) = []
    self.begin_fn_frame(none)
    init_sig = self.find_initialize(ty.name, ty.mod_name)
    ctor = ty_owned_symbol(ty, "new")
    self.line("FUNC :${ctor}")
    self.indent = self.indent + 1
    if sig = init_sig {
      if sig.params.size > 0 {
        self.line("ARGS")
        self.indent = self.indent + 1
        i = 0
        while i < sig.params.size {
          m = ty_myc(sig.params[i])
          self.line("TYPE :${m}")
          i = i + 1
        }
        self.indent = self.indent - 1
      }
    }
    self.line("RETURN")
    self.indent = self.indent + 1
    m = ty_myc(ty)
    self.line("TYPE :${m}")
    self.indent = self.indent - 1
    self.line("BODY")
    self.indent = self.indent + 1
    self.reset_rooted
    self.line("CALL :avant_gc_enter")
    if sig = init_sig {
      i = 0
      while i < sig.params.size {
        name = sig.node.params[i].name
        m = ty_myc(sig.params[i])
        self.line("PARAM ${i}")
        self.line("LOCAL :${name} :${m}")
        self.line("STORE")
        self.ensure_root(name, sig.params[i])
        i = i + 1
      }
    }
    tid = 1
    if id = self.class_ids.get(self.class_id_key(ty)) {
      tid = id
    }
    layout = ty_layout_myc(ty)
    self.emit_alloc_sizeof(layout, tid)
    sp = ty_self_ptr_myc(ty)
    self.line("AS :${sp}")
    self.line("LOCAL :self :${sp}")
    self.line("STORE")
    self.ensure_root("self", ty)
    self.emit_field_defaults(ty)
    if sig = init_sig {
      names: Array(String) = []
      i = 0
      while i < sig.node.params.size {
        names.push(sig.node.params[i].name)
        i = i + 1
      }
      self.emit_named_args(names, sig.params)
      self.line("LOCAL :self")
      mangled = sig.mangled
      self.line("CALL :${mangled}")
    }
    self.line("LOCAL :self")
    self.emit_ret
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
  }

  // Allocates without collecting. Null means the nursery could not
  // grow, and the caller retries after nursery_reclaim. Ordinary
  // .new stays on avant_alloc.
  pub fn emit_bump_constructor(ty: Ty) {
    saved_leaf = self.cur_leaf
    self.cur_leaf = 1
    self.quiet_guard = 0
    self.temps = 0
    opt = ty_nilable(ty)
    self.return_type = opt
    self.self_ty = nil
    self.self_name = ""
    none: Array(String) = []
    self.begin_fn_frame(none)
    init_sig = self.find_initialize(ty.name, ty.mod_name)
    ctor = ty_owned_symbol(ty, "bump")
    self.line("FUNC :${ctor}")
    self.indent = self.indent + 1
    if sig = init_sig {
      if sig.params.size > 0 {
        self.line("ARGS")
        self.indent = self.indent + 1
        i = 0
        while i < sig.params.size {
          m = ty_myc(sig.params[i])
          self.line("TYPE :${m}")
          i = i + 1
        }
        self.indent = self.indent - 1
      }
    }
    self.line("RETURN")
    self.indent = self.indent + 1
    m = ty_myc(opt)
    self.line("TYPE :${m}")
    self.indent = self.indent - 1
    self.line("BODY")
    self.indent = self.indent + 1
    self.reset_rooted
    if sig = init_sig {
      i = 0
      while i < sig.params.size {
        name = sig.node.params[i].name
        m = ty_myc(sig.params[i])
        self.line("PARAM ${i}")
        self.line("LOCAL :${name} :${m}")
        self.line("STORE")
        i = i + 1
      }
    }
    tid = 1
    if id = self.class_ids.get(self.class_id_key(ty)) {
      tid = id
    }
    layout = ty_layout_myc(ty)
    self.line("PUSH ${tid} :u32")
    self.line("SIZEOF :${layout}")
    self.line("CALL :avant_bump_alloc")
    self.line("LOCAL :bump_raw :ptr<void>")
    self.line("STORE")
    self.line("LOCAL :bump_raw")
    self.line("PUSH 0")
    self.line("AS :ptr<void>")
    self.line("BINARY :eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.emit_zero(ty_nil())
    self.emit_wrap_union(ty_nil(), opt)
    self.line("RET")
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    sp = ty_self_ptr_myc(ty)
    self.line("LOCAL :bump_raw")
    self.line("AS :${sp}")
    self.line("LOCAL :self :${sp}")
    self.line("STORE")
    self.emit_field_defaults(ty)
    if sig = init_sig {
      names: Array(String) = []
      i = 0
      while i < sig.node.params.size {
        names.push(sig.node.params[i].name)
        i = i + 1
      }
      self.emit_named_args(names, sig.params)
      self.line("LOCAL :self")
      mangled = sig.mangled
      self.line("CALL :${mangled}")
    }
    self.line("LOCAL :self")
    self.emit_wrap_union(ty, opt)
    self.line("RET")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
    self.cur_leaf = saved_leaf
    self.return_type = ty
  }

  pub fn emit_wrapper_main {
    run_void = true
    if sig = self.find_fn("run") {
      if sig.ret.is_void {
        run_void = true
      } else {
        run_void = false
      }
    }
    self.line("FUNC :main")
    self.indent = self.indent + 1
    self.line("ARGS")
    self.indent = self.indent + 1
    self.line("TYPE :i32")
    self.line("TYPE :ptr<void>")
    self.indent = self.indent - 1
    self.line("RETURN")
    self.indent = self.indent + 1
    self.line("TYPE :i32")
    self.indent = self.indent - 1
    self.line("BODY")
    self.indent = self.indent + 1
    self.line("CALL :avant_gc_enter")
    self.emit_type_maps
    self.emit_init_argv
    self.emit_cov_init
    self.line("CALL :run")
    if run_void {
    } else {
      self.line("STACK :drop")
    }
    self.line("CALL :avant_gc_leave")
    self.line("PUSH 0")
    self.line("RET")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
  }

  pub fn emit_init_argv {
    self.line("PARAM 1")
    self.line("PARAM 0")
    self.line("CALL :avant_io_init_argv")
  }

  pub fn emit_type_maps {
    self.line("PUSH 1 :u64")
    self.line("PUSH 1022 :u32")
    self.line("CALL :avant_type_map")
    self.line("PUSH 1 :u64")
    self.line("PUSH 1021 :u32")
    self.line("CALL :avant_type_map")
    self.line("PUSH 7 :u64")
    self.line("PUSH 1023 :u32")
    self.line("CALL :avant_type_map")
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if cdef.type_params.size > 0 {
      } else {
        if ty = self.resolver.get_named_for(cdef.mod_name, cdef.name) {
          bits = pointer_word_bits(ty)
          if id = self.class_ids.get(self.class_id_key_of(cdef.mod_name, cdef.name)) {
            self.line("PUSH ${bits} :u64")
            self.line("PUSH ${id} :u32")
            self.line("CALL :avant_type_map")
          }
        }
      }
      i = i + 1
    }
    i = 0
    while i < self.closure_names.size {
      bits = self.closure_bits[i]
      id = 400 + i
      self.line("PUSH ${bits} :u64")
      self.line("PUSH ${id} :u32")
      self.line("CALL :avant_type_map")
      i = i + 1
    }
  }

  pub fn emit_unpin_temp(t: String) {
    self.line("LOCAL :${t}")
    self.line("AS :ptr<void>")
    self.line("CALL :avant_unpin")
  }

  pub fn emit_unpin_all {
    i = self.pin_temps.size - 1
    while i >= 0 {
      self.emit_unpin_temp(self.pin_temps[i])
      i = i - 1
    }
    pt: Array(String) = []
    self.pin_temps = pt
    pl: Array(Int) = []
    self.pin_loops = pl
  }

  pub fn emit_unpin_loop {
    i = self.pin_temps.size - 1
    while i >= 0 {
      if self.pin_loops[i] == self.root_loop {
        self.emit_unpin_temp(self.pin_temps[i])
        i = i - 1
      } else {
        break
      }
    }
  }

  pub fn emit_pin_stmt(stmt: Stmt) {
    if e = stmt.expr {
      self.emit_expr(e)
      et = expr_ty(e)
      t = self.new_temp
      m = ty_myc(et)
      self.line("LOCAL :${t} :${m}")
      self.line("STORE")
      self.ensure_root(t, et)
      self.line("LOCAL :${t}")
      self.line("AS :ptr<void>")
      self.line("CALL :avant_pin")
      self.pin_temps.push(t)
      self.pin_loops.push(self.root_loop)
      self.emit_stmts(stmt.body, false)
      i = 0
      found = false
      while i < self.pin_temps.size {
        if str_eq(self.pin_temps[i], t) {
          found = true
        }
        i = i + 1
      }
      if found {
        self.emit_unpin_temp(t)
        kept_t: Array(String) = []
        kept_l: Array(Int) = []
        i = 0
        while i < self.pin_temps.size {
          if str_eq(self.pin_temps[i], t) {
          } else {
            kept_t.push(self.pin_temps[i])
            kept_l.push(self.pin_loops[i])
          }
          i = i + 1
        }
        self.pin_temps = kept_t
        self.pin_loops = kept_l
      }
    } else {
      self.emit_stmts(stmt.body, false)
    }
  }

  pub fn emit_ret {
    self.emit_unpin_all
    if self.quiet_guard != 0 {
      self.line("CALL :avant_gc_quiet_leave")
    }
    if self.cur_leaf == 0 {
      self.line("CALL :avant_gc_leave")
    }
    if self.c_main {
      self.line("PUSH 0")
    }
    self.line("RET")
  }

  pub fn emit_gc_leave_if_fallthrough(fnn: Function) {
    if fnn.body.size == 0 {
      self.emit_ret
      return
    }
    last = fnn.body[fnn.body.size - 1]
    if last.kind == st_return() {
      return
    }
    if last.kind == st_expr() {
      if self.return_type.is_void {
      } else {
        return
      }
    }
    self.emit_ret
  }

  pub fn emit_ptr_root(name: String) {
    self.rooted[name] = 1
    self.line("LOCAL :${name}")
    self.line("ADDR")
    self.line("CALL :avant_gc_root")
  }

  // Root an interior pointer only after a second thread exists.
  // g_avant_shared stays 0 for a whole single-threaded run, so the
  // call is not on the hot path. The array object remains a root
  // either way, and its buf word is scanned.
  pub fn emit_root_if_shared(name: String) {
    if self.may_share {
    } else {
      return
    }
    self.line("PUSH 0")
    self.line("GLOBAL :g_avant_shared")
    self.line("BINARY :not_eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.emit_ptr_root(name)
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
  }

  pub fn ensure_root(name: String, ty: Ty) {
    if self.cur_leaf != 0 {
      return
    }
    if self.place_name.size > 0 {
      if str_eq(name, self.place_name) {
        return
      }
    }
    if v = self.rooted.get(name) {
      return
    }
    if ty_has_heap(ty) {
    } else {
      return
    }
    self.rooted[name] = 1
    if ty.is_union {
      i = 0
      field_i = 1
      while i < ty.members.size {
        m = ty.members[i]
        if m.is_nil {
        } else {
          if ty_has_heap(m) {
            self.line("LOCAL :${name}")
            self.line("FIELD ${field_i}")
            self.line("ADDR")
            self.line("CALL :avant_gc_root")
          }
          field_i = field_i + 1
        }
        i = i + 1
      }
      return
    }
    // The root call is idempotent. Inside a loop it ran on every
    // iteration and walked the frame's slot list. Register the slot
    // once, before the outermost loop. It holds null until the loop
    // stores the real pointer. myc-llvm reloads the slot after a
    // collecting call. A union stays rooted at the store: its fields
    // are not one pointer word.
    if self.root_loop > 0 && pointer_root_ty(ty) {
      self.emit_early_root(name, ty)
      return
    }
    self.emit_ptr_root(name)
  }

  pub fn emit_early_root(name: String, ty: Ty) {
    saved_out = self.out
    saved_indent = self.indent
    self.out = self.early_out
    self.indent = self.early_indent
    self.emit_zero(ty)
    m = ty_myc(ty)
    decl = buf_new()
    decl.push_str("LOCAL :")
    decl.push_str(name)
    decl.push_str(" :")
    decl.push_str(m)
    self.line(decl.to_s)
    self.line("STORE")
    use = buf_new()
    use.push_str("LOCAL :")
    use.push_str(name)
    self.line(use.to_s)
    self.line("ADDR")
    self.line("CALL :avant_gc_root")
    self.out = saved_out
    self.indent = saved_indent
    // A temp rooted for the whole loop keeps its last pointer until the
    // next store. That store is after the next allocation, so the dead
    // buffer stays a root and is promoted. Clear temps at the end of the
    // outermost loop, once the iteration is done with them.
    if self.is_codegen_temp(name) {
      self.early_names.push(name)
      self.early_myc.push(ty_myc(ty))
    }
  }

  pub fn emit_stmts(body: Array(Stmt), implicit_return: Bool) {
    i = 0
    while i < body.size {
      at_tail = false
      if implicit_return {
        if i == body.size - 1 {
          at_tail = true
        }
      }
      self.emit_stmt(body[i], at_tail)
      i = i + 1
    }
  }

  pub fn emit_stmt(stmt: Stmt, at_tail: Bool) {
    self.cov_stmt(stmt)
    k = stmt.kind
    switch k {
      case 2 {
        if e = stmt.expr {
          self.emit_expr(e)
          self.emit_coerce(expr_ty(e), self.return_type)
        }
        self.emit_ret
      }
      case 3 {
        if stmt.bind.size > 0 {
          self.emit_if_assign(stmt)
        } else {
          if c = stmt.cond {
            self.emit_expr(c)
          }
          self.line("IF")
          self.indent = self.indent + 1
          self.line("THEN")
          self.indent = self.indent + 1
          self.cov_branch(stmt.loc)
          self.emit_stmts(stmt.then_body, false)
          self.indent = self.indent - 1
          if stmt.else_body.size > 0 {
            self.line("ELSE")
            self.indent = self.indent + 1
            self.cov_branch(stmt.loc)
            self.emit_stmts(stmt.else_body, false)
            self.indent = self.indent - 1
          } else {
            if self.cov {
              self.line("ELSE")
              self.indent = self.indent + 1
              self.cov_branch(stmt.loc)
              self.indent = self.indent - 1
            }
          }
          self.indent = self.indent - 1
          self.line("ENDIF")
        }
      }
      case 4 {
        if stmt.pre.size > 0 {
          self.emit_stmts(stmt.pre, false)
        }
        self.emit_while(stmt)
      }
      case 5 {
        self.emit_unpin_loop
        self.line("BREAK")
      }
      case 6 {
        self.emit_unpin_loop
        self.line("NEXT")
      }
      case 9 {
        self.emit_pin_stmt(stmt)
      }
      case 7 {
        self.emit_assign(stmt)
      }
      case 1 {
        if e = stmt.expr {
          self.emit_expr(e)
          if at_tail {
            if self.return_type.is_void {
              if expr_ty(e).is_void {
              } else {
                self.line("STACK :drop")
              }
            } else {
              self.emit_coerce(expr_ty(e), self.return_type)
              self.emit_ret
            }
          } else {
            if expr_ty(e).is_void {
            } else {
              self.line("STACK :drop")
            }
          }
        }
      }
      else {
      }
    }
  }

  pub fn expr_mentions(expr: Expr, name: String): Bool {
    if expr.kind == ex_name() {
      if str_eq(expr.ident, name) {
        return true
      }
    }
    i = 0
    while i < expr.cap_names.size {
      if str_eq(expr.cap_names[i], name) {
        return true
      }
      i = i + 1
    }
    if inner = expr.inner {
      if self.expr_mentions(inner, name) {
        return true
      }
    }
    if l = expr.left {
      if self.expr_mentions(l, name) {
        return true
      }
    }
    if r = expr.right {
      if self.expr_mentions(r, name) {
        return true
      }
    }
    if obj = expr.object {
      if self.expr_mentions(obj, name) {
        return true
      }
    }
    if c = expr.cond {
      if self.expr_mentions(c, name) {
        return true
      }
    }
    if recv = expr.receiver {
      if self.expr_mentions(recv, name) {
        return true
      }
    }
    if sz = expr.size_expr {
      if self.expr_mentions(sz, name) {
        return true
      }
    }
    if sp = expr.splice {
      if self.expr_mentions(sp, name) {
        return true
      }
    }
    i = 0
    while i < expr.args.size {
      if self.expr_mentions(expr.args[i], name) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.elems.size {
      if self.expr_mentions(expr.elems[i], name) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.field_exprs.size {
      if self.expr_mentions(expr.field_exprs[i], name) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      if pe = part.expr {
        if self.expr_mentions(pe, name) {
          return true
        }
      }
      i = i + 1
    }
    i = 0
    while i < expr.cases.size {
      if self.stmts_mention(expr.cases[i].body, name) {
        return true
      }
      i = i + 1
    }
    if self.stmts_mention(expr.else_body, name) {
      return true
    }
    if b = expr.block {
      if self.stmts_mention(b.body, name) {
        return true
      }
    }
    false
  }

  pub fn stmts_mention(body: Array(Stmt), name: String): Bool {
    i = 0
    while i < body.size {
      if self.stmt_mentions(body[i], name) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn stmt_mentions(stmt: Stmt, name: String): Bool {
    if str_eq(stmt.bind, name) {
      return true
    }
    if e = stmt.expr {
      if self.expr_mentions(e, name) {
        return true
      }
    }
    if c = stmt.cond {
      if self.expr_mentions(c, name) {
        return true
      }
    }
    if t = stmt.target {
      if self.expr_mentions(t, name) {
        return true
      }
    }
    if v = stmt.value {
      if self.expr_mentions(v, name) {
        return true
      }
    }
    if self.stmts_mention(stmt.then_body, name) {
      return true
    }
    if self.stmts_mention(stmt.else_body, name) {
      return true
    }
    self.stmts_mention(stmt.body, name)
  }

  // `primes = Array.new` does not read primes. Drop the old pointer
  // before the allocation so a young collection can free that buffer.
  pub fn assign_drops_local(stmt: Stmt): Bool {
    if t = stmt.target {
      if t.kind == ex_name() {
      } else {
        return false
      }
      if t.implicit_field {
        return false
      }
      if self.name_is_boxed(t.ident) {
        return false
      }
      if self.cap_index(t.ident) >= 0 {
        return false
      }
      if heap_ptr_value(expr_ty(t)) {
      } else {
        return false
      }
      if v = stmt.value {
        if self.expr_may_collect(v) {
          if self.expr_mentions(v, t.ident) {
            return false
          }
          return true
        }
      }
    }
    false
  }

  pub fn drop_local(name: String, ty: Ty) {
    self.emit_zero(ty)
    m = ty_myc(ty)
    self.line("LOCAL :${name} :${m}")
    self.line("STORE")
  }

  pub fn emit_assign(stmt: Stmt) {
    if stmt.op == tk_eq() {
      if self.assign_drops_local(stmt) {
        if t = stmt.target {
          self.drop_local(t.ident, expr_ty(t))
        }
      }
      if t = stmt.target {
        if t.kind == ex_name() {
          if self.name_is_boxed(t.ident) {
            if v = stmt.value {
              self.ensure_box(t.ident, expr_ty(t))
              self.emit_expr(v)
              self.emit_coerce(expr_ty(v), expr_ty(t))
              self.store_box_value(t.ident, expr_ty(t))
              return
            }
          }
        }
        if t.kind == ex_index() {
          if arr = t.left {
            if expr_ty(arr).is_hash {
              if v = stmt.value {
                self.emit_hash_set(t, v, expr_ty(arr))
                return
              }
            }
            if expr_ty(arr).is_array {
              if e = expr_ty(arr).inner {
                if heap_ptr_value(e) {
                  if v = stmt.value {
                    self.emit_array_set_ptr(t, v)
                    return
                  }
                }
              }
            }
          }
        }
        if t.kind == ex_field() {
          if obj = t.object {
            object_ty = expr_ty(obj)
            if object_ty.is_class {
              if needs_heap_barrier(expr_ty(t)) {
                if v = stmt.value {
                  self.emit_barrier_field_store(t, v)
                  return
                }
              }
            }
          }
        }
        if self.c_layout_heap_store(t) {
          if v = stmt.value {
            self.emit_expr(v)
            self.emit_coerce(expr_ty(v), expr_ty(t))
            self.line("STACK :dup")
            self.line("AS :ptr<void>")
            self.line("CALL :avant_pin")
            self.emit_lvalue(t)
            self.line("STORE")
            self.root_after_store(t)
            return
          }
        }
      }
      if v = stmt.value {
        if t = stmt.target {
          self.emit_expr(v)
          self.emit_coerce(expr_ty(v), expr_ty(t))
        }
      }
    } else {
      if t = stmt.target {
        if t.kind == ex_name() {
          if self.name_is_boxed(t.ident) {
            self.ensure_box(t.ident, expr_ty(t))
          }
        }
        self.emit_expr(t)
        tmp = self.new_temp
        ty = expr_ty(t)
        m = ty_myc(ty)
        self.line("LOCAL :${tmp} :${m}")
        self.line("STORE")
        if v = stmt.value {
          self.emit_expr(v)
        }
        self.line("LOCAL :${tmp}")
        self.emit_checked_binary(compound_to_binop(stmt.op), ty, stmt.proven)
      }
    }
    if t = stmt.target {
      if t.kind == ex_index() {
        if arr = t.left {
          if expr_ty(arr).is_buf {
            self.line("AS :u8")
          }
        }
      }
      self.emit_lvalue(t)
      self.line("STORE")
      self.root_after_store(t)
    }
  }

  pub fn emit_barrier_field_store(target: Expr, value: Expr) {
    field_ty = expr_ty(target)
    if obj = target.object {
      object_ty = expr_ty(obj)
      self.emit_expr(value)
      self.emit_coerce(expr_ty(value), field_ty)
      val = self.new_temp
      m = ty_myc(field_ty)
      self.line("LOCAL :${val} :${m}")
      self.line("STORE")
      // A local object is already addressed. The barrier and the store
      // do not allocate, so the value does not need its own root and the
      // object does not need a second slot.
      if obj.kind == ex_name() {
        if self.may_share {
          self.ensure_root(val, field_ty)
          self.ensure_root(obj.ident, object_ty)
        }
        self.line("LOCAL :${obj.ident}")
        self.line("CALL :avant_barrier")
        self.line("LOCAL :${val}")
        self.line("LOCAL :${obj.ident}")
        self.line("DEREF")
        fi = object_ty.field_index(target.ident)
        self.line("FIELD ${fi}")
        self.line("STORE")
      } else {
        self.ensure_root(val, field_ty)
        self.emit_expr(obj)
        objn = self.new_temp
        om = ty_myc(object_ty)
        self.line("LOCAL :${objn} :${om}")
        self.line("STORE")
        self.ensure_root(objn, object_ty)
        self.line("LOCAL :${objn}")
        self.line("CALL :avant_barrier")
        self.line("LOCAL :${val}")
        self.line("LOCAL :${objn}")
        self.line("DEREF")
        fi = object_ty.field_index(target.ident)
        self.line("FIELD ${fi}")
        self.line("STORE")
      }
    }
  }

  pub fn root_after_store(target: Expr) {
    if target.kind == ex_name() {
      if target.implicit_field {
        return
      }
      self.ensure_root(target.ident, expr_ty(target))
    }
  }

  pub fn emit_coerce(got: Ty, want: Ty) {
    if got.same_as(want) {
      return
    }
    if want.is_union {
      if want.includes_member(got) {
        self.emit_wrap_union(got, want)
      }
    }
  }

  pub fn emit_wrap_union(got: Ty, want: Ty) {
    val = self.new_temp
    gm = ty_myc(got)
    self.line("LOCAL :${val} :${gm}")
    self.line("STORE")
    self.ensure_root(val, got)
    payloads = want.payload_members
    i = payloads.size - 1
    while i >= 0 {
      m = payloads[i]
      if m.same_as(got) {
        self.line("LOCAL :${val}")
      } else {
        self.emit_zero(m)
      }
      i = i - 1
    }
    tag = want.tag_of(got)
    self.line("PUSH ${tag}")
    layout = ty_layout_myc(want)
    self.line("CREATE :${layout}")
  }

  pub fn try_success_from(got: Ty): Ty {
    if got.includes_nil {
      return ty_without_nil(got)
    }
    ret = self.return_type
    i = 0
    while i < got.members.size {
      m = got.members[i]
      if ret.includes_member(m) {
      } else {
        return m
      }
      i = i + 1
    }
    ty_without_nil(got)
  }

  pub fn try_fail_from(got: Ty): Ty {
    if got.includes_nil {
      return ty_nil()
    }
    ret = self.return_type
    i = 0
    while i < got.members.size {
      m = got.members[i]
      if ret.includes_member(m) {
        return m
      }
      i = i + 1
    }
    ty_nil()
  }

  pub fn emit_unwrap(tmp: String, uty: Ty, success: Ty) {
    if success.is_nil {
      self.line("PUSH 0")
      return
    }
    idx = uty.payload_index(success)
    self.line("LOCAL :${tmp}")
    self.line("FIELD ${idx}")
  }

  pub fn emit_failure_return(tmp: String, got: Ty, fail: Ty) {
    if self.return_type.same_as(got) {
      self.line("LOCAL :${tmp}")
    } else {
      if fail.is_nil {
        self.emit_zero(fail)
        self.emit_wrap_union(fail, self.return_type)
      } else {
        self.emit_unwrap(tmp, got, fail)
        self.emit_wrap_union(fail, self.return_type)
      }
    }
    self.emit_ret
  }

  pub fn emit_coalesce(left: Expr, right: Expr, result: Ty) {
    uty = expr_ty(left)
    self.emit_expr(left)
    tmp = self.new_temp
    um = ty_myc(uty)
    self.line("LOCAL :${tmp} :${um}")
    self.line("STORE")
    self.ensure_root(tmp, uty)
    dest = self.new_temp
    rm = ty_myc(result)
    nil_tag = uty.tag_of(ty_nil())
    self.line("LOCAL :${tmp}")
    self.line("FIELD 0")
    self.line("PUSH ${nil_tag}")
    self.line("BINARY :eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    right_ty = expr_ty(right)
    if right_ty.is_nil {
      self.emit_zero(ty_nil())
      self.emit_wrap_union(ty_nil(), result)
    } else if right_ty.same_as(result) {
      self.emit_expr(right)
    } else if result.is_union {
      self.emit_expr(right)
      self.emit_wrap_union(right_ty, result)
    } else {
      self.emit_expr(right)
    }
    self.line("LOCAL :${dest} :${rm}")
    self.line("STORE")
    self.ensure_root(dest, result)
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    if result.same_as(uty) {
      self.line("LOCAL :${tmp}")
    } else {
      self.emit_unwrap(tmp, uty, ty_without_nil(uty))
    }
    self.line("LOCAL :${dest} :${rm}")
    self.line("STORE")
    self.ensure_root(dest, result)
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.line("LOCAL :${dest}")
  }

  pub fn emit_try(expr: Expr) {
    if inner = expr.inner {
      uty = expr_ty(inner)
      self.emit_expr(inner)
      tmp = self.new_temp
      um = ty_myc(uty)
      self.line("LOCAL :${tmp} :${um}")
      self.line("STORE")
      self.ensure_root(tmp, uty)
      success = self.try_success_from(uty)
      fail = self.try_fail_from(uty)
      fail_tag = uty.tag_of(fail)
      wrapped = self.new_temp
      self.line("LOCAL :${tmp}")
      self.line("FIELD 0")
      self.line("PUSH ${fail_tag}")
      self.line("BINARY :eq")
      self.line("IF")
      self.indent = self.indent + 1
      self.line("THEN")
      self.indent = self.indent + 1
      self.emit_failure_return(tmp, uty, fail)
      self.indent = self.indent - 1
      self.line("ELSE")
      self.indent = self.indent + 1
      self.emit_unwrap(tmp, uty, success)
      sm = ty_myc(success)
      self.line("LOCAL :${wrapped} :${sm}")
      self.line("STORE")
      self.ensure_root(wrapped, success)
      self.indent = self.indent - 1
      self.indent = self.indent - 1
      self.line("ENDIF")
      self.line("LOCAL :${wrapped}")
    }
  }

  pub fn emit_if_assign(stmt: Stmt) {
    if cond = stmt.cond {
      uty = expr_ty(cond)
      success = ty_without_nil(uty)
      self.emit_expr(cond)
      tmp = self.new_temp
      um = ty_myc(uty)
      self.line("LOCAL :${tmp} :${um}")
      self.line("STORE")
      self.ensure_root(tmp, uty)
      nil_tag = uty.tag_of(ty_nil())
      self.line("LOCAL :${tmp}")
      self.line("FIELD 0")
      self.line("PUSH ${nil_tag}")
      self.line("BINARY :not_eq")
      self.line("IF")
      self.indent = self.indent + 1
      self.line("THEN")
      self.indent = self.indent + 1
      self.cov_branch(stmt.loc)
      self.emit_unwrap(tmp, uty, success)
      bind = stmt.bind
      sm = ty_myc(success)
      self.line("LOCAL :${bind} :${sm}")
      self.line("STORE")
      self.ensure_root(bind, success)
      self.emit_stmts(stmt.then_body, false)
      self.indent = self.indent - 1
      if stmt.else_body.size > 0 {
        self.line("ELSE")
        self.indent = self.indent + 1
        self.cov_branch(stmt.loc)
        self.emit_stmts(stmt.else_body, false)
        self.indent = self.indent - 1
      } else {
        if self.cov {
          self.line("ELSE")
          self.indent = self.indent + 1
          self.cov_branch(stmt.loc)
          self.indent = self.indent - 1
        }
      }
      self.indent = self.indent - 1
      self.line("ENDIF")
    }
  }

  pub fn emit_to_string(ty: Ty) {
    if ty.is_string {
      return
    }
    if ty.is_int {
      self.line("CALL :avant_str_from_int")
      return
    }
    if ty.is_int64 {
      self.line("CALL :avant_str_from_i64")
      return
    }
    if ty.is_uint64 {
      self.line("CALL :avant_str_from_u64")
      return
    }
    if ty.is_float {
      self.line("CALL :avant_str_from_float")
      return
    }
    if ty.is_bool {
      self.line("AS :i32")
      self.line("CALL :avant_str_from_bool")
    }
  }

  pub fn emit_interp(expr: Expr) {
    if expr.parts.size == 2 {
      head = expr.parts[0]
      tail = expr.parts[1]
      if text = head.text {
        if inner = tail.expr {
          if expr_ty(inner).is_int {
            self.emit_expr(inner)
            ntmp = self.new_temp
            self.line("LOCAL :${ntmp} :i32")
            self.line("STORE")
            self.line("LOCAL :${ntmp}")
            q = myc_quote(text)
            self.line("PUSH ${q}")
            self.line("CALL :avant_str_cat_i32")
            return
          }
        }
      }
    }
    pieces: Array(String) = []
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      skip = true
      if text = part.text {
        if text.size == 0 {
        } else {
          q = myc_quote(text)
          self.line("PUSH ${q}")
          skip = false
        }
      } else {
        if inner = part.expr {
          self.emit_expr(inner)
          self.emit_to_string(expr_ty(inner))
          skip = false
        }
      }
      if skip {
      } else {
        tmp = self.new_temp
        self.line("LOCAL :${tmp} :ptr<u8>")
        self.line("STORE")
        self.ensure_root(tmp, ty_string())
        pieces.push(tmp)
      }
      i = i + 1
    }
    if pieces.size == 0 {
      self.line("PUSH \"\"")
      return
    }
    acc = pieces[0]
    i = 1
    while i < pieces.size {
      p = pieces[i]
      self.line("LOCAL :${p}")
      self.line("LOCAL :${acc}")
      self.line("CALL :avant_str_concat")
      acc = self.new_temp
      self.line("LOCAL :${acc} :ptr<u8>")
      self.line("STORE")
      self.ensure_root(acc, ty_string())
      i = i + 1
    }
    self.line("LOCAL :${acc}")
  }

  pub fn emit_expr(expr: Expr) {
    k = expr.kind
    switch k {
      case 1 {
        self.emit_int_literal(expr)
      }
      case 2 {
        if expr.value_str.size > 0 {
          lit = myc_float_literal(expr.value_str)
          self.line("PUSH ${lit}")
        } else {
          self.line("PUSH 0.0")
        }
      }
      case 3 {
        q = myc_quote(expr.value_str)
        self.line("PUSH ${q}")
      }
      case 4 {
        if expr.bool_val {
          self.line("PUSH true")
        } else {
          self.line("PUSH false")
        }
      }
      case 15 {
        self.line("PUSH 0")
      }
      case 5 {
        if expr.fn_ref {
          self.emit_fn_ref(expr)
        } else {
          self.emit_lvalue(expr)
        }
      }
      case 20 {
        self.emit_lambda(expr)
      }
      case 9 {
        if expr.method_call {
          if obj = expr.object {
            object_ty = expr_ty(obj)
            if object_ty.is_join {
              self.emit_expr(obj)
              self.line("CALL :avant_join")
            } else if object_ty.is_array {
              if str_eq(expr.ident, "pop") {
                self.emit_array_pop(obj, object_ty)
              } else if str_eq(expr.ident, "sort") {
                self.emit_expr(obj)
                we_arr = self.new_temp
                m = ty_myc(object_ty)
                self.line("LOCAL :${we_arr} :${m}")
                self.line("STORE")
                self.ensure_root(we_arr, object_ty)
                self.emit_runtime_sort(we_arr, object_ty)
              } else if str_eq(expr.ident, "sorted") {
                we_cp = self.emit_array_copy_to(obj, object_ty)
                self.emit_runtime_sort(we_cp, object_ty)
                self.line("LOCAL :${we_cp}")
              } else if str_eq(expr.ident, "reverse") {
                self.emit_expr(obj)
                we_arr = self.new_temp
                m = ty_myc(object_ty)
                self.line("LOCAL :${we_arr} :${m}")
                self.line("STORE")
                self.ensure_root(we_arr, object_ty)
                if we_e = object_ty.inner {
                  em = ty_myc(we_e)
                  self.line("SIZEOF :${em}")
                  self.line("AS :u64")
                }
                self.line("LOCAL :${we_arr}")
                self.line("CALL :avant_array_reverse")
              } else if str_eq(expr.ident, "min") {
                self.emit_field_minmax(obj, object_ty, true)
              } else if str_eq(expr.ident, "max") {
                self.emit_field_minmax(obj, object_ty, false)
              } else if str_eq(expr.ident, "sum") {
                self.emit_expr(obj)
                if we_e2 = object_ty.inner {
                  fn_name = self.array_sum_func(we_e2)
                  self.line("CALL :${fn_name}")
                }
              } else if str_eq(expr.ident, "clear") {
                self.emit_array_clear(obj, object_ty)
              }
            } else if object_ty.is_float {
              self.emit_float_field(expr)
            } else if object_ty.is_integer {
              self.emit_int_field(expr)
            } else if object_ty.is_string {
              self.emit_expr(obj)
              if str_eq(expr.ident, "to_f") {
                self.line("CALL :avant_str_to_f")
              } else if str_eq(expr.ident, "to_i") {
                self.line("CALL :avant_str_to_i")
              } else if str_eq(expr.ident, "bytes") {
              } else if str_eq(expr.ident, "chars") {
                self.line("CALL :avant_str_chars")
                m = ty_myc(expr_ty(expr))
                self.line("AS :${m}")
              }
            } else if object_ty.is_bytes {
              self.emit_expr(obj)
              if str_eq(expr.ident, "to_buf") {
                self.line("CALL :avant_bytes_to_buf")
              } else if str_eq(expr.ident, "chars") {
                self.line("CALL :avant_bytes_chars")
                m = ty_myc(expr_ty(expr))
                self.line("AS :${m}")
              }
            } else if object_ty.is_buf {
              self.emit_expr(obj)
              if str_eq(expr.ident, "to_s") {
                self.line("CALL :avant_buf_to_str")
              } else if str_eq(expr.ident, "to_bytes") {
                self.line("CALL :avant_buf_to_str")
              } else if str_eq(expr.ident, "clear") {
                self.line("CALL :avant_buf_clear")
              }
            } else if object_ty.is_hash {
              if str_eq(expr.ident, "keys") || str_eq(expr.ident, "values") {
                is_keys = str_eq(expr.ident, "keys")
                self.emit_expr(obj)
                fn_name = "avant_hash_keys_str"
                if is_keys {
                  if we_hk = object_ty.key {
                    if we_hk.is_int {
                      fn_name = "avant_hash_keys_i32"
                    }
                  }
                } else {
                  if we_hv = object_ty.val {
                    if we_hv.is_string {
                      fn_name = "avant_hash_vals_str"
                    } else {
                      fn_name = "avant_hash_vals_i32"
                    }
                  }
                }
                self.line("CALL :${fn_name}")
                m = ty_myc(expr_ty(expr))
                self.line("AS :${m}")
              } else {
                self.emit_expr(obj)
                if str_eq(expr.ident, "clear") {
                  self.line("CALL :avant_hash_clear")
                } else if str_eq(expr.ident, "size") {
                  self.line("CALL :avant_hash_size")
                }
              }
            } else {
              empty: Array(Expr) = []
              name = expr.resolved
              if name.size == 0 {
                name = "${object_ty.name}__${emit_op_name(expr.ident)}"
              }
              self.emit_method_invoke(obj, name, empty)
            }
          }
        } else {
          if obj = expr.object {
            object_ty = expr_ty(obj)
            if object_ty.is_string {
              if str_eq(expr.ident, "size") {
                self.emit_expr(obj)
                self.line("CALL :avant_str_size")
              } else if str_eq(expr.ident, "bytes") {
                self.emit_expr(obj)
              } else if str_eq(expr.ident, "chars") {
                self.emit_expr(obj)
                self.line("CALL :avant_str_chars")
                m = ty_myc(expr_ty(expr))
                self.line("AS :${m}")
              } else if str_eq(expr.ident, "to_f") {
                self.emit_expr(obj)
                self.line("CALL :avant_str_to_f")
              } else if str_eq(expr.ident, "to_i") {
                self.emit_expr(obj)
                self.line("CALL :avant_str_to_i")
              } else {
                self.emit_lvalue(expr)
              }
            } else if object_ty.is_bytes {
              if str_eq(expr.ident, "size") {
                self.emit_expr(obj)
                self.line("CALL :avant_str_size")
              } else if str_eq(expr.ident, "chars") {
                self.emit_expr(obj)
                self.line("CALL :avant_bytes_chars")
                m = ty_myc(expr_ty(expr))
                self.line("AS :${m}")
              } else {
                self.emit_lvalue(expr)
              }
            } else if object_ty.is_hash {
              if str_eq(expr.ident, "size") {
                self.emit_expr(obj)
                self.line("CALL :avant_hash_size")
              } else if str_eq(expr.ident, "clear") {
                self.emit_expr(obj)
                self.line("CALL :avant_hash_clear")
              } else {
                self.emit_lvalue(expr)
              }
            } else if object_ty.is_buf {
              if str_eq(expr.ident, "size") {
                self.emit_expr(obj)
                self.line("CALL :avant_buf_size")
              } else {
                self.emit_lvalue(expr)
              }
            } else {
              self.emit_lvalue(expr)
            }
          } else {
            self.emit_lvalue(expr)
          }
        }
      }
      case 10 {
        self.emit_lvalue(expr)
        if l = expr.left {
          if expr_ty(l).is_buf {
            self.line("TO :i32")
          }
        }
      }
      case 7 {
        self.emit_unary(expr)
      }
      case 8 {
        self.emit_binary(expr)
      }
      case 6 {
        self.emit_call(expr)
      }
      case 11 {
        self.emit_struct_literal(expr)
      }
      case 12 {
        self.emit_array_literal(expr)
      }
      case 13 {
        self.emit_array_new(expr)
      }
      case 14 {
        self.emit_hash_new(expr)
      }
      case 18 {
        self.emit_switch(expr)
      }
      case 16 {
        self.emit_try(expr)
      }
      case 17 {
        self.emit_interp(expr)
      }
      else {
      }
    }
  }

  pub fn emit_lvalue(expr: Expr) {
    if expr.kind == ex_name() {
      if self.place_name.size > 0 {
        if str_eq(expr.ident, self.place_name) {
          self.line("LOCAL :${self.place_holder}")
          self.line("DEREF")
          self.line("FIELD ${self.place_field}")
          return
        }
      }
      if expr.implicit_field {
        self.emit_self_field(expr.ident)
        return
      }
      ci = self.cap_index(expr.ident)
      if ci >= 0 {
        self.emit_cap_lvalue(ci)
        return
      }
      if self.name_is_boxed(expr.ident) {
        self.emit_box_lvalue(expr.ident, expr_ty(expr))
        return
      }
      if self.is_struct_self(expr.ident) {
        if st = self.self_ty {
          m = ty_self_ptr_myc(st)
          self.line("LOCAL :${expr.ident} :${m}")
          self.line("DEREF")
          return
        }
      }
      ty = expr_ty(expr)
      m = ty_myc(ty)
      self.line("LOCAL :${expr.ident} :${m}")
      return
    }
    if expr.kind == ex_field() {
      self.emit_field_lvalue(expr)
      return
    }
    if expr.kind == ex_index() {
      self.emit_index_lvalue(expr)
      return
    }
    self.emit_expr(expr)
  }

  pub fn emit_field_lvalue(expr: Expr) {
    if obj = expr.object {
      object_ty = expr_ty(obj)
      if object_ty.is_array {
        self.emit_expr(obj)
        self.line("DEREF")
        self.line("FIELD 1")
        return
      }
      if object_ty.is_class {
        self.emit_expr(obj)
        self.line("DEREF")
        fi = object_ty.field_index(expr.ident)
        self.line("FIELD ${fi}")
        return
      }
      if object_ty.is_ptr {
        if inner = object_ty.inner {
          if inner.is_clayout {
            self.emit_expr(obj)
            self.line("DEREF")
            fi = inner.field_index(expr.ident)
            self.line("FIELD ${fi}")
            return
          }
        }
      }
      self.emit_lvalue(obj)
      fi = object_ty.field_index(expr.ident)
      self.line("FIELD ${fi}")
    }
  }

  // A pointer local is a volatile GC slot, so an index reloads the array
  // and its buffer every iteration. Across a loop that cannot collect,
  // a scalar buffer is kept in an i64, which is not a GC slot. The
  // single-mutator path uses that i64. The buffer slot is rooted once
  // before the loop. A second thread reloads that slot. The shared flag
  // load is volatile in myc-llvm, so the check stays in the loop.

  pub fn emit_struct_literal(expr: Expr) {
    ty = expr_ty(expr)
    n = ty.fields.size
    slots: Array(String) = []
    i = 0
    while i < n {
      slots.push("")
      i = i + 1
    }
    i = 0
    while i < expr.field_names.size {
      fname = expr.field_names[i]
      value = expr.field_exprs[i]
      fi = ty.field_index(fname)
      self.emit_expr(value)
      tmp = self.new_temp
      m = ty_myc(ty.fields[fi].ty)
      self.line("LOCAL :${tmp} :${m}")
      self.line("STORE")
      slots[fi] = tmp
      i = i + 1
    }
    i = n - 1
    while i >= 0 {
      slot = slots[i]
      self.line("LOCAL :${slot}")
      i = i - 1
    }
    m = ty_myc(ty)
    self.line("CREATE :${m}")
  }

  pub fn emit_alloc_sizeof(layout: String, type_id: Int) {
    self.line("PUSH ${type_id} :u32")
    self.line("SIZEOF :${layout}")
    self.line("CALL :avant_alloc")
  }

  pub fn emit_alloc_count(elem: Ty) {
    self.line("AS :u64")
    em = ty_myc(elem)
    self.line("SIZEOF :${em}")
    self.line("BINARY :mul")
    tid = array_type_id(elem)
    self.line("PUSH ${tid} :u32")
    self.line("STACK :swap2")
    self.line("CALL :avant_alloc")
    self.line("AS :ptr<${em}>")
  }

  pub fn null_slot(name: String, myc: String) {
    self.line("PUSH 0")
    self.line("AS :${myc}")
    self.line("LOCAL :${name} :${myc}")
    self.line("STORE")
  }

  pub fn emit_array_header(ty: Ty, buf: String, size: String, cap: String) {
    m = ty_myc(ty)
    arr = self.new_temp
    self.null_slot(arr, m)
    self.emit_array_header_at(ty, buf, size, cap, arr)
  }

  pub fn emit_array_header_at(ty: Ty, buf: String, size: String, cap: String, arr: String) {
    m = ty_myc(ty)
    layout = ty_layout_myc(ty)
    self.null_slot(arr, m)
    self.emit_alloc_sizeof(layout, 1022)
    self.line("AS :${m}")
    self.line("LOCAL :${arr} :${m}")
    self.line("STORE")
    self.ensure_root(arr, ty)
    self.line("LOCAL :${buf}")
    self.line("LOCAL :${arr}")
    self.line("DEREF")
    self.line("FIELD 0")
    self.line("STORE")
    self.line("LOCAL :${size}")
    self.line("LOCAL :${arr}")
    self.line("DEREF")
    self.line("FIELD 1")
    self.line("STORE")
    self.line("LOCAL :${cap}")
    self.line("LOCAL :${arr}")
    self.line("DEREF")
    self.line("FIELD 2")
    self.line("STORE")
    self.line("LOCAL :${arr}")
    self.line("CALL :avant_barrier")
    self.line("LOCAL :${arr}")
  }

  pub fn emit_array_literal(expr: Expr) {
    ty = expr_ty(expr)
    n = expr.elems.size
    ptr_tmp = self.new_temp
    self.line("PUSH ${n}")
    if e = ty.inner {
      self.emit_alloc_count(e)
      em = ty_myc(e)
      self.line("LOCAL :${ptr_tmp} :ptr<${em}>")
    } else {
      self.emit_alloc_count(ty_int())
      self.line("LOCAL :${ptr_tmp} :ptr<i32>")
    }
    self.line("STORE")
    self.emit_ptr_root(ptr_tmp)
    i = 0
    while i < expr.elems.size {
      el = expr.elems[i]
      self.emit_expr(el)
      if e = ty.inner {
        self.emit_coerce(expr_ty(el), e)
      }
      self.line("PUSH ${i}")
      self.line("LOCAL :${ptr_tmp}")
      self.line("BINARY :add")
      self.line("DEREF")
      self.line("STORE")
      i = i + 1
    }
    n_tmp = self.new_temp
    self.line("PUSH ${n}")
    self.line("LOCAL :${n_tmp} :i32")
    self.line("STORE")
    self.emit_array_header(ty, ptr_tmp, n_tmp, n_tmp)
  }

  pub fn emit_array_new(expr: Expr) {
    ty = expr_ty(expr)
    len_tmp = self.new_temp
    ptr_tmp = self.new_temp
    if size = expr.size_expr {
      self.emit_expr(size)
    }
    self.line("LOCAL :${len_tmp} :i32")
    self.line("STORE")
    em = "i32"
    if e = ty.inner {
      em = ty_myc(e)
    }
    arr = self.new_temp
    m = ty_myc(ty)
    // Both slots are roots for the whole loop. Clear them before the
    // buffer allocation, or the previous array is marked and promoted.
    self.null_slot(ptr_tmp, "ptr<${em}>")
    self.null_slot(arr, m)
    self.line("LOCAL :${len_tmp}")
    if e = ty.inner {
      self.emit_alloc_count(e)
      self.line("LOCAL :${ptr_tmp} :ptr<${em}>")
    } else {
      self.emit_alloc_count(ty_int())
      self.line("LOCAL :${ptr_tmp} :ptr<i32>")
    }
    self.line("STORE")
    self.emit_ptr_root(ptr_tmp)
    if e = ty.inner {
      self.note_loop_temp(ptr_tmp, "ptr<${ty_myc(e)}>")
    } else {
      self.note_loop_temp(ptr_tmp, "ptr<i32>")
    }
    self.emit_array_header_at(ty, ptr_tmp, len_tmp, len_tmp, arr)
  }

  pub fn emit_switch(expr: Expr) {
    result_ty = expr_ty(expr)
    if c = expr.cond {
      self.emit_expr(c)
      ct = expr_ty(c)
      if ct.is_bool {
        self.line("AS :i32")
      }
    }
    has_dest = false
    dest = ""
    if result_ty.is_void {
    } else {
      has_dest = true
      dest = self.new_temp
    }
    self.line("SWITCH")
    self.indent = self.indent + 1
    i = 0
    while i < expr.cases.size {
      arm = expr.cases[i]
      j = 0
      while j < arm.labels.size {
        lab = arm.labels[j]
        self.line("CASE ${lab}")
        self.indent = self.indent + 1
        self.cov_branch(arm.loc)
        self.emit_switch_arm(arm.body, has_dest, dest, result_ty)
        self.indent = self.indent - 1
        j = j + 1
      }
      i = i + 1
    }
    if expr.has_else {
      self.line("ELSE")
      self.indent = self.indent + 1
      self.cov_branch(expr.loc)
      self.emit_switch_arm(expr.else_body, has_dest, dest, result_ty)
      self.indent = self.indent - 1
    } else {
      if self.cov {
        self.line("ELSE")
        self.indent = self.indent + 1
        self.cov_branch(expr.loc)
        self.indent = self.indent - 1
      }
    }
    self.indent = self.indent - 1
    self.line("ENDSWITCH")
    if has_dest {
      self.line("LOCAL :${dest}")
    }
  }

  pub fn emit_switch_arm(body: Array(Stmt), has_dest: Bool, dest: String, result_ty: Ty) {
    if has_dest {
      if body.size == 0 {
        self.emit_zero(result_ty)
        m = ty_myc(result_ty)
        self.line("LOCAL :${dest} :${m}")
        self.line("STORE")
        self.ensure_root(dest, result_ty)
        return
      }
      last = body.size - 1
      i = 0
      while i < body.size {
        stmt = body[i]
        if i == last {
          if stmt.kind == st_expr() {
            if e = stmt.expr {
              self.emit_expr(e)
              self.emit_coerce(expr_ty(e), result_ty)
              m = ty_myc(result_ty)
              self.line("LOCAL :${dest} :${m}")
              self.line("STORE")
              self.ensure_root(dest, result_ty)
            }
          } else {
            self.emit_stmt(stmt, false)
          }
        } else {
          self.emit_stmt(stmt, false)
        }
        i = i + 1
      }
    } else {
      self.emit_stmts(body, false)
    }
  }

  pub fn emit_zero(ty: Ty) {
    if ty.is_fn {
      code = fn_code_myc(ty)
      layout = fn_layout_name(ty)
      self.line("PUSH 0")
      self.line("AS \"${code}\"")
      self.line("PUSH 0")
      self.line("AS :ptr<void>")
      self.line("CREATE :${layout}")
      return
    }
    if ty.is_float {
      self.line("PUSH 0 :f64")
      return
    }
    if ty.is_int64 {
      self.line("PUSH 0 :i64")
      return
    }
    if ty.is_uint64 {
      self.line("PUSH 0 :u64")
      return
    }
    if ty.is_bool {
      self.line("PUSH false")
      return
    }
    self.line("PUSH 0")
    if ty.is_int {
      return
    }
    if ty.is_nil {
      return
    }
    m = ty_myc(ty)
    self.line("AS :${m}")
  }

  pub fn emit_int_literal(expr: Expr) {
    ty = expr_ty(expr)
    if ty.is_float {
      self.line("PUSH ${expr.int_bits} :f64")
    } else if ty.is_uint64 {
      self.line("PUSH ${expr.int_bits} :u64")
    } else if ty.is_int64 {
      self.line("PUSH ${expr.int_bits} :i64")
    } else {
      self.line("PUSH ${expr.int_bits}")
    }
  }

  pub fn emit_unary(expr: Expr) {
    if inner = expr.inner {
      self.emit_expr(inner)
    }
    op = expr.op
    if op == tk_minus() {
      if inner = expr.inner {
        ity = expr_ty(inner)
        if ity.is_int || ity.is_int64 {
          m = ty_myc(ity)
          vt = self.new_temp
          self.line("LOCAL :${vt} :${m}")
          self.line("STORE")
          self.line("LOCAL :${vt}")
          self.line("AS :i64")
          if ity.is_int {
            self.line("PUSH 1 :i64")
            self.line("PUSH -2147483647 :i64")
            self.line("BINARY :sub")
          } else {
            self.line("PUSH 9223372036854775807 :i64")
            self.line("UNARY :neg")
            self.line("PUSH 1 :i64")
            self.line("BINARY :sub")
          }
          self.line("BINARY :eq")
          self.line("IF")
          self.indent = self.indent + 1
          self.line("THEN")
          self.indent = self.indent + 1
          self.emit_trap_overflow
          self.indent = self.indent - 1
          self.indent = self.indent - 1
          self.line("ENDIF")
          self.line("LOCAL :${vt}")
        }
      }
      self.line("UNARY :neg")
    } else if op == tk_bang() {
      self.line("UNARY :lnot")
    } else if op == tk_tilde() {
      self.line("UNARY :bnot")
    }
  }

  pub fn emit_trap_overflow {
    self.line("CALL :avant_trap_overflow")
  }

  pub fn emit_checked_binary(op: Int, ty: Ty, proven: Bool) {
    if proven {
      plain0 = myc_binop(op)
      if op == tk_greater_greater() {
        if ty.is_uint64 {
          plain0 = "shr"
        }
      }
      if op == tk_amp_plus() {
        plain0 = "add"
      }
      if op == tk_amp_minus() {
        plain0 = "sub"
      }
      if op == tk_amp_star() {
        plain0 = "mul"
      }
      self.line("BINARY :${plain0}")
      return
    }
    plain = myc_binop(op)
    if op == tk_greater_greater() {
      if ty.is_uint64 {
        plain = "shr"
      }
    }
    wrap = false
    if op == tk_amp_plus() {
      wrap = true
      plain = "add"
    }
    if op == tk_amp_minus() {
      wrap = true
      plain = "sub"
    }
    if op == tk_amp_star() {
      wrap = true
      plain = "mul"
    }
    if wrap {
      self.line("BINARY :${plain}")
      return
    }
    arith = false
    if op == tk_plus() {
      arith = true
    }
    if op == tk_minus() {
      arith = true
    }
    if op == tk_star() {
      arith = true
    }
    is_div = false
    if op == tk_slash() {
      is_div = true
    }
    if op == tk_percent() {
      is_div = true
    }
    if ty.is_int {
      if arith || is_div {
        m = ty_myc(ty)
        lt = self.new_temp
        self.line("LOCAL :${lt} :${m}")
        self.line("STORE")
        rt = self.new_temp
        self.line("LOCAL :${rt} :${m}")
        self.line("STORE")
        if is_div {
          self.line("LOCAL :${rt}")
          self.line("PUSH 0")
          self.line("BINARY :eq")
          self.line("IF")
          self.indent = self.indent + 1
          self.line("THEN")
          self.indent = self.indent + 1
          self.line("CALL :avant_trap_div_zero")
          self.indent = self.indent - 1
          self.indent = self.indent - 1
          self.line("ENDIF")
          self.line("LOCAL :${lt}")
          self.line("AS :i64")
          self.line("PUSH 1 :i64")
          self.line("PUSH -2147483647 :i64")
          self.line("BINARY :sub")
          self.line("BINARY :eq")
          self.line("LOCAL :${rt}")
          self.line("PUSH -1")
          self.line("BINARY :eq")
          self.line("BINARY :and")
          self.line("IF")
          self.indent = self.indent + 1
          self.line("THEN")
          self.indent = self.indent + 1
          self.emit_trap_overflow
          self.indent = self.indent - 1
          self.indent = self.indent - 1
          self.line("ENDIF")
          self.line("LOCAL :${rt}")
          self.line("LOCAL :${lt}")
          self.line("BINARY :${plain}")
          return
        }
        self.line("LOCAL :${rt}")
        self.line("AS :i64")
        self.line("LOCAL :${lt}")
        self.line("AS :i64")
        self.line("BINARY :${plain}")
        wt = self.new_temp
        self.line("LOCAL :${wt} :i64")
        self.line("STORE")
        self.line("LOCAL :${wt}")
        self.line("AS :i32")
        self.line("AS :i64")
        self.line("LOCAL :${wt}")
        self.line("BINARY :not_eq")
        self.line("IF")
        self.indent = self.indent + 1
        self.line("THEN")
        self.indent = self.indent + 1
        self.emit_trap_overflow
        self.indent = self.indent - 1
        self.indent = self.indent - 1
        self.line("ENDIF")
        self.line("LOCAL :${wt}")
        self.line("AS :i32")
        return
      }
      self.line("BINARY :${plain}")
      return
    }
    if ty.is_int64 || ty.is_uint64 {
      if arith || is_div {
        m = ty_myc(ty)
        lt = self.new_temp
        self.line("LOCAL :${lt} :${m}")
        self.line("STORE")
        rt = self.new_temp
        self.line("LOCAL :${rt} :${m}")
        self.line("STORE")
        fn_name = ""
        if ty.is_int64 {
          if op == tk_plus() {
            fn_name = "avant_checked_add_i64"
          } else if op == tk_minus() {
            fn_name = "avant_checked_sub_i64"
          } else if op == tk_star() {
            fn_name = "avant_checked_mul_i64"
          } else if op == tk_slash() {
            fn_name = "avant_checked_div_i64"
          } else {
            fn_name = "avant_checked_rem_i64"
          }
        } else {
          if op == tk_plus() {
            fn_name = "avant_checked_add_u64"
          } else if op == tk_minus() {
            fn_name = "avant_checked_sub_u64"
          } else if op == tk_star() {
            fn_name = "avant_checked_mul_u64"
          } else if op == tk_slash() {
            fn_name = "avant_checked_div_u64"
          } else {
            fn_name = "avant_checked_rem_u64"
          }
        }
        self.line("LOCAL :${rt}")
        self.line("LOCAL :${lt}")
        self.line("CALL :${fn_name}")
        return
      }
      self.line("BINARY :${plain}")
      return
    }
    self.line("BINARY :${plain}")
  }

  pub fn emit_binary(expr: Expr) {
    if expr.resolved.size > 0 {
      if l = expr.left {
        if r = expr.right {
          args: Array(Expr) = []
          args.push(r)
          self.emit_method_invoke(l, expr.resolved, args)
          return
        }
      }
    }
    if expr.op == tk_question_question() {
      if l = expr.left {
        if r = expr.right {
          self.emit_coalesce(l, r, expr_ty(expr))
        }
      }
      return
    }
    if expr.op == tk_amp_amp() {
      self.emit_logical(expr)
      return
    }
    if expr.op == tk_pipe_pipe() {
      self.emit_logical(expr)
      return
    }
    if l = expr.left {
      left_ty = expr_ty(l)
      if left_ty.is_string {
        self.emit_string_binary(expr)
        return
      }
      if left_ty.is_bytes {
        self.emit_string_binary(expr)
        return
      }
      tmp = self.new_temp
      self.emit_expr(l)
      m = ty_myc(left_ty)
      self.line("LOCAL :${tmp} :${m}")
      self.line("STORE")
      if r = expr.right {
        self.emit_expr(r)
        right_ty = expr_ty(r)
        if left_ty.is_uint64 {
          if right_ty.is_int {
            if expr.op == tk_less_less() {
              self.line("AS :${m}")
            } else if expr.op == tk_greater_greater() {
              self.line("AS :${m}")
            }
          }
        } else if left_ty.is_int64 {
          if right_ty.is_int {
            if expr.op == tk_less_less() {
              self.line("AS :${m}")
            } else if expr.op == tk_greater_greater() {
              self.line("AS :${m}")
            }
          }
        }
      }
      self.line("LOCAL :${tmp}")
      self.emit_checked_binary(expr.op, left_ty, expr.proven)
    }
  }

  pub fn emit_logical(expr: Expr) {
    dest = self.new_temp
    if l = expr.left {
      self.emit_expr(l)
    }
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.cov_branch(expr.loc)
    if expr.op == tk_amp_amp() {
      if r = expr.right {
        self.emit_expr(r)
      }
    } else {
      self.line("PUSH true")
    }
    self.line("LOCAL :${dest} :bool")
    self.line("STORE")
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    self.cov_branch(expr.loc)
    if expr.op == tk_amp_amp() {
      self.line("PUSH false")
    } else {
      if r = expr.right {
        self.emit_expr(r)
      }
    }
    self.line("LOCAL :${dest} :bool")
    self.line("STORE")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.line("LOCAL :${dest}")
  }

  pub fn emit_string_binary(expr: Expr) {
    if l = expr.left {
      if r = expr.right {
        if expr.op == tk_plus() {
          self.emit_expr(l)
          a = self.new_temp
          self.line("LOCAL :${a} :ptr<u8>")
          self.line("STORE")
          self.ensure_root(a, ty_string())
          self.emit_expr(r)
          self.line("LOCAL :${a}")
          self.line("CALL :avant_str_concat")
          return
        }
        if expr.op == tk_eq_eq() {
          self.emit_expr(l)
          a = self.new_temp
          self.line("LOCAL :${a} :ptr<u8>")
          self.line("STORE")
          self.emit_expr(r)
          self.line("LOCAL :${a}")
          self.line("CALL :avant_str_eq")
          self.line("PUSH 1")
          self.line("BINARY :eq")
          return
        }
        if expr.op == tk_not_eq() {
          self.emit_expr(l)
          a = self.new_temp
          self.line("LOCAL :${a} :ptr<u8>")
          self.line("STORE")
          self.emit_expr(r)
          self.line("LOCAL :${a}")
          self.line("CALL :avant_str_eq")
          self.line("PUSH 0")
          self.line("BINARY :eq")
        }
      }
    }
  }
}

pub fn emit_myc(program: Program): String {
  gen = MycGen.new(program)
  gen.emit
}

pub fn emit_myc(program: Program, symbols: SymbolTable): String {
  gen = MycGen.new(program)
  gen.symbols = symbols
  gen.emit
}
