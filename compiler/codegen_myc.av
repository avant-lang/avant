    self.ext("avant_str_fmt_float", "f64,i32", "ptr<u8>")
    self.ext("avant_str_eq", "ptr<u8>,ptr<u8>", "i32")
    self.ext("avant_str_size", "ptr<u8>", "i32")
    self.ext("avant_str_byte", "ptr<u8>,i32", "i32")
    self.ext("avant_str_to_f", "ptr<u8>", "f64")
