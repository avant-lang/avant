    self.ext("avant_json_parse", "ptr<u8>", "ptr<void>")
    self.ext("avant_json_free", "ptr<void>", "")
    self.ext("avant_json_gen_body", "i32", "ptr<u8>")
    self.ext("avant_json_gen_into", "ptr<void>,i32", "")
