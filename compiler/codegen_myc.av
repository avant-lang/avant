  pub fn emit_lib_decls {
    i = 0
    while i < self.program.libs.size {
      lib_def = self.program.libs[i]
      j = 0
      while j < lib_def.funs.size {
        self.emit_lib_fun(lib_def.funs[j])
        j = j + 1
      }
      i = i + 1
    }
  }

  pub fn emit_lib_fun(fnn: FunDecl) {
    params: Array(Ty) = []
    i = 0
    while i < fnn.params.size {
      params.push(self.resolver.resolve_value(fnn.params[i].type))
      i = i + 1
    }
    ret = ty_void()
    if t = fnn.return_type {
      ret = self.resolver.resolve(t)
    }
    self.line("FUNC :${fnn.name}")
    self.indent = self.indent + 1
    if ret.is_void {
    } else {
      self.line("RETURN")
      self.indent = self.indent + 1
      m = ty_myc(ret)
      self.line("TYPE :${m}")
      self.indent = self.indent - 1
    }
    if params.size > 0 {
      self.line("ARGS")
      self.indent = self.indent + 1
      i = 0
      while i < params.size {
        m = ty_myc(params[i])
        self.line("TYPE :${m}")
        i = i + 1
      }
      self.indent = self.indent - 1
    }
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
  }

  pub fn collect_sigs {
    i = 0
    while i < self.program.functions.size {
      fnn = self.program.functions[i]
      if fn_is_method(fnn) {
      } else {
        if fnn.generic {
        } else {
          params: Array(Ty) = []
          j = 0
          while j < fnn.params.size {
            params.push(self.resolver.resolve_value(fnn.params[j].type))
            j = j + 1
          }
          ret = ty_void()
          if t = fnn.return_type {
            ret = self.resolver.resolve(t)
          }
          sig = FuncSig.new(fnn.name, fnn, params, ret)
          self.functions.push(sig)
          self.fn_index[fnn.emit_name] = self.functions.size - 1
        }
      }
      i = i + 1
    }
  }

  pub fn collect_methods {
    fns = program_all_functions(self.program)
    i = 0
    while i < fns.size {
      fnn = fns[i]
      if fn_is_method(fnn) {
        if fnn.generic {
        } else if self.owner_is_template(fnn.owner) {
        } else {
          owner = fnn.owner
          if owner.size == 0 {
            if r = fnn.receiver {
              ty = self.resolver.resolve(r.type)
              owner = ty.name
              fnn.owner = owner
            }
          }
          params: Array(Ty) = []
          j = 0
          while j < fnn.params.size {
            params.push(self.resolver.resolve_value(fnn.params[j].type))
            j = j + 1
          }
          ret = ty_void()
          if t = fnn.return_type {
            ret = self.resolver.resolve(t)
          }
          sig = FuncSig.new(fnn.name, fnn, params, ret)
          sig.owner = owner
          self.methods.push(sig)
          self.method_index[fnn.emit_name] = self.methods.size - 1
        }
      }
      i = i + 1
    }
  }

  pub fn assign_class_ids {
    n = 1
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if cdef.type_params.size > 0 {
      } else {
        self.class_ids[cdef.name] = n
        n = n + 1
      }
      i = i + 1
    }
  }

  pub fn find_method(owner: String, name: String): FuncSig? {
    key = "${owner}__${name}"
    if id = self.method_index.get(key) {
      return self.methods[id]
    }
    nil
  }

  pub fn find_method_emit(emit: String): FuncSig? {
    if id = self.method_index.get(emit) {
      return self.methods[id]
    }
    nil
  }

  pub fn find_initialize(owner: String): FuncSig? {
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      if str_eq(sig.owner, owner) {
        if str_eq(sig.name, "initialize") {
          return sig
        }
      }
      i = i + 1
    }
    nil
  }

  pub fn note_ty(ty: Ty) {
    if ty.is_fn {
      layout = fn_layout_name(ty)
      i = 0
      while i < self.fn_tys.size {
        if str_eq(fn_layout_name(self.fn_tys[i]), layout) {
          return
        }
        i = i + 1
      }
      self.fn_tys.push(ty)
      i = 0
      while i < ty.members.size {
        self.note_ty(ty.members[i])
        i = i + 1
      }
      if r = ty.inner {
        self.note_ty(r)
      }
      return
    }
    if ty.is_array {
      layout = ty_layout_myc(ty)
      i = 0
      while i < self.array_tys.size {
        if str_eq(ty_layout_myc(self.array_tys[i]), layout) {
          return
        }
        i = i + 1
      }
      self.array_tys.push(ty)
      if e = ty.inner {
        self.note_ty(e)
      }
      return
    }
    if ty.is_union {
      layout = ty_layout_myc(ty)
      seen = false
      i = 0
      while i < self.union_tys.size {
        if str_eq(ty_layout_myc(self.union_tys[i]), layout) {
          seen = true
        }
        i = i + 1
      }
      if seen {
      } else {
        self.union_tys.push(ty)
      }
      i = 0
      while i < ty.members.size {
        self.note_ty(ty.members[i])
        i = i + 1
      }
    }
  }

  pub fn collect_arrays {
    i = 0
    while i < self.functions.size {
      sig = self.functions[i]
      j = 0
      while j < sig.params.size {
        self.note_ty(sig.params[j])
        j = j + 1
      }
      self.note_ty(sig.ret)
      i = i + 1
    }
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      j = 0
      while j < sig.params.size {
        self.note_ty(sig.params[j])
        j = j + 1
      }
      self.note_ty(sig.ret)
      i = i + 1
    }
    i = 0
    while i < self.program.structs.size {
      sdef = self.program.structs[i]
      if ty = self.resolver.get_named(sdef.name) {
        j = 0
        while j < ty.fields.size {
          self.note_ty(ty.fields[j].ty)
          j = j + 1
        }
      }
      i = i + 1
    }
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if ty = self.resolver.get_named(cdef.name) {
        j = 0
        while j < ty.fields.size {
          self.note_ty(ty.fields[j].ty)
          j = j + 1
        }
      }
      i = i + 1
    }
    fns = program_all_functions(self.program)
    i = 0
    while i < fns.size {
      if fns[i].generic {
      } else {
        self.collect_stmts(fns[i].body)
      }
      i = i + 1
    }
  }

  pub fn collect_stmts(body: Array(Stmt)) {
    i = 0
    while i < body.size {
      stmt = body[i]
      k = stmt.kind
      if k == st_if() {
        if c = stmt.cond {
          self.collect_expr(c)
        }
        self.collect_stmts(stmt.then_body)
        self.collect_stmts(stmt.else_body)
      } else if k == st_while() {
        if c = stmt.cond {
          self.collect_expr(c)
        }
        self.collect_stmts(stmt.body)
      } else if k == st_assign() {
        if t = stmt.target {
          self.collect_expr(t)
        }
        if v = stmt.value {
          self.collect_expr(v)
        }
      } else if k == st_expr() {
        if e = stmt.expr {
          self.collect_expr(e)
        }
      } else if k == st_return() {
        if e = stmt.expr {
          self.collect_expr(e)
        }
      }
      i = i + 1
    }
  }

  pub fn collect_expr(expr: Expr) {
    self.note_ty(expr_ty(expr))
    k = expr.kind
    if k == ex_call() {
      if inner = expr.inner {
        self.collect_expr(inner)
      }
      if recv = expr.receiver {
        self.collect_expr(recv)
        if str_eq(expr.callee, "parallel") {
          n = self.spawn_id
          expr.spawn_thunk = "__par_${n}"
          self.spawn_id = n + 1
          self.pending.push(expr)
          self.need_parallel = 1
          words: Array(Ty) = []
          words.push(expr_ty(recv))
          words.push(expr_ty(expr))
          wi = 0
          while wi < expr.cap_tys.size {
            words.push(expr.cap_tys[wi])
            wi = wi + 1
          }
          self.note_words("${expr.spawn_thunk}_cap", words)
        }
        if str_eq(expr.callee, "with") {
          if str_eq(expr_ty(recv).origin, "Mutex") {
            self.need_gate = 1
          }
        }
      } else {
        if str_eq(expr.callee, "spawn") {
          if b = expr.block {
            n = self.spawn_id
            expr.spawn_thunk = "__spawn_${n}"
            self.spawn_id = n + 1
            self.pending.push(expr)
            if expr.cap_names.size > 0 {
              self.note_words("${expr.spawn_thunk}_cap", expr.cap_tys)
            }
          }
        }
        if self.is_gate_callee(expr.callee) {
          self.need_gate = 1
        }
      }
      i = 0
      while i < expr.args.size {
        self.collect_expr(expr.args[i])
        i = i + 1
      }
      if b = expr.block {
        self.collect_stmts(b.body)
      }
      return
    }
    if k == ex_unary() {
      if inner = expr.inner {
        self.collect_expr(inner)
      }
      return
    }
    if k == ex_binary() {
      if l = expr.left {
        self.collect_expr(l)
      }
      if r = expr.right {
        self.collect_expr(r)
      }
      return
    }
    if k == ex_field() {
      if obj = expr.object {
        self.collect_expr(obj)
      }
      return
    }
    if k == ex_index() {
      if l = expr.left {
        self.collect_expr(l)
      }
      if r = expr.right {
        self.collect_expr(r)
      }
      return
    }
    if k == ex_struct() {
      i = 0
      while i < expr.field_exprs.size {
        self.collect_expr(expr.field_exprs[i])
        i = i + 1
      }
      return
    }
    if k == ex_array() {
      i = 0
      while i < expr.elems.size {
        self.collect_expr(expr.elems[i])
        i = i + 1
      }
      return
    }
    if k == ex_array_new() {
      if size = expr.size_expr {
        self.collect_expr(size)
      }
      return
    }
    if k == ex_try() {
      if inner = expr.inner {
        self.collect_expr(inner)
      }
      return
    }
    if k == ex_interp() {
      i = 0
      while i < expr.parts.size {
        part = expr.parts[i]
        if inner = part.expr {
          self.collect_expr(inner)
        }
        i = i + 1
      }
      return
    }
    if k == ex_lambda() {
      self.collect_lambda(expr)
      return
    }
    if k == ex_switch() {
      if c = expr.cond {
        self.collect_expr(c)
      }
      i = 0
      while i < expr.cases.size {
        self.collect_stmts(expr.cases[i].body)
        i = i + 1
      }
      if expr.has_else {
        self.collect_stmts(expr.else_body)
      }
    }
  }

  pub fn emit_layout(ty: Ty) {
    name = ty_layout_myc(ty)
    self.line("STRUCT :${name}")
    self.indent = self.indent + 1
    i = 0
    while i < ty.fields.size {
      m = ty_myc(ty.fields[i].ty)
      self.line("TYPE :${m}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.line("ENDSTRUCT")
    self.blank
  }

  pub fn emit_array_def(ty: Ty) {
    name = ty_layout_myc(ty)
    self.line("STRUCT :${name}")
    self.indent = self.indent + 1
    if e = ty.inner {
      em = ty_myc(e)
      self.line("TYPE :ptr<${em}>")
    }
    self.line("TYPE :i32")
    self.line("TYPE :i32")
    self.indent = self.indent - 1
    self.line("ENDSTRUCT")
    self.blank
  }

  pub fn emit_union_def(ty: Ty) {
    name = ty_layout_myc(ty)
    self.line("STRUCT :${name}")
    self.indent = self.indent + 1
    self.line("TYPE :i32")
    payloads = ty.payload_members
    i = 0
    while i < payloads.size {
      m = ty_myc(payloads[i])
      self.line("TYPE :${m}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.line("ENDSTRUCT")
    self.blank
  }

  pub fn emit: String {
    self.cov = coverage_wanted()
    if self.cov {
      self.cov_map_path = coverage_map_path()
    }
    self.resolver = load_types(self.program)
    self.collect_sigs
    self.collect_methods
    self.mark_numeric_leaves
    self.may_share = self.program_may_share
    self.mark_quiet_leaves
    self.assign_class_ids
    self.collect_arrays
    self.emit_runtime_decl
    self.emit_lib_decls
    i = 0
    while i < self.program.structs.size {
      sdef = self.program.structs[i]
      if sdef.type_params.size > 0 {
      } else {
        if ty = self.resolver.get_named(sdef.name) {
          self.emit_layout(ty)
        }
      }
      i = i + 1
    }
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if cdef.type_params.size > 0 {
      } else {
        if ty = self.resolver.get_named(cdef.name) {
          self.emit_layout(ty)
        }
      }
      i = i + 1
    }
    i = 0
    while i < self.program.libs.size {
      lib_def = self.program.libs[i]
      j = 0
      while j < lib_def.layouts.size {
        lay = lib_def.layouts[j]
        if ty = self.resolver.get_named(lay.name) {
          self.emit_layout(ty)
        }
        j = j + 1
      }
      i = i + 1
    }
    i = 0
    while i < self.union_tys.size {
      self.emit_union_def(self.union_tys[i])
      i = i + 1
    }
    i = 0
    while i < self.array_tys.size {
      self.emit_array_def(self.array_tys[i])
      i = i + 1
    }
    i = 0
    while i < self.fn_tys.size {
      self.emit_fn_def(self.fn_tys[i])
      i = i + 1
    }
    i = 0
    while i < self.box_tys.size {
      self.emit_box_def(self.box_tys[i])
      i = i + 1
    }
    self.emit_env_defs
    i = 0
    while i < self.pending.size {
      pend = self.pending[i]
      if str_eq(pend.callee, "parallel") {
        self.emit_parallel_layout(pend)
      } else {
        self.emit_spawn_cap_layout(pend)
      }
      i = i + 1
    }
    fns = program_all_functions(self.program)
    i = 0
    while i < fns.size {
      self.emit_function(fns[i])
      i = i + 1
    }
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if cdef.type_params.size > 0 {
      } else {
        if ty = self.resolver.get_named(cdef.name) {
          self.emit_constructor(ty)
        }
      }
      i = i + 1
    }
    self.cur_leaf = 0
    i = 0
    while i < self.pending.size {
      pend = self.pending[i]
      if str_eq(pend.callee, "parallel") {
        self.emit_parallel_thunk(pend)
      } else {
        self.emit_spawn_thunk(pend)
      }
      i = i + 1
    }
    i = 0
    while i < self.lambdas.size {
      self.emit_lambda_thunk(self.lambdas[i])
      i = i + 1
    }
    i = 0
    while i < fns.size {
      if fns[i].as_value {
        if fns[i].generic {
        } else {
          self.emit_fn_trampoline(fns[i])
        }
      }
      i = i + 1
    }
    if self.has_fn("main") {
    } else {
      self.emit_wrapper_main
    }
    self.write_cov_map
    self.out.to_s
  }

  pub fn owner_is_template(owner: String): Bool {
    if owner.size == 0 {
      return false
    }
    i = 0
    while i < self.program.structs.size {
      sdef = self.program.structs[i]
      if str_eq(sdef.name, owner) {
        return sdef.type_params.size > 0
      }
      i = i + 1
    }
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if str_eq(cdef.name, owner) {
        return cdef.type_params.size > 0
      }
      i = i + 1
    }
    false
  }

  pub fn mark_numeric_leaves {
    found = Hash(String, Int).new
    fns = program_all_functions(self.program)
    i = 0
    while i < fns.size {
      fnn = fns[i]
      if self.fn_can_skip_frame(fnn) {
        found[fnn.emit_name] = 1
      }
      i = i + 1
    }
    self.numeric_leaves = found
  }

  // A function that cannot collect needs no frame and no safepoint.
  // Another thread can collect while this one holds a raw pointer, so
  // this stays off when the program spawns or uses .parallel.
  //
  // A recursive call is not itself a collection. Every candidate starts
  // in the set, and a function drops out when it calls something that
  // is already out. Integer casts and hash get, clear, delete, and size
  // do not move. A hash or array index store is not a call in this walk.
  // Array.each is inlined, so the call is not a collection; the block is.
  // Those helpers defer, and a private mutator does not move inside that
  // window.
  pub fn mark_quiet_leaves {
    buf = buf_new()
    first = 1
    if self.may_share {
      self.program.quiet_leaves = ""
      return
    }
    open = Hash(String, Int).new
    fns = program_all_functions(self.program)
    i = 0
    while i < fns.size {
      fnn = fns[i]
      if self.quiet_candidate(fnn) {
        if v = self.numeric_leaves.get(fnn.emit_name) {
        } else {
          open[fnn.emit_name] = 1
        }
      }
      i = i + 1
    }
    self.leaf_open = open
    self.leaf_walk = 1
    guard = 0
    while guard < fns.size {
      removed = 0
      i = 0
      while i < fns.size {
        fnn = fns[i]
        if v = open.get(fnn.emit_name) {
          if v == 1 {
            if self.stmts_may_collect(fnn.body) {
              open[fnn.emit_name] = 0
              removed = 1
            }
          }
        }
        i = i + 1
      }
      if removed == 0 {
        guard = fns.size
      } else {
        guard = guard + 1
      }
    }
    self.leaf_walk = 0
    i = 0
    while i < fns.size {
      fnn = fns[i]
      if v = open.get(fnn.emit_name) {
        if v == 1 {
          self.numeric_leaves[fnn.emit_name] = 1
          if first == 0 {
            buf.push_str(",")
          }
          first = 0
          buf.push_str(fnn.emit_name)
        }
      }
      i = i + 1
    }
    // These helpers do not move when this thread is the only mutator.
    // Set grows under defer. Get, clear, delete, and size do not allocate.
    // A program that spawns does not reach this list.
    if first == 0 {
      buf.push_str(",")
    }
    buf.push_str("avant_hash_get_i32,avant_hash_get_str,avant_hash_get_i32k_i32")
    buf.push_str(",avant_hash_set_i32,avant_hash_set_str,avant_hash_set_i32k_i32")
    buf.push_str(",avant_hash_clear,avant_hash_size,avant_hash_del,avant_hash_del_i32k")
    self.program.quiet_leaves = buf.to_s
  }

  pub fn quiet_candidate(fnn: Function): Bool {
    if fnn.generic {
      return false
    }
    if str_eq(fnn.name, "main") {
      return false
    }
    if fnn.emit_name.size == 0 {
      return false
    }
    if fnn.box_names.size > 0 {
      return false
    }
    true
  }

  pub fn leaf_named(name: String): Bool {
    if v = self.numeric_leaves.get(name) {
      return true
    }
    false
  }

  // spawn and .parallel register a second thread, which can collect
  // while this thread holds an interior pointer. A program with neither
  // keeps g_avant_shared at 0, so the flag load is dead.
  pub fn program_may_share: Bool {
    fns = program_all_functions(self.program)
    i = 0
    while i < fns.size {
      if self.stmts_may_share(fns[i].body) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn stmts_may_share(body: Array(Stmt)): Bool {
    i = 0
    while i < body.size {
      if self.stmt_may_share(body[i]) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn stmt_may_share(stmt: Stmt): Bool {
    if e = stmt.expr {
      if self.expr_may_share(e) {
        return true
      }
    }
    if c = stmt.cond {
      if self.expr_may_share(c) {
        return true
      }
    }
    if t = stmt.target {
      if self.expr_may_share(t) {
        return true
      }
    }
    if v = stmt.value {
      if self.expr_may_share(v) {
        return true
      }
    }
    if self.stmts_may_share(stmt.then_body) {
      return true
    }
    if self.stmts_may_share(stmt.else_body) {
      return true
    }
    self.stmts_may_share(stmt.body)
  }

  pub fn expr_may_share(expr: Expr): Bool {
    if expr.kind == ex_call() {
      if str_eq(expr.callee, "spawn") {
        return true
      }
      if str_eq(expr.callee, "parallel") {
        return true
      }
    }
    if inner = expr.inner {
      if self.expr_may_share(inner) {
        return true
      }
    }
    if l = expr.left {
      if self.expr_may_share(l) {
        return true
      }
    }
    if r = expr.right {
      if self.expr_may_share(r) {
        return true
      }
    }
    if obj = expr.object {
      if self.expr_may_share(obj) {
        return true
      }
    }
    if c = expr.cond {
      if self.expr_may_share(c) {
        return true
      }
    }
    if recv = expr.receiver {
      if self.expr_may_share(recv) {
        return true
      }
    }
    if sz = expr.size_expr {
      if self.expr_may_share(sz) {
        return true
      }
    }
    i = 0
    while i < expr.args.size {
      if self.expr_may_share(expr.args[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.elems.size {
      if self.expr_may_share(expr.elems[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.field_exprs.size {
      if self.expr_may_share(expr.field_exprs[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      if pe = part.expr {
        if self.expr_may_share(pe) {
          return true
        }
      }
      i = i + 1
    }
    i = 0
    while i < expr.cases.size {
      if self.stmts_may_share(expr.cases[i].body) {
        return true
      }
      i = i + 1
    }
    if self.stmts_may_share(expr.else_body) {
      return true
    }
    if b = expr.block {
      if self.stmts_may_share(b.body) {
        return true
      }
    }
    false
  }

  pub fn fn_can_skip_frame(fnn: Function): Bool {
    if fnn.generic {
      return false
    }
    if fn_is_method(fnn) {
      return false
    }
    if str_eq(fnn.name, "main") {
      return false
    }
    if fnn.box_names.size > 0 {
      return false
    }
    if sig = self.find_fn(fnn.emit_name) {
      i = 0
      while i < sig.params.size {
        if ty_has_heap(sig.params[i]) {
          return false
        }
        i = i + 1
      }
      if ty_has_heap(sig.ret) {
        return false
      }
    } else {
      return false
    }
    if self.stmts_need_frame(fnn.body) {
      return false
    }
    true
  }

  pub fn stmts_need_frame(body: Array(Stmt)): Bool {
    i = 0
    while i < body.size {
      if self.stmt_needs_frame(body[i]) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn stmt_needs_frame(stmt: Stmt): Bool {
    if e = stmt.expr {
      if self.expr_needs_frame(e) {
        return true
      }
    }
    if c = stmt.cond {
      if self.expr_needs_frame(c) {
        return true
      }
    }
    if t = stmt.target {
      if self.expr_needs_frame(t) {
        return true
      }
    }
    if v = stmt.value {
      if self.expr_needs_frame(v) {
        return true
      }
    }
    if self.stmts_need_frame(stmt.then_body) {
      return true
    }
    if self.stmts_need_frame(stmt.else_body) {
      return true
    }
    if self.stmts_need_frame(stmt.body) {
      return true
    }
    false
  }

  pub fn expr_needs_frame(expr: Expr): Bool {
    if ty_has_heap(expr_ty(expr)) {
      return true
    }
    k = expr.kind
    if k == ex_call() {
      return true
    }
    if k == ex_lambda() {
      return true
    }
    if k == ex_array() {
      return true
    }
    if k == ex_array_new() {
      return true
    }
    if k == ex_hash_new() {
      return true
    }
    if k == ex_interp() {
      return true
    }
    if k == ex_splice() {
      return true
    }
    if k == ex_binary() {
      if expr.resolved.size > 0 {
        return true
      }
    }
    if k == ex_field() {
      if expr.method_call {
        return true
      }
    }
    if inner = expr.inner {
      if self.expr_needs_frame(inner) {
        return true
      }
    }
    if l = expr.left {
      if self.expr_needs_frame(l) {
        return true
      }
    }
    if r = expr.right {
      if self.expr_needs_frame(r) {
        return true
      }
    }
    if obj = expr.object {
      if self.expr_needs_frame(obj) {
        return true
      }
    }
    if c = expr.cond {
      if self.expr_needs_frame(c) {
        return true
      }
    }
    if recv = expr.receiver {
      if self.expr_needs_frame(recv) {
        return true
      }
    }
    if sz = expr.size_expr {
      if self.expr_needs_frame(sz) {
        return true
      }
    }
    i = 0
    while i < expr.args.size {
      if self.expr_needs_frame(expr.args[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.elems.size {
      if self.expr_needs_frame(expr.elems[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.field_exprs.size {
      if self.expr_needs_frame(expr.field_exprs[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      if pe = part.expr {
        if self.expr_needs_frame(pe) {
          return true
        }
      }
      i = i + 1
    }
    i = 0
    while i < expr.cases.size {
      if self.stmts_need_frame(expr.cases[i].body) {
        return true
      }
      i = i + 1
    }
    if self.stmts_need_frame(expr.else_body) {
      return true
    }
    if b = expr.block {
      if self.stmts_need_frame(b.body) {
        return true
      }
    }
    false
  }

  pub fn emit_function(fnn: Function) {
    self.cur_leaf = 0
    if fnn.generic {
      return
    }
    if self.owner_is_template(fnn.owner) {
      return
    }
    self.temps = 0
    self.c_main = false
    self.self_ty = nil
    self.self_name = ""
    if fn_is_method(fnn) {
      if sig = self.find_method_emit(fnn.emit_name) {
        self.return_type = sig.ret
        self.self_name = fn_self_name(fnn)
        if owner = self.resolver.get_named(sig.owner) {
          self.self_ty = owner
          self.emit_method_func(fnn, sig)
        } else {
          self.self_ty = nil
          self.emit_ptr_method_func(fnn, sig)
        }
      }
      self.self_ty = nil
      self.self_name = ""
      return
    }
    if sig = self.find_fn(fnn.emit_name) {
      self.return_type = sig.ret
      if str_eq(fnn.name, "main") {
        self.c_main = true
      }
      self.emit_plain_func(fnn, sig.params)
      self.c_main = false
    }
  }

  pub fn emit_return_header {
    if self.c_main {
      self.line("RETURN")
      self.indent = self.indent + 1
      self.line("TYPE :i32")
      self.indent = self.indent - 1
    } else {
      if self.return_type.is_void {
      } else {
        self.line("RETURN")
        self.indent = self.indent + 1
        m = ty_myc(self.return_type)
        self.line("TYPE :${m}")
        self.indent = self.indent - 1
      }
    }
  }

  pub fn emit_plain_func(fnn: Function, params: Array(Ty)) {
    self.cur_leaf = 0
    if v = self.numeric_leaves.get(fnn.emit_name) {
      self.cur_leaf = 1
    }
    self.begin_fn_frame(fnn.box_names)
    self.line("FUNC :${fnn.emit_name}")
    self.indent = self.indent + 1
    if self.c_main {
      self.line("ARGS")
      self.indent = self.indent + 1
      self.line("TYPE :i32")
      self.line("TYPE :ptr<void>")
      self.indent = self.indent - 1
      self.emit_return_header
      self.line("BODY")
      self.indent = self.indent + 1
      self.reset_rooted
      if self.cur_leaf == 0 {
        self.line("CALL :avant_gc_enter")
      }
      self.emit_type_maps
      self.emit_init_argv
      self.emit_cov_init
      self.cov_func(fnn)
      self.emit_stmts(fnn.body, true)
      self.emit_gc_leave_if_fallthrough(fnn)
    } else {
      if fnn.params.size > 0 {
        self.line("ARGS")
        self.indent = self.indent + 1
        i = 0
        while i < params.size {
          m = ty_myc(params[i])
          self.line("TYPE :${m}")
          i = i + 1
        }
        self.indent = self.indent - 1
      }
      self.emit_return_header
      self.line("BODY")
      self.indent = self.indent + 1
      self.reset_rooted
      if self.cur_leaf == 0 {
        self.line("CALL :avant_gc_enter")
      }
      pnames: Array(String) = []
      i = 0
      while i < fnn.params.size {
        pnames.push(fnn.params[i].name)
        i = i + 1
      }
      self.emit_param_group(pnames, params, 0)
      self.cov_func(fnn)
      self.emit_stmts(fnn.body, true)
      self.emit_gc_leave_if_fallthrough(fnn)
    }
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
  }

  pub fn emit_method_func(fnn: Function, sig: FuncSig) {
    self.cur_leaf = 0
    if self.leaf_named(sig.mangled) {
      self.cur_leaf = 1
    }
    self.begin_fn_frame(fnn.box_names)
    mangled = sig.mangled
    self.line("FUNC :${mangled}")
    self.indent = self.indent + 1
    self.line("ARGS")
    self.indent = self.indent + 1
    if owner = self.self_ty {
      m = ty_self_ptr_myc(owner)
      self.line("TYPE :${m}")
    }
    i = 0
    while i < sig.params.size {
      m = ty_myc(sig.params[i])
      self.line("TYPE :${m}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.emit_return_header
    self.line("BODY")
    self.indent = self.indent + 1
    self.reset_rooted
    if self.cur_leaf == 0 {
      self.line("CALL :avant_gc_enter")
    }
    recv_name = fn_self_name(fnn)
    if owner = self.self_ty {
      m = ty_self_ptr_myc(owner)
      self.line("PARAM 0")
      self.line("LOCAL :${recv_name} :${m}")
      self.line("STORE")
    }
    pnames: Array(String) = []
    i = 0
    while i < fnn.params.size {
      pnames.push(fnn.params[i].name)
      i = i + 1
    }
    raws = self.emit_param_stores(pnames, sig.params, 1)
    if rooted = self.self_ty {
      self.ensure_root(recv_name, rooted)
    }
    self.emit_param_finish(pnames, sig.params, raws)
    self.cov_func(fnn)
    self.emit_stmts(fnn.body, true)
    self.emit_gc_leave_if_fallthrough(fnn)
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
    self.self_ty = nil
    self.self_name = ""
  }

  pub fn emit_ptr_method_func(fnn: Function, sig: FuncSig) {
    self.cur_leaf = 0
    if self.leaf_named(sig.mangled) {
      self.cur_leaf = 1
    }
    self.begin_fn_frame(fnn.box_names)
    recv_ty = ty_void()
    if r = fnn.receiver {
      recv_ty = self.resolver.resolve(r.type)
    }
    mrecv = ty_myc(recv_ty)
    mangled = sig.mangled
    recv_name = fn_self_name(fnn)
    self.line("FUNC :${mangled}")
    self.indent = self.indent + 1
    self.line("ARGS")
    self.indent = self.indent + 1
    self.line("TYPE :${mrecv}")
    i = 0
    while i < sig.params.size {
      m = ty_myc(sig.params[i])
      self.line("TYPE :${m}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.emit_return_header
    self.line("BODY")
    self.indent = self.indent + 1
    self.reset_rooted
    if self.cur_leaf == 0 {
      self.line("CALL :avant_gc_enter")
    }
    self.line("PARAM 0")
    self.line("LOCAL :${recv_name} :${mrecv}")
    self.line("STORE")
    pnames: Array(String) = []
    i = 0
    while i < fnn.params.size {
      pnames.push(fnn.params[i].name)
      i = i + 1
    }
    self.emit_param_group(pnames, sig.params, 1)
    self.cov_func(fnn)
    self.emit_stmts(fnn.body, true)
    self.emit_gc_leave_if_fallthrough(fnn)
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
    self.self_ty = nil
    self.self_name = ""
  }

  pub fn emit_named_args(names: Array(String), types: Array(Ty)) {
    if names.size <= 1 {
      i = 0
      while i < names.size {
        self.line("LOCAL :${names[i]}")
        i = i + 1
      }
      return
    }
    tmps: Array(String) = []
    i = 0
    while i < names.size {
      self.line("LOCAL :${names[i]}")
      tmp = self.new_temp
      m = ty_myc(types[i])
      self.line("LOCAL :${tmp} :${m}")
      self.line("STORE")
      self.ensure_root(tmp, types[i])
      tmps.push(tmp)
      i = i + 1
    }
    i = tmps.size - 1
    while i >= 0 {
      t = tmps[i]
      self.line("LOCAL :${t}")
      i = i - 1
    }
  }

  pub fn emit_field_defaults(ty: Ty) {
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if str_eq(cdef.name, ty.name) {
        j = 0
        while j < cdef.fields.size {
          field = cdef.fields[j]
          if default = field.default {
            field_ty = ty.fields[j].ty
            self.emit_expr(default)
            self.emit_coerce(expr_ty(default), field_ty)
            if needs_heap_barrier(field_ty) {
              val = self.new_temp
              m = ty_myc(field_ty)
              self.line("LOCAL :${val} :${m}")
              self.line("STORE")
              self.ensure_root(val, field_ty)
              self.line("LOCAL :self")
              self.line("CALL :avant_barrier")
              self.line("LOCAL :${val}")
              self.line("LOCAL :self")
              self.line("DEREF")
              self.line("FIELD ${j}")
              self.line("STORE")
            } else {
              self.line("LOCAL :self")
              self.line("DEREF")
              self.line("FIELD ${j}")
              self.line("STORE")
            }
          }
          j = j + 1
        }
        return
      }
      i = i + 1
    }
  }

  pub fn emit_constructor(ty: Ty) {
    self.cur_leaf = 0
    self.temps = 0
    self.return_type = ty
    self.self_ty = nil
    self.self_name = ""
    none: Array(String) = []
    self.begin_fn_frame(none)
    init_sig = self.find_initialize(ty.name)
    ctor = "${ty.name}__new"
    self.line("FUNC :${ctor}")
    self.indent = self.indent + 1
    if sig = init_sig {
      if sig.params.size > 0 {
        self.line("ARGS")
        self.indent = self.indent + 1
        i = 0
        while i < sig.params.size {
          m = ty_myc(sig.params[i])
          self.line("TYPE :${m}")
          i = i + 1
        }
        self.indent = self.indent - 1
      }
    }
    self.line("RETURN")
    self.indent = self.indent + 1
    m = ty_myc(ty)
    self.line("TYPE :${m}")
    self.indent = self.indent - 1
    self.line("BODY")
    self.indent = self.indent + 1
    self.reset_rooted
    self.line("CALL :avant_gc_enter")
    if sig = init_sig {
      i = 0
      while i < sig.params.size {
        name = sig.node.params[i].name
        m = ty_myc(sig.params[i])
        self.line("PARAM ${i}")
        self.line("LOCAL :${name} :${m}")
        self.line("STORE")
        self.ensure_root(name, sig.params[i])
        i = i + 1
      }
    }
    tid = 1
    if id = self.class_ids.get(ty.name) {
      tid = id
    }
    layout = ty_layout_myc(ty)
    self.emit_alloc_sizeof(layout, tid)
    sp = ty_self_ptr_myc(ty)
    self.line("AS :${sp}")
    self.line("LOCAL :self :${sp}")
    self.line("STORE")
    self.ensure_root("self", ty)
    self.emit_field_defaults(ty)
    if sig = init_sig {
      names: Array(String) = []
      i = 0
      while i < sig.node.params.size {
        names.push(sig.node.params[i].name)
        i = i + 1
      }
      self.emit_named_args(names, sig.params)
      self.line("LOCAL :self")
      mangled = sig.mangled
      self.line("CALL :${mangled}")
    }
    self.line("LOCAL :self")
    self.emit_ret
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
  }

  pub fn emit_wrapper_main {
    run_void = true
    if sig = self.find_fn("run") {
      if sig.ret.is_void {
        run_void = true
      } else {
        run_void = false
      }
    }
    self.line("FUNC :main")
    self.indent = self.indent + 1
    self.line("ARGS")
    self.indent = self.indent + 1
    self.line("TYPE :i32")
    self.line("TYPE :ptr<void>")
    self.indent = self.indent - 1
    self.line("RETURN")
    self.indent = self.indent + 1
    self.line("TYPE :i32")
    self.indent = self.indent - 1
    self.line("BODY")
    self.indent = self.indent + 1
    self.line("CALL :avant_gc_enter")
    self.emit_type_maps
    self.emit_init_argv
    self.emit_cov_init
    self.line("CALL :run")
    if run_void {
    } else {
      self.line("STACK :drop")
    }
    self.line("CALL :avant_gc_leave")
    self.line("PUSH 0")
    self.line("RET")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
  }

  pub fn emit_init_argv {
    self.line("PARAM 1")
    self.line("PARAM 0")
    self.line("CALL :avant_io_init_argv")
  }

  pub fn emit_type_maps {
    self.line("PUSH 1 :u64")
    self.line("PUSH 1022 :u32")
    self.line("CALL :avant_type_map")
    self.line("PUSH 1 :u64")
    self.line("PUSH 1021 :u32")
    self.line("CALL :avant_type_map")
    self.line("PUSH 7 :u64")
    self.line("PUSH 1023 :u32")
    self.line("CALL :avant_type_map")
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if cdef.type_params.size > 0 {
      } else {
        if ty = self.resolver.get_named(cdef.name) {
          bits = pointer_word_bits(ty)
          if id = self.class_ids.get(cdef.name) {
            self.line("PUSH ${bits} :u64")
            self.line("PUSH ${id} :u32")
            self.line("CALL :avant_type_map")
          }
        }
      }
      i = i + 1
    }
    i = 0
    while i < self.closure_names.size {
      bits = self.closure_bits[i]
      id = 400 + i
      self.line("PUSH ${bits} :u64")
      self.line("PUSH ${id} :u32")
      self.line("CALL :avant_type_map")
      i = i + 1
    }
  }

  pub fn emit_ret {
    if self.cur_leaf == 0 {
      self.line("CALL :avant_gc_leave")
    }
    if self.c_main {
      self.line("PUSH 0")
    }
    self.line("RET")
  }

  pub fn emit_gc_leave_if_fallthrough(fnn: Function) {
    if fnn.body.size == 0 {
      self.emit_ret
      return
    }
    last = fnn.body[fnn.body.size - 1]
    if last.kind == st_return() {
      return
    }
    if last.kind == st_expr() {
      if self.return_type.is_void {
      } else {
        return
      }
    }
    self.emit_ret
  }

  pub fn emit_ptr_root(name: String) {
    self.rooted[name] = 1
    self.line("LOCAL :${name}")
    self.line("ADDR")
    self.line("CALL :avant_gc_root")
  }

  // Root an interior pointer only after a second thread exists.
  // g_avant_shared stays 0 for a whole single-threaded run, so the
  // call is not on the hot path. The array object remains a root
  // either way, and its buf word is scanned.
  pub fn emit_root_if_shared(name: String) {
    if self.may_share {
    } else {
      return
    }
    self.line("PUSH 0")
    self.line("GLOBAL :g_avant_shared")
    self.line("BINARY :not_eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.emit_ptr_root(name)
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
  }

  pub fn ensure_root(name: String, ty: Ty) {
    if self.cur_leaf != 0 {
      return
    }
    if self.place_name.size > 0 {
      if str_eq(name, self.place_name) {
        return
      }
    }
    if v = self.rooted.get(name) {
      return
    }
    if ty_has_heap(ty) {
    } else {
      return
    }
    self.rooted[name] = 1
    if ty.is_union {
      i = 0
      field_i = 1
      while i < ty.members.size {
        m = ty.members[i]
        if m.is_nil {
        } else {
          if ty_has_heap(m) {
            self.line("LOCAL :${name}")
            self.line("FIELD ${field_i}")
            self.line("ADDR")
            self.line("CALL :avant_gc_root")
          }
          field_i = field_i + 1
        }
        i = i + 1
      }
      return
    }
    // The root call is idempotent. Inside a loop it ran on every
    // iteration and walked the frame's slot list. Register the slot
    // once, before the outermost loop. It holds null until the loop
    // stores the real pointer. myc-llvm reloads the slot after a
    // collecting call. A union stays rooted at the store: its fields
    // are not one pointer word.
    if self.root_loop > 0 && pointer_root_ty(ty) {
      self.emit_early_root(name, ty)
      return
    }
    self.emit_ptr_root(name)
  }

  pub fn emit_early_root(name: String, ty: Ty) {
    saved_out = self.out
    saved_indent = self.indent
    self.out = self.early_out
    self.indent = self.early_indent
    self.emit_zero(ty)
    m = ty_myc(ty)
    decl = buf_new()
    decl.push_str("LOCAL :")
    decl.push_str(name)
    decl.push_str(" :")
    decl.push_str(m)
    self.line(decl.to_s)
    self.line("STORE")
    use = buf_new()
    use.push_str("LOCAL :")
    use.push_str(name)
    self.line(use.to_s)
    self.line("ADDR")
    self.line("CALL :avant_gc_root")
    self.out = saved_out
    self.indent = saved_indent
  }

  pub fn emit_while(stmt: Stmt) {
    nhoist = self.begin_loop_hoists(stmt)
    outer = false
    if self.root_loop == 0 {
      outer = true
      fresh = buf_new()
      self.early_out = fresh
      self.early_indent = self.indent
    }
    saved = self.out
    body = buf_new()
    self.out = body
    self.root_loop = self.root_loop + 1
    self.line("LOOP")
    self.indent = self.indent + 1
    self.line("COND")
    self.indent = self.indent + 1
    if c = stmt.cond {
      self.emit_expr(c)
    }
    self.indent = self.indent - 1
    self.line("BODY")
    self.indent = self.indent + 1
    self.cov_branch(stmt.loc)
    self.emit_stmts(stmt.body, false)
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDLOOP")
    self.root_loop = self.root_loop - 1
    self.end_loop_hoists(nhoist)
    self.out = saved
    if outer {
      self.out.push_str(self.early_out.to_s)
    }
    self.out.push_str(body.to_s)
  }

  pub fn emit_stmts(body: Array(Stmt), implicit_return: Bool) {
    i = 0
    while i < body.size {
      at_tail = false
      if implicit_return {
        if i == body.size - 1 {
          at_tail = true
        }
      }
      self.emit_stmt(body[i], at_tail)
      i = i + 1
    }
  }

  pub fn emit_stmt(stmt: Stmt, at_tail: Bool) {
    self.cov_stmt(stmt)
    k = stmt.kind
    switch k {
      case 2 {
        if e = stmt.expr {
          self.emit_expr(e)
          self.emit_coerce(expr_ty(e), self.return_type)
        }
        self.emit_ret
      }
      case 3 {
        if stmt.bind.size > 0 {
          self.emit_if_assign(stmt)
        } else {
          if c = stmt.cond {
            self.emit_expr(c)
          }
          self.line("IF")
          self.indent = self.indent + 1
          self.line("THEN")
          self.indent = self.indent + 1
          self.cov_branch(stmt.loc)
          self.emit_stmts(stmt.then_body, false)
          self.indent = self.indent - 1
          if stmt.else_body.size > 0 {
            self.line("ELSE")
            self.indent = self.indent + 1
            self.cov_branch(stmt.loc)
            self.emit_stmts(stmt.else_body, false)
            self.indent = self.indent - 1
          } else {
            if self.cov {
              self.line("ELSE")
              self.indent = self.indent + 1
              self.cov_branch(stmt.loc)
              self.indent = self.indent - 1
            }
          }
          self.indent = self.indent - 1
          self.line("ENDIF")
        }
      }
      case 4 {
        self.emit_while(stmt)
      }
      case 5 {
        self.line("BREAK")
      }
      case 6 {
        self.line("NEXT")
      }
      case 7 {
        self.emit_assign(stmt)
      }
      case 1 {
        if e = stmt.expr {
          self.emit_expr(e)
          if at_tail {
            if self.return_type.is_void {
              if expr_ty(e).is_void {
              } else {
                self.line("STACK :drop")
              }
            } else {
              self.emit_coerce(expr_ty(e), self.return_type)
              self.emit_ret
            }
          } else {
            if expr_ty(e).is_void {
            } else {
              self.line("STACK :drop")
            }
          }
        }
      }
      else {
      }
    }
  }

  pub fn emit_assign(stmt: Stmt) {
    if stmt.op == tk_eq() {
      if t = stmt.target {
        if t.kind == ex_name() {
          if self.name_is_boxed(t.ident) {
            if v = stmt.value {
              self.ensure_box(t.ident, expr_ty(t))
              self.emit_expr(v)
              self.emit_coerce(expr_ty(v), expr_ty(t))
              self.store_box_value(t.ident, expr_ty(t))
              return
            }
          }
        }
        if t.kind == ex_index() {
          if arr = t.left {
            if expr_ty(arr).is_hash {
              if v = stmt.value {
                self.emit_hash_set(t, v, expr_ty(arr))
                return
              }
            }
            if expr_ty(arr).is_array {
              if e = expr_ty(arr).inner {
                if heap_ptr_value(e) {
                  if v = stmt.value {
                    self.emit_array_set_ptr(t, v)
                    return
                  }
                }
              }
            }
          }
        }
        if t.kind == ex_field() {
          if obj = t.object {
            object_ty = expr_ty(obj)
            if object_ty.is_class {
              if needs_heap_barrier(expr_ty(t)) {
                if v = stmt.value {
                  self.emit_barrier_field_store(t, v)
                  return
                }
              }
            }
          }
        }
        if self.c_layout_heap_store(t) {
          if v = stmt.value {
            self.emit_expr(v)
            self.emit_coerce(expr_ty(v), expr_ty(t))
            self.line("STACK :dup")
            self.line("AS :ptr<void>")
            self.line("CALL :avant_pin")
            self.emit_lvalue(t)
            self.line("STORE")
            self.root_after_store(t)
            return
          }
        }
      }
      if v = stmt.value {
        if t = stmt.target {
          self.emit_expr(v)
          self.emit_coerce(expr_ty(v), expr_ty(t))
        }
      }
    } else {
      if t = stmt.target {
        if t.kind == ex_name() {
          if self.name_is_boxed(t.ident) {
            self.ensure_box(t.ident, expr_ty(t))
          }
        }
        self.emit_expr(t)
        tmp = self.new_temp
        ty = expr_ty(t)
        m = ty_myc(ty)
        self.line("LOCAL :${tmp} :${m}")
        self.line("STORE")
        if v = stmt.value {
          self.emit_expr(v)
        }
        self.line("LOCAL :${tmp}")
        op = myc_binop(compound_to_binop(stmt.op))
        self.line("BINARY :${op}")
      }
    }
    if t = stmt.target {
      self.emit_lvalue(t)
      self.line("STORE")
      self.root_after_store(t)
    }
  }

  pub fn emit_barrier_field_store(target: Expr, value: Expr) {
    field_ty = expr_ty(target)
    if obj = target.object {
      object_ty = expr_ty(obj)
      self.emit_expr(value)
      self.emit_coerce(expr_ty(value), field_ty)
      val = self.new_temp
      m = ty_myc(field_ty)
      self.line("LOCAL :${val} :${m}")
      self.line("STORE")
      // A local object is already addressed. The barrier and the store
      // do not allocate, so the value does not need its own root and the
      // object does not need a second slot.
      if obj.kind == ex_name() {
        if self.may_share {
          self.ensure_root(val, field_ty)
          self.ensure_root(obj.ident, object_ty)
        }
        self.line("LOCAL :${obj.ident}")
        self.line("CALL :avant_barrier")
        self.line("LOCAL :${val}")
        self.line("LOCAL :${obj.ident}")
        self.line("DEREF")
        fi = object_ty.field_index(target.ident)
        self.line("FIELD ${fi}")
        self.line("STORE")
      } else {
        self.ensure_root(val, field_ty)
        self.emit_expr(obj)
        objn = self.new_temp
        om = ty_myc(object_ty)
        self.line("LOCAL :${objn} :${om}")
        self.line("STORE")
        self.ensure_root(objn, object_ty)
        self.line("LOCAL :${objn}")
        self.line("CALL :avant_barrier")
        self.line("LOCAL :${val}")
        self.line("LOCAL :${objn}")
        self.line("DEREF")
        fi = object_ty.field_index(target.ident)
        self.line("FIELD ${fi}")
        self.line("STORE")
      }
    }
  }

  pub fn root_after_store(target: Expr) {
    if target.kind == ex_name() {
      if target.implicit_field {
        return
      }
      self.ensure_root(target.ident, expr_ty(target))
    }
  }

  pub fn emit_coerce(got: Ty, want: Ty) {
    if got.same_as(want) {
      return
    }
    if want.is_union {
      if want.includes_member(got) {
        self.emit_wrap_union(got, want)
      }
    }
  }

  pub fn emit_wrap_union(got: Ty, want: Ty) {
    val = self.new_temp
    gm = ty_myc(got)
    self.line("LOCAL :${val} :${gm}")
    self.line("STORE")
    self.ensure_root(val, got)
    payloads = want.payload_members
    i = payloads.size - 1
    while i >= 0 {
      m = payloads[i]
      if m.same_as(got) {
        self.line("LOCAL :${val}")
      } else {
        self.emit_zero(m)
      }
      i = i - 1
    }
    tag = want.tag_of(got)
    self.line("PUSH ${tag}")
    layout = ty_layout_myc(want)
    self.line("CREATE :${layout}")
  }

  pub fn try_success_from(got: Ty): Ty {
    if got.includes_nil {
      return ty_without_nil(got)
    }
    ret = self.return_type
    i = 0
    while i < got.members.size {
      m = got.members[i]
      if ret.includes_member(m) {
      } else {
        return m
      }
      i = i + 1
    }
    ty_without_nil(got)
  }

  pub fn try_fail_from(got: Ty): Ty {
    if got.includes_nil {
      return ty_nil()
    }
    ret = self.return_type
    i = 0
    while i < got.members.size {
      m = got.members[i]
      if ret.includes_member(m) {
        return m
      }
      i = i + 1
    }
    ty_nil()
  }

  pub fn emit_unwrap(tmp: String, uty: Ty, success: Ty) {
    if success.is_nil {
      self.line("PUSH 0")
      return
    }
    idx = uty.payload_index(success)
    self.line("LOCAL :${tmp}")
    self.line("FIELD ${idx}")
  }

  pub fn emit_failure_return(tmp: String, got: Ty, fail: Ty) {
    if self.return_type.same_as(got) {
      self.line("LOCAL :${tmp}")
    } else {
      if fail.is_nil {
        self.emit_zero(fail)
        self.emit_wrap_union(fail, self.return_type)
      } else {
        self.emit_unwrap(tmp, got, fail)
        self.emit_wrap_union(fail, self.return_type)
      }
    }
    self.emit_ret
  }

  pub fn emit_try(expr: Expr) {
    if inner = expr.inner {
      uty = expr_ty(inner)
      self.emit_expr(inner)
      tmp = self.new_temp
      um = ty_myc(uty)
      self.line("LOCAL :${tmp} :${um}")
      self.line("STORE")
      self.ensure_root(tmp, uty)
      success = self.try_success_from(uty)
      fail = self.try_fail_from(uty)
      fail_tag = uty.tag_of(fail)
      wrapped = self.new_temp
      self.line("LOCAL :${tmp}")
      self.line("FIELD 0")
      self.line("PUSH ${fail_tag}")
      self.line("BINARY :eq")
      self.line("IF")
      self.indent = self.indent + 1
      self.line("THEN")
      self.indent = self.indent + 1
      self.emit_failure_return(tmp, uty, fail)
      self.indent = self.indent - 1
      self.line("ELSE")
      self.indent = self.indent + 1
      self.emit_unwrap(tmp, uty, success)
      sm = ty_myc(success)
      self.line("LOCAL :${wrapped} :${sm}")
      self.line("STORE")
      self.ensure_root(wrapped, success)
      self.indent = self.indent - 1
      self.indent = self.indent - 1
      self.line("ENDIF")
      self.line("LOCAL :${wrapped}")
    }
  }

  pub fn emit_if_assign(stmt: Stmt) {
    if cond = stmt.cond {
      uty = expr_ty(cond)
      success = ty_without_nil(uty)
      self.emit_expr(cond)
      tmp = self.new_temp
      um = ty_myc(uty)
      self.line("LOCAL :${tmp} :${um}")
      self.line("STORE")
      self.ensure_root(tmp, uty)
      nil_tag = uty.tag_of(ty_nil())
      self.line("LOCAL :${tmp}")
      self.line("FIELD 0")
      self.line("PUSH ${nil_tag}")
      self.line("BINARY :not_eq")
      self.line("IF")
      self.indent = self.indent + 1
      self.line("THEN")
      self.indent = self.indent + 1
      self.cov_branch(stmt.loc)
      self.emit_unwrap(tmp, uty, success)
      bind = stmt.bind
      sm = ty_myc(success)
      self.line("LOCAL :${bind} :${sm}")
      self.line("STORE")
      self.ensure_root(bind, success)
      self.emit_stmts(stmt.then_body, false)
      self.indent = self.indent - 1
      if stmt.else_body.size > 0 {
        self.line("ELSE")
        self.indent = self.indent + 1
        self.cov_branch(stmt.loc)
        self.emit_stmts(stmt.else_body, false)
        self.indent = self.indent - 1
      } else {
        if self.cov {
          self.line("ELSE")
          self.indent = self.indent + 1
          self.cov_branch(stmt.loc)
          self.indent = self.indent - 1
        }
      }
      self.indent = self.indent - 1
      self.line("ENDIF")
    }
  }

  pub fn emit_to_string(ty: Ty) {
    if ty.is_string {
      return
    }
    if ty.is_int {
      self.line("CALL :avant_str_from_int")
      return
    }
    if ty.is_int64 {
      self.line("CALL :avant_str_from_i64")
      return
    }
    if ty.is_uint64 {
      self.line("CALL :avant_str_from_u64")
      return
    }
    if ty.is_float {
      self.line("CALL :avant_str_from_float")
      return
    }
    if ty.is_bool {
      self.line("AS :i32")
      self.line("CALL :avant_str_from_bool")
    }
  }

  pub fn emit_interp(expr: Expr) {
    if expr.parts.size == 2 {
      head = expr.parts[0]
      tail = expr.parts[1]
      if text = head.text {
        if inner = tail.expr {
          if expr_ty(inner).is_int {
            self.emit_expr(inner)
            ntmp = self.new_temp
            self.line("LOCAL :${ntmp} :i32")
            self.line("STORE")
            self.line("LOCAL :${ntmp}")
            q = myc_quote(text)
            self.line("PUSH ${q}")
            self.line("CALL :avant_str_cat_i32")
            return
          }
        }
      }
    }
    pieces: Array(String) = []
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      skip = true
      if text = part.text {
        if text.size == 0 {
        } else {
          q = myc_quote(text)
          self.line("PUSH ${q}")
          skip = false
        }
      } else {
        if inner = part.expr {
          self.emit_expr(inner)
          self.emit_to_string(expr_ty(inner))
          skip = false
        }
      }
      if skip {
      } else {
        tmp = self.new_temp
        self.line("LOCAL :${tmp} :ptr<u8>")
        self.line("STORE")
        self.ensure_root(tmp, ty_string())
        pieces.push(tmp)
      }
      i = i + 1
    }
    if pieces.size == 0 {
      self.line("PUSH \"\"")
      return
    }
    acc = pieces[0]
    i = 1
    while i < pieces.size {
      p = pieces[i]
      self.line("LOCAL :${p}")
      self.line("LOCAL :${acc}")
      self.line("CALL :avant_str_concat")
      acc = self.new_temp
      self.line("LOCAL :${acc} :ptr<u8>")
      self.line("STORE")
      self.ensure_root(acc, ty_string())
      i = i + 1
    }
    self.line("LOCAL :${acc}")
  }

  pub fn emit_expr(expr: Expr) {
    k = expr.kind
    switch k {
      case 1 {
        self.emit_int_literal(expr)
      }
      case 2 {
        if expr.value_str.size > 0 {
          lit = myc_float_literal(expr.value_str)
          self.line("PUSH ${lit}")
        } else {
          self.line("PUSH 0.0")
        }
      }
      case 3 {
        q = myc_quote(expr.value_str)
        self.line("PUSH ${q}")
      }
      case 4 {
        if expr.bool_val {
          self.line("PUSH true")
        } else {
          self.line("PUSH false")
        }
      }
      case 15 {
        self.line("PUSH 0")
      }
      case 5 {
        if expr.fn_ref {
          self.emit_fn_ref(expr)
        } else {
          self.emit_lvalue(expr)
        }
      }
      case 20 {
        self.emit_lambda(expr)
      }
      case 9 {
        if expr.method_call {
          if obj = expr.object {
            object_ty = expr_ty(obj)
            if object_ty.is_join {
              self.emit_expr(obj)
              self.line("CALL :avant_join")
            } else if object_ty.is_array {
              if str_eq(expr.ident, "pop") {
                self.emit_array_pop(obj, object_ty)
              } else if str_eq(expr.ident, "sort") {
                self.emit_expr(obj)
                self.line("CALL :avant_array_sort_i32")
              } else if str_eq(expr.ident, "clear") {
                self.emit_array_clear(obj, object_ty)
              }
            } else if object_ty.is_float {
              self.emit_float_field(expr)
            } else if object_ty.is_integer {
              self.emit_int_field(expr)
            } else if object_ty.is_string {
              self.emit_expr(obj)
              if str_eq(expr.ident, "to_f") {
                self.line("CALL :avant_str_to_f")
              } else if str_eq(expr.ident, "to_i") {
                self.line("CALL :avant_str_to_i")
              }
            } else if object_ty.is_buf {
              self.emit_expr(obj)
              if str_eq(expr.ident, "to_s") {
                self.line("CALL :avant_buf_to_str")
              } else if str_eq(expr.ident, "clear") {
                self.line("CALL :avant_buf_clear")
              }
            } else if object_ty.is_hash {
              self.emit_expr(obj)
              if str_eq(expr.ident, "clear") {
                self.line("CALL :avant_hash_clear")
              } else if str_eq(expr.ident, "size") {
                self.line("CALL :avant_hash_size")
              }
            } else {
              empty: Array(Expr) = []
              name = expr.resolved
              if name.size == 0 {
                name = "${object_ty.name}__${emit_op_name(expr.ident)}"
              }
              self.emit_method_invoke(obj, name, empty)
            }
          }
        } else {
          if obj = expr.object {
            object_ty = expr_ty(obj)
            if object_ty.is_string {
              if str_eq(expr.ident, "size") {
                self.emit_expr(obj)
                self.line("CALL :avant_str_size")
              } else if str_eq(expr.ident, "to_f") {
                self.emit_expr(obj)
                self.line("CALL :avant_str_to_f")
              } else if str_eq(expr.ident, "to_i") {
                self.emit_expr(obj)
                self.line("CALL :avant_str_to_i")
              } else {
                self.emit_lvalue(expr)
              }
            } else if object_ty.is_hash {
              if str_eq(expr.ident, "size") {
                self.emit_expr(obj)
                self.line("CALL :avant_hash_size")
              } else if str_eq(expr.ident, "clear") {
                self.emit_expr(obj)
                self.line("CALL :avant_hash_clear")
              } else {
                self.emit_lvalue(expr)
              }
            } else if object_ty.is_buf {
              if str_eq(expr.ident, "size") {
                self.emit_expr(obj)
                self.line("CALL :avant_buf_size")
              } else {
                self.emit_lvalue(expr)
              }
            } else {
              self.emit_lvalue(expr)
            }
          } else {
            self.emit_lvalue(expr)
          }
        }
      }
      case 10 {
        self.emit_lvalue(expr)
      }
      case 7 {
        self.emit_unary(expr)
      }
      case 8 {
        self.emit_binary(expr)
      }
      case 6 {
        self.emit_call(expr)
      }
      case 11 {
        self.emit_struct_literal(expr)
      }
      case 12 {
        self.emit_array_literal(expr)
      }
      case 13 {
        self.emit_array_new(expr)
      }
      case 14 {
        self.emit_hash_new(expr)
      }
      case 18 {
        self.emit_switch(expr)
      }
      case 16 {
        self.emit_try(expr)
      }
      case 17 {
        self.emit_interp(expr)
      }
      else {
      }
    }
  }

  pub fn emit_lvalue(expr: Expr) {
    if expr.kind == ex_name() {
      if self.place_name.size > 0 {
        if str_eq(expr.ident, self.place_name) {
          self.line("LOCAL :${self.place_holder}")
          self.line("DEREF")
          self.line("FIELD ${self.place_field}")
          return
        }
      }
      if expr.implicit_field {
        self.emit_self_field(expr.ident)
        return
      }
      ci = self.cap_index(expr.ident)
      if ci >= 0 {
        self.emit_cap_lvalue(ci)
        return
      }
      if self.name_is_boxed(expr.ident) {
        self.emit_box_lvalue(expr.ident, expr_ty(expr))
        return
      }
      if self.is_struct_self(expr.ident) {
        if st = self.self_ty {
          m = ty_self_ptr_myc(st)
          self.line("LOCAL :${expr.ident} :${m}")
          self.line("DEREF")
          return
        }
      }
      ty = expr_ty(expr)
      m = ty_myc(ty)
      self.line("LOCAL :${expr.ident} :${m}")
      return
    }
    if expr.kind == ex_field() {
      self.emit_field_lvalue(expr)
      return
    }
    if expr.kind == ex_index() {
      self.emit_index_lvalue(expr)
      return
    }
    self.emit_expr(expr)
  }

  pub fn emit_field_lvalue(expr: Expr) {
    if obj = expr.object {
      object_ty = expr_ty(obj)
      if object_ty.is_array {
        self.emit_expr(obj)
        self.line("DEREF")
        self.line("FIELD 1")
        return
      }
      if object_ty.is_class {
        self.emit_expr(obj)
        self.line("DEREF")
        fi = object_ty.field_index(expr.ident)
        self.line("FIELD ${fi}")
        return
      }
      if object_ty.is_ptr {
        if inner = object_ty.inner {
          if inner.is_clayout {
            self.emit_expr(obj)
            self.line("DEREF")
            fi = inner.field_index(expr.ident)
            self.line("FIELD ${fi}")
            return
          }
        }
      }
      self.emit_lvalue(obj)
      fi = object_ty.field_index(expr.ident)
      self.line("FIELD ${fi}")
    }
  }

  // A pointer local is a volatile GC slot, so an index reloads the array
  // and its buffer every iteration. Across a loop that cannot collect,
  // a scalar buffer is kept in an i64, which is not a GC slot. The
  // single-mutator path uses that i64. The buffer slot is rooted once
  // before the loop. A second thread reloads that slot. The shared flag
  // load is volatile in myc-llvm, so the check stays in the loop.
  pub fn begin_loop_hoists(stmt: Stmt): Int {
    if self.loop_may_collect(stmt) {
      return 0
    }
    names = self.plan_loop_hoists(stmt)
    i = 0
    while i < names.size {
      self.emit_buf_hoist(names[i])
      i = i + 1
    }
    names.size
  }

  pub fn end_loop_hoists(n: Int) {
    left = n
    while left > 0 {
      self.hoist_names.pop
      self.hoist_bits.pop
      self.hoist_ptrs.pop
      self.hoist_ems.pop
      left = left - 1
    }
  }

  pub fn plan_loop_hoists(stmt: Stmt): Array(String) {
    found: Array(String) = []
    assigned = self.loop_assigned(stmt)
    if c = stmt.cond {
      self.collect_hoist_names(c, assigned, found)
    }
    self.collect_hoist_stmts(stmt.body, assigned, found)
    found
  }

  pub fn collect_hoist_stmts(body: Array(Stmt), assigned: Array(String), found: Array(String)) {
    i = 0
    while i < body.size {
      self.collect_hoist_stmt(body[i], assigned, found)
      i = i + 1
    }
  }

  pub fn collect_hoist_stmt(stmt: Stmt, assigned: Array(String), found: Array(String)) {
    if e = stmt.expr {
      self.collect_hoist_names(e, assigned, found)
    }
    if c = stmt.cond {
      self.collect_hoist_names(c, assigned, found)
    }
    if t = stmt.target {
      self.collect_hoist_names(t, assigned, found)
    }
    if v = stmt.value {
      self.collect_hoist_names(v, assigned, found)
    }
    self.collect_hoist_stmts(stmt.then_body, assigned, found)
    self.collect_hoist_stmts(stmt.else_body, assigned, found)
    self.collect_hoist_stmts(stmt.body, assigned, found)
  }

  pub fn collect_hoist_names(expr: Expr, assigned: Array(String), found: Array(String)) {
    if expr.kind == ex_index() {
      if arr = expr.left {
        if arr.kind == ex_name() {
          if arr.implicit_field {
          } else {
            if self.name_is_boxed(arr.ident) {
            } else {
              if self.cap_index(arr.ident) >= 0 {
              } else {
                container = expr_ty(arr)
                if container.is_array {
                  if e = container.inner {
                    if hoist_array_elem(e) {
                      if self.name_listed(arr.ident, assigned) {
                      } else {
                        if self.hoist_index(arr.ident) >= 0 {
                        } else {
                          if self.name_listed(arr.ident, found) {
                          } else {
                            found.push(arr.ident)
                            self.hoist_ems.push(ty_myc(e))
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    if inner = expr.inner {
      self.collect_hoist_names(inner, assigned, found)
    }
    if l = expr.left {
      self.collect_hoist_names(l, assigned, found)
    }
    if r = expr.right {
      self.collect_hoist_names(r, assigned, found)
    }
    if obj = expr.object {
      self.collect_hoist_names(obj, assigned, found)
    }
    if c = expr.cond {
      self.collect_hoist_names(c, assigned, found)
    }
    if recv = expr.receiver {
      self.collect_hoist_names(recv, assigned, found)
    }
    if sz = expr.size_expr {
      self.collect_hoist_names(sz, assigned, found)
    }
    i = 0
    while i < expr.args.size {
      self.collect_hoist_names(expr.args[i], assigned, found)
      i = i + 1
    }
    i = 0
    while i < expr.elems.size {
      self.collect_hoist_names(expr.elems[i], assigned, found)
      i = i + 1
    }
    i = 0
    while i < expr.field_exprs.size {
      self.collect_hoist_names(expr.field_exprs[i], assigned, found)
      i = i + 1
    }
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      if pe = part.expr {
        self.collect_hoist_names(pe, assigned, found)
      }
      i = i + 1
    }
    i = 0
    while i < expr.cases.size {
      self.collect_hoist_stmts(expr.cases[i].body, assigned, found)
      i = i + 1
    }
    self.collect_hoist_stmts(expr.else_body, assigned, found)
    if b = expr.block {
      self.collect_hoist_stmts(b.body, assigned, found)
    }
  }

  pub fn loop_assigned(stmt: Stmt): Array(String) {
    found: Array(String) = []
    if c = stmt.cond {
      self.collect_assigned_expr(c, found)
    }
    self.collect_assigned_stmts(stmt.body, found)
    found
  }

  pub fn collect_assigned_stmts(body: Array(Stmt), found: Array(String)) {
    i = 0
    while i < body.size {
      self.collect_assigned_stmt(body[i], found)
      i = i + 1
    }
  }

  pub fn collect_assigned_stmt(stmt: Stmt, found: Array(String)) {
    if stmt.bind.size > 0 {
      if self.name_listed(stmt.bind, found) {
      } else {
        found.push(stmt.bind)
      }
    }
    if t = stmt.target {
      if t.kind == ex_name() {
        if t.implicit_field {
        } else {
          if self.name_listed(t.ident, found) {
          } else {
            found.push(t.ident)
          }
        }
      }
    }
    self.collect_assigned_stmts(stmt.then_body, found)
    self.collect_assigned_stmts(stmt.else_body, found)
    self.collect_assigned_stmts(stmt.body, found)
    if e = stmt.expr {
      self.collect_assigned_expr(e, found)
    }
  }

  pub fn collect_assigned_expr(expr: Expr, found: Array(String)) {
    i = 0
    while i < expr.cases.size {
      self.collect_assigned_stmts(expr.cases[i].body, found)
      i = i + 1
    }
    self.collect_assigned_stmts(expr.else_body, found)
    if b = expr.block {
      self.collect_assigned_stmts(b.body, found)
    }
    if inner = expr.inner {
      self.collect_assigned_expr(inner, found)
    }
    if l = expr.left {
      self.collect_assigned_expr(l, found)
    }
    if r = expr.right {
      self.collect_assigned_expr(r, found)
    }
    if obj = expr.object {
      self.collect_assigned_expr(obj, found)
    }
    if c = expr.cond {
      self.collect_assigned_expr(c, found)
    }
    i = 0
    while i < expr.args.size {
      self.collect_assigned_expr(expr.args[i], found)
      i = i + 1
    }
    i = 0
    while i < expr.elems.size {
      self.collect_assigned_expr(expr.elems[i], found)
      i = i + 1
    }
  }

  pub fn loop_may_collect(stmt: Stmt): Bool {
    if c = stmt.cond {
      if self.expr_may_collect(c) {
        return true
      }
    }
    self.stmts_may_collect(stmt.body)
  }

  pub fn stmts_may_collect(body: Array(Stmt)): Bool {
    i = 0
    while i < body.size {
      if self.stmt_may_collect(body[i]) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn stmt_may_collect(stmt: Stmt): Bool {
    if e = stmt.expr {
      if self.expr_may_collect(e) {
        return true
      }
    }
    if c = stmt.cond {
      if self.expr_may_collect(c) {
        return true
      }
    }
    if t = stmt.target {
      if self.expr_may_collect(t) {
        return true
      }
    }
    if v = stmt.value {
      if self.expr_may_collect(v) {
        return true
      }
    }
    if self.stmts_may_collect(stmt.then_body) {
      return true
    }
    if self.stmts_may_collect(stmt.else_body) {
      return true
    }
    self.stmts_may_collect(stmt.body)
  }

  pub fn expr_may_collect(expr: Expr): Bool {
    k = expr.kind
    if k == ex_call() {
      if self.call_may_collect(expr) {
        return true
      }
    }
    if k == ex_lambda() {
      return true
    }
    if k == ex_array() {
      return true
    }
    if k == ex_array_new() {
      return true
    }
    if k == ex_hash_new() {
      return true
    }
    if k == ex_interp() {
      return true
    }
    if k == ex_splice() {
      return true
    }
    if k == ex_binary() {
      if expr.resolved.size > 0 {
        return true
      }
      if l = expr.left {
        if expr_ty(l).is_string {
          return true
        }
      }
    }
    if k == ex_field() {
      if expr.method_call {
        if self.leaf_walk == 1 {
          if self.field_call_blocks(expr) {
            return true
          }
        } else {
          return true
        }
      }
    }
    if inner = expr.inner {
      if self.expr_may_collect(inner) {
        return true
      }
    }
    if l = expr.left {
      if self.expr_may_collect(l) {
        return true
      }
    }
    if r = expr.right {
      if self.expr_may_collect(r) {
        return true
      }
    }
    if obj = expr.object {
      if self.expr_may_collect(obj) {
        return true
      }
    }
    if c = expr.cond {
      if self.expr_may_collect(c) {
        return true
      }
    }
    if recv = expr.receiver {
      if self.expr_may_collect(recv) {
        return true
      }
    }
    if sz = expr.size_expr {
      if self.expr_may_collect(sz) {
        return true
      }
    }
    i = 0
    while i < expr.args.size {
      if self.expr_may_collect(expr.args[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.elems.size {
      if self.expr_may_collect(expr.elems[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.field_exprs.size {
      if self.expr_may_collect(expr.field_exprs[i]) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      if pe = part.expr {
        if self.expr_may_collect(pe) {
          return true
        }
      }
      i = i + 1
    }
    i = 0
    while i < expr.cases.size {
      if self.stmts_may_collect(expr.cases[i].body) {
        return true
      }
      i = i + 1
    }
    if self.stmts_may_collect(expr.else_body) {
      return true
    }
    if b = expr.block {
      if self.stmts_may_collect(b.body) {
        return true
      }
    }
    false
  }

  pub fn call_may_collect(expr: Expr): Bool {
    if self.leaf_walk == 1 {
      return self.call_blocks_leaf(expr)
    }
    if expr.indirect {
      return true
    }
    if expr.fn_ref {
      return true
    }
    if expr.method_call {
      return true
    }
    name = expr.callee
    if name.size == 0 {
      name = expr.resolved
    }
    if name.size == 0 {
      return true
    }
    if self.runtime_leaf(name) {
      return false
    }
    if v = self.numeric_leaves.get(name) {
      return false
    }
    true
  }

  // True when this call can move a heap pointer. Hash lookup and
  // integer casts do not. The name is the emit name when the callee
  // is one of ours still in the open set.
  pub fn call_blocks_leaf(expr: Expr): Bool {
    if expr.indirect {
      return true
    }
    if expr.fn_ref {
      return true
    }
    if recv = expr.receiver {
      if self.receiver_stays_put(expr_ty(recv), expr.callee) {
        return false
      }
    }
    if self.name_stays_put(expr.callee) {
      return false
    }
    if self.name_stays_put(expr.resolved) {
      return false
    }
    true
  }

  pub fn field_call_blocks(expr: Expr): Bool {
    if obj = expr.object {
      if self.receiver_stays_put(expr_ty(obj), expr.ident) {
        return false
      }
    }
    if self.name_stays_put(expr.resolved) {
      return false
    }
    true
  }

  pub fn name_stays_put(name: String): Bool {
    if name.size == 0 {
      return false
    }
    if self.runtime_leaf(name) {
      return true
    }
    if v = self.numeric_leaves.get(name) {
      return true
    }
    if v = self.leaf_open.get(name) {
      if v == 1 {
        return true
      }
    }
    false
  }

  pub fn receiver_stays_put(ty: Ty, name: String): Bool {
    if ty.is_hash {
      if str_eq(name, "get") {
        return true
      }
      if str_eq(name, "size") {
        return true
      }
      if str_eq(name, "clear") {
        return true
      }
      if str_eq(name, "delete") {
        return true
      }
      return false
    }
    if ty.is_integer {
      if str_eq(name, "to_i") {
        return true
      }
      if str_eq(name, "to_i64") {
        return true
      }
      if str_eq(name, "to_u64") {
        return true
      }
      if str_eq(name, "to_f") {
        return true
      }
      if str_eq(name, "abs") {
        return true
      }
      return false
    }
    if ty.is_float {
      if str_eq(name, "sqrt") {
        return true
      }
      if str_eq(name, "abs") {
        return true
      }
      if str_eq(name, "floor") {
        return true
      }
      if str_eq(name, "to_i") {
        return true
      }
      return false
    }
    if ty.is_array {
      if str_eq(name, "each") {
        return true
      }
      return false
    }
    false
  }

  pub fn runtime_leaf(name: String): Bool {
    if str_eq(name, "avant_gc_root") {
      return true
    }
    if str_eq(name, "avant_gc_reload") {
      return true
    }
    if str_eq(name, "avant_gc_enter") {
      return true
    }
    if str_eq(name, "avant_gc_leave") {
      return true
    }
    if str_eq(name, "avant_type_map") {
      return true
    }
    if str_eq(name, "avant_barrier") {
      return true
    }
    if str_eq(name, "avant_cov_hit") {
      return true
    }
    if str_eq(name, "avant_cov_init") {
      return true
    }
    if str_eq(name, "avant_pin") {
      return true
    }
    if str_eq(name, "avant_is_heap") {
      return true
    }
    if str_eq(name, "avant_exp") {
      return true
    }
    // The call in source is `exp`, rewritten to avant_exp. It does not
    // allocate. Naming only the runtime symbol left calculate_output
    // as a collecting frame.
    if str_eq(name, "exp") {
      return true
    }
    if str_eq(name, "avant_array_get_ptr") {
      return true
    }
    if str_eq(name, "avant_array_set_ptr") {
      return true
    }
    if str_eq(name, "avant_array_pop_ptr") {
      return true
    }
    if str_eq(name, "printf") {
      return true
    }
    if str_eq(name, "memset") {
      return true
    }
    if str_eq(name, "memcpy") {
      return true
    }
    if str_eq(name, "memmove") {
      return true
    }
    if str_eq(name, "malloc") {
      return true
    }
    if str_eq(name, "calloc") {
      return true
    }
    if str_eq(name, "free") {
      return true
    }
    false
  }

  pub fn name_listed(name: String, names: Array(String)): Bool {
    i = 0
    while i < names.size {
      if str_eq(names[i], name) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn hoist_index(name: String): Int {
    i = 0
    while i < self.hoist_names.size {
      if str_eq(self.hoist_names[i], name) {
        return i
      }
      i = i + 1
    }
    0 - 1
  }

  pub fn emit_buf_hoist(name: String) {
    hi = self.hoist_names.size
    em = self.hoist_ems[hi]
    self.line("LOCAL :${name}")
    self.line("DEREF")
    self.line("FIELD 0")
    ptr = self.new_temp
    self.line("LOCAL :${ptr} :ptr<${em}>")
    self.line("STORE")
    self.line("LOCAL :${ptr}")
    self.line("AS :i64")
    bits = self.new_temp
    self.line("LOCAL :${bits} :i64")
    self.line("STORE")
    if self.cur_leaf == 0 {
      self.emit_ptr_root(ptr)
    }
    self.hoist_names.push(name)
    self.hoist_bits.push(bits)
    self.hoist_ptrs.push(ptr)
  }

  pub fn emit_hoisted_index(ix: Expr, hi: Int) {
    em = self.hoist_ems[hi]
    bits = self.hoist_bits[hi]
    ptr = self.hoist_ptrs[hi]
    self.emit_expr(ix)
    ixt = self.new_temp
    self.line("LOCAL :${ixt} :i32")
    self.line("STORE")
    addr = self.new_temp
    if self.may_share {
      self.line("PUSH 0")
      self.line("GLOBAL :g_avant_shared")
      self.line("BINARY :not_eq")
      self.line("IF")
      self.indent = self.indent + 1
      self.line("THEN")
      self.indent = self.indent + 1
      self.line("LOCAL :${ptr}")
      self.line("LOCAL :${ixt}")
      self.line("STACK :swap2")
      self.line("BINARY :add")
      self.line("AS :i64")
      self.line("LOCAL :${addr} :i64")
      self.line("STORE")
      self.indent = self.indent - 1
      self.line("ELSE")
      self.indent = self.indent + 1
      self.line("LOCAL :${bits}")
      self.line("AS :ptr<${em}>")
      self.line("LOCAL :${ixt}")
      self.line("STACK :swap2")
      self.line("BINARY :add")
      self.line("AS :i64")
      self.line("LOCAL :${addr} :i64")
      self.line("STORE")
      self.indent = self.indent - 1
      self.indent = self.indent - 1
      self.line("ENDIF")
    } else {
      self.line("LOCAL :${bits}")
      self.line("AS :ptr<${em}>")
      self.line("LOCAL :${ixt}")
      self.line("STACK :swap2")
      self.line("BINARY :add")
      self.line("AS :i64")
      self.line("LOCAL :${addr} :i64")
      self.line("STORE")
    }
    self.line("LOCAL :${addr}")
    self.line("AS :ptr<${em}>")
    self.line("DEREF")
  }

  pub fn emit_index_lvalue(expr: Expr) {
    if arr = expr.left {
      if ix = expr.right {
        container = expr_ty(arr)
        if container.is_string {
          self.emit_expr(ix)
          ixt = self.new_temp
          self.line("LOCAL :${ixt} :i32")
          self.line("STORE")
          self.emit_expr(arr)
          st = self.new_temp
          self.line("LOCAL :${st} :ptr<u8>")
          self.line("STORE")
          self.line("LOCAL :${ixt}")
          self.line("LOCAL :${st}")
          self.line("BINARY :add")
          self.line("DEREF")
          self.line("TO :i32")
          return
        }
        if container.is_hash {
          self.emit_hash_get(expr, container)
          return
        }
        array_ty = container
        if e = array_ty.inner {
          em = ty_myc(e)
          if arr.kind == ex_name() {
            if arr.implicit_field {
            } else {
              hi = self.hoist_index(arr.ident)
              if hi >= 0 {
                self.emit_hoisted_index(ix, hi)
                return
              }
            }
          }
          self.emit_expr(ix)
          ixt = self.new_temp
          self.line("LOCAL :${ixt} :i32")
          self.line("STORE")
          self.emit_expr(arr)
          self.line("DEREF")
          self.line("FIELD 0")
          ptr_tmp = self.new_temp
          self.line("LOCAL :${ptr_tmp} :ptr<${em}>")
          self.line("STORE")
          self.emit_root_if_shared(ptr_tmp)
          self.line("LOCAL :${ixt}")
          self.line("LOCAL :${ptr_tmp}")
          self.line("BINARY :add")
          self.line("DEREF")
        } else {
          self.emit_expr(arr)
          self.line("DEREF")
          self.line("FIELD 0")
          ptr_tmp = self.new_temp
          self.line("LOCAL :${ptr_tmp} :ptr<i32>")
          self.line("STORE")
          self.emit_expr(ix)
          self.line("LOCAL :${ptr_tmp}")
          self.line("BINARY :add")
          self.line("DEREF")
        }
      }
    }
  }

  pub fn emit_struct_literal(expr: Expr) {
    ty = expr_ty(expr)
    n = ty.fields.size
    slots: Array(String) = []
    i = 0
    while i < n {
      slots.push("")
      i = i + 1
    }
    i = 0
    while i < expr.field_names.size {
      fname = expr.field_names[i]
      value = expr.field_exprs[i]
      fi = ty.field_index(fname)
      self.emit_expr(value)
      tmp = self.new_temp
      m = ty_myc(ty.fields[fi].ty)
      self.line("LOCAL :${tmp} :${m}")
      self.line("STORE")
      slots[fi] = tmp
      i = i + 1
    }
    i = n - 1
    while i >= 0 {
      slot = slots[i]
      self.line("LOCAL :${slot}")
      i = i - 1
    }
    m = ty_myc(ty)
    self.line("CREATE :${m}")
  }

  pub fn emit_alloc_sizeof(layout: String, type_id: Int) {
    self.line("PUSH ${type_id} :u32")
    self.line("SIZEOF :${layout}")
    self.line("CALL :avant_alloc")
  }

  pub fn emit_alloc_count(elem: Ty) {
    self.line("AS :u64")
    em = ty_myc(elem)
    self.line("SIZEOF :${em}")
    self.line("BINARY :mul")
    tid = array_type_id(elem)
    self.line("PUSH ${tid} :u32")
    self.line("STACK :swap2")
    self.line("CALL :avant_alloc")
    self.line("AS :ptr<${em}>")
  }

  pub fn emit_array_header(ty: Ty, buf: String, size: String, cap: String) {
    layout = ty_layout_myc(ty)
    self.emit_alloc_sizeof(layout, 1022)
    m = ty_myc(ty)
    self.line("AS :${m}")
    arr = self.new_temp
    self.line("LOCAL :${arr} :${m}")
    self.line("STORE")
    self.ensure_root(arr, ty)
    self.line("LOCAL :${buf}")
    self.line("LOCAL :${arr}")
    self.line("DEREF")
    self.line("FIELD 0")
    self.line("STORE")
    self.line("LOCAL :${size}")
    self.line("LOCAL :${arr}")
    self.line("DEREF")
    self.line("FIELD 1")
    self.line("STORE")
    self.line("LOCAL :${cap}")
    self.line("LOCAL :${arr}")
    self.line("DEREF")
    self.line("FIELD 2")
    self.line("STORE")
    self.line("LOCAL :${arr}")
    self.line("CALL :avant_barrier")
    self.line("LOCAL :${arr}")
  }

  pub fn emit_array_literal(expr: Expr) {
    ty = expr_ty(expr)
    n = expr.elems.size
    ptr_tmp = self.new_temp
    self.line("PUSH ${n}")
    if e = ty.inner {
      self.emit_alloc_count(e)
      em = ty_myc(e)
      self.line("LOCAL :${ptr_tmp} :ptr<${em}>")
    } else {
      self.emit_alloc_count(ty_int())
      self.line("LOCAL :${ptr_tmp} :ptr<i32>")
    }
    self.line("STORE")
    self.emit_ptr_root(ptr_tmp)
    i = 0
    while i < expr.elems.size {
      el = expr.elems[i]
      self.emit_expr(el)
      if e = ty.inner {
        self.emit_coerce(expr_ty(el), e)
      }
      self.line("PUSH ${i}")
      self.line("LOCAL :${ptr_tmp}")
      self.line("BINARY :add")
      self.line("DEREF")
      self.line("STORE")
      i = i + 1
    }
    n_tmp = self.new_temp
    self.line("PUSH ${n}")
    self.line("LOCAL :${n_tmp} :i32")
    self.line("STORE")
    self.emit_array_header(ty, ptr_tmp, n_tmp, n_tmp)
  }

  pub fn emit_array_new(expr: Expr) {
    ty = expr_ty(expr)
    len_tmp = self.new_temp
    ptr_tmp = self.new_temp
    if size = expr.size_expr {
      self.emit_expr(size)
    }
    self.line("LOCAL :${len_tmp} :i32")
    self.line("STORE")
    self.line("LOCAL :${len_tmp}")
    if e = ty.inner {
      self.emit_alloc_count(e)
      em = ty_myc(e)
      self.line("LOCAL :${ptr_tmp} :ptr<${em}>")
    } else {
      self.emit_alloc_count(ty_int())
      self.line("LOCAL :${ptr_tmp} :ptr<i32>")
    }
    self.line("STORE")
    self.emit_ptr_root(ptr_tmp)
    self.emit_array_header(ty, ptr_tmp, len_tmp, len_tmp)
  }

  pub fn emit_switch(expr: Expr) {
    result_ty = expr_ty(expr)
    if c = expr.cond {
      self.emit_expr(c)
      ct = expr_ty(c)
      if ct.is_bool {
        self.line("AS :i32")
      }
    }
    has_dest = false
    dest = ""
    if result_ty.is_void {
    } else {
      has_dest = true
      dest = self.new_temp
    }
    self.line("SWITCH")
    self.indent = self.indent + 1
    i = 0
    while i < expr.cases.size {
      arm = expr.cases[i]
      j = 0
      while j < arm.labels.size {
        lab = arm.labels[j]
        self.line("CASE ${lab}")
        self.indent = self.indent + 1
        self.cov_branch(arm.loc)
        self.emit_switch_arm(arm.body, has_dest, dest, result_ty)
        self.indent = self.indent - 1
        j = j + 1
      }
      i = i + 1
    }
    if expr.has_else {
      self.line("ELSE")
      self.indent = self.indent + 1
      self.cov_branch(expr.loc)
      self.emit_switch_arm(expr.else_body, has_dest, dest, result_ty)
      self.indent = self.indent - 1
    } else {
      if self.cov {
        self.line("ELSE")
        self.indent = self.indent + 1
        self.cov_branch(expr.loc)
        self.indent = self.indent - 1
      }
    }
    self.indent = self.indent - 1
    self.line("ENDSWITCH")
    if has_dest {
      self.line("LOCAL :${dest}")
    }
  }

  pub fn emit_switch_arm(body: Array(Stmt), has_dest: Bool, dest: String, result_ty: Ty) {
    if has_dest {
      if body.size == 0 {
        self.emit_zero(result_ty)
        m = ty_myc(result_ty)
        self.line("LOCAL :${dest} :${m}")
        self.line("STORE")
        self.ensure_root(dest, result_ty)
        return
      }
      last = body.size - 1
      i = 0
      while i < body.size {
        stmt = body[i]
        if i == last {
          if stmt.kind == st_expr() {
            if e = stmt.expr {
              self.emit_expr(e)
              self.emit_coerce(expr_ty(e), result_ty)
              m = ty_myc(result_ty)
              self.line("LOCAL :${dest} :${m}")
              self.line("STORE")
              self.ensure_root(dest, result_ty)
            }
          } else {
            self.emit_stmt(stmt, false)
          }
        } else {
          self.emit_stmt(stmt, false)
        }
        i = i + 1
      }
    } else {
      self.emit_stmts(body, false)
    }
  }

  pub fn emit_zero(ty: Ty) {
    if ty.is_fn {
      code = fn_code_myc(ty)
      layout = fn_layout_name(ty)
      self.line("PUSH 0")
      self.line("AS \"${code}\"")
      self.line("PUSH 0")
      self.line("AS :ptr<void>")
      self.line("CREATE :${layout}")
      return
    }
    if ty.is_float {
      self.line("PUSH 0 :f64")
      return
    }
    if ty.is_int64 {
      self.line("PUSH 0 :i64")
      return
    }
    if ty.is_uint64 {
      self.line("PUSH 0 :u64")
      return
    }
    if ty.is_bool {
      self.line("PUSH false")
      return
    }
    self.line("PUSH 0")
    if ty.is_int {
      return
    }
    if ty.is_nil {
      return
    }
    m = ty_myc(ty)
    self.line("AS :${m}")
  }

  pub fn emit_int_literal(expr: Expr) {
    ty = expr_ty(expr)
    if ty.is_float {
      self.line("PUSH ${expr.int_bits} :f64")
    } else if ty.is_uint64 {
      self.line("PUSH ${expr.int_bits} :u64")
    } else if ty.is_int64 {
      self.line("PUSH ${expr.int_bits} :i64")
    } else {
      self.line("PUSH ${expr.int_bits}")
    }
  }

  pub fn emit_unary(expr: Expr) {
    if inner = expr.inner {
      self.emit_expr(inner)
    }
    op = expr.op
    if op == tk_minus() {
      self.line("UNARY :neg")
    } else if op == tk_bang() {
      self.line("UNARY :lnot")
    } else if op == tk_tilde() {
      self.line("UNARY :bnot")
    }
  }

  pub fn emit_binary(expr: Expr) {
    if expr.resolved.size > 0 {
      if l = expr.left {
        if r = expr.right {
          args: Array(Expr) = []
          args.push(r)
          self.emit_method_invoke(l, expr.resolved, args)
          return
        }
      }
    }
    if expr.op == tk_amp_amp() {
      self.emit_logical(expr)
      return
    }
    if expr.op == tk_pipe_pipe() {
      self.emit_logical(expr)
      return
    }
    if l = expr.left {
      left_ty = expr_ty(l)
      if left_ty.is_string {
        self.emit_string_binary(expr)
        return
      }
      tmp = self.new_temp
      self.emit_expr(l)
      m = ty_myc(left_ty)
      self.line("LOCAL :${tmp} :${m}")
      self.line("STORE")
      if r = expr.right {
        self.emit_expr(r)
        right_ty = expr_ty(r)
        if left_ty.is_uint64 {
          if right_ty.is_int {
            if expr.op == tk_less_less() {
              self.line("AS :${m}")
            } else if expr.op == tk_greater_greater() {
              self.line("AS :${m}")
            }
          }
        } else if left_ty.is_int64 {
          if right_ty.is_int {
            if expr.op == tk_less_less() {
              self.line("AS :${m}")
            } else if expr.op == tk_greater_greater() {
              self.line("AS :${m}")
            }
          }
        }
      }
      self.line("LOCAL :${tmp}")
      op = myc_binop(expr.op)
      if expr.op == tk_greater_greater() {
        if left_ty.is_uint64 {
          op = "shr"
        }
      }
      self.line("BINARY :${op}")
    }
  }

  pub fn emit_logical(expr: Expr) {
    dest = self.new_temp
    if l = expr.left {
      self.emit_expr(l)
    }
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.cov_branch(expr.loc)
    if expr.op == tk_amp_amp() {
      if r = expr.right {
        self.emit_expr(r)
      }
    } else {
      self.line("PUSH true")
    }
    self.line("LOCAL :${dest} :bool")
    self.line("STORE")
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    self.cov_branch(expr.loc)
    if expr.op == tk_amp_amp() {
      self.line("PUSH false")
    } else {
      if r = expr.right {
        self.emit_expr(r)
      }
    }
    self.line("LOCAL :${dest} :bool")
    self.line("STORE")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.line("LOCAL :${dest}")
  }

  pub fn emit_string_binary(expr: Expr) {
    if l = expr.left {
      if r = expr.right {
        if expr.op == tk_plus() {
          self.emit_expr(l)
          a = self.new_temp
          self.line("LOCAL :${a} :ptr<u8>")
          self.line("STORE")
          self.ensure_root(a, ty_string())
          self.emit_expr(r)
          self.line("LOCAL :${a}")
          self.line("CALL :avant_str_concat")
          return
        }
        if expr.op == tk_eq_eq() {
          self.emit_expr(l)
          a = self.new_temp
          self.line("LOCAL :${a} :ptr<u8>")
          self.line("STORE")
          self.emit_expr(r)
          self.line("LOCAL :${a}")
          self.line("CALL :avant_str_eq")
          self.line("AS :bool")
          return
        }
        if expr.op == tk_not_eq() {
          self.emit_expr(l)
          a = self.new_temp
          self.line("LOCAL :${a} :ptr<u8>")
          self.line("STORE")
          self.emit_expr(r)
          self.line("LOCAL :${a}")
          self.line("CALL :avant_str_eq")
          self.line("PUSH 0")
          self.line("BINARY :eq")
        }
      }
    }
  }

  pub fn hash_set_func(ty: Ty): String {
    if k = ty.key {
      if k.is_int {
        return "avant_hash_set_i32k_i32"
      }
    }
    if v = ty.val {
      if v.is_string {
        return "avant_hash_set_str"
      }
    }
    "avant_hash_set_i32"
  }

  pub fn hash_get_func(ty: Ty): String {
    if k = ty.key {
      if k.is_int {
        return "avant_hash_get_i32k_i32"
      }
    }
    if v = ty.val {
      if v.is_string {
        return "avant_hash_get_str"
      }
    }
    "avant_hash_get_i32"
  }

  pub fn hash_del_func(ty: Ty): String {
    if k = ty.key {
      if k.is_int {
        return "avant_hash_del_i32k"
      }
    }
    "avant_hash_del"
  }

  pub fn emit_hash_new(expr: Expr) {
    ty = expr_ty(expr)
    val_kind = 0
    key_kind = 0
    if v = ty.val {
      if v.is_string {
        val_kind = 1
      }
    }
    if k = ty.key {
      if k.is_string {
        key_kind = 1
      }
    }
    self.line("PUSH ${val_kind}")
    self.line("PUSH ${key_kind}")
    self.line("CALL :avant_hash_new")
  }

  pub fn emit_hash_set(target: Expr, value: Expr, ty: Ty) {
    self.emit_expr(value)
    val = self.new_temp
    if v = ty.val {
      m = ty_myc(v)
      self.line("LOCAL :${val} :${m}")
      self.line("STORE")
      self.ensure_root(val, v)
    }
    if ix = target.right {
      self.emit_expr(ix)
    }
    key = self.new_temp
    if k = ty.key {
      m = ty_myc(k)
      self.line("LOCAL :${key} :${m}")
      self.line("STORE")
      self.ensure_root(key, k)
    }
    if arr = target.left {
      self.emit_expr(arr)
    }
    h = self.new_temp
    self.line("LOCAL :${h} :ptr<void>")
    self.line("STORE")
    self.ensure_root(h, ty)
    self.line("LOCAL :${val}")
    self.line("LOCAL :${key}")
    self.line("LOCAL :${h}")
    fn_name = self.hash_set_func(ty)
    self.line("CALL :${fn_name}")
  }

  pub fn emit_hash_get(expr: Expr, ty: Ty) {
    found = self.new_temp
    self.line("PUSH 0")
    self.line("LOCAL :${found} :i32")
    self.line("STORE")
    if ix = expr.right {
      self.emit_expr(ix)
    }
    key = self.new_temp
    if k = ty.key {
      m = ty_myc(k)
      self.line("LOCAL :${key} :${m}")
      self.line("STORE")
    }
    if arr = expr.left {
      self.emit_expr(arr)
    }
    h = self.new_temp
    self.line("LOCAL :${h} :ptr<void>")
    self.line("STORE")
    self.line("LOCAL :${found}")
    self.line("ADDR")
    self.line("LOCAL :${key}")
    self.line("LOCAL :${h}")
    fn_name = self.hash_get_func(ty)
    self.line("CALL :${fn_name}")
    self.emit_hash_get_wrap(ty, found)
  }

  pub fn emit_hash_get_wrap(ty: Ty, found: String) {
    val = self.new_temp
    want = ty_int()
    if v = ty.val {
      m = ty_myc(v)
      self.line("LOCAL :${val} :${m}")
      self.line("STORE")
      self.ensure_root(val, v)
      want = ty_nilable(v)
    }
    dest = self.new_temp
    self.line("LOCAL :${found}")
    self.line("PUSH 1")
    self.line("BINARY :eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.line("LOCAL :${val}")
    if v = ty.val {
      self.emit_wrap_union(v, want)
    }
    wm = ty_myc(want)
    self.line("LOCAL :${dest} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    self.emit_zero(ty_nil())
    self.emit_wrap_union(ty_nil(), want)
    self.line("LOCAL :${dest} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.line("LOCAL :${dest}")
  }

  pub fn emit_hash_method(expr: Expr, ty: Ty) {
    if str_eq(expr.callee, "clear") {
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      self.line("CALL :avant_hash_clear")
      return
    }
    if str_eq(expr.callee, "get") {
      idx = Expr.new(ex_index(), expr.loc)
      if recv = expr.receiver {
        idx.left = recv
      }
      if expr.args.size > 0 {
        idx.right = expr.args[0]
      }
      idx.ty = expr.ty
      self.emit_hash_get(idx, ty)
      return
    }
    if str_eq(expr.callee, "delete") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      key = self.new_temp
      if k = ty.key {
        m = ty_myc(k)
        self.line("LOCAL :${key} :${m}")
      } else {
        self.line("LOCAL :${key} :ptr<u8>")
      }
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      h = self.new_temp
      self.line("LOCAL :${h} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${key}")
      self.line("LOCAL :${h}")
      fn_name = self.hash_del_func(ty)
      self.line("CALL :${fn_name}")
      return
    }
    if str_eq(expr.callee, "inc_slice") {
      if expr.args.size > 2 {
        self.emit_expr(expr.args[2])
      }
      stop = self.new_temp
      self.line("LOCAL :${stop} :i32")
      self.line("STORE")
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      start = self.new_temp
      self.line("LOCAL :${start} :i32")
      self.line("STORE")
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      s = self.new_temp
      self.line("LOCAL :${s} :ptr<u8>")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      h = self.new_temp
      self.line("LOCAL :${h} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${stop}")
      self.line("LOCAL :${start}")
      self.line("LOCAL :${s}")
      self.line("LOCAL :${h}")
      self.line("CALL :avant_hash_inc_slice")
      return
    }
    if str_eq(expr.callee, "get_slice") {
      found = self.new_temp
      self.line("PUSH 0")
      self.line("LOCAL :${found} :i32")
      self.line("STORE")
      if expr.args.size > 2 {
        self.emit_expr(expr.args[2])
      }
      stop = self.new_temp
      self.line("LOCAL :${stop} :i32")
      self.line("STORE")
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      start = self.new_temp
      self.line("LOCAL :${start} :i32")
      self.line("STORE")
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      s = self.new_temp
      self.line("LOCAL :${s} :ptr<u8>")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      h = self.new_temp
      self.line("LOCAL :${h} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${found}")
      self.line("ADDR")
      self.line("LOCAL :${stop}")
      self.line("LOCAL :${start}")
      self.line("LOCAL :${s}")
      self.line("LOCAL :${h}")
      self.line("CALL :avant_hash_get_str_slice")
      self.emit_hash_get_wrap(ty, found)
      return
    }
    if str_eq(expr.callee, "get_concat") {
      found = self.new_temp
      self.line("PUSH 0")
      self.line("LOCAL :${found} :i32")
      self.line("STORE")
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      b = self.new_temp
      self.line("LOCAL :${b} :ptr<u8>")
      self.line("STORE")
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      a = self.new_temp
      self.line("LOCAL :${a} :ptr<u8>")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      h = self.new_temp
      self.line("LOCAL :${h} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${found}")
      self.line("ADDR")
      self.line("LOCAL :${b}")
      self.line("LOCAL :${a}")
      self.line("LOCAL :${h}")
      self.line("CALL :avant_hash_get_concat")
      self.emit_hash_get_wrap(ty, found)
    }
  }

  pub fn emit_array_method(expr: Expr, ty: Ty) {
    if str_eq(expr.callee, "push") {
      self.emit_array_push(expr, ty)
      return
    }
    if str_eq(expr.callee, "pop") {
      if recv = expr.receiver {
        self.emit_array_pop(recv, ty)
      }
      return
    }
    if str_eq(expr.callee, "each") {
      self.emit_array_each(expr, ty)
      return
    }
    if str_eq(expr.callee, "sort") {
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      self.line("CALL :avant_array_sort_i32")
      return
    }
    if str_eq(expr.callee, "clear") {
      if recv = expr.receiver {
        self.emit_array_clear(recv, ty)
      }
      return
    }
    if str_eq(expr.callee, "fill") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      self.line("CALL :avant_array_fill_i32")
      return
    }
    if str_eq(expr.callee, "reserve") {
      self.emit_array_reserve(expr, ty)
      return
    }
    if str_eq(expr.callee, "parallel") {
      self.emit_parallel(expr, ty)
    }
  }

  pub fn emit_array_clear(recv: Expr, ty: Ty) {
    self.emit_expr(recv)
    arr = self.new_temp
    m = ty_myc(ty)
    self.line("LOCAL :${arr} :${m}")
    self.line("STORE")
    self.ensure_root(arr, ty)
    self.line("PUSH 0")
    self.line("LOCAL :${arr}")
    self.line("DEREF")
    self.line("FIELD 1")
    self.line("STORE")
  }

  pub fn emit_array_reserve(expr: Expr, ty: Ty) {
    if recv = expr.receiver {
      self.emit_expr(recv)
    }
    arr = self.new_temp
    m = ty_myc(ty)
    self.line("LOCAL :${arr} :${m}")
    self.line("STORE")
    self.ensure_root(arr, ty)
    if e = ty.inner {
      tid = array_type_id(e)
      self.line("PUSH ${tid} :u32")
      em = ty_myc(e)
      self.line("SIZEOF :${em}")
      self.line("AS :u64")
    }
    if expr.args.size > 0 {
      self.emit_expr(expr.args[0])
    }
    self.line("LOCAL :${arr}")
    self.line("CALL :avant_array_reserve")
  }

  pub fn emit_array_pop(recv: Expr, ty: Ty) {
    self.emit_expr(recv)
    arr = self.new_temp
    m = ty_myc(ty)
    self.line("LOCAL :${arr} :${m}")
    self.line("STORE")
    self.ensure_root(arr, ty)
    if e = ty.inner {
      em = ty_myc(e)
      if heap_ptr_value(e) {
        self.line("LOCAL :${arr}")
        self.line("CALL :avant_array_pop_ptr")
        self.line("AS :${em}")
        return
      }
      self.line("SIZEOF :${em}")
      self.line("AS :u64")
      self.line("LOCAL :${arr}")
      self.line("CALL :avant_array_pop_slot")
      self.line("AS :ptr<${em}>")
      slot = self.new_temp
      self.line("LOCAL :${slot} :ptr<${em}>")
      self.line("STORE")
      self.emit_ptr_root(slot)
      self.line("LOCAL :${slot}")
      self.line("DEREF")
    }
  }

  pub fn emit_array_set_ptr(target: Expr, value: Expr) {
    if arr = target.left {
      if ix = target.right {
        array_ty = expr_ty(arr)
        if e = array_ty.inner {
          self.emit_expr(value)
          self.emit_coerce(expr_ty(value), e)
          val = self.new_temp
          em = ty_myc(e)
          self.line("LOCAL :${val} :${em}")
          self.line("STORE")
          self.ensure_root(val, e)
          self.emit_expr(arr)
          arrn = self.new_temp
          m = ty_myc(array_ty)
          self.line("LOCAL :${arrn} :${m}")
          self.line("STORE")
          self.ensure_root(arrn, array_ty)
          self.emit_expr(ix)
          ixt = self.new_temp
          self.line("LOCAL :${ixt} :i32")
          self.line("STORE")
          self.line("LOCAL :${val}")
          self.line("LOCAL :${ixt}")
          self.line("LOCAL :${arrn}")
          self.line("CALL :avant_array_set_ptr")
        }
      }
    }
  }

  pub fn emit_array_push(expr: Expr, ty: Ty) {
    if e = ty.inner {
      if e.is_int {
        if expr.args.size > 0 {
          self.emit_expr(expr.args[0])
          self.emit_coerce(expr_ty(expr.args[0]), e)
        }
        if recv = expr.receiver {
          self.emit_expr(recv)
        }
        self.line("CALL :avant_array_push_i32")
        return
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
        self.emit_coerce(expr_ty(expr.args[0]), e)
      }
      val = self.new_temp
      em = ty_myc(e)
      self.line("LOCAL :${val} :${em}")
      self.line("STORE")
      self.ensure_root(val, e)
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      arr = self.new_temp
      m = ty_myc(ty)
      self.line("LOCAL :${arr} :${m}")
      self.line("STORE")
      self.ensure_root(arr, ty)
      tid = array_type_id(e)
      if heap_ptr_value(e) {
        self.line("PUSH ${tid} :u32")
        self.line("LOCAL :${val}")
        self.line("LOCAL :${arr}")
        self.line("CALL :avant_array_push_ptr")
        return
      }
      self.line("PUSH ${tid} :u32")
      self.line("SIZEOF :${em}")
      self.line("AS :u64")
      self.line("LOCAL :${arr}")
      self.line("CALL :avant_array_push_slot")
      self.line("AS :ptr<${em}>")
      self.line("LOCAL :${val}")
      self.line("STACK :swap2")
      self.line("DEREF")
      self.line("STORE")
    }
  }

  pub fn emit_array_each(expr: Expr, ty: Ty) {
    if b = expr.block {
      pname = b.params[0]
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      arr = self.new_temp
      m = ty_myc(ty)
      self.line("LOCAL :${arr} :${m}")
      self.line("STORE")
      self.ensure_root(arr, ty)
      i = self.new_temp
      self.line("PUSH 0")
      self.line("LOCAL :${i} :i32")
      self.line("STORE")
      self.line("LOOP")
      self.indent = self.indent + 1
      self.line("COND")
      self.indent = self.indent + 1
      self.line("LOCAL :${arr}")
      self.line("DEREF")
      self.line("FIELD 1")
      self.line("LOCAL :${i}")
      self.line("BINARY :less")
      self.indent = self.indent - 1
      self.line("BODY")
      self.indent = self.indent + 1
      if e = ty.inner {
        em = ty_myc(e)
        buf = self.new_temp
        self.line("LOCAL :${arr}")
        self.line("DEREF")
        self.line("FIELD 0")
        self.line("LOCAL :${buf} :ptr<${em}>")
        self.line("STORE")
        self.line("LOCAL :${i}")
        self.line("LOCAL :${buf}")
        self.line("BINARY :add")
        self.line("DEREF")
        self.line("LOCAL :${pname} :${em}")
        self.line("STORE")
        self.ensure_root(pname, e)
      }
      self.emit_stmts(b.body, false)
      self.line("PUSH 1")
      self.line("LOCAL :${i}")
      self.line("BINARY :add")
      self.line("LOCAL :${i} :i32")
      self.line("STORE")
      self.indent = self.indent - 1
      self.indent = self.indent - 1
      self.line("ENDLOOP")
    }
  }

  pub fn emit_call(expr: Expr) {
    if expr.indirect {
      self.emit_indirect(expr)
      return
    }
    if expr.lib_name.size > 0 {
      self.emit_call_named(expr.callee, expr.args)
      return
    }
    if recv = expr.receiver {
      if str_eq(expr.callee, "new") {
        self.emit_ctor_call(expr, recv)
        return
      }
      rty = expr_ty(recv)
      if rty.is_float {
        self.emit_float_method(expr)
        return
      }
      if rty.is_integer {
        self.emit_int_method(expr)
        return
      }
      if rty.is_string {
        self.emit_string_method(expr)
        return
      }
      if rty.is_array {
        self.emit_array_method(expr, rty)
        return
      }
      if rty.is_hash {
        self.emit_hash_method(expr, rty)
        return
      }
      if rty.is_buf {
        self.emit_buf_method(expr)
        return
      }
      if rty.is_join {
        self.emit_join(expr)
        return
      }
      if str_eq(expr.callee, "with") {
        if str_eq(rty.origin, "Mutex") {
          self.emit_mutex_with(expr, rty)
          return
        }
      }
      self.emit_method_invoke(recv, expr.resolved, expr.args)
      return
    }
    if str_eq(expr.callee, "puts") {
      if expr.args.size > 0 {
        self.emit_puts(expr.args[0])
      }
      return
    }
    if str_eq(expr.callee, "spawn") {
      self.emit_spawn(expr)
      return
    }
    if str_eq(expr.callee, "avant_gate_new") {
      self.line("CALL :avant_gate_new")
      return
    }
    if self.is_gate_callee(expr.callee) {
      self.emit_args(expr.args)
      self.line("CALL :${expr.callee}")
      return
    }
    if str_eq(expr.callee, "now_ms") {
      self.line("CALL :avant_now_ms")
      return
    }
    if str_eq(expr.callee, "file_read") {
      self.emit_opt_cstr(expr, "avant_file_read")
      return
    }
    if str_eq(expr.callee, "file_write") {
      self.emit_call_named("avant_file_write", expr.args)
      return
    }
    if str_eq(expr.callee, "argv") {
      self.line("CALL :avant_argv")
      m = ty_myc(expr_ty(expr))
      self.line("AS :${m}")
      return
    }
    if str_eq(expr.callee, "process_run") {
      self.emit_process_run(expr)
      return
    }
    if str_eq(expr.callee, "process_run_out") {
      self.emit_process_run_out(expr)
      return
    }
    if str_eq(expr.callee, "env_get") {
      self.emit_opt_cstr(expr, "avant_env_get")
      return
    }
    if str_eq(expr.callee, "file_exists") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_file_exists")
      self.line("PUSH 1")
      self.line("BINARY :eq")
      return
    }
    if str_eq(expr.callee, "dir_list") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_dir_list")
      m = ty_myc(expr_ty(expr))
      self.line("AS :${m}")
      return
    }
    if str_eq(expr.callee, "now_us") {
      self.line("CALL :avant_now_us")
      return
    }
    if str_eq(expr.callee, "chr") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_str_from_byte")
      return
    }
    if str_eq(expr.callee, "repeat_byte") {
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_str_repeat_byte")
      return
    }
    if str_eq(expr.callee, "bytes_to_str") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_str_from_i32_bytes")
      return
    }
    if str_eq(expr.callee, "fmt_float") {
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_str_fmt_float")
      return
    }
    if str_eq(expr.callee, "str_to_f_slice") {
      if expr.args.size > 2 {
        self.emit_expr(expr.args[2])
      }
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_str_to_f_slice")
      return
    }
    if str_eq(expr.callee, "json_free") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_json_free")
      return
    }
    if str_eq(expr.callee, "b64_encode") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_b64_encode")
      return
    }
    if str_eq(expr.callee, "b64_decode") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_b64_decode")
      return
    }
    if str_eq(expr.callee, "b64_encode_buf") {
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_b64_encode_buf")
      return
    }
    if str_eq(expr.callee, "b64_decode_buf") {
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_b64_decode_buf")
      return
    }
    if str_eq(expr.callee, "zlib_compress") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_zlib_compress")
      return
    }
    if str_eq(expr.callee, "zlib_uncompress") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_zlib_uncompress")
      return
    }
    if str_eq(expr.callee, "sha256") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_sha256")
      return
    }
    if str_eq(expr.callee, "crc32_bytes") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_crc32_i32")
      return
    }
    if str_eq(expr.callee, "sha256_word0") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_sha256_word0")
      return
    }
    if str_eq(expr.callee, "re_count") {
      if expr.args.size == 3 {
        rid = self.re2c_call_id(expr.args[0], expr.args[2])
        if rid > 0 {
          self.emit_expr(expr.args[1])
          self.line("PUSH ${rid}")
          self.line("CALL :avant_re2c_count")
          return
        }
      }
      if expr.args.size > 2 {
        self.emit_expr(expr.args[2])
      }
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_re_count")
      return
    }
    if str_eq(expr.callee, "re_compile") {
      if expr.args.size == 2 {
        rid = self.re2c_call_id(expr.args[0], expr.args[1])
        if rid > 0 {
          self.line("PUSH ${rid}")
          self.line("CALL :avant_re2c_handle")
          return
        }
      }
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_re_compile")
      return
    }
    if str_eq(expr.callee, "re_find") {
      if expr.args.size > 2 {
        self.emit_expr(expr.args[2])
      }
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_re_find")
      return
    }
    if self.re_mark_callee(expr.callee) {
      self.line("CALL :avant_${expr.callee}")
      return
    }
    if str_eq(expr.callee, "hash_last_key") {
      self.line("CALL :avant_hash_last_key")
      return
    }
    if str_eq(expr.callee, "exp") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_exp")
      return
    }
    if str_eq(expr.callee, "sqrt") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("UNARY :sqrt")
      return
    }
    if str_eq(expr.callee, "json_root") {
      self.emit_json_root(expr)
      return
    }
    if str_eq(expr.callee, "json_get") {
      self.emit_json_obj_get(expr)
      return
    }
    if str_eq(expr.callee, "json_len") {
      self.emit_json_len(expr)
      return
    }
    if str_eq(expr.callee, "json_at") {
      self.emit_json_at(expr)
      return
    }
    if str_eq(expr.callee, "json_f64") {
      self.emit_json_f64(expr)
      return
    }
    if str_eq(expr.callee, "json_sum_f64") {
      self.emit_json_sum_f64(expr)
      return
    }
    if str_eq(expr.callee, "wide_op") {
      if expr.args.size > 4 {
        self.emit_expr(expr.args[4])
      }
      if expr.args.size > 3 {
        self.emit_expr(expr.args[3])
      }
      if expr.args.size > 2 {
        self.emit_expr(expr.args[2])
      }
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_wide_op")
      return
    }
    if str_eq(expr.callee, "wide_hi") {
      self.line("CALL :avant_wide_hi")
      return
    }
    if str_eq(expr.callee, "checksum_f64") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_checksum_f64")
      return
    }
    if str_eq(expr.callee, "checksum_str") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_checksum_str")
      return
    }
    if str_eq(expr.callee, "puts_u") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("PUSH \"%u\\n\"")
      self.line("PRINTF 1")
      return
    }
    if str_eq(expr.callee, "str_slice") {
      if expr.args.size > 2 {
        self.emit_expr(expr.args[2])
      }
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_str_slice")
      return
    }
    if str_eq(expr.callee, "buf_new") {
      if expr.args.size == 0 {
        self.line("PUSH 0")
      } else {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_buf_new")
      return
    }
    if str_eq(expr.callee, "json_parse") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_json_parse")
      return
    }
    if str_eq(expr.callee, "json_gen_body") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_json_gen_body")
      return
    }
    if str_eq(expr.callee, "json_gen_into") {
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_json_gen_into")
      return
    }
    if str_eq(expr.callee, "json_int") {
      self.emit_json_get(expr, false)
      return
    }
    if str_eq(expr.callee, "json_str") {
      self.emit_json_get(expr, true)
      return
    }
    if str_eq(expr.callee, "http_roundtrip") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      self.line("CALL :avant_http_roundtrip")
      return
    }
    name = expr.resolved
    if name.size == 0 {
      name = expr.callee
    }
    if sig = self.find_fn(name) {
      self.emit_typed_args(expr.args, sig.params)
      self.line("CALL :${name}")
    } else {
      self.emit_call_named(name, expr.args)
    }
  }

  pub fn is_struct_self(name: String): Bool {
    if st = self.self_ty {
      if st.is_struct {
        return str_eq(self.self_name, name)
      }
    }
    false
  }

  pub fn emit_self_field(field: String) {
    if st = self.self_ty {
      m = ty_self_ptr_myc(st)
      self.line("LOCAL :${self.self_name} :${m}")
      self.line("DEREF")
      fi = st.field_index(field)
      self.line("FIELD ${fi}")
    }
  }

  pub fn emit_self_ptr(recv: Expr) {
    ty = expr_ty(recv)
    if ty.is_class {
      self.emit_expr(recv)
      return
    }
    self.emit_lvalue(recv)
    self.line("ADDR")
  }

  pub fn emit_method_invoke(recv: Expr, name: String, args: Array(Expr)) {
    self.emit_args(args)
    rty = expr_ty(recv)
    if rty.is_ptr {
      self.emit_expr(recv)
    } else {
      self.emit_self_ptr(recv)
    }
    self.line("CALL :${name}")
  }

  pub fn c_layout_heap_store(target: Expr): Bool {
    if target.kind == ex_field() {
    } else {
      return false
    }
    if ty_has_heap(expr_ty(target)) {
    } else {
      return false
    }
    if obj = target.object {
      ot = expr_ty(obj)
      if ot.is_clayout {
        return true
      }
      if ot.is_ptr {
        if inner = ot.inner {
          if inner.is_clayout {
            return true
          }
        }
      }
    }
    false
  }

  pub fn emit_ctor_call(expr: Expr, recv: Expr) {
    ctor = expr.resolved
    if ctor.size == 0 {
      if recv.kind == ex_name() {
        ctor = "${recv.ident}__new"
      }
    }
    if ctor.size > 0 {
      self.emit_call_named(ctor, expr.args)
    }
  }

  pub fn emit_spawn_cap_layout(call: Expr) {
    if call.cap_names.size == 0 {
      return
    }
    name = call.spawn_thunk
    self.line("STRUCT :${name}_cap")
    self.indent = self.indent + 1
    i = 0
    while i < call.cap_tys.size {
      m = ty_myc(call.cap_tys[i])
      self.line("TYPE :${m}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.line("ENDSTRUCT")
    self.blank
  }

  pub fn emit_spawn(expr: Expr) {
    name = expr.spawn_thunk
    if expr.cap_names.size == 0 {
      self.line("PUSH 0")
      self.line("AS :ptr<void>")
    } else {
      cap_id = self.closure_type_id("${name}_cap")
      self.emit_alloc_sizeof("${name}_cap", cap_id)
      self.line("AS :ptr<${name}_cap>")
      holder = self.new_temp
      self.line("LOCAL :${holder} :ptr<${name}_cap>")
      self.line("STORE")
      self.line("LOCAL :${holder}")
      self.line("AS :ptr<void>")
      self.line("CALL :avant_pin")
      i = 0
      while i < expr.cap_names.size {
        cname = expr.cap_names[i]
        cm = ty_myc(expr.cap_tys[i])
        if self.name_is_boxed(cname) {
          self.emit_box_lvalue(cname, expr.cap_tys[i])
        } else {
          sci = self.cap_index(cname)
          if sci >= 0 {
            self.emit_cap_lvalue(sci)
          } else {
            self.line("LOCAL :${cname} :${cm}")
          }
        }
        self.line("LOCAL :${holder}")
        self.line("DEREF")
        self.line("FIELD ${i}")
        self.line("STORE")
        i = i + 1
      }
      self.line("LOCAL :${holder}")
      self.line("AS :ptr<void>")
    }
    self.line("ADDR :${name}")
    self.line("AS :ptr<void>")
    self.line("CALL :avant_spawn")
  }

  pub fn note_spawn_box(name: String, caps: Array(String), into: Array(String)) {
    found = false
    i = 0
    while i < caps.size {
      if str_eq(caps[i], name) {
        found = true
      }
      i = i + 1
    }
    if found {
    } else {
      return
    }
    j = 0
    while j < into.size {
      if str_eq(into[j], name) {
        return
      }
      j = j + 1
    }
    into.push(name)
  }

  pub fn collect_spawn_box_stmts(body: Array(Stmt), caps: Array(String), into: Array(String)) {
    i = 0
    while i < body.size {
      self.collect_spawn_box_stmt(body[i], caps, into)
      i = i + 1
    }
  }

  pub fn collect_spawn_box_stmt(stmt: Stmt, caps: Array(String), into: Array(String)) {
    k = stmt.kind
    if k == st_return() {
      if e = stmt.expr {
        self.collect_spawn_box_expr(e, caps, into)
      }
      return
    }
    if k == st_if() {
      if c = stmt.cond {
        self.collect_spawn_box_expr(c, caps, into)
      }
      self.collect_spawn_box_stmts(stmt.then_body, caps, into)
      self.collect_spawn_box_stmts(stmt.else_body, caps, into)
      return
    }
    if k == st_while() {
      if c = stmt.cond {
        self.collect_spawn_box_expr(c, caps, into)
      }
      self.collect_spawn_box_stmts(stmt.body, caps, into)
      return
    }
    if k == st_assign() {
      if target = stmt.target {
        self.collect_spawn_box_expr(target, caps, into)
      }
      if v = stmt.value {
        self.collect_spawn_box_expr(v, caps, into)
      }
      return
    }
    if k == st_expr() {
      if e = stmt.expr {
        self.collect_spawn_box_expr(e, caps, into)
      }
    }
  }

  pub fn collect_spawn_box_expr(expr: Expr, caps: Array(String), into: Array(String)) {
    k = expr.kind
    if k == ex_lambda() {
      i = 0
      while i < expr.cap_names.size {
        self.note_spawn_box(expr.cap_names[i], caps, into)
        i = i + 1
      }
      if b = expr.block {
        self.collect_spawn_box_stmts(b.body, caps, into)
      }
      return
    }
    if k == ex_call() {
      if inner = expr.inner {
        self.collect_spawn_box_expr(inner, caps, into)
      }
      if recv = expr.receiver {
        self.collect_spawn_box_expr(recv, caps, into)
      }
      i = 0
      while i < expr.args.size {
        self.collect_spawn_box_expr(expr.args[i], caps, into)
        i = i + 1
      }
      if b = expr.block {
        self.collect_spawn_box_stmts(b.body, caps, into)
      }
      return
    }
    if k == ex_unary() {
      if inner = expr.inner {
        self.collect_spawn_box_expr(inner, caps, into)
      }
      return
    }
    if k == ex_binary() {
      if l = expr.left {
        self.collect_spawn_box_expr(l, caps, into)
      }
      if r = expr.right {
        self.collect_spawn_box_expr(r, caps, into)
      }
      return
    }
    if k == ex_field() {
      if obj = expr.object {
        self.collect_spawn_box_expr(obj, caps, into)
      }
      return
    }
    if k == ex_index() {
      if l = expr.left {
        self.collect_spawn_box_expr(l, caps, into)
      }
      if r = expr.right {
        self.collect_spawn_box_expr(r, caps, into)
      }
      return
    }
    if k == ex_struct() {
      i = 0
      while i < expr.field_exprs.size {
        self.collect_spawn_box_expr(expr.field_exprs[i], caps, into)
        i = i + 1
      }
      return
    }
    if k == ex_array() {
      i = 0
      while i < expr.elems.size {
        self.collect_spawn_box_expr(expr.elems[i], caps, into)
        i = i + 1
      }
    }
  }

  pub fn emit_spawn_thunk(call: Expr) {
    if b = call.block {
      saved_indent = self.indent
      saved_count = self.temps
      saved_ret = self.return_type
      saved_rooted = self.rooted
      saved_self = self.self_ty
      saved_self_name = self.self_name
      saved_main = self.c_main
      self.indent = 0
      self.temps = 0
      self.return_type = ty_int()
      self.self_ty = nil
      self.self_name = ""
      self.c_main = false
      name = call.spawn_thunk
      self.line("FUNC :${name}")
      self.indent = self.indent + 1
      self.line("ARGS")
      self.indent = self.indent + 1
      self.line("TYPE :ptr<void>")
      self.indent = self.indent - 1
      self.line("RETURN")
      self.indent = self.indent + 1
      self.line("TYPE :i32")
      self.indent = self.indent - 1
      self.line("BODY")
      self.indent = self.indent + 1
      self.reset_rooted
      self.line("CALL :avant_gc_enter")
      self.line("PARAM 0")
      boxed: Array(String) = []
      self.collect_spawn_box_stmts(b.body, call.cap_names, boxed)
      if call.cap_names.size == 0 {
        self.line("STACK :drop")
        self.begin_fn_frame(boxed)
      } else {
        self.line("AS :ptr<${name}_cap>")
        holder = self.new_temp
        self.line("LOCAL :${holder} :ptr<${name}_cap>")
        self.line("STORE")
        self.begin_fn_frame(boxed)
        i = 0
        while i < call.cap_names.size {
          cname = call.cap_names[i]
          cm = ty_myc(call.cap_tys[i])
          self.line("LOCAL :${holder}")
          self.line("DEREF")
          self.line("FIELD ${i}")
          if self.name_is_boxed(cname) {
            tmp = self.new_temp
            self.line("LOCAL :${tmp} :${cm}")
            self.line("STORE")
            self.ensure_root(tmp, call.cap_tys[i])
            self.ensure_box(cname, call.cap_tys[i])
            self.line("LOCAL :${tmp}")
            self.store_box_value(cname, call.cap_tys[i])
          } else {
            self.line("LOCAL :${cname} :${cm}")
            self.line("STORE")
            self.ensure_root(cname, call.cap_tys[i])
          }
          i = i + 1
        }
      }
      i = 0
      while i < b.body.size {
        stmt = b.body[i]
        if i == b.body.size - 1 {
          if e = stmt.expr {
            self.emit_expr(e)
            self.emit_ret
          } else {
            self.emit_stmt(stmt, false)
            self.emit_ret
          }
        } else {
          self.emit_stmt(stmt, false)
        }
        i = i + 1
      }
      self.indent = self.indent - 1
      self.indent = self.indent - 1
      self.line("ENDFUNC")
      self.blank
      self.indent = saved_indent
      self.temps = saved_count
      self.return_type = saved_ret
      self.rooted = saved_rooted
      self.self_ty = saved_self
      self.self_name = saved_self_name
      self.c_main = saved_main
    }
  }

  pub fn emit_parallel_layout(call: Expr) {
    name = call.spawn_thunk
    self.line("STRUCT :${name}_cap")
    self.indent = self.indent + 1
    if recv = call.receiver {
      inm = ty_myc(expr_ty(recv))
      self.line("TYPE :${inm}")
    }
    outm = ty_myc(expr_ty(call))
    self.line("TYPE :${outm}")
    i = 0
    while i < call.cap_tys.size {
      cm = ty_myc(call.cap_tys[i])
      self.line("TYPE :${cm}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.line("ENDSTRUCT")
    self.blank
  }

  pub fn emit_parallel(expr: Expr, array_ty: Ty) {
    name = expr.spawn_thunk
    layout = "${name}_cap"
    if recv = expr.receiver {
      self.emit_expr(recv)
    }
    arr = self.new_temp
    am = ty_myc(array_ty)
    self.line("LOCAL :${arr} :${am}")
    self.line("STORE")
    self.ensure_root(arr, array_ty)
    self.line("LOCAL :${arr}")
    self.line("DEREF")
    self.line("FIELD 1")
    n = self.new_temp
    self.line("LOCAL :${n} :i32")
    self.line("STORE")
    out_ty = expr_ty(expr)
    elem = ty_int()
    if e = out_ty.inner {
      elem = e
    }
    ptr = self.new_temp
    self.line("LOCAL :${n}")
    em = ty_myc(elem)
    self.emit_alloc_count(elem)
    self.line("LOCAL :${ptr} :ptr<${em}>")
    self.line("STORE")
    self.emit_ptr_root(ptr)
    self.emit_array_header(out_ty, ptr, n, n)
    dst = self.new_temp
    om = ty_myc(out_ty)
    self.line("LOCAL :${dst} :${om}")
    self.line("STORE")
    self.ensure_root(dst, out_ty)
    tid = self.closure_type_id(layout)
    self.emit_alloc_sizeof(layout, tid)
    self.line("AS :ptr<${layout}>")
    ctx = self.new_temp
    self.line("LOCAL :${ctx} :ptr<${layout}>")
    self.line("STORE")
    self.emit_ptr_root(ctx)
    self.line("LOCAL :${ctx}")
    self.line("AS :ptr<void>")
    self.line("CALL :avant_pin")
    self.line("LOCAL :${arr}")
    self.line("LOCAL :${ctx}")
    self.line("DEREF")
    self.line("FIELD 0")
    self.line("STORE")
    self.line("LOCAL :${dst}")
    self.line("LOCAL :${ctx}")
    self.line("DEREF")
    self.line("FIELD 1")
    self.line("STORE")
    i = 0
    while i < expr.cap_names.size {
      cname = expr.cap_names[i]
      cm = ty_myc(expr.cap_tys[i])
      if self.name_is_boxed(cname) {
        self.emit_box_lvalue(cname, expr.cap_tys[i])
      } else {
        sci = self.cap_index(cname)
        if sci >= 0 {
          self.emit_cap_lvalue(sci)
        } else {
          self.line("LOCAL :${cname} :${cm}")
        }
      }
      fi = i + 2
      self.line("LOCAL :${ctx}")
      self.line("DEREF")
      self.line("FIELD ${fi}")
      self.line("STORE")
      i = i + 1
    }
    self.line("LOCAL :${ctx}")
    self.line("AS :ptr<void>")
    self.line("ADDR :${name}")
    self.line("AS :ptr<void>")
    self.line("LOCAL :${n}")
    self.line("CALL :avant_parallel_for")
    self.line("LOCAL :${dst}")
  }

  pub fn emit_parallel_thunk(call: Expr) {
    if b = call.block {
      saved_indent = self.indent
      saved_count = self.temps
      saved_ret = self.return_type
      saved_rooted = self.rooted
      saved_self = self.self_ty
      saved_self_name = self.self_name
      saved_main = self.c_main
      saved_place = self.place_name
      saved_ph = self.place_holder
      saved_pf = self.place_field
      self.indent = 0
      self.temps = 0
      self.return_type = ty_void()
      self.self_ty = nil
      self.self_name = ""
      self.c_main = false
      self.place_name = ""
      self.place_holder = ""
      self.place_field = 0
      name = call.spawn_thunk
      layout = "${name}_cap"
      self.line("FUNC :${name}")
      self.indent = self.indent + 1
      self.line("ARGS")
      self.indent = self.indent + 1
      self.line("TYPE :i32")
      self.line("TYPE :ptr<void>")
      self.indent = self.indent - 1
      self.line("BODY")
      self.indent = self.indent + 1
      self.reset_rooted
      self.line("CALL :avant_gc_enter")
      self.line("PARAM 0")
      idx = self.new_temp
      self.line("LOCAL :${idx} :i32")
      self.line("STORE")
      self.line("PARAM 1")
      self.line("AS :ptr<${layout}>")
      holder = self.new_temp
      self.line("LOCAL :${holder} :ptr<${layout}>")
      self.line("STORE")
      self.emit_ptr_root(holder)
      boxed: Array(String) = []
      self.collect_spawn_box_stmts(b.body, call.cap_names, boxed)
      self.begin_fn_frame(boxed)
      in_ty = ty_void()
      if recv = call.receiver {
        in_ty = expr_ty(recv)
      }
      am = ty_myc(in_ty)
      self.line("LOCAL :${holder}")
      self.line("DEREF")
      self.line("FIELD 0")
      arr = self.new_temp
      self.line("LOCAL :${arr} :${am}")
      self.line("STORE")
      self.ensure_root(arr, in_ty)
      out_ty = expr_ty(call)
      elem = ty_int()
      if e = out_ty.inner {
        elem = e
      }
      em = ty_myc(elem)
      om = ty_myc(out_ty)
      self.line("LOCAL :${holder}")
      self.line("DEREF")
      self.line("FIELD 1")
      dst = self.new_temp
      self.line("LOCAL :${dst} :${om}")
      self.line("STORE")
      self.ensure_root(dst, out_ty)
      pname = b.params[0]
      in_elem = ty_int()
      if ie = in_ty.inner {
        in_elem = ie
      }
      iem = ty_myc(in_elem)
      if heap_ptr_value(in_elem) {
        self.line("LOCAL :${idx}")
        self.line("LOCAL :${arr}")
        self.line("CALL :avant_array_get_ptr")
        self.line("AS :${iem}")
      } else {
        buf = self.new_temp
        self.line("LOCAL :${arr}")
        self.line("DEREF")
        self.line("FIELD 0")
        self.line("LOCAL :${buf} :ptr<${iem}>")
        self.line("STORE")
        self.emit_ptr_root(buf)
        self.line("LOCAL :${idx}")
        self.line("LOCAL :${buf}")
        self.line("BINARY :add")
        self.line("DEREF")
      }
      self.line("LOCAL :${pname} :${iem}")
      self.line("STORE")
      self.ensure_root(pname, in_elem)
      i = 0
      while i < call.cap_names.size {
        cname = call.cap_names[i]
        cm = ty_myc(call.cap_tys[i])
        fi = i + 2
        self.line("LOCAL :${holder}")
        self.line("DEREF")
        self.line("FIELD ${fi}")
        if self.name_is_boxed(cname) {
          tmp = self.new_temp
          self.line("LOCAL :${tmp} :${cm}")
          self.line("STORE")
          self.ensure_root(tmp, call.cap_tys[i])
          self.ensure_box(cname, call.cap_tys[i])
          self.line("LOCAL :${tmp}")
          self.store_box_value(cname, call.cap_tys[i])
        } else {
          self.line("LOCAL :${cname} :${cm}")
          self.line("STORE")
          self.ensure_root(cname, call.cap_tys[i])
        }
        i = i + 1
      }
      i = 0
      while i < b.body.size {
        stmt = b.body[i]
        if i == b.body.size - 1 {
          if last = stmt.expr {
            self.emit_expr(last)
            self.emit_coerce(expr_ty(last), elem)
            val = self.new_temp
            self.line("LOCAL :${val} :${em}")
            self.line("STORE")
            self.ensure_root(val, elem)
            if heap_ptr_value(elem) {
              self.line("LOCAL :${val}")
              self.line("LOCAL :${idx}")
              self.line("LOCAL :${dst}")
              self.line("CALL :avant_array_set_ptr")
            } else {
              slot = self.new_temp
              self.line("LOCAL :${dst}")
              self.line("DEREF")
              self.line("FIELD 0")
              self.line("LOCAL :${slot} :ptr<${em}>")
              self.line("STORE")
              self.emit_ptr_root(slot)
              self.line("LOCAL :${val}")
              self.line("LOCAL :${idx}")
              self.line("LOCAL :${slot}")
              self.line("BINARY :add")
              self.line("DEREF")
              self.line("STORE")
            }
            self.emit_ret
          } else {
            self.emit_stmt(stmt, false)
            self.emit_ret
          }
        } else {
          self.emit_stmt(stmt, false)
        }
        i = i + 1
      }
      self.indent = self.indent - 1
      self.indent = self.indent - 1
      self.line("ENDFUNC")
      self.blank
      self.indent = saved_indent
      self.temps = saved_count
      self.return_type = saved_ret
      self.rooted = saved_rooted
      self.self_ty = saved_self
      self.self_name = saved_self_name
      self.c_main = saved_main
      self.place_name = saved_place
      self.place_holder = saved_ph
      self.place_field = saved_pf
    }
  }

  pub fn emit_mutex_with(expr: Expr, mutex_ty: Ty) {
    if recv = expr.receiver {
      self.emit_expr(recv)
    }
    holder = self.new_temp
    m = ty_myc(mutex_ty)
    self.line("LOCAL :${holder} :${m}")
    self.line("STORE")
    self.ensure_root(holder, mutex_ty)
    gate_i = mutex_ty.field_index("gate")
    self.line("LOCAL :${holder}")
    self.line("DEREF")
    self.line("FIELD ${gate_i}")
    self.line("CALL :avant_gate_lock")
    saved_name = self.place_name
    saved_holder = self.place_holder
    saved_field = self.place_field
    self.place_holder = holder
    self.place_field = mutex_ty.field_index("cell")
    self.place_name = ""
    if b = expr.block {
      if b.params.size > 0 {
        self.place_name = b.params[0]
      }
      i = 0
      while i < b.body.size {
        stmt = b.body[i]
        if i == b.body.size - 1 {
          if e = stmt.expr {
            self.emit_expr(e)
          } else {
            self.emit_stmt(stmt, false)
          }
        } else {
          self.emit_stmt(stmt, false)
        }
        i = i + 1
      }
    }
    val_ty = expr_ty(expr)
    if val_ty.is_void {
      self.line("LOCAL :${holder}")
      self.line("DEREF")
      self.line("FIELD ${gate_i}")
      self.line("CALL :avant_gate_unlock")
    } else {
      tmp = self.new_temp
      vm = ty_myc(val_ty)
      self.line("LOCAL :${tmp} :${vm}")
      self.line("STORE")
      self.ensure_root(tmp, val_ty)
      self.line("LOCAL :${holder}")
      self.line("DEREF")
      self.line("FIELD ${gate_i}")
      self.line("CALL :avant_gate_unlock")
      self.line("LOCAL :${tmp}")
    }
    self.place_name = saved_name
    self.place_holder = saved_holder
    self.place_field = saved_field
  }

  pub fn emit_join(expr: Expr) {
    if recv = expr.receiver {
      self.emit_expr(recv)
    }
    self.line("CALL :avant_join")
  }

  pub fn emit_json_get(expr: Expr, as_str: Bool) {
    found = self.new_temp
    self.line("PUSH 0")
    self.line("LOCAL :${found} :i32")
    self.line("STORE")
    self.emit_expr(expr.args[1])
    key = self.new_temp
    self.line("LOCAL :${key} :ptr<u8>")
    self.line("STORE")
    self.emit_expr(expr.args[0])
    doc = self.new_temp
    self.line("LOCAL :${doc} :ptr<void>")
    self.line("STORE")
    self.line("LOCAL :${found}")
    self.line("ADDR")
    self.line("LOCAL :${key}")
    self.line("LOCAL :${doc}")
    val_ty = ty_int()
    if as_str {
      self.line("CALL :avant_json_get_str")
      val_ty = ty_string()
    } else {
      self.line("CALL :avant_json_get_int")
      val_ty = ty_int()
    }
    val = self.new_temp
    vm = ty_myc(val_ty)
    self.line("LOCAL :${val} :${vm}")
    self.line("STORE")
    self.ensure_root(val, val_ty)
    want = expr_ty(expr)
    wm = ty_myc(want)
    slot = self.new_temp
    self.line("LOCAL :${found}")
    self.line("PUSH 1")
    self.line("BINARY :eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.line("LOCAL :${val}")
    self.emit_wrap_union(val_ty, want)
    self.line("LOCAL :${slot} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    self.emit_zero(ty_nil())
    self.emit_wrap_union(ty_nil(), want)
    self.line("LOCAL :${slot} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.line("LOCAL :${slot}")
  }

  pub fn emit_nullable_ptr {
    ptr_ty = ty_ptr(ty_void())
    want = ty_nilable(ptr_ty)
    val = self.new_temp
    self.line("LOCAL :${val} :ptr<void>")
    self.line("STORE")
    self.ensure_root(val, ptr_ty)
    held = self.new_temp
    self.line("LOCAL :${val}")
    self.line("PUSH 0")
    self.line("AS :ptr<void>")
    self.line("BINARY :not_eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.line("LOCAL :${val}")
    self.emit_wrap_union(ptr_ty, want)
    wm = ty_myc(want)
    self.line("LOCAL :${held} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    self.emit_zero(ty_nil())
    self.emit_wrap_union(ty_nil(), want)
    self.line("LOCAL :${held} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.line("LOCAL :${held}")
  }

  pub fn emit_json_root(expr: Expr) {
    if expr.args.size > 0 {
      self.emit_expr(expr.args[0])
    }
    self.line("CALL :avant_json_root")
  }

  pub fn emit_json_obj_get(expr: Expr) {
    if expr.args.size > 1 {
      self.emit_expr(expr.args[1])
    }
    key = self.new_temp
    self.line("LOCAL :${key} :ptr<u8>")
    self.line("STORE")
    if expr.args.size > 0 {
      self.emit_expr(expr.args[0])
    }
    obj = self.new_temp
    self.line("LOCAL :${obj} :ptr<void>")
    self.line("STORE")
    self.line("LOCAL :${key}")
    self.line("LOCAL :${obj}")
    self.line("CALL :avant_json_obj_get")
    self.emit_nullable_ptr
  }

