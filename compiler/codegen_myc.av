  pub fn emit_int_convert(from: Ty, name: String) {
    if str_eq(name, "to_f") {
      self.line("AS :f64")
      return
    }
    if str_eq(name, "abs") {
      self.line("UNARY :abs")
      return
    }
    if str_eq(name, "to_i") {
      if from.is_int {
        return
      }
      self.line("AS :i32")
      return
    }
    if str_eq(name, "to_i64") {
      if from.is_int {
        self.line("TO :i64")
      } else if from.is_uint64 {
        self.line("AS :i64")
      }
      return
    }
    if str_eq(name, "to_u64") {
      if from.is_int {
        self.line("TO :i64")
        self.line("AS :u64")
      } else if from.is_int64 {
        self.line("AS :u64")
      }
    }
  }

  pub fn emit_float_field(expr: Expr) {
    if obj = expr.object {
      self.emit_expr(obj)
    }
    if str_eq(expr.ident, "sqrt") {
      self.line("UNARY :sqrt")
    } else if str_eq(expr.ident, "abs") {
      self.line("UNARY :abs")
    } else if str_eq(expr.ident, "floor") {
      self.line("UNARY :floor")
    } else if str_eq(expr.ident, "to_i") {
      self.line("UNARY :trunc")
      self.line("AS :i32")
    }
  }

  pub fn emit_int_field(expr: Expr) {
    if obj = expr.object {
      self.emit_expr(obj)
      self.emit_int_convert(expr_ty(obj), expr.ident)
    }
  }

  pub fn emit_float_method(expr: Expr) {
    if recv = expr.receiver {
      self.emit_expr(recv)
    }
    if str_eq(expr.callee, "sqrt") {
      self.line("UNARY :sqrt")
    } else if str_eq(expr.callee, "exp") {
      self.line("CALL :avant_exp")
    } else if str_eq(expr.callee, "abs") {
      self.line("UNARY :abs")
    } else if str_eq(expr.callee, "floor") {
      self.line("UNARY :floor")
    } else if str_eq(expr.callee, "to_i") {
      self.line("UNARY :trunc")
      self.line("AS :i32")
    }
  }

  pub fn emit_int_method(expr: Expr) {
    if recv = expr.receiver {
      self.emit_expr(recv)
      self.emit_int_convert(expr_ty(recv), expr.callee)
    }
  }

  pub fn emit_string_method(expr: Expr) {
    if recv = expr.receiver {
      self.emit_expr(recv)
    }
    if str_eq(expr.callee, "to_f") {
      self.line("CALL :avant_str_to_f")
    } else if str_eq(expr.callee, "to_i") {
      self.line("CALL :avant_str_to_i")
    }
  }

  pub fn emit_opt_cstr(expr: Expr, cname: String) {
    found = self.new_temp
    self.line("PUSH 0")
    self.line("LOCAL :${found} :i32")
    self.line("STORE")
    self.line("LOCAL :${found}")
    self.line("ADDR")
    if expr.args.size > 0 {
      self.emit_expr(expr.args[0])
    }
    self.line("CALL :${cname}")
    val_ty = ty_string()
    val = self.new_temp
    vm = ty_myc(val_ty)
    self.line("LOCAL :${val} :${vm}")
    self.line("STORE")
    self.ensure_root(val, val_ty)
    want = expr_ty(expr)
    wm = ty_myc(want)
    slot = self.new_temp
    self.line("LOCAL :${found}")
    self.line("PUSH 1")
    self.line("BINARY :eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.line("LOCAL :${val}")
    self.emit_wrap_union(val_ty, want)
    self.line("LOCAL :${slot} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    self.emit_zero(ty_nil())
    self.emit_wrap_union(ty_nil(), want)
    self.line("LOCAL :${slot} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.line("LOCAL :${slot}")
  }

  pub fn emit_process_run(expr: Expr) {
    if expr.args.size > 1 {
      self.emit_expr(expr.args[1])
    }
    self.line("AS :ptr<void>")
    args = self.new_temp
    self.line("LOCAL :${args} :ptr<void>")
    self.line("STORE")
    if expr.args.size > 0 {
      self.emit_expr(expr.args[0])
    }
    path = self.new_temp
    self.line("LOCAL :${path} :ptr<u8>")
    self.line("STORE")
    self.ensure_root(path, ty_string())
    self.line("LOCAL :${args}")
    self.line("LOCAL :${path}")
    self.line("CALL :avant_process_run")
  }

  pub fn emit_process_run_out(expr: Expr) {
    if expr.args.size > 2 {
      self.emit_expr(expr.args[2])
    }
    outp = self.new_temp
    self.line("LOCAL :${outp} :ptr<u8>")
    self.line("STORE")
    self.ensure_root(outp, ty_string())
    if expr.args.size > 1 {
      self.emit_expr(expr.args[1])
    }
    self.line("AS :ptr<void>")
    args = self.new_temp
    self.line("LOCAL :${args} :ptr<void>")
    self.line("STORE")
    if expr.args.size > 0 {
      self.emit_expr(expr.args[0])
    }
    path = self.new_temp
    self.line("LOCAL :${path} :ptr<u8>")
    self.line("STORE")
    self.ensure_root(path, ty_string())
    self.line("LOCAL :${outp}")
    self.line("LOCAL :${args}")
    self.line("LOCAL :${path}")
    self.line("CALL :avant_process_run_out")
  }

  pub fn emit_buf_method(expr: Expr) {
    if str_eq(expr.callee, "push_byte") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      b = self.new_temp
      self.line("LOCAL :${b} :i32")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      buf = self.new_temp
      self.line("LOCAL :${buf} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${b}")
      self.line("LOCAL :${buf}")
      self.line("CALL :avant_buf_push_byte")
      return
    }
    if str_eq(expr.callee, "push_str") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      s = self.new_temp
      self.line("LOCAL :${s} :ptr<u8>")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      buf = self.new_temp
      self.line("LOCAL :${buf} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${s}")
      self.line("LOCAL :${buf}")
      self.line("CALL :avant_buf_push_str")
      return
    }
    if str_eq(expr.callee, "push_slice") {
      if expr.args.size > 2 {
        self.emit_expr(expr.args[2])
      }
      stop = self.new_temp
      self.line("LOCAL :${stop} :i32")
      self.line("STORE")
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      start = self.new_temp
      self.line("LOCAL :${start} :i32")
      self.line("STORE")
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      s = self.new_temp
      self.line("LOCAL :${s} :ptr<u8>")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      buf = self.new_temp
      self.line("LOCAL :${buf} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${stop}")
      self.line("LOCAL :${start}")
      self.line("LOCAL :${s}")
      self.line("LOCAL :${buf}")
      self.line("CALL :avant_buf_push_slice")
      return
    }
    if str_eq(expr.callee, "push_fmt_f") {
      if expr.args.size > 1 {
        self.emit_expr(expr.args[1])
      }
      prec = self.new_temp
      self.line("LOCAL :${prec} :i32")
      self.line("STORE")
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      v = self.new_temp
      self.line("LOCAL :${v} :f64")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      buf = self.new_temp
      self.line("LOCAL :${buf} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${prec}")
      self.line("LOCAL :${v}")
      self.line("LOCAL :${buf}")
      self.line("CALL :avant_buf_push_fmt_f")
      return
    }
    if str_eq(expr.callee, "push_fmt_i") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      n = self.new_temp
      self.line("LOCAL :${n} :i32")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      buf = self.new_temp
      self.line("LOCAL :${buf} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${n}")
      self.line("LOCAL :${buf}")
      self.line("CALL :avant_buf_push_fmt_i")
      return
    }
    if str_eq(expr.callee, "starts_with") {
      if expr.args.size > 0 {
        self.emit_expr(expr.args[0])
      }
      s = self.new_temp
      self.line("LOCAL :${s} :ptr<u8>")
      self.line("STORE")
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      buf = self.new_temp
      self.line("LOCAL :${buf} :ptr<void>")
      self.line("STORE")
      self.line("LOCAL :${s}")
      self.line("LOCAL :${buf}")
      self.line("CALL :avant_buf_starts")
      return
    }
    if str_eq(expr.callee, "to_s") {
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      self.line("CALL :avant_buf_to_str")
      return
    }
    if str_eq(expr.callee, "clear") {
      if recv = expr.receiver {
        self.emit_expr(recv)
      }
      self.line("CALL :avant_buf_clear")
    }
  }

  pub fn emit_call_named(name: String, args: Array(Expr)) {
    self.emit_args(args)
    self.line("CALL :${name}")
  }

  pub fn emit_args(args: Array(Expr)) {
    none: Array(Ty) = []
    self.emit_typed_args(args, none)
  }

  pub fn emit_typed_args(args: Array(Expr), types: Array(Ty)) {
    if args.size <= 1 {
      if args.size == 1 {
        self.emit_expr(args[0])
        if types.size > 0 {
          self.emit_coerce(expr_ty(args[0]), types[0])
        }
      }
      return
    }
    tmps: Array(String) = []
    i = 0
    while i < args.size {
      arg = args[i]
      self.emit_expr(arg)
      got = expr_ty(arg)
      if i < types.size {
        self.emit_coerce(got, types[i])
        if types[i].is_union {
          if types[i].includes_member(got) {
            got = types[i]
          }
        }
      }
      tmp = self.new_temp
      m = ty_myc(got)
      self.line("LOCAL :${tmp} :${m}")
      self.line("STORE")
      self.ensure_root(tmp, got)
      tmps.push(tmp)
      i = i + 1
    }
    i = tmps.size - 1
    while i >= 0 {
      t = tmps[i]
      self.line("LOCAL :${t}")
      i = i - 1
    }
  }

  pub fn begin_fn_frame(boxes: Array(String)) {
    self.in_lambda = false
    self.env_layout = ""
    caps: Array(String) = []
    self.cap_list = caps
    ctys: Array(Ty) = []
    self.cap_tys_now = ctys
    bs: Array(String) = []
    i = 0
    while i < boxes.size {
      n = boxes[i]
      skip = false
      if self.self_name.size > 0 {
        if str_eq(n, self.self_name) {
          skip = true
        }
      }
      if skip {
      } else {
        bs.push(n)
      }
      i = i + 1
    }
    self.box_list = bs
    ready = Hash(String, Int).new
    self.box_ready = ready
  }

  pub fn cap_index(name: String): Int {
    i = 0
    while i < self.cap_list.size {
      if str_eq(self.cap_list[i], name) {
        return i
      }
      i = i + 1
    }
    0 - 1
  }

  pub fn name_is_boxed(name: String): Bool {
    i = 0
    while i < self.box_list.size {
      if str_eq(self.box_list[i], name) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn is_gate_callee(name: String): Bool {
    if str_eq(name, "avant_gate_new") {
      return true
    }
    if str_eq(name, "avant_gate_lock") {
      return true
    }
    if str_eq(name, "avant_gate_unlock") {
      return true
    }
    if str_eq(name, "avant_gate_wait") {
      return true
    }
    if str_eq(name, "avant_gate_signal") {
      return true
    }
    str_eq(name, "avant_gate_broadcast")
  }

  pub fn re2c_call_id(pat: Expr, flags: Expr): Int {
    if pat.kind == ex_string() {
    } else {
      return 0
    }
    if flags.kind == ex_int() {
    } else {
      return 0
    }
    key = re2c_key(pat.value_str, flags.int_bits.to_i)
    if id = self.program.re2c_ids.get(key) {
      return id
    }
    0
  }

  pub fn re_mark_callee(name: String): Bool {
    if str_eq(name, "re_m0") {
      return true
    }
    if str_eq(name, "re_m1") {
      return true
    }
    if str_eq(name, "re_c0") {
      return true
    }
    str_eq(name, "re_c1")
  }

  pub fn note_words(name: String, tys: Array(Ty)) {
    bits = 0u64
    offset = 0
    i = 0
    while i < tys.size {
      fty = tys[i]
      offset = align_up_i(offset, abi_align(fty))
      bits = add_ptr_bits(fty, offset, bits)
      offset = offset + abi_size(fty)
      i = i + 1
    }
    if bits == 0u64 {
      return
    }
    j = 0
    while j < self.closure_names.size {
      if str_eq(self.closure_names[j], name) {
        return
      }
      j = j + 1
    }
    self.closure_names.push(name)
    self.closure_bits.push(bits)
  }

  pub fn closure_type_id(name: String): Int {
    i = 0
    while i < self.closure_names.size {
      if str_eq(self.closure_names[i], name) {
        return 400 + i
      }
      i = i + 1
    }
    0
  }

  pub fn note_box(ty: Ty) {
    self.note_ty(ty)
    layout = box_layout_name(ty)
    i = 0
    while i < self.box_tys.size {
      if str_eq(box_layout_name(self.box_tys[i]), layout) {
        return
      }
      i = i + 1
    }
    self.box_tys.push(ty)
    bits = add_ptr_bits(ty, 0, 0u64)
    self.closure_names.push(layout)
    self.closure_bits.push(bits)
  }

  pub fn note_env(name: String, count: Int) {
    bits = 0u64
    i = 0
    while i < count {
      bits = word_bit(i * 8, bits)
      i = i + 1
    }
    self.closure_names.push(name)
    self.closure_bits.push(bits)
  }

  pub fn collect_lambda(expr: Expr) {
    n = self.lam_id
    expr.resolved = "__lam_${n}"
    self.lam_id = n + 1
    self.lambdas.push(expr)
    i = 0
    while i < expr.cap_tys.size {
      self.note_box(expr.cap_tys[i])
      i = i + 1
    }
    if expr.cap_names.size > 0 {
      env = "${expr.resolved}_env"
      self.note_env(env, expr.cap_names.size)
    }
    if b = expr.block {
      self.collect_stmts(b.body)
    }
  }

  pub fn emit_fn_def(ty: Ty) {
    name = fn_layout_name(ty)
    code = fn_code_myc(ty)
    self.line("STRUCT :${name}")
    self.indent = self.indent + 1
    self.line("TYPE :ptr<void>")
    self.line("TYPE \"${code}\"")
    self.indent = self.indent - 1
    self.line("ENDSTRUCT")
    self.blank
  }

  pub fn emit_box_def(ty: Ty) {
    name = box_layout_name(ty)
    m = ty_myc(ty)
    self.line("STRUCT :${name}")
    self.indent = self.indent + 1
    self.line("TYPE :${m}")
    self.indent = self.indent - 1
    self.line("ENDSTRUCT")
    self.blank
  }

  pub fn emit_env_defs {
    i = 0
    while i < self.lambdas.size {
      lam = self.lambdas[i]
      if lam.cap_names.size > 0 {
        name = "${lam.resolved}_env"
        self.line("STRUCT :${name}")
        self.indent = self.indent + 1
        j = 0
        while j < lam.cap_tys.size {
          box = box_layout_name(lam.cap_tys[j])
          self.line("TYPE :ptr<${box}>")
          j = j + 1
        }
        self.indent = self.indent - 1
        self.line("ENDSTRUCT")
        self.blank
      }
      i = i + 1
    }
  }

  pub fn emit_param_stores(names: Array(String), types: Array(Ty), index_base: Int): Array(String) {
    raws: Array(String) = []
    i = 0
    while i < names.size {
      m = ty_myc(types[i])
      slot = index_base + i
      self.line("PARAM ${slot}")
      if self.name_is_boxed(names[i]) {
        tmp = self.new_temp
        self.line("LOCAL :${tmp} :${m}")
        self.line("STORE")
        raws.push(tmp)
      } else {
        self.line("LOCAL :${names[i]} :${m}")
        self.line("STORE")
        raws.push("")
      }
      i = i + 1
    }
    raws
  }

  pub fn emit_param_finish(names: Array(String), types: Array(Ty), raws: Array(String)) {
    i = 0
    while i < names.size {
      if self.name_is_boxed(names[i]) {
        self.ensure_root(raws[i], types[i])
        self.ensure_box(names[i], types[i])
        self.line("LOCAL :${raws[i]}")
        self.store_box_value(names[i], types[i])
      } else {
        self.ensure_root(names[i], types[i])
      }
      i = i + 1
    }
  }

  pub fn emit_param_group(names: Array(String), types: Array(Ty), index_base: Int) {
    raws = self.emit_param_stores(names, types, index_base)
    self.emit_param_finish(names, types, raws)
  }

  pub fn ensure_box(name: String, ty: Ty) {
    if v = self.box_ready.get(name) {
      return
    }
    box = box_layout_name(ty)
    id = self.closure_type_id(box)
    self.emit_alloc_sizeof(box, id)
    self.line("AS :ptr<${box}>")
    self.line("LOCAL :${name} :ptr<${box}>")
    self.line("STORE")
    self.emit_zero(ty)
    self.store_box_value(name, ty)
    self.emit_ptr_root(name)
    self.box_ready[name] = 1
  }

  pub fn store_box_value(name: String, ty: Ty) {
    box = box_layout_name(ty)
    self.line("LOCAL :${name} :ptr<${box}>")
    self.line("DEREF")
    self.line("FIELD 0")
    self.line("STORE")
  }

  pub fn emit_box_lvalue(name: String, ty: Ty) {
    box = box_layout_name(ty)
    self.line("LOCAL :${name} :ptr<${box}>")
    self.line("DEREF")
    self.line("FIELD 0")
  }

  pub fn emit_cap_lvalue(index: Int) {
    self.line("LOCAL :__env :ptr<${self.env_layout}>")
    self.line("DEREF")
    self.line("FIELD ${index}")
    self.line("DEREF")
    self.line("FIELD 0")
  }

  pub fn emit_box_pointer(name: String, ty: Ty) {
    ci = self.cap_index(name)
    if ci >= 0 {
      self.line("LOCAL :__env :ptr<${self.env_layout}>")
      self.line("DEREF")
      self.line("FIELD ${ci}")
      return
    }
    self.ensure_box(name, ty)
    box = box_layout_name(ty)
    self.line("LOCAL :${name} :ptr<${box}>")
  }

  pub fn emit_named_value(name: String) {
    ci = self.cap_index(name)
    if ci >= 0 {
      self.emit_cap_lvalue(ci)
      return
    }
    if self.name_is_boxed(name) {
      self.line("LOCAL :${name}")
      self.line("DEREF")
      self.line("FIELD 0")
      return
    }
    self.line("LOCAL :${name}")
  }

  pub fn emit_fn_value(code_sym: String, fty: Ty, hold: String) {
    code = fn_code_myc(fty)
    layout = fn_layout_name(fty)
    // CREATE stores field 0 from the top of the stack. Push the code word, then the env.
    self.line("ADDR :${code_sym}")
    self.line("AS \"${code}\"")
    if hold.size == 0 {
      self.line("PUSH 0")
      self.line("AS :ptr<void>")
    } else {
      self.line("LOCAL :${hold}")
      self.line("AS :ptr<void>")
    }
    self.line("CREATE :${layout}")
  }

  pub fn emit_fn_ref(expr: Expr) {
    tramp = "__fn_${expr.resolved}"
    self.emit_fn_value(tramp, expr_ty(expr), "")
  }

  pub fn emit_lambda(expr: Expr) {
    fty = expr_ty(expr)
    if expr.cap_names.size == 0 {
      self.emit_fn_value(expr.resolved, fty, "")
      return
    }
    env = "${expr.resolved}_env"
    id = self.closure_type_id(env)
    self.emit_alloc_sizeof(env, id)
    self.line("AS :ptr<${env}>")
    hold = self.new_temp
    self.line("LOCAL :${hold} :ptr<${env}>")
    self.line("STORE")
    self.emit_ptr_root(hold)
    i = 0
    while i < expr.cap_names.size {
      self.emit_box_pointer(expr.cap_names[i], expr.cap_tys[i])
      self.line("LOCAL :${hold}")
      self.line("DEREF")
      self.line("FIELD ${i}")
      self.line("STORE")
      i = i + 1
    }
    self.emit_fn_value(expr.resolved, fty, hold)
  }

  pub fn emit_indirect(expr: Expr) {
    layout = expr.resolved
    if inner = expr.inner {
      self.emit_expr(inner)
      layout = ty_myc(expr_ty(inner))
    } else {
      self.emit_named_value(expr.callee)
    }
    tmp = self.new_temp
    self.line("LOCAL :${tmp} :${layout}")
    self.line("STORE")
    self.emit_ptr_root(tmp)
    self.emit_typed_args(expr.args, expr.cap_tys)
    self.line("LOCAL :${tmp}")
    self.line("FIELD 0")
    self.line("LOCAL :${tmp}")
    self.line("FIELD 1")
    self.line("INVOKE")
  }

  pub fn emit_body_fallthrough(body: Array(Stmt)) {
    if body.size == 0 {
      self.emit_ret
      return
    }
    last = body[body.size - 1]
    if last.kind == st_return() {
      return
    }
    if last.kind == st_expr() {
      if self.return_type.is_void {
      } else {
        return
      }
    }
    self.emit_ret
  }

  pub fn emit_lambda_thunk(expr: Expr) {
    saved_indent = self.indent
    saved_temps = self.temps
    saved_ret = self.return_type
    saved_main = self.c_main
    saved_rooted = self.rooted
    saved_self = self.self_ty
    saved_self_name = self.self_name
    self.indent = 0
    self.temps = 0
    self.c_main = false
    self.self_ty = nil
    self.self_name = ""
    self.in_lambda = true
    self.env_layout = ""
    if expr.cap_names.size > 0 {
      self.env_layout = "${expr.resolved}_env"
    }
    caps: Array(String) = []
    ctys: Array(Ty) = []
    i = 0
    while i < expr.cap_names.size {
      caps.push(expr.cap_names[i])
      ctys.push(expr.cap_tys[i])
      i = i + 1
    }
    self.cap_list = caps
    self.cap_tys_now = ctys
    boxes: Array(String) = []
    i = 0
    while i < expr.box_names.size {
      boxes.push(expr.box_names[i])
      i = i + 1
    }
    self.box_list = boxes
    ready = Hash(String, Int).new
    self.box_ready = ready
    fty = expr_ty(expr)
    ret = ty_void()
    if r = fty.inner {
      ret = r
    }
    self.return_type = ret
    name = expr.resolved
    self.line("FUNC :${name}")
    self.indent = self.indent + 1
    self.line("ARGS")
    self.indent = self.indent + 1
    self.line("TYPE :ptr<void>")
    i = 0
    while i < fty.members.size {
      m = ty_myc(fty.members[i])
      self.line("TYPE :${m}")
      i = i + 1
    }
    self.indent = self.indent - 1
    self.emit_return_header
    self.line("BODY")
    self.indent = self.indent + 1
    self.reset_rooted
    self.line("CALL :avant_gc_enter")
    self.line("PARAM 0")
    if expr.cap_names.size == 0 {
      self.line("STACK :drop")
    } else {
      self.line("AS :ptr<${self.env_layout}>")
      self.line("LOCAL :__env :ptr<${self.env_layout}>")
      self.line("STORE")
      self.emit_ptr_root("__env")
    }
    if b = expr.block {
      ptys: Array(Ty) = []
      i = 0
      while i < b.params.size {
        if i < fty.members.size {
          ptys.push(fty.members[i])
        } else {
          ptys.push(ty_void())
        }
        i = i + 1
      }
      self.emit_param_group(b.params, ptys, 1)
      self.emit_stmts(b.body, true)
      self.emit_body_fallthrough(b.body)
    } else {
      self.emit_ret
    }
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDFUNC")
    self.blank
    self.indent = saved_indent
    self.temps = saved_temps
    self.return_type = saved_ret
    self.c_main = saved_main
    self.rooted = saved_rooted
    self.self_ty = saved_self
    self.self_name = saved_self_name
    self.in_lambda = false
  }

  pub fn emit_fn_trampoline(fnn: Function) {
    if sig = self.find_fn(fnn.emit_name) {
      name = "__fn_${fnn.emit_name}"
      saved_ret = self.return_type
      saved_main = self.c_main
      self.c_main = false
      self.return_type = sig.ret
      self.line("FUNC :${name}")
      self.indent = self.indent + 1
      self.line("ARGS")
      self.indent = self.indent + 1
      self.line("TYPE :ptr<void>")
      i = 0
      while i < sig.params.size {
        m = ty_myc(sig.params[i])
        self.line("TYPE :${m}")
        i = i + 1
      }
      self.indent = self.indent - 1
      self.emit_return_header
      self.line("BODY")
      self.indent = self.indent + 1
      self.line("PARAM 0")
      self.line("STACK :drop")
      i = sig.params.size - 1
      while i >= 0 {
        slot = i + 1
        self.line("PARAM ${slot}")
        i = i - 1
      }
      self.line("CALL :${fnn.emit_name}")
      self.line("RET")
      self.indent = self.indent - 1
      self.indent = self.indent - 1
      self.line("ENDFUNC")
      self.blank
      self.return_type = saved_ret
      self.c_main = saved_main
    }
  }

  pub fn emit_puts(arg: Expr) {
    self.emit_expr(arg)
    ty = expr_ty(arg)
    if ty.is_int {
      self.line("PUSH \"%d\\n\"")
      self.line("PRINTF 1")
      return
    }
    if ty.is_int64 {
      self.line("PUSH \"%lld\\n\"")
      self.line("PRINTF 1")
      return
    }
    if ty.is_uint64 {
      self.line("PUSH \"%llu\\n\"")
      self.line("PRINTF 1")
      return
    }
    if ty.is_string {
      self.line("PUSH \"%s\\n\"")
      self.line("PRINTF 1")
      return
    }
    if ty.is_float {
      self.line("PUSH \"%g\\n\"")
      self.line("PRINTF 1")
      return
    }
    if ty.is_bool {
      self.line("AS :i32")
      self.line("PUSH \"%d\\n\"")
      self.line("PRINTF 1")
    }
  }
}

pub fn emit_myc(program: Program): String {
  gen = MycGen.new(program)
  gen.emit
}
