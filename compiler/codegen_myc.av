  pub fn emit_json_f64(expr: Expr) {
    found = self.new_temp
    self.line("PUSH 0")
    self.line("LOCAL :${found} :i32")
    self.line("STORE")
    if expr.args.size > 1 {
      self.emit_expr(expr.args[1])
    }
    key = self.new_temp
    self.line("LOCAL :${key} :ptr<u8>")
    self.line("STORE")
    if expr.args.size > 0 {
      self.emit_expr(expr.args[0])
    }
    obj = self.new_temp
    self.line("LOCAL :${obj} :ptr<void>")
    self.line("STORE")
    self.line("LOCAL :${found}")
    self.line("ADDR")
    self.line("LOCAL :${key}")
    self.line("LOCAL :${obj}")
    self.line("CALL :avant_json_obj_f64")
    val_ty = ty_float()
    val = self.new_temp
    self.line("LOCAL :${val} :f64")
    self.line("STORE")
    want = ty_nilable(val_ty)
    held = self.new_temp
    self.line("LOCAL :${found}")
    self.line("PUSH 1")
    self.line("BINARY :eq")
    self.line("IF")
    self.indent = self.indent + 1
    self.line("THEN")
    self.indent = self.indent + 1
    self.line("LOCAL :${val}")
    self.emit_wrap_union(val_ty, want)
    wm = ty_myc(want)
    self.line("LOCAL :${held} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.line("ELSE")
    self.indent = self.indent + 1
    self.emit_zero(ty_nil())
    self.emit_wrap_union(ty_nil(), want)
    self.line("LOCAL :${held} :${wm}")
    self.line("STORE")
    self.indent = self.indent - 1
    self.indent = self.indent - 1
    self.line("ENDIF")
    self.line("LOCAL :${held}")
  }

