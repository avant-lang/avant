pub fn (codegen_self: MycGen) vcand_expr(e: Expr, names: Array(String), exprs: Array(Expr)) {
  if e.kind == ex_index() {
    if l = e.left {
      if l.kind == ex_name() {
        if l.implicit_field {
        } else {
          if codegen_self.name_is_boxed(l.ident) {
          } else {
            if codegen_self.cap_index(l.ident) >= 0 {
            } else {
              found = false
              i = 0
              while i < names.size {
                if str_eq(names[i], l.ident) {
                  found = true
                }
                i = i + 1
              }
              if found {
              } else {
                names.push(l.ident)
                exprs.push(l)
              }
            }
          }
        }
      }
    }
  }
  if b = e.block {
    j = 0
    while j < b.body.size {
      codegen_self.vcand_stmt(b.body[j], names, exprs)
      j = j + 1
