pub fn (codegen_self: MycGen) g_byte_max(e: Expr, out: Array(Int)): Bool {
  if e.kind == ex_int() {
    if e.int_bits <= 1000000u64 {
      out.push(e.int_bits.to_i)
      return true
    }
    return false
  }
  if e.kind == ex_index() {
    if l = e.left {
      t = expr_ty(l)
      if t.is_buf || t.is_bytes || t.is_string {
        out.push(255)
        return true
      }
    }
    return false
  }
  if inner = e.inner {
    return codegen_self.g_byte_max(inner, out)
  }
  if e.kind == ex_binary() {
    if l = e.left {
      if r = e.right {
        if e.op == tk_amp() {
          if r.kind == ex_int() {
            if r.int_bits <= 1000000u64 {
              out.push(r.int_bits.to_i)
              return true
            }
          }
          if l.kind == ex_int() {
            if l.int_bits <= 1000000u64 {
              out.push(l.int_bits.to_i)
              return true
            }
          }
          return false
        }
        if e.op == tk_percent() {
          if r.kind == ex_int() {
            if r.int_bits >= 1u64 {
              if r.int_bits <= 1000000u64 {
                lm: Array(Int) = []
                if codegen_self.g_byte_max(l, lm) {
                  m = lm[0]
                  lim = r.int_bits.to_i - 1
                  if lim < m {
                    m = lim
                  }
                  out.push(m)
                  return true
                }
                return false
              }
            }
          }
          return false
        }
        if e.op == tk_greater_greater() {
          if r.kind == ex_int() {
            if r.int_bits <= 1000000u64 {
              lm: Array(Int) = []
              if codegen_self.g_byte_max(l, lm) {
                sh = r.int_bits.to_i
                m = lm[0]
                if sh >= 31 {
                  m = 0
                } else if sh > 0 {
                  m = m >> sh
                }
                out.push(m)
                return true
              }
            }
          }
          return false
        }
        if e.op == tk_plus() {
          lm: Array(Int) = []
          rm: Array(Int) = []
          if codegen_self.g_byte_max(l, lm) {
            if codegen_self.g_byte_max(r, rm) {
              s = lm[0] + rm[0]
              if s <= 100000000 {
                out.push(s)
                return true
              }
            }
          }
          return false
        }
        if e.op == tk_star() {
          if l.kind == ex_int() {
            if l.int_bits <= 64u64 {
              rm: Array(Int) = []
              if codegen_self.g_byte_max(r, rm) {
                out.push(l.int_bits.to_i * rm[0])
                return true
              }
            }
            return false
          }
          if r.kind == ex_int() {
            if r.int_bits <= 64u64 {
              lm: Array(Int) = []
              if codegen_self.g_byte_max(l, lm) {
                out.push(r.int_bits.to_i * lm[0])
                return true
              }
            }
            return false
          }
          return false
        }
      }
    }
  }
  false
}

