pub fn (codegen_self: MycGen) is_codegen_temp(name: String): Bool {
  if name.size < 3 {
    return false
  }
  str_eq(str_slice(name, 0, 3), "__t")
}

pub fn (codegen_self: MycGen) note_loop_temp(name: String, myc: String) {
  if codegen_self.root_loop == 0 {
    return
  }
  if codegen_self.is_codegen_temp(name) {
  } else {
    return
  }
  i = 0
  while i < codegen_self.early_names.size {
    if str_eq(codegen_self.early_names[i], name) {
      return
    }
    i = i + 1
  }
  codegen_self.early_names.push(name)
  codegen_self.early_myc.push(myc)
}

pub fn (codegen_self: MycGen) clear_early_temps {
  i = 0
  while i < codegen_self.early_names.size {
    codegen_self.line("PUSH 0")
    codegen_self.line("AS :${codegen_self.early_myc[i]}")
    codegen_self.line("LOCAL :${codegen_self.early_names[i]}")
    codegen_self.line("STORE")
    i = i + 1
  }
  en: Array(String) = []
  codegen_self.early_names = en
  emc: Array(String) = []
  codegen_self.early_myc = emc
}

pub fn (codegen_self: MycGen) stmt_has_while(stmt: Stmt): Bool {
  if stmt.kind == st_while() {
    return true
  }
  if codegen_self.stmts_have_while(stmt.then_body) {
    return true
  }
  if codegen_self.stmts_have_while(stmt.else_body) {
    return true
  }
  codegen_self.stmts_have_while(stmt.body)
}

pub fn (codegen_self: MycGen) stmts_have_while(body: Array(Stmt)): Bool {
  i = 0
  while i < body.size {
    if codegen_self.stmt_has_while(body[i]) {
      return true
    }
    i = i + 1
  }
  false
}

pub fn (codegen_self: MycGen) hoist_em_is_scalar(em: String): Bool {
  if str_eq(em, "f64") || str_eq(em, "i32") || str_eq(em, "i64") || str_eq(em, "u8") || str_eq(em, "u32") || str_eq(em, "u64") {
    return true
  }
  false
}

pub fn (codegen_self: MycGen) has_scalar_hoist: Bool {
  i = 0
  while i < codegen_self.hoist_ems.size {
    if codegen_self.hoist_em_is_scalar(codegen_self.hoist_ems[i]) {
      return true
    }
    i = i + 1
  }
  false
}

// A leaf parallel loop indexes numeric buffers hoisted outside it.
// When every numeric buffer is stable, that copy uses the plain
// address and can vectorize. The other copy reloads, for a buffer a
// young collection can still move. Pointer buffers keep their check.
// Splitting only the leaf keeps the duplicated body to one loop.

pub fn (codegen_self: MycGen) should_split_while(stmt: Stmt): Bool {
  if codegen_self.may_share {
  } else {
    return false
  }
  if codegen_self.bits_only != 0 {
    return false
  }
  if codegen_self.has_scalar_hoist {
  } else {
    return false
  }
  if codegen_self.loop_may_collect(stmt) {
    return false
  }
  if codegen_self.stmts_have_while(stmt.body) {
    return false
  }
  true
}

pub fn (codegen_self: MycGen) emit_scalar_hoists_are_stable: String {
  stable = codegen_self.new_temp
  codegen_self.line("PUSH 1")
  codegen_self.line("LOCAL :${stable} :i32")
  codegen_self.line("STORE")
  i = 0
  while i < codegen_self.hoist_young.size {
    if codegen_self.hoist_em_is_scalar(codegen_self.hoist_ems[i]) {
      young = codegen_self.hoist_young[i]
      codegen_self.line("LOCAL :${young}")
      codegen_self.line("PUSH 0")
      codegen_self.line("BINARY :not_eq")
      codegen_self.line("IF")
      codegen_self.indent = codegen_self.indent + 1
      codegen_self.line("THEN")
      codegen_self.indent = codegen_self.indent + 1
      codegen_self.line("PUSH 0")
      codegen_self.line("LOCAL :${stable}")
      codegen_self.line("STORE")
      codegen_self.indent = codegen_self.indent - 1
      codegen_self.indent = codegen_self.indent - 1
      codegen_self.line("ENDIF")
    }
    i = i + 1
  }
  stable
}

pub fn (codegen_self: MycGen) versioned_for(arr: Expr): Bool {
  if arr.kind == ex_name() {
    if arr.implicit_field {
      return false
    }
    return codegen_self.versioned_has(arr.ident)
  }
  false
}

pub fn (codegen_self: MycGen) versioned_has(name: String): Bool {
  i = 0
  while i < codegen_self.versioned.size {
    if str_eq(codegen_self.versioned[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

pub fn (codegen_self: MycGen) cg_root_name(e: Expr): String {
  if e.kind == ex_name() {
    return e.ident
  }
  if e.kind == ex_field() {
    if obj = e.object {
      return codegen_self.cg_root_name(obj)
    }
  }
  if e.kind == ex_index() {
    if l = e.left {
      return codegen_self.cg_root_name(l)
    }
  }
  ""
}

pub fn (codegen_self: MycGen) mentions_name(e: Expr, name: String): Bool {
  if e.kind == ex_name() {
    return str_eq(e.ident, name)
  }
  if inner = e.inner {
    if codegen_self.mentions_name(inner, name) {
      return true
    }
  }
  if l = e.left {
    if codegen_self.mentions_name(l, name) {
      return true
    }
  }
  if r = e.right {
    if codegen_self.mentions_name(r, name) {
      return true
    }
  }
  if obj = e.object {
    if codegen_self.mentions_name(obj, name) {
      return true
    }
  }
  if recv = e.receiver {
    if codegen_self.mentions_name(recv, name) {
      return true
    }
  }
  i = 0
  while i < e.args.size {
    if codegen_self.mentions_name(e.args[i], name) {
      return true
    }
    i = i + 1
  }
  i = 0
  while i < e.elems.size {
    if codegen_self.mentions_name(e.elems[i], name) {
      return true
    }
    i = i + 1
  }
  i = 0
  while i < e.field_exprs.size {
    if codegen_self.mentions_name(e.field_exprs[i], name) {
      return true
    }
    i = i + 1
  }
  if sz = e.size_expr {
    if codegen_self.mentions_name(sz, name) {
      return true
    }
  }
  false
}

pub fn (codegen_self: MycGen) vscan_expr(e: Expr, buf_name: String, ivar: String, state: Array(Int)) {
  if e.kind == ex_index() {
    if l = e.left {
      if l.kind == ex_name() {
        if str_eq(l.ident, buf_name) {
          if r = e.right {
            if r.kind == ex_name() {
              if str_eq(r.ident, ivar) {
                state[1] = 1
              } else {
                state[0] = 1
              }
            } else if r.kind == ex_binary() {
              if r.op == tk_plus() {
                ok = false
                if rl = r.left {
                  if rr = r.right {
                    if rl.kind == ex_name() {
                      if str_eq(rl.ident, ivar) {
                        if rr.kind == ex_int() {
                          if rr.int_bits <= 1000000u64 {
                            off = rr.int_bits.to_i
                            if off > state[2] {
                              state[2] = off
                            }
                            state[1] = 1
                            ok = true
                          }
                        }
                      }
                    }
                    if rr.kind == ex_name() {
                      if str_eq(rr.ident, ivar) {
                        if rl.kind == ex_int() {
                          if rl.int_bits <= 1000000u64 {
                            off = rl.int_bits.to_i
                            if off > state[2] {
                              state[2] = off
                            }
                            state[1] = 1
                            ok = true
                          }
                        }
                      }
                    }
                  }
                }
                if ok {
                } else {
                  state[0] = 1
                }
              } else {
                state[0] = 1
              }
            } else {
              state[0] = 1
            }
          }
        }
      }
    }
  }
  if e.kind == ex_call() {
    if recv = e.receiver {
      if codegen_self.mentions_name(recv, buf_name) {
        if recv.kind == ex_index() {
        } else if str_eq(codegen_self.cg_root_name(recv), buf_name) {
          state[0] = 1
        }
      }
    }
    ai = 0
    while ai < e.args.size {
      if codegen_self.mentions_name(e.args[ai], buf_name) {
        state[0] = 1
      }
      ai = ai + 1
    }
  }
  if b = e.block {
    i = 0
    while i < b.params.size {
      if str_eq(b.params[i], ivar) || str_eq(b.params[i], buf_name) {
        state[0] = 1
      }
      i = i + 1
    }
    j = 0
    while j < b.body.size {
      codegen_self.vscan_stmt(b.body[j], buf_name, ivar, state)
      j = j + 1
    }
  }
  if inner = e.inner {
    codegen_self.vscan_expr(inner, buf_name, ivar, state)
  }
  if l = e.left {
    codegen_self.vscan_expr(l, buf_name, ivar, state)
  }
  if r = e.right {
    codegen_self.vscan_expr(r, buf_name, ivar, state)
  }
  if obj = e.object {
    codegen_self.vscan_expr(obj, buf_name, ivar, state)
  }
  if recv = e.receiver {
    codegen_self.vscan_expr(recv, buf_name, ivar, state)
  }
  i = 0
  while i < e.args.size {
    codegen_self.vscan_expr(e.args[i], buf_name, ivar, state)
    i = i + 1
  }
  i = 0
  while i < e.elems.size {
    codegen_self.vscan_expr(e.elems[i], buf_name, ivar, state)
    i = i + 1
  }
  i = 0
  while i < e.field_exprs.size {
    codegen_self.vscan_expr(e.field_exprs[i], buf_name, ivar, state)
    i = i + 1
  }
  if sz = e.size_expr {
    codegen_self.vscan_expr(sz, buf_name, ivar, state)
  }
  if c = e.cond {
    codegen_self.vscan_expr(c, buf_name, ivar, state)
  }
  i = 0
  while i < e.cases.size {
    cs = e.cases[i]
    j = 0
    while j < cs.body.size {
      codegen_self.vscan_stmt(cs.body[j], buf_name, ivar, state)
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < e.else_body.size {
    codegen_self.vscan_stmt(e.else_body[i], buf_name, ivar, state)
    i = i + 1
  }
  i = 0
  while i < e.parts.size {
    part = e.parts[i]
    if inner = part.expr {
      codegen_self.vscan_expr(inner, buf_name, ivar, state)
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) vscan_stmt(s: Stmt, buf_name: String, ivar: String, state: Array(Int)) {
  if s.kind == st_assign() {
    if t = s.target {
      if t.kind == ex_name() {
        if str_eq(t.ident, buf_name) {
          state[0] = 1
        }
      }
    }
  }
  if e = s.expr {
    codegen_self.vscan_expr(e, buf_name, ivar, state)
  }
  if c = s.cond {
    codegen_self.vscan_expr(c, buf_name, ivar, state)
  }
  if t = s.target {
    codegen_self.vscan_expr(t, buf_name, ivar, state)
  }
  if v = s.value {
    codegen_self.vscan_expr(v, buf_name, ivar, state)
  }
  i = 0
  while i < s.then_body.size {
    codegen_self.vscan_stmt(s.then_body[i], buf_name, ivar, state)
    i = i + 1
  }
  i = 0
  while i < s.else_body.size {
    codegen_self.vscan_stmt(s.else_body[i], buf_name, ivar, state)
    i = i + 1
  }
  i = 0
  while i < s.body.size {
    codegen_self.vscan_stmt(s.body[i], buf_name, ivar, state)
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) vassign_scan_stmt(s: Stmt, ivar: String, in_block: Bool, state: Array(Int)) {
  if s.kind == st_assign() {
    if t = s.target {
      if t.kind == ex_name() {
        if str_eq(t.ident, ivar) {
          state[1] = 1
          if in_block {
            state[0] = 1
          } else {
            ok = false
            if s.op == tk_plus_eq() {
              if v = s.value {
                if v.kind == ex_int() {
                  ok = true
                }
              }
            }
            if s.op == tk_eq() {
              if v = s.value {
                if v.kind == ex_binary() {
                  if v.op == tk_plus() {
                    if l = v.left {
                      if r = v.right {
                        if l.kind == ex_name() {
                          if str_eq(l.ident, ivar) {
                            if r.kind == ex_int() {
                              ok = true
                            }
                          }
                        }
                        if r.kind == ex_name() {
                          if str_eq(r.ident, ivar) {
                            if l.kind == ex_int() {
                              ok = true
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            if ok {
            } else {
              state[0] = 1
            }
          }
        }
      }
    }
  }
  if e = s.expr {
    codegen_self.vassign_scan_expr(e, ivar, in_block, state)
  }
  if c = s.cond {
    codegen_self.vassign_scan_expr(c, ivar, in_block, state)
  }
  if v = s.value {
    codegen_self.vassign_scan_expr(v, ivar, in_block, state)
  }
  i = 0
  while i < s.then_body.size {
    codegen_self.vassign_scan_stmt(s.then_body[i], ivar, in_block, state)
    i = i + 1
  }
  i = 0
  while i < s.else_body.size {
    codegen_self.vassign_scan_stmt(s.else_body[i], ivar, in_block, state)
    i = i + 1
  }
  i = 0
  while i < s.body.size {
    codegen_self.vassign_scan_stmt(s.body[i], ivar, in_block, state)
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) vassign_scan_expr(e: Expr, ivar: String, in_block: Bool, state: Array(Int)) {
  nb = in_block
  if b = e.block {
    j = 0
    while j < b.body.size {
      codegen_self.vassign_scan_stmt(b.body[j], ivar, true, state)
      j = j + 1
    }
    nb = true
  }
  if inner = e.inner {
    codegen_self.vassign_scan_expr(inner, ivar, nb, state)
  }
  if l = e.left {
    codegen_self.vassign_scan_expr(l, ivar, nb, state)
  }
  if r = e.right {
    codegen_self.vassign_scan_expr(r, ivar, nb, state)
  }
  if obj = e.object {
    codegen_self.vassign_scan_expr(obj, ivar, nb, state)
  }
  if recv = e.receiver {
    codegen_self.vassign_scan_expr(recv, ivar, nb, state)
  }
  i = 0
  while i < e.args.size {
    codegen_self.vassign_scan_expr(e.args[i], ivar, nb, state)
    i = i + 1
  }
  i = 0
  while i < e.elems.size {
    codegen_self.vassign_scan_expr(e.elems[i], ivar, nb, state)
    i = i + 1
  }
  i = 0
  while i < e.field_exprs.size {
    codegen_self.vassign_scan_expr(e.field_exprs[i], ivar, nb, state)
    i = i + 1
  }
  if sz = e.size_expr {
    codegen_self.vassign_scan_expr(sz, ivar, nb, state)
  }
  if c = e.cond {
    codegen_self.vassign_scan_expr(c, ivar, nb, state)
  }
  i = 0
  while i < e.cases.size {
    cs = e.cases[i]
    j = 0
    while j < cs.body.size {
      codegen_self.vassign_scan_stmt(cs.body[j], ivar, true, state)
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < e.else_body.size {
    codegen_self.vassign_scan_stmt(e.else_body[i], ivar, true, state)
    i = i + 1
  }
  i = 0
  while i < e.parts.size {
    part = e.parts[i]
    if inner = part.expr {
      codegen_self.vassign_scan_expr(inner, ivar, nb, state)
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) vcand_expr(e: Expr, names: Array(String), exprs: Array(Expr)) {
  if e.kind == ex_index() {
    if l = e.left {
      if l.kind == ex_name() {
        if l.implicit_field {
        } else {
          if codegen_self.name_is_boxed(l.ident) {
          } else {
            if codegen_self.cap_index(l.ident) >= 0 {
            } else {
              found = false
              i = 0
              while i < names.size {
                if str_eq(names[i], l.ident) {
                  found = true
                }
                i = i + 1
              }
              if found {
              } else {
                names.push(l.ident)
                exprs.push(l)
              }
            }
          }
        }
      }
    }
  }
  if b = e.block {
    j = 0
    while j < b.body.size {
      codegen_self.vcand_stmt(b.body[j], names, exprs)
      j = j + 1
    }
  }
  if inner = e.inner {
    codegen_self.vcand_expr(inner, names, exprs)
  }
  if l = e.left {
    codegen_self.vcand_expr(l, names, exprs)
  }
  if r = e.right {
    codegen_self.vcand_expr(r, names, exprs)
  }
  if obj = e.object {
    codegen_self.vcand_expr(obj, names, exprs)
  }
  if recv = e.receiver {
    codegen_self.vcand_expr(recv, names, exprs)
  }
  i = 0
  while i < e.args.size {
    codegen_self.vcand_expr(e.args[i], names, exprs)
    i = i + 1
  }
  i = 0
  while i < e.elems.size {
    codegen_self.vcand_expr(e.elems[i], names, exprs)
    i = i + 1
  }
  i = 0
  while i < e.field_exprs.size {
    codegen_self.vcand_expr(e.field_exprs[i], names, exprs)
    i = i + 1
  }
  if sz = e.size_expr {
    codegen_self.vcand_expr(sz, names, exprs)
  }
  if c = e.cond {
    codegen_self.vcand_expr(c, names, exprs)
  }
  i = 0
  while i < e.cases.size {
    cs = e.cases[i]
    j = 0
    while j < cs.body.size {
      codegen_self.vcand_stmt(cs.body[j], names, exprs)
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < e.else_body.size {
    codegen_self.vcand_stmt(e.else_body[i], names, exprs)
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) vcand_stmt(s: Stmt, names: Array(String), exprs: Array(Expr)) {
  if e = s.expr {
    codegen_self.vcand_expr(e, names, exprs)
  }
  if c = s.cond {
    codegen_self.vcand_expr(c, names, exprs)
  }
  if t = s.target {
    codegen_self.vcand_expr(t, names, exprs)
