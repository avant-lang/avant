}

pub fn (codegen_self: MycGen) g_classify(idx: Expr, gv: Array(String), assigned: Array(String), in_block: Bool, rk: Array(Int), rg: Array(String), ro: Array(Int), rinv: Array(Expr)): Bool {
  if idx.kind == ex_name() {
    if codegen_self.g_is_guard(idx.ident, gv) {
      rk.push(0)
      rg.push(idx.ident)
      ro.push(0)
      rinv.push(idx)
      return true
    }
  }
  fn2: Array(String) = []
  fo2: Array(Int) = []
  if codegen_self.g_guarded_form(idx, gv, fn2, fo2) {
    rk.push(0)
    rg.push(fn2[0])
    ro.push(fo2[0])
    rinv.push(idx)
    return true
  }
  an: Array(String) = []
  ao: Array(Int) = []
  ai: Array(Expr) = []
  ah: Array(Int) = []
  if codegen_self.g_affine(idx, gv, assigned, in_block, an, ao, ai, ah) {
    rg.push(an[0])
    ro.push(ao[0])
    if ah[0] == 1 {
      rk.push(2)
      rinv.push(ai[0])
    } else {
      rk.push(0)
      rinv.push(idx)
    }
    return true
  }
  if in_block {
  } else {
    if codegen_self.g_inv_pure(idx) {
      ma = 0
      if codegen_self.g_names_assigned(idx, assigned) {
        ma = 1
      }
      if ma == 0 {
        rk.push(1)
        rg.push("")
        ro.push(0)
        rinv.push(idx)
        return true
      }
    }
  }
  bm: Array(Int) = []
  if codegen_self.g_byte_max(idx, bm) {
    rk.push(3)
    rg.push("")
    ro.push(bm[0])
    rinv.push(idx)
    return true
  }
  if idx.kind == ex_name() {
    if idx.implicit_field {
    } else {
      rk.push(3)
      rg.push(idx.ident)
      ro.push(0 - 1)
      rinv.push(idx)
      return true
    }
  }
  false
}

