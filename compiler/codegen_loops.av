  }
  if recv = e.receiver {
    codegen_self.dscan_expr(recv, dv, tbl, node, st, in_block, nb)
  }
  i = 0
  while i < e.args.size {
    codegen_self.dscan_expr(e.args[i], dv, tbl, node, st, in_block, nb)
    i = i + 1
  }
  i = 0
  while i < e.elems.size {
    codegen_self.dscan_expr(e.elems[i], dv, tbl, node, st, in_block, nb)
    i = i + 1
  }
  i = 0
  while i < e.field_exprs.size {
    codegen_self.dscan_expr(e.field_exprs[i], dv, tbl, node, st, in_block, nb)
    i = i + 1
  }
  if sz = e.size_expr {
    codegen_self.dscan_expr(sz, dv, tbl, node, st, in_block, nb)
  }
  if c = e.cond {
    codegen_self.dscan_expr(c, dv, tbl, node, st, in_block, nb)
  }
  i = 0
  while i < e.cases.size {
    cs = e.cases[i]
    j = 0
    while j < cs.body.size {
      codegen_self.dscan_stmt(cs.body[j], dv, tbl, node, st, true, true)
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < e.else_body.size {
    codegen_self.dscan_stmt(e.else_body[i], dv, tbl, node, st, true, nb)
    i = i + 1
  }
  i = 0
  while i < e.parts.size {
    part = e.parts[i]
    if inner = part.expr {
      codegen_self.dscan_expr(inner, dv, tbl, node, st, in_block, nb)
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) dseek_stmt(s: Stmt, gv: Array(String), found: Array(String), st: Array(Int)) {
  if st[0] == 1 {
    return
