  }
  if inner = e.inner {
    codegen_self.vcand_expr(inner, names, exprs)
  }
  if l = e.left {
    codegen_self.vcand_expr(l, names, exprs)
  }
  if r = e.right {
    codegen_self.vcand_expr(r, names, exprs)
  }
  if obj = e.object {
    codegen_self.vcand_expr(obj, names, exprs)
  }
  if recv = e.receiver {
    codegen_self.vcand_expr(recv, names, exprs)
  }
  i = 0
  while i < e.args.size {
    codegen_self.vcand_expr(e.args[i], names, exprs)
    i = i + 1
  }
  i = 0
  while i < e.elems.size {
    codegen_self.vcand_expr(e.elems[i], names, exprs)
    i = i + 1
  }
  i = 0
  while i < e.field_exprs.size {
    codegen_self.vcand_expr(e.field_exprs[i], names, exprs)
    i = i + 1
  }
  if sz = e.size_expr {
    codegen_self.vcand_expr(sz, names, exprs)
  }
  if c = e.cond {
    codegen_self.vcand_expr(c, names, exprs)
  }
  i = 0
  while i < e.cases.size {
    cs = e.cases[i]
    j = 0
    while j < cs.body.size {
      codegen_self.vcand_stmt(cs.body[j], names, exprs)
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < e.else_body.size {
    codegen_self.vcand_stmt(e.else_body[i], names, exprs)
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) vcand_stmt(s: Stmt, names: Array(String), exprs: Array(Expr)) {
  if e = s.expr {
    codegen_self.vcand_expr(e, names, exprs)
  }
  if c = s.cond {
    codegen_self.vcand_expr(c, names, exprs)
  }
  if t = s.target {
    codegen_self.vcand_expr(t, names, exprs)
  }
  if v = s.value {
    codegen_self.vcand_expr(v, names, exprs)
  }
  i = 0
  while i < s.then_body.size {
    codegen_self.vcand_stmt(s.then_body[i], names, exprs)
    i = i + 1
  }
  i = 0
  while i < s.else_body.size {
    codegen_self.vcand_stmt(s.else_body[i], names, exprs)
    i = i + 1
  }
  i = 0
  while i < s.body.size {
    codegen_self.vcand_stmt(s.body[i], names, exprs)
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) d_qualify(stmt: Stmt, gvbufs: Array(String), vbufs: Array(String), gvar_l: Array(String), gle_l: Array(Int), gok_l: Array(Int), gbound_l: Array(Expr), gcand_names: Array(String), gcand_exprs: Array(Expr), oq: Array(String), otbl: Array(String), odv: Array(String), ogidx: Array(Int), onode: Array(Expr)) {
  dbufs: Array(String) = []
  dtbl = ""
  ddv = ""
  dgidx = 0 - 1
  dnode: Array(Expr) = []
  if vbufs.size == 0 {
    if gvbufs.size == 0 {
      if stmt.body.size <= 16 {
        if gcand_names.size > 0 {
          if gcand_names.size <= 6 {
            dst: Array(Int) = [0, 20000, 0, 0, 0]
            dany = false
            dai = 0
            while dai < gvar_l.size {
              if gok_l[dai] == 1 {
                if gle_l[dai] == 0 {
                  if gbound_l[dai].kind == ex_name() {
                    dany = true
                  }
                  if gbound_l[dai].kind == ex_int() {
                    dany = true
                  }
                }
              }
              dai = dai + 1
            }
            if dany {
            dfound: Array(String) = []
            dfi = 0
            while dfi < gvar_l.size {
              dfound.push("")
              dfi = dfi + 1
            }
            dsi0 = 0
            while dsi0 < stmt.body.size {
              codegen_self.dseek_stmt(stmt.body[dsi0], gvar_l, dfound, dst)
              dsi0 = dsi0 + 1
            }
            dst[0] = 0
            dgi = 0
            while dgi < gvar_l.size {
              if dgidx < 0 {
                if dfound[dgi].size > 0 {
                if gok_l[dgi] == 1 {
                  if gle_l[dgi] == 0 {
                    dbnd_ok = false
                    if gbound_l[dgi].kind == ex_name() {
                      dbnd_ok = true
                    }
                    if gbound_l[dgi].kind == ex_int() {
                      dbnd_ok = true
                    }
                    if dbnd_ok {
                      dst[0] = 0
                      dst[2] = 0
                      dst[3] = 0
                      tbln: Array(String) = []
                      tblnode: Array(Expr) = []
                      dsi = 0
                      while dsi < stmt.body.size {
                        codegen_self.dscan_stmt(stmt.body[dsi], gvar_l[dgi], tbln, tblnode, dst, false, false)
                        dsi = dsi + 1
                      }
                      if dst[0] == 0 {
                        if tbln.size == 1 {
                          dui = 0
                          while dui < stmt.body.size {
                            codegen_self.duse_stmt(stmt.body[dui], gvar_l[dgi], dst)
                            dui = dui + 1
                          }
                          if dst[0] == 0 {
                            qual: Array(String) = []
                            dbi = 0
                            while dbi < gcand_names.size {
                              dst[4] = 0
                              dui2 = 0
                              while dui2 < stmt.body.size {
                                codegen_self.dbuf_stmt(stmt.body[dui2], gcand_names[dbi], gvar_l[dgi], dst)
                                dui2 = dui2 + 1
                              }
                              if dst[4] == 0 {
                                if dst[0] == 0 {
                                  if expr_ty(gcand_exprs[dbi]).is_string {
                                  } else {
                                    qual.push(gcand_names[dbi])
                                  }
                                }
                              }
                              dbi = dbi + 1
                            }
                            if dst[0] == 0 {
                              if qual.size > 0 {
                                if codegen_self.name_listed(tbln[0], qual) {
                                  if expr_ty(tblnode[0]).is_int {
                                    dgidx = dgi
                                    ddv = gvar_l[dgi]
                                    dtbl = tbln[0]
                                    dbufs = qual
                                    dnode = tblnode
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
                }
              }
              dgi = dgi + 1
            }
            }
          }
        }
      }
    }
  }
  if dgidx >= 0 {
    qi = 0
    while qi < dbufs.size {
      oq.push(dbufs[qi])
      qi = qi + 1
    }
    otbl.push(dtbl)
    odv.push(ddv)
    ogidx.push(dgidx)
    if dnode.size > 0 {
      onode.push(dnode[0])
    }
  }
}

pub fn (codegen_self: MycGen) d_emit(stmt: Stmt, outer: Bool, dgidx: Int, gbound_l: Array(Expr), gcand_names: Array(String), gcand_exprs: Array(Expr), dbufs: Array(String), dtbl: String, ddv: String, dnode: Array(Expr)) {
    codegen_self.emit_expr(gbound_l[dgidx])
    dbt = codegen_self.new_temp
    codegen_self.line("LOCAL :${dbt} :i32")
    codegen_self.line("STORE")
    codegen_self.line("LOCAL :${dbt}")
    codegen_self.line("AS :i64")
    dbound = codegen_self.new_temp
    codegen_self.line("LOCAL :${dbound} :i64")
    codegen_self.line("STORE")
    dsizes: Array(String) = []
    dvb = 0
    while dvb < dbufs.size {
      dbname = dbufs[dvb]
      dbexpr: Expr? = nil
      dci = 0
      while dci < gcand_names.size {
        if str_eq(gcand_names[dci], dbname) {
          dbexpr = gcand_exprs[dci]
        }
        dci = dci + 1
      }
      dbty = ty_int()
      if dbe = dbexpr {
        dbty = expr_ty(dbe)
      }
      if dbty.is_string {
        codegen_self.line("LOCAL :${dbname}")
        codegen_self.line("CALL :avant_str_size")
        codegen_self.line("AS :i64")
      } else if dbty.is_buf {
        codegen_self.line("LOCAL :${dbname}")
        codegen_self.line("AS :ptr<AvantBuf>")
        codegen_self.line("DEREF")
        codegen_self.line("FIELD 1")
        codegen_self.line("AS :i64")
      } else {
        codegen_self.line("LOCAL :${dbname}")
        codegen_self.line("DEREF")
        codegen_self.line("FIELD 1")
        codegen_self.line("AS :i64")
      }
      dsz = codegen_self.new_temp
      codegen_self.line("LOCAL :${dsz} :i64")
      codegen_self.line("STORE")
      dsizes.push(dsz)
      dvb = dvb + 1
    }
    dtsz = dsizes[0]
    dvb = 0
    while dvb < dbufs.size {
      if str_eq(dbufs[dvb], dtbl) {
        dtsz = dsizes[dvb]
      }
      dvb = dvb + 1
    }
    ddi = codegen_self.new_temp
    ddok = codegen_self.new_temp
    codegen_self.line("PUSH 0")
    codegen_self.line("LOCAL :${ddi} :i32")
    codegen_self.line("STORE")
    codegen_self.line("PUSH 1 :i64")
    codegen_self.line("LOCAL :${ddok} :i64")
    codegen_self.line("STORE")
    codegen_self.line("LOOP")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("COND")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("LOCAL :${dtsz}")
    codegen_self.line("LOCAL :${ddi}")
    codegen_self.line("AS :i64")
    codegen_self.line("BINARY :less")
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("BODY")
    codegen_self.indent = codegen_self.indent + 1
    dtnode = dnode[0]
    dtx = clone_expr(dtnode)
    dtx.ty = dtnode.ty
    if dlo = dtnode.left {
      if dlc = dtx.left {
        dlc.ty = dlo.ty
      }
    }
    if dtr = dtnode.right {
      dtx.right = clone_expr(dtr)
      if dtrc = dtx.right {
        dtrc.ty = dtr.ty
      }
    }
    if dtr2 = dtx.right {
      dtr2.ident = ddi
    }
    codegen_self.emit_expr(dtx)
    dent = codegen_self.new_temp
    codegen_self.line("LOCAL :${dent} :i32")
    codegen_self.line("STORE")
    codegen_self.line("PUSH 0 :i64")
    codegen_self.line("LOCAL :${dent}")
    codegen_self.line("AS :i64")
    codegen_self.line("BINARY :less")
    codegen_self.line("IF")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("THEN")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("PUSH 0 :i64")
    codegen_self.line("LOCAL :${ddok} :i64")
    codegen_self.line("STORE")
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("ENDIF")
    codegen_self.line("LOCAL :${dbound}")
    codegen_self.line("LOCAL :${dent}")
    codegen_self.line("AS :i64")
    codegen_self.line("BINARY :more_eq")
    codegen_self.line("IF")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("THEN")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("PUSH 0 :i64")
    codegen_self.line("LOCAL :${ddok} :i64")
    codegen_self.line("STORE")
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("ENDIF")
    codegen_self.line("LOCAL :${ddi}")
    codegen_self.line("PUSH 1")
    codegen_self.line("BINARY :add")
    codegen_self.line("LOCAL :${ddi} :i32")
    codegen_self.line("STORE")
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("ENDLOOP")
    codegen_self.line("PUSH true")
    codegen_self.line("PUSH 0 :i64")
    codegen_self.line("LOCAL :${ddv}")
    codegen_self.line("AS :i64")
    codegen_self.line("BINARY :more_eq")
    codegen_self.line("BINARY :and")
    dvb = 0
    while dvb < dbufs.size {
      codegen_self.line("LOCAL :${dsizes[dvb]}")
      codegen_self.line("PUSH 1 :i64")
      codegen_self.line("LOCAL :${dbound}")
      codegen_self.line("BINARY :sub")
      codegen_self.line("BINARY :less")
      codegen_self.line("BINARY :and")
      dvb = dvb + 1
    }
    codegen_self.line("LOCAL :${ddok}")
    codegen_self.line("PUSH 0 :i64")
    codegen_self.line("BINARY :not_eq")
    codegen_self.line("BINARY :and")
    codegen_self.line("IF")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("THEN")
    codegen_self.indent = codegen_self.indent + 1
    saved_verd = codegen_self.versioned
    codegen_self.versioned = dbufs
    codegen_self.emit_while_loop(stmt, outer)
    codegen_self.versioned = saved_verd
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("ELSE")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.emit_while_loop(stmt, outer)
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("ENDIF")
}

pub fn (codegen_self: MycGen) emit_while_loop(stmt: Stmt, outer: Bool) {
  codegen_self.root_loop = codegen_self.root_loop + 1
  codegen_self.line("LOOP")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("COND")
  codegen_self.indent = codegen_self.indent + 1
  if c = stmt.cond {
    codegen_self.emit_expr(c)
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("BODY")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.cov_branch(stmt.loc)
  codegen_self.emit_stmts(stmt.body, false)
  if outer {
    codegen_self.clear_early_temps
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDLOOP")
  codegen_self.root_loop = codegen_self.root_loop - 1
}

pub fn (codegen_self: MycGen) emit_while(stmt: Stmt) {
  nhoist = codegen_self.begin_loop_hoists(stmt)
  outer = false
  if codegen_self.root_loop == 0 {
    outer = true
    fresh = buf_new()
    codegen_self.early_out = fresh
    codegen_self.early_indent = codegen_self.indent
    en: Array(String) = []
    codegen_self.early_names = en
    emc: Array(String) = []
    codegen_self.early_myc = emc
  }
  saved = codegen_self.out
  body = buf_new()
  codegen_self.out = body
  vbufs: Array(String) = []
  vmaxs: Array(Int) = []
  cand_names: Array(String) = []
  cand_exprs: Array(Expr) = []
  vivar = ""
  vle2 = false
  vcoff2 = 0
  vbound: Expr? = nil
  gdone = false
  gvbufs: Array(String) = []
  gvar_l: Array(String) = []
  gle_l: Array(Int) = []
  gcoff_l: Array(Int) = []
  gbound_l: Array(Expr) = []
  gok_l: Array(Int) = []
  gcand_names: Array(String) = []
  gcand_exprs: Array(Expr) = []
  gassigned: Array(String) = []
  if c = stmt.cond {
    conj: Array(Expr) = []
    codegen_self.gsplit(c, conj)
    gci = 0
    while gci < conj.size {
      leaf = conj[gci]
      if leaf.kind == ex_binary() {
        if leaf.op == tk_less() || leaf.op == tk_less_eq() {
          if ll = leaf.left {
            if rr = leaf.right {
              gn = ""
              gc2 = 0
              if ll.kind == ex_name() {
                gn = ll.ident
              } else if ll.kind == ex_binary() {
                if ll.op == tk_plus() {
                  if lll = ll.left {
                    if llr = ll.right {
                      if lll.kind == ex_name() {
                        if llr.kind == ex_int() {
                          if llr.int_bits <= 1000000u64 {
                            gn = lll.ident
                            gc2 = llr.int_bits.to_i
                          }
                        }
                      }
                      if llr.kind == ex_name() {
                        if lll.kind == ex_int() {
                          if lll.int_bits <= 1000000u64 {
                            gn = llr.ident
                            gc2 = lll.int_bits.to_i
                          }
                        }
                      }
                    }
                  }
                }
              }
              if gn.size > 0 {
                gvar_l.push(gn)
                if leaf.op == tk_less_eq() {
                  gle_l.push(1)
                } else {
                  gle_l.push(0)
                }
                gcoff_l.push(gc2)
                gbound_l.push(rr)
                gok_l.push(0)
              }
            }
          }
        }
      }
      gci = gci + 1
    }
  }
  if true {
    if true {
      if c = stmt.cond {
        cc = c
        if cc.kind == ex_binary() {
          if cc.op == tk_amp_amp() {
            if cl0 = cc.left {
              cc = cl0
            }
          }
        }
        if cc.kind == ex_binary() {
          if cc.op == tk_less() || cc.op == tk_less_eq() {
            if cc.op == tk_less_eq() {
              vle2 = true
            }
            if cl = cc.left {
              if cr = cc.right {
                vbound = cr
                if cl.kind == ex_name() {
                  vivar = cl.ident
                } else if cl.kind == ex_binary() {
                  if cl.op == tk_plus() {
                    if cll = cl.left {
                      if clr = cl.right {
                        if cll.kind == ex_name() {
                          if clr.kind == ex_int() {
                            vivar = cll.ident
                            vcoff2 = clr.int_bits.to_i
                          }
                        }
                        if clr.kind == ex_name() {
                          if cll.kind == ex_int() {
                            vivar = clr.ident
                            vcoff2 = cll.int_bits.to_i
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  if vivar.size > 0 {
    ci0 = 0
    while ci0 < stmt.body.size {
      codegen_self.vcand_stmt(stmt.body[ci0], cand_names, cand_exprs)
      ci0 = ci0 + 1
    }
    bi = 0
    while bi < cand_names.size {
      bname = cand_names[bi]
      state: Array(Int) = [0, 0, 0]
      si = 0
      while si < stmt.body.size {
        codegen_self.vscan_stmt(stmt.body[si], bname, vivar, state)
        si = si + 1
      }
      if state[0] == 0 {
        if state[1] == 1 {
          ast: Array(Int) = [0, 0]
          first_assign = 0 - 1
          sj = 0
          while sj < stmt.body.size {
            ust: Array(Int) = [0, 0, 0]
            codegen_self.vscan_stmt(stmt.body[sj], bname, vivar, ust)
            ast2: Array(Int) = [0, 0]
            codegen_self.vassign_scan_stmt(stmt.body[sj], vivar, false, ast2)
            if ast2[1] == 1 {
              if first_assign < 0 {
                first_assign = sj
                if ust[1] == 1 {
                  state[0] = 1
                }
              }
            } else {
              if first_assign >= 0 {
                if ust[1] == 1 {
                  state[0] = 1
                }
              }
            }
            if ast2[0] == 1 {
              state[0] = 1
            }
            sj = sj + 1
          }
          if state[0] == 0 {
            vbufs.push(bname)
            vmaxs.push(state[2])
          }
        }
      }
      bi = bi + 1
    }
  }
  if gbound_l.size > 0 {
  gci0 = 0
  while gci0 < stmt.body.size {
    codegen_self.vcand_stmt(stmt.body[gci0], gcand_names, gcand_exprs)
    gci0 = gci0 + 1
  }
  if gcand_names.size > 0 {
    gassigned = codegen_self.loop_assigned(stmt)
    gfi = 0
    while gfi < gvar_l.size {
      if codegen_self.g_pure_bound(gbound_l[gfi], gassigned) {
        gok_l[gfi] = 1
      }
      gfi = gfi + 1
    }
  }
  ord_var: Array(String) = []
  ord_bad: Array(Int) = []
  ord_first: Array(Int) = []
  goi = 0
  while goi < gvar_l.size {
    if codegen_self.name_listed(gvar_l[goi], ord_var) {
    } else {
      obad = 0
      ofirst = 0 - 1
      gsj0 = 0
      while gsj0 < stmt.body.size {
        ast0: Array(Int) = [0, 0]
        codegen_self.vassign_scan_stmt(stmt.body[gsj0], gvar_l[goi], false, ast0)
        if ast0[0] == 1 {
          obad = 1
        }
        if ast0[1] == 1 {
          if ofirst < 0 {
            ofirst = gsj0
          }
        }
        gsj0 = gsj0 + 1
      }
      ord_var.push(gvar_l[goi])
      ord_bad.push(obad)
      ord_first.push(ofirst)
    }
    goi = goi + 1
  }
  gbi = 0
  while gbi < gcand_names.size {
    gbname = gcand_names[gbi]
    gskip = 0
    if codegen_self.name_listed(gbname, vbufs) {
      gskip = 1
    }
    if gskip == 0 {
    grk: Array(Int) = []
    grg: Array(String) = []
    gro: Array(Int) = []
    grinv: Array(Expr) = []
    gstate: Array(Int) = [0]
    gsi = 0
    while gsi < stmt.body.size {
      codegen_self.vscan2_stmt(stmt.body[gsi], gbname, gvar_l, gassigned, grk, grg, gro, grinv, gstate, false)
      gsi = gsi + 1
    }
    if gstate[0] == 0 {
      if grk.size > 0 {
        gbad = 0
        gui = 0
        while gui < grk.size {
          if grk[gui] == 3 {
            if gro[gui] < 0 {
              bmo: Array(Int) = []
              if codegen_self.g_byte_name_bound(stmt, grg[gui], gbname, bmo) {
                gro[gui] = bmo[0]
              } else {
                gbad = 1
              }
            }
          } else if grk[gui] != 1 {
            usedv = grg[gui]
            seen_before = 0
            guj = 0
            while guj < gui {
              if grk[guj] != 1 {
                if str_eq(grg[guj], usedv) {
                  seen_before = 1
                }
              }
              guj = guj + 1
            }
            if seen_before == 0 {
              usable = 0
              ggj = 0
              while ggj < gvar_l.size {
                if str_eq(gvar_l[ggj], usedv) {
