  if st[1] <= 0 {
    st[0] = 1
    return
  }
  st[1] = st[1] - 1
  if s.kind == st_assign() {
    if t = s.target {
      if t.kind == ex_name() {
        if v = s.value {
          if v.kind == ex_index() {
            if l = v.left {
              if l.kind == ex_name() {
                if r = v.right {
                  if r.kind == ex_name() {
                    gi = 0
                    while gi < gv.size {
                      if str_eq(t.ident, gv[gi]) {
                        if str_eq(r.ident, gv[gi]) {
                          if found[gi].size == 0 {
                            found[gi] = l.ident
                          }
                        }
                      }
                      gi = gi + 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  i = 0
  while i < s.then_body.size {
    codegen_self.dseek_stmt(s.then_body[i], gv, found, st)
    i = i + 1
  }
  i = 0
  while i < s.else_body.size {
    codegen_self.dseek_stmt(s.else_body[i], gv, found, st)
    i = i + 1
  }
  i = 0
  while i < s.body.size {
    codegen_self.dseek_stmt(s.body[i], gv, found, st)
    i = i + 1
  }
  i = 0
  while i < s.pre.size {
    codegen_self.dseek_stmt(s.pre[i], gv, found, st)
    i = i + 1
  }
}


pub fn (codegen_self: MycGen) duse_stmt(s: Stmt, dv: String, st: Array(Int)) {
