          if r = e.right {
            if codegen_self.mentions_name(r, gvar) {
              state[0] = 1
            }
          }
        }
      }
    }
  }
  if b = e.block {
    j = 0
    while j < b.body.size {
      codegen_self.guses_stmt(b.body[j], buf_name, gvar, state)
      j = j + 1
    }
  }
  if inner = e.inner {
    codegen_self.guses_expr(inner, buf_name, gvar, state)
  }
  if l = e.left {
    codegen_self.guses_expr(l, buf_name, gvar, state)
  }
  if r = e.right {
    codegen_self.guses_expr(r, buf_name, gvar, state)
  }
  if obj = e.object {
    codegen_self.guses_expr(obj, buf_name, gvar, state)
  }
  if recv = e.receiver {
    codegen_self.guses_expr(recv, buf_name, gvar, state)
  }
  i = 0
  while i < e.args.size {
    codegen_self.guses_expr(e.args[i], buf_name, gvar, state)
    i = i + 1
  }
  i = 0
  while i < e.elems.size {
    codegen_self.guses_expr(e.elems[i], buf_name, gvar, state)
    i = i + 1
  }
  i = 0
  while i < e.field_exprs.size {
    codegen_self.guses_expr(e.field_exprs[i], buf_name, gvar, state)
    i = i + 1
  }
  if sz = e.size_expr {
    codegen_self.guses_expr(sz, buf_name, gvar, state)
  }
  if c = e.cond {
    codegen_self.guses_expr(c, buf_name, gvar, state)
  }
  i = 0
  while i < e.cases.size {
    cs = e.cases[i]
    j = 0
    while j < cs.body.size {
      codegen_self.guses_stmt(cs.body[j], buf_name, gvar, state)
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < e.else_body.size {
    codegen_self.guses_stmt(e.else_body[i], buf_name, gvar, state)
    i = i + 1
  }
  i = 0
  while i < e.parts.size {
    part = e.parts[i]
    if inner = part.expr {
      codegen_self.guses_expr(inner, buf_name, gvar, state)
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) guses_stmt(s: Stmt, buf_name: String, gvar: String, state: Array(Int)) {
  if e = s.expr {
    codegen_self.guses_expr(e, buf_name, gvar, state)
  }
  if c = s.cond {
    codegen_self.guses_expr(c, buf_name, gvar, state)
  }
  if t = s.target {
    codegen_self.guses_expr(t, buf_name, gvar, state)
  }
  if v = s.value {
    codegen_self.guses_expr(v, buf_name, gvar, state)
  }
  i = 0
  while i < s.then_body.size {
    codegen_self.guses_stmt(s.then_body[i], buf_name, gvar, state)
    i = i + 1
  }
  i = 0
  while i < s.else_body.size {
    codegen_self.guses_stmt(s.else_body[i], buf_name, gvar, state)
    i = i + 1
  }
  i = 0
  while i < s.body.size {
    codegen_self.guses_stmt(s.body[i], buf_name, gvar, state)
    i = i + 1
  }
}

// Dispatch versioning (Wave K Part 4 retry): a guard variable D
// reassigned only by loads from one jump table T (D = T[D]) or by
// top-level literal steps (D = D + lit, D += lit) qualifies the
// buffers it indexes for a versioned fast copy when every entry of
// T is validated at loop entry to lie in [0, B), where B is the
// guard bound. Every scan below shares one work budget in st[1]:
// each statement or expression visit consumes one step, and running
// out sets the bad flag and declines the loop, so the analysis
// terminates on any input by construction. The budget is 20000
// node visits per loop attempt, with gates of at most 16 top-level
// body statements and at most 6 candidate buffers. st[0] is the
// global bad flag, st[2] records a step assignment seen in scan
// order, st[3] records any assignment to D seen in scan order, and
// st[4] is the per-buffer bad flag. The scans run only for loops
// no existing versioning path could version.

pub fn (codegen_self: MycGen) d_table_load(v: Expr, dv: String, tbl: Array(String), node: Array(Expr), st: Array(Int)): Bool {
  if v.kind == ex_index() {
    if l = v.left {
      if l.kind == ex_name() {
        if r = v.right {
          if r.kind == ex_name() {
            if str_eq(r.ident, dv) {
              if tbl.size == 0 {
                tbl.push(l.ident)
                node.push(v)
                return true
              }
              if str_eq(tbl[0], l.ident) {
                return true
              }
              st[0] = 1
              return true
            }
          }
        }
      }
    }
  }
  false
}

pub fn (codegen_self: MycGen) d_step_form(v: Expr, dv: String): Bool {
  if v.kind == ex_binary() {
    if v.op == tk_plus() {
      if l = v.left {
        if r = v.right {
          if l.kind == ex_name() {
            if str_eq(l.ident, dv) {
              if r.kind == ex_int() {
                return true
              }
            }
          }
          if r.kind == ex_name() {
            if str_eq(r.ident, dv) {
              if l.kind == ex_int() {
                return true
              }
            }
          }
        }
      }
    }
  }
  false
}

pub fn (codegen_self: MycGen) dscan_stmt(s: Stmt, dv: String, tbl: Array(String), node: Array(Expr), st: Array(Int), in_block: Bool, nested: Bool) {
  if st[0] == 1 {
    return
  }
  if st[1] <= 0 {
    st[0] = 1
    return
  }
  st[1] = st[1] - 1
  if s.kind == st_assign() {
    if t = s.target {
      if t.kind == ex_name() {
        if str_eq(t.ident, dv) {
          if nested {
            st[0] = 1
          } else if s.op == tk_plus_eq() {
            if in_block {
              st[0] = 1
            } else {
              if v = s.value {
                if v.kind == ex_int() {
                  st[2] = 1
                } else {
                  st[0] = 1
                }
              } else {
                st[0] = 1
              }
            }
          } else if s.op == tk_eq() {
            if v = s.value {
              if codegen_self.d_table_load(v, dv, tbl, node, st) {
                if st[2] == 1 {
                  st[0] = 1
                }
              } else if codegen_self.d_step_form(v, dv) {
                if in_block {
                  st[0] = 1
                } else {
                  st[2] = 1
                }
              } else {
                st[0] = 1
              }
            } else {
              st[0] = 1
            }
          } else {
            st[0] = 1
          }
        }
      }
    }
  }
  if e = s.expr {
    codegen_self.dscan_expr(e, dv, tbl, node, st, in_block, nested)
  }
  if c = s.cond {
    codegen_self.dscan_expr(c, dv, tbl, node, st, in_block, nested)
  }
  if t = s.target {
    codegen_self.dscan_expr(t, dv, tbl, node, st, in_block, nested)
  }
  if v = s.value {
    codegen_self.dscan_expr(v, dv, tbl, node, st, in_block, nested)
  }
  i = 0
  while i < s.then_body.size {
    codegen_self.dscan_stmt(s.then_body[i], dv, tbl, node, st, true, nested)
    i = i + 1
  }
  i = 0
  while i < s.else_body.size {
    codegen_self.dscan_stmt(s.else_body[i], dv, tbl, node, st, true, nested)
    i = i + 1
  }
  nb = nested
  if s.kind == st_while() {
    nb = true
  }
  i = 0
  while i < s.body.size {
    codegen_self.dscan_stmt(s.body[i], dv, tbl, node, st, in_block, nb)
    i = i + 1
  }
  i = 0
  while i < s.pre.size {
    codegen_self.dscan_stmt(s.pre[i], dv, tbl, node, st, in_block, nb)
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) dscan_expr(e: Expr, dv: String, tbl: Array(String), node: Array(Expr), st: Array(Int), in_block: Bool, nested: Bool) {
  if st[0] == 1 {
    return
  }
  if st[1] <= 0 {
    st[0] = 1
    return
  }
  st[1] = st[1] - 1
  nb = nested
  if b = e.block {
    j = 0
    while j < b.body.size {
      codegen_self.dscan_stmt(b.body[j], dv, tbl, node, st, true, true)
      j = j + 1
    }
    nb = true
  }
  if inner = e.inner {
    codegen_self.dscan_expr(inner, dv, tbl, node, st, in_block, nb)
  }
  if l = e.left {
    codegen_self.dscan_expr(l, dv, tbl, node, st, in_block, nb)
  }
