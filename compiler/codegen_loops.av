    if v = s.value {
      codegen_self.duse_expr(v, dv, st, false)
    }
  }
  i = 0
  while i < s.then_body.size {
    codegen_self.duse_stmt(s.then_body[i], dv, st)
    i = i + 1
  }
  i = 0
  while i < s.else_body.size {
    codegen_self.duse_stmt(s.else_body[i], dv, st)
    i = i + 1
  }
  i = 0
  while i < s.body.size {
    codegen_self.duse_stmt(s.body[i], dv, st)
    i = i + 1
  }
  i = 0
  while i < s.pre.size {
    codegen_self.duse_stmt(s.pre[i], dv, st)
    i = i + 1
  }
}

