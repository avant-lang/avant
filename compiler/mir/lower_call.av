// The lowering of calls and scalar members (Stage 28 W5b;
// stages/stage28/mir.md W5.2, W5.3): direct calls of the program's plain
// functions, the builtins `puts`, `puts_u`, `now_ms`, `now_us`, `sqrt`,
// `exp`, and the conversions and members of Int, Int64, UInt64 (`to_f
// to_i to_i64 to_u64 abs`) and Float64 (`to_i abs floor sqrt exp`), in
// their field (`x.to_f`) and call (`x.to_f()`) forms.

import location
import source
import token
import type
import ast
import typed_ir
import mir.types
import mir.ir
import mir.build
import mir.lower_ty
import mir.lower
import mir.lower_expr

// The old back end's builtins outside the supported subset (calls.av:
// 16-372): each is refused by name. The string builtins are in
// lower_str.av.
pub fn mir_other_builtin(name: String): Bool {
  names = ["spawn", "avant_gate_new", "avant_gate_lock", "avant_gate_unlock", "avant_gate_wait", "avant_gate_signal", "avant_gate_broadcast"]
  // W8b: lower_task.av lowers these in their checked forms first; what
  // reaches this list is a form the checker would not accept.
  for nm in names {
    if nm == name {
      return true
    }
  }
  false
}

// Arguments left to right, each snapshotted when a later one contains a
// switch (W5.3).
pub fn (lw: MirLower) lower_args(args: Array(Expr)): Array(MOperand) {
  out: Array(MOperand) = []
  i = 0
  while i < args.size {
    o = lw.lower_expr(args[i])
    j = i + 1
    while j < args.size {
      o = lw.snap(o, args[j])
      j += 1
    }
    out.push(o)
    i += 1
  }
  out
}

// A call into a fresh temporary of type ty (none when ty is void).
pub fn (lw: MirLower) call_to(ty: Int, callee: String, args: Array(MOperand)): MOperand {
  b = lw.lw_b
  if ty == mt_void() {
    b.call(-1, callee, args)
    return b.c_i32(0)
  }
  t = b.temp(ty)
  b.call(t, callee, args)
  b.copy_local(t)
}

pub fn (lw: MirLower) call_f64(callee: String, a: MOperand): MOperand {
  args: Array(MOperand) = []
  args.push(a)
  lw.call_to(mt_f64(), callee, args)
}

pub fn (lw: MirLower) lower_call(e: Expr): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  if e.type_call {
    if e.resolved == "Regex__compile" && e.args.size >= 2 {
      if got0 = lw.lower_re2c_compile(e) {
        return got0
      }
    }
    if got = lw.lower_named_call(e) {
      return got
    }
    lw.refuse(e.loc, "the type-level call ${e.callee}")
    return zero
  }
  if e.indirect {
    return lw.lower_indirect(e)
  }
  if e.lib_name.size > 0 {
    return lw.lower_lib_call(e)
  }
  // W8b: spawn, join, .parallel, Mutex.with, the gate builtins.
  if got_task = lw.lower_task_call(e) {
    return got_task
  }
  if bl = e.block {
    // W7b: the block forms of the Array and Hash builtins (lower_block.av);
    // spawn, .parallel, and Mutex.with are lower_task.av's (W8b).
    if got = lw.lower_block_call(e) {
      return got
    }
    lw.refuse(e.loc, "a call with a block (${e.callee})")
    return zero
  }
  if recv = e.receiver {
    if recv.kind == ex_name() && recv.ident == "String" && e.callee == "from_utf8" && e.args.size == 1 {
      // W8a: String.from_utf8(bytes) (builtins.av emit_from_utf8): the
      // runtime's string with an ok flag, as String?.
      return lw.lower_opt_cstr(e, "avant_str_from_utf8")
    }
    if rt = recv.ty {
      if e.callee == "or" && rt.is_union && e.args.size == 1 {
        if t = e.ty {
          return lw.lower_coalesce(recv, e.args[0], t, e.loc)
        }
      }
      // A user method on any type (Expr.resolved names a program method;
      // the builtin members have none, W6a.1).
      if !ast_is_ctor_call(e) && e.resolved.size > 0 {
        if sym0 = lw.lw_fn_syms.get(e.resolved) {
          if ms0 = lw.lw_syms.find_method_emit(e.resolved) {
            return lw.lower_method_call(e, recv, rt, sym0, e.args)
          }
        }
      }
      if (mir_is_str_ty(rt) || rt.is_buf) && e.callee == "get" {
        return lw.lower_get(e, recv, rt, e.args)
      }
      if (rt.is_integer || rt.is_float) && e.args.size == 0 {
        return lw.member(recv, rt, e.callee, e)
      }
      if mir_is_str_ty(rt) && e.resolved.size == 0 {
        return lw.str_member(e, recv, rt, e.callee, e.args)
      }
      if rt.is_array {
        return lw.arr_member(e, recv, rt, e.callee, e.args)
      }
      if rt.is_hash {
        return lw.hash_member(e, recv, rt, e.callee, e.args)
      }
      if rt.is_buf {
        return lw.buf_member(e, recv, e.callee, e.args)
      }
      if (rt.is_class || rt.is_struct) && !ast_is_ctor_call(e) {
        if sym = lw.lw_fn_syms.get(e.resolved) {
          return lw.lower_method_call(e, recv, rt, sym, e.args)
        }
      }
    }
    if ast_is_ctor_call(e) {
      if got = lw.lower_named_call(e) {
        return got
      }
    }
    lw.refuse(e.loc, "the method call .${e.callee}")
    return zero
  }
  c = e.callee
  if c == "puts" || c == "puts_u" {
    if e.args.size == 1 {
      return lw.lower_puts(e.args[0], c == "puts_u", e.loc)
    }
  }
  // The 64-bit clock (Stage 29 W4b1, D295 R6): monotonic milliseconds
  // and microseconds as Int64 (avant_now_ms and avant_now_us, the Int
  // readings that wrapped, stay for the seed v0.40.0's compiler).
  if c == "now_ms" || c == "now_us" {
    lw.at(e.loc)
    none: Array(MOperand) = []
    unit = "ms"
    if c == "now_us" {
      unit = "us"
    }
    return lw.call_to(mt_i64(), "avant_clock_${unit}", none)
  }
  if (c == "sqrt" || c == "exp") && e.args.size == 1 {
    a = lw.lower_expr(e.args[0])
    if lw.failed {
      return zero
    }
    lw.at(e.loc)
    if c == "sqrt" {
      return lw.call_f64("sqrt", a)
    }
    return lw.call_f64("exp", a)
  }
  if mir_str_builtin_arity(c) == e.args.size {
    return lw.lower_str_builtin(e, c)
  }
  if got = lw.heap_builtin(e, c) {
    return got
  }
  if got2 = lw.io_builtin(e, c) {
    return got2
  }
  if (c == "process_run" && e.args.size == 2) || (c == "process_run_out" && e.args.size == 3) {
    // W8a (calls.av emit_process_run, emit_process_run_out): the path,
    // the arguments array, the output path, left to right (the old back
    // end evaluates them right to left).
    ops = lw.lower_args(e.args)
    if lw.failed {
      return zero
    }
    lw.at(e.loc)
    return lw.call_to(mt_i32(), "avant_${c}", ops)
  }
  if mir_other_builtin(c) {
    lw.refuse(e.loc, "the builtin ${c}")
    return zero
  }
  name = e.resolved
  if name.size == 0 {
    name = c
  }
  if sym = lw.lw_fn_syms.get(name) {
    if fs = lw.lw_syms.find_fn(name) {
      ret = lw.ty_at(fs.ret, e.loc, "a call result")
      args = lw.lower_args_to(e.args, fs.params)
      if lw.failed {
        return zero
      }
      lw.at(e.loc)
      return lw.call_to(ret, sym, args)
    }
  }
  lw.refuse(e.loc, "the call ${c}")
  zero
}

// puts (calls.av:2043-2075): printf with the old formats for integers
// and strings; puts_u prints "%u\n". A Float64 prints its one text and a
// Bool the word true or false (Stage 29 W4b1, D293, D295 R7), through
// avant_puts_f64 and avant_puts_bool; a String prints by its length
// (avant_puts_str), a NUL byte included.
pub fn (lw: MirLower) lower_puts(arg: Expr, unsigned: Bool, loc: Location): MOperand {
  b = lw.lw_b
  ty = lw.ety(arg)
  v = lw.lower_expr(arg)
  if lw.failed {
    return b.c_i32(0)
  }
  lw.at(loc)
  if !unsigned && ty == mt_f64() {
    b.call(-1, "avant_puts_f64", lw.one(v))
    return b.c_i32(0)
  }
  if !unsigned && ty == mt_str() {
    b.call(-1, "avant_puts_str", lw.one(v))
    return b.c_i32(0)
  }
  if !unsigned && ty == mt_bool() {
    w = lw.tmp(mt_i32(), b.rv_cast(v, mt_i32()))
    b.call(-1, "avant_puts_bool", lw.one(w))
    return b.c_i32(0)
  }
  fmt = "%d\n"
  if unsigned {
    fmt = "%u\n"
  } else if ty == mt_i64() {
    fmt = "%lld\n"
  } else if ty == mt_u64() {
    fmt = "%llu\n"
  } else if ty == mt_str() {
    fmt = "%s\n"
  } else if ty == mt_f64() {
    fmt = "%g\n"
  } else if ty == mt_bool() {
    v = lw.tmp(mt_i32(), b.rv_cast(v, mt_i32()))
  }
  args: Array(MOperand) = []
  args.push(b.str_const(fmt))
  args.push(v)
  b.call(-1, "printf", args)
  b.c_i32(0)
}

pub fn (lw: MirLower) lower_field(e: Expr): MOperand {
  if obj = e.object {
    if ot = obj.ty {
      if e.method_call && e.resolved.size > 0 && !(ot.is_class || ot.is_struct) {
        if sym1 = lw.lw_fn_syms.get(e.resolved) {
          none4: Array(Expr) = []
          return lw.lower_method_call(e, obj, ot, sym1, none4)
        }
      }
      if ot.is_integer || ot.is_float {
        return lw.member(obj, ot, e.ident, e)
      }
      if mir_is_str_ty(ot) {
        none: Array(Expr) = []
        return lw.str_member(e, obj, ot, e.ident, none)
      }
      none3: Array(Expr) = []
      if ot.is_join && e.ident == "join" {
        return lw.lower_join(e, obj)
      }
      if ot.is_array {
        return lw.arr_member(e, obj, ot, e.ident, none3)
      }
      if ot.is_hash {
        return lw.hash_member(e, obj, ot, e.ident, none3)
      }
      if ot.is_buf {
        return lw.buf_member(e, obj, e.ident, none3)
      }
      if ot.is_class || ot.is_struct {
        if e.method_call {
          if sym = lw.lw_fn_syms.get(e.resolved) {
            none2: Array(Expr) = []
            return lw.lower_method_call(e, obj, ot, sym, none2)
          }
          lw.refuse(e.loc, "the method .${e.ident}")
          return lw.lw_b.c_i32(0)
        }
        return lw.lower_place_read(e)
      }
    }
  }
  if obj2 = e.object {
    if ot2 = obj2.ty {
      if (ot2.is_ptr || ot2.is_clayout) && !e.method_call {
        ck = lw.c_field_scalar(e)
        if ck > 0 {
          p = lw.place_of(e)
          if lw.failed {
            return lw.lw_b.c_i32(0)
          }
          lw.at(e.loc)
          raw = lw.tmp(lw.c_scalar_mty(ck), lw.lw_b.rv_use(lw.lw_b.copy(p)))
          return lw.from_c_scalar(raw, ck)
        }
        return lw.lower_place_read(e)
      }
    }
  }
  lw.refuse(e.loc, "the field .${e.ident} (W6)")
  lw.lw_b.c_i32(0)
}

// A scalar member (builtins.av:1687-1760) of the value of obj.
pub fn (lw: MirLower) member(obj: Expr, ot: Ty, name: String, e: Expr): MOperand {
  b = lw.lw_b
  from = lw.ety(obj)
  ty = lw.ety(e)
  v = lw.lower_expr(obj)
  if lw.failed {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  if ot.is_float {
    if name == "to_i" {
      return lw.f64_to_i32(v, e.loc)
    }
    if name == "abs" {
      return lw.call_f64("fabs", v)
    }
    if name == "floor" {
      return lw.call_f64("floor", v)
    }
    if name == "sqrt" {
      return lw.call_f64("sqrt", v)
    }
    if name == "exp" {
      return lw.call_f64("exp", v)
    }
  } else {
    if name == "to_i" || name == "to_i64" || name == "to_u64" {
      return lw.int_convert(v, from, ty, e.loc)
    }
    if name == "to_f" || name == "wrap_i" || name == "wrap_i64" || name == "wrap_u64" {
      if ty == from {
        return v
      }
      return lw.tmp(ty, b.rv_cast(v, ty))
    }
    if name == "abs" {
      return lw.int_abs(from, v, e.loc)
    }
  }
  lw.refuse(e.loc, "the member .${name} of ${ot.show}")
  b.c_i32(0)
}

// abs on Int or Int64 (D215, Stage 29 W4b1 R2): the negation of MIN
// traps like `-MIN` (UInt64.abs is refused by the checker).
pub fn (lw: MirLower) int_abs(ty: Int, v: MOperand, loc: Location): MOperand {
  b = lw.lw_b
  d = b.temp(ty)
  b.assign(b.pl(d), b.rv_use(v))
  c = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(d), lw.int_const(ty, 0i64)))
  neg = b.block
  join = b.block
  b.branch(c, neg, join)
  b.at(neg)
  min = lw.int_const(ty, 0i64 - 2147483647i64 - 1i64)
  if ty == mt_i64() {
    min = lw.int_const(ty, 0i64 - 9223372036854775807i64 - 1i64)
  }
  is_min = lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), b.copy_local(d), min))
  ok = lw.trap_open(is_min, true)
  none: Array(MOperand) = []
  lw.trap_close(ok, "avant_trap_overflow", none, loc)
  b.assign(b.pl(d), b.rv_un(mop_neg(), b.copy_local(d)))
  b.goto(join)
  b.at(join)
  b.copy_local(d)
}

pub fn mir_convert_code(ty: Int): Int {
  if ty == mt_i64() {
    return 1
  }
  if ty == mt_u64() {
    return 2
  }
  0
}

// to_i, to_i64, to_u64 between Int, Int64 and UInt64 (D215, Stage 29 W4b1
// R1): the same number in the target type, or avant_trap_convert(value,
// from * 4 + to) from a cold block; a widening that cannot fail (Int to
// Int64) is the plain cast. wrap_i, wrap_i64 and wrap_u64 are the plain
// casts (two's-complement truncation or reinterpretation).
pub fn (lw: MirLower) int_convert(v: MOperand, from: Int, to: Int, loc: Location): MOperand {
  b = lw.lw_b
  if to == from {
    return v
  }
  if from == mt_i32() && to == mt_i64() {
    return lw.tmp(to, b.rv_cast(v, to))
  }
  x = b.temp(from)
  b.assign(b.pl(x), b.rv_use(v))
  inside = b.c_bool(true)
  if from == mt_i64() && to == mt_i32() {
    c1 = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(x), b.c_i64(0i64 - 2147483648i64)))
    c2 = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), b.c_i64(2147483647i64)))
    inside = lw.tmp(mt_bool(), b.rv_bin(mop_and(), c1, c2))
  } else if from == mt_u64() && to == mt_i32() {
    inside = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), b.c_u64(2147483647i64)))
  } else if from == mt_u64() && to == mt_i64() {
    inside = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), b.c_u64(9223372036854775807i64)))
  } else {
    inside = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(x), lw.int_const(from, 0i64)))
  }
  ok = lw.trap_open(inside, false)
  wide = b.copy_local(x)
  if from != mt_i64() {
    wide = lw.tmp(mt_i64(), b.rv_cast(b.copy_local(x), mt_i64()))
  }
  kind = mir_convert_code(from) * 4 + mir_convert_code(to)
  lw.trap_close(ok, "avant_trap_convert", lw.two(wide, b.c_i32(kind)), loc)
  lw.tmp(to, b.rv_cast(b.copy_local(x), to))
}

// Float64.to_i (W5.2; C2, W11b): truncation inside (-2147483649,
// 2147483648); NaN (which fails both compares), the infinities and any
// value outside trap with avant_trap_to_i(x), like integer overflow.
pub fn (lw: MirLower) f64_to_i32(v: MOperand, loc: Location): MOperand {
  b = lw.lw_b
  x = b.temp(mt_f64())
  b.assign(b.pl(x), b.rv_use(v))
  lo = b.c_f64(mir_f64_bits(-2147483649.0), "-2147483649.0")
  hi = b.c_f64(mir_f64_bits(2147483648.0), "2147483648.0")
  c1 = lw.tmp(mt_bool(), b.rv_cmp(mop_gt(), b.copy_local(x), lo))
  c2 = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(x), hi))
  inside = lw.tmp(mt_bool(), b.rv_bin(mop_and(), c1, c2))
  ok = lw.trap_open(inside, false)
  lw.trap_close(ok, "avant_trap_to_i", lw.one(b.copy_local(x)), loc)
  lw.tmp(mt_i32(), b.rv_cast(b.copy_local(x), mt_i32()))
}
