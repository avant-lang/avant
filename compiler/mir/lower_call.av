// The lowering of calls and scalar members: direct calls of the
// program's plain functions, the builtins `puts`, `puts_u`, `now_ms`,
// `now_us`, `sqrt`, `exp`, and the conversions and members of the
// integer types (`to_f to_i to_u64 abs`) and Float64
// (`to_i abs floor sqrt exp`), in their field (`x.to_f`) and call
// (`x.to_f()`) forms.

import location
import source
import token
import type
import ast
import typed_ir
import mir.types
import mir.ir
import mir.build
import mir.lower_ty
import mir.lower
import mir.lower_expr

// The old back end's builtins outside the supported subset (calls.av:
// 16-372): each is refused by name. The string builtins are in
// lower_str.av.
pub fn mir_other_builtin(name: String): Bool {
  names = ["spawn", "avant_gate_new", "avant_gate_lock", "avant_gate_unlock", "avant_gate_wait", "avant_gate_signal", "avant_gate_broadcast"]
  // lower_task.av lowers these in their checked forms first; what
  // reaches this list is a form the checker would not accept.
  for nm in names {
    if nm == name {
      return true
    }
  }
  false
}

// Arguments left to right, each snapshotted when a later one contains a
// switch.
pub fn (lw: MirLower) lower_args(args: Array(Expr)): Array(MOperand) {
  out: Array(MOperand) = []
  i = 0
  while i < args.size {
    o = lw.lower_expr(args[i])
    j = i + 1
    while j < args.size {
      o = lw.snap(o, args[j])
      j += 1
    }
    out.push(o)
    i += 1
  }
  out
}

// A call into a fresh temporary of type ty (none when ty is void).
pub fn (lw: MirLower) call_to(ty: Int, callee: String, args: Array(MOperand)): MOperand {
  b = lw.lw_b
  if ty == mt_void() {
    b.call(-1, callee, args)
    return b.c_i32(0)
  }
  t = b.temp(ty)
  b.call(t, callee, args)
  b.copy_local(t)
}

pub fn (lw: MirLower) call_f64(callee: String, a: MOperand): MOperand {
  args: Array(MOperand) = []
  args.push(a)
  lw.call_to(mt_f64(), callee, args)
}

pub fn (lw: MirLower) lower_call(e: Expr): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  if e.type_call {
    if e.resolved == "Regex__compile" && e.args.size >= 2 {
      if got0 = lw.lower_re2c_compile(e) {
        return got0
      }
    }
    if got = lw.lower_named_call(e) {
      return got
    }
    lw.refuse(e.loc, "the type-level call ${e.callee}")
    return zero
  }
  if e.indirect {
    return lw.lower_indirect(e)
  }
  if e.lib_name.size > 0 {
    return lw.lower_lib_call(e)
  }
  // Spawn, join, .parallel, Mutex.with, the gate builtins.
  if got_task = lw.lower_task_call(e) {
    return got_task
  }
  if bl = e.block {
    // The block forms of the Array and Hash builtins (lower_block.av);
    // spawn, .parallel, and Mutex.with are lower_task.av's.
    if got = lw.lower_block_call(e) {
      return got
    }
    lw.refuse(e.loc, "a call with a block (${e.callee})")
    return zero
  }
  if recv = e.receiver {
    if recv.kind == ex_name() && recv.ident == "Float64" && e.callee == "from_bits" && e.args.size == 1 && e.resolved.size == 0 {
      // Float64.from_bits(u): a bitcast of the 64 bits.
      u = lw.lower_expr(e.args[0])
      if lw.failed() {
        return zero
      }
      lw.at(e.loc)
      args0: Array(MOperand) = []
      args0.push(u)
      return lw.call_to(mt_f64(), "avant_bits_u64_to_f64", args0)
    }
    if recv.kind == ex_name() && recv.ident == "String" && e.callee == "from_utf8" && e.args.size == 1 {
      // String.from_utf8(bytes) (builtins.av emit_from_utf8): the
      // runtime's string with an ok flag, as String?.
      return lw.lower_opt_cstr(e, "avant_str_from_utf8")
    }
    if e.resolved == "ptr.as" {
      // `v.as(T)`: the same address, as a Ptr(T).
      if t = e.ty {
        o = lw.lower_expr(recv)
        if lw.failed() {
          return zero
        }
        lw.at(e.loc)
        return lw.coerce(o, recv.ty ?? t, t, e.loc)
      }
    }
    if e.resolved == "carray.to_s" {
      return lw.lower_carray_to_s(e, recv)
    }
    if recv.kind == ex_name() && (recv.ident == "String" || recv.ident == "Bytes") && e.callee == "from_c" && e.args.size == 2 {
      return lw.lower_from_c(e, recv.ident)
    }
    if recv.kind == ex_name() && recv.ident == "String" && e.callee == "from_code_point" && e.args.size == 1 {
      // String.from_code_point(n): the runtime's UTF-8 of one code point
      // (it traps outside them).
      ops = lw.lower_args(e.args)
      if lw.failed() {
        return zero
      }
      lw.at(e.loc)
      return lw.call_to(mt_str(), "avant_str_from_code_point", ops)
    }
    if rt = recv.ty {
      if e.callee == "or" && rt.is_union() && e.args.size == 1 {
        if t = e.ty {
          return lw.lower_coalesce(recv, e.args[0], t, e.loc)
        }
      }
      if e.callee == "expect" && rt.is_union() && e.args.size == 1 {
        if t = e.ty {
          return lw.lower_expect(recv, e.args[0], t, e.loc)
        }
      }
      // `h.add(v)` on a type's hasher: an integer, a Bool, an enum or a
      // String the runtime mixes in (a struct's add is its hash method,
      // the call the checker made of it).
      if rt.is_hasher() && e.callee == "add" && e.args.size == 1 && e.resolved.size == 0 {
        return lw.lower_hasher_add(e, recv)
      }
      // A user method on any type (Expr.resolved names a program method;
      // the builtin members have none).
      if !ast_is_ctor_call(e) && e.resolved.size > 0 {
        if sym0 = lw.lw_fn_syms.get(e.resolved), ms0 = lw.lw_syms.find_method_emit(e.resolved) {
          return lw.lower_method_call(e, recv, rt, sym0, e.args)
        }
      }
      if rt.is_enum() && e.callee == "to_i" && e.args.size == 0 && e.resolved.size == 0 {
        // `t.to_i`: the value, extended to an Int.
        v = lw.lower_expr(recv)
        if lw.failed() {
          return zero
        }
        lw.at(e.loc)
        return lw.tmp(mt_int(), lw.lw_b.rv_cast(v, mt_int()))
      }
      if (mir_is_str_ty(rt) || rt.is_buf()) && e.callee == "get" {
        return lw.lower_get(e, recv, rt, e.args)
      }
      if (rt.is_integer() || rt.is_float() || (rt.is_bool() && mir_bool_conversion(e.callee))) && e.args.size == 0 {
        return lw.member(recv, rt, e.callee, e)
      }
      if rt.is_float() && e.args.size == 1 && e.resolved.size == 0 && float_math_binary(e.callee).size > 0 {
        // `x.pow(y)`, `y.atan2(x)`: the C library's two-argument call.
        x = lw.lower_expr(recv)
        y = lw.lower_expr(e.args[0])
        if lw.failed() {
          return zero
        }
        lw.at(e.loc)
        args2: Array(MOperand) = []
        args2.push(x)
        args2.push(y)
        return lw.call_to(mt_f64(), float_math_binary(e.callee), args2)
      }
      if (mir_is_str_ty(rt) || rt.is_buf()) && e.resolved.size == 0 {
        if found = lw.seq_search(e, recv, rt, e.callee, e.args) {
          return found
        }
      }
      if mir_is_str_ty(rt) && e.resolved.size == 0 {
        return lw.str_member(e, recv, rt, e.callee, e.args)
      }
      if rt.is_array() {
        return lw.arr_member(e, recv, rt, e.callee, e.args)
      }
      if rt.is_set() {
        return lw.set_member(e, recv, rt, e.callee, e.args)
      }
      if rt.is_hash() {
        return lw.hash_member(e, recv, rt, e.callee, e.args)
      }
      if rt.is_buf() {
        return lw.buf_member(e, recv, e.callee, e.args)
      }
      if (rt.is_class() || rt.is_struct()) && !ast_is_ctor_call(e) {
        if sym = lw.lw_fn_syms.get(e.resolved) {
          return lw.lower_method_call(e, recv, rt, sym, e.args)
        }
      }
    }
    if ast_is_ctor_call(e) {
      if got = lw.lower_named_call(e) {
        return got
      }
    }
    lw.refuse(e.loc, "the method call .${e.callee}")
    return zero
  }
  c = e.callee
  if c == "puts" || c == "puts_u" {
    if e.args.size == 1 {
      return lw.lower_puts(e.args[0], c == "puts_u", e.loc)
    }
  }
  if (c == "puts" || c == "eputs") && e.args.size == 0 {
    lw.at(e.loc)
    return lw.lower_out_str(lw.lw_b.str_const(""), c == "puts", 3)
  }
  if (c == "print" || c == "eputs" || c == "eprint") && e.args.size == 1 {
    how = 0
    if c == "eputs" {
      how = 3
    } else if c == "eprint" {
      how = 2
    }
    return lw.lower_out(e.args[0], how, e.loc)
  }
  if c == "exit" && e.args.size == 1 && !e.indirect {
    return lw.lower_exit(e)
  }
  if c == "panic" && e.args.size == 1 && !e.indirect {
    return lw.lower_panic(e)
  }
  // The 64-bit clock: monotonic milliseconds and microseconds as Int
  // (avant_now_ms and avant_now_us, the Int readings that wrapped,
  // stay for the seed v0.40.0's compiler).
  if c == "now_ms" || c == "now_us" {
    lw.at(e.loc)
    none: Array(MOperand) = []
    unit = "ms"
    if c == "now_us" {
      unit = "us"
    }
    return lw.call_to(mt_i64(), "avant_clock_${unit}", none)
  }
  if (c == "sqrt" || c == "exp") && e.args.size == 1 {
    a = lw.lower_expr(e.args[0])
    if lw.failed() {
      return zero
    }
    lw.at(e.loc)
    if c == "sqrt" {
      return lw.call_f64("sqrt", a)
    }
    return lw.call_f64("exp", a)
  }
  if mir_str_builtin_arity(c) == e.args.size {
    return lw.lower_str_builtin(e, c)
  }
  if got = lw.heap_builtin(e, c) {
    return got
  }
  if got2 = lw.io_builtin(e, c) {
    return got2
  }
  if mir_other_builtin(c) {
    lw.refuse(e.loc, "the builtin ${c}")
    return zero
  }
  name = e.resolved
  if name.size == 0 {
    name = c
  }
  if sym = lw.lw_fn_syms.get(name), fs = lw.lw_syms.find_fn(name) {
    ret = lw.ty_at(fs.ret, e.loc, "a call result")
    args = lw.lower_args_in(e.args, fs.params, e.int_bits, e.arg_order)
    if lw.failed() {
      return zero
    }
    lw.at(e.loc)
    lw.verb_frozen_check(e, args)
    return lw.call_to(ret, sym, args)
  }
  lw.refuse(e.loc, "the call ${c}")
  zero
}

// puts: a Float64 prints its one text and a Bool the word true or false
//, through avant_puts_f64 and
// avant_puts_bool; a String prints by its length (avant_puts_str), a NUL
// byte included; an integer prints through avant_puts_i64 (Int, and
// Int32 widened by its sign) or avant_puts_u64 (UInt64, UInt32 widened
// by zero), each of which checks stdout after its write (it was printf,
// whose failed write was found only later).
// puts_u prints the bits unsigned at their own width.
pub fn (lw: MirLower) lower_puts(arg: Expr, unsigned: Bool, loc: Location): MOperand {
  b = lw.lw_b
  ty = lw.ety(arg)
  v = lw.lower_expr(arg)
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(loc)
  if !unsigned && ty == mt_f64() {
    b.call(-1, "avant_puts_f64", lw.one(v))
    return b.c_i32(0)
  }
  if !unsigned && ty == mt_str() {
    b.call(-1, "avant_puts_str", lw.one(v))
    return b.c_i32(0)
  }
  if !unsigned && ty == mt_bool() {
    w = lw.tmp(mt_i32(), b.rv_cast(v, mt_i32()))
    b.call(-1, "avant_puts_bool", lw.one(w))
    return b.c_i32(0)
  }
  if unsigned || ty == mt_u32() || ty == mt_u64() {
    if ty == mt_i32() {
      v = lw.tmp(mt_u32(), b.rv_cast(v, mt_u32()))
      ty = mt_u32()
    }
    if ty != mt_u64() {
      v = lw.tmp(mt_u64(), b.rv_cast(v, mt_u64()))
    }
    b.call(-1, "avant_puts_u64", lw.one(v))
    return b.c_i32(0)
  }
  if ty != mt_i64() {
    v = lw.tmp(mt_i64(), b.rv_cast(v, mt_i64()))
  }
  b.call(-1, "avant_puts_i64", lw.one(v))
  b.c_i32(0)
}

// print, eputs and eprint (puts above keeps its own writers): the
// runtime's avant_out_* of the value's type, with how's bit 1 for a
// newline and bit 2 for stderr. The checker has made every other value
// the String its interpolation gives.
pub fn (lw: MirLower) lower_out(arg: Expr, how: Int, loc: Location): MOperand {
  b = lw.lw_b
  ty = lw.ety(arg)
  v = lw.lower_expr(arg)
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(loc)
  if ty == mt_str() {
    return lw.lower_out_str(v, false, how)
  }
  f = "avant_out_i64"
  if ty == mt_f64() {
    f = "avant_out_f64"
  } else if ty == mt_bool() {
    f = "avant_out_bool"
    v = lw.tmp(mt_i32(), b.rv_cast(v, mt_i32()))
  } else if ty == mt_u32() || ty == mt_u64() {
    f = "avant_out_u64"
    if ty != mt_u64() {
      v = lw.tmp(mt_u64(), b.rv_cast(v, mt_u64()))
    }
  } else if ty != mt_i64() {
    v = lw.tmp(mt_i64(), b.rv_cast(v, mt_i64()))
  }
  args: Array(MOperand) = []
  args.push(v)
  args.push(b.c_i32(how))
  b.call(-1, f, args)
  b.c_i32(0)
}

// A String written: puts's own writer when puts, else avant_out_str.
pub fn (lw: MirLower) lower_out_str(v: MOperand, puts: Bool, how: Int): MOperand {
  b = lw.lw_b
  if puts {
    b.call(-1, "avant_puts_str", lw.one(v))
    return b.c_i32(0)
  }
  args: Array(MOperand) = []
  args.push(v)
  args.push(b.c_i32(how))
  b.call(-1, "avant_out_str", args)
  b.c_i32(0)
}

// exit(status): the status checked as main's result is (outside 0..255
// it traps at this call), then the runtime's exit, which never returns;
// the block ends there.
pub fn (lw: MirLower) lower_exit(e: Expr): MOperand {
  b = lw.lw_b
  v = lw.lower_expr(e.args[0])
  if lw.failed() {
    return b.c_i32(0)
  }
  if lw.ety(e.args[0]) != mt_int() {
    v = lw.tmp(mt_int(), b.rv_cast(v, mt_int()))
  }
  st = lw.exit_status(v, e.loc)
  b.call(-1, "avant_exit", lw.one(st))
  b.unreachable()
  b.c_i32(0)
}

// panic(message): the trap expect raises on nil, with the message and the
// call's site; it never returns, and the block ends there.
pub fn (lw: MirLower) lower_panic(e: Expr): MOperand {
  b = lw.lw_b
  v = lw.lower_expr(e.args[0])
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  b.call(-1, "avant_trap_expect", lw.one(v))
  b.unreachable()
  b.c_i32(0)
}

pub fn (lw: MirLower) lower_field(e: Expr): MOperand {
  if e.type_call {
    // An enum's member: its value, a constant.
    if t = e.ty, t.is_enum() {
      return lw.enum_const(t, e.ident)
    }
  }
  if obj = e.object, ot = obj.ty {
    if e.method_call && e.resolved.size > 0 && !(ot.is_class() || ot.is_struct()) {
      if sym1 = lw.lw_fn_syms.get(e.resolved) {
        none4: Array(Expr) = []
        return lw.lower_method_call(e, obj, ot, sym1, none4)
      }
    }
    if ot.is_integer() || ot.is_float() || (ot.is_bool() && mir_bool_conversion(e.ident)) {
      return lw.member(obj, ot, e.ident, e)
    }
    if mir_is_str_ty(ot) {
      none: Array(Expr) = []
      return lw.str_member(e, obj, ot, e.ident, none)
    }
    none3: Array(Expr) = []
    if ot.is_join() && e.ident == "join" {
      return lw.lower_join(e, obj)
    }
    if ot.is_array() {
      return lw.arr_member(e, obj, ot, e.ident, none3)
    }
    if ot.is_set() {
      return lw.set_member(e, obj, ot, e.ident, none3)
    }
    if ot.is_hash() {
      return lw.hash_member(e, obj, ot, e.ident, none3)
    }
    if ot.is_buf() {
      return lw.buf_member(e, obj, e.ident, none3)
    }
    if ot.is_class() || ot.is_struct() {
      if e.method_call {
        if sym = lw.lw_fn_syms.get(e.resolved) {
          none2: Array(Expr) = []
          return lw.lower_method_call(e, obj, ot, sym, none2)
        }
        lw.refuse(e.loc, "the method .${e.ident}")
        return lw.lw_b.c_i32(0)
      }
      return lw.lower_place_read(e)
    }
  }
  if obj2 = e.object, ot2 = obj2.ty, (ot2.is_ptr() || ot2.is_clayout()) && !e.method_call {
    ck = lw.c_field_scalar(e)
    if ck > 0 {
      p = lw.place_of(e)
      if lw.failed() {
        return lw.lw_b.c_i32(0)
      }
      lw.at(e.loc)
      raw = lw.tmp(lw.c_scalar_mty(ck), lw.lw_b.rv_use(lw.lw_b.copy(p)))
      return lw.from_c_scalar(raw, ck)
    }
    if et = lw.c_field_enum(e) {
      p2 = lw.place_of(e)
      if lw.failed() {
        return lw.lw_b.c_i32(0)
      }
      lw.at(e.loc)
      raw2 = lw.tmp(mt_i32(), lw.lw_b.rv_use(lw.lw_b.copy(p2)))
      return lw.enum_from_c(raw2, et, e.loc)
    }
    // A field declared a plain `String` traps on a NULL first
    // (c_field_string_read); `String?` reads NULL as nil.
    got: MOperand = lw.lw_b.c_i32(0)
    if fname = lw.c_field_string(e) {
      got = lw.c_field_string_read(e, fname)
    } else {
      got = lw.lower_place_read(e)
    }
    if ft = e.ty, lw.c_ret_string(ft) {
      // A `String` field of C memory: through avant_c_str, so the
      // program keeps a string with its length (lower_ffi.av
      // c_string_owned).
      if lw.failed() {
        return got
      }
      v = lw.lw_b.temp(lw.ety(e))
      lw.lw_b.assign(lw.lw_b.pl(v), lw.lw_b.rv_use(got))
      return lw.c_string_owned(v)
    }
    return got
  }
  lw.internal(e.loc, "the field .${e.ident}")
  lw.lw_b.c_i32(0)
}

// A Bool's conversions to a number (the checker's bool_conversion_ty).
pub fn mir_bool_conversion(name: String): Bool {
  name == "to_i" || name == "to_u64" || name == "to_i32" || name == "to_u32"
}

// A scalar member (builtins.av:1687-1760) of the value of obj.
pub fn (lw: MirLower) member(obj: Expr, ot: Ty, name: String, e: Expr): MOperand {
  b = lw.lw_b
  from = lw.ety(obj)
  ty = lw.ety(e)
  v = lw.lower_expr(obj)
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  if ot.is_bool() {
    // `b.to_i` and the sized forms: the Bool zero-extended, no branch.
    if mir_bool_conversion(name) {
      return lw.tmp(ty, b.rv_cast(v, ty))
    }
  } else if ot.is_float() {
    if name == "to_i" {
      return lw.f64_to_i32(v, e.loc)
    }
    fname = float_math_unary(name)
    if fname.size > 0 {
      return lw.call_f64(fname, v)
    }
    if name == "to_bits" {
      // The same 64 bits, as a UInt64: a bitcast.
      args: Array(MOperand) = []
      args.push(v)
      return lw.call_to(mt_u64(), "avant_bits_f64_to_u64", args)
    }
  } else {
    if name == "to_i" || name == "to_u64" || name == "to_i32" || name == "to_u32" {
      return lw.int_convert(v, from, ty, e.loc)
    }
    if name == "to_f" || name == "wrap_i" || name == "wrap_u64" || name == "wrap_i32" || name == "wrap_u32" {
      if ty == from {
        return v
      }
      return lw.tmp(ty, b.rv_cast(v, ty))
    }
    if name == "abs" {
      return lw.int_abs(from, v, e.loc)
    }
    op = int_bit_count(name)
    if op.size > 0 {
      // One LLVM operation on the value's bits (64 or 32 of them); the
      // count as an Int.
      w = mt_i64()
      if from == mt_i32() || from == mt_u32() {
        w = mt_i32()
      }
      x = v
      if from != w {
        x = lw.tmp(w, b.rv_cast(v, w))
      }
      args: Array(MOperand) = []
      args.push(x)
      wn = "i64"
      if w == mt_i32() {
        wn = "i32"
      }
      r = lw.call_to(w, "avant_bits_${op}_${wn}", args)
      if w == mt_i64() {
        return r
      }
      return lw.tmp(mt_i64(), b.rv_cast(r, mt_i64()))
    }
  }
  lw.refuse(e.loc, "the member .${name} of ${ot.show()}")
  b.c_i32(0)
}

// abs on a signed integer: the negation of MIN traps like `-MIN`
// (UInt64.abs is refused by the checker).
pub fn (lw: MirLower) int_abs(ty: Int, v: MOperand, loc: Location): MOperand {
  b = lw.lw_b
  d = b.temp(ty)
  b.assign(b.pl(d), b.rv_use(v))
  c = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(d), lw.int_const(ty, 0)))
  neg = b.block()
  join = b.block()
  b.branch(c, neg, join)
  b.at(neg)
  min = lw.int_const(ty, 0 - 2147483647 - 1)
  if ty == mt_i64() {
    min = lw.int_const(ty, 0 - 9223372036854775807 - 1)
  }
  is_min = lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), b.copy_local(d), min))
  ok = lw.trap_open(is_min, true)
  none: Array(MOperand) = []
  lw.trap_close(ok, "avant_trap_overflow", none, loc)
  b.assign(b.pl(d), b.rv_un(mop_neg(), b.copy_local(d)))
  b.goto(join)
  b.at(join)
  b.copy_local(d)
}

// The kinds of avant_trap_convert: 16 + from * 4 + to, each 0 Int, 1
// Int32, 2 UInt64, 3 UInt32.
pub fn mir_convert_code(ty: Int): Int {
  if ty == mt_i32() {
    return 1
  }
  if ty == mt_u64() {
    return 2
  }
  if ty == mt_u32() {
    return 3
  }
  0
}

pub fn mir_int_signed(ty: Int): Bool {
  ty == mt_i32() || ty == mt_i64()
}

// to_i, to_i32, to_u64, to_u32 between
// Int, Int32, UInt64 and UInt32: the same number in the target type, or
// avant_trap_convert(value, kind) from a cold block; a widening that
// cannot fail (Int32 or UInt32 to Int, UInt32 to UInt64) is the plain
// cast. wrap_i, wrap_i32, wrap_u64 and wrap_u32 are the plain casts
// (two's-complement truncation, or extension by the source's sign).
pub fn (lw: MirLower) int_convert(v: MOperand, from: Int, to: Int, loc: Location): MOperand {
  b = lw.lw_b
  if to == from {
    return v
  }
  if (from == mt_i32() && to == mt_i64()) || (from == mt_u32() && (to == mt_i64() || to == mt_u64())) {
    return lw.tmp(to, b.rv_cast(v, to))
  }
  x = b.temp(from)
  b.assign(b.pl(x), b.rv_use(v))
  inside = b.c_bool(true)
  if mir_int_signed(from) {
    c0 = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(x), lw.int_const(from, 0)))
    if to == mt_i32() {
      lo = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(x), b.c_i64(0 - 2147483648)))
      hi = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), b.c_i64(2147483647)))
      inside = lw.tmp(mt_bool(), b.rv_bin(mop_and(), lo, hi))
    } else if to == mt_u32() && from == mt_i64() {
      hi2 = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), b.c_i64(4294967295)))
      inside = lw.tmp(mt_bool(), b.rv_bin(mop_and(), c0, hi2))
    } else {
      inside = c0
    }
  } else if to == mt_i64() {
    inside = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), b.c_u64(9223372036854775807)))
  } else if to == mt_i32() {
    inside = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), lw.int_const(from, 2147483647)))
  } else {
    inside = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), b.c_u64(4294967295)))
  }
  ok = lw.trap_open(inside, false)
  wide = b.copy_local(x)
  if from != mt_i64() {
    wide = lw.tmp(mt_i64(), b.rv_cast(b.copy_local(x), mt_i64()))
  }
  kind = 16 + mir_convert_code(from) * 4 + mir_convert_code(to)
  lw.trap_close(ok, "avant_trap_convert", lw.two(wide, b.c_i32(kind)), loc)
  lw.tmp(to, b.rv_cast(b.copy_local(x), to))
}

// Float64.to_i: truncation inside (-2147483649, 2147483648); NaN
// (which fails both compares), the infinities and any value outside
// trap with avant_trap_to_i(x), like integer overflow. Int is 64-bit:
// inside [-2^63, 2^63), both bounds exact doubles.
pub fn (lw: MirLower) f64_to_i32(v: MOperand, loc: Location): MOperand {
  b = lw.lw_b
  x = b.temp(mt_f64())
  b.assign(b.pl(x), b.rv_use(v))
  lo = b.c_f64(mir_f64_bits(-9223372036854775808.0), "-9223372036854775808.0")
  hi = b.c_f64(mir_f64_bits(9223372036854775808.0), "9223372036854775808.0")
  c1 = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(x), lo))
  c2 = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(x), hi))
  inside = lw.tmp(mt_bool(), b.rv_bin(mop_and(), c1, c2))
  ok = lw.trap_open(inside, false)
  lw.trap_close(ok, "avant_trap_to_i", lw.one(b.copy_local(x)), loc)
  lw.tmp(mt_int(), b.rv_cast(b.copy_local(x), mt_int()))
}

// The value of the member named member of the enum t, a constant of the
// enum's width.
pub fn (lw: MirLower) enum_const(t: Ty, member: String): MOperand {
  idx = t.enum_index(member)
  v = 0
  if idx >= 0 {
    v = t.enum_vals()[idx]
  }
  lw.lw_b.c_int(mir_enum_ty(t), v)
}

// `h.add(v)`: avant_hasher_add_str for a String, else avant_hasher_add
// with the value widened to 64 bits (an integer by its signedness, a Bool
// as 0 or 1, an enum as its integer).
pub fn (lw: MirLower) lower_hasher_add(e: Expr, recv: Expr): MOperand {
  b = lw.lw_b
  h = lw.lower_expr(recv)
  arg = e.args[0]
  v = lw.lower_expr(arg)
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  ops: Array(MOperand) = []
  ops.push(h)
  if at = arg.ty, at.is_string() {
    ops.push(v)
    return lw.call_to(mt_void(), "avant_hasher_add_str", ops)
  }
  ops.push(lw.tmp(mt_u64(), b.rv_cast(v, mt_u64())))
  lw.call_to(mt_void(), "avant_hasher_add", ops)
}
