// The lowering of hashes, Buf, and the heap members of strings: every
// operation is a runtime call, with the old back end's evaluation orders.
// A hash's key is an integer of any width (an enum and a Bool are their
// integers), passed to the runtime as a 64-bit integer, a String, or a
// struct: one of 1, 2, 4 or 8 bytes whose fields are all integers is that
// integer, built from its fields (its padding zero); any other is passed
// by the address of a local holding it, with its fields described to the
// runtime at creation. The runtime returns a value's address, and the
// value is loaded or stored here with its own type (runtime/avant_hash.c). Reads that return a
// union (`h[k]`, `get`, `delete`) are in lower_union.av, `each` in
// lower_block.av.

import location
import source
import token
import type
import ast
import typed_ir
import mir.types
import mir.ir
import mir.build
import mir.lower_ty
import mir.lower
import mir.lower_expr
import mir.lower_call
import mir.lower_agg
import mir.lower_str
import mir.lower_arr

// The key's and the value's types (Int when the checker left none).
pub fn mir_hash_key(ht: Ty): Ty {
  if k = ht.key {
    return k
  }
  ty_int()
}

pub fn mir_hash_val(ht: Ty): Ty {
  if v = ht.val {
    return v
  }
  ty_int()
}

// A String key: the `_sk` entries; every other key but a struct is an
// integer of its width (an enum, a Bool) and takes the `_ik` entries.
pub fn mir_hash_key_str(ht: Ty): Bool {
  mir_hash_key(ht).is_string()
}

// A struct key's field at the MIR level, a nested struct's fields in
// place: its byte offset, its MIR type, and its field path from the key.
pub class MirKeyLeaf {
  pub off: Int
  pub ty: Int
  pub path: Array(Int)

  fn initialize(off: Int, ty: Int, path: Array(Int)) {
    self.off = off
    self.ty = ty
    self.path = path
  }
}

pub fn (lw: MirLower) key_leaves(ty: Int, base: Int, path: Array(Int), out: Array(MirKeyLeaf)) {
  ts = lw.lw_m.types
  if ts.kind(ty) == mk_agg() {
    l = ts.layouts[ts.layout_of(ty)]
    i = 0
    while i < l.fields.size {
      p: Array(Int) = []
      for x in path {
        p.push(x)
      }
      p.push(i)
      lw.key_leaves(l.fields[i], base + l.offsets[i], p, out)
      i += 1
    }
    return
  }
  out.push(MirKeyLeaf.new(base, ty, path))
}

pub fn (lw: MirLower) key_leaves_of(kty: Int): Array(MirKeyLeaf) {
  out: Array(MirKeyLeaf) = []
  path: Array(Int) = []
  lw.key_leaves(kty, 0, path, out)
  out
}

// Whether the struct ty, or a struct among its fields at any depth,
// defines its own == (the checker's key_by_methods): its hash is keyed by
// its type's hash and equality.
pub fn (lw: MirLower) key_by_methods(ty: Ty, seen: Array(String)): Bool {
  key = "${ty.mod_name}.${ty.name}"
  if !ty.is_struct() || seen.contains(key) {
    return false
  }
  for ms in lw.lw_syms.methods {
    if ms.is_method_of(ty) && ms.name == "==" && !ms.node.lazy {
      return true
    }
  }
  seen.push(key)
  for f in ty.fields {
    if lw.key_by_methods(f.ty, seen) {
      return true
    }
  }
  false
}

// How a hash passes its key: 0 an integer (the `_ik` entries), 1 a String
// (`_sk`), 2 a struct by address (`_xk`), 3 a struct of integer, Bool and
// enum fields of 1, 2, 4 or 8 bytes, passed as the integer of its fields
// (`_ik`), 4 a struct hashed and compared by its type's methods, by
// address (`_uk`).
pub fn (lw: MirLower) hash_key_class(ht: Ty, loc: Location): Int {
  k = mir_hash_key(ht)
  if k.is_string() {
    return 1
  }
  if !k.is_struct() {
    return 0
  }
  seen: Array(String) = []
  if lw.key_by_methods(k, seen) {
    return 4
  }
  kty = lw.ty_at(k, loc, "a hash key")
  if lw.failed() {
    return 0
  }
  ts = lw.lw_m.types
  n = ts.size_of(kty)
  if n != 1 && n != 2 && n != 4 && n != 8 {
    return 2
  }
  for leaf in lw.key_leaves_of(kty) {
    if !(ts.is_int(leaf.ty) || leaf.ty == mt_bool()) {
      return 2
    }
  }
  3
}

// The fields of a struct key passed by address, as the runtime reads them
// (avant_hash.c's header): "W@OFF" for an integer of W bytes (a Bool and
// an enum are integers), "s@OFF" for a String, comma-separated.
// A key hashed by its type's methods may hold any field: the runtime
// reads its layout only to find the reference words (each "s", which
// takes the barrier when the key is stored); every other word is its
// width.
pub fn (lw: MirLower) hash_key_layout(ht: Ty, kty: Int, loc: Location): String {
  ts = lw.lw_m.types
  out = ""
  user = lw.hash_key_class(ht, loc) == 4
  for leaf in lw.key_leaves_of(kty) {
    w = ""
    n = ts.size_of(leaf.ty)
    if user && ts.is_refkind(leaf.ty) {
      w = "s"
    } else if user && (n == 1 || n == 2 || n == 4 || n == 8) && !ts.is_refkind(leaf.ty) {
      w = "${n}"
    } else if leaf.ty == mt_bool() {
      w = "1"
    } else if ts.is_int(leaf.ty) {
      w = "${ts.size_of(leaf.ty)}"
    } else if leaf.ty == mt_str() {
      w = "s"
    } else {
      lw.refuse(loc, "a Hash key of type ${mir_hash_key(ht).show()}")
      return ""
    }
    if out.size > 0 {
      out = out + ","
    }
    out = out + "${w}@${leaf.off}"
  }
  out
}

// The type id of a buffer of elements of type ty (an Array's element
// buffer of that type): 0 for no reference, 65535 for one reference each,
// else the element's own type map.
pub fn (lw: MirLower) elems_tid(t: Ty, ty: Int): Int {
  ef: Array(Int) = []
  en: Array(String) = []
  ef.push(ty)
  en.push("")
  el = lw.lw_b.note_layout("elems(${mir_mty(t)})", mlk_elems(), ef, en)
  lw.lw_b.type_id(el)
}

// A value that is one reference (a String, a class, an Array, a Hash,
// Bytes or a Buf): stored by the runtime behind the barrier.
pub fn (lw: MirLower) hash_val_ref(ht: Ty, loc: Location): Bool {
  vty = lw.ty_at(mir_hash_val(ht), loc, "a hash value")
  !lw.failed() && lw.lw_m.types.is_refkind(vty)
}

// A struct value (stored at the address the runtime returns, its words
// after the runtime's barrier when it holds references).
pub fn (lw: MirLower) hash_val_agg(ht: Ty, loc: Location): Bool {
  vty = lw.ty_at(mir_hash_val(ht), loc, "a hash value")
  !lw.failed() && lw.lw_m.types.kind(vty) == mk_agg()
}

// The entry `avant_hash_<op>_ik`, `_sk` or `_xk` for the hash's key.
pub fn (lw: MirLower) hash_op(ht: Ty, op: String, loc: Location): String {
  c = lw.hash_key_class(ht, loc)
  if c == 1 {
    return "avant_hash_${op}_sk"
  }
  if c == 2 {
    return "avant_hash_${op}_xk"
  }
  if c == 4 {
    return "avant_hash_${op}_uk"
  }
  "avant_hash_${op}_ik"
}

// The hash's descriptor (runtime/avant_rt.h, AVANT_HASH_K_*, _V_*): the
// key's width in bytes, 16 when it is a signed integer, 32 when it is a
// String, 64 (and no width) when it is a struct passed by address; the
// value's width shifted by 8, 4096 when it is a reference.
pub fn (lw: MirLower) hash_desc(ht: Ty, loc: Location): Int {
  ts = lw.lw_m.types
  kty = lw.ty_at(mir_hash_key(ht), loc, "a hash key")
  vty = lw.ty_at(mir_hash_val(ht), loc, "a hash value")
  if lw.failed() {
    return 0
  }
  d = 0
  kc = lw.hash_key_class(ht, loc)
  if kc == 1 {
    d = 8 + 32
  } else if kc == 2 || kc == 4 {
    d = 64
  } else if kc == 3 {
    d = ts.size_of(kty)
  } else {
    d = ts.size_of(kty)
    if ts.is_signed_int(kty) {
      d += 16
    }
  }
  if ts.is_refkind(vty) {
    d += 8 * 256 + 4096
  } else if ts.kind(vty) != mk_agg() {
    d += ts.size_of(vty) * 256
  } else if ts.ref_carrying(vty) {
    d += 16384
  }
  d
}

// A struct value's slot in the table: its size rounded up to a power of
// two (the runtime finds a value by a shift).
pub fn mir_hash_slot_bytes(n: Int): Int {
  p = 1
  while p < n {
    p = p * 2
  }
  p
}

// The type id of a buffer of struct values of type vty in their slots:
// the element buffer of vty itself when its size is a power of two, else
// of a record of vty and the padding up to the slot.
pub fn (lw: MirLower) hash_slot_tid(vt: Ty, vty: Int): Int {
  ts = lw.lw_m.types
  n = ts.size_of(vty)
  p = mir_hash_slot_bytes(n)
  if p == n {
    return lw.elems_tid(vt, vty)
  }
  name = "hslot(${mir_mty(vt)})"
  f: Array(Int) = []
  fnames: Array(String) = []
  f.push(vty)
  fnames.push("v")
  i = n
  while i < p {
    f.push(mt_u8())
    fnames.push("")
    i += 1
  }
  rec = lw.lw_b.note_layout(name, mlk_struct(), f, fnames)
  ef: Array(Int) = []
  en: Array(String) = []
  ef.push(ts.agg(rec))
  en.push("")
  el = lw.lw_b.note_layout("elems(${name})", mlk_elems(), ef, en)
  lw.lw_b.type_id(el)
}

// A key as the runtime takes it: an integer extended to 64 bits by its
// type's signedness, a String as it is, a struct of 1, 2, 4 or 8 bytes of
// integers as the integer of its fields (each zero-extended and shifted
// to its offset, so the padding is zero), any other struct as the
// address of a local holding it (a local whose address is taken is a
// root slot of the frame when it holds a String).
pub fn (lw: MirLower) hash_key_arg(ht: Ty, k: MOperand, loc: Location): MOperand {
  kc = lw.hash_key_class(ht, loc)
  if kc == 1 {
    return k
  }
  kty = lw.ty_at(mir_hash_key(ht), loc, "a hash key")
  if lw.failed() || kty == mt_i64() {
    return k
  }
  b = lw.lw_b
  if kc == 2 || kc == 4 {
    t = lw.hold(k, kty)
    return lw.tmp(b.types.ptr_to(kty), b.rv_addr_raw(b.pl(t)))
  }
  if kc == 3 {
    t = lw.hold(k, kty)
    acc = b.c_u64(0)
    first = true
    for leaf in lw.key_leaves_of(kty) {
      p = b.pl(t)
      for j in leaf.path {
        p = b.field(p, j)
      }
      v = lw.tmp(leaf.ty, b.rv_use(b.copy(p)))
      u = mt_u64()
      if leaf.ty != mt_bool() {
        n = b.types.size_of(leaf.ty)
        if n == 1 {
          u = mt_u8()
        } else if n == 2 {
          u = mt_u16()
        } else if n == 4 {
          u = mt_u32()
        }
        v = lw.tmp(u, b.rv_cast(v, u))
      }
      x = lw.tmp(mt_u64(), b.rv_cast(v, mt_u64()))
      if leaf.off > 0 {
        x = lw.tmp(mt_u64(), b.rv_bin(mop_shl(), x, b.c_u64(leaf.off * 8)))
      }
      if first {
        acc = x
        first = false
      } else {
        acc = lw.tmp(mt_u64(), b.rv_bin(mop_or(), acc, x))
      }
    }
    return lw.tmp(mt_i64(), b.rv_cast(acc, mt_i64()))
  }
  lw.tmp(mt_i64(), b.rv_cast(k, mt_i64()))
}

// The address a hash entry returned, as a pointer to the value's type:
// a local the value is loaded from or stored through.
pub fn (lw: MirLower) hash_slot(p: MOperand, vty: Int): Int {
  b = lw.lw_b
  q = b.temp(b.types.ptr_to(vty))
  b.assign(b.pl(q), b.rv_cast(p, b.types.ptr_to(vty)))
  q
}

// The value at a slot local.
pub fn (lw: MirLower) hash_load(q: Int, vty: Int): MOperand {
  b = lw.lw_b
  lw.tmp(vty, b.rv_use(b.copy(b.deref(b.pl(q)))))
}

// `find` (or `take`) of the key k (already the runtime's argument) in the
// hash h, reporting through the found local fl: the value loaded from the
// address the runtime gives (zeros when the key is absent, never read as
// a value then).
pub fn (lw: MirLower) hash_find_load(ht: Ty, op: String, h: MOperand, k: MOperand, fl: Int, vty: Int, loc: Location): MOperand {
  ops: Array(MOperand) = []
  ops.push(h)
  ops.push(k)
  ops.push(lw.found_ptr(fl))
  p = lw.call_to(mt_ptr(), lw.hash_op(ht, op, loc), ops)
  b = lw.lw_b
  if mir_hash_slot_bytes(b.types.size_of(vty)) <= 256 {
    return lw.hash_load(lw.hash_slot(p, vty), vty)
  }
  // A value wider than the runtime's zeros for an absent key is read
  // only when it was found.
  r = b.temp(vty)
  hit = b.block()
  miss = b.block()
  join = b.block()
  b.branch(lw.found_is(fl), hit, miss)
  b.at(hit)
  b.assign(b.pl(r), b.rv_use(lw.hash_load(lw.hash_slot(p, vty), vty)))
  b.goto(join)
  b.at(miss)
  b.assign(b.pl(r), b.rv_zero())
  b.goto(join)
  b.at(join)
  b.copy_local(r)
}

// `Hash(K, V).new`: avant_hash_create(descriptor).
pub fn (lw: MirLower) lower_hash_new(e: Expr): MOperand {
  b = lw.lw_b
  ty = lw.ety(e)
  if lw.failed() {
    return b.c_i32(0)
  }
  d = 0
  if t = e.ty {
    d = lw.hash_desc(t, e.loc)
  }
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  if t = e.ty, lw.hash_typed(t, e.loc) {
    return lw.hash_create_typed(e, t, ty, d)
  }
  lw.call_to(ty, "avant_hash_create", lw.one(b.c_u32(d)))
}

// Whether the hash is made by avant_hash_create_typed: a struct key
// passed by address, or a struct value.
pub fn (lw: MirLower) hash_typed(ht: Ty, loc: Location): Bool {
  kc = lw.hash_key_class(ht, loc)
  kc == 2 || kc == 4 || lw.hash_val_agg(ht, loc)
}

// avant_hash_create_typed(descriptor, the key's fields, the key's and the
// value's sizes, the type ids of the key and value buffers).
pub fn (lw: MirLower) hash_create_typed(e: Expr, ht: Ty, ty: Int, d: Int): MOperand {
  b = lw.lw_b
  ts = lw.lw_m.types
  kt = mir_hash_key(ht)
  vt = mir_hash_val(ht)
  kty = lw.ty_at(kt, e.loc, "a hash key")
  vty = lw.ty_at(vt, e.loc, "a hash value")
  if lw.failed() {
    return b.c_i32(0)
  }
  lay = ""
  kw = 8
  ktid = 0
  kc = lw.hash_key_class(ht, e.loc)
  if kc == 2 || kc == 4 {
    lay = lw.hash_key_layout(ht, kty, e.loc)
    kw = ts.size_of(kty)
    ktid = lw.elems_tid(kt, kty)
  }
  vw = ts.size_of(vty)
  vtid = 0
  atid = 0
  if ts.is_refkind(vty) {
    vw = 8
    vtid = 65535
    atid = 65535
  } else if ts.kind(vty) == mk_agg() {
    vtid = lw.hash_slot_tid(vt, vty)
    atid = lw.elems_tid(vt, vty)
  }
  if lw.failed() {
    return b.c_i32(0)
  }
  ops: Array(MOperand) = []
  ops.push(b.c_u32(d))
  ops.push(b.str_const(lay))
  ops.push(b.c_u32(kw))
  ops.push(b.c_u32(vw))
  ops.push(b.c_u32(ktid))
  ops.push(b.c_u32(vtid))
  ops.push(b.c_u32(atid))
  h = lw.call_to(ty, "avant_hash_create_typed", ops)
  if kc == 4 {
    hs = lw.key_fn_sym("__avant_key_hash", kt, e.loc)
    es = lw.key_fn_sym("__avant_key_eq", kt, e.loc)
    if lw.failed() {
      return b.c_i32(0)
    }
    seen_key = "${mir_mty(kt)}"
    if !lw.lw_ffi.ukey_seen.has_key(seen_key) {
      lw.lw_ffi.ukey_seen[seen_key] = 1
      lw.lw_ffi.ukeys.push(kt)
      lw.lw_ffi.ukey_locs.push(e.loc)
    }
    uops: Array(MOperand) = []
    uops.push(h)
    uops.push(b.c_fn("${hs}#keyhash"))
    uops.push(b.c_fn("${es}#keyeq"))
    b.call(-1, "avant_hash_user", uops)
  }
  h
}

// The symbol of the checker's instance of name (__avant_key_hash or
// __avant_key_eq, checker/equality.av key_fns) for the key type kt; ""
// after refusing when the checker made none.
pub fn (lw: MirLower) key_fn_sym(name: String, kt: Ty, loc: Location): String {
  params: Array(Ty) = []
  params.push(kt)
  if sym = lw.lw_fn_syms.get(sig_mangle(name, params)) {
    return sym
  }
  lw.refuse(loc, "a Hash keyed by ${kt.show()} made where its key functions are not written")
  ""
}

// The two thunks a hash keyed by a type's own hash and equality calls
// from the runtime (avant_hash_user), once per key type: `#keyhash(_1:
// the key's address, _2: the hasher)` calls the key-hash instance with
// the key loaded and the hasher; `#keyeq(_1, _2: two keys' addresses) ->
// i32` calls the key-equality instance with both keys loaded and gives
// its Bool as 0 or 1. Each loads its keys first, before anything can
// collect (a table slot's key is read in place). The runtime calls them
// inside an entry, on the program's thread (lower_cb_thunks' first-frame
// rule, and the task recovery bracket when the program has one).
pub fn (lw: MirLower) lower_key_thunks {
  b = lw.lw_b
  i = 0
  while i < lw.lw_ffi.ukeys.size && !lw.failed() {
    kt = lw.lw_ffi.ukeys[i]
    loc = lw.lw_ffi.ukey_locs[i]
    kty = lw.ty_at(kt, loc, "a hash key")
    hs = lw.key_fn_sym("__avant_key_hash", kt, loc)
    es = lw.key_fn_sym("__avant_key_eq", kt, loc)
    if lw.failed() {
      return
    }
    pk = b.types.ptr_to(kty)
    recovers = lw.recovers()
    none: Array(MOperand) = []
    // The hash thunk.
    lw.begin_at(loc)
    ps: Array(Int) = []
    ps.push(pk)
    ps.push(mt_ptr())
    hf = b.begin_fn("${hs}#keyhash", b.sig(ps, mt_void(), false), lw.mloc(loc), "callback")
    hf.entry = true
    lw.lw_ret = mt_void()
    lw.at(loc)
    k = lw.tmp(kty, b.rv_use(b.copy(b.deref(b.pl(1)))))
    if recovers {
      b.call(-1, "avant_task_cb_enter", none)
    }
    hargs: Array(MOperand) = []
    hargs.push(k)
    hargs.push(b.copy_local(2))
    b.call(-1, hs, hargs)
    if recovers {
      b.call(-1, "avant_task_cb_leave", none)
    }
    b.ret()
    b.end_fn()
    // The equality thunk.
    lw.begin_at(loc)
    qs: Array(Int) = []
    qs.push(pk)
    qs.push(pk)
    ef = b.begin_fn("${es}#keyeq", b.sig(qs, mt_i32(), false), lw.mloc(loc), "callback")
    ef.entry = true
    lw.lw_ret = mt_i32()
    lw.at(loc)
    x = lw.tmp(kty, b.rv_use(b.copy(b.deref(b.pl(1)))))
    y = lw.tmp(kty, b.rv_use(b.copy(b.deref(b.pl(2)))))
    if recovers {
      b.call(-1, "avant_task_cb_enter", none)
    }
    eargs: Array(MOperand) = []
    eargs.push(x)
    eargs.push(y)
    d = b.temp(mt_bool())
    b.call(d, es, eargs)
    if recovers {
      b.call(-1, "avant_task_cb_leave", none)
    }
    b.assign(b.pl(0), b.rv_cast(b.copy_local(d), mt_i32()))
    b.ret()
    b.end_fn()
    i += 1
  }
}

// `h[k] = v`: the value, the key, the hash, then the entry (it collects).
// A scalar value is stored at the address `put` returns; a reference
// value by `set_ref`, behind the barrier; a struct value at the address
// `slot` returns after its barrier (as an Array's push of such an
// element; `slot` refuses a nil hash, whose scratch word `put` would
// give).
pub fn (lw: MirLower) lower_hash_store(st: Stmt, t: Expr, arr: Expr, ix: Expr, ht: Ty) {
  if st.op != tk_eq() {
    lw.refuse(st.loc, "compound assignment to a hash entry")
    return
  }
  if v = st.value {
    vty = lw.ty_at(mir_hash_val(ht), st.loc, "a hash value")
    val = lw.snap(lw.snap(lw.lower_expr(v), ix), arr)
    key = lw.snap(lw.lower_expr(ix), arr)
    h = lw.lower_expr(arr)
    if lw.failed() {
      return
    }
    lw.at(st.loc)
    lw.hash_set(ht, h, key, val, vty, st.loc)
  }
}

// `h[k] = v` with its operands lowered: a reference value by set_ref
// (the runtime's barrier), a struct value through the slot entry, any
// other value stored at the address put gives.
pub fn (lw: MirLower) hash_set(ht: Ty, h: MOperand, key: MOperand, val: MOperand, vty: Int, loc: Location) {
  b = lw.lw_b
  k = lw.hash_key_arg(ht, key, loc)
  if lw.hash_val_ref(ht, loc) {
    dummy = b.call(-1, lw.hash_op(ht, "set_ref", loc), lw.three(h, k, val))
    return
  }
  if lw.hash_val_agg(ht, loc) {
    s = b.temp(b.types.addr_of(vty))
    b.call(s, lw.hash_op(ht, "slot", loc), lw.two(h, k))
    b.assign(b.deref(b.pl(s)), b.rv_use(val))
    return
  }
  p = lw.call_to(mt_ptr(), lw.hash_op(ht, "put", loc), lw.two(h, k))
  q = lw.hash_slot(p, vty)
  b.assign(b.deref(b.pl(q)), b.rv_use(val))
}

// `["tea": 12, "milk": 3]`: the hash Hash(K, V).new makes, then each
// entry set in the written order (its key, then its value, evaluated
// first), as `h[k] = v`.
pub fn (lw: MirLower) lower_hash_lit(e: Expr): MOperand {
  b = lw.lw_b
  h = lw.lower_hash_new(e)
  if lw.failed() {
    return b.c_i32(0)
  }
  if ht = e.ty {
    vty = lw.ty_at(mir_hash_val(ht), e.loc, "a hash value")
    i = 0
    while i + 1 < e.elems.size {
      key = lw.snap(lw.lower_expr(e.elems[i]), e.elems[i + 1])
      val = lw.lower_expr(e.elems[i + 1])
      if lw.failed() {
        return b.c_i32(0)
      }
      lw.at(e.elems[i].loc)
      lw.hash_set(ht, h, key, val, vty, e.elems[i].loc)
      i += 2
    }
  }
  h
}

// Arguments last to first (the old hash and Buf methods evaluate them so),
// then the receiver; each snapshotted before a later switch.
pub fn (lw: MirLower) args_then_recv(args: Array(Expr), recv: Expr): Array(MOperand) {
  ops = lw.lower_args_rev(args)
  i = 0
  while i < ops.size {
    ops[i] = lw.snap(ops[i], recv)
    i += 1
  }
  r = lw.lower_expr(recv)
  out: Array(MOperand) = []
  out.push(r)
  i = 0
  while i < ops.size {
    out.push(ops[i])
    i += 1
  }
  out
}

// `h.delete(k)` as a statement, whose value nobody reads: the plain
// delete, with no found flag and no value; false when e is not such a
// call.
pub fn (lw: MirLower) hash_delete_stmt(e: Expr): Bool {
  if e.callee != "delete" || e.args.size != 1 {
    return false
  }
  if bl = e.block {
    return false
  }
  if recv = e.receiver, ht = recv.ty {
    if !ht.is_hash() || e.resolved.size > 0 {
      return false
    }
    f = lw.hash_op(ht, "del", e.loc)
    ops = lw.args_then_recv(e.args, recv)
    if lw.failed() {
      return true
    }
    lw.at(e.loc)
    ops[1] = lw.hash_key_arg(ht, ops[1], e.loc)
    lw.lw_b.call(-1, f, ops)
    return true
  }
  false
}

// `h.inc(k, by)`: the value's address by `upsert` (an absent key starts
// at 0), the checked sum stored there and returned.
pub fn (lw: MirLower) hash_inc(e: Expr, ht: Ty, ops: Array(MOperand), vty: Int): MOperand {
  b = lw.lw_b
  by = b.c_int(vty, 1)
  if ops.size > 2 {
    by = ops[2]
  }
  up: Array(MOperand) = []
  up.push(ops[0])
  up.push(lw.hash_key_arg(ht, ops[1], e.loc))
  up.push(b.c_null(mt_ptr()))
  p = lw.call_to(mt_ptr(), lw.hash_op(ht, "upsert", e.loc), up)
  q = lw.hash_slot(p, vty)
  old = lw.hash_load(q, vty)
  lw.at(e.loc)
  n = lw.tmp(vty, b.rv_chk(mop_add(), old, by))
  b.assign(b.deref(b.pl(q)), b.rv_use(n))
  n
}

// `s: Set(T) = [a, b]`: the set Set(T).new() makes, then each element
// added in the written order (the upsert: an element already there is
// left as it is).
pub fn (lw: MirLower) lower_set_lit(e: Expr, st: Ty): MOperand {
  b = lw.lw_b
  h = lw.lower_hash_new(e)
  if lw.failed() {
    return b.c_i32(0)
  }
  for el in e.elems {
    v = lw.lower_expr(el)
    if lw.failed() {
      return b.c_i32(0)
    }
    lw.at(el.loc)
    up: Array(MOperand) = []
    up.push(h)
    up.push(lw.hash_key_arg(st, v, el.loc))
    up.push(b.c_null(mt_ptr()))
    dummy = lw.call_to(mt_ptr(), lw.hash_op(st, "upsert", el.loc), up)
  }
  h
}

// The members of Set(T), a hash of T to Bool: `add` is the upsert
// (one probe; an absent element is inserted, its Bool zero) and gives
// whether it was absent; `has` the find's found flag; `delete` the
// take's (as a statement it is the hash's plain delete,
// hash_delete_stmt); `values` the keys; `size`, `clear` and `each` the
// hash's.
pub fn (lw: MirLower) set_member(e: Expr, recv: Expr, ht: Ty, name: String, args: Array(Expr)): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  if name == "each" {
    lw.refuse(e.loc, "Set.each")
    return zero
  }
  if name == "size" || name == "clear" {
    return lw.hash_member(e, recv, ht, name, args)
  }
  ty = lw.ety(e)
  vty = lw.ty_at(mir_hash_val(ht), e.loc, "a set's value")
  if lw.failed() {
    return zero
  }
  if name == "values" && args.size == 0 {
    ops0 = lw.args_then_recv(args, recv)
    if lw.failed() {
      return zero
    }
    lw.at(e.loc)
    return lw.call_to(ty, "avant_hash_keys", ops0)
  }
  op = ""
  if name == "add" {
    op = "upsert"
  } else if name == "has" {
    op = "find"
  } else if name == "delete" {
    op = "take"
  }
  if op.size == 0 || args.size != 1 {
    lw.refuse(e.loc, "the member .${name} of ${ht.show()}")
    return zero
  }
  ops = lw.args_then_recv(args, recv)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  fl = lw.found_local()
  fops: Array(MOperand) = []
  fops.push(ops[0])
  fops.push(lw.hash_key_arg(ht, ops[1], e.loc))
  fops.push(lw.found_ptr(fl))
  dummy = lw.call_to(mt_ptr(), lw.hash_op(ht, op, e.loc), fops)
  if name == "add" {
    return lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), b.copy_local(fl), b.c_i32(0)))
  }
  lw.found_is(fl)
}

// The members of Hash.
pub fn (lw: MirLower) hash_member(e: Expr, recv: Expr, ht: Ty, name: String, args: Array(Expr)): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  if bl = e.block {
    lw.internal(e.loc, "Hash.${name} with a block")
    return zero
  }
  if name == "get" || name == "get_slice" || name == "get_concat" || name == "delete" {
    return lw.lower_hash_read(e, recv, ht, name, args)
  }
  if name == "each" {
    lw.internal(e.loc, "Hash.each")
    return zero
  }
  ty = lw.ety(e)
  vty = lw.ty_at(mir_hash_val(ht), e.loc, "a hash value")
  if lw.failed() {
    return zero
  }
  f = ""
  n = 0
  if name == "size" {
    f = "avant_hash_size"
  } else if name == "clear" {
    f = "avant_hash_clear"
  } else if name == "keys" {
    f = "avant_hash_keys"
  } else if name == "values" {
    f = "avant_hash_values"
  } else if name == "has" || name == "has_key" {
    f = lw.hash_op(ht, "find", e.loc)
    n = 1
  } else if name == "inc" {
    f = lw.hash_op(ht, "upsert", e.loc)
    n = -1
  } else if name == "inc_slice" {
    f = "avant_hash_inc_slice"
    n = 3
  }
  if f.size == 0 || (n >= 0 && args.size != n) || (n < 0 && (args.size < 1 || args.size > 2)) {
    lw.refuse(e.loc, "the member .${name} of ${ht.show()}")
    return zero
  }
  ops = lw.args_then_recv(args, recv)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  if name == "has" || name == "has_key" {
    fl = lw.found_local()
    fops: Array(MOperand) = []
    fops.push(ops[0])
    fops.push(lw.hash_key_arg(ht, ops[1], e.loc))
    fops.push(lw.found_ptr(fl))
    dummy = lw.call_to(mt_ptr(), f, fops)
    return lw.found_is(fl)
  }
  if name == "inc" {
    return lw.hash_inc(e, ht, ops, vty)
  }
  lw.call_to(ty, f, ops)
}

// The members of Buf (the old back end): one
// runtime call each; `starts_with` compares its result with 1.
pub fn (lw: MirLower) buf_member(e: Expr, recv: Expr, name: String, args: Array(Expr)): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  if name == "slice" && (args.size == 1 || args.size == 2) {
    // A new Buf of the bytes start up to stop (the size when there is no
    // stop): the bounds, then the receiver.
    ty1 = lw.ety(e)
    ops1 = lw.args_then_recv(args, recv)
    if lw.failed() {
      return zero
    }
    lw.at(e.loc)
    if args.size == 1 {
      h = lw.hold(ops1[0], ty1)
      ops1[0] = b.copy_local(h)
      ops1.push(lw.seq_size(h))
    }
    return lw.call_to(ty1, "avant_buf_slice", ops1)
  }

  f = ""
  n = 0
  if name == "size" {
    f = "avant_buf_size"
  } else if name == "to_s" || name == "to_bytes" {
    f = "avant_buf_to_str"
  } else if name == "clear" {
    f = "avant_buf_clear"
  } else if name == "push_byte" {
    f = "avant_buf_push_byte"
    n = 1
  } else if name == "push_str" || name == "push_bytes" {
    f = "avant_buf_push_str"
    if args.size == 1 {
      if at = args[0].ty, at.is_buf() {
        // Another Buf's bytes, read in place.
        f = "avant_buf_push_buf"
      }
    }
    n = 1
  } else if name == "push_slice" {
    f = "avant_buf_push_slice"
    n = 3
  } else if name == "push_fmt_f" {
    f = "avant_buf_push_fmt_f"
    n = 2
  } else if name == "push_fmt_i" {
    f = "avant_buf_push_fmt_i"
    n = 1
  } else if name == "starts_with" {
    f = "avant_buf_starts"
    n = 1
  }
  if f.size == 0 || args.size != n {
    lw.refuse(e.loc, "the member .${name} of Buf")
    return zero
  }
  ty = lw.ety(e)
  ops = lw.args_then_recv(args, recv)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  if name == "starts_with" {
    r = lw.call_to(mt_i32(), f, ops)
    return lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), r, b.c_i32(1)))
  }
  lw.call_to(ty, f, ops)
}

// The members of String and Bytes that make an Array or a Buf
// (the old back end): `split(sep)` (the separator,
// then the string), `fields`, `lines`, `chars`, `code_points`, `Bytes.to_buf`;
// nil when name is not one of them.
pub fn (lw: MirLower) str_heap_member(e: Expr, recv: Expr, rt: Ty, name: String, args: Array(Expr)): MOperand? {
  f = ""
  n = 0
  if rt.is_string() && name == "split" {
    f = "avant_str_split"
    n = 1
    if args.size == 2 {
      // At most a limit of fields.
      f = "avant_str_split_n"
      n = 2
    }
  } else if rt.is_string() && name == "fields" {
    f = "avant_str_fields"
  } else if rt.is_string() && name == "lines" {
    f = "avant_str_lines"
  } else if name == "chars" {
    f = "avant_str_chars"
    if rt.is_bytes() {
      f = "avant_bytes_chars"
    }
  } else if name == "code_points" {
    f = "avant_str_code_points"
    if rt.is_bytes() {
      f = "avant_bytes_code_points"
    }
  } else if rt.is_bytes() && name == "to_buf" {
    f = "avant_bytes_to_buf"
  }
  if f.size == 0 || args.size != n || e.resolved.size > 0 {
    return nil
  }
  ty = lw.ety(e)
  ops = lw.args_then_recv(args, recv)
  if lw.failed() {
    return lw.lw_b.c_i32(0)
  }
  lw.at(e.loc)
  lw.call_to(ty, f, ops)
}

// The builtins over heap values (calls.av:222-227, 270-276, 350-360):
// `buf_new(cap = 0)`, `bytes_to_str(xs)`, `hash_last_key()`; nil when c
// is not one of them.
pub fn (lw: MirLower) heap_builtin(e: Expr, c: String): MOperand? {
  b = lw.lw_b
  f = ""
  if c == "buf_new" && e.args.size <= 1 {
    f = "avant_buf_new"
  } else if c == "bytes_to_str" && e.args.size == 1 {
    f = "avant_str_from_int_bytes"
  } else if c == "hash_last_key" && e.args.size == 0 {
    f = "avant_hash_last_key"
  }
  if f.size == 0 {
    return nil
  }
  ty = lw.ety(e)
  ops = lw.lower_args(e.args)
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  if c == "buf_new" && ops.size == 0 {
    ops.push(b.c_i64(0))
  }
  lw.call_to(ty, f, ops)
}
