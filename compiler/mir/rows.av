// Rows out of loops: an element of an array of arrays (or of strings)
// that a loop reads at an index the loop never changes, `g[y]` in
//
//   for x in 0..w { ... g[y][x] ... }
//
// is the same object on every iteration when the loop writes no element
// of that kind: the pass loads it once in a preheader into a local, and
// the loop reads that local. The holder of the inner index is then a
// local the loop never writes, so loop versioning (loops.av, which runs
// next) can prove `x` in range once before the loop, and a string row's
// size and view test leave the loop as any string local's do.
//
// The load in the loop is `_r = copy (*_b)[copy _y]` after
// `_b = copy (*_g).0` in the same block, where _g (an Array) and _y (an
// integer or a constant) are locals the loop never writes and whose
// address is never taken, and _r is a temporary defined by that
// statement alone. It stays where it was, after the bounds check of _y
// that precedes it (so a failing index traps where it did); it now copies
// the preheader's local _R, and every read of _r inside the loop reads _R.
// The preheader reads the element only after testing _g for null and _y
// for range (else _R is null): when _y is out of range at entry the loop
// traps at its own check before any read of _R, since _y never changes
// and the array's elements only can.
//
// Same object: the loop stores no element of the row's kind (a direct
// element store of that type), calls nothing that might
// (avant_array_set_ptr, an indirect call, an unknown C function, a
// runtime helper outside the list below, or an Avant function that does
// so transitively), and stores into no header of _g's type (a buffer
// swapped by hand). A push, pop or clear of the outer array goes through
// such a helper. Another task changes no element of an array this thread
// reads (loops.av's argument: it is frozen, under a lock this thread
// holds, or this thread's alone). A collection may move the row: _R is a
// reference local like any other, so the collector updates it. Two reads
// of the same row in one loop share one local.
//
// A string held in a field, `self.text[self.pos]` in a parser's loop, is
// taken the same way: `_s = copy (*_o).F` with _o a class reference the
// loop never writes and F a string field, loaded once (after testing _o
// for null) when the loop stores into no such field of that class, makes
// no call that may collect (one more reference held in a slot across each
// such call would cost more than the load it saves), and calls nothing
// that stores a class's reference or string field. Then the string's
// size, view test and bytes' address leave the loop (loops.av). Array and
// Buf fields are not taken: versioning on them guards short loops (a
// heap's sift) for more than it saves.

import source
import mir.types
import mir.ir
import mir.flow
import mir.loops

fn rw_new_local(f: MFunc, ty: Int): Int {
  f.locals.push(MLocal.new(ty, ""))
  f.locals.size - 1
}

fn rw_copy_local(local: Int): MOperand {
  o = MOperand.new(mok_copy(), -1)
  o.place = MPlace.new(local)
  o
}

fn rw_local_of(o: MOperand?): Int {
  if x = o, x.kind == mok_copy() {
    if p = x.place, p.proj.size == 0 {
      return p.local
    }
  }
  -1
}

fn rw_assign(loc: MLoc, dest: Int, rv: MRvalue): MStmt {
  st = MStmt.new(msk_assign(), loc)
  st.place = MPlace.new(dest)
  st.rv = rv
  st
}

fn rw_use(o: MOperand): MRvalue {
  r = MRvalue.new(mrk_use())
  r.a = o
  r
}

fn rw_cmp(op: Int, a: MOperand, b: MOperand): MRvalue {
  r = MRvalue.new(mrk_cmp())
  r.op = op
  r.a = a
  r.b = b
  r
}

// Whether ty is a reference to an Array header.
fn rw_is_array(ts: MTypes, ty: Int): Bool {
  if ts.kind(ty) != mk_ref() {
    return false
  }
  lay = ts.get(ty).layout
  lay >= 0 && ts.layouts[lay].kind == mlk_array()
}

// Whether ty can be a row: an Array reference or a string.
fn rw_row_type(ts: MTypes, ty: Int): Bool {
  ty == mt_str() || rw_is_array(ts, ty)
}

// What place p writes: out[0] the element type when its last projection
// is an index into an element buffer (-1 otherwise), out[1] the type of
// the header whose field it writes when that is an Array's (-1
// otherwise), out[2] and out[3] the layout and field index when its
// last projection is a field (-1 otherwise). An unknown shape, or a whole
// object stored through a reference, reads as -2 in out[0], out[1] and
// out[2].
fn rw_place_target(ts: MTypes, f: MFunc, p: MPlace, out: Array(Int)) {
  out[0] = -1
  out[1] = -1
  out[2] = -1
  out[3] = -1
  ty = f.locals[p.local].ty
  holder = -1
  last = -1
  for pr in p.proj {
    mt = ts.get(ty)
    if pr.kind == mpk_deref() {
      holder = ty
      if ts.is_refkind(ty) && mt.layout >= 0 {
        ty = ts.agg(mt.layout)
      } else {
        ty = mt.pointee
      }
      if ty < 0 {
        out[0] = -2
        out[1] = -2
        out[2] = -2
        return
      }
      last = 0
    } else if pr.kind == mpk_field() {
      if mt.layout < 0 || pr.field >= ts.layouts[mt.layout].fields.size {
        out[0] = -2
        out[1] = -2
        out[2] = -2
        return
      }
      if ts.layouts[mt.layout].kind == mlk_array() {
        out[1] = holder
      } else {
        out[1] = -1
      }
      out[2] = mt.layout
      out[3] = pr.field
      ty = ts.layouts[mt.layout].fields[pr.field]
      out[0] = -1
      last = 1
    } else {
      if mt.kind == mk_agg() && mt.layout >= 0 && (ts.layouts[mt.layout].kind == mlk_elems() || ts.layouts[mt.layout].kind == mlk_carray()) {
        ty = ts.layouts[mt.layout].fields[0]
      }
      out[0] = ty
      out[1] = -1
      out[2] = -1
      out[3] = -1
      last = 2
    }
  }
  if last == 0 {
    // A whole object stored through a reference: any part of it.
    out[0] = -2
    out[1] = -2
    out[2] = -2
  }
}

// Runtime helpers that write no element of an existing array of arrays
// or of strings and swap no array's buffer for other contents.
fn rw_helper_keeps(name: String): Bool {
  if name == "avant_array_set_ptr" || name == "avant_array_copy" || name == "avant_array_reverse" {
    return false
  }
  if mir_lv_keeps_sizes(name) {
    return true
  }
  if name.starts_with("avant_buf_") {
    return true
  }
  keep = ["avant_array_push_i32", "avant_array_push_i64", "avant_array_reserve", "avant_array_freeze", "avant_array_thaw", "avant_array_hold", "avant_array_unhold", "avant_array_frozen_at"]
  for k in keep {
    if name == k {
      return true
    }
  }
  false
}

// Whether a store into place p of f can change a row: an element store
// whose element type can be a row (any_row) or is rt, or a store into a
// header of type gt (or of any Array when any_row).
fn rw_store_changes(ts: MTypes, f: MFunc, p: MPlace, rt: Int, gt: Int, any_row: Bool): Bool {
  if p.last_deref() < 0 {
    return false
  }
  out = [0, 0, 0, 0]
  rw_place_target(ts, f, p, out)
  if out[0] == -2 || out[1] == -2 {
    return true
  }
  if out[0] >= 0 {
    if any_row && rw_row_type(ts, out[0]) {
      return true
    }
    if out[0] == rt {
      return true
    }
  }
  if out[1] >= 0 {
    if any_row || out[1] == gt {
      return true
    }
  }
  false
}

fn rw_call_keeps(m: MModule, st: MStmt, keep: Array(Bool)): Bool {
  if fo = st.indirect {
    return false
  }
  if i = m.func_index.get(st.callee) {
    return keep[i]
  }
  if st.callee.starts_with("av.") {
    return false
  }
  rw_helper_keeps(st.callee)
}

// keep[i] when m.funcs[i] (and everything it calls) changes no row of any
// array (greatest fixpoint).
fn rw_summary(m: MModule): Array(Bool) {
  keep = mir_bools(m.funcs.size, true)
  changed = true
  while changed {
    changed = false
    for i in 0..m.funcs.size {
      if keep[i] {
        f = m.funcs[i]
        ok = true
        for blk in f.blocks {
          for st in blk.stmts {
            if ok {
              if st.kind == msk_assign() {
                if p = st.place, rw_store_changes(m.types, f, p, -1, -1, true) {
                  ok = false
                }
              } else if st.kind == msk_call() {
                if !rw_call_keeps(m, st, keep) {
                  ok = false
                }
              }
            }
          }
        }
        if !ok {
          keep[i] = false
          changed = true
        }
      }
    }
  }
  keep
}

fn rw_addr_taken(f: MFunc): Array(Bool) {
  out = mir_bools(f.locals.size, false)
  for blk in f.blocks {
    for st in blk.stmts {
      if r = st.rv, p = r.place, (r.kind == mrk_addr() || r.kind == mrk_addr_raw()) && p.frame_local() {
        out[p.local] = true
      }
    }
  }
  out
}

// ---- fields

// Whether a store into place p of f can change field fd of class layout
// lay, or, with lay < 0, any class field of a reference or string type.
fn rw_store_changes_field(ts: MTypes, f: MFunc, p: MPlace, lay: Int, fd: Int): Bool {
  if p.last_deref() < 0 {
    return false
  }
  out = [0, 0, 0, 0]
  rw_place_target(ts, f, p, out)
  if out[2] == -2 {
    return true
  }
  if out[2] >= 0 {
    if lay < 0 {
      fty = ts.layouts[out[2]].fields[out[3]]
      return ts.layouts[out[2]].kind == mlk_class() && ts.is_refkind(fty)
    }
    return out[2] == lay && out[3] == fd
  }
  false
}

fn rw_call_keeps_fields(m: MModule, st: MStmt, keepf: Array(Bool)): Bool {
  if fo = st.indirect {
    return false
  }
  if i = m.func_index.get(st.callee) {
    return keepf[i]
  }
  if st.callee.starts_with("av.") {
    return false
  }
  rw_helper_keeps(st.callee)
}

// keepf[i] when m.funcs[i] (and everything it calls) stores no class
// field of a reference or string type (greatest fixpoint).
fn rw_field_summary(m: MModule): Array(Bool) {
  keep = mir_bools(m.funcs.size, true)
  changed = true
  while changed {
    changed = false
    for i in 0..m.funcs.size {
      if keep[i] {
        f = m.funcs[i]
        ok = true
        for blk in f.blocks {
          for st in blk.stmts {
            if ok {
              if st.kind == msk_assign() {
                if p = st.place, rw_store_changes_field(m.types, f, p, -1, -1) {
                  ok = false
                }
              } else if st.kind == msk_call() {
                if !rw_call_keeps_fields(m, st, keep) {
                  ok = false
                }
              }
            }
          }
        }
        if !ok {
          keep[i] = false
          changed = true
        }
      }
    }
  }
  keep
}

// ---- rewriting reads of _r as reads of _R

fn rw_place(p: MPlace, r: Int, nr: Int): MPlace {
  changed = p.local == r
  for pr in p.proj {
    if o = pr.index, rw_mentions(o, r) {
      changed = true
    }
  }
  if !changed {
    return p
  }
  np = MPlace.new(p.local)
  if p.local == r {
    np.local = nr
  }
  for pr in p.proj {
    q = MProj.new(pr.kind, pr.field)
    if o = pr.index {
      q.index = rw_op(o, r, nr)
    }
    np.proj.push(q)
  }
  np
}

fn rw_mentions(o: MOperand, r: Int): Bool {
  if p = o.place {
    if p.local == r {
      return true
    }
    for pr in p.proj {
      if x = pr.index, rw_mentions(x, r) {
        return true
      }
    }
  }
  false
}

fn rw_op(o: MOperand, r: Int, nr: Int): MOperand {
  if !rw_mentions(o, r) {
    return o
  }
  n = MOperand.new(o.kind, o.ty)
  n.ival = o.ival
  n.text = o.text
  n.sid = o.sid
  if p = o.place {
    n.place = rw_place(p, r, nr)
  }
  n
}

fn rw_opt(o: MOperand?, r: Int, nr: Int): MOperand? {
  if x = o {
    return rw_op(x, r, nr)
  }
  nil
}

fn rw_stmt(st: MStmt, r: Int, nr: Int) {
  if p = st.place {
    // A bare `_r` place is a definition, not a read.
    if p.proj.size > 0 {
      st.place = rw_place(p, r, nr)
    }
  }
  if rv = st.rv {
    n = MRvalue.new(rv.kind)
    n.op = rv.op
    n.ty = rv.ty
    n.a = rw_opt(rv.a, r, nr)
    n.b = rw_opt(rv.b, r, nr)
    if p = rv.place {
      n.place = rw_place(p, r, nr)
    }
    for o in rv.ops {
      n.ops.push(rw_op(o, r, nr))
    }
    st.rv = n
  }
  st.indirect = rw_opt(st.indirect, r, nr)
  args: Array(MOperand) = []
  for o in st.args {
    args.push(rw_op(o, r, nr))
  }
  st.args = args
}

// ---- the pass

class RwLoop {
  f: MFunc
  body: Array(Bool)
  hdr: Int = 0
  def_in: Array(Bool)
  addr: Array(Bool)
  defs: Array(Int)
  coll: Array(Bool)

  fn initialize(f: MFunc, body: Array(Bool), hdr: Int) {
    self.f = f
    self.body = body
    self.hdr = hdr
    self.def_in = mir_bools(f.locals.size, false)
    self.addr = rw_addr_taken(f)
    self.defs = []
    self.coll = []
    for i in 0..f.locals.size {
      self.defs.push(0)
    }
  }
}

// Whether the loop keeps row objects of type rt held by arrays of type gt.
fn rw_loop_keeps(m: MModule, lp: RwLoop, rt: Int, gt: Int, keep: Array(Bool)): Bool {
  f = lp.f
  for b in 0..lp.body.size {
    if lp.body[b] {
      for st in f.blocks[b].stmts {
        if st.kind == msk_assign() {
          if p = st.place, rw_store_changes(m.types, f, p, rt, gt, false) {
            return false
          }
        } else if st.kind == msk_call() {
          if !rw_call_keeps(m, st, keep) {
            return false
          }
        }
      }
    }
  }
  true
}

// Whether the loop keeps field fd of class layout lay in every object.
fn rw_loop_keeps_field(m: MModule, lp: RwLoop, lay: Int, fd: Int, keepf: Array(Bool)): Bool {
  f = lp.f
  for b in 0..lp.body.size {
    if lp.body[b] {
      for st in f.blocks[b].stmts {
        if st.kind == msk_assign() {
          if p = st.place, rw_store_changes_field(m.types, f, p, lay, fd) {
            return false
          }
        } else if st.kind == msk_call() {
          // A held field in a loop that may collect would be one more
          // reference kept in a slot across each such call, where the
          // object's field is read again for one load.
          if mir_lv_call_collects(m, st, lp.coll) || !rw_call_keeps_fields(m, st, keepf) {
            return false
          }
        }
      }
    }
  }
  true
}

// When statement j of blk is `_s = copy (*_o).F`, _o a class reference
// the loop never writes and F a string field: out[0] = _o,
// out[1] = the class layout, out[2] = F, out[3] = _s.
fn rw_match_field(m: MModule, lp: RwLoop, blk: MBlock, j: Int, out: Array(Int)): Bool {
  f = lp.f
  ts = m.types
  st = blk.stmts[j]
  if st.kind != msk_assign() {
    return false
  }
  r = mir_stmt_def(st)
  if r < 0 || lp.defs[r] != 1 || lp.addr[r] || f.locals[r].ty != mt_str() {
    return false
  }
  rv = st.rv ?? MRvalue.new(0)
  if rv.kind != mrk_use() {
    return false
  }
  a = rv.a ?? MOperand.new(0, -1)
  if a.kind != mok_copy() {
    return false
  }
  p = a.place ?? MPlace.new(-1)
  if p.local < 0 || p.proj.size != 2 || p.proj[0].kind != mpk_deref() || p.proj[1].kind != mpk_field() {
    return false
  }
  o = p.local
  if lp.def_in[o] || lp.addr[o] || ts.kind(f.locals[o].ty) != mk_ref() {
    return false
  }
  lay = ts.get(f.locals[o].ty).layout
  if lay < 0 || ts.layouts[lay].kind != mlk_class() {
    return false
  }
  out[0] = o
  out[1] = lay
  out[2] = p.proj[1].field
  out[3] = r
  true
}

// The guarded load of field fd of _o into nr at the end of cur: returns
// the block after it.
fn rw_build_field(f: MFunc, loc: MLoc, cur: MBlock, o: Int, fd: Int, nr: Int): MBlock {
  rt = f.locals[nr].ty
  join = MBlock.new(f.blocks.size)
  f.blocks.push(join)
  cur.stmts.push(rw_assign(loc, nr, rw_use(MOperand.new(mok_null(), rt))))
  c1 = rw_new_local(f, mt_bool())
  cur.stmts.push(rw_assign(loc, c1, rw_cmp(mop_ne(), rw_copy_local(o), MOperand.new(mok_null(), f.locals[o].ty))))
  b2 = rw_test_block(f, loc, cur, c1, join.id)
  fp = MPlace.new(o)
  fp.proj.push(MProj.new(mpk_deref(), 0))
  fp.proj.push(MProj.new(mpk_field(), fd))
  fo = MOperand.new(mok_copy(), -1)
  fo.place = fp
  b2.stmts.push(rw_assign(loc, nr, rw_use(fo)))
  t = MTerm.new(mtk_goto(), loc)
  t.targets.push(join.id)
  b2.term = t
  join
}

// The array local _g when statement j of blk is `_r = copy (*_b)[copy _y]`
// after `_b = copy (*_g).0` there (out[0] = _g, out[1] = _y or -1 for a
// constant, out[2] = _r); else false.
fn rw_match(m: MModule, lp: RwLoop, blk: MBlock, j: Int, out: Array(Int)): Bool {
  f = lp.f
  ts = m.types
  st = blk.stmts[j]
  if st.kind != msk_assign() {
    return false
  }
  r = mir_stmt_def(st)
  if r < 0 || lp.defs[r] != 1 || lp.addr[r] || !rw_row_type(ts, f.locals[r].ty) {
    return false
  }
  rv = st.rv ?? MRvalue.new(0)
  if rv.kind != mrk_use() {
    return false
  }
  a = rv.a ?? MOperand.new(0, -1)
  if a.kind != mok_copy() {
    return false
  }
  p = a.place ?? MPlace.new(-1)
  if p.local < 0 || p.proj.size != 2 || p.proj[0].kind != mpk_deref() || p.proj[1].kind != mpk_index() {
    return false
  }
  bl = p.local
  y = -1
  if io = p.proj[1].index {
    if io.kind == mok_int() {
      y = -1
    } else {
      y = rw_local_of(io)
      if y < 0 || lp.def_in[y] || lp.addr[y] || !ts.is_int(f.locals[y].ty) {
        return false
      }
    }
  } else {
    return false
  }
  // _b's definition, earlier in the block, unchanged since.
  k = j - 1
  while k >= 0 {
    d = mir_stmt_def(blk.stmts[k])
    if d == bl {
      bs = blk.stmts[k]
      if bs.kind != msk_assign() {
        return false
      }
      brv = bs.rv ?? MRvalue.new(0)
      if brv.kind != mrk_use() {
        return false
      }
      ba = brv.a ?? MOperand.new(0, -1)
      bp = ba.place ?? MPlace.new(-1)
      if ba.kind != mok_copy() || bp.local < 0 || bp.proj.size != 2 || bp.proj[0].kind != mpk_deref() || bp.proj[1].kind != mpk_field() || bp.proj[1].field != 0 {
        return false
      }
      g = bp.local
      if lp.def_in[g] || lp.addr[g] || !rw_is_array(ts, f.locals[g].ty) {
        return false
      }
      out[0] = g
      out[1] = y
      out[2] = r
      return true
    }
    if y >= 0 && d == y {
      return false
    }
    k -= 1
  }
  false
}

// The guarded load of the row into nr, at the end of cur: returns the
// block after it (where the next one goes).
fn rw_build(f: MFunc, loc: MLoc, cur: MBlock, g: Int, yo: MOperand, bt: Int, nr: Int): MBlock {
  rt = f.locals[nr].ty
  // _R = null; if _g != null && 0 <= _y < size(_g) { _R = _g's element _y }.
  join = MBlock.new(f.blocks.size)
  f.blocks.push(join)
  cur.stmts.push(rw_assign(loc, nr, rw_use(MOperand.new(mok_null(), rt))))
  c1 = rw_new_local(f, mt_bool())
  cur.stmts.push(rw_assign(loc, c1, rw_cmp(mop_ne(), rw_copy_local(g), MOperand.new(mok_null(), f.locals[g].ty))))
  b2 = rw_test_block(f, loc, cur, c1, join.id)
  s32 = rw_new_local(f, mt_i32())
  sp = MPlace.new(g)
  sp.proj.push(MProj.new(mpk_deref(), 0))
  sp.proj.push(MProj.new(mpk_field(), 1))
  so = MOperand.new(mok_copy(), -1)
  so.place = sp
  b2.stmts.push(rw_assign(loc, s32, rw_use(so)))
  s64 = rw_new_local(f, mt_i64())
  b2.stmts.push(rw_assign(loc, s64, rw_cast(rw_copy_local(s32), mt_i64())))
  y64 = rw_new_local(f, mt_i64())
  yty = yo.ty
  if yl = yo.place {
    yty = f.locals[yl.local].ty
  }
  if yty == mt_i64() {
    b2.stmts.push(rw_assign(loc, y64, rw_use(yo)))
  } else {
    b2.stmts.push(rw_assign(loc, y64, rw_cast(yo, mt_i64())))
  }
  c2 = rw_new_local(f, mt_bool())
  zero = MOperand.new(mok_int(), mt_i64())
  zero.ival = 0
  b2.stmts.push(rw_assign(loc, c2, rw_cmp(mop_ge(), rw_copy_local(y64), zero)))
  b3 = rw_test_block(f, loc, b2, c2, join.id)
  c3 = rw_new_local(f, mt_bool())
  b3.stmts.push(rw_assign(loc, c3, rw_cmp(mop_lt(), rw_copy_local(y64), rw_copy_local(s64))))
  b4 = rw_test_block(f, loc, b3, c3, join.id)
  bufp = MPlace.new(g)
  bufp.proj.push(MProj.new(mpk_deref(), 0))
  bufp.proj.push(MProj.new(mpk_field(), 0))
  bo = MOperand.new(mok_copy(), -1)
  bo.place = bufp
  bl = rw_new_local(f, bt)
  b4.stmts.push(rw_assign(loc, bl, rw_use(bo)))
  ep = MPlace.new(bl)
  ep.proj.push(MProj.new(mpk_deref(), 0))
  ix = MProj.new(mpk_index(), 0)
  ix.index = yo
  ep.proj.push(ix)
  eo = MOperand.new(mok_copy(), -1)
  eo.place = ep
  b4.stmts.push(rw_assign(loc, nr, rw_use(eo)))
  t4 = MTerm.new(mtk_goto(), loc)
  t4.targets.push(join.id)
  b4.term = t4
  join
}

fn rw_cast(a: MOperand, ty: Int): MRvalue {
  r = MRvalue.new(mrk_cast())
  r.a = a
  r.ty = ty
  r
}

// Ends blk with `branch copy _c, next, fail`; returns the new next block.
fn rw_test_block(f: MFunc, loc: MLoc, blk: MBlock, c: Int, fail: Int): MBlock {
  nx = MBlock.new(f.blocks.size)
  f.blocks.push(nx)
  t = MTerm.new(mtk_branch(), loc)
  t.cond = rw_copy_local(c)
  t.targets.push(nx.id)
  t.targets.push(fail)
  blk.term = t
  nx
}

fn rw_defs_in(f: MFunc, body: Array(Bool), n0: Int): Array(Bool) {
  def_in = mir_bools(f.locals.size, false)
  for b in 0..n0 {
    if body[b] {
      for st in f.blocks[b].stmts {
        d = mir_stmt_def(st)
        if d >= 0 {
          def_in[d] = true
        }
      }
    }
  }
  def_in
}

// The key of a hoisted read: its kind, the object, and the index (a
// local or a constant) or the field.
fn rw_key(kind: Int, g: Int, yo: MOperand, fd: Int): String {
  if kind == 2 {
    return "f ${g} ${fd}"
  }
  if yo.kind == mok_int() {
    return "r ${g} c${yo.ival}"
  }
  "r ${g} l${rw_local_of(yo)}"
}

// Hoists every row of one loop; returns whether one moved.
fn rw_hoist_one(m: MModule, f: MFunc, body: Array(Bool), hdr: Int, keep: Array(Bool), keepf: Array(Bool), coll: Array(Bool)): Bool {
  lp = RwLoop.new(f, body, hdr)
  lp.coll = coll
  for blk in f.blocks {
    for st in blk.stmts {
      d = mir_stmt_def(st)
      if d >= 0 {
        lp.defs[d] += 1
      }
    }
  }
  n0 = f.blocks.size
  lp.def_in = rw_defs_in(f, body, n0)
  loc = f.loc
  if t0 = f.blocks[hdr].term {
    loc = t0.loc
  }
  // The preheader: a chain of blocks, one guarded load a row, made at
  // the first row found.
  first = MBlock.new(-1)
  cur = first
  moved = 0
  keys: Array(String) = []
  held: Array(Int) = []
  out = [0, 0, 0, 0]
  for bx in 0..n0 {
    if body[bx] {
      blk = f.blocks[bx]
      j = 0
      while j < blk.stmts.size {
        st = blk.stmts[j]
        r = -1
        kind = 0
        g = -1
        yo = MOperand.new(mok_int(), mt_i64())
        bt = -1
        fd = -1
        if rw_match(m, lp, blk, j, out) && rw_loop_keeps(m, lp, f.locals[out[2]].ty, f.locals[out[0]].ty, keep) {
          if a = st.rv, ao = a.a, p = ao.place, io = p.proj[1].index {
            yo = io
            bt = f.locals[p.local].ty
            g = out[0]
            r = out[2]
            kind = 1
          }
        } else if rw_match_field(m, lp, blk, j, out) && rw_loop_keeps_field(m, lp, out[1], out[2], keepf) {
          g = out[0]
          fd = out[2]
          r = out[3]
          kind = 2
        }
        if kind > 0 {
          if r >= 0 {
            if moved == 0 {
              first = MBlock.new(f.blocks.size)
              f.blocks.push(first)
              cur = first
            }
            // One local for each object and index (or field) the loop
            // reads: a second read of the same one shares it.
            key = rw_key(kind, g, yo, fd)
            nr = -1
            for q in 0..keys.size {
              if keys[q] == key && f.locals[held[q]].ty == f.locals[r].ty {
                nr = held[q]
              }
            }
            if nr < 0 {
              nr = rw_new_local(f, f.locals[r].ty)
              keys.push(key)
              held.push(nr)
              if kind == 1 {
                cur = rw_build(f, loc, cur, g, yo, bt, nr)
              } else {
                cur = rw_build_field(f, loc, cur, g, fd, nr)
              }
            }
            // The loop's load becomes a copy of _R, and its reads of _r
            // read _R.
            blk.stmts[j] = rw_assign(st.loc, r, rw_use(rw_copy_local(nr)))
            for by in 0..n0 {
              if body[by] {
                bk = f.blocks[by]
                for q in 0..bk.stmts.size {
                  if !(by == bx && q == j) {
                    rw_stmt(bk.stmts[q], r, nr)
                  }
                }
                if t = bk.term {
                  t.cond = rw_opt(t.cond, r, nr)
                }
              }
            }
            lp.def_in = rw_defs_in(f, body, n0)
            lp.addr = rw_addr_taken(f)
            while lp.defs.size < f.locals.size {
              lp.defs.push(0)
            }
            moved += 1
          }
        }
        j += 1
      }
    }
  }
  if moved == 0 {
    return false
  }
  tl = MTerm.new(mtk_goto(), loc)
  tl.targets.push(hdr)
  cur.term = tl
  preds = mir_preds(f)
  for p in preds[hdr] {
    if p < n0 && !body[p] {
      if t = f.blocks[p].term {
        for x in 0..t.targets.size {
          if t.targets[x] == hdr {
            t.targets[x] = first.id
          }
        }
      }
    }
  }
  true
}

fn rw_func(m: MModule, f: MFunc, keep: Array(Bool), keepf: Array(Bool), coll: Array(Bool)) {
  rounds = 0
  progress = true
  while progress && rounds < 256 {
    progress = false
    lps = mir_lv_loops(f)
    li = lps.headers.size - 1
    while li >= 0 && !progress {
      if lps.headers[li] != 0 && rw_hoist_one(m, f, lps.bodies[li], lps.headers[li], keep, keepf, coll) {
        progress = true
      }
      li -= 1
    }
    rounds += 1
  }
}

// The pass (after verify(lowered), before loop versioning): every
// function whose kind is unset.
pub fn mir_rows_pass(m: MModule) {
  keep = rw_summary(m)
  keepf = rw_field_summary(m)
  coll = mir_lv_collects(m)
  for f in m.funcs {
    if f.kind == mfk_unset() && f.blocks.size > 1 {
      rw_func(m, f, keep, keepf, coll)
    }
  }
}
