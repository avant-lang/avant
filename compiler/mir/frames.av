// The minimal frame pass (Stage 28 W5b; stages/stage28/mir.md W5.4): what
// the scalar subset needs to reach stage final. W6 replaces it with the
// leaf pass and the root-slot pass of 5.7 and 5.9.
//
// 1. Leaves: every function but `main` starts as a candidate; one that
//    makes a collecting call to an external, an indirect call, or a call
//    to an Avant function outside the set leaves it, to a fixpoint
//    (recursion stays in). Candidates become `leaf` and every call to one
//    is re-marked `nocollect`.
// 2. Frames: every other function becomes `frame`; its slots are all the
//    locals whose type has root words (2.10), a conservative superset of
//    the precise set W6 computes; the prologue of 5.1 and a `gc.leave`
//    before each `return` are inserted.

import source
import mir.types
import mir.ir

fn mir_in_set(cand: Hash(String, Int), name: String): Bool {
  if v = cand.get(name) {
    return v == 1
  }
  false
}

fn mir_call_blocks_leaf(m: MModule, st: MStmt, cand: Hash(String, Int)): Bool {
  if st.kind != msk_call() {
    return false
  }
  if fo = st.indirect {
    return true
  }
  if f = m.func(st.callee) {
    return !mir_in_set(cand, st.callee)
  }
  if str_starts_mir(st.callee, "av.") {
    return true
  }
  st.collects
}

fn mir_func_blocks_leaf(m: MModule, f: MFunc, cand: Hash(String, Int)): Bool {
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    i = 0
    while i < blk.stmts.size {
      if mir_call_blocks_leaf(m, blk.stmts[i], cand) {
        return true
      }
      i = i + 1
    }
    b = b + 1
  }
  false
}

fn mir_mark_calls(m: MModule, f: MFunc) {
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    i = 0
    while i < blk.stmts.size {
      st = blk.stmts[i]
      if st.kind == msk_call() {
        if g = m.func(st.callee) {
          st.collects = g.kind != mfk_leaf()
        }
      }
      i = i + 1
    }
    b = b + 1
  }
}

fn mir_add_frame(m: MModule, f: MFunc) {
  f.kind = mfk_frame()
  slots: Array(Int) = []
  k = 0
  while k < f.locals.size {
    if f.valid_local(k) && m.types.traced(f.locals[k].ty) {
      f.locals[k].slot = true
      slots.push(k)
    }
    k = k + 1
  }
  pro: Array(MStmt) = []
  i = 0
  while i < slots.size {
    if !f.is_param(slots[i]) {
      z = MStmt.new(msk_assign(), f.loc)
      z.place = MPlace.new(slots[i])
      z.rv = MRvalue.new(mrk_zero())
      pro.push(z)
    }
    i = i + 1
  }
  pro.push(MStmt.new(msk_gc_enter(), f.loc))
  roots = MStmt.new(msk_gc_roots(), f.loc)
  roots.locals = slots
  pro.push(roots)
  entry = f.blocks[0]
  i = 0
  while i < entry.stmts.size {
    pro.push(entry.stmts[i])
    i = i + 1
  }
  entry.stmts = pro
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    if t = blk.term {
      if t.kind == mtk_return() {
        blk.stmts.push(MStmt.new(msk_gc_leave(), t.loc))
      }
    }
    b = b + 1
  }
}

pub fn mir_frames_minimal(m: MModule) {
  cand = Hash(String, Int).new
  i = 0
  while i < m.funcs.size {
    if !str_eq(m.funcs[i].symbol, "main") {
      cand[m.funcs[i].symbol] = 1
    }
    i = i + 1
  }
  changed = true
  while changed {
    changed = false
    i = 0
    while i < m.funcs.size {
      f = m.funcs[i]
      if mir_in_set(cand, f.symbol) {
        if mir_func_blocks_leaf(m, f, cand) {
          cand[f.symbol] = 0
          changed = true
        }
      }
      i = i + 1
    }
  }
  i = 0
  while i < m.funcs.size {
    f = m.funcs[i]
    if mir_in_set(cand, f.symbol) {
      f.kind = mfk_leaf()
    }
    i = i + 1
  }
  i = 0
  while i < m.funcs.size {
    f = m.funcs[i]
    mir_mark_calls(m, f)
    if f.kind != mfk_leaf() {
      mir_add_frame(m, f)
    }
    i = i + 1
  }
}
