// The lowering of Avant's C interface: `Ptr(T)` values (`ptr %L` for a C
// layout pointee, else the untyped `ptr`), C layouts (`clayout`, laid out
// by the C rule, reached only through `ptr %L`), calls of `lib`/`fun`
// bindings (an external with its C name; arguments converted as the
// checker allows; every reference-carrying argument passed as a bare
// local, so the root-slot pass roots it for the call, gc.av (c)), C
// callbacks (`<target>#cb`, a thunk with the plain C signature of the
// `fn` type that calls the target, which opens its own frame), the `pin`
// statement (unpinned at the end of its block, before every return, and
// on `break`/`next` out of the pinning loop), and the pin of a heap value
// stored into a C-layout field (recorded by the field's address and
// unpinned only by `release`; V13 third form), and `release`.

import location
import source
import type
import ast
import token
import typed_ir
import mir.types
import mir.ir
import mir.build
import mir.runtime
import mir.lower_ty
import mir.lower
import mir.lower_expr
import mir.lower_agg
import mir.lower_union
import mir.lower_fn
import re2c_pat

// ---- types

// Ptr(T): `ptr %L` when T is a C layout (its fields are reached
// through it), else the untyped `ptr` (opaque, Void, and every other
// pointee: the language reads nothing through them). A layout being laid
// out is already noted (empty), so a pointer to it inside it, or inside a
// layout it holds, names it (a list's `next`, a reply's elements).
pub fn (lw: MirLower) ptr_ty(t: Ty, loc: Location): Int {
  if inner = t.inner, inner.is_clayout() {
    l = lw.lw_m.types.layout_named(mir_mty(inner))
    if l < 0 {
      l = lw.clayout_layout(inner, loc)
    }
    if l < 0 {
      return -1
    }
    return lw.lw_m.types.ptr_to(lw.lw_m.types.agg(l))
  }
  if inner2 = t.inner, ptr_elem_ok(inner2) {
    // A C scalar (its C width) or a pointer: the element p[i] reads.
    return lw.lw_m.types.ptr_to(lw.c_elem_mty(inner2, loc))
  }
  mt_ptr()
}

// The MIR type of a C element (a layout field's or a Ptr's pointee): a
// narrow C scalar at its C width, an enum as C's int, else the type's
// own.
pub fn (lw: MirLower) c_elem_mty(t: Ty, loc: Location): Int {
  if t.c_scalar > 0 {
    return lw.c_scalar_mty(t.c_scalar)
  }
  if t.is_enum() {
    return mt_i32()
  }
  lw.field_mty(t, loc)
}

// A C layout: the C fields in declaration order by the C rule, as
// the old back end's plain STRUCT; noted empty on first use, then filled
// (a pointer field may name it), never given a type id (it never lives
// on the GC heap). Held by value inside itself, it is refused.
pub fn (lw: MirLower) clayout_layout(t: Ty, loc: Location): Int {
  name = mir_mty(t)
  if b = lw.lw_busy.get(name), b == 1 {
    lw.refuse(loc, "C layout ${t.show()} holding itself by value")
    return -1
  }
  l = lw.lw_m.types.layout_named(name)
  if l >= 0 {
    return l
  }
  lw.lw_busy[name] = 1
  none: Array(Int) = []
  nonames: Array(String) = []
  id = lw.lw_b.note_layout(name, mlk_clayout(), none, nonames)
  fields: Array(Int) = []
  names: Array(String) = []
  j = 0
  while j < t.fields.size {
    ft = lw.field_mty(t.fields[j].ty, loc)
    if t.fields[j].ty.c_scalar > 0 {
      ft = lw.c_scalar_mty(t.fields[j].ty.c_scalar)
    }
    if t.fields[j].ty.is_enum() {
      // C's int: read through enum_from_c, written through
      // enum_to_c.
      ft = mt_i32()
    }
    if lw.failed() {
      return -1
    }
    fields.push(ft)
    names.push(t.fields[j].name)
    j += 1
  }
  lw.lw_busy[name] = 0
  lw.lw_m.types.set_fields(id, fields, names)
  id
}

// ---- calls into C

// A `lib`/`fun` call (calls.av emit_lib_call, decl.av emit_lib_fun): the
// binding's checked signature as the external's (an `fn` parameter is a
// `ptr`, the address of a `#cb` thunk); the first binding of a C name
// declares it, a call through another binding carries its own signature.
// The class is the call table's for the C name, else `collects`;
// a function that takes a callback always collects.
pub fn (lw: MirLower) lower_lib_call(e: Expr): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  if cs = lw.lw_syms.find_cfun(e.lib_name, e.callee) {
    ps: Array(Int) = []
    has_cb = false
    for param in cs.params {
      if param.is_fn() {
        ps.push(mt_ptr())
        has_cb = true
      } else if param.c_scalar > 0 {
        ps.push(lw.c_scalar_mty(param.c_scalar))
      } else if param.is_enum() {
        // C's int.
        ps.push(mt_i32())
      } else {
        ps.push(lw.ty_at(param, e.loc, "a C parameter"))
      }
    }
    ret = lw.ty_at(cs.ret, e.loc, "a C result")
    if cs.ret.c_scalar > 0 {
      ret = lw.c_scalar_mty(cs.ret.c_scalar)
    }
    if cs.ret.is_enum() {
      ret = mt_i32()
    }
    if lw.failed() {
      return zero
    }
    args: Array(MOperand) = []
    // The `&x` arguments: a cell in the frame per argument, read back
    // into x after the call.
    cells: Array(Int) = []
    outs: Array(Expr) = []
    out_ks: Array(Int) = []
    i = 0
    while i < e.args.size && i < ps.size {
      a = e.args[i]
      o = zero
      if cs.params[i].is_fn() {
        o = lw.cb_pointer(a, cs.params[i])
      } else if a.kind == ex_unary() && a.op == tk_amp() {
        cell = lw.out_cell(a, cs.params[i], ps[i])
        if lw.failed() {
          return zero
        }
        if x = a.inner {
          cells.push(cell)
          outs.push(x)
          ck = 0
          if inner = cs.params[i].inner {
            ck = inner.c_scalar
          }
          out_ks.push(ck)
        }
        lw.at(a.loc)
        o = lw.tmp(ps[i], b.rv_addr_raw(b.pl(cell)))
      } else {
        o = lw.lower_expr(a)
        if t = a.ty {
          o = lw.coerce(o, t, cs.params[i], a.loc)
        }
        if lw.failed() {
          return zero
        }
        if cs.params[i].c_scalar > 0 {
          o = lw.to_c_scalar(o, cs.params[i].c_scalar, a.loc)
        }
        if cs.params[i].is_enum() {
          o = lw.enum_to_c(o, cs.params[i])
        }
        if lw.c_ret_string(cs.params[i]) && !(cs.runtime && b.module.rt.class_of(e.callee) == mcc_never()) {
          o = lw.c_string_arg(o, ps[i], cs.runtime)
        } else if cs.params[i].is_struct() && lw.has_c_strings(cs.params[i], 0) {
          // A struct by value: its strings as C reads them, in a copy.
          lw.at(a.loc)
          sv = lw.hold(o, ps[i])
          cp = b.temp(ps[i])
          b.assign(b.pl(cp), b.rv_use(b.copy_local(sv)))
          lw.c_strings_out_in(b.pl(cp), cs.params[i], cs.runtime, a.loc, 0)
          o = b.copy_local(cp)
        }
        // A reference the C function holds, or an aggregate the emitter
        // passes by the C ABI (its C ABI lowering), is a bare local of the call.
        k = b.types.kind(ps[i])
        if (b.types.traced(ps[i]) || k == mk_agg()) && mir_bare_copy(o) < 0 {
          lw.at(a.loc)
          o = lw.tmp(ps[i], b.rv_use(o))
        }
      }
      for j in i + 1..e.args.size {
        o = lw.snap(o, e.args[j])
      }
      args.push(o)
      i += 1
    }
    if lw.failed() {
      return zero
    }
    lw.at(e.loc)
    sig = b.sig(ps, ret, false)
    x = b.extern_c(e.callee, sig)
    if has_cb {
      b.module.externs[x].cls = mcc_collects()
    }
    dest = -1
    if ret != mt_void() {
      dest = b.temp(ret)
    }
    st = b.call(dest, e.callee, args)
    if b.module.externs[x].sig != sig {
      st.sig = sig
    }
    for k in 0..cells.size {
      lw.out_back(cells[k], outs[k], out_ks[k], e.loc)
    }
    if dest < 0 {
      return zero
    }
    if cs.ret.c_scalar > 0 {
      return lw.from_c_scalar(b.copy_local(dest), cs.ret.c_scalar)
    }
    if cs.ret.is_enum() {
      return lw.enum_from_c(b.copy_local(dest), cs.ret, e.loc)
    }
    if cs.ret.is_string() {
      lw.c_string_present(dest, "${e.lib_name}.${e.callee}", e.loc)
    }
    if lw.c_ret_string(cs.ret) && !cs.runtime {
      return lw.c_string_owned(dest)
    }
    if cs.ret.is_struct() && !cs.runtime {
      lw.c_strings_owned_in(b.pl(dest), cs.ret, e.loc, 0)
    }
    return b.copy_local(dest)
  }
  lw.refuse(e.loc, "the C function ${e.lib_name}.${e.callee} (no checked signature)")
  zero
}

// `&x` passed to a C function's parameter of type pt (MIR type pty, a
// `ptr` to the element): a cell in the frame holding x's value at C's
// width (a narrow C scalar converted, out of range trapping), whose
// address C gets. The cell is no heap value and holds no reference the
// collector traces, so C may write it during the call.
pub fn (lw: MirLower) out_cell(a: Expr, pt: Ty, pty: Int): Int {
  b = lw.lw_b
  et = lw.lw_m.types.pointee(pty)
  if x = a.inner {
    v = lw.lower_expr(x)
    if lw.failed() {
      return 0
    }
    lw.at(a.loc)
    if inner = pt.inner, inner.c_scalar > 0 {
      v = lw.to_c_scalar(v, inner.c_scalar, a.loc)
    }
    cell = b.temp(et)
    b.assign(b.pl(cell), b.rv_use(v))
    return cell
  }
  lw.refuse(a.loc, "&x without a local")
  0
}

// After the call: what C wrote into the cell, back into the local x (a
// narrow C scalar converted to its Avant view).
pub fn (lw: MirLower) out_back(cell: Int, x: Expr, ck: Int, loc: Location) {
  b = lw.lw_b
  if xt = x.ty {
    ty = lw.ety(x)
    if lw.failed() {
      return
    }
    lw.at(loc)
    v = b.copy_local(cell)
    if ck > 0 {
      v = lw.from_c_scalar(v, ck)
    }
    if lw.name_in_box(x.ident) {
      if mir_name_index(lw.lw_cl.caps, x.ident) < 0 {
        lw.ensure_box(x.ident, xt, loc)
      }
      lw.box_store(x.ident, xt, v, loc)
      return
    }
    k = lw.var_get(x.ident, ty)
    b.assign(b.pl(k), b.rv_use(v))
    return
  }
  lw.refuse(loc, "&x without a type")
}

// A `String` or `Bytes` (or one of them optional) that comes from C: a
// `fun` result, a field of C memory or of a struct C returned, a C
// callback's argument.
pub fn (lw: MirLower) c_ret_string(t: Ty): Bool {
  if mir_is_str_ty(t) {
    return true
  }
  if r = mir_opt_ref(t) {
    return mir_is_str_ty(r)
  }
  false
}

// A C function declared to return a `String` may return an address inside
// a heap object (`strchr` of a heap string): a root slot may hold one, a
// reference-typed field may not (the field rule;
// runtime/avant_gc_internal.h), and nothing in the program says which the
// result will reach. So the result passes through avant_c_str (the Valk
// stage): an address outside the collected heap (C's own memory, a
// literal), null and the exact start of a heap string come back as they
// are; an address inside a heap object comes back as a fresh copy of the
// C string there. A collecting call: the copy allocates.
pub fn (lw: MirLower) c_string_owned(dest: Int): MOperand {
  b = lw.lw_b
  args: Array(MOperand) = []
  args.push(b.copy_local(dest))
  lw.call_to(b.func.locals[dest].ty, "avant_c_str", args)
}

// The `String` fields of a struct C returned by value, through nested
// structs: each one through avant_c_str in place (c_string_owned), so
// what the program keeps is a string with its length.
pub fn (lw: MirLower) c_strings_owned_in(p: MPlace, t: Ty, loc: Location, depth: Int) {
  b = lw.lw_b
  if depth > 16 {
    return
  }
  k = 0
  while k < t.fields.size {
    ft = t.fields[k].ty
    fp = b.field(p, k)
    if lw.c_ret_string(ft) {
      v = b.temp(lw.ty_at(ft, loc, "a C result's field"))
      b.assign(b.pl(v), b.rv_use(b.copy(fp)))
      b.assign(b.field(p, k), b.rv_use(lw.c_string_owned(v)))
    } else if ft.is_struct() {
      lw.c_strings_owned_in(fp, ft, loc, depth + 1)
    }
    k += 1
  }
}

// A `String` or `Bytes` argument of a `fun` as C reads it: a terminated
// `char *` with its bytes in place. A flat string is passed as it is;
// a view (runtime/avant_rt.h, AvantStrView) becomes the address of its
// bytes when it ends its base's bytes (the base's terminator ends them,
// and nothing moves during the call), else a fresh terminated copy
// (avant_str_c_arg). The runtime's own C functions read a string's
// length from its header, so a view becomes a flat copy for them
// (avant_str_flat). Both are collecting calls the emitter inlines down to
// a test of the header when the string is not a view. A runtime function
// the call table says never collects (std.regex's find, span and count)
// takes the string as it is and reads a view's bytes itself, so its call
// stays one that never collects.
pub fn (lw: MirLower) c_string_arg(o: MOperand, ty: Int, runtime: Bool): MOperand {
  f = "avant_str_c_arg"
  if runtime {
    f = "avant_str_flat"
  }
  args: Array(MOperand) = []
  args.push(o)
  lw.call_to(ty, f, args)
}

// String operand val as a flat string, in a new local: itself, or, when
// it is a view (avant_str_view_test, which never collects), a flat copy
// (avant_str_flat). Only the view's path calls the collecting copy, and
// with its own local as the argument, so no root slot of the common path
// keeps the value alive afterwards (a slot holds what it was given until
// the function returns: tests/fixtures/ffi/complete.av frees the value a
// `release` gives back in the same function).
pub fn (lw: MirLower) str_flat_if_view(val: MOperand, ty: Int): Int {
  b = lw.lw_b
  v0 = lw.hold(val, ty)
  res = b.temp(ty)
  b.assign(b.pl(res), b.rv_use(b.copy_local(v0)))
  t = lw.call_to(mt_i32(), "avant_str_view_test", lw.one(b.copy_local(v0)))
  isv = lw.tmp(mt_bool(), b.rv_cmp(mop_ne(), t, b.c_i32(0)))
  bv = b.block()
  join = b.block()
  b.branch(isv, bv, join)
  b.at(bv)
  v1 = b.temp(ty)
  b.assign(b.pl(v1), b.rv_use(b.copy_local(v0)))
  b.call(res, "avant_str_flat", lw.one(b.copy_local(v1)))
  b.goto(join)
  b.at(join)
  res
}

// Whether struct t holds a `String` or `Bytes`, directly or in a nested
// struct.
pub fn (lw: MirLower) has_c_strings(t: Ty, depth: Int): Bool {
  if depth > 16 {
    return false
  }
  for f in t.fields {
    if lw.c_ret_string(f.ty) {
      return true
    }
    if f.ty.is_struct() && lw.has_c_strings(f.ty, depth + 1) {
      return true
    }
  }
  false
}

// The `String` fields of a struct the program passes to C by value,
// through nested structs, each as c_string_arg makes it, in place.
pub fn (lw: MirLower) c_strings_out_in(p: MPlace, t: Ty, runtime: Bool, loc: Location, depth: Int) {
  b = lw.lw_b
  if depth > 16 {
    return
  }
  k = 0
  while k < t.fields.size {
    ft = t.fields[k].ty
    if lw.c_ret_string(ft) {
      fty = lw.ty_at(ft, loc, "a C argument's field")
      v = b.temp(fty)
      b.assign(b.pl(v), b.rv_use(b.copy(b.field(p, k))))
      b.assign(b.field(p, k), b.rv_use(lw.c_string_arg(b.copy_local(v), fty, runtime)))
    } else if ft.is_struct() {
      lw.c_strings_out_in(b.field(p, k), ft, runtime, loc, depth + 1)
    }
    k += 1
  }
}

// A C function declared `: String` promises a string: a NULL it returns
// traps, naming the function (one compare and a cold block). `String?`
// reads NULL as nil.
pub fn (lw: MirLower) c_string_present(dest: Int, name: String, loc: Location) {
  b = lw.lw_b
  isnull = lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), b.copy_local(dest), b.c_null(b.func.locals[dest].ty)))
  ok = lw.trap_open(isnull, true)
  targs: Array(MOperand) = []
  targs.push(b.str_const(name))
  lw.trap_close(ok, "avant_trap_c_null", targs, loc)
}

// The address of the `#cb` thunk for a callback argument (calls.av
// emit_cb_pointer): a function name (`<sym>#cb`) or a lambda that
// captures nothing (`<thunk>#cb`; the checker refuses a capture and any
// other expression). The lambda's own thunk is lowered as any lambda's.
pub fn (lw: MirLower) cb_pointer(arg: Expr, fty: Ty): MOperand {
  b = lw.lw_b
  target = ""
  lam = false
  if arg.kind == ex_lambda() {
    t = fty
    if at = arg.ty {
      t = at
    }
    target = arg.resolved
    if !str_starts(target, "av.") {
      base = lw.lw_cl.base
      if base.size == 0 {
        base = b.func.symbol
      }
      target = lw.lambda_symbol(base)
      arg.resolved = target
    }
    l = lw.fn_layout(t, arg.loc)
    if lw.failed() {
      return b.c_i32(0)
    }
    lw.lw_cl.pending.push(MirLam.new(arg, target))
    lam = true
  } else if got = lw.lw_fn_syms.get(arg.resolved) {
    target = got
  } else {
    lw.refuse(arg.loc, "this C callback")
    return b.c_i32(0)
  }
  sym = "${target}#cb"
  if !lw.lw_ffi.cb_seen.has_key(sym) {
    lw.lw_ffi.cb_seen[sym] = 1
    lw.lw_ffi.cbs.push(MirCb.new(sym, target, fty, lam, arg.loc))
  }
  b.c_fn(sym)
}

// The callback thunks (calls.av emit_cb_thunk): the plain C signature of
// the `fn` type (the emitter gives `#cb` functions the C boundary's
// `zeroext` on Bool), a call of the target with the parameters
// (after a null environment for a lambda thunk), its result returned. The
// leaf and frame passes decide its kind like any function's. A struct,
// union, or fn value by value in a callback's C signature is refused (the
// C ABI lowering of aggregates is done for calls into C only).
pub fn (lw: MirLower) lower_cb_thunks {
  b = lw.lw_b
  i = 0
  while i < lw.lw_ffi.cbs.size && !lw.failed() {
    cb = lw.lw_ffi.cbs[i]
    lw.begin_at(cb.loc)
    ps: Array(Int) = []
    j = 0
    while j < cb.fty.members.size {
      if cb.fty.members[j].is_enum() {
        // C's int, checked on the way in.
        ps.push(mt_i32())
      } else if cb.fty.members[j].c_scalar > 0 {
        // C's width, converted exactly to its Avant view on the way in.
        ps.push(lw.c_scalar_mty(cb.fty.members[j].c_scalar))
      } else {
        ps.push(lw.ty_at(cb.fty.members[j], cb.loc, "a C callback parameter"))
      }
      j += 1
    }
    ret = mt_void()
    if r = cb.fty.inner {
      ret = lw.ty_at(r, cb.loc, "a C callback result")
      if r.is_enum() {
        ret = mt_i32()
      }
      if r.c_scalar > 0 {
        ret = lw.c_scalar_mty(r.c_scalar)
      }
    }
    if lw.failed() {
      return
    }
    j = 0
    while j <= ps.size {
      t = ret
      if j < ps.size {
        t = ps[j]
      }
      if b.types.kind(t) == mk_agg() {
        lw.refuse(cb.loc, "a C callback with a value of type ${b.types.text(t)} (a struct, union or fn value by value is passed by the C ABI only in calls into C)")
        return
      }
      j += 1
    }
    cbf = b.begin_fn(cb.sym, b.sig(ps, ret, false), lw.mloc(cb.loc), "callback")
    // C calls it, on any thread: its frame registers a thread C started
    // and returns it to running (gc.av's first-frame rule).
    cbf.entry = true
    lw.lw_ret = ret
    lw.at(cb.loc)
    args: Array(MOperand) = []
    if cb.lambda {
      args.push(b.c_null(mt_ref()))
    }
    j = 0
    while j < ps.size {
      if cb.fty.members[j].is_enum() {
        args.push(lw.enum_from_c(b.copy_local(j + 1), cb.fty.members[j], cb.loc))
      } else if cb.fty.members[j].c_scalar > 0 {
        args.push(lw.from_c_scalar(b.copy_local(j + 1), cb.fty.members[j].c_scalar))
      } else if lw.c_ret_string(cb.fty.members[j]) {
        // A string C passes in: through avant_c_str (c_string_owned).
        args.push(lw.c_string_owned(j + 1))
      } else {
        args.push(b.copy_local(j + 1))
      }
      j += 1
    }
    // A trap inside a callback ends the process, also in a task or an
    // HTTP handler: their recovery points would skip the C frames
    // between (runtime/avant_task.c). Only a program that spawns or
    // serves HTTP has recovery points: any other program's thunk is as
    // before.
    none: Array(MOperand) = []
    recovers = lw.recovers()
    if recovers {
      b.call(-1, "avant_task_cb_enter", none)
    }
    if ret == mt_void() {
      b.call(-1, cb.target, args)
    } else if rt = cb.fty.inner, rt.is_enum() {
      d0 = b.temp(lw.ty_at(rt, cb.loc, "a C callback result"))
      b.call(d0, cb.target, args)
      b.assign(b.pl(0), b.rv_use(lw.enum_to_c(b.copy_local(d0), rt)))
    } else if rt2 = cb.fty.inner, rt2.c_scalar > 0 {
      // The Avant view's value to C's width: out of range traps.
      d1 = b.temp(mir_c_view_mty(rt2.c_scalar))
      b.call(d1, cb.target, args)
      b.assign(b.pl(0), b.rv_use(lw.to_c_scalar(b.copy_local(d1), rt2.c_scalar, cb.loc)))
    } else if rt3 = cb.fty.inner, lw.c_ret_string(rt3) {
      // A string the callback gives C: as a `fun` argument is
      // (c_string_arg).
      d2 = b.temp(ret)
      b.call(d2, cb.target, args)
      b.assign(b.pl(0), b.rv_use(lw.c_string_arg(b.copy_local(d2), ret, false)))
    } else {
      d = b.temp(ret)
      b.call(d, cb.target, args)
      b.assign(b.pl(0), b.rv_use(b.copy_local(d)))
    }
    if recovers {
      b.call(-1, "avant_task_cb_leave", none)
    }
    b.ret()
    b.end_fn()
    i += 1
  }
}

// ---- C-layout fields

// The place of `p.f` with p a `Ptr(L)`, L a C layout: p in a local (the
// holder), then `(*_h).k` (V13 wants the deref first).
// ---- C scalar types

// The C width of a C scalar type (type.av cs_*).
pub fn (lw: MirLower) c_scalar_mty(k: Int): Int {
  ts = lw.lw_m.types
  if k == cs_int8() {
    return ts.scalar(mk_int(), 8, true, "i8")
  }
  if k == cs_int16() {
    return ts.scalar(mk_int(), 16, true, "i16")
  }
  if k == cs_uint8() {
    return mt_u8()
  }
  if k == cs_uint16() {
    return ts.scalar(mk_int(), 16, false, "u16")
  }
  if k == cs_uint32() {
    return mt_u32()
  }
  ts.scalar(mk_f64(), 32, true, "f32")
}

// A C scalar's value seen in Avant: exact (sign or zero extension, or
// fpext).
pub fn (lw: MirLower) from_c_scalar(v: MOperand, k: Int): MOperand {
  vt = mir_c_view_mty(k)
  lw.tmp(vt, lw.lw_b.rv_cast(v, vt))
}

// An Avant value passed or stored as a C scalar: an integer outside the C
// type's range traps with avant_trap_c_range(value, k) (the correct value
// or a trap); a Float64 rounds to the nearest Float32.
pub fn (lw: MirLower) to_c_scalar(v: MOperand, k: Int, loc: Location): MOperand {
  b = lw.lw_b
  nt = lw.c_scalar_mty(k)
  if k == cs_float32() {
    return lw.tmp(nt, b.rv_cast(v, nt))
  }
  vt = mir_c_view_mty(k)
  x = b.temp(vt)
  b.assign(b.pl(x), b.rv_use(v))
  lo = -128
  hi = 127
  if k == cs_int16() {
    lo = -32768
    hi = 32767
  } else if k == cs_uint8() {
    lo = 0
    hi = 255
  } else if k == cs_uint16() {
    lo = 0
    hi = 65535
  } else if k == cs_uint32() {
    lo = 0
    hi = 4294967295
  }
  c1 = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(x), lw.int_const(vt, lo)))
  c2 = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), lw.int_const(vt, hi)))
  inside = lw.tmp(mt_bool(), b.rv_bin(mop_and(), c1, c2))
  ok = lw.trap_open(inside, false)
  x64 = b.copy_local(x)
  if vt != mt_i64() {
    x64 = lw.tmp(mt_i64(), b.rv_cast(b.copy_local(x), mt_i64()))
  }
  lw.trap_close(ok, "avant_trap_c_range", lw.two(x64, b.c_i32(k)), loc)
  lw.tmp(nt, b.rv_cast(b.copy_local(x), nt))
}

// The C scalar kind of a C layout's field that e names (directly or
// through a Ptr), else 0.
pub fn (lw: MirLower) c_field_scalar(e: Expr): Int {
  if e.kind == ex_index() {
    // An element through a Ptr: its pointee's kind.
    if l = e.left, lt = l.ty, lt.is_ptr() {
      if inner = lt.inner {
        return inner.c_scalar
      }
    }
    return 0
  }
  if e.kind == ex_field() && !e.method_call {
    if obj = e.object, ot = obj.ty {
      lay = ot
      if ot.is_ptr() {
        if inner = ot.inner {
          lay = inner
        }
      }
      if lay.is_clayout() {
        if ft = lay.field_named(e.ident) {
          return ft.c_scalar
        }
      }
    }
  }
  0
}

// The enum type of a C layout's field that e names (directly or through
// a Ptr), else nil.
pub fn (lw: MirLower) c_field_enum(e: Expr): Ty? {
  none: Ty? = nil
  if e.kind == ex_field() && !e.method_call {
    if obj = e.object, ot = obj.ty {
      lay = ot
      if ot.is_ptr() {
        if inner = ot.inner {
          lay = inner
        }
      }
      if lay.is_clayout() {
        if ft = lay.field_named(e.ident), ft.is_enum() {
          return ft
        }
      }
    }
  }
  none
}

// The C layout and its field that e names (directly or through a Ptr),
// when the field is declared a plain `String` (not `String?`), else nil.
pub fn (lw: MirLower) c_field_string(e: Expr): String? {
  if e.kind == ex_field() && !e.method_call {
    if obj = e.object, ot = obj.ty {
      lay = ot
      if ot.is_ptr() {
        if inner = ot.inner {
          lay = inner
        }
      }
      if lay.is_clayout() {
        if ft = lay.field_named(e.ident), ft.is_string() {
          return "${lay.name}.${e.ident}"
        }
      }
    }
  }
  nil
}

// A C layout's field declared `String` promises a string: a NULL there
// (one C left unset, or one `release` made null) traps, naming the field
// (one compare and a cold block). `String?` reads NULL as nil.
pub fn (lw: MirLower) c_field_string_read(e: Expr, name: String): MOperand {
  b = lw.lw_b
  ty = lw.ety(e)
  v = lw.lower_place_read(e)
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  d = b.temp(ty)
  b.assign(b.pl(d), b.rv_use(v))
  isnull = lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), b.copy_local(d), b.c_null(ty)))
  ok = lw.trap_open(isnull, true)
  targs: Array(MOperand) = []
  targs.push(b.str_const("the C field ${name} is NULL (declare it String? to read NULL as nil)"))
  lw.trap_close(ok, "avant_trap_expect", targs, e.loc)
  b.copy_local(d)
}

pub fn (lw: MirLower) ptr_field_place(e: Expr, obj: Expr, ot: Ty): MPlace {
  b = lw.lw_b
  if inner = ot.inner, inner.is_clayout() {
    o = lw.lower_expr(obj)
    if lw.failed() {
      return b.pl(0)
    }
    lw.at(e.loc)
    pt = lw.ety(obj)
    h = lw.hold(o, pt)
    // A NULL pointer traps, naming the layout and the field, before the
    // access (one compare and a cold block): the program's output is
    // flushed and a task or a request that does it fails alone.
    isnull = lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), b.copy_local(h), b.c_null(pt)))
    ok = lw.trap_open(isnull, true)
    targs: Array(MOperand) = []
    targs.push(b.str_const("the field ${e.ident} read or written through a NULL ${ot.show()} (a pointer C may leave NULL is declared ${ot.show()}? and tested: if p = ...)"))
    lw.trap_close(ok, "avant_trap_expect", targs, e.loc)
    k = lw.field_of(inner, e.ident, e.loc)
    return b.field(b.deref(b.pl(h)), k)
  }
  lw.refuse(e.loc, "the field .${e.ident} of ${ot.show()}")
  b.pl(0)
}

// The place of `p[i]`, p a Ptr to a C scalar or a pointer: p and i
// each in a local, a NULL p trapping before the access (one compare and
// a cold block), then `(*_h)[_i]`, element i of the C array at p. C
// gave no length, so i is not checked.
pub fn (lw: MirLower) ptr_index_place(e: Expr): MPlace {
  b = lw.lw_b
  if arr = e.left, ix = e.right, at = arr.ty {
    o = lw.lower_expr(arr)
    if lw.failed() {
      return b.pl(0)
    }
    lw.at(e.loc)
    pt = lw.ety(arr)
    h = lw.hold(o, pt)
    i = lw.lower_expr(ix)
    if lw.failed() {
      return b.pl(0)
    }
    lw.at(e.loc)
    k = lw.hold(i, mt_int())
    isnull = lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), b.copy_local(h), b.c_null(pt)))
    ok = lw.trap_open(isnull, true)
    targs: Array(MOperand) = []
    targs.push(b.str_const("an element read or written through a NULL ${at.show()} (a pointer C may leave NULL is declared ${at.show()}? and tested: if p = ...)"))
    lw.trap_close(ok, "avant_trap_expect", targs, e.loc)
    return b.index(b.deref(b.pl(h)), b.copy_local(k))
  }
  lw.refuse(e.loc, "this element of a Ptr")
  b.pl(0)
}

// `p[i]` read: the element, a narrow C scalar converted to its Avant
// view.
pub fn (lw: MirLower) lower_ptr_index_read(e: Expr): MOperand {
  b = lw.lw_b
  ck = lw.c_field_scalar(e)
  ty = lw.ety(e)
  p = lw.ptr_index_place(e)
  if lw.failed() {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  if ck > 0 {
    raw = lw.tmp(lw.c_scalar_mty(ck), b.rv_use(b.copy(p)))
    return lw.from_c_scalar(raw, ck)
  }
  lw.tmp(ty, b.rv_use(b.copy(p)))
}

// A reference-carrying value stored into a C-layout field (the old
// back end's emit_assign, c_layout_heap_store): the value in a local, the
// field's address in a local (one GEP: `addr` of a place reached through
// a `ptr` is a `ptr`), the value pinned and the pin recorded under that
// address (`avant_pin_field`), then stored. An overwrite unpins nothing;
// `release` gives the recorded pins back (lower_release). C memory is not
// traced, so no barrier (V13 third form).
pub fn (lw: MirLower) pinned_store(p: MPlace, ty: Int, val: MOperand) {
  b = lw.lw_b
  sv = val
  if ty == mt_str() {
    // C reads the field as a terminated string with its bytes in
    // place: a view is stored as a flat copy (str_flat_if_view).
    sv = b.copy_local(lw.str_flat_if_view(val, ty))
  }
  v = lw.hold(sv, ty)
  a = b.temp(mt_ptr())
  b.assign(b.pl(a), b.rv_addr(p))
  args: Array(MOperand) = []
  args.push(b.copy_local(a))
  args.push(b.copy_local(v))
  b.call(-1, "avant_pin_field", args)
  b.assign(p, b.rv_use(b.copy_local(v)))
}

// `release(place)`: the pins Avant's stores into a C-layout field took,
// given back. For a field (`release(h.name)`, `release(h.at)`): its
// address (`addr` of a place through a `ptr` is a `ptr`) and its size;
// for a `Ptr` to a C layout (`release(h)`): the pointer and the
// layout's size. Then `avant_release_range(lo, n)`, which never
// collects. No store, so no V13 form.
pub fn (lw: MirLower) lower_release(st: Stmt) {
  b = lw.lw_b
  if e = st.expr {
    ty = lw.ety(e)
    if lw.failed() {
      return
    }
    lo = -1
    n = 0
    if lw.lw_m.types.is_ptr(ty) {
      v = lw.lower_expr(e)
      if lw.failed() {
        return
      }
      lw.at(st.loc)
      lo = lw.hold(v, ty)
      n = lw.lw_m.types.size_of(lw.lw_m.types.pointee(ty))
    } else {
      p = lw.place_of(e)
      if lw.failed() {
        return
      }
      lw.at(st.loc)
      lo = b.temp(mt_ptr())
      b.assign(b.pl(lo), b.rv_addr(p))
      n = lw.lw_m.types.size_of(ty)
    }
    args: Array(MOperand) = []
    args.push(b.copy_local(lo))
    args.push(b.c_u64(n.to_i()))
    b.call(-1, "avant_release_range", args)
    return
  }
  lw.refuse(st.loc, "a release without a place")
}

// ---- pins

// `pin x { body }` (the old back end's emit_pin_stmt): x into a local, pinned; the
// body; unpinned at the end of the block when it falls through. A `fn`
// value pins its environment (the heap part of the value).
pub fn (lw: MirLower) lower_pin(st: Stmt) {
  b = lw.lw_b
  if e = st.expr {
    if et = e.ty {
      ty = lw.ety(e)
      v = lw.lower_expr(e)
      if lw.failed() {
        return
      }
      lw.at(st.loc)
      if mir_is_str_ty(et) && e.kind == ex_name() && !e.fn_ref && !e.implicit_field && !lw.name_in_box(e.ident) && lw.mutex_index(e.ident) < 0 {
        // A pinned string local is flat for the block: a view is
        // replaced by a flat copy (avant_str_flat; the same text), so the
        // address C gets from it is the pinned object's own.
        k = lw.var_find(e.ident, ty)
        if k >= 0 {
          fv = b.temp(ty)
          b.call(fv, "avant_str_flat", lw.one(v))
          b.assign(b.pl(k), b.rv_use(b.copy_local(fv)))
          v = b.copy_local(k)
        }
      }
      h = b.temp(ty)
      b.assign(b.pl(h), b.rv_use(v))
      if et.is_fn() {
        h2 = b.temp(mt_ref())
        b.assign(b.pl(h2), b.rv_use(b.copy(b.field(b.pl(h), 0))))
        h = h2
      }
      args: Array(MOperand) = []
      args.push(b.copy_local(h))
      b.call(-1, lw.task_name("avant_pin"), args)
      lw.lw_ffi.pins.push(h)
      lw.lw_ffi.pin_depth.push(lw.lw_heads.size)
      lw.lower_stmts(st.body)
      lw.lw_ffi.pins.pop()
      lw.lw_ffi.pin_depth.pop()
      if !lw.failed() && lw.open_now() {
        lw.at(st.loc)
        lw.unpin(h)
      }
      return
    }
    lw.refuse(st.loc, "an untyped pin")
    return
  }
  lw.lower_stmts(st.body)
}

pub fn (lw: MirLower) unpin(h: Int) {
  args: Array(MOperand) = []
  if h < -1 {
    // A `Mutex.with` block's lock, its mutex in local -2 - h
    // (lower_task.av lower_mutex_with).
    m = -2 - h
    gi = 0
    if g = lw.lw_ffi.with_gate.get(m) {
      gi = g
    }
    lw.lw_b.call(-1, "avant_gate_unlock", lw.gate_args(m, gi))
    return
  }
  if h < 0 {
    // A `gc.hold` block's entry (lower_hold).
    lw.lw_b.call(-1, lw.task_name("avant_gc_hold_end"), args)
    return
  }
  args.push(lw.lw_b.copy_local(h))
  lw.lw_b.call(-1, lw.task_name("avant_unpin"), args)
}

// Whether the program has recovery points (runtime/avant_task.c): it
// spawns (a trap in a task ends the task), or it imports std.http (a
// trap in a handler fails its request). Its C callbacks' thunks and its
// `pin` blocks and holds then go through the task pool's entries.
pub fn (lw: MirLower) recovers: Bool {
  if lw.lw_m.shared {
    return true
  }
  for m in lw.lw_prog.mods {
    if m.name == "std.http" {
      return true
    }
  }
  false
}

// A `pin` block's and a `gc.hold`'s runtime entry: in a program with
// recovery points, the task pool's form (runtime/avant_task.c), which
// keeps what a task or a handler holds so that a trap ending it gives it
// back; the collector's own otherwise.
pub fn (lw: MirLower) task_name(name: String): String {
  if !lw.recovers() {
    return name
  }
  if name == "avant_pin" {
    return "avant_task_pin"
  }
  if name == "avant_unpin" {
    return "avant_task_unpin"
  }
  if name == "avant_gc_hold_begin" {
    return "avant_task_hold_begin"
  }
  "avant_task_hold_end"
}

// `gc.hold { body }` (std.gc): avant_gc_hold_begin, the body,
// avant_gc_hold_end at the end of the block when it falls through. The
// hold is an entry of the pin stack (h -1), so it ends on every way out
// as a pin is unpinned: before a return (and a `?` that returns), and on
// break or continue out of a loop opened outside it.
pub fn (lw: MirLower) lower_hold(st: Stmt) {
  b = lw.lw_b
  lw.at(st.loc)
  none: Array(MOperand) = []
  b.call(-1, lw.task_name("avant_gc_hold_begin"), none)
  lw.lw_ffi.pins.push(-1)
  lw.lw_ffi.pin_depth.push(lw.lw_heads.size)
  lw.lower_stmts(st.body)
  lw.lw_ffi.pins.pop()
  lw.lw_ffi.pin_depth.pop()
  if !lw.failed() && lw.open_now() {
    lw.at(st.loc)
    lw.unpin(-1)
  }
}

// Before `break` or `next`: the pins opened inside the innermost loop,
// innermost first (the old back end's emit_unpin_loop).
pub fn (lw: MirLower) unpin_loop {
  i = lw.lw_ffi.pins.size - 1
  while i >= 0 && lw.lw_ffi.pin_depth[i] == lw.lw_heads.size {
    lw.unpin(lw.lw_ffi.pins[i])
    i -= 1
  }
}

// Before a return: every open pin, innermost first (the old back end's emit_ret's
// emit_unpin_all; the old back end also forgets them there, so a pin
// block whose end is reachable after a return inside it is never
// unpinned on that path: corrected here).
pub fn (lw: MirLower) unpin_all {
  i = lw.lw_ffi.pins.size - 1
  while i >= 0 {
    lw.unpin(lw.lw_ffi.pins[i])
    i -= 1
  }
}

// ---- literal regex patterns

// `Regex.compile("<literal>", <literal flags>, <limits>)` whose pattern
// re2c compiled at build time (pipeline.av re2c_plan; calls.av emit_call,
// re2c_call_id): `regex_from_re2c(id, groups, pattern, caseless,
// match_limit, depth_limit, heap_limit)` in std.regex, as the old back
// end; nil when the call is not one. The limits are lowered in the
// parameters' order, so a call whose named arguments are evaluated in
// another order stays an ordinary call unless they are literals.
pub fn (lw: MirLower) lower_re2c_compile(e: Expr): MOperand? {
  pat = e.args[0]
  flags = e.args[1]
  if pat.kind != ex_string() || e.args.size != 5 {
    return nil
  }
  if order = e.arg_order {
    for k in 2..5 {
      if e.args[k].kind != ex_int() {
        return nil
      }
    }
  }
  fv = -1
  if flags.kind == ex_int() && flags.int_bits <= 2147483647u64 {
    fv = flags.int_bits.to_i()
  } else if flags.kind == ex_bool() {
    fv = 0
    if flags.bool_val {
      fv = 1
    }
    if t = flags.ty {
    } else {
      flags.ty = ty_bool()
    }
  }
  if fv < 0 {
    return nil
  }
  rid = 0
  if id = lw.lw_prog.re2c_ids.get(re2c_key(pat.value_str, fv)) {
    rid = id
  }
  if rid <= 0 {
    return nil
  }
  groups = 0
  if rid <= lw.lw_prog.re2c_groups.size {
    groups = lw.lw_prog.re2c_groups[rid - 1]
  }
  if sym = lw.lw_fn_syms.get("regex_from_re2c") {
    b = lw.lw_b
    args: Array(MOperand) = []
    args.push(b.c_i64(rid.to_i()))
    args.push(b.c_i64(groups.to_i()))
    args.push(lw.lower_expr(pat))
    args.push(lw.lower_expr(flags))
    for k in 2..5 {
      args.push(lw.lower_expr(e.args[k]))
    }
    if lw.failed() {
      return b.c_i32(0)
    }
    lw.at(e.loc)
    return lw.call_to(lw.ety(e), sym, args)
  }
  nil
}

// ---- Enums at the C boundary

// An enum passed to C is C's int: a narrow (one-byte) enum is widened,
// one instruction.
pub fn (lw: MirLower) enum_to_c(v: MOperand, t: Ty): MOperand {
  if mir_enum_ty(t) == mt_i32() {
    return v
  }
  lw.tmp(mt_i32(), lw.lw_b.rv_cast(v, mt_i32()))
}

// An enum C gave (a `fun` result, a C layout's field): C's int, checked
// to be a member (a value that is none traps naming the enum and the
// number: one range test when the values are contiguous, else a switch),
// then the enum's width.
pub fn (lw: MirLower) enum_from_c(v: MOperand, t: Ty, loc: Location): MOperand {
  b = lw.lw_b
  x = b.temp(mt_i32())
  b.assign(b.pl(x), b.rv_use(v))
  vals = t.enum_vals()
  lo = vals[0]
  hi = vals[0]
  for w in vals {
    if w < lo {
      lo = w
    }
    if w > hi {
      hi = w
    }
  }
  ok = -1
  if hi - lo + 1 == vals.size {
    c1 = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(x), b.c_i32(lo)))
    c2 = lw.tmp(mt_bool(), b.rv_cmp(mop_le(), b.copy_local(x), b.c_i32(hi)))
    inside = lw.tmp(mt_bool(), b.rv_bin(mop_and(), c1, c2))
    ok = lw.trap_open(inside, false)
  } else {
    ok = b.block()
    bad = b.block()
    targets: Array(Int) = []
    for w2 in vals {
      targets.push(ok)
    }
    b.switch_on(b.copy_local(x), vals, targets, bad)
    b.at(bad)
  }
  x64 = lw.tmp(mt_i64(), b.rv_cast(b.copy_local(x), mt_i64()))
  lw.trap_close(ok, "avant_trap_enum", lw.two(x64, b.str_const(t.show())), loc)
  et = mir_enum_ty(t)
  if et == mt_i32() {
    return b.copy_local(x)
  }
  lw.tmp(et, b.rv_cast(b.copy_local(x), et))
}
