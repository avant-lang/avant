// The lowering of the builtins that take a block: `Array.each`, `any`, `all`,
// `sort { }`, `sorted { }`, and `Hash.each` are inlined loops in the calling function,
// as the old back end emitted them: the receiver once into a local, an `i32` counter,
// the size and the element buffer read again on every iteration, the block's
// parameters bound as the function's own named locals (or through their boxes when a
// lambda in the block captures them), the body lowered in place. A `return` in the
// block returns from the function; `break` leaves the inlined loop and `next` goes on
// with the next element (the old back end's `next` jumped back to the test without the
// increment, a loop that never ends; the bug is not reproduced). A value block (`any`,
// `all`, the comparators) yields the expression of its last statement. Blocks given to
// user functions are lambdas (the checker absorbs them as the last argument),
// lower_fn.av.

import location
import source
import token
import type
import ast
import typed_ir
import mir.types
import mir.ir
import mir.build
import mir.lower_ty
import mir.lower
import mir.lower_expr
import mir.lower_stmt
import mir.lower_call
import mir.lower_agg
import mir.lower_arr
import mir.lower_hash
import mir.lower_union
import mir.lower_fn

// The block forms, or nil for a call this file does not lower.
pub fn (lw: MirLower) lower_block_call(e: Expr): MOperand? {
  if bl0 = e.block, e.callee == "Array.new" && e.args.size == 1 && bl0.params.size == 1 {
    if r0 = e.receiver {
    } else {
      return lw.arr_build(e, bl0)
    }
  }
  if bl = e.block, recv = e.receiver, rt = recv.ty {
    c = e.callee
    if rt.is_array() && e.args.size == 0 {
      if c == "each" && bl.params.size == 1 {
        return lw.arr_each(e, recv, bl)
      }
      if (c == "any" || c == "all") && bl.params.size == 1 {
        return lw.arr_pred(e, recv, bl, c == "any")
      }
      if (c == "sort" || c == "sorted") && bl.params.size == 2 {
        return lw.arr_sort_block(e, recv, bl, c == "sorted")
      }
      if (c == "find" || c == "index_of") && bl.params.size == 1 {
        return lw.arr_find(e, recv, bl, c == "index_of")
      }
      if (c == "min_by" || c == "max_by") && bl.params.size == 1 {
        return lw.arr_min_by(e, recv, bl, c == "max_by")
      }
      if c == "delete_if" && bl.params.size == 1 {
        return lw.arr_delete_if(e, recv, bl)
      }
    }
    if (rt.is_hash() || rt.is_set()) && c == "delete_if" && e.args.size == 0 {
      return lw.hash_delete_if(e, recv, rt, bl)
    }
    if rt.is_hash() && c == "each" && e.args.size == 0 && bl.params.size == 2 {
      return lw.hash_each(e, recv, rt, bl)
    }
    if rt.is_set() && c == "each" && e.args.size == 0 && bl.params.size == 1 {
      return lw.hash_each(e, recv, rt, bl)
    }
  }
  nil
}

// The receiver, once, into its own local (a later assignment to the
// receiver's variable does not change the loop, as in the old back end).
pub fn (lw: MirLower) block_recv(recv: Expr, ty: Int): Int {
  b = lw.lw_b
  a = lw.lower_expr(recv)
  if lw.failed() {
    return 0
  }
  lw.at(recv.loc)
  h = b.temp(ty)
  b.assign(b.pl(h), b.rv_use(a))
  h
}

// `i < (*_h).size` for the array in _h, into a branch to body or exit.
pub fn (lw: MirLower) block_test(h: Int, i: Int, body: Int, exit: Int) {
  b = lw.lw_b
  n = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), 1))))
  c = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(i), n))
  b.branch(c, body, exit)
}

// The element at index _i of the array in _h (emit_arr_load: the buffer
// read again, no bounds check: i is below the size just read).
pub fn (lw: MirLower) block_elem(h: Int, aty: Int, i: Int): MOperand {
  b = lw.lw_b
  d = b.temp(b.types.ref_to(lw.elems_of(aty)))
  b.assign(b.pl(d), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), 0))))
  lw.tmp(lw.elem_of(aty), b.rv_use(b.copy(b.index(b.deref(b.pl(d)), b.copy_local(i)))))
}

// The parameter of `each`, `any` or `all` at index _i of the array in
// _h: the element's copy, or, when the element is a place (the block's
// place names, checker/places.av), the walked array and the counter
// bound to the hidden names its uses index.
pub fn (lw: MirLower) block_param(bl: Block, recv: Expr, h: Int, aty: Int, i: Int) {
  b = lw.lw_b
  if bl.place_arr.size > 0 {
    if rt = recv.ty {
      lw.bind_name(bl.place_arr, rt, aty, b.copy_local(h), bl.loc, true)
      ix = lw.tmp(mt_int(), b.rv_cast(b.copy_local(i), mt_int()))
      lw.bind_name(bl.place_idx, ty_int(), mt_int(), ix, bl.loc, true)
      return
    }
  }
  v = lw.block_elem(h, aty, i)
  lw.bind_name(bl.params[0], lw.elem_ty_of(recv), lw.elem_of(aty), v, bl.loc, true)
}

// Stores v at index _i of the array in _h (emit_arr_store), behind the
// buffer's barrier when the element is reference-carrying (the old back
// end stores without one, which loses the young value when a
// comparator's collection promoted the buffer).
pub fn (lw: MirLower) block_store(h: Int, aty: Int, i: Int, v: MOperand) {
  b = lw.lw_b
  d = b.temp(b.types.ref_to(lw.elems_of(aty)))
  b.assign(b.pl(d), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), 0))))
  et = lw.elem_of(aty)
  if b.types.ref_carrying(et) {
    b.barrier(d)
  }
  b.assign(b.index(b.deref(b.pl(d)), b.copy_local(i)), b.rv_use(v))
}

// _i = _i + 1 (the old plain add), then back to head.
pub fn (lw: MirLower) block_step(i: Int, head: Int) {
  b = lw.lw_b
  b.assign(b.pl(i), b.rv_bin(mop_add(), b.copy_local(i), b.c_i32(1)))
  b.goto(head)
}

// The block's body with `break` to exit and `next` to cont.
pub fn (lw: MirLower) block_body(stmts: Array(Stmt), cont: Int, exit: Int) {
  lw.lw_heads.push(cont)
  lw.lw_exits.push(exit)
  lw.lower_stmts(stmts)
  lw.lw_heads.pop()
  lw.lw_exits.pop()
}

// A value block (emit_pred_block, emit_cmp_block): every statement but
// the last, then the last one's expression (a trailing `return e` yields
// e there, as in the old back end).
pub fn (lw: MirLower) block_value(bl: Block, cont: Int, exit: Int): MOperand {
  b = lw.lw_b
  if bl.paren && bl.returns {
    if v = lw.lam_value(bl, ty_bool(), mt_bool(), cont, exit) {
      return v
    }
    return b.c_bool(false)
  }
  if bl.body.size == 0 {
    lw.refuse(bl.loc, "an empty value block")
    return b.c_bool(false)
  }
  head: Array(Stmt) = []
  i = 0
  while i < bl.body.size - 1 {
    head.push(bl.body[i])
    i += 1
  }
  lw.block_body(head, cont, exit)
  if lw.failed() {
    return b.c_bool(false)
  }
  if !lw.open_now() {
    // Every path left the block: the value is never used.
    return b.c_bool(false)
  }
  last = bl.body[bl.body.size - 1]
  if x = last.expr {
    v = lw.lower_expr(x)
    if lw.failed() {
      return b.c_bool(false)
    }
    lw.at(x.loc)
    return lw.tmp(mt_bool(), b.rv_use(v))
  }
  lw.refuse(last.loc, "a block that does not end with a value")
  b.c_bool(false)
}

// `Array(T).new(n) { |i| ... }`: n once, with `Array(T).new(n)`'s two
// traps (negative, the ceiling); a zeroed buffer of n elements; then for
// i from 0 to n - 1 the block with i bound, and its value stored into
// element i; then the header with size = cap = n, as lower_array_new.
// The buffer is held in a slot while it fills (the block may collect);
// elements not yet built are zero bytes, which the collector reads as no
// reference. A reference-carrying element is stored behind the buffer's
// barrier, as an array literal's and as block_store's (the fresh pass
// removes the barrier while the buffer is still open).
pub fn (lw: MirLower) arr_build(e: Expr, bl: Block): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  aty = lw.ety(e)
  if lw.failed() {
    return zero
  }
  nv = lw.lower_expr(e.args[0])
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  k = b.temp(mt_int())
  b.assign(b.pl(k), b.rv_use(nv))
  neg = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(k), b.c_i64(0)))
  ok = lw.trap_open(neg, true)
  lw.trap_close(ok, "avant_trap_negative", lw.two(b.copy_local(k), b.c_i32(0)), e.loc)
  big = lw.tmp(mt_bool(), b.rv_cmp(mop_gt(), b.copy_local(k), b.c_i64(2147483647)))
  ok2 = lw.trap_open(big, true)
  lw.trap_close(ok2, "avant_trap_size", lw.one(b.c_i32(2)), e.loc)
  n64 = lw.tmp(mt_u64(), b.rv_cast(b.copy_local(k), mt_u64()))
  bytes = lw.tmp(mt_u64(), b.rv_bin(mop_mul(), n64, lw.elem_size(aty)))
  d = b.temp(b.types.ref_to(lw.elems_of(aty)))
  b.call(d, "avant_alloc", lw.two(bytes, lw.buf_tid(aty)))
  et = lw.elem_of(aty)
  want = lw.elem_ty_of(e)
  rc = b.types.ref_carrying(et)
  i = b.temp(mt_int())
  b.assign(b.pl(i), b.rv_use(b.c_i64(0)))
  head = b.block()
  body = b.block()
  step = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  c = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(i), b.copy_local(k)))
  b.branch(c, body, exit)
  b.at(body)
  lw.bind_name(bl.params[0], ty_int(), mt_int(), b.copy_local(i), bl.loc, true)
  if bl.body.size == 0 {
    lw.refuse(bl.loc, "an empty value block")
    return zero
  }
  if bl.paren && bl.returns {
    // A lambda whose `return` gives the element: its value from the
    // result slot.
    if v = lw.lam_value(bl, want, et, step, exit) {
      lw.at(e.loc)
      if rc {
        b.barrier(d)
      }
      b.assign(b.index(b.deref(b.pl(d)), b.copy_local(i)), b.rv_use(v))
    }
    if lw.failed() {
      return zero
    }
    lw.goto_if_open(step, e.loc)
    b.at(step)
    lw.at(e.loc)
    b.assign(b.pl(i), b.rv_bin(mop_add(), b.copy_local(i), b.c_i64(1)))
    b.goto(head)
    b.at(exit)
    lw.at(e.loc)
    return lw.array_header(aty, d, lw.tmp(mt_i32(), b.rv_cast(b.copy_local(k), mt_i32())))
  }
  first: Array(Stmt) = []
  j = 0
  while j < bl.body.size - 1 {
    first.push(bl.body[j])
    j += 1
  }
  lw.block_body(first, step, exit)
  if lw.failed() {
    return zero
  }
  if lw.open_now() {
    last = bl.body[bl.body.size - 1]
    if x = last.expr {
      v = lw.lower_coerced(x, et, want)
      if lw.failed() {
        return zero
      }
      lw.at(x.loc)
      p = b.index(b.deref(b.pl(d)), b.copy_local(i))
      // Behind the buffer's barrier, like any store (lower_array_lit's
      // comment): the fresh pass removes it where the buffer is still
      // open.
      if rc {
        b.barrier(d)
      }
      b.assign(p, b.rv_use(v))
    } else {
      lw.refuse(last.loc, "a block that does not end with a value")
      return zero
    }
  }
  lw.goto_if_open(step, e.loc)
  b.at(step)
  lw.at(e.loc)
  b.assign(b.pl(i), b.rv_bin(mop_add(), b.copy_local(i), b.c_i64(1)))
  b.goto(head)
  b.at(exit)
  lw.at(e.loc)
  lw.array_header(aty, d, lw.tmp(mt_i32(), b.rv_cast(b.copy_local(k), mt_i32())))
}

// `xs.each { |x| ... }` (emit_array_each, builtins.av:1632-1684).
pub fn (lw: MirLower) arr_each(e: Expr, recv: Expr, bl: Block): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  aty = lw.ety(recv)
  if lw.failed() {
    return zero
  }
  h = lw.block_recv(recv, aty)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  i = b.temp(mt_i32())
  b.assign(b.pl(i), b.rv_use(b.c_i32(0)))
  head = b.block()
  body = b.block()
  step = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  lw.block_test(h, i, body, exit)
  b.at(body)
  lw.block_param(bl, recv, h, aty, i)
  lw.walk_body(bl, step, exit)
  lw.goto_if_open(step, e.loc)
  b.at(step)
  lw.at(e.loc)
  lw.block_step(i, head)
  b.at(exit)
  zero
}

// `xs.any { |x| p }`, `xs.all { |x| p }` (emit_array_predicate,
// builtins.av:789-862): the result starts false (any) or true (all); the
// first element that decides it ends the loop.
pub fn (lw: MirLower) arr_pred(e: Expr, recv: Expr, bl: Block, is_any: Bool): MOperand {
  b = lw.lw_b
  zero = b.c_bool(false)
  aty = lw.ety(recv)
  if lw.failed() {
    return zero
  }
  h = lw.block_recv(recv, aty)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  res = b.temp(mt_bool())
  b.assign(b.pl(res), b.rv_use(b.c_bool(!is_any)))
  i = b.temp(mt_i32())
  b.assign(b.pl(i), b.rv_use(b.c_i32(0)))
  head = b.block()
  body = b.block()
  step = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  lw.block_test(h, i, body, exit)
  b.at(body)
  lw.block_param(bl, recv, h, aty, i)
  p = lw.block_value(bl, step, exit)
  if lw.failed() {
    return zero
  }
  if lw.open_now() {
    lw.at(e.loc)
    hit = b.block()
    if !is_any {
      p = lw.tmp(mt_bool(), b.rv_un(mop_not(), p))
    }
    b.branch(p, hit, step)
    b.at(hit)
    b.assign(b.pl(res), b.rv_use(b.c_bool(is_any)))
    b.goto(exit)
  }
  b.at(step)
  lw.at(e.loc)
  lw.block_step(i, head)
  b.at(exit)
  b.copy_local(res)
}

// `xs.sort { |a, b| c }` and `xs.sorted { |a, b| c }` (emit_comparator_sort,
// builtins.av:864-947; `sorted` first copies the array, :949-974): an
// insertion sort that moves the element at i left while the comparator
// of (it, the element before) is true. `break` and `next` in the
// comparator end the inner loop, as its false does.
pub fn (lw: MirLower) arr_sort_block(e: Expr, recv: Expr, bl: Block, do_copy: Bool): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  aty = lw.ety(recv)
  if lw.failed() {
    return zero
  }
  arr = lw.block_recv(recv, aty)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  if do_copy {
    c = b.temp(aty)
    b.call(c, "avant_array_copy", lw.three(b.copy_local(arr), lw.elem_size(aty), lw.buf_tid(aty)))
    arr = c
  }
  et = lw.elem_of(aty)
  want = lw.elem_ty_of(recv)
  n = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.deref(b.pl(arr)), 1))))
  nl = mir_bare_copy(n)
  i = b.temp(mt_i32())
  b.assign(b.pl(i), b.rv_use(b.c_i32(1)))
  head = b.block()
  body = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  c1 = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(i), b.copy_local(nl)))
  b.branch(c1, body, exit)
  b.at(body)
  v = lw.block_elem(arr, aty, i)
  vl = mir_bare_copy(v)
  j = b.temp(mt_i32())
  b.assign(b.pl(j), b.rv_use(b.copy_local(i)))
  ihead = b.block()
  ibody = b.block()
  iexit = b.block()
  b.goto(ihead)
  b.at(ihead)
  c2 = lw.tmp(mt_bool(), b.rv_cmp(mop_gt(), b.copy_local(j), b.c_i32(0)))
  b.branch(c2, ibody, iexit)
  b.at(ibody)
  jm = lw.tmp(mt_i32(), b.rv_bin(mop_sub(), b.copy_local(j), b.c_i32(1)))
  jml = mir_bare_copy(jm)
  prev = lw.block_elem(arr, aty, jml)
  pl = mir_bare_copy(prev)
  lw.bind_name(bl.params[0], want, et, b.copy_local(vl), bl.loc, true)
  lw.bind_name(bl.params[1], want, et, b.copy_local(pl), bl.loc, true)
  cmp = lw.block_value(bl, iexit, iexit)
  if lw.failed() {
    return zero
  }
  if lw.open_now() {
    lw.at(e.loc)
    moved = b.block()
    b.branch(cmp, moved, iexit)
    b.at(moved)
    if !do_copy {
      // A store of the sort in place checks the freeze (the comparator
      // may have started a task that reads it).
      lw.frozen_check(arr, mir_frozen_sort(), e.loc)
    }
    lw.block_store(arr, aty, j, b.copy_local(pl))
    b.assign(b.pl(j), b.rv_use(b.copy_local(jml)))
    b.goto(ihead)
  }
  b.at(iexit)
  lw.at(e.loc)
  if !do_copy {
    lw.frozen_check(arr, mir_frozen_sort(), e.loc)
  }
  lw.block_store(arr, aty, j, b.copy_local(vl))
  lw.block_step(i, head)
  b.at(exit)
  if do_copy {
    return b.copy_local(arr)
  }
  zero
}

// A walk of a hash or a set in place (`for k, v in h`, `for k in
// h.keys()`, `for v in h.values()`, `for v in s`, `h.each`, `s.each`):
// the hash once, then each live entry in its order (the order of
// insertion), its number from avant_hash_walk, its key and value loaded
// through the addresses the runtime gives, both bound (a hidden name the
// body never reads is not loaded), the body. The hash's count of changes
// is read before the first step and again after each (one load and a
// compare): a step that only deleted the visited entry goes on, a key
// added (the walk would miss it) or another key deleted traps
// (walk_changed_check). Assigning an existing key's value is no change.
pub fn (lw: MirLower) hash_each(e: Expr, recv: Expr, ht: Ty, bl: Block): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  hty = lw.ety(recv)
  kt = ty_int()
  if k0 = ht.key {
    kt = k0
  }
  vt = ty_int()
  if v0 = ht.val {
    vt = v0
  }
  kty = lw.ty_at(kt, e.loc, "a hash key")
  vty = lw.ty_at(vt, e.loc, "a hash value")
  if lw.failed() {
    return zero
  }
  h = lw.block_recv(recv, hty)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  c0 = lw.hash_changes(h)
  n = b.temp(mt_i32())
  b.assign(b.pl(n), b.rv_use(b.c_i32(0)))
  ent = b.temp(mt_i32())
  head = b.block()
  body = b.block()
  step = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  ops: Array(MOperand) = []
  ops.push(b.copy_local(h))
  ops.push(b.copy_local(n))
  b.call(ent, "avant_hash_walk", ops)
  done = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(ent), b.c_i32(0)))
  b.branch(done, exit, body)
  b.at(body)
  b.assign(b.pl(n), b.rv_bin(mop_add(), b.copy_local(ent), b.c_i32(1)))
  if !str_starts(bl.params[0], "__for") {
    kv = lw.walk_load(h, ent, "avant_hash_walk_key", kty)
    lw.bind_name(bl.params[0], kt, kty, kv, bl.loc, true)
  }
  // A Set's walk binds the element only (its Bool is nobody's).
  if bl.params.size > 1 && !str_starts(bl.params[1], "__for") {
    lw.at(e.loc)
    vv = lw.walk_load(h, ent, "avant_hash_walk_val", vty)
    lw.bind_name(bl.params[1], vt, vty, vv, bl.loc, true)
  }
  lw.walk_body(bl, step, exit)
  lw.goto_if_open(step, e.loc)
  b.at(step)
  lw.at(e.loc)
  what = 0
  if bl.params.size == 1 {
    what = 1
  }
  lw.walk_changed_check(h, c0, ent, what, e.loc)
  b.goto(head)
  b.at(exit)
  zero
}

// `h.delete_if((k, v) { ... })`, `s.delete_if((v) { ... })`: the walk in
// place, each entry bound as in hash_each, the predicate, and the
// visited entry deleted by its number when it holds
// (avant_hash_walk_delete, which first refuses a frozen hash); a change
// the predicate made to the hash is checked as a walk's step is, and the
// walk's own deletion is no change it reports.
pub fn (lw: MirLower) hash_delete_if(e: Expr, recv: Expr, ht: Ty, bl: Block): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  hty = lw.ety(recv)
  kt = ty_int()
  if k0 = ht.key {
    kt = k0
  }
  vt = ty_int()
  if v0 = ht.val {
    vt = v0
  }
  kty = lw.ty_at(kt, e.loc, "a hash key")
  vty = lw.ty_at(vt, e.loc, "a hash value")
  if lw.failed() {
    return zero
  }
  h = lw.block_recv(recv, hty)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  first: Array(MOperand) = []
  first.push(b.copy_local(h))
  first.push(b.c_i32(-1))
  b.call(-1, "avant_hash_walk_delete", first)
  c0 = lw.hash_changes(h)
  n = b.temp(mt_i32())
  b.assign(b.pl(n), b.rv_use(b.c_i32(0)))
  ent = b.temp(mt_i32())
  head = b.block()
  body = b.block()
  del = b.block()
  keep = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  ops: Array(MOperand) = []
  ops.push(b.copy_local(h))
  ops.push(b.copy_local(n))
  b.call(ent, "avant_hash_walk", ops)
  done = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(ent), b.c_i32(0)))
  b.branch(done, exit, body)
  b.at(body)
  b.assign(b.pl(n), b.rv_bin(mop_add(), b.copy_local(ent), b.c_i32(1)))
  kv = lw.walk_load(h, ent, "avant_hash_walk_key", kty)
  lw.bind_name(bl.params[0], kt, kty, kv, bl.loc, true)
  if bl.params.size > 1 {
    lw.at(e.loc)
    vv = lw.walk_load(h, ent, "avant_hash_walk_val", vty)
    lw.bind_name(bl.params[1], vt, vty, vv, bl.loc, true)
  }
  p = lw.verb_value(bl, ty_bool(), mt_bool(), keep, exit)
  if lw.failed() {
    return zero
  }
  if lw.open_now() {
    lw.at(e.loc)
    b.branch(p, del, keep)
  }
  what = 0
  if bl.params.size == 1 {
    what = 1
  }
  b.at(del)
  lw.at(e.loc)
  lw.walk_changed_check(h, c0, ent, what, e.loc)
  dops: Array(MOperand) = []
  dops.push(b.copy_local(h))
  dops.push(b.copy_local(ent))
  b.call(-1, "avant_hash_walk_delete", dops)
  c1 = lw.hash_changes(h)
  b.assign(b.pl(c0), b.rv_use(b.copy_local(c1)))
  b.goto(head)
  b.at(keep)
  lw.at(e.loc)
  lw.walk_changed_check(h, c0, ent, what, e.loc)
  b.goto(head)
  b.at(exit)
  zero
}

// The key or the value of entry _ent of the hash in _h, loaded with its
// type through the address the runtime gives (`avant_hash_walk_key` or
// `_val`), before anything can collect.
pub fn (lw: MirLower) walk_load(h: Int, ent: Int, f: String, ty: Int): MOperand {
  b = lw.lw_b
  ops: Array(MOperand) = []
  ops.push(b.copy_local(h))
  ops.push(b.copy_local(ent))
  p = lw.call_to(mt_ptr(), f, ops)
  lw.hash_load(lw.hash_slot(p, ty), ty)
}

// After a step of the walk of the hash in _h: its count of changes read
// again and compared with _c0; when it moved, avant_hash_walk_ok says
// whether the only change was the deletion of the visited entry _ent
// (then the walk goes on from the new count) or which change it was, and
// the walk traps naming it (what: 0 a Hash, 1 a Set; 2 is added for a
// deletion of another key).
pub fn (lw: MirLower) walk_changed_check(h: Int, c0: Int, ent: Int, what: Int, loc: Location) {
  b = lw.lw_b
  c = lw.hash_changes(h)
  moved = lw.tmp(mt_bool(), b.rv_cmp(mop_ne(), b.copy_local(c), b.copy_local(c0)))
  cold = b.block()
  join = b.block()
  b.branch(moved, cold, join)
  b.at(cold)
  ops: Array(MOperand) = []
  ops.push(b.copy_local(h))
  ops.push(b.copy_local(c0))
  ops.push(b.copy_local(ent))
  r = lw.call_to(mt_i32(), "avant_hash_walk_ok", ops)
  bad = lw.tmp(mt_bool(), b.rv_cmp(mop_ne(), r, b.c_i32(1)))
  ok = lw.trap_open(bad, true)
  w = lw.tmp(mt_i32(), b.rv_bin(mop_add(), r, b.c_i32(what)))
  lw.trap_close(ok, "avant_trap_walk", lw.one(w), loc)
  b.assign(b.pl(c0), b.rv_use(b.copy_local(c)))
  b.goto(join)
  b.at(join)
}

// The count of changes of the hash in _h (AvantHash.changes, field 9 of
// %Hash), into a new local.
pub fn (lw: MirLower) hash_changes(h: Int): Int {
  b = lw.lw_b
  a = b.temp(mt_u32())
  b.assign(b.pl(a), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), 9))))
  a
}

// ---- lambdas in parentheses inlined as loops

// A builtin's lambda written in parentheses (`xs.each((x) { ... })`,
// Block.paren) is lowered in place, as the block in pipes it replaces;
// when a `return` in it ends a run of its body (Block.returns), that
// `return` goes on at end, its value into slot (-1: none, a walk's body),
// after the pins opened inside the body are closed (lower_stmt.av
// lower_return; lam_return).
pub fn (lw: MirLower) lam_open(end: Int, slot: Int, want: Ty) {
  lw.lw_lam_ends.push(end)
  lw.lw_lam_slots.push(slot)
  lw.lw_lam_tys.push(want)
  lw.lw_lam_pins.push(lw.lw_ffi.pins.size)
}

pub fn (lw: MirLower) lam_close {
  lw.lw_lam_ends.pop()
  lw.lw_lam_slots.pop()
  lw.lw_lam_tys.pop()
  lw.lw_lam_pins.pop()
}

pub fn (lw: MirLower) lam_return(st: Stmt) {
  b = lw.lw_b
  top = lw.lw_lam_ends.size - 1
  slot = lw.lw_lam_slots[top]
  if e = st.expr {
    if slot >= 0 {
      v = lw.lower_coerced(e, b.func.locals[slot].ty, lw.lw_lam_tys[top])
      if lw.failed() {
        return
      }
      lw.at(st.loc)
      b.assign(b.pl(slot), b.rv_use(v))
    } else {
      lw.lower_expr(e)
      if lw.failed() {
        return
      }
    }
  }
  lw.at(st.loc)
  i = lw.lw_ffi.pins.size - 1
  while i >= lw.lw_lam_pins[top] {
    lw.unpin(lw.lw_ffi.pins[i])
    i -= 1
  }
  b.goto(lw.lw_lam_ends[top])
}

// The body of an inlined walk (`each`) with `break` to exit and `next`
// to cont; a lambda whose `return` ends its run goes on at cont.
pub fn (lw: MirLower) walk_body(bl: Block, cont: Int, exit: Int) {
  if bl.paren && bl.returns {
    lw.lam_open(cont, -1, ty_void())
    lw.block_body(bl.body, cont, exit)
    lw.lam_close()
    return
  }
  lw.block_body(bl.body, cont, exit)
}

// The value of such a lambda's body (`any`, a comparator, the building
// lambda of `Array(T).new`, `with`, `parallel`): every statement, the
// last one's value into a slot as each `return`'s, then the slot where
// the runs join; nil for a body without a value (want Void).
pub fn (lw: MirLower) lam_value(bl: Block, want: Ty, mty: Int, cont: Int, exit: Int): MOperand? {
  b = lw.lw_b
  slot = -1
  if !want.is_void() {
    slot = b.temp(mty)
  }
  end = b.block()
  lw.lam_open(end, slot, want)
  if bl.body.size > 0 {
    head: Array(Stmt) = []
    j = 0
    while j < bl.body.size - 1 {
      head.push(bl.body[j])
      j += 1
    }
    lw.lam_stmts(head, cont, exit)
    if !lw.failed() && lw.open_now() {
      last = bl.body[bl.body.size - 1]
      if x = last.expr, last.kind == st_expr() && slot >= 0 {
        v = lw.lower_coerced(x, mty, want)
        if !lw.failed() {
          lw.at(x.loc)
          b.assign(b.pl(slot), b.rv_use(v))
        }
      } else {
        tail: Array(Stmt) = [last]
        lw.lam_stmts(tail, cont, exit)
      }
    }
  }
  lw.lam_close()
  if lw.failed() {
    return nil
  }
  lw.goto_if_open(end, bl.loc)
  b.at(end)
  if slot >= 0 {
    return b.copy_local(slot)
  }
  nil
}

// Statements of such a body: in a walk, with its loop's targets (cont
// below zero: a body run in place once, `with`, a task's).
pub fn (lw: MirLower) lam_stmts(stmts: Array(Stmt), cont: Int, exit: Int) {
  if cont < 0 {
    lw.lower_stmts(stmts)
    return
  }
  lw.block_body(stmts, cont, exit)
}

// The value of a lambda an array verb inlines (find, index_of, min_by,
// max_by, delete_if), of type want: the lambda's own result slot when a
// `return` in it ends its run, else its last expression.
pub fn (lw: MirLower) verb_value(bl: Block, want: Ty, mty: Int, cont: Int, exit: Int): MOperand {
  b = lw.lw_b
  if bl.returns {
    if v = lw.lam_value(bl, want, mty, cont, exit) {
      return v
    }
    return b.c_i32(0)
  }
  head: Array(Stmt) = []
  i = 0
  while i < bl.body.size - 1 {
    head.push(bl.body[i])
    i += 1
  }
  lw.block_body(head, cont, exit)
  if lw.failed() || !lw.open_now() || bl.body.size == 0 {
    return b.c_i32(0)
  }
  last = bl.body[bl.body.size - 1]
  if x = last.expr {
    v = lw.lower_coerced(x, mty, want)
    if lw.failed() {
      return b.c_i32(0)
    }
    lw.at(x.loc)
    return lw.tmp(mty, b.rv_use(v))
  }
  lw.refuse(last.loc, "a lambda that does not end with a value")
  b.c_i32(0)
}

// d = nil, for the optional type t (MIR type wty).
pub fn (lw: MirLower) assign_nil(d: Int, t: Ty, wty: Int) {
  b = lw.lw_b
  if r = mir_opt_word(t) {
    b.assign(b.pl(d), b.rv_use(lw.opt_nil(wty)))
  } else {
    b.assign(b.pl(d), b.rv_union_nil(b.types.layout_of(wty), t.tag_of(ty_nil())))
  }
}

// `xs.find((x) { p })` and `xs.index_of((x) { p })`: a loop over the
// elements as `any`'s, which stops at the first element p holds for;
// the element (find) or its position (index_of), nil when none does.
pub fn (lw: MirLower) arr_find(e: Expr, recv: Expr, bl: Block, want_index: Bool): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  t = ty_int()
  if et0 = e.ty {
    t = et0
  } else {
    lw.refuse(e.loc, "an untyped find")
    return zero
  }
  wty = lw.ty_at(t, e.loc, "a value")
  aty = lw.ety(recv)
  if lw.failed() {
    return zero
  }
  h = lw.block_recv(recv, aty)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  d = b.temp(wty)
  lw.assign_nil(d, t, wty)
  i = b.temp(mt_i32())
  b.assign(b.pl(i), b.rv_use(b.c_i32(0)))
  head = b.block()
  body = b.block()
  step = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  lw.block_test(h, i, body, exit)
  b.at(body)
  lw.block_param(bl, recv, h, aty, i)
  p = lw.verb_value(bl, ty_bool(), mt_bool(), step, exit)
  if lw.failed() {
    return zero
  }
  if lw.open_now() {
    lw.at(e.loc)
    hit = b.block()
    b.branch(p, hit, step)
    b.at(hit)
    if want_index {
      ix = lw.tmp(mt_int(), b.rv_cast(b.copy_local(i), mt_int()))
      b.assign(b.pl(d), b.rv_use(lw.coerce(ix, ty_int(), t, e.loc)))
    } else {
      v = lw.block_elem(h, aty, i)
      b.assign(b.pl(d), b.rv_use(lw.coerce(v, lw.elem_ty_of(recv), t, e.loc)))
    }
    b.goto(exit)
  }
  b.at(step)
  lw.at(e.loc)
  lw.block_step(i, head)
  b.at(exit)
  b.copy_local(d)
}

// `xs.min_by((x) { key })`, `xs.max_by(...)`: one pass, the key computed
// once per element; the first element of the smallest (largest) key by
// <, nil for an empty array. The element is kept when taken, so a lambda
// that changes the array cannot make the result read past its end.
pub fn (lw: MirLower) arr_min_by(e: Expr, recv: Expr, bl: Block, is_max: Bool): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  t = ty_int()
  if et0 = e.ty {
    t = et0
  } else {
    lw.refuse(e.loc, "an untyped min_by")
    return zero
  }
  kt = ty_int()
  if k0 = bl.key_ty {
    kt = k0
  } else {
    lw.refuse(e.loc, "a min_by key without a type")
    return zero
  }
  wty = lw.ty_at(t, e.loc, "a value")
  kty = lw.ty_at(kt, e.loc, "a key")
  aty = lw.ety(recv)
  if lw.failed() {
    return zero
  }
  h = lw.block_recv(recv, aty)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  // The best element so far, as the result (nil until the first).
  d = b.temp(wty)
  lw.assign_nil(d, t, wty)
  best = b.temp(kty)
  // Written before the loop (the first element takes it): a number's
  // zero, or the empty string.
  if kt.is_string() || kt.is_bytes() {
    b.assign(b.pl(best), b.rv_use(b.str_const("")))
  } else if kt.is_float() {
    b.assign(b.pl(best), b.rv_use(b.c_f64(0, "0.0")))
  } else {
    b.assign(b.pl(best), b.rv_use(b.c_int(kty, 0)))
  }
  at = b.temp(mt_i32())
  b.assign(b.pl(at), b.rv_use(b.c_i32(-1)))
  i = b.temp(mt_i32())
  b.assign(b.pl(i), b.rv_use(b.c_i32(0)))
  head = b.block()
  body = b.block()
  step = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  lw.block_test(h, i, body, exit)
  b.at(body)
  lw.block_param(bl, recv, h, aty, i)
  k = lw.verb_value(bl, kt, kty, step, exit)
  if lw.failed() {
    return zero
  }
  if lw.open_now() {
    lw.at(e.loc)
    kh = lw.hold(k, kty)
    take = b.block()
    cmp = b.block()
    first = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(at), b.c_i32(0)))
    b.branch(first, take, cmp)
    b.at(cmp)
    lhs = b.copy_local(kh)
    rhs = b.copy_local(best)
    if is_max {
      lhs = b.copy_local(best)
      rhs = b.copy_local(kh)
    }
    better = b.c_bool(false)
    if kt.is_string() || kt.is_bytes() {
      args: Array(MOperand) = []
      args.push(lhs)
      args.push(rhs)
      q = lw.call_to(mt_i32(), "avant_str_cmp", args)
      better = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), q, b.c_i32(0)))
    } else {
      better = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), lhs, rhs))
    }
    b.branch(better, take, step)
    b.at(take)
    b.assign(b.pl(best), b.rv_use(b.copy_local(kh)))
    b.assign(b.pl(at), b.rv_use(b.copy_local(i)))
    v = lw.block_elem(h, aty, i)
    b.assign(b.pl(d), b.rv_use(lw.coerce(v, lw.elem_ty_of(recv), t, e.loc)))
    b.goto(step)
  }
  b.at(step)
  lw.at(e.loc)
  lw.block_step(i, head)
  b.at(exit)
  b.copy_local(d)
}

// `xs.delete_if((x) { p })`: one pass in place, each element p does not
// hold for moved down to the next kept position; the references past
// the new size cleared, then the size set.
pub fn (lw: MirLower) arr_delete_if(e: Expr, recv: Expr, bl: Block): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  aty = lw.ety(recv)
  if lw.failed() {
    return zero
  }
  h = lw.block_recv(recv, aty)
  if lw.failed() {
    return zero
  }
  lw.at(e.loc)
  lw.frozen_check(h, mir_frozen_delete_if(), e.loc)
  w = b.temp(mt_i32())
  b.assign(b.pl(w), b.rv_use(b.c_i32(0)))
  i = b.temp(mt_i32())
  b.assign(b.pl(i), b.rv_use(b.c_i32(0)))
  head = b.block()
  body = b.block()
  keep = b.block()
  step = b.block()
  exit = b.block()
  b.goto(head)
  b.at(head)
  lw.block_test(h, i, body, exit)
  b.at(body)
  lw.block_param(bl, recv, h, aty, i)
  p = lw.verb_value(bl, ty_bool(), mt_bool(), keep, exit)
  if lw.failed() {
    return zero
  }
  if lw.open_now() {
    lw.at(e.loc)
    b.branch(p, step, keep)
  }
  b.at(keep)
  lw.at(e.loc)
  v = lw.block_elem(h, aty, i)
  lw.block_store(h, aty, w, v)
  b.assign(b.pl(w), b.rv_bin(mop_add(), b.copy_local(w), b.c_i32(1)))
  b.goto(step)
  b.at(step)
  lw.at(e.loc)
  lw.block_step(i, head)
  b.at(exit)
  et = lw.elem_of(aty)
  if b.types.ref_carrying(et) {
    n = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), 1))))
    lo = lw.tmp(mt_int(), b.rv_cast(b.copy_local(w), mt_int()))
    hi = lw.tmp(mt_int(), b.rv_cast(n, mt_int()))
    four = lw.two(b.copy_local(h), lo)
    four.push(hi)
    four.push(lw.elem_size(aty))
    b.call(-1, "avant_array_zero_range", four)
  }
  b.assign(b.field(b.deref(b.pl(h)), 1), b.rv_use(b.copy_local(w)))
  zero
}
