// `avant __mir-selftest` (internal, D190): builds the MIR modules of the
// core tests with the builder, prints the 10.2 example, and runs the
// verifier on every case; tests/cases/test_mir.av checks the output.

import mir.types
import mir.runtime
import mir.ir
import mir.build
import mir.print
import mir.example

pub fn mir_selftest {
  m = mir_example()
  puts("== example print")
  puts(mir_print(m, true))
  puts("== end")
}
