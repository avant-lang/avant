// Symbols and receivers of functions and methods (Stage 28 W7a;
// stages/stage28/mir.md 8.2, W7a): plain functions, overloads, generic
// instances (monomorphic, D175: the checker clones each instance into the
// program with its own emit name, checker/match.av instantiate_function
// and instantiate_method; generic structs and classes arrive as their
// instance definitions, resolve.av instantiate_template), methods on any
// type including other modules' types, and operator methods. The
// lowering never re-resolves a call: it lowers what the checker chose
// (`Expr.resolved`, `Function.emit_name`). Named interfaces are bounds on
// generics only: they are checked and erased by the checker, so nothing
// of them reaches the MIR (2.9).
//
// A symbol is `av.<module>/<item>` (8.2): item = [owner "."] name, then
// `[targs]` for a generic instance (the checker's Function.inst_args),
// or `(params)` when the name is overloaded in its scope.

import location
import source
import token
import type
import ast
import typed_ir
import mir.types
import mir.ir
import mir.build
import mir.lower_ty
import mir.lower
import mir.lower_expr
import mir.lower_call
import mir.lower_agg
import mir.lower_union

// The `[targs]` part of fnn's symbol when it is a generic instance (the
// type arguments the checker substituted, Function.inst_args), else "".
pub fn (lw: MirLower) instance_suffix(fnn: Function): String {
  if fnn.inst_args.size == 0 {
    return ""
  }
  buf = buf_new()
  buf.push_str("[")
  j = 0
  while j < fnn.inst_args.size {
    if j > 0 {
      buf.push_str(",")
    }
    buf.push_str(mir_mty(fnn.inst_args[j]))
    j = j + 1
  }
  buf.push_str("]")
  buf.to_s
}

fn mir_params_text(params: Array(Ty)): String {
  buf = buf_new()
  buf.push_str("(")
  j = 0
  while j < params.size {
    if j > 0 {
      buf.push_str(",")
    }
    buf.push_str(mir_mty(params[j]))
    j = j + 1
  }
  buf.push_str(")")
  buf.to_s
}

// 8.2 for a plain function: `av.<module>/<name>`, then `[targs]` for a
// generic instance, or `(params)` when another plain function of the
// module (not an instance) has the same name; `main` of the root module
// keeps its C name (8.1).
pub fn (lw: MirLower) symbol_of(fnn: Function): String {
  if fnn.name == "main" && fnn.mod_name == lw.lw_prog.root_module {
    return "main"
  }
  base = "av.${mir_module_part(fnn.mod_name)}/${fnn.name}"
  suffix = lw.instance_suffix(fnn)
  if suffix.size > 0 {
    return "${base}${suffix}"
  }
  n = 0
  i = 0
  while i < lw.lw_all.size {
    o = lw.lw_all[i]
    if !o.generic && !fn_is_method(o) && o.name == fnn.name && o.mod_name == fnn.mod_name && lw.instance_suffix(o).size == 0 {
      n = n + 1
    }
    i = i + 1
  }
  if n <= 1 {
    return base
  }
  if sig = lw.lw_syms.find_fn(fnn.emit_name) {
    return "${base}${mir_params_text(sig.params)}"
  }
  base
}

// The owner type of a method: a struct or class of any module (decl.av
// collect_methods: the owner's module, then the bare name), else the
// resolved receiver type (`fn (s: String) shout`, a method on a type that
// is not an aggregate).
pub fn (lw: MirLower) method_owner(fnn: Function): Ty? {
  if o = lw.owner_ty(fnn) {
    return o
  }
  if r = fnn.receiver {
    return lw.lw_syms.resolver.resolve(r.type)
  }
  nil
}

// 8.2 for a method: `av.<module>/<Owner>.<name>` (the owner without its
// module when it is the defining module's, else its mty: a method on
// another module's type), then `[targs]` for a generic method instance,
// or `(params)` when the owner has several non-instance methods of the
// name (overloads).
pub fn (lw: MirLower) method_symbol(fnn: Function): String {
  if sig = lw.lw_syms.find_method_emit(fnn.emit_name) {
    if ot = lw.method_owner(fnn) {
      base = "av.${mir_module_part(fnn.mod_name)}/${lw.owner_text(ot, fnn.mod_name)}.${fnn.name}"
      suffix = lw.instance_suffix(fnn)
      if suffix.size > 0 {
        return "${base}${suffix}"
      }
      n = 0
      i = 0
      while i < lw.lw_syms.methods.size {
        o = lw.lw_syms.methods[i]
        if !o.node.generic && o.owner == sig.owner && o.node.owner_mod == sig.node.owner_mod && o.name == sig.name {
          onode = o.node
          if lw.instance_suffix(onode).size == 0 {
            n = n + 1
          }
        }
        i = i + 1
      }
      if n > 1 {
        return "${base}${mir_params_text(sig.params)}"
      }
      return base
    }
  }
  lw.refuse(fnn.loc, "method ${fnn.name} (no checked signature)")
  ""
}

// The receiver's MIR type: `ref %C` for a class, `addr %S` for a struct
// (audit 2.4: the address of the receiver's storage), the value itself
// for any other type (the old back end's emit_ptr_method_func).
pub fn (lw: MirLower) method_receiver(fnn: Function): Int {
  if ot = lw.method_owner(fnn) {
    if ot.is_struct {
      t = lw.value_agg_ty(ot, fnn.loc)
      if t < 0 {
        return -1
      }
      return lw.lw_m.types.addr_of(t)
    }
    return lw.ty_at(ot, fnn.loc, "a receiver")
  }
  lw.refuse(fnn.loc, "method ${fnn.name} (no owner)")
  -1
}

// The checked parameter types of the program function or method a call
// resolved to (a constructor's are its initialize's), for converting the
// arguments; empty when unknown.
pub fn (lw: MirLower) callee_params(resolved: String, e: Expr): Array(Ty) {
  if fs = lw.lw_syms.find_fn(resolved) {
    return fs.params
  }
  if ms = lw.lw_syms.find_method_emit(resolved) {
    return ms.params
  }
  if t = e.ty {
    if t.is_class || t.is_union {
      i = 0
      while i < lw.lw_syms.methods.size {
        o = lw.lw_syms.methods[i]
        if o.name == "initialize" && !o.node.generic {
          onode2 = o.node
          if ot = lw.owner_ty(onode2) {
            want = t
            if t.is_union {
              want = ty_without_nil(t)
            }
            if ot.same_as(want) {
              return o.params
            }
          }
        }
        i = i + 1
      }
    }
  }
  none: Array(Ty) = []
  none
}

// An operator method `l op r` (the old back end's emit_binary with Expr.resolved,
// emit_method_invoke): the right operand (the argument) first, then the
// left (the receiver), then the call of `Owner.op`.
pub fn (lw: MirLower) lower_op_method(e: Expr): MOperand {
  if l = e.left {
    if r = e.right {
      if lt = l.ty {
        if sym = lw.lw_fn_syms.get(e.resolved) {
          args: Array(Expr) = []
          args.push(r)
          return lw.lower_method_call(e, l, lt, sym, args)
        }
      }
    }
  }
  lw.refuse(e.loc, "the operator method ${e.resolved}")
  lw.lw_b.c_i32(0)
}
