// The lowering of the concurrency constructs (Stage 28 W8b;
// stages/stage28/mir.md W8b, audit 6): `spawn { }` and `JoinHandle`,
// `.parallel { |x| }` on arrays, `Mutex.with { |x| }`, and the gate
// builtins (`avant_gate_*`, which `Channel(T)` is written in), with the
// old back end's representations and runtime calls (calls.av:451-1116).
//
// A spawn copies its captures by value (D35) into a heap record
// `%spawn_cap(<thunk>)`, which `avant_spawn` roots from the task until
// the thunk returns (R1, Stage 28 W16b: no pin; before, it was pinned
// here and unpinned by `avant_join`); its thunk `<enclosing>#spawnN(ref) -> i32`
// has its own frame and copies each capture into a local (or a fresh box
// when a lambda in the block captures it). A `.parallel` allocates the
// result array, a context record `%par_cap(<thunk>)` holding the input,
// the output, and the captures (pinned), and calls `avant_parallel_for`;
// its thunk `<enclosing>#parN(i32, ref)` reads element i (through
// `avant_array_get_ptr` for a reference element, else from the buffer),
// runs the block, and stores the result (`avant_array_set_ptr`, else
// into the buffer behind its barrier). `Mutex.with` locks the mutex's
// gate, lowers the block in place with its parameter naming the cell,
// and unlocks. Capture-record type ids are noted by the pre-walk at the
// old points (decl.av collect_expr), so the type maps equal the old
// back end's. A program that spawns or uses `.parallel` makes the
// module shared (section 7).

import location
import source
import token
import type
import ast
import typed_ir
import mir.types
import mir.ir
import mir.build
import mir.lower_ty
import mir.lower
import mir.lower_expr
import mir.lower_stmt
import mir.lower_agg
import mir.lower_arr
import mir.lower_fn
import mir.lower_cov

// ---- the pre-walk (decl.av collect_expr: a spawn's record is noted
// before its arguments and block, a .parallel's after its receiver)

// The next `#spawnN` or `#parN` symbol inside encl (8.2).
pub fn (lw: MirLower) task_symbol(encl: String, kind: String): String {
  key = "${encl}#${kind}"
  n = 1
  if got = lw.lw_task.n.get(key) {
    n = got + 1
  }
  lw.lw_task.n[key] = n
  "${encl}#${kind}${n}"
}

// A spawn block: its symbol and its record's type id (only when the
// record holds a reference word, as the old note_words).
pub fn (lw: MirLower) prewalk_spawn(e: Expr, encl: String) {
  lw.lw_m.shared = true
  sym = lw.task_symbol(encl, "spawn")
  e.spawn_thunk = sym
  lw.lw_task.index[sym] = lw.lw_task.count
  lw.lw_task.count = lw.lw_task.count + 1
  if e.cap_names.size == 0 {
    return
  }
  l = lw.task_layout(e, sym, false)
  if l >= 0 && lw.lw_m.types.layouts[l].ref_words.size > 0 {
    dummy = lw.lw_b.type_id(l)
  }
}

// A .parallel: its symbol and its context's type id (it always holds
// the two arrays).
pub fn (lw: MirLower) prewalk_par(e: Expr, encl: String) {
  lw.lw_m.shared = true
  sym = lw.task_symbol(encl, "par")
  e.spawn_thunk = sym
  lw.lw_task.index[sym] = lw.lw_task.count
  lw.lw_task.count = lw.lw_task.count + 1
  l = lw.task_layout(e, sym, true)
  if l >= 0 {
    dummy = lw.lw_b.type_id(l)
  }
}

// The capture record of a spawn (`%spawn_cap(<thunk>)`: the captures in
// order) or the context of a .parallel (`%par_cap(<thunk>)`: the input
// array, the result array, then the captures): calls.av
// emit_spawn_cap_layout, emit_parallel_layout.
pub fn (lw: MirLower) task_layout(e: Expr, sym: String, par: Bool): Int {
  name = "spawn_cap(${sym})"
  if par {
    name = "par_cap(${sym})"
  }
  known = lw.lw_m.types.layout_named(name)
  if known >= 0 {
    return known
  }
  fields: Array(Int) = []
  names: Array(String) = []
  if par {
    if recv = e.receiver {
      if rt = recv.ty {
        fields.push(lw.field_mty(rt, e.loc))
        names.push("in")
      }
    }
    if t = e.ty {
      fields.push(lw.field_mty(t, e.loc))
      names.push("out")
    }
  }
  i = 0
  while i < e.cap_names.size {
    fields.push(lw.field_mty(e.cap_tys[i], e.loc))
    names.push(e.cap_names[i])
    i = i + 1
  }
  if lw.failed {
    return -1
  }
  lw.lw_b.note_layout(name, mlk_record(), fields, names)
}

// ---- spawn and join

// The value of a captured name in the spawning frame (a local, a boxed
// variable, or a capture of the enclosing thunk): emit_box_lvalue,
// emit_cap_lvalue, or the local.
pub fn (lw: MirLower) capture_value(name: String, t: Ty, loc: Location): MOperand {
  ne = Expr.new(ex_name(), loc)
  ne.ident = name
  ne.ty = t
  lw.lower_name(ne)
}

// Stores the captures into the record in _c from field base on
// (calls.av emit_spawn, emit_parallel), each behind the record's barrier
// when it is reference-carrying (D187).
pub fn (lw: MirLower) store_captures(e: Expr, c: Int, base: Int) {
  b = lw.lw_b
  ts = b.types
  l = ts.layout_of(b.func.locals[c].ty)
  i = 0
  while i < e.cap_names.size && !lw.failed {
    v = lw.capture_value(e.cap_names[i], e.cap_tys[i], e.loc)
    if lw.failed {
      return
    }
    lw.at(e.loc)
    lw.store_place(b.field(b.deref(b.pl(c)), base + i), ts.layouts[l].fields[base + i], v)
    i = i + 1
  }
}

// A new record of layout l in a fresh local: `avant_alloc(size, id)`.
pub fn (lw: MirLower) new_record(l: Int, tid: Int, loc: Location): Int {
  b = lw.lw_b
  lw.at(loc)
  c = b.temp(b.types.ref_to(l))
  dummy = b.call(c, "avant_alloc", lw.two(b.c_u64(b.types.layouts[l].size.to_i64), b.c_u32(tid)))
  c
}

// The same, then `avant_pin` (a `.parallel` context: workers read it
// while this thread may collect).
pub fn (lw: MirLower) pinned_record(l: Int, tid: Int, loc: Location): Int {
  c = lw.new_record(l, tid, loc)
  dummy2 = lw.lw_b.call(-1, "avant_pin", lw.one(lw.lw_b.copy_local(c)))
  c
}

// `spawn { ... }` (calls.av emit_spawn): the record (or null), then
// `avant_spawn(thunk, record)`, whose result is the JoinHandle.
pub fn (lw: MirLower) lower_spawn(e: Expr): MOperand {
  b = lw.lw_b
  sym = e.spawn_thunk
  if !str_starts_mir(sym, "av.") {
    lw.refuse(e.loc, "a spawn the pre-walk did not name (internal)")
    return b.c_i32(0)
  }
  idx = 0
  if got = lw.lw_task.index.get(sym) {
    idx = got
  }
  lw.lw_task.pending.push(MirTask.new(e, sym, false, idx))
  arg = b.c_null(mt_ref())
  if e.cap_names.size > 0 {
    l = lw.task_layout(e, sym, false)
    if lw.failed {
      return b.c_i32(0)
    }
    tid = 0
    if b.types.layouts[l].ref_words.size > 0 {
      tid = b.type_id(l)
    }
    c = lw.new_record(l, tid, e.loc)
    lw.store_captures(e, c, 0)
    if lw.failed {
      return b.c_i32(0)
    }
    arg = b.copy_local(c)
  }
  lw.at(e.loc)
  h = b.temp(mt_ref())
  dummy = b.call(h, "avant_spawn", lw.two(b.c_fn(sym), arg))
  b.copy_local(h)
}

// `h.join` (calls.av emit_join): `avant_join(h)` waits, frees the task,
// and returns the thunk's Int.
pub fn (lw: MirLower) lower_join(e: Expr, recv: Expr): MOperand {
  b = lw.lw_b
  h = lw.lower_expr(recv)
  if lw.failed {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  lw.call_to(mt_i32(), "avant_join", lw.one(h))
}

// ---- .parallel

// `xs.parallel { |x| ... }` (calls.av emit_parallel): the receiver once,
// its size n, the result array (a zeroed buffer of n elements and its
// header, as Array(T).new(n)), the pinned context with the input, the
// result, and the captures, then `avant_parallel_for(n, thunk, ctx)`.
// The context is unpinned when every index has run (the old back end
// never unpins it, a leak per call: W8b, D196).
pub fn (lw: MirLower) lower_parallel(e: Expr, recv: Expr): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  sym = e.spawn_thunk
  if !str_starts_mir(sym, "av.") {
    lw.refuse(e.loc, "a .parallel the pre-walk did not name (internal)")
    return zero
  }
  idx = 0
  if got = lw.lw_task.index.get(sym) {
    idx = got
  }
  lw.lw_task.pending.push(MirTask.new(e, sym, true, idx))
  aty = lw.ety(recv)
  oty = lw.ety(e)
  if lw.failed {
    return zero
  }
  a0 = lw.lower_expr(recv)
  if lw.failed {
    return zero
  }
  lw.at(e.loc)
  a = b.temp(aty)
  dummy = b.assign(b.pl(a), b.rv_use(a0))
  n = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.deref(b.pl(a)), 1))))
  n64 = lw.tmp(mt_u64(), b.rv_cast(lw.dup(n), mt_u64()))
  bytes = lw.tmp(mt_u64(), b.rv_bin(mop_mul(), n64, lw.elem_size(oty)))
  d = b.temp(b.types.ref_to(lw.elems_of(oty)))
  dummy2 = b.call(d, "avant_alloc", lw.two(bytes, lw.buf_tid(oty)))
  out = lw.tmp(oty, b.rv_use(lw.array_header(oty, d, lw.dup(n))))
  l = lw.task_layout(e, sym, true)
  if lw.failed {
    return zero
  }
  c = lw.pinned_record(l, b.type_id(l), e.loc)
  ts = b.types
  lw.store_place(b.field(b.deref(b.pl(c)), 0), ts.layouts[l].fields[0], b.copy_local(a))
  lw.store_place(b.field(b.deref(b.pl(c)), 1), ts.layouts[l].fields[1], lw.dup(out))
  lw.store_captures(e, c, 2)
  if lw.failed {
    return zero
  }
  lw.at(e.loc)
  dummy3 = b.call(-1, "avant_parallel_for", lw.three(lw.dup(n), b.c_fn(sym), b.copy_local(c)))
  dummy4 = b.call(-1, "avant_unpin", lw.one(b.copy_local(c)))
  out
}

// ---- the thunks

// Lowers the queued thunks in pre-walk order, with the lambdas each one
// makes; a thunk may queue further thunks (a spawn inside a spawn).
pub fn (lw: MirLower) lower_pending_tasks {
  lw.lower_pending_lambdas
  while lw.lw_task.done < lw.lw_task.pending.size && !lw.failed {
    // The queue is in lowering order; the old back end emits in pre-walk
    // order: take the lowest index not lowered yet.
    best = -1
    i = lw.lw_task.done
    while i < lw.lw_task.pending.size {
      if best < 0 || lw.lw_task.pending[i].index < lw.lw_task.pending[best].index {
        best = i
      }
      i = i + 1
    }
    t = lw.lw_task.pending[best]
    lw.lw_task.pending[best] = lw.lw_task.pending[lw.lw_task.done]
    lw.lw_task.pending[lw.lw_task.done] = t
    lw.lw_task.done = lw.lw_task.done + 1
    lw.lw_cov.rank = mir_cov_task_rank() + t.index
    if t.par {
      lw.lower_par_thunk(t)
    } else {
      lw.lower_spawn_thunk(t)
    }
    lw.lower_pending_lambdas
  }
}

// The names a lambda in the block captures (the outermost lambdas'
// captures hold every name of this frame a nested lambda captures), with
// their types: they are boxed in the thunk's frame (calls.av
// collect_spawn_box_stmts boxes the captures among them; a local of the
// block a lambda captures is boxed too, which the old back end cannot
// compile).
pub fn (lw: MirLower) task_boxes(stmts: Array(Stmt), names: Array(String), tys: Array(Ty)) {
  i = 0
  while i < stmts.size {
    st = stmts[i]
    lw.task_boxes_opt(st.cond, names, tys)
    lw.task_boxes_opt(st.target, names, tys)
    lw.task_boxes_opt(st.value, names, tys)
    lw.task_boxes_opt(st.expr, names, tys)
    lw.task_boxes(st.pre, names, tys)
    lw.task_boxes(st.then_body, names, tys)
    lw.task_boxes(st.else_body, names, tys)
    lw.task_boxes(st.body, names, tys)
    i = i + 1
  }
}

pub fn (lw: MirLower) task_boxes_opt(e: Expr?, names: Array(String), tys: Array(Ty)) {
  if x = e {
    lw.task_boxes_expr(x, names, tys)
  }
}

pub fn (lw: MirLower) task_boxes_expr(e: Expr, names: Array(String), tys: Array(Ty)) {
  if e.kind == ex_lambda() {
    i = 0
    while i < e.cap_names.size {
      if mir_name_index(names, e.cap_names[i]) < 0 {
        names.push(e.cap_names[i])
        tys.push(e.cap_tys[i])
      }
      i = i + 1
    }
    return
  }
  lw.task_boxes_opt(e.inner, names, tys)
  lw.task_boxes_opt(e.receiver, names, tys)
  lw.task_boxes_opt(e.left, names, tys)
  lw.task_boxes_opt(e.right, names, tys)
  lw.task_boxes_opt(e.object, names, tys)
  lw.task_boxes_opt(e.cond, names, tys)
  lw.task_boxes_opt(e.size_expr, names, tys)
  i = 0
  while i < e.args.size {
    lw.task_boxes_expr(e.args[i], names, tys)
    i = i + 1
  }
  i = 0
  while i < e.elems.size {
    lw.task_boxes_expr(e.elems[i], names, tys)
    i = i + 1
  }
  i = 0
  while i < e.field_exprs.size {
    lw.task_boxes_expr(e.field_exprs[i], names, tys)
    i = i + 1
  }
  i = 0
  while i < e.parts.size {
    lw.task_boxes_opt(e.parts[i].expr, names, tys)
    i = i + 1
  }
  i = 0
  while i < e.cases.size {
    lw.task_boxes(e.cases[i].body, names, tys)
    i = i + 1
  }
  lw.task_boxes(e.else_body, names, tys)
  if bl = e.block {
    lw.task_boxes(bl.body, names, tys)
  }
}

// The start of a thunk: its own frame state, the boxed names zeroed
// (V9), and the record parameter cast to its layout.
pub fn (lw: MirLower) begin_task(t: MirTask, ps: Array(Int), ret: Int, rec: Int, l: Int, bl: Block): Int {
  b = lw.lw_b
  e = t.expr
  lw.begin_at(e.loc)
  dummy = b.begin_fn(t.sym, b.sig(ps, ret, false), lw.mloc(e.loc), "task")
  lw.lw_cl.base = t.sym
  lw.lw_main = false
  lw.lw_ret = mt_void()
  lw.lw_ret_ty = ty_void()
  names: Array(String) = []
  tys: Array(Ty) = []
  lw.task_boxes(bl.body, names, tys)
  lw.lw_cl.boxed = names
  lw.at(e.loc)
  i = 0
  while i < names.size && !lw.failed {
    k = lw.box_local_of(names[i], tys[i], e.loc)
    dummy2 = b.assign(b.pl(k), b.rv_zero)
    i = i + 1
  }
  c = -1
  if l >= 0 {
    c = b.local(b.types.ref_to(l), "cap")
    dummy3 = b.assign(b.pl(c), b.rv_cast(b.copy_local(rec), b.types.ref_to(l)))
  }
  c
}

// Each capture from the record (from field base on) into its local, or
// into a fresh box when a lambda in the block captures it.
pub fn (lw: MirLower) load_captures(e: Expr, c: Int, l: Int, base: Int) {
  b = lw.lw_b
  i = 0
  while i < e.cap_names.size && !lw.failed {
    ft = b.types.layouts[l].fields[base + i]
    lw.at(e.loc)
    v = lw.tmp(ft, b.rv_use(b.copy(b.field(b.deref(b.pl(c)), base + i))))
    ty = lw.ty_at(e.cap_tys[i], e.loc, "a capture")
    if lw.failed {
      return
    }
    lw.bind_name(e.cap_names[i], e.cap_tys[i], ty, v, e.loc, false)
    i = i + 1
  }
}

// Every statement of a value block but the last (each counted under
// coverage), then the last one's expression, converted to want; nil
// when the block ended earlier (calls.av emit_spawn_thunk,
// emit_parallel_thunk, emit_mutex_with: the last value is not a counted
// statement).
pub fn (lw: MirLower) task_value(bl: Block, want: Ty): MOperand? {
  if bl.body.size == 0 {
    lw.refuse(bl.loc, "an empty block")
    return nil
  }
  i = 0
  while i < bl.body.size - 1 {
    if lw.failed || !lw.open_now {
      return nil
    }
    lw.lower_stmt(bl.body[i])
    i = i + 1
  }
  if lw.failed || !lw.open_now {
    return nil
  }
  last = bl.body[bl.body.size - 1]
  if x = last.expr {
    if last.kind == st_expr() {
      v = lw.lower_expr(x)
      if lw.failed {
        return nil
      }
      if xt = x.ty {
        if !want.is_void {
          return lw.coerce(v, xt, want, x.loc)
        }
      }
      return v
    }
  }
  lw.lower_stmt(last)
  nil
}

// `<enclosing>#spawnN(_1: ref) -> i32` (calls.av emit_spawn_thunk).
pub fn (lw: MirLower) lower_spawn_thunk(t: MirTask) {
  e = t.expr
  b = lw.lw_b
  if bl = e.block {
    l = -1
    if e.cap_names.size > 0 {
      l = lw.task_layout(e, t.sym, false)
    }
    ps: Array(Int) = []
    ps.push(mt_ref())
    c = lw.begin_task(t, ps, mt_i32(), 1, l, bl)
    b.name_param(1, "cap")
    lw.lw_ret = mt_i32()
    lw.lw_ret_ty = ty_int()
    if l >= 0 {
      lw.load_captures(e, c, l, 0)
    }
    if got = lw.task_value(bl, ty_int()) {
      if lw.open_now {
        lw.at(e.loc)
        dummy = b.assign(b.pl(0), b.rv_use(got))
        b.ret
      }
    }
    lw.finish_at(e.loc)
    b.end_fn
    return
  }
  lw.refuse(e.loc, "a spawn without a block")
}

// `<enclosing>#parN(_1: i32, _2: ref)` (calls.av emit_parallel_thunk):
// element _1 of the input, the block, the result stored at _1.
pub fn (lw: MirLower) lower_par_thunk(t: MirTask) {
  e = t.expr
  b = lw.lw_b
  if bl = e.block {
    if recv = e.receiver {
      l = lw.task_layout(e, t.sym, true)
      if lw.failed {
        return
      }
      ps: Array(Int) = []
      ps.push(mt_i32())
      ps.push(mt_ref())
      c = lw.begin_task(t, ps, mt_void(), 2, l, bl)
      b.name_param(1, "i")
      b.name_param(2, "ctx")
      ts = b.types
      aty = ts.layouts[l].fields[0]
      oty = ts.layouts[l].fields[1]
      a = lw.tmp(aty, b.rv_use(b.copy(b.field(b.deref(b.pl(c)), 0))))
      ah = mir_bare_copy(a)
      d = lw.tmp(oty, b.rv_use(b.copy(b.field(b.deref(b.pl(c)), 1))))
      dh = mir_bare_copy(d)
      et = lw.elem_of(aty)
      v = b.c_i32(0)
      if ts.is_refkind(et) {
        gl = b.temp(et)
        dummy0 = b.call(gl, "avant_array_get_ptr", lw.two(b.copy_local(ah), b.copy_local(1)))
        v = b.copy_local(gl)
      } else {
        buf = b.temp(ts.ref_to(lw.elems_of(aty)))
        dummy = b.assign(b.pl(buf), b.rv_use(b.copy(b.field(b.deref(b.pl(ah)), 0))))
        v = lw.tmp(et, b.rv_use(b.copy(b.index(b.deref(b.pl(buf)), b.copy_local(1)))))
      }
      lw.bind_name(bl.params[0], lw.elem_ty_of(recv), et, v, bl.loc, false)
      lw.load_captures(e, c, l, 2)
      if lw.failed {
        return
      }
      want = lw.elem_ty_of(e)
      if got = lw.task_value(bl, want) {
        if lw.open_now {
          lw.at(e.loc)
          ot = lw.elem_of(oty)
          r = lw.tmp(ot, b.rv_use(got))
          if ts.is_refkind(ot) {
            dummy2 = b.call(-1, "avant_array_set_ptr", lw.three(b.copy_local(dh), b.copy_local(1), r))
          } else {
            ob = b.temp(ts.ref_to(lw.elems_of(oty)))
            dummy3 = b.assign(b.pl(ob), b.rv_use(b.copy(b.field(b.deref(b.pl(dh)), 0))))
            lw.store_place(b.index(b.deref(b.pl(ob)), b.copy_local(1)), ot, r)
          }
          b.ret
        }
      }
      lw.finish_at(e.loc)
      b.end_fn
      return
    }
  }
  lw.refuse(e.loc, "a .parallel without a block")
}

// ---- Mutex.with

// The innermost open Mutex.with place named name, or -1.
pub fn (lw: MirLower) mutex_index(name: String): Int {
  i = lw.lw_task.pnames.size - 1
  while i >= 0 {
    if str_eq(lw.lw_task.pnames[i], name) {
      return i
    }
    i = i - 1
  }
  -1
}

// The cell of the mutex in open place i: `(*_m).cell`.
pub fn (lw: MirLower) mutex_place(i: Int): MPlace {
  b = lw.lw_b
  b.field(b.deref(b.pl(lw.lw_task.pholders[i])), lw.lw_task.pfields[i])
}

// `m.with { |x| ... }` (calls.av emit_mutex_with): the mutex once into
// a local, `avant_gate_lock(m.gate)`, the block in place with x naming
// `m.cell` (reads, assignments behind the barrier, field stores through
// it), the value kept, `avant_gate_unlock(m.gate)`.
pub fn (lw: MirLower) lower_mutex_with(e: Expr, recv: Expr, rt: Ty, bl: Block): MOperand {
  b = lw.lw_b
  zero = b.c_i32(0)
  mty = lw.ety(recv)
  gi = lw.field_of(rt, "gate", e.loc)
  ci = lw.field_of(rt, "cell", e.loc)
  if lw.failed || bl.params.size != 1 {
    lw.refuse(e.loc, "this Mutex.with")
    return zero
  }
  o = lw.lower_expr(recv)
  if lw.failed {
    return zero
  }
  lw.at(e.loc)
  h = b.temp(mty)
  dummy = b.assign(b.pl(h), b.rv_use(o))
  g = lw.tmp(mt_u64(), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), gi))))
  dummy2 = b.call(-1, "avant_gate_lock", lw.one(g))
  lw.lw_task.pnames.push(bl.params[0])
  lw.lw_task.pholders.push(h)
  lw.lw_task.pfields.push(ci)
  vt = ty_void()
  if t = e.ty {
    vt = t
  }
  got = lw.task_value(bl, vt)
  dummy3 = lw.lw_task.pnames.pop
  dummy4 = lw.lw_task.pholders.pop
  dummy5 = lw.lw_task.pfields.pop
  if lw.failed || !lw.open_now {
    return zero
  }
  lw.at(e.loc)
  r = zero
  if v = got {
    if !vt.is_void {
      r = lw.tmp(lw.ety(e), b.rv_use(v))
    }
  }
  g2 = lw.tmp(mt_u64(), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), gi))))
  dummy6 = b.call(-1, "avant_gate_unlock", lw.one(g2))
  r
}

// ---- dispatch (lower_call.av): the calls this file lowers, or nil.

pub fn (lw: MirLower) lower_task_call(e: Expr): MOperand? {
  b = lw.lw_b
  c = e.callee
  if recv = e.receiver {
    if rt = recv.ty {
      if rt.is_join && str_eq(c, "join") {
        return lw.lower_join(e, recv)
      }
      if bl = e.block {
        if rt.is_array && str_eq(c, "parallel") {
          return lw.lower_parallel(e, recv)
        }
        if rt.is_class && str_eq(c, "with") && (str_eq(rt.origin, "Mutex") || str_eq(rt.name, "Mutex")) {
          return lw.lower_mutex_with(e, recv, rt, bl)
        }
      }
    }
    return nil
  }
  if str_eq(c, "spawn") {
    if bl2 = e.block {
      return lw.lower_spawn(e)
    }
    return nil
  }
  if str_eq(c, "avant_gate_new") && e.args.size == 0 {
    lw.at(e.loc)
    none: Array(MOperand) = []
    return lw.call_to(mt_u64(), c, none)
  }
  if mir_gate_builtin(c) && e.args.size == 1 {
    a = lw.lower_expr(e.args[0])
    if lw.failed {
      return b.c_i32(0)
    }
    lw.at(e.loc)
    dummy = b.call(-1, c, lw.one(a))
    return b.c_i32(0)
  }
  nil
}

// The gate builtins taking a gate (calls.av is_gate_callee).
pub fn mir_gate_builtin(name: String): Bool {
  str_eq(name, "avant_gate_lock") || str_eq(name, "avant_gate_unlock") || str_eq(name, "avant_gate_wait") || str_eq(name, "avant_gate_signal") || str_eq(name, "avant_gate_broadcast")
}
