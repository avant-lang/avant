  // The gate functions take the object that holds the gate word and the
  // word's byte offset in it; a lock and a wait may wait natively, so
  // they collect; an unlock, a signal and a broadcast never wait and
  // never collect.
  t.row("avant_gate_lock", "ref, u64", "void", c, "")
  t.row("avant_gate_unlock", "ref, u64", "void", n, "")
