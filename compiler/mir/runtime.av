  t.row("avant_hash_has_str", "ref, ref str", "i32", c, "")
  t.row("avant_hash_has_i32k", "ref, i32", "i32", c, "")
  t.row("avant_hash_get_or_i32", "ref, ref str, i32", "i32", c, "")
  t.row("avant_hash_get_or_str", "ref, ref str, ref str", "ref str", c, "")
  t.row("avant_hash_get_or_i32k_i32", "ref, i32, i32", "i32", c, "")
  t.row("avant_hash_inc_str", "ref, ref str, i32", "i32", c, "")
