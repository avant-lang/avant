  t.row("avant_gc_collect_young", "", "void", c, "")
  t.row("avant_gc_hold_end", "", "void", c, "")
  t.row("avant_task_hold_end", "", "void", c, "")
}

// The declarations' attributes, each read from the C body. Only `never`
// rows: a call that cannot collect may let LLVM keep values across it.
// The string readers end in avant_str_n (runtime/avant_str.c), which reads
// the string's header (every string carries its length there), and
// memcmp or a loop over the bytes: they read memory and write none, keep
// no pointer, take no lock, allocate, free and unwind nothing, and always
// return.
fn mir_rt_attrs(t: MRtTable) {
  str_reader = "nounwind willreturn nofree nosync memory(read)"
  // avant_str_size: avant_str_n.
  t.set_attrs("avant_str_size", str_reader)
  // avant_str_data: the header and a view's two fields.
  t.set_attrs("avant_str_data", str_reader)
  // avant_str_view_test: the header.
  t.set_attrs("avant_str_view_test", str_reader)
  // avant_str_eq: avant_str_n twice, memcmp.
  t.set_attrs("avant_str_eq", str_reader)
  // avant_str.c avant_str_cmp: avant_str_n twice, memcmp.
  t.set_attrs("avant_str_cmp", str_reader)
  // avant_buf_starts: avant_str_n, field reads of the Buf, memcmp.
  t.set_attrs("avant_buf_starts", str_reader)
  // avant_buf.c:192-195: one field read of its argument.
  t.set_attrs("avant_buf_size", "nounwind willreturn nofree nosync memory(argmem: read)")
  // The barriers (runtime/avant_gc_remset.c): they read the holder (its
  // header, and its references when the store log records them) and write
  // only the collector's own tables (the remembered set, the cards, the
  // log) and the holder's header flags, which generated code reads only in
  // its inline barrier and pop tests: a stale read there of a bit a
  // barrier sets (remembered, logged, cards) only makes one more call, and
  // no barrier changes the young and heap bits. So a field or a size
  // loaded before a barrier's call is not loaded again after it (a queue's
  // length around the store into its element).
  barrier = "nounwind willreturn nofree memory(read, inaccessiblemem: readwrite)"
  t.set_attrs("avant_barrier", barrier)
  t.set_attrs("avant_barrier_slot", barrier)
  t.set_attrs("avant_barrier_at", barrier)
}
