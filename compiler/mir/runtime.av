  t.row("avant_gc_reload", "ptr", "ptr", n, "")
  t.row("__avant_type_maps", "", "void", n, "")
  // quiet: the old quiet list (codegen/analysis.av), in its order.
  t.row("avant_hash_get_i32", "ref, ref str, ptr", "i32", q, "")
  t.row("avant_hash_get_str", "ref, ref str, ptr", "ref str", q, "")
  t.row("avant_hash_get_i32k_i32", "ref, i32, ptr", "i32", q, "")
  t.row("avant_hash_set_i32", "ref, ref str, i32", "void", q, "")
  t.row("avant_hash_set_str", "ref, ref str, ref str", "void", q, "")
  t.row("avant_hash_set_i32k_i32", "ref, i32, i32", "void", q, "")
  t.row("avant_hash_clear", "ref", "void", q, "")
  t.row("avant_hash_size", "ref", "i32", q, "")
  t.row("avant_hash_del", "ref, ref str", "void", q, "")
  t.row("avant_hash_del_i32k", "ref, i32", "void", q, "")
  t.row("avant_hash_get_str_slice", "ref, ref str, i32, i32, ptr", "ref str", q, "")
  t.row("avant_hash_inc_slice", "ref, ref str, i32, i32", "i32", q, "")
  t.row("avant_buf_clear", "ref", "void", q, "")
  t.row("avant_buf_push_byte", "ref, i32", "void", q, "")
  t.row("avant_buf_push_str", "ref, ref str", "void", q, "")
  t.row("avant_buf_push_slice", "ref, ref str, i32, i32", "void", q, "")
  t.row("avant_buf_push_fmt_i", "ref, i32", "void", q, "")
  t.row("avant_buf_push_fmt_f", "ref, f64, i32", "void", q, "")
  t.row("avant_regex_find", "ptr, ref str, i32", "i64", q, "")
  t.row("avant_regex_span_pair", "i32", "i64", q, "")
  t.row("avant_regex_span_at", "ptr, ref str, i32, i32", "i64", q, "")
  t.row("avant_regex_count", "ptr, ref str", "i32", q, "")
  // collects: the allocation entry, the slot rows, and the rows the core
  // example and the verifier tests call.
  t.row("avant_alloc", "u64, u32", "ref", c, "alloc")
  t.row("avant_array_push_slot", "ref, u64, u32", "addr", c, "slot")
  t.row("avant_array_pop_slot", "ref, u64", "addr", c, "slot")
  t.row("avant_array_push_ptr", "ref, ref, u32", "void", c, "")
  t.row("avant_io_init_argv", "i32, ptr", "void", c, "")
  t.row("avant_gc_collect", "", "void", c, "")
  t.row("avant_str_from_int", "i32", "ref str", c, "")
  t.row("avant_str_from_i64", "i64", "ref str", c, "")
  t.row("avant_str_from_u64", "u64", "ref str", c, "")
  t.row("avant_str_from_float", "f64", "ref str", c, "")
  t.row("avant_str_concat", "ref str, ref str", "ref str", c, "")
  t.row("avant_str_slice", "ref str, i32, i32", "ref str", c, "")
  // collects: the string rows W6a first calls (mir.md W6a.6).
  t.row("avant_str_cat_i32", "ref str, i32", "ref str", c, "")
  t.row("avant_str_from_bool", "i32", "ref str", c, "")
  t.row("avant_str_from_byte", "i32", "ref str", c, "")
  t.row("avant_str_repeat_byte", "i32, i32", "ref str", c, "")
  t.row("avant_str_fmt_float", "f64, i32", "ref str", c, "")
  t.row("avant_str_strip", "ref str, i32", "ref str", c, "")
  t.row("avant_buf_new", "i32", "ref", c, "")
  t.row("avant_buf_to_str", "ref", "ref str", c, "")
  t.row("avant_hash_new", "i32, i32", "ref", c, "")
  // collects: the array, hash, Buf, and string rows W6c first calls
  // (mir.md W6c.6; the old classification, audit 3.2).
  t.row("avant_array_push_i32", "ref, i32", "void", c, "")
  t.row("avant_array_reserve", "ref, i32, u64, u32", "void", c, "")
  t.row("avant_array_reverse", "ref, u64", "void", c, "")
  t.row("avant_array_copy", "ref, u64, u32", "ref", c, "")
  t.row("avant_array_sort_i32", "ref", "void", c, "")
  t.row("avant_array_sort_i64", "ref", "void", c, "")
  t.row("avant_array_sort_u64", "ref", "void", c, "")
  t.row("avant_array_sort_f64", "ref", "void", c, "")
  t.row("avant_array_sort_str", "ref", "void", c, "")
  t.row("avant_array_sort_bool", "ref", "void", c, "")
  t.row("avant_array_contains_i32", "ref, i32", "i32", c, "")
  t.row("avant_array_contains_i64", "ref, i64", "i32", c, "")
  t.row("avant_array_contains_u64", "ref, u64", "i32", c, "")
  t.row("avant_array_contains_f64", "ref, f64", "i32", c, "")
