  t.row("avant_array_min_i32", "ref, ptr", "i32", c, "")
  t.row("avant_array_min_i64", "ref, ptr", "i64", c, "")
  t.row("avant_array_min_u64", "ref, ptr", "u64", c, "")
  t.row("avant_array_min_f64", "ref, ptr", "f64", c, "")
