// The call table: for every external symbol the compiler may call, its MIR
// signature and one class: never (the old fixed --gc-leaf list of
// pipeline.av, the libc and GC hook names, __avant_type_maps), collects
// (everything else, and every name not in the table). Flags: alloc, slot
// (returns the untyped `addr` of an element inside the array's buffer),
// noreturn, varargs. The classes are the old back end's (proof: old),
// except the old quiet class (helpers that allocated only under defer),
// which is gone: its rows are never or collects. The first lowering that
// emits a never row proves it or moves it to collects. This is
// the MIR's own copy; pipeline.av's list is the old back end's and is not
// changed.
//
// Rows: the 47 never names of pipeline.av, the libc and GC hooks, the old
// quiet names, and the collects rows whose signature the core needs. A
// collects row is only needed for its signature (an unknown name already
// collects): rows are added as the lowering first calls them.

import source
import mir.types

pub fn mcc_never: Int { 1 }
pub fn mcc_collects: Int { 3 }

pub fn mcc_name(c: Int): String {
  if c == mcc_never() {
    return "never"
  }
  "collects"
}

pub class MRtRow {
  name: String = ""
  params: String = ""
  ret: String = ""
  pub cls: Int = 0
  pub alloc: Bool = false
  pub slot: Bool = false
  // Takes a derived address only to compare it with the runtime's own
  // addresses before it returns: never stored, never read through, and
  // the call never collects (verify_module.av V10).
  pub peek: Bool = false
  pub noreturn: Bool = false
  varargs: Bool = false
  pub attrs: String = ""

  fn initialize(name: String, params: String, ret: String, cls: Int) {
    self.name = name
    self.params = params
    self.ret = ret
    self.cls = cls
  }
}

pub class MRtTable {
  rows: Array(MRtRow) = []
  index: Hash(String, Int) = Hash(String, Int).new()

  fn initialize {
    mir_rt_fill(self)
    mir_rt_attrs(self)
  }

  // flags: "", or space-separated alloc slot peek noreturn varargs.
  pub fn row(name: String, params: String, ret: String, cls: Int, flags: String) {
    r = MRtRow.new(name, params, ret, cls)
    words = flags.split(" ")
    for w in words {
      if w == "alloc" {
        r.alloc = true
      } else if w == "slot" {
        r.slot = true
      } else if w == "peek" {
        r.peek = true
      } else if w == "noreturn" {
        r.noreturn = true
      } else if w == "varargs" {
        r.varargs = true
      }
    }
    self.index[name] = self.rows.size
    self.rows.push(r)
  }

  // LLVM function attributes for the declaration of a row whose C
  // body is a pure reader (each proven in mir_rt_attrs).
  pub fn set_attrs(name: String, text: String) {
    if r = find(name) {
      r.attrs = text
    }
  }

  pub fn attrs_of(name: String): String {
    if r = find(name) {
      return r.attrs
    }
    ""
  }

  pub fn find(name: String): MRtRow? {
    if i = self.index.get(name) {
      return self.rows[i]
    }
    nil
  }

  // The class of a C name: the row's, or collects for a name not here.
  pub fn class_of(name: String): Int {
    if r = find(name) {
      return r.cls
    }
    mcc_collects()
  }

  // The row's MIR signature, interned into ts; -1 when a type text does
  // not parse (a table defect).
  pub fn sig_of(r: MRtRow, ts: MTypes): Int {
    ps: Array(Int) = []
    if r.params.size > 0 {
      parts = r.params.split(", ")
      i = 0
      while i < parts.size {
        t = ts.parse_text(parts[i])
        if t < 0 {
          return -1
        }
        ps.push(t)
        i += 1
      }
    }
    rt = ts.parse_text(r.ret)
    if rt < 0 {
      return -1
    }
    ts.sig(ps, rt, r.varargs)
  }
}

fn mir_rt_fill(t: MRtTable) {
  n = mcc_never()
  c = mcc_collects()
  // never: the old fixed --gc-leaf list (pipeline.av), in its order.
  t.row("avant_type_map", "u32, u64", "void", n, "")
  t.row("avant_type_map_at", "u32, u32, u32, u64", "void", n, "")
  t.row("avant_barrier", "ref", "void", n, "")
  t.row("avant_barrier_at", "ptr", "void", n, "")
  t.row("avant_barrier_slot", "ref, ptr", "void", n, "")
  t.row("avant_cov_hit", "i32", "void", n, "")
  t.row("avant_cov_init", "ref str", "void", n, "")
  t.row("avant_pin", "ref", "void", n, "")
  t.row("avant_unpin", "ref", "void", n, "")
  t.row("avant_pin_field", "ptr, ref", "void", n, "")
  t.row("avant_release_range", "ptr, u64", "void", n, "")
  t.row("avant_is_heap", "ref", "i32", n, "")
  t.row("avant_is_young", "ref", "i32", n, "")
  t.row("avant_gc_quiet_enter", "", "void", n, "")
  t.row("avant_gc_quiet_leave", "", "void", n, "")
  // std.gc's `gc.hold { }`: the entry collects nothing; the end is a
  // collection point (below).
  t.row("avant_gc_hold_begin", "", "void", n, "")
  // In a program that spawns, a `pin` block's pin and a `gc.hold` go
  // through the task pool, which ends them when a trap ends the task
  // (runtime/avant_task.c); the same calls underneath.
  t.row("avant_task_pin", "ref", "void", n, "")
  t.row("avant_task_unpin", "ref", "void", n, "")
  t.row("avant_task_hold_begin", "", "void", n, "")
  t.row("avant_array_get_ptr", "ref, i64", "ref", n, "")
  t.row("avant_array_set_ptr", "ref, i64, ref", "void", n, "")
  t.row("avant_array_pop_ptr", "ref", "ref", n, "")
  t.row("avant_array_clear", "ref", "void", n, "")
  t.row("avant_array_zero_range", "ref, i64, i64, u64", "void", n, "")
  t.row("avant_array_fill_i32", "ref, i32", "void", n, "")
  t.row("avant_array_fill_i64", "ref, i64", "void", n, "")
  t.row("avant_array_fill_u8", "ref, i32", "void", n, "")
  // The freeze: a captured Array's count, at a spawn or .parallel
  // and at its end; neither allocates.
  t.row("avant_array_freeze", "ref, i32", "void", n, "")
  t.row("avant_array_thaw", "ref, i32, u64", "void", n, "")
  // A captured value holding a Hash (an Array or a Hash of them at any
  // level): the same count, a level each.
  t.row("avant_value_freeze", "ref, i32, u32", "void", n, "")
  t.row("avant_value_thaw", "ref, i32, u32, u64", "void", n, "")
  // The freeze of a method call on an element (lower_agg.av
  // held_method_call): the holder's slot, the element size, the call's
  // name and site; and the test of a frozen Array's change in a program
  // with such calls (lower_arr.av frozen_check).
  t.row("avant_array_hold", "ptr, u64, ref str, ref str", "void", n, "")
  t.row("avant_array_unhold", "ptr", "void", n, "")
  t.row("avant_array_frozen", "ref, i32", "void", n, "")
  // A store through a struct method's receiver in a program with such
  // calls that spawns (lower_agg.av recv_store_check): the receiver's
  // address and the store's site.
  t.row("avant_array_recv_store", "addr, ref str", "void", n, "peek")
  t.row("avant_str_size", "ref str", "i64", n, "")
  // The address of a string's bytes (a view's are its base's), used at
  // once; the emitter inlines it.
  t.row("avant_str_data", "ref str, i32", "ptr u8", n, "")
  // libc's memcmp for a String switch's labels: never collects; LLVM
  // expands it at a constant size.
  t.row("memcmp", "ptr u8, ref str, i64", "i32", n, "")
  t.row("avant_str_byte", "ref str, i64", "i64", n, "")
  t.row("avant_str_eq", "ref str, ref str", "i32", n, "")
  t.row("avant_str_cmp", "ref str, ref str", "i32", n, "")
  t.row("avant_str_parse_i32", "ref str, i64, ptr", "i32", n, "")
  t.row("avant_str_parse_i64", "ref str, i64, ptr", "i64", n, "")
  t.row("avant_str_parse_u64", "ref str, i64, ptr", "u64", n, "")
  t.row("avant_str_parse_f64", "ref str", "f64", n, "")
  t.row("avant_str_parse_f64_slice", "ref str, i64, i64", "f64", n, "")
  t.row("avant_buf_size", "ref", "i64", n, "")
  t.row("avant_buf_starts", "ref, ref str", "i32", n, "")
  // The search methods of String, Bytes and Buf: both sides read in
  // place, no allocation (a trap for a bad start or byte).
  t.row("avant_seq_find", "ref, i32, ref, i32, i64, i32", "i64", n, "")
  t.row("avant_seq_find_byte", "ref, i32, i64, i64, i32", "i64", n, "")
  t.row("avant_clock_ms", "", "i64", n, "")
  t.row("avant_clock_us", "", "i64", n, "")
  t.row("avant_trap_empty", "i32", "void", n, "noreturn")
  t.row("avant_trap_frozen", "i32", "void", n, "noreturn")
  t.row("avant_trap_poisoned", "", "void", n, "noreturn")
  t.row("avant_trap_walk", "i32", "void", n, "noreturn")
  t.row("avant_trap_bounds", "i64, i64", "void", n, "noreturn")
  t.row("avant_trap_div_zero", "", "void", n, "noreturn")
  t.row("avant_trap_overflow", "", "void", n, "noreturn")
  t.row("avant_trap_shift", "i64, i32", "void", n, "noreturn")
  t.row("avant_trap_to_i", "f64", "void", n, "noreturn")
  t.row("avant_trap_c_range", "i64, i32", "void", n, "noreturn")
  t.row("avant_trap_convert", "i64, i32", "void", n, "noreturn")
  t.row("avant_trap_byte", "i64", "void", n, "noreturn")
  t.row("avant_trap_size", "i32", "void", n, "noreturn")
  t.row("avant_trap_size_at", "i32, i32", "void", n, "noreturn")
  t.row("avant_trap_negative", "i64, i32", "void", n, "noreturn")
  t.row("avant_trap_exit_status", "i64", "void", n, "noreturn")
  t.row("avant_trap_c_null", "ref str", "void", n, "noreturn")
  // An enum value that is no member: the value and the enum's name.
  t.row("avant_trap_enum", "i64, ref str", "void", n, "noreturn")
  // `x.expect(why)` on nil: the text given.
  t.row("avant_trap_expect", "ref str", "void", n, "noreturn")
  // A constant computed before main whose value is a failure.
  t.row("avant_trap_const", "ref str", "void", n, "noreturn")
  // The sited form the emitter calls for each trap row above (ll_call,
  // ll_bounds, ll_arith_block): its parameters and the site's number in
  // the module's table of trap texts.
  t.row("avant_trap_overflow_in", "i32", "void", n, "noreturn")
  t.row("avant_trap_div_zero_in", "i32", "void", n, "noreturn")
  t.row("avant_trap_empty_at", "i32, i32", "void", n, "noreturn")
  t.row("avant_trap_walk_at", "i32, i32", "void", n, "noreturn")
  t.row("avant_trap_frozen_at", "i32, i32", "void", n, "noreturn")
  t.row("avant_trap_poisoned_at", "i32", "void", n, "noreturn")
  t.row("avant_trap_bounds_at", "i64, i64, i32", "void", n, "noreturn")
  t.row("avant_trap_bounds_in", "i64, i64, i32", "void", n, "noreturn")
  t.row("avant_trap_div_zero_at", "i32", "void", n, "noreturn")
  t.row("avant_trap_overflow_at", "i32", "void", n, "noreturn")
  t.row("avant_trap_shift_at", "i64, i32, i32", "void", n, "noreturn")
  t.row("avant_trap_to_i_at", "f64, i32", "void", n, "noreturn")
  t.row("avant_trap_c_range_at", "i64, i32, i32", "void", n, "noreturn")
  t.row("avant_trap_convert_at", "i64, i32, i32", "void", n, "noreturn")
  t.row("avant_trap_byte_at", "i64, i32", "void", n, "noreturn")
  t.row("avant_trap_negative_at", "i64, i32, i32", "void", n, "noreturn")
  t.row("avant_trap_exit_status_at", "i64, i32", "void", n, "noreturn")
  t.row("avant_trap_c_null_at", "ref str, i32", "void", n, "noreturn")
  t.row("avant_trap_enum_at", "i64, ref str, i32", "void", n, "noreturn")
  t.row("avant_trap_expect_at", "ref str, i32", "void", n, "noreturn")
  t.row("avant_trap_const_at", "ref str, i32", "void", n, "noreturn")
  // The constants' start-up (lower_const.av): the constant being
  // computed, none, and a slot's reference words made roots with what
  // the value reaches frozen; none allocates on the heap.
  t.row("avant_const_begin", "ref str", "void", n, "")
  t.row("avant_const_end", "", "void", n, "")
  t.row("avant_const_ready", "ptr, u64", "void", n, "")
  t.row("avant_checked_add_i64", "i64, i64", "i64", n, "")
  t.row("avant_checked_sub_i64", "i64, i64", "i64", n, "")
  t.row("avant_checked_mul_i64", "i64, i64", "i64", n, "")
  t.row("avant_checked_add_u64", "u64, u64", "u64", n, "")
  t.row("avant_checked_sub_u64", "u64, u64", "u64", n, "")
  t.row("avant_checked_mul_u64", "u64, u64", "u64", n, "")
  t.row("avant_checked_div_i64", "i64, i64", "i64", n, "")
  t.row("avant_checked_rem_i64", "i64, i64", "i64", n, "")
  t.row("avant_checked_div_u64", "u64, u64", "u64", n, "")
  t.row("avant_checked_rem_u64", "u64, u64", "u64", n, "")
  // never: libc, the GC hooks, the type-map function.
  t.row("printf", "ref str", "i32", n, "varargs")
  t.row("memset", "ptr, i32, u64", "ptr", n, "")
  t.row("memcpy", "ptr, ptr, u64", "ptr", n, "")
  t.row("memmove", "ptr, ptr, u64", "ptr", n, "")
  t.row("malloc", "u64", "ptr", n, "")
  t.row("calloc", "u64, u64", "ptr", n, "")
  t.row("free", "ptr", "void", n, "")
  // never: libm, for Float64 abs, floor, sqrt, exp (libm allocates
  // nothing; exp directly, where before it was the runtime's avant_exp,
  // a wrapper of the same call).
  t.row("fabs", "f64", "f64", n, "")
  t.row("floor", "f64", "f64", n, "")
  t.row("sqrt", "f64", "f64", n, "")
  t.row("exp", "f64", "f64", n, "")
  t.row("ceil", "f64", "f64", n, "")
  t.row("round", "f64", "f64", n, "")
  t.row("trunc", "f64", "f64", n, "")
  t.row("sin", "f64", "f64", n, "")
  t.row("cos", "f64", "f64", n, "")
  t.row("tan", "f64", "f64", n, "")
  t.row("log", "f64", "f64", n, "")
  t.row("log2", "f64", "f64", n, "")
  t.row("log10", "f64", "f64", n, "")
  t.row("pow", "f64, f64", "f64", n, "")
  t.row("atan2", "f64, f64", "f64", n, "")
  // never: no C function at all; the emitter writes each as one LLVM
  // operation (llvm/emit.av ll_bits_op): the bit counts and a float's
  // bits, to and from UInt64.
  t.row("avant_bits_ctpop_i64", "i64", "i64", n, "")
  t.row("avant_bits_ctpop_i32", "i32", "i32", n, "")
  t.row("avant_bits_ctlz_i64", "i64", "i64", n, "")
  t.row("avant_bits_ctlz_i32", "i32", "i32", n, "")
  t.row("avant_bits_cttz_i64", "i64", "i64", n, "")
  t.row("avant_bits_cttz_i32", "i32", "i32", n, "")
  t.row("avant_bits_f64_to_u64", "f64", "u64", n, "")
  t.row("avant_bits_u64_to_f64", "u64", "f64", n, "")
  // std.bits (lib/std/bits.av): a multiply's high half, an add's carry
  // and a subtract's borrow out, a 128-by-64 division, a rotation, the
  // bit and byte reversals.
  t.row("avant_bits_mulhi_u64", "u64, u64", "u64", n, "")
  t.row("avant_bits_carry_u64", "u64, u64, u64", "u64", n, "")
  t.row("avant_bits_borrow_u64", "u64, u64, u64", "u64", n, "")
  t.row("avant_bits_divq_u64", "u64, u64, u64", "u64", n, "")
  t.row("avant_bits_divr_u64", "u64, u64, u64", "u64", n, "")
  t.row("avant_bits_rotl_u64", "u64, u64", "u64", n, "")
  t.row("avant_bits_bitrev_u64", "u64", "u64", n, "")
  t.row("avant_bits_bswap_u64", "u64", "u64", n, "")
  t.row("avant_gc_enter", "", "void", n, "")
  t.row("avant_gc_leave", "", "void", n, "")
  t.row("avant_gc_root_begin", "u32", "ptr", n, "")
  t.row("avant_gc_frame_enter", "ptr", "void", n, "")
  t.row("avant_gc_frame_leave", "ptr", "void", n, "")
  t.row("__avant_type_maps", "", "void", n, "")
  // What was the old back end's quiet list, the Hash(K, V) entries
  // (runtime/avant_hash.c) first. Its class is gone: a row that neither
  // allocates nor enters a defer region is never (a hash lookup or
  // deletion only reads or moves entries); one that allocates or reaches
  // a named safepoint (runtime/avant_gc.h) collects (a hash insertion may
  // grow the table), so its callers root and reload across it like any
  // collecting call.
  t.row("avant_hash_find_ik", "ref, i64, ptr", "ptr", n, "")
  t.row("avant_hash_find_sk", "ref, ref str, ptr", "ptr", n, "")
  t.row("avant_hash_take_ik", "ref, i64, ptr", "ptr", n, "")
  t.row("avant_hash_take_sk", "ref, ref str, ptr", "ptr", n, "")
  t.row("avant_hash_find_xk", "ref, ptr, ptr", "ptr", n, "")
  t.row("avant_hash_take_xk", "ref, ptr, ptr", "ptr", n, "")
  t.row("avant_hash_del_xk", "ref, ptr", "void", n, "")
  t.row("avant_hash_create_typed", "u32, ref str, u32, u32, u32, u32, u32", "ref", c, "")
  t.row("avant_hash_put_xk", "ref, ptr", "ptr", c, "")
  t.row("avant_hash_upsert_xk", "ref, ptr, ptr", "ptr", c, "")
  t.row("avant_hash_set_ref_xk", "ref, ptr, ref", "void", c, "")
  t.row("avant_hash_slot_ik", "ref, i64", "addr", c, "slot")
  t.row("avant_hash_slot_sk", "ref, ref str", "addr", c, "slot")
  t.row("avant_hash_slot_xk", "ref, ptr", "addr", c, "slot")
  t.row("avant_hash_create", "u32", "ref", c, "")
  // A key hashed and compared by its type's methods: the entries call
  // back into generated code (the type's hash and ==), which may
  // allocate, so every one of them collects, the lookups included.
  t.row("avant_hash_user", "ref, ptr, ptr", "void", n, "")
  t.row("avant_hasher_add", "ptr, u64", "void", n, "")
  t.row("avant_hasher_add_str", "ptr, ref str", "void", n, "")
  t.row("avant_hash_find_uk", "ref, ptr, ptr", "ptr", c, "")
  t.row("avant_hash_take_uk", "ref, ptr, ptr", "ptr", c, "")
  t.row("avant_hash_del_uk", "ref, ptr", "void", c, "")
  t.row("avant_hash_put_uk", "ref, ptr", "ptr", c, "")
  t.row("avant_hash_upsert_uk", "ref, ptr, ptr", "ptr", c, "")
  t.row("avant_hash_set_ref_uk", "ref, ptr, ref", "void", c, "")
  t.row("avant_hash_slot_uk", "ref, ptr", "addr", c, "slot")
  t.row("avant_hash_put_ik", "ref, i64", "ptr", c, "")
  t.row("avant_hash_put_sk", "ref, ref str", "ptr", c, "")
  t.row("avant_hash_upsert_ik", "ref, i64, ptr", "ptr", c, "")
  t.row("avant_hash_upsert_sk", "ref, ref str, ptr", "ptr", c, "")
  t.row("avant_hash_set_ref_ik", "ref, i64, ref", "void", c, "")
  t.row("avant_hash_set_ref_sk", "ref, ref str, ref", "void", c, "")
  t.row("avant_hash_keys", "ref", "ref", c, "")
  t.row("avant_hash_values", "ref", "ref", c, "")
  // The walk in place: none of them allocates.
  t.row("avant_hash_walk", "ref, i32", "i32", n, "")
  t.row("avant_hash_walk_key", "ref, i32", "ptr", n, "")
  t.row("avant_hash_walk_val", "ref, i32", "ptr", n, "")
  t.row("avant_hash_walk_ok", "ref, u32, i32", "i32", n, "")
  t.row("avant_hash_walk_delete", "ref, i32", "void", n, "")
  t.row("avant_hash_clear", "ref", "void", n, "")
  t.row("avant_hash_size", "ref", "i64", n, "")
  t.row("avant_hash_del_sk", "ref, ref str", "void", n, "")
  t.row("avant_hash_del_ik", "ref, i64", "void", n, "")
  t.row("avant_hash_get_str_slice", "ref, ref str, i64, i64, ptr", "ref str", n, "")
  // A String key given as a slice of a String (_sk_part) or a Buf
  // (_bk_part), read in place (lower_hash.av key_part): the find only
  // reads; the upsert and the slot build the key at a miss.
  t.row("avant_hash_find_sk_part", "ref, ref str, i64, i64, ptr", "ptr", n, "")
  t.row("avant_hash_find_bk_part", "ref, ref, i64, i64, ptr", "ptr", n, "")
  t.row("avant_hash_upsert_sk_part", "ref, ref str, i64, i64, ptr", "ptr", c, "")
  t.row("avant_hash_upsert_bk_part", "ref, ref, i64, i64, ptr", "ptr", c, "")
  t.row("avant_hash_slot_sk_part", "ref, ref str, i64, i64, i32", "addr", c, "slot")
  t.row("avant_hash_slot_bk_part", "ref, ref, i64, i64, i32", "addr", c, "slot")
