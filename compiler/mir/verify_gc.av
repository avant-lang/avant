// The verifier's GC and dataflow rules (Stage 28 W4; stages/stage28/mir.md
// 5, 6): V9 (no read before a write, lowered), V11 and V12 (traced locals
// live across a collecting call are slots, final), V14 (the fresh
// exemption: reaching definitions and the closing barrier), V15-V17 (leaf
// and frame shape, final), V19 (shared modules, final).

import mir.types
import mir.runtime
import mir.ir
import mir.flow
import mir.verify_core

pub fn mir_verify_gc(v: MVerifier) {
  mir_v15(v)
  mir_v16(v)
  mir_v17(v)
  mir_v19(v)
  if v.bad {
    return
  }
  if v.on(9) {
    mir_v9(v)
  }
  if v.on(11) {
    mir_v11_v12(v)
  }
  mir_v14(v)
}

fn mir_is_indirect(st: MStmt): Bool {
  if x = st.indirect {
    return true
  }
  false
}

fn mir_is_gc_stmt(st: MStmt): Bool {
  st.kind == msk_gc_enter() || st.kind == msk_gc_roots() || st.kind == msk_gc_leave()
}

fn mir_v15(v: MVerifier) {
  f = v.func
  if f.kind != mfk_leaf() {
    return
  }
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    j = 0
    while j < blk.stmts.size {
      st = blk.stmts[j]
      if st.kind == msk_call() && (st.collects || mir_is_indirect(st)) {
        v.err(15, b, j, st.loc, "a leaf makes a collecting or indirect call")
      } else if mir_is_gc_stmt(st) {
        v.err(15, b, j, st.loc, "a leaf has a frame statement")
      }
      j += 1
    }
    b += 1
  }
  k = 0
  while k < f.locals.size {
    if f.locals[k].slot {
      v.ferr(15, "a leaf has the slot _${k}")
    }
    k += 1
  }
}

// V16 as restated by Stage 29 VALK-A1 (M4, gc.av rule 2): a frame
// function links a record (bb0 begins with the zeroed non-parameter
// slots, gc.enter and gc.roots of every slot in local order, and no other
// gc.enter or gc.roots follows) or links none (no frame statement at all).
// It must link one when it has a slot, or when a thread's first Avant
// frame can be its own (MFunc.first_frame: main, a C callback's thunk, a
// task's thunk; the record registers the thread). The frame pass links
// none exactly when neither holds; a record with no slot elsewhere is
// correct and accepted (the builder's modules have them). V17 checks the
// returns of a function that links one.
fn mir_v16(v: MVerifier) {
  f = v.func
  if f.kind == mfk_unset() {
    v.ferr(16, "the function has no kind (the frame pass has not run)")
    return
  }
  if f.kind != mfk_frame() {
    return
  }
  slots: Array(Int) = []
  k = 0
  while k < f.locals.size {
    if f.valid_local(k) && f.locals[k].slot {
      slots.push(k)
      if !v.ts.traced(f.locals[k].ty) {
        v.ferr(16, "the slot _${k} has no root words")
      }
    }
    k += 1
  }
  if !mir_has_gc_stmt(f) {
    if slots.size > 0 {
      v.ferr(16, "a frame function with slots links no frame record")
    } else if f.first_frame {
      v.ferr(16, "a thread's first Avant frame can be this function's (main, a C callback's or a task's thunk) and it links no frame record")
    }
    return
  }
  bb0 = f.blocks[0]
  idx = 0
  ok = true
  k = 0
  while ok && k < slots.size {
    if !f.is_param(slots[k]) {
      ok = idx < bb0.stmts.size && mir_is_zero_of(bb0.stmts[idx], slots[k])
      idx += 1
    }
    k += 1
  }
  ok = ok && idx < bb0.stmts.size && bb0.stmts[idx].kind == msk_gc_enter()
  ok = ok && idx + 1 < bb0.stmts.size && bb0.stmts[idx + 1].kind == msk_gc_roots() && mir_same_ints(bb0.stmts[idx + 1].locals, slots)
  if !ok {
    v.ferr(16, "bb0 does not begin with the zeroed non-parameter slots, gc.enter, and gc.roots of every slot in local order")
    return
  }
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    j = 0
    while j < blk.stmts.size {
      st = blk.stmts[j]
      if (st.kind == msk_gc_enter() || st.kind == msk_gc_roots()) && !(b == 0 && (j == idx || j == idx + 1)) {
        v.err(16, b, j, st.loc, "gc.enter or gc.roots outside the prologue")
      }
      j += 1
    }
    b += 1
  }
}

// Whether f has a frame statement (gc.enter, gc.roots or gc.leave)
// anywhere: a frame function without one links no record (V16).
fn mir_has_gc_stmt(f: MFunc): Bool {
  for blk in f.blocks {
    for st in blk.stmts {
      if mir_is_gc_stmt(st) {
        return true
      }
    }
  }
  false
}

fn mir_is_zero_of(st: MStmt, l: Int): Bool {
  if st.kind != msk_assign() {
    return false
  }
  if p = st.place, r = st.rv {
    return p.proj.size == 0 && p.local == l && r.kind == mrk_zero()
  }
  false
}

fn mir_same_ints(a: Array(Int), b: Array(Int)): Bool {
  if a.size != b.size {
    return false
  }
  for i in 0..a.size {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

// V17: every return of a frame function that links a record has
// gc.leave immediately before it, and gc.leave is nowhere else. A frame
// function with no frame statement links none (V16 says when that is
// allowed) and has nothing to unlink.
fn mir_v17(v: MVerifier) {
  f = v.func
  if f.kind != mfk_frame() {
    return
  }
  if !mir_has_gc_stmt(f) {
    return
  }
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    is_ret = false
    if t = blk.term {
      is_ret = t.kind == mtk_return()
      n = blk.stmts.size
      if is_ret && (n == 0 || blk.stmts[n - 1].kind != msk_gc_leave()) {
        v.err(17, b, -1, t.loc, "a return of a frame function without gc.leave before it")
      }
    }
    j = 0
    while j < blk.stmts.size {
      if blk.stmts[j].kind == msk_gc_leave() && !(is_ret && j == blk.stmts.size - 1) {
        v.err(17, b, j, blk.stmts[j].loc, "gc.leave not immediately before a return")
      }
      j += 1
    }
    b += 1
  }
}

fn mir_v19(v: MVerifier) {
  f = v.func
  if !v.m.shared || f.kind != mfk_leaf() {
    return
  }
  k = 0
  while k < f.locals.size {
    if f.valid_local(k) && v.ts.traced(f.locals[k].ty) {
      v.ferr(19, "a leaf of a shared module holds root words in _${k} (${v.tx(f.locals[k].ty)})")
    }
    k += 1
  }
}

fn mir_v9(v: MVerifier) {
  f = v.func
  n = f.locals.size
  nw = mir_nwords(n)
  ins = mir_defined_in(f)
  cur = mir_zero_words(nw)
  reads: Array(Int) = []
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    mir_words_load(cur, ins, b * nw, nw)
    j = 0
    while j < blk.stmts.size {
      st = blk.stmts[j]
      reads.clear
      mir_stmt_reads(st, reads)
      mir_v9_check(v, cur, reads, b, j, st.loc)
      d = mir_stmt_def(st)
      if d >= 0 && d < n {
        mir_bit_on(cur, 0, d)
      }
      j += 1
    }
    if t = blk.term {
      reads.clear
      mir_term_reads(f, t, reads)
      mir_v9_check(v, cur, reads, b, -1, t.loc)
    }
    b += 1
  }
}

fn mir_v9_check(v: MVerifier, cur: Array(UInt64), reads: Array(Int), b: Int, j: Int, loc: MLoc) {
  for r in reads {
    if !mir_bit(cur, 0, r) {
      v.err(9, b, j, loc, "_${r} is read before it is written on some path")
      mir_bit_on(cur, 0, r)
    }
  }
}

// Whether f makes a collecting call (V11's and V12's liveness matters only
// there).
fn mir_has_collecting_call(f: MFunc): Bool {
  for blk in f.blocks {
    for stmt in blk.stmts {
      if stmt.kind == msk_call() && stmt.collects {
        return true
      }
    }
  }
  false
}

// V11 and V12. The liveness is the frame pass's (MFunc.live) when it still
// describes the function: the walk below recomputes each block's transfer
// and successors as it goes and, at the first difference, its errors are
// dropped and the walk runs again on liveness computed here. A function
// without a collecting call needs no liveness (only V11's address-taken
// clause can apply).
fn mir_v11_v12(v: MVerifier) {
  f = v.func
  if !mir_has_collecting_call(f) {
    mir_v11_addr_only(v)
    return
  }
  start = v.errs.size
  if lv = f.live {
    if mir_v11_walk(v, lv, true) {
      return
    }
    while v.errs.size > start {
      dropped = v.errs.pop
    }
  }
  mir_v11_walk(v, mir_live(f), false)
}

// V11's address-taken clause alone, in the walk's order (blocks up,
// statements down).
fn mir_v11_addr_only(v: MVerifier) {
  f = v.func
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    j = blk.stmts.size - 1
    while j >= 0 {
      mir_v11_addr(v, b, j, blk.stmts[j])
      j -= 1
    }
    b += 1
  }
}

fn mir_v11_addr(v: MVerifier, b: Int, j: Int, st: MStmt) {
  f = v.func
  ts = v.ts
  if f.kind == mfk_frame() && st.kind == msk_assign() {
    if r = st.rv, p = r.place {
      l = p.local
      if (r.kind == mrk_addr() || r.kind == mrk_addr_raw()) && p.frame_local && !f.locals[l].slot && ts.traced(f.locals[l].ty) {
        v.err(11, b, j, st.loc, "the address of _${l} (${v.tx(f.locals[l].ty)}) is taken and _${l} is not a slot")
      }
    }
  }
}

// The walk of V11 and V12 over lv, backwards through each block from its
// live-out. With check, it also recomputes each block's transfer and
// successors and returns false at the first that differs from lv's.
fn mir_v11_walk(v: MVerifier, lv: MLive, check: Bool): Bool {
  f = v.func
  ts = v.ts
  n = f.locals.size
  if check && (lv.n != n || lv.nb != f.blocks.size) {
    return false
  }
  nw = lv.nw
  // the locals V11 and V12 ask about: real, not slots, with root words
  cand = mir_zero_words(nw)
  for k in 0..n {
    if f.valid_local(k) && !f.locals[k].slot && ts.traced(f.locals[k].ty) {
      mir_bit_on(cand, 0, k)
    }
  }
  live = mir_zero_words(nw)
  gen = mir_zero_words(nw)
  kill = mir_zero_words(nw)
  reads: Array(Int) = []
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    at = b * nw
    mir_words_load(live, lv.outs, at, nw)
    if check {
      if !mir_live_same_succ(lv, b, blk) {
        return false
      }
      w = 0
      while w < nw {
        gen[w] = 0u64
        kill[w] = 0u64
        w += 1
      }
    }
    if t = blk.term {
      reads.clear
      mir_term_reads(f, t, reads)
      mir_bits_mark(live, 0, n, reads)
      mir_bits_mark(gen, 0, n, reads)
    }
    j = blk.stmts.size - 1
    while j >= 0 {
      st = blk.stmts[j]
      if st.kind == msk_call() && st.collects {
        d = st.dest
        for w in 0..nw {
          x = live[w] & cand[w]
          if d >= 0 && d / 64 == w {
            x = x & ~(1u64 << (d % 64).to_u64)
          }
          if x != 0u64 {
            mir_v11_report(v, b, j, st, w, x)
          }
        }
      }
      mir_v11_addr(v, b, j, st)
      d = mir_stmt_def(st)
      if d >= 0 && d < n {
        mir_bit_off(live, 0, d)
        mir_bit_off(gen, 0, d)
        mir_bit_on(kill, 0, d)
      }
      reads.clear
      mir_stmt_reads(st, reads)
      mir_bits_mark(live, 0, n, reads)
      mir_bits_mark(gen, 0, n, reads)
      j -= 1
    }
    if check {
      for w in 0..nw {
        if gen[w] != lv.gen[at + w] || kill[w] != lv.kill[at + w] {
          return false
        }
      }
    }
    b += 1
  }
  true
}

// The errors of one collecting call for the candidates x of word w, in
// local order; the call's destination is exempt.
fn mir_v11_report(v: MVerifier, b: Int, j: Int, st: MStmt, w: Int, x: UInt64) {
  f = v.func
  ts = v.ts
  for i in 0..64 {
    if ((x >> i.to_u64) & 1u64) != 0u64 {
      k = w * 64 + i
      if k != st.dest {
        rule = 11
        if ts.is_addr(f.locals[k].ty) {
          rule = 12
        }
        callee = st.callee
        if mir_is_indirect(st) {
          callee = "an indirect callee"
        }
        v.err(rule, b, j, st.loc, "_${k} (${v.tx(f.locals[k].ty)}) is live across the collecting call to ${callee} and is not a slot")
      }
    }
  }
}

// V14, the fresh exemption (Stage 28 W4; restated by Stage 29 VALK-A1,
// M5, mir/fresh.av). A `fresh` store needs no barrier of its own when
// either form holds:
// - open: its holder _h is open at the store: on every path, since the
//   last collecting or indirect call and the last redefinition of _h, an
//   allocation marked `fresh` defined _h (young, or barriered at birth on
//   its slow path), or `barrier copy _h` ran that is not the slot form
//   (one followed by an element store of _h's buffer marks one card), or
//   _h is _1 of an `initialize` (MFunc.fresh_self) and the function has
//   not collected since its entry. A barrier's effect (young, remembered,
//   cards counted as marked) lasts until the next collection, which only a
//   collecting call of the thread's own can start (in a shared module a
//   loop's poll is one, explicit at stage final).
// - closed fill (W1b): every reaching definition of _h is an allocation's
//   result in this function (rd 1), every path from the store to a
//   redefinition of _h or to a return passes a closing `barrier copy _h`
//   (pend), and _h is a slot at stage final.
// And at stage final every call of an `initialize` passes an open first
//   argument (the receiver its entry assumes open; the fresh pass puts a
//   barrier before a call whose receiver is not, such as a method's own
//   `initialize(...)`).
// Two dataflows: the open sets (op, one bit per local, an intersection),
// then, only over the holders of the stores the first found not open,
// the closed-fill form (rd: 0 no definition reaches, 1 only alloc
// results, 2 another; pd: a closed-fill store awaits its closing barrier;
// both indexed by the holder's place in that short list, so a function
// with many locals and blocks pays for the few holders, VALK-A1).
fn mir_v14(v: MVerifier) {
  f = v.func
  any = f.fresh_self
  b = 0
  while b < f.blocks.size {
    j = 0
    while j < f.blocks[b].stmts.size {
      st = f.blocks[b].stmts[j]
      if st.fresh || mir_v14_init_call(v, st) {
        any = true
      }
      j += 1
    }
    b += 1
  }
  if !any {
    return
  }
  n = f.locals.size
  nb = f.blocks.size
  nw = mir_nwords(n)
  preds = mir_preds(f)
  op_out = mir_zero_words(nb * nw)
  for i in 0..op_out.size {
    op_out[i] = ~0u64
  }
  op = mir_zero_words(nw)
  none: Array(Int) = []
  changed = true
  while changed {
    changed = false
    for b in 0..nb {
      mir_v14_op_in(f, b, preds, op_out, op)
      mir_v14_block(v, b, op, none, none, none, false)
      for w in 0..nw {
        if op[w] != op_out[b * nw + w] {
          op_out[b * nw + w] = op[w]
          changed = true
        }
      }
    }
  }
  // The final walk of the open sets: the receivers' errors, and the
  // holders of the fresh stores that are not open (hs, idx: local to its
  // place in hs, or -1).
  idx = mir_ints(n, -1)
  hs: Array(Int) = []
  for b in 0..nb {
    mir_v14_op_in(f, b, preds, op_out, op)
    mir_v14_block(v, b, op, idx, hs, none, true)
  }
  if hs.size == 0 {
    return
  }
  k = hs.size
  kw = mir_nwords(k)
  rd_out = mir_ints(nb * k, 0)
  pd_out = mir_zero_words(nb * kw)
  rd = mir_ints(k, 0)
  pd = mir_zero_words(kw)
  changed = true
  while changed {
    changed = false
    for b in 0..nb {
      mir_v14_op_in(f, b, preds, op_out, op)
      mir_v14_fill_in(f, b, preds, rd_out, pd_out, idx, hs, rd, pd)
      mir_v14_fill_block(v, b, op, idx, rd, pd, false)
      for i in 0..k {
        if rd[i] != rd_out[b * k + i] {
          rd_out[b * k + i] = rd[i]
          changed = true
        }
      }
      for w in 0..kw {
        if pd[w] != pd_out[b * kw + w] {
          pd_out[b * kw + w] = pd[w]
          changed = true
        }
      }
    }
  }
  for b in 0..nb {
    mir_v14_op_in(f, b, preds, op_out, op)
    mir_v14_fill_in(f, b, preds, rd_out, pd_out, idx, hs, rd, pd)
    mir_v14_fill_block(v, b, op, idx, rd, pd, true)
  }
}

// Whether st calls an `initialize` (MFunc.fresh_self) of this module.
fn mir_v14_init_call(v: MVerifier, st: MStmt): Bool {
  if st.kind != msk_call() {
    return false
  }
  if fo = st.indirect {
    return false
  }
  if g = v.m.func(st.callee) {
    return g.fresh_self
  }
  false
}

fn mir_ints(n: Int, x: Int): Array(Int) {
  xs: Array(Int) = []
  for i in 0..n {
    xs.push(x)
  }
  xs
}

// The open set at the entry of block b: the intersection of its
// predecessors' exits; bb0: _1 of an initialize; a block no edge enters:
// nothing.
fn mir_v14_op_in(f: MFunc, b: Int, preds: Array(Array(Int)), op_out: Array(UInt64), op: Array(UInt64)) {
  nw = op.size
  if b == 0 || preds[b].size == 0 {
    for w in 0..nw {
      op[w] = 0u64
    }
    if b == 0 && f.fresh_self && f.locals.size > 1 {
      mir_bit_on(op, 0, 1)
    }
    return
  }
  for w in 0..nw {
    op[w] = ~0u64
  }
  for p in preds[b] {
    for w in 0..nw {
      op[w] = op[w] & op_out[p * nw + w]
    }
  }
}

// The closed-fill state at the entry of block b, over the holders hs: rd
// the most of the predecessors' exits (bb0: a parameter is defined, 2),
// pd their union.
fn mir_v14_fill_in(f: MFunc, b: Int, preds: Array(Array(Int)), rd_out: Array(Int), pd_out: Array(UInt64), idx: Array(Int), hs: Array(Int), rd: Array(Int), pd: Array(UInt64)) {
  k = rd.size
  kw = pd.size
  for i in 0..k {
    rd[i] = 0
  }
  for w in 0..kw {
    pd[w] = 0u64
  }
  for p in preds[b] {
    if b > 0 {
      for i in 0..k {
        if rd_out[p * k + i] > rd[i] {
          rd[i] = rd_out[p * k + i]
        }
      }
    }
    for w in 0..kw {
      pd[w] = pd[w] | pd_out[p * kw + w]
    }
  }
  if b == 0 {
    for i in 0..k {
      if f.is_param(hs[i]) {
        rd[i] = 2
      }
    }
  }
}

// Whether stmts[j], a barrier on h, is the slot form: the next statement
// is an element store of h's buffer (the emitter's avant_barrier_slot,
// which marks one card), so it opens nothing.
fn mir_v14_slot_form(stmts: Array(MStmt), j: Int, h: Int): Bool {
  k = j + 1
  if k >= stmts.size || stmts[k].kind != msk_assign() {
    return false
  }
  if p = stmts[k].place {
    return p.local == h && p.proj.size >= 2 && p.proj[0].kind == mpk_deref() && p.proj[1].kind == mpk_index()
  }
  false
}

// The open set's transfer of one statement, in place.
fn mir_v14_op_step(v: MVerifier, blk: MBlock, j: Int, op: Array(UInt64)) {
  st = blk.stmts[j]
  if st.kind == msk_barrier() && st.args.size == 1 {
    h = mir_bare_local(st.args[0])
    if h >= 0 && !mir_v14_slot_form(blk.stmts, j, h) {
      mir_bit_on(op, 0, h)
    }
  }
  if st.kind == msk_call() && (st.collects || mir_is_indirect(st)) {
    for w in 0..op.size {
      op[w] = 0u64
    }
  }
  d = mir_stmt_def(st)
  if d >= 0 {
    mir_bit_off(op, 0, d)
    if st.kind == msk_call() && st.fresh {
      if e = v.m.ext(st.callee), e.alloc {
        mir_bit_on(op, 0, d)
      }
    }
  }
}

// The open sets through block b. With report (the final walk): a
// receiver of an initialize that is not open is an error (stage final),
// and the holder of each fresh store that is not open joins hs.
fn mir_v14_block(v: MVerifier, b: Int, op: Array(UInt64), idx: Array(Int), hs: Array(Int), none: Array(Int), report: Bool) {
  f = v.func
  blk = f.blocks[b]
  j = 0
  while j < blk.stmts.size {
    st = blk.stmts[j]
    if report && v.stage == mst_final() && mir_v14_init_call(v, st) {
      h = -1
      if st.args.size > 0 {
        h = mir_bare_local(st.args[0])
      }
      if h < 0 || !mir_bit(op, 0, h) {
        v.err(14, b, j, st.loc, "the receiver of a call to ${st.callee} is not open (an object just allocated, or barriered, with no collecting call since)")
      }
    }
    if report && st.fresh && st.kind == msk_assign() {
      if p = st.place {
        if p.last_deref != 0 {
          v.err(14, b, j, st.loc, "the holder of a fresh store is not a local")
        } else if !mir_bit(op, 0, p.local) && idx[p.local] < 0 {
          idx[p.local] = hs.size
          hs.push(p.local)
        }
      }
    }
    mir_v14_op_step(v, blk, j, op)
    j += 1
  }
}

// The closed-fill form through block b over the holders (idx); op is
// carried along to tell a store that is not open. report adds the errors.
fn mir_v14_fill_block(v: MVerifier, b: Int, op: Array(UInt64), idx: Array(Int), rd: Array(Int), pd: Array(UInt64), report: Bool) {
  f = v.func
  blk = f.blocks[b]
  j = 0
  while j < blk.stmts.size {
    st = blk.stmts[j]
    if st.kind == msk_barrier() && st.args.size == 1 {
      h = mir_bare_local(st.args[0])
      if h >= 0 && idx[h] >= 0 {
        mir_bit_off(pd, 0, idx[h])
      }
    }
    d = mir_stmt_def(st)
    if d >= 0 && idx[d] >= 0 {
      i = idx[d]
      if mir_bit(pd, 0, i) && report {
        v.err(14, b, j, st.loc, "_${d} is redefined before the closing barrier of its fresh fill")
      }
      mir_bit_off(pd, 0, i)
      rd[i] = 2
      if st.kind == msk_call() {
        if e = v.m.ext(st.callee), e.alloc {
          rd[i] = 1
        }
      }
    }
    if st.fresh && st.kind == msk_assign() {
      if p = st.place, p.last_deref == 0 && !mir_bit(op, 0, p.local) && idx[p.local] >= 0 {
        h = p.local
        if report && rd[idx[h]] == 2 {
          v.err(14, b, j, st.loc, "fresh store through _${h}, which is not only the result of an allocation in this function")
        }
        if report && v.stage == mst_final() && !f.locals[h].slot {
          v.err(14, b, j, st.loc, "fresh store through _${h}, which is not a slot")
        }
        mir_bit_on(pd, 0, idx[h])
      }
    }
    mir_v14_op_step(v, blk, j, op)
    j += 1
  }
  if report {
    if t = blk.term, t.kind == mtk_return() {
      for i in 0..rd.size {
        if mir_bit(pd, 0, i) {
          k = 0
          while k < f.locals.size {
            if idx[k] == i {
              v.err(14, b, -1, t.loc, "return before the closing barrier of the fresh fill through _${k}")
            }
            k += 1
          }
        }
      }
    }
  }
}
