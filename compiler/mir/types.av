// MIR types and layouts (Stage 28 W4; stages/stage28/mir.md section 2).
// One MType per distinct type, interned by its printed text; ids 0-12 are
// the fixed scalar and untyped kinds below. Layouts compute their C-rule
// offsets, size, alignment, heap reference words, and root words (2.10)
// when noted.

import source

pub fn mk_void: Int { 0 }
pub fn mk_bool: Int { 1 }
pub fn mk_int: Int { 2 }
pub fn mk_f64: Int { 3 }
pub fn mk_ref: Int { 4 }
pub fn mk_str: Int { 5 }
pub fn mk_task: Int { 6 }
pub fn mk_ptr: Int { 7 }
pub fn mk_addr: Int { 8 }
pub fn mk_code: Int { 9 }
pub fn mk_agg: Int { 10 }

// The fixed type ids (interned first, in this order, by MTypes.new).
pub fn mt_void: Int { 0 }
pub fn mt_bool: Int { 1 }
pub fn mt_u8: Int { 2 }
pub fn mt_i32: Int { 3 }
pub fn mt_u32: Int { 4 }
pub fn mt_i64: Int { 5 }
pub fn mt_u64: Int { 6 }
pub fn mt_f64: Int { 7 }
pub fn mt_ref: Int { 8 }
pub fn mt_str: Int { 9 }
pub fn mt_task: Int { 10 }
pub fn mt_ptr: Int { 11 }
pub fn mt_addr: Int { 12 }
// The MIR type of the language's `Int` (Stage 29 W-INT1, D314: 64-bit).
// Sizes and capacities in the Array, Buf and Hash headers stay i32 (the
// runtime's ceiling, AVANT_SIZE_MAX), read with a sign extension.
pub fn mt_int: Int { 5 }

// Layout kinds (2.4).
pub fn mlk_struct: Int { 1 }
pub fn mlk_class: Int { 2 }
pub fn mlk_union: Int { 3 }
pub fn mlk_fnval: Int { 4 }
pub fn mlk_clayout: Int { 5 }
pub fn mlk_record: Int { 6 }
pub fn mlk_array: Int { 7 }
pub fn mlk_elems: Int { 8 }
pub fn mlk_hash: Int { 9 }
pub fn mlk_buf: Int { 10 }

pub fn mlk_name(k: Int): String {
  names = ["?", "struct", "class", "union", "fnval", "clayout", "record", "array", "elems", "hash", "buf"]
  if k < 0 || k >= names.size {
    return "?"
  }
  names[k]
}

pub fn mlk_parse(s: String): Int {
  k = 1
  while k <= 10 {
    if mlk_name(k) == s {
      return k
    }
    k += 1
  }
  0
}

pub class MType {
  id: Int = 0
  pub kind: Int = 0
  pub bits: Int = 0
  signed: Bool = false
  pub pointee: Int = -1
  pub layout: Int = -1
  pub sig: Int = -1
  pub text: String = ""

  fn initialize(kind: Int, text: String) {
    self.kind = kind
    self.text = text
    self.pointee = -1
    self.layout = -1
    self.sig = -1
  }
}

pub class MLayout {
  pub name: String = ""
  pub kind: Int = 0
  pub fields: Array(Int) = []
  pub names: Array(String) = []
  pub offsets: Array(Int) = []
  pub size: Int = 0
  pub align: Int = 1
  pub ref_words: Array(Int) = []
  root_words: Array(Int) = []
  pub type_id: Int = 0
  pub nil_tag: Int = -1

  fn initialize(name: String, kind: Int) {
    self.name = name
    self.kind = kind
  }
}

pub class MSig {
  pub params: Array(Int)
  pub ret: Int = 0
  pub varargs: Bool = false
  pub text: String = ""

  fn initialize(params: Array(Int), ret: Int, varargs: Bool, text: String) {
    self.params = params
    self.ret = ret
    self.varargs = varargs
    self.text = text
  }
}

pub fn mir_align_up(n: Int, a: Int): Int {
  if a <= 1 {
    return n
  }
  ((n + a - 1) / a) * a
}

pub class MTypes {
  all: Array(MType) = []
  index: Hash(String, Int) = Hash(String, Int).new
  pub layouts: Array(MLayout) = []
  layout_index: Hash(String, Int) = Hash(String, Int).new
  pub sigs: Array(MSig) = []
  sig_index: Hash(String, Int) = Hash(String, Int).new

  fn initialize {
    prim(mk_void(), 0, false, "void")
    prim(mk_bool(), 1, false, "bool")
    prim(mk_int(), 8, false, "u8")
    prim(mk_int(), 32, true, "i32")
    prim(mk_int(), 32, false, "u32")
    prim(mk_int(), 64, true, "i64")
    prim(mk_int(), 64, false, "u64")
    prim(mk_f64(), 64, true, "f64")
    prim(mk_ref(), 64, false, "ref")
    prim(mk_str(), 64, false, "ref str")
    prim(mk_task(), 64, false, "ref task")
    prim(mk_ptr(), 64, false, "ptr")
    prim(mk_addr(), 64, false, "addr")
  }

  // A C scalar's type (Stage 29 W1b): i8, i16, u16 and f32 are interned
  // on first use (u8 and u32 are fixed ids); kind mk_int, or mk_f64 with
  // 32 bits for f32.
  pub fn scalar(kind: Int, bits: Int, signed: Bool, text: String): Int {
    if i = self.index.get(text) {
      return i
    }
    t = MType.new(kind, text)
    t.bits = bits
    t.signed = signed
    add(t)
  }

  pub fn is_f32(ty: Int): Bool {
    kind(ty) == mk_f64() && self.all[ty].bits == 32
  }

  fn prim(kind: Int, bits: Int, signed: Bool, text: String) {
    t = MType.new(kind, text)
    t.bits = bits
    t.signed = signed
    dummy = add(t)
  }

  fn add(t: MType): Int {
    if i = self.index.get(t.text) {
      return i
    }
    t.id = self.all.size
    self.all.push(t)
    self.index[t.text] = t.id
    t.id
  }

  pub fn get(id: Int): MType {
    self.all[id]
  }

  pub fn text(id: Int): String {
    if id < 0 || id >= self.all.size {
      return "?"
    }
    self.all[id].text
  }

  pub fn kind(id: Int): Int {
    if id < 0 || id >= self.all.size {
      return -1
    }
    self.all[id].kind
  }

  // ref %L (L a layout index).
  pub fn ref_to(layout: Int): Int {
    t = MType.new(mk_ref(), "ref %${self.layouts[layout].name}")
    t.layout = layout
    add(t)
  }

  pub fn ptr_to(ty: Int): Int {
    t = MType.new(mk_ptr(), "ptr ${text(ty)}")
    t.pointee = ty
    add(t)
  }

  pub fn addr_of(ty: Int): Int {
    t = MType.new(mk_addr(), "addr ${text(ty)}")
    t.pointee = ty
    add(t)
  }

  pub fn agg(layout: Int): Int {
    t = MType.new(mk_agg(), "%${self.layouts[layout].name}")
    t.layout = layout
    add(t)
  }

  pub fn code(sig: Int): Int {
    t = MType.new(mk_code(), "code${self.sigs[sig].text}")
    t.sig = sig
    add(t)
  }

  // A signature, interned by its text "(P, ...) -> R".
  pub fn sig(params: Array(Int), ret: Int, varargs: Bool): Int {
    buf = buf_new()
    buf.push_str("(")
    for i in 0..params.size {
      if i > 0 {
        buf.push_str(", ")
      }
      buf.push_str(text(params[i]))
    }
    if varargs {
      if params.size > 0 {
        buf.push_str(", ")
      }
      buf.push_str("...")
    }
    buf.push_str(") -> ${text(ret)}")
    key = buf.to_s
    if got = self.sig_index.get(key) {
      return got
    }
    copy: Array(Int) = []
    k = 0
    while k < params.size {
      copy.push(params[k])
      k += 1
    }
    id = self.sigs.size
    self.sigs.push(MSig.new(copy, ret, varargs, key))
    self.sig_index[key] = id
    id
  }

  // The type a call-table text names: a scalar, `ref`, `ref str`,
  // `ref task`, `ptr`, `ptr <scalar>`, or `addr`; -1 otherwise.
  pub fn parse_text(s: String): Int {
    if i = self.index.get(s) {
      if i <= mt_addr() {
        return i
      }
    }
    if str_starts(s, "ptr ") {
      inner = parse_text(str_slice(s, 4, s.size))
      if inner >= 0 {
        return ptr_to(inner)
      }
    }
    -1
  }

  pub fn layout_named(name: String): Int {
    if i = self.layout_index.get(name) {
      return i
    }
    -1
  }

  // Notes a layout and computes its byte layout and word sets (2.4, 2.10).
  // Idempotent by name: a second note returns the first index.
  pub fn note_layout(name: String, kind: Int, fields: Array(Int), names: Array(String)): Int {
    if i = self.layout_index.get(name) {
      return i
    }
    l = MLayout.new(name, kind)
    if kind == mlk_array() {
      l.type_id = 1022
    } else if kind == mlk_buf() {
      l.type_id = 1021
    } else if kind == mlk_hash() {
      l.type_id = 1023
    }
    id = self.layouts.size
    self.layouts.push(l)
    self.layout_index[name] = id
    set_fields(id, fields, names)
    id
  }

  // (Re)computes layout id's fields, offsets, size, alignment, and word
  // sets (W6b): a class is noted empty first, so that a field of type
  // `ref %C` can name it (recursive and mutually referring classes), and
  // filled once every layout its fields hold by value exists.
  pub fn set_fields(id: Int, fields: Array(Int), names: Array(String)) {
    l = self.layouts[id]
    f: Array(Int) = []
    l.fields = f
    n: Array(String) = []
    l.names = n
    o: Array(Int) = []
    l.offsets = o
    r: Array(Int) = []
    l.ref_words = r
    w: Array(Int) = []
    l.root_words = w
    off = 0
    al = 1
    i = 0
    while i < fields.size {
      fa = align_of(fields[i])
      off = mir_align_up(off, fa)
      l.fields.push(fields[i])
      if i < names.size {
        l.names.push(names[i])
      } else {
        l.names.push("")
      }
      l.offsets.push(off)
      words(fields[i], off, l.ref_words, l.root_words)
      off += size_of(fields[i])
      if fa > al {
        al = fa
      }
      i += 1
    }
    l.align = al
    l.size = mir_align_up(off, al)
  }

  pub fn size_of(ty: Int): Int {
    k = kind(ty)
    if k == mk_void() {
      return 0
    }
    if k == mk_bool() {
      return 1
    }
    if k == mk_int() || k == mk_f64() {
      return self.all[ty].bits / 8
    }
    if k == mk_agg() {
      return self.layouts[self.all[ty].layout].size
    }
    8
  }

  pub fn align_of(ty: Int): Int {
    k = kind(ty)
    if k == mk_agg() {
      return self.layouts[self.all[ty].layout].align
    }
    s = size_of(ty)
    if s < 1 {
      return 1
    }
    s
  }

  // Appends the heap reference words and the root words of a value of type
  // ty at byte offset base (2.10). Code words are neither.
  pub fn words(ty: Int, base: Int, refs: Array(Int), roots: Array(Int)) {
    k = kind(ty)
    if is_refkind(ty) {
      refs.push(base / 8)
      roots.push(base / 8)
    } else if k == mk_ptr() || k == mk_addr() {
      roots.push(base / 8)
    } else if k == mk_agg() {
      l = self.layouts[self.all[ty].layout]
      i = 0
      while i < l.fields.size {
        words(l.fields[i], base + l.offsets[i], refs, roots)
        i += 1
      }
    }
  }

  pub fn root_count(ty: Int): Int {
    refs: Array(Int) = []
    roots: Array(Int) = []
    words(ty, 0, refs, roots)
    roots.size
  }

  // Traced: the type has root words. Reference-carrying: heap ref words.
  pub fn traced(ty: Int): Bool {
    root_count(ty) > 0
  }

  pub fn ref_carrying(ty: Int): Bool {
    refs: Array(Int) = []
    roots: Array(Int) = []
    words(ty, 0, refs, roots)
    refs.size > 0
  }

  pub fn is_refkind(ty: Int): Bool {
    k = kind(ty)
    k == mk_ref() || k == mk_str() || k == mk_task()
  }

  pub fn is_int(ty: Int): Bool {
    kind(ty) == mk_int()
  }

  pub fn is_signed_int(ty: Int): Bool {
    is_int(ty) && self.all[ty].signed
  }

  pub fn is_ptr(ty: Int): Bool {
    kind(ty) == mk_ptr()
  }

  pub fn is_addr(ty: Int): Bool {
    kind(ty) == mk_addr()
  }

  pub fn layout_of(ty: Int): Int {
    if ty < 0 || ty >= self.all.size {
      return -1
    }
    self.all[ty].layout
  }

  pub fn pointee(ty: Int): Int {
    if ty < 0 || ty >= self.all.size {
      return -1
    }
    self.all[ty].pointee
  }

  // compat (2.11). at_call adds the call-result retyping: untyped `ref`
  // to any reference, and untyped `addr` (the slot rows' result) to any
  // `addr T`.
  pub fn compat(src: Int, dst: Int, at_call: Bool): Bool {
    if src < 0 || dst < 0 {
      return false
    }
    if src == dst {
      return true
    }
    if dst == mt_ref() && is_refkind(src) {
      return true
    }
    if dst == mt_ptr() && (is_ptr(src) || kind(src) == mk_code()) {
      return true
    }
    if at_call {
      if src == mt_ref() && is_refkind(dst) {
        return true
      }
      if src == mt_addr() && is_addr(dst) {
        return true
      }
    }
    false
  }
}
