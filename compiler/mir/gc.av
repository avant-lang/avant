// The GC passes before emission (Stage 28 W6a; stages/stage28/mir.md 5.7,
// 5.9 steps 2 and 3, W6a): the leaf pass, then the root-slot pass (the
// frame pass). They replace W5's stand-in (frames.av, every traced local a
// slot). Both run on stage-lowered MIR, where every Avant callee is marked
// `collects` and every kind is unset, and leave a module that
// verify(final) accepts by construction: the slot rule below is V11 and
// V12's own liveness, so nothing the verifier asks for can be missing.
//
// 1. Leaves (5.7; V15, V19): every function but `main` whose kind is
//    still unset starts as a candidate; in a shared module (section 7) a function with a local
//    that has root words is not one (V19: another thread can collect at
//    any time). A candidate with a collecting call to an external, an
//    indirect call, or a call to an Avant function outside the set leaves
//    it, to a fixpoint (recursion stays in). Candidates become `leaf`,
//    and every call to an Avant function is re-marked by its callee's
//    kind (V18).
// 2. Frames (5.1, 5.2; V11, V12, V16, V17): every other function becomes
//    `frame`. A local is a slot when its type has root words (2.10) and
//    (a) it is live after a `collects` call that does not define it, or
//    (b) its address is taken (an `addr` or `addr.raw` of a frame-local
//    place based on it), or (c) it is passed as a bare `copy _k` argument
//    to a `collects` call of an external: the runtime's C helpers may
//    collect while they hold their arguments (with AVANT_NURSERY=0 the
//    outermost avant_gc_defer_enter runs a full collection that relies on
//    the caller having rooted them, runtime/avant_gc_roots.c; the old
//    back end spilled every such argument into a root, audit 4.3.2), or to
//    (until Stage 28 W15a1, also of a row of the old quiet class, whose
//    rows are now never or collects).
//    Then the prologue of 5.1 (zero every non-parameter slot, gc.enter,
//    gc.roots of every slot in local order) and a gc.leave before each
//    return.
// 3. Polls (Stage 28 W17a; gc-design.md 4.4, the safepoints of a shared
//    program): in a shared module, before the slot set is computed, every
//    block a back edge enters (an edge to a block whose number is not
//    greater than its source's, so every cycle has one) begins with
//    `call avant_gc_poll() collects`, a collecting call like any other,
//    when the loop it heads holds another loop's head (an outer loop,
//    Stage 28 W17b), or when every reference live on entry to that block
//    is already a slot (an innermost loop that keeps a reference only in
//    a local does not poll, as a leaf's does not: the poll would make it
//    a slot, reloaded after the poll at every iteration, which kept
//    Matmul's inner loops from hoisting their rows: +6-11% with every
//    loop polling and plain slots, W17b; 2.4x with W17a's volatile
//    slots, D207, D259). So a collection waits at most for one run of
//    such an innermost loop. The emitter tests the request flag and
//    calls only when it is set. Leaves have no frame and do not poll
//    (rule 5, V15); an unshared module is unchanged.

import source
import mir.types
import mir.ir
import mir.runtime
import mir.flow

fn mir_in_set(cand: Hash(String, Int), name: String): Bool {
  if v = cand.get(name) {
    return v == 1
  }
  false
}

fn mir_call_blocks_leaf(m: MModule, st: MStmt, cand: Hash(String, Int)): Bool {
  if st.kind != msk_call() {
    return false
  }
  if fo = st.indirect {
    return true
  }
  if f = m.func(st.callee) {
    return !mir_in_set(cand, st.callee)
  }
  if str_starts(st.callee, "av.") {
    return true
  }
  st.collects
}

fn mir_func_blocks_leaf(m: MModule, f: MFunc, cand: Hash(String, Int)): Bool {
  for blk in f.blocks {
    for stmt in blk.stmts {
      if mir_call_blocks_leaf(m, stmt, cand) {
        return true
      }
    }
  }
  false
}

// V19: whether f holds root words in any local (parameters included).
fn mir_holds_roots(m: MModule, f: MFunc): Bool {
  k = 0
  while k < f.locals.size {
    if f.valid_local(k) && m.types.traced(f.locals[k].ty) {
      return true
    }
    k = k + 1
  }
  false
}

fn mir_mark_calls(m: MModule, f: MFunc) {
  for blk in f.blocks {
    for st in blk.stmts {
      if st.kind == msk_call() {
        if g = m.func(st.callee) {
          st.collects = g.kind != mfk_leaf()
        }
      }
    }
  }
}

// The leaf pass (step 2 of 5.9).
pub fn mir_leaf_pass(m: MModule) {
  cand = Hash(String, Int).new
  for f in m.funcs {
    if f.kind == mfk_unset() && f.symbol != "main" && !(m.shared && mir_holds_roots(m, f)) {
      cand[f.symbol] = 1
    }
  }
  changed = true
  while changed {
    changed = false
    for f in m.funcs {
      if mir_in_set(cand, f.symbol) && mir_func_blocks_leaf(m, f, cand) {
        cand[f.symbol] = 0
        changed = true
      }
    }
  }
  for f in m.funcs {
    if mir_in_set(cand, f.symbol) {
      f.kind = mfk_leaf()
    }
  }
  for fdef in m.funcs {
    mir_mark_calls(m, fdef)
  }
}

// Whether st calls an external (not an Avant function, not indirect).
fn mir_calls_external(m: MModule, st: MStmt): Bool {
  if fo = st.indirect {
    return false
  }
  if f = m.func(st.callee) {
    return false
  }
  true
}

// The slot set of a frame function (rules a, b, c above), as one flag per
// local, from the function's liveness lv (flow.av).
pub fn mir_slot_need(m: MModule, f: MFunc, lv: MLive): Array(Bool) {
  ts = m.types
  n = f.locals.size
  nw = lv.nw
  need = mir_zero_words(nw)
  live = mir_zero_words(nw)
  reads: Array(Int) = []
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    mir_words_load(live, lv.outs, b * nw, nw)
    if t = blk.term {
      reads.clear
      mir_term_reads(f, t, reads)
      mir_bits_mark(live, 0, n, reads)
    }
    j = blk.stmts.size - 1
    while j >= 0 {
      st = blk.stmts[j]
      if st.kind == msk_call() && st.collects {
        // every live local but the call's destination
        d = st.dest
        keep_d = d >= 0 && d < n && mir_bit(need, 0, d)
        for w in 0..nw {
          need[w] = need[w] | live[w]
        }
        if d >= 0 && d < n && !keep_d {
          mir_bit_off(need, 0, d)
        }
        if mir_calls_external(m, st) {
          for arg in st.args {
            if p = arg.place {
              if p.proj.size == 0 && p.local >= 0 && p.local < n {
                mir_bit_on(need, 0, p.local)
              }
            }
          }
        }
      }
      if st.kind == msk_assign() {
        if r = st.rv {
          if p = r.place {
            if (r.kind == mrk_addr() || r.kind == mrk_addr_raw()) && p.frame_local && p.local >= 0 && p.local < n {
              mir_bit_on(need, 0, p.local)
            }
          }
        }
      }
      mir_live_step_bits(st, live, n, reads)
      j = j - 1
    }
    b = b + 1
  }
  out = mir_bools(n, false)
  for k in 0..n {
    out[k] = mir_bit(need, 0, k) && f.valid_local(k) && ts.traced(f.locals[k].ty)
  }
  out
}

// The poll's call-table row, declared in the module on first use.
fn mir_declare_poll(m: MModule): Bool {
  if e = m.ext("avant_gc_poll") {
    return true
  }
  if r = m.rt.find("avant_gc_poll") {
    sg = m.rt.sig_of(r, m.types)
    if sg < 0 {
      return false
    }
    x = MExtern.new("avant_gc_poll", sg, r.cls)
    m.extern_index["avant_gc_poll"] = m.externs.size
    m.externs.push(x)
    return true
  }
  false
}

// Rule 3 above: a poll at the head of every block a back edge enters,
// unless it heads an innermost loop and a reference live on entry to it
// is not already a slot (W17a, by measurement: a poll there would make it
// a slot; W17b, by measurement: outer loops poll always, which costs
// nothing measurable on Matmul with plain slots).
fn mir_add_polls(m: MModule, f: MFunc, lv: MLive) {
  n = f.blocks.size
  need0 = mir_slot_need(m, f, lv)
  ts = m.types
  heads = mir_bools(n, false)
  // last[h]: the last block of the loop h heads (its latest back edge's
  // source), so the loop's blocks are h..last[h] in the lowering's order.
  last: Array(Int) = []
  for b in 0..n {
    last.push(-1)
  }
  for b in 0..n {
    succ = mir_succ(f.blocks[b])
    i = 0
    while i < succ.size {
      h = succ[i]
      if h >= 0 && h <= b && h < n {
        heads[h] = true
        if b > last[h] {
          last[h] = b
        }
      }
      i = i + 1
    }
  }
  // An outer loop (one whose blocks hold another loop's head) always
  // polls (Stage 28 W17b): its new slots cost nothing inside the inner
  // loop (no call there, so LLVM keeps a plain slot's value in a
  // register), and a collection then waits at most for one run of an
  // innermost loop.
  outer = mir_bools(n, false)
  for h in 0..n {
    if heads[h] {
      k = h + 1
      while k <= last[h] && k < n {
        if heads[k] {
          outer[h] = true
        }
        k = k + 1
      }
    }
  }
  for h in 0..n {
    if heads[h] && !outer[h] {
      live = mir_live_in_bits(lv, h)
      k = 0
      while k < f.locals.size {
        if mir_bit(live, 0, k) && !need0[k] && f.valid_local(k) && ts.traced(f.locals[k].ty) {
          heads[h] = false
        }
        k = k + 1
      }
    }
  }
  for h in 0..n {
    if heads[h] && mir_declare_poll(m) {
      blk = f.blocks[h]
      loc = f.loc
      if blk.stmts.size > 0 {
        loc = blk.stmts[0].loc
      } else if t = blk.term {
        loc = t.loc
      }
      st = MStmt.new(msk_call(), loc)
      st.callee = "avant_gc_poll"
      st.collects = true
      xs: Array(MStmt) = [st]
      i = 0
      while i < blk.stmts.size {
        xs.push(blk.stmts[i])
        i = i + 1
      }
      blk.stmts = xs
    }
  }
}

// The function's liveness is computed once (Stage 28 W18P, O153): the polls
// read and define nothing, so they leave every block's transfer and
// live-out as they were; so do gc.enter, gc.roots and gc.leave; the
// prologue's zeroing changes bb0's transfer, which is computed again, and
// bb0's live-in, which no live-out depends on since no edge enters bb0
// (V2; with such an edge the liveness is not kept). The function keeps it
// (f.live) for the verifier's V11 and V12.
fn mir_add_frame(m: MModule, f: MFunc) {
  f.kind = mfk_frame()
  lv = mir_live(f)
  if m.shared {
    mir_add_polls(m, f, lv)
  }
  need = mir_slot_need(m, f, lv)
  slots: Array(Int) = []
  k = 0
  while k < f.locals.size {
    if need[k] {
      f.locals[k].slot = true
      slots.push(k)
    }
    k = k + 1
  }
  pro: Array(MStmt) = []
  i = 0
  while i < slots.size {
    if !f.is_param(slots[i]) {
      z = MStmt.new(msk_assign(), f.loc)
      z.place = MPlace.new(slots[i])
      z.rv = MRvalue.new(mrk_zero())
      pro.push(z)
    }
    i = i + 1
  }
  pro.push(MStmt.new(msk_gc_enter(), f.loc))
  roots = MStmt.new(msk_gc_roots(), f.loc)
  roots.locals = slots
  pro.push(roots)
  entry = f.blocks[0]
  i = 0
  while i < entry.stmts.size {
    pro.push(entry.stmts[i])
    i = i + 1
  }
  entry.stmts = pro
  for blk in f.blocks {
    if t = blk.term {
      if t.kind == mtk_return() {
        blk.stmts.push(MStmt.new(msk_gc_leave(), t.loc))
      }
    }
  }
  if f.blocks.size > 0 {
    reads: Array(Int) = []
    mir_live_block(f, lv, 0, reads)
    f.live = lv
    for i in 0..lv.succ.size {
      if lv.succ[i] == 0 {
        f.live = nil
      }
    }
  }
}

// The root-slot pass (step 3 of 5.9): every function the leaf pass left
// unset becomes a frame (a function whose kind was already set, as in the
// selftest's hand-built helpers, is left alone).
pub fn mir_frame_pass(m: MModule) {
  for f in m.funcs {
    if f.kind == mfk_unset() {
      mir_add_frame(m, f)
    }
  }
}

// Both passes, in the order of 5.9.
pub fn mir_gc_passes(m: MModule) {
  mir_leaf_pass(m)
  mir_frame_pass(m)
}
