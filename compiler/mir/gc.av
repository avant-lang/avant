// The GC passes before emission (Stage 28 W6a; stages/stage28/mir.md 5.7,
// 5.9 steps 2 and 3, W6a): the leaf pass, then the root-slot pass (the
// frame pass). They replace W5's stand-in (frames.av, every traced local a
// slot). Both run on stage-lowered MIR, where every Avant callee is marked
// `collects` and every kind is unset, and leave a module that
// verify(final) accepts by construction: the slot rule below is V11 and
// V12's own liveness, so nothing the verifier asks for can be missing.
//
// 1. Leaves (5.7; V15, V19): every function but `main` whose kind is
//    still unset starts as a candidate; in a shared module (section 7) a function with a local
//    that has root words is not one (V19: another thread can collect at
//    any time). A candidate with a collecting call to an external, an
//    indirect call, or a call to an Avant function outside the set leaves
//    it, to a fixpoint (recursion stays in). Candidates become `leaf`,
//    and every call to an Avant function is re-marked by its callee's
//    kind (V18).
// 2. Frames (5.1, 5.2; V11, V12, V16, V17): every other function becomes
//    `frame`. A local is a slot when its type has root words (2.10) and
//    (a) it is live after a `collects` call that does not define it, or
//    (b) its address is taken (an `addr` or `addr.raw` of a frame-local
//    place based on it), or (c) it is passed as a bare `copy _k` argument
//    to a `collects` call of an external: the runtime's C helpers may
//    collect while they hold their arguments (with AVANT_NURSERY=0 the
//    outermost avant_gc_defer_enter runs a full collection that relies on
//    the caller having rooted them, runtime/avant_rt.c:3384-3407; the old
//    back end spilled every such argument into a root, audit 4.3.2), or to
//    a call of an external of class quiet (W6c: its outermost defer can
//    collect under AVANT_NURSERY=0 the same way).
//    Then the prologue of 5.1 (zero every non-parameter slot, gc.enter,
//    gc.roots of every slot in local order) and a gc.leave before each
//    return.

import source
import mir.types
import mir.ir
import mir.runtime
import mir.flow

fn mir_in_set(cand: Hash(String, Int), name: String): Bool {
  if v = cand.get(name) {
    return v == 1
  }
  false
}

fn mir_call_blocks_leaf(m: MModule, st: MStmt, cand: Hash(String, Int)): Bool {
  if st.kind != msk_call() {
    return false
  }
  if fo = st.indirect {
    return true
  }
  if f = m.func(st.callee) {
    return !mir_in_set(cand, st.callee)
  }
  if str_starts_mir(st.callee, "av.") {
    return true
  }
  st.collects
}

fn mir_func_blocks_leaf(m: MModule, f: MFunc, cand: Hash(String, Int)): Bool {
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    i = 0
    while i < blk.stmts.size {
      if mir_call_blocks_leaf(m, blk.stmts[i], cand) {
        return true
      }
      i = i + 1
    }
    b = b + 1
  }
  false
}

// V19: whether f holds root words in any local (parameters included).
fn mir_holds_roots(m: MModule, f: MFunc): Bool {
  k = 0
  while k < f.locals.size {
    if f.valid_local(k) && m.types.traced(f.locals[k].ty) {
      return true
    }
    k = k + 1
  }
  false
}

fn mir_mark_calls(m: MModule, f: MFunc) {
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    i = 0
    while i < blk.stmts.size {
      st = blk.stmts[i]
      if st.kind == msk_call() {
        if g = m.func(st.callee) {
          st.collects = g.kind != mfk_leaf()
        }
      }
      i = i + 1
    }
    b = b + 1
  }
}

// The leaf pass (step 2 of 5.9).
pub fn mir_leaf_pass(m: MModule) {
  cand = Hash(String, Int).new
  i = 0
  while i < m.funcs.size {
    f = m.funcs[i]
    if f.kind == mfk_unset() && !str_eq(f.symbol, "main") && !(m.shared && mir_holds_roots(m, f)) {
      cand[f.symbol] = 1
    }
    i = i + 1
  }
  changed = true
  while changed {
    changed = false
    i = 0
    while i < m.funcs.size {
      f = m.funcs[i]
      if mir_in_set(cand, f.symbol) {
        if mir_func_blocks_leaf(m, f, cand) {
          cand[f.symbol] = 0
          changed = true
        }
      }
      i = i + 1
    }
  }
  i = 0
  while i < m.funcs.size {
    f = m.funcs[i]
    if mir_in_set(cand, f.symbol) {
      f.kind = mfk_leaf()
    }
    i = i + 1
  }
  i = 0
  while i < m.funcs.size {
    mir_mark_calls(m, m.funcs[i])
    i = i + 1
  }
}

// Whether st calls an external (not an Avant function, not indirect).
fn mir_calls_external(m: MModule, st: MStmt): Bool {
  if fo = st.indirect {
    return false
  }
  if f = m.func(st.callee) {
    return false
  }
  true
}

// Whether st calls an external of class quiet (a nocollect call in a
// module that is not shared).
fn mir_calls_quiet(m: MModule, st: MStmt): Bool {
  if !mir_calls_external(m, st) {
    return false
  }
  if e = m.ext(st.callee) {
    return e.cls == mcc_quiet()
  }
  false
}

// The slot set of a frame function (rules a, b, c above), as one flag per
// local.
pub fn mir_slot_need(m: MModule, f: MFunc): Array(Bool) {
  ts = m.types
  n = f.locals.size
  need = mir_bools(n, false)
  outs = mir_live_out(f)
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    live = mir_bools_copy(outs[b])
    if t = blk.term {
      reads: Array(Int) = []
      mir_term_reads(f, t, reads)
      i = 0
      while i < reads.size {
        live[reads[i]] = true
        i = i + 1
      }
    }
    j = blk.stmts.size - 1
    while j >= 0 {
      st = blk.stmts[j]
      if st.kind == msk_call() && st.collects {
        k = 0
        while k < n {
          if live[k] && k != st.dest {
            need[k] = true
          }
          k = k + 1
        }
        if mir_calls_external(m, st) {
          i = 0
          while i < st.args.size {
            if p = st.args[i].place {
              if p.proj.size == 0 {
                need[p.local] = true
              }
            }
            i = i + 1
          }
        }
      } else if st.kind == msk_call() && mir_calls_quiet(m, st) {
        // (c) also for a quiet row (W6c): it collects nothing with the
        // nursery on, but its outermost avant_gc_defer_enter runs a full
        // collection under AVANT_NURSERY=0 (section 14, 8.8), and the
        // old back end roots these arguments (builtins.av emit_hash_set).
        i = 0
        while i < st.args.size {
          if p = st.args[i].place {
            if p.proj.size == 0 {
              need[p.local] = true
            }
          }
          i = i + 1
        }
      }
      if st.kind == msk_assign() {
        if r = st.rv {
          if p = r.place {
            if (r.kind == mrk_addr() || r.kind == mrk_addr_raw()) && p.frame_local {
              need[p.local] = true
            }
          }
        }
      }
      mir_live_step(st, live)
      j = j - 1
    }
    b = b + 1
  }
  k = 0
  while k < n {
    need[k] = need[k] && f.valid_local(k) && ts.traced(f.locals[k].ty)
    k = k + 1
  }
  need
}

fn mir_add_frame(m: MModule, f: MFunc) {
  f.kind = mfk_frame()
  need = mir_slot_need(m, f)
  slots: Array(Int) = []
  k = 0
  while k < f.locals.size {
    if need[k] {
      f.locals[k].slot = true
      slots.push(k)
    }
    k = k + 1
  }
  pro: Array(MStmt) = []
  i = 0
  while i < slots.size {
    if !f.is_param(slots[i]) {
      z = MStmt.new(msk_assign(), f.loc)
      z.place = MPlace.new(slots[i])
      z.rv = MRvalue.new(mrk_zero())
      pro.push(z)
    }
    i = i + 1
  }
  pro.push(MStmt.new(msk_gc_enter(), f.loc))
  roots = MStmt.new(msk_gc_roots(), f.loc)
  roots.locals = slots
  pro.push(roots)
  entry = f.blocks[0]
  i = 0
  while i < entry.stmts.size {
    pro.push(entry.stmts[i])
    i = i + 1
  }
  entry.stmts = pro
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    if t = blk.term {
      if t.kind == mtk_return() {
        blk.stmts.push(MStmt.new(msk_gc_leave(), t.loc))
      }
    }
    b = b + 1
  }
}

// The root-slot pass (step 3 of 5.9): every function the leaf pass left
// unset becomes a frame (a function whose kind was already set, as in the
// selftest's hand-built helpers, is left alone).
pub fn mir_frame_pass(m: MModule) {
  i = 0
  while i < m.funcs.size {
    f = m.funcs[i]
    if f.kind == mfk_unset() {
      mir_add_frame(m, f)
    }
    i = i + 1
  }
}

// Both passes, in the order of 5.9.
pub fn mir_gc_passes(m: MModule) {
  mir_leaf_pass(m)
  mir_frame_pass(m)
}
