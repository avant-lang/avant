// The GC passes before emission: the leaf pass, then
// the root-slot pass (the frame pass). They replace an earlier stand-in
// (frames.av, every traced local a slot). Both run on stage-lowered MIR,
// where every Avant callee is marked `collects` and every kind is unset,
// and leave a module that verify(final) accepts by construction: the slot
// rule below is V11 and V12's own liveness, so nothing the verifier asks
// for can be missing.
//
// 1. Leaves (V15, V19): every function but `main` whose kind is still
//    unset starts as a candidate; in a shared module a function with a
//    local that has root words is not one (V19: another thread can
//    collect at any time). A candidate with a collecting call to an
//    external, an indirect call, or a call to an Avant function outside
//    the set leaves it, to a fixpoint (recursion stays in). Candidates
//    become `leaf`, and every call to an Avant function is re-marked by
//    its callee's kind (V18).
// 2. Frames (V11, V12, V16, V17): every other function becomes
//    `frame`. A local is a slot when its type has root words and
//    (a) it is live after a `collects` call that does not define it, or
//    (b) its address is taken (an `addr` or `addr.raw` of a frame-local
//    place based on it), or (c) it is passed as a bare `copy _k` argument
//    to a `collects` call of an external: the runtime's C helpers may
//    collect while they hold their arguments (with AVANT_NURSERY=0 the
//    outermost avant_gc_defer_enter runs a full collection that relies on
//    the caller having rooted them, runtime/avant_gc_roots.c; the old
//    back end spilled every such argument into a root), or to
//    (once also of a row of the old quiet class, whose
//    rows are now never or collects).
//    Then the frame prologue (zero every non-parameter slot, gc.enter,
//    gc.roots of every slot in local order) and a gc.leave before each
//    return.
//    A frame function with no slot links no frame record: no gc.enter,
//    gc.roots or gc.leave. It holds no
//    reference across any collecting call (a reference live there would
//    be a slot by (a), an argument of an external's call by (c)), so no
//    collection below it has anything of it to find or to move, and a
//    record costs its link and unlink at every call (a constructor whose
//    arguments hold no reference then inlines).
//    The first-frame rule: a function a thread's first Avant frame can
//    belong to keeps its record even with no slot: `main`, a C
//    callback's thunk and a task's thunk (MFunc.first_frame). Its record is
//    what registers a thread C started (avant_gc_frame_enter), returns a
//    foreign thread to running for the callback and to native after it
//    (the safepoint rule), and initializes the heap; so every
//    other Avant function runs below a frame record of its thread, as
//    before, and a function without one needs nothing from the chain. A
//    shared module follows the same rule: a thread stops only at a
//    collecting call (a poll, an allocation, a native transition), where
//    a function without a slot holds nothing (the safepoints). What
//    the rule changes is a diagnostic's reach: the stalled-handshake
//    report (AVANT_GC_VERIFY_STALL_MS) names the innermost frame record,
//    now the innermost function that has one.
// 3. Polls (the safepoints of a shared program): in a shared module,
//    before the slot set is computed, every block a back edge enters (an
//    edge into a block on the path of a depth-first walk from the entry,
//    so every cycle has one and no other edge is one) begins with
//    `call avant_gc_poll() collects`, a collecting call like any other,
//    when the loop it heads holds another loop's head (an outer loop), or
//    when every reference live on entry to that block is already a slot
//    (an innermost loop that keeps a reference only in a local does not
//    poll, as a leaf's does not: the poll would make it a slot, reloaded
//    after the poll at every iteration, which kept Matmul's inner loops
//    from hoisting their rows: +6-11% with every loop polling and plain
//    slots; 2.4x with volatile slots). So a collection waits at most for
//    one run of such an innermost loop. The emitter tests the request flag
//    and calls only when it is set. Leaves have no frame and do not poll
//    (rule 5, V15); an unshared module is unchanged.

import source
import mir.types
import mir.ir
import mir.runtime
import mir.flow
import mir.fresh

fn mir_call_blocks_leaf(m: MModule, st: MStmt, cand: Set(String)): Bool {
  if st.kind != msk_call() {
    return false
  }
  if fo = st.indirect {
    return true
  }
  if f = m.func(st.callee) {
    return !cand.has(st.callee)
  }
  if st.callee.starts_with("av.") {
    return true
  }
  st.collects
}

fn mir_func_blocks_leaf(m: MModule, f: MFunc, cand: Set(String)): Bool {
  for blk in f.blocks {
    for stmt in blk.stmts {
      if mir_call_blocks_leaf(m, stmt, cand) {
        return true
      }
    }
  }
  false
}

// V19: whether f holds root words in any local (parameters included).
fn mir_holds_roots(m: MModule, f: MFunc): Bool {
  k = 0
  while k < f.locals.size {
    if f.valid_local(k) && m.types.traced(f.locals[k].ty) {
      return true
    }
    k += 1
  }
  false
}

fn mir_mark_calls(m: MModule, f: MFunc) {
  for blk in f.blocks {
    for st in blk.stmts {
      if st.kind == msk_call() {
        if g = m.func(st.callee) {
          st.collects = g.kind != mfk_leaf()
        }
      }
    }
  }
}

// The leaf pass (the first pass after the lowering).
pub fn mir_leaf_pass(m: MModule) {
  cand = Set(String).new()
  for f in m.funcs {
    if f.kind == mfk_unset() && f.symbol != "main" && !(m.shared && mir_holds_roots(m, f)) {
      cand.add(f.symbol)
    }
  }
  changed = true
  while changed {
    changed = false
    for f in m.funcs {
      if cand.has(f.symbol) && mir_func_blocks_leaf(m, f, cand) {
        cand.delete(f.symbol)
        changed = true
      }
    }
  }
  for f in m.funcs {
    if cand.has(f.symbol) {
      f.kind = mfk_leaf()
    }
  }
  for fdef in m.funcs {
    mir_mark_calls(m, fdef)
  }
}

// Whether st calls an external (not an Avant function, not indirect).
fn mir_calls_external(m: MModule, st: MStmt): Bool {
  if fo = st.indirect {
    return false
  }
  if f = m.func(st.callee) {
    return false
  }
  true
}

// The slot set of a frame function (rules a, b, c above), as one flag per
// local, from the function's liveness lv (flow.av).
pub fn mir_slot_need(m: MModule, f: MFunc, lv: MLive): Array(Bool) {
  ts = m.types
  n = f.locals.size
  nw = lv.nw
  need = mir_zero_words(nw)
  live = mir_zero_words(nw)
  reads: Array(Int) = []
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    mir_words_load(live, lv.outs, b * nw, nw)
    if t = blk.term {
      reads.clear()
      mir_term_reads(f, t, reads)
      mir_bits_mark(live, 0, n, reads)
    }
    j = blk.stmts.size - 1
    while j >= 0 {
      st = blk.stmts[j]
      if st.kind == msk_call() && st.collects {
        // every live local but the call's destination
        d = st.dest
        keep_d = d >= 0 && d < n && mir_bit(need, 0, d)
        for w in 0..nw {
          need[w] = need[w] | live[w]
        }
        if d >= 0 && d < n && !keep_d {
          mir_bit_off(need, 0, d)
        }
        if mir_calls_external(m, st) {
          for arg in st.args {
            if p = arg.place, p.proj.size == 0 && p.local >= 0 && p.local < n {
              mir_bit_on(need, 0, p.local)
            }
          }
        }
      }
      if st.kind == msk_assign() {
        if r = st.rv, p = r.place, (r.kind == mrk_addr() || r.kind == mrk_addr_raw()) && p.frame_local() && p.local >= 0 && p.local < n {
          mir_bit_on(need, 0, p.local)
        }
      }
      mir_live_step_bits(st, live, n, reads)
      j -= 1
    }
    b += 1
  }
  out = mir_bools(n, false)
  for k in 0..n {
    out[k] = mir_bit(need, 0, k) && f.valid_local(k) && ts.traced(f.locals[k].ty)
  }
  out
}

// The poll's call-table row, declared in the module on first use.
fn mir_declare_poll(m: MModule): Bool {
  if e = m.ext("avant_gc_poll") {
    return true
  }
  if r = m.rt.find("avant_gc_poll") {
    sg = m.rt.sig_of(r, m.types)
    if sg < 0 {
      return false
    }
    x = MExtern.new("avant_gc_poll", sg, r.cls)
    m.extern_index["avant_gc_poll"] = m.externs.size
    m.externs.push(x)
    return true
  }
  false
}

// Rule 3 above: a poll at the head of every block a back edge enters,
// unless it heads an innermost loop and a reference live on entry to it
// is not already a slot (by measurement: a poll there would make it a
// slot; by measurement: outer loops poll always, which costs nothing
// measurable on Matmul with plain slots).
fn mir_add_polls(m: MModule, f: MFunc, lv: MLive) {
  n = f.blocks.size
  need0 = mir_slot_need(m, f, lv)
  ts = m.types
  // The loop heads (mir/flow.av): a real cycle's, by a depth-first
  // walk; last[h] is the latest back edge's source, so the loop's
  // blocks are h..last[h] in the lowering's order.
  last: Array(Int) = []
  heads = mir_loop_heads(f, last)
  // An outer loop (one whose blocks hold another loop's head) always
  // polls: its new slots cost nothing inside the inner loop (no call
  // there, so LLVM keeps a plain slot's value in a register), and a
  // collection then waits at most for one run of an innermost loop.
  outer = mir_bools(n, false)
  for h in 0..n {
    if heads[h] {
      k = h + 1
      while k <= last[h] && k < n {
        if heads[k] {
          outer[h] = true
        }
        k += 1
      }
    }
  }
  for h in 0..n {
    if heads[h] && !outer[h] {
      live = mir_live_in_bits(lv, h)
      k = 0
      while k < f.locals.size {
        if mir_bit(live, 0, k) && !need0[k] && f.valid_local(k) && ts.traced(f.locals[k].ty) {
          heads[h] = false
        }
        k += 1
      }
    }
  }
  for h in 0..n {
    if heads[h] && mir_declare_poll(m) {
      blk = f.blocks[h]
      loc = f.loc
      if blk.stmts.size > 0 {
        loc = blk.stmts[0].loc
      } else if t = blk.term {
        loc = t.loc
      }
      st = MStmt.new(msk_call(), loc)
      st.callee = "avant_gc_poll"
      st.collects = true
      xs: Array(MStmt) = [st]
      xs.concat(blk.stmts)
      blk.stmts = xs
    }
  }
}

// The stale-slot sets: for each block, the slots (of cand) that a
// collecting call can find still holding the value they had on entry to
// the block, that is, a collecting call is reachable from there before
// the slot is defined again (a call that defines the slot counts: the
// old value is the slot's while the call runs). The backward transfer of
// a block is (out & ~kill) | gen, from its statements: a definition
// leaves, a collecting call makes every slot stale. The least solution,
// from empty sets, as the liveness's.
fn mir_stale_in(f: MFunc, lv: MLive, cand: Array(UInt64)): Array(UInt64) {
  nb = f.blocks.size
  nw = lv.nw
  n = lv.n
  gen = mir_zero_words(nb * nw)
  kill = mir_zero_words(nb * nw)
  for b in 0..nb {
    stmts = f.blocks[b].stmts
    j = stmts.size - 1
    while j >= 0 {
      st = stmts[j]
      if st.kind == msk_call() && st.collects {
        for w in 0..nw {
          gen[b * nw + w] = cand[w]
          kill[b * nw + w] = ~0u64
        }
      } else {
        d = mir_stmt_def(st)
        if d >= 0 && d < n {
          mir_bit_on(kill, b * nw, d)
          mir_bit_off(gen, b * nw, d)
        }
      }
      j -= 1
    }
  }
  ins = mir_zero_words(nb * nw)
  changed = true
  while changed {
    changed = false
    b = nb - 1
    while b >= 0 {
      at = b * nw
      for w in 0..nw {
        x = 0u64
        for i in lv.succ_at[b]..lv.succ_at[b + 1] {
          x = x | ins[lv.succ[i] * nw + w]
        }
        y = gen[at + w] | (x & ~kill[at + w])
        if y != ins[at + w] {
          ins[at + w] = y
          changed = true
        }
      }
      b -= 1
    }
  }
  ins
}

// Where a clear that follows stmts[j] goes: after the heap stores that
// follow it, since a store must come right after its barrier, or after
// the call that gave the slot it stores through (V13).
fn mir_clear_at(blk: MBlock, j: Int): Int {
  at = j
  while at + 1 < blk.stmts.size && blk.stmts[at + 1].kind == msk_assign() {
    if p = blk.stmts[at + 1].place, !p.frame_local() {
      at += 1
    } else {
      return at
    }
  }
  at
}

fn mir_clear_stmt(k: Int, loc: MLoc): MStmt {
  z = MStmt.new(msk_assign(), loc)
  z.place = MPlace.new(k)
  z.rv = MRvalue.new(mrk_zero())
  z
}

// A slot whose value is dead is cleared where it dies, when a collecting
// call can come before the slot is written again: otherwise the frame
// keeps naming the dead object, and that collection keeps it (and
// everything it reaches) alive. The common case is a reassignment from a
// call in a loop, `w = make_work(...)`: the old value dies before the
// call, and without the clear the slot holds it while the call allocates
// the new one. A slot dies after a statement that reads or defines it
// when it is not live after it, and on entry to a block it is not live
// into from a predecessor where it is live (or that its terminator
// reads). A path on which no collecting call comes before the slot's
// next definition (a loop whose only call is on another branch) gets no
// clear. A slot whose address is taken is never cleared (a pointer to it
// may be read where the liveness does not see it). A clear defines a
// local where it is dead, so it changes no block's liveness, only the
// transfer of the blocks it is added to, which is computed again.
fn mir_clear_dead_slots(f: MFunc, lv: MLive, need: Array(Bool)) {
  n = f.locals.size
  nw = lv.nw
  nb = f.blocks.size
  if nb == 0 {
    return
  }
  cand = mir_zero_words(nw)
  any = false
  for k in 0..n {
    if need[k] {
      mir_bit_on(cand, 0, k)
      any = true
    }
  }
  if !any {
    return
  }
  for blk in f.blocks {
    for st in blk.stmts {
      if r = st.rv, p = r.place, (r.kind == mrk_addr() || r.kind == mrk_addr_raw()) && p.frame_local() && p.local >= 0 && p.local < n {
        mir_bit_off(cand, 0, p.local)
      }
    }
  }
  stale_in = mir_stale_in(f, lv, cand)
  // the live set before each block's terminator
  before_term = mir_zero_words(nb * nw)
  reads: Array(Int) = []
  for b in 0..nb {
    for w in 0..nw {
      before_term[b * nw + w] = lv.outs[b * nw + w]
    }
    if t = f.blocks[b].term {
      reads.clear()
      mir_term_reads(f, t, reads)
      mir_bits_mark(before_term, b * nw, n, reads)
    }
  }
  // each block's predecessors, one entry per edge
  preds: Array(Array(Int)) = []
  for b in 0..nb {
    none: Array(Int) = []
    preds.push(none)
  }
  for p in 0..nb {
    for i in lv.succ_at[p]..lv.succ_at[p + 1] {
      preds[lv.succ[i]].push(p)
    }
  }
  live = mir_zero_words(nw)
  stale = mir_zero_words(nw)
  touched: Array(Int) = []
  for b in 0..nb {
    blk = f.blocks[b]
    // entry clears: dead into b, live out of a predecessor, stale in b
    head: Array(MStmt) = []
    if b > 0 {
      lin = mir_live_in_bits(lv, b)
      dead_from = mir_zero_words(nw)
      for p in preds[b] {
        for w in 0..nw {
          dead_from[w] = dead_from[w] | (before_term[p * nw + w] & ~lin[w] & cand[w] & stale_in[b * nw + w])
        }
      }
      loc = f.loc
      if blk.stmts.size > 0 {
        loc = blk.stmts[0].loc
      } else if t = blk.term {
        loc = t.loc
      }
      for k in 0..n {
        if mir_bit(dead_from, 0, k) {
          head.push(mir_clear_stmt(k, loc))
        }
      }
    }
    // clears after the statement where a slot dies, walking back from
    // the block's end with the live and stale sets after each statement
    after: Array(Array(MStmt)) = []
    for j in 0..blk.stmts.size {
      e: Array(MStmt) = []
      after.push(e)
    }
    found = head.size > 0
    for w in 0..nw {
      x = 0u64
      for i in lv.succ_at[b]..lv.succ_at[b + 1] {
        x = x | stale_in[lv.succ[i] * nw + w]
      }
      stale[w] = x
    }
    mir_words_load(live, before_term, b * nw, nw)
    j = blk.stmts.size - 1
    while j >= 0 {
      st = blk.stmts[j]
      reads.clear()
      mir_stmt_reads(st, reads)
      d = mir_stmt_def(st)
      if d >= 0 {
        reads.push(d)
      }
      for k in reads {
        if k >= 0 && k < n && mir_bit(cand, 0, k) && mir_bit(stale, 0, k) && !mir_bit(live, 0, k) {
          at = mir_clear_at(blk, j)
          dup = false
          for z in after[at] {
            if zp = z.place, zp.local == k {
              dup = true
            }
          }
          if !dup {
            after[at].push(mir_clear_stmt(k, st.loc))
            found = true
          }
        }
      }
      if st.kind == msk_call() && st.collects {
        for w in 0..nw {
          stale[w] = cand[w]
        }
      } else if d >= 0 && d < n {
        mir_bit_off(stale, 0, d)
      }
      mir_live_step_bits(st, live, n, reads)
      j -= 1
    }
    if found {
      xs: Array(MStmt) = []
      xs.concat(head)
      for j2 in 0..blk.stmts.size {
        xs.push(blk.stmts[j2])
        xs.concat(after[j2])
      }
      blk.stmts = xs
      touched.push(b)
    }
  }
  for b in touched {
    mir_live_block(f, lv, b, reads)
  }
}

// The function's liveness is computed once: the polls read and define
// nothing, so they leave every block's transfer and live-out as they were;
// so do gc.enter, gc.roots and gc.leave; the prologue's zeroing changes
// bb0's transfer, which is computed again, and bb0's live-in, which no
// live-out depends on since no edge enters bb0 (V2; with such an edge the
// liveness is not kept). The function keeps it (f.live) for the verifier's
// V11 and V12.
fn mir_add_frame(m: MModule, f: MFunc) {
  f.kind = mfk_frame()
  lv = mir_live(f)
  if m.shared {
    mir_add_polls(m, f, lv)
  }
  need = mir_slot_need(m, f, lv)
  slots: Array(Int) = []
  k = 0
  while k < f.locals.size {
    if need[k] {
      f.locals[k].slot = true
      slots.push(k)
    }
    k += 1
  }
  if slots.size > 0 {
    mir_clear_dead_slots(f, lv, need)
  }
  if slots.size == 0 && !f.first_frame() {
    // No record (rule 2 above): nothing is added, so the liveness is
    // still the function's own, every block's transfer included.
    f.live = lv
    return
  }
  pro: Array(MStmt) = []
  i = 0
  while i < slots.size {
    if !f.is_param(slots[i]) {
      z = MStmt.new(msk_assign(), f.loc)
      z.place = MPlace.new(slots[i])
      z.rv = MRvalue.new(mrk_zero())
      pro.push(z)
    }
    i += 1
  }
  pro.push(MStmt.new(msk_gc_enter(), f.loc))
  roots = MStmt.new(msk_gc_roots(), f.loc)
  roots.locals = slots
  pro.push(roots)
  entry = f.blocks[0]
  pro.concat(entry.stmts)
  entry.stmts = pro
  for blk in f.blocks {
    if t = blk.term, t.kind == mtk_return() {
      blk.stmts.push(MStmt.new(msk_gc_leave(), t.loc))
    }
  }
  if f.blocks.size > 0 {
    reads: Array(Int) = []
    mir_live_block(f, lv, 0, reads)
    f.live = lv
    for ix in 0..lv.succ.size {
      if lv.succ[ix] == 0 {
        f.live = nil
      }
    }
  }
}

// The root-slot pass (after the leaf pass): every function the leaf pass left
// unset becomes a frame (a function whose kind was already set, as in the
// selftest's hand-built helpers, is left alone).
pub fn mir_frame_pass(m: MModule) {
  for f in m.funcs {
    if f.kind == mfk_unset() {
      mir_add_frame(m, f)
    }
  }
}

// Both passes, the leaf pass first.
pub fn mir_gc_passes(m: MModule) {
  mir_leaf_pass(m)
  // Barriers on open holders go before the slot set is computed
  // (fresh.av).
  mir_fresh_pass(m)
  mir_frame_pass(m)
}
