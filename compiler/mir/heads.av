// Array header words out of loops: a loop that reads the size or the
// buffer reference of an Array it never reassigns,
//
//   for u in adj[v] { if !visited[u] { visited[u] = true; queue.push(u) } }
//
// reads `(*_a).1` (the size) and `(*_a).0` (the buffer) of the row and of
// `visited` at every element. LLVM cannot keep them in registers: the
// loop holds a call (the push's growth) and a store to an Array's size
// (the push's fast path) on some paths, so its loop-invariant motion
// takes nothing out, and the loads stay on every path, the common one
// that calls and stores nothing included (four loads an element of
// Graph::BFS's search, twice C's loads). This pass reads each such word
// once before the loop into a local, makes the loop's reads copies of
// that local, and reads the word again after each statement of the loop
// that may change it (where it is next read, or at the end of that
// block), so a path that changes nothing reads nothing:
//
// - the size, after a statement that may change an existing Array's size
//   or buffer: a call outside the runtime helpers that keep every size
//   (loops.av, mir_lv_keeps_sizes; growth, the one place a buffer is
//   replaced in place, comes only through calls outside that list), a
//   call to a module function that does so transitively (the summary,
//   mir_lv_summary), an indirect call, or a store into the size or
//   buffer word of an Array that was not allocated earlier in the same
//   block;
// - the buffer reference, after those and after every call that may
//   collect (a collection may move the buffer; mir_lv_call_collects).
//
// So the loop reads exactly the values it read before: between two
// statements that may change a word, nothing changes it. Which array:
// a local of Array type the loop never writes and whose address is never
// taken (a root slot the collector updates is such a local: the word is
// read again after each collecting call, through the slot). Null: a
// local read through in the loop's header block is read in the preheader
// unguarded (the header would have read it there first); any other is
// read in the preheader only when it is not null (else the local starts
// as zero), and is a candidate only when every statement after which it
// is read again follows, in the same iteration, a statement that reads
// through it, so the read again never meets a null the loop would not
// have met first. Programs with threads are left alone (another thread
// collects at this one's safepoints, which the loop's calls do not
// list). Only innermost loops that hold a call and are not a few
// iterations long are taken, and only a word some iteration can run
// without reading again (hd_func and hd_hoist_one say why); a word read
// again after a statement is never taken out a second time (its local is
// marked).

import source
import mir.types
import mir.ir
import mir.flow
import mir.loops

fn hd_new_local(f: MFunc, ty: Int): Int {
  f.locals.push(MLocal.new(ty, ""))
  f.locals.size - 1
}

fn hd_copy_local(local: Int): MOperand {
  o = MOperand.new(mok_copy(), -1)
  o.place = MPlace.new(local)
  o
}

fn hd_assign(loc: MLoc, dest: Int, rv: MRvalue): MStmt {
  st = MStmt.new(msk_assign(), loc)
  st.place = MPlace.new(dest)
  st.rv = rv
  st
}

fn hd_use(o: MOperand): MRvalue {
  r = MRvalue.new(mrk_use())
  r.a = o
  r
}

// `copy (*_a).k`
fn hd_word(a: Int, k: Int): MOperand {
  p = MPlace.new(a)
  p.proj.push(MProj.new(mpk_deref(), 0))
  p.proj.push(MProj.new(mpk_field(), k))
  o = MOperand.new(mok_copy(), -1)
  o.place = p
  o
}

// What one function's loops share, computed once (the pass runs over
// every function of every program, the compiler's own included): the
// locals whose address is taken, the blocks' predecessors (a loop's
// preheader changes only its own header's), a mark per local stamped
// with the loop being looked at (its locals defined in the body), and,
// when first asked, each local's count of definitions and the constant
// a single definition gives it.
class HdCtx {
  addr: Array(Bool)
  preds: Array(Array(Int))
  mark: Array(Int) = []
  stamp: Int = 0
  ndef: Array(Int) = []
  cval: Array(Int) = []
  consts: Bool = false

  fn initialize(f: MFunc) {
    self.addr = hd_addr_taken(f)
    self.preds = mir_preds(f)
  }
}

fn hd_grow(made: Array(Bool), f: MFunc) {
  while made.size < f.locals.size {
    made.push(false)
  }
}

fn hd_is_array(ts: MTypes, ty: Int): Bool {
  if ts.kind(ty) != mk_ref() {
    return false
  }
  lay = ts.get(ty).layout
  lay >= 0 && ts.layouts[lay].kind == mlk_array()
}

// The header word a statement reads, `_x = copy (*_a).k` with k the
// buffer (0) or the size (1): out[0] = _a, out[1] = k; else false.
fn hd_match(ts: MTypes, f: MFunc, st: MStmt, out: Array(Int)): Bool {
  if st.kind != msk_assign() || mir_stmt_def(st) < 0 {
    return false
  }
  rv = st.rv ?? MRvalue.new(0)
  if rv.kind != mrk_use() {
    return false
  }
  a = rv.a ?? MOperand.new(0, -1)
  if a.kind != mok_copy() {
    return false
  }
  p = a.place ?? MPlace.new(-1)
  if p.local < 0 || p.proj.size != 2 || p.proj[0].kind != mpk_deref() || p.proj[1].kind != mpk_field() {
    return false
  }
  if p.proj[1].field != 0 && p.proj[1].field != 1 {
    return false
  }
  if !hd_is_array(ts, f.locals[p.local].ty) {
    return false
  }
  out[0] = p.local
  out[1] = p.proj[1].field
  true
}

fn hd_place_derefs(p: MPlace?, a: Int): Bool {
  if x = p, x.local == a && x.proj.size > 0 && x.proj[0].kind == mpk_deref() {
    return true
  }
  false
}

fn hd_op_derefs(o: MOperand?, a: Int): Bool {
  if x = o {
    return hd_place_derefs(x.place, a)
  }
  false
}

// Whether a statement reads or writes through local a (so a is not null
// after it).
fn hd_derefs(st: MStmt, a: Int): Bool {
  if hd_place_derefs(st.place, a) {
    return true
  }
  if r = st.rv {
    if hd_op_derefs(r.a, a) || hd_op_derefs(r.b, a) || hd_place_derefs(r.place, a) {
      return true
    }
    for o in r.ops {
      if hd_op_derefs(o, a) {
        return true
      }
    }
  }
  false
}

// Whether place p writes the buffer or the size word of an Array (or a
// part whose shape is not known).
fn hd_place_writes_header(ts: MTypes, f: MFunc, p: MPlace): Bool {
  ty = f.locals[p.local].ty
  for pr in p.proj {
    mt = ts.get(ty)
    if pr.kind == mpk_deref() {
      if ts.is_refkind(ty) && mt.layout >= 0 {
        ty = ts.agg(mt.layout)
      } else {
        ty = mt.pointee
      }
      if ty < 0 {
        return true
      }
    } else if pr.kind == mpk_field() {
      if mt.layout < 0 {
        return true
      }
      lay = ts.layouts[mt.layout]
      if lay.kind == mlk_array() && (pr.field == 0 || pr.field == 1) {
        return true
      }
      if pr.field >= lay.fields.size {
        return true
      }
      ty = lay.fields[pr.field]
    } else {
      if mt.kind == mk_agg() && mt.layout >= 0 && ts.layouts[mt.layout].kind == mlk_elems() {
        ty = ts.layouts[mt.layout].fields[0]
      }
    }
  }
  // A whole object stored through a reference: any part of it.
  p.proj.size > 0 && p.proj[p.proj.size - 1].kind == mpk_deref()
}

// Whether local h holds, at statement j of blk, an allocation made
// earlier in the same block.
fn hd_fresh_here(blk: MBlock, j: Int, h: Int): Bool {
  k = j - 1
  while k >= 0 {
    st = blk.stmts[k]
    if mir_stmt_def(st) == h {
      return st.kind == msk_call() && (st.callee == "avant_alloc" || st.callee == "avant_alloc_unzeroed")
    }
    k -= 1
  }
  false
}

// Whether statement j of blk may change an existing Array's size or
// buffer word (keep: mir_lv_summary).
fn hd_changes(m: MModule, f: MFunc, blk: MBlock, j: Int, keep: Array(Bool)): Bool {
  st = blk.stmts[j]
  if st.kind == msk_assign() {
    if p = st.place, p.last_deref() >= 0 {
      if !hd_place_writes_header(m.types, f, p) {
        return false
      }
      return !(p.last_deref() == 0 && hd_fresh_here(blk, j, p.local))
    }
    return false
  }
  if st.kind != msk_call() {
    return false
  }
  if fo = st.indirect {
    return true
  }
  if i = m.func_index.get(st.callee) {
    return !keep[i]
  }
  if st.callee.starts_with("av.") {
    return true
  }
  !mir_lv_keeps_sizes(st.callee)
}

// Whether a loop's header compares with a small constant (`for k in
// 0..4`): a loop of a few iterations, which LLVM unrolls, gains less from
// one read an iteration than its preheader costs on every entry
// (Maze::BFS's four neighbours: +14% instructions).
fn hd_short(f: MFunc, hb: MBlock, cx: HdCtx): Bool {
  for st in hb.stmts {
    if r = st.rv, r.kind == mrk_cmp() {
      for o in [r.a, r.b] {
        if x = o {
          c = hd_const_of(f, x, cx)
          if c >= 0 && c <= 16 {
            return true
          }
        }
      }
    }
  }
  false
}

// The value of an operand that is a constant, or a local whose only
// definition in the function is a constant (a range's end); else -1.
fn hd_const_of(f: MFunc, o: MOperand, cx: HdCtx): Int {
  if o.kind == mok_int() {
    return o.ival
  }
  if o.kind != mok_copy() {
    return -1
  }
  p = o.place ?? MPlace.new(-1)
  if p.local < 0 || p.proj.size != 0 {
    return -1
  }
  if !cx.consts {
    cx.consts = true
    for i in 0..f.locals.size {
      cx.ndef.push(0)
      cx.cval.push(-1)
    }
    for blk in f.blocks {
      for st in blk.stmts {
        d = mir_stmt_def(st)
        if d >= 0 && d < cx.ndef.size {
          cx.ndef[d] += 1
          if r = st.rv, r.kind == mrk_use() {
            if a = r.a, a.kind == mok_int() {
              cx.cval[d] = a.ival
            }
          }
        }
      }
    }
  }
  if p.local < cx.ndef.size && cx.ndef[p.local] == 1 {
    return cx.cval[p.local]
  }
  -1
}

fn hd_no_call(name: String): Bool {
  name.starts_with("avant_trap_") || name == "avant_str_size" || name == "avant_str_view_test" || name == "avant_str_data" || name == "avant_buf_size"
}

fn hd_addr_taken(f: MFunc): Array(Bool) {
  out = mir_bools(f.locals.size, false)
  for blk in f.blocks {
    for st in blk.stmts {
      if r = st.rv, p = r.place, (r.kind == mrk_addr() || r.kind == mrk_addr_raw()) && p.frame_local() {
        out[p.local] = true
      }
    }
  }
  out
}

// Per block of the loop body, whether every path from the header to the
// block's end (in one iteration: an edge back into the header starts a
// new one) reads or writes through local a: a forward must-analysis.
// inb gets the same at each block's start.
fn hd_derefed(f: MFunc, body: Array(Bool), hdr: Int, n0: Int, a: Int, preds: Array(Array(Int)), inb: Array(Bool)): Array(Bool) {
  outb = mir_bools(n0, true)
  for b in 0..n0 {
    inb[b] = true
  }
  inb[hdr] = false
  changed = true
  rounds = 0
  while changed && rounds < 1000 {
    changed = false
    for b in 0..n0 {
      if body[b] {
        v = b != hdr
        if b != hdr {
          for p in preds[b] {
            if p < n0 && body[p] && !outb[p] {
              v = false
            }
          }
        }
        inb[b] = v
        for st in f.blocks[b].stmts {
          if hd_derefs(st, a) {
            v = true
          }
        }
        if v != outb[b] {
          outb[b] = v
          changed = true
        }
      }
    }
    rounds += 1
  }
  outb
}

// Whether every statement of the loop after which a's words would be read
// again follows a read through a in the same iteration. clob[b][j] says
// statement j of block b changes a word (either kind).
fn hd_guarded(f: MFunc, body: Array(Bool), hdr: Int, n0: Int, a: Int, clob: Array(Array(Bool)), preds: Array(Array(Int))): Bool {
  inb = mir_bools(n0, false)
  outb = hd_derefed(f, body, hdr, n0, a, preds, inb)
  for b in 0..n0 {
    if body[b] {
      v = inb[b]
      blk = f.blocks[b]
      for j in 0..blk.stmts.size {
        if hd_derefs(blk.stmts[j], a) {
          v = true
        }
        if clob[b][j] && !v {
          return false
        }
      }
    }
  }
  true
}

// Whether some path from the loop's header back to it crosses only
// blocks with no statement that changes the word (chg; with buf, the
// buffer reference, also mov: a collecting call).
fn hd_clean_path(f: MFunc, body: Array(Bool), hdr: Int, n0: Int, preds: Array(Array(Int)), buf: Bool, chg: Array(Array(Bool)), mov: Array(Array(Bool))): Bool {
  clean = mir_bools(n0, false)
  for b in 0..n0 {
    if body[b] {
      c = true
      for j in 0..chg[b].size {
        if chg[b][j] || (buf && mov[b][j]) {
          c = false
        }
      }
      clean[b] = c
    }
  }
  if !clean[hdr] {
    return false
  }
  seen = mir_bools(n0, false)
  work: Array(Int) = [hdr]
  seen[hdr] = true
  while work.size > 0 {
    b = work.pop() ?? hdr
    if t = f.blocks[b].term {
      for x in t.targets {
        if x == hdr {
          return true
        }
        if x < n0 && body[x] && clean[x] && !seen[x] {
          seen[x] = true
          work.push(x)
        }
      }
    }
  }
  false
}

// Takes the header words of one loop out; returns whether one moved.
// made: the locals this pass made (their reads are not taken again).
fn hd_hoist_one(m: MModule, f: MFunc, body: Array(Bool), hdr: Int, keep: Array(Bool), coll: Array(Bool), made: Array(Bool), cx: HdCtx): Bool {
  ts = m.types
  // The blocks the loop forest knew (a preheader made for another loop
  // lies after them, in no loop).
  n0 = body.size
  blist: Array(Int) = []
  for b in 0..n0 {
    if body[b] {
      blist.push(b)
    }
  }
  // Only a loop with a call: in one without, LLVM takes the words out
  // itself where it can (its stores are elements'), and holding them
  // here too only changed its register allocation, both ways
  // (Base64::Decode-Pure +6.6% and Sort::Merge +8.9% instructions from a
  // spill; Graph::AStar's heap sift loops -5%). A trap's call ends the
  // program; the string and Buf reads the emitter writes as loads
  // (avant_str_size, avant_str_view_test, avant_str_data, avant_buf_size)
  // are no calls either. And not a loop of a few iterations (hd_short).
  calls = false
  for b in blist {
    for st in f.blocks[b].stmts {
      if st.kind == msk_call() && !hd_no_call(st.callee) {
        calls = true
      }
    }
  }
  if !calls || hd_short(f, f.blocks[hdr], cx) {
    return false
  }
  // The locals the body defines: stamped with this loop.
  cx.stamp += 1
  while cx.mark.size < f.locals.size {
    cx.mark.push(0)
  }
  for b in blist {
    for st in f.blocks[b].stmts {
      d = mir_stmt_def(st)
      if d >= 0 {
        cx.mark[d] = cx.stamp
      }
    }
  }
  // The words the loop reads: (array, word) pairs.
  arrs: Array(Int) = []
  words: Array(Int) = []
  out = [0, 0]
  for b in blist {
    if true {
      for st in f.blocks[b].stmts {
        if hd_match(ts, f, st, out) {
          d = mir_stmt_def(st)
          a = out[0]
          if !made[d] && cx.mark[a] != cx.stamp && !(a < cx.addr.size && cx.addr[a]) {
            seen = false
            for q in 0..arrs.size {
              if arrs[q] == a && words[q] == out[1] {
                seen = true
              }
            }
            if !seen {
              arrs.push(a)
              words.push(out[1])
            }
          }
        }
      }
    }
  }
  if arrs.size == 0 {
    return false
  }
  preds = cx.preds
  // Per statement: whether it may change a size or buffer word (chg), and
  // whether it may move a buffer (mov: a collecting call).
  chg: Array(Array(Bool)) = []
  mov: Array(Array(Bool)) = []
  any: Array(Array(Bool)) = []
  for b in 0..n0 {
    c1: Array(Bool) = []
    c2: Array(Bool) = []
    c3: Array(Bool) = []
    if body[b] {
      blk = f.blocks[b]
      for j in 0..blk.stmts.size {
        x = hd_changes(m, f, blk, j, keep)
        y = mir_lv_call_collects(m, blk.stmts[j], coll)
        c1.push(x)
        c2.push(y)
        c3.push(x || y)
      }
    }
    chg.push(c1)
    mov.push(c2)
    any.push(c3)
  }
  // Which arrays the header block reads through (read unguarded), and
  // which others qualify (hd_guarded).
  // Per pair: whether the header block reads through its array (read
  // unguarded), and whether the array qualifies (hd_guarded, once an
  // array).
  in_hdr = mir_bools(arrs.size, false)
  ok = mir_bools(arrs.size, false)
  for q in 0..arrs.size {
    for st in f.blocks[hdr].stmts {
      if hd_derefs(st, arrs[q]) {
        in_hdr[q] = true
      }
    }
  }
  for q in 0..arrs.size {
    prev = -1
    for r in 0..q {
      if arrs[r] == arrs[q] {
        prev = r
      }
    }
    if prev >= 0 {
      ok[q] = ok[prev]
    } else {
      ok[q] = in_hdr[q] || hd_guarded(f, body, hdr, n0, arrs[q], any, preds)
    }
  }
  // Only a word some iteration can run without reading again: a path
  // from the header back to it that crosses no block that changes the
  // word (for the buffer reference, no collecting call either). A loop
  // whose every iteration calls (most of the compiler's own) would read
  // the word again once an iteration, as it read it before, for a
  // preheader more.
  for q in 0..arrs.size {
    if ok[q] && !hd_clean_path(f, body, hdr, n0, preds, words[q] == 0, chg, mov) {
      ok[q] = false
    }
  }
  moving = false
  for q in 0..arrs.size {
    if ok[q] {
      moving = true
    }
  }
  if !moving {
    return false
  }
  loc = f.loc
  if t0 = f.blocks[hdr].term {
    loc = t0.loc
  }
  first = MBlock.new(f.blocks.size)
  f.blocks.push(first)
  cur = first
  held: Array(Int) = []
  moved = 0
  for q in 0..arrs.size {
    a = arrs[q]
    k = words[q]
    h = -1
    if ok[q] {
      lay = ts.layouts[ts.get(f.locals[a].ty).layout]
      h = hd_new_local(f, lay.fields[k])
      hd_grow(made, f)
      made[h] = true
      if in_hdr[q] {
        cur.stmts.push(hd_assign(loc, h, hd_use(hd_word(a, k))))
      } else {
        // _h = zero; if _a != null { _h = (*_a).k }
        cur.stmts.push(hd_assign(loc, h, MRvalue.new(mrk_zero())))
        c = hd_new_local(f, mt_bool())
        hd_grow(made, f)
        r = MRvalue.new(mrk_cmp())
        r.op = mop_ne()
        r.a = hd_copy_local(a)
        r.b = MOperand.new(mok_null(), f.locals[a].ty)
        cur.stmts.push(hd_assign(loc, c, r))
        load = MBlock.new(f.blocks.size)
        f.blocks.push(load)
        join = MBlock.new(f.blocks.size)
        f.blocks.push(join)
        t = MTerm.new(mtk_branch(), loc)
        t.cond = hd_copy_local(c)
        t.targets.push(load.id)
        t.targets.push(join.id)
        cur.term = t
        load.stmts.push(hd_assign(loc, h, hd_use(hd_word(a, k))))
        tl = MTerm.new(mtk_goto(), loc)
        tl.targets.push(join.id)
        load.term = tl
        cur = join
      }
      moved += 1
    }
    held.push(h)
  }
  // The loop's reads become copies, and each word is read again after
  // each statement that may change it, where it is next needed: before
  // the block's next read of it, or at the block's end when none follows
  // (a loop body that calls three functions between two reads reads the
  // word once, not three times; the compiler's own loops made 2.6% more
  // IR read again after every call). Between the change and that read
  // nothing changes the word, so the value is the one it had there. A
  // call that returns an element's slot is followed at once by the store
  // through the slot (the barrier rule, V13), which no read again comes
  // between, as no read of a word does.
  for b in blist {
    if true {
      blk = f.blocks[b]
      outs: Array(MStmt) = []
      pend = mir_bools(arrs.size, false)
      for j in 0..blk.stmts.size {
        st = blk.stmts[j]
        if hd_match(ts, f, st, out) {
          d = mir_stmt_def(st)
          for q in 0..arrs.size {
            if held[q] >= 0 && arrs[q] == out[0] && words[q] == out[1] && !made[d] {
              if pend[q] {
                outs.push(hd_assign(st.loc, held[q], hd_use(hd_word(arrs[q], words[q]))))
                pend[q] = false
              }
              st = hd_assign(st.loc, d, hd_use(hd_copy_local(held[q])))
            }
          }
        }
        outs.push(st)
        for q in 0..arrs.size {
          if held[q] >= 0 && (chg[b][j] || (words[q] == 0 && mov[b][j])) {
            pend[q] = true
          }
        }
      }
      for q in 0..arrs.size {
        if pend[q] {
          ploc = loc
          if t = blk.term {
            ploc = t.loc
          }
          outs.push(hd_assign(ploc, held[q], hd_use(hd_word(arrs[q], words[q]))))
        }
      }
      blk.stmts = outs
    }
  }
  tl = MTerm.new(mtk_goto(), loc)
  tl.targets.push(hdr)
  cur.term = tl
  for p in preds[hdr] {
    if p < n0 && !body[p] {
      if t = f.blocks[p].term {
        for x in 0..t.targets.size {
          if t.targets[x] == hdr {
            t.targets[x] = first.id
          }
        }
      }
    }
  }
  true
}

fn hd_func(m: MModule, f: MFunc, keep: Array(Bool), coll: Array(Bool)) {
  made = mir_bools(f.locals.size, false)
  lps = mir_lv_loops(f)
  if lps.headers.size == 0 {
    return
  }
  cx = HdCtx.new(f)
  // Innermost loops only: a word held in a register across an inner
  // loop competes with that loop's own values, and LLVM then spills it
  // (a store and a load where the loop had one load): Graph::AStar's
  // neighbour loop around its heap's sift-up read 6% more instructions
  // with its row's words held. Innermost loops never share a block, and
  // a preheader changes only its own header's predecessors, so one loop
  // forest serves them all.
  for li in 0..lps.headers.size {
    inner = false
    for h2 in lps.headers {
      if h2 != lps.headers[li] && lps.bodies[li][h2] {
        inner = true
      }
    }
    if lps.headers[li] != 0 && !inner {
      hd_hoist_one(m, f, lps.bodies[li], lps.headers[li], keep, coll, made, cx)
    }
  }
}

// The pass (after loop versioning and check runs, before the GC passes,
// which then make a slot of an array local the loop now reads after a
// collecting call): every function whose kind is unset, in a program
// with one thread.
pub fn mir_heads_pass(m: MModule) {
  if m.shared {
    return
  }
  keep = mir_lv_summary(m)
  coll = mir_lv_collects(m)
  for f in m.funcs {
    if f.kind == mfk_unset() && f.blocks.size > 1 {
      hd_func(m, f, keep, coll)
    }
  }
}
