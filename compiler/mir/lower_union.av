// The lowering of unions and `T?` (Stage 28 W7a; stages/stage28/mir.md
// W7a): a union value is its layout by value (2.4: `i32 tag`, then one
// payload per non-nil member in the checker's member order; the tag of
// member k is k). Construction is the `union` rvalue (other payloads
// zero); a value meets a union type only where the checker allows it
// (`ty_assignable`) and is converted there (`coerce`): a member is
// wrapped with its tag, `nil` with the nil tag, and a union of fewer
// members is re-tagged member by member (`retag`, which also narrows:
// the success side of `if x = ...`, `?`, and `??` when it is a union).
// Reads test the tag and copy the payload. The builtins whose result is
// `T?` are here too: `get` on String, Bytes, Array, Buf, and Hash, hash
// index reads, `get_slice`, `get_concat`, `index_of`, `min`, `max`,
// `env_get`, and `file_read`.

import location
import source
import token
import type
import ast
import typed_ir
import mir.types
import mir.ir
import mir.build
import mir.lower_ty
import mir.lower
import mir.lower_expr
import mir.lower_stmt
import mir.lower_call
import mir.lower_agg
import mir.lower_arr
import mir.lower_hash

// The payload field of member index i of u (type.av payload_index: 1 +
// the non-nil members before it), or -1 for nil.
pub fn mir_payload_field(u: Ty, i: Int): Int {
  if u.members[i].is_nil {
    return -1
  }
  n = 1
  for j in 0..i {
    if !u.members[j].is_nil {
      n += 1
    }
  }
  n
}

// ---- conversion

// o (a value of type got) as a value of type want (the old back end's emit_coerce,
// emit_wrap_union): unchanged unless want is a union that got is not; a
// member is wrapped with its tag; a union is re-tagged.
pub fn (lw: MirLower) coerce(o: MOperand, got: Ty, want: Ty, loc: Location): MOperand {
  if want.is_ptr && got.is_ptr && !lw.failed {
    // W8a: Ptr(A) as Ptr(B) (the checker unifies pointees): a pointer
    // cast when the MIR types differ (`ptr %L` and `ptr`).
    pw = lw.ty_at(want, loc, "a pointer")
    pg = lw.ty_at(got, loc, "a pointer")
    if lw.failed || pw == pg {
      return o
    }
    lw.at(loc)
    return lw.tmp(pw, lw.lw_b.rv_cast(o, pw))
  }
  if !want.is_union || got.same_as(want) || lw.failed {
    return o
  }
  b = lw.lw_b
  wty = lw.ty_at(want, loc, "a value")
  if lw.failed {
    return o
  }
  if got.is_union {
    return lw.retag(o, got, want, loc)
  }
  if !want.includes_member(got) {
    lw.refuse(loc, "a value of type ${got.show} as ${want.show}")
    return o
  }
  if r = mir_opt_ref(want) {
    // An optional reference (W3b, B13): the reference itself, or null.
    if got.is_nil {
      return b.c_null(wty)
    }
    return o
  }
  l = b.types.layout_of(wty)
  lw.at(loc)
  if got.is_nil {
    return lw.tmp(wty, b.rv_union_nil(l, want.tag_of(got)))
  }
  lw.tmp(wty, b.rv_union(l, want.tag_of(got), o))
}

// v lowered and converted to want (the MIR type ty of a place).
pub fn (lw: MirLower) lower_coerced(v: Expr, ty: Int, want: Ty): MOperand {
  if v.kind == ex_nil() && want.is_union && want.includes_nil {
    // `nil` into a union place: the nil tag directly.
    lw.at(v.loc)
    b = lw.lw_b
    if r = mir_opt_ref(want) {
      return b.c_null(ty)
    }
    return lw.tmp(ty, b.rv_union_nil(b.types.layout_of(ty), want.tag_of(ty_nil())))
  }
  // Every value here is checked: the field defaults of generic class
  // instances too, since the checker types them by their fields (C14,
  // W10b; until then this typed untyped literal defaults itself).
  o = lw.lower_expr(v)
  if t = v.ty {
    return lw.coerce(o, t, want, v.loc)
  }
  o
}

// The arguments of a call, left to right, each converted to its
// parameter's type (the old back end converts only the arguments of
// type-level calls, calls.av:1384-1427; a `nil` or a bare T passed to a
// `T?` parameter of a plain function or method does not compile there:
// D196).
pub fn (lw: MirLower) lower_args_to(args: Array(Expr), params: Array(Ty)): Array(MOperand) {
  out: Array(MOperand) = []
  i = 0
  while i < args.size {
    if i < params.size {
      a0 = args[i]
      if t0 = a0.ty {
      } else if !params[i].is_union && (a0.kind == ex_int() || a0.kind == ex_float() || a0.kind == ex_bool() || a0.kind == ex_string()) {
        // W8a: a parameter default the checker spliced in untyped (`caseless:
        // Bool = false`) takes its parameter's type, as a field default does
        // (lower_coerced).
        a0.ty = params[i]
      }
    }
    o = lw.lower_expr(args[i])
    if i < params.size {
      if t = args[i].ty {
        o = lw.coerce(o, t, params[i], args[i].loc)
      }
    }
    j = i + 1
    while j < args.size {
      o = lw.snap(o, args[j])
      j += 1
    }
    out.push(o)
    i += 1
  }
  out
}

// A union value of type from as type to: one arm per member of from
// that to holds, writing to's tag for it and the same payload. A member
// to does not hold (the failure side of a narrowing, already excluded by
// the caller's test) leaves the zero.
pub fn (lw: MirLower) retag(o: MOperand, from: Ty, to: Ty, loc: Location): MOperand {
  b = lw.lw_b
  fty = lw.ty_at(from, loc, "a value")
  tty = lw.ty_at(to, loc, "a value")
  if lw.failed {
    return o
  }
  lw.at(loc)
  fr = mir_is_opt_ref(from)
  tr = mir_is_opt_ref(to)
  if fr && tr {
    return o
  }
  src = lw.hold(o, fty)
  if fr || tr {
    return lw.retag_ref(src, from, to, tty, loc)
  }
  tl = b.types.layout_of(tty)
  d = b.temp(tty)
  b.assign(b.pl(d), b.rv_zero)
  tag = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.pl(src), 0))))
  values: Array(Int64) = []
  targets: Array(Int) = []
  arms: Array(Int) = []
  members: Array(Int) = []
  for i in 0..from.members.size {
    if to.includes_member(from.members[i]) {
      arm = b.block
      values.push(i.to_i64)
      targets.push(arm)
      arms.push(arm)
      members.push(i)
    }
  }
  join = b.block
  b.switch_on(tag, values, targets, join)
  for i in 0..arms.size {
    b.at(arms[i])
    m = from.members[members[i]]
    k = to.tag_of(m)
    if m.is_nil {
      b.assign(b.pl(d), b.rv_union_nil(tl, k))
    } else {
      p = lw.tmp(lw.ty_at(m, loc, "a member"), b.rv_use(b.copy(b.field(b.pl(src), mir_payload_field(from, members[i])))))
      b.assign(b.pl(d), b.rv_union(tl, k, p))
    }
    b.goto(join)
  }
  b.at(join)
  b.copy_local(d)
}

// retag where one side is an optional reference (W3b, B13): from one,
// its null pointer as to's nil and its reference as to's member; into
// one, the payload of its reference member, null for every other member
// (nil, or the failure side the caller's test already excluded).
fn (lw: MirLower) retag_ref(src: Int, from: Ty, to: Ty, tty: Int, loc: Location): MOperand {
  b = lw.lw_b
  d = b.temp(tty)
  join = b.block
  if fm = mir_opt_ref(from) {
    tl = b.types.layout_of(tty)
    b.assign(b.pl(d), b.rv_zero)
    bnil = b.block
    bval = b.block
    b.branch(lw.ref_is_null(src, true), bnil, bval)
    b.at(bnil)
    if to.includes_nil {
      b.assign(b.pl(d), b.rv_union_nil(tl, to.tag_of(ty_nil())))
    }
    b.goto(join)
    b.at(bval)
    if to.includes_member(fm) {
      b.assign(b.pl(d), b.rv_union(tl, to.tag_of(fm), b.copy_local(src)))
    }
    b.goto(join)
    b.at(join)
    return b.copy_local(d)
  }
  if tm = mir_opt_ref(to) {
    b.assign(b.pl(d), b.rv_use(b.c_null(tty)))
    k = from.tag_of(tm)
    if k >= 0 {
      tag = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.pl(src), 0))))
      arm = b.block
      values: Array(Int64) = [k.to_i64]
      targets: Array(Int) = [arm]
      b.switch_on(tag, values, targets, join)
      b.at(arm)
      p = lw.tmp(tty, b.rv_use(b.copy(b.field(b.pl(src), mir_payload_field(from, k)))))
      b.assign(b.pl(d), b.rv_use(p))
      b.goto(join)
      b.at(join)
    }
    return b.copy_local(d)
  }
  b.copy_local(d)
}

// Whether the optional reference in src is null (eq) or not.
fn (lw: MirLower) ref_is_null(src: Int, eq: Bool): MOperand {
  b = lw.lw_b
  ty = b.func.locals[src].ty
  op = mop_eq()
  if !eq {
    op = mop_ne()
  }
  lw.tmp(mt_bool(), b.rv_cmp(op, b.copy_local(src), b.c_null(ty)))
}

// The value of type success held by the union in src (of type uty):
// the payload of that member (the old back end's emit_unwrap), a re-tagged union
// when success is a union of several members, nothing for Nil.
pub fn (lw: MirLower) unwrap(src: Int, uty: Ty, success: Ty, loc: Location): MOperand {
  b = lw.lw_b
  if success.is_nil {
    return b.c_i32(0)
  }
  if r = mir_opt_ref(uty) {
    // The reference itself (W3b, B13).
    return b.copy_local(src)
  }
  if success.is_union {
    return lw.retag(b.copy_local(src), uty, success, loc)
  }
  st = lw.ty_at(success, loc, "a value")
  lw.tmp(st, b.rv_use(b.copy(b.field(b.pl(src), mir_payload_field(uty, uty.tag_of(success))))))
}

// `tag == k` (or `!=`) of the union in src, of type uty; for an
// optional reference, a null test (W3b, B13).
pub fn (lw: MirLower) tag_is(src: Int, uty: Ty, k: Int, eq: Bool): MOperand {
  b = lw.lw_b
  if r = mir_opt_ref(uty) {
    return lw.ref_is_null(src, eq == uty.members[k].is_nil)
  }
  tag = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.pl(src), 0))))
  op = mop_eq()
  if !eq {
    op = mop_ne()
  }
  lw.tmp(mt_bool(), b.rv_cmp(op, tag, b.c_i32(k)))
}

// ---- `??`, `.or`, postfix `?`, `if x = ...`

// `l ?? r` and `l.or(r)` (the old back end's emit_coalesce): the left once; when it
// holds nil, the right (evaluated only then) as the result type;
// otherwise the left itself or its non-nil part.
pub fn (lw: MirLower) lower_coalesce(l: Expr, r: Expr, result: Ty, loc: Location): MOperand {
  b = lw.lw_b
  if uty = l.ty {
    rty = lw.ty_at(result, loc, "a value")
    lty = lw.ety(l)
    u = lw.lower_expr(l)
    if lw.failed {
      return b.c_i32(0)
    }
    lw.at(loc)
    src = lw.hold(u, lty)
    d = b.temp(rty)
    fails = ty_failures(uty)
    bnil = b.block
    bval = b.block
    join = b.block
    if fails.size == 1 {
      c = lw.tag_is(src, uty, uty.tag_of(fails[0]), true)
      b.branch(c, bnil, bval)
    } else {
      lw.branch_failure(src, uty, fails, bnil, bval)
    }
    b.at(bnil)
    if r.kind == ex_switch() && r.op == tk_return() {
      // `?? return v`, `?? break`, `?? continue` (Stage 29 W4a): the
      // statement leaves; nothing reaches the join from here.
      lw.lower_stmts(r.else_body)
      if lw.failed {
        return b.c_i32(0)
      }
      lw.goto_if_open(join, loc)
    } else {
      v = lw.lower_coerced(r, rty, result)
      if lw.failed {
        return b.c_i32(0)
      }
      lw.at(loc)
      b.assign(b.pl(d), b.rv_use(v))
      b.goto(join)
    }
    b.at(bval)
    if result.same_as(uty) {
      b.assign(b.pl(d), b.rv_use(b.copy_local(src)))
    } else {
      success = ty_without_nil(uty)
      if sp = ty_success_part(uty) {
        success = sp
      }
      b.assign(b.pl(d), b.rv_use(lw.coerce(lw.unwrap(src, uty, success, loc), success, result, loc)))
    }
    b.goto(join)
    b.at(join)
    return b.copy_local(d)
  }
  lw.refuse(loc, "an untyped ??")
  b.c_i32(0)
}

// A branch to bfail when the union in src (of type uty) holds one of
// fails (D292: several failure members), else to bok: one switch on the
// tag.
pub fn (lw: MirLower) branch_failure(src: Int, uty: Ty, fails: Array(Ty), bfail: Int, bok: Int) {
  b = lw.lw_b
  tag = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.pl(src), 0))))
  values: Array(Int64) = []
  targets: Array(Int) = []
  for f in fails {
    values.push(uty.tag_of(f).to_i64)
    targets.push(bfail)
  }
  b.switch_on(tag, values, targets, bok)
}

// `e?` (the old back end's emit_try, emit_failure_return): the union once; on a
// failure tag (D292: nil and the members marked Error) the function
// returns the failure (the union itself when the result type is the
// same, else the failure as the result type); otherwise the value is the
// success part.
pub fn (lw: MirLower) lower_try(e: Expr): MOperand {
  b = lw.lw_b
  if inner = e.inner {
    if uty = inner.ty {
      if ret = lw.lw_ret_ty {
        ity = lw.ety(inner)
        u = lw.lower_expr(inner)
        if lw.failed {
          return b.c_i32(0)
        }
        lw.at(e.loc)
        src = lw.hold(u, ity)
        fails = ty_failures(uty)
        success = ty_without_nil(uty)
        if sp = ty_success_part(uty) {
          success = sp
        }
        bf = b.block
        bok = b.block
        if fails.size == 1 {
          c = lw.tag_is(src, uty, uty.tag_of(fails[0]), true)
          b.branch(c, bf, bok)
        } else {
          lw.branch_failure(src, uty, fails, bf, bok)
        }
        b.at(bf)
        if ret.same_as(uty) {
          b.assign(b.pl(0), b.rv_use(b.copy_local(src)))
        } else if fails.size == 1 {
          fv = lw.coerce(lw.unwrap(src, uty, fails[0], e.loc), fails[0], ret, e.loc)
          b.assign(b.pl(0), b.rv_use(fv))
        } else {
          b.assign(b.pl(0), b.rv_use(lw.retag(b.copy_local(src), uty, ret, e.loc)))
        }
        lw.unpin_all
        b.ret
        b.at(bok)
        return lw.unwrap(src, uty, success, e.loc)
      }
    }
  }
  lw.refuse(e.loc, "postfix ? here")
  b.c_i32(0)
}

// `if x = cond { } else { }` (the old back end's emit_if_assign; type.av
// ty_failures, ty_success_part): the union once; when its tag is not a
// failure's, x (a local of the success type) holds the success part for
// the then-body.
pub fn (lw: MirLower) lower_if_bind(st: Stmt) {
  b = lw.lw_b
  if c = st.cond {
    if uty = c.ty {
      success = ty_without_nil(uty)
      if p = ty_success_part(uty) {
        success = p
      }
      fails = ty_failures(uty)
      cty = lw.ety(c)
      sty = lw.ty_at(success, st.loc, "a binding")
      u = lw.lower_expr(c)
      if lw.failed {
        return
      }
      lw.at(st.loc)
      src = lw.hold(u, cty)
      bt = b.block
      bf = b.block
      join = bf
      if st.else_body.size > 0 || lw.lw_cov.on {
        join = b.block
      }
      if fails.size == 1 {
        ok = lw.tag_is(src, uty, uty.tag_of(fails[0]), false)
        b.branch(ok, bt, bf)
      } else {
        lw.branch_failure(src, uty, fails, bf, bt)
      }
      b.at(bt)
      lw.cov_branch(st.loc)
      v = lw.unwrap(src, uty, success, st.loc)
      lw.bind_name(st.bind, success, sty, v, st.loc, false)
      lw.lower_stmts(st.then_body)
      lw.goto_if_open(join, st.loc)
      if st.else_body.size > 0 || lw.lw_cov.on {
        b.at(bf)
        lw.cov_branch(st.loc)
        lw.lower_stmts(st.else_body)
        lw.goto_if_open(join, st.loc)
      }
      b.at(join)
      return
    }
  }
  lw.refuse(st.loc, "this if binding")
}

// One binding of an if-assign or a chain element (Stage 29 W4a): the
// union once; on a failure tag to bfail, else on to a fresh block where
// the name holds the success part (the builder is left there).
pub fn (lw: MirLower) lower_cond_bind(el: Stmt, bfail: Int) {
  b = lw.lw_b
  if c = el.cond {
    if uty = c.ty {
      success = ty_without_nil(uty)
      if p = ty_success_part(uty) {
        success = p
      }
      fails = ty_failures(uty)
      cty = lw.ety(c)
      sty = lw.ty_at(success, el.loc, "a binding")
      u = lw.lower_expr(c)
      if lw.failed {
        return
      }
      lw.at(el.loc)
      src = lw.hold(u, cty)
      bok = b.block
      if fails.size == 1 {
        ok = lw.tag_is(src, uty, uty.tag_of(fails[0]), false)
        b.branch(ok, bok, bfail)
      } else {
        lw.branch_failure(src, uty, fails, bfail, bok)
      }
      b.at(bok)
      v = lw.unwrap(src, uty, success, el.loc)
      lw.bind_name(el.bind, success, sty, v, el.loc, false)
      return
    }
  }
  lw.refuse(el.loc, "this if binding")
}

// One element of a condition: a binding, or a Bool test whose false goes
// to bfail; the builder is left where it holds.
pub fn (lw: MirLower) lower_cond_element(el: Stmt, bfail: Int) {
  if el.bind.size > 0 {
    lw.lower_cond_bind(el, bfail)
    return
  }
  if c = el.cond {
    cv = lw.lower_expr(c)
    if lw.failed {
      return
    }
    bok = lw.lw_b.block
    lw.at(el.loc)
    lw.lw_b.branch(cv, bok, bfail)
    lw.lw_b.at(bok)
  }
}

// An `if` with a condition list, or one whose branches give a value
// (Stage 29 W4a): the elements in order, each failure to the one else
// block (never duplicated); mode 0 is a statement, 1 writes each
// branch's value into dest (converted to want), 2 returns it from the
// function (its tail).
pub fn (lw: MirLower) lower_if_general(st: Stmt, mode: Int, dest: Int, want: Ty?) {
  b = lw.lw_b
  belse = b.block
  join = belse
  has_else = st.else_body.size > 0 || lw.lw_cov.on
  if has_else {
    join = b.block
  }
  for el in st.pre {
    lw.lower_cond_element(el, belse)
    if lw.failed {
      return
    }
  }
  lw.lower_cond_element(st, belse)
  if lw.failed {
    return
  }
  lw.cov_branch(st.loc)
  lw.lower_branch(st.then_body, mode, dest, want)
  lw.goto_if_open(join, st.loc)
  if has_else {
    b.at(belse)
    lw.cov_branch(st.loc)
    lw.lower_branch(st.else_body, mode, dest, want)
    lw.goto_if_open(join, st.loc)
  }
  b.at(join)
}

// A branch's statements; in a value mode (lower_if_general) its last
// expression is the value, and a last `if` with an else gives its own.
pub fn (lw: MirLower) lower_branch(body: Array(Stmt), mode: Int, dest: Int, want: Ty?) {
  if mode == 0 {
    lw.lower_stmts(body)
    return
  }
  b = lw.lw_b
  i = 0
  while i < body.size {
    if lw.failed || !lw.open_now {
      return
    }
    st = body[i]
    if i == body.size - 1 {
      if st.kind == st_if() && st.else_body.size > 0 {
        lw.cov_stmt(st)
        lw.lower_if_general(st, mode, dest, want)
        return
      }
      if st.kind == st_expr() {
        if e = st.expr {
          lw.cov_stmt(st)
          if mode == 2 {
            v = lw.lower_ret_value(e)
            if lw.failed {
              return
            }
            lw.at(st.loc)
            b.assign(b.pl(0), b.rv_use(v))
            b.ret
            return
          }
          v2 = lw.lower_expr(e)
          if t = e.ty {
            if w = want {
              v2 = lw.coerce(v2, t, w, e.loc)
            }
          }
          if lw.failed {
            return
          }
          lw.at(st.loc)
          b.assign(b.pl(dest), b.rv_use(v2))
          return
        }
      }
    }
    lw.lower_stmt(st)
    i += 1
  }
}

// ---- results of type T?

// The union `want` (a T?) holding v (of type vt) when found, else nil;
// v was computed before the test (the old back end's emit_hash_get_wrap and the
// min/max, env_get, file_read forms).
pub fn (lw: MirLower) opt_of(want: Ty, found: MOperand, v: MOperand, vt: Ty, loc: Location): MOperand {
  b = lw.lw_b
  wty = lw.ty_at(want, loc, "a value")
  if lw.failed {
    return b.c_i32(0)
  }
  d = b.temp(wty)
  bt = b.block
  bf = b.block
  join = b.block
  b.branch(found, bt, bf)
  b.at(bt)
  if r = mir_opt_ref(want) {
    // An optional reference (W3b, B13): the reference, or null.
    b.assign(b.pl(d), b.rv_use(v))
    b.goto(join)
    b.at(bf)
    b.assign(b.pl(d), b.rv_use(b.c_null(wty)))
    b.goto(join)
    b.at(join)
    return b.copy_local(d)
  }
  l = b.types.layout_of(wty)
  b.assign(b.pl(d), b.rv_union(l, want.tag_of(vt), v))
  b.goto(join)
  b.at(bf)
  b.assign(b.pl(d), b.rv_union_nil(l, want.tag_of(ty_nil())))
  b.goto(join)
  b.at(join)
  b.copy_local(d)
}

// `found == 1` of an out-parameter local.
pub fn (lw: MirLower) found_is(f: Int): MOperand {
  b = lw.lw_b
  lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), b.copy_local(f), b.c_i32(1)))
}

// A fresh `found` local, 0, and its raw address for the runtime.
pub fn (lw: MirLower) found_local: Int {
  b = lw.lw_b
  f = b.temp(mt_i32())
  b.assign(b.pl(f), b.rv_use(b.c_i32(0)))
  f
}

pub fn (lw: MirLower) found_ptr(f: Int): MOperand {
  b = lw.lw_b
  lw.tmp(b.types.ptr_to(mt_i32()), b.rv_addr_raw(b.pl(f)))
}

// The bounded reads `s.get(i)`, `b.get(i)`, `xs.get(i)`
// (builtins.av:1402-1570): the receiver, then the index, then the size;
// the result starts as nil and becomes the element when 0 <= i < size,
// read only then.
pub fn (lw: MirLower) lower_get(e: Expr, recv: Expr, rt: Ty, args: Array(Expr)): MOperand {
  b = lw.lw_b
  if t = e.ty {
    wty = lw.ety(e)
    aty = lw.ety(recv)
    r = lw.lower_expr(recv)
    if lw.failed {
      return b.c_i32(0)
    }
    if args.size > 0 {
      r = lw.snap(r, args[0])
    }
    lw.at(e.loc)
    h = lw.hold(r, aty)
    iv = b.c_i32(0)
    if args.size > 0 {
      iv = lw.lower_expr(args[0])
    }
    if lw.failed {
      return b.c_i32(0)
    }
    lw.at(e.loc)
    ix = lw.hold(iv, mt_i32())
    n = b.c_i32(0)
    if rt.is_array || rt.is_buf {
      n = lw.tmp(mt_i32(), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), 1))))
    } else {
      n = lw.call_to(mt_i32(), "avant_str_size", lw.one(b.copy_local(h)))
    }
    oref = mir_is_opt_ref(t)
    l = -1
    if !oref {
      l = b.types.layout_of(wty)
    }
    d = b.temp(wty)
    if oref {
      b.assign(b.pl(d), b.rv_use(b.c_null(wty)))
    } else {
      b.assign(b.pl(d), b.rv_union_nil(l, t.tag_of(ty_nil())))
    }
    c1 = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(ix), b.c_i32(0)))
    c2 = lw.tmp(mt_bool(), b.rv_cmp(mop_lt(), b.copy_local(ix), n))
    c = lw.tmp(mt_bool(), b.rv_bin(mop_and(), c1, c2))
    bt = b.block
    join = b.block
    b.branch(c, bt, join)
    b.at(bt)
    elt = ty_int()
    v = b.c_i32(0)
    if rt.is_array {
      if inner = rt.inner {
        elt = inner
      }
      et = lw.elem_of(aty)
      if b.types.is_refkind(et) {
        v = lw.call_to(et, "avant_array_get_ptr", lw.two(b.copy_local(h), b.copy_local(ix)))
      } else {
        dd = b.temp(b.types.ref_to(lw.elems_of(aty)))
        b.assign(b.pl(dd), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), 0))))
        v = lw.tmp(et, b.rv_use(b.copy(b.index(b.deref(b.pl(dd)), b.copy_local(ix)))))
      }
    } else if rt.is_buf {
      dd2 = b.temp(b.types.ref_to(lw.elems_of(aty)))
      b.assign(b.pl(dd2), b.rv_use(b.copy(b.field(b.deref(b.pl(h)), 0))))
      byte = lw.tmp(mt_u8(), b.rv_use(b.copy(b.index(b.deref(b.pl(dd2)), b.copy_local(ix)))))
      v = lw.tmp(mt_i32(), b.rv_cast(byte, mt_i32()))
    } else {
      pu8 = b.ptr_to(mt_u8())
      pv = lw.tmp(pu8, b.rv_cast(b.copy_local(h), pu8))
      pk = mir_bare_copy(pv)
      byte2 = lw.tmp(mt_u8(), b.rv_use(b.copy(b.index(b.deref(b.pl(pk)), b.copy_local(ix)))))
      v = lw.tmp(mt_i32(), b.rv_cast(byte2, mt_i32()))
    }
    if oref || t.same_as(elt) {
      // An optional reference, or an element that is already the result
      // (`get` on an `Array(T?)`, W3b: the verifier refused the old
      // re-wrapping of the element as its own member).
      b.assign(b.pl(d), b.rv_use(v))
    } else {
      b.assign(b.pl(d), b.rv_union(l, t.tag_of(elt), v))
    }
    b.goto(join)
    b.at(join)
    return b.copy_local(d)
  }
  lw.refuse(e.loc, "an untyped get")
  b.c_i32(0)
}

// `xs.index_of(v)` (builtins.av:1141-1190): the value, then the array;
// the runtime's index, nil when negative. `xs.min`, `xs.max`
// (builtins.av:1194-1240): the array, then the runtime's value with a
// found flag.
pub fn (lw: MirLower) lower_arr_opt(e: Expr, recv: Expr, rt: Ty, name: String, args: Array(Expr)): MOperand {
  b = lw.lw_b
  if t = e.ty {
    aty = lw.ety(recv)
    if lw.failed {
      return b.c_i32(0)
    }
    et = lw.elem_of(aty)
    want = lw.elem_ty_of(recv)
    if name == "index_of" && args.size == 1 {
      f = lw.kind_fn("avant_array_index", et, true)
      if f.size == 0 {
        lw.refuse(e.loc, "Array.index_of on ${want.show}")
        return b.c_i32(0)
      }
      v = lw.snap(lw.lower_coerced(args[0], et, want), recv)
      a = lw.lower_expr(recv)
      if lw.failed {
        return b.c_i32(0)
      }
      lw.at(e.loc)
      if et == mt_bool() {
        v = lw.tmp(mt_i32(), b.rv_cast(v, mt_i32()))
      }
      ix = lw.call_to(mt_i32(), f, lw.two(a, v))
      k = lw.hold(ix, mt_i32())
      c = lw.tmp(mt_bool(), b.rv_cmp(mop_ge(), b.copy_local(k), b.c_i32(0)))
      return lw.opt_of(t, c, b.copy_local(k), ty_int(), e.loc)
    }
    mf = lw.kind_fn("avant_array_${name}", et, false)
    if args.size > 0 || mf.size == 0 || et == mt_bool() {
      lw.refuse(e.loc, "Array.${name} on ${want.show}")
      return b.c_i32(0)
    }
    lw.at(e.loc)
    fl = lw.found_local
    a2 = lw.lower_expr(recv)
    if lw.failed {
      return b.c_i32(0)
    }
    lw.at(e.loc)
    v2 = lw.call_to(et, mf, lw.two(a2, lw.found_ptr(fl)))
    return lw.opt_of(t, lw.found_is(fl), v2, want, e.loc)
  }
  lw.refuse(e.loc, "an untyped Array.${name}")
  b.c_i32(0)
}

// Hash reads (as the old back end did): `h[k]` and
// `h.get(k)` (the key, then the hash), `h.get_slice(s, a, b)` (b, a, s,
// then the hash), `h.get_concat(a, b)` (b, a, then the hash); each runtime
// read reports through a found flag.
pub fn (lw: MirLower) lower_hash_read(e: Expr, recv: Expr, ht: Ty, name: String, args: Array(Expr)): MOperand {
  b = lw.lw_b
  if t = e.ty {
    vt = ty_int()
    if v = ht.val {
      vt = v
    }
    vty = lw.ty_at(vt, e.loc, "a hash value")
    if lw.failed {
      return b.c_i32(0)
    }
    lw.at(e.loc)
    fl = lw.found_local
    f = ""
    if name == "get" && args.size == 1 {
      f = mir_hash_op(ht, "get")
    } else if name == "get_slice" && args.size == 3 {
      f = "avant_hash_get_str_slice"
    } else if name == "get_concat" && args.size == 2 {
      f = "avant_hash_get_concat"
    }
    if f.size == 0 {
      lw.refuse(e.loc, "Hash.${name} here")
      return b.c_i32(0)
    }
    ops = lw.args_then_recv(args, recv)
    if lw.failed {
      return b.c_i32(0)
    }
    lw.at(e.loc)
    ops.push(lw.found_ptr(fl))
    v2 = lw.call_to(vty, f, ops)
    return lw.opt_of(t, lw.found_is(fl), v2, vt, e.loc)
  }
  lw.refuse(e.loc, "an untyped hash read")
  b.c_i32(0)
}

// `env_get(name)` (calls.av emit_opt_cstr): the
// argument, then the runtime's string with an ok flag, as String?.
pub fn (lw: MirLower) lower_opt_cstr(e: Expr, f: String): MOperand {
  b = lw.lw_b
  if t = e.ty {
    lw.at(e.loc)
    fl = lw.found_local
    ops = lw.lower_args(e.args)
    if lw.failed {
      return b.c_i32(0)
    }
    lw.at(e.loc)
    ops.push(lw.found_ptr(fl))
    v = lw.call_to(mt_str(), f, ops)
    return lw.opt_of(t, lw.found_is(fl), v, ty_string(), e.loc)
  }
  lw.refuse(e.loc, "an untyped ${e.callee}")
  b.c_i32(0)
}

// The builtins of the old back end that need no FFI and are neither
// string nor heap builtins (calls.av:157-200, 252-272, 291-320, 349-352):
// `argv`, `file_exists`, `env_get`,
// `wide_op`, `wide_hi`, `checksum_f64`, `sha256`, `crc32_bytes`,
// `sha256_word0`; nil when c is not one of them.
pub fn (lw: MirLower) io_builtin(e: Expr, c: String): MOperand? {
  b = lw.lw_b
  if c == "env_get" && e.args.size == 1 {
    return lw.lower_opt_cstr(e, "avant_env_get")
  }
  if c == "wide_op" && e.args.size == 5 {
    // calls.av:291-309: the arguments last to first, then the call.
    wops = lw.lower_args_rev(e.args)
    if lw.failed {
      return b.c_i32(0)
    }
    lw.at(e.loc)
    return lw.call_to(mt_i32(), "avant_wide_op", wops)
  }
  f = ""
  if c == "wide_hi" && e.args.size == 0 {
    f = "avant_wide_hi"
  } else if c == "checksum_f64" && e.args.size == 1 {
    f = "avant_checksum_f64"
  } else if c == "sha256" && e.args.size == 1 {
    f = "avant_sha256"
  } else if c == "crc32_bytes" && e.args.size == 1 {
    f = "avant_crc32_i32"
  } else if c == "sha256_word0" && e.args.size == 1 {
    f = "avant_sha256_word0"
  } else if c == "#gc.collect" && e.args.size == 0 {
    // std.gc's `gc.collect()` (checker/visibility.av check_gc_call).
    f = "avant_gc_collect_young"
  } else if c == "argv" && e.args.size == 0 {
    f = "avant_argv"
  } else if c == "file_exists" && e.args.size == 1 {
    f = "avant_file_exists"
  }
  if f.size == 0 {
    return nil
  }
  ty = lw.ety(e)
  ops = lw.lower_args(e.args)
  if lw.failed {
    return b.c_i32(0)
  }
  lw.at(e.loc)
  if c == "file_exists" {
    r = lw.call_to(mt_i32(), f, ops)
    return lw.tmp(mt_bool(), b.rv_cmp(mop_eq(), r, b.c_i32(1)))
  }
  lw.call_to(ty, f, ops)
}
