pub class Location {
  pub path: String = ""
  pub line: Int = 0
  pub column: Int = 0
  offset: Int = 0

  fn initialize(path: String, line: Int, column: Int, offset: Int) {
    self.path = path
    self.line = line
    self.column = column
    self.offset = offset
  }

  pub fn show: String {
    "${self.path}:${self.line}:${self.column}"
  }
}
