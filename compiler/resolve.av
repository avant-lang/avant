import location
import diagnostic
import source
import token
import lexer
import type
import ast

pub class TypeResolver {
  named: Hash(String, Int)
  opaques: Hash(String, Int)
  interned: Array(Ty)
  failed: Bool = false
  err: CompileError? = nil
  t_int: Ty
  t_int64: Ty
  t_uint64: Ty
  t_bool: Ty
  t_float: Ty
  t_string: Ty
  t_void: Ty
  t_nil: Ty
  t_buf: Ty
  tparams: Hash(String, Int)
  program: Program? = nil
  struct_inflight: Array(String)
  inst_depth: Int = 0

  fn initialize {
    n = Hash(String, Int).new
    self.named = n
    o = Hash(String, Int).new
    self.opaques = o
    inn: Array(Ty) = []
    inn.push(ty_void())
    self.interned = inn
    self.t_int = ty_int()
    self.t_int64 = ty_int64()
    self.t_uint64 = ty_uint64()
    self.t_bool = ty_bool()
    self.t_float = ty_float()
    self.t_string = ty_string()
    self.t_void = ty_void()
    self.t_nil = ty_nil()
    self.t_buf = ty_buf()
    tp = Hash(String, Int).new
    self.tparams = tp
    self.program = nil
    inf: Array(String) = []
    self.struct_inflight = inf
    self.inst_depth = 0
    self.failed = false
    self.err = nil
  }

  pub fn set_tparams(names: Array(String)) {
    tp = Hash(String, Int).new
    i = 0
    while i < names.size {
      tp[names[i]] = 1
      i = i + 1
    }
    self.tparams = tp
  }

  pub fn clear_tparams {
    tp = Hash(String, Int).new
    self.tparams = tp
  }

  pub fn has_err: Bool {
    self.failed
  }

  pub fn fail(loc: Location, message: String) {
    if self.failed {
      return
    }
    self.failed = true
    self.err = CompileError.new(loc, message)
  }

  pub fn intern(ty: Ty): Int {
    self.interned.push(ty)
    self.interned.size - 1
  }

  pub fn ty_at(id: Int): Ty {
    self.interned[id]
  }

  pub fn put_named(name: String, ty: Ty): Int {
    id = self.intern(ty)
    self.named[name] = id
    id
  }

  pub fn get_named(name: String): Ty? {
    if id = self.named.get(name) {
      return self.ty_at(id)
    }
    nil
  }

  pub fn get_opaque(name: String): Ty? {
    if id = self.opaques.get(name) {
      return self.ty_at(id)
    }
    nil
  }

  pub fn resolve_value(tn: TypeName): Ty {
    ty = self.resolve(tn)
    if ty.is_opaque {
      self.fail(tn.loc, "${ty.show} is opaque; use Ptr(${ty.show})")
      return self.t_int
    }
    if ty.is_clayout {
      self.fail(tn.loc, "${ty.show} is a C layout; use Ptr(${ty.show})")
      return self.t_int
    }
    if ty.is_void {
      self.fail(tn.loc, "Void is not a value; use Ptr(Void) or omit a return type")
      return self.t_int
    }
    ty
  }

  pub fn resolve(tn: TypeName): Ty {
    inner = self.resolve_core(tn)
    if tn.nilable {
      return ty_nilable(inner)
    }
    inner
  }

  pub fn reject_args(tn: TypeName) {
    if tn.args.size > 0 {
      self.fail(tn.loc, "${tn.name} does not take type arguments")
    }
  }

  pub fn resolve_core(tn: TypeName): Ty {
    if tn.fn_type {
      params: Array(Ty) = []
      i = 0
      while i < tn.args.size {
        params.push(self.resolve_value_uninline(tn.args[i]))
        i = i + 1
      }
      ret = self.t_void
      if r = tn.ret {
        ret = self.resolve_uninline(r)
      }
      return ty_fn(params, ret)
    }
    if tn.members.size > 0 {
      parts: Array(Ty) = []
      i = 0
      while i < tn.members.size {
        parts.push(self.resolve(tn.members[i]))
        i = i + 1
      }
      return ty_union_build(parts)
    }
    if str_eq(tn.name, "Int") {
      self.reject_args(tn)
      return self.t_int
    }
    if str_eq(tn.name, "Int64") {
      self.reject_args(tn)
      return self.t_int64
    }
    if str_eq(tn.name, "UInt64") {
      self.reject_args(tn)
      return self.t_uint64
    }
    if str_eq(tn.name, "Bool") {
      self.reject_args(tn)
      return self.t_bool
    }
    if str_eq(tn.name, "Float64") {
      self.reject_args(tn)
      return self.t_float
    }
    if str_eq(tn.name, "String") {
      self.reject_args(tn)
      return self.t_string
    }
    if str_eq(tn.name, "Buf") {
      self.reject_args(tn)
      return self.t_buf
    }
    if str_eq(tn.name, "Nil") {
      self.reject_args(tn)
      return self.t_nil
    }
    if str_eq(tn.name, "Void") {
      self.reject_args(tn)
      return self.t_void
    }
    if str_eq(tn.name, "Array") {
      if tn.args.size != 1 {
        self.fail(tn.loc, "Array takes one type argument")
        return self.t_int
      }
      return ty_array(self.resolve_value_uninline(tn.args[0]))
    }
    if str_eq(tn.name, "Hash") {
      if tn.args.size != 2 {
        self.fail(tn.loc, "Hash takes two type arguments")
        return self.t_int
      }
      return ty_hash(self.resolve_value_uninline(tn.args[0]), self.resolve_value_uninline(tn.args[1]))
    }
    if str_eq(tn.name, "JoinHandle") {
      if tn.args.size != 1 {
        self.fail(tn.loc, "JoinHandle takes one type argument")
        return self.t_int
      }
      return ty_join(self.resolve_value_uninline(tn.args[0]))
    }
    if str_eq(tn.name, "Ptr") {
      if tn.args.size != 1 {
        self.fail(tn.loc, "Ptr takes one type argument")
        return self.t_int
      }
      inner = tn.args[0]
      if str_eq(inner.name, "Void") {
        self.reject_args(inner)
        return ty_ptr(self.t_void)
      }
      return ty_ptr(self.resolve_uninline(inner))
    }
    if id = self.tparams.get(tn.name) {
      if tn.args.size == 0 {
        return ty_var(tn.name)
      }
    }
    if self.has_template(tn.name) {
      return self.instantiate_template(tn)
    }
    self.reject_args(tn)
    if found = self.get_named(tn.name) {
      if found.template {
        self.fail(tn.loc, "${tn.name} needs type arguments")
        return self.t_int
      }
      return found
    }
    if opq = self.get_opaque(tn.name) {
      return opq
    }
    self.fail(tn.loc, "unknown type ${tn.name}")
    self.t_int
  }

  pub fn save_inflight: Array(String) {
    saved: Array(String) = []
    i = 0
    while i < self.struct_inflight.size {
      saved.push(self.struct_inflight[i])
      i = i + 1
    }
    saved
  }

  pub fn resolve_uninline(tn: TypeName): Ty {
    saved = self.save_inflight
    empty: Array(String) = []
    self.struct_inflight = empty
    ty = self.resolve(tn)
    self.struct_inflight = saved
    ty
  }

  pub fn resolve_value_uninline(tn: TypeName): Ty {
    saved = self.save_inflight
    empty: Array(String) = []
    self.struct_inflight = empty
    ty = self.resolve_value(tn)
    self.struct_inflight = saved
    ty
  }

  pub fn inflight_has(key: String): Bool {
    i = 0
    while i < self.struct_inflight.size {
      if str_eq(self.struct_inflight[i], key) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn format_app(origin: String, args: Array(Ty)): String {
    buf = buf_new()
    buf.push_str(origin)
    buf.push_str("(")
    i = 0
    while i < args.size {
      if i > 0 {
        buf.push_str(", ")
      }
      buf.push_str(args[i].show)
      i = i + 1
    }
    buf.push_str(")")
    buf.to_s
  }

  pub fn inst_key(origin: String, args: Array(Ty)): String {
    buf = buf_new()
    buf.push_str(origin)
    i = 0
    while i < args.size {
      buf.push_str("__")
      buf.push_str(mangle_ty(args[i]))
      i = i + 1
    }
    buf.to_s
  }

  pub fn find_struct_template(name: String): StructDef? {
    if p = self.program {
      i = 0
      while i < p.structs.size {
        sdef = p.structs[i]
        if str_eq(sdef.name, name) {
          if sdef.type_params.size > 0 {
            return sdef
          }
        }
        i = i + 1
      }
    }
    nil
  }

  pub fn find_class_template(name: String): ClassDef? {
    if p = self.program {
      i = 0
      while i < p.classes.size {
        cdef = p.classes[i]
        if str_eq(cdef.name, name) {
          if cdef.type_params.size > 0 {
            return cdef
          }
        }
        i = i + 1
      }
    }
    nil
  }

  pub fn has_template(name: String): Bool {
    if s = self.find_struct_template(name) {
      return true
    }
    if c = self.find_class_template(name) {
      return true
    }
    false
  }

  pub fn has_struct_named(name: String): Bool {
    if p = self.program {
      i = 0
      while i < p.structs.size {
        if str_eq(p.structs[i].name, name) {
          return true
        }
        i = i + 1
      }
    }
    false
  }

  pub fn has_class_named(name: String): Bool {
    if p = self.program {
      i = 0
      while i < p.classes.size {
        if str_eq(p.classes[i].name, name) {
          return true
        }
        i = i + 1
      }
    }
    false
  }

  pub fn defines_type(name: String): Bool {
    if type_is_builtin(name) {
      return true
    }
    if p = self.program {
      i = 0
      while i < p.structs.size {
        if str_eq(p.structs[i].name, name) {
          return true
        }
        i = i + 1
      }
      i = 0
      while i < p.classes.size {
        if str_eq(p.classes[i].name, name) {
          return true
        }
        i = i + 1
      }
      i = 0
      while i < p.libs.size {
        lib_def = p.libs[i]
        j = 0
        while j < lib_def.layouts.size {
          if str_eq(lib_def.layouts[j].name, name) {
            return true
          }
          j = j + 1
        }
        i = i + 1
      }
    }
    false
  }

  pub fn check_type_params(loc: Location, type_name: String, params: Array(String)) {
    seen = Hash(String, Int).new
    i = 0
    while i < params.size {
      p = params[i]
      if prev = seen.get(p) {
        self.fail(loc, "duplicate type parameter ${p}")
        return
      }
      seen[p] = 1
      if str_eq(p, type_name) {
        self.fail(loc, "type parameter ${p} must be a fresh name")
        return
      }
      if self.defines_type(p) {
        self.fail(loc, "type parameter ${p} must be a fresh name")
        return
      }
      i = i + 1
    }
  }

  pub fn ty_args_have_var(args: Array(Ty)): Bool {
    i = 0
    while i < args.size {
      if ty_has_var(args[i]) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn make_pattern(kind: Int, origin: String, args: Array(Ty)): Ty {
    t = Ty.new(kind)
    t.origin = origin
    t.name = origin
    t.label = self.format_app(origin, args)
    t.ty_args = args
    t.template = false
    t
  }

  pub fn clone_subst_field(field: Field, from: Array(String), to: Array(TypeName)): Field {
    t = subst_type_name(field.type, from, to)
    f = Field.new(field.loc, field.name, t)
    if d = field.default {
      c = clone_expr(d)
      subst_type_in_expr(c, from, to)
      f.default = c
    }
    f
  }

  pub fn fill_inst_fields(ty: Ty, fields: Array(Field)) {
    resolved: Array(TyField) = []
    seen = Hash(String, Int).new
    i = 0
    while i < fields.size {
      field = fields[i]
      if prev = seen.get(field.name) {
        self.fail(field.loc, "duplicate field ${field.name}")
        return
      }
      seen[field.name] = 1
      resolved.push(TyField.new(field.name, self.resolve_value(field.type)))
      if self.failed {
        return
      }
      i = i + 1
    }
    ty.fields = resolved
  }

  pub fn instantiate_template(tn: TypeName): Ty {
    if self.failed {
      return self.t_int
    }
    is_struct = false
    kind = tyk_class()
    params: Array(String) = []
    src_fields: Array(Field) = []
    src_methods: Array(Function) = []
    mod_name = ""
    vis = false
    loc = tn.loc
    if sdef = self.find_struct_template(tn.name) {
      is_struct = true
      kind = tyk_struct()
      params = sdef.type_params
      src_fields = sdef.fields
      src_methods = sdef.methods
      mod_name = sdef.mod_name
      vis = sdef.vis
      loc = sdef.loc
    } else {
      if cdef = self.find_class_template(tn.name) {
        kind = tyk_class()
        params = cdef.type_params
        src_fields = cdef.fields
        src_methods = cdef.methods
        mod_name = cdef.mod_name
        vis = cdef.vis
        loc = cdef.loc
      } else {
        self.fail(tn.loc, "unknown type ${tn.name}")
        return self.t_int
      }
    }
    if tn.args.size == 0 {
      self.fail(tn.loc, "${tn.name} needs type arguments")
      return self.t_int
    }
    if tn.args.size != params.size {
      n = params.size
      word = "type arguments"
      if n == 1 {
        word = "type argument"
      }
      self.fail(tn.loc, "${tn.name} takes ${n} ${word}")
      return self.t_int
    }
    arg_tys: Array(Ty) = []
    i = 0
    while i < tn.args.size {
      arg_tys.push(self.resolve(tn.args[i]))
      if self.failed {
        return self.t_int
      }
      i = i + 1
    }
    if self.ty_args_have_var(arg_tys) {
      return self.make_pattern(kind, tn.name, arg_tys)
    }
    key = self.inst_key(tn.name, arg_tys)
    label = self.format_app(tn.name, arg_tys)
    if is_struct {
      if self.inflight_has(key) {
        self.fail(tn.loc, "struct layout of ${label} is infinite")
        return self.t_int
      }
    }
    if existing = self.get_named(key) {
      return existing
    }
    self.inst_depth = self.inst_depth + 1
    if self.inst_depth > 32 {
      self.fail(tn.loc, "type instantiation too deep")
      self.inst_depth = self.inst_depth - 1
      return self.t_int
    }
    shell = Ty.new(kind)
    shell.name = key
    shell.origin = tn.name
    shell.label = label
    shell.ty_args = arg_tys
    shell.template = false
    dummy_id = self.put_named(key, shell)
    if p = self.program {
      fields: Array(Field) = []
      methods: Array(Function) = []
      i = 0
      while i < src_fields.size {
        fields.push(self.clone_subst_field(src_fields[i], params, tn.args))
        i = i + 1
      }
      i = 0
      while i < src_methods.size {
        m = clone_function(src_methods[i])
        subst_function_types(m, params, tn.args)
        m.owner = key
        m.generic = false
        fresh: Array(String) = []
        m.type_params = fresh
        m.emit_name = m.name
        methods.push(m)
        i = i + 1
      }
      if is_struct {
        if self.has_struct_named(key) {
        } else {
          sinst = StructDef.new(loc, key)
          sinst.fields = fields
          sinst.methods = methods
          sinst.mod_name = mod_name
          sinst.vis = vis
          p.structs.push(sinst)
        }
      } else {
        if self.has_class_named(key) {
        } else {
          cinst = ClassDef.new(loc, key)
          cinst.fields = fields
          cinst.methods = methods
          cinst.mod_name = mod_name
          cinst.vis = vis
          p.classes.push(cinst)
        }
      }
      if is_struct {
        self.struct_inflight.push(key)
        self.fill_inst_fields(shell, fields)
        dummy_pop = self.struct_inflight.pop
      } else {
        saved = self.save_inflight
        empty: Array(String) = []
        self.struct_inflight = empty
        self.fill_inst_fields(shell, fields)
        self.struct_inflight = saved
      }
    }
    self.inst_depth = self.inst_depth - 1
    shell
  }
}

pub fn note_ptr_opaque_skip(tn: TypeName, resolver: TypeResolver, skip: Hash(String, Int)) {
  if r = tn.ret {
    note_ptr_opaque_skip(r, resolver, skip)
  }
  i = 0
  while i < tn.args.size {
    note_ptr_opaque_skip(tn.args[i], resolver, skip)
    i = i + 1
  }
  i = 0
  while i < tn.members.size {
    note_ptr_opaque_skip(tn.members[i], resolver, skip)
    i = i + 1
  }
  if str_eq(tn.name, "Ptr") {
    if tn.args.size == 1 {
      inner = tn.args[0]
      if inner.args.size == 0 {
        if type_is_builtin(inner.name) {
          return
        }
        if existing = resolver.get_named(inner.name) {
          return
        }
        if skipped = skip.get(inner.name) {
          return
        }
        if already = resolver.get_opaque(inner.name) {
          return
        }
        opq = ty_named(tyk_opaque(), inner.name)
        id = resolver.intern(opq)
        resolver.opaques[inner.name] = id
      }
    }
  }
}

pub fn note_ptr_opaque(tn: TypeName, resolver: TypeResolver) {
  empty = Hash(String, Int).new
  note_ptr_opaque_skip(tn, resolver, empty)
}

pub fn note_type_name(tn: TypeName, resolver: TypeResolver) {
  note_ptr_opaque(tn, resolver)
}

pub fn collect_opaques(program: Program, resolver: TypeResolver) {
  i = 0
  while i < program.libs.size {
    lib_def = program.libs[i]
    j = 0
    while j < lib_def.funs.size {
      cfun = lib_def.funs[j]
      k = 0
      while k < cfun.params.size {
        note_type_name(cfun.params[k].type, resolver)
        k = k + 1
      }
      if ret = cfun.return_type {
        note_type_name(ret, resolver)
      }
      j = j + 1
    }
    j = 0
    while j < lib_def.layouts.size {
      lay = lib_def.layouts[j]
      k = 0
      while k < lay.fields.size {
        note_type_name(lay.fields[k].type, resolver)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.structs.size {
    sdef = program.structs[i]
    j = 0
    while j < sdef.fields.size {
      note_type_name(sdef.fields[j].type, resolver)
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.classes.size {
    cdef = program.classes[i]
    j = 0
    while j < cdef.fields.size {
      note_type_name(cdef.fields[j].type, resolver)
      j = j + 1
    }
    i = i + 1
  }
  fns = program_all_functions(program)
  i = 0
  while i < fns.size {
    fnn = fns[i]
    names = collect_fn_type_params(fnn, resolver.named)
    skip = Hash(String, Int).new
    n = 0
    while n < names.size {
      skip[names[n]] = 1
      n = n + 1
    }
    j = 0
    while j < fnn.params.size {
      note_ptr_opaque_skip(fnn.params[j].type, resolver, skip)
      j = j + 1
    }
    if recv = fnn.receiver {
      note_ptr_opaque_skip(recv.type, resolver, skip)
    }
    if ret = fnn.return_type {
      note_ptr_opaque_skip(ret, resolver, skip)
    }
    i = i + 1
  }
}

pub fn c_field_ok(ty: Ty): Bool {
  if ty.is_int {
    return true
  }
  if ty.is_int64 {
    return true
  }
  if ty.is_uint64 {
    return true
  }
  if ty.is_bool {
    return true
  }
  if ty.is_float {
    return true
  }
  if ty.is_string {
    return true
  }
  if ty.is_clayout {
    return true
  }
  if ty.is_ptr {
    if inner = ty.inner {
      if inner.is_void {
        return true
      }
      if inner.is_opaque {
        return true
      }
      if inner.is_clayout {
        return true
      }
    }
  }
  false
}

pub fn fill_clayout_fields(resolver: TypeResolver, layout: CLayout, ready: Hash(String, Int)) {
  resolved: Array(TyField) = []
  seen = Hash(String, Int).new
  i = 0
  while i < layout.fields.size {
    field = layout.fields[i]
    if prev = seen.get(field.name) {
      resolver.fail(field.loc, "duplicate field ${field.name}")
      return
    }
    seen[field.name] = 1
    ty = resolver.resolve(field.type)
    if resolver.failed {
      return
    }
    if ty.is_clayout {
      if mark = ready.get(ty.name) {
      } else {
        resolver.fail(field.loc, "${ty.name} is not a complete C layout yet")
        return
      }
    }
    if c_field_ok(ty) {
    } else {
      resolver.fail(field.loc, "C layout fields must be C types, not ${ty.show}")
      return
    }
    resolved.push(TyField.new(field.name, ty))
    i = i + 1
  }
  if ty = resolver.get_named(layout.name) {
    ty.fields = resolved
  }
  ready[layout.name] = 1
}

pub fn fill_type_fields(resolver: TypeResolver, name: String, fields: Array(Field)) {
  resolved: Array(TyField) = []
  seen = Hash(String, Int).new
  i = 0
  while i < fields.size {
    field = fields[i]
    if prev = seen.get(field.name) {
      resolver.fail(field.loc, "duplicate field ${field.name}")
      return
    }
    seen[field.name] = 1
    resolved.push(TyField.new(field.name, resolver.resolve_value(field.type)))
    i = i + 1
  }
  if ty = resolver.get_named(name) {
    ty.fields = resolved
  }
}

pub fn load_types(program: Program): TypeResolver {
  resolver = TypeResolver.new
  resolver.program = program
  i = 0
  while i < program.structs.size {
    sdef = program.structs[i]
    if existing = resolver.get_named(sdef.name) {
      resolver.fail(sdef.loc, "${sdef.name} is already defined")
      return resolver
    }
    if sdef.type_params.size > 0 {
      resolver.check_type_params(sdef.loc, sdef.name, sdef.type_params)
      if resolver.failed {
        return resolver
      }
    }
    sty = ty_named(tyk_struct(), sdef.name)
    if sdef.type_params.size > 0 {
      sty.template = true
    }
    resolver.put_named(sdef.name, sty)
    i = i + 1
  }
  i = 0
  while i < program.classes.size {
    cdef = program.classes[i]
    if already = resolver.get_named(cdef.name) {
      resolver.fail(cdef.loc, "${cdef.name} is already defined")
      return resolver
    }
    if cdef.type_params.size > 0 {
      resolver.check_type_params(cdef.loc, cdef.name, cdef.type_params)
      if resolver.failed {
        return resolver
      }
    }
    cty = ty_named(tyk_class(), cdef.name)
    if cdef.type_params.size > 0 {
      cty.template = true
    }
    resolver.put_named(cdef.name, cty)
    i = i + 1
  }
  i = 0
  while i < program.libs.size {
    lib_def = program.libs[i]
    j = 0
    while j < lib_def.layouts.size {
      lay = lib_def.layouts[j]
      if existing = resolver.get_named(lay.name) {
        resolver.fail(lay.loc, "${lay.name} is already defined")
        return resolver
      }
      resolver.put_named(lay.name, ty_named(tyk_clayout(), lay.name))
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.libs.size {
    lib_def = program.libs[i]
    if existing = resolver.get_named(lib_def.name) {
      resolver.fail(lib_def.loc, "lib ${lib_def.name} collides with a type")
      return resolver
    }
    i = i + 1
  }
  collect_opaques(program, resolver)
  i = 0
  while i < program.structs.size {
    if resolver.failed {
      return resolver
    }
    sdef2 = program.structs[i]
    if sdef2.type_params.size > 0 {
    } else {
      fill_type_fields(resolver, sdef2.name, sdef2.fields)
    }
    i = i + 1
  }
  i = 0
  while i < program.classes.size {
    if resolver.failed {
      return resolver
    }
    cdef2 = program.classes[i]
    if cdef2.type_params.size > 0 {
    } else {
      fill_type_fields(resolver, cdef2.name, cdef2.fields)
    }
    i = i + 1
  }
  ready = Hash(String, Int).new
  i = 0
  while i < program.libs.size {
    lib_def = program.libs[i]
    j = 0
    while j < lib_def.layouts.size {
      fill_clayout_fields(resolver, lib_def.layouts[j], ready)
      if resolver.failed {
        return resolver
      }
      j = j + 1
    }
    i = i + 1
  }
  resolver
}
