import location
import diagnostic
import source
import token
import lexer
import type
import ast
import suggest

// A generic type's instance whose template bounds its parameters
// (`class Top(T: Ranked)`): the checker tests each bound on the arguments
// once the interfaces' opt-ins are known (check_bound_uses).
pub class BoundUse {
  pub loc: Location
  pub label: String = ""
  pub params: Array(String) = []
  pub bounds: Array(TypeBound) = []
  pub args: Array(TypeName) = []
  pub arg_tys: Array(Ty) = []
  pub mod_name: String = ""

  fn initialize(loc: Location) {
    self.loc = loc
  }
}

pub class TypeResolver {
  pub named: Hash(String, Int)
  pub collide: Hash(String, Int)
  opaques: Hash(String, Int)
  interned: Array(Ty)
  failed: Bool = false
  err: CompileError? = nil
  pub errors: DiagBag
  pub t_int: Ty
  pub t_uint64: Ty
  pub t_bool: Ty
  pub t_float: Ty
  pub t_string: Ty
  pub t_void: Ty
  pub t_nil: Ty
  pub t_buf: Ty
  pub t_bytes: Ty
  tparams: Hash(String, Int)
  pub tparam_names: Array(String)
  program: Program? = nil
  struct_inflight: Array(String)
  inst_depth: Int = 0
  // Set while a `fun` signature or a C layout's fields resolve: the only
  // places a C scalar type (Int8 ... Float32) may be named (Stage 29 W1b).
  pub c_scalar_ok: Bool = false
  // Every declared type name, for "did you mean" (Stage 29 W3a), with
  // its module (Stage 29 W5c1).
  type_names: Array(String)
  type_name_mods: Array(String)
  // The module a type name is being resolved in, when the caller knows
  // it (the checker's resolve_in_module, a type's fields): a suggestion
  // names only a type that module sees (W5c1); "" offers every type.
  pub scope_mod: String = ""
  // The type aliases (`type Ty = A | B`): by type_key(module, name), and
  // by the bare name when one module declares it (-1 when two do); the
  // ones being resolved, so an alias that names itself is an error.
  aliases: Array(AliasDef)
  alias_ix: Hash(String, Int)
  alias_inflight: Array(String)
  pub bound_uses: Array(BoundUse)

  fn initialize {
    n = Hash(String, Int).new
    self.named = n
    col = Hash(String, Int).new
    self.collide = col
    o = Hash(String, Int).new
    self.opaques = o
    inn: Array(Ty) = []
    inn.push(ty_void())
    self.interned = inn
    self.t_int = ty_int()
    self.t_uint64 = ty_uint64()
    self.t_bool = ty_bool()
    self.t_float = ty_float()
    self.t_string = ty_string()
    self.t_void = ty_void()
    self.t_nil = ty_nil()
    self.t_buf = ty_buf()
    self.t_bytes = ty_bytes()
    tp = Hash(String, Int).new
    self.tparams = tp
    self.tparam_names = []
    self.program = nil
    self.struct_inflight = []
    self.type_names = []
    self.type_name_mods = []
    self.scope_mod = ""
    self.aliases = []
    ai = Hash(String, Int).new
    self.alias_ix = ai
    self.alias_inflight = []
    self.bound_uses = []
    self.inst_depth = 0
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new
  }

  pub fn set_tparams(names: Array(String)) {
    tp = Hash(String, Int).new
    copy: Array(String) = []
    i = 0
    while i < names.size {
      tp[names[i]] = 1
      copy.push(names[i])
      i += 1
    }
    self.tparams = tp
    self.tparam_names = copy
  }

  pub fn clear_tparams {
    tp = Hash(String, Int).new
    self.tparams = tp
    self.tparam_names = []
  }

  pub fn has_err: Bool {
    self.failed
  }

  pub fn fail(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(3, message), message)
    if self.errors.count == 0 {
      self.err = e
    }
    self.failed = true
    self.errors.push(e)
  }

  // Every error counts, kept or not (O163, Stage 29 W1a; O162 fixed the
  // parser the same way): the bag keeps at most 20 and drops repeats, so
  // its item count cannot be a mark.
  pub fn err_count: Int {
    self.errors.pushes
  }

  pub fn new_err_since(mark: Int): Bool {
    self.errors.pushes > mark
  }

  pub fn intern(ty: Ty): Int {
    self.interned.push(ty)
    self.interned.size - 1
  }

  pub fn ty_at(id: Int): Ty {
    self.interned[id]
  }

  pub fn type_key(mod_name: String, name: String): String {
    "${mod_name}@@${name}"
  }

  pub fn put_named(name: String, ty: Ty): Int {
    id = intern(ty)
    self.named[name] = id
    id
  }

  pub fn bind_type(mod_name: String, name: String, ty: Ty): Int {
    ty.mod_name = mod_name
    id = intern(ty)
    self.named[type_key(mod_name, name)] = id
    if prev = self.named.get(name) {
      old = ty_at(prev)
      if old.mod_name != mod_name {
        self.collide[name] = 1
      }
    } else {
      self.named[name] = id
    }
    self.type_names.push(name)
    self.type_name_mods.push(mod_name)
    id
  }

  // The known type name nearest to name, as " (did you mean `String`?)",
  // or "" when none is close (Stage 29 W3a, D298: a name that is not a
  // single capital letter is no longer a type parameter).
  // The suggestion is compiler/suggest.av's (Stage 29 W5c1): the builtin
  // types first, then the declared ones.
  pub fn type_hint(name: String): String {
    sg = Suggest.new(name)
    offer_types(sg, 0)
    sg.hint
  }

  // The builtin types (rank), then the declared ones scope_mod sees
  // (rank + 1).
  pub fn offer_types(sg: Suggest, rank: Int) {
    sg.offer_list(builtin_type_names(), rank)
    for i in 0..self.type_names.size {
      t = self.type_names[i]
      m = self.type_name_mods[i]
      if sg.could(t) && (self.scope_mod.size == 0 || m.size == 0 || m == self.scope_mod || type_seen_from(m, t, self.scope_mod)) {
        sg.offer(t, rank + 1)
      }
    }
  }

  // Whether module from sees module m's type name (an import's pub type).
  pub fn type_seen_from(m: String, name: String, from: String): Bool {
    if p = self.program {
      for info in p.mods {
        if info.name == from {
          for imp in info.imports {
            if imp == m {
              return type_is_pub(p, m, name)
            }
          }
        }
      }
    }
    false
  }

  // A bare type name that types of two modules share (collide), written
  // in module mod_name (a field's type: the checker's views do not reach
  // it): the one such type mod_name sees, its own or an import's pub one,
  // is pinned with its module; two are ambiguous, named both (Stage 29
  // W5c1, O224: before, a field said "unknown type Token" even when the
  // module saw only one Token).
  pub fn qualify_seen(tn: TypeName, mod_name: String) {
    for a in tn.args {
      qualify_seen(a, mod_name)
    }
    for m in tn.members {
      qualify_seen(m, mod_name)
    }
    if r = tn.ret {
      qualify_seen(r, mod_name)
    }
    if tn.fn_type || tn.members.size > 0 || tn.mod_name.size > 0 || tn.pinned {
      return
    }
    if flag = self.collide.get(tn.name) {
      owners = seen_owners(tn.name, mod_name)
      if owners.size > 1 {
        what = buf_new()
        spell = buf_new()
        for i in 0..owners.size {
          if i > 0 {
            if i == owners.size - 1 {
              what.push_str(" and ")
              spell.push_str(" or ")
            } else {
              what.push_str(", ")
              spell.push_str(", ")
            }
          }
          what.push_str(owners[i])
          spell.push_str("${owners[i]}.${tn.name}")
        }
        both = "both "
        if owners.size > 2 {
          both = ""
        }
        fail(tn.loc, "${tn.name} is a type of ${both}${what.to_s}: write ${spell.to_s}")
      }
      if owners.size == 0 {
        // Declared only by modules this one does not see: reported once,
        // the name then pinned to one of them so it is not reported again.
        fail(tn.loc, "unknown type ${tn.name}")
        if p = self.program {
          for info in p.mods {
            if owners.size == 0 {
              if t = get_named_in(info.name, tn.name) {
                owners.push(info.name)
              }
            }
          }
        }
      }
      if owners.size > 0 {
        tn.mod_name = owners[0]
      }
    }
  }

  // The modules whose type name mod_name sees: its own, then each import
  // that declares it pub, in import order.
  pub fn seen_owners(name: String, mod_name: String): Array(String) {
    out: Array(String) = []
    if t = get_named_in(mod_name, name) {
      out.push(mod_name)
    }
    if p = self.program {
      for info in p.mods {
        if info.name == mod_name {
          for imp in info.imports {
            if imp != mod_name && type_is_pub(p, imp, name) {
              if t2 = get_named_in(imp, name) {
                out.push(imp)
              }
            }
          }
        }
      }
    }
    out
  }

  pub fn get_named(name: String): Ty? {
    if flag = self.collide.get(name) {
      return nil
    }
    if id = self.named.get(name) {
      return ty_at(id)
    }
    nil
  }

  pub fn get_named_in(mod_name: String, name: String): Ty? {
    if id = self.named.get(type_key(mod_name, name)) {
      return ty_at(id)
    }
    nil
  }

  pub fn get_named_for(mod_name: String, name: String): Ty? {
    if ty = get_named_in(mod_name, name) {
      return ty
    }
    get_named(name)
  }

  pub fn get_opaque(name: String): Ty? {
    if id = self.opaques.get(name) {
      return ty_at(id)
    }
    nil
  }

  pub fn resolve_value(tn: TypeName): Ty {
    value_only(resolve(tn), tn)
  }

  // ty as a value's type: an opaque type, a C layout and Void are not.
  pub fn value_only(ty: Ty, tn: TypeName): Ty {
    if ty.is_opaque {
      fail(tn.loc, "${ty.show} is opaque; use Ptr(${ty.show})")
      return self.t_int
    }
    if ty.is_clayout {
      fail(tn.loc, "${ty.show} is a C layout; use Ptr(${ty.show})")
      return self.t_int
    }
    if ty.is_void {
      fail(tn.loc, "Void is not a value; use Ptr(Void) or omit a return type")
      return self.t_int
    }
    ty
  }

  pub fn resolve(tn: TypeName): Ty {
    inner = resolve_core(tn)
    if tn.nilable {
      return ty_nilable(inner)
    }
    inner
  }

  pub fn reject_args(tn: TypeName) {
    if tn.args.size > 0 {
      fail(tn.loc, "${tn.name} does not take type arguments")
    }
  }

  pub fn resolve_core(tn: TypeName): Ty {
    if tn.fn_type {
      params: Array(Ty) = []
      i = 0
      while i < tn.args.size {
        params.push(resolve_value_uninline(tn.args[i]))
        i += 1
      }
      ret = self.t_void
      if r = tn.ret {
        ret = resolve_uninline(r)
      }
      return ty_fn(params, ret)
    }
    if tn.members.size > 0 {
      parts: Array(Ty) = []
      i = 0
      while i < tn.members.size {
        parts.push(resolve(tn.members[i]))
        i += 1
      }
      return ty_union_build(parts)
    }
    if tn.name == "Int" {
      reject_args(tn)
      return self.t_int
    }
    cs = c_scalar_of(tn.name)
    if cs > 0 {
      reject_args(tn)
      if !self.c_scalar_ok {
        view = ty_c_view(ty_c_scalar(cs))
        fail(tn.loc, "${tn.name} is a C type: it is allowed in a `fun` signature and a C layout's field only (in Avant it is ${view.show})")
      }
      return ty_c_scalar(cs)
    }
    if tn.name == "Int64" {
      // One integer spelling (Stage 29 W-ADOPT, D300, D317).
      fail(tn.loc, removed_int_message("Int64", "Int"))
      return self.t_int
    }
    if tn.name == "Int32" {
      reject_args(tn)
      return ty_int32()
    }
    if tn.name == "UInt32" {
      reject_args(tn)
      return ty_uint32()
    }
    if tn.name == "UInt64" {
      reject_args(tn)
      return self.t_uint64
    }
    if tn.name == "Bool" {
      reject_args(tn)
      return self.t_bool
    }
    if tn.name == "Float64" {
      reject_args(tn)
      return self.t_float
    }
    if tn.name == "String" {
      reject_args(tn)
      return self.t_string
    }
    if tn.name == "Buf" {
      reject_args(tn)
      return self.t_buf
    }
    if tn.name == "Bytes" {
      reject_args(tn)
      return self.t_bytes
    }
    if tn.name == "Nil" {
      reject_args(tn)
      return self.t_nil
    }
    if tn.name == "Void" {
      reject_args(tn)
      return self.t_void
    }
    if tn.name == "Array" {
      if tn.args.size != 1 {
        fail(tn.loc, "Array takes one type argument")
        return self.t_int
      }
      return ty_array(resolve_value_uninline(tn.args[0]))
    }
    if tn.name == "Hash" {
      if tn.args.size != 2 {
        fail(tn.loc, "Hash takes two type arguments")
        return self.t_int
      }
      hk = resolve_value_uninline(tn.args[0])
      hv = resolve_value_uninline(tn.args[1])
      why = hash_type_problem(hk, hv)
      if why.size > 0 {
        fail(tn.loc, why)
      }
      return ty_hash(hk, hv)
    }
    if tn.name == "JoinHandle" {
      if tn.args.size != 1 {
        fail(tn.loc, "JoinHandle takes one type argument")
        return self.t_int
      }
      return ty_join(resolve_value_uninline(tn.args[0]))
    }
    if idef = find_interface(tn.name) {
      return reject_iface_value(tn, idef)
    }
    if tn.name == "Ptr" {
      if tn.args.size != 1 {
        fail(tn.loc, "Ptr takes one type argument")
        return self.t_int
      }
      inner = tn.args[0]
      if inner.name == "Void" {
        reject_args(inner)
        return ty_ptr(self.t_void)
      }
      return ty_ptr(resolve_uninline(inner))
    }
    if id = self.tparams.get(tn.name), tn.args.size == 0 {
      return ty_var(tn.name)
    }
    ntmpl = template_count(tn.name)
    if ntmpl > 0 {
      if tn.mod_name.size == 0 && ntmpl > 1 {
        fail(tn.loc, "ambiguous name ${tn.name}; qualify it")
        return self.t_int
      }
      return instantiate_template(tn)
    }
    reject_args(tn)
    if tn.mod_name.size > 0 {
      if found = get_named_in(tn.mod_name, tn.name) {
        if found.template {
          fail(tn.loc, "${tn.name} needs type arguments")
          return self.t_int
        }
        return found
      }
    }
    if found = get_named(tn.name) {
      if found.template {
        fail(tn.loc, "${tn.name} needs type arguments")
        return self.t_int
      }
      return found
    }
    if al = find_alias(tn) {
      return resolve_alias(al, tn)
    }
    if opq = get_opaque(tn.name) {
      return opq
    }
    fail(tn.loc, "unknown type ${tn.name}${type_hint(tn.name)}")
    self.t_int
  }

  pub fn save_inflight: Array(String) {
    saved: Array(String) = []
    for i in 0..self.struct_inflight.size {
      saved.push(self.struct_inflight[i])
    }
    saved
  }

  pub fn resolve_uninline(tn: TypeName): Ty {
    saved = self.save_inflight
    self.struct_inflight = []
    ty = resolve(tn)
    self.struct_inflight = saved
    ty
  }

  pub fn resolve_value_uninline(tn: TypeName): Ty {
    saved = self.save_inflight
    self.struct_inflight = []
    ty = resolve_value(tn)
    self.struct_inflight = saved
    ty
  }

  pub fn inflight_has(key: String): Bool {
    for i in 0..self.struct_inflight.size {
      if self.struct_inflight[i] == key {
        return true
      }
    }
    false
  }

  pub fn format_app(origin: String, args: Array(Ty)): String {
    buf = buf_new()
    buf.push_str(origin)
    buf.push_str("(")
    i = 0
    while i < args.size {
      if i > 0 {
        buf.push_str(", ")
      }
      buf.push_str(args[i].show)
      i += 1
    }
    buf.push_str(")")
    buf.to_s
  }

  pub fn inst_key(origin: String, args: Array(Ty)): String {
    buf = buf_new()
    buf.push_str(origin)
    for arg in args {
      buf.push_str("__")
      buf.push_str(mangle_ty(arg))
    }
    buf.to_s
  }

  pub fn find_struct_template(name: String, mod_name: String): StructDef? {
    found: StructDef? = nil
    count = 0
    if p = self.program {
      for sdef in p.structs {
        if sdef.name == name && sdef.type_params.size > 0 {
          if mod_name.size > 0 {
            if sdef.mod_name == mod_name {
              return sdef
            }
          } else {
            count += 1
            found = sdef
          }
        }
      }
    }
    if mod_name.size > 0 {
      return nil
    }
    if count == 1 {
      return found
    }
    nil
  }

  pub fn find_class_template(name: String, mod_name: String): ClassDef? {
    found: ClassDef? = nil
    count = 0
    if p = self.program {
      for cdef in p.classes {
        if cdef.name == name && cdef.type_params.size > 0 {
          if mod_name.size > 0 {
            if cdef.mod_name == mod_name {
              return cdef
            }
          } else {
            count += 1
            found = cdef
          }
        }
      }
    }
    if mod_name.size > 0 {
      return nil
    }
    if count == 1 {
      return found
    }
    nil
  }

  pub fn template_count(name: String): Int {
    n = 0
    if p = self.program {
      for sdef in p.structs {
        if sdef.name == name && sdef.type_params.size > 0 {
          n += 1
        }
      }
      for cdef in p.classes {
        if cdef.name == name && cdef.type_params.size > 0 {
          n += 1
        }
      }
    }
    n
  }

  pub fn has_template(name: String): Bool {
    template_count(name) > 0
  }

  pub fn has_struct_named(name: String): Bool {
    if p = self.program {
      for sdef in p.structs {
        if sdef.name == name {
          return true
        }
      }
    }
    false
  }

  pub fn has_class_named(name: String): Bool {
    if p = self.program {
      for cls in p.classes {
        if cls.name == name {
          return true
        }
      }
    }
    false
  }

  pub fn find_interface(name: String): InterfaceDef? {
    if p = self.program {
      for idef in p.interfaces {
        if idef.name == name {
          return idef
        }
      }
    }
    nil
  }

  pub fn defines_type(name: String): Bool {
    if type_is_builtin(name) {
      return true
    }
    if p = self.program {
      for sdef in p.structs {
        if sdef.name == name {
          return true
        }
      }
      for cls in p.classes {
        if cls.name == name {
          return true
        }
      }
      for lib_def in p.libs {
        for layout in lib_def.layouts {
          if layout.name == name {
            return true
          }
        }
      }
      for iface in p.interfaces {
        if iface.name == name {
          return true
        }
      }
    }
    false
  }

  pub fn reject_iface_value(tn: TypeName, idef: InterfaceDef): Ty {
    n = idef.type_params.size
    if n == 0 {
      if tn.args.size > 0 {
        fail(tn.loc, "${idef.name} does not take type arguments")
        return self.t_int
      }
      fail(tn.loc, "${idef.name} is not a value type")
      return self.t_int
    }
    if tn.args.size == 0 {
      fail(tn.loc, "${idef.name} needs type arguments")
      return self.t_int
    }
    if tn.args.size != n {
      word = "type arguments"
      if n == 1 {
        word = "type argument"
      }
      fail(tn.loc, "${idef.name} takes ${n} ${word}")
      return self.t_int
    }
    arg_tys: Array(Ty) = []
    mark0 = self.err_count
    i = 0
    while i < tn.args.size {
      arg_tys.push(resolve(tn.args[i]))
      if new_err_since(mark0) {
        return self.t_int
      }
      i += 1
    }
    label = format_app(idef.name, arg_tys)
    fail(tn.loc, "${label} is not a value type")
    self.t_int
  }

  pub fn check_type_params(loc: Location, type_name: String, params: Array(String)) {
    seen = Hash(String, Int).new
    for p in params {
      if prev = seen.get(p) {
        fail(loc, "duplicate type parameter ${p}")
        return
      }
      seen[p] = 1
      if p == type_name {
        fail(loc, "type parameter ${p} must be a fresh name")
        return
      }
      if defines_type(p) {
        fail(loc, "type parameter ${p} must be a fresh name")
        return
      }
    }
  }

  pub fn ty_args_have_var(args: Array(Ty)): Bool {
    for arg in args {
      if ty_has_var(arg) {
        return true
      }
    }
    false
  }

  pub fn make_pattern(kind: Int, origin: String, args: Array(Ty)): Ty {
    ty_app(kind, origin, origin, format_app(origin, args), args)
  }

  pub fn clone_subst_field(field: Field, from: Array(String), to: Array(TypeName)): Field {
    t = subst_type_name(field.type, from, to)
    f = Field.new(field.loc, field.name, t)
    f.vis = field.vis
    if d = field.default {
      c = clone_expr(d)
      subst_type_in_expr(c, from, to)
      f.default = c
    }
    f
  }

  pub fn fill_inst_fields(ty: Ty, fields: Array(Field)) {
    resolved: Array(TyField) = []
    seen = Hash(String, Int).new
    mark0 = self.err_count
    for field in fields {
      if prev = seen.get(field.name) {
        fail(field.loc, "duplicate field ${field.name}")
        return
      }
      seen[field.name] = 1
      tf = TyField.new(field.name, resolve_value(field.type))
      tf.vis = field.vis
      if d = field.default {
        tf.defaulted = true
      }
      resolved.push(tf)
      if new_err_since(mark0) {
        return
      }
    }
    ty.fields = resolved
  }

  // Pins the user type names inside a type argument (O255, Stage 29
  // W-FIX1b): each is given the module of the type it resolves to here,
  // where the generic is used, and marked, so the instance's fields and
  // methods, which are checked in the generic's own module, read the
  // same types. Type parameters and built-in names are left as they are.
  pub fn pin_type_name(tn: TypeName) {
    if !tn.fn_type && tn.members.size == 0 && !tn.pinned && tn.args.size == 0 {
      if al = find_alias(tn) {
        // An alias is the type it names, wherever the instance is read.
        expand_alias_name(tn, al)
      }
    }
    for a in tn.args {
      pin_type_name(a)
    }
    for m in tn.members {
      pin_type_name(m)
    }
    if r = tn.ret {
      pin_type_name(r)
    }
    if tn.fn_type || tn.members.size > 0 || tn.pinned {
      return
    }
    if id = self.tparams.get(tn.name), tn.args.size == 0 {
      return
    }
    if template_count(tn.name) > 0 {
      if sdef = find_struct_template(tn.name, tn.mod_name) {
        tn.mod_name = sdef.mod_name
        tn.pinned = true
      } else if cdef = find_class_template(tn.name, tn.mod_name) {
        tn.mod_name = cdef.mod_name
        tn.pinned = true
      }
      return
    }
    if tn.mod_name.size > 0 {
      if found = get_named_in(tn.mod_name, tn.name) {
        tn.pinned = true
        return
      }
    }
    if found = get_named(tn.name) {
      if found.is_struct || found.is_class || found.is_clayout {
        tn.mod_name = found.mod_name
        tn.pinned = true
      }
    }
  }

  pub fn add_alias(al: AliasDef) {
    key = type_key(al.mod_name, al.name)
    if prev = self.alias_ix.get(key) {
      fail(al.loc, "type ${al.name} is already defined")
      return
    }
    self.aliases.push(al)
    i = self.aliases.size - 1
    self.alias_ix[key] = i
    if other = self.alias_ix.get(al.name) {
      self.alias_ix[al.name] = -1
    } else {
      self.alias_ix[al.name] = i
    }
  }

  // The alias a written type name names: in the module it qualifies, else
  // in the module it is resolved in, else the one module that declares it.
  pub fn find_alias(tn: TypeName): AliasDef? {
    if self.aliases.size == 0 || tn.fn_type || tn.members.size > 0 || tn.name.size == 0 {
      return nil
    }
    if tn.mod_name.size > 0 {
      if i = self.alias_ix.get(type_key(tn.mod_name, tn.name)) {
        return self.aliases[i]
      }
      return nil
    }
    if self.scope_mod.size > 0 {
      if i2 = self.alias_ix.get(type_key(self.scope_mod, tn.name)) {
        return self.aliases[i2]
      }
    }
    if i3 = self.alias_ix.get(tn.name), i3 >= 0 {
      return self.aliases[i3]
    }
    nil
  }

  // The type an alias names, resolved in the alias's own module. An alias
  // that reaches itself before a struct or class names it is refused: a
  // recursive type goes through a class, whose fields may name the alias.
  pub fn resolve_alias(al: AliasDef, tn: TypeName): Ty {
    key = type_key(al.mod_name, al.name)
    if self.alias_inflight.contains(key) {
      fail(tn.loc, "type ${al.name} names itself: a recursive type goes through a struct or class, whose field may hold a ${al.name}")
      return self.t_int
    }
    if tn.args.size > 0 {
      fail(tn.loc, "${tn.name} does not take type arguments")
      return self.t_int
    }
    self.alias_inflight.push(key)
    saved = self.scope_mod
    self.scope_mod = al.mod_name
    t = clone_type_name(al.target)
    qualify_seen(t, al.mod_name)
    ty = resolve(t)
    self.scope_mod = saved
    self.alias_inflight.pop
    ty
  }

  // tn, an alias's name, rewritten in place into the alias's type, its
  // names qualified in the alias's module (nilable kept).
  pub fn expand_alias_name(tn: TypeName, al: AliasDef) {
    key = type_key(al.mod_name, al.name)
    if self.alias_inflight.contains(key) {
      return
    }
    t = clone_type_name(al.target)
    qualify_seen(t, al.mod_name)
    self.alias_inflight.push(key)
    saved = self.scope_mod
    self.scope_mod = al.mod_name
    pin_type_name(t)
    self.scope_mod = saved
    self.alias_inflight.pop
    tn.name = t.name
    tn.args = t.args
    tn.members = t.members
    tn.mod_name = t.mod_name
    tn.fn_type = t.fn_type
    tn.ret = t.ret
    tn.pinned = t.pinned
    if t.nilable {
      tn.nilable = true
    }
  }

  pub fn instantiate_template(tn: TypeName): Ty {
    is_struct = false
    kind = tyk_class()
    params: Array(String) = []
    src_fields: Array(Field) = []
    src_methods: Array(Function) = []
    mod_name = ""
    vis = false
    loc = tn.loc
    if sdef = find_struct_template(tn.name, tn.mod_name) {
      is_struct = true
      kind = tyk_struct()
      params = sdef.type_params
      src_fields = sdef.fields
      src_methods = sdef.methods
      mod_name = sdef.mod_name
      vis = sdef.vis
      loc = sdef.loc
    } else {
      if cdef = find_class_template(tn.name, tn.mod_name) {
        kind = tyk_class()
        params = cdef.type_params
        src_fields = cdef.fields
        src_methods = cdef.methods
        mod_name = cdef.mod_name
        vis = cdef.vis
        loc = cdef.loc
      } else {
        fail(tn.loc, "unknown type ${tn.name}")
        return self.t_int
      }
    }
    if tn.args.size == 0 {
      fail(tn.loc, "${tn.name} needs type arguments")
      return self.t_int
    }
    if tn.args.size != params.size {
      n = params.size
      word = "type arguments"
      if n == 1 {
        word = "type argument"
      }
      fail(tn.loc, "${tn.name} takes ${n} ${word}")
      return self.t_int
    }
    arg_tys: Array(Ty) = []
    mark0 = self.err_count
    i = 0
    while i < tn.args.size {
      arg_tys.push(resolve(tn.args[i]))
      if new_err_since(mark0) {
        return self.t_int
      }
      i += 1
    }
    if ty_args_have_var(arg_tys) {
      // A pattern (`Cell(T)` in a generic signature) names its template's
      // module, as an instance does, so two modules' templates of one
      // name keep their methods apart.
      pat = make_pattern(kind, tn.name, arg_tys)
      pat.mod_name = mod_name
      return pat
    }
    origin_key = tn.name
    if flag = self.collide.get(tn.name) {
      origin_key = "${mod_emit_prefix(mod_name)}__${tn.name}"
    }
    key = inst_key(origin_key, arg_tys)
    label = format_app(tn.name, arg_tys)
    if is_struct && inflight_has(key) {
      fail(tn.loc, "struct layout of ${label} is infinite")
      return self.t_int
    }
    if existing = get_named(key) {
      return existing
    }
    pbounds: Array(TypeBound) = []
    if sdef0 = find_struct_template(tn.name, tn.mod_name) {
      pbounds = sdef0.param_bounds
    } else if cdef0 = find_class_template(tn.name, tn.mod_name) {
      pbounds = cdef0.param_bounds
    }
    if pbounds.size > 0 {
      use = BoundUse.new(tn.loc)
      use.label = label
      use.params = params
      use.bounds = pbounds
      for a0 in tn.args {
        pa0 = clone_type_name(a0)
        pin_type_name(pa0)
        use.args.push(pa0)
      }
      use.arg_tys = arg_tys
      use.mod_name = self.scope_mod
      self.bound_uses.push(use)
    }
    self.inst_depth += 1
    if self.inst_depth > 32 {
      fail(tn.loc, "type instantiation too deep")
      self.inst_depth -= 1
      return self.t_int
    }
    shell = ty_app(kind, key, tn.name, label, arg_tys)
    shell.mod_name = mod_name
    if flag2 = self.collide.get(tn.name) {
      shell.emit_base = "${mod_emit_prefix(mod_name)}__${tn.name}"
    }
    put_named(key, shell)
    if p = self.program {
      // The arguments as the instance carries them: copies, pinned to
      // the types they name here (pin_type_name).
      pargs: Array(TypeName) = []
      for a in tn.args {
        pa = clone_type_name(a)
        pin_type_name(pa)
        pargs.push(pa)
      }
      fields: Array(Field) = []
      methods: Array(Function) = []
      i = 0
      while i < src_fields.size {
        fields.push(clone_subst_field(src_fields[i], params, pargs))
        i += 1
      }
      i = 0
      while i < src_methods.size {
        m = clone_function(src_methods[i])
        subst_function_types(m, params, pargs)
        m.owner = key
        m.generic = false
        fresh: Array(String) = []
        m.type_params = fresh
        m.emit_name = m.name
        methods.push(m)
        i += 1
      }
      opted: Array(TypeName) = []
      src_opt: Array(TypeName) = []
      if is_struct {
        if sdef = find_struct_template(tn.name, tn.mod_name) {
          src_opt = sdef.opt_ins
        }
      } else {
        if cdef = find_class_template(tn.name, tn.mod_name) {
          src_opt = cdef.opt_ins
        }
      }
      shell.error_mark = error_opted(src_opt)
      i = 0
      while i < src_opt.size {
        opted.push(subst_type_name(src_opt[i], params, pargs))
        i += 1
      }
      if is_struct {
        if !has_struct_named(key) {
          sinst = StructDef.new(loc, key)
          sinst.fields = fields
          sinst.methods = methods
          sinst.opt_ins = opted
          sinst.mod_name = mod_name
          sinst.vis = vis
          p.structs.push(sinst)
        }
      } else {
        if !has_class_named(key) {
          cinst = ClassDef.new(loc, key)
          cinst.fields = fields
          cinst.methods = methods
          cinst.opt_ins = opted
          cinst.mod_name = mod_name
          cinst.vis = vis
          p.classes.push(cinst)
        }
      }
      if is_struct {
        self.struct_inflight.push(key)
        fill_inst_fields(shell, fields)
        self.struct_inflight.pop
      } else {
        saved = self.save_inflight
        self.struct_inflight = []
        fill_inst_fields(shell, fields)
        self.struct_inflight = saved
      }
    }
    self.inst_depth -= 1
    shell
  }
}

pub fn note_ptr_opaque_skip(tn: TypeName, resolver: TypeResolver, skip: Hash(String, Int)) {
  if r = tn.ret {
    note_ptr_opaque_skip(r, resolver, skip)
  }
  for arg in tn.args {
    note_ptr_opaque_skip(arg, resolver, skip)
  }
  i = 0
  while i < tn.members.size {
    note_ptr_opaque_skip(tn.members[i], resolver, skip)
    i += 1
  }
  for bound in tn.bounds {
    note_ptr_opaque_skip(bound, resolver, skip)
  }
  if tn.name == "Ptr" {
    if tn.args.size == 1 {
      inner = tn.args[0]
      if inner.args.size == 0 {
        if type_is_builtin(inner.name) {
          return
        }
        if existing = resolver.get_named(inner.name) {
          return
        }
        if skipped = skip.get(inner.name) {
          return
        }
        if already = resolver.get_opaque(inner.name) {
          return
        }
        opq = ty_named(tyk_opaque(), inner.name)
        id = resolver.intern(opq)
        resolver.opaques[inner.name] = id
      }
    }
  }
}

pub fn note_ptr_opaque(tn: TypeName, resolver: TypeResolver) {
  empty = Hash(String, Int).new
  note_ptr_opaque_skip(tn, resolver, empty)
}

pub fn note_type_name(tn: TypeName, resolver: TypeResolver) {
  note_ptr_opaque(tn, resolver)
}

pub fn collect_opaques(program: Program, resolver: TypeResolver) {
  for lib_def in program.libs {
    for cfun in lib_def.funs {
      for param in cfun.params {
        note_type_name(param.type, resolver)
      }
      if ret = cfun.return_type {
        note_type_name(ret, resolver)
      }
    }
    for lay in lib_def.layouts {
      k = 0
      while k < lay.fields.size {
        note_type_name(lay.fields[k].type, resolver)
        k += 1
      }
    }
  }
  for sdef in program.structs {
    j = 0
    while j < sdef.fields.size {
      note_type_name(sdef.fields[j].type, resolver)
      j += 1
    }
  }
  for cdef in program.classes {
    j = 0
    while j < cdef.fields.size {
      note_type_name(cdef.fields[j].type, resolver)
      j += 1
    }
  }
  fns = program_all_functions(program)
  for fnn in fns {
    names = collect_fn_type_params(fnn, resolver.named)
    skip = Hash(String, Int).new
    for name in names {
      skip[name] = 1
    }
    for param in fnn.params {
      note_ptr_opaque_skip(param.type, resolver, skip)
    }
    if recv = fnn.receiver {
      note_ptr_opaque_skip(recv.type, resolver, skip)
    }
    if ret = fnn.return_type {
      note_ptr_opaque_skip(ret, resolver, skip)
    }
  }
}

pub fn c_field_ok(ty: Ty): Bool {
  if ty.is_integer {
    return true
  }
  // An enum is C's int in a C layout (Stage 29 W5a1, D358).
  if ty.is_enum {
    return true
  }
  if ty.is_uint64 {
    return true
  }
  if ty.is_bool {
    return true
  }
  if ty.is_float {
    return true
  }
  if ty.is_string {
    return true
  }
  if ty.is_clayout {
    return true
  }
  if ty.is_ptr {
    if inner = ty.inner {
      if inner.is_void {
        return true
      }
      if inner.is_opaque {
        return true
      }
      if inner.is_clayout {
        return true
      }
    }
  }
  false
}

pub fn fill_clayout_fields(resolver: TypeResolver, layout: CLayout, ready: Hash(String, Int)) {
  resolved: Array(TyField) = []
  seen = Hash(String, Int).new
  i = 0
  while i < layout.fields.size {
    field = layout.fields[i]
    if prev = seen.get(field.name) {
      resolver.fail(field.loc, "duplicate field ${field.name}")
      return
    }
    seen[field.name] = 1
    markf = resolver.err_count
    resolver.c_scalar_ok = true
    ty = resolver.resolve(field.type)
    resolver.c_scalar_ok = false
    if resolver.new_err_since(markf) {
      return
    }
    if ty.is_clayout {
      if mark = ready.get(resolver.type_key(ty.mod_name, ty.name)) {
      } else {
        resolver.fail(field.loc, "${ty.name} is not a complete C layout yet")
        return
      }
    }
    if !c_field_ok(ty) {
      resolver.fail(field.loc, "C layout fields must be C types, not ${ty.show}")
      return
    }
    resolved.push(TyField.new(field.name, ty))
    i += 1
  }
  if ty = resolver.get_named_in(layout.mod_name, layout.name) {
    ty.fields = resolved
  }
  ready[resolver.type_key(layout.mod_name, layout.name)] = 1
}

// Whether module m declares a pub type name (a struct, an enum, a
// class, an interface or a C layout).
pub fn type_is_pub(p: Program, m: String, name: String): Bool {
  for sdef in p.structs {
    if sdef.mod_name == m && sdef.name == name {
      return sdef.vis
    }
  }
  for cdef in p.classes {
    if cdef.mod_name == m && cdef.name == name {
      return cdef.vis
    }
  }
  for idef in p.interfaces {
    if idef.mod_name == m && idef.name == name {
      return idef.vis
    }
  }
  for lib_def in p.libs {
    if lib_def.mod_name == m {
      for lay in lib_def.layouts {
        if lay.name == name {
          return lib_def.vis
        }
      }
    }
  }
  false
}

pub fn fill_type_fields(resolver: TypeResolver, mod_name: String, name: String, fields: Array(Field)) {
  resolved: Array(TyField) = []
  seen = Hash(String, Int).new
  for field in fields {
    if prev = seen.get(field.name) {
      resolver.fail(field.loc, "duplicate field ${field.name}")
      return
    }
    seen[field.name] = 1
    resolver.qualify_seen(field.type, mod_name)
    resolver.scope_mod = mod_name
    tf = TyField.new(field.name, resolver.resolve_value(field.type))
    resolver.scope_mod = ""
    tf.vis = field.vis
    if d = field.default {
      tf.defaulted = true
    }
    resolved.push(tf)
  }
  if ty = resolver.get_named_in(mod_name, name) {
    ty.fields = resolved
  }
}

pub fn load_types(program: Program): TypeResolver {
  resolver = TypeResolver.new
  resolver.program = program
  for sdef in program.structs {
    if sdef.name == "Error" {
      resolver.fail(sdef.loc, "Error is the built-in error marker (class E: Error); choose another name")
      continue
    }
    if existing = resolver.get_named_in(sdef.mod_name, sdef.name) {
      resolver.fail(sdef.loc, "${sdef.name} is already defined")
      continue
    }
    if sdef.type_params.size > 0 {
      resolver.check_type_params(sdef.loc, sdef.name, sdef.type_params)
    }
    sty = ty_named(tyk_struct(), sdef.name)
    if decl = sdef.enum_of {
      // An enum (Stage 29 W5a1): its own type kind, with its members.
      sty = ty_named(tyk_enum(), sdef.name)
      info = TyEnum.new
      info.names = decl.names
      info.vals = decl.vals
      info.c_int = decl.c_int
      sty.members_of = info
    }
    sty.error_mark = error_opted(sdef.opt_ins)
    if sdef.type_params.size > 0 {
      sty.template = true
    }
    resolver.bind_type(sdef.mod_name, sdef.name, sty)
  }
  for cdef in program.classes {
    if cdef.name == "Error" {
      resolver.fail(cdef.loc, "Error is the built-in error marker (class E: Error); choose another name")
      continue
    }
    if already = resolver.get_named_in(cdef.mod_name, cdef.name) {
      resolver.fail(cdef.loc, "${cdef.name} is already defined")
      continue
    }
    if cdef.type_params.size > 0 {
      resolver.check_type_params(cdef.loc, cdef.name, cdef.type_params)
    }
    cty = ty_named(tyk_class(), cdef.name)
    cty.error_mark = error_opted(cdef.opt_ins)
    if cdef.type_params.size > 0 {
      cty.template = true
    }
    resolver.bind_type(cdef.mod_name, cdef.name, cty)
  }
  for idef in program.interfaces {
    if existing = resolver.get_named_in(idef.mod_name, idef.name) {
      resolver.fail(idef.loc, "${idef.name} is already defined")
      continue
    }
    if idef.name == "Error" {
      resolver.fail(idef.loc, "Error is the built-in error marker (class E: Error); choose another name")
      continue
    }
    if idef.type_params.size > 0 {
      resolver.check_type_params(idef.loc, idef.name, idef.type_params)
    }
    ity = ty_named(tyk_iface(), idef.name)
    if idef.type_params.size > 0 {
      ity.template = true
    }
    resolver.bind_type(idef.mod_name, idef.name, ity)
  }
  for lib_def in program.libs {
    for lay in lib_def.layouts {
      if existing = resolver.get_named_in(lib_def.mod_name, lay.name) {
        resolver.fail(lay.loc, "${lay.name} is already defined")
        continue
      }
      resolver.bind_type(lib_def.mod_name, lay.name, ty_named(tyk_clayout(), lay.name))
    }
  }
  for lib_def in program.libs {
    if existing = resolver.get_named(lib_def.name) {
      resolver.fail(lib_def.loc, "lib ${lib_def.name} collides with a type")
    } else {
      if flag = resolver.collide.get(lib_def.name) {
        resolver.fail(lib_def.loc, "lib ${lib_def.name} collides with a type")
      }
    }
  }
  for al in program.aliases {
    if al.name == "Error" {
      resolver.fail(al.loc, "Error is the built-in error marker (class E: Error); choose another name")
      continue
    }
    if existing = resolver.get_named_in(al.mod_name, al.name) {
      resolver.fail(al.loc, "${al.name} is already defined")
      continue
    }
    resolver.add_alias(al)
  }
  collect_opaques(program, resolver)
  for sdef2 in program.structs {
    if !(sdef2.type_params.size > 0) {
      fill_type_fields(resolver, sdef2.mod_name, sdef2.name, sdef2.fields)
    }
  }
  for cdef2 in program.classes {
    if !(cdef2.type_params.size > 0) {
      fill_type_fields(resolver, cdef2.mod_name, cdef2.name, cdef2.fields)
    }
  }
  ready = Hash(String, Int).new
  for lib_def in program.libs {
    j = 0
    while j < lib_def.layouts.size {
      fill_clayout_fields(resolver, lib_def.layouts[j], ready)
      j += 1
    }
  }
  seal_type_emits(program, resolver)
  resolver
}

pub fn seal_type_emits(program: Program, resolver: TypeResolver) {
  for sdef in program.structs {
    seal_one_emit(resolver, sdef.mod_name, sdef.name)
  }
  for cdef in program.classes {
    seal_one_emit(resolver, cdef.mod_name, cdef.name)
  }
  for idef in program.interfaces {
    seal_one_emit(resolver, idef.mod_name, idef.name)
  }
  for lib_def in program.libs {
    for lay in lib_def.layouts {
      seal_one_emit(resolver, lib_def.mod_name, lay.name)
    }
  }
}

pub fn seal_one_emit(resolver: TypeResolver, mod_name: String, name: String) {
  if flag = resolver.collide.get(name), ty = resolver.get_named_in(mod_name, name) {
    ty.emit_base = "${mod_emit_prefix(mod_name)}__${name}"
  }
}

