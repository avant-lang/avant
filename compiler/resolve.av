import location
import diagnostic
import source
import token
import lexer
import type
import ast

pub class TypeResolver {
  pub named: Hash(String, Int)
  pub collide: Hash(String, Int)
  opaques: Hash(String, Int)
  interned: Array(Ty)
  failed: Bool = false
  err: CompileError? = nil
  pub errors: DiagBag
  pub t_int: Ty
  pub t_int64: Ty
  pub t_uint64: Ty
  pub t_bool: Ty
  pub t_float: Ty
  pub t_string: Ty
  pub t_void: Ty
  pub t_nil: Ty
  pub t_buf: Ty
  pub t_bytes: Ty
  tparams: Hash(String, Int)
  pub tparam_names: Array(String)
  program: Program? = nil
  struct_inflight: Array(String)
  inst_depth: Int = 0
  // Set while a `fun` signature or a C layout's fields resolve: the only
  // places a C scalar type (Int8 ... Float32) may be named (Stage 29 W1b).
  pub c_scalar_ok: Bool = false
  // Every declared type name, for "did you mean" (Stage 29 W3a).
  type_names: Array(String)

  fn initialize {
    n = Hash(String, Int).new
    self.named = n
    col = Hash(String, Int).new
    self.collide = col
    o = Hash(String, Int).new
    self.opaques = o
    inn: Array(Ty) = []
    inn.push(ty_void())
    self.interned = inn
    self.t_int = ty_int()
    self.t_int64 = ty_int64()
    self.t_uint64 = ty_uint64()
    self.t_bool = ty_bool()
    self.t_float = ty_float()
    self.t_string = ty_string()
    self.t_void = ty_void()
    self.t_nil = ty_nil()
    self.t_buf = ty_buf()
    self.t_bytes = ty_bytes()
    tp = Hash(String, Int).new
    self.tparams = tp
    self.tparam_names = []
    self.program = nil
    self.struct_inflight = []
    self.type_names = []
    self.inst_depth = 0
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new
  }

  pub fn set_tparams(names: Array(String)) {
    tp = Hash(String, Int).new
    copy: Array(String) = []
    i = 0
    while i < names.size {
      tp[names[i]] = 1
      copy.push(names[i])
      i += 1
    }
    self.tparams = tp
    self.tparam_names = copy
  }

  pub fn clear_tparams {
    tp = Hash(String, Int).new
    self.tparams = tp
    self.tparam_names = []
  }

  pub fn has_err: Bool {
    self.failed
  }

  pub fn fail(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(3, message), message)
    if self.errors.count == 0 {
      self.err = e
    }
    self.failed = true
    self.errors.push(e)
  }

  // Every error counts, kept or not (O163, Stage 29 W1a; O162 fixed the
  // parser the same way): the bag keeps at most 20 and drops repeats, so
  // its item count cannot be a mark.
  pub fn err_count: Int {
    self.errors.pushes
  }

  pub fn new_err_since(mark: Int): Bool {
    self.errors.pushes > mark
  }

  pub fn intern(ty: Ty): Int {
    self.interned.push(ty)
    self.interned.size - 1
  }

  pub fn ty_at(id: Int): Ty {
    self.interned[id]
  }

  pub fn type_key(mod_name: String, name: String): String {
    "${mod_name}@@${name}"
  }

  pub fn put_named(name: String, ty: Ty): Int {
    id = self.intern(ty)
    if prev = self.named.get(name) {
    } else {
      self.type_names.push(name)
    }
    self.named[name] = id
    id
  }

  pub fn bind_type(mod_name: String, name: String, ty: Ty): Int {
    ty.mod_name = mod_name
    id = self.intern(ty)
    self.named[self.type_key(mod_name, name)] = id
    if prev = self.named.get(name) {
      old = self.ty_at(prev)
      if old.mod_name != mod_name {
        self.collide[name] = 1
      }
    } else {
      self.named[name] = id
      self.type_names.push(name)
    }
    id
  }

  // The known type name nearest to name, as " (did you mean `String`?)",
  // or "" when none is close (Stage 29 W3a, D298: a name that is not a
  // single capital letter is no longer a type parameter).
  pub fn type_hint(name: String): String {
    best = ""
    best_d = name.size / 3
    if best_d < 1 {
      best_d = 1
    }
    best_d += 1
    builtin = "Int Int64 UInt64 Bool Float64 String Array Hash Buf Bytes Ptr Void Nil"
    cands = builtin.split(" ")
    for t in self.type_names {
      cands.push(t)
    }
    for t in cands {
      d = name_distance(name, t)
      if d < best_d && t != name {
        best = t
        best_d = d
      }
    }
    if best.size == 0 {
      return ""
    }
    " (did you mean `${best}`?)"
  }

  pub fn get_named(name: String): Ty? {
    if flag = self.collide.get(name) {
      return nil
    }
    if id = self.named.get(name) {
      return self.ty_at(id)
    }
    nil
  }

  pub fn get_named_in(mod_name: String, name: String): Ty? {
    if id = self.named.get(self.type_key(mod_name, name)) {
      return self.ty_at(id)
    }
    nil
  }

  pub fn get_named_for(mod_name: String, name: String): Ty? {
    if ty = self.get_named_in(mod_name, name) {
      return ty
    }
    self.get_named(name)
  }

  pub fn get_opaque(name: String): Ty? {
    if id = self.opaques.get(name) {
      return self.ty_at(id)
    }
    nil
  }

  pub fn resolve_value(tn: TypeName): Ty {
    ty = self.resolve(tn)
    if ty.is_opaque {
      self.fail(tn.loc, "${ty.show} is opaque; use Ptr(${ty.show})")
      return self.t_int
    }
    if ty.is_clayout {
      self.fail(tn.loc, "${ty.show} is a C layout; use Ptr(${ty.show})")
      return self.t_int
    }
    if ty.is_void {
      self.fail(tn.loc, "Void is not a value; use Ptr(Void) or omit a return type")
      return self.t_int
    }
    ty
  }

  pub fn resolve(tn: TypeName): Ty {
    inner = self.resolve_core(tn)
    if tn.nilable {
      return ty_nilable(inner)
    }
    inner
  }

  pub fn reject_args(tn: TypeName) {
    if tn.args.size > 0 {
      self.fail(tn.loc, "${tn.name} does not take type arguments")
    }
  }

  pub fn resolve_core(tn: TypeName): Ty {
    if tn.fn_type {
      params: Array(Ty) = []
      i = 0
      while i < tn.args.size {
        params.push(self.resolve_value_uninline(tn.args[i]))
        i += 1
      }
      ret = self.t_void
      if r = tn.ret {
        ret = self.resolve_uninline(r)
      }
      return ty_fn(params, ret)
    }
    if tn.members.size > 0 {
      parts: Array(Ty) = []
      i = 0
      while i < tn.members.size {
        parts.push(self.resolve(tn.members[i]))
        i += 1
      }
      return ty_union_build(parts)
    }
    if tn.name == "Int" {
      self.reject_args(tn)
      return self.t_int
    }
    cs = c_scalar_of(tn.name)
    if cs > 0 {
      self.reject_args(tn)
      if !self.c_scalar_ok {
        view = ty_c_view(ty_c_scalar(cs))
        self.fail(tn.loc, "${tn.name} is a C type: it is allowed in a `fun` signature and a C layout's field only (in Avant it is ${view.show})")
      }
      return ty_c_scalar(cs)
    }
    if tn.name == "Int64" {
      self.reject_args(tn)
      return self.t_int64
    }
    if tn.name == "UInt64" {
      self.reject_args(tn)
      return self.t_uint64
    }
    if tn.name == "Bool" {
      self.reject_args(tn)
      return self.t_bool
    }
    if tn.name == "Float64" {
      self.reject_args(tn)
      return self.t_float
    }
    if tn.name == "String" {
      self.reject_args(tn)
      return self.t_string
    }
    if tn.name == "Buf" {
      self.reject_args(tn)
      return self.t_buf
    }
    if tn.name == "Bytes" {
      self.reject_args(tn)
      return self.t_bytes
    }
    if tn.name == "Nil" {
      self.reject_args(tn)
      return self.t_nil
    }
    if tn.name == "Void" {
      self.reject_args(tn)
      return self.t_void
    }
    if tn.name == "Array" {
      if tn.args.size != 1 {
        self.fail(tn.loc, "Array takes one type argument")
        return self.t_int
      }
      return ty_array(self.resolve_value_uninline(tn.args[0]))
    }
    if tn.name == "Hash" {
      if tn.args.size != 2 {
        self.fail(tn.loc, "Hash takes two type arguments")
        return self.t_int
      }
      return ty_hash(self.resolve_value_uninline(tn.args[0]), self.resolve_value_uninline(tn.args[1]))
    }
    if tn.name == "JoinHandle" {
      if tn.args.size != 1 {
        self.fail(tn.loc, "JoinHandle takes one type argument")
        return self.t_int
      }
      return ty_join(self.resolve_value_uninline(tn.args[0]))
    }
    if idef = self.find_interface(tn.name) {
      return self.reject_iface_value(tn, idef)
    }
    if tn.name == "Ptr" {
      if tn.args.size != 1 {
        self.fail(tn.loc, "Ptr takes one type argument")
        return self.t_int
      }
      inner = tn.args[0]
      if inner.name == "Void" {
        self.reject_args(inner)
        return ty_ptr(self.t_void)
      }
      return ty_ptr(self.resolve_uninline(inner))
    }
    if id = self.tparams.get(tn.name) {
      if tn.args.size == 0 {
        return ty_var(tn.name)
      }
    }
    ntmpl = self.template_count(tn.name)
    if ntmpl > 0 {
      if tn.mod_name.size == 0 && ntmpl > 1 {
        self.fail(tn.loc, "ambiguous name ${tn.name}; qualify it")
        return self.t_int
      }
      return self.instantiate_template(tn)
    }
    self.reject_args(tn)
    if tn.mod_name.size > 0 {
      if found = self.get_named_in(tn.mod_name, tn.name) {
        if found.template {
          self.fail(tn.loc, "${tn.name} needs type arguments")
          return self.t_int
        }
        return found
      }
    }
    if found = self.get_named(tn.name) {
      if found.template {
        self.fail(tn.loc, "${tn.name} needs type arguments")
        return self.t_int
      }
      return found
    }
    if opq = self.get_opaque(tn.name) {
      return opq
    }
    self.fail(tn.loc, "unknown type ${tn.name}${self.type_hint(tn.name)}")
    self.t_int
  }

  pub fn save_inflight: Array(String) {
    saved: Array(String) = []
    for i in 0..self.struct_inflight.size {
      saved.push(self.struct_inflight[i])
    }
    saved
  }

  pub fn resolve_uninline(tn: TypeName): Ty {
    saved = self.save_inflight
    self.struct_inflight = []
    ty = self.resolve(tn)
    self.struct_inflight = saved
    ty
  }

  pub fn resolve_value_uninline(tn: TypeName): Ty {
    saved = self.save_inflight
    self.struct_inflight = []
    ty = self.resolve_value(tn)
    self.struct_inflight = saved
    ty
  }

  pub fn inflight_has(key: String): Bool {
    for i in 0..self.struct_inflight.size {
      if self.struct_inflight[i] == key {
        return true
      }
    }
    false
  }

  pub fn format_app(origin: String, args: Array(Ty)): String {
    buf = buf_new()
    buf.push_str(origin)
    buf.push_str("(")
    i = 0
    while i < args.size {
      if i > 0 {
        buf.push_str(", ")
      }
      buf.push_str(args[i].show)
      i += 1
    }
    buf.push_str(")")
    buf.to_s
  }

  pub fn inst_key(origin: String, args: Array(Ty)): String {
    buf = buf_new()
    buf.push_str(origin)
    for arg in args {
      buf.push_str("__")
      buf.push_str(mangle_ty(arg))
    }
    buf.to_s
  }

  pub fn find_struct_template(name: String, mod_name: String): StructDef? {
    found: StructDef? = nil
    count = 0
    if p = self.program {
      for sdef in p.structs {
        if sdef.name == name && sdef.type_params.size > 0 {
          if mod_name.size > 0 {
            if sdef.mod_name == mod_name {
              return sdef
            }
          } else {
            count += 1
            found = sdef
          }
        }
      }
    }
    if mod_name.size > 0 {
      return nil
    }
    if count == 1 {
      return found
    }
    nil
  }

  pub fn find_class_template(name: String, mod_name: String): ClassDef? {
    found: ClassDef? = nil
    count = 0
    if p = self.program {
      for cdef in p.classes {
        if cdef.name == name && cdef.type_params.size > 0 {
          if mod_name.size > 0 {
            if cdef.mod_name == mod_name {
              return cdef
            }
          } else {
            count += 1
            found = cdef
          }
        }
      }
    }
    if mod_name.size > 0 {
      return nil
    }
    if count == 1 {
      return found
    }
    nil
  }

  pub fn template_count(name: String): Int {
    n = 0
    if p = self.program {
      for sdef in p.structs {
        if sdef.name == name && sdef.type_params.size > 0 {
          n += 1
        }
      }
      for cdef in p.classes {
        if cdef.name == name && cdef.type_params.size > 0 {
          n += 1
        }
      }
    }
    n
  }

  pub fn has_template(name: String): Bool {
    self.template_count(name) > 0
  }

  pub fn has_struct_named(name: String): Bool {
    if p = self.program {
      for sdef in p.structs {
        if sdef.name == name {
          return true
        }
      }
    }
    false
  }

  pub fn has_class_named(name: String): Bool {
    if p = self.program {
      for cls in p.classes {
        if cls.name == name {
          return true
        }
      }
    }
    false
  }

  pub fn find_interface(name: String): InterfaceDef? {
    if p = self.program {
      for idef in p.interfaces {
        if idef.name == name {
          return idef
        }
      }
    }
    nil
  }

  pub fn defines_type(name: String): Bool {
    if type_is_builtin(name) {
      return true
    }
    if p = self.program {
      for sdef in p.structs {
        if sdef.name == name {
          return true
        }
      }
      for cls in p.classes {
        if cls.name == name {
          return true
        }
      }
      for lib_def in p.libs {
        for layout in lib_def.layouts {
          if layout.name == name {
            return true
          }
        }
      }
      for iface in p.interfaces {
        if iface.name == name {
          return true
        }
      }
    }
    false
  }

  pub fn reject_iface_value(tn: TypeName, idef: InterfaceDef): Ty {
    n = idef.type_params.size
    if n == 0 {
      if tn.args.size > 0 {
        self.fail(tn.loc, "${idef.name} does not take type arguments")
        return self.t_int
      }
      self.fail(tn.loc, "${idef.name} is not a value type")
      return self.t_int
    }
    if tn.args.size == 0 {
      self.fail(tn.loc, "${idef.name} needs type arguments")
      return self.t_int
    }
    if tn.args.size != n {
      word = "type arguments"
      if n == 1 {
        word = "type argument"
      }
      self.fail(tn.loc, "${idef.name} takes ${n} ${word}")
      return self.t_int
    }
    arg_tys: Array(Ty) = []
    mark0 = self.err_count
    i = 0
    while i < tn.args.size {
      arg_tys.push(self.resolve(tn.args[i]))
      if self.new_err_since(mark0) {
        return self.t_int
      }
      i += 1
    }
    label = self.format_app(idef.name, arg_tys)
    self.fail(tn.loc, "${label} is not a value type")
    self.t_int
  }

  pub fn check_type_params(loc: Location, type_name: String, params: Array(String)) {
    seen = Hash(String, Int).new
    for p in params {
      if prev = seen.get(p) {
        self.fail(loc, "duplicate type parameter ${p}")
        return
      }
      seen[p] = 1
      if p == type_name {
        self.fail(loc, "type parameter ${p} must be a fresh name")
        return
      }
      if self.defines_type(p) {
        self.fail(loc, "type parameter ${p} must be a fresh name")
        return
      }
    }
  }

  pub fn ty_args_have_var(args: Array(Ty)): Bool {
    for arg in args {
      if ty_has_var(arg) {
        return true
      }
    }
    false
  }

  pub fn make_pattern(kind: Int, origin: String, args: Array(Ty)): Ty {
    ty_app(kind, origin, origin, self.format_app(origin, args), args)
  }

  pub fn clone_subst_field(field: Field, from: Array(String), to: Array(TypeName)): Field {
    t = subst_type_name(field.type, from, to)
    f = Field.new(field.loc, field.name, t)
    f.vis = field.vis
    if d = field.default {
      c = clone_expr(d)
      subst_type_in_expr(c, from, to)
      f.default = c
    }
    f
  }

  pub fn fill_inst_fields(ty: Ty, fields: Array(Field)) {
    resolved: Array(TyField) = []
    seen = Hash(String, Int).new
    mark0 = self.err_count
    for field in fields {
      if prev = seen.get(field.name) {
        self.fail(field.loc, "duplicate field ${field.name}")
        return
      }
      seen[field.name] = 1
      tf = TyField.new(field.name, self.resolve_value(field.type))
      tf.vis = field.vis
      resolved.push(tf)
      if self.new_err_since(mark0) {
        return
      }
    }
    ty.fields = resolved
  }

  pub fn instantiate_template(tn: TypeName): Ty {
    is_struct = false
    kind = tyk_class()
    params: Array(String) = []
    src_fields: Array(Field) = []
    src_methods: Array(Function) = []
    mod_name = ""
    vis = false
    loc = tn.loc
    if sdef = self.find_struct_template(tn.name, tn.mod_name) {
      is_struct = true
      kind = tyk_struct()
      params = sdef.type_params
      src_fields = sdef.fields
      src_methods = sdef.methods
      mod_name = sdef.mod_name
      vis = sdef.vis
      loc = sdef.loc
    } else {
      if cdef = self.find_class_template(tn.name, tn.mod_name) {
        kind = tyk_class()
        params = cdef.type_params
        src_fields = cdef.fields
        src_methods = cdef.methods
        mod_name = cdef.mod_name
        vis = cdef.vis
        loc = cdef.loc
      } else {
        self.fail(tn.loc, "unknown type ${tn.name}")
        return self.t_int
      }
    }
    if tn.args.size == 0 {
      self.fail(tn.loc, "${tn.name} needs type arguments")
      return self.t_int
    }
    if tn.args.size != params.size {
      n = params.size
      word = "type arguments"
      if n == 1 {
        word = "type argument"
      }
      self.fail(tn.loc, "${tn.name} takes ${n} ${word}")
      return self.t_int
    }
    arg_tys: Array(Ty) = []
    mark0 = self.err_count
    i = 0
    while i < tn.args.size {
      arg_tys.push(self.resolve(tn.args[i]))
      if self.new_err_since(mark0) {
        return self.t_int
      }
      i += 1
    }
    if self.ty_args_have_var(arg_tys) {
      return self.make_pattern(kind, tn.name, arg_tys)
    }
    origin_key = tn.name
    if flag = self.collide.get(tn.name) {
      origin_key = "${mod_emit_prefix(mod_name)}__${tn.name}"
    }
    key = self.inst_key(origin_key, arg_tys)
    label = self.format_app(tn.name, arg_tys)
    if is_struct && self.inflight_has(key) {
      self.fail(tn.loc, "struct layout of ${label} is infinite")
      return self.t_int
    }
    if existing = self.get_named(key) {
      return existing
    }
    self.inst_depth += 1
    if self.inst_depth > 32 {
      self.fail(tn.loc, "type instantiation too deep")
      self.inst_depth -= 1
      return self.t_int
    }
    shell = ty_app(kind, key, tn.name, label, arg_tys)
    shell.mod_name = mod_name
    if flag2 = self.collide.get(tn.name) {
      shell.emit_base = "${mod_emit_prefix(mod_name)}__${tn.name}"
    }
    self.put_named(key, shell)
    if p = self.program {
      fields: Array(Field) = []
      methods: Array(Function) = []
      i = 0
      while i < src_fields.size {
        fields.push(self.clone_subst_field(src_fields[i], params, tn.args))
        i += 1
      }
      i = 0
      while i < src_methods.size {
        m = clone_function(src_methods[i])
        subst_function_types(m, params, tn.args)
        m.owner = key
        m.generic = false
        fresh: Array(String) = []
        m.type_params = fresh
        m.emit_name = m.name
        methods.push(m)
        i += 1
      }
      opted: Array(TypeName) = []
      src_opt: Array(TypeName) = []
      if is_struct {
        if sdef = self.find_struct_template(tn.name, tn.mod_name) {
          src_opt = sdef.opt_ins
        }
      } else {
        if cdef = self.find_class_template(tn.name, tn.mod_name) {
          src_opt = cdef.opt_ins
        }
      }
      shell.error_mark = error_opted(src_opt)
      i = 0
      while i < src_opt.size {
        opted.push(subst_type_name(src_opt[i], params, tn.args))
        i += 1
      }
      if is_struct {
        if !self.has_struct_named(key) {
          sinst = StructDef.new(loc, key)
          sinst.fields = fields
          sinst.methods = methods
          sinst.opt_ins = opted
          sinst.mod_name = mod_name
          sinst.vis = vis
          p.structs.push(sinst)
        }
      } else {
        if !self.has_class_named(key) {
          cinst = ClassDef.new(loc, key)
          cinst.fields = fields
          cinst.methods = methods
          cinst.opt_ins = opted
          cinst.mod_name = mod_name
          cinst.vis = vis
          p.classes.push(cinst)
        }
      }
      if is_struct {
        self.struct_inflight.push(key)
        self.fill_inst_fields(shell, fields)
        self.struct_inflight.pop
      } else {
        saved = self.save_inflight
        self.struct_inflight = []
        self.fill_inst_fields(shell, fields)
        self.struct_inflight = saved
      }
    }
    self.inst_depth -= 1
    shell
  }
}

pub fn note_ptr_opaque_skip(tn: TypeName, resolver: TypeResolver, skip: Hash(String, Int)) {
  if r = tn.ret {
    note_ptr_opaque_skip(r, resolver, skip)
  }
  for arg in tn.args {
    note_ptr_opaque_skip(arg, resolver, skip)
  }
  i = 0
  while i < tn.members.size {
    note_ptr_opaque_skip(tn.members[i], resolver, skip)
    i += 1
  }
  for bound in tn.bounds {
    note_ptr_opaque_skip(bound, resolver, skip)
  }
  if tn.name == "Ptr" {
    if tn.args.size == 1 {
      inner = tn.args[0]
      if inner.args.size == 0 {
        if type_is_builtin(inner.name) {
          return
        }
        if existing = resolver.get_named(inner.name) {
          return
        }
        if skipped = skip.get(inner.name) {
          return
        }
        if already = resolver.get_opaque(inner.name) {
          return
        }
        opq = ty_named(tyk_opaque(), inner.name)
        id = resolver.intern(opq)
        resolver.opaques[inner.name] = id
      }
    }
  }
}

pub fn note_ptr_opaque(tn: TypeName, resolver: TypeResolver) {
  empty = Hash(String, Int).new
  note_ptr_opaque_skip(tn, resolver, empty)
}

pub fn note_type_name(tn: TypeName, resolver: TypeResolver) {
  note_ptr_opaque(tn, resolver)
}

pub fn collect_opaques(program: Program, resolver: TypeResolver) {
  for lib_def in program.libs {
    for cfun in lib_def.funs {
      for param in cfun.params {
        note_type_name(param.type, resolver)
      }
      if ret = cfun.return_type {
        note_type_name(ret, resolver)
      }
    }
    for lay in lib_def.layouts {
      k = 0
      while k < lay.fields.size {
        note_type_name(lay.fields[k].type, resolver)
        k += 1
      }
    }
  }
  for sdef in program.structs {
    j = 0
    while j < sdef.fields.size {
      note_type_name(sdef.fields[j].type, resolver)
      j += 1
    }
  }
  for cdef in program.classes {
    j = 0
    while j < cdef.fields.size {
      note_type_name(cdef.fields[j].type, resolver)
      j += 1
    }
  }
  fns = program_all_functions(program)
  for fnn in fns {
    names = collect_fn_type_params(fnn, resolver.named)
    skip = Hash(String, Int).new
    for name in names {
      skip[name] = 1
    }
    for param in fnn.params {
      note_ptr_opaque_skip(param.type, resolver, skip)
    }
    if recv = fnn.receiver {
      note_ptr_opaque_skip(recv.type, resolver, skip)
    }
    if ret = fnn.return_type {
      note_ptr_opaque_skip(ret, resolver, skip)
    }
  }
}

pub fn c_field_ok(ty: Ty): Bool {
  if ty.is_int {
    return true
  }
  if ty.is_int64 {
    return true
  }
  if ty.is_uint64 {
    return true
  }
  if ty.is_bool {
    return true
  }
  if ty.is_float {
    return true
  }
  if ty.is_string {
    return true
  }
  if ty.is_clayout {
    return true
  }
  if ty.is_ptr {
    if inner = ty.inner {
      if inner.is_void {
        return true
      }
      if inner.is_opaque {
        return true
      }
      if inner.is_clayout {
        return true
      }
    }
  }
  false
}

pub fn fill_clayout_fields(resolver: TypeResolver, layout: CLayout, ready: Hash(String, Int)) {
  resolved: Array(TyField) = []
  seen = Hash(String, Int).new
  i = 0
  while i < layout.fields.size {
    field = layout.fields[i]
    if prev = seen.get(field.name) {
      resolver.fail(field.loc, "duplicate field ${field.name}")
      return
    }
    seen[field.name] = 1
    markf = resolver.err_count
    resolver.c_scalar_ok = true
    ty = resolver.resolve(field.type)
    resolver.c_scalar_ok = false
    if resolver.new_err_since(markf) {
      return
    }
    if ty.is_clayout {
      if mark = ready.get(resolver.type_key(ty.mod_name, ty.name)) {
      } else {
        resolver.fail(field.loc, "${ty.name} is not a complete C layout yet")
        return
      }
    }
    if !c_field_ok(ty) {
      resolver.fail(field.loc, "C layout fields must be C types, not ${ty.show}")
      return
    }
    resolved.push(TyField.new(field.name, ty))
    i += 1
  }
  if ty = resolver.get_named_in(layout.mod_name, layout.name) {
    ty.fields = resolved
  }
  ready[resolver.type_key(layout.mod_name, layout.name)] = 1
}

pub fn fill_type_fields(resolver: TypeResolver, mod_name: String, name: String, fields: Array(Field)) {
  resolved: Array(TyField) = []
  seen = Hash(String, Int).new
  for field in fields {
    if prev = seen.get(field.name) {
      resolver.fail(field.loc, "duplicate field ${field.name}")
      return
    }
    seen[field.name] = 1
    tf = TyField.new(field.name, resolver.resolve_value(field.type))
    tf.vis = field.vis
    resolved.push(tf)
  }
  if ty = resolver.get_named_in(mod_name, name) {
    ty.fields = resolved
  }
}

pub fn load_types(program: Program): TypeResolver {
  resolver = TypeResolver.new
  resolver.program = program
  for sdef in program.structs {
    if sdef.name == "Error" {
      resolver.fail(sdef.loc, "Error is the built-in error marker (class E: Error); choose another name")
      continue
    }
    if existing = resolver.get_named_in(sdef.mod_name, sdef.name) {
      resolver.fail(sdef.loc, "${sdef.name} is already defined")
      continue
    }
    if sdef.type_params.size > 0 {
      resolver.check_type_params(sdef.loc, sdef.name, sdef.type_params)
    }
    sty = ty_named(tyk_struct(), sdef.name)
    sty.error_mark = error_opted(sdef.opt_ins)
    if sdef.type_params.size > 0 {
      sty.template = true
    }
    resolver.bind_type(sdef.mod_name, sdef.name, sty)
  }
  for cdef in program.classes {
    if cdef.name == "Error" {
      resolver.fail(cdef.loc, "Error is the built-in error marker (class E: Error); choose another name")
      continue
    }
    if already = resolver.get_named_in(cdef.mod_name, cdef.name) {
      resolver.fail(cdef.loc, "${cdef.name} is already defined")
      continue
    }
    if cdef.type_params.size > 0 {
      resolver.check_type_params(cdef.loc, cdef.name, cdef.type_params)
    }
    cty = ty_named(tyk_class(), cdef.name)
    cty.error_mark = error_opted(cdef.opt_ins)
    if cdef.type_params.size > 0 {
      cty.template = true
    }
    resolver.bind_type(cdef.mod_name, cdef.name, cty)
  }
  for idef in program.interfaces {
    if existing = resolver.get_named_in(idef.mod_name, idef.name) {
      resolver.fail(idef.loc, "${idef.name} is already defined")
      continue
    }
    if idef.name == "Error" {
      resolver.fail(idef.loc, "Error is the built-in error marker (class E: Error); choose another name")
      continue
    }
    if idef.type_params.size > 0 {
      resolver.check_type_params(idef.loc, idef.name, idef.type_params)
    }
    ity = ty_named(tyk_iface(), idef.name)
    if idef.type_params.size > 0 {
      ity.template = true
    }
    resolver.bind_type(idef.mod_name, idef.name, ity)
  }
  for lib_def in program.libs {
    for lay in lib_def.layouts {
      if existing = resolver.get_named_in(lib_def.mod_name, lay.name) {
        resolver.fail(lay.loc, "${lay.name} is already defined")
        continue
      }
      resolver.bind_type(lib_def.mod_name, lay.name, ty_named(tyk_clayout(), lay.name))
    }
  }
  for lib_def in program.libs {
    if existing = resolver.get_named(lib_def.name) {
      resolver.fail(lib_def.loc, "lib ${lib_def.name} collides with a type")
    } else {
      if flag = resolver.collide.get(lib_def.name) {
        resolver.fail(lib_def.loc, "lib ${lib_def.name} collides with a type")
      }
    }
  }
  collect_opaques(program, resolver)
  for sdef2 in program.structs {
    if !(sdef2.type_params.size > 0) {
      fill_type_fields(resolver, sdef2.mod_name, sdef2.name, sdef2.fields)
    }
  }
  for cdef2 in program.classes {
    if !(cdef2.type_params.size > 0) {
      fill_type_fields(resolver, cdef2.mod_name, cdef2.name, cdef2.fields)
    }
  }
  ready = Hash(String, Int).new
  for lib_def in program.libs {
    j = 0
    while j < lib_def.layouts.size {
      fill_clayout_fields(resolver, lib_def.layouts[j], ready)
      j += 1
    }
  }
  seal_type_emits(program, resolver)
  resolver
}

pub fn seal_type_emits(program: Program, resolver: TypeResolver) {
  for sdef in program.structs {
    seal_one_emit(resolver, sdef.mod_name, sdef.name)
  }
  for cdef in program.classes {
    seal_one_emit(resolver, cdef.mod_name, cdef.name)
  }
  for idef in program.interfaces {
    seal_one_emit(resolver, idef.mod_name, idef.name)
  }
  for lib_def in program.libs {
    for lay in lib_def.layouts {
      seal_one_emit(resolver, lib_def.mod_name, lay.name)
    }
  }
}

pub fn seal_one_emit(resolver: TypeResolver, mod_name: String, name: String) {
  if flag = resolver.collide.get(name) {
    if ty = resolver.get_named_in(mod_name, name) {
      ty.emit_base = "${mod_emit_prefix(mod_name)}__${name}"
    }
  }
}

// Edit distance between two names, a letter's case counting half a change
// (so `string` is nearest `String`), in whole steps rounded up.
pub fn name_distance(a: String, b: String): Int {
  prev: Array(Int) = []
  for j in 0..b.size + 1 {
    prev.push(j * 2)
  }
  for i in 1..a.size + 1 {
    cur: Array(Int) = []
    cur.push(i * 2)
    for j in 1..b.size + 1 {
      x = a[i - 1]
      y = b[j - 1]
      cost = 2
      if x == y {
        cost = 0
      } else if x == y + 32 || y == x + 32 {
        cost = 1
      }
      best = prev[j - 1] + cost
      if prev[j] + 2 < best {
        best = prev[j] + 2
      }
      if cur[j - 1] + 2 < best {
        best = cur[j - 1] + 2
      }
      cur.push(best)
    }
    prev = cur
  }
  (prev[b.size] + 1) / 2
}
