pub fn (checker_self: Checker) check_langarena_call(expr: Expr): Ty? {
  if str_eq(expr.callee, "now_us") {
    if expr.args.size == 0 {
      if b = expr.block {
        checker_self.fail(expr.loc, "now_us takes no arguments")
        return checker_self.t_int()
      }
      return checker_self.t_int()
    }
    checker_self.fail(expr.loc, "now_us takes no arguments")
    return checker_self.t_int()
  }
  if str_eq(expr.callee, "repeat_byte") {
    if expr.args.size == 2 {
      if b = expr.block {
        checker_self.fail(expr.loc, "repeat_byte takes a byte and a count")
        return checker_self.t_string()
      }
    } else {
      checker_self.fail(expr.loc, "repeat_byte takes a byte and a count")
      return checker_self.t_string()
    }
    bty = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    n = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    if bty.is_int {
    } else {
      checker_self.fail(expr.args[0].loc, "repeat_byte expects Int byte")
    }
    if n.is_int {
    } else {
      checker_self.fail(expr.args[1].loc, "repeat_byte expects Int count")
    }
    return checker_self.t_string()
  }
  if str_eq(expr.callee, "bytes_to_str") {
    return checker_self.check_i32_bytes_to_str(expr)
  }
  if str_eq(expr.callee, "fmt_float") {
    if expr.args.size == 2 {
      if b = expr.block {
        checker_self.fail(expr.loc, "fmt_float takes Float64 and Int")
        return checker_self.t_string()
      }
    } else {
      checker_self.fail(expr.loc, "fmt_float takes Float64 and Int")
      return checker_self.t_string()
    }
    got = checker_self.check_expr(expr.args[0])
    if got.is_numeric {
    } else {
      checker_self.fail(expr.args[0].loc, "fmt_float expects Float64")
    }
    if got.is_float {
    } else {
      expr.args[0].ty = checker_self.t_float()
    }
    prec = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    if prec.is_int {
    } else {
      checker_self.fail(expr.args[1].loc, "precision must be Int")
    }
    return checker_self.t_string()
  }
  if str_eq(expr.callee, "str_to_f_slice") {
    if expr.args.size == 3 {
      if b = expr.block {
        checker_self.fail(expr.loc, "str_to_f_slice takes String, start, stop")
        return checker_self.t_float()
      }
    } else {
      checker_self.fail(expr.loc, "str_to_f_slice takes String, start, stop")
      return checker_self.t_float()
    }
    s = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if ty_assignable(s, checker_self.t_string()) {
    } else {
      checker_self.fail(expr.args[0].loc, "str_to_f_slice expects String")
    }
    start = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    stop = checker_self.check_expr_as(expr.args[2], checker_self.t_int())
    if start.is_int {
      if stop.is_int {
      } else {
        checker_self.fail(expr.loc, "start and stop must be Int")
      }
    } else {
      checker_self.fail(expr.loc, "start and stop must be Int")
    }
    return checker_self.t_float()
  }
  if str_eq(expr.callee, "hash_last_key") {
    if expr.args.size == 0 {
      if b = expr.block {
        checker_self.fail(expr.loc, "hash_last_key takes no arguments")
        return checker_self.t_string()
      }
      return checker_self.t_string()
    }
    checker_self.fail(expr.loc, "hash_last_key takes no arguments")
    return checker_self.t_string()
  }
  if str_eq(expr.callee, "exp") {
    if expr.args.size == 1 {
      if b = expr.block {
        checker_self.fail(expr.loc, "exp takes one Float64")
        return checker_self.t_float()
      }
    } else {
      checker_self.fail(expr.loc, "exp takes one Float64")
      return checker_self.t_float()
    }
    got = checker_self.check_expr(expr.args[0])
    if got.is_numeric {
    } else {
      checker_self.fail(expr.args[0].loc, "exp expects Float64")
    }
    if got.is_float {
    } else {
      expr.args[0].ty = checker_self.t_float()
    }
    return checker_self.t_float()
  }
  if str_eq(expr.callee, "sqrt") {
    if expr.args.size == 1 {
      if b = expr.block {
        checker_self.fail(expr.loc, "sqrt takes one Float64")
        return checker_self.t_float()
      }
    } else {
      checker_self.fail(expr.loc, "sqrt takes one Float64")
      return checker_self.t_float()
    }
    got = checker_self.check_expr(expr.args[0])
    if got.is_numeric {
    } else {
      checker_self.fail(expr.args[0].loc, "sqrt expects Float64")
    }
    if got.is_float {
    } else {
      expr.args[0].ty = checker_self.t_float()
    }
    return checker_self.t_float()
  }
  if str_eq(expr.callee, "wide_op") {
    if expr.args.size == 5 {
      if b = expr.block {
        checker_self.fail(expr.loc, "wide_op takes five Ints")
        return checker_self.t_int()
      }
    } else {
      checker_self.fail(expr.loc, "wide_op takes five Ints")
      return checker_self.t_int()
    }
    i = 0
    while i < expr.args.size {
      got = checker_self.check_expr_as(expr.args[i], checker_self.t_int())
      if got.is_int {
      } else {
        checker_self.fail(expr.args[i].loc, "wide_op expects Int")
      }
      i = i + 1
    }
    return checker_self.t_int()
  }
  if str_eq(expr.callee, "wide_hi") {
    if expr.args.size == 0 {
      if b = expr.block {
        checker_self.fail(expr.loc, "wide_hi takes no arguments")
        return checker_self.t_int()
      }
      return checker_self.t_int()
    }
    checker_self.fail(expr.loc, "wide_hi takes no arguments")
    return checker_self.t_int()
  }
  if str_eq(expr.callee, "checksum_f64") {
    if expr.args.size == 1 {
      if b = expr.block {
        checker_self.fail(expr.loc, "checksum_f64 takes one Float64")
        return checker_self.t_int()
      }
    } else {
      checker_self.fail(expr.loc, "checksum_f64 takes one Float64")
      return checker_self.t_int()
    }
    got = checker_self.check_expr(expr.args[0])
    if got.is_numeric {
    } else {
      checker_self.fail(expr.args[0].loc, "checksum_f64 expects Float64")
    }
    if got.is_float {
    } else {
      expr.args[0].ty = checker_self.t_float()
    }
    return checker_self.t_int()
  }
  if str_eq(expr.callee, "checksum_str") {
    return checker_self.check_one_string(expr, checker_self.t_int())
  }
  if str_eq(expr.callee, "puts_u") {
    if expr.args.size == 1 {
      if b = expr.block {
        checker_self.fail(expr.loc, "puts_u takes one Int")
        return checker_self.t_void()
      }
    } else {
      checker_self.fail(expr.loc, "puts_u takes one Int")
      return checker_self.t_void()
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if got.is_int {
    } else {
      checker_self.fail(expr.args[0].loc, "puts_u expects Int")
    }
    return checker_self.t_void()
  }
  nil
}

