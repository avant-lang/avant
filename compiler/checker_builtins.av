pub fn (checker_self: Checker) check_parallel(expr: Expr, array: Ty): Ty {
  if checker_self.in_task > 0 {
    checker_self.fail(expr.loc, "parallel inside a pool worker")
    return ty_array(checker_self.t_int())
  }
  if b = expr.block {
    if expr.args.size == 0 {
    } else {
      checker_self.fail(expr.loc, "parallel takes a block, not arguments")
      return ty_array(checker_self.t_int())
    }
    if b.params.size == 1 {
    } else {
      checker_self.fail(b.loc, "parallel { |x| ... } takes one block parameter")
      return ty_array(checker_self.t_int())
    }
    if e = array.inner {
      checker_self.push_scope
      checker_self.bind(b.params[0], e)
      checker_self.in_task = checker_self.in_task + 1
      result = checker_self.check_block_value(b)
      checker_self.in_task = checker_self.in_task - 1
      checker_self.pop_scope
      checker_self.collect_spawn_captures(expr, b.body)
      return ty_array(result)
    }
    checker_self.fail(expr.loc, "parallel needs an element type")
    return ty_array(checker_self.t_int())
  }
  checker_self.fail(expr.loc, "parallel needs a block")
  ty_array(checker_self.t_int())
}

