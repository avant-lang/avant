pub fn (checker_self: Checker) check_json_get(expr: Expr, val: Ty): Ty {
  if expr.args.size == 2 {
    if b = expr.block {
      checker_self.fail(expr.loc, "${expr.callee} takes a document and a key")
      return ty_nilable(val)
    }
  } else {
    checker_self.fail(expr.loc, "${expr.callee} takes a document and a key")
    return ty_nilable(val)
  }
  doc = checker_self.check_expr(expr.args[0])
  if doc.is_ptr {
  } else {
    checker_self.fail(expr.args[0].loc, "${expr.callee} expects Ptr(Void)")
  }
  key = checker_self.check_expr_as(expr.args[1], checker_self.t_string())
  if ty_assignable(key, checker_self.t_string()) {
  } else {
    checker_self.fail(expr.args[1].loc, "key must be String")
  }
  ty_nilable(val)
}
