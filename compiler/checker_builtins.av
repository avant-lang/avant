pub fn (checker_self: Checker) expect_no_args(expr: Expr, ret: Ty, message: String): Ty {
  if expr.args.size == 0 {
    return ret
  }
  checker_self.fail(expr.loc, message)
  ret
}

pub fn (checker_self: Checker) check_float_method(expr: Expr): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "Float64.${expr.callee} does not take a block")
    return checker_self.t_float()
  }
  if str_eq(expr.callee, "sqrt") {
    return checker_self.expect_no_args(expr, checker_self.t_float(), "Float64.${expr.callee} takes no arguments")
  }
  if str_eq(expr.callee, "abs") {
    return checker_self.expect_no_args(expr, checker_self.t_float(), "Float64.${expr.callee} takes no arguments")
  }
  if str_eq(expr.callee, "floor") {
    return checker_self.expect_no_args(expr, checker_self.t_float(), "Float64.${expr.callee} takes no arguments")
  }
  if str_eq(expr.callee, "exp") {
    return checker_self.expect_no_args(expr, checker_self.t_float(), "Float64.${expr.callee} takes no arguments")
  }
  if str_eq(expr.callee, "to_i") {
    return checker_self.expect_no_args(expr, checker_self.t_int(), "Float64.to_i takes no arguments")
  }
  checker_self.fail(expr.loc, "no method ${expr.callee} on Float64")
  checker_self.t_float()
}

pub fn (checker_self: Checker) check_int_method(expr: Expr, object: Ty): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "${object.show}.${expr.callee} does not take a block")
    return object
  }
  if str_eq(expr.callee, "to_f") {
    return checker_self.expect_no_args(expr, checker_self.t_float(), "${object.show}.to_f takes no arguments")
  }
  if str_eq(expr.callee, "abs") {
    return checker_self.expect_no_args(expr, object, "${object.show}.abs takes no arguments")
  }
  if str_eq(expr.callee, "to_i") {
    return checker_self.expect_no_args(expr, checker_self.t_int(), "${object.show}.to_i takes no arguments")
  }
  if str_eq(expr.callee, "to_i64") {
    return checker_self.expect_no_args(expr, checker_self.t_int64(), "${object.show}.to_i64 takes no arguments")
  }
  if str_eq(expr.callee, "to_u64") {
    return checker_self.expect_no_args(expr, checker_self.t_uint64(), "${object.show}.to_u64 takes no arguments")
  }
  checker_self.fail(expr.loc, "no method ${expr.callee} on ${object.show}")
  object
}

pub fn (checker_self: Checker) check_bytes_method(expr: Expr): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "Bytes.${expr.callee} does not take a block")
    return checker_self.t_bytes()
  }
  if str_eq(expr.callee, "get") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "get takes one Int")
      return ty_nilable(checker_self.t_int())
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if got.is_int {
    } else {
      checker_self.fail(expr.args[0].loc, "get index must be Int")
    }
    return ty_nilable(checker_self.t_int())
  }
  if str_eq(expr.callee, "slice") {
    if expr.args.size == 2 {
    } else {
      checker_self.fail(expr.loc, "slice takes start and stop")
      return checker_self.t_bytes()
    }
    a = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    bb = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    if a.is_int {
      if bb.is_int {
      } else {
        checker_self.fail(expr.loc, "slice bounds must be Int")
      }
    } else {
      checker_self.fail(expr.loc, "slice bounds must be Int")
    }
    return checker_self.t_bytes()
  }
  if str_eq(expr.callee, "to_buf") {
    return checker_self.expect_no_args(expr, checker_self.t_buf(), "to_buf takes no arguments")
  }
  if str_eq(expr.callee, "chars") {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_string()), "chars takes no arguments")
  }
  checker_self.fail(expr.loc, "no method ${expr.callee} on Bytes")
  checker_self.t_bytes()
}

pub fn (checker_self: Checker) check_string_method(expr: Expr): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "String.${expr.callee} does not take a block")
    return checker_self.t_string()
  }
  if str_eq(expr.callee, "split") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "split takes one String separator")
      return ty_array(checker_self.t_string())
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if ty_assignable(got, checker_self.t_string()) {
    } else {
      checker_self.fail(expr.args[0].loc, "split expects String separator")
    }
    return ty_array(checker_self.t_string())
  }
  if str_eq(expr.callee, "fields") {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_string()), "fields takes no arguments")
  }
  if str_eq(expr.callee, "strip") {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "strip takes no arguments")
  }
  if str_eq(expr.callee, "strip_left") {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "strip_left takes no arguments")
  }
  if str_eq(expr.callee, "strip_right") {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "strip_right takes no arguments")
  }
  if str_eq(expr.callee, "bytes") {
    return checker_self.expect_no_args(expr, checker_self.t_bytes(), "bytes takes no arguments")
  }
  if str_eq(expr.callee, "chars") {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_string()), "chars takes no arguments")
  }
  if str_eq(expr.callee, "to_f") {
    return checker_self.expect_no_args(expr, checker_self.t_float(), "String.to_f takes no arguments")
  }
  if str_eq(expr.callee, "to_i") {
    return checker_self.expect_no_args(expr, checker_self.t_int(), "String.to_i takes no arguments")
  }
  if str_eq(expr.callee, "get") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "get takes one Int")
      return ty_nilable(checker_self.t_int())
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if got.is_int {
    } else {
      checker_self.fail(expr.args[0].loc, "get index must be Int")
    }
    return ty_nilable(checker_self.t_int())
  }
  checker_self.fail(expr.loc, "no method ${expr.callee} on String")
  checker_self.t_string()
}

pub fn (checker_self: Checker) check_buf_method(expr: Expr): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "Buf.${expr.callee} does not take a block")
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "push_bytes") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "push_bytes takes one Bytes")
      return checker_self.t_void()
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_bytes())
    if got.is_bytes {
    } else {
      checker_self.fail(expr.args[0].loc, "push_bytes expects Bytes")
    }
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "to_bytes") {
    return checker_self.expect_no_args(expr, checker_self.t_bytes(), "to_bytes takes no arguments")
  }
  if str_eq(expr.callee, "push_byte") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "push_byte takes one Int")
      return checker_self.t_void()
    }
    bty = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if bty.is_int {
    } else {
      checker_self.fail(expr.args[0].loc, "byte must be Int")
    }
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "push_str") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "push_str takes one String")
      return checker_self.t_void()
    }
    s = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if ty_assignable(s, checker_self.t_string()) {
    } else {
      checker_self.fail(expr.args[0].loc, "push_str expects String")
    }
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "push_slice") {
    if expr.args.size == 3 {
    } else {
      checker_self.fail(expr.loc, "push_slice takes string, start, stop")
      return checker_self.t_void()
    }
    s = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if ty_assignable(s, checker_self.t_string()) {
    } else {
      checker_self.fail(expr.args[0].loc, "push_slice expects String")
    }
    start = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    stop = checker_self.check_expr_as(expr.args[2], checker_self.t_int())
    if start.is_int {
      if stop.is_int {
      } else {
        checker_self.fail(expr.loc, "start and stop must be Int")
      }
    } else {
      checker_self.fail(expr.loc, "start and stop must be Int")
    }
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "push_fmt_f") {
    if expr.args.size == 2 {
    } else {
      checker_self.fail(expr.loc, "push_fmt_f takes Float64 and Int")
      return checker_self.t_void()
    }
    v = checker_self.check_expr(expr.args[0])
    if v.is_numeric {
    } else {
      checker_self.fail(expr.args[0].loc, "push_fmt_f expects Float64")
    }
    if v.is_float {
    } else {
      expr.args[0].ty = checker_self.t_float()
    }
    prec = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    if prec.is_int {
    } else {
      checker_self.fail(expr.args[1].loc, "precision must be Int")
    }
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "push_fmt_i") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "push_fmt_i takes one Int")
      return checker_self.t_void()
    }
    n = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if n.is_int {
    } else {
      checker_self.fail(expr.args[0].loc, "push_fmt_i expects Int")
    }
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "starts_with") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "starts_with takes one String")
      return checker_self.t_bool()
    }
    s = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if ty_assignable(s, checker_self.t_string()) {
    } else {
      checker_self.fail(expr.args[0].loc, "starts_with expects String")
    }
    return checker_self.t_bool()
  }
  if str_eq(expr.callee, "to_s") {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "to_s takes no arguments")
  }
  if str_eq(expr.callee, "clear") {
    return checker_self.expect_no_args(expr, checker_self.t_void(), "clear takes no arguments")
  }
  if str_eq(expr.callee, "get") {
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "get takes one Int")
      return ty_nilable(checker_self.t_int())
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if got.is_int {
    } else {
      checker_self.fail(expr.args[0].loc, "get index must be Int")
    }
    return ty_nilable(checker_self.t_int())
  }
  checker_self.fail(expr.loc, "no method ${expr.callee} on Buf")
  checker_self.t_void()
}

pub fn (checker_self: Checker) check_array_method(expr: Expr, array: Ty): Ty {
  if str_eq(expr.callee, "push") {
    if b = expr.block {
      checker_self.fail(expr.loc, "push does not take a block")
      return checker_self.t_void()
    }
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "push takes one argument")
      return checker_self.t_void()
    }
    if e = array.inner {
      got = checker_self.check_expr_as(expr.args[0], e)
      if ty_assignable(got, e) {
      } else {
        checker_self.fail(expr.args[0].loc, "push expects ${e.show}, got ${got.show}")
      }
    }
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "pop") {
    if b = expr.block {
      checker_self.fail(expr.loc, "pop does not take a block")
      if e = array.inner {
        return e
      }
      return checker_self.t_int()
    }
    if expr.args.size == 0 {
      if e = array.inner {
        return e
      }
      return checker_self.t_int()
    }
    checker_self.fail(expr.loc, "pop takes no arguments")
    if e = array.inner {
      return e
    }
    return checker_self.t_int()
  }
  if str_eq(expr.callee, "each") {
    if b = expr.block {
      if expr.args.size == 0 {
      } else {
        checker_self.fail(expr.loc, "each takes a block, not arguments")
        return checker_self.t_void()
      }
      if b.params.size == 1 {
      } else {
        checker_self.fail(b.loc, "each { |x| ... } takes one block parameter")
        return checker_self.t_void()
      }
      if e = array.inner {
        checker_self.check_block_void(b, b.params[0], e)
      }
      return checker_self.t_void()
    }
    checker_self.fail(expr.loc, "each needs a block")
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "sort") {
    if expr.args.size == 0 {
    } else {
      checker_self.fail(expr.loc, "sort takes no arguments")
      return checker_self.t_void()
    }
    if b = expr.block {
      if b.params.size == 2 {
      } else {
        checker_self.fail(b.loc, "sort { |a, b| ... } takes two block parameters")
        return checker_self.t_void()
      }
      if e = array.inner {
        checker_self.push_scope
        checker_self.bind(b.params[0], e)
        checker_self.bind(b.params[1], e)
        bt = checker_self.check_block_value(b)
        checker_self.pop_scope
        if bt.is_bool {
        } else {
          checker_self.fail(b.loc, "sort comparator must return Bool")
        }
      }
      return checker_self.t_void()
    }
    if e = array.inner {
      if checker_self.is_ordered_ty(e) {
      } else {
        checker_self.fail(expr.loc, "Array.sort needs an ordered element type or a comparator block")
      }
    }
    return checker_self.t_void()
  }
  if str_eq(expr.callee, "sorted") {
    if expr.args.size == 0 {
    } else {
      checker_self.fail(expr.loc, "sorted takes no arguments")
      if e = array.inner {
        return ty_array(e)
      }
      return ty_array(checker_self.t_int())
    }
    if b = expr.block {
      if b.params.size == 2 {
      } else {
        checker_self.fail(b.loc, "sorted { |a, b| ... } takes two block parameters")
        if e = array.inner {
          return ty_array(e)
        }
        return ty_array(checker_self.t_int())
      }
      if e = array.inner {
        checker_self.push_scope
        checker_self.bind(b.params[0], e)
        checker_self.bind(b.params[1], e)
        bt = checker_self.check_block_value(b)
        checker_self.pop_scope
        if bt.is_bool {
        } else {
          checker_self.fail(b.loc, "sorted comparator must return Bool")
        }
        return ty_array(e)
      }
      return ty_array(checker_self.t_int())
    }
    if e = array.inner {
      if checker_self.is_ordered_ty(e) {
      } else {
        checker_self.fail(expr.loc, "Array.sorted needs an ordered element type or a comparator block")
      }
      return ty_array(e)
    }
    return ty_array(checker_self.t_int())
  }
  if str_eq(expr.callee, "reverse") {
    if b = expr.block {
      checker_self.fail(expr.loc, "reverse does not take a block")
      return checker_self.t_void()
    }
    return checker_self.expect_no_args(expr, checker_self.t_void(), "reverse takes no arguments")
  }
  if str_eq(expr.callee, "contains") {
    if b = expr.block {
      checker_self.fail(expr.loc, "contains does not take a block")
      return checker_self.t_bool()
    }
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "contains takes one argument")
      return checker_self.t_bool()
    }
    if e = array.inner {
      if checker_self.is_eq_ty(e) {
      } else {
        checker_self.fail(expr.loc, "Array.contains needs an equality element type")
      }
      got = checker_self.check_expr_as(expr.args[0], e)
      if ty_assignable(got, e) {
      } else {
        checker_self.fail(expr.args[0].loc, "contains expects ${e.show}")
      }
    }
    return checker_self.t_bool()
  }
  if str_eq(expr.callee, "any") || str_eq(expr.callee, "all") {
    pred_name = expr.callee
    if expr.args.size == 0 {
    } else {
      checker_self.fail(expr.loc, "${pred_name} takes a block, not arguments")
      return checker_self.t_bool()
    }
    if b = expr.block {
      if b.params.size == 1 {
      } else {
        checker_self.fail(b.loc, "${pred_name} { |x| ... } takes one block parameter")
        return checker_self.t_bool()
      }
      if e = array.inner {
        checker_self.push_scope
        checker_self.bind(b.params[0], e)
        bt = checker_self.check_block_value(b)
        checker_self.pop_scope
        if bt.is_bool {
        } else {
          checker_self.fail(b.loc, "${pred_name} predicate must return Bool")
        }
      }
      return checker_self.t_bool()
    }
    checker_self.fail(expr.loc, "${pred_name} needs a block")
    return checker_self.t_bool()
  }
  if str_eq(expr.callee, "index_of") {
    if b = expr.block {
      checker_self.fail(expr.loc, "index_of does not take a block")
      return ty_nilable(checker_self.t_int())
    }
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "index_of takes one argument")
      return ty_nilable(checker_self.t_int())
    }
    if e = array.inner {
      if checker_self.is_eq_ty(e) {
      } else {
        checker_self.fail(expr.loc, "Array.index_of needs an equality element type")
      }
      got = checker_self.check_expr_as(expr.args[0], e)
      if ty_assignable(got, e) {
      } else {
        checker_self.fail(expr.args[0].loc, "index_of expects ${e.show}")
      }
    }
    return ty_nilable(checker_self.t_int())
  }
  if str_eq(expr.callee, "min") {
    if b = expr.block {
      checker_self.fail(expr.loc, "min does not take a block")
      if e = array.inner {
        return ty_nilable(e)
      }
      return ty_nilable(checker_self.t_int())
    }
    if expr.args.size == 0 {
    } else {
      checker_self.fail(expr.loc, "min takes no arguments")
    }
    if e = array.inner {
      if checker_self.is_ordered_ty(e) {
        if e.is_bool {
          checker_self.fail(expr.loc, "Array.min needs an ordered element type")
        }
      } else {
        checker_self.fail(expr.loc, "Array.min needs an ordered element type")
      }
      return ty_nilable(e)
    }
    return ty_nilable(checker_self.t_int())
  }
  if str_eq(expr.callee, "max") {
    if b = expr.block {
      checker_self.fail(expr.loc, "max does not take a block")
      if e = array.inner {
        return ty_nilable(e)
      }
      return ty_nilable(checker_self.t_int())
    }
    if expr.args.size == 0 {
    } else {
      checker_self.fail(expr.loc, "max takes no arguments")
    }
    if e = array.inner {
      if checker_self.is_ordered_ty(e) {
        if e.is_bool {
          checker_self.fail(expr.loc, "Array.max needs an ordered element type")
        }
      } else {
        checker_self.fail(expr.loc, "Array.max needs an ordered element type")
      }
      return ty_nilable(e)
    }
    return ty_nilable(checker_self.t_int())
  }
  if str_eq(expr.callee, "sum") {
    if b = expr.block {
      checker_self.fail(expr.loc, "sum does not take a block")
      if e = array.inner {
        return e
      }
      return checker_self.t_int()
    }
    if expr.args.size == 0 {
    } else {
      checker_self.fail(expr.loc, "sum takes no arguments")
    }
    if e = array.inner {
      if checker_self.is_numeric_ty(e) {
        return e
      }
      checker_self.fail(expr.loc, "Array.sum needs a numeric element type")
      return e
    }
    return checker_self.t_int()
  }
  if str_eq(expr.callee, "clear") {
    if b = expr.block {
      checker_self.fail(expr.loc, "clear does not take a block")
      return checker_self.t_void()
    }
    return checker_self.expect_no_args(expr, checker_self.t_void(), "clear takes no arguments")
  }
  if str_eq(expr.callee, "fill") {
    if b = expr.block {
      checker_self.fail(expr.loc, "fill does not take a block")
      return checker_self.t_void()
    }
    if expr.args.size == 1 {
    } else {
      checker_self.fail(expr.loc, "fill takes one argument")
      return checker_self.t_void()
    }
    if e = array.inner {
      if e.is_int {
        got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
        if got.is_int {
        } else {
          checker_self.fail(expr.args[0].loc, "fill expects Int")
        }
      } else if e.is_bool {
