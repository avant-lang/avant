pub fn (checker_self: Checker) check_codec_call(expr: Expr): Ty? {
  if str_eq(expr.callee, "b64_encode") {
    return checker_self.check_one_string(expr, checker_self.t_string())
  }
  if str_eq(expr.callee, "b64_decode") {
    return checker_self.check_one_string(expr, checker_self.t_string())
  }
  if str_eq(expr.callee, "zlib_compress") {
    return checker_self.check_one_string(expr, checker_self.t_string())
  }
  if str_eq(expr.callee, "zlib_uncompress") {
    return checker_self.check_one_string(expr, checker_self.t_string())
  }
  if str_eq(expr.callee, "sha256") {
    return checker_self.check_one_string(expr, checker_self.t_string())
  }
  if str_eq(expr.callee, "b64_encode_buf") {
    return checker_self.check_buf_string(expr)
  }
  if str_eq(expr.callee, "b64_decode_buf") {
    return checker_self.check_buf_string(expr)
  }
  if str_eq(expr.callee, "crc32_bytes") {
    return checker_self.check_i32_bytes(expr)
  }
  if str_eq(expr.callee, "sha256_word0") {
    return checker_self.check_i32_bytes(expr)
  }
  if str_eq(expr.callee, "re_count") {
    if expr.args.size == 3 {
      if b = expr.block {
        checker_self.fail(expr.loc, "re_count takes pattern, text, and caseless")
        return checker_self.t_int()
      }
    } else {
      checker_self.fail(expr.loc, "re_count takes pattern, text, and caseless")
      return checker_self.t_int()
    }
    pat = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    text = checker_self.check_expr_as(expr.args[1], checker_self.t_string())
    flags = checker_self.check_expr_as(expr.args[2], checker_self.t_int())
    if ty_assignable(pat, checker_self.t_string()) {
      if ty_assignable(text, checker_self.t_string()) {
      } else {
        checker_self.fail(expr.loc, "re_count expects String pattern and text")
      }
    } else {
      checker_self.fail(expr.loc, "re_count expects String pattern and text")
    }
    if flags.is_int {
    } else {
      checker_self.fail(expr.args[2].loc, "caseless must be Int")
    }
    return checker_self.t_int()
  }
  if str_eq(expr.callee, "re_compile") {
    if expr.args.size == 2 {
      if b = expr.block {
        checker_self.fail(expr.loc, "re_compile takes a pattern and flags")
        return ty_ptr(checker_self.t_void())
      }
    } else {
      checker_self.fail(expr.loc, "re_compile takes a pattern and flags")
      return ty_ptr(checker_self.t_void())
    }
    pat = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    flags = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    if ty_assignable(pat, checker_self.t_string()) {
    } else {
      checker_self.fail(expr.args[0].loc, "re_compile expects String")
    }
    if flags.is_int {
    } else {
      checker_self.fail(expr.args[1].loc, "flags must be Int")
    }
    return ty_ptr(checker_self.t_void())
  }
  if str_eq(expr.callee, "re_find") {
    if expr.args.size == 3 {
      if b = expr.block {
        checker_self.fail(expr.loc, "re_find takes a pattern, a string, and a start")
        return checker_self.t_int()
      }
    } else {
      checker_self.fail(expr.loc, "re_find takes a pattern, a string, and a start")
      return checker_self.t_int()
    }
    re = checker_self.check_expr(expr.args[0])
    if re.is_ptr {
    } else {
      checker_self.fail(expr.args[0].loc, "re_find expects Ptr(Void)")
    }
    text = checker_self.check_expr_as(expr.args[1], checker_self.t_string())
    from = checker_self.check_expr_as(expr.args[2], checker_self.t_int())
    if ty_assignable(text, checker_self.t_string()) {
    } else {
      checker_self.fail(expr.args[1].loc, "re_find expects String")
    }
    if from.is_int {
    } else {
      checker_self.fail(expr.args[2].loc, "start must be Int")
    }
    return checker_self.t_int()
  }
  if checker_self.re_mark_name(expr.callee) {
    if expr.args.size == 0 {
      if b = expr.block {
        checker_self.fail(expr.loc, "${expr.callee} takes no arguments")
        return checker_self.t_int()
      }
      return checker_self.t_int()
    }
    checker_self.fail(expr.loc, "${expr.callee} takes no arguments")
    return checker_self.t_int()
  }
  nil
}

pub fn (checker_self: Checker) re_mark_name(name: String): Bool {
  if str_eq(name, "re_m0") {
    return true
  }
  if str_eq(name, "re_m1") {
    return true
  }
  if str_eq(name, "re_c0") {
    return true
  }
  str_eq(name, "re_c1")
}

pub fn (checker_self: Checker) check_one_string(expr: Expr, ret: Ty): Ty {
  if expr.args.size == 1 {
    if b = expr.block {
      checker_self.fail(expr.loc, "${expr.callee} takes one String")
      return ret
    }
  } else {
    checker_self.fail(expr.loc, "${expr.callee} takes one String")
    return ret
  }
  got = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
  if ty_assignable(got, checker_self.t_string()) {
  } else {
    checker_self.fail(expr.args[0].loc, "${expr.callee} expects String")
  }
  ret
}

