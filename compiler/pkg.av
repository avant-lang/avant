import location
import diagnostic
import source
import loader
import pipeline
import manifest

// git, looked up on PATH as a shell would (an empty PATH entry is the
// current directory); "" when it is not found.
pub fn pkg_git_bin: String {
  path = env_get("PATH") ?? "/usr/local/bin:/usr/bin:/bin"
  for entry in path.split(":") {
    dir = entry
    if dir.size == 0 {
      dir = "."
    }
    cand = "${dir}/git"
    if file_exists(cand) && !dir_exists(cand) {
      return cand
    }
  }
  ""
}

pub fn pkg_git_missing {
  diag_puts("avant fetch: git not found on PATH (${env_get("PATH") ?? ""})")
}

pub fn pkg_git(args: Array(String), what: String, tag: String): Bool {
  git = pkg_git_bin()
  if git.size == 0 {
    pkg_git_missing()
    return false
  }
  log = "${tmp_new_dir()}/git-${tag}.log"
  code = tool_run_out(git, args, log)
  if code != 0 {
    diag_puts("avant fetch: git ${what} failed (${code})")
    if text = file_read(log) {
      t = text.strip()
      if t.size > 0 {
        diag_puts(t)
      }
    }
    return false
  }
  true
}

pub fn pkg_git_out(args: Array(String), what: String, tag: String): String {
  git = pkg_git_bin()
  if git.size == 0 {
    pkg_git_missing()
    return ""
  }
  log = "${tmp_new_dir()}/git-${tag}.log"
  code = tool_run_out(git, args, log)
  if code != 0 {
    diag_puts("avant fetch: git ${what} failed (${code})")
    if text = file_read(log) {
      t = text.strip()
      if t.size > 0 {
        diag_puts(t)
      }
    }
    return ""
  }
  if text = file_read(log) {
    return text.strip()
  }
  ""
}

// A git command's output, or "" when it fails, with nothing said: for
// questions whose "no" is an answer (is this commit here, which origin).
pub fn pkg_git_ask(args: Array(String), tag: String): String {
  git = pkg_git_bin()
  if git.size == 0 {
    return ""
  }
  out = "${tmp_new_dir()}/git-${tag}.out"
  err = "${tmp_new_dir()}/git-${tag}.err"
  code = tool_run_split(git, args, out, err)
  if code != 0 {
    return ""
  }
  if text = file_read(out) {
    return text.strip()
  }
  ""
}

pub fn pkg_join(dir: String, leaf: String): String {
  if dir == "." {
    return leaf
  }
  if dir.size > 0 && dir[dir.size - 1] == 47 {
    return "${dir}${leaf}"
  }
  "${dir}/${leaf}"
}

// A directory as an absolute path, for git, which runs elsewhere.
pub fn pkg_abs_dir(dir: String): String {
  if dir.size > 0 && dir[0] == 47 {
    return dir
  }
  cwd = cwd_physical()
  if dir == "." || dir.size == 0 {
    return cwd
  }
  if str_starts(dir, "./") {
    return "${cwd}/${str_slice(dir, 2, dir.size)}"
  }
  "${cwd}/${dir}"
}

// A git source as git clone reads it: a URL (`scheme://`), an scp-like
// `host:path` (a colon before any slash) and an absolute path as written;
// a relative path is read from the directory of the manifest that names
// it, not from wherever fetch runs.
pub fn pkg_git_source(git: String, manifest_dir: String): String {
  if str_contains(git, "://") || git.size == 0 || git[0] == 47 {
    return git
  }
  i = 0
  while i < git.size {
    if git[i] == 47 {
      break
    }
    if git[i] == 58 {
      return git
    }
    i += 1
  }
  base = pkg_abs_dir(manifest_dir)
  rel = git
  while str_starts(rel, "./") {
    rel = str_slice(rel, 2, rel.size)
  }
  "${base}/${rel}"
}

// The commit rev names in the checkout at dest: a full SHA as written,
// else the remote's branch, a tag, or anything else git resolves; ""
// when nothing does.
pub fn pkg_resolve(dest: String, rev: String, tag: String): String {
  if pkg_is_sha(rev) {
    got = pkg_git_ask(["-C", dest, "rev-parse", "--verify", "${rev}^{commit}"], "${tag}-sha")
    return got
  }
  for cand in ["refs/remotes/origin/${rev}", "refs/tags/${rev}", rev] {
    got = pkg_git_ask(["-C", dest, "rev-parse", "--verify", "${cand}^{commit}"], "${tag}-rev")
    if pkg_is_sha(got) {
      return got
    }
  }
  ""
}

pub class PkgFetched {
  pub name: String = ""
  pub source: String = ""
  pub sha: String = ""
  pub man: PkgManifest

  fn initialize(name: String, source: String, sha: String, man: PkgManifest) {
    self.name = name
    self.source = source
    self.sha = sha
    self.man = man
  }
}

// `avant fetch [DIR] [--update]`: each dependency (and theirs) checked out
// in deps/NAME at one commit, detached; avant.lock written; every other
// checkout in deps/ removed. A plain fetch keeps the lockfile's commit for
// a dependency whose git and rev did not change; --update resolves every
// branch and tag again. A checkout is cloned again only when its origin is
// another source; nothing is fetched from the network when the commit
// wanted is already in the checkout.
pub fn pkg_fetch(dir: String, update: Bool): Bool {
  manifest_path = pkg_join(dir, "avant.toml")
  text = ""
  if t = file_read(manifest_path) {
    text = t
  } else {
    diag_puts("avant fetch: cannot read ${manifest_path}")
    return false
  }
  m = pkg_parse_manifest(text, manifest_path)
  if !m.ok {
    diag_puts("avant fetch: ${m.err}")
    return false
  }
  if pkg_git_bin().size == 0 {
    pkg_git_missing()
    return false
  }
  lock = PkgLock.new()
  if !update {
    lock_path = pkg_join(dir, "avant.lock")
    if lt = file_read(lock_path) {
      lock = pkg_parse_lock(lt)
    }
  }
  deps_dir = pkg_join(dir, "deps")
  resolved: Array(PkgLockEnt) = []
  fetched: Array(PkgFetched) = []
  queue: Array(PkgDep) = []
  // The directory of the manifest that named each queued dependency: a
  // relative git path is read from there.
  queue_dirs: Array(String) = []
  for d in m.deps {
    queue.push(d)
    queue_dirs.push(dir)
  }
  qi = 0
  while qi < queue.size {
    dep = queue[qi]
    from_dir = queue_dirs[qi]
    qi += 1
    source = pkg_git_source(dep.git, from_dir)
    dest = pkg_join(deps_dir, dep.name)
    tag = dep.name
    rev = dep.rev
    if rev.size == 0 {
      rev = "HEAD"
    }
    // A second request for a name already fetched: the same commit, or
    // a conflict; the checkout is not moved.
    seen_at = -1
    for fi in 0..fetched.size {
      if fetched[fi].name == dep.name {
        seen_at = fi
      }
    }
    if seen_at >= 0 {
      first = fetched[seen_at]
      want = ""
      if first.source == source {
        want = pkg_resolve(dest, rev, "${tag}-again")
      } else if pkg_is_sha(rev) {
        want = rev
      }
      if want.size == 0 || !pkg_same_sha(want, first.sha) {
        if want.size == 0 {
          want = "${rev} from ${source}"
        }
        diag_puts("avant fetch: dependency ${dep.name} resolves to two different commits (${first.source}#${first.sha} vs ${dep.git}#${want}); a project uses one version of each dependency: pin the same commit for ${dep.name} everywhere, then fetch again")
        return false
      }
      continue
    }
    // The commit the lockfile already chose, while git and rev are the
    // ones it was fetched with.
    locked_sha = ""
    if ent = lock.find(dep.name), ent.git == dep.git && (ent.rev.size == 0 || ent.rev == dep.rev) {
      locked_sha = ent.sha
    }
    if file_exists(dest) && !dir_exists(pkg_join(dest, ".git")) {
      diag_puts("avant fetch: ${dest} exists and is not a git checkout; move it away, then fetch again")
      return false
    }
    if dir_exists(pkg_join(dest, ".git")) {
      origin = pkg_git_ask(["-C", dest, "remote", "get-url", "origin"], "${tag}-origin")
      if origin != source {
        // Fetched from another source (a clone that patches the
        // dependency): cloned again from the new one, once its own
        // changes are known to be none.
        if !pkg_clean(dest, tag) {
          return false
        }
        fs_remove_tree(dest)
      }
    }
    if !dir_exists(pkg_join(dest, ".git")) {
      if !pkg_git(["clone", "-q", "--no-checkout", source, dest], "clone for ${dep.name}", "clone-${tag}") {
        return false
      }
    } else if !pkg_clean(dest, tag) {
      return false
    }
    sha = ""
    wanted = locked_sha
    if wanted.size == 0 && pkg_is_sha(rev) {
      wanted = rev
    }
    if wanted.size > 0 {
      sha = pkg_resolve(dest, wanted, tag)
    }
    if sha.size == 0 {
      if !pkg_git(["-C", dest, "fetch", "-q", "--force", "--tags", "--prune", "origin"], "fetch for ${dep.name}", "fetch-${tag}") {
        return false
      }
      if wanted.size > 0 {
        sha = pkg_resolve(dest, wanted, tag)
      } else {
        sha = pkg_resolve(dest, rev, tag)
      }
    }
    if sha.size == 0 {
      what = rev
      if wanted.size > 0 {
        what = wanted
      }
      diag_puts("avant fetch: ${dep.name} has no commit ${what} in ${source}")
      return false
    }
    if !pkg_git(["-C", dest, "checkout", "-q", "--detach", sha], "checkout ${sha} for ${dep.name}", "checkout-${tag}") {
      return false
    }
    ent = PkgLockEnt.new(dep.name, dep.git, sha)
    ent.rev = dep.rev
    resolved.push(ent)
    puts("fetched ${dep.name} ${sha}")
    sub_path = pkg_join(dest, "avant.toml")
    sub = PkgManifest.new()
    sub.ok = true
    if st = file_read(sub_path) {
      sub = pkg_parse_manifest(st, sub_path)
      if !sub.ok {
        diag_puts("avant fetch: ${sub.err}")
        return false
      }
      for d in sub.deps {
        queue.push(d)
        queue_dirs.push(dest)
      }
    }
    fetched.push(PkgFetched.new(dep.name, source, sha, sub))
  }
  if !pkg_prune(deps_dir, fetched) {
    return false
  }
  for f in fetched {
    if f.man.has_c() && m.link_mode(f.name).size == 0 {
      puts("note: ${f.name} links C code: opt in with [link] ${f.name} = \"source\" (compile the C it carries) or \"system\" (link the system's library) in ${manifest_path}")
    }
  }
  lock_path2 = pkg_join(dir, "avant.lock")
  if e = write_failure(file_write(lock_path2, pkg_lock_render(resolved))) {
    diag_puts("avant fetch: ${e.message()}")
    return false
  }
  true
}

// What git status says of a checkout's own changes (modified, staged or
// untracked files), "" when there are none; nil when git cannot say.
pub fn pkg_status(dest: String, tag: String): String? {
  out = "${tmp_new_dir()}/git-${tag}-status.out"
  code = tool_run_out(pkg_git_bin(), ["-C", dest, "status", "--porcelain"], out)
  text = (file_read(out) ?? "").strip()
  if code != 0 {
    diag_puts("avant fetch: cannot read the state of ${dest} (git status failed)")
    if text.size > 0 {
      diag_puts(text)
    }
    return nil
  }
  text
}

// A checkout fetch may move or replace: one with no change git does not
// have.
pub fn pkg_clean(dest: String, tag: String): Bool {
  if text = pkg_status(dest, tag) {
    if text.size == 0 {
      return true
    }
    diag_puts("avant fetch: ${dest} has changes git does not have; to change a dependency, patch a clone of it (avant.toml's git and rev name the clone); otherwise remove ${dest}, then fetch again:")
    diag_puts(text)
  }
  false
}

// Every directory of deps/ that is no dependency any more is removed,
// when it is a clean git checkout; any other is kept and named.
pub fn pkg_prune(deps_dir: String, fetched: Array(PkgFetched)): Bool {
  entries = dir_list(deps_dir) ?? []
  for e in entries {
    if e.size == 0 || e[0] == 46 {
      continue
    }
    keep = false
    for f in fetched {
      if f.name == e {
        keep = true
      }
    }
    path = pkg_join(deps_dir, e)
    if keep || !dir_exists(path) {
      continue
    }
    if !dir_exists(pkg_join(path, ".git")) {
      puts("note: kept ${path}: no dependency names it and it is not a git checkout; the compiler does not read it")
      continue
    }
    if text = pkg_status(path, "prune-${e}") {
      if text.size > 0 {
        puts("note: kept ${path}: no dependency names it any more, but it has changes git does not have; the compiler does not read it")
        continue
      }
    } else {
      continue
    }
    if fs_remove_tree(path) != 0 {
      diag_puts("avant fetch: cannot remove ${path}")
      return false
    }
    puts("removed ${path}: no dependency names it any more")
  }
  true
}
