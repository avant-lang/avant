import location
import diagnostic

pub class Source {
  path: String = ""
  text: String = ""

  fn initialize(path: String, text: String) {
    self.path = path
    self.text = text
  }
}

pub fn source_read(path: String): Source? {
  if text = file_read(path) {
    return Source.new(path, text)
  }
  nil
}

// The runtime's comparison (avant_str_eq: the two lengths first, then one
// memcmp; Stage 28 W18P, O155) instead of a loop that asked both sizes and
// bounds-checked both bytes at every step.
pub fn str_eq(a: String, b: String): Bool {
  a == b
}

pub fn str_ends(s: String, suf: String): Bool {
  if suf.size > s.size {
    return false
  }
  str_eq(str_slice(s, s.size - suf.size, s.size), suf)
}
