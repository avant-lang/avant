import location
import diagnostic

pub class Source {
  pub path: String = ""
  pub text: String = ""

  fn initialize(path: String, text: String) {
    self.path = path
    self.text = text
  }
}

// `avant run` starts the program through this runtime entry, not the
// prelude's process_run (Stage 29 W4b2's shim; file_write and dir_list
// are the prelude's since W-ADOPT): the command's exit status is the
// program's, 128 + n when signal n killed it and 127 when it could not
// start, and a ProcessError's fields cannot be told apart yet without a
// type switch (W5).
lib sys_shim {
  fun avant_fs_run(path: String, args: Array(String)): Int
}

// The exit status; 128 + n for signal n; 127 when it could not start.
pub fn shim_process_run(path: String, args: Array(String)): Int {
  sys_shim.avant_fs_run(path, args)
}

// A write's failure, or nil (O569, Stage 29 W-FIX1e): its message is
// `cannot write PATH: REASON`, which the compiler prints or returns
// where it used to drop the reason with `?? -1`.
pub fn write_failure(r: Int | IoError): IoError? {
  _ = r?
  nil
}

pub fn source_read(path: String): Source? {
  if text = file_read(path) {
    return Source.new(path, text)
  }
  nil
}

pub fn str_ends(s: String, suf: String): Bool {
  if suf.size > s.size {
    return false
  }
  str_slice(s, s.size - suf.size, s.size) == suf
}

pub fn str_starts(s: String, pre: String): Bool {
  if pre.size > s.size {
    return false
  }
  str_slice(s, 0, pre.size) == pre
}

pub fn str_lt(a: String, b: String): Bool {
  n = a.size
  if b.size < n {
    n = b.size
  }
  for i in 0..n {
    if a[i] < b[i] {
      return true
    }
    if a[i] > b[i] {
      return false
    }
  }
  a.size < b.size
}
