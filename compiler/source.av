import location
import diagnostic

pub class Source {
  path: String = ""
  text: String = ""

  fn initialize(path: String, text: String) {
    self.path = path
    self.text = text
  }
}

pub fn source_read(path: String): Source? {
  if text = file_read(path) {
    return Source.new(path, text)
  }
  nil
}

pub fn str_ends(s: String, suf: String): Bool {
  if suf.size > s.size {
    return false
  }
  str_slice(s, s.size - suf.size, s.size) == suf
}

pub fn str_starts(s: String, pre: String): Bool {
  if pre.size > s.size {
    return false
  }
  str_slice(s, 0, pre.size) == pre
}

pub fn str_lt(a: String, b: String): Bool {
  n = a.size
  if b.size < n {
    n = b.size
  }
  i = 0
  while i < n {
    if a[i] < b[i] {
      return true
    }
    if a[i] > b[i] {
      return false
    }
    i = i + 1
  }
  a.size < b.size
}
