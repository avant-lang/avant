class Source {
  path: String = ""
  text: String = ""

  fn initialize(path: String, text: String) {
    self.path = path
    self.text = text
  }
}

fn source_read(path: String): Source? {
  if text = file_read(path) {
    return Source.new(path, text)
  }
  nil
}

fn str_eq(a: String, b: String): Bool {
  if a.size != b.size {
    return false
  }
  i = 0
  while i < a.size {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}
