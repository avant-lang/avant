import location
import diagnostic

pub class Source {
  pub path: String = ""
  pub text: String = ""

  fn initialize(path: String, text: String) {
    self.path = path
    self.text = text
  }
}

// The compiler's own file_write, dir_list and process_run until the next
// release (Stage 29 W4b2, the narrow shim): the seed v0.40.0 types them as
// Int, Array(String) and Int, the compiler it builds as a result or an
// IoError / ProcessError (D295 R12), so the compiler calls these runtime
// entries, which mean the same under both. At the next release the
// compiler adopts the prelude's forms and the shim goes, with
// avant_fs_write/list/run and the runtime's avant_file_read.
lib sys_shim {
  fun avant_fs_write(path: String, body: String): Int
  fun avant_fs_list(path: String): Array(String)
  fun avant_fs_run(path: String, args: Array(String)): Int
}

// 0 when the whole body was written, else 1.
pub fn shim_file_write(path: String, body: String): Int {
  sys_shim.avant_fs_write(path, body)
}

// The sorted names, empty when the directory cannot be read.
pub fn shim_dir_list(path: String): Array(String) {
  sys_shim.avant_fs_list(path)
}

// The exit status; 128 + n for signal n; 127 when it could not start.
pub fn shim_process_run(path: String, args: Array(String)): Int {
  sys_shim.avant_fs_run(path, args)
}

pub fn source_read(path: String): Source? {
  if text = file_read(path) {
    return Source.new(path, text)
  }
  nil
}

pub fn str_ends(s: String, suf: String): Bool {
  if suf.size > s.size {
    return false
  }
  str_slice(s, s.size - suf.size, s.size) == suf
}

pub fn str_starts(s: String, pre: String): Bool {
  if pre.size > s.size {
    return false
  }
  str_slice(s, 0, pre.size) == pre
}

pub fn str_lt(a: String, b: String): Bool {
  n = a.size
  if b.size < n {
    n = b.size
  }
  for i in 0..n {
    if a[i] < b[i] {
      return true
    }
    if a[i] > b[i] {
      return false
    }
  }
  a.size < b.size
}

// Two's-complement reinterpretation between Int64 and UInt64 (Stage 29
// W4b1, D295 R1: to_i64 and to_u64 trap outside the target's range). They
// are written with operations the seed v0.40.0 and the compiler it builds
// read the same; the compiler adopts `wrap_i64` / `wrap_u64` at the next
// release.
pub fn bits_u64_to_i64(x: UInt64): Int64 {
  if x <= 9223372036854775807u64 {
    return x.to_i64
  }
  (x - 9223372036854775808u64).to_i64 - 9223372036854775807i64 - 1i64
}

pub fn bits_i64_to_u64(x: Int64): UInt64 {
  if x >= 0i64 {
    return x.to_u64
  }
  ((x + 9223372036854775807i64) + 1i64).to_u64 + 9223372036854775808u64
}
