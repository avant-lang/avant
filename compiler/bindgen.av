import source
import loader
import pipeline

pub class BindResult {
  ok: Bool = false
  text: String = ""
  err: String = ""

  fn initialize(ok: Bool, text: String, err: String) {
    self.ok = ok
    self.text = text
    self.err = err
  }
}

pub fn bind_emit(s: String) {
  if s.size == 0 {
    return
  }
  if s[s.size - 1] == 10 {
    if s.size == 1 {
      puts("")
      return
    }
    puts(str_slice(s, 0, s.size - 1))
    return
  }
  puts(s)
}

pub fn bind_default_name(header: String): String {
  base = path_basename(header)
  if str_ends(base, ".h") {
    return str_slice(base, 0, base.size - 2)
  }
  base
}

fn bind_read(path: String): String {
  if text = file_read(path) {
    return text
  }
  ""
}

// The bind helper (D135, D141), a build product of runtime/build.sh. In a
// checkout, runtime/build/avant-bind comes first, so the helper this tree
// built wins over an old one beside the compiler; otherwise (a release
// install) the helper beside the compiler. Nothing is built here.
fn bind_helper(tried: Array(String)): String {
  root = avant_checkout_root()
  if root.size > 0 {
    cand = "${root}/runtime/build/avant-bind"
    tried.push(cand)
    if file_exists(cand) {
      return cand
    }
  }
  exe = self_exe_path()
  if str_contains(exe, "/") {
    cand = "${path_dirname(exe)}/avant-bind"
    tried.push(cand)
    if file_exists(cand) {
      return cand
    }
  }
  ""
}

fn bind_split(bin: String, lib_name: String, header: String, out_path: String, err_path: String): Int {
  args: Array(String) = []
  args.push(lib_name)
  args.push(header)
  process_run_split(bin, args, out_path, err_path)
}

pub fn bind_generate(lib_name: String, header: String): BindResult {
  tried: Array(String) = []
  bin = bind_helper(tried)
  if bin.size == 0 {
    where = ""
    i = 0
    while i < tried.size {
      if i > 0 {
        where = "${where}, "
      }
      where = "${where}${tried[i]}"
      i = i + 1
    }
    return BindResult.new(false, "", "avant-bind not found (looked in ${where}); build it with sh runtime/build.sh, which needs llvm-config and libclang")
  }
  work = tmp_new_dir()
  out_path = "${work}/bind.out"
  err_path = "${work}/bind.err"
  code = bind_split(bin, lib_name, header, out_path, err_path)
  out_txt = bind_read(out_path)
  err_txt = bind_read(err_path)
  if code != 0 {
    if err_txt.size > 0 {
      return BindResult.new(false, "", err_txt)
    }
    return BindResult.new(false, "", "avant-bind failed (${code})")
  }
  BindResult.new(true, out_txt, err_txt)
}
