// The prelude module's source: standard input (read_line) and the error
// types IoError and ProcessError, which read_line, std.fs and
// std.process give, written in Avant. The file and process functions
// beside them (file_read, file_write, dir_list, process_run, dir_exists,
// dir_walk) are std.fs's and std.process's under their old names, kept
// only for the compiler's own sources, which the seed builds: the checker
// refuses them anywhere else, naming the new spelling (moved_io_name).
// The loader adds this module, named `prelude`, to a program whose source
// names one of the functions or one of the two types (prelude_wanted); every module of the
// program then sees its pub names, the two error types included. The runtime entries are
// avant_sys_* in runtime/avant_io.c. The text is built line by line
// because the seed has no multi-line string literal yet.

import token

// The names that bring the module in: its functions and its two types.
// A program's own IoError or ProcessError is its own: where a module
// declares one, the prelude's type of that name is not seen bare in it
// (checker/visibility.av type_slot_visible, resolve.av seen_owners).
pub fn prelude_names: Array(String) {
  ["file_read", "file_write", "dir_list", "process_run", "read_line", "dir_exists", "dir_walk", "IoError", "ProcessError"]
}

// The old functions of prelude_old_source: a program gets them only when
// it names one.
pub fn prelude_old_names: Array(String) {
  ["file_read", "file_write", "dir_list", "process_run"]
}

pub fn prelude_old_wanted(tokens: Array(Token)): Bool {
  names_wanted(tokens, prelude_old_names())
}

// The functions of the module's second part (prelude_more_source), which
// a program gets only when it names one of them: a program that uses
// only the first part's functions compiles exactly the code it did
// before the second part existed.
pub fn prelude_more_names: Array(String) {
  ["read_line", "dir_exists", "dir_walk"]
}

// Whether a module's tokens name one of the prelude module's names.
pub fn prelude_wanted(tokens: Array(Token)): Bool {
  names_wanted(tokens, prelude_names())
}

// Whether they name one of the second part's (prelude_more_names).
pub fn prelude_more_wanted(tokens: Array(Token)): Bool {
  names_wanted(tokens, prelude_more_names())
}

fn names_wanted(tokens: Array(Token), names: Array(String)): Bool {
  for t in tokens {
    if t.kind == tk_ident() {
      for n in names {
        if t.value == n {
          return true
        }
      }
    }
  }
  false
}

pub fn prelude_path: String {
  "<prelude>"
}

pub fn prelude_source: String {
  b = Buf.new()
  lines = [
    "lib avant_sys {",
    "  fun avant_sys_strerror(code: Int): String",
    "  fun avant_sys_strsignal(sig: Int): String",
    "}",
    "",
    "// A file or directory operation that failed: op is \"read\", \"write\",",
    "// \"list\", \"open\", \"stat\", \"delete\", \"rename\" or \"make\", errno the OS",
    "// error number.",
    "pub class IoError: Error {",
    "  pub op: String",
    "  pub path: String",
    "  pub errno: Int",
    "",
    "  fn initialize(op: String, path: String, errno: Int) {",
    "    self.op = op",
    "    self.path = path",
    "    self.errno = errno",
    "  }",
    "",
    "  pub fn message: String {",
    "    \"cannot \${op} \${path}: \${avant_sys.avant_sys_strerror(errno)}\"",
    "  }",
    "}",
    "",
    "// A program that could not start (errno; output names the output file",
    "// it could not open, else it is \"\"), or that a signal killed (signal).",
    "pub class ProcessError: Error {",
    "  pub path: String",
    "  pub errno: Int",
    "  pub signal: Int",
    "  pub output: String",
    "",
    "  fn initialize(path: String, errno: Int, signal: Int, output: String) {",
    "    self.path = path",
    "    self.errno = errno",
    "    self.signal = signal",
    "    self.output = output",
    "  }",
    "",
    "  pub fn message: String {",
    "    if signal > 0 {",
    "      return \"\${path} killed by signal \${signal} (\${avant_sys.avant_sys_strsignal(signal)})\"",
    "    }",
    "    if output.size > 0 {",
    "      return \"cannot run \${path}: cannot open \${output}: \${avant_sys.avant_sys_strerror(errno)}\"",
    "    }",
    "    \"cannot run \${path}: \${avant_sys.avant_sys_strerror(errno)}\"",
    "  }",
    "}"
  ]
  for line in lines {
    b.push_str(line)
    b.push_str("\n")
  }
  b.to_s()
}

// The old file and process functions, which only the compiler's own
// sources still call (the seed that builds them has no std.fs): a part
// of its own, so a program that imports std.fs or std.process carries
// none of them.
pub fn prelude_old_source: String {
  b = Buf.new()
  lines = [
    "lib avant_sys_old {",
    "  fun avant_sys_read(path: String): String?",
    "  fun avant_sys_write(path: String, body: String): Int",
    "  fun avant_sys_list(path: String): Array(String)?",
    "  fun avant_sys_run(path: String, args: Array(String), out: String): Int",
    "  fun avant_sys_errno: Int",
    "  fun avant_sys_stage: Int",
    "  fun avant_sys_signal: Int",
    "}",
    "",
    "// The whole file.",
    "pub fn file_read(path: String): String | IoError {",
    "  if text = avant_sys_old.avant_sys_read(path) {",
    "    return text",
    "  }",
    "  IoError.new(\"read\", path, avant_sys_old.avant_sys_errno())",
    "}",
    "",
    "// Creates or replaces the file; the bytes written.",
    "pub fn file_write(path: String, body: String): Int | IoError {",
    "  n = avant_sys_old.avant_sys_write(path, body)",
    "  if n < 0 {",
    "    return IoError.new(\"write\", path, avant_sys_old.avant_sys_errno())",
    "  }",
    "  n",
    "}",
    "",
    "// The names in the directory, sorted, without . and ..",
    "pub fn dir_list(path: String): Array(String) | IoError {",
    "  if names = avant_sys_old.avant_sys_list(path) {",
    "    return names",
    "  }",
    "  IoError.new(\"list\", path, avant_sys_old.avant_sys_errno())",
    "}",
    "",
    "// Runs the program (a name without / is looked up on PATH) and waits;",
    "// the exit status of a process that exited.",
    "pub fn process_run(path: String, args: Array(String)): Int | ProcessError {",
    "  process_result(path, avant_sys_old.avant_sys_run(path, args, \"\"), \"\")",
    "}",
    "",
    "fn process_result(path: String, st: Int, out: String): Int | ProcessError {",
    "  if st == -2 {",
    "    return ProcessError.new(path, 0, avant_sys_old.avant_sys_signal(), \"\")",
    "  }",
    "  if st < 0 {",
    "    if avant_sys_old.avant_sys_stage() == 1 {",
    "      return ProcessError.new(path, avant_sys_old.avant_sys_errno(), 0, out)",
    "    }",
    "    return ProcessError.new(path, avant_sys_old.avant_sys_errno(), 0, \"\")",
    "  }",
    "  st",
    "}"
  ]
  for line in lines {
    b.push_str(line)
    b.push_str("\n")
  }
  b.to_s()
}

// The module's second part: standard input read line by line, and the
// two directory functions the compiler's own sources still call, after
// the first part (its error types and process_result).
pub fn prelude_more_source: String {
  b = Buf.new()
  lines = [
    "lib avant_sys_more {",
    "  fun avant_sys_read_line(handle: Int): String?",
    "  fun avant_sys_is_dir(path: String): Int",
    "  fun avant_sys_walk(path: String): Array(String)?",
    "  fun avant_sys_more_errno: Int",
    "}",
    "",
    "// One line of standard input without its newline; nil at the end of",
    "// the input.",
    "pub fn read_line: String | IoError | Nil {",
    "  if line = avant_sys_more.avant_sys_read_line(-1) {",
    "    return line",
    "  }",
    "  e = avant_sys_more.avant_sys_more_errno()",
    "  if e != 0 {",
    "    return IoError.new(\"read\", \"standard input\", e)",
    "  }",
    "  nil",
    "}",
    "",
    "// Whether path names a directory.",
    "pub fn dir_exists(path: String): Bool {",
    "  avant_sys_more.avant_sys_is_dir(path) == 1",
    "}",
    "",
    "// Every name below the directory, as a path relative to it: a directory",
    "// before what it holds, each directory's names sorted; links are not",
    "// followed.",
    "pub fn dir_walk(path: String): Array(String) | IoError {",
    "  if names = avant_sys_more.avant_sys_walk(path) {",
    "    return names",
    "  }",
    "  IoError.new(\"list\", path, avant_sys_more.avant_sys_more_errno())",
    "}"
  ]
  for line in lines {
    b.push_str(line)
    b.push_str("\n")
  }
  b.to_s()
}

// The task module's source: TaskError, the
// failure `h.join` gives when a trap ended the task, and the function
// the lowering calls to make join's value. The loader adds it, named
// `task`, to a program whose source spawns (task_prelude_wanted); every
// module of the program then sees TaskError.
pub fn task_prelude_wanted(tokens: Array(Token)): Bool {
  for t in tokens {
    if t.kind == tk_spawn() {
      return true
    }
  }
  false
}

pub fn task_prelude_path: String {
  "<task>"
}

pub fn task_prelude_source: String {
  b = Buf.new()
  lines = [
    "// A task that a trap ended : the trap's text (what) and its",
    "// site (FILE:LINE:COL, \"\" when the trap has none).",
    "pub class TaskError: Error {",
    "  pub what: String",
    "  pub site: String",
    "",
    "  fn initialize(what: String, site: String) {",
    "    self.what = what",
    "    self.site = site",
    "  }",
    "",
    "  pub fn message: String {",
    "    if site.size > 0 {",
    "      return \"the task trapped: \${what} at \${site}\"",
    "    }",
    "    \"the task trapped: \${what}\"",
    "  }",
    "}",
    "",
    "// The value of `h.join` (mir/lower_task.av lower_join): the block's Int,",
    "// or the trap that ended the task.",
    "pub fn __avant_join_result(value: Int, what: String?, site: String): Int | TaskError {",
    "  if w = what {",
    "    return TaskError.new(w, site)",
    "  }",
    "  value",
    "}",
    "",
    "// The trap that ended a task whose value is not an Int (the join of",
    "// mir/lower_task.av lower_typed_join).",
    "pub fn __avant_task_error(what: String, site: String): TaskError {",
    "  TaskError.new(what, site)",
    "}"
  ]
  for line in lines {
    b.push_str(line)
    b.push_str("\n")
  }
  b.to_s()
}

// The formatting part: n.to_s(base), min, max and clamp on the number
// types, s.is_utf8(), and a Bytes' to_hex and from_hex, written in
// Avant. The loader
// adds it, as the module `prelude_fmt`, only to a program whose source
// writes one of them (fmt_prelude_wanted), so no other program carries
// a byte of it.
pub fn fmt_prelude_path: String {
  "<prelude_fmt>"
}

// Whether the tokens write `.clamp(`, `.to_hex(`, `.from_hex(`,
// `.is_utf8(`, or `.min(`, `.max(` or `.to_s(` with an argument (an array's `xs.min()` and a value's
// `to_s()` take none).
pub fn fmt_prelude_wanted(tokens: Array(Token)): Bool {
  i = 0
  while i + 3 < tokens.size {
    if tokens[i].kind == tk_dot() && tokens[i + 1].kind == tk_ident() && tokens[i + 2].kind == tk_l_paren() {
      n = tokens[i + 1].value
      if n == "clamp" || n == "to_hex" || n == "from_hex" || n == "is_utf8" {
        return true
      }
      if (n == "min" || n == "max" || n == "to_s") && tokens[i + 3].kind != tk_r_paren() {
        return true
      }
    }
    i += 1
  }
  false
}

pub fn fmt_prelude_source: String {
  b = Buf.new()
  lines = [
    "// The text of an integer in a base from 2 to 36, lower case, with a -",
    "// for a negative (n.to_s(base), which the checker writes as this call).",
    "pub fn __avant_to_s_base(n: Int, base: Int): String {",
    "  if n < 0 {",
    "    return \"-\" + __avant_digits(~n.wrap_u64() &+ 1u64, base)",
    "  }",
    "  __avant_digits(n.wrap_u64(), base)",
    "}",
    "",
    "pub fn __avant_to_s_base(n: Int32, base: Int): String {",
    "  __avant_to_s_base(n.to_i(), base)",
    "}",
    "",
    "pub fn __avant_to_s_base(n: UInt32, base: Int): String {",
    "  __avant_to_s_base(n.to_i(), base)",
    "}",
    "",
    "pub fn __avant_to_s_base(n: UInt64, base: Int): String {",
    "  __avant_digits(n, base)",
    "}",
    "",
    "fn __avant_digits(u: UInt64, base: Int): String {",
    "  if base < 2 || base > 36 {",
    "    panic(\"to_s(base) needs base in 2..36, got \${base}\")",
    "  }",
    "  b = base.wrap_u64()",
    "  out: Array(Int) = []",
    "  v = u",
    "  while true {",
    "    d = (v % b).to_i()",
    "    if d < 10 {",
    "      out.push(48 + d)",
    "    } else {",
    "      out.push(87 + d)",
    "    }",
    "    v = v / b",
    "    if v == 0u64 {",
    "      break",
    "    }",
    "  }",
    "  buf = Buf.new()",
    "  i = out.size - 1",
    "  while i >= 0 {",
    "    buf.push_byte(out[i])",
    "    i -= 1",
    "  }",
    "  buf.to_s()",
    "}",
    "",
    "// The smaller of the two.",
    "pub fn (a: Int) min(b: Int): Int {",
    "  if b < a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// The larger of the two.",
    "pub fn (a: Int) max(b: Int): Int {",
    "  if b > a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// x held within lo..=hi; lo must not be above hi.",
    "pub fn (x: Int) clamp(lo: Int, hi: Int): Int {",
    "  if !(lo <= hi) {",
    "    panic(\"clamp(lo, hi) needs lo <= hi, got \${lo} and \${hi}\")",
    "  }",
    "  if x < lo {",
    "    return lo",
    "  }",
    "  if x > hi {",
    "    return hi",
    "  }",
    "  x",
    "}",
    "// The smaller of the two.",
    "pub fn (a: Int32) min(b: Int32): Int32 {",
    "  if b < a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// The larger of the two.",
    "pub fn (a: Int32) max(b: Int32): Int32 {",
    "  if b > a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// x held within lo..=hi; lo must not be above hi.",
    "pub fn (x: Int32) clamp(lo: Int32, hi: Int32): Int32 {",
    "  if !(lo <= hi) {",
    "    panic(\"clamp(lo, hi) needs lo <= hi, got \${lo} and \${hi}\")",
    "  }",
    "  if x < lo {",
    "    return lo",
    "  }",
    "  if x > hi {",
    "    return hi",
    "  }",
    "  x",
    "}",
    "// The smaller of the two.",
    "pub fn (a: UInt32) min(b: UInt32): UInt32 {",
    "  if b < a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// The larger of the two.",
    "pub fn (a: UInt32) max(b: UInt32): UInt32 {",
    "  if b > a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// x held within lo..=hi; lo must not be above hi.",
    "pub fn (x: UInt32) clamp(lo: UInt32, hi: UInt32): UInt32 {",
    "  if !(lo <= hi) {",
    "    panic(\"clamp(lo, hi) needs lo <= hi, got \${lo} and \${hi}\")",
    "  }",
    "  if x < lo {",
    "    return lo",
    "  }",
    "  if x > hi {",
    "    return hi",
    "  }",
    "  x",
    "}",
    "// The smaller of the two.",
    "pub fn (a: UInt64) min(b: UInt64): UInt64 {",
    "  if b < a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// The larger of the two.",
    "pub fn (a: UInt64) max(b: UInt64): UInt64 {",
    "  if b > a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// x held within lo..=hi; lo must not be above hi.",
    "pub fn (x: UInt64) clamp(lo: UInt64, hi: UInt64): UInt64 {",
    "  if !(lo <= hi) {",
    "    panic(\"clamp(lo, hi) needs lo <= hi, got \${lo} and \${hi}\")",
    "  }",
    "  if x < lo {",
    "    return lo",
    "  }",
    "  if x > hi {",
    "    return hi",
    "  }",
    "  x",
    "}",
    "// The smaller of the two.",
    "pub fn (a: Float64) min(b: Float64): Float64 {",
    "  if b < a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// The larger of the two.",
    "pub fn (a: Float64) max(b: Float64): Float64 {",
    "  if b > a {",
    "    return b",
    "  }",
    "  a",
    "}",
    "",
    "// x held within lo..=hi; lo must not be above hi.",
    "pub fn (x: Float64) clamp(lo: Float64, hi: Float64): Float64 {",
    "  if !(lo <= hi) {",
    "    panic(\"clamp(lo, hi) needs lo <= hi, got \${lo} and \${hi}\")",
    "  }",
    "  if x < lo {",
    "    return lo",
    "  }",
    "  if x > hi {",
    "    return hi",
    "  }",
    "  x",
    "}",
    "",
    "// Whether the string's bytes are valid UTF-8.",
    "pub fn (s: String) is_utf8: Bool {",
    "  if v = String.from_utf8(s.bytes) {",
    "    return true",
    "  }",
    "  false",
    "}",
    "",
    "// Two lower-case hexadecimal digits a byte.",
    "pub fn (b: Bytes) to_hex: String {",
    "  digits = \"0123456789abcdef\"",
    "  buf = Buf.new()",
    "  for x in b {",
    "    buf.push_byte(digits[x >> 4])",
    "    buf.push_byte(digits[x & 15])",
    "  }",
    "  buf.to_s()",
    "}",
    "",
    "// The bytes two hexadecimal digits each spell (either case); nil for an",
    "// odd count or any other character.",
    "pub fn (b: Bytes) from_hex: Bytes? {",
    "  if b.size % 2 != 0 {",
    "    return nil",
    "  }",
    "  buf = Buf.new()",
    "  i = 0",
    "  while i < b.size {",
    "    hi = __avant_hex_digit(b[i])",
    "    lo = __avant_hex_digit(b[i + 1])",
    "    if hi < 0 || lo < 0 {",
    "      return nil",
    "    }",
    "    buf.push_byte(hi * 16 + lo)",
    "    i += 2",
    "  }",
    "  buf.to_bytes()",
    "}",
    "",
    "fn __avant_hex_digit(c: Int): Int {",
    "  if c >= 48 && c <= 57 {",
    "    return c - 48",
    "  }",
    "  if c >= 97 && c <= 102 {",
    "    return c - 87",
    "  }",
    "  if c >= 65 && c <= 70 {",
    "    return c - 55",
    "  }",
    "  -1",
    "}"
  ]
  for line in lines {
    b.push_str(line)
    b.push_str("\n")
  }
  b.to_s()
}
