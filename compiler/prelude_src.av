// The prelude module's source: the file, input and process functions
// (prelude_names), written in Avant. Each returns its result or an Error
// value that says what failed: IoError for files, directories and
// standard input, ProcessError for programs.
// The loader adds this module, named `prelude`, to a program whose source
// names one of the functions (prelude_wanted); every module of the
// program then sees its pub names, the two error types included. The runtime entries are
// avant_sys_* in runtime/avant_io.c. The text is built line by line
// because the seed has no multi-line string literal yet.

import token

// The names that bring the module in: its functions. A program that
// calls none of them may declare its own IoError or ProcessError.
pub fn prelude_names: Array(String) {
  ["file_read", "file_write", "dir_list", "process_run", "process_run_out", "read_line", "file_open", "dir_exists", "dir_make", "dir_walk", "file_delete", "file_size", "process_output"]
}

// The functions of the module's second part (prelude_more_source), which
// a program gets only when it names one of them: a program that uses
// only the first part's functions compiles exactly the code it did
// before the second part existed.
pub fn prelude_more_names: Array(String) {
  ["read_line", "file_open", "dir_exists", "dir_make", "dir_walk", "file_delete", "file_size", "process_output"]
}

// Whether a module's tokens name one of the prelude module's names.
pub fn prelude_wanted(tokens: Array(Token)): Bool {
  names_wanted(tokens, prelude_names())
}

// Whether they name one of the second part's (prelude_more_names).
pub fn prelude_more_wanted(tokens: Array(Token)): Bool {
  names_wanted(tokens, prelude_more_names())
}

fn names_wanted(tokens: Array(Token), names: Array(String)): Bool {
  for t in tokens {
    if t.kind == tk_ident() {
      for n in names {
        if t.value == n {
          return true
        }
      }
    }
  }
  false
}

pub fn prelude_path: String {
  "<prelude>"
}

pub fn prelude_source: String {
  b = buf_new()
  lines = [
  "lib avant_sys {",
  "  fun avant_sys_read(path: String): String?",
  "  fun avant_sys_write(path: String, body: String): Int",
  "  fun avant_sys_list(path: String): Array(String)?",
  "  fun avant_sys_run(path: String, args: Array(String), out: String): Int",
  "  fun avant_sys_errno: Int",
  "  fun avant_sys_stage: Int",
  "  fun avant_sys_signal: Int",
  "  fun avant_sys_strerror(code: Int): String",
  "  fun avant_sys_strsignal(sig: Int): String",
  "}",
  "",
  "// A file or directory operation that failed: op is \"read\", \"write\",",
  "// \"list\", \"open\", \"stat\", \"delete\" or \"make\", errno the OS error number.",
  "pub class IoError: Error {",
  "  pub op: String",
  "  pub path: String",
  "  pub errno: Int",
  "",
  "  fn initialize(op: String, path: String, errno: Int) {",
  "    self.op = op",
  "    self.path = path",
  "    self.errno = errno",
  "  }",
  "",
  "  pub fn message: String {",
  "    \"cannot \${op} \${path}: \${avant_sys.avant_sys_strerror(errno)}\"",
  "  }",
  "}",
  "",
  "// A program that could not start (errno; output names the output file",
  "// it could not open, else it is \"\"), or that a signal killed (signal).",
  "pub class ProcessError: Error {",
  "  pub path: String",
  "  pub errno: Int",
  "  pub signal: Int",
  "  pub output: String",
  "",
  "  fn initialize(path: String, errno: Int, signal: Int, output: String) {",
  "    self.path = path",
  "    self.errno = errno",
  "    self.signal = signal",
  "    self.output = output",
  "  }",
  "",
  "  pub fn message: String {",
  "    if signal > 0 {",
  "      return \"\${path} killed by signal \${signal} (\${avant_sys.avant_sys_strsignal(signal)})\"",
  "    }",
  "    if output.size > 0 {",
  "      return \"cannot run \${path}: cannot open \${output}: \${avant_sys.avant_sys_strerror(errno)}\"",
  "    }",
  "    \"cannot run \${path}: \${avant_sys.avant_sys_strerror(errno)}\"",
  "  }",
  "}",
  "",
  "// The whole file.",
  "pub fn file_read(path: String): String | IoError {",
  "  if text = avant_sys.avant_sys_read(path) {",
  "    return text",
  "  }",
  "  IoError.new(\"read\", path, avant_sys.avant_sys_errno())",
  "}",
  "",
  "// Creates or replaces the file; the bytes written.",
  "pub fn file_write(path: String, body: String): Int | IoError {",
  "  n = avant_sys.avant_sys_write(path, body)",
  "  if n < 0 {",
  "    return IoError.new(\"write\", path, avant_sys.avant_sys_errno())",
  "  }",
  "  n",
  "}",
  "",
  "// The names in the directory, sorted, without . and ..",
  "pub fn dir_list(path: String): Array(String) | IoError {",
  "  if names = avant_sys.avant_sys_list(path) {",
  "    return names",
  "  }",
  "  IoError.new(\"list\", path, avant_sys.avant_sys_errno())",
  "}",
  "",
  "// Runs the program (a name without / is looked up on PATH) and waits;",
  "// the exit status of a process that exited.",
  "pub fn process_run(path: String, args: Array(String)): Int | ProcessError {",
  "  process_result(path, avant_sys.avant_sys_run(path, args, \"\"), \"\")",
  "}",
  "",
  "// process_run with stdout and stderr written to the file out.",
  "pub fn process_run_out(path: String, args: Array(String), out: String): Int | ProcessError {",
  "  process_result(path, avant_sys.avant_sys_run(path, args, out), out)",
  "}",
  "",
  "fn process_result(path: String, st: Int, out: String): Int | ProcessError {",
  "  if st == -2 {",
  "    return ProcessError.new(path, 0, avant_sys.avant_sys_signal(), \"\")",
  "  }",
  "  if st < 0 {",
  "    if avant_sys.avant_sys_stage() == 1 {",
  "      return ProcessError.new(path, avant_sys.avant_sys_errno(), 0, out)",
  "    }",
  "    return ProcessError.new(path, avant_sys.avant_sys_errno(), 0, \"\")",
  "  }",
  "  st",
  "}"
  ]
  for line in lines {
    b.push_str(line)
    b.push_str("\n")
  }
  b.to_s()
}

// The module's second part: standard input and files read line by
// line, the file system's basics and a child process's output, after
// the first part (its error types and process_result).
pub fn prelude_more_source: String {
  b = buf_new()
  lines = [
  "lib avant_sys_more {",
  "  fun avant_sys_read_line(handle: Int): String?",
  "  fun avant_sys_open(path: String): Int",
  "  fun avant_sys_close(handle: Int)",
  "  fun avant_sys_is_dir(path: String): Int",
  "  fun avant_sys_make_dir(path: String): Int",
  "  fun avant_sys_delete(path: String): Int",
  "  fun avant_sys_size(path: String): Int",
  "  fun avant_sys_walk(path: String): Array(String)?",
  "  fun avant_sys_capture(path: String, args: Array(String), input: String): Int",
  "  fun avant_sys_captured(which: Int): String",
  "  fun avant_sys_more_errno: Int",
  "  fun avant_sys_more_signal: Int",
  "}",
  "",
  "// One line of standard input without its newline; nil at the end of",
  "// the input.",
  "pub fn read_line: String | IoError | Nil {",
  "  if line = avant_sys_more.avant_sys_read_line(-1) {",
  "    return line",
  "  }",
  "  e = avant_sys_more.avant_sys_more_errno()",
  "  if e != 0 {",
  "    return IoError.new(\"read\", \"standard input\", e)",
  "  }",
  "  nil",
  "}",
  "",
  "// A file read line by line. It closes itself at the end of the file or",
  "// on an error; close stops it early.",
  "pub class FileReader {",
  "  pub path: String",
  "  handle: Int",
  "",
  "  fn initialize(path: String, handle: Int) {",
  "    self.path = path",
  "    self.handle = handle",
  "  }",
  "",
  "  // The next line without its newline; nil after the last one.",
  "  pub fn read_line: String | IoError | Nil {",
  "    if handle == 0 {",
  "      return nil",
  "    }",
  "    if line = avant_sys_more.avant_sys_read_line(handle) {",
  "      return line",
  "    }",
  "    e = avant_sys_more.avant_sys_more_errno()",
  "    close()",
  "    if e != 0 {",
  "      return IoError.new(\"read\", path, e)",
  "    }",
  "    nil",
  "  }",
  "",
  "  pub fn close {",
  "    if handle != 0 {",
  "      avant_sys_more.avant_sys_close(handle)",
  "      self.handle = 0",
  "    }",
  "  }",
  "}",
  "",
  "// The file, to read line by line.",
  "pub fn file_open(path: String): FileReader | IoError {",
  "  h = avant_sys_more.avant_sys_open(path)",
  "  if h == 0 {",
  "    return IoError.new(\"open\", path, avant_sys_more.avant_sys_more_errno())",
  "  }",
  "  FileReader.new(path, h)",
  "}",
  "",
  "// Whether path names a directory.",
  "pub fn dir_exists(path: String): Bool {",
  "  avant_sys_more.avant_sys_is_dir(path) == 1",
  "}",
  "",
  "// Makes the directory and its missing parents; one that exists is fine.",
  "// Nothing on success, else what failed.",
  "pub fn dir_make(path: String): Void | IoError {",
  "  if avant_sys_more.avant_sys_make_dir(path) != 0 {",
  "    return IoError.new(\"make\", path, avant_sys_more.avant_sys_more_errno())",
  "  }",
  "}",
  "",
  "// Removes a file (not a directory): nothing on success, else what failed.",
  "pub fn file_delete(path: String): Void | IoError {",
  "  if avant_sys_more.avant_sys_delete(path) != 0 {",
  "    return IoError.new(\"delete\", path, avant_sys_more.avant_sys_more_errno())",
  "  }",
  "}",
  "",
  "// The size in bytes.",
  "pub fn file_size(path: String): Int | IoError {",
  "  n = avant_sys_more.avant_sys_size(path)",
  "  if n < 0 {",
  "    return IoError.new(\"stat\", path, avant_sys_more.avant_sys_more_errno())",
  "  }",
  "  n",
  "}",
  "",
  "// Every name below the directory, as a path relative to it: a directory",
  "// before what it holds, each directory's names sorted; links are not",
  "// followed.",
  "pub fn dir_walk(path: String): Array(String) | IoError {",
  "  if names = avant_sys_more.avant_sys_walk(path) {",
  "    return names",
  "  }",
  "  IoError.new(\"list\", path, avant_sys_more.avant_sys_more_errno())",
  "}",
  "",
  "// What a finished program gave: its exit status and what it wrote.",
  "pub class ProcessOutput {",
  "  pub status: Int",
  "  pub stdout: String",
  "  pub stderr: String",
  "",
  "  fn initialize(status: Int, stdout: String, stderr: String) {",
  "    self.status = status",
  "    self.stdout = stdout",
  "    self.stderr = stderr",
  "  }",
  "}",
  "",
  "// Runs the program as process_run does, with input on its stdin, and",
  "// captures its stdout and stderr.",
  "pub fn process_output(path: String, args: Array(String), input: String = \"\"): ProcessOutput | ProcessError {",
  "  st = avant_sys_more.avant_sys_capture(path, args, input)",
  "  if st < 0 {",
  "    return process_failure(path, st)",
  "  }",
  "  ProcessOutput.new(st, avant_sys_more.avant_sys_captured(1), avant_sys_more.avant_sys_captured(2))",
  "}",
  "",
  "// Why a captured run failed: a signal, or a start (or an output too",
  "// large to hold) that failed.",
  "fn process_failure(path: String, st: Int): ProcessError {",
  "  if st == -2 {",
  "    return ProcessError.new(path, 0, avant_sys_more.avant_sys_more_signal(), \"\")",
  "  }",
  "  ProcessError.new(path, avant_sys_more.avant_sys_more_errno(), 0, \"\")",
  "}"
  ]
  for line in lines {
    b.push_str(line)
    b.push_str("\n")
  }
  b.to_s()
}

// The task module's source: TaskError, the
// failure `h.join` gives when a trap ended the task, and the function
// the lowering calls to make join's value. The loader adds it, named
// `task`, to a program whose source spawns (task_prelude_wanted); every
// module of the program then sees TaskError.
pub fn task_prelude_wanted(tokens: Array(Token)): Bool {
  for t in tokens {
    if t.kind == tk_spawn() {
      return true
    }
  }
  false
}

pub fn task_prelude_path: String {
  "<task>"
}

pub fn task_prelude_source: String {
  b = buf_new()
  lines = [
  "// A task that a trap ended : the trap's text (what) and its",
  "// site (FILE:LINE:COL, \"\" when the trap has none).",
  "pub class TaskError: Error {",
  "  pub what: String",
  "  pub site: String",
  "",
  "  fn initialize(what: String, site: String) {",
  "    self.what = what",
  "    self.site = site",
  "  }",
  "",
  "  pub fn message: String {",
  "    if site.size > 0 {",
  "      return \"the task trapped: \${what} at \${site}\"",
  "    }",
  "    \"the task trapped: \${what}\"",
  "  }",
  "}",
  "",
  "// The value of `h.join` (mir/lower_task.av lower_join): the block's Int,",
  "// or the trap that ended the task.",
  "pub fn __avant_join_result(value: Int, what: String?, site: String): Int | TaskError {",
  "  if w = what {",
  "    return TaskError.new(w, site)",
  "  }",
  "  value",
  "}"
  ]
  for line in lines {
    b.push_str(line)
    b.push_str("\n")
  }
  b.to_s()
}
