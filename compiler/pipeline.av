pub class IrBox {
  pub ok: Bool = false
  pub re2c_obj: String = ""
  std_objects: Array(String) = []
  std_flags: Array(String) = []
  // The C the project's manifests ask for (its own and its dependencies'),
  // compiled when the program is linked.
  pub pkg_c: Array(PkgCUnit) = []
  pub mir: MModule? = nil

  fn initialize(ok: Bool) {
    self.ok = ok
  }
}

lib posix {
  fun exit(code: Int)
}

// The runtime's checked write to standard output (the one std.testing's
// report uses): every byte written, or the process stops with the reason.
lib checked_out {
  fun avant_test_write(s: String, n: Int)
}

lib scratch_rt {
  fun avant_tmp_dir: String
  fun avant_tmp_new_dir: String
  fun avant_tmp_keep
}

// File and process helpers in runtime/avant_io.c: no /bin/rm, chmod,
// mkdir, or sh -c pwd. Internal; no prelude name.
lib fs_rt {
  fun avant_fs_unlink(path: String): Int
  fun avant_fs_remove_tree(path: String): Int
  fun avant_fs_chmod_x(path: String): Int
  fun avant_fs_mkdir_p(path: String): Int
  fun avant_fs_cwd: String
  fun avant_process_run_split(path: String, args: Array(String), out: String, err: String): Int
  fun avant_tool_run(path: String, args: Array(String), out: String, err: String): Int
  fun avant_fs_copy(src: String, dst: String): Int
}

// rm -f
pub fn fs_unlink(path: String): Int {
  fs_rt.avant_fs_unlink(path)
}

// rm -rf
pub fn fs_remove_tree(path: String): Int {
  fs_rt.avant_fs_remove_tree(path)
}

// chmod +x
pub fn fs_chmod_x(path: String): Int {
  fs_rt.avant_fs_chmod_x(path)
}

// mkdir -p
pub fn fs_mkdir_p(path: String): Int {
  fs_rt.avant_fs_mkdir_p(path)
}

// Runs path with args and waits; stdout to out, stderr to err.
pub fn process_run_split(path: String, args: Array(String), out: String, err: String): Int {
  fs_rt.avant_process_run_split(path, args, out, err)
}

// A tool the compiler runs (cc, re2c, the bind helper, git): stdin is
// /dev/null, never the compiler's own (a tool that reads a
// non-terminal stdin would take the user's input or hang on a socket).
pub fn tool_run(path: String, args: Array(String)): Int {
  fs_rt.avant_tool_run(path, args, "", "")
}

// tool_run with stdout and stderr to out.
pub fn tool_run_out(path: String, args: Array(String), out: String): Int {
  fs_rt.avant_tool_run(path, args, out, "")
}

// tool_run with stdout to out and stderr to err.
pub fn tool_run_split(path: String, args: Array(String), out: String, err: String): Int {
  fs_rt.avant_tool_run(path, args, out, err)
}

// The process's private scratch directory. Every temporary the compiler
// writes lives in it; it is removed at exit, and children nest inside
// it through TMPDIR.
pub fn tmp_dir: String {
  scratch_rt.avant_tmp_dir()
}

// A fresh, created directory inside tmp_dir, for a group of files that
// must not collide with another group in the same process.
pub fn tmp_new_dir: String {
  scratch_rt.avant_tmp_new_dir()
}

pub fn tmp_path(name: String): String {
  "${tmp_dir()}/${name}"
}

// --keep-tmp: keep this process's scratch directory and every nested one.
pub fn tmp_keep {
  scratch_rt.avant_tmp_keep()
}

// A line to standard error, through eputs: it flushes what standard
// output holds first (the two streams keep their order when they go to one
// place), and a failed write stops the compiler with status 1 and the
// stream's name and reason, as puts does for standard output.
pub fn diag_puts(s: String) {
  eputs(s)
}

// A line to standard output at once, unbuffered (the test runner's report
// shows as each file ends, also through a pipe), written whole: a write
// that fails stops the compiler with "avant runtime: cannot write to
// standard output: REASON" and status 1, never a lost line and status 0.
pub fn out_puts(s: String) {
  line = "${s}\n"
  checked_out.avant_test_write(line, line.size)
}

pub fn diag_exit(code: Int) {
  posix.exit(code)
}

pub fn diag_bag(bag: DiagBag) {
  if bag.is_empty() {
    return
  }
  text = bag.render_all()
  if text.size > 0 && text[text.size - 1] == 10 {
    diag_puts(text[..text.size - 1])
    return
  }
  diag_puts(text)
}

pub class LinkJob {
  pub objects: Array(String) = []
  pub flags: Array(String) = []
  pub err: String = ""
  pub codegen: String = ""
  // --cpu=baseline|v2|v3|v4|native, "" when absent.
  pub cpu: String = ""
}

pub class CliSplit {
  pub paths: Array(String) = []
  pub rest: Array(String) = []
}

pub class RunSplit {
  pub file: String = ""
  pub link: Array(String) = []
  pub program: Array(String) = []
  has_dash: Bool = false
  pub err: String = ""
}

pub fn drop_av_suffix(path: String): String {
  base = path_basename(path)
  if base.ends_with(".av") {
    return base[..base.size - 3]
  }
  base
}

// The `runtime: PATH` line of the build's record beside the compiler
// (EXE.versions.txt, tools/letters.sh): the runtime/ of the checkout it
// was built in; "" without a record or without the line (a release
// archive's versions.txt, a seed, a bare copy).
pub fn record_runtime: String {
  exe = self_exe_path()
  if exe.size == 0 {
    return ""
  }
  if text = fs.read("${exe}.versions.txt") {
    for line in text.split("\n") {
      if line.size > 9 && line.starts_with("runtime: ") {
        return line[9..]
      }
    }
  }
  ""
}

// The root whose runtime/ the build's record names (record_runtime), or
// "" when it names none: a kept or copied compiler links and compiles
// against the runtime it was built with, never the one its path or the
// working directory climbs to, and stops saying why when that runtime
// is gone.
pub fn record_runtime_root: String {
  rt = record_runtime()
  if rt.size == 0 {
    return ""
  }
  if !fs.exists("${rt}/build/avant_rt.o") {
    diag_puts("${self_exe_path()}.versions.txt names the runtime ${rt}, which has no build/avant_rt.o; set AVANT_ROOT to the checkout whose runtime this compiler should link")
    diag_exit(1)
  }
  path_dirname(rt)
}

// The checkout the compiler runs from, or "" when it is not in one (a
// release install): AVANT_ROOT, else the one whose runtime the build's
// record names, else the parent of the compiler's bin/ when it holds
// runtime/build/avant_rt.o, else the current directory when it does.
pub fn avant_checkout_root: String {
  if v = process.env("AVANT_ROOT") {
    return v
  }
  rec = record_runtime_root()
  if rec.size > 0 {
    return rec
  }
  args = process.args()
  if args.size > 0 {
    dir = path_dirname(args[0])
    base = path_basename(dir)
    if base == "bin" {
      parent = path_dirname(dir)
      if fs.exists("${parent}/runtime/build/avant_rt.o") {
        return parent
      }
    }
  }
  if fs.exists("runtime/build/avant_rt.o") {
    return "."
  }
  ""
}

// The root whose runtime/ the compiler links and compiles against:
// AVANT_ROOT; else the one whose runtime the build's record names
// (record_runtime_root); else a checkout (the parent of the compiler's
// bin/, then the current directory) when it holds
// runtime/build/avant_rt.o; else the compiler's own install, the
// directory of its executable, when that holds one (the release layout);
// else ".". A checkout wins so that a seed in bin/vX/ links the runtime
// of the tree it builds.
pub fn avant_root: String {
  if v = process.env("AVANT_ROOT") {
    return v
  }
  rec = record_runtime_root()
  if rec.size > 0 {
    return rec
  }
  args = process.args()
  if args.size > 0 {
    dir = path_dirname(args[0])
    base = path_basename(dir)
    if base == "bin" {
      parent = path_dirname(dir)
      probe = "${parent}/runtime/build/avant_rt.o"
      if fs.exists(probe) {
        return parent
      }
    }
  }
  // The working directory's runtime only for a compiler started from
  // inside that tree (a seed in bin/vX/ links the tree it builds): a
  // release run from a PATH or another directory inside a clone of the
  // repository links its own runtime, not the clone's.
  if fs.exists("runtime/build/avant_rt.o") && args.size > 0 && started_inside_cwd(args[0]) {
    return "."
  }
  exe = self_exe_path()
  if exe.size > 0 {
    home = path_dirname(exe)
    if fs.exists("${home}/runtime/build/avant_rt.o") {
      return home
    }
  }
  "."
}

// Whether the program path argv0 names a file under the working
// directory: a relative path with a directory that does not climb out
// (`./bin/v1/avant`, `bin/v1/avant`), or an absolute one below the
// physical working directory. A bare name was found on PATH.
pub fn started_inside_cwd(argv0: String): Bool {
  if argv0.size == 0 {
    return false
  }
  if argv0[0] == 47 {
    here = cwd_physical()
    return here.size > 1 && argv0.starts_with("${here}/")
  }
  if !argv0.contains("/") {
    return false
  }
  !(argv0.starts_with("../") || argv0.contains("/../"))
}

pub fn runtime_object_names: Array(String) {
  names: Array(String) = []
  names.push("avant_rt.o")
  names.push("avant_str.o")
  names.push("avant_buf.o")
  names.push("avant_hash.o")
  names.push("avant_array.o")
  names.push("avant_task.o")
  names.push("avant_io.o")
  names.push("avant_cov.o")
  names
}

pub fn runtime_objects(root: String): Array(String) {
  names = runtime_object_names()
  objs: Array(String) = []
  i = 0
  while i < names.size {
    objs.push("${root}/runtime/build/${names[i]}")
    i += 1
  }
  objs
}

// The runtime's object linked after every other object of a program
// (runtime/avant_tls.c): the hot thread-locals generated code reads, which
// then end the thread-local block, next to the thread pointer, with any
// linker.
pub fn runtime_tls_object(root: String): String {
  "${root}/runtime/build/avant_tls.o"
}

pub fn linker_flags_s(extra: Array(String)): String {
  buf = Buf.new()
  buf.push_str("-pthread -lm")
  for i in 0..extra.size {
    buf.push_str(" ")
    buf.push_str(extra[i])
  }
  buf.to_s()
}

pub fn compile_source(src: Source): IrBox {
  if src.path.size > 0 && fs.exists(src.path) {
    return compile_av_path(src.path)
  }
  lex = Lexer.new(src)
  tokens = lex.tokenize()
  if e = lex.err {
    diag_bag(lex.errors)
    return IrBox.new(false)
  }
  parser = Parser.new(src, tokens)
  program = parser.parse()
  if e = parser.err {
    diag_bag(parser.errors)
    return IrBox.new(false)
  }
  if program.imports.size > 0 {
    diag_puts("import needs a .av file root")
    return IrBox.new(false)
  }
  name = module_name_of(src.path)
  tag_module(program, name, src.path)
  program.root_module = name
  info = ModInfo.new(name, src.path)
  program.mods.push(info)
  if prelude_wanted(tokens) {
    add_prelude(program, prelude_more_wanted(tokens))
  }
  if task_prelude_wanted(tokens) {
    add_task_prelude(program)
  }
  if fmt_prelude_wanted(tokens) {
    add_fmt_prelude(program)
  }
  compile_program(src, program)
}

pub fn compile_program(src: Source, program: Program): IrBox {
  compile_program(src, program, "")
}

// cov_map is the coverage slot map's default path; empty means the
// scratch directory, for a program that runs inside this process.
pub fn compile_program(src: Source, program: Program, cov_map: String): IrBox {
  compile_program(src, program, cov_map, 0)
}

// cpu: the x86-64 level compiled for (llvm_cpu_parse's number, 0 when
// none was named), which the loop tiles' shape follows.
pub fn compile_program(src: Source, program: Program, cov_map: String, cpu: Int): IrBox {
  expander = Expander.new(src, program)
  expander.expand()
  if e = expander.err {
    diag_bag(expander.errors)
    return IrBox.new(false)
  }
  checker = Checker.new(src, program)
  checker.check()
  if e = checker.err {
    diag_bag(checker.errors)
    return IrBox.new(false)
  }
  if err = backend_refusal() {
    diag_puts(err)
    return IrBox.new(false)
  }
  // The literal regex patterns re2c can match. A pattern whose scanner
  // re2c warns about stays on PCRE2 (compile_re2c), and the others are
  // generated again without it, once.
  plan = re2c_plan(program)
  if plan.count > 0 {
    built = compile_re2c(plan)
    if built.bad.size > 0 {
      skip = Hash(String, String).new()
      for id, why in built.bad {
        if id >= 1 && id <= plan.keys.size {
          skip[plan.keys[id - 1]] = why
        }
      }
      plan = re2c_plan(program, skip)
      built = Re2cBuild.new()
      if plan.count > 0 {
        built = compile_re2c(plan)
        if built.bad.size > 0 {
          diag_puts("re2c: the scanners warned again without the patterns re2c warned about: every literal pattern stays on PCRE2")
          built.obj = ""
        }
      }
    }
    if built.obj.size > 0 {
      program.re2c_ids = plan.ids
      program.re2c_groups = plan.groups
      program.re2c_obj = built.obj
    }
  }
  for note in plan.notes {
    diag_puts(note)
  }
  map = cov_map
  if map.size == 0 && coverage_wanted() {
    map = tmp_path("coverage.map")
  }
  if coverage_wanted() {
    // The slot map is written while the program is lowered, before the
    // driver creates a missing output directory: its directory exists
    // first.
    if err = cov_map_dir(coverage_map_path(map)) {
      diag_puts(err)
      return IrBox.new(false)
    }
  }
  // AVANT_COVERAGE_MAP wins over the default (coverage_map_path).
  if coverage_wanted() {
    map = coverage_map_path(map)
  } else {
    map = ""
  }
  compile_program_llvm(src, program, checker.symbol_table(), map, cpu)
}

// Creates the directory of the coverage slot map at path when it is
// missing; the error text when that fails.
pub fn cov_map_dir(path: String): String? {
  i = path.size - 1
  while i > 0 {
    if path[i] == 47 {
      dir = path[..i]
      if fs_mkdir_p(dir) != 0 {
        return "cannot create the coverage map directory ${dir}"
      }
      return nil
    }
    i -= 1
  }
  nil
}

// AVANT_BACKEND (internal): unset, empty, or "llvm" is the one back end
// (the lowering to MIR, then llvm/driver.av). Any other value is
// refused with this message, naming the variable (the old back end it
// selected is retired).
pub fn backend_refusal: String? {
  if v = process.env("AVANT_BACKEND") {
    if v.size == 0 || v == "llvm" {
      return nil
    }
    return "AVANT_BACKEND must be unset, empty, or llvm (the only back end), not ${v}"
  }
  nil
}

// Coverage: AVANT_COVERAGE set to anything but "" or "0".
pub fn coverage_wanted: Bool {
  if v = process.env("AVANT_COVERAGE"), v.size > 0 {
    if v == "0" {
    } else {
      return true
    }
  }
  false
}

// The slot map's path: AVANT_COVERAGE_MAP when set, else the default
// the driver chose (beside the output binary, or the scratch
// directory when the program runs inside this process).
pub fn coverage_map_path(fallback: String): String {
  if v = process.env("AVANT_COVERAGE_MAP"), v.size > 0 {
    return v
  }
  fallback
}

// The back end's half of compile_program: the checked program lowered to
// final-stage MIR (mir/lower.av), carried in the box for compile, run,
// and dump; a construct the lowering does not support yet stops here
// with its diagnostic. cov_map: the coverage slot map's path when
// AVANT_COVERAGE is on, else empty.
pub fn compile_program_llvm(src: Source, program: Program, symbols: SymbolTable, cov_map: String, cpu: Int): IrBox {
  low = mir_lower_program(program, symbols, src.path, avant_root(), cov_map, cpu)
  if low.err.size > 0 {
    diag_puts(low.err)
    return IrBox.new(false)
  }
  box = IrBox.new(true)
  box.mir = low.module
  box.re2c_obj = program.re2c_obj
  fill_std_link(program, box)
  box
}

pub fn fill_std_link(program: Program, box: IrBox) {
  root = avant_root()
  sys = false
  for ldef in program.libs {
    if (ldef.name == "avant_sys_more" || ldef.name == "fs_sys" || ldef.name == "process_sys") && !sys {
      // The prelude's second part (prelude_src.av prelude_more_source),
      // std.fs and std.process declare their runtime in these lib blocks.
      sys = true
      box.std_objects.push("${root}/runtime/build/avant_sys.o")
    }
  }
  os = false
  for mod in program.mods {
    if (mod.name == "std.random" || mod.name == "std.time") && !os {
      // The system's entropy, wall clock and sleep (one object for both).
      os = true
      box.std_objects.push("${root}/runtime/build/avant_os.o")
    }
    if mod.name == "std.zlib" {
      // zlib is vendored inside avant_zlib.o: no -lz.
      box.std_objects.push("${root}/runtime/build/avant_zlib.o")
    }
    if mod.name == "std.digest" {
      // CRC-32 and SHA-256 with the vendored fast paths inside.
      box.std_objects.push("${root}/runtime/build/avant_digest.o")
    }
    if mod.name == "std.base64" {
      box.std_objects.push("${root}/runtime/build/avant_base64.o")
      box.std_objects.push("${root}/runtime/build/libbase64.o")
    }
    if mod.name == "std.json" {
      box.std_objects.push("${root}/runtime/build/avant_json.o")
      box.std_objects.push("${root}/runtime/build/yyjson.o")
    }
    if mod.name == "std.regex" {
      // PCRE2 is vendored inside avant_re.o: no -lpcre2-8.
      box.std_objects.push("${root}/runtime/build/avant_re.o")
    }
    if mod.name == "std.http" {
      box.std_objects.push("${root}/runtime/build/avant_http.o")
      box.std_objects.push("${root}/runtime/build/us_bsd.o")
      box.std_objects.push("${root}/runtime/build/us_context.o")
      box.std_objects.push("${root}/runtime/build/us_loop.o")
      box.std_objects.push("${root}/runtime/build/us_socket.o")
      box.std_objects.push("${root}/runtime/build/us_udp.o")
      box.std_objects.push("${root}/runtime/build/us_epoll_kqueue.o")
    }
  }
}

// The objects and flags the program links beyond its own code: the
// standard library's C, then each package's (compiled now, or taken from
// the cache). False, with the reason said, when a package's C does not
// compile.
pub fn attach_std_link(box: IrBox, job: LinkJob): Bool {
  job.objects.concat(box.std_objects)
  job.flags.concat(box.std_flags)
  for unit in box.pkg_c {
    if !build_pkg_c(unit, job) {
      return false
    }
  }
  true
}

// One package's C, as the root project chose it.
pub class PkgCUnit {
  pub name: String = ""
  // The package's directory: its paths are read from there.
  pub dir: String = ""
  pub sources: Array(String) = []
  pub include: Array(String) = []
  pub flags: Array(String) = []
  pub libs: Array(String) = []

  fn initialize(name: String, dir: String) {
    self.name = name
    self.dir = dir
  }
}

pub fn pkg_c_list(xs: Array(String)): String {
  b = Buf.new()
  for i in 0..xs.size {
    if i > 0 {
      b.push_str(", ")
    }
    b.push_str(xs[i])
  }
  b.to_s()
}

pub fn pkg_c_what(man: PkgManifest): String {
  b = Buf.new()
  if man.c_sources.size > 0 {
    if man.c_sources.size == 1 {
      b.push_str("1 C source")
    } else {
      b.push_str("${man.c_sources.size} C sources")
    }
  }
  if man.c_libs.size > 0 {
    if b.size > 0 {
      b.push_str("; ")
    }
    b.push_str("the libraries ${pkg_c_list(man.c_libs)}")
  }
  if man.c_system.size > 0 {
    if b.size > 0 {
      b.push_str("; ")
    }
    b.push_str("the system's ${pkg_c_list(man.c_system)} instead of its sources")
  }
  b.to_s()
}

// What a program links of its project's C: the root manifest's own [c]
// (its sources and libraries, no opt-in: they are the project's), and the
// [c] of each dependency the program imports a module of, only as the
// root manifest's [link] chose it: "source" compiles the C sources the
// package carries, "system" links the system's library instead; a
// package with C and no choice is an error, so nothing links unasked.
pub fn plan_pkg_c(loader: Loader, box: IrBox): Bool {
  if ds = loader.dep_set {
    root = ds.root
    man_path = man_join(loader.manifest_dir, "avant.toml")
    for ln in root.link_names {
      known = false
      for p in ds.pkgs {
        if p.name == ln {
          known = true
        }
      }
      if !known {
        diag_puts("${man_path}: [link] names ${ln}, which is not a dependency of this project")
        return false
      }
    }
    if root.has_c() {
      unit = PkgCUnit.new(root.name, loader.manifest_dir)
      unit.sources.concat(root.c_sources)
      unit.include.concat(root.c_include)
      unit.flags.concat(root.c_flags)
      unit.libs.concat(root.c_libs)
      box.pkg_c.push(unit)
    }
    for p in ds.pkgs {
      man = p.man
      if !man.has_c() || !loader.uses_dep(p.dir) {
        continue
      }
      mode = root.link_mode(p.name)
      if mode.size == 0 {
        diag_puts("${man_path}: the dependency ${p.name} links C code (${pkg_c_what(man)}), and nothing links unless this project opts in: add [link] with ${p.name} = \"source\" (compile the C it carries) or ${p.name} = \"system\" (link the system's library)")
        return false
      }
      if mode == "source" && man.c_sources.size == 0 {
        diag_puts("${man_path}: [link] ${p.name} = \"source\", but ${p.name} carries no C sources (${pkg_c_what(man)}): write ${p.name} = \"system\"")
        return false
      }
      if mode == "system" && man.c_sources.size > 0 && man.c_system.size == 0 {
        diag_puts("${man_path}: [link] ${p.name} = \"system\", but ${p.name} names no system library to link instead of its C sources: write ${p.name} = \"source\"")
        return false
      }
      unit = PkgCUnit.new(p.name, p.dir)
      if mode == "source" {
        unit.sources.concat(man.c_sources)
        unit.include.concat(man.c_include)
        unit.flags.concat(man.c_flags)
      } else {
        unit.libs.concat(man.c_system)
      }
      unit.libs.concat(man.c_libs)
      box.pkg_c.push(unit)
    }
  }
  true
}

// The cache of compiled package C: AVANT_CACHE_DIR, else
// $XDG_CACHE_HOME/avant, else ~/.cache/avant; "" when none can be named
// (each link then compiles again).
pub fn avant_cache_dir: String {
  if v = process.env("AVANT_CACHE_DIR"), v.size > 0 {
    return v
  }
  if v = process.env("XDG_CACHE_HOME"), v.size > 0 {
    return "${v}/avant"
  }
  if v = process.env("HOME"), v.size > 0 {
    return "${v}/.cache/avant"
  }
  ""
}

// The C compiler run_cc runs, and the first line of its --version: what
// the cache's key names of the compiler.
pub fn cc_identity: String {
  path = "/usr/bin/env"
  args: Array(String) = []
  if v = process.env("CC"), fs.exists(v) {
    path = v
  } else if fs.exists("/usr/bin/cc") {
    path = "/usr/bin/cc"
  } else {
    args.push("cc")
  }
  args.push("--version")
  out = "${tmp_new_dir()}/cc-version.txt"
  _ = tool_run_out(path, args, out)
  first = ""
  if text = fs.read(out) {
    lines = text.split("\n")
    if lines.size > 0 {
      first = lines[0]
    }
  }
  "${path} ${first}"
}

// Every header a package's C may read: the .h files under its include
// directories and beside its sources, as "path sha256" lines, sorted by
// path as listed.
pub fn pkg_c_headers(unit: PkgCUnit): String {
  b = Buf.new()
  dirs: Array(String) = []
  dirs.concat(unit.include)
  for src in unit.sources {
    d = path_dirname(src)
    seen = false
    for x in dirs {
      if x == d {
        seen = true
      }
    }
    if !seen {
      dirs.push(d)
    }
  }
  for d in dirs {
    full = join_dir(unit.dir, d)
    names = fs.walk(full) ?? []
    for n in names {
      if n.ends_with(".h") {
        text = fs.read(join_dir(full, n)) ?? ""
        b.push_str("${d}/${n} ${digest.sha256_hex(text.bytes)}\n")
      }
    }
  }
  b.to_s()
}

// Compiles a package's C sources (or takes them from the cache, keyed by
// the C compiler, the flags and the contents of the sources and their
// headers, so a new version or another compiler is compiled again) and
// adds them and its libraries to the link.
pub fn build_pkg_c(unit: PkgCUnit, job: LinkJob): Bool {
  if unit.sources.size > 0 {
    key_text = Buf.new()
    key_text.push_str("package C 1\n${cc_identity()}\n")
    for f in unit.flags {
      key_text.push_str("flag ${f}\n")
    }
    for inc in unit.include {
      key_text.push_str("include ${inc}\n")
    }
    for src in unit.sources {
      full = join_dir(unit.dir, src)
      if text = fs.read(full) {
        key_text.push_str("source ${src} ${digest.sha256_hex(text.bytes)}\n")
      } else {
        diag_puts("package ${unit.name}: its C source ${src} is missing (${full})")
        return false
      }
    }
    key_text.push_str(pkg_c_headers(unit))
    key = digest.sha256_hex(key_text.to_s().bytes)
    cache = avant_cache_dir()
    dest = ""
    if cache.size > 0 {
      dest = "${cache}/c/${unit.name}-${key[..16]}"
      if fs_mkdir_p(dest) != 0 {
        dest = ""
      }
    }
    for i in 0..unit.sources.size {
      src = unit.sources[i]
      obj_name = "${i}-${path_basename(src)}.o"
      cached = ""
      if dest.size > 0 {
        cached = "${dest}/${obj_name}"
        if fs.exists(cached) {
          job.objects.push(cached)
          continue
        }
      }
      obj = "${tmp_new_dir()}/${obj_name}"
      args: Array(String) = []
      args.push("-c")
      has_opt = false
      has_std = false
      for f in unit.flags {
        if f.starts_with("-O") {
          has_opt = true
        }
        if f.starts_with("-std=") {
          has_std = true
        }
      }
      if !has_opt {
        args.push("-O2")
      }
      if !has_std {
        args.push("-std=c11")
      }
      for inc in unit.include {
        args.push("-I")
        args.push(join_dir(unit.dir, inc))
      }
      args.concat(unit.flags)
      args.push("-o")
      args.push(obj)
      args.push(join_dir(unit.dir, src))
      if run_cc(args) != 0 {
        diag_puts("package ${unit.name}: failed to compile its C source ${src}")
        return false
      }
      if cached.size > 0 && fs_rt.avant_fs_copy(obj, cached) == 0 {
        job.objects.push(cached)
      } else {
        job.objects.push(obj)
      }
    }
  }
  for lname in unit.libs {
    job.flags.push("-l${lname}")
  }
  true
}

pub fn compile_av_path(path: String): IrBox {
  compile_av_path(path, "")
}

pub fn compile_av_path(path: String, cov_map: String): IrBox {
  compile_av_path(path, cov_map, 0)
}

pub fn compile_av_path(path: String, cov_map: String, cpu: Int): IrBox {
  loader = Loader.new()
  if program = loader.load_root(path) {
    if e = loader.err {
      diag_bag(loader.errors)
      return IrBox.new(false)
    }
    src = Source.new(path, "")
    if text = fs.read(path) {
      src = Source.new(path, text)
    }
    box = compile_program(src, program, cov_map, cpu)
    if box.ok && !plan_pkg_c(loader, box) {
      return IrBox.new(false)
    }
    return box
  }
  if e = loader.err {
    diag_bag(loader.errors)
  }
  IrBox.new(false)
}

pub fn compile_av_paths(paths: Array(String)): IrBox {
  compile_av_paths(paths, "")
}

pub fn compile_av_paths(paths: Array(String), cov_map: String): IrBox {
  compile_av_paths(paths, cov_map, 0)
}

pub fn compile_av_paths(paths: Array(String), cov_map: String, cpu: Int): IrBox {
  if paths.size == 0 {
    diag_puts("compile needs a .av file")
    return IrBox.new(false)
  }
  if paths.size > 1 {
    diag_puts("compile takes one root .av (use import)")
    return IrBox.new(false)
  }
  compile_av_path(paths[0], cov_map, cpu)
}

// The physical working directory, or "." when it cannot be read.
pub fn cwd_physical: String {
  fs_rt.avant_fs_cwd()
}

// The coverage map default for a binary written to out: beside it,
// absolute, since the program opens it from wherever it runs.
pub fn coverage_map_beside(out: String): String {
  if coverage_wanted() {
    if out.size > 0 && out[0] == 47 {
      return "${out}.covmap"
    }
    return "${cwd_physical()}/${out}.covmap"
  }
  ""
}

pub fn print_ir(ir: String) {
  if ir.size == 0 {
    return
  }
  if ir[ir.size - 1] == 10 {
    puts(ir[..ir.size - 1])
  } else {
    puts(ir)
  }
}

pub fn run_cc(args: Array(String)): Int {
  if v = process.env("CC"), fs.exists(v) {
    return tool_run(v, args)
  }
  if fs.exists("/usr/bin/cc") {
    return tool_run("/usr/bin/cc", args)
  }
  wrapped: Array(String) = []
  wrapped.push("cc")
  wrapped.concat(args)
  tool_run("/usr/bin/env", wrapped)
}

// re2c, in this order: AVANT_RE2C, the re2c beside the compiler's own
// executable (a release ships one), then the system's.
pub fn re2c_bin: String {
  if v = process.env("AVANT_RE2C"), fs.exists(v) {
    return v
  }
  exe = self_exe_path()
  if exe.contains("/") {
    beside = "${path_dirname(exe)}/re2c"
    if fs.exists(beside) {
      return beside
    }
  }
  if fs.exists("/usr/bin/re2c") {
    return "/usr/bin/re2c"
  }
  "re2c"
}

// What compile_re2c made: the scanners' object ("" when there is none),
// and the scanners re2c warned about, by id, with its first message.
pub class Re2cBuild {
  pub obj: String = ""
  pub bad: Hash(Int, String)

  fn initialize {
    h = Hash(Int, String).new()
    self.bad = h
    self.obj = ""
  }
}

// The scanner id (avant_re2c_find_ID) whose lines hold each line of the
// generated source, 0 for a line outside every scanner: by 1-based line.
pub fn re2c_line_owners(src: String): Array(Int) {
  owners: Array(Int) = [0]
  cur = 0
  for line in src.split("\n") {
    if line.starts_with("static int32_t avant_re2c_find_") {
      rest = line[31..]
      k = 0
      while k < rest.size && rest[k] >= 48 && rest[k] <= 57 {
        k += 1
      }
      cur = rest[..k].to_i() ?? 0
    } else if line.starts_with("}") {
      owners.push(cur)
      cur = 0
      continue
    }
    owners.push(cur)
  }
  owners
}

// Reads re2c's messages (PATH:LINE:COL: warning: ... or error: ...) into
// build.bad by the scanner each line falls in; false when a message names
// no scanner (then no pattern can be kept on re2c).
pub fn re2c_read_warnings(text: String, re_path: String, owners: Array(Int), build: Re2cBuild): Bool {
  prefix = "${re_path}:"
  for line in text.split("\n") {
    if !(line.contains(": warning: ") || line.contains(": error: ")) {
      continue
    }
    if !line.starts_with(prefix) {
      return false
    }
    rest = line[prefix.size..]
    k = 0
    while k < rest.size && rest[k] >= 48 && rest[k] <= 57 {
      k += 1
    }
    n = rest[..k].to_i() ?? 0
    if n <= 0 || n >= owners.size || owners[n] == 0 {
      return false
    }
    id = owners[n]
    if have = build.bad.get(id) {
      continue
    }
    at = line.index_of(": warning: ") ?? (line.index_of(": error: ") ?? 0)
    why = line[at + 2..]
    build.bad[id] = "re2c ${why}"
  }
  true
}

pub fn compile_re2c(plan: Re2cPlan): Re2cBuild {
  build = Re2cBuild.new()
  src = plan.src
  base = "${tmp_new_dir()}/re2c"
  re_path = "${base}.re"
  c_path = "${base}.c"
  log_path = "${base}.log"
  if e = write_failure(fs.write(re_path, src)) {
    diag_puts("re2c: ${e.message()}")
    return build
  }
  // No --bit-vectors: re2c's end-of-input rule, which lets a text hold
  // NUL bytes (the scanner's own comment), cannot be used with it.
  // Every warning on: a warning has meant a generator mistake (a NUL
  // sentinel inside a rule made a scanner read past its text), so a
  // scanner re2c warns about is not used and its pattern stays on PCRE2.
  // Except that a rule matches the empty string: every scanner's
  // end-of-input rule (`$`) does by design, and a pattern that matches
  // it is an ordinary regex (re2c reports the end-of-input rule it then
  // shadows as an error of its own, which still keeps that pattern off).
  args: Array(String) = []
  args.push("-W")
  args.push("-Wno-match-empty-string")
  args.push("-o")
  args.push(c_path)
  args.push(re_path)
  code = tool_run_out(re2c_bin(), args, log_path)
  text = fs.read(log_path) ?? ""
  if text.contains(": warning: ") || text.contains(": error: ") {
    if re2c_read_warnings(text, re_path, re2c_line_owners(src), build) && build.bad.size > 0 {
      return build
    }
    diag_puts("re2c: generator warned outside a pattern's scanner, every literal pattern stays on PCRE2")
    diag_puts(text)
    build.bad.clear()
    return build
  }
  if code != 0 {
    diag_puts("re2c: generator failed, pattern stays on PCRE2")
    if text.size > 0 {
      diag_puts(text)
    }
    return build
  }
  obj = "${base}.o"
  cc: Array(String) = []
  cc.push("-c")
  cc.push("-O2")
  // Placed as the runtime is (runtime/build.sh): the matcher is linked
  // after the runtime, so its growth moved this code.
  cc.push("-falign-functions=64")
  cc.push("-falign-loops=32")
  cc.push("-std=c11")
  cc.push("-I")
  cc.push("${avant_root()}/runtime")
  cc.push("-o")
  cc.push(obj)
  cc.push(c_path)
  code = run_cc(cc)
  if code != 0 {
    diag_puts("re2c: C compile failed, pattern stays on PCRE2")
    return build
  }
  build.obj = obj
  build
}

pub fn compile_c_file(path: String): String {
  if !fs.exists(path) {
    diag_puts("C source is missing: ${path}")
    return ""
  }
  base = path_basename(path)
  name = base
  if base.ends_with(".c") {
    name = base[..base.size - 2]
  }
  obj = "${tmp_new_dir()}/${name}.o"
  args: Array(String) = []
  args.push("-c")
  args.push("-O2")
  args.push("-std=c11")
  args.push("-o")
  args.push(obj)
  args.push(path)
  code = run_cc(args)
  if code != 0 {
    diag_puts("failed to compile C: ${path}")
    return ""
  }
  obj
}

// --lib NAME links the system's library (-lNAME); --lib PATH, a name
// with a slash or a library file's name (lib.a, lib.so, lib.so.1), links
// that file, as a .o is.
pub fn link_lib(job: LinkJob, v: String): String {
  if v.size == 0 {
    return "--lib needs a name or a library's path"
  }
  if v.contains("/") || v.ends_with(".a") || v.ends_with(".so") || v.contains(".so.") {
    if !fs.exists(v) || fs.is_dir(v) {
      return "--lib ${v}: no such library file"
    }
    job.objects.push(v)
    return ""
  }
  job.flags.push("-l${v}")
  ""
}

pub fn parse_link(args: Array(String)): LinkJob {
  job = LinkJob.new()
  i = 0
  while i < args.size {
    arg = args[i]
    if arg == "--debug" {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "debug"
      i += 1
    } else if arg == "--release" {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "release"
      i += 1
    } else if arg == "--final" {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "release"
      i += 1
    } else if arg == "--cpu" || arg.starts_with("--cpu=") {
      v = ""
      if arg == "--cpu" {
        if i + 1 >= args.size {
          job.err = "--cpu needs a level (baseline, v2, v3, v4, native)"
          return job
        }
        v = args[i + 1]
        i += 2
      } else {
        v = arg[6..]
        i += 1
      }
      if !(v == "baseline" || v == "v2" || v == "v3" || v == "v4" || v == "native") {
        job.err = "unknown CPU level ${v} (--cpu=baseline, v2, v3, v4 or native)"
        return job
      }
      if job.cpu.size > 0 && job.cpu != v {
        job.err = "choose one --cpu"
        return job
      }
      job.cpu = v
    } else if arg == "--lib" {
      if i + 1 >= args.size {
        job.err = "--lib needs a name or a library's path"
        return job
      }
      job.err = link_lib(job, args[i + 1])
      if job.err.size > 0 {
        return job
      }
      i += 2
    } else if arg.starts_with("--lib=") {
      job.err = link_lib(job, arg[6..])
      if job.err.size > 0 {
        return job
      }
      i += 1
    } else if arg == "--cc" {
      if i + 1 >= args.size {
        job.err = "--cc needs a .c file"
        return job
      }
      obj = compile_c_file(args[i + 1])
      if obj == "" {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i += 2
    } else if arg.starts_with("--cc=") {
      obj = compile_c_file(arg[5..])
      if obj == "" {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i += 1
    } else if arg.starts_with("-l") {
      if arg.size > 2 {
        job.flags.push(arg)
        i += 1
      } else {
        job.err = "unknown link argument ${arg}"
        return job
      }
    } else if arg.ends_with(".c") {
      obj = compile_c_file(arg)
      if obj == "" {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i += 1
    } else if arg.ends_with(".o") {
      job.objects.push(arg)
      i += 1
    } else {
      job.err = "unknown link argument ${arg}"
      return job
    }
  }
  job
}

pub fn split_run_args(args: Array(String)): RunSplit {
  split = RunSplit.new()
  left: Array(String) = []
  i = 0
  seen = false
  while i < args.size {
    if seen {
      split.program.push(args[i])
    } else if args[i] == "--" {
      seen = true
    } else {
      left.push(args[i])
    }
    i += 1
  }
  split.has_dash = seen
  files = 0
  for j in 0..left.size {
    if left[j].ends_with(".av") {
      files += 1
      split.file = left[j]
    } else {
      split.link.push(left[j])
    }
  }
  if files == 0 {
    split.err = "run needs a .av file"
  } else if files > 1 {
    split.err = "run takes one root .av (use import)"
  }
  split
}

pub fn take_av_files(args: Array(String)): CliSplit {
  split = CliSplit.new()
  i = 0
  while i < args.size {
    if args[i].ends_with(".av") {
      split.paths.push(args[i])
      i += 1
    } else {
      break
    }
  }
  while i < args.size {
    split.rest.push(args[i])
    i += 1
  }
  split
}

pub fn take_out_path(args: Array(String), source: String): CliSplit {
  split = CliSplit.new()
  if args.size == 0 {
    split.paths.push(drop_av_suffix(source))
    return split
  }
  first = args[0]
  if first.starts_with("-") {
    split.paths.push(drop_av_suffix(source))
    split.rest.concat(args)
    return split
  }
  if first.ends_with(".c") {
    split.paths.push(drop_av_suffix(source))
    split.rest.concat(args)
    return split
  }
  if first.ends_with(".o") {
    split.paths.push(drop_av_suffix(source))
    split.rest.concat(args)
    return split
  }
  split.paths.push(first)
  split.rest.concat(args[1..])
  split
}

pub fn verb_codegen(codegen: String, verb: String): String {
  if codegen.size > 0 {
    return codegen
  }
  if verb == "compile" {
    return "release"
  }
  "debug"
}
