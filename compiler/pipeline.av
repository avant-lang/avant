pub class IrBox {
  text: String = ""
  ok: Bool = false
  re2c_obj: String = ""
  quiet_leaves: String = ""
  std_objects: Array(String)
  std_flags: Array(String)
  mir: MModule? = nil

  fn initialize(text: String, ok: Bool) {
    self.text = text
    self.ok = ok
    self.re2c_obj = ""
    self.quiet_leaves = ""
    objs: Array(String) = []
    flags: Array(String) = []
    self.std_objects = objs
    self.std_flags = flags
  }
}

lib posix {
  fun write(fd: Int, buf: String, count: Int): Int
  fun exit(code: Int)
}

lib scratch_rt {
  fun avant_tmp_dir: String
  fun avant_tmp_new_dir: String
  fun avant_tmp_keep
}

// File and process helpers in runtime/avant_io.c (D140): no /bin/rm,
// chmod, mkdir, or sh -c pwd. Internal; no prelude name (D132).
lib fs_rt {
  fun avant_fs_unlink(path: String): Int
  fun avant_fs_remove_tree(path: String): Int
  fun avant_fs_chmod_x(path: String): Int
  fun avant_fs_mkdir_p(path: String): Int
  fun avant_fs_cwd: String
  fun avant_process_run_split(path: String, args: Array(String), out: String, err: String): Int
  fun avant_tool_run(path: String, args: Array(String), out: String, err: String): Int
  fun avant_file_identity(path: String): String
  fun avant_env_set(name: String, value: String)
}

// rm -f
pub fn fs_unlink(path: String): Int {
  fs_rt.avant_fs_unlink(path)
}

// rm -rf
pub fn fs_remove_tree(path: String): Int {
  fs_rt.avant_fs_remove_tree(path)
}

// chmod +x
pub fn fs_chmod_x(path: String): Int {
  fs_rt.avant_fs_chmod_x(path)
}

// mkdir -p
pub fn fs_mkdir_p(path: String): Int {
  fs_rt.avant_fs_mkdir_p(path)
}

// Runs path with args and waits; stdout to out, stderr to err.
pub fn process_run_split(path: String, args: Array(String), out: String, err: String): Int {
  fs_rt.avant_process_run_split(path, args, out, err)
}

// A tool the compiler runs (myc-llvm, cc, re2c, the bind helper, git):
// stdin is /dev/null, never the compiler's own (Wave D). myc-llvm reads all
// of a non-terminal stdin before its arguments, so an inherited pipe made
// it take the input as a source file and an open socket made it hang.
pub fn tool_run(path: String, args: Array(String)): Int {
  fs_rt.avant_tool_run(path, args, "", "")
}

// tool_run with stdout and stderr to out.
pub fn tool_run_out(path: String, args: Array(String), out: String): Int {
  fs_rt.avant_tool_run(path, args, out, "")
}

// tool_run with stdout to out and stderr to err.
pub fn tool_run_split(path: String, args: Array(String), out: String, err: String): Int {
  fs_rt.avant_tool_run(path, args, out, err)
}

// The process's private scratch directory (D127). Every temporary the
// compiler writes lives in it; it is removed at exit, and children nest
// inside it through TMPDIR.
pub fn tmp_dir: String {
  scratch_rt.avant_tmp_dir()
}

// A fresh, created directory inside tmp_dir, for a group of files that
// must not collide with another group in the same process.
pub fn tmp_new_dir: String {
  scratch_rt.avant_tmp_new_dir()
}

pub fn tmp_path(name: String): String {
  "${tmp_dir()}/${name}"
}

// --keep-tmp: keep this process's scratch directory and every nested one.
pub fn tmp_keep {
  scratch_rt.avant_tmp_keep()
}

pub fn diag_puts(s: String) {
  line = "${s}\n"
  dummy = posix.write(2, line, line.size)
}

pub fn out_puts(s: String) {
  line = "${s}\n"
  dummy = posix.write(1, line, line.size)
}

pub fn diag_exit(code: Int) {
  posix.exit(code)
}

pub fn diag_bag(bag: DiagBag) {
  if bag.is_empty {
    return
  }
  text = bag.render_all
  if text.size > 0 {
    if text[text.size - 1] == 10 {
      diag_puts(str_slice(text, 0, text.size - 1))
      return
    }
  }
  diag_puts(text)
}

