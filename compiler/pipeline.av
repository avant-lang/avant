pub fn str_contains(s: String, needle: String): Bool {
  if needle.size == 0 {
    return true
  }
  if needle.size > s.size {
    return false
  }
  i = 0
  last = s.size - needle.size
  while i <= last {
    if str_eq(str_slice(s, i, i + needle.size), needle) {
      return true
    }
    i = i + 1
  }
  false
}

pub fn str_starts(s: String, pre: String): Bool {
  if pre.size > s.size {
    return false
  }
  str_eq(str_slice(s, 0, pre.size), pre)
}

pub fn drop_av_suffix(path: String): String {
  base = path_basename(path)
  if str_ends(base, ".av") {
    return str_slice(base, 0, base.size - 3)
  }
  base
}

// The checkout the compiler runs from, or "" when it is not in one (a
// release install): AVANT_ROOT, else the parent of the compiler's bin/
// when it holds runtime/build/avant_rt.o, else the current directory when
// it does.
pub fn avant_checkout_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  args = argv()
  if args.size > 0 {
    dir = path_dirname(args[0])
    base = path_basename(dir)
    if str_eq(base, "bin") {
      parent = path_dirname(dir)
      if file_exists("${parent}/runtime/build/avant_rt.o") {
        return parent
      }
    }
  }
  if file_exists("runtime/build/avant_rt.o") {
    return "."
  }
  ""
}

// The root whose runtime/ the compiler links and compiles against (D149):
// AVANT_ROOT; else a checkout (the parent of the compiler's bin/, then the
// current directory) when it holds runtime/build/avant_rt.o; else the
// compiler's own install, the directory of its executable, when that holds
// one (the release layout, D148); else ".". A checkout wins so that a seed
// in bin/vX/ links the runtime of the tree it builds.
pub fn avant_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  args = argv()
  if args.size > 0 {
    dir = path_dirname(args[0])
    base = path_basename(dir)
    if str_eq(base, "bin") {
      parent = path_dirname(dir)
      probe = "${parent}/runtime/build/avant_rt.o"
      if file_exists(probe) {
        return parent
      }
    }
  }
  if file_exists("runtime/build/avant_rt.o") {
    return "."
  }
  exe = self_exe_path()
  if exe.size > 0 {
    home = path_dirname(exe)
    if file_exists("${home}/runtime/build/avant_rt.o") {
      return home
    }
  }
  "."
}

pub fn myc_probe_ir: String {
  "FUNC :avant_gc_root\n  ARGS\n    TYPE :ptr<void>\nENDFUNC\n\nFUNC :avant_gc_reload\n  RETURN\n    TYPE :ptr<void>\n  ARGS\n    TYPE :ptr<void>\nENDFUNC\n\nFUNC :avant_gc_enter\nENDFUNC\n\nFUNC :avant_gc_leave\nENDFUNC\n\nFUNC :probe_alloc\n  RETURN\n    TYPE :ptr<void>\n  ARGS\n    TYPE :u64\nENDFUNC\n\nFUNC :main\n  RETURN\n    TYPE :i32\n  ARGS\n    TYPE :i32\n    TYPE :ptr<ptr<u8>>\n  BODY\n    CALL :avant_gc_enter\n    PUSH 8\n    AS :u64\n    CALL :probe_alloc\n    LOCAL :t :ptr<void>\n    STORE\n    LOCAL :t\n    ADDR\n    CALL :avant_gc_root\n    PUSH 8\n    AS :u64\n    CALL :probe_alloc\n    STACK :drop\n    CALL :avant_gc_leave\n    PUSH 0\n    RET\nENDFUNC\n"
}

pub fn myc_accepts_safepoints(path: String): Bool {
  dir = tmp_new_dir()
  ir_path = "${dir}/probe.myc"
  out_path = "${dir}/probe.log"
  w = file_write(ir_path, myc_probe_ir())
  if w != 0 {
    return false
  }
  args: Array(String) = []
  args.push("dump")
  args.push("--gc-root=avant_gc_root")
  args.push("--gc-reload=avant_gc_reload")
  args.push("--gc-enter=avant_gc_enter")
  args.push("--gc-leave=avant_gc_leave")
  args.push(ir_path)
  code = tool_run_out(path, args, out_path)
  if code != 0 {
    return false
  }
  if text = file_read(out_path) {
    return str_contains(text, "gc.statepoint")
  }
  false
}

// The probe cache key for the backend at path (D139): its device, inode,
// size, and nanosecond change time, then the path; "" when unreadable.
pub fn myc_probe_key(path: String): String {
  id = fs_rt.avant_file_identity(path)
  if id.size == 0 {
    return ""
  }
  "${id}:${path}"
}

// Whether the backend at path accepts the safepoint flags, probed once per
// run (D139). A process that probes successfully exports AVANT_MYC_PROBED
// (internal) with the key; a child whose chosen backend has the same key
// skips the probe, and any other path or identity is probed again.
pub fn myc_safepoints_ok(path: String): Bool {
  key = myc_probe_key(path)
  if key.size > 0 {
    if have = env_get("AVANT_MYC_PROBED") {
      if str_eq(have, key) {
        return true
      }
    }
  }
  if myc_accepts_safepoints(path) {
    if key.size > 0 {
      fs_rt.avant_env_set("AVANT_MYC_PROBED", key)
    }
    return true
  }
  false
}

// avant test probes once before its jobs (D139), quietly: a missing or
// refused backend is reported by the compiles that need it.
pub fn myc_probe_once {
  cands = myc_llvm_candidates()
  i = 0
  while i < cands.size {
    if file_exists(cands[i]) {
      dummy = myc_safepoints_ok(cands[i])
      return
    }
    i = i + 1
  }
}

// Where the compiler looks for its backend, in order (D150, amending D54):
// AVANT_MYC_LLVM (an explicit choice wins); the myc-llvm beside the
// compiler's own executable (the backend it ships with); then each PATH
// directory (an ambient one, last).
pub fn myc_llvm_candidates: Array(String) {
  out: Array(String) = []
  if v = env_get("AVANT_MYC_LLVM") {
    out.push(v)
  }
  exe = self_exe_path()
  if str_contains(exe, "/") {
    out.push("${path_dirname(exe)}/myc-llvm")
  }
  if path_env = env_get("PATH") {
    start = 0
    i = 0
    while i <= path_env.size {
      if i == path_env.size || path_env[i] == 58 {
        if i > start {
          out.push("${str_slice(path_env, start, i)}/myc-llvm")
        }
        start = i + 1
      }
      i = i + 1
    }
  }
  out
}

// The first candidate that exists must be a safepoints build; a stock
// myc-llvm is refused, never skipped. An AVANT_MYC_LLVM that names a
// missing file is an error, not a reason to fall back to another backend.
pub fn myc_llvm_path: String {
  if v = env_get("AVANT_MYC_LLVM") {
    if file_exists(v) {
    } else {
      diag_puts("AVANT_MYC_LLVM points at a missing file: ${v}")
      return ""
    }
  }
  cands = myc_llvm_candidates()
  i = 0
  while i < cands.size {
    cand = cands[i]
    if file_exists(cand) {
      if myc_safepoints_ok(cand) {
        return cand
      }
      diag_puts("myc-llvm at ${cand} does not accept the safepoints GC flags; refusing to build GC-unsafe code (tried ${cand})")
      return ""
    }
    i = i + 1
  }
  tried = ""
  i = 0
  while i < cands.size {
    if i > 0 {
      tried = "${tried}, "
    }
    tried = "${tried}${cands[i]}"
    i = i + 1
  }
  diag_puts("myc-llvm not found (tried: ${tried})")
  ""
}

pub fn runtime_object_names: Array(String) {
  names: Array(String) = []
  names.push("avant_rt.o")
  names.push("avant_str.o")
  names.push("avant_buf.o")
  names.push("avant_hash.o")
  names.push("avant_array.o")
  names.push("avant_task.o")
  names.push("avant_wide.o")
  names.push("avant_codec.o")
  names.push("avant_io.o")
  names.push("avant_cov.o")
  names
}

pub fn runtime_objects(root: String): Array(String) {
  names = runtime_object_names()
  objs: Array(String) = []
  i = 0
  while i < names.size {
    objs.push("${root}/runtime/build/${names[i]}")
    i = i + 1
  }
  objs
}

pub fn linker_flags_s(extra: Array(String)): String {
  buf = buf_new()
  buf.push_str("-pthread -lm")
  i = 0
  while i < extra.size {
    buf.push_str(" ")
    buf.push_str(extra[i])
    i = i + 1
  }
  buf.to_s
}

pub fn compile_source(src: Source): IrBox {
  if src.path.size > 0 {
    if file_exists(src.path) {
      return compile_av_path(src.path)
    }
  }
  lex = Lexer.new(src)
  tokens = lex.tokenize
  if e = lex.err {
    diag_bag(lex.errors)
    return IrBox.new("", false)
  }
  parser = Parser.new(src, tokens)
  program = parser.parse
  if e = parser.err {
    diag_bag(parser.errors)
    return IrBox.new("", false)
  }
  if program.imports.size > 0 {
    diag_puts("import needs a .av file root")
    return IrBox.new("", false)
  }
  name = module_name_of(src.path)
  tag_module(program, name, src.path)
  program.root_module = name
  info = ModInfo.new(name, src.path)
  program.mods.push(info)
  compile_program(src, program)
}

pub fn compile_program(src: Source, program: Program): IrBox {
  compile_program(src, program, "")
}

// cov_map is the coverage slot map's default path (D129); empty means
// the scratch directory, for a program that runs inside this process.
pub fn compile_program(src: Source, program: Program, cov_map: String): IrBox {
  expander = Expander.new(src, program)
  dummy_e = expander.expand
  if e = expander.err {
    diag_bag(expander.errors)
    return IrBox.new("", false)
  }
  checker = Checker.new(src, program)
  dummy = checker.check
  if e = checker.err {
    diag_bag(checker.errors)
    return IrBox.new("", false)
  }
  backend = backend_choice()
  if !str_eq(backend, "myc") {
    if !str_eq(backend, "llvm") {
      diag_puts("AVANT_BACKEND must be myc or llvm, not ${backend}")
      return IrBox.new("", false)
    }
    return compile_program_llvm(src, program, checker.symbol_table())
  }
  plan = re2c_plan(program)
  if plan.count > 0 {
    obj = compile_re2c(plan.src)
    if obj.size > 0 {
      program.re2c_ids = plan.ids
      program.re2c_groups = plan.groups
      program.re2c_obj = obj
    }
  }
  map = cov_map
  if map.size == 0 && coverage_wanted() {
    map = tmp_path("coverage.map")
  }
  ir = emit_myc(program, checker.symbol_table(), map)
  if program.codegen_error.size > 0 {
    diag_puts("error: ${program.codegen_error}")
    return IrBox.new("", false)
  }
  box = IrBox.new(ir, true)
  box.re2c_obj = program.re2c_obj
  box.quiet_leaves = program.quiet_leaves
  fill_std_link(program, box)
  box
}

// AVANT_BACKEND (D176, internal): "llvm" selects the new back end (the
// lowering to MIR, then llvm/driver.av); unset, empty, or "myc" the old
// one; any other value is returned for compile_program to refuse.
pub fn backend_choice: String {
  if v = env_get("AVANT_BACKEND") {
    if v.size == 0 || str_eq(v, "myc") {
      return "myc"
    }
    return v
  }
  "myc"
}

// The new back end's half of compile_program (Stage 28 W5b): the checked
// program lowered to final-stage MIR (mir/lower.av), carried in the box
// for compile, run, and dump; a construct the lowering does not support
// yet stops here with its diagnostic.
pub fn compile_program_llvm(src: Source, program: Program, symbols: SymbolTable): IrBox {
  if coverage_wanted() {
    diag_puts("error[L0001]: not yet supported by the llvm back end: coverage (AVANT_COVERAGE, W8)")
    return IrBox.new("", false)
  }
  low = mir_lower_program(program, symbols, src.path, avant_root())
  if low.err.size > 0 {
    diag_puts(low.err)
    return IrBox.new("", false)
  }
  box = IrBox.new("", true)
  box.mir = low.module
  fill_std_link(program, box)
  box
}

pub fn fill_std_link(program: Program, box: IrBox) {
  root = avant_root()
  i = 0
  while i < program.mods.size {
    if str_eq(program.mods[i].name, "std.zlib") {
      // zlib is vendored inside avant_zlib.o (D146): no -lz.
      box.std_objects.push("${root}/runtime/build/avant_zlib.o")
    }
    if str_eq(program.mods[i].name, "std.base64") {
      box.std_objects.push("${root}/runtime/build/avant_base64.o")
      box.std_objects.push("${root}/runtime/build/libbase64.o")
    }
    if str_eq(program.mods[i].name, "std.json") {
      box.std_objects.push("${root}/runtime/build/avant_json.o")
      box.std_objects.push("${root}/runtime/build/yyjson.o")
    }
    if str_eq(program.mods[i].name, "std.regex") {
      // PCRE2 is vendored inside avant_re.o (D146): no -lpcre2-8.
      box.std_objects.push("${root}/runtime/build/avant_re.o")
    }
    if str_eq(program.mods[i].name, "std.http") {
      box.std_objects.push("${root}/runtime/build/avant_http.o")
      box.std_objects.push("${root}/runtime/build/us_bsd.o")
      box.std_objects.push("${root}/runtime/build/us_context.o")
      box.std_objects.push("${root}/runtime/build/us_loop.o")
      box.std_objects.push("${root}/runtime/build/us_socket.o")
      box.std_objects.push("${root}/runtime/build/us_udp.o")
      box.std_objects.push("${root}/runtime/build/us_epoll_kqueue.o")
    }
    i = i + 1
  }
}

pub fn attach_std_link(box: IrBox, job: LinkJob) {
  i = 0
  while i < box.std_objects.size {
    job.objects.push(box.std_objects[i])
    i = i + 1
  }
  i = 0
  while i < box.std_flags.size {
    job.flags.push(box.std_flags[i])
    i = i + 1
  }
}

pub fn compile_av_path(path: String): IrBox {
  compile_av_path(path, "")
}

pub fn compile_av_path(path: String, cov_map: String): IrBox {
  loader = Loader.new()
  if program = loader.load_root(path) {
    if e = loader.err {
      diag_bag(loader.errors)
      return IrBox.new("", false)
    }
    src = Source.new(path, "")
    if text = file_read(path) {
      src = Source.new(path, text)
    }
    return compile_program(src, program, cov_map)
  }
  if e = loader.err {
    diag_bag(loader.errors)
  }
  IrBox.new("", false)
}

pub fn compile_av_paths(paths: Array(String)): IrBox {
  compile_av_paths(paths, "")
}

pub fn compile_av_paths(paths: Array(String), cov_map: String): IrBox {
  if paths.size == 0 {
    diag_puts("compile needs a .av file")
    return IrBox.new("", false)
  }
  if paths.size > 1 {
    diag_puts("compile takes one root .av (use import)")
    return IrBox.new("", false)
  }
  compile_av_path(paths[0], cov_map)
}

// The physical working directory, or "." when it cannot be read.
pub fn cwd_physical: String {
  fs_rt.avant_fs_cwd()
}

// The coverage map default for a binary written to out (D129): beside
// it, absolute, since the program opens it from wherever it runs.
pub fn coverage_map_beside(out: String): String {
  if coverage_wanted() {
    if out.size > 0 && out[0] == 47 {
      return "${out}.covmap"
    }
    return "${cwd_physical()}/${out}.covmap"
  }
  ""
}

pub fn print_ir(ir: String) {
  if ir.size == 0 {
    return
  }
  if ir[ir.size - 1] == 10 {
    puts(str_slice(ir, 0, ir.size - 1))
  } else {
    puts(ir)
  }
}

pub fn run_cc(args: Array(String)): Int {
  if v = env_get("CC") {
    if file_exists(v) {
      return tool_run(v, args)
    }
  }
  if file_exists("/usr/bin/cc") {
    return tool_run("/usr/bin/cc", args)
  }
  wrapped: Array(String) = []
  wrapped.push("cc")
  i = 0
  while i < args.size {
    wrapped.push(args[i])
    i = i + 1
  }
  tool_run("/usr/bin/env", wrapped)
}

// re2c, in the backend's order (D150): AVANT_RE2C, the re2c beside the
// compiler's own executable (a release ships one, D151), then the system's.
pub fn re2c_bin: String {
  if v = env_get("AVANT_RE2C") {
    if file_exists(v) {
      return v
    }
  }
  exe = self_exe_path()
  if str_contains(exe, "/") {
    beside = "${path_dirname(exe)}/re2c"
    if file_exists(beside) {
      return beside
    }
  }
  if file_exists("/usr/bin/re2c") {
    return "/usr/bin/re2c"
  }
  "re2c"
}

pub fn compile_re2c(src: String): String {
  base = "${tmp_new_dir()}/re2c"
  re_path = "${base}.re"
  c_path = "${base}.c"
  log_path = "${base}.log"
  w = file_write(re_path, src)
  if w != 0 {
    diag_puts("re2c: cannot write ${re_path}")
    return ""
  }
  args: Array(String) = []
  args.push("-b")
  args.push("-o")
  args.push(c_path)
  args.push(re_path)
  code = tool_run_out(re2c_bin(), args, log_path)
  if code != 0 {
    diag_puts("re2c: generator failed, pattern stays on PCRE2")
    if text = file_read(log_path) {
      diag_puts(text)
    }
    return ""
  }
  obj = "${base}.o"
  cc: Array(String) = []
  cc.push("-c")
  cc.push("-O2")
  cc.push("-std=c11")
  cc.push("-I")
  cc.push("${avant_root()}/runtime")
  cc.push("-o")
  cc.push(obj)
  cc.push(c_path)
  code = run_cc(cc)
  if code != 0 {
    diag_puts("re2c: C compile failed, pattern stays on PCRE2")
    return ""
  }
  obj
}

pub fn compile_c_file(path: String): String {
  if file_exists(path) {
  } else {
    diag_puts("C source is missing: ${path}")
    return ""
  }
  base = path_basename(path)
  name = base
  if str_ends(base, ".c") {
    name = str_slice(base, 0, base.size - 2)
  }
  obj = "${tmp_new_dir()}/${name}.o"
  args: Array(String) = []
  args.push("-c")
  args.push("-O2")
  args.push("-std=c11")
  args.push("-o")
  args.push(obj)
  args.push(path)
  code = run_cc(args)
  if code != 0 {
    diag_puts("failed to compile C: ${path}")
    return ""
  }
  obj
}

pub fn parse_link(args: Array(String)): LinkJob {
  job = LinkJob.new
  i = 0
  while i < args.size {
    arg = args[i]
    if str_eq(arg, "--debug") {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "debug"
      i = i + 1
    } else if str_eq(arg, "--release") {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "release"
      i = i + 1
    } else if str_eq(arg, "--final") {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "release"
      i = i + 1
    } else if str_eq(arg, "--lib") {
      if i + 1 >= args.size {
        job.err = "--lib needs a name"
        return job
      }
      name = args[i + 1]
      job.flags.push("-l${name}")
      i = i + 2
    } else if str_starts(arg, "--lib=") {
      name = str_slice(arg, 6, arg.size)
      job.flags.push("-l${name}")
      i = i + 1
    } else if str_eq(arg, "--cc") {
      if i + 1 >= args.size {
        job.err = "--cc needs a .c file"
        return job
      }
      obj = compile_c_file(args[i + 1])
      if str_eq(obj, "") {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 2
    } else if str_starts(arg, "--cc=") {
      obj = compile_c_file(str_slice(arg, 5, arg.size))
      if str_eq(obj, "") {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 1
    } else if str_starts(arg, "-l") {
      if arg.size > 2 {
        job.flags.push(arg)
        i = i + 1
      } else {
        job.err = "unknown link argument ${arg}"
        return job
      }
    } else if str_ends(arg, ".c") {
      obj = compile_c_file(arg)
      if str_eq(obj, "") {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 1
    } else if str_ends(arg, ".o") {
      job.objects.push(arg)
      i = i + 1
    } else {
      job.err = "unknown link argument ${arg}"
      return job
    }
  }
  job
}

pub fn split_run_args(args: Array(String)): RunSplit {
  split = RunSplit.new
  left: Array(String) = []
  i = 0
  seen = false
  while i < args.size {
    if seen {
      split.program.push(args[i])
    } else if str_eq(args[i], "--") {
      seen = true
    } else {
      left.push(args[i])
    }
    i = i + 1
  }
  split.has_dash = seen
  files = 0
  j = 0
  while j < left.size {
    if str_ends(left[j], ".av") {
      files = files + 1
      split.file = left[j]
    } else {
      split.link.push(left[j])
    }
    j = j + 1
  }
  if files == 0 {
    split.err = "run needs a .av file"
  } else if files > 1 {
    split.err = "run takes one root .av (use import)"
  }
  split
}

pub fn take_av_files(args: Array(String)): CliSplit {
  split = CliSplit.new
  i = 0
  while i < args.size {
    if str_ends(args[i], ".av") {
      split.paths.push(args[i])
      i = i + 1
    } else {
      break
    }
  }
  while i < args.size {
    split.rest.push(args[i])
    i = i + 1
  }
  split
}

pub fn take_out_path(args: Array(String), source: String): CliSplit {
  split = CliSplit.new
  if args.size == 0 {
    split.paths.push(drop_av_suffix(source))
    return split
  }
  first = args[0]
  if str_starts(first, "-") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  if str_ends(first, ".c") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  if str_ends(first, ".o") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  split.paths.push(first)
  i = 1
  while i < args.size {
    split.rest.push(args[i])
    i = i + 1
  }
  split
}

pub fn verb_codegen(codegen: String, verb: String): String {
  if codegen.size > 0 {
    return codegen
  }
  if str_eq(verb, "compile") {
    return "default"
  }
  "debug"
}

pub fn myc_mode(codegen: String): String {
  if str_eq(codegen, "release") {
    return "final"
  }
  if str_eq(codegen, "debug") {
    return "debug"
  }
  if str_eq(codegen, "default") {
    return "default"
  }
  "debug"
}

pub fn invoke_myc(ir: String, mode: String, extra_objs: Array(String), extra_flags: Array(String), out_path: String, quiet: String, codegen: String, capture: Bool): Int {
  // myc-llvm writes its object beside its input, so both stay here.
  work = tmp_new_dir()
  ir_path = "${work}/main.myc"
  w = file_write(ir_path, ir)
  if w != 0 {
    diag_puts("cannot write ${ir_path}")
    return 1
  }
  myc = myc_llvm_path()
  if myc.size == 0 {
    return 1
  }
  flags = linker_flags_s(extra_flags)
  args: Array(String) = []
  args.push("MYC_LINKER_FLAGS=${flags}")
  args.push(myc)
  args.push(mode)
  sel = myc_mode(codegen)
  if str_eq(sel, "final") {
    args.push("--final")
  } else if str_eq(sel, "debug") {
    args.push("--debug")
  }
  // myc-llvm GC safepoints: names stay Avant C symbols; myc only sees these flags.
  args.push("--gc-root=avant_gc_root")
  args.push("--gc-reload=avant_gc_reload")
  args.push("--gc-enter=avant_gc_enter")
  args.push("--gc-leave=avant_gc_leave")
  // String size and the numeric conversions lower from fields, not calls,
  // so a quiet leaf can contain them. They do not allocate.
  leaves = "avant_type_map,avant_type_map_at,avant_barrier,avant_barrier_at,avant_cov_hit,avant_cov_init,avant_pin,avant_unpin,avant_is_heap,avant_is_young,avant_exp,avant_bump_alloc,avant_gc_quiet_enter,avant_gc_quiet_leave,avant_array_get_ptr,avant_array_set_ptr,avant_array_pop_ptr,avant_array_clear,avant_array_fill_i32,avant_array_fill_u8,avant_str_size,avant_str_byte,avant_str_eq,avant_str_to_f,avant_str_to_i,avant_str_to_f_slice,avant_checksum_str,avant_checksum_f64,avant_buf_size,avant_buf_starts,avant_wide_op,avant_wide_hi,avant_now_ms,avant_now_us,avant_trap_bounds,avant_trap_div_zero,avant_trap_overflow,avant_checked_add_i64,avant_checked_sub_i64,avant_checked_mul_i64,avant_checked_add_u64,avant_checked_sub_u64,avant_checked_mul_u64,avant_checked_div_i64,avant_checked_rem_i64,avant_checked_div_u64,avant_checked_rem_u64"
  if quiet.size > 0 {
    leaves = "${leaves},${quiet}"
  }
  args.push("--gc-leaf=${leaves}")
  args.push(ir_path)
  objs = runtime_objects(avant_root())
  i = 0
  while i < objs.size {
    args.push(objs[i])
    i = i + 1
  }
  i = 0
  while i < extra_objs.size {
    args.push(extra_objs[i])
    i = i + 1
  }
  if str_eq(mode, "c") {
    args.push(out_path)
  }
  if file_exists("/usr/bin/env") {
    if capture {
      log = "${work}/myc.log"
      code = tool_run_out("/usr/bin/env", args, log)
      if code != 0 {
        if text = file_read(log) {
          diag_puts(text)
        }
      }
      return code
    }
    return tool_run("/usr/bin/env", args)
  }
  diag_puts("cannot find /usr/bin/env")
  1
}
