pub class IrBox {
  ok: Bool = false
  re2c_obj: String = ""
  std_objects: Array(String)
  std_flags: Array(String)
  mir: MModule? = nil

  fn initialize(ok: Bool) {
    self.ok = ok
    self.re2c_obj = ""
    objs: Array(String) = []
    flags: Array(String) = []
    self.std_objects = objs
    self.std_flags = flags
  }
}

lib posix {
  fun write(fd: Int, buf: String, count: Int): Int
  fun exit(code: Int)
}

lib scratch_rt {
  fun avant_tmp_dir: String
  fun avant_tmp_new_dir: String
  fun avant_tmp_keep
}

// File and process helpers in runtime/avant_io.c (D140): no /bin/rm,
// chmod, mkdir, or sh -c pwd. Internal; no prelude name (D132).
lib fs_rt {
  fun avant_fs_unlink(path: String): Int
  fun avant_fs_remove_tree(path: String): Int
  fun avant_fs_chmod_x(path: String): Int
  fun avant_fs_mkdir_p(path: String): Int
  fun avant_fs_cwd: String
  fun avant_process_run_split(path: String, args: Array(String), out: String, err: String): Int
  fun avant_tool_run(path: String, args: Array(String), out: String, err: String): Int
}

// rm -f
pub fn fs_unlink(path: String): Int {
  fs_rt.avant_fs_unlink(path)
}

// rm -rf
pub fn fs_remove_tree(path: String): Int {
  fs_rt.avant_fs_remove_tree(path)
}

// chmod +x
pub fn fs_chmod_x(path: String): Int {
  fs_rt.avant_fs_chmod_x(path)
}

// mkdir -p
pub fn fs_mkdir_p(path: String): Int {
  fs_rt.avant_fs_mkdir_p(path)
}

// Runs path with args and waits; stdout to out, stderr to err.
pub fn process_run_split(path: String, args: Array(String), out: String, err: String): Int {
  fs_rt.avant_process_run_split(path, args, out, err)
}

// A tool the compiler runs (cc, re2c, the bind helper, git): stdin is
// /dev/null, never the compiler's own (Wave D: a tool that reads a
// non-terminal stdin would take the user's input or hang on a socket).
pub fn tool_run(path: String, args: Array(String)): Int {
  fs_rt.avant_tool_run(path, args, "", "")
}

// tool_run with stdout and stderr to out.
pub fn tool_run_out(path: String, args: Array(String), out: String): Int {
  fs_rt.avant_tool_run(path, args, out, "")
}

// tool_run with stdout to out and stderr to err.
pub fn tool_run_split(path: String, args: Array(String), out: String, err: String): Int {
  fs_rt.avant_tool_run(path, args, out, err)
}

// The process's private scratch directory (D127). Every temporary the
// compiler writes lives in it; it is removed at exit, and children nest
// inside it through TMPDIR.
pub fn tmp_dir: String {
  scratch_rt.avant_tmp_dir()
}

// A fresh, created directory inside tmp_dir, for a group of files that
// must not collide with another group in the same process.
pub fn tmp_new_dir: String {
  scratch_rt.avant_tmp_new_dir()
}

pub fn tmp_path(name: String): String {
  "${tmp_dir()}/${name}"
}

// --keep-tmp: keep this process's scratch directory and every nested one.
pub fn tmp_keep {
  scratch_rt.avant_tmp_keep()
}

pub fn diag_puts(s: String) {
  line = "${s}\n"
  dummy = posix.write(2, line, line.size)
}

pub fn out_puts(s: String) {
  line = "${s}\n"
  dummy = posix.write(1, line, line.size)
}

pub fn diag_exit(code: Int) {
  posix.exit(code)
}

pub fn diag_bag(bag: DiagBag) {
  if bag.is_empty {
    return
  }
  text = bag.render_all
  if text.size > 0 && text[text.size - 1] == 10 {
    diag_puts(str_slice(text, 0, text.size - 1))
    return
  }
  diag_puts(text)
}

pub class LinkJob {
  objects: Array(String)
  flags: Array(String)
  err: String = ""
  codegen: String = ""
  // --cpu=baseline|v2|v3|v4|native (Stage 28 W18S, O140), "" when absent.
  cpu: String = ""

  fn initialize {
    o: Array(String) = []
    f: Array(String) = []
    self.objects = o
    self.flags = f
    self.err = ""
    self.codegen = ""
    self.cpu = ""
  }
}

pub class CliSplit {
  paths: Array(String)
  rest: Array(String)

  fn initialize {
    p: Array(String) = []
    r: Array(String) = []
    self.paths = p
    self.rest = r
  }
}

pub class RunSplit {
  file: String = ""
  link: Array(String)
  program: Array(String)
  has_dash: Bool = false
  err: String = ""

  fn initialize {
    self.file = ""
    lk: Array(String) = []
    self.link = lk
    pg: Array(String) = []
    self.program = pg
    self.has_dash = false
    self.err = ""
  }
}

pub fn str_contains(s: String, needle: String): Bool {
  if needle.size == 0 {
    return true
  }
  if needle.size > s.size {
    return false
  }
  i = 0
  last = s.size - needle.size
  while i <= last {
    if str_slice(s, i, i + needle.size) == needle {
      return true
    }
    i = i + 1
  }
  false
}

pub fn str_starts(s: String, pre: String): Bool {
  if pre.size > s.size {
    return false
  }
  str_slice(s, 0, pre.size) == pre
}

pub fn drop_av_suffix(path: String): String {
  base = path_basename(path)
  if str_ends(base, ".av") {
    return str_slice(base, 0, base.size - 3)
  }
  base
}

// The checkout the compiler runs from, or "" when it is not in one (a
// release install): AVANT_ROOT, else the parent of the compiler's bin/
// when it holds runtime/build/avant_rt.o, else the current directory when
// it does.
pub fn avant_checkout_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  args = argv()
  if args.size > 0 {
    dir = path_dirname(args[0])
    base = path_basename(dir)
    if base == "bin" {
      parent = path_dirname(dir)
      if file_exists("${parent}/runtime/build/avant_rt.o") {
        return parent
      }
    }
  }
  if file_exists("runtime/build/avant_rt.o") {
    return "."
  }
  ""
}

// The root whose runtime/ the compiler links and compiles against (D149):
// AVANT_ROOT; else a checkout (the parent of the compiler's bin/, then the
// current directory) when it holds runtime/build/avant_rt.o; else the
// compiler's own install, the directory of its executable, when that holds
// one (the release layout, D148); else ".". A checkout wins so that a seed
// in bin/vX/ links the runtime of the tree it builds.
pub fn avant_root: String {
  if v = env_get("AVANT_ROOT") {
    return v
  }
  args = argv()
  if args.size > 0 {
    dir = path_dirname(args[0])
    base = path_basename(dir)
    if base == "bin" {
      parent = path_dirname(dir)
      probe = "${parent}/runtime/build/avant_rt.o"
      if file_exists(probe) {
        return parent
      }
    }
  }
  if file_exists("runtime/build/avant_rt.o") {
    return "."
  }
  exe = self_exe_path()
  if exe.size > 0 {
    home = path_dirname(exe)
    if file_exists("${home}/runtime/build/avant_rt.o") {
      return home
    }
  }
  "."
}

pub fn runtime_object_names: Array(String) {
  names: Array(String) = []
  names.push("avant_rt.o")
  names.push("avant_str.o")
  names.push("avant_buf.o")
  names.push("avant_hash.o")
  names.push("avant_array.o")
  names.push("avant_task.o")
  names.push("avant_wide.o")
  names.push("avant_codec.o")
  names.push("avant_io.o")
  names.push("avant_cov.o")
  names
}

pub fn runtime_objects(root: String): Array(String) {
  names = runtime_object_names()
  objs: Array(String) = []
  i = 0
  while i < names.size {
    objs.push("${root}/runtime/build/${names[i]}")
    i = i + 1
  }
  objs
}

pub fn linker_flags_s(extra: Array(String)): String {
  buf = buf_new()
  buf.push_str("-pthread -lm")
  i = 0
  while i < extra.size {
    buf.push_str(" ")
    buf.push_str(extra[i])
    i = i + 1
  }
  buf.to_s
}

pub fn compile_source(src: Source): IrBox {
  if src.path.size > 0 && file_exists(src.path) {
    return compile_av_path(src.path)
  }
  lex = Lexer.new(src)
  tokens = lex.tokenize
  if e = lex.err {
    diag_bag(lex.errors)
    return IrBox.new(false)
  }
  parser = Parser.new(src, tokens)
  program = parser.parse
  if e = parser.err {
    diag_bag(parser.errors)
    return IrBox.new(false)
  }
  if program.imports.size > 0 {
    diag_puts("import needs a .av file root")
    return IrBox.new(false)
  }
  name = module_name_of(src.path)
  tag_module(program, name, src.path)
  program.root_module = name
  info = ModInfo.new(name, src.path)
  program.mods.push(info)
  compile_program(src, program)
}

pub fn compile_program(src: Source, program: Program): IrBox {
  compile_program(src, program, "")
}

// cov_map is the coverage slot map's default path (D129); empty means
// the scratch directory, for a program that runs inside this process.
pub fn compile_program(src: Source, program: Program, cov_map: String): IrBox {
  expander = Expander.new(src, program)
  dummy_e = expander.expand
  if e = expander.err {
    diag_bag(expander.errors)
    return IrBox.new(false)
  }
  checker = Checker.new(src, program)
  dummy = checker.check
  if e = checker.err {
    diag_bag(checker.errors)
    return IrBox.new(false)
  }
  if err = backend_refusal() {
    diag_puts(err)
    return IrBox.new(false)
  }
  // The literal regex patterns re2c can match (D150).
  plan = re2c_plan(program)
  if plan.count > 0 {
    obj = compile_re2c(plan.src)
    if obj.size > 0 {
      program.re2c_ids = plan.ids
      program.re2c_groups = plan.groups
      program.re2c_obj = obj
    }
  }
  map = cov_map
  if map.size == 0 && coverage_wanted() {
    map = tmp_path("coverage.map")
  }
  if coverage_wanted() {
    // The slot map is written while the program is lowered, before the
    // driver creates a missing output directory (W10b): its directory
    // exists first.
    if err = cov_map_dir(coverage_map_path(map)) {
      diag_puts(err)
      return IrBox.new(false)
    }
  }
  // AVANT_COVERAGE_MAP wins over the default (coverage_map_path).
  if coverage_wanted() {
    map = coverage_map_path(map)
  } else {
    map = ""
  }
  compile_program_llvm(src, program, checker.symbol_table(), map)
}

// Creates the directory of the coverage slot map at path when it is
// missing; the error text when that fails.
pub fn cov_map_dir(path: String): String? {
  i = path.size - 1
  while i > 0 {
    if path[i] == 47 {
      dir = str_slice(path, 0, i)
      if fs_mkdir_p(dir) != 0 {
        return "cannot create the coverage map directory ${dir}"
      }
      return nil
    }
    i = i - 1
  }
  nil
}

// AVANT_BACKEND (D176, internal; D210): unset, empty, or "llvm" is the
// one back end (the lowering to MIR, then llvm/driver.av). Any other
// value is refused with this message, naming the variable (the old back
// end it selected retired in Stage 28 W11).
pub fn backend_refusal: String? {
  if v = env_get("AVANT_BACKEND") {
    if v.size == 0 || v == "llvm" {
      return nil
    }
    return "AVANT_BACKEND must be unset, empty, or llvm (the only back end), not ${v}"
  }
  nil
}

// Coverage (D129): AVANT_COVERAGE set to anything but "" or "0".
pub fn coverage_wanted: Bool {
  if v = env_get("AVANT_COVERAGE") {
    if v.size > 0 {
      if v == "0" {
      } else {
        return true
      }
    }
  }
  false
}

// The slot map's path (D129): AVANT_COVERAGE_MAP when set, else the
// default the driver chose (beside the output binary, or the scratch
// directory when the program runs inside this process).
pub fn coverage_map_path(fallback: String): String {
  if v = env_get("AVANT_COVERAGE_MAP") {
    if v.size > 0 {
      return v
    }
  }
  fallback
}

// The back end's half of compile_program (Stage 28 W5b): the checked
// program lowered to final-stage MIR (mir/lower.av), carried in the box
// for compile, run, and dump; a construct the lowering does not support
// yet stops here with its diagnostic.
// cov_map: the coverage slot map's path when AVANT_COVERAGE is on (W8b),
// else empty.
pub fn compile_program_llvm(src: Source, program: Program, symbols: SymbolTable, cov_map: String): IrBox {
  low = mir_lower_program(program, symbols, src.path, avant_root(), cov_map)
  if low.err.size > 0 {
    diag_puts(low.err)
    return IrBox.new(false)
  }
  box = IrBox.new(true)
  box.mir = low.module
  box.re2c_obj = program.re2c_obj
  fill_std_link(program, box)
  box
}

pub fn fill_std_link(program: Program, box: IrBox) {
  root = avant_root()
  i = 0
  while i < program.mods.size {
    if program.mods[i].name == "std.zlib" {
      // zlib is vendored inside avant_zlib.o (D146): no -lz.
      box.std_objects.push("${root}/runtime/build/avant_zlib.o")
    }
    if program.mods[i].name == "std.base64" {
      box.std_objects.push("${root}/runtime/build/avant_base64.o")
      box.std_objects.push("${root}/runtime/build/libbase64.o")
    }
    if program.mods[i].name == "std.json" {
      box.std_objects.push("${root}/runtime/build/avant_json.o")
      box.std_objects.push("${root}/runtime/build/yyjson.o")
    }
    if program.mods[i].name == "std.regex" {
      // PCRE2 is vendored inside avant_re.o (D146): no -lpcre2-8.
      box.std_objects.push("${root}/runtime/build/avant_re.o")
    }
    if program.mods[i].name == "std.http" {
      box.std_objects.push("${root}/runtime/build/avant_http.o")
      box.std_objects.push("${root}/runtime/build/us_bsd.o")
      box.std_objects.push("${root}/runtime/build/us_context.o")
      box.std_objects.push("${root}/runtime/build/us_loop.o")
      box.std_objects.push("${root}/runtime/build/us_socket.o")
      box.std_objects.push("${root}/runtime/build/us_udp.o")
      box.std_objects.push("${root}/runtime/build/us_epoll_kqueue.o")
    }
    i = i + 1
  }
}

pub fn attach_std_link(box: IrBox, job: LinkJob) {
  i = 0
  while i < box.std_objects.size {
    job.objects.push(box.std_objects[i])
    i = i + 1
  }
  i = 0
  while i < box.std_flags.size {
    job.flags.push(box.std_flags[i])
    i = i + 1
  }
}

pub fn compile_av_path(path: String): IrBox {
  compile_av_path(path, "")
}

pub fn compile_av_path(path: String, cov_map: String): IrBox {
  loader = Loader.new()
  if program = loader.load_root(path) {
    if e = loader.err {
      diag_bag(loader.errors)
      return IrBox.new(false)
    }
    src = Source.new(path, "")
    if text = file_read(path) {
      src = Source.new(path, text)
    }
    return compile_program(src, program, cov_map)
  }
  if e = loader.err {
    diag_bag(loader.errors)
  }
  IrBox.new(false)
}

pub fn compile_av_paths(paths: Array(String)): IrBox {
  compile_av_paths(paths, "")
}

pub fn compile_av_paths(paths: Array(String), cov_map: String): IrBox {
  if paths.size == 0 {
    diag_puts("compile needs a .av file")
    return IrBox.new(false)
  }
  if paths.size > 1 {
    diag_puts("compile takes one root .av (use import)")
    return IrBox.new(false)
  }
  compile_av_path(paths[0], cov_map)
}

// The physical working directory, or "." when it cannot be read.
pub fn cwd_physical: String {
  fs_rt.avant_fs_cwd()
}

// The coverage map default for a binary written to out (D129): beside
// it, absolute, since the program opens it from wherever it runs.
pub fn coverage_map_beside(out: String): String {
  if coverage_wanted() {
    if out.size > 0 && out[0] == 47 {
      return "${out}.covmap"
    }
    return "${cwd_physical()}/${out}.covmap"
  }
  ""
}

pub fn print_ir(ir: String) {
  if ir.size == 0 {
    return
  }
  if ir[ir.size - 1] == 10 {
    puts(str_slice(ir, 0, ir.size - 1))
  } else {
    puts(ir)
  }
}

pub fn run_cc(args: Array(String)): Int {
  if v = env_get("CC") {
    if file_exists(v) {
      return tool_run(v, args)
    }
  }
  if file_exists("/usr/bin/cc") {
    return tool_run("/usr/bin/cc", args)
  }
  wrapped: Array(String) = []
  wrapped.push("cc")
  i = 0
  while i < args.size {
    wrapped.push(args[i])
    i = i + 1
  }
  tool_run("/usr/bin/env", wrapped)
}

// re2c, in the order D150 set: AVANT_RE2C, the re2c beside the
// compiler's own executable (a release ships one, D151), then the system's.
pub fn re2c_bin: String {
  if v = env_get("AVANT_RE2C") {
    if file_exists(v) {
      return v
    }
  }
  exe = self_exe_path()
  if str_contains(exe, "/") {
    beside = "${path_dirname(exe)}/re2c"
    if file_exists(beside) {
      return beside
    }
  }
  if file_exists("/usr/bin/re2c") {
    return "/usr/bin/re2c"
  }
  "re2c"
}

pub fn compile_re2c(src: String): String {
  base = "${tmp_new_dir()}/re2c"
  re_path = "${base}.re"
  c_path = "${base}.c"
  log_path = "${base}.log"
  w = file_write(re_path, src)
  if w != 0 {
    diag_puts("re2c: cannot write ${re_path}")
    return ""
  }
  args: Array(String) = []
  args.push("-b")
  args.push("-o")
  args.push(c_path)
  args.push(re_path)
  code = tool_run_out(re2c_bin(), args, log_path)
  if code != 0 {
    diag_puts("re2c: generator failed, pattern stays on PCRE2")
    if text = file_read(log_path) {
      diag_puts(text)
    }
    return ""
  }
  obj = "${base}.o"
  cc: Array(String) = []
  cc.push("-c")
  cc.push("-O2")
  cc.push("-std=c11")
  cc.push("-I")
  cc.push("${avant_root()}/runtime")
  cc.push("-o")
  cc.push(obj)
  cc.push(c_path)
  code = run_cc(cc)
  if code != 0 {
    diag_puts("re2c: C compile failed, pattern stays on PCRE2")
    return ""
  }
  obj
}

pub fn compile_c_file(path: String): String {
  if !file_exists(path) {
    diag_puts("C source is missing: ${path}")
    return ""
  }
  base = path_basename(path)
  name = base
  if str_ends(base, ".c") {
    name = str_slice(base, 0, base.size - 2)
  }
  obj = "${tmp_new_dir()}/${name}.o"
  args: Array(String) = []
  args.push("-c")
  args.push("-O2")
  args.push("-std=c11")
  args.push("-o")
  args.push(obj)
  args.push(path)
  code = run_cc(args)
  if code != 0 {
    diag_puts("failed to compile C: ${path}")
    return ""
  }
  obj
}

pub fn parse_link(args: Array(String)): LinkJob {
  job = LinkJob.new
  i = 0
  while i < args.size {
    arg = args[i]
    if arg == "--debug" {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "debug"
      i = i + 1
    } else if arg == "--release" {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "release"
      i = i + 1
    } else if arg == "--final" {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "release"
      i = i + 1
    } else if arg == "--cpu" || str_starts(arg, "--cpu=") {
      v = ""
      if arg == "--cpu" {
        if i + 1 >= args.size {
          job.err = "--cpu needs a level (baseline, v2, v3, v4, native)"
          return job
        }
        v = args[i + 1]
        i = i + 2
      } else {
        v = str_slice(arg, 6, arg.size)
        i = i + 1
      }
      if !(v == "baseline" || v == "v2" || v == "v3" || v == "v4" || v == "native") {
        job.err = "unknown CPU level ${v} (--cpu=baseline, v2, v3, v4 or native)"
        return job
      }
      if job.cpu.size > 0 && job.cpu != v {
        job.err = "choose one --cpu"
        return job
      }
      job.cpu = v
    } else if arg == "--lib" {
      if i + 1 >= args.size {
        job.err = "--lib needs a name"
        return job
      }
      name = args[i + 1]
      job.flags.push("-l${name}")
      i = i + 2
    } else if str_starts(arg, "--lib=") {
      name = str_slice(arg, 6, arg.size)
      job.flags.push("-l${name}")
      i = i + 1
    } else if arg == "--cc" {
      if i + 1 >= args.size {
        job.err = "--cc needs a .c file"
        return job
      }
      obj = compile_c_file(args[i + 1])
      if obj == "" {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 2
    } else if str_starts(arg, "--cc=") {
      obj = compile_c_file(str_slice(arg, 5, arg.size))
      if obj == "" {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 1
    } else if str_starts(arg, "-l") {
      if arg.size > 2 {
        job.flags.push(arg)
        i = i + 1
      } else {
        job.err = "unknown link argument ${arg}"
        return job
      }
    } else if str_ends(arg, ".c") {
      obj = compile_c_file(arg)
      if obj == "" {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 1
    } else if str_ends(arg, ".o") {
      job.objects.push(arg)
      i = i + 1
    } else {
      job.err = "unknown link argument ${arg}"
      return job
    }
  }
  job
}

pub fn split_run_args(args: Array(String)): RunSplit {
  split = RunSplit.new
  left: Array(String) = []
  i = 0
  seen = false
  while i < args.size {
    if seen {
      split.program.push(args[i])
    } else if args[i] == "--" {
      seen = true
    } else {
      left.push(args[i])
    }
    i = i + 1
  }
  split.has_dash = seen
  files = 0
  j = 0
  while j < left.size {
    if str_ends(left[j], ".av") {
      files = files + 1
      split.file = left[j]
    } else {
      split.link.push(left[j])
    }
    j = j + 1
  }
  if files == 0 {
    split.err = "run needs a .av file"
  } else if files > 1 {
    split.err = "run takes one root .av (use import)"
  }
  split
}

pub fn take_av_files(args: Array(String)): CliSplit {
  split = CliSplit.new
  i = 0
  while i < args.size {
    if str_ends(args[i], ".av") {
      split.paths.push(args[i])
      i = i + 1
    } else {
      break
    }
  }
  while i < args.size {
    split.rest.push(args[i])
    i = i + 1
  }
  split
}

pub fn take_out_path(args: Array(String), source: String): CliSplit {
  split = CliSplit.new
  if args.size == 0 {
    split.paths.push(drop_av_suffix(source))
    return split
  }
  first = args[0]
  if str_starts(first, "-") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  if str_ends(first, ".c") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  if str_ends(first, ".o") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  split.paths.push(first)
  i = 1
  while i < args.size {
    split.rest.push(args[i])
    i = i + 1
  }
  split
}

pub fn verb_codegen(codegen: String, verb: String): String {
  if codegen.size > 0 {
    return codegen
  }
  if verb == "compile" {
    return "default"
  }
  "debug"
}
