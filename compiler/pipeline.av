pub fn runtime_objects(root: String): Array(String) {
  names = runtime_object_names()
  objs: Array(String) = []
  i = 0
  while i < names.size {
    objs.push("${root}/runtime/build/${names[i]}")
    i = i + 1
  }
  objs
}

pub fn linker_flags_s(extra: Array(String)): String {
  buf = buf_new()
  buf.push_str("-pthread -lm -lpcre2-8 -lz")
  i = 0
  while i < extra.size {
    buf.push_str(" ")
    buf.push_str(extra[i])
    i = i + 1
  }
  buf.to_s
}

pub fn compile_source(src: Source): IrBox {
  if src.path.size > 0 {
    if file_exists(src.path) {
      return compile_av_path(src.path)
    }
  }
  lex = Lexer.new(src)
  tokens = lex.tokenize
  if e = lex.err {
    diag_bag(lex.errors)
    return IrBox.new("", false)
  }
  parser = Parser.new(src, tokens)
  program = parser.parse
  if e = parser.err {
    diag_bag(parser.errors)
    return IrBox.new("", false)
  }
  if program.imports.size > 0 {
    diag_puts("import needs a .av file root")
    return IrBox.new("", false)
  }
  name = module_name_of(src.path)
  tag_module(program, name, src.path)
  program.root_module = name
  info = ModInfo.new(name, src.path)
  program.mods.push(info)
  compile_program(src, program)
}

pub fn compile_program(src: Source, program: Program): IrBox {
  expander = Expander.new(src, program)
  dummy_e = expander.expand
  if e = expander.err {
    diag_bag(expander.errors)
    return IrBox.new("", false)
  }
  checker = Checker.new(src, program)
  dummy = checker.check
  if e = checker.err {
    diag_bag(checker.errors)
    return IrBox.new("", false)
  }
  plan = re2c_plan(program)
  if plan.count > 0 {
    obj = compile_re2c(plan.src)
    if obj.size > 0 {
      program.re2c_ids = plan.ids
      program.re2c_obj = obj
    }
  }
  ir = emit_myc(program, checker.symbol_table())
  box = IrBox.new(ir, true)
  box.re2c_obj = program.re2c_obj
  box.quiet_leaves = program.quiet_leaves
  box
}

pub fn compile_av_path(path: String): IrBox {
  loader = Loader.new()
  if program = loader.load_root(path) {
    if e = loader.err {
      diag_bag(loader.errors)
      return IrBox.new("", false)
    }
    src = Source.new(path, "")
    if text = file_read(path) {
      src = Source.new(path, text)
    }
    return compile_program(src, program)
  }
  if e = loader.err {
    diag_bag(loader.errors)
  }
  IrBox.new("", false)
}

pub fn compile_av_paths(paths: Array(String)): IrBox {
  if paths.size == 0 {
    diag_puts("compile needs a .av file")
    return IrBox.new("", false)
  }
  if paths.size > 1 {
    diag_puts("compile takes one root .av (use import)")
    return IrBox.new("", false)
  }
  compile_av_path(paths[0])
}

pub fn print_ir(ir: String) {
  if ir.size == 0 {
    return
  }
  if ir[ir.size - 1] == 10 {
    puts(str_slice(ir, 0, ir.size - 1))
  } else {
    puts(ir)
  }
}

pub fn run_cc(args: Array(String)): Int {
  if v = env_get("CC") {
    if file_exists(v) {
      return process_run(v, args)
    }
  }
  if file_exists("/usr/bin/cc") {
    return process_run("/usr/bin/cc", args)
  }
  wrapped: Array(String) = []
  wrapped.push("cc")
  i = 0
  while i < args.size {
    wrapped.push(args[i])
    i = i + 1
  }
  process_run("/usr/bin/env", wrapped)
}

pub fn re2c_bin: String {
  if v = env_get("AVANT_RE2C") {
    if file_exists(v) {
      return v
    }
  }
  local = "${avant_root()}/bin/re2c"
  if file_exists(local) {
    return local
  }
  if file_exists("/usr/bin/re2c") {
    return "/usr/bin/re2c"
  }
  "re2c"
}

pub fn compile_re2c(src: String): String {
  stamp = now_ms()
  base = "/tmp/avant-re2c-${stamp}"
  re_path = "${base}.re"
  c_path = "${base}.c"
  log_path = "${base}.log"
  w = file_write(re_path, src)
  if w != 0 {
    diag_puts("re2c: cannot write ${re_path}")
    return ""
  }
  args: Array(String) = []
  args.push("-b")
  args.push("-o")
  args.push(c_path)
  args.push(re_path)
  code = process_run_out(re2c_bin(), args, log_path)
  if code != 0 {
    diag_puts("re2c: generator failed, pattern stays on PCRE2")
    if text = file_read(log_path) {
      diag_puts(text)
    }
    return ""
  }
  obj = "${base}.o"
  cc: Array(String) = []
  cc.push("-c")
  cc.push("-O2")
  cc.push("-std=c11")
  cc.push("-I")
  cc.push("${avant_root()}/runtime")
  cc.push("-o")
  cc.push(obj)
  cc.push(c_path)
  code = run_cc(cc)
  if code != 0 {
    diag_puts("re2c: C compile failed, pattern stays on PCRE2")
    return ""
  }
  obj
}

pub fn compile_c_file(path: String): String {
  if file_exists(path) {
  } else {
    diag_puts("C source is missing: ${path}")
    return ""
  }
  dir = path_dirname(path)
  base = path_basename(path)
  name = base
  if str_ends(base, ".c") {
    name = str_slice(base, 0, base.size - 2)
  }
  obj = "${dir}/${name}.o"
  args: Array(String) = []
  args.push("-c")
  args.push("-O2")
  args.push("-std=c11")
  args.push("-o")
  args.push(obj)
  args.push(path)
  code = run_cc(args)
  if code != 0 {
    diag_puts("failed to compile C: ${path}")
    return ""
  }
  obj
}

pub fn parse_link(args: Array(String)): LinkJob {
  job = LinkJob.new
  i = 0
  while i < args.size {
    arg = args[i]
    if str_eq(arg, "--debug") {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "debug"
      i = i + 1
    } else if str_eq(arg, "--release") {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "release"
      i = i + 1
    } else if str_eq(arg, "--final") {
      if job.codegen.size > 0 {
        job.err = "choose one of --debug, --release"
        return job
      }
      job.codegen = "release"
      i = i + 1
    } else if str_eq(arg, "--lib") {
      if i + 1 >= args.size {
        job.err = "--lib needs a name"
        return job
      }
      name = args[i + 1]
      job.flags.push("-l${name}")
      i = i + 2
    } else if str_starts(arg, "--lib=") {
      name = str_slice(arg, 6, arg.size)
      job.flags.push("-l${name}")
      i = i + 1
    } else if str_eq(arg, "--cc") {
      if i + 1 >= args.size {
        job.err = "--cc needs a .c file"
        return job
      }
      obj = compile_c_file(args[i + 1])
      if str_eq(obj, "") {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 2
    } else if str_starts(arg, "--cc=") {
      obj = compile_c_file(str_slice(arg, 5, arg.size))
      if str_eq(obj, "") {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 1
    } else if str_starts(arg, "-l") {
      if arg.size > 2 {
        job.flags.push(arg)
        i = i + 1
      } else {
        job.err = "unknown link argument ${arg}"
        return job
      }
    } else if str_ends(arg, ".c") {
      obj = compile_c_file(arg)
      if str_eq(obj, "") {
        job.err = "failed to compile C"
        return job
      }
      job.objects.push(obj)
      i = i + 1
    } else if str_ends(arg, ".o") {
      job.objects.push(arg)
      i = i + 1
    } else {
      job.err = "unknown link argument ${arg}"
      return job
    }
  }
  job
}

pub fn take_av_files(args: Array(String)): CliSplit {
  split = CliSplit.new
  i = 0
  while i < args.size {
    if str_ends(args[i], ".av") {
      split.paths.push(args[i])
      i = i + 1
    } else {
      break
    }
  }
  while i < args.size {
    split.rest.push(args[i])
    i = i + 1
  }
  split
}

pub fn take_out_path(args: Array(String), source: String): CliSplit {
  split = CliSplit.new
  if args.size == 0 {
    split.paths.push(drop_av_suffix(source))
    return split
  }
  first = args[0]
  if str_starts(first, "-") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  if str_ends(first, ".c") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  if str_ends(first, ".o") {
    split.paths.push(drop_av_suffix(source))
    i = 0
    while i < args.size {
      split.rest.push(args[i])
      i = i + 1
    }
    return split
  }
  split.paths.push(first)
  i = 1
  while i < args.size {
    split.rest.push(args[i])
    i = i + 1
  }
  split
}

pub fn myc_wants_final: Bool {
  if v = env_get("AVANT_MYC_FINAL") {
    if str_eq(v, "1") {
      return true
    }
  }
  false
}

pub fn myc_wants_debug: Bool {
  if myc_wants_final() {
    return false
  }
  if v = env_get("AVANT_MYC_DEBUG") {
    if str_eq(v, "0") {
      return false
    }
  }
  true
}

pub fn myc_mode(codegen: String): String {
  if str_eq(codegen, "release") {
    return "final"
  }
  if str_eq(codegen, "debug") {
    return "debug"
  }
  if str_eq(codegen, "default") {
    return "default"
  }
  if myc_wants_final() {
    return "final"
  }
  if myc_wants_debug() {
    return "debug"
  }
  "default"
}

pub fn invoke_myc(ir: String, mode: String, extra_objs: Array(String), extra_flags: Array(String), out_path: String, quiet: String, codegen: String): Int {
  stamp = now_ms()
  ir_path = "/tmp/avant-av-${stamp}.myc"
  w = file_write(ir_path, ir)
  if w != 0 {
    diag_puts("cannot write ${ir_path}")
    return 1
  }
  myc = myc_llvm_path()
  if myc.size == 0 {
    return 1
  }
  flags = linker_flags_s(extra_flags)
  args: Array(String) = []
  args.push("MYC_LINKER_FLAGS=${flags}")
  args.push(myc)
  args.push(mode)
  sel = myc_mode(codegen)
  if str_eq(sel, "final") {
    args.push("--final")
  } else if str_eq(sel, "debug") {
    args.push("--debug")
  }
  // myc-llvm GC safepoints: names stay Avant C symbols; myc only sees these flags.
  args.push("--gc-root=avant_gc_root")
  args.push("--gc-reload=avant_gc_reload")
  args.push("--gc-enter=avant_gc_enter")
  args.push("--gc-leave=avant_gc_leave")
  // String size and the numeric conversions lower from fields, not calls,
  // so a quiet leaf can contain them. They do not allocate.
  leaves = "avant_type_map,avant_barrier,avant_cov_hit,avant_cov_init,avant_pin,avant_unpin,avant_is_heap,avant_is_young,avant_exp,avant_bump_alloc,avant_gc_quiet_enter,avant_gc_quiet_leave,avant_array_get_ptr,avant_array_set_ptr,avant_array_pop_ptr,avant_array_clear,avant_array_fill_i32,avant_array_fill_u8,avant_str_size,avant_str_byte,avant_str_eq,avant_str_to_f,avant_str_to_i,avant_str_to_f_slice,avant_checksum_str,avant_checksum_f64,avant_buf_size,avant_buf_starts,avant_wide_op,avant_wide_hi,avant_now_ms,avant_now_us,avant_trap_bounds,avant_trap_div_zero,avant_trap_overflow,avant_checked_add_i64,avant_checked_sub_i64,avant_checked_mul_i64,avant_checked_add_u64,avant_checked_sub_u64,avant_checked_mul_u64,avant_checked_div_i64,avant_checked_rem_i64,avant_checked_div_u64,avant_checked_rem_u64"
  if quiet.size > 0 {
    leaves = "${leaves},${quiet}"
  }
  args.push("--gc-leaf=${leaves}")
  args.push(ir_path)
  objs = runtime_objects(avant_root())
  i = 0
  while i < objs.size {
    args.push(objs[i])
    i = i + 1
  }
  i = 0
  while i < extra_objs.size {
    args.push(extra_objs[i])
    i = i + 1
  }
  if str_eq(mode, "c") {
    args.push(out_path)
  }
  if file_exists("/usr/bin/env") {
    return process_run("/usr/bin/env", args)
  }
  diag_puts("cannot find /usr/bin/env")
  1
}
