pub fn (codegen_self: MycGen) c_params_of(lib_name: String, name: String): Array(Ty) {
  params: Array(Ty) = []
  if s = codegen_self.symbols {
    if csig = s.find_cfun(lib_name, name) {
      return csig.params
    }
  }
  i = 0
  while i < codegen_self.program.libs.size {
    lib_def = codegen_self.program.libs[i]
    if str_eq(lib_def.name, lib_name) {
      j = 0
      while j < lib_def.funs.size {
        fnn = lib_def.funs[j]
        if str_eq(fnn.name, name) {
          k = 0
          while k < fnn.params.size {
            params.push(codegen_self.resolver.resolve_value(fnn.params[k].type))
            k = k + 1
          }
          return params
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  params
}

pub fn (codegen_self: MycGen) emit_cb_pointer(arg: Expr, fty: Ty) {
  name = "__cb_${arg.resolved}"
  seen = false
  i = 0
  while i < codegen_self.cb_names.size {
    if str_eq(codegen_self.cb_names[i], name) {
      seen = true
    }
    i = i + 1
  }
  if seen {
  } else {
    codegen_self.cb_names.push(name)
    codegen_self.cb_targets.push(arg.resolved)
    codegen_self.cb_tys.push(fty)
    if arg.kind == ex_lambda() {
      codegen_self.cb_lambda.push(1)
    } else {
      codegen_self.cb_lambda.push(0)
    }
  }
  codegen_self.line("ADDR :${name}")
  codegen_self.line("AS :ptr<void>")
}

pub fn (codegen_self: MycGen) emit_lib_call(expr: Expr) {
  params = codegen_self.c_params_of(expr.lib_name, expr.callee)
  has_cb = false
  i = 0
  while i < params.size {
    if params[i].is_fn {
      has_cb = true
    }
    i = i + 1
  }
  if has_cb {
  } else {
    codegen_self.emit_call_named(expr.callee, expr.args)
    return
  }
  if expr.args.size <= 1 {
    if expr.args.size == 1 {
      if params[0].is_fn {
        codegen_self.emit_cb_pointer(expr.args[0], params[0])
      } else {
        codegen_self.emit_expr(expr.args[0])
        codegen_self.emit_coerce(expr_ty(expr.args[0]), params[0])
      }
    }
    codegen_self.line("CALL :${expr.callee}")
    return
  }
  tmps: Array(String) = []
  i = 0
  while i < expr.args.size {
    arg = expr.args[i]
    if params[i].is_fn {
      codegen_self.emit_cb_pointer(arg, params[i])
      tmp = codegen_self.new_temp
      codegen_self.line("LOCAL :${tmp} :ptr<void>")
      codegen_self.line("STORE")
      tmps.push(tmp)
    } else {
      codegen_self.emit_expr(arg)
      got = expr_ty(arg)
      codegen_self.emit_coerce(got, params[i])
      if params[i].is_union {
        if params[i].includes_member(got) {
          got = params[i]
        }
      }
      tmp = codegen_self.new_temp
      m = ty_myc(got)
      codegen_self.line("LOCAL :${tmp} :${m}")
      codegen_self.line("STORE")
      codegen_self.ensure_root(tmp, got)
      tmps.push(tmp)
    }
    i = i + 1
  }
  i = tmps.size - 1
  while i >= 0 {
    codegen_self.line("LOCAL :${tmps[i]}")
    i = i - 1
  }
  codegen_self.line("CALL :${expr.callee}")
}

pub fn (codegen_self: MycGen) emit_cb_thunk(idx: Int) {
  name = codegen_self.cb_names[idx]
  target = codegen_self.cb_targets[idx]
  fty = codegen_self.cb_tys[idx]
  is_lambda = codegen_self.cb_lambda[idx] == 1
  saved_ret = codegen_self.return_type
  saved_main = codegen_self.c_main
  codegen_self.c_main = false
  ret = ty_void()
  if r = fty.inner {
    ret = r
  }
  codegen_self.return_type = ret
  codegen_self.line("FUNC :${name}")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("ARGS")
  codegen_self.indent = codegen_self.indent + 1
  i = 0
  while i < fty.members.size {
    m = ty_myc(fty.members[i])
    codegen_self.line("TYPE :${m}")
    i = i + 1
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.emit_return_header
  codegen_self.line("BODY")
  codegen_self.indent = codegen_self.indent + 1
  i = fty.members.size - 1
  while i >= 0 {
    codegen_self.line("PARAM ${i}")
    i = i - 1
  }
  if is_lambda {
    codegen_self.line("PUSH 0")
    codegen_self.line("AS :ptr<void>")
  }
  codegen_self.line("CALL :${target}")
  codegen_self.line("RET")
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDFUNC")
  codegen_self.blank
  codegen_self.return_type = saved_ret
  codegen_self.c_main = saved_main
}

pub fn (codegen_self: MycGen) emit_call_named(name: String, args: Array(Expr)) {
  codegen_self.emit_args(args)
  codegen_self.line("CALL :${name}")
}

pub fn (codegen_self: MycGen) emit_args(args: Array(Expr)) {
  none: Array(Ty) = []
  codegen_self.emit_typed_args(args, none)
}

pub fn (codegen_self: MycGen) emit_typed_args(args: Array(Expr), types: Array(Ty)) {
  if args.size <= 1 {
    if args.size == 1 {
      codegen_self.emit_expr(args[0])
      if types.size > 0 {
        codegen_self.emit_coerce(expr_ty(args[0]), types[0])
      }
    }
    return
  }
  tmps: Array(String) = []
  i = 0
  while i < args.size {
    arg = args[i]
    codegen_self.emit_expr(arg)
    got = expr_ty(arg)
    if i < types.size {
      codegen_self.emit_coerce(got, types[i])
      if types[i].is_union {
        if types[i].includes_member(got) {
          got = types[i]
        }
      }
    }
    tmp = codegen_self.new_temp
    m = ty_myc(got)
    codegen_self.line("LOCAL :${tmp} :${m}")
    codegen_self.line("STORE")
    codegen_self.ensure_root(tmp, got)
    tmps.push(tmp)
    i = i + 1
  }
  i = tmps.size - 1
  while i >= 0 {
    t = tmps[i]
    codegen_self.line("LOCAL :${t}")
    i = i - 1
  }
}

pub fn (codegen_self: MycGen) begin_fn_frame(boxes: Array(String)) {
  codegen_self.in_lambda = false
  codegen_self.env_layout = ""
  caps: Array(String) = []
  codegen_self.cap_list = caps
  ctys: Array(Ty) = []
  codegen_self.cap_tys_now = ctys
  bs: Array(String) = []
  i = 0
  while i < boxes.size {
    n = boxes[i]
    skip = false
    if codegen_self.self_name.size > 0 {
      if str_eq(n, codegen_self.self_name) {
        skip = true
      }
    }
    if skip {
    } else {
      bs.push(n)
    }
    i = i + 1
  }
  codegen_self.box_list = bs
  ready = Hash(String, Int).new
  codegen_self.box_ready = ready
}

pub fn (codegen_self: MycGen) cap_index(name: String): Int {
  i = 0
  while i < codegen_self.cap_list.size {
    if str_eq(codegen_self.cap_list[i], name) {
      return i
    }
    i = i + 1
  }
  0 - 1
}

pub fn (codegen_self: MycGen) name_is_boxed(name: String): Bool {
  i = 0
  while i < codegen_self.box_list.size {
    if str_eq(codegen_self.box_list[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

pub fn (codegen_self: MycGen) is_gate_callee(name: String): Bool {
  if str_eq(name, "avant_gate_new") {
    return true
  }
  if str_eq(name, "avant_gate_lock") {
    return true
  }
  if str_eq(name, "avant_gate_unlock") {
    return true
  }
  if str_eq(name, "avant_gate_wait") {
    return true
  }
  if str_eq(name, "avant_gate_signal") {
    return true
  }
  str_eq(name, "avant_gate_broadcast")
}

pub fn (codegen_self: MycGen) re2c_call_id(pat: Expr, flags: Expr): Int {
  if pat.kind == ex_string() {
  } else {
    return 0
  }
  if flags.kind == ex_int() {
  } else {
    return 0
  }
  key = re2c_key(pat.value_str, flags.int_bits.to_i)
  if id = codegen_self.program.re2c_ids.get(key) {
    return id
  }
  0
}

pub fn (codegen_self: MycGen) re_mark_callee(name: String): Bool {
  if str_eq(name, "re_m0") {
    return true
  }
  if str_eq(name, "re_m1") {
    return true
  }
  if str_eq(name, "re_c0") {
    return true
  }
  str_eq(name, "re_c1")
}

pub fn (codegen_self: MycGen) note_words(name: String, tys: Array(Ty)) {
  bits = 0u64
  offset = 0
  i = 0
  while i < tys.size {
    fty = tys[i]
    offset = align_up_i(offset, abi_align(fty))
    bits = add_ptr_bits(fty, offset, bits)
    offset = offset + abi_size(fty)
    i = i + 1
  }
  if bits == 0u64 {
    return
  }
  j = 0
  while j < codegen_self.closure_names.size {
    if str_eq(codegen_self.closure_names[j], name) {
      return
    }
    j = j + 1
  }
  codegen_self.closure_names.push(name)
  codegen_self.closure_bits.push(bits)
}

pub fn (codegen_self: MycGen) closure_type_id(name: String): Int {
  i = 0
  while i < codegen_self.closure_names.size {
    if str_eq(codegen_self.closure_names[i], name) {
      return 400 + i
    }
    i = i + 1
  }
  0
}

pub fn (codegen_self: MycGen) note_box(ty: Ty) {
  codegen_self.note_ty(ty)
  layout = box_layout_name(ty)
  i = 0
  while i < codegen_self.box_tys.size {
    if str_eq(box_layout_name(codegen_self.box_tys[i]), layout) {
      return
    }
    i = i + 1
  }
  codegen_self.box_tys.push(ty)
  bits = add_ptr_bits(ty, 0, 0u64)
  codegen_self.closure_names.push(layout)
  codegen_self.closure_bits.push(bits)
}

pub fn (codegen_self: MycGen) note_env(name: String, count: Int) {
  bits = 0u64
  i = 0
  while i < count {
    bits = word_bit(i * 8, bits)
    i = i + 1
  }
  codegen_self.closure_names.push(name)
  codegen_self.closure_bits.push(bits)
}

pub fn (codegen_self: MycGen) collect_lambda(expr: Expr) {
  n = codegen_self.lam_id
  expr.resolved = "__lam_${n}"
  codegen_self.lam_id = n + 1
  codegen_self.lambdas.push(expr)
  i = 0
  while i < expr.cap_tys.size {
    codegen_self.note_box(expr.cap_tys[i])
    i = i + 1
  }
  if expr.cap_names.size > 0 {
    env = "${expr.resolved}_env"
    codegen_self.note_env(env, expr.cap_names.size)
  }
  if b = expr.block {
    codegen_self.collect_stmts(b.body)
  }
}

pub fn (codegen_self: MycGen) emit_fn_def(ty: Ty) {
  name = fn_layout_name(ty)
  code = fn_code_myc(ty)
  codegen_self.line("STRUCT :${name}")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("TYPE :ptr<void>")
  codegen_self.line("TYPE \"${code}\"")
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDSTRUCT")
  codegen_self.blank
}

pub fn (codegen_self: MycGen) emit_box_def(ty: Ty) {
  name = box_layout_name(ty)
  m = ty_myc(ty)
  codegen_self.line("STRUCT :${name}")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("TYPE :${m}")
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDSTRUCT")
  codegen_self.blank
}

pub fn (codegen_self: MycGen) emit_env_defs {
  i = 0
  while i < codegen_self.lambdas.size {
    lam = codegen_self.lambdas[i]
    if lam.cap_names.size > 0 {
      name = "${lam.resolved}_env"
      codegen_self.line("STRUCT :${name}")
      codegen_self.indent = codegen_self.indent + 1
      j = 0
      while j < lam.cap_tys.size {
        box = box_layout_name(lam.cap_tys[j])
        codegen_self.line("TYPE :ptr<${box}>")
        j = j + 1
      }
      codegen_self.indent = codegen_self.indent - 1
      codegen_self.line("ENDSTRUCT")
      codegen_self.blank
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) emit_param_stores(names: Array(String), types: Array(Ty), index_base: Int): Array(String) {
  raws: Array(String) = []
  i = 0
  while i < names.size {
    m = ty_myc(types[i])
    slot = index_base + i
    codegen_self.line("PARAM ${slot}")
    if codegen_self.name_is_boxed(names[i]) {
      tmp = codegen_self.new_temp
      codegen_self.line("LOCAL :${tmp} :${m}")
      codegen_self.line("STORE")
      raws.push(tmp)
    } else {
      codegen_self.line("LOCAL :${names[i]} :${m}")
      codegen_self.line("STORE")
      raws.push("")
    }
    i = i + 1
  }
  raws
}

pub fn (codegen_self: MycGen) emit_param_finish(names: Array(String), types: Array(Ty), raws: Array(String)) {
  i = 0
  while i < names.size {
    if codegen_self.name_is_boxed(names[i]) {
      codegen_self.ensure_root(raws[i], types[i])
      codegen_self.ensure_box(names[i], types[i])
      codegen_self.line("LOCAL :${raws[i]}")
      codegen_self.store_box_value(names[i], types[i])
    } else {
      codegen_self.ensure_root(names[i], types[i])
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) emit_param_group(names: Array(String), types: Array(Ty), index_base: Int) {
  raws = codegen_self.emit_param_stores(names, types, index_base)
  codegen_self.emit_param_finish(names, types, raws)
}

pub fn (codegen_self: MycGen) ensure_box(name: String, ty: Ty) {
  if v = codegen_self.box_ready.get(name) {
    return
  }
  box = box_layout_name(ty)
  id = codegen_self.closure_type_id(box)
  codegen_self.emit_alloc_sizeof(box, id)
  codegen_self.line("AS :ptr<${box}>")
  codegen_self.line("LOCAL :${name} :ptr<${box}>")
  codegen_self.line("STORE")
  codegen_self.emit_zero(ty)
  codegen_self.store_box_value(name, ty)
  codegen_self.emit_ptr_root(name)
  codegen_self.box_ready[name] = 1
}

pub fn (codegen_self: MycGen) store_box_value(name: String, ty: Ty) {
  box = box_layout_name(ty)
  codegen_self.line("LOCAL :${name} :ptr<${box}>")
  codegen_self.line("DEREF")
  codegen_self.line("FIELD 0")
  codegen_self.line("STORE")
}

pub fn (codegen_self: MycGen) emit_box_lvalue(name: String, ty: Ty) {
  box = box_layout_name(ty)
  codegen_self.line("LOCAL :${name} :ptr<${box}>")
  codegen_self.line("DEREF")
  codegen_self.line("FIELD 0")
}

pub fn (codegen_self: MycGen) emit_cap_lvalue(index: Int) {
  codegen_self.line("LOCAL :__env :ptr<${codegen_self.env_layout}>")
  codegen_self.line("DEREF")
  codegen_self.line("FIELD ${index}")
  codegen_self.line("DEREF")
  codegen_self.line("FIELD 0")
}

pub fn (codegen_self: MycGen) emit_box_pointer(name: String, ty: Ty) {
  ci = codegen_self.cap_index(name)
  if ci >= 0 {
    codegen_self.line("LOCAL :__env :ptr<${codegen_self.env_layout}>")
    codegen_self.line("DEREF")
    codegen_self.line("FIELD ${ci}")
    return
  }
  codegen_self.ensure_box(name, ty)
  box = box_layout_name(ty)
  codegen_self.line("LOCAL :${name} :ptr<${box}>")
}

pub fn (codegen_self: MycGen) emit_named_value(name: String) {
  ci = codegen_self.cap_index(name)
  if ci >= 0 {
    codegen_self.emit_cap_lvalue(ci)
    return
  }
  if codegen_self.name_is_boxed(name) {
    codegen_self.line("LOCAL :${name}")
    codegen_self.line("DEREF")
    codegen_self.line("FIELD 0")
    return
  }
  codegen_self.line("LOCAL :${name}")
}

pub fn (codegen_self: MycGen) emit_fn_value(code_sym: String, fty: Ty, hold: String) {
  code = fn_code_myc(fty)
  layout = fn_layout_name(fty)
  // CREATE stores field 0 from the top of the stack. Push the code word, then the env.
  codegen_self.line("ADDR :${code_sym}")
  codegen_self.line("AS \"${code}\"")
  if hold.size == 0 {
    codegen_self.line("PUSH 0")
    codegen_self.line("AS :ptr<void>")
  } else {
    codegen_self.line("LOCAL :${hold}")
    codegen_self.line("AS :ptr<void>")
  }
  codegen_self.line("CREATE :${layout}")
}

pub fn (codegen_self: MycGen) emit_fn_ref(expr: Expr) {
  tramp = "__fn_${expr.resolved}"
  codegen_self.emit_fn_value(tramp, expr_ty(expr), "")
}

pub fn (codegen_self: MycGen) emit_lambda(expr: Expr) {
  fty = expr_ty(expr)
  if expr.cap_names.size == 0 {
    codegen_self.emit_fn_value(expr.resolved, fty, "")
    return
  }
  env = "${expr.resolved}_env"
  id = codegen_self.closure_type_id(env)
  codegen_self.emit_alloc_sizeof(env, id)
  codegen_self.line("AS :ptr<${env}>")
  hold = codegen_self.new_temp
  codegen_self.line("LOCAL :${hold} :ptr<${env}>")
  codegen_self.line("STORE")
  codegen_self.emit_ptr_root(hold)
  i = 0
  while i < expr.cap_names.size {
    codegen_self.emit_box_pointer(expr.cap_names[i], expr.cap_tys[i])
    codegen_self.line("LOCAL :${hold}")
    codegen_self.line("DEREF")
    codegen_self.line("FIELD ${i}")
    codegen_self.line("STORE")
    i = i + 1
  }
  codegen_self.emit_fn_value(expr.resolved, fty, hold)
}

pub fn (codegen_self: MycGen) emit_indirect(expr: Expr) {
  layout = expr.resolved
  if inner = expr.inner {
    codegen_self.emit_expr(inner)
    layout = ty_myc(expr_ty(inner))
  } else {
    codegen_self.emit_named_value(expr.callee)
  }
  tmp = codegen_self.new_temp
  codegen_self.line("LOCAL :${tmp} :${layout}")
  codegen_self.line("STORE")
  codegen_self.emit_ptr_root(tmp)
  codegen_self.emit_typed_args(expr.args, expr.cap_tys)
  codegen_self.line("LOCAL :${tmp}")
  codegen_self.line("FIELD 0")
  codegen_self.line("LOCAL :${tmp}")
  codegen_self.line("FIELD 1")
  codegen_self.line("INVOKE")
}

pub fn (codegen_self: MycGen) emit_body_fallthrough(body: Array(Stmt)) {
  if body.size == 0 {
    codegen_self.emit_ret
    return
  }
  last = body[body.size - 1]
  if last.kind == st_return() {
    return
  }
  if last.kind == st_expr() {
    if codegen_self.return_type.is_void {
    } else {
      return
    }
  }
  codegen_self.emit_ret
}

pub fn (codegen_self: MycGen) emit_lambda_thunk(expr: Expr) {
  saved_indent = codegen_self.indent
  saved_temps = codegen_self.temps
  saved_ret = codegen_self.return_type
  saved_main = codegen_self.c_main
  saved_rooted = codegen_self.rooted
  saved_self = codegen_self.self_ty
  saved_self_name = codegen_self.self_name
  saved_guard = codegen_self.quiet_guard
  codegen_self.indent = 0
  codegen_self.temps = 0
  codegen_self.c_main = false
  codegen_self.self_ty = nil
  codegen_self.self_name = ""
  codegen_self.quiet_guard = 0
  codegen_self.in_lambda = true
  codegen_self.env_layout = ""
  if expr.cap_names.size > 0 {
    codegen_self.env_layout = "${expr.resolved}_env"
  }
  caps: Array(String) = []
  ctys: Array(Ty) = []
  i = 0
  while i < expr.cap_names.size {
    caps.push(expr.cap_names[i])
    ctys.push(expr.cap_tys[i])
    i = i + 1
  }
  codegen_self.cap_list = caps
  codegen_self.cap_tys_now = ctys
  boxes: Array(String) = []
  i = 0
  while i < expr.box_names.size {
    boxes.push(expr.box_names[i])
    i = i + 1
  }
  codegen_self.box_list = boxes
  ready = Hash(String, Int).new
  codegen_self.box_ready = ready
  fty = expr_ty(expr)
  ret = ty_void()
  if r = fty.inner {
    ret = r
  }
  codegen_self.return_type = ret
  name = expr.resolved
  codegen_self.line("FUNC :${name}")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("ARGS")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("TYPE :ptr<void>")
  i = 0
  while i < fty.members.size {
    m = ty_myc(fty.members[i])
    codegen_self.line("TYPE :${m}")
    i = i + 1
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.emit_return_header
  codegen_self.line("BODY")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.reset_rooted
  codegen_self.line("CALL :avant_gc_enter")
  codegen_self.line("PARAM 0")
  if expr.cap_names.size == 0 {
    codegen_self.line("STACK :drop")
  } else {
    codegen_self.line("AS :ptr<${codegen_self.env_layout}>")
    codegen_self.line("LOCAL :__env :ptr<${codegen_self.env_layout}>")
    codegen_self.line("STORE")
    codegen_self.emit_ptr_root("__env")
  }
  if b = expr.block {
    ptys: Array(Ty) = []
    i = 0
    while i < b.params.size {
      if i < fty.members.size {
        ptys.push(fty.members[i])
      } else {
        ptys.push(ty_void())
      }
      i = i + 1
    }
    codegen_self.emit_param_group(b.params, ptys, 1)
    codegen_self.emit_stmts(b.body, true)
    codegen_self.emit_body_fallthrough(b.body)
  } else {
    codegen_self.emit_ret
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDFUNC")
  codegen_self.blank
  codegen_self.indent = saved_indent
  codegen_self.temps = saved_temps
  codegen_self.return_type = saved_ret
  codegen_self.c_main = saved_main
  codegen_self.rooted = saved_rooted
  codegen_self.self_ty = saved_self
  codegen_self.self_name = saved_self_name
  codegen_self.quiet_guard = saved_guard
  codegen_self.in_lambda = false
}

pub fn (codegen_self: MycGen) emit_fn_trampoline(fnn: Function) {
  if sig = codegen_self.find_fn(fnn.emit_name) {
    name = "__fn_${fnn.emit_name}"
    saved_ret = codegen_self.return_type
    saved_main = codegen_self.c_main
    codegen_self.c_main = false
    codegen_self.return_type = sig.ret
    codegen_self.line("FUNC :${name}")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("ARGS")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("TYPE :ptr<void>")
    i = 0
    while i < sig.params.size {
      m = ty_myc(sig.params[i])
      codegen_self.line("TYPE :${m}")
      i = i + 1
    }
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.emit_return_header
    codegen_self.line("BODY")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("PARAM 0")
    codegen_self.line("STACK :drop")
    i = sig.params.size - 1
    while i >= 0 {
      slot = i + 1
      codegen_self.line("PARAM ${slot}")
      i = i - 1
    }
    codegen_self.line("CALL :${fnn.emit_name}")
    codegen_self.line("RET")
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.indent = codegen_self.indent - 1
    codegen_self.line("ENDFUNC")
    codegen_self.blank
    codegen_self.return_type = saved_ret
    codegen_self.c_main = saved_main
  }
}

pub fn (codegen_self: MycGen) emit_puts(arg: Expr) {
  codegen_self.emit_expr(arg)
  ty = expr_ty(arg)
  if ty.is_int {
    codegen_self.line("PUSH \"%d\\n\"")
    codegen_self.line("PRINTF 1")
    return
  }
  if ty.is_int64 {
    codegen_self.line("PUSH \"%lld\\n\"")
    codegen_self.line("PRINTF 1")
    return
  }
  if ty.is_uint64 {
    codegen_self.line("PUSH \"%llu\\n\"")
    codegen_self.line("PRINTF 1")
    return
  }
  if ty.is_string {
    codegen_self.line("PUSH \"%s\\n\"")
    codegen_self.line("PRINTF 1")
    return
  }
  if ty.is_float {
    codegen_self.line("PUSH \"%g\\n\"")
    codegen_self.line("PRINTF 1")
    return
  }
  if ty.is_bool {
    codegen_self.line("AS :i32")
    codegen_self.line("PUSH \"%d\\n\"")
    codegen_self.line("PRINTF 1")
  }
}
