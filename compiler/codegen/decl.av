  codegen_self.line("GLOBAL :g_avant_shared")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("TYPE :i32")
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDGLOBAL")
  codegen_self.ext("avant_gc_reload", "ptr<void>", "ptr<void>")
  codegen_self.ext("avant_type_map", "u32,u64", "")
  codegen_self.ext("avant_barrier", "ptr<void>", "")
