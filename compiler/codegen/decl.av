pub fn (codegen_self: MycGen) find_fn(name: String): FuncSig? {
  if id = codegen_self.fn_index.get(name) {
    return codegen_self.functions[id]
  }
  nil
}

pub fn (codegen_self: MycGen) has_fn(name: String): Bool {
  if id = codegen_self.fn_index.get(name) {
    return true
  }
  false
}

pub fn (codegen_self: MycGen) ext(name: String, args_s: String, ret: String) {
  codegen_self.line("FUNC :${name}")
  codegen_self.indent = codegen_self.indent + 1
  if ret.size > 0 {
    codegen_self.line("RETURN")
    codegen_self.indent = codegen_self.indent + 1
    codegen_self.line("TYPE :${ret}")
    codegen_self.indent = codegen_self.indent - 1
  }
  args = split_comma(args_s)
  if args.size > 0 {
    codegen_self.line("ARGS")
    codegen_self.indent = codegen_self.indent + 1
    i = 0
    while i < args.size {
      a = args[i]
      codegen_self.line("TYPE :${a}")
      i = i + 1
    }
    codegen_self.indent = codegen_self.indent - 1
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDFUNC")
  codegen_self.blank
}

pub fn (codegen_self: MycGen) emit_runtime_decl {
  // Declaring avant_gc_root is what myc-llvm keys off, via --gc-root from
  // pipeline.av. The copying-nursery contract is avant-ledgers/stages/safepoints.md.
  codegen_self.ext("avant_alloc", "u64,u32", "ptr<void>")
  codegen_self.ext("avant_bump_alloc", "u64,u32", "ptr<void>")
  codegen_self.ext("avant_nursery_reclaim", "", "")
