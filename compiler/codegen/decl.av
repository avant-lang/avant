pub fn (codegen_self: MycGen) emit_lib_decls {
  i = 0
  while i < codegen_self.program.libs.size {
    lib_def = codegen_self.program.libs[i]
    j = 0
    while j < lib_def.funs.size {
      codegen_self.emit_lib_fun(lib_def.name, lib_def.funs[j])
      j = j + 1
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) emit_lib_fun(lib_name: String, fnn: FunDecl) {
  params: Array(Ty) = []
  ret = ty_void()
  shared = false
  if s = codegen_self.symbols {
    if csig = s.find_cfun(lib_name, fnn.name) {
      params = csig.params
      ret = csig.ret
      shared = true
    }
  }
  if shared {
  } else {
    i = 0
    while i < fnn.params.size {
      params.push(codegen_self.resolver.resolve_value(fnn.params[i].type))
      i = i + 1
    }
    if t = fnn.return_type {
      ret = codegen_self.resolver.resolve(t)
    }
  }
  codegen_self.line("FUNC :${fnn.name}")
  codegen_self.indent = codegen_self.indent + 1
  if ret.is_void {
  } else {
    codegen_self.line("RETURN")
    codegen_self.indent = codegen_self.indent + 1
    m = ty_myc(ret)
    codegen_self.line("TYPE :${m}")
    codegen_self.indent = codegen_self.indent - 1
  }
  if params.size > 0 {
    codegen_self.line("ARGS")
    codegen_self.indent = codegen_self.indent + 1
    i = 0
    while i < params.size {
      if params[i].is_fn {
        codegen_self.line("TYPE :ptr<void>")
      } else {
        m = ty_myc(params[i])
        codegen_self.line("TYPE :${m}")
      }
      i = i + 1
    }
    codegen_self.indent = codegen_self.indent - 1
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDFUNC")
  codegen_self.blank
}

pub fn (codegen_self: MycGen) collect_sigs {
  i = 0
  while i < codegen_self.program.functions.size {
    fnn = codegen_self.program.functions[i]
    if fn_is_method(fnn) {
    } else {
      if fnn.generic {
      } else {
        params: Array(Ty) = []
        j = 0
        while j < fnn.params.size {
          params.push(codegen_self.resolver.resolve_value(fnn.params[j].type))
          j = j + 1
        }
        ret = ty_void()
        if t = fnn.return_type {
          ret = codegen_self.resolver.resolve(t)
        }
        sig = FuncSig.new(fnn.name, fnn, params, ret)
        codegen_self.functions.push(sig)
        codegen_self.fn_index[fnn.emit_name] = codegen_self.functions.size - 1
      }
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) collect_methods {
  fns = program_all_functions(codegen_self.program)
  i = 0
  while i < fns.size {
    fnn = fns[i]
    if fn_is_method(fnn) {
      if fnn.generic {
      } else if codegen_self.owner_is_template(fnn.owner) {
      } else {
        owner = fnn.owner
        if owner.size == 0 {
          if r = fnn.receiver {
            ty = codegen_self.resolver.resolve(r.type)
            owner = ty.name
            fnn.owner = owner
          }
        }
        params: Array(Ty) = []
        j = 0
        while j < fnn.params.size {
          params.push(codegen_self.resolver.resolve_value(fnn.params[j].type))
          j = j + 1
        }
        ret = ty_void()
        if t = fnn.return_type {
          ret = codegen_self.resolver.resolve(t)
        }
        sig = FuncSig.new(fnn.name, fnn, params, ret)
        sig.owner = owner
        codegen_self.methods.push(sig)
        codegen_self.method_index[fnn.emit_name] = codegen_self.methods.size - 1
      }
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) assign_class_ids {
  n = 1
  i = 0
  while i < codegen_self.program.classes.size {
    cdef = codegen_self.program.classes[i]
    if cdef.type_params.size > 0 {
    } else {
      key = cdef.name
      if flag = codegen_self.resolver.collide.get(cdef.name) {
        key = "${mod_emit_prefix(cdef.mod_name)}__${cdef.name}"
      }
      codegen_self.class_ids[key] = n
      n = n + 1
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) find_method(owner: String, name: String): FuncSig? {
  key = "${owner}__${name}"
  if id = codegen_self.method_index.get(key) {
    return codegen_self.methods[id]
  }
  nil
}

pub fn (codegen_self: MycGen) find_method_emit(emit: String): FuncSig? {
  if id = codegen_self.method_index.get(emit) {
    return codegen_self.methods[id]
  }
  nil
}

pub fn (codegen_self: MycGen) class_id_key(ty: Ty): String {
  if ty.emit_base.size > 0 {
    return ty.emit_base
  }
  ty.name
}

pub fn (codegen_self: MycGen) class_id_key_of(mod_name: String, name: String): String {
  if flag = codegen_self.resolver.collide.get(name) {
    return "${mod_emit_prefix(mod_name)}__${name}"
  }
  name
}

pub fn (codegen_self: MycGen) find_initialize(owner: String, owner_mod: String): FuncSig? {
  i = 0
  while i < codegen_self.methods.size {
    sig = codegen_self.methods[i]
    if str_eq(sig.owner, owner) {
      if str_eq(sig.name, "initialize") {
        if owner_mod.size == 0 {
          return sig
        }
        if str_eq(sig.node.owner_mod, owner_mod) {
          return sig
        }
        if sig.node.owner_mod.size == 0 {
          return sig
        }
      }
    }
    i = i + 1
  }
  nil
}

pub fn (codegen_self: MycGen) note_ty(ty: Ty) {
  if ty.is_fn {
    layout = fn_layout_name(ty)
    i = 0
    while i < codegen_self.fn_tys.size {
      if str_eq(fn_layout_name(codegen_self.fn_tys[i]), layout) {
        return
      }
      i = i + 1
    }
    codegen_self.fn_tys.push(ty)
    i = 0
    while i < ty.members.size {
      codegen_self.note_ty(ty.members[i])
      i = i + 1
    }
    if r = ty.inner {
      codegen_self.note_ty(r)
    }
    return
  }
  if ty.is_array {
    layout = ty_layout_myc(ty)
    i = 0
    while i < codegen_self.array_tys.size {
      if str_eq(ty_layout_myc(codegen_self.array_tys[i]), layout) {
        return
      }
      i = i + 1
    }
    codegen_self.array_tys.push(ty)
    if e = ty.inner {
      codegen_self.note_ty(e)
    }
    return
  }
  if ty.is_union {
    layout = ty_layout_myc(ty)
    seen = false
    i = 0
    while i < codegen_self.union_tys.size {
      if str_eq(ty_layout_myc(codegen_self.union_tys[i]), layout) {
        seen = true
      }
      i = i + 1
    }
    if seen {
    } else {
      codegen_self.union_tys.push(ty)
    }
    i = 0
    while i < ty.members.size {
      codegen_self.note_ty(ty.members[i])
      i = i + 1
    }
  }
}

pub fn (codegen_self: MycGen) collect_arrays {
  i = 0
  while i < codegen_self.functions.size {
    sig = codegen_self.functions[i]
    j = 0
    while j < sig.params.size {
      codegen_self.note_ty(sig.params[j])
      j = j + 1
    }
    codegen_self.note_ty(sig.ret)
    i = i + 1
  }
  i = 0
  while i < codegen_self.methods.size {
    sig = codegen_self.methods[i]
    j = 0
    while j < sig.params.size {
      codegen_self.note_ty(sig.params[j])
      j = j + 1
    }
    codegen_self.note_ty(sig.ret)
    i = i + 1
  }
  i = 0
  while i < codegen_self.program.structs.size {
    sdef = codegen_self.program.structs[i]
    if ty = codegen_self.resolver.get_named_for(sdef.mod_name, sdef.name) {
      j = 0
      while j < ty.fields.size {
        codegen_self.note_ty(ty.fields[j].ty)
        j = j + 1
      }
    }
    i = i + 1
  }
  i = 0
  while i < codegen_self.program.classes.size {
    cdef = codegen_self.program.classes[i]
    if ty = codegen_self.resolver.get_named_for(cdef.mod_name, cdef.name) {
      j = 0
      while j < ty.fields.size {
        codegen_self.note_ty(ty.fields[j].ty)
        j = j + 1
      }
    }
    i = i + 1
  }
  fns = program_all_functions(codegen_self.program)
  i = 0
  while i < fns.size {
    if fns[i].generic {
    } else {
      codegen_self.collect_stmts(fns[i].body)
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) collect_stmts(body: Array(Stmt)) {
  i = 0
  while i < body.size {
    stmt = body[i]
    k = stmt.kind
    if k == st_if() {
      if c = stmt.cond {
        codegen_self.collect_expr(c)
      }
      codegen_self.collect_stmts(stmt.then_body)
      codegen_self.collect_stmts(stmt.else_body)
    } else if k == st_while() {
      codegen_self.collect_stmts(stmt.pre)
      if c = stmt.cond {
        codegen_self.collect_expr(c)
      }
      codegen_self.collect_stmts(stmt.body)
    } else if k == st_pin() {
      if e = stmt.expr {
        codegen_self.collect_expr(e)
      }
      codegen_self.collect_stmts(stmt.body)
    } else if k == st_assign() {
      if t = stmt.target {
        codegen_self.collect_expr(t)
      }
      if v = stmt.value {
        codegen_self.collect_expr(v)
      }
    } else if k == st_expr() {
      if e = stmt.expr {
        codegen_self.collect_expr(e)
      }
    } else if k == st_return() {
      if e = stmt.expr {
        codegen_self.collect_expr(e)
      }
    }
    i = i + 1
  }
}

pub fn (codegen_self: MycGen) collect_expr(expr: Expr) {
  codegen_self.note_ty(expr_ty(expr))
  k = expr.kind
  if k == ex_call() {
    if inner = expr.inner {
      codegen_self.collect_expr(inner)
    }
    if recv = expr.receiver {
      codegen_self.collect_expr(recv)
      if str_eq(expr.callee, "each") {
        rt = expr_ty(recv)
        if rt.is_hash {
          if kk = rt.key {
            codegen_self.note_ty(ty_array(kk))
          }
          if vv = rt.val {
            codegen_self.note_ty(ty_nilable(vv))
          }
        }
      }
      if str_eq(expr.callee, "parallel") {
        n = codegen_self.spawn_id
        expr.spawn_thunk = "__par_${n}"
        codegen_self.spawn_id = n + 1
        codegen_self.pending.push(expr)
        codegen_self.need_parallel = 1
        words: Array(Ty) = []
        words.push(expr_ty(recv))
        words.push(expr_ty(expr))
        wi = 0
        while wi < expr.cap_tys.size {
          words.push(expr.cap_tys[wi])
          wi = wi + 1
        }
        codegen_self.note_words("${expr.spawn_thunk}_cap", words)
      }
      if str_eq(expr.callee, "with") {
        if str_eq(expr_ty(recv).origin, "Mutex") {
          codegen_self.need_gate = 1
        }
      }
    } else {
      if str_eq(expr.callee, "spawn") {
        if b = expr.block {
          n = codegen_self.spawn_id
          expr.spawn_thunk = "__spawn_${n}"
          codegen_self.spawn_id = n + 1
          codegen_self.pending.push(expr)
          if expr.cap_names.size > 0 {
            codegen_self.note_words("${expr.spawn_thunk}_cap", expr.cap_tys)
          }
        }
      }
      if codegen_self.is_gate_callee(expr.callee) {
        codegen_self.need_gate = 1
      }
    }
    i = 0
    while i < expr.args.size {
      codegen_self.collect_expr(expr.args[i])
      i = i + 1
    }
    if b = expr.block {
      codegen_self.collect_stmts(b.body)
    }
    return
  }
  if k == ex_unary() {
    if inner = expr.inner {
      codegen_self.collect_expr(inner)
    }
    return
  }
  if k == ex_binary() {
    if l = expr.left {
      codegen_self.collect_expr(l)
    }
    if r = expr.right {
      codegen_self.collect_expr(r)
    }
    return
  }
  if k == ex_field() {
    if obj = expr.object {
      codegen_self.collect_expr(obj)
    }
    return
  }
  if k == ex_index() {
    if l = expr.left {
      codegen_self.collect_expr(l)
    }
    if r = expr.right {
      codegen_self.collect_expr(r)
    }
    return
  }
  if k == ex_struct() {
    i = 0
    while i < expr.field_exprs.size {
      codegen_self.collect_expr(expr.field_exprs[i])
      i = i + 1
    }
    return
  }
  if k == ex_array() {
    i = 0
    while i < expr.elems.size {
      codegen_self.collect_expr(expr.elems[i])
      i = i + 1
    }
    return
  }
  if k == ex_array_new() {
    if size = expr.size_expr {
      codegen_self.collect_expr(size)
    }
    return
  }
  if k == ex_try() {
    if inner = expr.inner {
      codegen_self.collect_expr(inner)
    }
    return
  }
  if k == ex_interp() {
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      if inner = part.expr {
        codegen_self.collect_expr(inner)
      }
      i = i + 1
    }
    return
  }
  if k == ex_lambda() {
    codegen_self.collect_lambda(expr)
    return
  }
  if k == ex_switch() {
    if c = expr.cond {
      codegen_self.collect_expr(c)
    }
    i = 0
    while i < expr.cases.size {
      codegen_self.collect_stmts(expr.cases[i].body)
      i = i + 1
    }
    if expr.has_else {
      codegen_self.collect_stmts(expr.else_body)
    }
  }
}

pub fn (codegen_self: MycGen) emit_layout(ty: Ty) {
  name = ty_layout_myc(ty)
  codegen_self.line("STRUCT :${name}")
  codegen_self.indent = codegen_self.indent + 1
  i = 0
  while i < ty.fields.size {
    m = ty_myc(ty.fields[i].ty)
    codegen_self.line("TYPE :${m}")
    i = i + 1
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDSTRUCT")
  codegen_self.blank
}

pub fn (codegen_self: MycGen) emit_array_def(ty: Ty) {
  name = ty_layout_myc(ty)
  codegen_self.line("STRUCT :${name}")
  codegen_self.indent = codegen_self.indent + 1
  if e = ty.inner {
    em = ty_myc(e)
    codegen_self.line("TYPE :ptr<${em}>")
  }
  codegen_self.line("TYPE :i32")
  codegen_self.line("TYPE :i32")
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDSTRUCT")
  codegen_self.blank
}

pub fn (codegen_self: MycGen) emit_union_def(ty: Ty) {
  name = ty_layout_myc(ty)
  codegen_self.line("STRUCT :${name}")
  codegen_self.indent = codegen_self.indent + 1
  codegen_self.line("TYPE :i32")
  payloads = ty.payload_members
  i = 0
  while i < payloads.size {
    m = ty_myc(payloads[i])
    codegen_self.line("TYPE :${m}")
    i = i + 1
  }
  codegen_self.indent = codegen_self.indent - 1
  codegen_self.line("ENDSTRUCT")
  codegen_self.blank
}
