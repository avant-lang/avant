pub fn ex_array_new: Int { 13 }
pub fn ex_hash_new: Int { 14 }
pub fn ex_nil: Int { 15 }
pub fn ex_try: Int { 16 }
pub fn ex_interp: Int { 17 }
// A switch node (`switch c { case ... else ... }`) also holds the two
// forms whose value comes from statements (Stage 29 W4a), so every walker
// visits them as it visits a switch: op tk_return, the right side of
// `x ?? return v` / `?? break` / `?? continue` (else_body is that one
// statement; cond is nil, no cases); op tk_if, an `if` used as a value
// (else_body is the if statement, which has an else).
pub fn ex_switch: Int { 18 }
pub fn ex_splice: Int { 19 }
pub fn ex_lambda: Int { 20 }

pub fn st_expr: Int { 1 }
pub fn st_return: Int { 2 }
pub fn st_if: Int { 3 }
pub fn st_while: Int { 4 }
pub fn st_break: Int { 5 }
pub fn st_continue: Int { 6 }
pub fn st_assign: Int { 7 }
pub fn st_quote: Int { 8 }
pub fn st_pin: Int { 9 }
pub fn st_release: Int { 10 }
// `gc.hold { body }` (std.gc, Stage 29 W1c2, D305): body only.
pub fn st_hold: Int { 11 }

pub class TypeName {
  pub loc: Location
  pub name: String = ""
  pub args: Array(TypeName) = []
  pub nilable: Bool = false
  // The name was resolved where it was written and stands for that type
  // wherever it is read again (O255, Stage 29 W-FIX1b): a generic type's
  // or function's instance carries its type arguments this way, with the
  // module of each in mod_name, so a type of the module that uses the
  // generic is known inside the generic's own module. The checker skips
  // its visibility rules for a pinned name. It shares `nilable`'s word.
  pub pinned: Bool = false
  pub members: Array(TypeName) = []
  pub mod_name: String = ""
  pub splice: Expr? = nil
  pub fn_type: Bool = false
  pub ret: TypeName? = nil
  pub bounds: Array(TypeName) = []

  fn initialize(loc: Location, name: String) {
    self.loc = loc
    self.name = name
  }
}

pub class TypeBound {
  pub param: String = ""
  pub iface: TypeName

  fn initialize(param: String, iface: TypeName) {
    self.param = param
    self.iface = iface
  }
}

pub class Param {
  pub loc: Location
  pub name: String = ""
  pub type: TypeName
  pub default: Expr? = nil

  fn initialize(loc: Location, name: String, type: TypeName) {
    self.loc = loc
    self.name = name
    self.type = type
  }
}

pub class InterpPart {
  pub text: String? = nil
  pub expr: Expr? = nil

  fn initialize {
  }
}

