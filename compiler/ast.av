    self.loc = loc
  }
}

pub class Expr {
  pub kind: Int = 0
  pub loc: Location
  pub ident: String = ""
  pub callee: String = ""
  pub value_str: String = ""
  pub int_bits: UInt64 = 0u64
  pub int_suffix: String = ""
  pub float_val: Float64 = 0.0
  pub bool_val: Bool = false
  pub op: Int = 0
  pub implicit_field: Bool = false
  pub method_call: Bool = false
  pub proven: Bool = false
  pub type_name: String = ""
  pub lib_name: String = ""
  pub has_else: Bool = false
  pub left: Expr? = nil
  pub right: Expr? = nil
  pub object: Expr? = nil
  pub cond: Expr? = nil
  pub receiver: Expr? = nil
  pub inner: Expr? = nil
  pub size_expr: Expr? = nil
  pub args: Array(Expr) = []
  pub elems: Array(Expr) = []
  pub field_names: Array(String) = []
  pub field_exprs: Array(Expr) = []
  pub parts: Array(InterpPart) = []
  pub cases: Array(SwitchCase) = []
  pub else_body: Array(Stmt) = []
  pub block: Block? = nil
  pub elem_type: TypeName? = nil
  pub key_type: TypeName? = nil
  pub val_type: TypeName? = nil
  pub type_args: Array(TypeName) = []
  pub ty: Ty? = nil
  pub spawn_thunk: String = ""
  pub resolved: String = ""
  pub cap_names: Array(String) = []
  pub cap_tys: Array(Ty) = []
  pub box_names: Array(String) = []
  pub indirect: Bool = false
  pub type_call: Bool = false
  pub fn_ref: Bool = false
  vis: Bool = false
  // A parameter default spliced into a call as an argument
  // (checker/match.av fill_defaults): a call checked again drops it and
  // splices anew, so a default is never taken for an argument the caller
  // wrote. This flag and the next share the four flags' word: the node's
  // size is unchanged.
  pub is_default: Bool = false
  pub mod_name: String = ""
  pub splice: Expr? = nil

  fn initialize(kind: Int, loc: Location) {
    self.kind = kind
    self.loc = loc
  }
}

pub class Stmt {
  pub kind: Int = 0
  pub proven: Bool = false
  pub vstep: Int = -1
  pub vle: Bool = false
  pub vcoff: Int = 0
  pub vstart: Int = 0
  pub loc: Location
  pub expr: Expr? = nil
  pub value: Expr? = nil
  pub target: Expr? = nil
  pub cond: Expr? = nil
  pub bind: String = ""
  pub op: Int = 0
  pub then_body: Array(Stmt) = []
  pub else_body: Array(Stmt) = []
  pub body: Array(Stmt) = []
  pub pre: Array(Stmt) = []
  pub for_kind: Int = 0
  pub declared: TypeName? = nil
  pub lead: Int = 0
  // An `if` with an else at a function's tail whose branches end in
  // values (Stage 29 W4a, D31): the checker sets it, and the function's
  // value is the branch's (mir lower_body).
  pub tail_value: Bool = false

  fn initialize(kind: Int, loc: Location) {
    self.kind = kind
    self.loc = loc
  }
}

pub class Field {
  pub loc: Location
  pub name: String = ""
  pub type: TypeName
  pub default: Expr? = nil
  // `pub` (Stage 29 W3a, D299): visible outside the type's module.
  pub vis: Bool = false
  // Stage 29 W3b (D292): initialize sets this field on every path before
  // anything can read it (checker/init.av), so the constructor does not
  // store its zero first.
  pub set_by_init: Bool = false

  fn initialize(loc: Location, name: String, type: TypeName) {
    self.loc = loc
    self.name = name
    self.type = type
  }
}

