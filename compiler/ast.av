pub fn stmt_expr(loc: Location, expr: Expr): Stmt {
  s = Stmt.new(st_expr(), loc)
  s.expr = expr
  s
}

pub fn stmt_return(loc: Location, expr: Expr?): Stmt {
  s = Stmt.new(st_return(), loc)
  s.expr = expr
  s
}

pub fn stmt_return_void(loc: Location): Stmt {
  Stmt.new(st_return(), loc)
}

pub fn stmt_return_val(loc: Location, expr: Expr): Stmt {
  s = Stmt.new(st_return(), loc)
  s.expr = expr
  s
}

pub fn stmt_quote(loc: Location, body: Array(Stmt)): Stmt {
  s = Stmt.new(st_quote(), loc)
  s.body = body
  s
}

pub fn program_all_functions(program: Program): Array(Function) {
  out: Array(Function) = []
  for function in program.functions {
    out.push(function)
  }
  for sdef in program.structs {
    for method in sdef.methods {
      out.push(method)
    }
  }
  for cdef in program.classes {
    for method in cdef.methods {
      out.push(method)
    }
  }
  out
}

pub fn fn_is_method(fnn: Function): Bool {
  if r = fnn.receiver {
    return true
  }
  fnn.owner.size > 0
}

pub fn fn_self_name(fnn: Function): String {
  if r = fnn.receiver {
    return r.name
  }
  "self"
}

pub fn clone_type_name(tn: TypeName): TypeName {
  out = TypeName.new(tn.loc, tn.name)
  out.nilable = tn.nilable
  out.pinned = tn.pinned
  out.mod_name = tn.mod_name
  out.fn_type = tn.fn_type
  if sp = tn.splice {
    out.splice = clone_expr(sp)
  }
  if r = tn.ret {
    out.ret = clone_type_name(r)
  }
  i = 0
  while i < tn.args.size {
    out.args.push(clone_type_name(tn.args[i]))
    i += 1
  }
  i = 0
  while i < tn.members.size {
    out.members.push(clone_type_name(tn.members[i]))
    i += 1
  }
  i = 0
  while i < tn.bounds.size {
    out.bounds.push(clone_type_name(tn.bounds[i]))
    i += 1
  }
  out
}

// Whether a type name holds a pinned part: it belongs to an instance of
// a generic, and names a type argument where the generic was used.
pub fn type_name_has_pinned(tn: TypeName): Bool {
  if tn.pinned {
    return true
  }
  for a in tn.args {
    if type_name_has_pinned(a) {
      return true
    }
  }
  for m in tn.members {
    if type_name_has_pinned(m) {
      return true
    }
  }
  if r = tn.ret {
    return type_name_has_pinned(r)
  }
  false
}

pub fn subst_type_name(tn: TypeName, from: Array(String), to: Array(TypeName)): TypeName {
  if tn.fn_type {
    out = TypeName.new(tn.loc, "")
    out.fn_type = true
    out.nilable = tn.nilable
    i = 0
    while i < tn.args.size {
      out.args.push(subst_type_name(tn.args[i], from, to))
      i += 1
    }
    if r = tn.ret {
      out.ret = subst_type_name(r, from, to)
    }
    i = 0
    while i < tn.bounds.size {
      out.bounds.push(subst_type_name(tn.bounds[i], from, to))
      i += 1
    }
    return out
  }
  if tn.members.size > 0 {
    out = TypeName.new(tn.loc, "")
    out.nilable = tn.nilable
    i = 0
    while i < tn.members.size {
      out.members.push(subst_type_name(tn.members[i], from, to))
      i += 1
    }
    i = 0
    while i < tn.bounds.size {
      out.bounds.push(subst_type_name(tn.bounds[i], from, to))
      i += 1
    }
    return out
  }
  if tn.args.size == 0 {
    i = 0
    while i < from.size {
      if tn.name == from[i] {
        rep = clone_type_name(to[i])
        bi = 0
        while bi < tn.bounds.size {
          rep.bounds.push(subst_type_name(tn.bounds[bi], from, to))
          bi += 1
        }
        if tn.nilable && !rep.nilable {
          if rep.members.size > 0 {
            wrapped = TypeName.new(tn.loc, "")
            wrapped.members.push(rep)
            wrapped.nilable = true
            return wrapped
          }
          rep.nilable = true
        }
        return rep
      }
      i += 1
    }
  }
  out = TypeName.new(tn.loc, tn.name)
  out.nilable = tn.nilable
  out.pinned = tn.pinned
  out.mod_name = tn.mod_name
  i = 0
  while i < tn.args.size {
    out.args.push(subst_type_name(tn.args[i], from, to))
    i += 1
  }
  i = 0
  while i < tn.bounds.size {
    out.bounds.push(subst_type_name(tn.bounds[i], from, to))
    i += 1
  }
  out
}

pub fn type_name_unbound_names(tn: TypeName, named: Hash(String, Int), into: Array(String)) {
  bi = 0
  while bi < tn.bounds.size {
    type_name_unbound_names(tn.bounds[bi], named, into)
    bi += 1
  }
  if tn.fn_type {
    i = 0
    while i < tn.args.size {
      type_name_unbound_names(tn.args[i], named, into)
      i += 1
    }
    if r = tn.ret {
      type_name_unbound_names(r, named, into)
    }
    return
  }
  if tn.members.size > 0 {
    i = 0
    while i < tn.members.size {
      type_name_unbound_names(tn.members[i], named, into)
      i += 1
    }
    return
  }
  if tn.name == "Ptr" {
    if tn.args.size == 1 {
      arg = tn.args[0]
      if arg.members.size == 0 && arg.args.size == 0 {
        return
      }
    }
  }
  i = 0
  while i < tn.args.size {
    type_name_unbound_names(tn.args[i], named, into)
    i += 1
  }
  if type_is_builtin(tn.name) {
    return
  }
  if id = named.get(tn.name) {
    return
  }
  if tn.args.size > 0 {
    return
  }
  if tn.name.size == 0 {
    return
  }
  // Only a single capital letter is an implicit type parameter (Stage 29
  // W3a, D298; D30 amended): any other unknown name stays a type and is
  // reported as unknown, with the nearest known name.
  if !is_type_param_name(tn.name) {
    return
  }
  for i in 0..into.size {
    if into[i] == tn.name {
      return
    }
  }
  into.push(tn.name)
}

pub fn is_type_param_name(name: String): Bool {
  name.size == 1 && name[0] >= 65 && name[0] <= 90
}

pub fn clone_param(p: Param): Param {
  out = Param.new(p.loc, p.name, clone_type_name(p.type))
  if d = p.default {
    out.default = clone_expr(d)
  }
  out
}

pub fn clone_interp_part(p: InterpPart): InterpPart {
  out = InterpPart.new()
  out.text = p.text
  if e = p.expr {
    out.expr = clone_expr(e)
  }
  out
}

pub fn clone_switch_case(c: SwitchCase): SwitchCase {
  out = SwitchCase.new(c.loc)
  i = 0
  while i < c.labels.size {
    out.labels.push(c.labels[i])
    i += 1
  }
  i = 0
  while i < c.body.size {
    out.body.push(clone_stmt(c.body[i]))
    i += 1
  }
  out
}

pub fn clone_block(b: Block): Block {
  out = Block.new(b.loc)
  i = 0
  while i < b.params.size {
    out.params.push(b.params[i])
    i += 1
  }
  i = 0
  while i < b.param_types.size {
    out.param_types.push(clone_type_name(b.param_types[i]))
    i += 1
  }
  i = 0
  while i < b.body.size {
    out.body.push(clone_stmt(b.body[i]))
    i += 1
  }
  out
}

// A checked call on a receiver that constructs (`T.new(...)`), rather
// than calling a method.
pub fn ast_is_ctor_call(e: Expr): Bool {
  e.callee == "new"
}

pub fn clone_expr(e: Expr): Expr {
  out = Expr.new(e.kind, e.loc)
  out.ident = e.ident
  out.callee = e.callee
  out.value_str = e.value_str
  out.int_bits = e.int_bits
  out.int_suffix = e.int_suffix
  out.float_val = e.float_val
  out.bool_val = e.bool_val
  out.op = e.op
  out.implicit_field = e.implicit_field
  out.method_call = e.method_call
  out.proven = e.proven
  out.type_name = e.type_name
  out.lib_name = e.lib_name
  out.has_else = e.has_else
  out.vis = e.vis
  out.mod_name = e.mod_name
  out.indirect = e.indirect
  out.type_call = e.type_call
  out.fn_ref = e.fn_ref
  out.is_default = e.is_default
  out.resolved = e.resolved
  out.spawn_thunk = e.spawn_thunk
  if sp = e.splice {
    out.splice = clone_expr(sp)
  }
  if x = e.left {
    out.left = clone_expr(x)
  }
  if x = e.right {
    out.right = clone_expr(x)
  }
  if x = e.object {
    out.object = clone_expr(x)
  }
  if x = e.cond {
    out.cond = clone_expr(x)
  }
  if x = e.receiver {
    out.receiver = clone_expr(x)
  }
  if x = e.inner {
    out.inner = clone_expr(x)
  }
  if x = e.size_expr {
    out.size_expr = clone_expr(x)
  }
  i = 0
  while i < e.args.size {
    out.args.push(clone_expr(e.args[i]))
    i += 1
  }
  i = 0
  while i < e.elems.size {
    out.elems.push(clone_expr(e.elems[i]))
    i += 1
  }
  i = 0
  while i < e.field_names.size {
    out.field_names.push(e.field_names[i])
    i += 1
  }
  i = 0
  while i < e.field_exprs.size {
    out.field_exprs.push(clone_expr(e.field_exprs[i]))
    i += 1
  }
  i = 0
  while i < e.parts.size {
    out.parts.push(clone_interp_part(e.parts[i]))
    i += 1
  }
  i = 0
  while i < e.cases.size {
    out.cases.push(clone_switch_case(e.cases[i]))
    i += 1
  }
  i = 0
  while i < e.else_body.size {
    out.else_body.push(clone_stmt(e.else_body[i]))
    i += 1
  }
  if b = e.block {
    out.block = clone_block(b)
  }
  i = 0
  while i < e.cap_names.size {
    out.cap_names.push(e.cap_names[i])
    i += 1
  }
  i = 0
  while i < e.cap_tys.size {
    out.cap_tys.push(e.cap_tys[i])
    i += 1
  }
  i = 0
  while i < e.box_names.size {
    out.box_names.push(e.box_names[i])
    i += 1
  }
  if t = e.elem_type {
    out.elem_type = clone_type_name(t)
  }
  if t = e.key_type {
    out.key_type = clone_type_name(t)
  }
  if t = e.val_type {
    out.val_type = clone_type_name(t)
  }
  i = 0
  while i < e.type_args.size {
    out.type_args.push(clone_type_name(e.type_args[i]))
    i += 1
  }
  out
}

pub fn clone_stmt(s: Stmt): Stmt {
  out = Stmt.new(s.kind, s.loc)
  out.bind = s.bind
  out.op = s.op
  if x = s.expr {
    out.expr = clone_expr(x)
  }
  if x = s.value {
    out.value = clone_expr(x)
  }
  if x = s.target {
    out.target = clone_expr(x)
  }
  if x = s.cond {
    out.cond = clone_expr(x)
  }
  i = 0
  while i < s.then_body.size {
    out.then_body.push(clone_stmt(s.then_body[i]))
    i += 1
  }
  i = 0
  while i < s.else_body.size {
    out.else_body.push(clone_stmt(s.else_body[i]))
    i += 1
  }
  i = 0
  while i < s.body.size {
    out.body.push(clone_stmt(s.body[i]))
    i += 1
  }
  // A `for` loop's set-up statements and kind (Stage 29 W1a): a generic
  // function's instance lost them, so `for x in xs` there named an
  // undeclared `__for0_i`.
  i = 0
  while i < s.pre.size {
    out.pre.push(clone_stmt(s.pre[i]))
    i += 1
  }
  out.for_kind = s.for_kind
  out.lead = s.lead
  if t = s.declared {
    out.declared = clone_type_name(t)
  }
  out
}

pub fn clone_function(fnn: Function): Function {
  out = Function.new(fnn.loc, fnn.name)
  out.owner = fnn.owner
  out.emit_name = fnn.emit_name
  if r = fnn.receiver {
    out.receiver = clone_param(r)
  }
  if t = fnn.return_type {
    out.return_type = clone_type_name(t)
  }
  i = 0
  while i < fnn.params.size {
    out.params.push(clone_param(fnn.params[i]))
    i += 1
  }
  i = 0
  while i < fnn.body.size {
    out.body.push(clone_stmt(fnn.body[i]))
    i += 1
  }
  i = 0
  while i < fnn.type_params.size {
    out.type_params.push(fnn.type_params[i])
    i += 1
  }
  for b in fnn.bounds {
    out.bounds.push(TypeBound.new(b.param, clone_type_name(b.iface)))
  }
  i = 0
  while i < fnn.inst_args.size {
    out.inst_args.push(fnn.inst_args[i])
    i += 1
  }
  out.generic = fnn.generic
  out.ol_index = fnn.ol_index
  out.vis = fnn.vis
  out.type_method = fnn.type_method
  out.mod_name = fnn.mod_name
  out.owner_mod = fnn.owner_mod
  out.as_value = fnn.as_value
  i = 0
  while i < fnn.box_names.size {
    out.box_names.push(fnn.box_names[i])
    i += 1
  }
  if sp = fnn.name_splice {
    out.name_splice = clone_expr(sp)
  }
  out
}

pub fn subst_type_in_expr(e: Expr, from: Array(String), to: Array(TypeName)) {
  if x = e.left {
    subst_type_in_expr(x, from, to)
  }
  if x = e.right {
    subst_type_in_expr(x, from, to)
  }
  if x = e.object {
    subst_type_in_expr(x, from, to)
  }
  if x = e.cond {
    subst_type_in_expr(x, from, to)
  }
  if x = e.receiver {
    subst_type_in_expr(x, from, to)
  }
  if x = e.inner {
    subst_type_in_expr(x, from, to)
  }
  if x = e.size_expr {
    subst_type_in_expr(x, from, to)
  }
  i = 0
  while i < e.args.size {
    subst_type_in_expr(e.args[i], from, to)
    i += 1
  }
  i = 0
  while i < e.elems.size {
    subst_type_in_expr(e.elems[i], from, to)
    i += 1
  }
  i = 0
  while i < e.field_exprs.size {
    subst_type_in_expr(e.field_exprs[i], from, to)
    i += 1
  }
  for p in e.parts {
    if inner = p.expr {
      subst_type_in_expr(inner, from, to)
    }
  }
  i = 0
  while i < e.cases.size {
    subst_type_in_stmts(e.cases[i].body, from, to)
    i += 1
  }
  subst_type_in_stmts(e.else_body, from, to)
  if b = e.block {
    subst_type_in_stmts(b.body, from, to)
    i = 0
    while i < b.param_types.size {
      b.param_types[i] = subst_type_name(b.param_types[i], from, to)
      i += 1
    }
  }
  if t = e.elem_type {
    e.elem_type = subst_type_name(t, from, to)
  }
  if t = e.key_type {
    e.key_type = subst_type_name(t, from, to)
  }
  if t = e.val_type {
    e.val_type = subst_type_name(t, from, to)
  }
  i = 0
  while i < e.type_args.size {
    e.type_args[i] = subst_type_name(e.type_args[i], from, to)
    i += 1
  }
}

pub fn subst_type_in_stmts(body: Array(Stmt), from: Array(String), to: Array(TypeName)) {
  i = 0
  while i < body.size {
    subst_type_in_stmt(body[i], from, to)
    i += 1
  }
}

pub fn subst_type_in_stmt(s: Stmt, from: Array(String), to: Array(TypeName)) {
  if x = s.expr {
    subst_type_in_expr(x, from, to)
  }
  if x = s.value {
    subst_type_in_expr(x, from, to)
  }
  if x = s.target {
    subst_type_in_expr(x, from, to)
  }
  if x = s.cond {
    subst_type_in_expr(x, from, to)
  }
  subst_type_in_stmts(s.then_body, from, to)
  subst_type_in_stmts(s.else_body, from, to)
  subst_type_in_stmts(s.body, from, to)
  if t = s.declared {
    s.declared = subst_type_name(t, from, to)
  }
}

pub fn subst_function_types(fnn: Function, from: Array(String), to: Array(TypeName)) {
  if r = fnn.receiver {
    r.type = subst_type_name(r.type, from, to)
  }
  if t = fnn.return_type {
    fnn.return_type = subst_type_name(t, from, to)
  }
  for p in fnn.params {
    p.type = subst_type_name(p.type, from, to)
    if d = p.default {
      subst_type_in_expr(d, from, to)
    }
  }
  for b in fnn.bounds {
    b.iface = subst_type_name(b.iface, from, to)
    for j in 0..from.size {
      if b.param == from[j] {
        b.param = to[j].name
      }
    }
  }
  subst_type_in_stmts(fnn.body, from, to)
}

// The hidden name of argument j of the call whose argument frame is
// frame (checker/match.av fill_defaults): no name a program can write.
pub fn arg_frame_name(frame: UInt64, j: Int): String {
  "$${frame}.${j}"
}

// Each name of from in e becomes a copy of the node of to at the same
// index. A node of to without an ident is a hidden argument name that
// has not been needed yet (its frame in int_bits, its index in op): it is
// named at its first use, so the caller can tell which were used.
pub fn rewrite_expr_names(e: Expr, from: Array(String), to: Array(Expr)): Expr {
  if e.kind == ex_name() {
    i = 0
    while i < from.size {
      if e.ident == from[i] {
        t = to[i]
        if t.ident.size == 0 {
          t.ident = arg_frame_name(t.int_bits, t.op)
        }
        c = Expr.new(ex_name(), t.loc)
        c.ident = t.ident
        return c
      }
      i += 1
    }
    return e
  }
  if x = e.left {
    e.left = rewrite_expr_names(x, from, to)
  }
  if x = e.right {
    e.right = rewrite_expr_names(x, from, to)
  }
  if x = e.object {
    e.object = rewrite_expr_names(x, from, to)
  }
  if x = e.cond {
    e.cond = rewrite_expr_names(x, from, to)
  }
  if x = e.receiver {
    e.receiver = rewrite_expr_names(x, from, to)
  }
  if x = e.inner {
    e.inner = rewrite_expr_names(x, from, to)
  }
  if b = e.block {
    // A block's own parameter hides an outer name of the same spelling.
    hidden = false
    for bp in b.params {
      for fname in from {
        if bp == fname {
          hidden = true
        }
      }
    }
    if hidden {
      from2: Array(String) = []
      to2: Array(Expr) = []
      for k in 0..from.size {
        keep = true
        for bp in b.params {
          if bp == from[k] {
            keep = false
          }
        }
        if keep {
          from2.push(from[k])
          to2.push(to[k])
        }
      }
      rewrite_stmt_names_body(b.body, from2, to2)
    } else {
      rewrite_stmt_names_body(b.body, from, to)
    }
  }
  if x = e.size_expr {
    e.size_expr = rewrite_expr_names(x, from, to)
  }
  i = 0
  while i < e.args.size {
    e.args[i] = rewrite_expr_names(e.args[i], from, to)
    i += 1
  }
  i = 0
  while i < e.elems.size {
    e.elems[i] = rewrite_expr_names(e.elems[i], from, to)
    i += 1
  }
  i = 0
  while i < e.field_exprs.size {
    e.field_exprs[i] = rewrite_expr_names(e.field_exprs[i], from, to)
    i += 1
  }
  for p in e.parts {
    if inner = p.expr {
      p.expr = rewrite_expr_names(inner, from, to)
    }
  }
  i = 0
  while i < e.cases.size {
    rewrite_stmt_names_body(e.cases[i].body, from, to)
    i += 1
  }
  rewrite_stmt_names_body(e.else_body, from, to)
  e
}

pub fn rewrite_stmt_names_body(body: Array(Stmt), from: Array(String), to: Array(Expr)) {
  i = 0
  while i < body.size {
    rewrite_stmt_names(body[i], from, to)
    i += 1
  }
}

pub fn rewrite_stmt_names(s: Stmt, from: Array(String), to: Array(Expr)) {
  if x = s.expr {
    s.expr = rewrite_expr_names(x, from, to)
  }
  if x = s.value {
    s.value = rewrite_expr_names(x, from, to)
  }
  if x = s.target {
    s.target = rewrite_expr_names(x, from, to)
  }
  if x = s.cond {
    s.cond = rewrite_expr_names(x, from, to)
  }
  rewrite_stmt_names_body(s.then_body, from, to)
  rewrite_stmt_names_body(s.else_body, from, to)
  rewrite_stmt_names_body(s.body, from, to)
}

pub fn collect_fn_type_params(fnn: Function, named: Hash(String, Int)): Array(String) {
  into: Array(String) = []
  for param in fnn.params {
    type_name_unbound_names(param.type, named, into)
  }
  if r = fnn.receiver {
    type_name_unbound_names(r.type, named, into)
  }
  if t = fnn.return_type {
    type_name_unbound_names(t, named, into)
  }
  into
}

// The `Error` marker (D292, Stage 29 W4a): whether a type's interface
// clause names it.
pub fn error_opted(opted: Array(TypeName)): Bool {
  for tn in opted {
    if tn.name == "Error" && tn.mod_name.size == 0 {
      return true
    }
  }
  false
}

