pub class TypeName {
  loc: Location
  name: String = ""
  args: Array(TypeName)
  nilable: Bool = false
  members: Array(TypeName)
  mod_name: String = ""
  splice: Expr? = nil
  fn_type: Bool = false
  ret: TypeName? = nil
  bounds: Array(TypeName)

  fn initialize(loc: Location, name: String) {
    self.loc = loc
    self.name = name
    self.args = []
    self.members = []
    self.bounds = []
    self.nilable = false
    self.mod_name = ""
    self.fn_type = false
  }
}

pub class TypeBound {
  param: String = ""
  iface: TypeName

  fn initialize(param: String, iface: TypeName) {
    self.param = param
    self.iface = iface
  }
}

pub class Param {
  loc: Location
  name: String = ""
  type: TypeName
  default: Expr? = nil

  fn initialize(loc: Location, name: String, type: TypeName) {
    self.loc = loc
    self.name = name
    self.type = type
  }
}

