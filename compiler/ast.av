  loc: Location
  params: Array(String)
  body: Array(Stmt)

  fn initialize(loc: Location) {
    self.loc = loc
    p: Array(String) = []
    self.params = p
    b: Array(Stmt) = []
    self.body = b
  }
}

pub class Expr {
  kind: Int = 0
  loc: Location
  ident: String = ""
  callee: String = ""
  value_str: String = ""
  int_bits: UInt64 = 0u64
  int_suffix: String = ""
  float_val: Float64 = 0.0
  bool_val: Bool = false
  op: Int = 0
  implicit_field: Bool = false
  method_call: Bool = false
  type_name: String = ""
  lib_name: String = ""
  has_else: Bool = false
  left: Expr? = nil
  right: Expr? = nil
  object: Expr? = nil
  cond: Expr? = nil
  receiver: Expr? = nil
  inner: Expr? = nil
  size_expr: Expr? = nil
  args: Array(Expr)
  elems: Array(Expr)
  field_names: Array(String)
  field_exprs: Array(Expr)
  parts: Array(InterpPart)
  cases: Array(SwitchCase)
  else_body: Array(Stmt)
  block: Block? = nil
  elem_type: TypeName? = nil
  key_type: TypeName? = nil
  val_type: TypeName? = nil
  ty: Ty? = nil
  spawn_thunk: String = ""
  resolved: String = ""
  cap_names: Array(String)
  cap_tys: Array(Ty)
  vis: Bool = false
  mod_name: String = ""

  fn initialize(kind: Int, loc: Location) {
    self.kind = kind
    self.loc = loc
    a: Array(Expr) = []
    self.args = a
    el: Array(Expr) = []
    self.elems = el
    fns: Array(String) = []
    self.field_names = fns
    fe: Array(Expr) = []
    self.field_exprs = fe
    ps: Array(InterpPart) = []
    self.parts = ps
    cs: Array(SwitchCase) = []
    self.cases = cs
    eb: Array(Stmt) = []
    self.else_body = eb
    cn: Array(String) = []
    self.cap_names = cn
    ct: Array(Ty) = []
    self.cap_tys = ct
    self.spawn_thunk = ""
    self.resolved = ""
    self.vis = false
    self.mod_name = ""
  }
}

