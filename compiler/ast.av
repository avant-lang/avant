pub class Expr {
  kind: Int = 0
  loc: Location
  ident: String = ""
  callee: String = ""
  value_str: String = ""
  int_bits: UInt64 = 0u64
  int_suffix: String = ""
  float_val: Float64 = 0.0
  bool_val: Bool = false
  op: Int = 0
  implicit_field: Bool = false
  method_call: Bool = false
  proven: Bool = false
  type_name: String = ""
  lib_name: String = ""
  has_else: Bool = false
  left: Expr? = nil
  right: Expr? = nil
  object: Expr? = nil
  cond: Expr? = nil
  receiver: Expr? = nil
  inner: Expr? = nil
  size_expr: Expr? = nil
  args: Array(Expr)
  elems: Array(Expr)
  field_names: Array(String)
  field_exprs: Array(Expr)
  parts: Array(InterpPart)
  cases: Array(SwitchCase)
  else_body: Array(Stmt)
  block: Block? = nil
  elem_type: TypeName? = nil
  key_type: TypeName? = nil
  val_type: TypeName? = nil
  type_args: Array(TypeName)
  ty: Ty? = nil
  spawn_thunk: String = ""
  resolved: String = ""
  cap_names: Array(String)
  cap_tys: Array(Ty)
  box_names: Array(String)
  indirect: Bool = false
  type_call: Bool = false
  fn_ref: Bool = false
  vis: Bool = false
  mod_name: String = ""
  splice: Expr? = nil

  fn initialize(kind: Int, loc: Location) {
    self.kind = kind
    self.loc = loc
    self.args = []
    self.elems = []
    self.field_names = []
    self.field_exprs = []
    self.parts = []
    self.cases = []
    self.else_body = []
    self.type_args = []
    self.cap_names = []
    self.cap_tys = []
    self.box_names = []
    self.spawn_thunk = ""
    self.resolved = ""
    self.indirect = false
    self.type_call = false
    self.fn_ref = false
    self.vis = false
    self.mod_name = ""
  }
}

pub class Stmt {
  kind: Int = 0
  proven: Bool = false
  vstep: Int = -1
  vle: Bool = false
  vcoff: Int = 0
  vstart: Int = 0
