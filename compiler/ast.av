  expr: Expr? = nil
  value: Expr? = nil
  target: Expr? = nil
  cond: Expr? = nil
  bind: String = ""
  op: Int = 0
  then_body: Array(Stmt)
  else_body: Array(Stmt)
  body: Array(Stmt)
  pre: Array(Stmt)
  for_kind: Int = 0
  declared: TypeName? = nil
  lead: Int = 0

  fn initialize(kind: Int, loc: Location) {
    self.kind = kind
    self.loc = loc
    self.then_body = []
    self.else_body = []
    self.body = []
    self.pre = []
    self.for_kind = 0
  }
}

