    self.module_path = ""
    self.root_module = ""
    self.mods = []
    self.interfaces = []
    self.opt_ins = []
    ri = Hash(String, Int).new
    self.re2c_ids = ri
    self.re2c_groups = []
    self.re2c_obj = ""
