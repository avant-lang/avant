  else_body: Array(Stmt)
  body: Array(Stmt)
  declared: TypeName? = nil

  fn initialize(kind: Int, loc: Location) {
    self.kind = kind
    self.loc = loc
    t: Array(Stmt) = []
    self.then_body = t
    e: Array(Stmt) = []
    self.else_body = e
    b: Array(Stmt) = []
    self.body = b
  }
}

