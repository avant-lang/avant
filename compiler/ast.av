  owner: String = ""
  emit_name: String = ""
  type_params: Array(String)
  generic: Bool = false
  ol_index: Int = 0
  vis: Bool = false
  type_method: Bool = false
  mod_name: String = ""
  owner_mod: String = ""
  name_splice: Expr? = nil
  box_names: Array(String)
  as_value: Bool = false
  bounds: Array(TypeBound)
  // A generic function's or method's instance: the type arguments the
  // checker substituted (checker/match.av instantiate_function and
  // instantiate_method), in type-parameter order; empty otherwise.
  inst_args: Array(Ty)

  fn initialize(loc: Location, name: String) {
    self.loc = loc
    self.name = name
    self.params = []
    self.body = []
    self.emit_name = name
    self.type_params = []
    self.box_names = []
    self.bounds = []
    self.inst_args = []
    self.generic = false
    self.ol_index = 0
    self.vis = false
    self.mod_name = ""
    self.owner_mod = ""
    self.as_value = false
  }
}

