pub fn ex_int: Int { 1 }
pub fn ex_float: Int { 2 }
pub fn ex_string: Int { 3 }
pub fn ex_bool: Int { 4 }
pub fn ex_name: Int { 5 }
pub fn ex_call: Int { 6 }
pub fn ex_unary: Int { 7 }
pub fn ex_binary: Int { 8 }
pub fn ex_field: Int { 9 }
pub fn ex_index: Int { 10 }
pub fn ex_struct: Int { 11 }
