pub class TypeName {
  loc: Location
  name: String = ""
  args: Array(TypeName)
  nilable: Bool = false
  members: Array(TypeName)
  mod_name: String = ""

  fn initialize(loc: Location, name: String) {
    self.loc = loc
    self.name = name
    a: Array(TypeName) = []
    self.args = a
    m: Array(TypeName) = []
    self.members = m
    self.nilable = false
    self.mod_name = ""
  }
}

pub class Param {
  loc: Location
  name: String = ""
  type: TypeName
  default: Expr? = nil

  fn initialize(loc: Location, name: String, type: TypeName) {
    self.loc = loc
    self.name = name
    self.type = type
  }
}

pub class InterpPart {
  text: String? = nil
  expr: Expr? = nil

  fn initialize {
  }
}

pub class SwitchCase {
  loc: Location
  labels: Array(Int64)
  body: Array(Stmt)

  fn initialize(loc: Location) {
    self.loc = loc
    labs: Array(Int64) = []
    self.labels = labs
    b: Array(Stmt) = []
    self.body = b
  }
}

