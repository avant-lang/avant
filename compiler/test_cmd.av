import loader
import pipeline
import pkg
import source
import cov_report
import llvm.glue

pub class FileRun {
  abs: String = ""
  rel: String = ""
  bin: String = ""
  output: String = ""
  parallels: Array(String) = []
  par_logs: Array(String) = []
  ok: Bool = true
  compiled: Bool = false
  exclusive: Bool = false
  reported: Bool = false
  map: String = ""
  frags: Array(String)
  pending: Int = 0

  fn initialize(abs: String, rel: String, bin: String) {
    self.abs = abs
    self.rel = rel
    self.bin = bin
    self.ok = true
    self.compiled = false
    self.exclusive = false
    self.reported = false
    self.map = ""
    self.frags = []
    self.pending = 0
  }
}

lib job_rt {
  fun avant_job_start(path: String, args: Array(String), out: String): Int
  fun avant_job_wait: Int
  fun avant_job_status: Int
}

// One test job (D131): /usr/bin/env with its variables and command as
// arguments, stdout and stderr to log. No shell: statuses come from
// waitpid, and the runtime can stop every job's process group on a signal.
// kind 0 compiles file, 1 runs its serial work, 2 runs one parallel name.
pub class JobCmd {
  args: Array(String)
  log: String = ""
  pid: Int = 0
  code: Int = 0
  finished: Bool = false
  started: Bool = false
  kind: Int = 0
  file: Int = 0
  names: String = ""

  fn initialize(args: Array(String), log: String, kind: Int, file: Int) {
    self.args = args
    self.log = log
    self.kind = kind
    self.file = file
  }
}

// Keeps up to limit jobs running and hands back each one as it finishes
// (D136). Jobs are added while others run, so a file's run starts as soon
// as its own compile is done: there is no phase barrier. A free slot takes
// a waiting run before a waiting compile, and the earliest file first.
pub class JobSched {
  jobs: Array(JobCmd) = []
  limit: Int = 1
  running: Int = 0

  fn initialize(limit: Int) {
    self.limit = limit
    if self.limit < 1 {
      self.limit = 1
    }
    self.running = 0
  }

  pub fn add(cmd: JobCmd) {
    self.jobs.push(cmd)
  }

  fn better(a: JobCmd, b: JobCmd): Bool {
    if a.kind > 0 {
      if b.kind == 0 {
        return true
      }
    } else {
      if b.kind > 0 {
        return false
      }
    }
    a.file < b.file
  }

  fn pick: Int {
    best = -1
    i = 0
    while i < self.jobs.size {
      cmd = self.jobs[i]
      if !cmd.started {
        if best < 0 {
          best = i
        } else if better(cmd, self.jobs[best]) {
          best = i
        }
      }
      i += 1
    }
    best
  }

  // The index of the next finished job, or -1 when every added job has
  // finished.
  pub fn wait_one: Int {
    while self.running < self.limit {
      k = self.pick
      if k < 0 {
        break
      }
      cmd = self.jobs[k]
      cmd.started = true
      pid = job_rt.avant_job_start("/usr/bin/env", cmd.args, cmd.log)
      if pid < 0 {
        cmd.code = 127
        cmd.finished = true
        return k
      }
      cmd.pid = pid
      self.running += 1
    }
    if self.running == 0 {
      return -1
    }
    got = job_rt.avant_job_wait()
    if got < 0 {
      return -1
    }
    self.running -= 1
    i = 0
    while i < self.jobs.size {
      cmd = self.jobs[i]
      if cmd.started && cmd.pid == got && !cmd.finished {
        cmd.code = job_rt.avant_job_status()
        cmd.finished = true
        return i
      }
      i += 1
    }
    self.wait_one
  }
}

pub class TestHost {
  compiler: String = ""
  seq: Int = 0
  jobs: Int = 1
  coverage: Bool = false
  junit: Bool = false
  good: Int = 0
  bad: Int = 0
  cov: CovReport

  fn initialize(compiler: String, jobs: Int) {
    self.compiler = compiler
    self.jobs = jobs
    self.cov = CovReport.new("")
  }

  pub fn fresh: String {
    self.seq += 1
    tmp_path("t-${self.seq}")
  }
}

fn parse_u(s: String): Int {
  if s.size == 0 {
    return -1
  }
  n = 0
  i = 0
  while i < s.size {
    c = s[i]
    if c < 48 || c > 57 {
      return -1
    }
    n = n * 10 + (c - 48)
    i += 1
  }
  n
}

fn count_range(part: String): Int {
  t = part.strip()
  if t.size == 0 {
    return 0
  }
  dash = -1
  for i in 0..t.size {
    if t[i] == 45 {
      dash = i
    }
  }
  if dash < 0 {
    if parse_u(t) < 0 {
      return 0
    }
    return 1
  }
  lo = parse_u(str_slice(t, 0, dash))
  hi = parse_u(str_slice(t, dash + 1, t.size))
  if lo < 0 || hi < lo {
    return 0
  }
  hi - lo + 1
}

fn count_online: Int {
  if text = file_read("/sys/devices/system/cpu/online") {
    spec = text.strip()
    if spec.size == 0 {
      return 1
    }
    total = 0
    start = 0
    i = 0
    while i <= spec.size {
      if i == spec.size || spec[i] == 44 {
        total += count_range(str_slice(spec, start, i))
        start = i + 1
      }
      i += 1
    }
    if total < 1 {
      return 1
    }
    return total
  }
  1
}

fn read_cwd: String {
  cwd_physical()
}

fn abs_join(dir: String, rel: String): String {
  if rel.size > 0 && rel[0] == 47 {
    return rel
  }
  if dir == "/" {
    return "/${rel}"
  }
  "${dir}/${rel}"
}

fn rel_of(cwd: String, abs: String): String {
  prefix = "${cwd}/"
  if str_starts(abs, prefix) {
    return str_slice(abs, prefix.size, abs.size)
  }
  abs
}

fn is_test_name(name: String): Bool {
  if str_starts(name, "test_") {
    return str_ends(name, ".av")
  }
  false
}

fn path_less(a: String, b: String): Bool {
  n = a.size
  if b.size < n {
    n = b.size
  }
  for i in 0..n {
    if a[i] < b[i] {
      return true
    }
    if a[i] > b[i] {
      return false
    }
  }
  a.size < b.size
}

fn sort_files(files: Array(FileRun)) {
  for i in 1..files.size {
    j = i
    while j > 0 {
      if path_less(files[j].rel, files[j - 1].rel) {
        tmp = files[j]
        files[j] = files[j - 1]
        files[j - 1] = tmp
        j -= 1
      } else {
        break
      }
    }
  }
}

fn walk_tests(dir: String, cwd: String, into: Array(FileRun), seq: Int): Int {
  names = dir_list(dir) ?? []
  i = 0
  nseq = seq
  while i < names.size {
    name = names[i]
    i += 1
    if name.size == 0 {
      continue
    }
    if name[0] == 46 {
      continue
    }
    if name == "deps" {
      continue
    }
    path = abs_join(dir, name)
    if is_test_name(name) {
      nseq += 1
      into.push(FileRun.new(path, rel_of(cwd, path), tmp_path("bin-${nseq}")))
    } else {
      sub = dir_list(path) ?? []
      if sub.size > 0 {
        nseq = walk_tests(path, cwd, into, nseq)
      }
    }
  }
  nseq
}

fn read_text(path: String): String {
  if text = file_read(path) {
    return text
  }
  ""
}

fn listed(paths: Array(String), path: String): Bool {
  for p in paths {
    if p == path {
      return true
    }
  }
  false
}

fn env_base(compiler: String, names: String, only: String, frag: String): Array(String) {
  a: Array(String) = []
  a.push("AVANT_COMPILER=${compiler}")
  a.push("AVANT_TEST_LIST=")
  a.push("AVANT_TEST_ONLY=${only}")
  a.push("AVANT_TEST_NAMES=${names}")
  a.push("AVANT_JUNIT_FRAGMENT=${frag}")
  a
}

fn env_plain(compiler: String, coverage: Bool, map: String): Array(String) {
  a = env_base(compiler, "", "", "")
  if coverage {
    a.push("AVANT_COVERAGE=1")
    a.push("AVANT_COVERAGE_MAP=${map}")
  }
  a
}

fn env_run(compiler: String, names: String, only: String, coverage: Bool, frag: String): Array(String) {
  a = env_base(compiler, names, only, frag)
  if coverage {
    a.push("AVANT_COVERAGE=")
    a.push("AVANT_COVERAGE_LCOV=0")
    a.push("AVANT_COVERAGE_REPORT=0")
  }
  a
}

fn rm_file(path: String) {
  dummy = fs_unlink(path)
}

fn name_lines(text: String): Array(String) {
  out: Array(String) = []
  start = 0
  i = 0
  while i <= text.size {
    if i == text.size || text[i] == 10 {
      line = str_slice(text, start, i)
      if line.size > 0 && line[line.size - 1] == 13 {
        line = str_slice(line, 0, line.size - 1)
      }
      if line.size > 0 {
        out.push(line)
      }
      start = i + 1
    }
    i += 1
  }
  out
}

fn chmod_bin(path: String) {
  dummy = fs_chmod_x(path)
}

fn append_text(into: String, chunk: String): String {
  if chunk.size == 0 {
    return into
  }
  if into.size == 0 {
    return chunk
  }
  "${into}${chunk}"
}

fn emit_file(host: TestHost, f: FileRun) {
  if f.reported {
    return
  }
  f.reported = true
  if f.output.size > 0 {
    text = f.output
    if text[text.size - 1] == 10 {
      text = str_slice(text, 0, text.size - 1)
    }
    out_puts(text)
  }
  if f.ok {
    out_puts("ok ${f.rel}")
    host.good += 1
  } else {
    out_puts("FAIL ${f.rel}")
    host.bad += 1
  }
}

fn queue_run(host: TestHost, sched: JobSched, f: FileRun, at: Int) {
  base = host.fresh()
  names = "${base}.names"
  frag = ""
  if host.junit {
    frag = "${base}.junit"
    f.frags.push(frag)
  }
  args = env_run(host.compiler, names, "", host.coverage, frag)
  args.push(f.bin)
  run = JobCmd.new(args, "${base}.log", 1, at)
  run.names = names
  sched.add(run)
}

fn queue_parallels(host: TestHost, sched: JobSched, f: FileRun, at: Int) {
  for name in f.parallels {
    frag = ""
    if host.junit {
      frag = "${host.fresh()}.junit"
      f.frags.push(frag)
    }
    args = env_run(host.compiler, "", name, host.coverage, frag)
    args.push(f.bin)
    cmd = JobCmd.new(args, "${host.fresh()}.log", 2, at)
    sched.add(cmd)
    f.par_logs.push(cmd.log)
    f.pending += 1
  }
}

fn take_par_logs(f: FileRun) {
  for par_log in f.par_logs {
    f.output = append_text(f.output, read_text(par_log))
    rm_file(par_log)
  }
}

// [test] first (D136): the listed files move to the front in the listed
// order and the rest keep walk order. Applied after --shard picks its
// slice, so a shard's files do not depend on the list.
fn order_first(files: Array(FileRun), first_abs: Array(String)): Array(FileRun) {
  if first_abs.size == 0 {
    return files
  }
  out: Array(FileRun) = []
  taken: Array(Int) = []
  f = 0
  while f < files.size {
    taken.push(0)
    f += 1
  }
  e = 0
  while e < first_abs.size {
    f = 0
    while f < files.size {
      if taken[f] == 0 && files[f].abs == first_abs[e] {
        taken[f] = 1
        out.push(files[f])
      }
      f += 1
    }
    e += 1
  }
  f = 0
  while f < files.size {
    if taken[f] == 0 {
      out.push(files[f])
    }
    f += 1
  }
  out
}

// Runs files through one scheduler (D136): each file's serial work is
// queued when its compile finishes, its parallel names when its serial
// work finishes (D84), and the file is reported when its last job ends.
fn run_many(host: TestHost, files: Array(FileRun)) {
  if files.size == 0 {
    return
  }
  sched = JobSched.new(host.jobs)
  i = 0
  while i < files.size {
    f = files[i]
    if host.coverage {
      f.map = "${host.fresh()}.map"
    }
    args = env_plain(host.compiler, host.coverage, f.map)
    args.push(host.compiler)
    args.push("compile")
    args.push(f.abs)
    args.push(f.bin)
    args.push("--debug")
    // The tests are local runs: the machine's highest level (O140).
    args.push("--cpu=${llvm_cpu_name(llvm_host_level())}")
    sched.add(JobCmd.new(args, "${host.fresh()}.log", 0, i))
    i += 1
  }
  while true {
    k = sched.wait_one
    if k < 0 {
      break
    }
    cmd = sched.jobs[k]
    f = files[cmd.file]
    if cmd.kind == 0 {
      if cmd.code != 0 {
        f.ok = false
        f.compiled = false
        f.output = read_text(cmd.log)
        emit_file(host, f)
      } else {
        f.compiled = true
        chmod_bin(f.bin)
        queue_run(host, sched, f, cmd.file)
      }
      rm_file(cmd.log)
    } else if cmd.kind == 1 {
      f.output = append_text(f.output, read_text(cmd.log))
      if cmd.code != 0 {
        f.ok = false
      }
      rm_file(cmd.log)
      found = name_lines(read_text(cmd.names))
      rm_file(cmd.names)
      seen: Array(String) = []
      for name in found {
        if listed(seen, name) {
          f.ok = false
          f.output = append_text(f.output, "duplicate parallel name ${name}\n")
        } else {
          seen.push(name)
          f.parallels.push(name)
        }
      }
      if f.parallels.size == 0 {
        emit_file(host, f)
      } else {
        queue_parallels(host, sched, f, cmd.file)
      }
    } else {
      if cmd.code != 0 {
        f.ok = false
      }
      f.pending -= 1
      if f.pending == 0 {
        take_par_logs(f)
        emit_file(host, f)
      }
    }
  }
  for f in files {
    if f.compiled && !f.reported {
      take_par_logs(f)
      f.ok = false
      f.output = append_text(f.output, "test jobs did not finish\n")
      emit_file(host, f)
    }
  }
  if host.coverage {
    for f in files {
      if f.compiled {
        host.cov.merge_map(f.map)
      }
      rm_file(f.map)
      if f.map.size > 0 {
        rm_file("${f.map}.hits")
      }
    }
  }
  for path in files {
    if path.compiled {
      rm_file(path.bin)
    }
  }
}

fn xml_escape(s: String): String {
  b = buf_new()
  i = 0
  while i < s.size {
    c = s[i]
    if c == 38 {
      b.push_str("&amp;")
    } else if c == 60 {
      b.push_str("&lt;")
    } else if c == 62 {
      b.push_str("&gt;")
    } else if c == 34 {
      b.push_str("&quot;")
    } else {
      b.push_byte(c)
    }
    i += 1
  }
  b.to_s
}

fn find_from(text: String, needle: String, from: Int): Int {
  if needle.size == 0 {
    return -1
  }
  last = text.size - needle.size
  i = from
  while i <= last {
    if str_slice(text, i, i + needle.size) == needle {
      return i
    }
    i += 1
  }
  -1
}

fn attr_sum(text: String, key: String): Int {
  total = 0
  from = 0
  while true {
    at = find_from(text, key, from)
    if at < 0 {
      return total
    }
    j = at + key.size
    n = 0
    while j < text.size && text[j] >= 48 && text[j] <= 57 {
      n = n * 10 + (text[j] - 48)
      j += 1
    }
    total += n
    from = j
  }
  total
}

fn suite_time_ms(text: String): Int {
  total = 0
  from = 0
  while true {
    at = find_from(text, "<testsuite", from)
    if at < 0 {
      return total
    }
    t = find_from(text, "time=\"", at)
    if t < 0 {
      return total
    }
    j = t + 6
    whole = 0
    while j < text.size && text[j] >= 48 && text[j] <= 57 {
      whole = whole * 10 + (text[j] - 48)
      j += 1
    }
    frac = 0
    digits = 0
    if j < text.size && text[j] == 46 {
      j += 1
      while j < text.size && text[j] >= 48 && text[j] <= 57 && digits < 3 {
        frac = frac * 10 + (text[j] - 48)
        digits += 1
        j += 1
      }
    }
    while digits < 3 {
      frac *= 10
      digits += 1
    }
    total = total + whole * 1000 + frac
    from = j
  }
  total
}

fn secs_str(ms: Int): String {
  whole = ms / 1000
  frac = ms % 1000
  fs = "${frac}"
  while fs.size < 3 {
    fs = "0${fs}"
  }
  "${whole}.${fs}"
}

fn write_junit(path: String, files: Array(FileRun)) {
  tests = 0
  bad = 0
  total_ms = 0
  body = buf_new()
  fb = buf_new()
  fb_tests = 0
  fb_bad = 0
  for f in files {
    fragtext = ""
    for frag in f.frags {
      fragtext = append_text(fragtext, read_text(frag))
      rm_file(frag)
    }
    if fragtext.size > 0 {
      body.push_str(fragtext)
      if fragtext[fragtext.size - 1] != 10 {
        body.push_str("\n")
      }
      tests = tests + attr_sum(fragtext, "tests=\"")
      bad = bad + attr_sum(fragtext, "failures=\"")
      total_ms += suite_time_ms(fragtext)
    } else {
      fb_tests += 1
      tests += 1
      fb.push_str("    <testcase name=\"")
      fb.push_str(xml_escape(f.rel))
      fb.push_str("\" classname=\"")
      fb.push_str(xml_escape(f.rel))
      fb.push_str("\" time=\"0.000\"")
      if f.ok {
        fb.push_str("/>\n")
      } else {
        fb_bad += 1
        bad += 1
        fb.push_str(">\n      <failure message=\"failed\"><![CDATA[")
        fb.push_str(f.output)
        fb.push_str("]]></failure>\n    </testcase>\n")
      }
    }
  }
  b = buf_new()
  b.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
  b.push_str("<testsuites tests=\"${tests}\" failures=\"${bad}\" time=\"${secs_str(total_ms)}\">\n")
  b.push_str(body.to_s)
  if fb_tests > 0 {
    b.push_str("  <testsuite name=\"avant test\" tests=\"${fb_tests}\" failures=\"${fb_bad}\" time=\"0.000\">\n")
    b.push_str(fb.to_s)
    b.push_str("  </testsuite>\n")
  }
  b.push_str("</testsuites>\n")
  w = file_write(path, b.to_s) ?? -1
  if w < 0 {
    diag_puts("cannot write ${path}")
    diag_exit(1)
  }
}

fn shard_index(spec: String, want_index: Bool): Int {
  slash = -1
  for i in 0..spec.size {
    if spec[i] == 47 {
      slash = i
    }
  }
  if slash < 1 {
    return -1
  }
  if want_index {
    return parse_u(str_slice(spec, 0, slash))
  }
  parse_u(str_slice(spec, slash + 1, spec.size))
}

fn test_fail(message: String) {
  diag_puts(message)
  diag_exit(1)
}

fn is_dir(path: String): Bool {
  file_exists("${path}/.")
}

fn require_cov_dir(anchor: String, rel: String, key: String) {
  path = abs_join(anchor, rel)
  if !file_exists(path) {
    test_fail("${key} directory does not exist: ${rel}")
  }
  if !is_dir(path) {
    test_fail("${key} path is not a directory: ${rel}")
  }
}

pub fn driver_test(args: Array(String)) {
  jobs = -1
  shard = ""
  junit = ""
  skip_ex = false
  coverage = false
  paths: Array(String) = []
  i = 0
  while i < args.size {
    arg = args[i]
    if arg == "--jobs" {
      if i + 1 >= args.size {
        test_fail("--jobs needs an integer")
      }
      jobs = parse_u(args[i + 1])
      if jobs < 1 {
        test_fail("--jobs needs an integer greater than 0")
      }
      i += 2
    } else if str_starts(arg, "--jobs=") {
      jobs = parse_u(str_slice(arg, 7, arg.size))
      if jobs < 1 {
        test_fail("--jobs needs an integer greater than 0")
      }
      i += 1
    } else if arg == "--shard" {
      if i + 1 >= args.size {
        test_fail("--shard needs I/N")
      }
      shard = args[i + 1]
      i += 2
    } else if str_starts(arg, "--shard=") {
      shard = str_slice(arg, 8, arg.size)
      i += 1
    } else if arg == "--junit" {
      if i + 1 >= args.size {
        test_fail("--junit needs a path")
      }
      junit = args[i + 1]
      i += 2
    } else if str_starts(arg, "--junit=") {
      junit = str_slice(arg, 8, arg.size)
      i += 1
    } else if arg == "--skip-exclusive" {
      skip_ex = true
      i += 1
    } else if arg == "--coverage" {
      coverage = true
      i += 1
    } else if arg == "-h" || arg == "--help" {
      diag_puts("avant test [TEST-OPTIONS] [PATH...]")
      diag_puts("--jobs N   test processes at once (default: online processors)")
      diag_puts("--jobs 1   one file at a time")
      diag_puts("--shard I/N   slice I of N, 1-based, round-robin")
      diag_puts("--junit PATH   one case per file")
      diag_puts("--skip-exclusive   omit [test] exclusive files")
      diag_puts("--coverage   instrument tests and print one coverage table")
      diag_exit(0)
    } else if arg == "--" {
      test_fail("avant test does not take program arguments")
    } else if str_starts(arg, "-") {
      test_fail("unknown test argument ${arg}")
    } else {
      paths.push(arg)
      i += 1
    }
  }
  if jobs < 1 {
    jobs = count_online()
  }
  cwd = read_cwd()
  man_dir = find_manifest(cwd)
  test_dir = ""
  test_entry = ""
  exclusive: Array(String) = []
  first: Array(String) = []
  cov_include: Array(String) = []
  cov_exclude: Array(String) = []
  if man_dir.size > 0 {
    man_path = abs_join(man_dir, "avant.toml")
    if text = file_read(man_path) {
      m = pkg_parse_manifest(text, man_path)
      if !m.ok {
        test_fail(m.err)
      }
      if m.test_err.size > 0 {
        test_fail(m.test_err)
      }
      if m.cov_err.size > 0 {
        test_fail(m.cov_err)
      }
      if m.test_dir.size > 0 && m.test_entry.size > 0 {
        test_fail("${man_path}: [test] dir and entry cannot both be set")
      }
      test_dir = m.test_dir
      test_entry = m.test_entry
      for k in 0..m.test_exclusive.size {
        exclusive.push(m.test_exclusive[k])
      }
      for k in 0..m.test_first.size {
        first.push(m.test_first[k])
      }
      for k in 0..m.cov_include.size {
        cov_include.push(m.cov_include[k])
      }
      for k in 0..m.cov_exclude.size {
        cov_exclude.push(m.cov_exclude[k])
      }
    }
  }
  anchor = cwd
  if man_dir.size > 0 {
    anchor = man_dir
  }
  if coverage {
    for k in 0..cov_include.size {
      require_cov_dir(anchor, cov_include[k], "include")
    }
    for k in 0..cov_exclude.size {
      require_cov_dir(anchor, cov_exclude[k], "exclude")
    }
  }
  files: Array(FileRun) = []
  if paths.size == 0 {
    if test_entry.size > 0 {
      entry = abs_join(anchor, test_entry)
      if !file_exists(entry) {
        test_fail("test entry does not exist: ${test_entry}")
      }
      files.push(FileRun.new(entry, rel_of(cwd, entry), tmp_path("bin-1")))
    } else {
      root = abs_join(anchor, "tests")
      if test_dir.size > 0 {
        root = abs_join(anchor, test_dir)
        if !file_exists(root) {
          test_fail("test dir does not exist: ${test_dir}")
        }
      }
      if file_exists(root) {
        walk_tests(root, cwd, files, 0)
      }
    }
  } else {
    p = 0
    seq = 0
    while p < paths.size {
      arg = paths[p]
      if !file_exists(arg) {
        test_fail("test path does not exist: ${arg}")
      }
      abs = arg
      if arg.size == 0 || arg[0] != 47 {
        abs = abs_join(cwd, arg)
      }
      if str_ends(arg, ".av") {
        seq += 1
        files.push(FileRun.new(abs, rel_of(cwd, abs), tmp_path("bin-${seq}")))
      } else {
        seq = walk_tests(abs, cwd, files, seq)
      }
      p += 1
    }
  }
  sort_files(files)
  ex_abs: Array(String) = []
  e = 0
  while e < exclusive.size {
    ex_abs.push(abs_join(anchor, exclusive[e]))
    e += 1
  }
  if paths.size == 0 {
    for e in 0..ex_abs.size {
      found = false
      for path in files {
        if path.abs == ex_abs[e] {
          found = true
        }
      }
      if !found {
        test_fail("exclusive path is not a selected test: ${exclusive[e]}")
      }
    }
  }
  first_abs: Array(String) = []
  e = 0
  while e < first.size {
    first_abs.push(abs_join(anchor, first[e]))
    e += 1
  }
  if paths.size == 0 {
    for e in 0..first_abs.size {
      found = false
      for path in files {
        if path.abs == first_abs[e] {
          found = true
        }
      }
      if !found {
        test_fail("first path is not a selected test: ${first[e]}")
      }
    }
  }
  f = 0
  while f < files.size {
    if listed(ex_abs, files[f].abs) {
      files[f].exclusive = true
    }
    f += 1
  }
  if shard.size > 0 {
    idx = shard_index(shard, true)
    cnt = shard_index(shard, false)
    if idx < 1 || cnt < 1 || idx > cnt {
      test_fail("bad --shard ${shard}")
    }
    has_ex = false
    for path in files {
      if path.exclusive {
        has_ex = true
      }
    }
    if has_ex && !skip_ex {
      test_fail("--shard cannot include an exclusive file (pass --skip-exclusive)")
    }
    pool: Array(FileRun) = []
    f = 0
    while f < files.size {
      if !(skip_ex && files[f].exclusive) {
        pool.push(files[f])
      }
      f += 1
    }
    picked: Array(FileRun) = []
    for f in 0..pool.size {
      if f % cnt == idx - 1 {
        picked.push(pool[f])
      }
    }
    files = picked
  } else if skip_ex {
    kept: Array(FileRun) = []
    f = 0
    while f < files.size {
      if !files[f].exclusive {
        kept.push(files[f])
      }
      f += 1
    }
    files = kept
  }
  if files.size == 0 {
    test_fail("no tests selected")
  }
  run_order = order_first(files, first_abs)
  argv0 = "avant"
  args0 = argv()
  if args0.size > 0 {
    argv0 = args0[0]
  }
  host = TestHost.new(argv0, jobs)
  host.coverage = coverage
  host.junit = junit.size > 0
  if coverage {
    host.cov = CovReport.new(anchor)
    host.cov.use_excludes(cov_exclude)
  }
  if jobs == 1 {
    run_many(host, run_order)
  } else {
    normals: Array(FileRun) = []
    excls: Array(FileRun) = []
    f = 0
    while f < run_order.size {
      if run_order[f].exclusive {
        excls.push(run_order[f])
      } else {
        normals.push(run_order[f])
      }
      f += 1
    }
    run_many(host, normals)
    for excl in excls {
      alone: Array(FileRun) = []
      alone.push(excl)
      run_many(host, alone)
    }
  }
  if junit.size > 0 {
    write_junit(junit, files)
  }
  bad = host.bad
  good = host.good
  puts("${bad} failed, ${good} passed")
  if coverage {
    for k in 0..cov_include.size {
      host.cov.add_tree(abs_join(anchor, cov_include[k]), cov_exclude)
    }
    if host.cov.has_rows {
      fs_mkdir_p("coverage")
      host.cov.write_lcov("coverage/lcov.info")
      host.cov.print_table
    }
  }
  if bad > 0 {
    diag_exit(1)
  }
  diag_exit(0)
}
