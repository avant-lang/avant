import source
import ast

pub class Re2cPlan {
  pub src: String = ""
  pub ids: Hash(String, Int)
  pub groups: Array(Int)
  pub count: Int = 0

  fn initialize {
    h = Hash(String, Int).new
    self.ids = h
    self.groups = []
    self.src = ""
    self.count = 0
  }
}

// Capture groups a re2c scanner can serve: group 0 and group 1 only,
// and no named groups. Returns -1 when the pattern must stay on PCRE2
// for correctness (more than one group, a named group, or a "(?"
// construct other than "(?:").
pub fn re2c_capture_groups(pat: String): Int {
  n = 0
  in_class = false
  i = 0
  while i < pat.size {
    c = pat[i]
    if c == 92 {
      i += 2
    } else if in_class {
      if c == 93 {
        in_class = false
      }
      i += 1
    } else if c == 91 {
      in_class = true
      i += 1
    } else if c == 40 {
      if i + 1 < pat.size && pat[i + 1] == 63 {
        if i + 2 < pat.size && pat[i + 2] == 58 {
          i += 3
        } else {
          return -1
        }
      } else {
        n += 1
        if n > 1 {
          return -1
        }
        i += 1
      }
    } else {
      i += 1
    }
  }
  n
}

pub class RePat {
  s: String = ""
  at: Int = 0
  len: Int = 0
  caseless: Int = 0
  bad: Bool = false
  why: String = ""
  nongreedy: Bool = false

  fn initialize {
  }

  pub fn fail(why: String) {
    if self.bad {
      return
    }
    self.bad = true
    self.why = why
  }

  pub fn peek: Int {
    if self.at >= self.len {
      return 0
    }
    self.s[self.at]
  }

  pub fn bump {
    self.at += 1
  }

  pub fn hex2(c: Int): String {
    h = "0123456789abcdef"
    chr(h[c / 16]) + chr(h[c % 16])
  }

  pub fn other_case(c: Int): Int {
    if c >= 65 && c <= 90 {
      return c + 32
    }
    if c >= 97 && c <= 122 {
      return c - 32
    }
    c
  }

  pub fn class_atom(c: Int): String {
    if c == 93 || c == 92 || c == 94 || c == 45 || c < 32 || c > 126 {
      return "\\x${self.hex2(c)}"
    }
    chr(c)
  }

  pub fn quote_lit(raw: String): String {
    q = 34
    if self.caseless != 0 {
      q = 39
    }
    buf = buf_new(raw.size + 2)
    buf.push_byte(q)
    i = 0
    while i < raw.size {
      c = raw[i]
      if c == q || c == 92 {
        buf.push_byte(92)
        buf.push_byte(c)
      } else if c == 10 {
        buf.push_str("\\n")
      } else if c == 13 {
        buf.push_str("\\r")
      } else if c == 9 {
        buf.push_str("\\t")
      } else {
        buf.push_byte(c)
      }
      i += 1
    }
    buf.push_byte(q)
    buf.to_s
  }

  pub fn push_class_char(buf: Buf, c: Int) {
    buf.push_str(self.class_atom(c))
    o = self.other_case(c)
    if o != c {
      buf.push_str(self.class_atom(o))
    }
  }

  pub fn class_escape(buf: Buf): Bool {
    if self.at >= self.len {
      self.fail("truncated escape")
      return false
    }
    c = self.peek
    self.bump
    if c == 100 || c == 68 {
      buf.push_str("0-9")
      return true
    }
    if c == 119 || c == 87 {
      buf.push_str("0-9A-Za-z_")
      return true
    }
    if c == 115 || c == 83 {
      buf.push_str(" \\t\\n\\r\\f\\v")
      return true
    }
    if c == 110 {
      buf.push_str("\\n")
      return true
    }
    if c == 114 {
      buf.push_str("\\r")
      return true
    }
    if c == 116 {
      buf.push_str("\\t")
      return true
    }
    if c == 102 {
      buf.push_str("\\f")
      return true
    }
    if c == 118 {
      buf.push_str("\\v")
      return true
    }
    if c >= 48 && c <= 57 {
      self.fail("backreference")
      return false
    }
    self.push_class_char(buf, c)
    true
  }

  pub fn parse_class: String {
    self.bump
    neg = false
    if self.peek == 94 {
      neg = true
      self.bump
    }
    body = buf_new()
    if self.peek == 93 {
      body.push_str(self.class_atom(93))
      self.bump
    }
    while self.at < self.len && self.peek != 93 {
      c = self.peek
      if c == 92 {
        self.bump
        if !self.class_escape(body) {
          return ""
        }
      } else if self.at + 2 < self.len && self.s[self.at + 1] == 45 && self.s[self.at + 2] != 93 {
        a = c
        b = self.s[self.at + 2]
        self.at += 3
        body.push_str(self.class_atom(a))
        body.push_byte(45)
        body.push_str(self.class_atom(b))
        oa = self.other_case(a)
        ob = self.other_case(b)
        if oa != a && ob != b {
          body.push_str(self.class_atom(oa))
          body.push_byte(45)
          body.push_str(self.class_atom(ob))
        }
      } else {
        self.bump
        self.push_class_char(body, c)
      }
    }
    if self.peek != 93 {
      self.fail("unclosed class")
      return ""
    }
    self.bump
    if neg {
      return "[^${body.to_s}]"
    }
    "[${body.to_s}]"
  }

  pub fn read_digits: String {
    buf = buf_new()
    while self.peek >= 48 && self.peek <= 57 {
      buf.push_byte(self.peek)
      self.bump
    }
    buf.to_s
  }

  pub fn take_quant: String {
    self.nongreedy = false
    c = self.peek
    if c == 42 || c == 43 {
      self.bump
      if self.peek == 63 {
        self.bump
        self.nongreedy = true
      } else if self.peek == 43 {
        self.fail("possessive")
      }
      return chr(c)
    }
    if c == 63 {
      self.bump
      if self.peek == 63 {
        self.bump
        self.nongreedy = true
      }
      return "?"
    }
    if c == 123 {
      self.bump
      n = self.read_digits()
      if n.size == 0 {
        self.fail("bad repetition")
        return ""
      }
      if self.peek == 125 {
        self.bump
        if self.peek == 63 {
          self.bump
          self.nongreedy = true
        }
        return "{${n}}"
      }
      if self.peek == 44 {
        self.bump
        if self.peek == 125 {
          self.bump
          if self.peek == 63 {
            self.bump
            self.nongreedy = true
          }
          return "{${n},}"
        }
        m = self.read_digits()
        if m.size == 0 {
          self.fail("bad repetition")
          return ""
        }
        if self.peek != 125 {
          self.fail("bad repetition")
          return ""
        }
        self.bump
        if self.peek == 63 {
          self.bump
          self.nongreedy = true
        }
        return "{${n},${m}}"
      }
      self.fail("bad repetition")
      return ""
    }
    ""
  }

  pub fn escape_atom: String {
    if self.at >= self.len {
      self.fail("truncated escape")
      return ""
    }
    c = self.peek
    self.bump
    if c >= 48 && c <= 57 {
      self.fail("backreference")
      return ""
    }
    if c == 100 {
      return "R[0-9]"
    }
    if c == 68 {
      return "R[^0-9]"
    }
    if c == 119 {
      return "R[0-9A-Za-z_]"
    }
    if c == 87 {
      return "R[^0-9A-Za-z_]"
    }
    if c == 115 {
      return "R[ \\t\\n\\r\\f\\v]"
    }
    if c == 83 {
      return "R[^ \\t\\n\\r\\f\\v]"
    }
    if c == 98 || c == 66 {
      self.fail("word boundary")
      return ""
    }
    if c == 110 {
      return "L" + chr(10)
    }
    if c == 114 {
      return "L" + chr(13)
    }
    if c == 116 {
      return "L" + chr(9)
    }
    "L" + chr(c)
  }

  pub fn parse_alt: Array(String) {
    empty: Array(String) = []
    if self.bad {
      return empty
    }
    left = self.parse_concat()
    if self.peek != 124 {
      return left
    }
    acc = self.fold(left)
    while self.peek == 124 {
      self.bump
      right = self.fold(self.parse_concat())
      if self.bad {
        return empty
      }
      acc = "${acc} | ${right}"
    }
    one: Array(String) = []
    one.push("R${acc}")
    one
  }

  pub fn parse_concat: Array(String) {
    parts: Array(String) = []
    while self.at < self.len {
      c = self.peek
      if c == 124 || c == 41 {
        return parts
      }
      parts.push(self.parse_repeat())
      if self.bad {
        return parts
      }
    }
    parts
  }

  pub fn parse_repeat: String {
    atom = self.parse_atom()
    if self.bad {
      return ""
    }
    q = self.take_quant()
    if self.bad {
      return ""
    }
    if q.size == 0 {
      return atom
    }
    if self.nongreedy {
      if atom == "R." {
        if q == "*" {
          return "n"
        }
      }
      self.fail("non-greedy")
      return ""
    }
    if atom == "n" || atom == "N" {
      self.fail("non-greedy")
      return ""
    }
    if atom.size > 0 && atom[0] == 76 {
      raw = str_slice(atom, 1, atom.size)
      return "R${self.quote_lit(raw)}${q}"
    }
    if atom.size > 0 && atom[0] == 82 {
      raw = str_slice(atom, 1, atom.size)
      return "R${raw}${q}"
    }
    self.fail("bad quantifier")
    ""
  }

  pub fn parse_atom: String {
    c = self.peek
    if c == 0 {
      self.fail("empty atom")
      return ""
    }
    if c == 46 {
      self.bump
      return "R."
    }
    if c == 91 {
      cls = self.parse_class()
      if self.bad {
        return ""
      }
      return "R${cls}"
    }
    if c == 40 {
      return self.parse_group()
    }
    if c == 92 {
      self.bump
      return self.escape_atom()
    }
    if c == 41 || c == 124 {
      self.fail("empty atom")
      return ""
    }
    self.bump
    "L" + chr(c)
  }

  pub fn parse_group: String {
    self.bump
    cap = true
    if self.peek == 63 {
      self.bump
      if self.peek == 58 {
        self.bump
        cap = false
      } else {
        self.fail("lookaround")
        return ""
      }
    }
    inner = self.parse_alt()
    if self.peek != 41 {
      self.fail("unclosed group")
      return ""
    }
    self.bump
    if inner.size == 1 {
      if inner[0] == "n" {
        if cap {
          return "N"
        }
        return "n"
      }
    }
    folded = self.fold(inner)
    if self.bad {
      return ""
    }
    if cap {
      return "R(${folded})"
    }
    "R(!${folded})"
  }

  pub fn until_lit(raw: String): String {
    if raw.size == 0 || raw.size > 2 {
      self.fail("non-greedy")
      return ""
    }
    i = 0
    while i < raw.size {
      if raw[i] == 10 {
        self.fail("non-greedy")
        return ""
      }
      i += 1
    }
    if raw.size == 1 {
      one = self.class_atom(raw[0])
      extra = ""
      other = self.other_case(raw[0])
      if other != raw[0] {
        extra = self.class_atom(other)
      }
      return "[^${one}${extra}\\n]*"
    }
    ch = raw[0]
    ch2 = raw[1]
    quoted = self.quote_lit(chr(ch))
    ca = self.class_atom(ch)
    cb = self.class_atom(ch2)
    ea = ""
    eb = ""
    oa = self.other_case(ch)
    ob = self.other_case(ch2)
    if oa != ch {
      ea = self.class_atom(oa)
    }
    if ob != ch2 {
      eb = self.class_atom(ob)
    }
    "([^${ca}${ea}\\n] | ${quoted} [^${cb}${eb}\\n])*"
  }

  pub fn fold(parts: Array(String)): String {
    if self.bad {
      return ""
    }
    merged: Array(String) = []
    i = 0
    while i < parts.size {
      p = parts[i]
      if p.size > 0 {
        if p[0] == 76 {
          acc = str_slice(p, 1, p.size)
          i += 1
          while i < parts.size {
            q = parts[i]
            if q.size > 0 {
              if q[0] == 76 {
                acc = acc + str_slice(q, 1, q.size)
                i += 1
              } else {
                break
              }
            } else {
              break
            }
          }
          merged.push("L${acc}")
        } else {
          merged.push(p)
          i += 1
        }
      } else {
        self.fail("empty piece")
        return ""
      }
    }
    out = buf_new()
    i = 0
    while i < merged.size {
      p = merged[i]
      if p == "n" || p == "N" {
        if i + 1 >= merged.size {
          self.fail("non-greedy")
          return ""
        }
        nxt = merged[i + 1]
        if nxt.size == 0 || nxt[0] != 76 {
          self.fail("non-greedy")
          return ""
        }
        lit = str_slice(nxt, 1, nxt.size)
        mid = self.until_lit(lit)
        if self.bad {
          return ""
        }
        if p == "N" {
          out.push_str("(${mid}) ")
        } else {
          out.push_str("${mid} ")
        }
        out.push_str(self.quote_lit(lit))
        out.push_byte(32)
        i += 2
      } else if p[0] == 76 {
        out.push_str(self.quote_lit(str_slice(p, 1, p.size)))
        out.push_byte(32)
        i += 1
      } else if p[0] == 82 {
        out.push_str(str_slice(p, 1, p.size))
        out.push_byte(32)
        i += 1
      } else {
        self.fail("bad piece")
        return ""
      }
    }
    out.to_s
  }

  pub fn translate(pat: String, caseless: Int): String {
    self.s = pat
    self.len = pat.size
    self.at = 0
    self.caseless = caseless
    self.bad = false
    self.why = ""
    if pat.size == 0 {
      self.fail("empty pattern")
      return ""
    }
    parts = self.parse_alt()
    if self.bad {
      return ""
    }
    if self.at != self.len {
      self.fail("unparsed tail")
      return ""
    }
    got = self.fold(parts)
    if self.bad {
      return ""
    }
    if got.size == 0 {
      self.fail("empty pattern")
      return ""
    }
    got
  }
}

pub fn re2c_key(pat: String, flags: Int): String {
  "${flags}\n${pat}"
}

pub fn body_has_capture(body: String): Bool {
  i = 0
  while i < body.size {
    if body[i] == 40 {
      return true
    }
    i += 1
  }
  false
}

pub fn re2c_show(pat: String): String {
  if pat.size > 48 {
    return str_slice(pat, 0, 48)
  }
  pat
}

pub class Re2cCollect {
  ids: Hash(String, Int)
  pats: Array(String)
  flags: Array(Int)
  groups: Array(Int)
  bodies: Array(String)

  fn initialize {
    h = Hash(String, Int).new
    self.ids = h
    self.pats = []
    self.flags = []
    self.groups = []
    self.bodies = []
  }

  pub fn note_pat(pat: String, flags: Int) {
    if !(flags == 0 || flags == 1) {
      return
    }
    key = re2c_key(pat, flags)
    if id = self.ids.get(key) {
      return
    }
    ngroups = re2c_capture_groups(pat)
    if ngroups < 0 {
      puts("re2c: pattern stays on PCRE2 (capture groups beyond the first): ${re2c_show(pat)}")
      return
    }
    tr = RePat.new
    body = tr.translate(pat, flags)
    if tr.bad {
      puts("re2c: pattern stays on PCRE2 (${tr.why}): ${re2c_show(pat)}")
      return
    }
    self.pats.push(pat)
    self.flags.push(flags)
    self.groups.push(ngroups)
    self.bodies.push(body)
    self.ids[key] = self.pats.size
  }

  pub fn note_call(expr: Expr) {
    if expr.type_call {
      if expr.resolved == "Regex__compile" {
        if expr.args.size >= 1 {
          pat = expr.args[0]
          if pat.kind == ex_string() {
            fv = 0
            ok = true
            if expr.args.size >= 2 {
              fl = expr.args[1]
              if fl.kind == ex_bool() {
                if fl.bool_val {
                  fv = 1
                }
              } else if fl.kind == ex_int() && fl.int_bits <= 2147483647u64 {
                fv = fl.int_bits.to_i
              } else {
                ok = false
              }
            }
            if ok {
              self.note_pat(pat.value_str, fv)
            }
          }
        }
      }
    }
  }

  pub fn walk_expr(expr: Expr) {
    if expr.kind == ex_call() {
      self.note_call(expr)
    }
    if a = expr.left {
      self.walk_expr(a)
    }
    if a = expr.right {
      self.walk_expr(a)
    }
    if a = expr.object {
      self.walk_expr(a)
    }
    if a = expr.cond {
      self.walk_expr(a)
    }
    if a = expr.receiver {
      self.walk_expr(a)
    }
    if a = expr.inner {
      self.walk_expr(a)
    }
    if a = expr.size_expr {
      self.walk_expr(a)
    }
    i = 0
    while i < expr.args.size {
      self.walk_expr(expr.args[i])
      i += 1
    }
    i = 0
    while i < expr.elems.size {
      self.walk_expr(expr.elems[i])
      i += 1
    }
    i = 0
    while i < expr.field_exprs.size {
      self.walk_expr(expr.field_exprs[i])
      i += 1
    }
    for part in expr.parts {
      if inner = part.expr {
        self.walk_expr(inner)
      }
    }
    i = 0
    while i < expr.cases.size {
      self.walk_stmts(expr.cases[i].body)
      i += 1
    }
    if b = expr.block {
      self.walk_stmts(b.body)
    }
  }

  pub fn walk_stmts(body: Array(Stmt)) {
    for stmt in body {
      if e = stmt.expr {
        self.walk_expr(e)
      }
      if e = stmt.value {
        self.walk_expr(e)
      }
      if e = stmt.target {
        self.walk_expr(e)
      }
      if e = stmt.cond {
        self.walk_expr(e)
      }
      self.walk_stmts(stmt.then_body)
      self.walk_stmts(stmt.else_body)
      self.walk_stmts(stmt.body)
    }
  }

  pub fn walk_fns(fns: Array(Function)) {
    i = 0
    while i < fns.size {
      self.walk_stmts(fns[i].body)
      i += 1
    }
  }

  pub fn source: String {
    buf = buf_new()
    buf.push_str("#include \"avant_rt.h\"\n")
    buf.push_str("#include <stddef.h>\n")
    buf.push_str("#include <stdint.h>\n\n")
    buf.push_str("/*!maxnmatch:re2c*/\n\n")
    any_cap = false
    for bd in self.bodies {
      if body_has_capture(bd) {
        any_cap = true
      }
    }
    for i in 0..self.bodies.size {
      id = i + 1
      body = self.bodies[i]
      cap = body_has_capture(body)
      buf.push_str("static int32_t avant_re2c_find_${id}(const char *s, int32_t from, int32_t *m0, int32_t *m1, int32_t *c0, int32_t *c1) {\n")
      buf.push_str("  size_t n = avant_str_n(s ? s : \"\");\n")
      buf.push_str("  if (!s) s = \"\";\n")
      buf.push_str("  if (from < 0) from = 0;\n")
      buf.push_str("  if ((size_t)from > n) return 0;\n")
      buf.push_str("  const char *base = s;\n")
      buf.push_str("  const char *YYCURSOR = s + from, *YYMARKER = YYCURSOR, *YYLIMIT = s + n;\n")
      if any_cap {
        buf.push_str("  const char *yypmatch[YYMAXNMATCH * 2];\n")
        buf.push_str("  size_t yynmatch = 0;\n")
        buf.push_str("  /*!stags:re2c format = 'const char *@@;\\n'; */\n")
      }
      buf.push_str("  for (;;) {\n")
      buf.push_str("    const char *start = YYCURSOR;\n")
      buf.push_str("    /*!re2c\n")
      buf.push_str("      re2c:yyfill:enable = 0;\n")
      buf.push_str("      re2c:define:YYCTYPE = \"unsigned char\";\n")
      if any_cap {
        buf.push_str("      re2c:posix-captures = 1;\n")
      }
      buf.push_str("\n      ${body} {\n")
      if cap {
        buf.push_str("        if (yynmatch > 0 && yypmatch[0] && yypmatch[1]) {\n")
        buf.push_str("          *m0 = (int32_t)(yypmatch[0] - base);\n")
        buf.push_str("          *m1 = (int32_t)(yypmatch[1] - base);\n")
        buf.push_str("        } else {\n")
        buf.push_str("          *m0 = (int32_t)(start - base);\n")
        buf.push_str("          *m1 = (int32_t)(YYCURSOR - base);\n")
        buf.push_str("        }\n")
        buf.push_str("        if (yynmatch > 1 && yypmatch[2] && yypmatch[3]) {\n")
        buf.push_str("          *c0 = (int32_t)(yypmatch[2] - base);\n")
        buf.push_str("          *c1 = (int32_t)(yypmatch[3] - base);\n")
        buf.push_str("        } else {\n")
        buf.push_str("          *c0 = *m0;\n")
        buf.push_str("          *c1 = *m1;\n")
        buf.push_str("        }\n")
      } else {
        buf.push_str("        *m0 = (int32_t)(start - base);\n")
        buf.push_str("        *m1 = (int32_t)(YYCURSOR - base);\n")
        buf.push_str("        *c0 = *m0;\n")
        buf.push_str("        *c1 = *m1;\n")
      }
      buf.push_str("        return 1;\n")
      buf.push_str("      }\n")
      buf.push_str("      * { continue; }\n")
      buf.push_str("      [\\x00] { return 0; }\n")
      buf.push_str("    */\n")
      buf.push_str("  }\n")
      buf.push_str("}\n\n")
      buf.push_str("static int32_t avant_re2c_scan_${id}(const char *s) {\n")
      buf.push_str("  size_t n = avant_str_n(s ? s : \"\");\n")
      buf.push_str("  if (!s) s = \"\";\n")
      buf.push_str("  const char *YYCURSOR = s, *YYMARKER = YYCURSOR, *YYLIMIT = s + n;\n")
      if any_cap {
        buf.push_str("  const char *yypmatch[YYMAXNMATCH * 2];\n")
        buf.push_str("  size_t yynmatch = 0;\n")
        buf.push_str("  /*!stags:re2c format = 'const char *@@;\\n'; */\n")
      }
      buf.push_str("  int32_t nmatch = 0;\n")
      buf.push_str("  for (;;) {\n")
      buf.push_str("    const char *start = YYCURSOR;\n")
      buf.push_str("    /*!re2c\n")
      buf.push_str("      re2c:yyfill:enable = 0;\n")
      buf.push_str("      re2c:define:YYCTYPE = \"unsigned char\";\n")
      if any_cap {
        buf.push_str("      re2c:posix-captures = 1;\n")
      }
      buf.push_str("\n")
      buf.push_str("      ${body} {\n")
      buf.push_str("        nmatch++;\n")
      buf.push_str("        if (YYCURSOR == start) YYCURSOR++;\n")
      buf.push_str("        continue;\n")
      buf.push_str("      }\n")
      buf.push_str("      * { continue; }\n")
      buf.push_str("      [\\x00] { return nmatch; }\n")
      buf.push_str("    */\n")
      buf.push_str("  }\n")
      buf.push_str("}\n\n")
    }
    n = self.bodies.size
    buf.push_str("int32_t avant_re2c_owns(void *re) {\n")
    buf.push_str("  uintptr_t t = (uintptr_t)re;\n")
    buf.push_str("  return t >= 1 && t <= ${n};\n")
    buf.push_str("}\n\n")
    buf.push_str("void *avant_re2c_handle(int32_t id) {\n")
    buf.push_str("  return (void *)(uintptr_t)id;\n")
    buf.push_str("}\n\n")
    buf.push_str("int32_t avant_re2c_find_into(void *re, const char *s, int32_t from, int32_t *spans, int32_t max_pairs) {\n")
    buf.push_str("  int32_t id = (int32_t)(uintptr_t)re;\n")
    buf.push_str("  int32_t m0 = 0, m1 = 0, c0 = 0, c1 = 0, rc = 0;\n")
    buf.push_str("  if (!s) s = \"\";\n")
    buf.push_str("  switch (id) {\n")
    for i in 0..self.bodies.size {
      id = i + 1
      buf.push_str("    case ${id}: rc = avant_re2c_find_${id}(s, from, &m0, &m1, &c0, &c1); break;\n")
    }
    buf.push_str("    default: return 0;\n")
    buf.push_str("  }\n")
    buf.push_str("  if (rc && spans && max_pairs > 0) {\n")
    buf.push_str("    spans[0] = m0;\n")
    buf.push_str("    spans[1] = m1;\n")
    buf.push_str("    if (max_pairs > 1) {\n")
    buf.push_str("      spans[2] = c0;\n")
    buf.push_str("      spans[3] = c1;\n")
    buf.push_str("    }\n")
    buf.push_str("  }\n")
    buf.push_str("  return rc;\n")
    buf.push_str("}\n\n")
    buf.push_str("int32_t avant_re2c_groups(int32_t id) {\n")
    buf.push_str("  switch (id) {\n")
    for i in 0..self.bodies.size {
      id = i + 1
      buf.push_str("    case ${id}: return ${self.groups[i]};\n")
    }
    buf.push_str("    default: return 0;\n")
    buf.push_str("  }\n")
    buf.push_str("}\n\n")
    buf.push_str("int32_t avant_re2c_count(int32_t id, const char *s) {\n")
    buf.push_str("  switch (id) {\n")
    for i in 0..self.bodies.size {
      id = i + 1
      buf.push_str("    case ${id}: return avant_re2c_scan_${id}(s);\n")
    }
    buf.push_str("    default: return 0;\n")
    buf.push_str("  }\n")
    buf.push_str("}\n")
    buf.to_s
  }
}

pub fn re2c_plan(program: Program): Re2cPlan {
  plan = Re2cPlan.new
  col = Re2cCollect.new
  col.walk_fns(program.functions)
  for cls in program.classes {
    col.walk_fns(cls.methods)
  }
  for sdef in program.structs {
    col.walk_fns(sdef.methods)
  }
  if col.pats.size == 0 {
    return plan
  }
  plan.ids = col.ids
  plan.groups = col.groups
  plan.count = col.pats.size
  plan.src = col.source
  plan
}
