import checker

pub fn (checker_self: Checker) nn_has(name: String): Bool {
  checker_self.facts.nn_var.contains(name)
}

// A name a lambda assigns (lam_written) changes whenever code that may
// call the lambda runs: no fact about its value holds.
pub fn (checker_self: Checker) lw_has(name: String): Bool {
  checker_self.facts.lam_written.contains(name)
}

pub fn (checker_self: Checker) nn_add(name: String) {
  if checker_self.nn_has(name) || checker_self.lw_has(name) {
    return
  }
  checker_self.facts.nn_var.push(name)
}

pub fn (checker_self: Checker) nn_remove(name: String) {
  kept: Array(String) = []
  for i in 0..checker_self.facts.nn_var.size {
    if checker_self.facts.nn_var[i] != name {
      kept.push(checker_self.facts.nn_var[i])
    }
  }
  checker_self.facts.nn_var = kept
}

pub fn (checker_self: Checker) annotate_vstep(prev: Stmt, stmt: Stmt) {
  if prev.kind != st_assign() {
    return
  }
  if prev.op != tk_eq() {
    return
  }
  if t = prev.target, v = prev.value, t.kind == ex_name() && v.kind == ex_int() && v.int_bits <= 1000000u64 {
    ivar = t.ident
    if c = stmt.cond {
      cc = c
      if cc.kind == ex_binary() && cc.op == tk_amp_amp() {
        if cl0 = cc.left {
          cc = cl0
        }
      }
      if cc.kind == ex_binary() {
        is_le = false
        coff = 0
        matched = false
        if cc.op == tk_less() || cc.op == tk_less_eq() {
          if cc.op == tk_less_eq() {
            is_le = true
          }
          if cl = cc.left {
            if cl.kind == ex_name() {
              if cl.ident == ivar {
                matched = true
              }
            } else if cl.kind == ex_binary() {
              if cl.op == tk_plus() {
                if cll = cl.left, clr = cl.right {
                  if cll.kind == ex_name() && cll.ident == ivar && checker_self.lit_small(clr) {
                    coff = clr.int_bits.to_i()
                    matched = true
                  }
                  if clr.kind == ex_name() && clr.ident == ivar && checker_self.lit_small(cll) {
                    coff = cll.int_bits.to_i()
                    matched = true
                  }
                }
              }
            }
          }
        }
        if matched {
          step = checker_self.body_vstep(stmt.body, ivar)
          if step > 0 {
            stmt.vstep = step
            stmt.vstart = v.int_bits.to_i()
            stmt.vle = is_le
            stmt.vcoff = coff
          }
        }
      }
    }
  }
}

pub fn (checker_self: Checker) body_vstep(body: Array(Stmt), ivar: String): Int {
  step = -1
  i = 0
  while i < body.size {
    got = checker_self.stmt_vstep(body[i], ivar)
    if got == 0 - 2 {
      return -1
    }
    if got > 0 {
      if step < 0 {
        step = got
      } else if step != got {
        return -1
      }
    }
    i += 1
  }
  step
}

pub fn (checker_self: Checker) stmt_vstep(s: Stmt, ivar: String): Int {
  if s.kind == st_assign() {
    if t = s.target, t.kind == ex_name() && t.ident == ivar {
      if s.op == tk_plus_eq() {
        if v = s.value, v.kind == ex_int() && v.int_bits >= 1u64 && v.int_bits <= 1000000u64 {
          return v.int_bits.to_i()
        }
        return 0 - 2
      }
      if s.op == tk_eq() {
        if v = s.value, v.kind == ex_binary() && v.op == tk_plus(), l = v.left, r = v.right {
          if l.kind == ex_name() && l.ident == ivar && r.kind == ex_int() && r.int_bits >= 1u64 && r.int_bits <= 1000000u64 {
            return r.int_bits.to_i()
          }
          if r.kind == ex_name() && r.ident == ivar && l.kind == ex_int() && l.int_bits >= 1u64 && l.int_bits <= 1000000u64 {
            return l.int_bits.to_i()
          }
        }
        return 0 - 2
      }
      return 0 - 2
    }
  }
  for st in s.then_body {
    got = checker_self.stmt_vstep(st, ivar)
    if got == 0 - 2 {
      return 0 - 2
    }
    if got > 0 {
      return got
    }
  }
  for st in s.else_body {
    got = checker_self.stmt_vstep(st, ivar)
    if got == 0 - 2 {
      return 0 - 2
    }
    if got > 0 {
      return got
    }
  }
  for st in s.body {
    got = checker_self.stmt_vstep(st, ivar)
    if got == 0 - 2 {
      return 0 - 2
    }
    if got > 0 {
      return got
    }
  }
  -1
}

pub fn (checker_self: Checker) sv_put(v: String, cont: String, st: Int) {
  if checker_self.lw_has(v) {
    checker_self.sv_remove_var(v)
    return
  }
  for i in 0..checker_self.facts.sv_var.size {
    if checker_self.facts.sv_var[i] == v {
      checker_self.facts.sv_cont[i] = cont
      checker_self.facts.sv_stamp[i] = st
      return
    }
  }
  checker_self.facts.sv_var.push(v)
  checker_self.facts.sv_cont.push(cont)
  checker_self.facts.sv_stamp.push(st)
}

pub fn (checker_self: Checker) sv_get(v: String): String {
  for i in 0..checker_self.facts.sv_var.size {
    if checker_self.facts.sv_var[i] == v {
      return checker_self.facts.sv_cont[i]
    }
  }
  ""
}

pub fn (checker_self: Checker) sv_remove_var(v: String) {
  kept_v: Array(String) = []
  kept_c: Array(String) = []
  kept_s: Array(Int) = []
  for i in 0..checker_self.facts.sv_var.size {
    if checker_self.facts.sv_var[i] != v {
      kept_v.push(checker_self.facts.sv_var[i])
      kept_c.push(checker_self.facts.sv_cont[i])
      kept_s.push(checker_self.facts.sv_stamp[i])
    }
  }
  checker_self.facts.sv_var = kept_v
  checker_self.facts.sv_cont = kept_c
  checker_self.facts.sv_stamp = kept_s
}

// The live fact bounding v by cont's size with the most slack, or -1.
pub fn (checker_self: Checker) fact_best(v: String, cont: String): Int {
  best = -1
  at = -1
  for i in 0..checker_self.facts.fact_var.size {
    if checker_self.facts.fact_live[i] == 1 && checker_self.facts.fact_var[i] == v && checker_self.facts.fact_cont[i] == cont && checker_self.facts.fact_slack[i] > best {
      best = checker_self.facts.fact_slack[i]
      at = i
    }
  }
  at
}

// An index e proven by fact fi: logged, so a later shrink can take the
// proof back (Anchors, above).
pub fn (checker_self: Checker) log_use(fi: Int, e: Expr) {
  checker_self.facts.use_cont.push(checker_self.facts.fact_cont[fi])
  checker_self.facts.use_cty.push(checker_self.facts.fact_cty[fi])
  checker_self.facts.use_anchor.push(checker_self.facts.fact_anchor[fi])
  checker_self.facts.use_expr.push(e)
}

pub fn (checker_self: Checker) fact_slack_of(v: String, cont: String): Int {
  best = -1
  for i in 0..checker_self.facts.fact_var.size {
    if checker_self.facts.fact_live[i] == 1 && checker_self.facts.fact_var[i] == v && checker_self.facts.fact_cont[i] == cont && checker_self.facts.fact_slack[i] > best {
      best = checker_self.facts.fact_slack[i]
    }
  }
  best
}

// Any fact on v, for the arithmetic it proves (`i + 1` cannot overflow
// when i < some size): a fact whose container may have shrunk (live 2)
// still bounds i by the size it was read with.
pub fn (checker_self: Checker) fact_any_slack(v: String): Int {
  best = -1
  for i in 0..checker_self.facts.fact_var.size {
    if checker_self.facts.fact_live[i] >= 1 && checker_self.facts.fact_var[i] == v && checker_self.facts.fact_slack[i] > best {
      best = checker_self.facts.fact_slack[i]
    }
  }
  best
}

pub fn (checker_self: Checker) kill_facts_for(v: String) {
  for i in 0..checker_self.facts.fact_var.size {
    if checker_self.facts.fact_var[i] == v {
      checker_self.facts.fact_live[i] = 0
    }
    if checker_self.facts.fact_cont[i] == v {
      checker_self.facts.fact_live[i] = 0
    }
  }
  // v names another container now: no size relation about it holds, and
  // a loop around this assignment reads the new one with the old bound.
  checker_self.remove_relations_of(v)
  if t = checker_self.lookup(v), t.is_array() || t.is_buf() {
    checker_self.facts.kill_cont.push(v)
  }
}

pub fn (checker_self: Checker) bv_put(v: String, cont: String, delta: Int, st: Int) {
  if checker_self.lw_has(v) {
    checker_self.bv_remove_var(v)
    return
  }
  for i in 0..checker_self.facts.bv_var.size {
    if checker_self.facts.bv_var[i] == v {
      checker_self.facts.bv_cont[i] = cont
      checker_self.facts.bv_delta[i] = delta
      checker_self.facts.bv_stamp[i] = st
      return
    }
  }
  checker_self.facts.bv_var.push(v)
  checker_self.facts.bv_cont.push(cont)
  checker_self.facts.bv_delta.push(delta)
  checker_self.facts.bv_stamp.push(st)
}

pub fn (checker_self: Checker) bv_get(v: String): String {
  for i in 0..checker_self.facts.bv_var.size {
    if checker_self.facts.bv_var[i] == v {
      return checker_self.facts.bv_cont[i]
    }
  }
  ""
}

pub fn (checker_self: Checker) bv_delta_of(v: String): Int {
  for i in 0..checker_self.facts.bv_var.size {
    if checker_self.facts.bv_var[i] == v {
      return checker_self.facts.bv_delta[i]
    }
  }
  0
}

pub fn (checker_self: Checker) bv_remove_var(v: String) {
  kept_v: Array(String) = []
  kept_c: Array(String) = []
  kept_d: Array(Int) = []
  kept_s: Array(Int) = []
  for i in 0..checker_self.facts.bv_var.size {
    if checker_self.facts.bv_var[i] != v {
      kept_v.push(checker_self.facts.bv_var[i])
      kept_c.push(checker_self.facts.bv_cont[i])
      kept_d.push(checker_self.facts.bv_delta[i])
      kept_s.push(checker_self.facts.bv_stamp[i])
    }
  }
  checker_self.facts.bv_var = kept_v
  checker_self.facts.bv_cont = kept_c
  checker_self.facts.bv_delta = kept_d
  checker_self.facts.bv_stamp = kept_s
}

pub fn (checker_self: Checker) cs_put(cont: String, v: String, delta: Int, st: Int) {
  if checker_self.lw_has(v) {
    return
  }
  for i in 0..checker_self.facts.cs_cont.size {
    if checker_self.facts.cs_cont[i] == cont {
      checker_self.facts.cs_var[i] = v
      checker_self.facts.cs_delta[i] = delta
      checker_self.facts.cs_stamp[i] = st
      return
    }
  }
  checker_self.facts.cs_cont.push(cont)
  checker_self.facts.cs_var.push(v)
  checker_self.facts.cs_delta.push(delta)
  checker_self.facts.cs_stamp.push(st)
}

pub fn (checker_self: Checker) cs_cont_of_var(v: String): String {
  for i in 0..checker_self.facts.cs_var.size {
    if checker_self.facts.cs_var[i] == v {
      return checker_self.facts.cs_cont[i]
    }
  }
  ""
}

pub fn (checker_self: Checker) cs_delta_of_var(v: String): Int {
  for i in 0..checker_self.facts.cs_var.size {
    if checker_self.facts.cs_var[i] == v {
      return checker_self.facts.cs_delta[i]
    }
  }
  0
}

// Anchors. A bounds fact `i < xs.size - k` holds while xs keeps the size
// it had where that size was read: at the fact's own condition when the
// bound is `xs.size` there, else where a size relation was made
// (`n = xs.size`, `xs = Array(T).new(n)`). Each such read takes a stamp,
// increasing through the function, and the fact keeps it (fact_anchor).
// Every index the fact proves is logged with the container, its type and
// that stamp (use_*), and every container whose size a statement may have
// changed is logged too (kill_cont), so that:
// - a statement that may shrink xs (a pop or clear on any array of xs's
//   type, a call that may reach xs, an assignment to xs) ends its facts
//   and size relations for the statements after it, and takes back the
//   proofs it made itself, its own parts being evaluated in an order
//   these facts do not follow;
// - a loop whose body may shrink xs takes back every proof inside it that
//   rests on a size read before the loop: the next iteration reads after
//   the shrink (loop_region_end).
pub fn (checker_self: Checker) next_stamp: Int {
  checker_self.facts.stamp += 1
  checker_self.facts.stamp
}

pub fn (checker_self: Checker) sv_stamp_of(v: String): Int {
  for i in 0..checker_self.facts.sv_var.size {
    if checker_self.facts.sv_var[i] == v {
      return checker_self.facts.sv_stamp[i]
    }
  }
  0
}

pub fn (checker_self: Checker) bv_stamp_of(v: String): Int {
  for i in 0..checker_self.facts.bv_var.size {
    if checker_self.facts.bv_var[i] == v {
      return checker_self.facts.bv_stamp[i]
    }
  }
  0
}

pub fn (checker_self: Checker) cs_stamp_of_var(v: String): Int {
  for i in 0..checker_self.facts.cs_var.size {
    if checker_self.facts.cs_var[i] == v {
      return checker_self.facts.cs_stamp[i]
    }
  }
  0
}

// The size relations that name v as the size (cs: `xs = Array(T).new(v)`),
// dropped when v is assigned anew.
pub fn (checker_self: Checker) cs_remove_var(v: String) {
  kept_c: Array(String) = []
  kept_v: Array(String) = []
  kept_d: Array(Int) = []
  kept_s: Array(Int) = []
  for i in 0..checker_self.facts.cs_var.size {
    if checker_self.facts.cs_var[i] != v {
      kept_c.push(checker_self.facts.cs_cont[i])
      kept_v.push(checker_self.facts.cs_var[i])
      kept_d.push(checker_self.facts.cs_delta[i])
      kept_s.push(checker_self.facts.cs_stamp[i])
    }
  }
  checker_self.facts.cs_cont = kept_c
  checker_self.facts.cs_var = kept_v
  checker_self.facts.cs_delta = kept_d
  checker_self.facts.cs_stamp = kept_s
}

// Every size relation about the container cont: its size may have
// changed, so `n == cont.size` (sv, bv) and `cont.size == n` (cs) no
// longer hold.
pub fn (checker_self: Checker) remove_relations_of(cont: String) {
  sv_v: Array(String) = []
  sv_c: Array(String) = []
  sv_s: Array(Int) = []
  for i in 0..checker_self.facts.sv_var.size {
    if checker_self.facts.sv_cont[i] != cont {
      sv_v.push(checker_self.facts.sv_var[i])
      sv_c.push(checker_self.facts.sv_cont[i])
      sv_s.push(checker_self.facts.sv_stamp[i])
    }
  }
  checker_self.facts.sv_var = sv_v
  checker_self.facts.sv_cont = sv_c
  checker_self.facts.sv_stamp = sv_s
  bv_v: Array(String) = []
  bv_c: Array(String) = []
  bv_d: Array(Int) = []
  bv_s: Array(Int) = []
  for i in 0..checker_self.facts.bv_var.size {
    if checker_self.facts.bv_cont[i] != cont {
      bv_v.push(checker_self.facts.bv_var[i])
      bv_c.push(checker_self.facts.bv_cont[i])
      bv_d.push(checker_self.facts.bv_delta[i])
      bv_s.push(checker_self.facts.bv_stamp[i])
    }
  }
  checker_self.facts.bv_var = bv_v
  checker_self.facts.bv_cont = bv_c
  checker_self.facts.bv_delta = bv_d
  checker_self.facts.bv_stamp = bv_s
  cs_c: Array(String) = []
  cs_v: Array(String) = []
  cs_d: Array(Int) = []
  cs_s: Array(Int) = []
  for i in 0..checker_self.facts.cs_cont.size {
    if checker_self.facts.cs_cont[i] != cont {
      cs_c.push(checker_self.facts.cs_cont[i])
      cs_v.push(checker_self.facts.cs_var[i])
      cs_d.push(checker_self.facts.cs_delta[i])
      cs_s.push(checker_self.facts.cs_stamp[i])
    }
  }
  checker_self.facts.cs_cont = cs_c
  checker_self.facts.cs_var = cs_v
  checker_self.facts.cs_delta = cs_d
  checker_self.facts.cs_stamp = cs_s
}

// The stamp of the size read a bound rests on (bound_cont_of's cases):
// a fresh one for `xs.size` read here, the relation's for a name.
pub fn (checker_self: Checker) bound_anchor_of(e: Expr): Int {
  if e.kind == ex_field() {
    return checker_self.next_stamp()
  }
  if e.kind == ex_name() {
    got = checker_self.sv_get(e.ident)
    if got.size > 0 {
      return checker_self.sv_stamp_of(e.ident)
    }
    gotb = checker_self.bv_get(e.ident)
    if gotb.size > 0 {
      return checker_self.bv_stamp_of(e.ident)
    }
    return checker_self.cs_stamp_of_var(e.ident)
  }
  if e.kind == ex_binary() {
    if l = e.left {
      return checker_self.bound_anchor_of(l)
    }
  }
  0
}

pub fn (checker_self: Checker) bound_cont_of(e: Expr): String {
  if e.kind == ex_field() {
    if e.ident == "size" {
      if obj = e.object, obj.kind == ex_name() {
        if obj.implicit_field {
          return ""
        }
        return obj.ident
      }
    }
    return ""
  }
  if e.kind == ex_name() {
    got = checker_self.sv_get(e.ident)
    if got.size > 0 {
      return got
    }
    gotb = checker_self.bv_get(e.ident)
    if gotb.size > 0 {
      return gotb
    }
    return checker_self.cs_cont_of_var(e.ident)
  }
  if e.kind == ex_binary() && (e.op == tk_minus() || e.op == tk_plus()) {
    if l = e.left {
      return checker_self.bound_cont_of(l)
    }
  }
  ""
}

pub fn (checker_self: Checker) bound_delta_of(e: Expr): Int {
  if e.kind == ex_field() {
    return 0
  }
  if e.kind == ex_name() {
    got = checker_self.sv_get(e.ident)
    if got.size > 0 {
      return 0
    }
    bg = checker_self.bv_get(e.ident)
    if bg.size > 0 {
      return checker_self.bv_delta_of(e.ident)
    }
    cc = checker_self.cs_cont_of_var(e.ident)
    if cc.size > 0 {
      return 0 - checker_self.cs_delta_of_var(e.ident)
    }
    return 0
  }
  if e.kind == ex_binary() {
    if l = e.left, r = e.right {
      base = checker_self.bound_delta_of(l)
      if checker_self.lit_small(r) {
        if e.op == tk_minus() {
          return base - r.int_bits.to_i()
        }
        return base + r.int_bits.to_i()
      }
    }
  }
  0
}

pub fn (checker_self: Checker) lit_small(e: Expr): Bool {
  if e.kind == ex_int() {
    return e.int_bits <= 1000000u64
  }
  false
}

pub fn (checker_self: Checker) value_is_nonneg(val: Expr, selfname: String): Bool {
  if val.kind == ex_int() {
    return true
  }
  if val.kind == ex_field() {
    if val.ident == "size" {
      return true
    }
  }
  if val.kind == ex_name() {
    return checker_self.nn_has(val.ident)
  }
  if val.kind == ex_binary() {
    if val.op == tk_star() {
      if l = val.left, r = val.right {
        lok = false
        if l.kind == ex_int() {
          lok = true
        } else if l.kind == ex_name() {
          if checker_self.nn_has(l.ident) {
            lok = true
          }
        }
        rok = false
        if r.kind == ex_int() {
          rok = true
        } else if r.kind == ex_name() {
          if checker_self.nn_has(r.ident) {
            rok = true
          }
        }
        if lok {
          return rok
        }
        return false
      }
    }
    if val.op == tk_plus() || val.op == tk_minus() {
      if l = val.left, r = val.right {
        lok = false
        if l.kind == ex_int() {
          lok = true
        } else if l.kind == ex_name() {
          if checker_self.nn_has(l.ident) {
            lok = true
          }
          if l.ident == selfname && checker_self.nn_has(selfname) {
            lok = true
          }
        }
        rok = false
        if r.kind == ex_int() {
          rok = true
        } else if r.kind == ex_name() {
          if checker_self.nn_has(r.ident) {
            rok = true
          }
        }
        if val.op == tk_minus() {
          // `n - 3` is negative for n below 3.
          return false
        }
        if lok {
          return rok
        }
      }
    }
  }
  false
}

pub fn (checker_self: Checker) fact_after_stmt(stmt: Stmt) {
  if stmt.kind == st_assign() {
    if t = stmt.target, t.kind == ex_name() {
      v = t.ident
      checker_self.kill_facts_for(v)
      if stmt.op != tk_eq() {
        // `v += e` and the other updates: v's new value is not e, so no
        // relation of v's survives; v stays non-negative only through an
        // operator that traps instead of wrapping, from a non-negative v
        // and e.
        if val = stmt.value {
          keeps = stmt.op == tk_plus_eq() || stmt.op == tk_star_eq() || stmt.op == tk_slash_eq() || stmt.op == tk_percent_eq()
          if keeps && checker_self.nn_has(v) && checker_self.value_is_nonneg(val, v) {
            checker_self.nn_add(v)
          } else {
            checker_self.nn_remove(v)
          }
          checker_self.sv_remove_var(v)
          checker_self.bv_remove_var(v)
          checker_self.cs_remove_var(v)
          checker_self.cap_after_assign(v, stmt.op, val)
        }
      } else if val = stmt.value {
        if checker_self.value_is_nonneg(val, v) {
          checker_self.nn_add(v)
        } else {
          checker_self.nn_remove(v)
        }
        sv_done = false
        if val.kind == ex_field() {
          if val.ident == "size" {
            if obj = val.object, obj.kind == ex_name() {
              checker_self.sv_put(v, obj.ident, checker_self.next_stamp())
              sv_done = true
            }
          }
        }
        if val.kind == ex_array_new() {
          if sz = val.size_expr {
            if sz.kind == ex_name() {
              st = checker_self.next_stamp()
              checker_self.sv_put(sz.ident, v, st)
              checker_self.cs_put(v, sz.ident, 0, st)
              sv_done = true
            } else if sz.kind == ex_binary() {
              if sz.op == tk_plus() || sz.op == tk_minus() {
                if sl2 = sz.left, sr2 = sz.right {
                  if sl2.kind == ex_name() && checker_self.lit_small(sr2) {
                    d = sr2.int_bits.to_i()
                    if sz.op == tk_minus() {
                      d = 0 - d
                    }
                    checker_self.cs_put(v, sl2.ident, d, checker_self.next_stamp())
                  }
                  if sr2.kind == ex_name() && checker_self.lit_small(sl2) && sz.op == tk_plus() {
                    checker_self.cs_put(v, sr2.ident, sl2.int_bits.to_i(), checker_self.next_stamp())
                  }
                }
              }
            }
          }
        }
        if !sv_done {
          checker_self.sv_remove_var(v)
        }
        bc = checker_self.bound_cont_of(val)
        if bc.size > 0 {
          checker_self.bv_put(v, bc, checker_self.bound_delta_of(val), checker_self.bound_anchor_of(val))
        } else {
          checker_self.bv_remove_var(v)
        }
        // A relation `xs.size == v + d` is about v's old value.
        checker_self.cs_remove_var(v)
        checker_self.cap_after_assign(v, stmt.op, val)
      }
    }
  }
  checker_self.cap_kill_captures_stmt(stmt)
  for i in 0..checker_self.facts.fact_var.size {
    if checker_self.facts.fact_live[i] == 1 && checker_self.deep_shrinks_stmt(stmt, checker_self.facts.fact_cont[i]) {
      checker_self.facts.fact_live[i] = 0
    }
  }
}

pub fn (checker_self: Checker) deep_shrinks_stmt(s: Stmt, cont: String): Bool {
  if s.kind == st_assign() {
    if t = s.target, t.kind == ex_name() && t.ident == cont {
      return true
    }
  }
  if e = s.expr, checker_self.deep_shrinks_expr(e, cont) {
    return true
  }
  if c = s.cond, checker_self.deep_shrinks_expr(c, cont) {
    return true
  }
  if t = s.target, checker_self.deep_shrinks_expr(t, cont) {
    return true
  }
  if v = s.value, checker_self.deep_shrinks_expr(v, cont) {
    return true
  }
  for st in s.then_body {
    if checker_self.deep_shrinks_stmt(st, cont) {
      return true
    }
  }
  for st in s.else_body {
    if checker_self.deep_shrinks_stmt(st, cont) {
      return true
    }
  }
  for st in s.body {
    if checker_self.deep_shrinks_stmt(st, cont) {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) deep_shrinks_expr(e: Expr, cont: String): Bool {
  if e.kind == ex_call() {
    if e.callee == "pop" || e.callee == "clear" {
      if recv = e.receiver, checker_self.expr_root_name(recv) == cont {
        return true
      }
    }
  }
  if inner = e.inner, checker_self.deep_shrinks_expr(inner, cont) {
    return true
  }
  if l = e.left, checker_self.deep_shrinks_expr(l, cont) {
    return true
  }
  if r = e.right, checker_self.deep_shrinks_expr(r, cont) {
    return true
  }
  if obj = e.object, checker_self.deep_shrinks_expr(obj, cont) {
    return true
  }
  if recv = e.receiver, checker_self.deep_shrinks_expr(recv, cont) {
    return true
  }
  for arg in e.args {
    if checker_self.deep_shrinks_expr(arg, cont) {
      return true
    }
  }
  for elem in e.elems {
    if checker_self.deep_shrinks_expr(elem, cont) {
      return true
    }
  }
  for field_expr in e.field_exprs {
    if checker_self.deep_shrinks_expr(field_expr, cont) {
      return true
    }
  }
  if sz = e.size_expr, checker_self.deep_shrinks_expr(sz, cont) {
    return true
  }
  if c = e.cond, checker_self.deep_shrinks_expr(c, cont) {
    return true
  }
  if b = e.block {
    for st in b.body {
      if checker_self.deep_shrinks_stmt(st, cont) {
        return true
      }
    }
  }
  for cs in e.cases {
    for st in cs.body {
      if checker_self.deep_shrinks_stmt(st, cont) {
        return true
      }
    }
  }
  for st in e.else_body {
    if checker_self.deep_shrinks_stmt(st, cont) {
      return true
    }
  }
  for part in e.parts {
    if inner = part.expr, checker_self.deep_shrinks_expr(inner, cont) {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) step_is_nonneg(v: Expr): Bool {
  if v.kind == ex_int() {
    return true
  }
  if v.kind == ex_name() {
    return checker_self.nn_has(v.ident)
  }
  false
}

pub fn (checker_self: Checker) deep_ivar_ok_stmt(s: Stmt, ivar: String): Bool {
  if s.kind == st_assign() {
    if t = s.target, t.kind == ex_name() && t.ident == ivar {
      if s.op == tk_plus_eq() {
        if v = s.value, checker_self.step_is_nonneg(v) {
          return checker_self.deep_ivar_ok_rest(s, ivar)
        }
        return false
      }
      if s.op == tk_eq() {
        if v = s.value, v.kind == ex_binary() && v.op == tk_plus(), l = v.left, r = v.right {
          if l.kind == ex_name() && l.ident == ivar && checker_self.step_is_nonneg(r) {
            return checker_self.deep_ivar_ok_rest(s, ivar)
          }
          if r.kind == ex_name() && r.ident == ivar && checker_self.step_is_nonneg(l) {
            return checker_self.deep_ivar_ok_rest(s, ivar)
          }
        }
        return false
      }
      return false
    }
  }
  checker_self.deep_ivar_ok_rest(s, ivar)
}

pub fn (checker_self: Checker) deep_ivar_ok_rest(s: Stmt, ivar: String): Bool {
  if e = s.expr, !checker_self.deep_ivar_ok_expr(e, ivar) {
    return false
  }
  if c = s.cond, !checker_self.deep_ivar_ok_expr(c, ivar) {
    return false
  }
  if v = s.value, !checker_self.deep_ivar_ok_expr(v, ivar) {
    return false
  }
  for st in s.then_body {
    if !checker_self.deep_ivar_ok_stmt(st, ivar) {
      return false
    }
  }
  for st in s.else_body {
    if !checker_self.deep_ivar_ok_stmt(st, ivar) {
      return false
    }
  }
  for st in s.body {
    if !checker_self.deep_ivar_ok_stmt(st, ivar) {
      return false
    }
  }
  true
}

pub fn (checker_self: Checker) deep_ivar_ok_expr(e: Expr, ivar: String): Bool {
  if inner = e.inner, !checker_self.deep_ivar_ok_expr(inner, ivar) {
    return false
  }
  if l = e.left, !checker_self.deep_ivar_ok_expr(l, ivar) {
    return false
  }
  if r = e.right, !checker_self.deep_ivar_ok_expr(r, ivar) {
    return false
  }
  if obj = e.object, !checker_self.deep_ivar_ok_expr(obj, ivar) {
    return false
  }
  if recv = e.receiver, !checker_self.deep_ivar_ok_expr(recv, ivar) {
    return false
  }
  for arg in e.args {
    if !checker_self.deep_ivar_ok_expr(arg, ivar) {
      return false
    }
  }
  for elem in e.elems {
    if !checker_self.deep_ivar_ok_expr(elem, ivar) {
      return false
    }
  }
  for field_expr in e.field_exprs {
    if !checker_self.deep_ivar_ok_expr(field_expr, ivar) {
      return false
    }
  }
  if sz = e.size_expr, !checker_self.deep_ivar_ok_expr(sz, ivar) {
    return false
  }
  if c = e.cond, !checker_self.deep_ivar_ok_expr(c, ivar) {
    return false
  }
  if b = e.block {
    for st in b.body {
      if !checker_self.deep_ivar_ok_stmt(st, ivar) {
        return false
      }
    }
  }
  for cs in e.cases {
    for st in cs.body {
      if !checker_self.deep_ivar_ok_stmt(st, ivar) {
        return false
      }
    }
  }
  for st in e.else_body {
    if !checker_self.deep_ivar_ok_stmt(st, ivar) {
      return false
    }
  }
  true
}

pub fn (checker_self: Checker) body_ivar_ok(body: Array(Stmt), ivar: String): Bool {
  i = 0
  while i < body.size {
    if !checker_self.deep_ivar_ok_stmt(body[i], ivar) {
      return false
    }
    i += 1
  }
  true
}

pub fn (checker_self: Checker) body_shrinks(body: Array(Stmt), cont: String): Bool {
  i = 0
  while i < body.size {
    if checker_self.deep_shrinks_stmt(body[i], cont) {
      return true
    }
    i += 1
  }
  false
}

pub fn (checker_self: Checker) collect_cond_nn(e: Expr, into: Array(String)) {
  if e.kind == ex_binary() {
    if e.op == tk_amp_amp() {
      if l = e.left {
        checker_self.collect_cond_nn(l, into)
      }
      if r = e.right {
        checker_self.collect_cond_nn(r, into)
      }
      return
    }
    if e.op == 47 {
      if l = e.left, r = e.right, l.kind == ex_name() && r.kind == ex_int() && r.int_bits == 0u64 {
        into.push(l.ident)
      }
    }
    if e.op == tk_less_eq() {
      if l = e.left, r = e.right, r.kind == ex_name() && l.kind == ex_int() && l.int_bits == 0u64 {
        into.push(r.ident)
      }
    }
  }
}

pub fn (checker_self: Checker) fact_from_cond(e: Expr, body: Array(Stmt), nnl: Array(String)) {
  if e.kind != ex_binary() {
    return
  }
  if e.op == tk_amp_amp() {
    if l = e.left {
      checker_self.fact_from_cond(l, body, nnl)
    }
    if r = e.right {
      checker_self.fact_from_cond(r, body, nnl)
    }
    return
  }
  ivar = ""
  bound: Expr? = nil
  slack = 0
  is_le = false
  if e.op == tk_less() {
    if l = e.left, l.kind == ex_name() {
      ivar = l.ident
      if r = e.right {
        bound = r
      }
    }
  } else if e.op == tk_less_eq() {
    is_le = true
    if l = e.left, l.kind == ex_name() {
      ivar = l.ident
      if r = e.right {
        bound = r
      }
    }
  } else if e.op == 47 {
    if r = e.right, r.kind == ex_name() {
      ivar = r.ident
      if l = e.left {
        bound = l
      }
    }
  } else if e.op == 48 {
    is_le = true
    if r = e.right, r.kind == ex_name() {
      ivar = r.ident
      if l = e.left {
        bound = l
      }
    }
  } else {
    return
  }
  if ivar.size == 0 || checker_self.lw_has(ivar) {
    return
  }
  if b = bound {
    cont = checker_self.bound_cont_of(b)
    if cont.size == 0 {
      if is_le {
        return
      }
      nonneg2 = false
      if checker_self.nn_has(ivar) {
        nonneg2 = true
      }
      if nnl.contains(ivar) {
        nonneg2 = true
      }
      if !nonneg2 {
        return
      }
      if checker_self.body_ivar_ok(body, ivar) {
        checker_self.facts.fact_var.push(ivar)
        checker_self.facts.fact_cont.push("")
        checker_self.facts.fact_slack.push(0)
        checker_self.facts.fact_live.push(1)
        checker_self.facts.fact_anchor.push(0)
        checker_self.facts.fact_cty.push(checker_self.t_void())
      }
      return
    }
    delta = checker_self.bound_delta_of(b)
    if is_le {
      slack = (0 - delta) - 1
    } else {
      slack = 0 - delta
    }
    if slack < 0 {
      return
    }
    direct = false
    if b.kind == ex_field() {
      direct = true
    }
    nonneg = false
    if checker_self.nn_has(ivar) {
      nonneg = true
    }
    if nnl.contains(ivar) {
      nonneg = true
    }
    if !nonneg {
      return
    }
    if !direct && checker_self.body_shrinks(body, cont) {
      return
    }
    if checker_self.body_ivar_ok(body, ivar) {
      cty = checker_self.t_void()
      if got = checker_self.lookup(cont) {
        cty = got
      }
      checker_self.facts.fact_var.push(ivar)
      checker_self.facts.fact_cont.push(cont)
      checker_self.facts.fact_slack.push(slack)
      checker_self.facts.fact_live.push(1)
      checker_self.facts.fact_anchor.push(checker_self.bound_anchor_of(b))
      checker_self.facts.fact_cty.push(cty)
    }
  }
}

pub fn (checker_self: Checker) push_loop_facts(cond: Expr, body: Array(Stmt)) {
  nnl: Array(String) = []
  checker_self.collect_cond_nn(cond, nnl)
  checker_self.fact_from_cond(cond, body, nnl)
}

pub fn (checker_self: Checker) pop_loop_facts(saved: Int) {
  while checker_self.facts.fact_var.size > saved {
    dropped_s = checker_self.facts.fact_var.pop()
    dropped_c = checker_self.facts.fact_cont.pop()
    dropped_k = checker_self.facts.fact_slack.pop()
    dropped_l = checker_self.facts.fact_live.pop()
    dropped_a = checker_self.facts.fact_anchor.pop()
    dropped_t = checker_self.facts.fact_cty.pop()
  }
}

pub fn (checker_self: Checker) cap_put(name: String, val: Int) {
  if checker_self.lw_has(name) {
    checker_self.cap_remove(name)
    return
  }
  for i in 0..checker_self.facts.cap_var.size {
    if checker_self.facts.cap_var[i] == name {
      checker_self.facts.cap_val[i] = val
      return
    }
  }
  checker_self.facts.cap_var.push(name)
  checker_self.facts.cap_val.push(val)
}

pub fn (checker_self: Checker) cap_get(name: String): Int {
  for i in 0..checker_self.facts.cap_var.size {
    if checker_self.facts.cap_var[i] == name {
      return checker_self.facts.cap_val[i]
    }
  }
  0 - 1
}

pub fn (checker_self: Checker) cap_remove(name: String) {
  kept_v: Array(String) = []
  kept_c: Array(Int) = []
  for i in 0..checker_self.facts.cap_var.size {
    if checker_self.facts.cap_var[i] != name {
      kept_v.push(checker_self.facts.cap_var[i])
      kept_c.push(checker_self.facts.cap_val[i])
    }
  }
  checker_self.facts.cap_var = kept_v
  checker_self.facts.cap_val = kept_c
}

pub fn (checker_self: Checker) gcap_put(name: String, val: Int) {
  live = 1
  if checker_self.lw_has(name) {
    live = 0
  }
  checker_self.facts.gcap_var.push(name)
  checker_self.facts.gcap_val.push(val)
  checker_self.facts.gcap_live.push(live)
}

pub fn (checker_self: Checker) gcap_get(name: String): Int {
  best = 0 - 1
  for i in 0..checker_self.facts.gcap_var.size {
    if checker_self.facts.gcap_live[i] == 1 && checker_self.facts.gcap_var[i] == name && (best < 0 || checker_self.facts.gcap_val[i] < best) {
      best = checker_self.facts.gcap_val[i]
    }
  }
  best
}

pub fn (checker_self: Checker) cap_of(name: String): Int {
  a = checker_self.cap_get(name)
  g = checker_self.gcap_get(name)
  if a < 0 {
    return g
  }
  if g < 0 {
    return a
  }
  if a < g {
    return a
  }
  g
}

pub fn (checker_self: Checker) gnn_put(name: String) {
  live = 1
  if checker_self.lw_has(name) {
    live = 0
  }
  checker_self.facts.gnn_var.push(name)
  checker_self.facts.gnn_live.push(live)
}

pub fn (checker_self: Checker) gpos_put(name: String) {
  live = 1
  if checker_self.lw_has(name) {
    live = 0
  }
  checker_self.facts.gpos_var.push(name)
  checker_self.facts.gpos_live.push(live)
}

pub fn (checker_self: Checker) gne_put(name: String) {
  live = 1
  if checker_self.lw_has(name) {
    live = 0
  }
  checker_self.facts.gne_var.push(name)
  checker_self.facts.gne_live.push(live)
}

pub fn (checker_self: Checker) gnn_has(name: String): Bool {
  for i in 0..checker_self.facts.gnn_var.size {
    if checker_self.facts.gnn_live[i] == 1 && checker_self.facts.gnn_var[i] == name {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) gpos_has(name: String): Bool {
  for i in 0..checker_self.facts.gpos_var.size {
    if checker_self.facts.gpos_live[i] == 1 && checker_self.facts.gpos_var[i] == name {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) gne_has(name: String): Bool {
  for i in 0..checker_self.facts.gne_var.size {
    if checker_self.facts.gne_live[i] == 1 && checker_self.facts.gne_var[i] == name {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) nn_proven(name: String): Bool {
  if checker_self.nn_has(name) {
    return true
  }
  checker_self.gnn_has(name)
}

pub fn (checker_self: Checker) cap_kill_guards(name: String) {
  for i in 0..checker_self.facts.gcap_var.size {
    if checker_self.facts.gcap_var[i] == name {
      checker_self.facts.gcap_live[i] = 0
    }
  }
  for i in 0..checker_self.facts.gnn_var.size {
    if checker_self.facts.gnn_var[i] == name {
      checker_self.facts.gnn_live[i] = 0
    }
  }
  for i in 0..checker_self.facts.gpos_var.size {
    if checker_self.facts.gpos_var[i] == name {
      checker_self.facts.gpos_live[i] = 0
    }
  }
  for i in 0..checker_self.facts.gne_var.size {
    if checker_self.facts.gne_var[i] == name {
      checker_self.facts.gne_live[i] = 0
    }
  }
}

pub fn (checker_self: Checker) pop_guard_facts(sg: Int, sn: Int, sp: Int, se: Int) {
  while checker_self.facts.gcap_var.size > sg {
    dv = checker_self.facts.gcap_var.pop()
    dc = checker_self.facts.gcap_val.pop()
    dl = checker_self.facts.gcap_live.pop()
  }
  while checker_self.facts.gnn_var.size > sn {
    dv2 = checker_self.facts.gnn_var.pop()
    dl2 = checker_self.facts.gnn_live.pop()
  }
  while checker_self.facts.gpos_var.size > sp {
    dv3 = checker_self.facts.gpos_var.pop()
    dl3 = checker_self.facts.gpos_live.pop()
  }
  while checker_self.facts.gne_var.size > se {
    dv4 = checker_self.facts.gne_var.pop()
    dl4 = checker_self.facts.gne_live.pop()
  }
}

// The receiver of `recv.name` with no argument, written either way: the
// member without parentheses or the call with none (`x.to_f`,
// `x.to_f()`); nil for anything else.
pub fn member_recv(e: Expr, name: String): Expr? {
  if e.kind == ex_field() && e.ident == name {
    return e.object
  }
  if e.kind == ex_call() && e.callee == name && e.args.size == 0 && !e.indirect {
    if b = e.block {
      return nil
    }
    return e.receiver
  }
  nil
}

// The source of `n.to_f.sqrt.to_i` (each member with or without its
// parentheses); nil for anything else.
pub fn sqrt_toi_src(e: Expr): Expr? {
  if r1 = member_recv(e, "to_i"), r2 = member_recv(r1, "sqrt"), src = member_recv(r2, "to_f") {
    return src
  }
  nil
}

pub fn (checker_self: Checker) is_sqrt_toi(e: Expr): Bool {
  if src = sqrt_toi_src(e) {
    if t = src.ty {
      return t.is_int()
    }
    if src.kind == ex_name() {
      return true
    }
    if src.kind == ex_int() {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) sqrt_src_nonneg(e: Expr): Bool {
  if src = sqrt_toi_src(e) {
    return checker_self.expr_nonneg(src)
  }
  false
}

pub fn (checker_self: Checker) expr_nonneg(e: Expr): Bool {
  if e.kind == ex_int() {
    return true
  }
  if e.kind == ex_name() {
    return checker_self.nn_proven(e.ident)
  }
  if checker_self.is_sqrt_toi(e) {
    return checker_self.sqrt_src_nonneg(e)
  }
  if e.kind == ex_field() {
    return e.ident == "size"
  }
  if e.kind == ex_binary() {
    if e.op == tk_star() || e.op == tk_plus() {
      if l = e.left, r = e.right, checker_self.expr_nonneg(l) {
        return checker_self.expr_nonneg(r)
      }
      return false
    }
    if e.op == tk_minus() {
      if l = e.left, r = e.right, r.kind == ex_int() {
        return checker_self.expr_nonneg(l)
      }
      return false
    }
  }
  false
}

pub fn (checker_self: Checker) cap_of_expr(e: Expr): Int {
  if e.kind == ex_int() {
    if e.int_bits <= 4611686018427387904u64 {
      return e.int_bits.to_i()
    }
    return 0 - 1
  }
  if e.kind == ex_name() {
    return checker_self.cap_of(e.ident)
  }
  if checker_self.is_sqrt_toi(e) && checker_self.sqrt_src_nonneg(e) {
    // isqrt of a non-negative Int (64-bit).
    return 3037000499
  }
  if e.kind == ex_field() {
    if e.ident == "size" {
      return 2147483647
    }
    return 0 - 1
  }
  if e.kind == ex_binary() {
    if l = e.left, r = e.right {
      cl = checker_self.cap_of_expr(l)
      if cl < 0 {
        return 0 - 1
      }
      if e.op == tk_plus() {
        cr = checker_self.cap_of_expr(r)
        if cr < 0 {
          return 0 - 1
        }
        if cl > 2305843009213693952 - cr {
          return 0 - 1
        }
        return cl + cr
      }
      if e.op == tk_star() {
        cr = checker_self.cap_of_expr(r)
        if cr < 0 {
          return 0 - 1
        }
        if cl == 0 || cr == 0 {
          return 0
        }
        if cl > 9223372036854775807 / cr {
          return 0 - 1
        }
        return cl * cr
      }
      if e.op == tk_minus() {
        if checker_self.expr_nonneg(r) {
          return cl
        }
        return 0 - 1
      }
    }
  }
  0 - 1
}

pub fn (checker_self: Checker) flip_cmp(op: Int): Int {
  if op == tk_less() {
    return tk_greater()
  }
  if op == tk_less_eq() {
    return tk_greater_eq()
  }
  if op == tk_greater() {
    return tk_less()
  }
  if op == tk_greater_eq() {
    return tk_less_eq()
  }
  op
}

pub fn (checker_self: Checker) push_guard_facts(e: Expr) {
  if e.kind != ex_binary() {
    return
  }
  if e.op == tk_amp_amp() {
    if l = e.left {
      checker_self.push_guard_facts(l)
    }
    if r = e.right {
      checker_self.push_guard_facts(r)
    }
    return
  }
  op = e.op
  v = ""
  bound: Expr? = nil
  flipped = false
  if l = e.left, r = e.right {
    if l.kind == ex_name() {
      v = l.ident
      bound = r
    } else if r.kind == ex_name() {
      v = r.ident
      bound = l
      flipped = true
    }
  }
  if v.size == 0 {
    return
  }
  if flipped {
    op = checker_self.flip_cmp(op)
  }
  if b = bound {
    if op == tk_less() || op == tk_less_eq() {
      cb = checker_self.cap_of_expr(b)
      if cb >= 0 {
        cap = cb
        if op == tk_less() {
          cap = cb - 1
        }
        if cap >= 0 {
          checker_self.gcap_put(v, cap)
        }
      }
      return
    }
    if op == tk_greater() || op == tk_greater_eq() {
      if b.kind == ex_int() && b.int_bits <= 4611686018427387904u64 {
        low = b.int_bits.to_i()
        if op == tk_greater() {
          low += 1
        }
        if low >= 1 {
          checker_self.gnn_put(v)
          checker_self.gpos_put(v)
          checker_self.gne_put(v)
        } else if low == 0 {
          checker_self.gnn_put(v)
        }
      }
      return
    }
    if op == tk_not_eq() {
      if b.kind == ex_int() && b.int_bits == 0u64 {
        checker_self.gne_put(v)
      }
      return
    }
    if op == tk_eq_eq() {
      cb2 = checker_self.cap_of_expr(b)
      if cb2 >= 0 {
        checker_self.gcap_put(v, cb2)
      }
      if b.kind == ex_int() && b.int_bits <= 4611686018427387904u64 {
        lv = b.int_bits.to_i()
        checker_self.gnn_put(v)
        if lv >= 1 {
          checker_self.gpos_put(v)
          checker_self.gne_put(v)
        }
      }
      return
    }
  }
}

// The largest value of ty a cap test allows (Int is 64-bit; the caps
// are non-negative Int bounds).
pub fn (checker_self: Checker) cap_max(ty: Ty): Int {
  if ty.is_int32() {
    return 2147483647
  }
  if ty.is_uint32() {
    return 4294967295
  }
  9223372036854775807
}

pub fn (checker_self: Checker) cap_sum_ok(cl: Int, cr: Int, ty: Ty): Bool {
  if cl > checker_self.cap_max(ty) - cr {
    return false
  }
  true
}

pub fn (checker_self: Checker) cap_prod_ok(cl: Int, cr: Int, ty: Ty): Bool {
  if cl == 0 || cr == 0 {
    return true
  }
  if cl > checker_self.cap_max(ty) / cr {
    return false
  }
  true
}

pub fn (checker_self: Checker) cap_pair_proven(op: Int, cl: Int, cr: Int, ty: Ty): Bool {
  if cl < 0 || cr < 0 {
    return false
  }
  if op == tk_plus() {
    return checker_self.cap_sum_ok(cl, cr, ty)
  }
  if op == tk_star() {
    return checker_self.cap_prod_ok(cl, cr, ty)
  }
  if op == tk_minus() {
    if ty.is_unsigned() {
      return false
    }
    if cl > 2147483647 {
      return false
    }
    if cr > 2147483647 {
      return false
    }
    return true
  }
  false
}

pub fn (checker_self: Checker) arith_proven(op: Int, l: Expr, r: Expr, ty: Ty): Bool {
  if !checker_self.expr_nonneg(l) {
    return false
  }
  if !checker_self.expr_nonneg(r) {
    return false
  }
  cl = checker_self.cap_of_expr(l)
  cr = checker_self.cap_of_expr(r)
  checker_self.cap_pair_proven(op, cl, cr, ty)
}

pub fn (checker_self: Checker) compound_proven(op: Int, target: String, value: Expr, ty: Ty): Bool {
  if !checker_self.nn_proven(target) {
    return false
  }
  if !checker_self.expr_nonneg(value) {
    return false
  }
  ct = checker_self.cap_of(target)
  cv = checker_self.cap_of_expr(value)
  if op == tk_plus_eq() {
    return checker_self.cap_pair_proven(tk_plus(), ct, cv, ty)
  }
  if op == tk_star_eq() {
    return checker_self.cap_pair_proven(tk_star(), ct, cv, ty)
  }
  if op == tk_minus_eq() {
    return checker_self.cap_pair_proven(tk_minus(), ct, cv, ty)
  }
  false
}

pub fn (checker_self: Checker) divisor_proven(r: Expr): Bool {
  if r.kind == ex_int() {
    return r.int_bits != 0u64
  }
  if r.kind == ex_name() {
    if checker_self.gpos_has(r.ident) {
      return true
    }
    if checker_self.nn_proven(r.ident) && checker_self.gne_has(r.ident) {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) cap_after_assign(v: String, op: Int, val: Expr) {
  old_cap = checker_self.cap_of(v)
  checker_self.cap_kill_guards(v)
  if op == tk_eq() {
    if checker_self.is_sqrt_toi(val) && checker_self.sqrt_src_nonneg(val) {
      checker_self.cap_put(v, 46340)
      checker_self.nn_add(v)
      return
    }
    c = checker_self.cap_of_expr(val)
    if c >= 0 {
      if val.kind == ex_field() {
        if val.ident == "size" {
          checker_self.cap_remove(v)
          return
        }
      }
      checker_self.cap_put(v, c)
    } else {
      checker_self.cap_remove(v)
    }
    return
  }
  if op == tk_plus_eq() {
    cv = checker_self.cap_of_expr(val)
    if old_cap >= 0 && cv >= 0 {
      if old_cap > 2305843009213693952 - cv {
        checker_self.cap_remove(v)
      } else {
        checker_self.cap_put(v, old_cap + cv)
      }
    } else {
      checker_self.cap_remove(v)
    }
    return
  }
  if op == tk_minus_eq() {
    if checker_self.expr_nonneg(val) {
      if old_cap >= 0 {
        checker_self.cap_put(v, old_cap)
      } else {
        checker_self.cap_remove(v)
      }
    } else {
      checker_self.cap_remove(v)
    }
    return
  }
  if op == tk_star_eq() {
    cv2 = checker_self.cap_of_expr(val)
    if old_cap >= 0 && cv2 >= 0 {
      if old_cap == 0 || cv2 == 0 {
        checker_self.cap_put(v, 0)
      } else if old_cap > 9223372036854775807 / cv2 {
        checker_self.cap_remove(v)
      } else {
        checker_self.cap_put(v, old_cap * cv2)
      }
    } else {
      checker_self.cap_remove(v)
    }
    return
  }
  checker_self.cap_remove(v)
}

pub fn (checker_self: Checker) cap_collect_assigned_stmt(s: Stmt, into: Array(String)) {
  if s.kind == st_assign() {
    if t = s.target, t.kind == ex_name() && !into.contains(t.ident) {
      into.push(t.ident)
    }
  }
  if e = s.expr {
    checker_self.cap_collect_assigned_expr(e, into)
  }
  if c = s.cond {
    checker_self.cap_collect_assigned_expr(c, into)
  }
  if t = s.target {
    checker_self.cap_collect_assigned_expr(t, into)
  }
  if v = s.value {
    checker_self.cap_collect_assigned_expr(v, into)
  }
  i = 0
  while i < s.then_body.size {
    checker_self.cap_collect_assigned_stmt(s.then_body[i], into)
    i += 1
  }
  i = 0
  while i < s.else_body.size {
    checker_self.cap_collect_assigned_stmt(s.else_body[i], into)
    i += 1
  }
  i = 0
  while i < s.body.size {
    checker_self.cap_collect_assigned_stmt(s.body[i], into)
    i += 1
  }
  i = 0
  while i < s.pre.size {
    checker_self.cap_collect_assigned_stmt(s.pre[i], into)
    i += 1
  }
}

pub fn (checker_self: Checker) cap_collect_assigned_expr(e: Expr, into: Array(String)) {
  if b = e.block {
    j = 0
    while j < b.body.size {
      checker_self.cap_collect_assigned_stmt(b.body[j], into)
      j += 1
    }
  }
  for cs in e.cases {
    j = 0
    while j < cs.body.size {
      checker_self.cap_collect_assigned_stmt(cs.body[j], into)
      j += 1
    }
  }
  i = 0
  while i < e.else_body.size {
    checker_self.cap_collect_assigned_stmt(e.else_body[i], into)
    i += 1
  }
  if inner = e.inner {
    checker_self.cap_collect_assigned_expr(inner, into)
  }
  if l = e.left {
    checker_self.cap_collect_assigned_expr(l, into)
  }
  if r = e.right {
    checker_self.cap_collect_assigned_expr(r, into)
  }
  if obj = e.object {
    checker_self.cap_collect_assigned_expr(obj, into)
  }
  if recv = e.receiver {
    checker_self.cap_collect_assigned_expr(recv, into)
  }
  i = 0
  while i < e.args.size {
    checker_self.cap_collect_assigned_expr(e.args[i], into)
    i += 1
  }
  i = 0
  while i < e.elems.size {
    checker_self.cap_collect_assigned_expr(e.elems[i], into)
    i += 1
  }
  i = 0
  while i < e.field_exprs.size {
    checker_self.cap_collect_assigned_expr(e.field_exprs[i], into)
    i += 1
  }
  if sz = e.size_expr {
    checker_self.cap_collect_assigned_expr(sz, into)
  }
  if c = e.cond {
    checker_self.cap_collect_assigned_expr(c, into)
  }
}

pub fn (checker_self: Checker) cap_kill_assigned_in(body: Array(Stmt)) {
  names: Array(String) = []
  i = 0
  while i < body.size {
    checker_self.cap_collect_assigned_stmt(body[i], names)
    i += 1
  }
  i = 0
  while i < names.size {
    checker_self.cap_remove(names[i])
    i += 1
  }
}

pub fn (checker_self: Checker) cap_kill_captures_stmt(s: Stmt) {
  checker_self.cap_kill_captures_rest(s)
}

pub fn (checker_self: Checker) cap_kill_captures_rest(s: Stmt) {
  if e = s.expr {
    checker_self.cap_kill_captures_expr(e)
  }
  if c = s.cond {
    checker_self.cap_kill_captures_expr(c)
  }
  if t = s.target {
    checker_self.cap_kill_captures_expr(t)
  }
  if v = s.value {
    checker_self.cap_kill_captures_expr(v)
  }
  for st in s.then_body {
    checker_self.cap_kill_captures_rest(st)
  }
  for st in s.else_body {
    checker_self.cap_kill_captures_rest(st)
  }
  for st in s.body {
    checker_self.cap_kill_captures_rest(st)
  }
  for st in s.pre {
    checker_self.cap_kill_captures_rest(st)
  }
}

pub fn (checker_self: Checker) cap_kill_captures_expr(e: Expr) {
  for cap_name in e.cap_names {
    checker_self.cap_remove(cap_name)
    checker_self.cap_kill_guards(cap_name)
  }
  if inner = e.inner {
    checker_self.cap_kill_captures_expr(inner)
  }
  if l = e.left {
    checker_self.cap_kill_captures_expr(l)
  }
  if r = e.right {
    checker_self.cap_kill_captures_expr(r)
  }
  if obj = e.object {
    checker_self.cap_kill_captures_expr(obj)
  }
  if recv = e.receiver {
    checker_self.cap_kill_captures_expr(recv)
  }
  for arg in e.args {
    checker_self.cap_kill_captures_expr(arg)
  }
  for elem in e.elems {
    checker_self.cap_kill_captures_expr(elem)
  }
  for field_expr in e.field_exprs {
    checker_self.cap_kill_captures_expr(field_expr)
  }
  if sz = e.size_expr {
    checker_self.cap_kill_captures_expr(sz)
  }
  if c = e.cond {
    checker_self.cap_kill_captures_expr(c)
  }
  if b = e.block {
    for st in b.body {
      checker_self.cap_kill_captures_rest(st)
    }
  }
  for cs in e.cases {
    for st in cs.body {
      checker_self.cap_kill_captures_rest(st)
    }
  }
  for st in e.else_body {
    checker_self.cap_kill_captures_rest(st)
  }
  for part in e.parts {
    if inner2 = part.expr {
      checker_self.cap_kill_captures_expr(inner2)
    }
  }
}

// ---- Shrinks through another name
//
// What may change the size of the array or Buf a local name holds,
// besides that name: a `pop` or `clear` on any array of its type (another
// name may hold the same array), and code that may reach it, which can
// only reach it through what it is given (a module has no variables): the
// arguments, the receiver, and the captures of a function value. A call
// of a function value may reach anything; any other call, and an operator,
// an index or an interpolation that runs a type's own method (`equals`,
// `compare`, `hash`, `to_s`), reaches the container when the type of one
// of its operands may hold its type. A builtin that runs no code of the program and keeps
// every size (`push`, `size`, a `String` method) reaches nothing.

// Whether a value of type t may be, or lead to, an object of type cty
// through fields, elements, members and keys. A function value, a type
// variable and an interface may lead anywhere; a number, a Bool, a
// String, Bytes, an enum and an opaque C handle lead nowhere (C memory
// holds no reference the collector would keep), a C pointer or layout to
// what its type says.
pub fn (checker_self: Checker) ty_reaches(t: Ty, cty: Ty, seen: Array(String)): Bool {
  if t.same_as(cty) {
    return true
  }
  if t.is_integer() || t.is_float() || t.is_bool() || t.is_string() || t.is_bytes() || t.is_void() || t.is_nil() || t.is_enum() || t.is_module() || t.is_buf() || t.is_opaque() {
    return false
  }
  if t.is_array() || t.is_join() || t.is_ptr() {
    if i = t.inner {
      return checker_self.ty_reaches(i, cty, seen)
    }
    return true
  }
  if t.is_hash() {
    if k = t.key, v = t.val {
      return checker_self.ty_reaches(k, cty, seen) || checker_self.ty_reaches(v, cty, seen)
    }
    return true
  }
  if t.is_union() {
    for m in t.members {
      if checker_self.ty_reaches(m, cty, seen) {
        return true
      }
    }
    return false
  }
  if t.is_struct() || t.is_class() || t.is_clayout() {
    key = mangle_ty(t)
    if seen.contains(key) {
      return false
    }
    seen.push(key)
    for f in t.fields {
      if checker_self.ty_reaches(f.ty, cty, seen) {
        return true
      }
    }
    return false
  }
  true
}

// ty_reaches from the top, remembered across the program's functions:
// the same argument types meet the same containers again and again.
pub fn (checker_self: Checker) reaches(t: Ty, cty: Ty): Bool {
  key = "${mangle_ty(t)} ${mangle_ty(cty)}"
  if got = checker_self.facts.reach_memo.get(key) {
    return got
  }
  seen: Array(String) = []
  r = checker_self.ty_reaches(t, cty, seen)
  checker_self.facts.reach_memo[key] = r
  r
}

pub fn (checker_self: Checker) expr_reaches(e: Expr, cty: Ty): Bool {
  if t = e.ty {
    return checker_self.reaches(t, cty)
  }
  true
}

pub fn (checker_self: Checker) args_reach(e: Expr, cty: Ty): Bool {
  for arg in e.args {
    if checker_self.expr_reaches(arg, cty) {
      return true
    }
  }
  false
}

// A builtin method of an array that runs no code of the program and
// keeps every size.
pub fn plain_array_method(name: String): Bool {
  name == "push" || name == "size" || name == "reserve" || name == "fill" || name == "each" || name == "any" || name == "all" || name == "get" || name == "parallel"
}

// Whether evaluating e itself (its operands aside) may shrink the
// container c of type cty.
pub fn (checker_self: Checker) node_shrinks(e: Expr, c: String, cty: Ty): Bool {
  k = e.kind
  if k == ex_call() || (k == ex_field() && e.method_call) {
    if e.indirect {
      return true
    }
    name = e.callee
    recv = e.receiver
    if k == ex_field() {
      name = e.ident
      recv = e.object
    }
    if r = recv {
      if rt = r.ty {
        if e.resolved.size == 0 {
          if rt.is_array() {
            if name == "pop" || name == "clear" {
              return checker_self.expr_root_name(r) == c || rt.same_as(cty)
            }
            if plain_array_method(name) {
              return false
            }
            // The elements' own `equals`, `compare` or `to_s` may run.
            if i = rt.inner {
              return checker_self.reaches(i, cty)
            }
            return true
          }
          if rt.is_buf() {
            if name == "clear" {
              return checker_self.expr_root_name(r) == c || rt.same_as(cty)
            }
            return false
          }
          if rt.is_string() || rt.is_bytes() || rt.is_integer() || rt.is_float() || rt.is_bool() {
            return checker_self.args_reach(e, cty)
          }
          if rt.is_hash() {
            // The keys' own `hash` and `equals` may run.
            if key = rt.key {
              if checker_self.reaches(key, cty) {
                return true
              }
            }
            return checker_self.args_reach(e, cty)
          }
        }
        if checker_self.reaches(rt, cty) {
          return true
        }
      } else if !e.type_call && !(r.kind == ex_name() && r.ident.size > 0 && r.ident[0] >= 65 && r.ident[0] <= 90) {
        return true
      }
    }
    return checker_self.args_reach(e, cty)
  }
  if k == ex_binary() || k == ex_unary() || k == ex_index() {
    user = e.resolved.size > 0 || e.op_form != 0
    if k == ex_binary() && (e.op == tk_eq_eq() || e.op == tk_not_eq() || e.op == tk_less() || e.op == tk_less_eq() || e.op == tk_greater() || e.op == tk_greater_eq()) {
      // A struct, array or optional compares its parts, each by its own
      // `equals` or `compare`.
      if l = e.left, lt = l.ty, lt.is_struct() || lt.is_array() || lt.is_union() {
        user = true
      }
    }
    if k == ex_index() {
      if l = e.left, lt = l.ty, lt.is_hash() {
        user = true
      }
    }
    if user {
      if l = e.left, checker_self.expr_reaches(l, cty) {
        return true
      }
      if r = e.right, checker_self.expr_reaches(r, cty) {
        return true
      }
      if i = e.inner, checker_self.expr_reaches(i, cty) {
        return true
      }
    }
    return false
  }
  if k == ex_interp() {
    for part in e.parts {
      if inner = part.expr, checker_self.expr_reaches(inner, cty) {
        return true
      }
    }
    return false
  }
  if k == ex_hash_new() {
    // A literal's keys are hashed.
    if t = e.ty, key = t.key {
      return checker_self.reaches(key, cty)
    }
    return e.elems.size > 0
  }
  false
}

// Whether evaluating e, with everything in it, may shrink c. A lambda's
// body runs when the lambda is called, a call that reaches anything.
pub fn (checker_self: Checker) expr_shrinks(e: Expr, c: String, cty: Ty): Bool {
  if checker_self.node_shrinks(e, c, cty) {
    return true
  }
  if inner = e.inner, checker_self.expr_shrinks(inner, c, cty) {
    return true
  }
  if l = e.left, checker_self.expr_shrinks(l, c, cty) {
    return true
  }
  if r = e.right, checker_self.expr_shrinks(r, c, cty) {
    return true
  }
  if obj = e.object, checker_self.expr_shrinks(obj, c, cty) {
    return true
  }
  if recv = e.receiver, checker_self.expr_shrinks(recv, c, cty) {
    return true
  }
  for arg in e.args {
    if checker_self.expr_shrinks(arg, c, cty) {
      return true
    }
  }
  for elem in e.elems {
    if checker_self.expr_shrinks(elem, c, cty) {
      return true
    }
  }
  for field_expr in e.field_exprs {
    if checker_self.expr_shrinks(field_expr, c, cty) {
      return true
    }
  }
  if sz = e.size_expr, checker_self.expr_shrinks(sz, c, cty) {
    return true
  }
  if cnd = e.cond, checker_self.expr_shrinks(cnd, c, cty) {
    return true
  }
  if e.kind != ex_lambda() {
    if b = e.block {
      for st in b.body {
        if checker_self.stmt_shrinks(st, c, cty) {
          return true
        }
      }
    }
  }
  for cs in e.cases {
    for st in cs.body {
      if checker_self.stmt_shrinks(st, c, cty) {
        return true
      }
    }
  }
  for st in e.else_body {
    if checker_self.stmt_shrinks(st, c, cty) {
      return true
    }
  }
  for part in e.parts {
    if inner2 = part.expr, checker_self.expr_shrinks(inner2, c, cty) {
      return true
    }
  }
  false
}

// The statement's own parts: its expressions and those of a for loop's
// set-up, not the statements of its bodies (each is checked, and ends
// facts, itself). An assignment to c in the set-up (`for x in xs` holds xs
// in a name of its own) comes before the loop's facts: their own end.
pub fn (checker_self: Checker) stmt_own_shrinks(s: Stmt, c: String, cty: Ty): Bool {
  if e = s.expr, checker_self.expr_shrinks(e, c, cty) {
    return true
  }
  if cnd = s.cond, checker_self.expr_shrinks(cnd, c, cty) {
    return true
  }
  if t = s.target, checker_self.expr_shrinks(t, c, cty) {
    return true
  }
  if v = s.value, checker_self.expr_shrinks(v, c, cty) {
    return true
  }
  for st in s.pre {
    if checker_self.stmt_own_shrinks(st, c, cty) {
      return true
    }
  }
  false
}

// The whole statement, bodies included, and an assignment to c.
pub fn (checker_self: Checker) stmt_shrinks(s: Stmt, c: String, cty: Ty): Bool {
  if s.kind == st_assign() {
    if t = s.target, t.kind == ex_name() && t.ident == c {
      return true
    }
  }
  if checker_self.stmt_own_shrinks(s, c, cty) {
    return true
  }
  for st in s.then_body {
    if checker_self.stmt_shrinks(st, c, cty) {
      return true
    }
  }
  for st in s.else_body {
    if checker_self.stmt_shrinks(st, c, cty) {
      return true
    }
  }
  for st in s.body {
    if checker_self.stmt_shrinks(st, c, cty) {
      return true
    }
  }
  false
}

// c's size may have changed: its facts no longer bound an index (they
// still bound the variable, for arithmetic), its size relations end, and
// a loop around this point takes back the proofs that rest on an older
// size.
pub fn (checker_self: Checker) shrink_cont(c: String) {
  for i in 0..checker_self.facts.fact_var.size {
    if checker_self.facts.fact_live[i] == 1 && checker_self.facts.fact_cont[i] == c {
      checker_self.facts.fact_live[i] = 2
    }
  }
  checker_self.remove_relations_of(c)
  checker_self.facts.kill_cont.push(c)
}

pub fn (checker_self: Checker) add_cand(names: Array(String), tys: Array(Ty), c: String, cty: Ty) {
  if c.size == 0 || names.contains(c) {
    return
  }
  if !(cty.is_array() || cty.is_buf() || cty.is_void()) {
    // A String or Bytes never changes size.
    return
  }
  names.push(c)
  tys.push(cty)
}

// After statement s (checked, mark the size of the proof log before it):
// each container whose size s's own parts may change loses its facts and
// relations, and the proofs s made from them.
pub fn (checker_self: Checker) shrinks_after_stmt(s: Stmt, mark: Int) {
  names: Array(String) = []
  tys: Array(Ty) = []
  for i in mark..checker_self.facts.use_cont.size {
    checker_self.add_cand(names, tys, checker_self.facts.use_cont[i], checker_self.facts.use_cty[i])
  }
  for i in 0..checker_self.facts.fact_var.size {
    if checker_self.facts.fact_live[i] == 1 {
      checker_self.add_cand(names, tys, checker_self.facts.fact_cont[i], checker_self.facts.fact_cty[i])
    }
  }
  rel: Array(String) = []
  for c in checker_self.facts.sv_cont {
    rel.push(c)
  }
  for c in checker_self.facts.bv_cont {
    rel.push(c)
  }
  for c in checker_self.facts.cs_cont {
    rel.push(c)
  }
  for c in rel {
    if !names.contains(c) {
      cty = checker_self.t_void()
      if got = checker_self.lookup(c) {
        cty = got
      }
      checker_self.add_cand(names, tys, c, cty)
    }
  }
  for ni in 0..names.size {
    c = names[ni]
    if checker_self.stmt_own_shrinks(s, c, tys[ni]) {
      calls: Array(Expr) = []
      only_calls = checker_self.stmt_shrink_calls(s, c, tys[ni], calls)
      for i in mark..checker_self.facts.use_cont.size {
        if checker_self.facts.use_cont[i] == c {
          u = checker_self.facts.use_expr[i]
          if !(only_calls && checker_self.before_all(u, calls)) {
            u.proven = false
          }
        }
      }
      checker_self.shrink_cont(c)
    }
  }
}

// The nodes of s's own parts that may shrink c, into calls; true when
// each is a call (its receiver and arguments are read before it runs),
// false when another node or a statement of a block or an arm may.
pub fn (checker_self: Checker) stmt_shrink_calls(s: Stmt, c: String, cty: Ty, calls: Array(Expr)): Bool {
  ok = true
  if e = s.expr, !checker_self.shrink_calls_of(e, c, cty, calls) {
    ok = false
  }
  if cnd = s.cond, !checker_self.shrink_calls_of(cnd, c, cty, calls) {
    ok = false
  }
  if t = s.target, !checker_self.shrink_calls_of(t, c, cty, calls) {
    ok = false
  }
  if v = s.value, !checker_self.shrink_calls_of(v, c, cty, calls) {
    ok = false
  }
  for st in s.pre {
    if checker_self.stmt_own_shrinks(st, c, cty) {
      ok = false
    }
  }
  ok
}

pub fn (checker_self: Checker) shrink_calls_of(e: Expr, c: String, cty: Ty, calls: Array(Expr)): Bool {
  ok = true
  if checker_self.node_shrinks(e, c, cty) {
    if e.kind == ex_call() || (e.kind == ex_field() && e.method_call) {
      calls.push(e)
    } else {
      ok = false
    }
  }
  for sub in checker_self.operands_of(e) {
    if !checker_self.shrink_calls_of(sub, c, cty, calls) {
      ok = false
    }
  }
  if e.kind != ex_lambda() {
    if b = e.block {
      for st in b.body {
        if checker_self.stmt_shrinks(st, c, cty) {
          ok = false
        }
      }
    }
  }
  for cs in e.cases {
    for st in cs.body {
      if checker_self.stmt_shrinks(st, c, cty) {
        ok = false
      }
    }
  }
  for st in e.else_body {
    if checker_self.stmt_shrinks(st, c, cty) {
      ok = false
    }
  }
  if cnd = e.cond, !checker_self.shrink_calls_of(cnd, c, cty, calls) {
    ok = false
  }
  ok
}

// The sub-expressions of e that are values it reads (no block, arm or
// condition).
pub fn (checker_self: Checker) operands_of(e: Expr): Array(Expr) {
  out: Array(Expr) = []
  if inner = e.inner {
    out.push(inner)
  }
  if l = e.left {
    out.push(l)
  }
  if r = e.right {
    out.push(r)
  }
  if obj = e.object {
    out.push(obj)
  }
  if recv = e.receiver {
    out.push(recv)
  }
  for arg in e.args {
    out.push(arg)
  }
  for elem in e.elems {
    out.push(elem)
  }
  for field_expr in e.field_exprs {
    out.push(field_expr)
  }
  if sz = e.size_expr {
    out.push(sz)
  }
  for part in e.parts {
    if inner2 = part.expr {
      out.push(inner2)
    }
  }
  out
}

// Whether u is read before every call of calls runs: inside its receiver
// or one of its arguments (outside a lambda's body).
pub fn (checker_self: Checker) before_all(u: Expr, calls: Array(Expr)): Bool {
  for k in calls {
    inside = false
    if recv = k.receiver, checker_self.expr_holds(recv, u) {
      inside = true
    }
    if obj = k.object, checker_self.expr_holds(obj, u) {
      inside = true
    }
    for arg in k.args {
      if checker_self.expr_holds(arg, u) {
        inside = true
      }
    }
    if !inside {
      return false
    }
  }
  true
}

// Whether u is e or one of its operands, at any depth (not in a lambda's
// body, a block or an arm).
pub fn (checker_self: Checker) expr_holds(e: Expr, u: Expr): Bool {
  if e == u {
    return true
  }
  if e.kind == ex_lambda() {
    return false
  }
  for sub in checker_self.operands_of(e) {
    if checker_self.expr_holds(sub, u) {
      return true
    }
  }
  false
}

// The end of a loop whose body began at stamp entry, with the proof and
// shrink logs at uses and kills: a proof in the body that rests on a size
// read before the loop is taken back when the body may change that size.
pub fn (checker_self: Checker) loop_region_end(entry: Int, uses: Int, kills: Int) {
  if checker_self.facts.kill_cont.size == kills {
    return
  }
  killed: Array(String) = []
  for i in kills..checker_self.facts.kill_cont.size {
    if !killed.contains(checker_self.facts.kill_cont[i]) {
      killed.push(checker_self.facts.kill_cont[i])
    }
  }
  for i in uses..checker_self.facts.use_cont.size {
    if checker_self.facts.use_anchor[i] <= entry && killed.contains(checker_self.facts.use_cont[i]) {
      checker_self.facts.use_expr[i].proven = false
    }
  }
}

// ---- Names a lambda assigns
//
// A lambda shares the variables it captures with the code around it, so
// one that assigns a captured name changes it whenever it is called,
// through any call that may reach it. Once such a lambda is checked, the
// name carries no fact (lw_has), the facts it had end, and the proofs made
// in the statement that holds the lambda about it are taken back
// (sweep_proofs): a loop around the lambda may call it before reaching
// them again.
pub fn (checker_self: Checker) lambda_writes(names: Array(String)) {
  for n in names {
    if !checker_self.lw_has(n) {
      checker_self.facts.lam_written.push(n)
      checker_self.kill_facts_for(n)
      checker_self.nn_remove(n)
      checker_self.cap_remove(n)
      checker_self.cap_kill_guards(n)
      checker_self.sv_remove_var(n)
      checker_self.bv_remove_var(n)
      checker_self.cs_remove_var(n)
    }
  }
}

pub fn (checker_self: Checker) expr_mentions(e: Expr, names: Array(String)): Bool {
  if e.kind == ex_name() && names.contains(e.ident) {
    return true
  }
  if inner = e.inner, checker_self.expr_mentions(inner, names) {
    return true
  }
  if l = e.left, checker_self.expr_mentions(l, names) {
    return true
  }
  if r = e.right, checker_self.expr_mentions(r, names) {
    return true
  }
  if obj = e.object, checker_self.expr_mentions(obj, names) {
    return true
  }
  if recv = e.receiver, checker_self.expr_mentions(recv, names) {
    return true
  }
  for arg in e.args {
    if checker_self.expr_mentions(arg, names) {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) sweep_expr(e: Expr, names: Array(String)) {
  if e.proven && checker_self.expr_mentions(e, names) {
    e.proven = false
  }
  if inner = e.inner {
    checker_self.sweep_expr(inner, names)
  }
  if l = e.left {
    checker_self.sweep_expr(l, names)
  }
  if r = e.right {
    checker_self.sweep_expr(r, names)
  }
  if obj = e.object {
    checker_self.sweep_expr(obj, names)
  }
  if recv = e.receiver {
    checker_self.sweep_expr(recv, names)
  }
  for arg in e.args {
    checker_self.sweep_expr(arg, names)
  }
  for elem in e.elems {
    checker_self.sweep_expr(elem, names)
  }
  for field_expr in e.field_exprs {
    checker_self.sweep_expr(field_expr, names)
  }
  if sz = e.size_expr {
    checker_self.sweep_expr(sz, names)
  }
  if c = e.cond {
    checker_self.sweep_expr(c, names)
  }
  if b = e.block {
    for st in b.body {
      checker_self.sweep_proofs(st, names)
    }
  }
  for cs in e.cases {
    for st in cs.body {
      checker_self.sweep_proofs(st, names)
    }
  }
  for st in e.else_body {
    checker_self.sweep_proofs(st, names)
  }
  for part in e.parts {
    if inner2 = part.expr {
      checker_self.sweep_expr(inner2, names)
    }
  }
}

pub fn (checker_self: Checker) sweep_proofs(s: Stmt, names: Array(String)) {
  if s.proven {
    if t = s.target, checker_self.expr_mentions(t, names) {
      s.proven = false
    }
    if v = s.value, checker_self.expr_mentions(v, names) {
      s.proven = false
    }
  }
  if e = s.expr {
    checker_self.sweep_expr(e, names)
  }
  if c = s.cond {
    checker_self.sweep_expr(c, names)
  }
  if t = s.target {
    checker_self.sweep_expr(t, names)
  }
  if v = s.value {
    checker_self.sweep_expr(v, names)
  }
  for st in s.then_body {
    checker_self.sweep_proofs(st, names)
  }
  for st in s.else_body {
    checker_self.sweep_proofs(st, names)
  }
  for st in s.body {
    checker_self.sweep_proofs(st, names)
  }
  for st in s.pre {
    checker_self.sweep_proofs(st, names)
  }
}

// ---- A name bound anew
//
// A case binding (`case xs: Array(Int)`), and any other binding of a new
// variable, may hide a variable of the same name; the facts, keyed by
// name, would otherwise go on describing the hidden one. They end when the name is bound (the hidden variable
// loses them too, until its next assignment or loop).
pub fn (checker_self: Checker) forget_facts(name: String) {
  if name.size == 0 || !checker_self.facts_name(name) {
    return
  }
  checker_self.kill_facts_for(name)
  checker_self.nn_remove(name)
  checker_self.cap_remove(name)
  checker_self.cap_kill_guards(name)
  checker_self.sv_remove_var(name)
  checker_self.bv_remove_var(name)
  checker_self.cs_remove_var(name)
}

// Whether any fact or relation names name.
pub fn (checker_self: Checker) facts_name(name: String): Bool {
  f = checker_self.facts
  f.fact_var.contains(name) || f.fact_cont.contains(name) || f.nn_var.contains(name) || f.cap_var.contains(name) || f.sv_var.contains(name) || f.sv_cont.contains(name) || f.bv_var.contains(name) || f.bv_cont.contains(name) || f.cs_var.contains(name) || f.cs_cont.contains(name) || f.gcap_var.contains(name) || f.gnn_var.contains(name) || f.gpos_var.contains(name) || f.gne_var.contains(name)
}
