import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import loader
import typed_ir
import checker.names
import checker

// Whether a method name is declared on the type whose methods carry the
// owner name owner (an external method of a builtin type: `Int`).
pub fn (checker_self: Checker) owner_has_method(owner: String, name: String): Bool {
  for ms in checker_self.methods {
    if ms.owner == owner && ms.name == name {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) expect_no_args(expr: Expr, ret: Ty, message: String): Ty {
  if expr.args.size == 0 {
    return ret
  }
  checker_self.fail(expr.loc, message)
  ret
}

pub fn (checker_self: Checker) check_float_method(expr: Expr): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "Float64.${expr.callee} does not take a block")
    return checker_self.t_float()
  }
  if float_math_unary(expr.callee).size > 0 {
    return checker_self.expect_no_args(expr, checker_self.t_float(), "Float64.${expr.callee} takes no arguments")
  }
  if float_math_binary(expr.callee).size > 0 {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "Float64.${expr.callee} takes one Float64")
      return checker_self.t_float()
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_float())
    if !got.is_float() {
      checker_self.fail(expr.args[0].loc, "Float64.${expr.callee} expects Float64, got ${got.show()}")
    }
    return checker_self.t_float()
  }
  if expr.callee == "to_bits" {
    return checker_self.expect_no_args(expr, checker_self.t_uint64(), "Float64.to_bits takes no arguments")
  }
  if expr.callee == "to_i" {
    return checker_self.expect_no_args(expr, checker_self.t_int(), "Float64.to_i takes no arguments")
  }
  if checker_self.owner_has_method("Float64", expr.callee) {
    none: Ty? = nil
    return checker_self.dispatch_method(expr, checker_self.t_float(), none)
  }
  checker_self.fail_hint(expr.loc, "no method ${expr.callee} on Float64", checker_self.builtin_hint(checker_self.t_float(), expr.callee))
  checker_self.t_float()
}

pub fn (checker_self: Checker) check_int_method(expr: Expr, object: Ty): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "${object.show()}.${expr.callee} does not take a block")
    return object
  }
  if expr.callee == "to_f" {
    return checker_self.expect_no_args(expr, checker_self.t_float(), "${object.show()}.to_f takes no arguments")
  }
  if expr.callee == "abs" {
    if object.is_unsigned() {
      checker_self.fail(expr.loc, "abs of a ${object.show()} is the value itself")
    }
    return checker_self.expect_no_args(expr, object, "${object.show()}.abs takes no arguments")
  }
  if rt = int_conversion_ty(expr.callee) {
    return checker_self.expect_no_args(expr, rt, "${object.show()}.${expr.callee} takes no arguments")
  }
  if int_bit_count(expr.callee).size > 0 {
    return checker_self.expect_no_args(expr, checker_self.t_int(), "${object.show()}.${expr.callee} takes no arguments")
  }
  now = removed_int_conversion(expr.callee)
  if now.size > 0 {
    checker_self.fail(expr.loc, removed_int_message(expr.callee, now))
    return checker_self.t_int()
  }
  if checker_self.owner_has_method(object.show(), expr.callee) {
    none: Ty? = nil
    return checker_self.dispatch_method(expr, object, none)
  }
  checker_self.fail_hint(expr.loc, "no method ${expr.callee} on ${object.show()}", checker_self.builtin_hint(object, expr.callee))
  object
}

pub fn (checker_self: Checker) check_bytes_method(expr: Expr): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "Bytes.${expr.callee} does not take a block")
    return checker_self.t_bytes()
  }
  if expr.callee == "get" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "get takes one Int")
      return ty_nilable(checker_self.t_int())
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if !got.is_int() {
      checker_self.fail(expr.args[0].loc, "get index must be Int")
    }
    return ty_nilable(checker_self.t_int())
  }
  if expr.callee == "to_buf" {
    return checker_self.expect_no_args(expr, checker_self.t_buf(), "to_buf takes no arguments")
  }
  if expr.callee == "to_s" {
    // The same bytes as a String, unchecked, as Buf's to_s: no copy.
    return checker_self.expect_no_args(expr, checker_self.t_string(), "to_s takes no arguments")
  }
  if expr.callee == "chars" {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_string()), "chars takes no arguments")
  }
  if expr.callee == "code_points" {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_int()), "code_points takes no arguments")
  }
  // String's split and strip, over bytes: the parts are Bytes.
  if expr.callee == "split" {
    if expr.args.size != 1 && expr.args.size != 2 {
      checker_self.fail(expr.loc, "split takes a separator (Bytes or a String) and an optional limit, split(sep, limit)")
      return ty_array(checker_self.t_bytes())
    }
    got = checker_self.check_expr(expr.args[0])
    if !got.is_bytes() && !got.is_string() {
      checker_self.fail(expr.args[0].loc, "the separator of split is Bytes or a String, got ${got.show()}")
    }
    if expr.args.size == 2 {
      lim = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
      if !lim.is_int() {
        checker_self.fail(expr.args[1].loc, "the limit of split is an Int, got ${lim.show()}")
      }
    }
    return ty_array(checker_self.t_bytes())
  }
  if expr.callee == "strip" || expr.callee == "strip_left" || expr.callee == "strip_right" {
    return checker_self.expect_no_args(expr, checker_self.t_bytes(), "${expr.callee} takes no arguments")
  }
  none: Ty? = nil
  checker_self.dispatch_method(expr, checker_self.t_bytes(), none)
}

pub fn (checker_self: Checker) check_string_method(expr: Expr): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "String.${expr.callee} does not take a block")
    return checker_self.t_string()
  }
  if expr.callee == "split" {
    if expr.args.size != 1 && expr.args.size != 2 {
      checker_self.fail(expr.loc, "split takes a String separator and an optional limit, split(sep, limit)")
      return ty_array(checker_self.t_string())
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if !ty_assignable(got, checker_self.t_string()) {
      checker_self.fail(expr.args[0].loc, "split expects String separator")
    }
    if expr.args.size == 2 {
      lim = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
      if !lim.is_int() {
        checker_self.fail(expr.args[1].loc, "the limit of split is an Int, got ${lim.show()}")
      }
    }
    return ty_array(checker_self.t_string())
  }
  if expr.callee == "replace" {
    if expr.args.size != 2 {
      checker_self.fail(expr.loc, "replace takes the String to find and the String to put in its place, replace(from, to)")
      return checker_self.t_string()
    }
    for a in expr.args {
      got = checker_self.check_expr_as(a, checker_self.t_string())
      if !ty_assignable(got, checker_self.t_string()) {
        checker_self.fail(a.loc, "replace expects String, got ${got.show()}")
        return checker_self.t_string()
      }
    }
    return checker_self.t_string()
  }
  if expr.callee == "repeat" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "repeat takes one Int, the count")
      return checker_self.t_string()
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if !got.is_int() {
      checker_self.fail(expr.args[0].loc, "the count of repeat is an Int, got ${got.show()}")
    }
    return checker_self.t_string()
  }
  if expr.callee == "pad_left" || expr.callee == "pad_right" {
    if expr.args.size != 1 && expr.args.size != 2 {
      checker_self.fail(expr.loc, "${expr.callee} takes a width and an optional fill byte, ${expr.callee}(width, ' ')")
      return checker_self.t_string()
    }
    for a in expr.args {
      got = checker_self.check_expr_as(a, checker_self.t_int())
      if !got.is_int() {
        checker_self.fail(a.loc, "the width and the fill byte of ${expr.callee} are Int, got ${got.show()}")
        return checker_self.t_string()
      }
    }
    return checker_self.t_string()
  }
  if expr.callee == "fields" {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_string()), "fields takes no arguments")
  }
  if expr.callee == "strip" {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "strip takes no arguments")
  }
  if expr.callee == "strip_left" {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "strip_left takes no arguments")
  }
  if expr.callee == "strip_right" {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "strip_right takes no arguments")
  }
  if expr.callee == "to_ascii_lower" || expr.callee == "to_ascii_upper" {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "${expr.callee} takes no arguments")
  }
  if expr.callee == "lines" {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_string()), "lines takes no arguments")
  }
  if expr.callee == "delete_prefix" || expr.callee == "delete_suffix" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "${expr.callee} takes one String, the part to remove")
      return checker_self.t_string()
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if !ty_assignable(got, checker_self.t_string()) {
      checker_self.fail(expr.args[0].loc, "${expr.callee} expects String, got ${got.show()}")
    }
    return checker_self.t_string()
  }
  if expr.callee == "bytes" {
    // A builtin read-only property is read without parentheses.
    checker_self.fail(expr.loc, "bytes is read without parentheses: write .bytes")
    return checker_self.t_bytes()
  }
  if expr.callee == "chars" {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_string()), "chars takes no arguments")
  }
  if expr.callee == "code_points" {
    return checker_self.expect_no_args(expr, ty_array(checker_self.t_int()), "code_points takes no arguments")
  }
  // Strict parsing: the whole string is the number, else nil; an
  // integer may name its base (2..36).
  if expr.callee == "to_f" {
    return checker_self.expect_no_args(expr, ty_nilable(checker_self.t_float()), "String.to_f takes no arguments")
  }
  if expr.callee == "to_i64" {
    // One integer spelling.
    checker_self.fail(expr.loc, removed_int_message("to_i64", "to_i"))
    return ty_nilable(checker_self.t_int())
  }
  if expr.callee == "to_i" || expr.callee == "to_u64" {
    rt = checker_self.t_int()
    if expr.callee == "to_u64" {
      rt = checker_self.t_uint64()
    }
    if expr.args.size > 1 {
      checker_self.fail(expr.loc, "String.${expr.callee} takes at most one argument, the base")
    } else if expr.args.size == 1 {
      bt = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
      if !bt.is_int() {
        checker_self.fail(expr.args[0].loc, "the base of String.${expr.callee} must be Int")
      } else if expr.args[0].kind == ex_int() && (expr.args[0].int_bits < 2 || expr.args[0].int_bits > 36) {
        checker_self.fail(expr.args[0].loc, "the base of String.${expr.callee} must be in 2..36")
      }
    }
    return ty_nilable(rt)
  }
  if expr.callee == "get" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "get takes one Int")
      return ty_nilable(checker_self.t_int())
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if !got.is_int() {
      checker_self.fail(expr.args[0].loc, "get index must be Int")
    }
    return ty_nilable(checker_self.t_int())
  }
  none: Ty? = nil
  checker_self.dispatch_method(expr, checker_self.t_string(), none)
}

pub fn (checker_self: Checker) check_buf_method(expr: Expr): Ty {
  if b = expr.block {
    checker_self.fail(expr.loc, "Buf.${expr.callee} does not take a block")
    return checker_self.t_void()
  }
  if expr.callee == "push_bytes" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "push_bytes takes one Bytes")
      return checker_self.t_void()
    }
    got = checker_self.check_expr(expr.args[0])
    if !got.is_bytes() && !got.is_buf() {
      checker_self.fail(expr.args[0].loc, "push_bytes expects Bytes or Buf, got ${got.show()}")
    }
    return checker_self.t_void()
  }
  if expr.callee == "to_bytes" {
    return checker_self.expect_no_args(expr, checker_self.t_bytes(), "to_bytes takes no arguments")
  }
  if expr.callee == "push_byte" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "push_byte takes one Int")
      return checker_self.t_void()
    }
    bty = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if !bty.is_int() {
      checker_self.fail(expr.args[0].loc, "byte must be Int")
    }
    return checker_self.t_void()
  }
  if expr.callee == "push_str" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "push_str takes one String, Bytes or Buf")
      return checker_self.t_void()
    }
    s = checker_self.check_expr(expr.args[0])
    if !ty_assignable(s, checker_self.t_string()) && !s.is_bytes() && !s.is_buf() {
      checker_self.fail(expr.args[0].loc, "push_str expects String, Bytes or Buf, got ${s.show()}")
    }
    return checker_self.t_void()
  }
  if expr.callee == "push_slice" {
    if expr.args.size != 3 {
      checker_self.fail(expr.loc, "push_slice takes string, start, stop")
      return checker_self.t_void()
    }
    s = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if !ty_assignable(s, checker_self.t_string()) {
      checker_self.fail(expr.args[0].loc, "push_slice expects String")
    }
    start = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    stop = checker_self.check_expr_as(expr.args[2], checker_self.t_int())
    if start.is_int() {
      if !stop.is_int() {
        checker_self.fail(expr.loc, "start and stop must be Int")
      }
    } else {
      checker_self.fail(expr.loc, "start and stop must be Int")
    }
    return checker_self.t_void()
  }
  if expr.callee == "push_fmt_f" {
    if expr.args.size != 2 {
      checker_self.fail(expr.loc, "push_fmt_f takes Float64 and Int")
      return checker_self.t_void()
    }
    v = checker_self.check_expr(expr.args[0])
    if !v.is_numeric() {
      checker_self.fail(expr.args[0].loc, "push_fmt_f expects Float64")
    }
    if !v.is_float() {
      expr.args[0].ty = checker_self.t_float()
    }
    prec = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    if !prec.is_int() {
      checker_self.fail(expr.args[1].loc, "precision must be Int")
    }
    return checker_self.t_void()
  }
  if expr.callee == "push_fmt_i" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "push_fmt_i takes one Int")
      return checker_self.t_void()
    }
    n = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if !n.is_int() {
      checker_self.fail(expr.args[0].loc, "push_fmt_i expects Int")
    }
    return checker_self.t_void()
  }
  if expr.callee == "starts_with" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "starts_with takes one String")
      return checker_self.t_bool()
    }
    s = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if !ty_assignable(s, checker_self.t_string()) {
      checker_self.fail(expr.args[0].loc, "starts_with expects String")
    }
    return checker_self.t_bool()
  }
  if expr.callee == "to_s" {
    return checker_self.expect_no_args(expr, checker_self.t_string(), "to_s takes no arguments")
  }
  if expr.callee == "clear" {
    return checker_self.expect_no_args(expr, checker_self.t_void(), "clear takes no arguments")
  }
  if expr.callee == "get" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "get takes one Int")
      return ty_nilable(checker_self.t_int())
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if !got.is_int() {
      checker_self.fail(expr.args[0].loc, "get index must be Int")
    }
    return ty_nilable(checker_self.t_int())
  }
  none: Ty? = nil
  checker_self.dispatch_method(expr, checker_self.t_buf(), none)
}

pub fn (checker_self: Checker) check_array_method(expr: Expr, array: Ty): Ty {
  if recv = expr.receiver, checker_self.refuse_walk_change(expr, recv) {
    return checker_self.t_void()
  }
  // An element type with its own <.
  if ordered = checker_self.user_order_call(expr, array) {
    return ordered
  }
  if expr.callee == "push" {
    if b = expr.block {
      checker_self.fail(expr.loc, "push does not take a block")
      return checker_self.t_void()
    }
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "push takes one argument")
      return checker_self.t_void()
    }
    if e = array.inner {
      got = checker_self.check_expr_as(expr.args[0], e)
      if !ty_assignable(got, e) {
        checker_self.fail(expr.args[0].loc, "push expects ${e.show()}, got ${got.show()}")
      }
    }
    return checker_self.t_void()
  }
  if expr.callee == "pop" {
    if b = expr.block {
      checker_self.fail(expr.loc, "pop does not take a block")
      if e = array.inner {
        return e
      }
      return checker_self.t_int()
    }
    if expr.args.size == 0 {
      // The last element, removed, or nil when the array is empty.
      if e = array.inner {
        return ty_nilable(e)
      }
      return ty_nilable(checker_self.t_int())
    }
    checker_self.fail(expr.loc, "pop takes no arguments")
    if e = array.inner {
      return e
    }
    return checker_self.t_int()
  }
  if expr.callee == "each" {
    if b = expr.block {
      if expr.args.size != 0 {
        checker_self.fail(expr.loc, "each takes a block, not arguments")
        return checker_self.t_void()
      }
      if b.params.size != 1 {
        checker_self.fail(b.loc, "each takes a lambda of one parameter: xs.each (x) { ... }")
        return checker_self.t_void()
      }
      if e = array.inner {
        saved_for = checker_self.for_names.size
        saved_places = checker_self.place_names.size
        saved_walks = checker_self.walk_texts.size
        checker_self.loop_depth += 1
        checker_self.push_scope()
        checker_self.bind_walk_param(expr, b, array, e)
        checker_self.check_walk_body(b, "each")
        checker_self.pop_scope()
        checker_self.loop_depth -= 1
        checker_self.end_places(saved_places)
        checker_self.end_plain_walks(saved_walks)
        checker_self.end_for_vars(saved_for)
      }
      return checker_self.t_void()
    }
    checker_self.fail(expr.loc, "each needs a block")
    return checker_self.t_void()
  }
  if expr.callee == "sort" {
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "sort takes no arguments")
      return checker_self.t_void()
    }
    if b = expr.block {
      if b.params.size != 2 {
        checker_self.fail(b.loc, "sort takes a lambda of two parameters: xs.sort (a, b) { ... }")
        return checker_self.t_void()
      }
      if e = array.inner {
        saved_for = checker_self.for_names.size
        checker_self.refuse_block_param_outer(b, expr.callee)
        checker_self.push_scope()
        checker_self.bind(b.params[0], e)
        checker_self.bind(b.params[1], e)
        checker_self.note_for_var(b.params[0], 7)
        checker_self.note_for_var(b.params[1], 7)
        checker_self.loop_depth += 1
        bt = checker_self.check_walk_value(b, "sort", checker_self.t_bool())
        checker_self.loop_depth -= 1
        checker_self.pop_scope()
        checker_self.end_for_vars(saved_for)
        if !bt.is_bool() {
          checker_self.fail(b.loc, "sort comparator must return Bool")
        }
      }
      return checker_self.t_void()
    }
    if e = array.inner, !checker_self.is_ordered_ty(e) {
      checker_self.fail(expr.loc, "Array.sort needs an ordered element type or a comparator block")
    }
    return checker_self.t_void()
  }
  if expr.callee == "sorted" {
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "sorted takes no arguments")
      if e = array.inner {
        return ty_array(e)
      }
      return ty_array(checker_self.t_int())
    }
    if b = expr.block {
      if b.params.size != 2 {
        checker_self.fail(b.loc, "sorted takes a lambda of two parameters: xs.sorted (a, b) { ... }")
        if e = array.inner {
          return ty_array(e)
        }
        return ty_array(checker_self.t_int())
      }
      if e = array.inner {
        saved_for = checker_self.for_names.size
        checker_self.refuse_block_param_outer(b, expr.callee)
        checker_self.push_scope()
        checker_self.bind(b.params[0], e)
        checker_self.bind(b.params[1], e)
        checker_self.note_for_var(b.params[0], 7)
        checker_self.note_for_var(b.params[1], 7)
        checker_self.loop_depth += 1
        bt = checker_self.check_walk_value(b, "sorted", checker_self.t_bool())
        checker_self.loop_depth -= 1
        checker_self.pop_scope()
        checker_self.end_for_vars(saved_for)
        if !bt.is_bool() {
          checker_self.fail(b.loc, "sorted comparator must return Bool")
        }
        return ty_array(e)
      }
      return ty_array(checker_self.t_int())
    }
    if e = array.inner {
      if !checker_self.is_ordered_ty(e) {
        checker_self.fail(expr.loc, "Array.sorted needs an ordered element type or a comparator block")
      }
      return ty_array(e)
    }
    return ty_array(checker_self.t_int())
  }
  if expr.callee == "reverse" {
    if b = expr.block {
      checker_self.fail(expr.loc, "reverse does not take a block")
      return checker_self.t_void()
    }
    return checker_self.expect_no_args(expr, checker_self.t_void(), "reverse takes no arguments")
  }
  // `has` is the membership test of every collection.
  if expr.callee == "has" {
    member = expr.callee
    if b = expr.block {
      checker_self.fail(expr.loc, "${member} does not take a block")
      return checker_self.t_bool()
    }
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "${member} takes one argument")
      return checker_self.t_bool()
    }
    if e = array.inner {
      got = checker_self.check_expr_as(expr.args[0], e)
      if !ty_assignable(got, e) {
        checker_self.fail(expr.args[0].loc, "${member} expects ${e.show()}")
        return checker_self.t_bool()
      }
      checker_self.search_by_eq(expr, e)
    }
    return checker_self.t_bool()
  }
  if expr.callee == "any" || expr.callee == "all" {
    pred_name = expr.callee
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "${pred_name} takes a block, not arguments")
      return checker_self.t_bool()
    }
    if b = expr.block {
      if b.params.size != 1 {
        checker_self.fail(b.loc, "${pred_name} takes a lambda of one parameter: xs.${pred_name} (x) { ... }")
        return checker_self.t_bool()
      }
      if e = array.inner {
        saved_for = checker_self.for_names.size
        saved_places = checker_self.place_names.size
        saved_walks = checker_self.walk_texts.size
        checker_self.push_scope()
        checker_self.bind_walk_param(expr, b, array, e)
        checker_self.loop_depth += 1
        bt = checker_self.check_walk_value(b, pred_name, checker_self.t_bool())
        checker_self.loop_depth -= 1
        checker_self.pop_scope()
        checker_self.end_places(saved_places)
        checker_self.end_plain_walks(saved_walks)
        checker_self.end_for_vars(saved_for)
        if !bt.is_bool() {
          checker_self.fail(b.loc, "${pred_name} predicate must return Bool")
        }
      }
      return checker_self.t_bool()
    }
    checker_self.fail(expr.loc, "${pred_name} needs a block")
    return checker_self.t_bool()
  }
  if expr.callee == "index_of" && expr.args.size > 0 {
    if b = expr.block {
      checker_self.fail(expr.loc, "index_of takes a value or a function, not both")
      return ty_nilable(checker_self.t_int())
    }
    if expr.args.size != 1 && expr.args.size != 2 {
      checker_self.fail(expr.loc, "index_of takes a value and an optional start, index_of(v, from)")
      return ty_nilable(checker_self.t_int())
    }
    if e = array.inner {
      got = checker_self.check_expr_as(expr.args[0], e)
      if !ty_assignable(got, e) {
        checker_self.fail(expr.args[0].loc, "index_of expects ${e.show()}")
        return ty_nilable(checker_self.t_int())
      }
      if expr.args.size == 2 {
        ft = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
        if !ft.is_int() {
          checker_self.fail(expr.args[1].loc, "the start of index_of is an Int, got ${ft.show()}")
          return ty_nilable(checker_self.t_int())
        }
        checker_self.search_array_from(expr, e)
        return ty_nilable(checker_self.t_int())
      }
      checker_self.search_by_eq(expr, e)
    }
    return ty_nilable(checker_self.t_int())
  }
  if expr.callee == "last_index_of" {
    if b = expr.block {
      checker_self.fail(expr.loc, "last_index_of does not take a block")
      return ty_nilable(checker_self.t_int())
    }
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "last_index_of takes one value")
      return ty_nilable(checker_self.t_int())
    }
    if e = array.inner {
      got = checker_self.check_expr_as(expr.args[0], e)
      if !ty_assignable(got, e) {
        checker_self.fail(expr.args[0].loc, "last_index_of expects ${e.show()}")
        return ty_nilable(checker_self.t_int())
      }
      checker_self.search_array_from(expr, e)
    }
    return ty_nilable(checker_self.t_int())
  }
  if expr.callee == "min" {
    if b = expr.block {
      checker_self.fail(expr.loc, "min does not take a block")
      if e = array.inner {
        return ty_nilable(e)
      }
      return ty_nilable(checker_self.t_int())
    }
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "min takes no arguments")
    }
    if e = array.inner {
      if checker_self.is_ordered_ty(e) {
        if e.is_bool() {
          checker_self.fail(expr.loc, "Array.min needs an ordered element type")
        }
      } else {
        checker_self.fail(expr.loc, "Array.min needs an ordered element type")
      }
      return ty_nilable(e)
    }
    return ty_nilable(checker_self.t_int())
  }
  if expr.callee == "max" {
    if b = expr.block {
      checker_self.fail(expr.loc, "max does not take a block")
      if e = array.inner {
        return ty_nilable(e)
      }
      return ty_nilable(checker_self.t_int())
    }
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "max takes no arguments")
    }
    if e = array.inner {
      if checker_self.is_ordered_ty(e) {
        if e.is_bool() {
          checker_self.fail(expr.loc, "Array.max needs an ordered element type")
        }
      } else {
        checker_self.fail(expr.loc, "Array.max needs an ordered element type")
      }
      return ty_nilable(e)
    }
    return ty_nilable(checker_self.t_int())
  }
  if expr.callee == "sum" {
    if b = expr.block {
      checker_self.fail(expr.loc, "sum does not take a block")
      if e = array.inner {
        return e
      }
      return checker_self.t_int()
    }
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "sum takes no arguments")
    }
    if e = array.inner {
      if checker_self.is_numeric_ty(e) {
        return e
      }
      checker_self.fail(expr.loc, "Array.sum needs a numeric element type")
      return e
    }
    return checker_self.t_int()
  }
  if expr.callee == "clear" {
    if b = expr.block {
      checker_self.fail(expr.loc, "clear does not take a block")
      return checker_self.t_void()
    }
    return checker_self.expect_no_args(expr, checker_self.t_void(), "clear takes no arguments")
  }
  if expr.callee == "fill" {
    if b = expr.block {
      checker_self.fail(expr.loc, "fill does not take a block")
      return checker_self.t_void()
    }
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "fill takes one argument")
      return checker_self.t_void()
    }
    if e = array.inner {
      if e.is_integer() {
        // Any integer element (Int, Int32, UInt32, UInt64).
        got = checker_self.check_expr_as(expr.args[0], e)
        if !got.same_as(e) {
          checker_self.fail(expr.args[0].loc, "fill expects ${e.show()}")
        }
      } else if e.is_bool() {
        got = checker_self.check_expr_as(expr.args[0], checker_self.t_bool())
        if !got.is_bool() {
          checker_self.fail(expr.args[0].loc, "fill expects Bool")
        }
      } else {
        checker_self.check_fill_any(expr, e)
      }
    } else {
      checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    }
    return checker_self.t_void()
  }
  if expr.callee == "reserve" {
    if b = expr.block {
      checker_self.fail(expr.loc, "reserve does not take a block")
      return checker_self.t_void()
    }
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "reserve takes one Int")
      return checker_self.t_void()
    }
    n = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if !n.is_int() {
      checker_self.fail(expr.args[0].loc, "reserve expects Int")
    }
    return checker_self.t_void()
  }
  if expr.callee == "get" {
    if b = expr.block {
      checker_self.fail(expr.loc, "get does not take a block")
      if e = array.inner {
        return ty_nilable(e)
      }
      return checker_self.t_int()
    }
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "get takes one Int")
      if e = array.inner {
        return ty_nilable(e)
      }
      return checker_self.t_int()
    }
    got = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    if !got.is_int() {
      checker_self.fail(expr.args[0].loc, "get index must be Int")
    }
    if e = array.inner {
      return ty_nilable(e)
    }
    return ty_nilable(checker_self.t_int())
  }
  if expr.callee == "parallel" {
    return checker_self.check_parallel(expr, array)
  }
  if e = array.inner {
    if got = checker_self.check_array_verb(expr, array, e) {
      return got
    }
    if got = checker_self.check_array_fn_verb(expr, array, e) {
      return got
    }
  }
  if checker_self.owner_has_method("Array", expr.callee) {
    none: Ty? = nil
    return checker_self.dispatch_method(expr, array, none)
  }
  hint = checker_self.builtin_hint(array, expr.callee)
  if expr.callee == "contains" || expr.callee == "includes" || expr.callee == "has_key" {
    hint = " (write `xs.has(v)`)"
  }
  checker_self.fail_hint(expr.loc, "no method ${expr.callee} on Array", hint)
  checker_self.t_int()
}

pub fn (checker_self: Checker) check_parallel(expr: Expr, array: Ty): Ty {
  if b = expr.block {
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "parallel takes a block, not arguments")
      return ty_array(checker_self.t_int())
    }
    if b.params.size != 1 {
      checker_self.fail(b.loc, "parallel takes a lambda of one parameter: xs.parallel (x) { ... }")
      return ty_array(checker_self.t_int())
    }
    if e = array.inner {
      // Each body gets its element, so an element type that cannot cross
      // to another task (a class, a Hash, a fn, an Array of those) would
      // put one mutable object in two bodies when the array holds it
      // twice, or two elements reach it: the
      // receiver obeys spawn's and send's rule for what crosses.
      if !checker_self.copyable_for_spawn(e) {
        checker_self.fail(expr.loc, ".parallel cannot run over an ${array.show()}: its elements (${e.show()}) cannot cross to another task, and two bodies would share one object when the array holds it twice; a mutable object reaches another task only inside a Mutex")
        return ty_array(checker_self.t_int())
      }
      saved_for = checker_self.for_names.size
      checker_self.refuse_block_param_outer(b, "parallel")
      checker_self.push_scope()
      checker_self.bind(b.params[0], e)
      checker_self.note_for_var(b.params[0], 9)
      checker_self.in_task += 1
      saved_loops = checker_self.loop_depth
      checker_self.loop_depth = 0
      saved_try = checker_self.try_in
      checker_self.try_in = "a parallel block"
      saved_fails = checker_self.spawn_fails
      checker_self.spawn_fails = []
      saved_ph = checker_self.pending_handles
      saved_pa = checker_self.pending_arrays
      checker_self.pending_handles = []
      checker_self.pending_arrays = []
      result = checker_self.t_int()
      if b.paren {
        s = checker_self.inline_enter(b, "parallel", checker_self.inline_result(b))
        want = checker_self.return_type
        result = checker_self.check_block_value(b)
        checker_self.inline_leave(s)
        if !want.is_var() && !checker_self.has_err() {
          if !ty_assignable(result, want) {
            checker_self.fail(b.body[b.body.size - 1].loc, "the lambda's result is ${want.show()}, its last expression ${result.show()}")
          }
          result = want
        }
      } else {
        result = checker_self.check_block_value(b)
      }
      checker_self.pending_handles = saved_ph
      checker_self.pending_arrays = saved_pa
      fails = checker_self.spawn_fails
      checker_self.spawn_fails = saved_fails
      checker_self.try_in = saved_try
      if fails.size > 0 && !checker_self.has_err() {
        // A `?` in the body: that element is the failure.
        parts: Array(Ty) = []
        parts.push(result)
        parts.concat(fails)
        result = ty_union_build(parts)
      }
      checker_self.loop_depth = saved_loops
      checker_self.in_task -= 1
      checker_self.pop_scope()
      checker_self.end_for_vars(saved_for)
      saved_pp = checker_self.par_param
      saved_pt = checker_self.par_param_ty
      checker_self.par_param = b.params[0]
      checker_self.par_param_ty = e
      checker_self.collect_spawn_captures(expr, b.body)
      checker_self.par_param = saved_pp
      checker_self.par_param_ty = saved_pt
      return ty_array(result)
    }
    checker_self.fail(expr.loc, "parallel needs an element type")
    return ty_array(checker_self.t_int())
  }
  checker_self.fail(expr.loc, "parallel needs a block")
  ty_array(checker_self.t_int())
}

// The members of Set(T): add, has and delete take one element (add
// says whether it was new, delete whether it was there), each walks the
// elements, values gives them as an array, clear empties the set; size
// is read without parentheses (check_field).
pub fn (checker_self: Checker) check_set_method(expr: Expr, set: Ty): Ty {
  elem = checker_self.t_int()
  if k = set.key {
    elem = k
  }
  c = expr.callee
  if c == "add" || c == "has" || c == "delete" {
    if expr.args.size != 1 {
      checker_self.fail(expr.loc, "${c} takes one element")
      return checker_self.t_bool()
    }
    if b = expr.block {
      checker_self.fail(expr.loc, "${c} takes one element")
      return checker_self.t_bool()
    }
    got = checker_self.check_expr_as(expr.args[0], elem)
    if !ty_assignable(got, elem) {
      checker_self.fail(expr.args[0].loc, "the element must be ${elem.show()}, got ${got.show()}")
    }
    return checker_self.t_bool()
  }
  if c == "values" || c == "clear" {
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "${c} takes no arguments")
    } else if b = expr.block {
      checker_self.fail(expr.loc, "${c} takes no arguments")
    }
    if c == "clear" {
      return checker_self.t_void()
    }
    return ty_array(elem)
  }
  if c == "delete_if" {
    return checker_self.check_hash_delete_if(expr, set, true)
  }
  if c == "each" {
    if b = expr.block {
      if expr.args.size != 0 {
        checker_self.fail(expr.loc, "each takes a block, not arguments")
        return checker_self.t_void()
      }
      if b.params.size != 1 {
        checker_self.fail(b.loc, "each takes a lambda of one parameter: s.each (v) { ... }")
        return checker_self.t_void()
      }
      checker_self.refuse_block_param_outer(b, "each")
      checker_self.push_scope()
      checker_self.bind(b.params[0], elem)
      checker_self.loop_depth += 1
      checker_self.check_walk_body(b, "each")
      checker_self.loop_depth -= 1
      checker_self.pop_scope()
      return checker_self.t_void()
    }
    checker_self.fail(expr.loc, "each needs a block")
    return checker_self.t_void()
  }
  if checker_self.owner_has_method("Set", c) {
    none: Ty? = nil
    return checker_self.dispatch_method(expr, set, none)
  }
  hint = checker_self.builtin_hint(set, c)
  if c == "has_key" || c == "contains" || c == "includes" {
    hint = " (write `s.has(v)`)"
  } else if c == "push" || c == "insert" || c == "put" {
    hint = " (write `s.add(v)`)"
  } else if c == "remove" {
    hint = " (write `s.delete(v)`)"
  } else if c == "keys" || c == "to_a" {
    hint = " (write `s.values()`)"
  }
  checker_self.fail_hint(expr.loc, "no method ${c} on ${set.show()}", hint)
  checker_self.t_int()
}

pub fn (checker_self: Checker) check_hash_method(expr: Expr, hash: Ty): Ty {
  if expr.callee == "keys" {
    if expr.args.size == 0 {
      if b = expr.block {
        checker_self.fail(expr.loc, "keys takes no arguments")
      }
      if k = hash.key {
        return ty_array(k)
      }
      return ty_array(checker_self.t_int())
    }
    checker_self.fail(expr.loc, "keys takes no arguments")
    if k = hash.key {
      return ty_array(k)
    }
    return ty_array(checker_self.t_int())
  }
  if expr.callee == "values" {
    if expr.args.size == 0 {
      if b = expr.block {
        checker_self.fail(expr.loc, "values takes no arguments")
      }
      if v = hash.val {
        return ty_array(v)
      }
      return ty_array(checker_self.t_int())
    }
    checker_self.fail(expr.loc, "values takes no arguments")
    if v = hash.val {
      return ty_array(v)
    }
    return ty_array(checker_self.t_int())
  }
  // `has`, the one membership test of every collection.
  if expr.callee == "has" {
    if expr.args.size == 1 {
      if b = expr.block {
        checker_self.fail(expr.loc, "${expr.callee} takes one key")
        return checker_self.t_bool()
      }
    } else {
      checker_self.fail(expr.loc, "${expr.callee} takes one key")
      return checker_self.t_bool()
    }
    if k = hash.key {
      got = checker_self.check_expr_as(expr.args[0], k)
      if !ty_assignable(got, k) {
        checker_self.fail(expr.args[0].loc, "hash key must be ${k.show()}, got ${got.show()}")
      }
    }
    return checker_self.t_bool()
  }
  if expr.callee == "get_or" {
    // One spelling per meaning: `h[k] ?? d` says it, with the same one
    // probe (the lookup's found flag chooses the value or d).
    checker_self.fail(expr.loc, "Hash has no get_or: write h[k] ?? default, the value or default when the key is missing")
    for a in expr.args {
      dummy = checker_self.check_expr(a)
    }
    if v = hash.val {
      return v
    }
    return checker_self.t_int()
  }
  if expr.callee == "inc" {
    if expr.args.size == 1 || expr.args.size == 2 {
      if b = expr.block {
        checker_self.fail(expr.loc, "inc takes key and optional amount")
        return checker_self.t_int()
      }
    } else {
      checker_self.fail(expr.loc, "inc takes key and optional amount")
      return checker_self.t_int()
    }
    // A counter of any integer type: the amount and the result are the
    // value's type.
    vt = checker_self.t_int()
    if v = hash.val {
      vt = v
    }
    if !vt.is_integer() {
      checker_self.fail(expr.loc, "inc needs integer values; this hash's values are ${vt.show()}")
      return checker_self.t_int()
    }
    if k = hash.key {
      got = checker_self.check_expr_as(expr.args[0], k)
      if !ty_assignable(got, k) {
        checker_self.fail(expr.args[0].loc, "hash key must be ${k.show()}, got ${got.show()}")
      }
    }
    if expr.args.size == 2 {
      by = checker_self.check_expr_as(expr.args[1], vt)
      if !ty_assignable(by, vt) {
        checker_self.fail(expr.args[1].loc, "inc amount must be ${vt.show()}, got ${by.show()}")
      }
    }
    return vt
  }
  if expr.callee == "delete_if" {
    return checker_self.check_hash_delete_if(expr, hash, false)
  }
  if expr.callee == "each" {
    if b = expr.block {
      if expr.args.size != 0 {
        checker_self.fail(expr.loc, "each takes a block, not arguments")
        return checker_self.t_void()
      }
      if b.params.size != 2 {
        checker_self.fail(b.loc, "each takes a lambda of two parameters: h.each (k, v) { ... }")
        return checker_self.t_void()
      }
      if k = hash.key, v = hash.val {
        saved_for = checker_self.for_names.size
        checker_self.refuse_block_param_outer(b, "each")
        checker_self.push_scope()
        checker_self.bind(b.params[0], k)
        checker_self.bind(b.params[1], v)
        checker_self.note_for_var(b.params[0], 8)
        checker_self.note_for_var(b.params[1], 8)
        checker_self.loop_depth += 1
        checker_self.check_walk_body(b, "each")
        checker_self.loop_depth -= 1
        checker_self.pop_scope()
        checker_self.end_for_vars(saved_for)
      }
      return checker_self.t_void()
    }
    checker_self.fail(expr.loc, "each needs a block")
    return checker_self.t_void()
  }
  if expr.callee == "clear" {
    if expr.args.size == 0 {
      if b = expr.block {
        checker_self.fail(expr.loc, "clear takes no arguments")
        return checker_self.t_void()
      }
      return checker_self.t_void()
    }
    checker_self.fail(expr.loc, "clear takes no arguments")
    return checker_self.t_void()
  }
  if expr.callee == "get" {
    if expr.args.size == 1 {
      if b = expr.block {
        checker_self.fail(expr.loc, "get takes one key")
        return checker_self.t_int()
      }
    } else {
      checker_self.fail(expr.loc, "get takes one key")
      return checker_self.t_int()
    }
    if k = hash.key {
      got = checker_self.check_expr_as(expr.args[0], k)
      if !ty_assignable(got, k) {
        checker_self.fail(expr.args[0].loc, "hash key must be ${k.show()}, got ${got.show()}")
      }
    }
    if v = hash.val {
      return ty_nilable(v)
    }
    return checker_self.t_int()
  }
  if expr.callee == "delete" {
    // The value removed, or nil when the key was absent.
    gone = ty_nilable(checker_self.t_int())
    if v = hash.val {
      gone = ty_nilable(v)
    }
    if expr.args.size == 1 {
      if b = expr.block {
        checker_self.fail(expr.loc, "delete takes one key")
        return gone
      }
    } else {
      checker_self.fail(expr.loc, "delete takes one key")
      return gone
    }
    if k = hash.key {
      got = checker_self.check_expr_as(expr.args[0], k)
      if !ty_assignable(got, k) {
        checker_self.fail(expr.args[0].loc, "hash key must be ${k.show()}, got ${got.show()}")
      }
    }
    return gone
  }
  if expr.callee == "get_slice" {
    if expr.args.size == 3 {
      if b = expr.block {
        checker_self.fail(expr.loc, "get_slice takes string, start, stop")
        return checker_self.t_int()
      }
    } else {
      checker_self.fail(expr.loc, "get_slice takes string, start, stop")
      return checker_self.t_int()
    }
    ok = false
    if k = hash.key, v = hash.val, k.is_string() && v.is_string() {
      ok = true
    }
    if !ok {
      checker_self.fail(expr.loc, "get_slice is Hash(String, String) only")
    }
    s = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if !ty_assignable(s, checker_self.t_string()) {
      checker_self.fail(expr.args[0].loc, "get_slice expects String")
    }
    start = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    stop = checker_self.check_expr_as(expr.args[2], checker_self.t_int())
    if start.is_int() {
      if !stop.is_int() {
        checker_self.fail(expr.loc, "start and stop must be Int")
      }
    } else {
      checker_self.fail(expr.loc, "start and stop must be Int")
    }
    if v = hash.val {
      return ty_nilable(v)
    }
    return ty_nilable(checker_self.t_string())
  }
  if expr.callee == "get_concat" {
    if expr.args.size == 2 {
      if b = expr.block {
        checker_self.fail(expr.loc, "get_concat takes two Strings")
        return ty_nilable(checker_self.t_int())
      }
    } else {
      checker_self.fail(expr.loc, "get_concat takes two Strings")
      return ty_nilable(checker_self.t_int())
    }
    ok = false
    if k = hash.key, v = hash.val, k.is_string() && v.is_int() {
      ok = true
    }
    if !ok {
      checker_self.fail(expr.loc, "get_concat is Hash(String, Int) only")
    }
    a = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    bstr = checker_self.check_expr_as(expr.args[1], checker_self.t_string())
    if ty_assignable(a, checker_self.t_string()) {
      if !ty_assignable(bstr, checker_self.t_string()) {
        checker_self.fail(expr.loc, "get_concat expects String keys")
      }
    } else {
      checker_self.fail(expr.loc, "get_concat expects String keys")
    }
    return ty_nilable(checker_self.t_int())
  }
  if checker_self.owner_has_method("Hash", expr.callee) {
    none: Ty? = nil
    return checker_self.dispatch_method(expr, hash, none)
  }
  hint = checker_self.builtin_hint(hash, expr.callee)
  if expr.callee == "has_key" || expr.callee == "contains" || expr.callee == "includes" || expr.callee == "contains_key" {
    hint = " (write `h.has(k)`)"
  }
  checker_self.fail_hint(expr.loc, "no method ${expr.callee} on Hash", hint)
  checker_self.t_int()
}

pub fn (checker_self: Checker) check_codec_call(expr: Expr): Ty? {
  // The compiler's own sources' sha256 (the hex text), not std.digest's
  // digest.sha256 (the bytes).
  if expr.callee == "sha256" && expr.mod_name.size == 0 {
    return checker_self.check_one_string(expr, checker_self.t_string())
  }
  nil
}

pub fn (checker_self: Checker) check_one_string(expr: Expr, ret: Ty): Ty {
  if expr.args.size == 1 {
    if b = expr.block {
      checker_self.fail(expr.loc, "${expr.callee} takes one String")
      return ret
    }
  } else {
    checker_self.fail(expr.loc, "${expr.callee} takes one String")
    return ret
  }
  got = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
  if !ty_assignable(got, checker_self.t_string()) {
    checker_self.fail(expr.args[0].loc, "${expr.callee} expects String")
  }
  ret
}

pub fn (checker_self: Checker) check_buf_string(expr: Expr): Ty {
  if expr.args.size == 2 {
    if b = expr.block {
      checker_self.fail(expr.loc, "${expr.callee} takes Buf and String")
      return checker_self.t_void()
    }
  } else {
    checker_self.fail(expr.loc, "${expr.callee} takes Buf and String")
    return checker_self.t_void()
  }
  buf = checker_self.check_expr(expr.args[0])
  if !buf.is_buf() {
    checker_self.fail(expr.args[0].loc, "${expr.callee} expects Buf")
  }
  s = checker_self.check_expr_as(expr.args[1], checker_self.t_string())
  if !ty_assignable(s, checker_self.t_string()) {
    checker_self.fail(expr.args[1].loc, "${expr.callee} expects String")
  }
  checker_self.t_void()
}

pub fn (checker_self: Checker) check_langarena_call(expr: Expr): Ty? {
  if expr.callee == "now_us" {
    if expr.args.size == 0 {
      if b = expr.block {
        checker_self.fail(expr.loc, "now_us takes no arguments")
        return checker_self.t_int()
      }
      return checker_self.t_int()
    }
    checker_self.fail(expr.loc, "now_us takes no arguments")
    return checker_self.t_int()
  }
  if expr.callee == "repeat_byte" {
    if expr.args.size == 2 {
      if b = expr.block {
        checker_self.fail(expr.loc, "repeat_byte takes a byte and a count")
        return checker_self.t_string()
      }
    } else {
      checker_self.fail(expr.loc, "repeat_byte takes a byte and a count")
      return checker_self.t_string()
    }
    bty = checker_self.check_expr_as(expr.args[0], checker_self.t_int())
    n = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    if !bty.is_int() {
      checker_self.fail(expr.args[0].loc, "repeat_byte expects Int byte")
    }
    if !n.is_int() {
      checker_self.fail(expr.args[1].loc, "repeat_byte expects Int count")
    }
    return checker_self.t_string()
  }
  if expr.callee == "bytes_to_str" {
    checker_self.fail(expr.loc, "bytes_to_str is gone: push the bytes into a Buf (buf.push_byte(n)) and take buf.to_s(), or a Bytes' b.to_s()")
    return checker_self.t_string()
  }
  if expr.callee == "fmt_float" {
    if expr.args.size == 2 {
      if b = expr.block {
        checker_self.fail(expr.loc, "fmt_float takes Float64 and Int")
        return checker_self.t_string()
      }
    } else {
      checker_self.fail(expr.loc, "fmt_float takes Float64 and Int")
      return checker_self.t_string()
    }
    got = checker_self.check_expr(expr.args[0])
    if !got.is_numeric() {
      checker_self.fail(expr.args[0].loc, "fmt_float expects Float64")
    }
    if !got.is_float() {
      expr.args[0].ty = checker_self.t_float()
    }
    prec = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    if !prec.is_int() {
      checker_self.fail(expr.args[1].loc, "precision must be Int")
    }
    return checker_self.t_string()
  }
  if expr.callee == "str_to_f_slice" {
    if expr.args.size == 3 {
      if b = expr.block {
        checker_self.fail(expr.loc, "str_to_f_slice takes String, start, stop")
        return ty_nilable(checker_self.t_float())
      }
    } else {
      checker_self.fail(expr.loc, "str_to_f_slice takes String, start, stop")
      return ty_nilable(checker_self.t_float())
    }
    s = checker_self.check_expr_as(expr.args[0], checker_self.t_string())
    if !ty_assignable(s, checker_self.t_string()) {
      checker_self.fail(expr.args[0].loc, "str_to_f_slice expects String")
    }
    start = checker_self.check_expr_as(expr.args[1], checker_self.t_int())
    stop = checker_self.check_expr_as(expr.args[2], checker_self.t_int())
    if start.is_int() {
      if !stop.is_int() {
        checker_self.fail(expr.loc, "start and stop must be Int")
      }
    } else {
      checker_self.fail(expr.loc, "start and stop must be Int")
    }
    return ty_nilable(checker_self.t_float())
  }
  nil
}

pub fn (checker_self: Checker) check_i32_bytes_to_str(expr: Expr): Ty {
  if expr.args.size == 1 {
    if b = expr.block {
      checker_self.fail(expr.loc, "bytes_to_str takes Array(Int)")
      return checker_self.t_string()
    }
  } else {
    checker_self.fail(expr.loc, "bytes_to_str takes Array(Int)")
    return checker_self.t_string()
  }
  got = checker_self.check_expr(expr.args[0])
  ok = false
  if got.is_array() {
    if e = got.inner, e.is_int() {
      ok = true
    }
  }
  if !ok {
    checker_self.fail(expr.args[0].loc, "bytes_to_str expects Array(Int)")
  }
  checker_self.t_string()
}
