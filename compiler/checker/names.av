pub fn is_op_fn_name(name: String): Bool {
  if str_eq(name, "&+") {
    return true
  }
  if str_eq(name, "&-") {
    return true
  }
  if str_eq(name, "&*") {
    return true
  }
  if str_eq(name, "+") {
    return true
  }
  if str_eq(name, "-") {
    return true
  }
  if str_eq(name, "*") {
    return true
  }
  if str_eq(name, "/") {
    return true
  }
  if str_eq(name, "%") {
    return true
  }
  if str_eq(name, "==") {
    return true
  }
  if str_eq(name, "!=") {
    return true
  }
  if str_eq(name, "<") {
    return true
  }
  if str_eq(name, "<=") {
    return true
  }
  if str_eq(name, ">") {
    return true
  }
  if str_eq(name, ">=") {
    return true
  }
  false
}

pub fn binary_op_method_name(op: Int): String {
  fn_op_name(op)
}

pub fn ty_to_type_name(ty: Ty, loc: Location): TypeName {
  if ty.is_union {
    if ty.is_nilable {
      inner = ty_without_nil(ty)
      tn = ty_to_type_name(inner, loc)
      if tn.nilable {
      } else {
        tn.nilable = true
      }
      return tn
    }
    out = TypeName.new(loc, "")
    for m in ty.members {
      out.members.push(ty_to_type_name(m, loc))
    }
    return out
  }
  k = ty.kind
  if k == tyk_int() {
    return TypeName.new(loc, "Int")
  }
  if k == tyk_int64() {
    return TypeName.new(loc, "Int64")
  }
  if k == tyk_uint64() {
    return TypeName.new(loc, "UInt64")
  }
  if k == tyk_bool() {
    return TypeName.new(loc, "Bool")
  }
  if k == tyk_float() {
    return TypeName.new(loc, "Float64")
  }
  if k == tyk_string() {
    return TypeName.new(loc, "String")
  }
  if k == tyk_buf() {
    return TypeName.new(loc, "Buf")
  }
  if k == tyk_bytes() {
    return TypeName.new(loc, "Bytes")
  }
  if k == tyk_nil() {
    return TypeName.new(loc, "Nil")
  }
  if k == tyk_void() {
    return TypeName.new(loc, "Void")
  }
  if k == tyk_array() {
    tn = TypeName.new(loc, "Array")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_hash() {
    tn = TypeName.new(loc, "Hash")
    if ke = ty.key {
      tn.args.push(ty_to_type_name(ke, loc))
    }
    if va = ty.val {
      tn.args.push(ty_to_type_name(va, loc))
    }
    return tn
  }
  if k == tyk_ptr() {
    tn = TypeName.new(loc, "Ptr")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_join() {
    tn = TypeName.new(loc, "JoinHandle")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_fn() {
    tn = TypeName.new(loc, "")
    tn.fn_type = true
    for m in ty.members {
      tn.args.push(ty_to_type_name(m, loc))
    }
    if r = ty.inner {
      if r.is_void {
      } else {
        tn.ret = ty_to_type_name(r, loc)
      }
    }
    return tn
  }
  TypeName.new(loc, ty.name)
}

pub class ImplFact {
  type_key: String = ""
  iface_key: String = ""
  mod_name: String = ""
  vis: Bool = false

  fn initialize {
  }
}

pub fn str_index(names: Array(String), name: String): Int {
  for i in 0..names.size {
    if str_eq(names[i], name) {
      return i
    }
  }
  0 - 1
}

pub fn iface_key_of(name: String, args: Array(Ty)): String {
  if args.size == 0 {
    return name
  }
  buf = buf_new()
  buf.push_str(name)
  i = 0
  while i < args.size {
    buf.push_str("__")
    buf.push_str(mangle_ty(args[i]))
    i = i + 1
  }
  buf.to_s
}

pub fn impl_type_key(ty: Ty): String {
  if ty.is_ptr {
    return mangle_ty(ty)
  }
  ty.name
}

pub fn ty_eq_sig(a: Ty, b: Ty, ap: Array(String), bp: Array(String)): Bool {
  if a.is_var {
    if b.is_var {
      ia = str_index(ap, a.name)
      ib = str_index(bp, b.name)
      if ia < 0 {
        return false
      }
      return ia == ib
    }
    return false
  }
  if b.is_var {
    return false
  }
  if a.kind != b.kind {
    return false
  }
  if a.is_fn {
    if a.members.size != b.members.size {
      return false
    }
    i = 0
    while i < a.members.size {
      if ty_eq_sig(a.members[i], b.members[i], ap, bp) {
      } else {
        return false
      }
      i = i + 1
    }
    if ar = a.inner {
      if br = b.inner {
        return ty_eq_sig(ar, br, ap, bp)
      }
    }
    return false
  }
  if a.is_union {
    if a.members.size != b.members.size {
      return false
    }
    i = 0
    while i < a.members.size {
      if ty_eq_sig(a.members[i], b.members[i], ap, bp) {
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  if a.is_ptr {
    if ae = a.inner {
      if be = b.inner {
        return ty_eq_sig(ae, be, ap, bp)
      }
    }
    return false
  }
  if a.is_array {
    if ae = a.inner {
      if be = b.inner {
        return ty_eq_sig(ae, be, ap, bp)
      }
    }
    return false
  }
  if a.is_join {
    if ae = a.inner {
      if be = b.inner {
        return ty_eq_sig(ae, be, ap, bp)
      }
    }
    return false
  }
  if a.is_hash {
    if ak = a.key {
      if av = a.val {
        if bk = b.key {
          if bv = b.val {
            if ty_eq_sig(ak, bk, ap, bp) {
              return ty_eq_sig(av, bv, ap, bp)
            }
          }
        }
      }
    }
    return false
  }
  a.same_as(b)
}
