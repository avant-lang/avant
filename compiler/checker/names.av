// A builtin type that takes external methods, as the owner name a method
// of it carries: it has no module of its own, so its external methods are
// seen as functions are (in their module, and in its importers when pub).
pub fn builtin_owner_name(name: String): Bool {
  name == "String" || name == "Bytes" || name == "Buf" || name == "Int" || name == "Int32" || name == "UInt32" || name == "UInt64" || name == "Float64" || name == "Bool" || name == "Array" || name == "Hash" || name == "Set"
}

// The builtin value types an external method may extend, besides the
// program's own types and C pointers.
pub fn builtin_receiver_ok(ty: Ty): Bool {
  ty.is_bytes() || ty.is_string() || ty.is_buf() || ty.is_integer() || ty.is_float() || ty.is_bool()
}

// The owner a program's method on a builtin container is filed under
// ("Array", "Hash", "Set"), or "" for any other type: one name for every
// element type, the receiver's declared type telling the instances apart.
pub fn container_owner(ty: Ty): String {
  if ty.is_array() {
    return "Array"
  }
  if ty.is_set() {
    return "Set"
  }
  if ty.is_hash() {
    return "Hash"
  }
  ""
}

pub fn is_op_fn_name(name: String): Bool {
  if name == "&" || name == "|" || name == "^" || name == "<<" || name == ">>" || name == "[]" || name == "[]=" {
    return true
  }
  if name == "&+" {
    return true
  }
  if name == "&-" {
    return true
  }
  if name == "&*" {
    return true
  }
  if name == "+" {
    return true
  }
  if name == "-" {
    return true
  }
  if name == "*" {
    return true
  }
  if name == "/" {
    return true
  }
  if name == "%" {
    return true
  }
  if name == "==" {
    return true
  }
  if name == "!=" {
    return true
  }
  if name == "<" {
    return true
  }
  if name == "<=" {
    return true
  }
  if name == ">" {
    return true
  }
  if name == ">=" {
    return true
  }
  false
}

pub fn binary_op_method_name(op: Int): String {
  fn_op_name(op)
}

pub fn ty_to_type_name(ty: Ty, loc: Location): TypeName {
  if ty.rec {
    // A recursive alias by its name, in its module.
    rn = TypeName.new(loc, ty.name)
    rn.mod_name = ty.mod_name
    rn.pinned = true
    return rn
  }
  if ty.is_union() {
    if ty.is_nilable() {
      inner = ty_without_nil(ty)
      tn = ty_to_type_name(inner, loc)
      if !tn.nilable {
        tn.nilable = true
      }
      return tn
    }
    out = TypeName.new(loc, "")
    for m in ty.members {
      out.members.push(ty_to_type_name(m, loc))
    }
    return out
  }
  k = ty.kind
  if k == tyk_int() {
    return TypeName.new(loc, "Int")
  }
  if k == tyk_uint64() {
    return TypeName.new(loc, "UInt64")
  }
  if k == tyk_int32() {
    return TypeName.new(loc, "Int32")
  }
  if k == tyk_uint32() {
    return TypeName.new(loc, "UInt32")
  }
  if k == tyk_bool() {
    return TypeName.new(loc, "Bool")
  }
  if k == tyk_float() {
    return TypeName.new(loc, "Float64")
  }
  if k == tyk_string() {
    return TypeName.new(loc, "String")
  }
  if k == tyk_buf() {
    return TypeName.new(loc, "Buf")
  }
  if k == tyk_hasher() {
    return TypeName.new(loc, "Hasher")
  }
  if k == tyk_bytes() {
    return TypeName.new(loc, "Bytes")
  }
  if k == tyk_nil() {
    return TypeName.new(loc, "Nil")
  }
  if k == tyk_void() {
    return TypeName.new(loc, "Void")
  }
  if k == tyk_array() {
    tn = TypeName.new(loc, "Array")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_hash() && ty.is_set() {
    tn = TypeName.new(loc, "Set")
    if ke = ty.key {
      tn.args.push(ty_to_type_name(ke, loc))
    }
    return tn
  }
  if k == tyk_hash() {
    tn = TypeName.new(loc, "Hash")
    if ke = ty.key {
      tn.args.push(ty_to_type_name(ke, loc))
    }
    if va = ty.val {
      tn.args.push(ty_to_type_name(va, loc))
    }
    return tn
  }
  if k == tyk_ptr() {
    tn = TypeName.new(loc, "Ptr")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_join() {
    tn = TypeName.new(loc, "JoinHandle")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_fn() {
    tn = TypeName.new(loc, "")
    tn.fn_type = true
    for m in ty.members {
      tn.args.push(ty_to_type_name(m, loc))
    }
    if r = ty.inner, !r.is_void() {
      tn.ret = ty_to_type_name(r, loc)
    }
    return tn
  }
  // A named type (a struct, a class, an instance of a generic one, a C
  // layout): pinned to its module, so the name means this type wherever
  // an instance reads it.
  named = TypeName.new(loc, ty.name)
  named.mod_name = ty.mod_name
  named.pinned = true
  named
}

pub class ImplFact {
  pub type_key: String = ""
  pub iface_key: String = ""
  pub mod_name: String = ""
  pub vis: Bool = false

  fn initialize {
  }
}

pub fn iface_key_of(name: String, args: Array(Ty)): String {
  if args.size == 0 {
    return name
  }
  buf = buf_new()
  buf.push_str(name)
  for arg in args {
    buf.push_str("__")
    buf.push_str(mangle_ty(arg))
  }
  buf.to_s()
}

pub fn impl_type_key(ty: Ty): String {
  if ty.is_ptr() {
    return mangle_ty(ty)
  }
  ty.name
}

pub fn ty_eq_sig(a: Ty, b: Ty, ap: Array(String), bp: Array(String)): Bool {
  if a.is_var() {
    if b.is_var() {
      ia = ap.index_of(a.name) ?? -1
      ib = bp.index_of(b.name) ?? -1
      if ia < 0 {
        return false
      }
      return ia == ib
    }
    return false
  }
  if b.is_var() {
    return false
  }
  if a.kind != b.kind {
    return false
  }
  if a.rec || b.rec {
    return a.same_as(b)
  }
  if a.is_fn() {
    if a.members.size != b.members.size {
      return false
    }
    for i in 0..a.members.size {
      if !ty_eq_sig(a.members[i], b.members[i], ap, bp) {
        return false
      }
    }
    if ar = a.inner, br = b.inner {
      return ty_eq_sig(ar, br, ap, bp)
    }
    return false
  }
  if a.is_union() {
    if a.members.size != b.members.size {
      return false
    }
    for i in 0..a.members.size {
      if !ty_eq_sig(a.members[i], b.members[i], ap, bp) {
        return false
      }
    }
    return true
  }
  if a.is_ptr() {
    if ae = a.inner, be = b.inner {
      return ty_eq_sig(ae, be, ap, bp)
    }
    return false
  }
  if a.is_array() {
    if ae = a.inner, be = b.inner {
      return ty_eq_sig(ae, be, ap, bp)
    }
    return false
  }
  if a.is_join() {
    if ae = a.inner, be = b.inner {
      return ty_eq_sig(ae, be, ap, bp)
    }
    return false
  }
  if a.is_hash() {
    if a.is_set() != b.is_set() {
      return false
    }
    if ak = a.key, av = a.val, bk = b.key, bv = b.val, ty_eq_sig(ak, bk, ap, bp) {
      return ty_eq_sig(av, bv, ap, bp)
    }
    return false
  }
  a.same_as(b)
}
