import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import loader
import typed_ir
import checker.names
import checker

pub fn (checker_self: Checker) note_modules {
  checker_self.root_module = checker_self.program.root_module
  checker_self.current_module = checker_self.root_module
  km = Hash(String, Int).new()
  for info in checker_self.program.mods {
    km[info.name] = 1
    for imp in info.imports {
      km[imp] = 1
    }
  }
  checker_self.known_mods = km
  ln = Hash(String, Int).new()
  for info in checker_self.program.mods {
    for imp in info.imports {
      last = module_last_name(imp)
      if last.size > 0 {
        ln[last] = 1
      }
    }
  }
  checker_self.last_names = ln
  tm = Hash(String, String).new()
  tv = Hash(String, Int).new()
  checker_self.type_mod = tm
  checker_self.type_vis = tv
  tlist = Hash(String, String).new()
  checker_self.type_list = tlist
  tmulti = Hash(String, Int).new()
  checker_self.type_multi = tmulti
  for sdef in checker_self.program.structs {
    checker_self.remember_type(sdef.name, sdef.mod_name, sdef.vis)
  }
  for cdef in checker_self.program.classes {
    checker_self.remember_type(cdef.name, cdef.mod_name, cdef.vis)
  }
  for idef in checker_self.program.interfaces {
    checker_self.remember_type(idef.name, idef.mod_name, idef.vis)
  }
  for lib_def in checker_self.program.libs {
    for lay in lib_def.layouts {
      checker_self.remember_type(lay.name, lib_def.mod_name, lib_def.vis)
    }
  }
}

// Fields are private unless `pub`: a field without `pub` is read,
// written and named in a literal only inside its type's module.
pub fn (checker_self: Checker) field_hidden(owner: Ty, name: String): Bool {
  from = checker_self.current_module
  if owner.mod_name.size == 0 || from.size == 0 || owner.mod_name == from {
    return false
  }
  for f in owner.fields {
    if f.name == name {
      if f.vis {
        return false
      }
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) field_private_text(owner: Ty, name: String): String {
  "field ${name} of ${owner.show()} is private to module ${owner.mod_name}; mark it pub"
}

pub fn (checker_self: Checker) check_field_visible(owner: Ty, name: String, loc: Location): Bool {
  if checker_self.field_hidden(owner, name) {
    checker_self.fail_alone(loc, checker_self.field_private_text(owner, name))
    return false
  }
  true
}

pub fn type_slot(mod_name: String, name: String): String {
  "${mod_name}@@${name}"
}

pub fn (checker_self: Checker) remember_type(name: String, mod_name: String, vis: Bool) {
  slot = type_slot(mod_name, name)
  if prev = checker_self.type_mod.get(slot) {
    return
  }
  checker_self.type_mod[slot] = mod_name
  if vis {
    checker_self.type_vis[slot] = 1
  } else {
    checker_self.type_vis[slot] = 0
  }
  if listed = checker_self.type_list.get(name) {
    checker_self.type_list[name] = "${listed}\n${mod_name}"
    checker_self.type_multi[name] = 1
  } else {
    checker_self.type_list[name] = mod_name
    checker_self.type_mod[name] = mod_name
    if vis {
      checker_self.type_vis[name] = 1
    } else {
      checker_self.type_vis[name] = 0
    }
  }
}

pub fn (checker_self: Checker) mods_of_type(name: String): Array(String) {
  out: Array(String) = []
  if s = checker_self.type_list.get(name) {
    start = 0
    i = 0
    while i <= s.size {
      brk = false
      if i == s.size {
        brk = true
      } else {
        if s[i] == 10 {
          brk = true
        }
      }
      if brk {
        if i > start {
          out.push(str_slice(s, start, i))
        }
        start = i + 1
      }
      i += 1
    }
  }
  out
}

// Whether from_mod sees module mod_name's type name written bare: its
// own, or an import's pub type, but never a std module's, whose types
// are written with its name as its functions are (`fs.Reader`,
// `sync.Mutex(Int)`), so a program's own type of that name is its own.
pub fn (checker_self: Checker) type_slot_visible(name: String, mod_name: String, from_mod: String): Bool {
  if mod_name != from_mod && std_needs_qualifier(mod_name) {
    return false
  }
  if mod_name == "prelude" && from_mod != mod_name {
    // A module's own IoError or ProcessError wins over the prelude's.
    if own = checker_self.type_vis.get(type_slot(from_mod, name)) {
      return false
    }
  }
  checker_self.type_slot_visible_q(name, mod_name, from_mod)
}

// Whether from_mod sees module mod_name's type name written with that
// module's name (`std.fs.Reader`, `fs.Reader`).
pub fn (checker_self: Checker) type_slot_visible_q(name: String, mod_name: String, from_mod: String): Bool {
  if mod_name == from_mod {
    return true
  }
  if v = checker_self.type_vis.get(type_slot(mod_name, name)), v == 1 {
    return checker_self.imported_by(from_mod, mod_name)
  }
  false
}

pub fn (checker_self: Checker) imported_by(from_mod: String, target: String): Bool {
  if from_mod == target {
    return true
  }
  for info in checker_self.program.mods {
    if info.name == from_mod {
      for imp in info.imports {
        if imp == target {
          return true
        }
      }
    }
  }
  false
}

pub fn (checker_self: Checker) qualifier_ok(qual: String, from_mod: String): Bool {
  if qual == from_mod {
    return true
  }
  checker_self.imported_by(from_mod, qual)
}

pub fn (checker_self: Checker) visible_type_mod(name: String, from_mod: String, qual: String): String {
  if qual.size > 0 {
    if o = checker_self.type_mod.get(type_slot(qual, name)), checker_self.qualifier_ok(qual, from_mod) && checker_self.type_slot_visible_q(name, qual, from_mod) {
      return qual
    }
    return ""
  }
  owners = checker_self.mods_of_type(name)
  found = ""
  n = 0
  for owner in owners {
    if checker_self.type_slot_visible(name, owner, from_mod) {
      n += 1
      found = owner
    }
  }
  if n == 1 {
    return found
  }
  if n > 1 && checker_self.own_alias_same(name, from_mod) {
    return from_mod
  }
  ""
}

// Whether from_mod's own alias of the bare type name names the same type
// as every import's pub type or alias of that name it also sees: the
// module's own alias is then the name, and the import's is the same type
// (`type Data = data.Data` beside data's `pub type Data`). Two different
// types stay a clash that names both.
pub fn (checker_self: Checker) own_alias_same(name: String, from_mod: String): Bool {
  own = checker_self.t_int()
  if a = checker_self.alias_tys.get(type_slot(from_mod, name)) {
    own = a
  } else {
    return false
  }
  for m in checker_self.mods_of_type(name) {
    if m != from_mod && checker_self.type_slot_visible(name, m, from_mod) {
      other = checker_self.t_int()
      if b = checker_self.alias_tys.get(type_slot(m, name)) {
        other = b
      } else if c = checker_self.resolver.get_named_in(m, name) {
        other = c
      } else {
        return false
      }
      if !own.same_as(other) {
        return false
      }
    }
  }
  true
}

pub fn (checker_self: Checker) type_is_visible(name: String, from_mod: String, qual: String): Bool {
  if checker_self.mods_of_type(name).size == 0 {
    return true
  }
  checker_self.visible_type_mod(name, from_mod, qual).size > 0
}

pub fn (checker_self: Checker) lib_is_visible(name: String, from_mod: String): Bool {
  owner = from_mod
  if o = checker_self.lib_mod.get(name) {
    owner = o
  }
  if owner == from_mod {
    return true
  }
  if v = checker_self.lib_vis.get(name), v == 1 {
    return checker_self.imported_by(from_mod, owner)
  }
  false
}

pub fn (checker_self: Checker) fn_is_visible(fnn: Function, from_mod: String): Bool {
  checker_self.fn_is_visible_q(fnn, from_mod, checker_self.call_mod)
}

// A std module's functions are written with its name, as Go's are:
// `import std.fs` gives `fs.read`, never a bare `read`, so a program's own
// `read` is never ambiguous with it. Another module sees a pub function of
// a std module only at a call or a function value qualified by that
// module (qual); a program's own modules keep their bare names.
pub fn std_needs_qualifier(mod_name: String): Bool {
  mod_name.starts_with("std.")
}

pub fn (checker_self: Checker) fn_is_visible_q(fnn: Function, from_mod: String, qual: String): Bool {
  if fnn.mod_name == from_mod {
    return true
  }
  if fnn.mod_name.size == 0 {
    return true
  }
  if from_mod.size == 0 {
    return true
  }
  if fnn.vis {
    if std_needs_qualifier(fnn.mod_name) && qual != fnn.mod_name {
      return false
    }
    return checker_self.imported_by(from_mod, fnn.mod_name)
  }
  false
}

// The qualified spelling of a std module's function the current module
// imports and names bare (`fs.read` for `read` after `import std.fs`;
// the whole name when another import ends in the same last name); ""
// when no imported std module has a pub function of that name.
pub fn (checker_self: Checker) std_bare_spelling(name: String): String {
  from_mod = checker_self.current_module
  for i in checker_self.fn_indices_named(name) {
    sig = checker_self.functions[i]
    m = sig.node.mod_name
    if sig.name == name && sig.node.vis && m != from_mod && std_needs_qualifier(m) && checker_self.imported_by(from_mod, m) && !checker_self.sig_is_instance(sig) {
      last = module_last_name(m)
      if last.size > 0 && checker_self.last_name_unique(last, from_mod) {
        return "${last}.${name}"
      }
      return "${m}.${name}"
    }
  }
  ""
}

// Whether exactly one import of from_mod ends in the last name q.
fn (checker_self: Checker) last_name_unique(q: String, from_mod: String): Bool {
  n = 0
  for info in checker_self.program.mods {
    if info.name == from_mod {
      for imp in info.imports {
        if imp == q || module_last_name(imp) == q {
          n += 1
        }
      }
    }
  }
  n == 1
}

// The qualified spelling of a pub type of a std module the current module
// imports, named bare (`fs.Reader` for `Reader` after `import std.fs`);
// "" when no imported std module has a pub type of that name.
pub fn (checker_self: Checker) std_type_bare_spelling(name: String): String {
  from_mod = checker_self.current_module
  for m in checker_self.mods_of_type(name) {
    if m != from_mod && std_needs_qualifier(m) && checker_self.imported_by(from_mod, m) && checker_self.type_slot_visible_q(name, m, from_mod) {
      last = module_last_name(m)
      if last.size > 0 && checker_self.last_name_unique(last, from_mod) {
        return "${last}.${name}"
      }
      return "${m}.${name}"
    }
  }
  ""
}

// "unknown type NAME", or for a std module's type named bare, the
// qualified spelling to write.
pub fn (checker_self: Checker) unknown_type_text(name: String): String {
  spelled = checker_self.std_type_bare_spelling(name)
  if spelled.size > 0 {
    return "${name} needs its module's name: write ${spelled}; a std module's types are not named bare"
  }
  "unknown type ${name}"
}

// The type a type alias names where the alias is used as a value
// (`type Rx = regex.Regex`, then `Rx.compile(...)`, `Rx { ... }` or, for
// an alias of a class, `Rx.new(...)`): its target when that is a named
// type, through an alias of an alias; nil when name is a local, not an
// alias this module sees, or an alias of a union or a function type.
pub fn (checker_self: Checker) alias_value_target(name: String, loc: Location): TypeName? {
  if name.size == 0 || !(name[0] >= 65 && name[0] <= 90) {
    return nil
  }
  first = TypeName.new(loc, name)
  saved0 = checker_self.resolver.scope_mod
  checker_self.resolver.scope_mod = checker_self.current_module
  any = checker_self.resolver.find_alias(first)
  checker_self.resolver.scope_mod = saved0
  if a0 = any {
  } else {
    return nil
  }
  if found = checker_self.lookup(name) {
    return nil
  }
  if f = checker_self.implicit_field(name) {
    return nil
  }
  cur = name
  qual = ""
  depth = 0
  while depth < 16 {
    tn = TypeName.new(loc, cur)
    tn.mod_name = qual
    saved = checker_self.resolver.scope_mod
    checker_self.resolver.scope_mod = checker_self.current_module
    got = checker_self.resolver.find_alias(tn)
    checker_self.resolver.scope_mod = saved
    if al = got {
      if al.mod_name != checker_self.current_module && !(al.vis && checker_self.imported_by(checker_self.current_module, al.mod_name)) {
        return nil
      }
      t = al.target
      if t.fn_type || t.members.size > 0 || t.nilable {
        return nil
      }
      if t.args.size == 0 {
        cur = t.name
        qual = t.mod_name
        if more = checker_self.resolver.find_alias(t) {
          depth += 1
          continue
        }
      }
      return clone_type_name(t)
    }
    return nil
  }
  nil
}

// Why a type alias used as a value names no one type to build (an alias
// of a union or a function type), or "" (not such an alias, or a local).
pub fn (checker_self: Checker) alias_not_value_text(name: String, loc: Location): String {
  if name.size == 0 || !(name[0] >= 65 && name[0] <= 90) {
    return ""
  }
  tn = TypeName.new(loc, name)
  saved = checker_self.resolver.scope_mod
  checker_self.resolver.scope_mod = checker_self.current_module
  got = checker_self.resolver.find_alias(tn)
  checker_self.resolver.scope_mod = saved
  if al = got {
    if found = checker_self.lookup(name) {
      return ""
    }
    t = al.target
    if t.members.size > 0 || t.fn_type || t.nilable {
      return "${name} is an alias of a union or a function type, not one type: build a value with its member's own name"
    }
  }
  ""
}

// The spelling that replaced a prelude function the language no longer
// has, "" for any other name. Asked only where a call or a value names
// no function, so a program's own function of that name is its own.
pub fn removed_prelude_spelling(name: String): String {
  if name == "sqrt" {
    return "x.sqrt()"
  }
  if name == "exp" {
    return "x.exp()"
  }
  ""
}

// The message for a call of a prelude function that left the language
// for a std module or for the program's own code, "" for any other name.
// Asked only where a call names no function, so a program's own
// function of that name is its own.
pub fn left_prelude_text(name: String): String {
  if name == "puts_u" {
    return "puts_u is gone: write puts(n.wrap_u32()) for a 32-bit value's unsigned text, puts(n.wrap_u64()) for a 64-bit one"
  }
  if name == "crc32_bytes" {
    return "crc32_bytes is gone: write digest.crc32(b) (import std.digest)"
  }
  if name == "sha256" {
    return "sha256 is gone: write digest.sha256_hex(s.bytes) (import std.digest)"
  }
  ""
}

// A bare name of an imported std module's function: refused with its
// qualified spelling; a prelude function the language no longer has:
// refused with the spelling that replaced it; true when refused.
pub fn (checker_self: Checker) refuse_std_bare(loc: Location, name: String): Bool {
  gone = removed_prelude_spelling(name)
  if gone.size > 0 {
    checker_self.fail(loc, "${name} is a Float64 method: write ${gone}")
    return true
  }
  left = left_prelude_text(name)
  if left.size > 0 {
    checker_self.fail(loc, left)
    return true
  }
  spelled = checker_self.std_bare_spelling(name)
  if spelled.size == 0 {
    return false
  }
  checker_self.fail(loc, "${name} needs its module's name: write ${spelled}; a std module's functions are not named bare")
  true
}

// Functions are scoped per module. A candidate at an unqualified call is a
// function the current module sees (its own, and the pub functions of the
// modules it imports); at a qualified call `m.f()` (qual, or call_mod while
// match_func runs), only m's functions among them.
pub fn (checker_self: Checker) fn_candidate_q(fnn: Function, qual: String): Bool {
  if qual.size > 0 && fnn.mod_name != qual {
    return false
  }
  checker_self.fn_is_visible_q(fnn, checker_self.current_module, qual)
}

pub fn (checker_self: Checker) fn_candidate(fnn: Function): Bool {
  checker_self.fn_candidate_q(fnn, checker_self.call_mod)
}

// Two or more functions match a call equally. When they come from
// different modules, the message names each one's module and the
// qualified calls that pick one; as for types, a module's own
// function does not win over an imported one of the same signature.
pub fn (checker_self: Checker) fail_ambiguous_call(loc: Location, name: String, cands: Array(FuncSig), plain: String) {
  mods: Array(String) = []
  for sig in cands {
    seen = false
    for m in mods {
      if m == sig.node.mod_name {
        seen = true
      }
    }
    if !seen {
      mods.push(sig.node.mod_name)
    }
  }
  if mods.size < 2 {
    // Overloads of one module: each signature that matched.
    checker_self.fail(loc, "${plain}: ${checker_self.sigs_text(name, cands)} ${checker_self.both_word(cands.size)} match")
    return
  }
  defs = buf_new()
  calls = buf_new()
  for k in 0..mods.size {
    if k > 0 {
      sep = ", "
      if k == mods.size - 1 {
        sep = " and "
      }
      defs.push_str(sep)
      if k == mods.size - 1 {
        sep = " or "
      }
      calls.push_str(sep)
    }
    defs.push_str("${mods[k]}.${name}")
    calls.push_str("${mods[k]}.${name}()")
  }
  both = "both"
  if mods.size > 2 {
    both = "all"
  }
  checker_self.fail(loc, "${plain}: ${defs.to_s()} ${both} match; write ${calls.to_s()}")
}

// "a(x: Int) and a(s: String)", "f(), g() and h()": the signatures of
// a call's candidates, under the name the call wrote.
pub fn (checker_self: Checker) sigs_text(shown: String, cands: Array(FuncSig)): String {
  b = buf_new()
  for k in 0..cands.size {
    if k > 0 {
      if k == cands.size - 1 {
        b.push_str(" and ")
      } else {
        b.push_str(", ")
      }
    }
    b.push_str(checker_self.sig_text(shown, cands[k]))
  }
  b.to_s()
}

pub fn (checker_self: Checker) both_word(n: Int): String {
  if n > 2 {
    return "all"
  }
  "both"
}

// A method call two or more methods of one type match equally: each
// signature.
pub fn (checker_self: Checker) fail_ambiguous_method(loc: Location, shown: String, cands: Array(FuncSig)) {
  // Two modules' external methods of a builtin type, both seen here.
  mods: Array(String) = []
  for sig in cands {
    seen = false
    for m in mods {
      if m == sig.node.mod_name {
        seen = true
      }
    }
    if !seen {
      mods.push(sig.node.mod_name)
    }
  }
  if mods.size > 1 {
    mods.sort (a, b) { str_lt(a, b) }
    defs = buf_new()
    for k in 0..mods.size {
      if k > 0 {
        if k == mods.size - 1 {
          defs.push_str(" and ")
        } else {
          defs.push_str(", ")
        }
      }
      defs.push_str(mods[k])
    }
    checker_self.fail(loc, "ambiguous call to ${shown}: the methods of modules ${defs.to_s()} ${checker_self.both_word(mods.size)} match, and a method call cannot name its module; call it from a module that imports only one of them")
    return
  }
  checker_self.fail(loc, "ambiguous call to ${shown}: ${checker_self.sigs_text(shown, cands)} ${checker_self.both_word(cands.size)} match")
}

// A function name taken as a value that two or more functions match:
// from different modules, the qualified values that pick one; within one
// module, the fn type that picks one.
pub fn (checker_self: Checker) fail_ambiguous_value(loc: Location, name: String, cands: Array(FuncSig)) {
  mods: Array(String) = []
  for sig in cands {
    seen = false
    for m in mods {
      if m == sig.node.mod_name {
        seen = true
      }
    }
    if !seen {
      mods.push(sig.node.mod_name)
    }
  }
  if mods.size < 2 {
    first = cands[0]
    checker_self.fail(loc, "ambiguous function value ${name}: ${checker_self.sigs_text(name, cands)} ${checker_self.both_word(cands.size)} match; give the value its fn type to pick one (f: ${checker_self.fn_sig_ty(first).show()} = ${name})")
    return
  }
  defs = buf_new()
  for k in 0..mods.size {
    if k > 0 {
      if k == mods.size - 1 {
        defs.push_str(" and ")
      } else {
        defs.push_str(", ")
      }
    }
    defs.push_str("${mods[k]}.${name}")
  }
  picks = buf_new()
  for k2 in 0..mods.size {
    if k2 > 0 {
      if k2 == mods.size - 1 {
        picks.push_str(" or ")
      } else {
        picks.push_str(", ")
      }
    }
    picks.push_str("${mods[k2]}.${name}")
  }
  checker_self.fail(loc, "ambiguous function value ${name}: ${defs.to_s()} ${checker_self.both_word(mods.size)} match; write ${picks.to_s()}")
}

pub fn (checker_self: Checker) method_is_visible(fnn: Function, from_mod: String): Bool {
  // A builtin type has no module of its own to carry its methods: an
  // external method of String, Bytes, Buf, a number, Bool, an Array, a
  // Hash or a Set is seen as a function is, in
  // its module and, when pub, in the modules that import it.
  if builtin_owner_name(fnn.owner) {
    if fnn.mod_name == from_mod {
      return true
    }
    return fnn.vis && checker_self.imported_by(from_mod, fnn.mod_name)
  }
  if fnn.vis {
    return true
  }
  if fnn.name == "initialize" {
    return true
  }
  if fnn.mod_name == from_mod {
    return true
  }
  if fnn.mod_name.size == 0 {
    return true
  }
  if from_mod.size == 0 {
    return true
  }
  false
}

// The error for a bare name that names a type and something else of the
// same name that from_mod sees: two modules' types, or a type and a C lib
// or a function, each named with its module and the qualified spellings
// that pick one (two modules' types read "unknown type Token" or
// "ambiguous name Token; qualify it"). "" when the name is not ambiguous.
pub fn (checker_self: Checker) clash_message(name: String, from_mod: String): String {
  if !checker_self.clash_unqualified(name, from_mod) {
    return ""
  }
  kinds: Array(String) = []
  mods: Array(String) = []
  for m in checker_self.mods_of_type(name) {
    if checker_self.type_slot_visible(name, m, from_mod) {
      kinds.push("a type")
      mods.push(m)
    }
  }
  if id = checker_self.lib_names.get(name), checker_self.lib_is_visible(name, from_mod) {
    owner = from_mod
    if o = checker_self.lib_mod.get(name) {
      owner = o
    }
    kinds.push("a lib")
    mods.push(owner)
  }
  fn_mods = Hash(String, Int).new()
  for i in checker_self.fn_indices_named(name) {
    sig = checker_self.functions[i]
    if checker_self.fn_is_visible(sig.node, from_mod) {
      if seen = fn_mods.get(sig.node.mod_name) {
      } else {
        fn_mods[sig.node.mod_name] = 1
        kinds.push("a function")
        mods.push(sig.node.mod_name)
      }
    }
  }
  all_types = true
  for k in kinds {
    if k != "a type" {
      all_types = false
    }
  }
  what = buf_new()
  spell = buf_new()
  for i in 0..mods.size {
    if i > 0 {
      if i == mods.size - 1 {
        what.push_str(" and ")
        spell.push_str(" or ")
      } else {
        what.push_str(", ")
        spell.push_str(", ")
      }
    }
    if all_types {
      what.push_str(mods[i])
    } else {
      what.push_str("${kinds[i]} of ${mods[i]}")
    }
    spell.push_str("${mods[i]}.${name}")
  }
  if all_types {
    both = "both "
    if mods.size > 2 {
      both = ""
    }
    return "${name} is a type of ${both}${what.to_s()}: write ${spell.to_s()}"
  }
  "${name} is ${what.to_s()}: write ${spell.to_s()}"
}

pub fn (checker_self: Checker) clash_unqualified(name: String, from_mod: String): Bool {
  origins: Array(String) = []
  type_mods = checker_self.mods_of_type(name)
  ti = 0
  while ti < type_mods.size {
    if checker_self.type_slot_visible(name, type_mods[ti], from_mod) {
      origins.push("type:${type_mods[ti]}")
    }
    ti += 1
  }
  if id = checker_self.lib_names.get(name), checker_self.lib_is_visible(name, from_mod) {
    owner = from_mod
    if o = checker_self.lib_mod.get(name) {
      owner = o
    }
    origins.push("lib:${owner}")
  }
  fn_mods = Hash(String, Int).new()
  for i in checker_self.fn_indices_named(name) {
    sig = checker_self.functions[i]
    if checker_self.fn_is_visible(sig.node, from_mod) {
      if seen = fn_mods.get(sig.node.mod_name) {
      } else {
        fn_mods[sig.node.mod_name] = 1
        origins.push("fn:${sig.node.mod_name}")
      }
    }
  }
  owner_count = 0
  has_type = false
  has_fn = false
  has_lib = false
  for o in origins {
    if o.size >= 5 {
      if o.starts_with("type:") {
        owner_count += 1
        has_type = true
      } else if o.starts_with("lib:") {
        owner_count += 1
        has_type = true
        has_lib = true
      } else if o.starts_with("fn:") {
        has_fn = true
      }
    }
  }
  if owner_count > 1 && !has_fn && !has_lib && checker_self.own_alias_same(name, from_mod) {
    return false
  }
  if owner_count > 1 {
    return true
  }
  if owner_count >= 1 && has_fn {
    return true
  }
  false
}

pub fn (checker_self: Checker) lookup_named_type(name: String, loc: Location, qual: String): Ty? {
  if qual.size == 0 {
    clash = checker_self.clash_message(name, checker_self.current_module)
    if clash.size > 0 {
      checker_self.fail(loc, clash)
      return nil
    }
  }
  owner = checker_self.visible_type_mod(name, checker_self.current_module, qual)
  if owner.size > 0 {
    if ty = checker_self.resolver.get_named_in(owner, name) {
      return ty
    }
  }
  if ty = checker_self.resolver.get_named(name), checker_self.type_is_visible(name, checker_self.current_module, qual) {
    return ty
  }
  if qual.size > 0 {
    checker_self.fail(loc, "unknown type ${qual}.${name}")
  } else {
    checker_self.fail_hint(loc, checker_self.unknown_type_text(name), checker_self.type_hint_here(name))
  }
  nil
}

// The parts of a type name (its arguments, a union's members, a function
// type's result), each seen from the current module like the name's head
// (an instance now carries the types its arguments named, so each must be
// one this module may name; before, only the head was checked). A name
// two modules declare is given the module this one sees. True when every
// part may be named here.
pub fn (checker_self: Checker) type_parts_seen(tn: TypeName): Bool {
  for a in tn.args {
    if !checker_self.type_part_seen(a) {
      return false
    }
  }
  for m in tn.members {
    if !checker_self.type_part_seen(m) {
      return false
    }
  }
  if r = tn.ret {
    if !checker_self.type_part_seen(r) {
      return false
    }
  }
  true
}

pub fn (checker_self: Checker) type_part_seen(tn: TypeName): Bool {
  if tn.pinned {
    return true
  }
  if !tn.fn_type && tn.members.size == 0 {
    owners = checker_self.mods_of_type(tn.name)
    if tn.mod_name.size > 0 {
      if !checker_self.qualifier_ok(tn.mod_name, checker_self.current_module) {
        checker_self.fail(tn.loc, "unknown module ${tn.mod_name}")
        return false
      }
      if owners.size > 0 && !checker_self.type_is_visible(tn.name, checker_self.current_module, tn.mod_name) {
        checker_self.fail(tn.loc, "unknown type ${tn.mod_name}.${tn.name}")
        return false
      }
    } else if owners.size > 0 {
      clash = checker_self.clash_message(tn.name, checker_self.current_module)
      if clash.size > 0 {
        checker_self.fail(tn.loc, clash)
        return false
      }
      if !checker_self.type_is_visible(tn.name, checker_self.current_module, "") {
        checker_self.fail(tn.loc, checker_self.unknown_type_text(tn.name))
        return false
      }
      if flag = checker_self.type_multi.get(tn.name) {
        tn.mod_name = checker_self.visible_type_mod(tn.name, checker_self.current_module, "")
      }
    }
  }
  checker_self.type_parts_seen(tn)
}

pub fn (checker_self: Checker) resolve_in_module(tn: TypeName): Ty {
  saved = checker_self.resolver.scope_mod
  checker_self.resolver.scope_mod = checker_self.current_module
  ty = checker_self.resolve_in_module_core(tn)
  checker_self.resolver.scope_mod = saved
  ty
}

pub fn (checker_self: Checker) resolve_in_module_core(tn: TypeName): Ty {
  if tn.pinned {
    return checker_self.resolver.resolve(tn)
  }
  if !checker_self.type_parts_seen(tn) {
    return checker_self.t_int()
  }
  if tn.mod_name.size > 0 {
    if !checker_self.qualifier_ok(tn.mod_name, checker_self.current_module) {
      checker_self.fail(tn.loc, "unknown module ${tn.mod_name}")
      return checker_self.t_int()
    }
    owners = checker_self.mods_of_type(tn.name)
    if owners.size > 0 && !checker_self.type_is_visible(tn.name, checker_self.current_module, tn.mod_name) {
      checker_self.fail(tn.loc, "unknown type ${tn.mod_name}.${tn.name}")
      return checker_self.t_int()
    }
  } else {
    owners = checker_self.mods_of_type(tn.name)
    if owners.size > 0 {
      clash = checker_self.clash_message(tn.name, checker_self.current_module)
      if clash.size > 0 {
        checker_self.fail(tn.loc, clash)
        return checker_self.t_int()
      }
      if !checker_self.type_is_visible(tn.name, checker_self.current_module, "") {
        checker_self.fail(tn.loc, checker_self.unknown_type_text(tn.name))
        return checker_self.t_int()
      }
      if flag = checker_self.type_multi.get(tn.name) {
        owner = checker_self.visible_type_mod(tn.name, checker_self.current_module, "")
        use = TypeName.new(tn.loc, tn.name)
        use.mod_name = owner
        use.nilable = tn.nilable
        use.fn_type = tn.fn_type
        use.args = tn.args
        use.members = tn.members
        use.bounds = tn.bounds
        use.ret = tn.ret
        return checker_self.resolver.resolve(use)
      }
    }
  }
  checker_self.resolver.resolve(tn)
}

// A value's type, seen from the current module: resolve_in_module's
// rules, then the resolver's for a value. (Before, this looked the name
// up bare: a parameter of a type whose name two modules declare was
// `unknown type`, though the same name as a result type resolved.)
pub fn (checker_self: Checker) resolve_value_in_module(tn: TypeName): Ty {
  mark = checker_self.err_count()
  ty = checker_self.resolve_in_module(tn)
  if checker_self.new_err_since(mark) {
    return ty
  }
  checker_self.resolver.value_only(ty, tn)
}

pub fn (checker_self: Checker) ensure_pub_sig_ty(ty: Ty, loc: Location, fnn: Function) {
  if !fnn.vis {
    return
  }
  if ty.rec {
    // A recursive alias is its members, each checked once.
    if ty_walk_enter(ty, wk_pub()) {
      for m in ty.members {
        checker_self.ensure_pub_sig_ty(m, loc, fnn)
      }
      ty_walk_leave(ty, wk_pub())
    }
    return
  }
  if ty.is_agg() {
    owner = fnn.mod_name
    if ty.mod_name.size > 0 {
      owner = ty.mod_name
    } else {
      if o = checker_self.type_mod.get(ty.name) {
        owner = o
      }
    }
    // An instance of a generic type is as visible as its template and
    // its arguments (before, an instance of an imported generic was
    // looked up by its own name, never found, and
    // `pub fn mk: Box(Int)` was refused as a private type).
    named = ty.name
    if ty.origin.size > 0 {
      named = ty.origin
      for arg in ty.ty_args {
        checker_self.ensure_pub_sig_ty(arg, loc, fnn)
      }
    }
    if owner != fnn.mod_name {
      vis = 0
      if flag = checker_self.type_vis.get(type_slot(owner, named)) {
        vis = flag
      } else {
        if flag2 = checker_self.type_vis.get(named) {
          vis = flag2
        }
      }
      if vis != 1 {
        checker_self.fail(loc, "pub signature cannot use private type ${ty.show()}")
      }
    }
    return
  }
  if ty.is_array() {
    if elem = ty.inner {
      checker_self.ensure_pub_sig_ty(elem, loc, fnn)
    }
    return
  }
  if ty.is_hash() {
    if hk = ty.key {
      checker_self.ensure_pub_sig_ty(hk, loc, fnn)
    }
    if hv = ty.val {
      checker_self.ensure_pub_sig_ty(hv, loc, fnn)
    }
    return
  }
  if ty.is_ptr() {
    if inner = ty.inner {
      checker_self.ensure_pub_sig_ty(inner, loc, fnn)
    }
    return
  }
  if ty.is_clayout() {
    owner = fnn.mod_name
    if ty.mod_name.size > 0 {
      owner = ty.mod_name
    } else {
      if o = checker_self.type_mod.get(ty.name) {
        owner = o
      }
    }
    if owner != fnn.mod_name {
      vis = 0
      if flag = checker_self.type_vis.get(type_slot(owner, ty.name)) {
        vis = flag
      } else {
        if flag2 = checker_self.type_vis.get(ty.name) {
          vis = flag2
        }
      }
      if vis != 1 {
        checker_self.fail(loc, "pub signature cannot use private type ${ty.name}")
      }
    }
    return
  }
  if ty.is_join() {
    if jin = ty.inner {
      checker_self.ensure_pub_sig_ty(jin, loc, fnn)
    }
    return
  }
  if ty.is_union() {
    for mem in ty.members {
      checker_self.ensure_pub_sig_ty(mem, loc, fnn)
    }
    return
  }
  if ty.is_fn() {
    for mem in ty.members {
      checker_self.ensure_pub_sig_ty(mem, loc, fnn)
    }
    if r = ty.inner {
      checker_self.ensure_pub_sig_ty(r, loc, fnn)
    }
  }
}

pub fn (checker_self: Checker) lookup_module_type(mod: String, name: String, loc: Location): Ty? {
  if ty = checker_self.resolver.get_named_in(mod, name), checker_self.type_is_visible(name, checker_self.current_module, mod) {
    return ty
  }
  checker_self.fail(loc, "unknown type ${mod}.${name}")
  nil
}

pub fn (checker_self: Checker) type_from_recv(recv: Expr, loc: Location): Ty? {
  if recv.kind == ex_name() {
    return checker_self.lookup_named_type(recv.ident, recv.loc, "")
  }
  if recv.kind == ex_field() {
    if obj = recv.object {
      object = checker_self.check_expr(obj)
      if !object.is_module() {
        checker_self.fail(loc, "new is a type constructor")
        return nil
      }
      return checker_self.lookup_module_type(object.name, recv.ident, recv.loc)
    }
  }
  checker_self.fail(loc, "new is a type constructor")
  nil
}

pub fn (checker_self: Checker) dispatch_qualified_call(expr: Expr, mod: String): Ty {
  if expr.callee == "new" {
    checker_self.fail(expr.loc, "new is a type constructor")
    return checker_self.t_int()
  }
  // A block or lambda argument: `m.f (x) { ... }` picks m's f as
  // `f { ... }` would, its body checked in the calling module.
  checker_self.absorb_fn_block_q(expr, mod)
  none: Ty? = nil
  if got = checker_self.dispatch_deferred_q(expr, none, mod) {
    expr.receiver = nil
    return got
  }
  saved = checker_self.current_module
  arg_tys: Array(Ty) = []
  i = 0
  while i < expr.args.size {
    arg_tys.push(checker_self.check_call_arg(expr.args[i]))
    i += 1
  }
  checker_self.call_mod = mod
  matched = checker_self.match_func(expr.callee, arg_tys, none, expr.loc, checker_self.int_literal_flags(expr.args))
  checker_self.call_mod = ""
  checker_self.current_module = mod
  if sig = matched {
    checker_self.fill_defaults(expr, sig.node)
    i = 0
    while i < expr.args.size {
      got = checker_self.t_int()
      if i < arg_tys.size {
        got = arg_tys[i]
      } else {
        got = checker_self.check_default_arg(expr, i, sig.params, sig.node)
      }
      got = checker_self.fit_call_arg(expr.args[i], got, sig.params[i])
      if !ty_assignable(got, sig.params[i]) {
        n = i + 1
        checker_self.fail(expr.args[i].loc, "argument ${n} of ${expr.callee} ${checker_self.arg_is_text(got, sig.params[i])}")
      }
      i += 1
    }
    expr.resolved = sig.node.emit_name
    expr.receiver = nil
    checker_self.current_module = saved
    return sig.ret
  }
  checker_self.current_module = saved
  checker_self.t_int()
}

// std.gc's two forms. `gc` names the module in a module that imports
// std.gc, unless a local or a field takes the name.
pub fn (checker_self: Checker) names_std_gc(name: String): Bool {
  if name != "gc" {
    return false
  }
  if found = checker_self.lookup(name) {
    return false
  }
  if f = checker_self.implicit_field(name) {
    return false
  }
  checker_self.imported_by(checker_self.current_module, "std.gc")
}

// `gc.hold { }` (parser.av parse_hold): the module imported, and `gc`
// not a local's or a field's name.
pub fn (checker_self: Checker) check_hold(stmt: Stmt) {
  if !checker_self.imported_by(checker_self.current_module, "std.gc") {
    checker_self.fail(stmt.loc, "gc.hold needs import std.gc")
    return
  }
  if !checker_self.names_std_gc("gc") {
    checker_self.fail(stmt.loc, "gc.hold: gc names a local or a field here, not std.gc")
  }
}

// `gc.collect()`: a young collection now (deferred to the end of an
// enclosing hold). The call becomes the builtin `#gc.collect`, which no
// program can name; `gc.hold` outside a statement and any other member
// are errors.
pub fn (checker_self: Checker) check_gc_call(expr: Expr): Ty {
  if expr.callee == "collect" {
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "gc.collect takes no arguments")
    } else if b = expr.block {
      checker_self.fail(b.loc, "gc.collect takes no block")
    }
    expr.receiver = nil
    expr.callee = "#gc.collect"
    return checker_self.t_void()
  }
  if expr.callee == "hold" {
    checker_self.fail(expr.loc, "gc.hold is a statement: gc.hold { ... }")
    return checker_self.t_void()
  }
  checker_self.fail(expr.loc, "unknown function gc.${expr.callee}; std.gc has gc.hold { } and gc.collect()")
  checker_self.t_void()
}

// A module's last name qualifies its names (`import std.time`, then
// `time.now()`), as the whole name does. q is a last name in from_mod
// when no import (nor from_mod itself) is named q in whole and one import
// ends in `.q`: that import's whole name, else "". Two imports ending in
// `.q` make a use of q an error naming both whole names. std.gc keeps
// its own reading of `gc` (names_std_gc).
pub fn (checker_self: Checker) last_name_module(q: String, from_mod: String, loc: Location): String {
  if q == "gc" {
    return ""
  }
  // A module's own name stands for an import ending in it, when one does:
  // a program in http.av that imports std.http means std.http by
  // `http.listen`, since a module has no need to qualify its own names.
  if q != from_mod {
    if k = checker_self.known_mods.get(q) {
      return ""
    }
  }
  found = ""
  other = ""
  for info in checker_self.program.mods {
    if info.name == from_mod {
      for imp in info.imports {
        if module_last_name(imp) == q && imp != q {
          if found.size == 0 {
            found = imp
          } else if imp != found && other.size == 0 {
            other = imp
          }
        }
      }
    }
  }
  if other.size > 0 {
    checker_self.fail(loc, "${q} is the last name of both ${found} and ${other}: write the whole name (${found}.… or ${other}.…)")
    return ""
  }
  found
}

// The name after a module name's last dot ("" for a name without one).
pub fn module_last_name(m: String): String {
  i = m.size - 1
  while i >= 0 {
    if m[i] == 46 {
      return str_slice(m, i + 1, m.size)
    }
    i -= 1
  }
  ""
}

// Rewrites the root name of a name chain (`time` in `time.now()`,
// `fs.read`, `fs.Reader.x`) to the whole module name its last name
// stands for, unless the name is a local, a field or a module's whole
// name; the readers after this see the whole name, as written.
pub fn (checker_self: Checker) qualify_last_name(expr: Expr) {
  root = expr
  if root.kind == ex_call() {
    if r = root.receiver {
      root = r
    } else {
      return
    }
  }
  while root.kind == ex_field() {
    if o = root.object {
      root = o
    } else {
      return
    }
  }
  if root.kind != ex_name() || root.type_args.size > 0 || root.ident.size == 0 {
    return
  }
  q = root.ident
  if k = checker_self.last_names.get(q) {
  } else {
    return
  }
  if q != checker_self.current_module {
    if k2 = checker_self.known_mods.get(q) {
      return
    }
  }
  if found = checker_self.lookup(q) {
    return
  }
  if f = checker_self.implicit_field(q) {
    return
  }
  full = checker_self.last_name_module(q, checker_self.current_module, root.loc)
  if full.size > 0 {
    root.ident = full
  }
}

// The std.fs or std.process spelling of a function that left the
// prelude, "" for any other name.
pub fn moved_io_name(name: String): String {
  olds = ["file_read", "file_write", "dir_list", "file_exists", "dir_exists", "dir_walk", "process_run", "argv", "env_get"]
  news = ["fs.read(path)", "fs.write(path, body)", "fs.list(path)", "fs.exists(path)", "fs.is_dir(path)", "fs.walk(path)", "process.run(program, args)", "process.args()", "process.env(name)"]
  for i in 0..olds.size {
    if olds[i] == name {
      return news[i]
    }
  }
  ""
}

// The spelling that replaced a prelude twin (a free function beside the
// form that says the same), "" for any other name. The compiler's own
// sources keep the twin until the next seed builds them.
pub fn retired_twin_name(name: String): String {
  if name == "str_slice" {
    return "s[start..stop]"
  }
  if name == "buf_new" {
    return "Buf.new()"
  }
  ""
}

// Whether the current module may still call the prelude's old file and
// process names and its twins: the compiler's own sources (built by the
// seed, which has no std.fs), the two modules that wrap them, and the
// prelude's own parts.
pub fn (checker_self: Checker) moved_io_allowed: Bool {
  m = checker_self.current_module
  if m == "std.fs" || m == "std.process" || m == "prelude" || m.starts_with("prelude_") {
    return true
  }
  for info in checker_self.program.mods {
    if info.name == m {
      p = info.path
      return p.starts_with("compiler/") || p.contains("/compiler/")
    }
  }
  false
}

// A call of a function that left the prelude, outside the modules that
// may still name it: refused with the new spelling; true when refused.
pub fn (checker_self: Checker) refuse_moved_io(expr: Expr): Bool {
  twin = retired_twin_name(expr.callee)
  if twin.size > 0 && !expr.derived && !checker_self.moved_io_allowed() {
    checker_self.fail(expr.loc, "${expr.callee} is gone: write ${twin}")
    return true
  }
  spelled = moved_io_name(expr.callee)
  if spelled.size == 0 || checker_self.moved_io_allowed() {
    return false
  }
  mod = "std.fs"
  if spelled.starts_with("process.") {
    mod = "std.process"
  }
  checker_self.fail(expr.loc, "${expr.callee} is now ${spelled}: import ${mod}")
  true
}
