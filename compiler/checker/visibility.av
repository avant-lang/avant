pub fn (checker_self: Checker) note_modules {
  checker_self.root_module = checker_self.program.root_module
  checker_self.current_module = checker_self.root_module
  km = Hash(String, Int).new
  for info in checker_self.program.mods {
    km[info.name] = 1
    for imp in info.imports {
      km[imp] = 1
    }
  }
  checker_self.known_mods = km
  tm = Hash(String, String).new
  tv = Hash(String, Int).new
  checker_self.type_mod = tm
  checker_self.type_vis = tv
  tlist = Hash(String, String).new
  checker_self.type_list = tlist
  tmulti = Hash(String, Int).new
  checker_self.type_multi = tmulti
  for sdef in checker_self.program.structs {
    checker_self.remember_type(sdef.name, sdef.mod_name, sdef.vis)
  }
  for cdef in checker_self.program.classes {
    checker_self.remember_type(cdef.name, cdef.mod_name, cdef.vis)
  }
  for idef in checker_self.program.interfaces {
    checker_self.remember_type(idef.name, idef.mod_name, idef.vis)
  }
  for lib_def in checker_self.program.libs {
    for lay in lib_def.layouts {
      checker_self.remember_type(lay.name, lib_def.mod_name, lib_def.vis)
    }
  }
}

// Fields are private unless `pub` (Stage 29 W3a, D299; D42 rule 5
// replaced): a field without `pub` is read, written and named in a literal
// only inside its type's module.
pub fn (checker_self: Checker) field_hidden(owner: Ty, name: String): Bool {
  from = checker_self.current_module
  if owner.mod_name.size == 0 || from.size == 0 || owner.mod_name == from {
    return false
  }
  for f in owner.fields {
    if f.name == name {
      if f.vis {
        return false
      }
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) field_private_text(owner: Ty, name: String): String {
  "field ${name} of ${owner.show} is private to module ${owner.mod_name}; mark it pub"
}

pub fn (checker_self: Checker) check_field_visible(owner: Ty, name: String, loc: Location): Bool {
  if checker_self.field_hidden(owner, name) {
    checker_self.fail(loc, checker_self.field_private_text(owner, name))
    return false
  }
  true
}

pub fn type_slot(mod_name: String, name: String): String {
  "${mod_name}@@${name}"
}

pub fn (checker_self: Checker) remember_type(name: String, mod_name: String, vis: Bool) {
  slot = type_slot(mod_name, name)
  if prev = checker_self.type_mod.get(slot) {
    return
  }
  checker_self.type_mod[slot] = mod_name
  if vis {
    checker_self.type_vis[slot] = 1
  } else {
    checker_self.type_vis[slot] = 0
  }
  if listed = checker_self.type_list.get(name) {
    checker_self.type_list[name] = "${listed}\n${mod_name}"
    checker_self.type_multi[name] = 1
  } else {
    checker_self.type_list[name] = mod_name
    checker_self.type_mod[name] = mod_name
    if vis {
      checker_self.type_vis[name] = 1
    } else {
      checker_self.type_vis[name] = 0
    }
  }
}

pub fn (checker_self: Checker) mods_of_type(name: String): Array(String) {
  out: Array(String) = []
  if s = checker_self.type_list.get(name) {
    start = 0
    i = 0
    while i <= s.size {
      brk = false
      if i == s.size {
        brk = true
      } else {
        if s[i] == 10 {
          brk = true
        }
      }
      if brk {
        if i > start {
          out.push(str_slice(s, start, i))
        }
        start = i + 1
      }
      i += 1
    }
  }
  out
}

pub fn (checker_self: Checker) type_slot_visible(name: String, mod_name: String, from_mod: String): Bool {
  if mod_name == from_mod {
    return true
  }
  if v = checker_self.type_vis.get(type_slot(mod_name, name)), v == 1 {
    return checker_self.imported_by(from_mod, mod_name)
  }
  false
}

pub fn (checker_self: Checker) imported_by(from_mod: String, target: String): Bool {
  if from_mod == target {
    return true
  }
  for info in checker_self.program.mods {
    if info.name == from_mod {
      for imp in info.imports {
        if imp == target {
          return true
        }
      }
    }
  }
  false
}

pub fn (checker_self: Checker) qualifier_ok(qual: String, from_mod: String): Bool {
  if qual == from_mod {
    return true
  }
  checker_self.imported_by(from_mod, qual)
}

pub fn (checker_self: Checker) visible_type_mod(name: String, from_mod: String, qual: String): String {
  if qual.size > 0 {
    if o = checker_self.type_mod.get(type_slot(qual, name)), checker_self.qualifier_ok(qual, from_mod) && checker_self.type_slot_visible(name, qual, from_mod) {
      return qual
    }
    return ""
  }
  owners = checker_self.mods_of_type(name)
  found = ""
  n = 0
  for owner in owners {
    if checker_self.type_slot_visible(name, owner, from_mod) {
      n += 1
      found = owner
    }
  }
  if n == 1 {
    return found
  }
  ""
}

pub fn (checker_self: Checker) type_is_visible(name: String, from_mod: String, qual: String): Bool {
  if checker_self.mods_of_type(name).size == 0 {
    return true
  }
  checker_self.visible_type_mod(name, from_mod, qual).size > 0
}

pub fn (checker_self: Checker) lib_is_visible(name: String, from_mod: String): Bool {
  owner = from_mod
  if o = checker_self.lib_mod.get(name) {
    owner = o
  }
  if owner == from_mod {
    return true
  }
  if v = checker_self.lib_vis.get(name), v == 1 {
    return checker_self.imported_by(from_mod, owner)
  }
  false
}

pub fn (checker_self: Checker) fn_is_visible(fnn: Function, from_mod: String): Bool {
  if fnn.mod_name == from_mod {
    return true
  }
  if fnn.mod_name.size == 0 {
    return true
  }
  if from_mod.size == 0 {
    return true
  }
  if fnn.vis {
    return checker_self.imported_by(from_mod, fnn.mod_name)
  }
  false
}

// Functions are scoped per module (Stage 29 W3a, D298). A candidate at an
// unqualified call is a function the current module sees (its own, and the
// pub functions of the modules it imports); at a qualified call `m.f()`
// (qual, or call_mod while match_func runs), only m's functions among them.
pub fn (checker_self: Checker) fn_candidate_q(fnn: Function, qual: String): Bool {
  if qual.size > 0 && fnn.mod_name != qual {
    return false
  }
  checker_self.fn_is_visible(fnn, checker_self.current_module)
}

pub fn (checker_self: Checker) fn_candidate(fnn: Function): Bool {
  checker_self.fn_candidate_q(fnn, checker_self.call_mod)
}

// Two or more functions match a call equally. When they come from
// different modules, the message names each one's module and the
// qualified calls that pick one (D298); as for types, a module's own
// function does not win over an imported one of the same signature.
pub fn (checker_self: Checker) fail_ambiguous_call(loc: Location, name: String, cands: Array(FuncSig), plain: String) {
  mods: Array(String) = []
  for sig in cands {
    seen = false
    for m in mods {
      if m == sig.node.mod_name {
        seen = true
      }
    }
    if !seen {
      mods.push(sig.node.mod_name)
    }
  }
  if mods.size < 2 {
    checker_self.fail(loc, plain)
    return
  }
  defs = buf_new()
  calls = buf_new()
  for k in 0..mods.size {
    if k > 0 {
      sep = ", "
      if k == mods.size - 1 {
        sep = " and "
      }
      defs.push_str(sep)
      if k == mods.size - 1 {
        sep = " or "
      }
      calls.push_str(sep)
    }
    defs.push_str("${mods[k]}.${name}")
    calls.push_str("${mods[k]}.${name}()")
  }
  both = "both"
  if mods.size > 2 {
    both = "all"
  }
  checker_self.fail(loc, "${plain}: ${defs.to_s} ${both} match; write ${calls.to_s}")
}

pub fn (checker_self: Checker) method_is_visible(fnn: Function, from_mod: String): Bool {
  if fnn.owner == "Bytes" || fnn.owner == "String" || fnn.owner == "Buf" {
    if fnn.mod_name == from_mod {
      return true
    }
    return checker_self.imported_by(from_mod, fnn.mod_name)
  }
  if fnn.vis {
    return true
  }
  if fnn.name == "initialize" {
    return true
  }
  if fnn.mod_name == from_mod {
    return true
  }
  if fnn.mod_name.size == 0 {
    return true
  }
  if from_mod.size == 0 {
    return true
  }
  false
}

pub fn (checker_self: Checker) clash_unqualified(name: String, from_mod: String): Bool {
  origins: Array(String) = []
  type_mods = checker_self.mods_of_type(name)
  ti = 0
  while ti < type_mods.size {
    if checker_self.type_slot_visible(name, type_mods[ti], from_mod) {
      origins.push("type:${type_mods[ti]}")
    }
    ti += 1
  }
  if id = checker_self.lib_names.get(name), checker_self.lib_is_visible(name, from_mod) {
    owner = from_mod
    if o = checker_self.lib_mod.get(name) {
      owner = o
    }
    origins.push("lib:${owner}")
  }
  fn_mods = Hash(String, Int).new
  for i in 1..checker_self.functions.size {
    sig = checker_self.functions[i]
    if sig.name == name && checker_self.fn_is_visible(sig.node, from_mod) {
      if seen = fn_mods.get(sig.node.mod_name) {
      } else {
        fn_mods[sig.node.mod_name] = 1
        origins.push("fn:${sig.node.mod_name}")
      }
    }
  }
  owner_count = 0
  has_type = false
  has_fn = false
  for o in origins {
    if o.size >= 5 {
      if str_slice(o, 0, 5) == "type:" {
        owner_count += 1
        has_type = true
      } else if str_slice(o, 0, 4) == "lib:" {
        owner_count += 1
        has_type = true
      } else if str_slice(o, 0, 3) == "fn:" {
        has_fn = true
      }
    }
  }
  if owner_count > 1 {
    return true
  }
  if owner_count >= 1 && has_fn {
    return true
  }
  false
}

pub fn (checker_self: Checker) lookup_named_type(name: String, loc: Location, qual: String): Ty? {
  if checker_self.clash_unqualified(name, checker_self.current_module) && qual.size == 0 {
    checker_self.fail(loc, "ambiguous name ${name}; qualify it")
    return nil
  }
  owner = checker_self.visible_type_mod(name, checker_self.current_module, qual)
  if owner.size > 0 {
    if ty = checker_self.resolver.get_named_in(owner, name) {
      return ty
    }
  }
  if ty = checker_self.resolver.get_named(name), checker_self.type_is_visible(name, checker_self.current_module, qual) {
    return ty
  }
  if qual.size > 0 {
    checker_self.fail(loc, "unknown type ${qual}.${name}")
  } else {
    checker_self.fail(loc, "unknown type ${name}")
  }
  nil
}

pub fn (checker_self: Checker) resolve_in_module(tn: TypeName): Ty {
  if tn.mod_name.size > 0 {
    if !checker_self.qualifier_ok(tn.mod_name, checker_self.current_module) {
      checker_self.fail(tn.loc, "unknown module ${tn.mod_name}")
      return checker_self.t_int()
    }
    owners = checker_self.mods_of_type(tn.name)
    if owners.size > 0 && !checker_self.type_is_visible(tn.name, checker_self.current_module, tn.mod_name) {
      checker_self.fail(tn.loc, "unknown type ${tn.mod_name}.${tn.name}")
      return checker_self.t_int()
    }
  } else {
    owners = checker_self.mods_of_type(tn.name)
    if owners.size > 0 {
      if checker_self.clash_unqualified(tn.name, checker_self.current_module) {
        checker_self.fail(tn.loc, "ambiguous name ${tn.name}; qualify it")
        return checker_self.t_int()
      }
      if !checker_self.type_is_visible(tn.name, checker_self.current_module, "") {
        checker_self.fail(tn.loc, "unknown type ${tn.name}")
        return checker_self.t_int()
      }
      if flag = checker_self.type_multi.get(tn.name) {
        owner = checker_self.visible_type_mod(tn.name, checker_self.current_module, "")
        use = TypeName.new(tn.loc, tn.name)
        use.mod_name = owner
        use.nilable = tn.nilable
        use.fn_type = tn.fn_type
        use.args = tn.args
        use.members = tn.members
        use.bounds = tn.bounds
        use.ret = tn.ret
        return checker_self.resolver.resolve(use)
      }
    }
  }
  checker_self.resolver.resolve(tn)
}

pub fn (checker_self: Checker) resolve_value_in_module(tn: TypeName): Ty {
  if tn.mod_name.size > 0 {
    if !checker_self.qualifier_ok(tn.mod_name, checker_self.current_module) {
      checker_self.fail(tn.loc, "unknown module ${tn.mod_name}")
      return checker_self.t_int()
    }
  } else {
    if named = checker_self.resolver.get_named(tn.name) {
      if !checker_self.type_is_visible(tn.name, checker_self.current_module, "") {
        checker_self.fail(tn.loc, "unknown type ${tn.name}")
        return checker_self.t_int()
      }
      if checker_self.clash_unqualified(tn.name, checker_self.current_module) {
        checker_self.fail(tn.loc, "ambiguous name ${tn.name}; qualify it")
        return checker_self.t_int()
      }
    }
  }
  checker_self.resolver.resolve_value(tn)
}

pub fn (checker_self: Checker) ensure_pub_sig_ty(ty: Ty, loc: Location, fnn: Function) {
  if !fnn.vis {
    return
  }
  if ty.is_agg {
    owner = fnn.mod_name
    if ty.mod_name.size > 0 {
      owner = ty.mod_name
    } else {
      if o = checker_self.type_mod.get(ty.name) {
        owner = o
      }
    }
    if owner != fnn.mod_name {
      vis = 0
      if flag = checker_self.type_vis.get(type_slot(owner, ty.name)) {
        vis = flag
      } else {
        if flag2 = checker_self.type_vis.get(ty.name) {
          vis = flag2
        }
      }
      if vis != 1 {
        checker_self.fail(loc, "pub signature cannot use private type ${ty.name}")
      }
    }
    return
  }
  if ty.is_array {
    if elem = ty.inner {
      checker_self.ensure_pub_sig_ty(elem, loc, fnn)
    }
    return
  }
  if ty.is_hash {
    if hk = ty.key {
      checker_self.ensure_pub_sig_ty(hk, loc, fnn)
    }
    if hv = ty.val {
      checker_self.ensure_pub_sig_ty(hv, loc, fnn)
    }
    return
  }
  if ty.is_ptr {
    if inner = ty.inner {
      checker_self.ensure_pub_sig_ty(inner, loc, fnn)
    }
    return
  }
  if ty.is_clayout {
    owner = fnn.mod_name
    if ty.mod_name.size > 0 {
      owner = ty.mod_name
    } else {
      if o = checker_self.type_mod.get(ty.name) {
        owner = o
      }
    }
    if owner != fnn.mod_name {
      vis = 0
      if flag = checker_self.type_vis.get(type_slot(owner, ty.name)) {
        vis = flag
      } else {
        if flag2 = checker_self.type_vis.get(ty.name) {
          vis = flag2
        }
      }
      if vis != 1 {
        checker_self.fail(loc, "pub signature cannot use private type ${ty.name}")
      }
    }
    return
  }
  if ty.is_join {
    if jin = ty.inner {
      checker_self.ensure_pub_sig_ty(jin, loc, fnn)
    }
    return
  }
  if ty.is_union {
    for mem in ty.members {
      checker_self.ensure_pub_sig_ty(mem, loc, fnn)
    }
    return
  }
  if ty.is_fn {
    for mem in ty.members {
      checker_self.ensure_pub_sig_ty(mem, loc, fnn)
    }
    if r = ty.inner {
      checker_self.ensure_pub_sig_ty(r, loc, fnn)
    }
  }
}

pub fn (checker_self: Checker) lookup_module_type(mod: String, name: String, loc: Location): Ty? {
  if ty = checker_self.resolver.get_named_in(mod, name), checker_self.type_is_visible(name, checker_self.current_module, mod) {
    return ty
  }
  checker_self.fail(loc, "unknown type ${mod}.${name}")
  nil
}

pub fn (checker_self: Checker) type_from_recv(recv: Expr, loc: Location): Ty? {
  if recv.kind == ex_name() {
    return checker_self.lookup_named_type(recv.ident, recv.loc, "")
  }
  if recv.kind == ex_field() {
    if obj = recv.object {
      object = checker_self.check_expr(obj)
      if !object.is_module {
        checker_self.fail(loc, "new is a type constructor")
        return nil
      }
      return checker_self.lookup_module_type(object.name, recv.ident, recv.loc)
    }
  }
  checker_self.fail(loc, "new is a type constructor")
  nil
}

pub fn (checker_self: Checker) dispatch_qualified_call(expr: Expr, mod: String): Ty {
  if expr.callee == "new" {
    checker_self.fail(expr.loc, "new is a type constructor")
    return checker_self.t_int()
  }
  // A block or lambda argument (Stage 29 W3a): `m.f { |x| ... }` picks m's
  // f as `f { ... }` would, its body checked in the calling module.
  checker_self.absorb_fn_block_q(expr, mod)
  none: Ty? = nil
  if got = checker_self.dispatch_deferred_q(expr, none, mod) {
    expr.receiver = nil
    return got
  }
  saved = checker_self.current_module
  arg_tys: Array(Ty) = []
  i = 0
  while i < expr.args.size {
    arg_tys.push(checker_self.check_expr(expr.args[i]))
    i += 1
  }
  checker_self.call_mod = mod
  matched = checker_self.match_func(expr.callee, arg_tys, none, expr.loc)
  checker_self.call_mod = ""
  checker_self.current_module = mod
  if sig = matched {
    checker_self.fill_defaults(expr, sig.node)
    i = 0
    while i < expr.args.size {
      got = checker_self.t_int()
      if i < arg_tys.size {
        got = arg_tys[i]
      } else {
        got = checker_self.check_default_arg(expr, i, sig.params[i], sig.node)
      }
      got = checker_self.fit_call_arg(expr.args[i], got, sig.params[i])
      if !ty_assignable(got, sig.params[i]) {
        n = i + 1
        checker_self.fail(expr.args[i].loc, "argument ${n} of ${expr.callee} is ${got.show}, expected ${sig.params[i].show}")
      }
      i += 1
    }
    expr.resolved = sig.node.emit_name
    expr.receiver = nil
    checker_self.current_module = saved
    return sig.ret
  }
  checker_self.current_module = saved
  checker_self.t_int()
}

// std.gc's two forms (Stage 29 W1c2, D305). `gc` names the module in a
// module that imports std.gc, unless a local or a field takes the name.
pub fn (checker_self: Checker) names_std_gc(name: String): Bool {
  if name != "gc" {
    return false
  }
  if found = checker_self.lookup(name) {
    return false
  }
  if f = checker_self.implicit_field(name) {
    return false
  }
  checker_self.imported_by(checker_self.current_module, "std.gc")
}

// `gc.hold { }` (parser.av parse_hold): the module imported, and `gc`
// not a local's or a field's name.
pub fn (checker_self: Checker) check_hold(stmt: Stmt) {
  if !checker_self.imported_by(checker_self.current_module, "std.gc") {
    checker_self.fail(stmt.loc, "gc.hold needs import std.gc")
    return
  }
  if !checker_self.names_std_gc("gc") {
    checker_self.fail(stmt.loc, "gc.hold: gc names a local or a field here, not std.gc")
  }
}

// `gc.collect()`: a young collection now (deferred to the end of an
// enclosing hold). The call becomes the builtin `#gc.collect`, which no
// program can name; `gc.hold` outside a statement and any other member
// are errors.
pub fn (checker_self: Checker) check_gc_call(expr: Expr): Ty {
  if expr.callee == "collect" {
    if expr.args.size != 0 {
      checker_self.fail(expr.loc, "gc.collect takes no arguments")
    } else if b = expr.block {
      checker_self.fail(b.loc, "gc.collect takes no block")
    }
    expr.receiver = nil
    expr.callee = "#gc.collect"
    return checker_self.t_void()
  }
  if expr.callee == "hold" {
    checker_self.fail(expr.loc, "gc.hold is a statement: gc.hold { ... }")
    return checker_self.t_void()
  }
  checker_self.fail(expr.loc, "unknown function gc.${expr.callee}; std.gc has gc.hold { } and gc.collect()")
  checker_self.t_void()
}
