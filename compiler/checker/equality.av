// Equality and ordering beyond the scalars. The rule:
//
//   - a class compares by identity unless it defines fn equals (its
//     ==, spell_protocols);
//   - a struct compares its fields in order, each by its own ==, unless
//     it defines fn equals: the checker writes that method the first time a
//     program compares the struct or opts it into an interface that asks
//     for == (derive_eq_method), so it is an ordinary method, a witness of
//     `interface Eq(T)` included;
//   - an array is equal to another of its type when the sizes are equal
//     and the elements are, in order; an optional, when both are nil or
//     both hold equal values; a Hash, when the sizes are equal and each
//     key of one is a key of the other with an equal value (in any
//     order); a Set, when the sizes are equal and each element of one is
//     in the other: generic functions the checker writes once
//     (eq_template) and instantiates for each element type;
//   - a Float64 compares by IEEE (NaN equals nothing, itself included),
//     so an array or struct holding NaN is not equal to itself;
//   - != is always !(a == b); a type's order is its fn compare, from
//     which the checker writes < (derive_orders); >, <= and >= are
//     b < a, !(b < a) and !(a < b);
//   - two values of different types do not compare (a compile error),
//     an optional is never compared with nil, and a function or a union
//     of several types has no ==.
//
// Nothing here runs for a program that compares no such values: the
// methods and functions exist only once a comparison asks for them.

import location
import source
import token
import lexer
import type
import ast
import parser
import typed_ir
import checker.names
import checker
import checker.match

// Why the struct key (or a field of one, named by path) cannot be a
// Hash key, or "". A struct key's hash is derived from its fields the
// way its derived == compares them (runtime/avant_hash.c): every field
// must be a key itself (an integer, a Bool, an enum, a String or such a
// struct). A struct that defines its own == is a key when it defines its
// own hash too (fn hash(h: Hasher)), which feeds the hasher the values
// that == compares: the table hashes and compares it by those two
// methods (key_fns), and its fields may be anything. One with == and no
// hash is refused: a hash derived from all its fields could disagree
// with that == (two equal keys hashed apart are an entry that cannot be
// found). seen holds the structs being looked into.
pub fn (checker_self: Checker) hash_key_problem(ty: Ty, seen: Array(String), path: String): String {
  return checker_self.key_problem(ty, seen, path, "a Hash key")
}

// The same for a Set's element (what is "a Set element") or a Hash's key.
pub fn (checker_self: Checker) key_problem(ty: Ty, seen: Array(String), path: String, what: String): String {
  if ty.is_integer() || ty.is_bool() || ty.is_enum() || ty.is_string() || ty.is_var() {
    return ""
  }
  if ty.is_float() {
    return "${what} cannot hold a Float64 (${path}): its == follows IEEE 754 (NaN is not equal to itself, -0.0 equals 0.0), so no hash agrees with it; key by an integer (a fixed-point value, or an index)"
  }
  if !ty.is_struct() {
    return "${what}'s fields are integers, Bools, enums, Strings or structs of those, not ${ty.show()} (${path}): key by a struct of the other fields, or keep this one out of the key (a value beside it)"
  }
  if checker_self.own_op(ty, "==") {
    if sig = checker_self.own_hash(ty) {
      return ""
    }
    return "${ty.show()} defines its own ==, so it cannot be ${what} without its own hash: equal values must hash alike; add fn hash(h: Hasher) feeding it the fields equals compares"
  }
  if seen.has(ty_seen_key(ty)) {
    return ""
  }
  seen.push(ty_seen_key(ty))
  for f in ty.fields {
    m = checker_self.key_problem(f.ty, seen, "the field ${ty.show()}.${f.name}", what)
    if m.size > 0 {
      return m
    }
  }
  ""
}

// The resolver's Hash types with a struct key made so far: each key is
// tested by hash_key_problem, an error at the Hash type when it fails.
pub fn (checker_self: Checker) check_hash_key_uses {
  saved = checker_self.current_module
  while checker_self.hash_key_done < checker_self.resolver.hash_key_uses.size {
    use = checker_self.resolver.hash_key_uses[checker_self.hash_key_done]
    checker_self.hash_key_done += 1
    if use.mod_name.size > 0 {
      checker_self.current_module = use.mod_name
    }
    seen: Array(String) = []
    why = checker_self.key_problem(use.key, seen, "", use.what)
    if why.size > 0 {
      checker_self.fail(use.loc, why)
    }
    checker_self.current_module = saved
  }
}

// Whether ty (a struct or class) has a method of this name that the
// program wrote (not one the checker derived: derive_eq_method's ==,
// derive_hash_method's hash).
pub fn (checker_self: Checker) own_op(ty: Ty, name: String): Bool {
  for ms in checker_self.methods {
    if ms.is_method_of(ty) && ms.name == name && !ms.node.lazy {
      return true
    }
  }
  false
}

// The struct's hash method, written by the program: `fn hash(h: Hasher)`.
pub fn (checker_self: Checker) own_hash(ty: Ty): FuncSig? {
  for ms in checker_self.methods {
    if ms.is_method_of(ty) && ms.name == "hash" && !ms.node.lazy && ms.params.size == 1 && ms.params[0].is_hasher() && ms.ret.is_void() {
      return ms
    }
  }
  nil
}

// The struct's hash method, its own or the one derive_hash_method wrote.
pub fn (checker_self: Checker) hash_method(ty: Ty): FuncSig? {
  for ms in checker_self.methods {
    if ms.is_method_of(ty) && ms.name == "hash" && ms.params.size == 1 && ms.params[0].is_hasher() && ms.ret.is_void() {
      return ms
    }
  }
  nil
}

// Whether a Hash keyed by ty (a struct the key rule accepts) hashes and
// compares it by its type's methods (the runtime's _uk entries): ty, or a
// struct among its fields at any depth, defines its own ==.
pub fn (checker_self: Checker) key_by_methods(ty: Ty, seen: Array(String)): Bool {
  if !ty.is_struct() || seen.has(ty_seen_key(ty)) {
    return false
  }
  if checker_self.own_op(ty, "==") {
    return true
  }
  seen.push(ty_seen_key(ty))
  for f in ty.fields {
    if checker_self.key_by_methods(f.ty, seen) {
      return true
    }
  }
  false
}

// The two functions a Hash keyed by such a struct calls (written once
// per key type, from key_template_source): the key fed to the hasher,
// and two keys compared. Made where the program makes such a Hash or
// Set; the lowering finds them by their emit names
// (compiler/mir/lower_hash.av).
pub fn (checker_self: Checker) key_fns(key: Ty, loc: Location) {
  seen: Array(String) = []
  if !checker_self.key_by_methods(key, seen) {
    return
  }
  seen2: Array(String) = []
  if checker_self.key_problem(key, seen2, "", "a Hash key").size > 0 {
    return
  }
  for name in ["__avant_key_hash", "__avant_key_eq"] {
    if sig = checker_self.eq_template(name) {
      subst: Array(Ty) = []
      subst.push(key)
      _ = checker_self.instantiate_function(sig, subst, loc)
    }
  }
}

// Why a value of type ty cannot be added to a Hasher, or "": an integer,
// a Bool, an enum, a String, or a struct whose hash is its own or
// derived from fields that are all such values. A struct with its own ==
// and no hash is refused (equal values must hash alike). seen holds the
// structs being looked into.
pub fn (checker_self: Checker) hash_add_problem(ty: Ty, seen: Array(String)): String {
  if ty.is_integer() || ty.is_bool() || ty.is_enum() || ty.is_string() || ty.is_var() {
    return ""
  }
  if ty.is_float() {
    return "a Hasher takes no Float64: its == follows IEEE 754 (NaN is not equal to itself, -0.0 equals 0.0), so no hash agrees with it; add an integer made from it (a fixed-point value)"
  }
  if !ty.is_struct() {
    return "a Hasher takes integers, Bools, enums, Strings and structs, not ${ty.show()}: add the values it holds (each element, or its size and its elements)"
  }
  if sig = checker_self.hash_method(ty) {
    return ""
  }
  if checker_self.own_op(ty, "==") {
    return "${ty.show()} defines equals but no hash: equal values must hash alike; add fn hash(h: Hasher) feeding it the fields equals compares"
  }
  if seen.has(ty_seen_key(ty)) {
    return ""
  }
  seen.push(ty_seen_key(ty))
  for f in ty.fields {
    m = checker_self.hash_add_problem(f.ty, seen)
    if m.size > 0 {
      if f.ty.is_struct() {
        return m
      }
      return "${m} (the field ${ty.show()}.${f.name}: give ${ty.show()} its own fn hash(h: Hasher), or leave the field out of it)"
    }
  }
  ""
}

// `h.add(v)` on a Hasher (h the receiver, checked): an integer, a Bool,
// an enum or a String the runtime mixes in; a struct is the call of its
// hash method with h (its own, or the one derive_hash_method writes:
// each field added in order), so the expression becomes `v.hash(h)`.
pub fn (checker_self: Checker) check_hasher_method(expr: Expr): Ty {
  if expr.callee != "add" || expr.args.size != 1 {
    for a in expr.args {
      checker_self.check_expr(a)
    }
    checker_self.fail(expr.loc, "a Hasher has one method, add(v): it takes each value the type's equality compares")
    return checker_self.t_void()
  }
  if bl = expr.block {
    checker_self.fail(expr.loc, "Hasher.add does not take a block")
    return checker_self.t_void()
  }
  v = checker_self.check_expr(expr.args[0])
  if checker_self.has_err() {
    return checker_self.t_void()
  }
  seen: Array(String) = []
  why = checker_self.hash_add_problem(v, seen)
  if why.size > 0 {
    checker_self.fail(expr.args[0].loc, why)
    return checker_self.t_void()
  }
  if v.is_struct() {
    checker_self.derive_hash_method(v, expr.loc)
    if sig = checker_self.hash_method(v), h = expr.receiver {
      args: Array(Expr) = []
      args.push(h)
      expr.receiver = expr.args[0]
      expr.args = args
      expr.callee = "hash"
      expr.resolved = sig.node.emit_name
    }
  }
  checker_self.t_void()
}

// The derived hash of the struct sty: `fn hash(h: Hasher)`, each field
// added in order (`h.add(self.f)`), as derive_eq_method writes ==;
// lazy, public, in the struct's module. The caller has checked
// hash_add_problem.
pub fn (checker_self: Checker) derive_hash_method(sty: Ty, loc: Location) {
  if sig = checker_self.hash_method(sty) {
    return
  }
  sloc = loc
  for sdef in checker_self.program.structs {
    if sdef.name == sty.name && sdef.mod_name == sty.mod_name {
      sloc = sdef.loc
    }
  }
  fnn = Function.new(sloc, "hash")
  fnn.owner = sty.name
  fnn.owner_mod = sty.mod_name
  fnn.mod_name = sty.mod_name
  fnn.vis = true
  fnn.lazy = true
  fnn.params.push(Param.new(sloc, "__avant_h", TypeName.new(sloc, "Hasher")))
  for f in sty.fields {
    call = Expr.new(ex_call(), sloc)
    call.callee = "add"
    hn = Expr.new(ex_name(), sloc)
    hn.ident = "__avant_h"
    call.receiver = hn
    call.args.push(eq_field_of(sloc, "self", f.name))
    fnn.body.push(stmt_expr(sloc, call))
  }
  checker_self.attach_method_fn(fnn)
  params: Array(Ty) = []
  params.push(ty_hasher())
  sig = FuncSig.new(fnn.name, fnn, params, checker_self.t_void())
  sig.owner = sty.name
  checker_self.alloc_ol(fnn)
  checker_self.methods.push(sig)
  checker_self.note_method_named()
  key = "${sty.name}__${fnn.name}"
  if taken = checker_self.method_index.get(key) {
  } else {
    checker_self.method_index[key] = checker_self.methods.size - 1
  }
  if checker_self.adopt_pending {
    checker_self.assign_one_method_emit(sig)
    checker_self.pending.push(fnn)
  }
}

// The protocol methods are named methods (equals, compare, hash), and
// the operators call them: `fn equals(other: T): Bool` (one parameter)
// is registered under the name == (so the derived ==, the Eq bounds,
// contains, index_of and the keys find it as before; messages show
// equals), and a method declared `fn ==`, `fn <`, `fn <=`, `fn >` or
// `fn >=` (in a type's body, as an external method, or in an interface)
// is refused with the method to write.
pub fn (checker_self: Checker) spell_protocols {
  for fnn in program_all_functions(checker_self.program) {
    if fn_is_method(fnn) {
      checker_self.spell_method(fnn)
    }
  }
  for idef in checker_self.program.interfaces {
    for m in idef.methods {
      checker_self.spell_method(m)
    }
  }
}

pub fn (checker_self: Checker) spell_method(fnn: Function) {
  if fnn.lazy || fnn.shown_name.size > 0 {
    return
  }
  pt = "T"
  if fnn.params.size == 1 && fnn.params[0].type.name.size > 0 {
    pt = fnn.params[0].type.name
  }
  if fnn.name == "==" {
    checker_self.fail(fnn.loc, "fn == is spelled equals: write fn equals(other: ${pt}): Bool: == calls it")
  } else if fnn.name == "<" || fnn.name == "<=" || fnn.name == ">" || fnn.name == ">=" {
    checker_self.fail(fnn.loc, "fn ${fnn.name} is spelled compare: write fn compare(other: ${pt}): Int: <, <=, >, >= and sort use it")
  } else if fnn.name == "equals" && fnn.params.size == 1 && !fnn.type_method {
    fnn.name = "=="
    fnn.shown_name = "equals"
  }
}

// A type's order: each `fn compare(other: T): Int` of a struct or class
// gets the internal `<` the order machinery calls (`self.compare(other)
// < 0`, lazy, as derive_eq_method writes ==), so >, <=, >=, sort,
// sorted, min and max follow compare and cannot disagree with it.
pub fn (checker_self: Checker) derive_orders {
  n = checker_self.methods.size
  i = 0
  while i < n {
    ms = checker_self.methods[i]
    i += 1
    if ms.node.lazy || ms.name != "compare" || ms.params.size != 1 || !ms.ret.is_int() || ms.node.generic {
      continue
    }
    if oty = checker_self.resolver.get_named_in(ms.node.owner_mod, ms.owner) {
      if (oty.is_struct() || oty.is_class()) && ms.params[0].same_as(oty) && !checker_self.user_op(oty, "<") {
        checker_self.derive_lt_method(oty, ms.node.loc)
      }
    }
  }
}

// Whether a struct or class ty orders by its `<`: derived here from its
// `fn compare` when derive_orders could not (an instance of a generic
// struct, whose methods exist only once it is instantiated).
pub fn (checker_self: Checker) has_order(ty: Ty, loc: Location): Bool {
  if checker_self.user_op(ty, "<") {
    return true
  }
  if !ty.is_struct() && !ty.is_class() {
    return false
  }
  for ms in checker_self.methods {
    if ms.is_method_of(ty) && ms.name == "compare" && !ms.node.lazy && ms.params.size == 1 && ms.ret.is_int() && ms.params[0].same_as(ty) {
      checker_self.derive_lt_method(ty, loc)
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) derive_lt_method(sty: Ty, loc: Location) {
  fnn = Function.new(loc, "<")
  fnn.owner = sty.name
  fnn.owner_mod = sty.mod_name
  fnn.mod_name = sty.mod_name
  fnn.vis = true
  fnn.lazy = true
  fnn.return_type = TypeName.new(loc, "Bool")
  fnn.params.push(Param.new(loc, "other", ty_to_type_name(sty, loc)))
  call = Expr.new(ex_call(), loc)
  call.callee = "compare"
  me = Expr.new(ex_name(), loc)
  me.ident = "self"
  call.receiver = me
  o = Expr.new(ex_name(), loc)
  o.ident = "other"
  call.args.push(o)
  zero = Expr.new(ex_int(), loc)
  zero.int_bits = 0u64
  lt = Expr.new(ex_binary(), loc)
  lt.op = tk_less()
  lt.left = call
  lt.right = zero
  fnn.body.push(stmt_expr(loc, lt))
  checker_self.attach_method_fn(fnn)
  params: Array(Ty) = []
  params.push(sty)
  sig = FuncSig.new(fnn.name, fnn, params, checker_self.t_bool())
  sig.owner = sty.name
  checker_self.alloc_ol(fnn)
  checker_self.methods.push(sig)
  checker_self.note_method_named()
  key = "${sty.name}__${fnn.name}"
  if taken = checker_self.method_index.get(key) {
  } else {
    checker_self.method_index[key] = checker_self.methods.size - 1
  }
  if checker_self.adopt_pending {
    checker_self.assign_one_method_emit(sig)
    checker_self.pending.push(fnn)
  }
}

// `a.equals(b)` of a struct or a class: the comparison `a == b` (its
// receiver already checked as left), resolved as the operator is.
pub fn (checker_self: Checker) check_equals_call(expr: Expr, left: Ty): Ty {
  if recv = expr.receiver {
    r = expr.args[0]
    args: Array(Expr) = []
    expr.kind = ex_binary()
    expr.op = tk_eq_eq()
    expr.left = recv
    expr.right = r
    expr.receiver = nil
    expr.args = args
    expr.callee = ""
    if got = checker_self.check_agg_compare(expr, r, tk_eq_eq(), "==", left) {
      return got
    }
  }
  checker_self.t_bool()
}

// A type that defines its own equality defines its own hash, and one
// that defines `fn hash(h: Hasher)` defines its own equality: equal
// values must hash alike, so one without the other is refused at its
// declaration, as is a hash of another signature beside an equality.
// Classes too (a class is never a key, but the pair is one protocol).
pub fn (checker_self: Checker) check_hash_pairs {
  for ms in checker_self.methods {
    if !ms.node.lazy && ms.name == "==" {
      hm = checker_self.named_method(ms.owner, ms.node.owner_mod, "hash")
      if h = hm {
        if !(h.params.size == 1 && h.params[0].is_hasher() && h.ret.is_void()) {
          checker_self.fail(h.node.loc, "hash takes the Hasher: fn hash(h: Hasher)")
        }
      } else {
        checker_self.fail(ms.node.loc, "${ms.owner} defines equals but no hash: equal values must hash alike; add fn hash(h: Hasher) feeding it the fields equals compares")
      }
    }
    if !ms.node.lazy && ms.name == "hash" && ms.params.size == 1 && ms.params[0].is_hasher() {
      if e = checker_self.named_method(ms.owner, ms.node.owner_mod, "==") {
      } else {
        checker_self.fail(ms.node.loc, "${ms.owner} defines hash but no equals: a hash agrees with an equality; add fn equals(other: ${ms.owner}): Bool comparing the values hash adds")
      }
    }
  }
}

// The method of owner (of module owner_mod) with this name that the
// program wrote, or nil.
pub fn (checker_self: Checker) named_method(owner: String, owner_mod: String, name: String): FuncSig? {
  for ms in checker_self.methods {
    if ms.owner == owner && (owner_mod.size == 0 || ms.node.owner_mod.size == 0 || ms.node.owner_mod == owner_mod) && ms.name == name && !ms.node.lazy {
      return ms
    }
  }
  nil
}

// Whether ty (a struct or class) has a method of this name.
pub fn (checker_self: Checker) user_op(ty: Ty, name: String): Bool {
  for ms in checker_self.methods {
    if ms.is_method_of(ty) && ms.name == name {
      return true
    }
  }
  false
}

// "" when a value of ty has ==, else the part that has none, shown
// (`Hash(String, Int)`, with the field that holds it). seen holds the
// structs being looked into, so a struct that holds an array of itself
// ends.
pub fn (checker_self: Checker) eq_missing(ty: Ty, seen: Array(String)): String {
  if ty.is_integer() || ty.is_float() || ty.is_bool() || ty.is_string() || ty.is_bytes() || ty.is_enum() || ty.is_class() {
    return ""
  }
  if ty.is_struct() {
    if checker_self.user_op(ty, "==") || seen.has(ty_seen_key(ty)) {
      return ""
    }
    seen.push(ty_seen_key(ty))
    for f in ty.fields {
      m = checker_self.eq_missing(f.ty, seen)
      if m.size > 0 {
        if f.ty.is_struct() || f.ty.is_array() || f.ty.is_nilable() {
          return m
        }
        return "${m} (the field ${ty.show()}.${f.name})"
      }
    }
    return ""
  }
  if ty.is_array() {
    if e = ty.inner {
      return checker_self.eq_missing(e, seen)
    }
  }
  if ty.is_nilable() {
    return checker_self.eq_missing(ty_without_nil(ty), seen)
  }
  if ty.is_set() {
    // An element is a key: it has == by the key rule.
    return ""
  }
  if ty.is_hash() {
    if v = ty.val {
      return checker_self.eq_missing(v, seen)
    }
    return ""
  }
  ty.show()
}

// The refusal of == on ty, which has none (missing as eq_missing gave it).
pub fn (checker_self: Checker) eq_refusal(ty: Ty, missing: String): String {
  if ty.is_union() && !ty.is_nilable() {
    return "${ty.show()} has no ==: take it apart with switch and compare its members"
  }
  if ty.is_struct() {
    return "cannot compare ${ty.show()}: ${missing} has no ==; define fn equals(other: ${ty.show()}): Bool on ${ty.show()}"
  }
  if missing == ty.show() {
    return "${ty.show()} has no =="
  }
  "cannot compare ${ty.show()}: ${missing} has no =="
}

// The derived == of the struct sty: `fn ==(other: S): Bool`,
// each field compared in order with &&, `true` for no field; written
// once, in the struct's module (its fields are visible there), public
// and lazy (lowered only when called). The caller has checked
// eq_missing.
pub fn (checker_self: Checker) derive_eq_method(sty: Ty, loc: Location) {
  if checker_self.user_op(sty, "==") {
    return
  }
  sloc = loc
  for sdef in checker_self.program.structs {
    if sdef.name == sty.name && sdef.mod_name == sty.mod_name {
      sloc = sdef.loc
    }
  }
  fnn = Function.new(sloc, "==")
  fnn.owner = sty.name
  fnn.owner_mod = sty.mod_name
  fnn.mod_name = sty.mod_name
  fnn.vis = true
  fnn.lazy = true
  fnn.return_type = TypeName.new(sloc, "Bool")
  fnn.params.push(Param.new(sloc, "other", ty_to_type_name(sty, sloc)))
  body = Expr.new(ex_bool(), sloc)
  body.bool_val = true
  first = true
  for f in sty.fields {
    cmp = Expr.new(ex_binary(), sloc)
    cmp.op = tk_eq_eq()
    cmp.left = eq_field_of(sloc, "self", f.name)
    cmp.right = eq_field_of(sloc, "other", f.name)
    if first {
      body = cmp
      first = false
    } else {
      both = Expr.new(ex_binary(), sloc)
      both.op = tk_amp_amp()
      both.left = body
      both.right = cmp
      body = both
    }
  }
  fnn.body.push(stmt_expr(sloc, body))
  checker_self.attach_method_fn(fnn)
  params: Array(Ty) = []
  params.push(sty)
  sig = FuncSig.new(fnn.name, fnn, params, checker_self.t_bool())
  sig.owner = sty.name
  checker_self.alloc_ol(fnn)
  checker_self.methods.push(sig)
  checker_self.note_method_named()
  key = "${sty.name}__${fnn.name}"
  if taken = checker_self.method_index.get(key) {
  } else {
    checker_self.method_index[key] = checker_self.methods.size - 1
  }
  if checker_self.adopt_pending {
    checker_self.assign_one_method_emit(sig)
    checker_self.pending.push(fnn)
  }
}

// A struct's name in the lists of structs being looked into, with its
// module: two modules' structs of one name are two structs.
pub fn ty_seen_key(ty: Ty): String {
  "${ty.mod_name}.${ty.name}"
}

pub fn eq_field_of(loc: Location, obj: String, name: String): Expr {
  o = Expr.new(ex_name(), loc)
  o.ident = obj
  f = Expr.new(ex_field(), loc)
  f.object = o
  f.ident = name
  f
}

// The generic functions behind an array's and an optional's ==, and an
// array's min and max by a user < (each keeps the first of equal
// elements), as Avant, parsed once per program when first needed.
pub fn eq_template_source(name: String): String {
  if name == "__avant_key_hash" {
    return "fn __avant_key_hash(k: T, h: Hasher) {\n  h.add(k)\n}\n"
  }
  if name == "__avant_key_eq" {
    return "fn __avant_key_eq(a: T, b: T): Bool {\n  a == b\n}\n"
  }
  if name == "__avant_eq_array" {
    return "fn __avant_eq_array(a: Array(T), b: Array(T)): Bool {\n  if a.size != b.size {\n    return false\n  }\n  i = 0\n  while i < a.size {\n    if a[i] != b[i] {\n      return false\n    }\n    i += 1\n  }\n  true\n}\n"
  }
  if name == "__avant_eq_hash" {
    return "fn __avant_eq_hash(a: Hash(K, V), b: Hash(K, V)): Bool {\n  if a.size != b.size {\n    return false\n  }\n  for k, v in a {\n    if w = b[k] {\n      if v != w {\n        return false\n      }\n    } else {\n      return false\n    }\n  }\n  true\n}\n"
  }
  if name == "__avant_eq_set" {
    return "fn __avant_eq_set(a: Set(T), b: Set(T)): Bool {\n  if a.size != b.size {\n    return false\n  }\n  for v in a {\n    if !b.has(v) {\n      return false\n    }\n  }\n  true\n}\n"
  }
  if name == "__avant_min" || name == "__avant_max" {
    test = "xs[i] < m"
    if name == "__avant_max" {
      test = "m < xs[i]"
    }
    return "fn ${name}(xs: Array(T)): T? {\n  if xs.size == 0 {\n    return nil\n  }\n  m = xs[0]\n  i = 1\n  while i < xs.size {\n    if ${test} {\n      m = xs[i]\n    }\n    i += 1\n  }\n  m\n}\n"
  }
  if name == "__avant_contains" {
    return "fn __avant_contains(v: T, xs: Array(T)): Bool {\n  i = 0\n  while i < xs.size {\n    if xs[i] == v {\n      return true\n    }\n    i += 1\n  }\n  false\n}\n"
  }
  if name == "__avant_index_of" {
    return "fn __avant_index_of(v: T, xs: Array(T)): Int? {\n  i = 0\n  while i < xs.size {\n    if xs[i] == v {\n      return i\n    }\n    i += 1\n  }\n  nil\n}\n"
  }
  "fn __avant_eq_opt(a: T?, b: T?): Bool {\n  if x = a {\n    if y = b {\n      return x == y\n    }\n    return false\n  }\n  if _ = b {\n    return false\n  }\n  true\n}\n"
}

pub fn (checker_self: Checker) eq_template(name: String): FuncSig? {
  for sig in checker_self.functions {
    if sig.name == name && sig.node.generic {
      return sig
    }
  }
  src = Source.new("<avant>", eq_template_source(name))
  lex = Lexer.new(src)
  tokens = lex.tokenize()
  ps = Parser.new(src, tokens)
  p = ps.parse()
  if p.functions.size != 1 {
    return nil
  }
  fnn = p.functions[0]
  fnn.mod_name = checker_self.root_module
  checker_self.program.functions.push(fnn)
  saved = checker_self.current_module
  checker_self.current_module = fnn.mod_name
  checker_self.register_function(fnn)
  checker_self.current_module = saved
  for sig2 in checker_self.functions {
    if sig2.name == name && sig2.node.generic {
      return sig2
    }
  }
  nil
}

// `a == b` of two arrays or two optionals of type ty: a call of the
// template's instance for the element type, recorded on the expression
// (op_fn); false when it cannot be made (an error was given).
pub fn (checker_self: Checker) eq_by_function(expr: Expr, ty: Ty): Bool {
  name = "__avant_eq_opt"
  arg = ty_without_nil(ty)
  subst: Array(Ty) = []
  if ty.is_array() {
    name = "__avant_eq_array"
    if e = ty.inner {
      arg = e
    }
  } else if ty.is_set() {
    name = "__avant_eq_set"
    if k = ty.key {
      arg = k
    }
  } else if ty.is_hash() {
    name = "__avant_eq_hash"
    if k = ty.key {
      arg = k
    }
    if v = ty.val {
      subst.push(arg)
      arg = v
    }
  }
  if sig = checker_self.eq_template(name) {
    subst.push(arg)
    if inst = checker_self.instantiate_function(sig, subst, expr.loc) {
      expr.resolved = inst.node.emit_name
      expr.op_form = op_fn()
      if expr.op == tk_not_eq() {
        expr.op_form = op_fn() + op_not()
      }
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) eq_is_compare(op: Int): Bool {
  op == tk_eq_eq() || op == tk_not_eq() || op == tk_less() || op == tk_less_eq() || op == tk_greater() || op == tk_greater_eq()
}

// A comparison whose left operand is a struct or class (check_binary,
// once the left is typed): the type's own operator method when it has
// one; else the derived forms of the rule above. nil when op is no
// comparison and the type defines no method for it (the caller goes on,
// the right still unchecked).
pub fn (checker_self: Checker) check_agg_compare(expr: Expr, r: Expr, op: Int, opname: String, left: Ty): Ty? {
  if checker_self.user_op(left, opname) {
    right = checker_self.check_call_arg(r)
    arg_tys: Array(Ty) = []
    arg_tys.push(right)
    none: Ty? = nil
    rs: Array(Expr) = [r]
    if sig = checker_self.match_method(left.name, opname, arg_tys, none, expr.loc, left.name, left.mod_name, checker_self.int_literal_flags(rs)) {
      // A literal operand takes the parameter's type (`v + 2` with an
      // Int32 parameter), as a method's literal argument does.
      got = checker_self.fit_call_arg(r, right, sig.params[0])
      if !ty_assignable(got, sig.params[0]) {
        checker_self.fail(r.loc, "${left.show()}.${opname} takes ${sig.params[0].show()}, got ${got.show()}")
      }
      expr.resolved = sig.node.emit_name
      return sig.ret
    }
    return checker_self.t_int()
  }
  if !checker_self.eq_is_compare(op) {
    return nil
  }
  right = checker_self.check_expr(r)
  if checker_self.has_err() {
    return checker_self.t_bool()
  }
  if !right.same_as(left) {
    checker_self.fail_hint(expr.loc, "cannot compare ${left.show()} with ${right.show()}: ${opname} compares two values of one type", checker_self.open_hint(r, right))
    return checker_self.t_bool()
  }
  if op == tk_eq_eq() || op == tk_not_eq() {
    if !checker_self.user_op(left, "==") {
      if left.is_class() {
        // Identity: the lowering compares the references.
        return checker_self.t_bool()
      }
      seen: Array(String) = []
      missing = checker_self.eq_missing(left, seen)
      if missing.size > 0 {
        checker_self.fail(expr.loc, checker_self.eq_refusal(left, missing))
        return checker_self.t_bool()
      }
      checker_self.derive_eq_method(left, expr.loc)
    }
    if checker_self.resolve_compare(expr, left, right, "==") {
      if op == tk_not_eq() {
        expr.op_form = op_not()
      }
    }
    return checker_self.t_bool()
  }
  if !checker_self.has_order(left, expr.loc) {
    checker_self.fail(expr.loc, "${left.show()} has no order: define fn compare(other: ${left.show()}): Int on it (negative, zero or positive: <, <=, >, >=, sort, min and max use it)")
    return checker_self.t_bool()
  }
  if checker_self.resolve_compare(expr, left, right, "<") {
    if op == tk_greater() {
      expr.op_form = op_swap()
    } else if op == tk_less_eq() {
      expr.op_form = op_swap() + op_not()
    } else if op == tk_greater_eq() {
      expr.op_form = op_not()
    }
  }
  checker_self.t_bool()
}

// expr's comparison as the method name of left's type, taking right;
// false when no such method fits (match_method said why).
pub fn (checker_self: Checker) resolve_compare(expr: Expr, left: Ty, right: Ty, name: String): Bool {
  arg_tys: Array(Ty) = []
  arg_tys.push(right)
  none: Ty? = nil
  if sig = checker_self.match_method(left.name, name, arg_tys, none, expr.loc, left.name, left.mod_name, checker_self.no_int_literals()) {
    if !sig.ret.is_bool() {
      checker_self.fail(expr.loc, "${left.show()}.${name} returns ${sig.ret.show()}; a comparison derived from it needs Bool")
      return false
    }
    expr.resolved = sig.node.emit_name
    return true
  }
  false
}

// sort, sorted, min and max of an array whose element type defines <
//: the element's order is its <. sort
// and sorted become their block form `{ |a, b| a < b }` (expr.block set,
// nil returned, the caller goes on with the block); min and max become
// the call of __avant_min or __avant_max for the element type. nil when
// the element type defines no < (the builtin order applies).
pub fn (checker_self: Checker) user_order_call(expr: Expr, array: Ty): Ty? {
  name = expr.callee
  if !(name == "sort" || name == "sorted" || name == "min" || name == "max") || expr.args.size != 0 {
    return nil
  }
  if _ = expr.block {
    return nil
  }
  if e = array.inner, e.is_agg() && checker_self.has_order(e, expr.loc) {
    if name == "sort" || name == "sorted" {
      blk = Block.new(expr.loc)
      blk.params.push("__avant_a")
      blk.params.push("__avant_b")
      a = Expr.new(ex_name(), expr.loc)
      a.ident = "__avant_a"
      b = Expr.new(ex_name(), expr.loc)
      b.ident = "__avant_b"
      lt = Expr.new(ex_binary(), expr.loc)
      lt.op = tk_less()
      lt.left = a
      lt.right = b
      blk.body.push(stmt_expr(expr.loc, lt))
      expr.block = blk
      return nil
    }
    if recv = expr.receiver, sig = checker_self.eq_template("__avant_${name}") {
      subst: Array(Ty) = []
      subst.push(e)
      if inst = checker_self.instantiate_function(sig, subst, expr.loc) {
        args: Array(Expr) = []
        args.push(recv)
        expr.args = args
        expr.receiver = nil
        expr.callee = "__avant_${name}"
        expr.resolved = inst.node.emit_name
        expr.method_call = false
      }
    }
    return ty_nilable(e)
  }
  nil
}

// `xs.has(v)` and `xs.index_of(v)` (expr, its argument checked)
// with elements of type e: they compare by the element's ==, and refuse
// what == refuses. An element the runtime searches as == compares it (an
// integer, a Float64 by IEEE, a Bool, a String by bytes, a class without
// fn == by identity) keeps the runtime's search; any other becomes the
// call of a loop through ==, the value first as in the runtime's form
// (__avant_contains, __avant_index_of).
pub fn (checker_self: Checker) search_by_eq(expr: Expr, e: Ty) {
  if e.is_integer() || e.is_float() || e.is_bool() || e.is_string() {
    return
  }
  if e.is_class() && !checker_self.user_op(e, "==") {
    return
  }
  seen: Array(String) = []
  missing = checker_self.eq_missing(e, seen)
  if missing.size > 0 || (e.is_union() && !e.is_nilable()) {
    checker_self.fail(expr.loc, "${expr.callee} compares the elements with ==: ${checker_self.eq_refusal(e, missing)}")
    return
  }
  if e.is_struct() {
    checker_self.derive_eq_method(e, expr.loc)
  }
  name = "__avant_${expr.callee}"
  if expr.callee == "has" {
    name = "__avant_contains"
  }
  if recv = expr.receiver, sig = checker_self.eq_template(name) {
    subst: Array(Ty) = []
    subst.push(e)
    if inst = checker_self.instantiate_function(sig, subst, expr.loc) {
      args: Array(Expr) = []
      args.push(expr.args[0])
      args.push(recv)
      expr.args = args
      expr.receiver = nil
      expr.callee = name
      expr.resolved = inst.node.emit_name
      expr.method_call = false
    }
  }
}

// Whether the elements of an array of type array order by a user <.
pub fn (checker_self: Checker) user_ordered(array: Ty): Bool {
  if e = array.inner, e.is_agg() {
    return checker_self.user_op(e, "<")
  }
  false
}
