import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import loader
import typed_ir
import checker.names
import checker
import receiver_writes

// std.sync's Channel and Mutex cross a task as shared handles: that
// is their purpose. A class of another module with one of those
// names is an ordinary class (before, any class named Channel or
// Mutex crossed).
pub fn (checker_self: Checker) is_share_ty(ty: Ty): Bool {
  checker_self.is_sync_ty(ty, "Channel") || checker_self.is_sync_ty(ty, "Mutex")
}

pub fn (checker_self: Checker) copyable_for_spawn(ty: Ty): Bool {
  if checker_self.is_share_ty(ty) || checker_self.is_handle_class(ty) {
    return true
  }
  if ty.is_struct() {
    return checker_self.struct_crosses(ty)
  }
  // A captured Array is shared with the task, frozen until the task
  // ends, so its elements cross in turn: an Array of a class would put
  // one mutable object in two tasks with no lock (send's rule,
  // checker/guard.av send_crosses).
  if ty.is_array() {
    if e = ty.inner {
      return checker_self.copyable_for_spawn(e)
    }
    return false
  }
  // A captured Hash (a Set too) is shared and frozen as an Array is: its
  // keys are plain values, and its values cross in turn.
  if ty.is_hash() {
    if k = ty.key, v = ty.val {
      return checker_self.copyable_bits(k) && checker_self.copyable_for_spawn(v)
    }
    return false
  }
  checker_self.copyable_bits(ty)
}

// A struct crosses as a copy when every field does: a value that holds
// no reference to mutable state (copyable_bits), a Channel or a Mutex
// (the copy shares the handle, as a captured Channel or Mutex does), or
// such a struct in turn. A field of the copy assigned in one task is not
// the other's.
pub fn (checker_self: Checker) struct_crosses(ty: Ty): Bool {
  for field in ty.fields {
    if checker_self.is_share_ty(field.ty) || checker_self.copyable_bits(field.ty) {
      continue
    }
    if field.ty.is_struct() && checker_self.struct_crosses(field.ty) {
      continue
    }
    return false
  }
  true
}

// A class whose every field is a Channel or a Mutex: it crosses a task as
// a handle, the reference shared as the handles it holds are, when no
// code assigns one of its fields outside its initialize (checked once
// the program is: check_handle_classes), so every task reads the same
// handles for good and nothing else in it can change.
pub fn (checker_self: Checker) is_handle_class(ty: Ty): Bool {
  if !ty.is_class() || ty.template {
    return false
  }
  for f in ty.fields {
    if !checker_self.is_share_ty(f.ty) {
      return false
    }
  }
  true
}

// The handle classes a crossing value of type ty holds (itself, or the
// elements and values of its Arrays and Hashes), noted with where they
// crossed and what (`spawn cannot capture s`, ...): the message if one of
// their fields is assigned outside initialize.
pub fn (checker_self: Checker) note_handles(ty: Ty, loc: Location, what: String) {
  if checker_self.is_handle_class(ty) {
    checker_self.handle_tys.push(ty)
    checker_self.handle_at.push(loc)
    checker_self.handle_what.push(what)
    return
  }
  if ty.is_array() {
    if e = ty.inner {
      checker_self.note_handles(e, loc, what)
    }
    return
  }
  if ty.is_hash() {
    if v = ty.val {
      checker_self.note_handles(v, loc, what)
    }
  }
}

// Every assignment to a field of a class that crossed as a handle,
// outside that class's initialize, refuses the crossing.
pub fn (checker_self: Checker) check_handle_classes(fns: Array(Function)) {
  if checker_self.handle_tys.size == 0 || checker_self.any_err() {
    return
  }
  all: Array(Function) = []
  for f in fns {
    if !f.generic {
      all.push(f)
    }
  }
  all.concat(checker_self.pending)
  for fnn in all {
    // An initialize sets its own object's fields: "MODULE.Class".
    in_init = ""
    if fnn.name == "initialize" && fnn.owner.size > 0 {
      om = fnn.owner_mod
      if om.size == 0 {
        om = fnn.mod_name
      }
      in_init = "${om}.${fnn.owner}"
    }
    checker_self.handle_stores(fnn.body, in_init)
    if checker_self.has_err() {
      return
    }
  }
}

pub fn (checker_self: Checker) handle_stores(body: Array(Stmt), in_init: String) {
  for st in body {
    if checker_self.has_err() {
      return
    }
    if st.kind == st_assign() {
      if t = st.target, t.kind == ex_field() {
        if obj = t.object, ot = obj.ty {
          for i in 0..checker_self.handle_tys.size {
            ht = checker_self.handle_tys[i]
            if ot.is_class() && ot.name == ht.name && ot.mod_name == ht.mod_name && !(in_init == "${ht.mod_name}.${ht.name}" && obj.kind == ex_name() && obj.ident == "self") {
              at = checker_self.handle_at[i]
              checker_self.fail(at, "${checker_self.handle_what[i]}: a ${ht.show()}, a class of Mutex and Channel fields, crosses as a handle only when no field of it is assigned after initialize, and ${ht.show()}.${t.ident} is assigned at ${t.loc.line()}:${t.loc.column()}; set its fields in initialize, or keep the changing value in one of its Mutexes")
              return
            }
          }
        }
      }
    }
    for e in [st.expr, st.cond, st.target, st.value] {
      if x = e {
        checker_self.handle_stores_expr(x, in_init)
      }
    }
    checker_self.handle_stores(st.pre, in_init)
    checker_self.handle_stores(st.then_body, in_init)
    checker_self.handle_stores(st.else_body, in_init)
    checker_self.handle_stores(st.body, in_init)
  }
}

pub fn (checker_self: Checker) handle_stores_expr(e: Expr, in_init: String) {
  if b = e.block {
    checker_self.handle_stores(b.body, in_init)
  }
  for cs in e.cases {
    checker_self.handle_stores(cs.body, in_init)
  }
  checker_self.handle_stores(e.else_body, in_init)
  for x in [e.inner, e.left, e.right, e.object, e.receiver, e.cond, e.size_expr] {
    if y = x {
      checker_self.handle_stores_expr(y, in_init)
    }
  }
  for a in e.args {
    checker_self.handle_stores_expr(a, in_init)
  }
  for a2 in e.elems {
    checker_self.handle_stores_expr(a2, in_init)
  }
  for a3 in e.field_exprs {
    checker_self.handle_stores_expr(a3, in_init)
  }
}

// The part of a type spawn's rule refuses that names it best: an
// Array's elements or a Hash's keys or values, at any level, else ty.
pub fn (checker_self: Checker) cross_leaf(ty: Ty): Ty {
  if ty.is_array() {
    if e = ty.inner, !checker_self.copyable_for_spawn(e) {
      return checker_self.cross_leaf(e)
    }
  }
  if ty.is_hash() {
    if k = ty.key, !checker_self.copyable_bits(k) {
      return k
    }
    if v = ty.val, !checker_self.copyable_for_spawn(v) {
      return checker_self.cross_leaf(v)
    }
  }
  ty
}

// Whether a type holds a Hash at some level of Arrays and Hashes: a send
// copies an Array, not a Hash, so such a value does not cross by send.
pub fn holds_hash(ty: Ty): Bool {
  if ty.is_hash() {
    return true
  }
  if ty.is_array() {
    if e = ty.inner {
      return holds_hash(e)
    }
  }
  false
}

// "Array", "Hash" or "Set": what the captured name root holds, for a
// message.
pub fn (checker_self: Checker) frozen_kind(root: String): String {
  if ty = checker_self.lookup(root) {
    if ty.is_set() {
      return "Set"
    }
    if ty.is_hash() {
      return "Hash"
    }
  }
  "Array"
}

pub fn (checker_self: Checker) copyable_bits(ty: Ty): Bool {
  if ty.is_integer() {
    return true
  }
  // An enum is a number.
  if ty.is_enum() {
    return true
  }
  if ty.is_uint64() {
    return true
  }
  if ty.is_bool() {
    return true
  }
  if ty.is_float() {
    return true
  }
  if ty.is_string() {
    return true
  }
  // Bytes is immutable, as a String is: both tasks keep the same bytes.
  if ty.is_bytes() {
    return true
  }
  if ty.is_ptr() {
    return checker_self.ptr_crosses_here(ty)
  }
  if ty.is_struct() {
    for field in ty.fields {
      if !checker_self.copyable_bits(field.ty) {
        return false
      }
    }
    return true
  }
  false
}

// A C pointer crosses a task only in the module that declares it: a
// `Ptr(T)` whose T is a C layout of one of this module's `lib` blocks,
// or an opaque C type one of them names (in a function's parameters or
// result, or a layout's field). The package that binds a C library
// shares its handles between its own tasks (a client pool, a
// connection the library makes safe for threads): C memory's
// thread-safety is the C library's, and the package's code is where
// that is known. Its users see a crossing refused as before. A
// `Ptr(Void)`, or a pointer to a C scalar or to another pointer, names
// no declaration, and never crosses.
pub fn (checker_self: Checker) ptr_crosses_here(ty: Ty): Bool {
  if p = ty.inner {
    if !(p.is_opaque() || p.is_clayout()) {
      return false
    }
    if p.mod_name.size > 0 && p.mod_name != checker_self.current_module {
      // Another module's C type of the same name.
      return false
    }
    for lb in checker_self.program.libs {
      if lb.mod_name == checker_self.current_module && lib_declares(lb, p.name, p.is_clayout()) {
        return true
      }
    }
  }
  false
}

// Whether every Ptr a value of type t holds (itself, a struct's fields,
// a union's members) crosses here.
pub fn (checker_self: Checker) ptrs_cross_here(t: Ty): Bool {
  if t.is_ptr() {
    return checker_self.ptr_crosses_here(t)
  }
  if t.is_union() {
    for m in t.members {
      if !checker_self.ptrs_cross_here(m) {
        return false
      }
    }
    return true
  }
  if t.is_struct() {
    for f in t.fields {
      if !checker_self.ptrs_cross_here(f.ty) {
        return false
      }
    }
  }
  true
}

// Whether the lib block lb declares the C type name: a layout of that
// name (a C layout), or a name its functions and layouts write (an
// opaque type).
pub fn lib_declares(lb: LibDef, name: String, layout: Bool): Bool {
  if layout {
    for lay in lb.layouts {
      if lay.name == name {
        return true
      }
    }
    return false
  }
  for f in lb.funs {
    for p in f.params {
      if type_name_names(p.type, name) {
        return true
      }
    }
    if r = f.return_type, type_name_names(r, name) {
      return true
    }
  }
  for lay2 in lb.layouts {
    for fl in lay2.fields {
      if type_name_names(fl.type, name) {
        return true
      }
    }
  }
  false
}

pub fn type_name_names(tn: TypeName, name: String): Bool {
  if tn.name == name && tn.args.size == 0 {
    return true
  }
  for a in tn.args {
    if type_name_names(a, name) {
      return true
    }
  }
  for m in tn.members {
    if type_name_names(m, name) {
      return true
    }
  }
  if r = tn.ret {
    return type_name_names(r, name)
  }
  false
}

// What may leave a `Mutex.with` block as its value: spawn's rule for
// what crosses a task (a share type, or bits that hold no reference to
// mutable state), without the frozen array (that rule freezes a named
// array while a task is pending; a value has no name to freeze) and
// with what holds no mutable state either: `Bytes`, `nil`, and a union
// or a struct of such members. A class, an array, a hash, a `Buf`, a
// `fn` or a pointer may be the guarded object or a part of it: outside
// the block the lock no longer protects it.
pub fn (checker_self: Checker) leaves_mutex_with(ty: Ty): Bool {
  if checker_self.is_share_ty(ty) {
    return true
  }
  if ty.is_nil() || ty.is_bytes() {
    return true
  }
  if ty.is_union() {
    for m in ty.members {
      if !checker_self.leaves_mutex_with(m) {
        return false
      }
    }
    return true
  }
  if ty.is_struct() {
    for field in ty.fields {
      if !checker_self.leaves_mutex_with(field.ty) {
        return false
      }
    }
    return true
  }
  checker_self.copyable_bits(ty)
}

// The construct a capture message names: the user wrote a spawn block
// or an Array's `.parallel` block, and both are checked by the walk
// below (node is the spawn or the `.parallel` call).
pub fn task_word(node: Expr): String {
  if node.kind == ex_call() && node.callee == "parallel" {
    return ".parallel"
  }
  if node.kind == ex_lambda() {
    return handler_word(node)
  }
  "spawn"
}

// What a server's lambda is called in a message, by the method that
// registered it (node.callee, set by check_handler_lambda): a timer of
// Server.every and a hook of Server.on_close are checked as handlers,
// but neither is one.
pub fn handler_word(node: Expr): String {
  if node.callee == "every" {
    return "a Server.every timer"
  }
  if node.callee == "on_close" {
    return "a Server.on_close hook"
  }
  "an HTTP handler"
}

// handler_runs, said of a function value given as the lambda.
pub fn handler_runs_fn(node: Expr): String {
  if node.callee == "every" || node.callee == "on_close" {
    return handler_runs(node)
  }
  "the server runs it on each of its loop threads at once"
}

// handler_runs, said of the one lambda a message names.
pub fn handler_runs_one(node: Expr): String {
  if node.callee == "every" || node.callee == "on_close" {
    return handler_runs(node)
  }
  "the server runs the handler on each of its loop threads at once"
}

// Why what a server's lambda captures must cross threads, in the words
// of the method that registered it.
pub fn handler_runs(node: Expr): String {
  if node.callee == "every" {
    return "the timer runs on the server's first loop thread while the handlers run on every loop thread"
  }
  if node.callee == "on_close" {
    return "the hook runs on the thread that called serve, after the loop threads that ran the handlers"
  }
  "the server runs every handler on each of its loop threads at once"
}

// Who shares a captured Array with the code around node, and what a
// mutable object must not reach, in node's words.
pub fn task_whom(node: Expr): String {
  if node.kind == ex_lambda() {
    return "server's loop threads"
  }
  "task"
}

pub fn task_unit(node: Expr): String {
  if node.kind == ex_lambda() {
    return "thread"
  }
  "task"
}

// Until when a captured Array is read-only, in node's words.
pub fn frozen_until(node: Expr): String {
  if node.kind == ex_call() && node.callee == "parallel" {
    return "read-only while the bodies run"
  }
  if node.kind == ex_lambda() && (node.callee == "every" || node.callee == "on_close") {
    return "read-only once it is registered, since ${handler_runs(node)}"
  }
  if node.kind == ex_lambda() {
    return "read-only once the handler is registered, since the server runs the handler on each of its loop threads at once"
  }
  "read-only until join"
}

pub fn (checker_self: Checker) collect_spawn_captures(expr: Expr, body: Array(Stmt)) {
  seen = Hash(String, Int).new()
  checker_self.walk_spawn_stmts(body, expr, seen)
}

pub fn (checker_self: Checker) walk_spawn_stmts(body: Array(Stmt), node: Expr, seen: Hash(String, Int)) {
  i = 0
  while i < body.size {
    checker_self.walk_spawn_stmt(body[i], node, seen)
    i += 1
  }
}

pub fn (checker_self: Checker) walk_spawn_stmt(stmt: Stmt, node: Expr, seen: Hash(String, Int)) {
  k = stmt.kind
  if k == st_return() {
    if e = stmt.expr {
      checker_self.walk_spawn_expr(e, node, seen)
    }
    return
  }
  if k == st_if() {
    checker_self.walk_spawn_stmts(stmt.pre, node, seen)
    if c = stmt.cond {
      checker_self.walk_spawn_expr(c, node, seen)
    }
    checker_self.walk_spawn_stmts(stmt.then_body, node, seen)
    checker_self.walk_spawn_stmts(stmt.else_body, node, seen)
    return
  }
  if k == st_while() {
    checker_self.walk_spawn_stmts(stmt.pre, node, seen)
    if c = stmt.cond {
      checker_self.walk_spawn_expr(c, node, seen)
    }
    checker_self.walk_spawn_stmts(stmt.body, node, seen)
    return
  }
  if k == st_assign() {
    if target = stmt.target {
      if target.kind == ex_name() {
        if ty = checker_self.lookup(target.ident) {
          if node.kind == ex_lambda() {
            checker_self.fail(target.loc, "${handler_word(node)} cannot assign to ${target.ident}: ${handler_runs_one(node)}, so the captured variable would be written by several threads; keep a value the handlers change in a Mutex")
          } else if task_word(node) == "spawn" {
            checker_self.fail(target.loc, "spawn cannot assign to ${target.ident}: the task has its own copy, made when it starts, and the copy is read-only; give the new value as the block's value and read it from join")
          } else {
            checker_self.fail(target.loc, ".parallel cannot assign to ${target.ident}: each body has its own copy, and the copy is read-only; give the new value as the body's value, which .parallel returns in its array")
          }
        }
      } else if checker_self.spawn_array_frozen(target) {
        root = checker_self.expr_root_name(target)
        checker_self.fail(target.loc, "${task_word(node)} cannot mutate captured ${checker_self.frozen_kind(root)} ${root}; it is ${frozen_until(node)}")
        checker_self.walk_spawn_expr(target, node, seen)
      } else {
        checker_self.walk_spawn_expr(target, node, seen)
      }
    }
    if v = stmt.value {
      checker_self.walk_spawn_expr(v, node, seen)
    }
    return
  }
  if k == st_expr() {
    if e = stmt.expr {
      checker_self.walk_spawn_expr(e, node, seen)
    }
    return
  }
  if k == st_pin() || k == st_release() || k == st_hold() || k == st_defer() {
    // A `pin` block's value and body, and `release`'s place, are walked
    // like any statement's (before, a name used only there was not
    // captured, and the back end stopped with L0001).
    if e = stmt.expr {
      checker_self.walk_spawn_expr(e, node, seen)
    }
    checker_self.walk_spawn_stmts(stmt.body, node, seen)
  }
}

pub fn (checker_self: Checker) walk_spawn_expr(expr: Expr, node: Expr, seen: Hash(String, Int)) {
  k = expr.kind
  if k == ex_name() {
    checker_self.note_spawn_capture(expr, node, seen)
    return
  }
  if k == ex_call() {
    if inner = expr.inner {
      checker_self.walk_spawn_expr(inner, node, seen)
    }
    if expr.indirect && expr.callee.size > 0 {
      name = Expr.new(ex_name(), expr.loc)
      name.ident = expr.callee
      checker_self.note_spawn_capture(name, node, seen)
    }
    if recv = expr.receiver {
      if checker_self.changes_frozen(expr.callee, recv) && checker_self.spawn_array_frozen(recv) {
        root = checker_self.expr_root_name(recv)
        checker_self.fail(expr.loc, "${task_word(node)} cannot mutate captured ${checker_self.frozen_kind(root)} ${root}; it is ${frozen_until(node)}")
      }
      if checker_self.spawn_array_frozen(recv) && rw_element_place(recv) {
        // A method on an element (`xs[0].bump`): refused once the
        // program is checked if it changes its receiver.
        checker_self.note_element_call(expr, recv, task_side(node))
      }
      checker_self.walk_spawn_expr(recv, node, seen)
    }
    if expr.args.size > 0 && verb_template_mutator(expr.callee) && checker_self.spawn_array_frozen(expr.args[0]) {
      root = checker_self.expr_root_name(expr.args[0])
      checker_self.fail(expr.loc, "${task_word(node)} cannot mutate captured ${checker_self.frozen_kind(root)} ${root}; it is ${frozen_until(node)}")
    }
    for i in 0..expr.args.size {
      checker_self.walk_spawn_expr(expr.args[i], node, seen)
    }
    if b = expr.block {
      checker_self.walk_spawn_stmts(b.body, node, seen)
    }
    return
  }
  if k == ex_unary() {
    if inner = expr.inner {
      checker_self.walk_spawn_expr(inner, node, seen)
    }
    return
  }
  if k == ex_binary() {
    if l = expr.left {
      checker_self.walk_spawn_expr(l, node, seen)
    }
    if r = expr.right {
      checker_self.walk_spawn_expr(r, node, seen)
    }
    return
  }
  if k == ex_field() {
    if obj = expr.object {
      if checker_self.field_mutates_array(expr) && checker_self.spawn_array_frozen(obj) {
        root = checker_self.expr_root_name(obj)
        checker_self.fail(expr.loc, "${task_word(node)} cannot mutate captured ${checker_self.frozen_kind(root)} ${root}; it is ${frozen_until(node)}")
      }
      if expr.method_call && checker_self.spawn_array_frozen(obj) && rw_element_place(obj) {
        checker_self.note_element_call(expr, obj, task_side(node))
      }
      checker_self.walk_spawn_expr(obj, node, seen)
    }
    return
  }
  if k == ex_index() {
    if l = expr.left {
      checker_self.walk_spawn_expr(l, node, seen)
    }
    if r = expr.right {
      checker_self.walk_spawn_expr(r, node, seen)
    }
    return
  }
  if k == ex_struct() {
    for i in 0..expr.field_exprs.size {
      checker_self.walk_spawn_expr(expr.field_exprs[i], node, seen)
    }
    return
  }
  if k == ex_array() || k == ex_hash_lit() {
    for i in 0..expr.elems.size {
      checker_self.walk_spawn_expr(expr.elems[i], node, seen)
    }
    return
  }
  if k == ex_array_new() {
    if size = expr.size_expr {
      checker_self.walk_spawn_expr(size, node, seen)
    }
    for fv in expr.elems {
      checker_self.walk_spawn_expr(fv, node, seen)
    }
    return
  }
  if k == ex_try() {
    if inner = expr.inner {
      checker_self.walk_spawn_expr(inner, node, seen)
    }
    return
  }
  if k == ex_interp() {
    for part in expr.parts {
      if inner = part.expr {
        checker_self.walk_spawn_expr(inner, node, seen)
      }
    }
    return
  }
  if k == ex_switch() {
    if c = expr.cond {
      checker_self.walk_spawn_expr(c, node, seen)
    }
    for i in 0..expr.cases.size {
      checker_self.walk_spawn_stmts(expr.cases[i].body, node, seen)
    }
    if expr.has_else {
      checker_self.walk_spawn_stmts(expr.else_body, node, seen)
    }
    return
  }
  if k == ex_lambda() {
    if b = expr.block {
      mark = checker_self.spawn_skip.size
      checker_self.spawn_skip.concat(b.params)
      checker_self.walk_spawn_stmts(b.body, node, seen)
      while checker_self.spawn_skip.size > mark {
        dropped = checker_self.spawn_skip.pop()
      }
    }
  }
}

pub fn (checker_self: Checker) spawn_skip_has(name: String): Bool {
  for i in 0..checker_self.spawn_skip.size {
    if checker_self.spawn_skip[i] == name {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) expr_root_name(expr: Expr): String {
  k = expr.kind
  if k == ex_name() {
    // A walk's hidden array (checker/places.av) is the array it holds,
    // and a place, the element itself, is reached from it.
    if root = checker_self.place_roots.get(expr.ident) {
      return root
    }
    pi = checker_self.place_at(expr.ident)
    if pi >= 0 {
      if root2 = checker_self.place_roots.get(checker_self.place_arrs[pi]) {
        return root2
      }
    }
    return expr.ident
  }
  if k == ex_field() {
    if obj = expr.object {
      return checker_self.expr_root_name(obj)
    }
  }
  if k == ex_index() {
    if l = expr.left {
      return checker_self.expr_root_name(l)
    }
  }
  ""
}

pub fn (checker_self: Checker) array_mutator(name: String): Bool {
  if name == "push" {
    return true
  }
  if name == "pop" {
    return true
  }
  if name == "clear" {
    return true
  }
  if name == "fill" {
    return true
  }
  if name == "sort" {
    return true
  }
  if name == "reverse" {
    return true
  }
  if name == "delete_if" || name == "insert" || name == "delete_at" || name == "try_delete_at" || name == "concat" || name == "shuffle" {
    return true
  }
  name == "reserve"
}

// The array verbs the checker writes as a call of a generic function
// whose first argument is the array (checker/verbs.av): by the time a
// block is walked, `xs.shuffle(rng)` is `__avant_shuffle(xs, rng)`.
pub fn verb_template_mutator(callee: String): Bool {
  callee == "__avant_fill" || callee == "__avant_shuffle" || callee == "__avant_try_delete_at"
}

// The methods that change a Hash or a Set: `delete`, `delete_if`,
// `clear`, `inc`, and a Set's `add` (a store `h[k] = v` is
// an assignment).
pub fn hash_mutator(name: String): Bool {
  name == "delete" || name == "delete_if" || name == "clear" || name == "inc" || name == "add"
}

// The type of a name, or of an element or value reached from one by
// indexing (`xs`, `xs[0]`, `h["a"]`, `h["a"][0]`), as the scope declares
// it; nil for any other expression (a field, a call) and for a name the
// block declares.
pub fn (checker_self: Checker) place_ty(expr: Expr): Ty? {
  if expr.kind == ex_name() {
    if checker_self.spawn_skip_has(expr.ident) {
      return nil
    }
    return checker_self.lookup(expr.ident)
  }
  if expr.kind == ex_index() {
    if l = expr.left, lt = checker_self.place_ty(l) {
      if lt.is_array() {
        return lt.inner
      }
      if lt.is_hash() {
        return lt.val
      }
    }
  }
  nil
}

// Whether calling the method name on recv changes what the freeze
// covers: a Hash mutator on a hash, an Array mutator on an array or on
// anything else an array holds (as before); on a hash's value that is
// neither (a String's `reverse`) or on what a hash's method gives
// (`h.keys`), nothing.
pub fn (checker_self: Checker) changes_frozen(name: String, recv: Expr): Bool {
  // A hash has no fields: `h.keys` is a new array.
  if recv.kind == ex_field() {
    if obj = recv.object, ot = checker_self.place_ty(obj), ot.is_hash() {
      return false
    }
  }
  if t = checker_self.place_ty(recv) {
    if t.is_hash() {
      return hash_mutator(name)
    }
    if !t.is_array() && recv.kind == ex_index() {
      if l = recv.left, lt = checker_self.place_ty(l), lt.is_hash() {
        return false
      }
    }
  }
  checker_self.array_mutator(name)
}

// The type of an Array name or of an element reached from one by
// indexing (`xs`, `xs[0]`), as the scope declares it; nil for any other
// expression. A zero-argument mutator written without parentheses
// (`xs.pop`, `xs.clear`, `xs.sort`, `xs.reverse`) is a field node, and
// this tells it from a struct field of the same name.
pub fn (checker_self: Checker) indexed_array_ty(expr: Expr): Ty? {
  if expr.kind == ex_name() {
    if checker_self.spawn_skip_has(expr.ident) {
      return nil
    }
    if ty = checker_self.lookup(expr.ident) {
      if ty.is_array() {
        return ty
      }
    }
    return nil
  }
  if expr.kind == ex_index() {
    if l = expr.left {
      if at = checker_self.indexed_array_ty(l) {
        if e = at.inner {
          if e.is_array() {
            return e
          }
        }
      }
    }
  }
  nil
}

// Whether a field node is an Array mutator written without parentheses.
pub fn (checker_self: Checker) field_mutates_array(expr: Expr): Bool {
  if expr.kind != ex_field() {
    return false
  }
  if obj = expr.object {
    if t = checker_self.place_ty(obj), t.is_hash() {
      return hash_mutator(expr.ident)
    }
    if !checker_self.array_mutator(expr.ident) {
      return false
    }
    if at = checker_self.indexed_array_ty(obj) {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) spawn_array_frozen(expr: Expr): Bool {
  root = checker_self.expr_root_name(expr)
  if root.size == 0 {
    return false
  }
  if checker_self.spawn_skip_has(root) {
    return false
  }
  if ty = checker_self.lookup(root) {
    return ty.is_array() || ty.is_hash()
  }
  false
}

pub fn (checker_self: Checker) pending_has_array(name: String): Bool {
  for pending_array in checker_self.pending_arrays {
    if pending_array == name {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) pending_join(handle: String) {
  kept_h: Array(String) = []
  kept_a: Array(String) = []
  for i in 0..checker_self.pending_handles.size {
    if checker_self.pending_handles[i] != handle {
      kept_h.push(checker_self.pending_handles[i])
      kept_a.push(checker_self.pending_arrays[i])
    }
  }
  checker_self.pending_handles = kept_h
  checker_self.pending_arrays = kept_a
}

pub fn (checker_self: Checker) scan_pending_stmt(stmt: Stmt) {
  for st in stmt.pre {
    checker_self.scan_pending_stmt(st)
  }
  if e = stmt.expr {
    checker_self.scan_pending_expr(e)
  }
  if c = stmt.cond {
    checker_self.scan_pending_expr(c)
  }
  if t = stmt.target {
    checker_self.scan_pending_target(t)
  }
  if v = stmt.value {
    checker_self.scan_pending_expr(v)
  }
  for st in stmt.then_body {
    checker_self.scan_pending_stmt(st)
  }
  for st in stmt.else_body {
    checker_self.scan_pending_stmt(st)
  }
  for st in stmt.body {
    checker_self.scan_pending_stmt(st)
  }
}

pub fn (checker_self: Checker) scan_pending_target(target: Expr) {
  if target.kind == ex_name() {
    if checker_self.pending_by_handler(target.ident) {
      // A lambda captures the variable itself: a new array assigned
      // here would reach the handler unfrozen.
      checker_self.fail(target.loc, "cannot assign ${target.ident}: an HTTP handler registered above captures it and reads it on each of the server's loop threads; the array it holds is read-only from the registration on, and a new one would not be")
    }
    return
  }
  root = checker_self.expr_root_name(target)
  if root.size > 0 && checker_self.pending_has_array(root) {
    checker_self.fail(target.loc, checker_self.pending_mutate_msg(root))
  }
  checker_self.scan_pending_expr(target)
}

// The handle an HTTP handler's captured Array is pending under: no
// name, so no join ends it; the array stays frozen from the handler's
// registration on.
pub fn handler_pending: String {
  "#http"
}

pub fn (checker_self: Checker) pending_by_handler(name: String): Bool {
  for i in 0..checker_self.pending_arrays.size {
    if checker_self.pending_arrays[i] == name && checker_self.pending_handles[i] == handler_pending() {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) pending_mutate_msg(root: String): String {
  if checker_self.pending_by_handler(root) {
    // A Hash, as an Array: frozen from the registration on.
    return "cannot mutate ${root}: an HTTP handler registered above reads it on each of the server's loop threads, and it is read-only from the registration on"
  }
  "cannot mutate ${root} while a spawn using it is running; join first"
}

// A walk's place (checker/places.av), named: an element of the array.
pub fn (checker_self: Checker) is_place_name(e: Expr): Bool {
  e.kind == ex_name() && checker_self.place_at(e.ident) >= 0
}

pub fn (checker_self: Checker) scan_pending_expr(expr: Expr) {
  k = expr.kind
  if k == ex_field() && checker_self.field_mutates_array(expr) {
    if obj = expr.object {
      root = checker_self.expr_root_name(obj)
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.fail(expr.loc, checker_self.pending_mutate_msg(root))
      }
    }
  }
  if k == ex_field() {
    // A method on an element of a pending array (`xs[0].bump`), told
    // from a field read once the program is checked.
    if obj = expr.object, obj.kind == ex_index() || obj.kind == ex_field() || checker_self.is_place_name(obj) {
      root = checker_self.expr_root_name(obj)
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.note_element_call(expr, obj, 2)
      }
    }
    if expr.ident == "join" {
      if obj = expr.object, obj.kind == ex_name() {
        checker_self.pending_join(obj.ident)
        return
      }
    }
  }
  if k == ex_call() {
    if expr.callee == "join" {
      if recv = expr.receiver, recv.kind == ex_name() {
        checker_self.pending_join(recv.ident)
      }
    }
    if recv = expr.receiver, checker_self.changes_frozen(expr.callee, recv) {
      root = checker_self.expr_root_name(recv)
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.fail(expr.loc, checker_self.pending_mutate_msg(root))
      }
    }
    if expr.args.size > 0 && verb_template_mutator(expr.callee) {
      root = checker_self.expr_root_name(expr.args[0])
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.fail(expr.loc, checker_self.pending_mutate_msg(root))
      }
    }
    if recv = expr.receiver, recv.kind == ex_index() || recv.kind == ex_field() || checker_self.is_place_name(recv) {
      root = checker_self.expr_root_name(recv)
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.note_element_call(expr, recv, 2)
      }
    }
  }
  if inner = expr.inner {
    checker_self.scan_pending_expr(inner)
  }
  if l = expr.left {
    checker_self.scan_pending_expr(l)
  }
  if r = expr.right {
    checker_self.scan_pending_expr(r)
  }
  if obj = expr.object {
    checker_self.scan_pending_expr(obj)
  }
  if recv = expr.receiver {
    checker_self.scan_pending_expr(recv)
  }
  for arg in expr.args {
    checker_self.scan_pending_expr(arg)
  }
  for elem in expr.elems {
    checker_self.scan_pending_expr(elem)
  }
  for field_expr in expr.field_exprs {
    checker_self.scan_pending_expr(field_expr)
  }
  if sz = expr.size_expr {
    checker_self.scan_pending_expr(sz)
  }
  if c = expr.cond {
    checker_self.scan_pending_expr(c)
  }
  if b = expr.block {
    for st in b.body {
      checker_self.scan_pending_stmt(st)
    }
  }
  for cs in expr.cases {
    for st in cs.body {
      checker_self.scan_pending_stmt(st)
    }
  }
  for st in expr.else_body {
    checker_self.scan_pending_stmt(st)
  }
  for part in expr.parts {
    if inner = part.expr {
      checker_self.scan_pending_expr(inner)
    }
  }
}

// One statement of any block, with the sender's rule around it: the
// statement is scanned for a mutation of an Array a running spawn
// captured, then checked, and a spawn it starts is running for the
// block's later statements. Every walk over a block's statements calls
// this, and scans a value's tail expression with scan_pending_expr (the
// arms of a switch, value blocks, an `if` used as a value and
// `?? return` called check_stmt directly, so a spawn started there was
// never recorded and a later `push` raced the task; the tails of those
// blocks and of a `with` body, and a binding chain's elements, were not
// scanned).
pub fn (checker_self: Checker) check_block_stmt(stmt: Stmt, expected: Ty, last: Bool) {
  follows = checker_self.facts.after_follows
  checker_self.facts.after_follows = false
  checker_self.scan_pending_stmt(stmt)
  mark = checker_self.facts.use_cont.size
  lw_mark = checker_self.facts.lam_written.size
  checker_self.check_stmt(stmt, expected, last)
  if !checker_self.has_err() {
    checker_self.register_spawn_pending(stmt)
    checker_self.shrinks_after_stmt(stmt, mark)
    if checker_self.facts.lam_written.size > lw_mark {
      checker_self.sweep_proofs(stmt, checker_self.facts.lam_written[lw_mark..])
    }
    if !follows {
      // A switch arm's, a value block's or a value branch's statement:
      // no fact_after_stmt follows, so what it assigns keeps no fact.
      checker_self.forget_assigned(stmt)
    }
  }
}

// The condition of an `if` used as a block's value: its branches go
// through check_block_stmt themselves.
pub fn (checker_self: Checker) scan_pending_if_head(stmt: Stmt) {
  for el in stmt.pre {
    checker_self.scan_pending_stmt(el)
  }
  if c = stmt.cond {
    checker_self.scan_pending_expr(c)
  }
}

pub fn (checker_self: Checker) register_spawn_pending(stmt: Stmt) {
  if stmt.kind == st_assign() {
    if v = stmt.value, v.kind == ex_call(), v.callee == "spawn" {
      handle = ""
      if t = stmt.target, t.kind == ex_name() {
        handle = t.ident
      }
      for i in 0..v.cap_names.size {
        if v.cap_tys[i].is_array() || v.cap_tys[i].is_hash() {
          checker_self.pending_handles.push(handle)
          checker_self.pending_arrays.push(v.cap_names[i])
        }
      }
      return
    }
  }
  if e = stmt.expr, e.kind == ex_call(), e.callee == "spawn" {
    for i in 0..e.cap_names.size {
      if e.cap_tys[i].is_array() || e.cap_tys[i].is_hash() {
        checker_self.pending_handles.push("")
        checker_self.pending_arrays.push(e.cap_names[i])
      }
    }
  }
}

pub fn (checker_self: Checker) note_spawn_capture(expr: Expr, node: Expr, seen: Hash(String, Int)) {
  if checker_self.spawn_skip_has(expr.ident) {
    return
  }
  if ty = checker_self.lookup(expr.ident) {
    if node.kind == ex_lambda() && checker_self.handler_shares(ty) {
      if ty.is_array() {
        if prev = seen.get(expr.ident) {
          return
        }
        seen[expr.ident] = 1
        node.cap_names.push(expr.ident)
        node.cap_tys.push(ty)
      }
      return
    }
    if ty.is_array() && !checker_self.copyable_for_spawn(ty) {
      leaf = checker_self.cross_leaf(ty)
      checker_self.fail(expr.loc, "${task_word(node)} cannot capture ${expr.ident}: an ${ty.show()} is shared with the ${task_whom(node)}, and its elements (${leaf.show()}) cannot cross to another ${task_unit(node)}: a mutable object reaches another ${task_unit(node)} only inside a Mutex")
      return
    }
    if ty.is_hash() && !checker_self.copyable_for_spawn(ty) {
      leaf = checker_self.cross_leaf(ty)
      checker_self.fail(expr.loc, "${task_word(node)} cannot capture ${expr.ident}: a ${ty.show()} is shared with the task, and its keys or values (${leaf.show()}) cannot cross to another task: a key must be a plain value, and a mutable object reaches another task only inside a Mutex")
      return
    }
    if !checker_self.copyable_for_spawn(ty) {
      if task_word(node) == "spawn" && ty.is_class() {
        if f = checker_self.current_fn {
          // A class's object moves into the task: the name is taken
          // as `Mutex(T).new` takes it, once the function is checked
          // (checker/guard.av check_consumes, guard_move_at), and its
          // class's methods keep nothing from outside
          // (check_guarded).
          if prev = seen.get(expr.ident) {
            return
          }
          seen[expr.ident] = 1
          checker_self.consumes.push(node)
          checker_self.consume_names.push(expr.ident)
          checker_self.consume_tys.push(ty)
          checker_self.consume_locs.push(expr.loc)
          checker_self.guarded.push(ty)
          checker_self.guarded_at.push(expr.loc)
          checker_self.guarded_by.push("spawn")
          node.cap_names.push(expr.ident)
          node.cap_tys.push(ty)
          return
        }
      }
      if node.kind == ex_lambda() {
        checker_self.fail(expr.loc, "${handler_word(node)} cannot capture ${expr.ident}: its type, ${ty.show()}, cannot cross to another thread, and ${handler_runs(node)}; numbers, Bool, String, Bytes, enums, structs of them, Arrays and Hashes of those (frozen once the handler is registered), a Channel, a Mutex and the Server can, and state the handlers change belongs in a Mutex")
        return
      }
      if ty_holds_ptr(ty) {
        checker_self.fail(expr.loc, "${task_word(node)} cannot capture ${expr.ident}: its type, ${ty.show()}, holds C memory, which crosses to another task only in the module whose lib block declares its C type (a layout or an opaque type; never Ptr(Void)), since whether C may use it from two threads is known there")
        return
      }
      checker_self.fail(expr.loc, "${task_word(node)} cannot capture ${expr.ident}: its type, ${ty.show()}, cannot cross to another task; numbers, Bool, String, Bytes, enums, structs of them and Arrays and Hashes of those can, and a mutable object reaches another task only inside a Mutex")
      return
    }
    if prev = seen.get(expr.ident) {
      return
    }
    seen[expr.ident] = 1
    checker_self.note_handles(ty, expr.loc, "${task_word(node)} cannot capture ${expr.ident}")
    node.cap_names.push(expr.ident)
    node.cap_tys.push(ty)
  }
}

// ---- A method that changes its receiver, on an element.
//
// A struct method gets its receiver's address, so `xs[0].bump` with `fn
// bump { self.n += 1 }` writes the element in xs's buffer, as `xs[0].n
// += 1` does. Where the receiver is an element of an Array a running
// task reads, through the captured name (in the task: walk_spawn_expr)
// or the pending one (in the sender: scan_pending_expr), the call is
// noted, and once the whole program is checked (every method body has
// its types) it is refused when the method changes its receiver
// (receiver_writes.av: an assignment to a place of self through struct
// fields, or such a call on one, at any depth). A call through any other
// path traps at run time (the freeze, mir/lower_agg.av
// lower_method_call).
// The side note_element_call records for a call inside node's block.
pub fn task_side(node: Expr): Int {
  if task_word(node) == "spawn" {
    return 1
  }
  3
}

pub fn (checker_self: Checker) note_element_call(expr: Expr, recv: Expr, side: Int) {
  checker_self.elem_calls.push(expr)
  checker_self.elem_roots.push(checker_self.expr_root_name(recv))
  checker_self.elem_sides.push(side)
}

pub fn (checker_self: Checker) check_element_writes {
  if checker_self.elem_calls.size == 0 || checker_self.any_err() {
    return
  }
  rw = ReceiverWrites.new()
  for ms in checker_self.methods {
    rw.add(ms.node)
  }
  for f in checker_self.pending {
    rw.add(f)
  }
  i = 0
  while i < checker_self.elem_calls.size {
    e = checker_self.elem_calls[i]
    root = checker_self.elem_roots[i]
    side = checker_self.elem_sides[i]
    i += 1
    recv: Expr? = nil
    if e.kind == ex_call() {
      recv = e.receiver
    } else if e.kind == ex_field() && e.method_call {
      recv = e.object
    }
    if r = recv, rt = r.ty, rt.is_struct(), e.resolved.size > 0, rw_element_place(r) {
      if rw.writes(e.resolved) {
        name = e.callee
        if e.kind == ex_field() {
          name = e.ident
        }
        if side == 1 {
          checker_self.fail(e.loc, "spawn cannot mutate captured Array ${root}: ${rt.show()}.${name} changes its receiver, an element of ${root}; it is read-only until join")
        } else if side == 3 {
          checker_self.fail(e.loc, ".parallel cannot mutate captured Array ${root}: ${rt.show()}.${name} changes its receiver, an element of ${root}; it is read-only while the bodies run")
        } else {
          checker_self.fail(e.loc, "cannot mutate ${root} while a spawn using it is running: ${rt.show()}.${name} changes its receiver, an element of ${root}; join first")
        }
        return
      }
    }
  }
}

// ---- What an HTTP handler captures.
//
// std.http runs one event loop per pool thread and calls the same
// handler closures from each, so a handler's captures are shared by
// several threads at once, as a task's are. A lambda given to a route
// method of std.http's Server is checked by spawn's rule: what it
// captures must cross (numbers, Bool, String, enums, structs of them, a
// Channel, a Mutex, Arrays of those), it cannot assign a captured
// variable, and it cannot change a captured Array, which is frozen when
// the handler is registered (mir/lower_agg.av) and stays so. The Server
// itself may be captured (a handler that stops or inspects it). A
// handler given as a function value is refused: what that value captures
// was never checked; a named function captures nothing.
// What a handler may capture beyond spawn's rule: the Server itself.
pub fn (checker_self: Checker) handler_shares(ty: Ty): Bool {
  checker_self.is_http_server(ty)
}

pub fn (checker_self: Checker) is_http_server(ty: Ty): Bool {
  ty.is_struct() && ty.mod_name == "std.http" && ty.name == "Server"
}

pub fn (checker_self: Checker) handler_method(name: String): Bool {
  name == "get" || name == "post" || name == "put" || name == "delete" || name == "patch" || name == "route" || name == "websocket" || name == "websocket_open" || name == "websocket_close" || name == "fallback" || name == "every" || name == "on_close"
}

pub fn (checker_self: Checker) check_handler_args(expr: Expr) {
  for arg in expr.args {
    if checker_self.has_err() {
      return
    }
    if arg.kind == ex_lambda() {
      checker_self.check_handler_lambda(arg, expr.callee)
    } else if at = arg.ty, at.is_fn() {
      if arg.kind == ex_name() && arg.fn_ref {
        continue
      }
      node = Expr.new(ex_lambda(), arg.loc)
      node.callee = expr.callee
      checker_self.fail(arg.loc, "${handler_word(node)} must be a lambda written at the call or a named function: ${handler_runs_fn(node)}, and what a function value captures is not checked")
    }
  }
}

pub fn (checker_self: Checker) check_handler_lambda(lam: Expr, method: String) {
  node = Expr.new(ex_lambda(), lam.loc)
  node.callee = method
  seen = Hash(String, Int).new()
  if b = lam.block {
    mark = checker_self.spawn_skip.size
    checker_self.spawn_skip.concat(b.params)
    checker_self.walk_spawn_stmts(b.body, node, seen)
    while checker_self.spawn_skip.size > mark {
      dropped = checker_self.spawn_skip.pop()
    }
  }
  if checker_self.has_err() {
    return
  }
  // A lambda in a method captures `self` without naming it.
  for i in 0..lam.cap_names.size {
    if lam.cap_names[i] == "self" && !checker_self.copyable_for_spawn(lam.cap_tys[i]) {
      checker_self.fail(lam.loc, "${handler_word(node)} cannot capture self: its type, ${lam.cap_tys[i].show()}, cannot cross to another thread, and ${handler_runs(node)}; state the handlers change belongs in a Mutex")
      return
    }
    if lam.cap_names[i] == "self" {
      checker_self.note_handles(lam.cap_tys[i], lam.loc, "${handler_word(node)} cannot capture self")
    }
  }
  for i in 0..node.cap_names.size {
    if node.cap_tys[i].is_array() || node.cap_tys[i].is_hash() {
      checker_self.pending_handles.push(handler_pending())
      checker_self.pending_arrays.push(node.cap_names[i])
    }
  }
}
