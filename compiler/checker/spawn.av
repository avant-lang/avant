import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import loader
import typed_ir
import checker.names
import checker
import receiver_writes

// std.sync's Channel and Mutex cross a task as shared handles: that
// is their purpose. A class of another module with one of those
// names is an ordinary class (before, any class named Channel or
// Mutex crossed).
pub fn (checker_self: Checker) is_share_ty(ty: Ty): Bool {
  checker_self.is_sync_ty(ty, "Channel") || checker_self.is_sync_ty(ty, "Mutex")
}

pub fn (checker_self: Checker) copyable_for_spawn(ty: Ty): Bool {
  if checker_self.is_share_ty(ty) {
    return true
  }
  // A captured Array is shared with the task, frozen until the task
  // ends, so its elements cross in turn: an Array of a class would put
  // one mutable object in two tasks with no lock (send's rule,
  // checker/guard.av send_crosses).
  if ty.is_array() {
    if e = ty.inner {
      return checker_self.copyable_for_spawn(e)
    }
    return false
  }
  checker_self.copyable_bits(ty)
}

pub fn (checker_self: Checker) copyable_bits(ty: Ty): Bool {
  if ty.is_integer() {
    return true
  }
  // An enum is a number.
  if ty.is_enum() {
    return true
  }
  if ty.is_uint64() {
    return true
  }
  if ty.is_bool() {
    return true
  }
  if ty.is_float() {
    return true
  }
  if ty.is_string() {
    return true
  }
  if ty.is_struct() {
    for field in ty.fields {
      if !checker_self.copyable_bits(field.ty) {
        return false
      }
    }
    return true
  }
  false
}

// What may leave a `Mutex.with` block as its value: spawn's rule for
// what crosses a task (a share type, or bits that hold no reference to
// mutable state), without the frozen array (that rule freezes a named
// array while a task is pending; a value has no name to freeze) and
// with what holds no mutable state either: `Bytes`, `nil`, and a union
// or a struct of such members. A class, an array, a hash, a `Buf`, a
// `fn` or a pointer may be the guarded object or a part of it: outside
// the block the lock no longer protects it.
pub fn (checker_self: Checker) leaves_mutex_with(ty: Ty): Bool {
  if checker_self.is_share_ty(ty) {
    return true
  }
  if ty.is_nil() || ty.is_bytes() {
    return true
  }
  if ty.is_union() {
    for m in ty.members {
      if !checker_self.leaves_mutex_with(m) {
        return false
      }
    }
    return true
  }
  if ty.is_struct() {
    for field in ty.fields {
      if !checker_self.leaves_mutex_with(field.ty) {
        return false
      }
    }
    return true
  }
  checker_self.copyable_bits(ty)
}

// The construct a capture message names: the user wrote a spawn block
// or an Array's `.parallel` block, and both are checked by the walk
// below (node is the spawn or the `.parallel` call).
pub fn task_word(node: Expr): String {
  if node.kind == ex_call() && node.callee == "parallel" {
    return ".parallel"
  }
  "spawn"
}

// Until when a captured Array is read-only, in node's words.
pub fn frozen_until(node: Expr): String {
  if node.kind == ex_call() && node.callee == "parallel" {
    return "read-only while the bodies run"
  }
  "read-only until join"
}

pub fn (checker_self: Checker) collect_spawn_captures(expr: Expr, body: Array(Stmt)) {
  seen = Hash(String, Int).new()
  checker_self.walk_spawn_stmts(body, expr, seen)
}

pub fn (checker_self: Checker) walk_spawn_stmts(body: Array(Stmt), node: Expr, seen: Hash(String, Int)) {
  i = 0
  while i < body.size {
    checker_self.walk_spawn_stmt(body[i], node, seen)
    i += 1
  }
}

pub fn (checker_self: Checker) walk_spawn_stmt(stmt: Stmt, node: Expr, seen: Hash(String, Int)) {
  k = stmt.kind
  if k == st_return() {
    if e = stmt.expr {
      checker_self.walk_spawn_expr(e, node, seen)
    }
    return
  }
  if k == st_if() {
    checker_self.walk_spawn_stmts(stmt.pre, node, seen)
    if c = stmt.cond {
      checker_self.walk_spawn_expr(c, node, seen)
    }
    checker_self.walk_spawn_stmts(stmt.then_body, node, seen)
    checker_self.walk_spawn_stmts(stmt.else_body, node, seen)
    return
  }
  if k == st_while() {
    checker_self.walk_spawn_stmts(stmt.pre, node, seen)
    if c = stmt.cond {
      checker_self.walk_spawn_expr(c, node, seen)
    }
    checker_self.walk_spawn_stmts(stmt.body, node, seen)
    return
  }
  if k == st_assign() {
    if target = stmt.target {
      if target.kind == ex_name() {
        if ty = checker_self.lookup(target.ident) {
          if task_word(node) == "spawn" {
            checker_self.fail(target.loc, "spawn cannot assign to ${target.ident}: the task has its own copy, made when it starts, and the copy is read-only; give the new value as the block's value and read it from join")
          } else {
            checker_self.fail(target.loc, ".parallel cannot assign to ${target.ident}: each body has its own copy, and the copy is read-only; give the new value as the body's value, which .parallel returns in its array")
          }
        }
      } else if checker_self.spawn_array_frozen(target) {
        root = checker_self.expr_root_name(target)
        checker_self.fail(target.loc, "${task_word(node)} cannot mutate captured Array ${root}; it is ${frozen_until(node)}")
        checker_self.walk_spawn_expr(target, node, seen)
      } else {
        checker_self.walk_spawn_expr(target, node, seen)
      }
    }
    if v = stmt.value {
      checker_self.walk_spawn_expr(v, node, seen)
    }
    return
  }
  if k == st_expr() {
    if e = stmt.expr {
      checker_self.walk_spawn_expr(e, node, seen)
    }
    return
  }
  if k == st_pin() || k == st_release() || k == st_hold() {
    // A `pin` block's value and body, and `release`'s place, are walked
    // like any statement's (before, a name used only there was not
    // captured, and the back end stopped with L0001).
    if e = stmt.expr {
      checker_self.walk_spawn_expr(e, node, seen)
    }
    checker_self.walk_spawn_stmts(stmt.body, node, seen)
  }
}

pub fn (checker_self: Checker) walk_spawn_expr(expr: Expr, node: Expr, seen: Hash(String, Int)) {
  k = expr.kind
  if k == ex_name() {
    checker_self.note_spawn_capture(expr, node, seen)
    return
  }
  if k == ex_call() {
    if inner = expr.inner {
      checker_self.walk_spawn_expr(inner, node, seen)
    }
    if expr.indirect && expr.callee.size > 0 {
      name = Expr.new(ex_name(), expr.loc)
      name.ident = expr.callee
      checker_self.note_spawn_capture(name, node, seen)
    }
    if recv = expr.receiver {
      if checker_self.array_mutator(expr.callee) && checker_self.spawn_array_frozen(recv) {
        root = checker_self.expr_root_name(recv)
        checker_self.fail(expr.loc, "${task_word(node)} cannot mutate captured Array ${root}; it is ${frozen_until(node)}")
      }
      if checker_self.spawn_array_frozen(recv) && rw_element_place(recv) {
        // A method on an element (`xs[0].bump`): refused once the
        // program is checked if it changes its receiver.
        checker_self.note_element_call(expr, recv, task_side(node))
      }
      checker_self.walk_spawn_expr(recv, node, seen)
    }
    for i in 0..expr.args.size {
      checker_self.walk_spawn_expr(expr.args[i], node, seen)
    }
    if b = expr.block {
      checker_self.walk_spawn_stmts(b.body, node, seen)
    }
    return
  }
  if k == ex_unary() {
    if inner = expr.inner {
      checker_self.walk_spawn_expr(inner, node, seen)
    }
    return
  }
  if k == ex_binary() {
    if l = expr.left {
      checker_self.walk_spawn_expr(l, node, seen)
    }
    if r = expr.right {
      checker_self.walk_spawn_expr(r, node, seen)
    }
    return
  }
  if k == ex_field() {
    if obj = expr.object {
      if checker_self.field_mutates_array(expr) && checker_self.spawn_array_frozen(obj) {
        root = checker_self.expr_root_name(obj)
        checker_self.fail(expr.loc, "${task_word(node)} cannot mutate captured Array ${root}; it is ${frozen_until(node)}")
      }
      if expr.method_call && checker_self.spawn_array_frozen(obj) && rw_element_place(obj) {
        checker_self.note_element_call(expr, obj, task_side(node))
      }
      checker_self.walk_spawn_expr(obj, node, seen)
    }
    return
  }
  if k == ex_index() {
    if l = expr.left {
      checker_self.walk_spawn_expr(l, node, seen)
    }
    if r = expr.right {
      checker_self.walk_spawn_expr(r, node, seen)
    }
    return
  }
  if k == ex_struct() {
    for i in 0..expr.field_exprs.size {
      checker_self.walk_spawn_expr(expr.field_exprs[i], node, seen)
    }
    return
  }
  if k == ex_array() {
    for i in 0..expr.elems.size {
      checker_self.walk_spawn_expr(expr.elems[i], node, seen)
    }
    return
  }
  if k == ex_array_new() {
    if size = expr.size_expr {
      checker_self.walk_spawn_expr(size, node, seen)
    }
    for fv in expr.elems {
      checker_self.walk_spawn_expr(fv, node, seen)
    }
    return
  }
  if k == ex_try() {
    if inner = expr.inner {
      checker_self.walk_spawn_expr(inner, node, seen)
    }
    return
  }
  if k == ex_interp() {
    for part in expr.parts {
      if inner = part.expr {
        checker_self.walk_spawn_expr(inner, node, seen)
      }
    }
    return
  }
  if k == ex_switch() {
    if c = expr.cond {
      checker_self.walk_spawn_expr(c, node, seen)
    }
    for i in 0..expr.cases.size {
      checker_self.walk_spawn_stmts(expr.cases[i].body, node, seen)
    }
    if expr.has_else {
      checker_self.walk_spawn_stmts(expr.else_body, node, seen)
    }
    return
  }
  if k == ex_lambda() {
    if b = expr.block {
      mark = checker_self.spawn_skip.size
      for param in b.params {
        checker_self.spawn_skip.push(param)
      }
      checker_self.walk_spawn_stmts(b.body, node, seen)
      while checker_self.spawn_skip.size > mark {
        dropped = checker_self.spawn_skip.pop()
      }
    }
  }
}

pub fn (checker_self: Checker) spawn_skip_has(name: String): Bool {
  for i in 0..checker_self.spawn_skip.size {
    if checker_self.spawn_skip[i] == name {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) expr_root_name(expr: Expr): String {
  k = expr.kind
  if k == ex_name() {
    // A walk's hidden array (checker/places.av) is the array it holds,
    // and a place, the element itself, is reached from it.
    if root = checker_self.place_roots.get(expr.ident) {
      return root
    }
    pi = checker_self.place_at(expr.ident)
    if pi >= 0 {
      if root2 = checker_self.place_roots.get(checker_self.place_arrs[pi]) {
        return root2
      }
    }
    return expr.ident
  }
  if k == ex_field() {
    if obj = expr.object {
      return checker_self.expr_root_name(obj)
    }
  }
  if k == ex_index() {
    if l = expr.left {
      return checker_self.expr_root_name(l)
    }
  }
  ""
}

pub fn (checker_self: Checker) array_mutator(name: String): Bool {
  if name == "push" {
    return true
  }
  if name == "pop" {
    return true
  }
  if name == "clear" {
    return true
  }
  if name == "fill" {
    return true
  }
  if name == "sort" {
    return true
  }
  if name == "reverse" {
    return true
  }
  name == "reserve"
}

// The type of an Array name or of an element reached from one by
// indexing (`xs`, `xs[0]`), as the scope declares it; nil for any other
// expression. A zero-argument mutator written without parentheses
// (`xs.pop`, `xs.clear`, `xs.sort`, `xs.reverse`) is a field node, and
// this tells it from a struct field of the same name.
pub fn (checker_self: Checker) indexed_array_ty(expr: Expr): Ty? {
  if expr.kind == ex_name() {
    if checker_self.spawn_skip_has(expr.ident) {
      return nil
    }
    if ty = checker_self.lookup(expr.ident) {
      if ty.is_array() {
        return ty
      }
    }
    return nil
  }
  if expr.kind == ex_index() {
    if l = expr.left {
      if at = checker_self.indexed_array_ty(l) {
        if e = at.inner {
          if e.is_array() {
            return e
          }
        }
      }
    }
  }
  nil
}

// Whether a field node is an Array mutator written without parentheses.
pub fn (checker_self: Checker) field_mutates_array(expr: Expr): Bool {
  if expr.kind != ex_field() || !checker_self.array_mutator(expr.ident) {
    return false
  }
  if obj = expr.object {
    if at = checker_self.indexed_array_ty(obj) {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) spawn_array_frozen(expr: Expr): Bool {
  root = checker_self.expr_root_name(expr)
  if root.size == 0 {
    return false
  }
  if checker_self.spawn_skip_has(root) {
    return false
  }
  if ty = checker_self.lookup(root) {
    return ty.is_array()
  }
  false
}

pub fn (checker_self: Checker) pending_has_array(name: String): Bool {
  for pending_array in checker_self.pending_arrays {
    if pending_array == name {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) pending_join(handle: String) {
  kept_h: Array(String) = []
  kept_a: Array(String) = []
  for i in 0..checker_self.pending_handles.size {
    if checker_self.pending_handles[i] != handle {
      kept_h.push(checker_self.pending_handles[i])
      kept_a.push(checker_self.pending_arrays[i])
    }
  }
  checker_self.pending_handles = kept_h
  checker_self.pending_arrays = kept_a
}

pub fn (checker_self: Checker) scan_pending_stmt(stmt: Stmt) {
  for st in stmt.pre {
    checker_self.scan_pending_stmt(st)
  }
  if e = stmt.expr {
    checker_self.scan_pending_expr(e)
  }
  if c = stmt.cond {
    checker_self.scan_pending_expr(c)
  }
  if t = stmt.target {
    checker_self.scan_pending_target(t)
  }
  if v = stmt.value {
    checker_self.scan_pending_expr(v)
  }
  for st in stmt.then_body {
    checker_self.scan_pending_stmt(st)
  }
  for st in stmt.else_body {
    checker_self.scan_pending_stmt(st)
  }
  for st in stmt.body {
    checker_self.scan_pending_stmt(st)
  }
}

pub fn (checker_self: Checker) scan_pending_target(target: Expr) {
  if target.kind == ex_name() {
    return
  }
  root = checker_self.expr_root_name(target)
  if root.size > 0 && checker_self.pending_has_array(root) {
    checker_self.fail(target.loc, "cannot mutate ${root} while a spawn using it is running; join first")
  }
  checker_self.scan_pending_expr(target)
}

// A walk's place (checker/places.av), named: an element of the array.
pub fn (checker_self: Checker) is_place_name(e: Expr): Bool {
  e.kind == ex_name() && checker_self.place_at(e.ident) >= 0
}

pub fn (checker_self: Checker) scan_pending_expr(expr: Expr) {
  k = expr.kind
  if k == ex_field() && checker_self.field_mutates_array(expr) {
    if obj = expr.object {
      root = checker_self.expr_root_name(obj)
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.fail(expr.loc, "cannot mutate ${root} while a spawn using it is running; join first")
      }
    }
  }
  if k == ex_field() {
    // A method on an element of a pending array (`xs[0].bump`), told
    // from a field read once the program is checked.
    if obj = expr.object, obj.kind == ex_index() || obj.kind == ex_field() || checker_self.is_place_name(obj) {
      root = checker_self.expr_root_name(obj)
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.note_element_call(expr, obj, 2)
      }
    }
    if expr.ident == "join" {
      if obj = expr.object, obj.kind == ex_name() {
        checker_self.pending_join(obj.ident)
        return
      }
    }
  }
  if k == ex_call() {
    if expr.callee == "join" {
      if recv = expr.receiver, recv.kind == ex_name() {
        checker_self.pending_join(recv.ident)
      }
    }
    if recv = expr.receiver, checker_self.array_mutator(expr.callee) {
      root = checker_self.expr_root_name(recv)
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.fail(expr.loc, "cannot mutate ${root} while a spawn using it is running; join first")
      }
    }
    if recv = expr.receiver, recv.kind == ex_index() || recv.kind == ex_field() || checker_self.is_place_name(recv) {
      root = checker_self.expr_root_name(recv)
      if root.size > 0 && checker_self.pending_has_array(root) {
        checker_self.note_element_call(expr, recv, 2)
      }
    }
  }
  if inner = expr.inner {
    checker_self.scan_pending_expr(inner)
  }
  if l = expr.left {
    checker_self.scan_pending_expr(l)
  }
  if r = expr.right {
    checker_self.scan_pending_expr(r)
  }
  if obj = expr.object {
    checker_self.scan_pending_expr(obj)
  }
  if recv = expr.receiver {
    checker_self.scan_pending_expr(recv)
  }
  for arg in expr.args {
    checker_self.scan_pending_expr(arg)
  }
  for elem in expr.elems {
    checker_self.scan_pending_expr(elem)
  }
  for field_expr in expr.field_exprs {
    checker_self.scan_pending_expr(field_expr)
  }
  if sz = expr.size_expr {
    checker_self.scan_pending_expr(sz)
  }
  if c = expr.cond {
    checker_self.scan_pending_expr(c)
  }
  if b = expr.block {
    for st in b.body {
      checker_self.scan_pending_stmt(st)
    }
  }
  for cs in expr.cases {
    for st in cs.body {
      checker_self.scan_pending_stmt(st)
    }
  }
  for st in expr.else_body {
    checker_self.scan_pending_stmt(st)
  }
  for part in expr.parts {
    if inner = part.expr {
      checker_self.scan_pending_expr(inner)
    }
  }
}

// One statement of any block, with the sender's rule around it: the
// statement is scanned for a mutation of an Array a running spawn
// captured, then checked, and a spawn it starts is running for the
// block's later statements. Every walk over a block's statements calls
// this, and scans a value's tail expression with scan_pending_expr (the
// arms of a switch, value blocks, an `if` used as a value and
// `?? return` called check_stmt directly, so a spawn started there was
// never recorded and a later `push` raced the task; the tails of those
// blocks and of a `with` body, and a binding chain's elements, were not
// scanned).
pub fn (checker_self: Checker) check_block_stmt(stmt: Stmt, expected: Ty, last: Bool) {
  checker_self.scan_pending_stmt(stmt)
  checker_self.check_stmt(stmt, expected, last)
  if !checker_self.has_err() {
    checker_self.register_spawn_pending(stmt)
  }
}

// The condition of an `if` used as a block's value: its branches go
// through check_block_stmt themselves.
pub fn (checker_self: Checker) scan_pending_if_head(stmt: Stmt) {
  for el in stmt.pre {
    checker_self.scan_pending_stmt(el)
  }
  if c = stmt.cond {
    checker_self.scan_pending_expr(c)
  }
}

pub fn (checker_self: Checker) register_spawn_pending(stmt: Stmt) {
  if stmt.kind == st_assign() {
    if v = stmt.value, v.kind == ex_call(), v.callee == "spawn" {
      handle = ""
      if t = stmt.target, t.kind == ex_name() {
        handle = t.ident
      }
      for i in 0..v.cap_names.size {
        if v.cap_tys[i].is_array() {
          checker_self.pending_handles.push(handle)
          checker_self.pending_arrays.push(v.cap_names[i])
        }
      }
      return
    }
  }
  if e = stmt.expr, e.kind == ex_call(), e.callee == "spawn" {
    for i in 0..e.cap_names.size {
      if e.cap_tys[i].is_array() {
        checker_self.pending_handles.push("")
        checker_self.pending_arrays.push(e.cap_names[i])
      }
    }
  }
}

pub fn (checker_self: Checker) note_spawn_capture(expr: Expr, node: Expr, seen: Hash(String, Int)) {
  if checker_self.spawn_skip_has(expr.ident) {
    return
  }
  if ty = checker_self.lookup(expr.ident) {
    if ty.is_array() && !checker_self.copyable_for_spawn(ty) {
      leaf = ty
      while leaf.is_array() {
        if e = leaf.inner {
          leaf = e
        } else {
          break
        }
      }
      checker_self.fail(expr.loc, "${task_word(node)} cannot capture ${expr.ident}: an ${ty.show()} is shared with the task, and its elements (${leaf.show()}) cannot cross to another task: a mutable object reaches another task only inside a Mutex")
      return
    }
    if !checker_self.copyable_for_spawn(ty) {
      checker_self.fail(expr.loc, "${task_word(node)} cannot capture ${expr.ident}: its type, ${ty.show()}, cannot cross to another task; numbers, Bool, String, enums, structs of them and Arrays of those can, and a mutable object reaches another task only inside a Mutex")
      return
    }
    if prev = seen.get(expr.ident) {
      return
    }
    seen[expr.ident] = 1
    node.cap_names.push(expr.ident)
    node.cap_tys.push(ty)
  }
}

// ---- A method that changes its receiver, on an element.
//
// A struct method gets its receiver's address, so `xs[0].bump` with `fn
// bump { self.n += 1 }` writes the element in xs's buffer, as `xs[0].n
// += 1` does. Where the receiver is an element of an Array a running
// task reads, through the captured name (in the task: walk_spawn_expr)
// or the pending one (in the sender: scan_pending_expr), the call is
// noted, and once the whole program is checked (every method body has
// its types) it is refused when the method changes its receiver
// (receiver_writes.av: an assignment to a place of self through struct
// fields, or such a call on one, at any depth). A call through any other
// path traps at run time (the freeze, mir/lower_agg.av
// lower_method_call).
// The side note_element_call records for a call inside node's block.
pub fn task_side(node: Expr): Int {
  if task_word(node) == "spawn" {
    return 1
  }
  3
}

pub fn (checker_self: Checker) note_element_call(expr: Expr, recv: Expr, side: Int) {
  checker_self.elem_calls.push(expr)
  checker_self.elem_roots.push(checker_self.expr_root_name(recv))
  checker_self.elem_sides.push(side)
}

pub fn (checker_self: Checker) check_element_writes {
  if checker_self.elem_calls.size == 0 || checker_self.any_err() {
    return
  }
  rw = ReceiverWrites.new()
  for ms in checker_self.methods {
    rw.add(ms.node)
  }
  for f in checker_self.pending {
    rw.add(f)
  }
  i = 0
  while i < checker_self.elem_calls.size {
    e = checker_self.elem_calls[i]
    root = checker_self.elem_roots[i]
    side = checker_self.elem_sides[i]
    i += 1
    recv: Expr? = nil
    if e.kind == ex_call() {
      recv = e.receiver
    } else if e.kind == ex_field() && e.method_call {
      recv = e.object
    }
    if r = recv, rt = r.ty, rt.is_struct(), e.resolved.size > 0, rw_element_place(r) {
      if rw.writes(e.resolved) {
        name = e.callee
        if e.kind == ex_field() {
          name = e.ident
        }
        if side == 1 {
          checker_self.fail(e.loc, "spawn cannot mutate captured Array ${root}: ${rt.show()}.${name} changes its receiver, an element of ${root}; it is read-only until join")
        } else if side == 3 {
          checker_self.fail(e.loc, ".parallel cannot mutate captured Array ${root}: ${rt.show()}.${name} changes its receiver, an element of ${root}; it is read-only while the bodies run")
        } else {
          checker_self.fail(e.loc, "cannot mutate ${root} while a spawn using it is running: ${rt.show()}.${name} changes its receiver, an element of ${root}; join first")
        }
        return
      }
    }
  }
}
