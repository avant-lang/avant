// The receiver inside a method. A field is written `self.name = ...`: a
// bare `name = ...` where `name` is a field of the receiver (no local of
// that name) is refused, naming both ways out. A bare name resolves, in
// order: a local or parameter; a field of the receiver (read); a method
// of the receiver (call); a function of the module or the prelude. A bare
// call that fits both a method of the receiver and a function is refused,
// naming `self.name(...)` and the function's qualified form: nothing wins
// silently.

import location
import source
import token
import type
import ast
import resolve
import typed_ir
import checker.names
import checker

// The prelude's free functions (checker.av check_call and the builtin
// helpers it calls), which a method of the same name would shadow.
pub fn prelude_call_name(name: String): Bool {
  names = ["argv", "buf_new", "bytes_to_str", "checksum_f64", "checksum_str", "chr", "crc32_bytes", "env_get", "eprint", "eputs", "exit", "exp", "file_exists", "fmt_float", "hash_last_key", "join", "now_ms", "now_us", "print", "puts", "puts_u", "repeat_byte", "sha256", "sha256_word0", "spawn", "sqrt", "str_slice", "str_to_f_slice", "wide_hi", "wide_op"]
  for n in names {
    if n == name {
      return true
    }
  }
  false
}

// The receiver's type when the body is a method of a type the program
// declares, inherent or external (its fields and methods are in scope
// bare, the receiver named self or as the external method names it),
// else nil.
pub fn (checker_self: Checker) bare_receiver: Ty? {
  checker_self.self_ty
}

// Whether the receiver type st has an instance method name taking argc
// arguments.
pub fn (checker_self: Checker) receiver_method_fits(st: Ty, name: String, argc: Int): Bool {
  owner = st.name
  named = checker_self.method_indices_named(name)
  for x in 0..named.size {
    sig = checker_self.methods[named[x]]
    if !sig.node.type_method && sig.owner == owner && sig.name == name && arity_ok(sig.node, argc) {
      if st.mod_name.size == 0 || sig.node.owner_mod.size == 0 || sig.node.owner_mod == st.mod_name {
        return true
      }
    }
  }
  false
}

// Whether a function the current module sees is named name and takes
// argc arguments (a prelude function counts by name).
pub fn (checker_self: Checker) free_fn_fits(name: String, argc: Int): Bool {
  if prelude_call_name(name) {
    return true
  }
  named = checker_self.fn_indices_named(name)
  for x in 0..named.size {
    sig = checker_self.functions[named[x]]
    if sig.name == name && checker_self.fn_is_visible(sig.node, checker_self.current_module) && arity_ok(sig.node, argc) {
      return true
    }
  }
  false
}

// A bare call `name(args)` (or a bare `name` in field form, argc 0) in a
// method: the receiver's method when one fits, made `self.name(args)`;
// an error when a function fits too; nil when no method fits (the call
// is a function's).
pub fn (checker_self: Checker) bare_method_call(expr: Expr, name: String, argc: Int): Expr? {
  if st = checker_self.bare_receiver() {
    if !checker_self.receiver_method_fits(st, name, argc) {
      return nil
    }
    if checker_self.free_fn_fits(name, argc) {
      checker_self.fail(expr.loc, "${name} is both a method of ${st.show()} and a function; write ${checker_self.self_name}.${name}(...) for the method, or qualify the function (module.${name}(...))")
      return nil
    }
    r = Expr.new(ex_name(), expr.loc)
    r.ident = checker_self.self_name
    return r
  }
  nil
}

// A bare `name = ...` (or `name += ...`) where name is a field of the
// receiver and no local.
pub fn (checker_self: Checker) refuse_bare_field_write(target: Expr, loc: Location) {
  owner = "the receiver"
  if st = checker_self.self_ty {
    owner = st.show()
  }
  checker_self.fail(target.loc, "${target.ident} is a field of ${owner}; write ${checker_self.self_name}.${target.ident} = ... to change the field, or choose another name for a local")
}

// self inside a lambda of an inherent method: every enclosing lambda
// captures it, by value, since self is never reassigned (a class
// receiver's reference, a struct receiver's copy); the receiver's
// type, or nil after refusing (an external method's receiver may be
// reassigned, so it is not captured this way).
pub fn (checker_self: Checker) capture_receiver(loc: Location): Ty? {
  if checker_self.self_name != "self" {
    checker_self.fail(loc, "a lambda cannot capture the receiver ${checker_self.self_name} of an external method; copy it into a local first")
    return nil
  }
  st = checker_self.t_int()
  if got = checker_self.lookup("self") {
    st = got
  } else if s2 = checker_self.self_ty {
    st = s2
  } else {
    checker_self.fail(loc, "self is only valid in a method")
    return nil
  }
  for lam in checker_self.lam_exprs {
    seen = false
    for n in lam.cap_names {
      if n == "self" {
        seen = true
      }
    }
    if !seen {
      lam.cap_names.push("self")
      lam.cap_tys.push(st)
    }
  }
  st
}

// A write through self (self.f = ..., self.s.f += ...) inside a lambda of
// a struct method: the lambda holds a copy of the receiver, so the write
// would change only the copy; refused.
pub fn (checker_self: Checker) refuse_copy_write(target: Expr, loc: Location) {
  if checker_self.lam_exprs.size == 0 {
    return
  }
  if st = checker_self.self_ty {
    if !st.is_struct() {
      return
    }
  } else {
    return
  }
  cur = target
  done = false
  while !done {
    if cur.kind == ex_field() || cur.kind == ex_index() {
      if o = cur.object {
        cur = o
      } else if l = cur.left {
        cur = l
      } else {
        done = true
      }
    } else {
      done = true
    }
  }
  if cur.kind == ex_name() && cur.ident == "self" {
    checker_self.fail(loc, "a lambda holds a copy of the struct receiver, so this write would change only the copy; write the field outside the lambda, or make the type a class")
  }
}

// A `for` loop's variable. The loop is a `while` over a hidden counter: a
// range's variable is that counter, an array's variable is a copy of the
// element, stored again at each step. The parser marks the loop's own
// stores (for_kind 3 and 4); note_for_var records each one's target with
// the scope that holds it, so a name the body binds anew (an if-assign, a
// block parameter) is not taken for the loop's.
pub fn (checker_self: Checker) note_for_var(name: String, kind: Int) {
  at = checker_self.lookup_index(name)
  for i in 0..checker_self.for_names.size {
    if checker_self.for_scopes[i] == at && checker_self.for_names[i] == name {
      return
    }
  }
  checker_self.for_names.push(name)
  checker_self.for_scopes.push(at)
  checker_self.for_kinds.push(kind)
}

// 3 or 4 when `name` is, here, a for variable; else 0.
pub fn (checker_self: Checker) for_var_kind(name: String): Int {
  if checker_self.for_names.size == 0 {
    return 0
  }
  at = checker_self.lookup_index(name)
  i = checker_self.for_names.size - 1
  while i >= 0 {
    if checker_self.for_scopes[i] == at && checker_self.for_names[i] == name {
      return checker_self.for_kinds[i]
    }
    i -= 1
  }
  0
}

// The place `name` is, here, or -1.
pub fn (checker_self: Checker) place_at(name: String): Int {
  if checker_self.place_names.size == 0 {
    return -1
  }
  at = checker_self.lookup_index(name)
  i = checker_self.place_names.size - 1
  while i >= 0 {
    if checker_self.place_scopes[i] == at && checker_self.place_names[i] == name {
      return i
    }
    i -= 1
  }
  -1
}

// What a copy parameter is, for its messages: kind 7 a comparator's, 8
// a Hash walk's, 9 a `.parallel` body's.
pub fn copy_param_what(name: String, kind: Int): String {
  if kind == 7 {
    return "${name} is a comparator's parameter, a copy of an element being compared: a comparator only compares"
  }
  if kind == 8 {
    return "${name} is a copy of the entry (a struct is a value), so the Hash would not change; change a copy and store it back with its key (q = ${name}, then h[key] = q)"
  }
  "${name} is a .parallel body's copy of its element, so the array would not change; return the new element from the body (ys = xs.parallel { |e| ... })"
}

// `p.pos.x` for a target made of a name and fields; "" for anything else.
pub fn (checker_self: Checker) field_path_text(e: Expr): String {
  if e.kind == ex_name() {
    return e.ident
  }
  if e.kind == ex_field() {
    if o = e.object {
      head = checker_self.field_path_text(o)
      if head.size > 0 {
        return "${head}.${e.ident}"
      }
    }
  }
  ""
}

// The program assigns a for variable (`x = ...`, `x += ...`): the write
// would change the loop's copy and be lost, or, on a range's counter,
// change the iteration. Refused, with what works. True when it failed.
pub fn (checker_self: Checker) refuse_for_assign(stmt: Stmt): Bool {
  if checker_self.for_names.size == 0 {
    return false
  }
  if target = stmt.target, target.kind == ex_name() {
    kind = checker_self.for_var_kind(target.ident)
    if kind == 3 {
      checker_self.fail(stmt.loc, "cannot assign to ${target.ident}: a for variable is a copy of the range's counter, set again at each step; to skip or repeat steps, use a while loop with a counter of its own")
      return true
    }
    n = target.ident
    if kind == 4 {
      checker_self.fail(stmt.loc, "cannot assign to ${n}: a for variable is a copy of the element, so the array would not change; store through an index (for i in 0..xs.size { xs[i] = ... })")
      return true
    }
    if kind == 6 {
      checker_self.fail(stmt.loc, "cannot assign to ${n}: a block parameter of each, any or all is a copy of the element, so the array would not change; store through an index (for i in 0..xs.size { xs[i] = ... })")
      return true
    }
    if kind == 8 {
      checker_self.fail(stmt.loc, "cannot assign to ${n}: a Hash walk's parameters are copies of the entry's key and value, so the Hash would not change; store through the key (h[key] = ...)")
      return true
    }
    if kind >= 7 {
      checker_self.fail(stmt.loc, "cannot assign to ${n}: ${copy_param_what(n, kind)}")
      return true
    }
  }
  false
}

// The program assigns a field of a for variable through struct values
// only (`p.x = 1`, `p.pos.x += 1`; the target is checked, so every part
// has its type): the write lands in the loop's copy. Refused, with what
// works. A field of a class element changes the object and is not
// refused; neither is a path that passes through a reference (a class,
// a pointer) or an index. True when it failed.
pub fn (checker_self: Checker) refuse_for_field_write(target: Expr, loc: Location): Bool {
  if checker_self.for_names.size == 0 || target.kind != ex_field() {
    return false
  }
  cur = target
  while cur.kind == ex_field() {
    if o = cur.object {
      if ot = o.ty {
        if !ot.is_struct() {
          return false
        }
      } else {
        return false
      }
      cur = o
    } else {
      return false
    }
  }
  if cur.kind != ex_name() {
    return false
  }
  kind = checker_self.for_var_kind(cur.ident)
  if kind < 7 {
    // A for variable or a walk's parameter over an Array of structs is
    // the element itself (checker/places.av): its uses are indexes by
    // now, and a class element's field changes the object.
    return false
  }
  path = checker_self.field_path_text(target)
  checker_self.fail(loc, "cannot assign to ${path}: ${copy_param_what(cur.ident, kind)}")
  true
}
