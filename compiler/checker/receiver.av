// The receiver inside a method (Stage 29 W3b, B6, D292). A field is
// written `self.name = ...`: a bare `name = ...` where `name` is a field
// of the receiver (no local of that name) is refused, naming both ways
// out. A bare name resolves, in order: a local or parameter; a field of
// the receiver (read); a method of the receiver (call); a function of the
// module or the prelude. A bare call that fits both a method of the
// receiver and a function is refused, naming `self.name(...)` and the
// function's qualified form: nothing wins silently (D308's rule).

import location
import source
import token
import type
import ast
import resolve
import typed_ir
import checker.names
import checker

// The prelude's free functions (checker.av check_call and the builtin
// helpers it calls), which a method of the same name would shadow.
pub fn prelude_call_name(name: String): Bool {
  names = ["argv", "buf_new", "bytes_to_str", "checksum_f64", "checksum_str", "chr", "crc32_bytes", "dir_list", "env_get", "exp", "file_exists", "file_read", "file_write", "fmt_float", "hash_last_key", "join", "now_ms", "now_us", "process_run", "process_run_out", "puts", "puts_u", "repeat_byte", "sha256", "sha256_word0", "spawn", "sqrt", "str_slice", "str_to_f_slice", "wide_hi", "wide_op"]
  for n in names {
    if n == name {
      return true
    }
  }
  false
}

// The receiver's type when the body is an inherent method's (self is
// the receiver and its fields are in scope), else nil.
pub fn (checker_self: Checker) bare_receiver: Ty? {
  if checker_self.self_name != "self" {
    return nil
  }
  checker_self.self_ty
}

// Whether the receiver type st has an instance method name taking argc
// arguments.
pub fn (checker_self: Checker) receiver_method_fits(st: Ty, name: String, argc: Int): Bool {
  owner = st.name
  named = checker_self.method_indices_named(name)
  for x in 0..named.size {
    sig = checker_self.methods[named[x]]
    if !sig.node.type_method && sig.owner == owner && sig.name == name && arity_ok(sig.node, argc) {
      if st.mod_name.size == 0 || sig.node.owner_mod.size == 0 || sig.node.owner_mod == st.mod_name {
        return true
      }
    }
  }
  false
}

// Whether a function the current module sees is named name and takes
// argc arguments (a prelude function counts by name).
pub fn (checker_self: Checker) free_fn_fits(name: String, argc: Int): Bool {
  if prelude_call_name(name) {
    return true
  }
  named = checker_self.fn_indices_named(name)
  for x in 0..named.size {
    sig = checker_self.functions[named[x]]
    if sig.name == name && checker_self.fn_is_visible(sig.node, checker_self.current_module) && arity_ok(sig.node, argc) {
      return true
    }
  }
  false
}

// A bare call `name(args)` (or a bare `name` in field form, argc 0) in a
// method: the receiver's method when one fits, made `self.name(args)`;
// an error when a function fits too; nil when no method fits (the call
// is a function's).
pub fn (checker_self: Checker) bare_method_call(expr: Expr, name: String, argc: Int): Expr? {
  if st = checker_self.bare_receiver {
    if !checker_self.receiver_method_fits(st, name, argc) {
      return nil
    }
    if checker_self.free_fn_fits(name, argc) {
      checker_self.fail(expr.loc, "${name} is both a method of ${st.show} and a function; write self.${name}(...) for the method, or qualify the function (module.${name}(...))")
      return nil
    }
    r = Expr.new(ex_name(), expr.loc)
    r.ident = "self"
    return r
  }
  nil
}

// A bare `name = ...` (or `name += ...`) where name is a field of the
// receiver and no local.
pub fn (checker_self: Checker) refuse_bare_field_write(target: Expr, loc: Location) {
  owner = "the receiver"
  if st = checker_self.self_ty {
    owner = st.show
  }
  checker_self.fail(target.loc, "${target.ident} is a field of ${owner}; write self.${target.ident} = ... to change the field, or choose another name for a local")
}
