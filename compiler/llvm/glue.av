// The compiler's in-process LLVM (Stage 28, D162, D172): the binding of
// runtime/avant_llvm.c, which tools/build-llvm.sh merges with LLVM 20 into
// runtime/build/avant_llvm.o. Only the compiler links that object (the
// letters pass it to `compile compiler/main.av`); a user program never
// does. Internal; no prelude name (D132).

import source

// Its integers are Int (C int64_t) on both sides (Stage 29 W-INT1): the
// seed's `Int` is 32-bit and B's is 64-bit, and both link this one object.
lib avant_llvm {
  fun avant_llvm_init: Int
  fun avant_llvm_compile_file(ll_path: String, passes: String, level: Int, obj_path: String): Int
  fun avant_llvm_compile_text(text: String, name: String, passes: String, level: Int, obj_path: String): Int
  fun avant_llvm_error: String
  fun avant_llvm_version: String
  fun avant_llvm_f64_text(bits: Int): String
  fun avant_llvm_host_level: Int
  fun avant_llvm_set_cpu(level: Int): Int
}

// The codegen modes (D174), one table: the new-pass-manager pipeline and
// the codegen optimization level (0 None, which lets LLVM pick FastISel;
// 2 Default; 3 Aggressive). The keys are the compiler's codegen names
// (verb_codegen): "debug" (--debug), "default" (compile's bare mode),
// "release" (--release).
pub fn llvm_mode_passes(codegen: String): String {
  if codegen == "release" {
    return "default<O3>"
  }
  if codegen == "default" {
    return "mem2reg,sccp,dce,simplifycfg"
  }
  "default<O0>"
}

pub fn llvm_mode_level(codegen: String): Int {
  if codegen == "release" {
    return 3
  }
  if codegen == "default" {
    return 2
  }
  0
}

// The status codes of runtime/avant_llvm.c, named for a diagnostic.
pub fn llvm_status_name(code: Int): String {
  if code == 1 {
    return "target"
  }
  if code == 2 {
    return "parse"
  }
  if code == 3 {
    return "verify"
  }
  if code == 4 {
    return "passes"
  }
  if code == 5 {
    return "emit"
  }
  "status ${code}"
}

fn llvm_result(code: Int, label: String): String {
  if code == 0 {
    return ""
  }
  "LLVM ${llvm_status_name(code)} failed for ${label}: ${avant_llvm.avant_llvm_error()}"
}

// Compiles the textual IR file ll_path to the object obj_path in the
// codegen mode `codegen`: parse, verify, the mode's pipeline, emit. Returns
// "" on success, else the message for a diagnostic.
pub fn llvm_compile_file(ll_path: String, codegen: String, obj_path: String): String {
  code = avant_llvm.avant_llvm_compile_file(ll_path, llvm_mode_passes(codegen), llvm_mode_level(codegen).to_i, obj_path)
  llvm_result(code.to_i, ll_path)
}

// The same from IR text in memory; name labels it in messages.
pub fn llvm_compile_text(text: String, name: String, codegen: String, obj_path: String): String {
  code = avant_llvm.avant_llvm_compile_text(text, name, llvm_mode_passes(codegen), llvm_mode_level(codegen).to_i, obj_path)
  llvm_result(code.to_i, name)
}

// The linked LLVM's version ("20.1.8").
pub fn llvm_version: String {
  avant_llvm.avant_llvm_version()
}

// A double constant's IR text from its bits (O141): a shortest round-trip
// decimal, or a bitcast of the bits for a NaN or an infinity.
pub fn llvm_f64_text(bits: Int): String {
  avant_llvm.avant_llvm_f64_text(bits)
}

// The CPU levels of generated code (Stage 28 W18S, O140): 1 x86-64 itself
// (`--cpu=baseline`), 2-4 x86-64-v2 to v4, 5 the compiling machine's CPU
// (`--cpu=native`). Only LLVM's target machine sees the choice
// (runtime/avant_llvm.c); every program records it and checks it at
// startup. Local runs (`avant run`, `avant test`'s programs) take the
// machine's highest level; an artifact (`avant compile`, `--release`)
// takes llvm_cpu_default: x86-64-v2, chosen by measurement (W18S,
// records/2026-11-10-s28-w18s/la): v3 over v2 is -2.9% instructions but
// only -1.6% task time on LangArena (-0.4% without the threaded Matmul
// rows), all of it in a few vectorizable rows (Matmul::Single -15%,
// Spectralnorm -5%, Huffman decode -4%) with others slower by layout, and
// it would refuse every CPU before AVX2; v2 costs nothing against plain
// x86-64. --cpu=v3 is the opt-in.
pub fn llvm_cpu_default: Int {
  2
}

pub fn llvm_host_level: Int {
  avant_llvm.avant_llvm_host_level().to_i
}

// The level a --cpu value names, or 0.
pub fn llvm_cpu_parse(v: String): Int {
  if v == "baseline" {
    return 1
  }
  if v == "v2" {
    return 2
  }
  if v == "v3" {
    return 3
  }
  if v == "v4" {
    return 4
  }
  if v == "native" {
    return 5
  }
  0
}

// The --cpu value of a level (baseline, v2, v3, v4, native).
pub fn llvm_cpu_name(level: Int): String {
  if level == 1 {
    return "baseline"
  }
  if level == 5 {
    return "native"
  }
  "v${level}"
}

pub fn llvm_set_cpu(level: Int) {
  dummy = avant_llvm.avant_llvm_set_cpu(level.to_i)
}
