// The LLVM emitter: a verified, final-stage MIR module to the textual
// .ll the in-process LLVM compiles (compiler/llvm/glue.av). The text is
// deterministic (only the MIR's own numbers and names, in module order)
// and the same in every codegen mode (the mode selects only the glue's
// pipeline).
//
// Module order: header, layouts, string constants, the
// allocation globals (when an inline allocation was emitted), the
// declarations (externals and the runtime entry points the emitter calls,
// sorted by name, then the intrinsics), the functions in module order,
// __avant_type_maps, the attribute group. Every defined function carries
// #0; Avant functions are internal and mangled, `main` is
// external.
//
// The core (state, places, operands) is emit_core.av; the GC sequences
// are emit_gc.av.

import source
import mir.types
import mir.runtime
import mir.ir
import mir.print
import llvm.emit_core
import llvm.emit_gc
import llvm.emit_cabi

pub fn ll_datalayout: String {
  "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
}

pub fn ll_triple: String {
  "x86_64-pc-linux-gnu"
}

// The .ll text of a module that verified at stage final. inline_fast
// false emits the call forms of allocation and the barrier.
pub fn ll_emit_module(m: MModule, inline_fast: Bool): String {
  e = LlEmit.new(m)
  e.inline_fast = inline_fast
  if m.globals.size > 0 {
    ll_const_facts(e)
  }
  i = 0
  while i < m.funcs.size {
    ll_function(e, m.funcs[i])
    i += 1
  }
  body = e.out.to_s()
  e.out = buf_new()
  ll_type_maps(e)
  if e.used_frame_helpers {
    ll_gc_frame_helpers(e)
  }
  if e.used_alloc_slow {
    ll_alloc_slow_helper(e)
  }
  maps = e.out.to_s()

  out = buf_new()
  out.push_str("source_filename = \"${m.name}\"\n")
  out.push_str("target datalayout = \"${ll_datalayout()}\"\n")
  out.push_str("target triple = \"${ll_triple()}\"\n")
  out.push_str("\n")
  ll_layouts(e, out)
  if m.strs.size > 0 {
    for i2 in 0..m.strs.size {
      s = m.strs[i2]
      // A literal is a static string object: the runtime's header (its
      // size the bytes and the terminator, the string tag, no heap flag)
      // and then the bytes, so its length is a header read like every
      // heap string's; the value is the address of the bytes.
      out.push_str("@str.${i2} = private constant { i64, [${s.size + 1} x i8] } { i64 ${ll_str_header(s.size)}, [${s.size + 1} x i8] c\"${mir_escape(s)}\\00\" }, align 8\n")
    }
    out.push_str("\n")
  }
  if e.frame_maps.size > 0 {
    // The frame records' maps too wide for an inline desc
    // (ll_gc_frame_layout).
    for t in e.frame_maps {
      out.push_str(t)
      out.push_str("\n")
    }
    out.push_str("\n")
  }
  if m.globals.size > 0 {
    // The slots of the constants computed before main: written once by
    // the start-up, read by every use.
    for g in m.globals {
      al = e.ts.align_of(g.ty)
      if al < 8 {
        al = 8
      }
      out.push_str("${ll_sym(g.symbol)} = internal global ${ll_type_text(e.ts, g.ty)} zeroinitializer, align ${al}\n")
    }
    out.push_str("\n")
  }
  if e.used_str_nil {
    out.push_str("@str.nil = private constant { i64, [1 x i8] } { i64 ${ll_str_header(0)}, [1 x i8] zeroinitializer }, align 8\n\n")
  }
  if e.tlocs.size > 0 {
    // The trap sites: their texts, and the table the runtime reads through
    // its weak reference, indexed by a trap's last argument.
    for ix in 0..e.tlocs.size {
      t = e.tlocs[ix]
      out.push_str("@tl.${ix} = private unnamed_addr constant [${t.size + 1} x i8] c\"${mir_escape(t)}\\00\", align 1\n")
    }
    out.push_str("@__avant_trap_sites = constant [${e.tlocs.size} x ptr] [")
    for j in 0..e.tlocs.size {
      if j > 0 {
        out.push_str(", ")
      }
      out.push_str("ptr @tl.${j}")
    }
    out.push_str("]\n\n")
  }
  if e.used_alloc_globals {
    out.push_str(ll_alloc_globals(m.shared))
    out.push_str("\n")
  }
  if e.used_poll_global {
    out.push_str("@avant_gc_requested = external global i32\n\n")
  }
  if e.used_frame_global {
    // local-exec: a program is an executable that links avant_rt.o, so
    // the frame chain's head is one %fs-relative access.
    out.push_str("@avant_gc_top = external thread_local(localexec) global ptr\n\n")
  }
  ll_declarations(e, out)
  out.push_str("\n")
  out.push_str(body)
  out.push_str(maps)
  // Every function probes its stack: a frame larger than a page
  // touches each page it takes, so a stack overflow faults in the
  // guard page and never steps over it into whatever is mapped below
  // (a pool thread's guard is one 4 KB page). LLVM emits the probe
  // only for a frame over 4,096 bytes: no LangArena task has one
  // (their binaries are byte-identical), and the compiler's own build
  // runs 0.011% more instructions.
  out.push_str("attributes #0 = { nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\" }\n")
  if e.used_stubs {
    out.push_str("attributes #1 = { cold noinline noreturn nounwind \"frame-pointer\"=\"all\" \"probe-stack\"=\"inline-asm\" }\n")
  }
  ll_loop_md(e, out)
  out.to_s()
}

// The layouts as named LLVM struct types, in creation order. An element
// buffer `%elems(E)` has no LLVM type of its own: it is only indexed, by
// the element type (E5).
fn ll_layouts(e: LlEmit, out: Buf) {
  n = 0
  // C's arrays (`T name[N]`) first: an array type is no struct, so a
  // struct that holds one may not name it before its definition.
  for l in e.ts.layouts {
    if l.kind == mlk_carray() {
      out.push_str("${ll_type_name(l.name)} = type [${l.fields.size} x ${e.llt(l.fields[0])}]\n")
      n += 1
    }
  }
  for l in e.ts.layouts {
    if l.kind == mlk_carray() {
    } else if l.kind != mlk_elems() {
      out.push_str("${ll_type_name(l.name)} = type {")
      for j in 0..l.fields.size {
        if j > 0 {
          out.push_str(",")
        }
        out.push_str(" ${e.llt(l.fields[j])}")
      }
      if l.fields.size > 0 {
        out.push_str(" ")
      }
      out.push_str("}\n")
      n += 1
    }
  }
  if n > 0 {
    out.push_str("\n")
  }
}

// ---- declarations

fn ll_declarations(e: LlEmit, out: Buf) {
  names: Array(String) = []
  for extern in e.m.externs {
    if extern.name != "__avant_type_maps" {
      ll_insert_sorted(names, extern.name)
    }
  }
  for rt_name in e.rt_names {
    ll_insert_sorted(names, rt_name)
  }
  scratch = MTypes.new()
  for name in names {
    if x = e.m.ext(name) {
      // A libm row called as its intrinsic (ll_call), and a bit operation
      // written as an instruction, need no declaration.
      if ll_math_intrinsic(e.ts, x).size == 0 && !name.starts_with("avant_bits_") {
        if ll_cabi_needed(e.ts, x.sig) {
          out.push_str(ll_cabi_declare(e.ts, name, x.sig))
        } else {
          out.push_str(ll_declare(e.ts, name, x.sig, x.noreturn, e.m.rt.attrs_of(name)))
        }
      }
    } else if r = e.m.rt.find(name) {
      out.push_str(ll_declare(scratch, name, e.m.rt.sig_of(r, scratch), r.noreturn, r.attrs))
    }
  }
  intr: Array(String) = []
  for intrinsic in e.intrinsics {
    ll_insert_sorted(intr, intrinsic)
  }
  for i in 0..intr.size {
    out.push_str("${intr[i]}\n")
  }
}

fn ll_insert_sorted(xs: Array(String), s: String) {
  for i in 0..xs.size {
    if xs[i] == s {
      return
    }
  }
  xs.push(s)
  j = xs.size - 1
  while j > 0 && str_lt(s, xs[j - 1]) {
    xs[j] = xs[j - 1]
    j -= 1
  }
  xs[j] = s
}

// `declare <ret> @name(<params>)`: `zeroext` on a C boolean;
// the traps are `noreturn nounwind cold`; a call-table row's
// attributes follow (the pure readers, runtime.av mir_rt_attrs).
fn ll_declare(ts: MTypes, name: String, sig: Int, noreturn: Bool, attrs: String): String {
  s = ts.sigs[sig]
  buf = buf_new()
  buf.push_str("declare ${ll_c_type(ts, s.ret)} ${ll_sym(name)}(")
  for i in 0..s.params.size {
    if i > 0 {
      buf.push_str(", ")
    }
    buf.push_str(ll_c_param(ts, s.params[i]))
  }
  if s.varargs {
    if s.params.size > 0 {
      buf.push_str(", ")
    }
    buf.push_str("...")
  }
  buf.push_str(")")
  if noreturn {
    buf.push_str(" noreturn nounwind cold")
  }
  if attrs.size > 0 {
    buf.push_str(" ${attrs}")
  }
  buf.push_str("\n")
  buf.to_s()
}

// A parameter or result type at the C boundary.
fn ll_c_type(ts: MTypes, ty: Int): String {
  if ty == mt_bool() {
    return "zeroext i1"
  }
  ext = ll_c_ext(ts, ty)
  if ext.size > 0 {
    return "${ext} ${ll_type_text(ts, ty)}"
  }
  ll_type_text(ts, ty)
}

// A parameter type at the C boundary: the attribute follows the type.
fn ll_c_param(ts: MTypes, ty: Int): String {
  if ty == mt_bool() {
    return "i1 zeroext"
  }
  ext = ll_c_ext(ts, ty)
  if ext.size > 0 {
    return "${ll_type_text(ts, ty)} ${ext}"
  }
  ll_type_text(ts, ty)
}

// A C integer narrower than 32 bits (a C scalar type) is extended to 32
// bits by its sign, as the SysV ABI's callers do (clang's `signext` and
// `zeroext`): C code compiled by clang relies on it.
fn ll_c_ext(ts: MTypes, ty: Int): String {
  if ts.is_int(ty) && ts.get(ty).bits < 32 {
    return ll_pick(ts.is_signed_int(ty), "signext", "zeroext")
  }
  ""
}

// ---- __avant_type_maps

fn ll_type_maps(e: LlEmit) {
  e.out.push_str("define internal void @__avant_type_maps() #0 {\nentry:\n")
  for tm in e.m.maps {
    chunks = mir_map_chunks(e.ts, tm)
    stride = mir_map_stride(e.ts, tm)
    if stride == 0 && chunks.size == 1 {
      e.need("avant_type_map")
      e.line("call void @avant_type_map(i32 ${tm.id}, i64 ${chunks[0].wrap_i()})")
    } else {
      e.need("avant_type_map_at")
      for c in 0..chunks.size {
        if c == 0 || chunks[c] != 0u64 {
          e.line("call void @avant_type_map_at(i32 ${tm.id}, i32 ${stride}, i32 ${64 * c}, i64 ${chunks[c].wrap_i()})")
        }
      }
    }
  }
  e.line("ret void")
  e.out.push_str("}\n\n")
}

// ---- functions

// The constants computed before main (mir/lower_const.av) never change
// after the start-up, so a read of one tells LLVM so, which lets a loop
// or a function load a slot (and an Array's buffer and size, a class
// object's fields) once:
// - a slot's load is !invariant.load; a reference also !nonnull, !align
//   8 and !dereferenceable (its layout's size). True from the start-up
//   on: nothing writes a slot but the start-up and the collector, and
//   the runtime pins each object a slot names (avant_const_ready), so the
//   collector never moves it and never rewrites the slot;
// - a field of the object loaded from a slot is !invariant.load when it
//   is an Array's buffer reference or size (a frozen array never
//   changes either: every change traps before it writes) or a class
//   object's field (a constant's class has no field assigned outside
//   initialize); the runtime pins those fields' objects too, so the
//   collector never rewrites them; only when no C function of the
//   program is handed a reference (an Array, a Hash, a class: C could
//   write it), else the plain load;
// - the start-up function, and every function it reaches by a call or
//   a function value, loads plainly (before main a slot does change),
//   and the start-up is never inlined into main.
// Measured on a loop that reads constants with a runtime call in it:
// the slot's marks 4.0% fewer instructions, the fields' 4.1% more (9.1%
// on a loop without calls); an accessor function marked memory(none),
// a distinct alias tag for the slots, and no frame slot for a local
// holding a constant changed nothing and were not kept.
fn ll_const_facts(e: LlEmit) {
  todo: Array(String) = []
  for f in e.m.funcs {
    if f.symbol.ends_with("/__consts") {
      todo.push(f.symbol)
      e.startup_reach.add(f.symbol)
    }
  }
  i = 0
  while i < todo.size {
    if g = e.m.func(todo[i]) {
      for blk in g.blocks {
        for st in blk.stmts {
          names: Array(String) = []
          if st.kind == msk_call() && st.callee.size > 0 {
            names.push(st.callee)
          }
          for o in st.args {
            if o.kind == mok_fn() {
              names.push(o.text)
            }
          }
          if r = st.rv {
            for o2 in [r.a, r.b] {
              if x = o2, x.kind == mok_fn() {
                names.push(x.text)
              }
            }
            for o3 in r.ops {
              if o3.kind == mok_fn() {
                names.push(o3.text)
              }
            }
          }
          for n in names {
            if e.startup_reach.add(n) {
              todo.push(n)
            }
          }
        }
      }
    }
    i += 1
  }
  // A C function handed a reference could change a constant object.
  fields = true
  for f2 in e.m.funcs {
    for blk2 in f2.blocks {
      for st2 in blk2.stmts {
        if st2.kind == msk_call() && st2.callee.size > 0 && !st2.callee.starts_with("av.") {
          if xr = e.m.rt.find(st2.callee) {
          } else {
            for a in st2.args {
              at = a.ty
              if p = a.place {
                at = mt_ref()
                if p.proj.size == 0 && p.local < f2.locals.size {
                  at = f2.locals[p.local].ty
                }
              }
              if e.ts.is_refkind(at) && at != mt_str() {
                fields = false
              }
            }
          }
        }
      }
    }
  }
  e.const_fields = fields
}

// The locals of f holding a slot's address, and those holding the value
// loaded from one, each assigned nothing else (none in a function the
// start-up reaches).
fn ll_const_locals(e: LlEmit, f: MFunc) {
  e.cslots = Set(Int).new()
  e.cvals = Set(Int).new()
  if e.startup_reach.has(f.symbol) {
    return
  }
  slots = Set(Int).new()
  vals = Set(Int).new()
  other = Set(Int).new()
  for blk in f.blocks {
    for st in blk.stmts {
      if st.kind == msk_assign() {
        if pl = st.place, pl.proj.size == 0 {
          kind = 0
          if r = st.rv, r.kind == mrk_use() {
            if a = r.a {
              if a.kind == mok_global() {
                kind = 1
              } else if ap = a.place, ap.proj.size == 1 && ap.proj[0].kind == mpk_deref() && slots.has(ap.local) {
                kind = 2
              }
            }
          }
          if kind == 1 {
            slots.add(pl.local)
          } else if kind == 2 {
            vals.add(pl.local)
          } else {
            other.add(pl.local)
          }
        }
      } else if st.kind == msk_call() && st.dest >= 0 {
        other.add(st.dest)
      }
    }
  }
  for k in slots {
    if !other.has(k) && !f.is_param(k) {
      e.cslots.add(k)
    }
  }
  for k2 in vals {
    if !other.has(k2) && !f.is_param(k2) {
      e.cvals.add(k2)
    }
  }
}

fn ll_function(e: LlEmit, f: MFunc) {
  e.f = f
  e.v.func = f
  if e.m.globals.size > 0 {
    ll_const_locals(e, f)
  }
  e.tn = 0
  e.trap_ovf = false
  e.trap_div0 = false
  e.trap_bounds = false
  e.arith_reset()
  s = e.ts.sigs[f.sig]
  linkage = "internal "
  if f.external {
    linkage = ""
  }
  // A C callback thunk (`#cb`) has the C boundary's types (`zeroext`
  // on Bool).
  c_abi = f.symbol.ends_with("#cb")
  rtext = e.llt(s.ret)
  if c_abi {
    rtext = ll_c_type(e.ts, s.ret)
  }
  e.out.push_str("define ${linkage}${rtext} ${ll_sym(f.symbol)}(")
  for i in 0..s.params.size {
    if i > 0 {
      e.out.push_str(", ")
    }
    ptext = e.llt(s.params[i])
    if c_abi {
      ptext = ll_c_param(e.ts, s.params[i])
    }
    e.out.push_str("${ptext} %a${i + 1}")
  }
  if f.caller_site {
    // The hidden last parameter: the site of the call into the library
    // (mir_caller_sites).
    if s.params.size > 0 {
      e.out.push_str(", ")
    }
    e.out.push_str("i32 %caller.site")
  }
  if e.m.globals.size > 0 && f.symbol.ends_with("/__consts") {
    // The start-up stays a call of its own: the slots it writes are
    // read as never changing (ll_const_facts) only outside it.
    e.out.push_str(") noinline #0 {\nalloca:\n")
  } else {
    e.out.push_str(") #0 {\nalloca:\n")
  }
  e.label = "alloca"
  // The frame record first: a slot local's address is in it.
  ll_gc_frame_layout(e, f)
  if e.frame_words >= 0 {
    e.line("%gcf = alloca ${ll_gc_frame_type(e)}, align ${e.frame_align}")
  }
  for i in 0..f.locals.size {
    if f.valid_local(i) {
      ty = f.locals[i].ty
      // A slot local has no alloca: its address is its place in the
      // record, computed where it is used (local_addr).
      if e.frame_words < 0 || e.frame_at[i] < 0 {
        e.line("${e.local_name(i)} = alloca ${e.llt(ty)}, align ${e.align(ty)}")
      }
    }
  }
  i = 1
  while i <= f.nparams {
    e.store(f.locals[i].ty, "%a${i}", e.local_addr(i), e.slot_vol(i))
    i += 1
  }
  e.line("br label %bb0")
  b = 0
  while b < f.blocks.size {
    blk = f.blocks[b]
    e.bk = b
    e.block("bb${b}")
    j = 0
    while j < blk.stmts.size {
      e.si = j
      ll_stmt(e, blk.stmts[j])
      j += 1
    }
    e.si = blk.stmts.size
    if t = blk.term {
      ll_term(e, t)
    }
    b += 1
  }
  ll_arith_block(e)
  e.out.push_str("}\n\n")
  ll_trap_stubs(e)
}

// ---- statements

fn ll_stmt(e: LlEmit, st: MStmt) {
  e.site(st.loc)
  k = st.kind
  if k == msk_assign() {
    if p = st.place, rv = st.rv {
      pt = e.place_type(p)
      val = ll_rvalue(e, rv, pt)
      ptr = e.place_ptr(p)
      e.store_tagged(pt, val, ptr, e.pa_vol, e.pa_tbaa)
    }
  } else if k == msk_call() {
    ll_call(e, st)
  } else if k == msk_barrier() {
    ll_barrier(e, st.args[0])
  } else if k == msk_barrier_at() {
    ll_barrier_at(e, st.args[0])
  } else if k == msk_check_bounds() {
    ll_bounds(e, st)
  } else if k == msk_gc_enter() {
    ll_gc_frame_enter(e)
  } else if k == msk_gc_leave() {
    ll_gc_frame_leave(e)
  }
}

// check.bounds i, n: unsigned i >= n traps with avant_trap_bounds(i, n).
// The operands are two i64 (an Int index against a size the header keeps
// in 32 bits, sign-extended), or two i32 (MIR's own tests), widened for
// the trap.
fn ll_bounds(e: LlEmit, st: MStmt) {
  i = e.value(st.args[0])
  ity = e.ov_ty
  n = e.value(st.args[1])
  c = e.tmp()
  e.line("${c} = icmp uge ${e.llt(ity)} ${i}, ${n}")
  oob = e.part("oob")
  ok = e.part("ok")
  e.line("br i1 ${c}, label %${oob}, label %${ok}")
  e.block(oob)
  // The function's own stub (ll_trap_stubs), which names the function:
  // the check's trap block calls it with the same two arguments as the
  // plain trap, so LLVM's inlining costs and merging stay as they were
  // (a site argument per check flipped an inlining on Maze::AStar,
  // +5.8% instructions).
  e.trap_bounds = true
  if ity != mt_i64() {
    wi = e.tmp()
    e.line("${wi} = sext i32 ${i} to i64")
    wn = e.tmp()
    e.line("${wn} = sext i32 ${n} to i64")
    i = wi
    n = wn
  }
  e.line("call void ${ll_stub(e, "#tb")}(i64 ${i}, i64 ${n})")
  e.line("unreachable")
  e.block(ok)
}

// A call: arguments left to right, the call, then the destination (a
// local) stored at once. Allocation rows may expand inline.
fn ll_call(e: LlEmit, st: MStmt) {
  result = ""
  ret = mt_void()
  if fo = st.indirect {
    result = ll_call_indirect(e, st, fo)
    ret = e.ov_ty
  } else if g = e.m.func(st.callee) {
    s = e.ts.sigs[g.sig]
    ret = s.ret
    args = ll_args(e, st.args, s.params, false)
    if g.caller_site {
      if args.size > 0 {
        args = "${args}, "
      }
      args = "${args}i32 ${ll_caller_site(e)}"
    }
    result = ll_emit_call(e, ret == mt_void(), e.llt(ret), ll_sym(g.symbol), args)
  } else if x = e.m.ext(st.callee) {
    if x.name == "avant_gc_poll" {
      // The request flag's test, the call only when set.
      ll_gc_poll(e)
      return
    }
    sig = x.sig
    if st.sig >= 0 {
      sig = st.sig
    }
    s = e.ts.sigs[sig]
    ret = s.ret
    if ll_cabi_needed(e.ts, sig) || ll_cabi_needed(e.ts, x.sig) {
      // An aggregate at the C boundary (emit_cabi.av); the
      // destination is written there.
      ll_cabi_call(e, st, x.name, sig)
      return
    }
    intr = ll_math_intrinsic(e.ts, x)
    bits = ""
    if intr.size == 0 {
      bits = ll_bits_op(e, x.name, st.args)
    }
    if intr.size > 0 {
      // The libm row as its LLVM intrinsic (no errno, so LLVM may
      // vectorize and fold it; a NaN where libm gives one).
      if s.params.size == 2 {
        e.need_intrinsic("declare double @${intr}(double, double)")
      } else {
        e.need_intrinsic("declare double @${intr}(double)")
      }
      result = ll_emit_call(e, false, "double", "@${intr}", ll_args(e, st.args, s.params, true))
    } else if bits.size > 0 {
      result = bits
    } else if x.alloc {
      result = ll_alloc(e, x.name, st.args, st.fresh)
    } else if x.name == "avant_str_size" && e.inline_fast {
      result = ll_str_size(e, st.args)
    } else if x.name == "avant_str_data" && e.inline_fast {
      result = ll_str_data(e, st.args)
    } else if x.name == "avant_str_view_test" && e.inline_fast {
      result = ll_str_view_test(e, st.args)
    } else if (x.name == "avant_str_flat" || x.name == "avant_str_c_arg") && e.inline_fast {
      result = ll_str_unview(e, x.name, st.args)
    } else {
      args = ll_args(e, st.args, s.params, true)
      callee = ll_sym(x.name)
      if x.noreturn && x.name.starts_with("avant_trap_") {
        // A trap the lowering raises: its sited form, with the site's
        // text last.
        e.need("${x.name}_at")
        callee = ll_sym("${x.name}_at")
        if args.size > 0 {
          args = "${args}, "
        }
        site = ""
        if x.name == "avant_trap_expect" {
          // `panic` and `expect`: in a library function that names its
          // caller's site, that site.
          site = ll_caller_site(e)
        } else {
          site = e.site_ref()
        }
        args = "${args}i32 ${site}"
      }
      rt = ll_c_type(e.ts, ret)
      if s.varargs || sig != x.sig {
        rt = "${rt} ${ll_fn_type(e, s)}"
      }
      result = ll_emit_call(e, ret == mt_void(), rt, callee, args)
    }
  }
  if st.dest >= 0 {
    d = st.dest
    e.store(e.f.locals[d].ty, result, e.local_addr(d), e.slot_vol(d))
  }
}

// The LLVM intrinsic of a libm external, or "": Float64's math methods
// (mir/runtime.av's libm rows), when the external is `double (double)`
// or `double (double, double)`, are llvm.fabs, llvm.floor and the others
// of the same name (fabs, floor, ceil, trunc, round and sqrt become
// instructions; exp, the logarithms, the trigonometric functions, pow and
// atan2 are lowered to libm's call, and folded only for constants, with
// the host's libm). They give the same bits as libm on every input (sqrt
// of a negative or a NaN is a NaN either way; Avant never reads errno,
// the one difference).
fn ll_math_intrinsic(ts: MTypes, x: MExtern): String {
  s = ts.sigs[x.sig]
  if s.params.size < 1 || s.params.size > 2 || s.ret != mt_f64() || s.varargs {
    return ""
  }
  for p in s.params {
    if p != mt_f64() {
      return ""
    }
  }
  n = x.name
  if s.params.size == 2 {
    if n == "pow" || n == "atan2" {
      return "llvm.${n}.f64"
    }
    return ""
  }
  if n == "sqrt" || n == "fabs" || n == "floor" || n == "ceil" || n == "trunc" || n == "round" || n == "exp" || n == "sin" || n == "cos" || n == "tan" || n == "log" || n == "log2" || n == "log10" {
    return "llvm.${n}.f64"
  }
  ""
}

// The bit operations the lowering calls by name (mir/runtime.av's
// avant_bits_ rows), each one LLVM operation and no function: a bit
// count (llvm.ctpop, llvm.ctlz, llvm.cttz, defined at zero: the width)
// or a bitcast between a Float64 and a UInt64. "" for another name.
fn ll_bits_op(e: LlEmit, name: String, args: Array(MOperand)): String {
  if !name.starts_with("avant_bits_") {
    return ""
  }
  if name.ends_with("_u64") && name != "avant_bits_f64_to_u64" {
    return ll_bits_u64(e, name, args)
  }
  if args.size != 1 {
    return ""
  }
  x = e.value(args[0])
  if name == "avant_bits_f64_to_u64" {
    t = e.tmp()
    e.line("${t} = bitcast double ${x} to i64")
    return t
  }
  if name == "avant_bits_u64_to_f64" {
    t2 = e.tmp()
    e.line("${t2} = bitcast i64 ${x} to double")
    return t2
  }
  w = "i64"
  if name.ends_with("_i32") {
    w = "i32"
  }
  op = ""
  for o in ["ctpop", "ctlz", "cttz"] {
    if name.starts_with("avant_bits_${o}_") {
      op = o
    }
  }
  if op.size == 0 {
    return ""
  }
  t3 = e.tmp()
  if op == "ctpop" {
    e.need_intrinsic("declare ${w} @llvm.ctpop.${w}(${w})")
    e.line("${t3} = call ${w} @llvm.ctpop.${w}(${w} ${x})")
  } else {
    e.need_intrinsic("declare ${w} @llvm.${op}.${w}(${w}, i1)")
    e.line("${t3} = call ${w} @llvm.${op}.${w}(${w} ${x}, i1 false)")
  }
  t3
}

// std.bits's operations on UInt64 (lib/std/bits.av), each a few LLVM
// instructions the back end turns into one or two machine ones: the high
// half of a widening multiply, the carry or borrow out of an add or a
// subtract with one in, a 128-by-64 division's quotient or remainder, a
// rotation (a funnel shift, its amount modulo 64), a bit or byte
// reversal. "" for another name or arity.
fn ll_bits_u64(e: LlEmit, name: String, args: Array(MOperand)): String {
  xs: Array(String) = []
  for a in args {
    xs.push(e.value(a))
  }
  if name == "avant_bits_mulhi_u64" && xs.size == 2 {
    a = e.tmp()
    e.line("${a} = zext i64 ${xs[0]} to i128")
    b = e.tmp()
    e.line("${b} = zext i64 ${xs[1]} to i128")
    p = e.tmp()
    e.line("${p} = mul i128 ${a}, ${b}")
    h = e.tmp()
    e.line("${h} = lshr i128 ${p}, 64")
    r = e.tmp()
    e.line("${r} = trunc i128 ${h} to i64")
    return r
  }
  if (name == "avant_bits_carry_u64" || name == "avant_bits_borrow_u64") && xs.size == 3 {
    op = "uadd"
    if name == "avant_bits_borrow_u64" {
      op = "usub"
    }
    e.need_intrinsic("declare { i64, i1 } @llvm.${op}.with.overflow.i64(i64, i64)")
    s1 = e.tmp()
    e.line("${s1} = call { i64, i1 } @llvm.${op}.with.overflow.i64(i64 ${xs[0]}, i64 ${xs[1]})")
    v1 = e.tmp()
    e.line("${v1} = extractvalue { i64, i1 } ${s1}, 0")
    o1 = e.tmp()
    e.line("${o1} = extractvalue { i64, i1 } ${s1}, 1")
    s2 = e.tmp()
    e.line("${s2} = call { i64, i1 } @llvm.${op}.with.overflow.i64(i64 ${v1}, i64 ${xs[2]})")
    o2 = e.tmp()
    e.line("${o2} = extractvalue { i64, i1 } ${s2}, 1")
    o = e.tmp()
    e.line("${o} = or i1 ${o1}, ${o2}")
    r2 = e.tmp()
    e.line("${r2} = zext i1 ${o} to i64")
    return r2
  }
  if (name == "avant_bits_divq_u64" || name == "avant_bits_divr_u64") && xs.size == 3 {
    hi = e.tmp()
    e.line("${hi} = zext i64 ${xs[0]} to i128")
    hs = e.tmp()
    e.line("${hs} = shl i128 ${hi}, 64")
    lo = e.tmp()
    e.line("${lo} = zext i64 ${xs[1]} to i128")
    n = e.tmp()
    e.line("${n} = or i128 ${hs}, ${lo}")
    d = e.tmp()
    e.line("${d} = zext i64 ${xs[2]} to i128")
    op2 = "udiv"
    if name == "avant_bits_divr_u64" {
      op2 = "urem"
    }
    q = e.tmp()
    e.line("${q} = ${op2} i128 ${n}, ${d}")
    r3 = e.tmp()
    e.line("${r3} = trunc i128 ${q} to i64")
    return r3
  }
  if name == "avant_bits_rotl_u64" && xs.size == 2 {
    e.need_intrinsic("declare i64 @llvm.fshl.i64(i64, i64, i64)")
    r4 = e.tmp()
    e.line("${r4} = call i64 @llvm.fshl.i64(i64 ${xs[0]}, i64 ${xs[0]}, i64 ${xs[1]})")
    return r4
  }
  if (name == "avant_bits_bitrev_u64" || name == "avant_bits_bswap_u64") && xs.size == 1 {
    f = "bitreverse"
    if name == "avant_bits_bswap_u64" {
      f = "bswap"
    }
    e.need_intrinsic("declare i64 @llvm.${f}.i64(i64)")
    r5 = e.tmp()
    e.line("${r5} = call i64 @llvm.${f}.i64(i64 ${xs[0]})")
    return r5
  }
  ""
}

// The site a call into a library function that names its caller's site
// passes, or `panic`'s: the one this function was given when it is such
// a function itself, else the statement's own.
fn ll_caller_site(e: LlEmit): String {
  if e.f.caller_site {
    return "%caller.site"
  }
  e.site_ref()
}

fn ll_emit_call(e: LlEmit, is_void: Bool, ret: String, callee: String, args: String): String {
  if is_void {
    e.line("call ${ret} ${callee}(${args})")
    return ""
  }
  t = e.tmp()
  e.line("${t} = call ${ret} ${callee}(${args})")
  t
}

// `(<params>[, ...])`: the function type a call through another
// binding's signature, or a variadic call, spells out.
fn ll_fn_type(e: LlEmit, s: MSig): String {
  buf = buf_new()
  buf.push_str("(")
  for i in 0..s.params.size {
    if i > 0 {
      buf.push_str(", ")
    }
    buf.push_str(e.llt(s.params[i]))
  }
  if s.varargs {
    if s.params.size > 0 {
      buf.push_str(", ")
    }
    buf.push_str("...")
  }
  buf.push_str(")")
  buf.to_s()
}

// The argument list: each operand loaded here, in order; a fixed
// parameter takes its declared type (zeroext for a C boolean), a variadic
// argument its own type.
fn ll_args(e: LlEmit, ops: Array(MOperand), params: Array(Int), c_boundary: Bool): String {
  buf = buf_new()
  i = 0
  while i < ops.size {
    x = e.value(ops[i])
    ty = e.ov_ty
    if i < params.size {
      ty = params[i]
    }
    if i > 0 {
      buf.push_str(", ")
    }
    if c_boundary && ty == mt_bool() {
      buf.push_str("i1 zeroext ${x}")
    } else if c_boundary && ll_c_ext(e.ts, ty).size > 0 {
      buf.push_str("${e.llt(ty)} ${ll_c_ext(e.ts, ty)} ${x}")
    } else {
      buf.push_str("${e.llt(ty)} ${x}")
    }
    i += 1
  }
  buf.to_s()
}

// call indirect copy P: the fnval's environment (word 0) is the
// first argument of its code (word 1). Sets ov_ty to the result type.
fn ll_call_indirect(e: LlEmit, st: MStmt, fo: MOperand): String {
  fv = e.value(fo)
  fty = e.ov_ty
  l = e.ts.layouts[e.ts.layout_of(fty)]
  s = e.ts.sigs[e.ts.get(l.fields[1]).sig]
  env = e.tmp()
  e.line("${env} = extractvalue ${e.llt(fty)} ${fv}, 0")
  code = e.tmp()
  e.line("${code} = extractvalue ${e.llt(fty)} ${fv}, 1")
  args = ll_args(e, st.args, s.params[1..], false)
  if args.size > 0 {
    args = "ptr ${env}, ${args}"
  } else {
    args = "ptr ${env}"
  }
  r = ll_emit_call(e, s.ret == mt_void(), e.llt(s.ret), code, args)
  e.ov_ty = s.ret
  r
}

// ---- terminators

// The loop metadata of a cold back edge (the checked copy that loop
// versioning keeps): one distinct node per loop header of the function,
// numbered in emission order; node !0 is the shared unroll-disable hint.
fn ll_cold_md(e: LlEmit, t: MTerm): String {
  if t.cold <= 0 {
    return ""
  }
  key = "${e.f.symbol}|${t.cold}"
  if got = e.loop_md.get(key) {
    return ", !llvm.loop !${got}"
  }
  e.loop_md_n += 1
  e.loop_md[key] = e.loop_md_n
  ", !llvm.loop !${e.loop_md_n}"
}

// The metadata: !0 the loops' unroll hint, !1 to !14 the alias tags and
// the load facts (ll_tbaa_nodes), then one node per cold loop.
fn ll_loop_md(e: LlEmit, out: Buf) {
  first = ll_tbaa_last() + 1
  if e.loop_md_n < first && !e.used_tbaa {
    return
  }
  out.push_str("\n")
  if e.loop_md_n >= first {
    out.push_str("!0 = !{!\"llvm.loop.unroll.disable\"}\n")
  }
  if e.used_tbaa {
    out.push_str(ll_tbaa_nodes())
  }
  i = first
  while i <= e.loop_md_n {
    out.push_str("!${i} = distinct !{!${i}, !0}\n")
    i += 1
  }
}

fn ll_term(e: LlEmit, t: MTerm) {
  e.site(t.loc)
  k = t.kind
  if k == mtk_goto() {
    e.line("br label %bb${t.targets[0]}${ll_cold_md(e, t)}")
  } else if k == mtk_branch() {
    c = "false"
    if o = t.cond {
      c = e.value(o)
    }
    e.line("br i1 ${c}, label %bb${t.targets[0]}, label %bb${t.targets[1]}${ll_cold_md(e, t)}")
  } else if k == mtk_switch() {
    if o = t.cond {
      c = e.value(o)
      ty = e.ov_ty
      buf = buf_new()
      buf.push_str("switch ${e.llt(ty)} ${c}, label %bb${t.targets[t.targets.size - 1]} [")
      for i in 0..t.values.size {
        buf.push_str(" ${e.llt(ty)} ${e.int_text(ty, t.values[i])}, label %bb${t.targets[i]}")
      }
      buf.push_str(" ]")
      e.line(buf.to_s())
    }
  } else if k == mtk_return() {
    if e.f.has_ret() {
      ty = e.f.locals[0].ty
      x = e.load(ty, e.local_addr(0), e.slot_vol(0))
      e.line("ret ${e.llt(ty)} ${x}")
    } else {
      e.line("ret void")
    }
  } else {
    e.line("unreachable")
  }
}

// ---- rvalues: the value to store into a place of type pt.

fn ll_rvalue(e: LlEmit, r: MRvalue, pt: Int): String {
  k = r.kind
  if k == mrk_use() {
    if a = r.a {
      return e.value(a)
    }
  }
  if k == mrk_zero() {
    return e.zero_text(pt)
  }
  if k == mrk_unary() {
    return ll_unary(e, r)
  }
  if k == mrk_binary() || k == mrk_checked() || k == mrk_cmp() {
    if a = r.a, b = r.b {
      x = e.value(a)
      ty = e.ov_ty
      y = e.value(b)
      if k == mrk_cmp() {
        return ll_cmp(e, r.op, ty, x, y)
      }
      if k == mrk_checked() {
        return ll_checked(e, r.op, ty, x, y)
      }
      return ll_binary(e, r.op, ty, x, y)
    }
  }
  if k == mrk_cast() {
    if a = r.a {
      return ll_cast(e, e.value(a), e.ov_ty, r.ty)
    }
  }
  if k == mrk_addr() || k == mrk_addr_raw() {
    if p = r.place {
      return e.place_ptr(p)
    }
  }
  if k == mrk_struct() {
    vals: Array(String) = []
    tys: Array(Int) = []
    for i in 0..r.ops.size {
      vals.push(e.value(r.ops[i]))
      tys.push(e.ov_ty)
    }
    agg = "zeroinitializer"
    for i in 0..vals.size {
      agg = ll_insert(e, r.ty, agg, tys[i], vals[i], i)
    }
    return agg
  }
  if k == mrk_union() {
    l = e.ts.layouts[e.ts.layout_of(r.ty)]
    agg = ll_insert(e, r.ty, "zeroinitializer", mt_i32(), "${r.op}", 0)
    if a = r.a {
      x = e.value(a)
      pi = 1 + r.op
      if l.nil_tag >= 0 && r.op > l.nil_tag {
        pi = r.op
      }
      agg = ll_insert(e, r.ty, agg, l.fields[pi], x, pi)
    }
    return agg
  }
  if k == mrk_fnval() {
    if a = r.a, b = r.b {
      env = e.value(a)
      code = e.value(b)
      agg = ll_insert(e, r.ty, "zeroinitializer", mt_ref(), env, 0)
      return ll_insert(e, r.ty, agg, mt_ptr(), code, 1)
    }
  }
  "undef"
}

// E4: aggregates are built by insertvalue chains from zeroinitializer.
fn ll_insert(e: LlEmit, aty: Int, agg: String, fty: Int, x: String, idx: Int): String {
  t = e.tmp()
  e.line("${t} = insertvalue ${e.llt(aty)} ${agg}, ${e.llt(fty)} ${x}, ${idx}")
  t
}

fn ll_unary(e: LlEmit, r: MRvalue): String {
  if a = r.a {
    x = e.value(a)
    ty = e.ov_ty
    if r.op == mop_neg_chk() {
      return ll_overflow(e, "ssub", ty, "0", x)
    }
    t = e.tmp()
    if r.op == mop_neg() && ty == mt_f64() {
      e.line("${t} = fneg double ${x}")
    } else if r.op == mop_neg() {
      e.line("${t} = sub ${e.llt(ty)} 0, ${x}")
    } else if ty == mt_bool() {
      e.line("${t} = xor i1 ${x}, true")
    } else {
      e.line("${t} = xor ${e.llt(ty)} ${x}, -1")
    }
    return t
  }
  "undef"
}

fn ll_binary(e: LlEmit, op: Int, ty: Int, x: String, y: String): String {
  lt = e.llt(ty)
  signed = e.ts.is_signed_int(ty)
  f = ty == mt_f64()
  name = "add"
  if op == mop_add() {
    name = ll_pick(f, "fadd", "add")
  } else if op == mop_sub() {
    name = ll_pick(f, "fsub", "sub")
  } else if op == mop_mul() {
    name = ll_pick(f, "fmul", "mul")
  } else if op == mop_div() {
    name = ll_pick(f, "fdiv", ll_pick(signed, "sdiv", "udiv"))
  } else if op == mop_rem() {
    name = ll_pick(f, "frem", ll_pick(signed, "srem", "urem"))
  } else if op == mop_and() {
    name = "and"
  } else if op == mop_or() {
    name = "or"
  } else if op == mop_xor() {
    name = "xor"
  } else if op == mop_shl() {
    name = "shl"
  } else if op == mop_shr() {
    name = ll_pick(signed, "ashr", "lshr")
  }
  t = e.tmp()
  e.line("${t} = ${name} ${lt} ${x}, ${y}")
  t
}

fn ll_pick(c: Bool, a: String, b: String): String {
  if c {
    return a
  }
  b
}

fn ll_cmp(e: LlEmit, op: Int, ty: Int, x: String, y: String): String {
  t = e.tmp()
  if ty == mt_f64() {
    names = ["oeq", "une", "olt", "ole", "ogt", "oge"]
    e.line("${t} = fcmp ${names[op - mop_eq()]} double ${x}, ${y}")
    return t
  }
  signed = e.ts.is_signed_int(ty)
  names = ["eq", "ne", "ult", "ule", "ugt", "uge"]
  if signed {
    names = ["eq", "ne", "slt", "sle", "sgt", "sge"]
  }
  e.line("${t} = icmp ${names[op - mop_eq()]} ${e.llt(ty)} ${x}, ${y}")
  t
}

// add.chk sub.chk mul.chk: the with.overflow intrinsic and a
// branch to the function's overflow trap. Past the branch the operation
// is known not to wrap, so the result used is the plain operation with
// that flag (nsw signed, nuw unsigned): LLVM reads the flag where it
// cannot see through the intrinsic and the trap's call (an induction
// variable's range, a sign extension of an index, a loop's trip count),
// and folds the two into the one add or multiply and its jump.
fn ll_overflow(e: LlEmit, name: String, ty: Int, x: String, y: String): String {
  lt = e.llt(ty)
  pair = "{ ${lt}, i1 }"
  e.need_intrinsic("declare ${pair} @llvm.${name}.with.overflow.${lt}(${lt}, ${lt})")
  r = e.tmp()
  e.line("${r} = call ${pair} @llvm.${name}.with.overflow.${lt}(${lt} ${x}, ${lt} ${y})")
  o = e.tmp()
  e.line("${o} = extractvalue ${pair} ${r}, 1")
  ll_arith_trap(e, o, false)
  flag = "nsw"
  if name.starts_with("u") {
    flag = "nuw"
  }
  v = e.tmp()
  e.line("${v} = ${str_slice(name, 1, name.size)} ${flag} ${lt} ${x}, ${y}")
  v
}

// The function's arithmetic trap when c holds: every overflow check of
// a source line branches to that line's one trap.ovf.N block, every
// division by zero to its trap.div0.N, so LLVM keeps folding a line's
// checks into one branch (a block per check kept it from that: +7%
// instructions on Maze::AStar). The line blocks only pass their site to
// the function's one trap call (ll_arith_block): a call per line made
// small functions too costly to inline (+12% on Maze::AStar).
fn ll_arith_trap(e: LlEmit, c: String, div_zero: Bool) {
  name = "ovf"
  if div_zero {
    name = "div0"
    e.trap_div0 = true
  } else {
    e.trap_ovf = true
  }
  n = e.arith_block(name)
  ok = e.part("${name}.ok")
  e.line("br i1 ${c}, label %trap.${name}.${n}, label %${ok}")
  e.block(ok)
}

// The function's name and a position, "Name (file:line:col)", for the
// traps that name their function: arithmetic (the check's line, and its
// column when the line has one check's), bounds (the function's start).
fn ll_fn_site_at(e: LlEmit, file: Int, line: Int, col: Int): String {
  path = "?"
  if file >= 0 && file < e.m.files.size {
    path = e.m.files[file]
  }
  fname = e.f.source_name
  if fname.size == 0 {
    fname = e.f.symbol
  }
  if col < 0 {
    return e.text_ref("${fname} (${path}:${line})")
  }
  e.text_ref("${fname} (${path}:${line}:${col})")
}

fn ll_fn_site(e: LlEmit): String {
  loc = e.f.loc
  ll_fn_site_at(e, loc.file(), loc.line(), loc.col())
}

// The function's arithmetic trap blocks (ll_arith_trap): each line's
// block jumps to its kind's one block, which calls the stub with the
// line's site (a phi).
fn ll_arith_block(e: LlEmit) {
  if !e.trap_ovf && !e.trap_div0 {
    return
  }
  kinds = ["ovf", "div0"]
  sufs = ["#to", "#td"]
  for k, kind in kinds {
    incoming: Array(String) = []
    i = 0
    while i < e.arith_keys.size {
      parts = e.arith_keys[i].split(" ")
      if parts[0] == kind {
        site = ll_fn_site_at(e, parts[1].to_i() ?? -1, parts[2].to_i() ?? 0, e.arith_cols[i])
        e.block("trap.${kind}.${i}")
        e.line("br label %trap.${kind}")
        incoming.push("[ ${site}, %trap.${kind}.${i} ]")
      }
      i += 1
    }
    if incoming.size > 0 {
      e.block("trap.${kind}")
      e.line("%trap.${kind}.site = phi i32 ${incoming.join(", ")}")
      e.line("call void ${ll_stub(e, sufs[k])}(i32 %trap.${kind}.site)")
      e.line("unreachable")
    }
  }
}

// The LLVM name of the function's trap stub with suffix suf.
fn ll_stub(e: LlEmit, suf: String): String {
  ll_sym(e.f.symbol + suf)
}

// The function's trap stubs: cold, never inlined, they call the
// runtime's trap with a site: the bounds stub the function's own
// (ll_fn_site), so its trap block keeps the plain trap's arguments; the
// arithmetic stubs the site their line's block passes.
fn ll_trap_stubs(e: LlEmit) {
  if !e.trap_ovf && !e.trap_div0 && !e.trap_bounds {
    return
  }
  e.used_stubs = true
  o = e.out
  if e.trap_bounds {
    fsite = ll_fn_site(e)
    e.need("avant_trap_bounds_in")
    o.push_str("define internal void ${ll_stub(e, "#tb")}(i64 %i, i64 %n) #1 {\n")
    o.push_str("  call void @avant_trap_bounds_in(i64 %i, i64 %n, i32 ${fsite})\n  unreachable\n}\n\n")
  }
  if e.trap_ovf {
    e.need("avant_trap_overflow_in")
    o.push_str("define internal void ${ll_stub(e, "#to")}(i32 %s) #1 {\n")
    o.push_str("  call void @avant_trap_overflow_in(i32 %s)\n  unreachable\n}\n\n")
  }
  if e.trap_div0 {
    e.need("avant_trap_div_zero_in")
    o.push_str("define internal void ${ll_stub(e, "#td")}(i32 %s) #1 {\n")
    o.push_str("  call void @avant_trap_div_zero_in(i32 %s)\n  unreachable\n}\n\n")
  }
}

fn ll_checked(e: LlEmit, op: Int, ty: Int, x: String, y: String): String {
  signed = e.ts.is_signed_int(ty)
  s = ll_pick(signed, "s", "u")
  if op == mop_add() {
    return ll_overflow(e, "${s}add", ty, x, y)
  }
  if op == mop_sub() {
    return ll_overflow(e, "${s}sub", ty, x, y)
  }
  if op == mop_mul() {
    return ll_overflow(e, "${s}mul", ty, x, y)
  }
  // div.chk, rem.chk: divisor 0 traps; signed (MIN, -1) traps for div
  // and gives 0 for rem (a safe divisor of 1).
  lt = e.llt(ty)
  z = e.tmp()
  e.line("${z} = icmp eq ${lt} ${y}, 0")
  ll_arith_trap(e, z, true)
  d = y
  if signed {
    min = "-2147483648"
    mt = e.ts.get(ty)
    width = mt.bits
    if width == 64 {
      min = "-9223372036854775808"
    } else if width == 8 {
      min = "-128"
    }
    m1 = e.tmp()
    e.line("${m1} = icmp eq ${lt} ${x}, ${min}")
    m2 = e.tmp()
    e.line("${m2} = icmp eq ${lt} ${y}, -1")
    mm = e.tmp()
    e.line("${mm} = and i1 ${m1}, ${m2}")
    if op == mop_div() {
      ll_arith_trap(e, mm, false)
    } else {
      d = e.tmp()
      e.line("${d} = select i1 ${mm}, ${lt} 1, ${lt} ${y}")
    }
  }
  name = ll_pick(op == mop_div(), ll_pick(signed, "sdiv", "udiv"), ll_pick(signed, "srem", "urem"))
  t = e.tmp()
  e.line("${t} = ${name} ${lt} ${x}, ${d}")
  t
}

// cast: integer width and signedness by the source type,
// int <-> f64, bool -> int; reference and pointer casts emit nothing.
fn ll_cast(e: LlEmit, x: String, src: Int, dst: Int): String {
  ts = e.ts
  name = ""
  if src == mt_bool() && ts.is_int(dst) {
    name = "zext"
  } else if ts.is_int(src) && ts.is_int(dst) {
    sb = ts.get(src).bits
    db = ts.get(dst).bits
    if db > sb {
      name = ll_pick(ts.is_signed_int(src), "sext", "zext")
    } else if db < sb {
      name = "trunc"
    }
  } else if ts.is_int(src) && dst == mt_f64() {
    name = ll_pick(ts.is_signed_int(src), "sitofp", "uitofp")
  } else if src == mt_f64() && ts.is_int(dst) {
    name = ll_pick(ts.is_signed_int(dst), "fptosi", "fptoui")
  } else if src == mt_f64() && ts.is_f32(dst) {
    name = "fptrunc"
  } else if ts.is_f32(src) && dst == mt_f64() {
    name = "fpext"
  }
  if name.size == 0 {
    return x
  }
  t = e.tmp()
  e.line("${t} = ${name} ${e.llt(src)} ${x} to ${e.llt(dst)}")
  t
}
