// The GC contract as emitted: frame enter and leave, root registration,
// the barrier (inline fast path, or the call form), and allocation (the
// inline fast path, or the call form). The runtime ABI is the frozen
// one; the sequences reproduce the old back end's.

import source
import mir.types
import mir.ir
import llvm.emit_core

// Frames. A frame function keeps its frame record in its own stack
// frame: %gcf, two words { prev, desc } (runtime/avant_rt.h) followed in
// place by the function's slot locals themselves, the locals of the
// gc.roots that follows gc.enter, in the listed order, each at its
// alignment. A slot local has no alloca of its own: its address is a
// GEP of %gcf, emitted where it is used (LlEmit.local_addr). desc says which words
// after the header are root words: an odd constant, bit i + 1 for word i,
// when the record has at most 62 words after the header; else a private
// constant map ({ n, the n root word indices }) whose address plus 2 is
// desc. gc.enter stores desc and links the record with the module's
// @__avant_frame_push: inline (prev = avant_gc_top, avant_gc_top = %gcf)
// when the thread already has an innermost frame, else through
// avant_gc_frame_enter, which also registers the thread and initializes
// the heap. gc.leave calls @__avant_frame_pop, which unlinks it inline
// when %gcf is innermost and not the thread's outermost frame, else
// through avant_gc_frame_leave. Both helpers are internal and small, so
// the inliner at -O3 folds them into every frame (ll_gc_frame_helpers).
// The call forms (inline_fast false) call the runtime entries directly.
// gc.roots itself emits nothing: the record's layout is its slots, and
// nothing comes between gc.enter and it (V16). Before, the record was
// { prev, slots, n, cap, scope } with an array of the slots' addresses
// after it: four header stores and one address store per slot at every
// entry, where desc is one store.

// The record of bb0's gc.enter and gc.roots, into e: frame_words (the
// words after the header, or -1 when the function has no gc.enter: a
// leaf), frame_at (each local's byte offset in the record, or -1),
// frame_align, and frame_desc (desc's store operand, typed).
pub fn ll_gc_frame_layout(e: LlEmit, f: MFunc) {
  e.frame_words = -1
  e.frame_align = 8
  e.frame_desc = ""
  e.frame_at = []
  if f.blocks.size == 0 {
    return
  }
  found = false
  slots: Array(Int) = []
  for st in f.blocks[0].stmts {
    if st.kind == msk_gc_enter() {
      found = true
    } else if st.kind == msk_gc_roots() {
      slots.concat(st.locals)
    }
  }
  if !found {
    return
  }
  for i in 0..f.locals.size {
    e.frame_at.push(-1)
  }
  w = 0
  roots: Array(Int) = []
  for l in slots {
    ty = f.locals[l].ty
    a = e.align(ty)
    if a > e.frame_align {
      e.frame_align = a
    }
    off = 16 + w * 8
    while off % a != 0 {
      off += 8
    }
    e.frame_at[l] = off
    w0 = (off - 16) / 8
    refs: Array(Int) = []
    words: Array(Int) = []
    e.ts.words(ty, 0, refs, words)
    for wd in words {
      roots.push(w0 + wd)
    }
    w = w0 + (e.ts.size_of(ty) + 7) / 8
  }
  e.frame_words = w
  if w <= 62 {
    d = 1
    for r in roots {
      bit = 2
      k = 0
      while k < r {
        bit *= 2
        k += 1
      }
      d += bit
    }
    e.frame_desc = "i64 ${d}"
    return
  }
  name = "@__avant_frame_map.${e.frame_maps.size}"
  text = "${name} = private unnamed_addr constant { i64, [${roots.size} x i32] } { i64 ${roots.size}, [${roots.size} x i32] ["
  j = 0
  while j < roots.size {
    if j > 0 {
      text = text + ", "
    }
    text = text + "i32 ${roots[j]}"
    j += 1
  }
  e.frame_maps.push(text + "] }, align 8")
  e.frame_desc = "ptr getelementptr (i8, ptr ${name}, i64 2)"
}

pub fn ll_gc_frame_type(e: LlEmit): String {
  if e.frame_words == 0 {
    return "{ ptr, i64 }"
  }
  "{ ptr, i64, [${e.frame_words} x i64] }"
}

// A thread's first Avant frame can be only a first-frame function's
// (MFunc.first_frame: main, a C callback's thunk, a task's thunk; the
// frame pass gives each a record, gc.av rule 2), so every other record is
// linked below another record of its thread: avant_gc_top is not null at
// its gc.enter, and at its gc.leave it is the record itself (every
// return unlinks, V17; a recovery's jump restores avant_gc_top to the
// record its recovery point was entered under) and prev is not null. Such
// a record links and unlinks inline with no test: three instructions and
// two. A first-frame function's record goes through the helpers, which
// take the runtime entry for the thread's outermost frame. The runtime's
// checked mode asks, at every collection, that a thread's outermost
// record entered through the runtime (gc_verify_frames).
pub fn ll_gc_frame_enter(e: LlEmit) {
  fd = e.tmp()
  e.line("${fd} = getelementptr inbounds i8, ptr %gcf, i64 8")
  e.line("store ${e.frame_desc}, ptr ${fd}, align 8")
  e.need("avant_gc_frame_enter")
  if !e.inline_fast {
    e.line("call void @avant_gc_frame_enter(ptr %gcf)")
    return
  }
  e.used_frame_global = true
  if e.f.first_frame() {
    e.used_frame_helpers = true
    e.line("call void @__avant_frame_push(ptr %gcf)")
    return
  }
  t = e.tmp()
  e.line("${t} = load ptr, ptr @avant_gc_top, align 8")
  e.line("store ptr ${t}, ptr %gcf, align 8")
  e.line("store volatile ptr %gcf, ptr @avant_gc_top, align 8")
}

pub fn ll_gc_frame_leave(e: LlEmit) {
  e.need("avant_gc_frame_leave")
  if !e.inline_fast {
    e.line("call void @avant_gc_frame_leave(ptr %gcf)")
    return
  }
  e.used_frame_global = true
  if e.f.first_frame() {
    e.used_frame_helpers = true
    e.line("call void @__avant_frame_pop(ptr %gcf)")
    return
  }
  p = e.tmp()
  e.line("${p} = load ptr, ptr %gcf, align 8")
  e.line("store volatile ptr ${p}, ptr @avant_gc_top, align 8")
}

// The module's two frame helpers, when a first-frame function's record
// links inline: internal functions the inliner at -O3 folds into every
// caller (in --debug they stay calls). The link and the unlink of a
// record; the stores into avant_gc_top are volatile, here and in the
// other records' inline link and unlink, so that LLVM cannot merge an
// inlined callee's unlink into the next frame's link (dead-store
// elimination), which would leave the callee's llvm.lifetime.end before
// any store that unlinks it.
pub fn ll_gc_frame_helpers(e: LlEmit) {
  e.need_intrinsic("declare i1 @llvm.expect.i1(i1, i1)")
  // The helpers call both: a frame whose every path ends in a call that
  // never returns (exit) unlinks nowhere, so nothing else declared the
  // leave.
  e.need("avant_gc_frame_enter")
  e.need("avant_gc_frame_leave")
  e.out.push_str("define internal void @__avant_frame_push(ptr %f) #0 {\nentry:\n")
  e.line("%t = load ptr, ptr @avant_gc_top, align 8")
  e.line("%c = icmp ne ptr %t, null")
  e.line("%x = call i1 @llvm.expect.i1(i1 %c, i1 true)")
  e.line("br i1 %x, label %link, label %enter")
  e.block("link")
  e.line("store ptr %t, ptr %f, align 8")
  e.line("store volatile ptr %f, ptr @avant_gc_top, align 8")
  e.line("ret void")
  e.block("enter")
  e.line("call void @avant_gc_frame_enter(ptr %f)")
  e.line("ret void")
  e.out.push_str("}\n\n")
  e.out.push_str("define internal void @__avant_frame_pop(ptr %f) #0 {\nentry:\n")
  e.line("%t = load ptr, ptr @avant_gc_top, align 8")
  e.line("%p = load ptr, ptr %f, align 8")
  e.line("%c1 = icmp eq ptr %t, %f")
  e.line("%c2 = icmp ne ptr %p, null")
  e.line("%c = and i1 %c1, %c2")
  e.line("%x = call i1 @llvm.expect.i1(i1 %c, i1 true)")
  e.line("br i1 %x, label %unlink, label %leave")
  e.block("unlink")
  e.line("store volatile ptr %p, ptr @avant_gc_top, align 8")
  e.line("ret void")
  e.block("leave")
  e.line("call void @avant_gc_frame_leave(ptr %f)")
  e.line("ret void")
  e.out.push_str("}\n\n")
}

// barrier copy _h: the holder is read once (E1); null, or a heap
// object already young or remembered, skips the call. The header's flags
// (runtime/avant_rt.h: HEAP 0x8000, YOUNG 0x20; REM 0x10) are tested with
// one masked compare: flags & 0x8030 is above 0x8000 exactly when HEAP is
// set and YOUNG or REM is (without HEAP it is at most 0x30), the same
// condition as the two tests and their `and` before, in four instructions
// where LLVM made seven. The call form when inline fast paths are off.
// When the store the barrier precedes (V13) is an element of the holder's
// buffer (`(*_h)[i]`, `(*_h)[i].j`), the call passes the slot
// (avant_barrier_slot, a large pointer buffer marks the slot's card); the
// slot's address is formed only on the call path.
pub fn ll_barrier(e: LlEmit, o: MOperand) {
  k = ll_barrier_store(e, o)
  if k >= 0 {
    e.need("avant_barrier_slot")
  } else {
    e.need("avant_barrier")
  }
  h = e.value(o)
  if !e.inline_fast {
    ll_barrier_call(e, h, k)
    return
  }
  test = e.part("test")
  call = e.part("call")
  cont = e.part("cont")
  z = e.tmp()
  e.line("${z} = icmp eq ptr ${h}, null")
  e.line("br i1 ${z}, label %${cont}, label %${test}")
  e.block(test)
  fp = e.tmp()
  e.line("${fp} = getelementptr inbounds i8, ptr ${h}, i64 -2")
  fl = e.tmp()
  e.line("${fl} = load i16, ptr ${fp}, align 2")
  // 0x8030 and 0x8000 as i16.
  mk = e.tmp()
  e.line("${mk} = and i16 ${fl}, -32720")
  skip = e.tmp()
  e.line("${skip} = icmp ugt i16 ${mk}, -32768")
  e.line("br i1 ${skip}, label %${cont}, label %${call}")
  e.block(call)
  ll_barrier_call(e, h, k)
  e.line("br label %${cont}")
  e.block(cont)
}

// The index in the current block of the store the barrier on O precedes
// when that store is an element of O's buffer, else -1.
fn ll_barrier_store(e: LlEmit, o: MOperand): Int {
  stmts = e.f.blocks[e.bk].stmts
  k = e.si + 1
  if k >= stmts.size || stmts[k].kind != msk_assign() {
    return -1
  }
  if hp = o.place, p = stmts[k].place, hp.proj.size == 0 && p.local == hp.local && p.proj.size >= 2 && p.proj[0].kind == mpk_deref() && p.proj[1].kind == mpk_index() {
    return k
  }
  -1
}

// The barrier call on holder H: with the slot of store K (formed at that
// statement's position), or the holder alone when K < 0.
fn ll_barrier_call(e: LlEmit, h: String, k: Int) {
  if k < 0 {
    e.line("call void @avant_barrier(ptr ${h})")
    return
  }
  si = e.si
  e.si = k
  if p = e.f.blocks[e.bk].stmts[k].place {
    slot = e.place_ptr(p)
    e.line("call void @avant_barrier_slot(ptr ${h}, ptr ${slot})")
  }
  e.si = si
}

// barrier_at copy _a: the unknown-holder form, always a call.
pub fn ll_barrier_at(e: LlEmit, o: MOperand) {
  e.need("avant_barrier_at")
  a = e.value(o)
  e.line("call void @avant_barrier_at(ptr ${a})")
}

// The allocation call form; returns the result value.
fn ll_alloc_call(e: LlEmit, callee: String, size: String, ty: String): String {
  e.need(callee)
  r = e.tmp()
  e.line("${r} = call ptr @${callee}(i64 ${size}, i32 ${ty})")
  r
}

// _d = call avant_alloc(size, type): the inline
// fast path, then the slow call, joined by a phi; returns the
// pointer to store into _d. A constant size and type fold the size tests
// (and choose the call form when the fast path can never be taken).
//
// The path: the cursor's new end is compared with the limit the runtime
// publishes, and when it fits the cursor is stored, the header written
// and the payload zeroed. Nothing else: the runtime publishes a null
// limit whenever the path may not run (no hole, a no-GC region, a
// collection pending; a null limit fails the compare whatever the cursor
// holds; under the stress mode a site finds the limit null or spent,
// ll_alloc_slow_helper below), it counts the bytes from the cursor at
// its next entry, takes the block record's copy of the cursor then, and
// sets a young object's start bit when a collection promotes it or a
// lookup needs it (runtime/avant_gc_alloc.c, gc_fast_publish,
// gc_alloc_sync_slow, "Late start bits"). Before, the path tested
// g_avant_shared, avant_gc_fast_ok and a null cursor before the limit,
// stored the cursor in the block's record, set the start bit and kept
// four counters (22 of its 40 instructions in a loop that allocates one
// small object).
//
// A shared module (the fast path's single-threaded condition lifted):
// every thread has its own young cursor, so the path runs on any thread.
// It reads its own limit, avant_gc_limit_mt, which the runtime also
// publishes while a thread bumps in a hole charged to it (hole
// accounting); the limit of an unshared module, avant_gc_limit, is null
// in a program with threads. And its path sets the object's start bit
// itself: the late start bits are the single mutator's (another thread
// may look an object up while its allocator is still bumping in the same
// hole). An empty payload is one word (as avant_alloc): a 0-byte object
// at a block's end would have the next block's first address as its
// payload. birth (the allocation is marked `fresh`, mir/fresh.av): stores
// into the object follow with no barrier of their own, so the slow path's
// result, which may be mature (born in mature space by
// avant_alloc_in_mature or on an unregistered thread), is barriered once:
// avant_barrier returns at once for a young object. The inline path's
// result is always young: it bumps in the thread's young hole.
//
// The slow call is the module's __avant_alloc_slow (ll_alloc_slow_helper
// below: the runtime's avant_alloc_slow, and under the stress mode the
// inline allocation itself after it).
pub fn ll_alloc(e: LlEmit, callee: String, args: Array(MOperand), birth: Bool): String {
  size = e.value(args[0])
  ty = e.value(args[1])
  const_size = args[0].kind == mok_int() && args[1].kind == mok_int()
  sz = args[0].ival
  tid = args[1].ival
  if args[0].kind == mok_int() && sz == 0 {
    sz = 8
    size = "8"
  } else if args[0].kind != mok_int() {
    z = e.tmp()
    e.line("${z} = icmp eq i64 ${size}, 0")
    s8 = e.tmp()
    e.line("${s8} = select i1 ${z}, i64 8, i64 ${size}")
    size = s8
  }
  total = "0"
  if const_size {
    tot = (sz + 15) & -8
    if !e.inline_fast || tot > 8192 || (tid == 0 && sz >= 6144) {
      return ll_alloc_birth(e, ll_alloc_call(e, callee, size, ty), birth)
    }
    total = "${tot}"
  } else if !e.inline_fast {
    return ll_alloc_birth(e, ll_alloc_call(e, callee, size, ty), birth)
  }
  e.used_alloc_globals = true
  e.need_intrinsic("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
  shared = e.m.shared
  limit = "@avant_gc_limit"
  if shared {
    limit = "@avant_gc_limit_mt"
  }
  bump = e.tmp()
  e.line("${bump} = load ptr, ptr @avant_gc_bump, align 8")
  lim = e.tmp()
  e.line("${lim} = load ptr, ptr ${limit}, align 8")
  if !const_size {
    t15 = e.tmp()
    e.line("${t15} = add i64 ${size}, 15")
    total = e.tmp()
    e.line("${total} = and i64 ${t15}, -8")
  }
  bi = e.tmp()
  e.line("${bi} = ptrtoint ptr ${bump} to i64")
  ei = e.tmp()
  e.line("${ei} = add i64 ${bi}, ${total}")
  li = e.tmp()
  e.line("${li} = ptrtoint ptr ${lim} to i64")
  go = e.tmp()
  e.line("${go} = icmp ule i64 ${ei}, ${li}")
  if !const_size {
    c5 = e.tmp()
    e.line("${c5} = icmp ule i64 ${total}, 8192")
    t0 = e.tmp()
    e.line("${t0} = icmp eq i32 ${ty}, 0")
    big = e.tmp()
    e.line("${big} = icmp uge i64 ${size}, 6144")
    both = e.tmp()
    e.line("${both} = and i1 ${t0}, ${big}")
    c6 = e.tmp()
    e.line("${c6} = xor i1 ${both}, true")
    a56 = e.tmp()
    e.line("${a56} = and i1 ${c5}, ${c6}")
    g2 = e.tmp()
    e.line("${g2} = and i1 ${go}, ${a56}")
    go = g2
  }
  fast = e.part("fast")
  slow = e.part("slow")
  cont = e.part("cont")
  e.line("br i1 ${go}, label %${fast}, label %${slow}")

  e.block(fast)
  obj = ll_alloc_take(e, bump, total, const_size, sz, tid, size, ty, shared)
  e.line("br label %${cont}")

  e.block(slow)
  e.used_alloc_slow = true
  sc = e.tmp()
  e.line("${sc} = call ptr @__avant_alloc_slow(i64 ${size}, i32 ${ty})")
  s = ll_alloc_birth(e, sc, birth)
  e.line("br label %${cont}")

  e.block(cont)
  r = e.tmp()
  e.line("${r} = phi ptr [ ${obj}, %${fast} ], [ ${s}, %${slow} ]")
  r
}

// The inline path's slow call, one per module (ll_alloc): the runtime's
// avant_alloc_slow, which is avant_alloc but for one answer, null: "the
// hole now has room for exactly this object, take it inline". Then the
// inline allocation is made here, by the same sequence the sites run
// (ll_alloc_take) with the size and the type as values and the cursor
// read again (no test: the runtime made the room). The runtime answers so
// only under AVANT_GC_STRESS=1, after the collection that mode runs
// before every allocation: the stress pass then executes the emitted
// inline sequence at every allocation the inline path serves, each with a
// collection right before it and one right after (the next allocation's),
// where before, the sequence never ran under that mode. Without the mode
// the branch on null is never taken. What the stress pass runs is this
// function's copy of the sequence; a site's own copy (its limit compare,
// a constant size and type folded into the header) does not run under
// that mode, the limit being spent whenever a site tests it;
// AVANT_GC_VERIFY=1 without the stress mode checks the headers the sites
// write. One function for the module, never inlined, and not code at
// every site: with the null answer handled at the site (a jump back into
// the inline block, or a second copy of it there) LLVM kept less of the
// code around each allocation in registers (Maze::AStar +1.5% in
// instructions, Binarytrees::Obj +0.9%); this way a site is what it was
// but for the name it calls.
pub fn ll_alloc_slow_helper(e: LlEmit) {
  e.need("avant_alloc_slow")
  e.need_intrinsic("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
  e.out.push_str("define internal ptr @__avant_alloc_slow(i64 %size, i32 %ty) noinline #0 {\nentry:\n")
  e.line("%s = call ptr @avant_alloc_slow(i64 %size, i32 %ty)")
  e.line("%again = icmp eq ptr %s, null")
  e.line("br i1 %again, label %redo, label %got")
  e.block("got")
  e.line("ret ptr %s")
  e.block("redo")
  e.line("%bump = load ptr, ptr @avant_gc_bump, align 8")
  e.line("%up = add i64 %size, 15")
  e.line("%total = and i64 %up, -8")
  obj = ll_alloc_take(e, "%bump", "%total", false, 0, 0, "%size", "%ty", e.m.shared)
  e.line("ret ptr ${obj}")
  e.out.push_str("}\n\n")
}

// The inline allocation itself, at cursor BUMP for TOTAL bytes (the
// limit allows it): the cursor's store, the header, the zeroed payload,
// and a shared module's start bit; returns the payload's address. Emitted
// at every inline site, where the limit compare passes (ll_alloc), and
// once in the module's slow-call helper, where the runtime answers null
// (ll_alloc_slow_helper).
fn ll_alloc_take(e: LlEmit, bump: String, total: String, const_size: Bool, sz: Int, tid: Int, size: String, ty: String, shared: Bool): String {
  end = e.tmp()
  e.line("${end} = getelementptr inbounds i8, ptr ${bump}, i64 ${total}")
  e.line("store ptr ${end}, ptr @avant_gc_bump, align 8")
  // The header: size | type << 32 | (HEAP | YOUNG) << 48.
  if const_size {
    hdr = (32800u64 << 48u64) | (tid.to_u64() << 32u64) | sz.to_u64()
    e.line("store i64 ${hdr.wrap_i()}, ptr ${bump}, align 8")
  } else {
    tz = e.tmp()
    e.line("${tz} = zext i32 ${ty} to i64")
    tsh = e.tmp()
    e.line("${tsh} = shl i64 ${tz}, 32")
    h1 = e.tmp()
    e.line("${h1} = or i64 ${size}, ${tsh}")
    h2 = e.tmp()
    e.line("${h2} = or i64 ${h1}, ${(32800u64 << 48u64).wrap_i()}")
    e.line("store i64 ${h2}, ptr ${bump}, align 8")
  }
  obj = e.tmp()
  e.line("${obj} = getelementptr inbounds i8, ptr ${bump}, i64 8")
  e.line("call void @llvm.memset.p0.i64(ptr ${obj}, i8 0, i64 ${size}, i1 false)")
  if shared {
    ll_alloc_start_bit(e, bump)
  }
  obj
}

// A shared module's inline allocation sets its object's start bit
// (ll_alloc): avant_gc_starts[off >> 9] |= 1 << ((off >> 3) & 63), OFF
// the header's offset from avant_gc_base.
fn ll_alloc_start_bit(e: LlEmit, bump: String) {
  base = e.tmp()
  e.line("${base} = load ptr, ptr @avant_gc_base, align 8")
  pi = e.tmp()
  e.line("${pi} = ptrtoint ptr ${bump} to i64")
  bsi = e.tmp()
  e.line("${bsi} = ptrtoint ptr ${base} to i64")
  off = e.tmp()
  e.line("${off} = sub i64 ${pi}, ${bsi}")
  st = e.tmp()
  e.line("${st} = load ptr, ptr @avant_gc_starts, align 8")
  wd = e.tmp()
  e.line("${wd} = lshr i64 ${off}, 9")
  b3 = e.tmp()
  e.line("${b3} = lshr i64 ${off}, 3")
  bit = e.tmp()
  e.line("${bit} = and i64 ${b3}, 63")
  mask = e.tmp()
  e.line("${mask} = shl i64 1, ${bit}")
  wp = e.tmp()
  e.line("${wp} = getelementptr inbounds i64, ptr ${st}, i64 ${wd}")
  old = e.tmp()
  e.line("${old} = load i64, ptr ${wp}, align 8")
  nw = e.tmp()
  e.line("${nw} = or i64 ${old}, ${mask}")
  e.line("store i64 ${nw}, ptr ${wp}, align 8")
}

// The birth barrier of an allocation's call result R (ll_alloc), when
// birth; returns R.
fn ll_alloc_birth(e: LlEmit, r: String, birth: Bool): String {
  if birth {
    e.need("avant_barrier")
    e.line("call void @avant_barrier(ptr ${r})")
  }
  r
}

// A static string's header word (runtime/avant_rt.h, AvantHeader): the
// size, N bytes and the terminator, in the low 32 bits; the type id of
// bytes (0); and the string tag (AVANT_FLAG_STRMETA, 0x4000) in the top
// 16 bits, without the heap flag.
pub fn ll_str_header(n: Int): Int {
  (0x4000 << 48) + n + 1
}

// _d = call avant_str_size(_s): a string's size, read from its object
// (runtime/avant_rt.h, AvantStrView): a flat string's header size less
// its terminator, or a view's length field (a view's header type id is
// 1020; a rare branch). A null string, which the runtime reads as empty,
// reads the header of the static empty string @str.nil instead (a
// select). A live string object never changes, so its loads are
// invariant: LLVM may hoist them out of a loop and merge two of the same
// string. The call form when inline fast paths are off.
pub fn ll_str_size(e: LlEmit, args: Array(MOperand)): String {
  e.used_str_nil = true
  e.used_tbaa = true
  e.need_intrinsic("declare i1 @llvm.expect.i1(i1, i1)")
  s = e.value(args[0])
  isn = e.tmp()
  e.line("${isn} = icmp eq ptr ${s}, null")
  q = e.tmp()
  e.line("${q} = select i1 ${isn}, ptr getelementptr inbounds (i8, ptr @str.nil, i64 8), ptr ${s}")
  isv = ll_str_is_view(e, q)
  flat = e.part("strflat")
  view = e.part("strview")
  done = e.part("strsize")
  e.line("br i1 ${isv}, label %${view}, label %${flat}")
  e.block(flat)
  h = e.tmp()
  e.line("${h} = getelementptr inbounds i8, ptr ${q}, i64 -8")
  sz = e.tmp()
  e.line("${sz} = load i32, ptr ${h}, align 8, !invariant.load !13, !range !14")
  w = e.tmp()
  e.line("${w} = zext i32 ${sz} to i64")
  n = e.tmp()
  e.line("${n} = sub nuw nsw i64 ${w}, 1")
  e.line("br label %${done}")
  e.block(view)
  lp = e.tmp()
  e.line("${lp} = getelementptr inbounds i8, ptr ${q}, i64 12")
  lv = e.tmp()
  e.line("${lv} = load i32, ptr ${lp}, align 4, !invariant.load !13, !range !12")
  lw = e.tmp()
  e.line("${lw} = zext i32 ${lv} to i64")
  e.line("br label %${done}")
  e.block(done)
  r = e.tmp()
  e.line("${r} = phi i64 [ ${n}, %${flat} ], [ ${lw}, %${view} ]")
  r
}

// Whether the string object at Q (not null) is a view: its header's type
// id (the 16 bits at Q - 4) is 1020; expected false.
fn ll_str_is_view(e: LlEmit, q: String): String {
  tp = e.tmp()
  e.line("${tp} = getelementptr inbounds i8, ptr ${q}, i64 -4")
  ty = e.tmp()
  e.line("${ty} = load i16, ptr ${tp}, align 4, !invariant.load !13")
  c = e.tmp()
  e.line("${c} = icmp eq i16 ${ty}, 1020")
  x = e.tmp()
  e.line("${x} = call i1 @llvm.expect.i1(i1 ${c}, i1 false)")
  x
}

// _d = call avant_str_flat(_s) or avant_str_c_arg(_s): a string that is
// not a view is passed on as it is (null too), with no call; a view goes
// to the runtime (lower_ffi.av c_string_arg). The call form when inline
// fast paths are off.
pub fn ll_str_unview(e: LlEmit, name: String, args: Array(MOperand)): String {
  e.used_str_nil = true
  e.used_tbaa = true
  e.need(name)
  e.need_intrinsic("declare i1 @llvm.expect.i1(i1, i1)")
  s = e.value(args[0])
  isn = e.tmp()
  e.line("${isn} = icmp eq ptr ${s}, null")
  q = e.tmp()
  e.line("${q} = select i1 ${isn}, ptr getelementptr inbounds (i8, ptr @str.nil, i64 8), ptr ${s}")
  isv = ll_str_is_view(e, q)
  head = e.label
  view = e.part("strview")
  done = e.part("strflat")
  e.line("br i1 ${isv}, label %${view}, label %${done}")
  e.block(view)
  r = e.tmp()
  e.line("${r} = call ptr @${name}(ptr ${s})")
  e.line("br label %${done}")
  e.block(done)
  p = e.tmp()
  e.line("${p} = phi ptr [ ${s}, %${head} ], [ ${r}, %${view} ]")
  p
}

// _d = call avant_str_view_test(_s): 1 when the string is a view, else 0
// (null reads the static empty string's header). The call form when
// inline fast paths are off.
pub fn ll_str_view_test(e: LlEmit, args: Array(MOperand)): String {
  e.used_str_nil = true
  e.used_tbaa = true
  e.need_intrinsic("declare i1 @llvm.expect.i1(i1, i1)")
  s = e.value(args[0])
  isn = e.tmp()
  e.line("${isn} = icmp eq ptr ${s}, null")
  q = e.tmp()
  e.line("${q} = select i1 ${isn}, ptr getelementptr inbounds (i8, ptr @str.nil, i64 8), ptr ${s}")
  isv = ll_str_is_view(e, q)
  r = e.tmp()
  e.line("${r} = zext i1 ${isv} to i32")
  r
}

// _d = call avant_str_data(_s, _v): the address of a string's bytes, used
// at once (as a `ref` to `ptr u8` cast was): a flat string's own address,
// or, when _v (the view test, avant_str_view_test) is set, a view's base
// plus its offset. The string is not null (its size was read, or the
// index proven inside it). The call form when inline fast paths are off.
pub fn ll_str_data(e: LlEmit, args: Array(MOperand)): String {
  e.used_tbaa = true
  e.need_intrinsic("declare i1 @llvm.expect.i1(i1, i1)")
  s = e.value(args[0])
  v = e.value(args[1])
  c = e.tmp()
  e.line("${c} = icmp ne i32 ${v}, 0")
  isv = e.tmp()
  e.line("${isv} = call i1 @llvm.expect.i1(i1 ${c}, i1 false)")
  head = e.label
  view = e.part("strview")
  done = e.part("strdata")
  e.line("br i1 ${isv}, label %${view}, label %${done}")
  e.block(view)
  bp = e.tmp()
  e.line("${bp} = load ptr, ptr ${s}, align 8, !invariant.load !13")
  op = e.tmp()
  e.line("${op} = getelementptr inbounds i8, ptr ${s}, i64 8")
  ov = e.tmp()
  e.line("${ov} = load i32, ptr ${op}, align 8, !invariant.load !13")
  oz = e.tmp()
  e.line("${oz} = zext i32 ${ov} to i64")
  d = e.tmp()
  e.line("${d} = getelementptr inbounds i8, ptr ${bp}, i64 ${oz}")
  e.line("br label %${done}")
  e.block(done)
  r = e.tmp()
  e.line("${r} = phi ptr [ ${s}, %${head} ], [ ${d}, %${view} ]")
  r
}

// The safepoint poll at a loop head of a shared module: a volatile load
// of the request flag (kept in every iteration), and the call, out of
// line, only when a collection is requested; the call is a collecting
// call of the MIR, so every reference live across it is in a slot and
// reloaded after it.
pub fn ll_gc_poll(e: LlEmit) {
  e.used_poll_global = true
  e.need("avant_gc_poll")
  e.need_intrinsic("declare i1 @llvm.expect.i1(i1, i1)")
  r = e.tmp()
  e.line("${r} = load volatile i32, ptr @avant_gc_requested, align 4")
  c = e.tmp()
  e.line("${c} = icmp ne i32 ${r}, 0")
  x = e.tmp()
  e.line("${x} = call i1 @llvm.expect.i1(i1 ${c}, i1 false)")
  yes = e.part("poll")
  cont = e.part("polled")
  e.line("br i1 ${x}, label %${yes}, label %${cont}")
  e.block(yes)
  e.line("call void @avant_gc_poll()")
  e.line("br label %${cont}")
  e.block(cont)
}

// The runtime globals the allocation fast path reads: the cursor
// and the module's limit, and for a shared module the block's base and
// start bits (ll_alloc). They are thread-local and local-exec, as
// avant_gc_top is: every program the compiler builds is an executable that
// links the runtime statically, so each access is one %fs-relative load or
// store; without a model (general-dynamic, which the linker relaxes) each
// address was formed apart (`mov %fs:0`, `lea`, often a copy: two or three
// instructions more per access). A shared-object output (none is built
// today; `--lib` links a C library) could not use local-exec for a
// variable another module defines: it needs initial-exec here and for
// avant_gc_top (general-dynamic in a library that is dlopen'ed), chosen by
// the driver, which knows the output kind, and passed to the emitter.
pub fn ll_alloc_globals(shared: Bool): String {
  buf = buf_new()
  buf.push_str("@avant_gc_bump = external thread_local(localexec) global ptr\n")
  if shared {
    buf.push_str("@avant_gc_limit_mt = external thread_local(localexec) global ptr\n")
    buf.push_str("@avant_gc_base = external thread_local(localexec) global ptr\n")
    buf.push_str("@avant_gc_starts = external thread_local(localexec) global ptr\n")
  } else {
    buf.push_str("@avant_gc_limit = external thread_local(localexec) global ptr\n")
  }
  buf.to_s()
}
