// The back end's driver: a final-stage MIR module to a linked program.
// In the verify mode (llvm_verify_mode) it refuses a module the
// verifier rejects at stage final (the rule's diagnostic),
// emits the .ll in memory (emit.av), compiles it with the in-process
// LLVM in the job's codegen mode (glue.av) to an object in the
// compiler's private scratch directory (pipeline.av tmp_new_dir, under
// TMPDIR; removed after the link and with the process), and links it
// with cc: the object, the runtime objects of runtime_object_names, the
// job's extra objects (std, re2c, --cc, .o), then linker_flags_s
// (-pthread -lm and the job's -l flags), -o OUT. No back-end process.
//
// Every entry returns "" on success or the message for diag_puts; the
// caller exits 1 on a message.

import source
import pipeline
import mir.ir
import mir.verify_core
import mir.verify
import llvm.glue
import llvm.emit
import std.fs
import std.process

pub class LlvmJob {
  pub codegen: String = "debug"
  // The CPU level (glue.av llvm_cpu_parse); 0 is the artifact default.
  pub cpu: Int = 0
  pub objects: Array(String) = []
  pub flags: Array(String) = []
  pub keep_ll: String = ""
  pub inline_fast: Bool = true
  pub emit_us: Int = 0
  pub compile_us: Int = 0
  pub link_us: Int = 0

  // codegen: "debug" or "release"
  // (verb_codegen's names).
  fn initialize(codegen: String) {
    self.codegen = codegen
  }
}

// The verify mode: AVANT_VERIFY=1 runs the MIR verifier at stage final
// before emission, and LLVM's verifier on the emitted module
// (runtime/avant_llvm.c). The suite (`avant test` sets it for what it
// compiles and runs), the gate, tools/letters.sh and CI turn it on; a
// user's compile skips both, since every change to the compiler passes
// them over the whole corpus there. Stage lowered's checks run on every
// compile (mir/lower.av), and `__emit-ll` verifies at stage final always.
pub fn llvm_verify_mode: Bool {
  if v = process.env("AVANT_VERIFY"), v == "1" {
    return true
  }
  false
}

// The verifier at stage final: "" or every error in the compiler's
// diagnostic form (error[V<n>] ... --> file:line:col), one after another.
pub fn llvm_verify(m: MModule): String {
  errs = mir_verify_errors(m, mst_final())
  if errs.size == 0 {
    return ""
  }
  buf = Buf.new()
  i = 0
  while i < errs.size {
    if i > 0 {
      buf.push_str("\n")
    }
    r = errs[i].render(m)
    if r.size > 0 && r[r.size - 1] == 10 {
      r = r[..r.size - 1]
    }
    buf.push_str(r)
    i += 1
  }
  buf.to_s()
}

// The .ll text of a program, and what the steps after it still need of
// the module.
class LlvmText {
  text: String = ""
  name: String = ""
  err: String = ""
  emit_us: Int = 0
}

// Verify (when verify), then emit the box's module. The module is taken
// out of the box: when this returns nothing holds it, so the collection
// that follows frees the whole MIR before the .ll text is compiled (the
// in-process LLVM then grows on top of the text alone, not of the text and
// the MIR).
fn llvm_text(box: IrBox, inline_fast: Bool, shadows: Bool, verify: Bool): LlvmText {
  r = LlvmText.new()
  if m = box.mir {
    box.mir = nil
    r.name = m.name
    if verify {
      bad = llvm_verify(m)
      if bad.size > 0 {
        r.err = bad
        return r
      }
    }
    t0 = now_us()
    r.text = ll_emit_module(m, inline_fast, shadows)
    r.emit_us = now_us() - t0
  } else {
    r.err = "internal error: the program has no module"
  }
  r
}

// The module's name ("" when the box has none).
fn box_name(box: IrBox): String {
  if m = box.mir {
    return m.name
  }
  ""
}

// The runtime's full collection that also returns every free resident
// byte to the system (gc.collect() keeps what it frees for the next
// cycle). The compiler calls it at its two phase boundaries, where what
// it frees is not needed again: the text's building needs less than the
// front end did, and LLVM allocates outside the heap.
lib gc_release {
  fun avant_gc_release
}

// Verify (in the verify mode), emit, and compile to obj_path. With job.keep_ll set, the
// pre-optimization .ll is also written there (for the goldens and the
// self-hosting fixed point). An LLVM failure after the verifier passed
// is an emitter bug, reported as an internal error. The box's module is
// dropped once its text is made; what the program's compile left dead
// (the syntax tree, the checker's tables) is collected first, and the
// module before LLVM starts, so the compiler's own heap is the text;
// each collection gives what it freed back to the system.
pub fn llvm_object(box: IrBox, job: LlvmJob, obj_path: String): String {
  gc_release.avant_gc_release()
  r = llvm_text(box, job.inline_fast, job.codegen == "release", llvm_verify_mode())
  if r.err.size > 0 {
    return r.err
  }
  job.emit_us = r.emit_us
  text = r.text
  name = r.name
  r = LlvmText.new()
  if job.keep_ll.size > 0 {
    if e = write_failure(fs.write(job.keep_ll, text)) {
      return e.message()
    }
  }
  cpu = job.cpu
  if cpu == 0 {
    cpu = llvm_cpu_default()
  }
  llvm_set_cpu(cpu)
  gc_release.avant_gc_release()
  t1 = now_us()
  err = llvm_compile_text(text, "${name}.ll", job.codegen, obj_path)
  job.compile_us = now_us() - t1
  if err.size > 0 {
    return "internal error: ${err}"
  }
  ""
}

// Emit only: the pre-optimization .ll written to ll_path
// (`avant __emit-ll`, the self-hosting fixed point), after the stage
// final verifier.
pub fn llvm_emit_ll(box: IrBox, inline_fast: Bool, ll_path: String): String {
  gc_release.avant_gc_release()
  r = llvm_text(box, inline_fast, true, true)
  if r.err.size > 0 {
    return r.err
  }
  if e = write_failure(fs.write(ll_path, r.text)) {
    return e.message()
  }
  ""
}

// Verify, emit, compile, and link the program out_path. A missing
// parent directory of out_path is created first (kept from the old
// driver: `compile x.av out/dir/x` works).
pub fn llvm_build(box: IrBox, job: LlvmJob, out_path: String): String {
  parent = llvm_out_parent(out_path)
  if parent.size > 0 && fs_mkdir_p(parent) != 0 {
    return "cannot create the output directory ${parent}"
  }
  work = tmp_new_dir()
  obj = "${work}/${box_name(box)}.o"
  err = llvm_object(box, job, obj)
  if err.size > 0 {
    return err
  }
  t0 = now_us()
  err = llvm_link(obj, job, out_path)
  job.link_us = now_us() - t0
  fs_unlink(obj)
  fs_remove_tree(work)
  err
}

// The directory part of an output path ("" when it has none, or is "/").
pub fn llvm_out_parent(out_path: String): String {
  i = out_path.size - 1
  while i > 0 {
    if out_path[i] == 47 {
      return out_path[..i]
    }
    i -= 1
  }
  ""
}

// The linker script the link adds to the default one (GNU ld and lld
// read it with -T; INSERT keeps their default script): the runtime's hot
// functions (sections .avant_hot.K.NAME, runtime/build.sh's place_hot)
// sorted by name into one output section after all other code, starting
// on a 4 KiB boundary. Placed there, a hot function moves only when a hot
// function sorted before it changes: neither the program's code, which
// stays where it was, nor the rest of the runtime moves it within its
// page.
pub fn llvm_hot_script: String {
  "SECTIONS\n{\n  .avant_hot ALIGN(4096) : { *(SORT(.avant_hot.*)) }\n}\nINSERT AFTER .text;\n"
}

// pipeline.run_cc with the output to log.
pub fn llvm_run_cc_out(args: Array(String), log: String): Int {
  if v = process.env("CC"), fs.exists(v) {
    return tool_run_out(v, args, log)
  }
  if fs.exists("/usr/bin/cc") {
    return tool_run_out("/usr/bin/cc", args, log)
  }
  wrapped: Array(String) = []
  wrapped.push("cc")
  wrapped.concat(args)
  tool_run_out("/usr/bin/env", wrapped, log)
}

// Whether the linker this link runs reads llvm_hot_script: cc with the
// link's own flags (a -fuse-ld among them, or a CC that adds one) asked
// for its linker's version (one short run before the link). GNU ld and
// lld read it; mold and gold do not, and get no script: their links keep
// each hot section as an output section of its own, where that linker
// puts an unknown code section, on no page boundary.
pub fn llvm_linker_reads_script(flags: Array(String), log: String): Bool {
  args: Array(String) = []
  args.concat(flags)
  args.push("-Wl,--version")
  ok = false
  if llvm_run_cc_out(args, log) == 0 {
    text = fs.read(log) ?? ""
    // The linker's own version line (cc prints its command lines too;
    // mold's line says it is compatible with GNU ld, so the start of the
    // line decides).
    for l in text.split("\n") {
      if l.starts_with("GNU ld ") || (l.contains("LLD ") && l.contains("compatible with GNU linkers")) {
        ok = true
      }
    }
  }
  fs_unlink(log)
  ok
}

// cc OBJ <runtime objects> <job objects> <the runtime's avant_tls.o>
// <flags> -Wl,-T,avant_hot.ld -o OUT: the hot thread-locals' object comes
// after every other object, so no other object's thread-locals come
// between them and the thread pointer (runtime/avant_tls.c); the script
// (llvm_hot_script) is written beside OBJ when the linker reads it.
pub fn llvm_link(obj: String, job: LlvmJob, out_path: String): String {
  args: Array(String) = []
  args.push(obj)
  root = avant_root()
  rt = runtime_objects(root)
  args.concat(rt)
  args.concat(job.objects)
  args.push(runtime_tls_object(root))
  extra = job.flags
  line = linker_flags_s(extra)
  words = line.split(" ")
  flags: Array(String) = []
  i = 0
  while i < words.size {
    if words[i].size > 0 {
      args.push(words[i])
      flags.push(words[i])
    }
    i += 1
  }
  dir = llvm_out_parent(obj)
  script = ""
  if llvm_linker_reads_script(flags, "${dir}/linker.txt") {
    script = "${dir}/avant_hot.ld"
    if e = write_failure(fs.write(script, llvm_hot_script())) {
      return e.message()
    }
    args.push("-Wl,-T,${script}")
  }
  args.push("-o")
  args.push(out_path)
  code = run_cc(args)
  if script.size > 0 {
    fs_unlink(script)
  }
  if code != 0 {
    return "link failed: cc exited ${code}"
  }
  ""
}

