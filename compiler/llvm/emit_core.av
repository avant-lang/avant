// The LLVM emitter's core: the emitter state, LLVM type and constant
// texts, symbols, and the two primitives every statement is built from: a
// place's address and an operand's value. Rule E1 is structural here: an
// operand is loaded from its local at the point of use, once per
// occurrence, and no LLVM value is kept across MIR statements (only inside
// one statement's expansion). Rule E2: every load and store of a slot is
// plain (slot_vol), in a shared module too; before, a shared module's slot
// accesses were volatile, because another thread's collection could read
// and rewrite them at any instruction. emit_gc.av holds the GC sequences,
// emit.av the statements, functions, and the module.
//
// Kept within what an older seed's type maps traced (see
// compiler/checker.av, FlowFacts): LlEmit holds 27 words; no array of
// structs or unions.

import source
import mir.types
import mir.runtime
import mir.ir
import mir.print
import mir.verify_core
import llvm.glue

pub class LlEmit {
  pub m: MModule
  pub ts: MTypes
  pub v: MVerifier
  pub f: MFunc
  pub out: Buf
  pub tn: Int = 0
  pub label: String = ""
  pub bk: Int = 0
  pub si: Int = 0
  pub inline_fast: Bool = true
  pub used_alloc_globals: Bool = false
  pub used_alloc_slow: Bool = false
  pub used_poll_global: Bool = false
  pub used_proof_global: Bool = false
  pub used_frame_global: Bool = false
  pub used_frame_helpers: Bool = false
  pub used_str_nil: Bool = false
  pub used_buf_nil: Bool = false
  pub frame_words: Int = -1
  pub frame_at: Array(Int)
  pub frame_align: Int = 8
  pub frame_desc: String = ""
  pub frame_maps: Array(String)
  pub cur_file: Int = 0
  pub cur_line: Int = 0
  pub cur_col: Int = 0
  pub tlocs: Array(String)
  tloc_seen: Hash(String, Int)
  pub trap_ovf: Bool = false
  pub trap_div0: Bool = false
  // The function's arithmetic trap blocks, one per kind and source line
  // (ll_arith_trap): "ovf FILE LINE" or "div0 FILE LINE", the column of
  // the line's first check (-1 when its checks have several), and the
  // index of each key.
  pub arith_keys: Array(String)
  pub arith_cols: Array(Int)
  arith_seen: Hash(String, Int)
  pub trap_bounds: Bool = false
  pub used_stubs: Bool = false
  pub rt_names: Array(String)
  rt_seen: Hash(String, Int)
  pub intrinsics: Array(String)
  intr_seen: Hash(String, Int)
  pa_ty: Int = 0
  pub pa_vol: Bool = false
  pub pa_tbaa: String = ""
  pub pa_atomic: Bool = false
  pub pa_size: Bool = false
  pub used_tbaa: Bool = false
  pub loop_md: Hash(String, Int)
  pub loop_md_n: Int = 0
  pub ov_ty: Int = 0
  // What LLVM is told about the constants computed before main
  // (ll_const_facts): the functions the start-up reaches, which read
  // the slots plainly; whether a constant object's own fields may be
  // marked (no C function is handed a reference); in the function being
  // emitted, the locals holding a slot's address and those holding the
  // value loaded from one; for the place just formed, the type a slot
  // holds (-1 when it is no slot) and whether it is a constant object's
  // field.
  pub startup_reach: Set(String) = Set(String).new()
  pub const_fields: Bool = false
  pub cslots: Set(Int) = Set(Int).new()
  pub cvals: Set(Int) = Set(Int).new()
  pa_cslot: Int = -1
  pa_cfield: Bool = false

  fn initialize(m: MModule) {
    self.m = m
    self.ts = m.types
    self.v = MVerifier.new(m, mst_final())
    self.f = MFunc.new("", 0, mir_loc0())
    self.out = buf_new()
    self.label = ""
    self.rt_names = []
    self.rt_seen = Hash(String, Int).new()
    self.intrinsics = []
    self.intr_seen = Hash(String, Int).new()
    self.loop_md = Hash(String, Int).new()
    self.loop_md_n = ll_tbaa_last()
    self.frame_at = []
    self.frame_maps = []
    self.tlocs = []
    self.tloc_seen = Hash(String, Int).new()
    self.arith_keys = []
    self.arith_cols = []
    self.arith_seen = Hash(String, Int).new()
  }

  // A new function: no arithmetic trap blocks yet.
  pub fn arith_reset {
    self.arith_keys = []
    self.arith_cols = []
    self.arith_seen = Hash(String, Int).new()
  }

  // The index of the arithmetic trap block of kind ("ovf", "div0") for
  // the statement being emitted's line.
  pub fn arith_block(kind: String): Int {
    key = "${kind} ${self.cur_file} ${self.cur_line}"
    if got = self.arith_seen.get(key) {
      if self.arith_cols[got] != self.cur_col {
        self.arith_cols[got] = -1
      }
      return got
    }
    n = self.arith_keys.size
    self.arith_seen[key] = n
    self.arith_keys.push(key)
    self.arith_cols.push(self.cur_col)
    n
  }

  // The source site of the statement being emitted, for a trap's
  // message.
  pub fn site(loc: MLoc) {
    self.cur_file = loc.file()
    self.cur_line = loc.line()
    self.cur_col = loc.col()
  }

  // The site's number N in the module's table of trap texts,
  // @__avant_trap_sites ("file:line:col", one entry per text), the last
  // argument of a trap's _at form. An immediate, not the text's
  // address: a constant address in a cold block was hoisted into hot
  // loops as a live register (+5.8% instructions on Maze::AStar).
  pub fn site_ref: String {
    path = "?"
    if self.cur_file >= 0 && self.cur_file < self.m.files.size {
      path = self.m.files[self.cur_file]
    }
    text_ref("${path}:${self.cur_line}:${self.cur_col}")
  }

  // A trap text's number in the module's table (one per text).
  pub fn text_ref(text: String): String {
    n = self.tlocs.size
    if got = self.tloc_seen.get(text) {
      n = got
    } else {
      self.tloc_seen[text] = n
      self.tlocs.push(text)
    }
    "${n}"
  }

  // ---- output

  // One instruction line, indented two spaces.
  pub fn line(s: String) {
    self.out.push_str("  ")
    self.out.push_str(s)
    self.out.push_str("\n")
  }

  // A new LLVM block: a blank line, then `name:`.
  pub fn block(name: String) {
    self.out.push_str("\n")
    self.out.push_str(name)
    self.out.push_str(":\n")
    self.label = name
  }

  // A fresh temporary, %t<n> per function.
  pub fn tmp: String {
    n = self.tn
    self.tn += 1
    "%t${n}"
  }

  // The label of a block the current statement expands into:
  // bb<k>.s<i>.<part>, i the statement's index in its MIR block.
  pub fn part(name: String): String {
    "bb${self.bk}.s${self.si}.${name}"
  }

  // A runtime entry point the emitter itself calls (declared once).
  pub fn need(name: String) {
    if got = self.rt_seen.get(name) {
      return
    }
    self.rt_seen[name] = self.rt_names.size
    self.rt_names.push(name)
  }

  // An intrinsic, with its full declaration text.
  pub fn need_intrinsic(decl: String) {
    if got = self.intr_seen.get(decl) {
      return
    }
    self.intr_seen[decl] = self.intrinsics.size
    self.intrinsics.push(decl)
  }

  // ---- types and constants

  // The LLVM type of a MIR type.
  pub fn llt(ty: Int): String {
    ll_type_text(self.ts, ty)
  }

  pub fn align(ty: Int): Int {
    self.ts.align_of(ty)
  }

  // The zero of a type.
  pub fn zero_text(ty: Int): String {
    k = self.ts.kind(ty)
    if k == mk_bool() {
      return "false"
    }
    if k == mk_int() {
      return "0"
    }
    if k == mk_f64() {
      return "0.0"
    }
    if k == mk_agg() {
      return "zeroinitializer"
    }
    "null"
  }

  // An integer constant of type ty as LLVM reads it: two's complement
  // signed decimal of the type's width.
  pub fn int_text(ty: Int, x: Int): String {
    mt = self.ts.get(ty)
    width = mt.bits
    if self.ts.kind(ty) == mk_bool() {
      if x != 0 {
        return "true"
      }
      return "false"
    }
    if width == 32 && x >= 2147483648 {
      return "${x - 4294967296}"
    }
    if width == 16 && x >= 32768 {
      return "${x - 65536}"
    }
    if width == 8 && x >= 128 {
      return "${x - 256}"
    }
    "${x}"
  }

  // ---- locals and places

  // The alloca of local n: %_<n> or %_<n>.<source name>.
  pub fn local_name(n: Int): String {
    name = self.f.locals[n].name
    if name.size == 0 {
      return "%_${n}"
    }
    ll_local("_${n}.${name}")
  }

  // The address of local n where it is used: its alloca, or, for a slot
  // local, its place in the frame record (emit_gc.av), a GEP of %gcf
  // emitted here, in the using block. At --debug FastISel folds such a GEP
  // into the access's frame address; one GEP made in the entry block
  // would be a value spilled there and reloaded at every use in another
  // block (the compiler compiling itself --debug took 2.5% more
  // instructions so). -O3 merges the repeated GEPs.
  pub fn local_addr(n: Int): String {
    if self.frame_words >= 0 && n < self.frame_at.size && self.frame_at[n] >= 0 {
      t = tmp()
      line("${t} = getelementptr inbounds i8, ptr %gcf, i64 ${self.frame_at[n]}")
      return t
    }
    local_name(n)
  }

  // Rule E2: no slot access is volatile. A collection reads and rewrites
  // a thread's slots only while that thread is stopped at a safepoint (a
  // collecting call, the poll) or native (inside a call), in a shared
  // module as in a single-threaded one (the collector's safepoint
  // handshake); the slot's address escapes to the runtime at gc.roots, so
  // LLVM must assume every such call reads and writes the slot, and the
  // reload rule (after a collecting call, each use of a slot loads it
  // afresh) rereads it after the call anyway. (volatile only in
  // a shared module, where another thread's collection could touch the
  // slot at any instruction.)
  pub fn slot_vol(local: Int): Bool {
    false
  }

  pub fn vol(volatile: Bool): String {
    if volatile {
      return " volatile"
    }
    ""
  }

  pub fn load(ty: Int, ptr: String, volatile: Bool): String {
    load_tagged(ty, ptr, volatile, "")
  }

  // A load with an alias tag (", !tbaa !N", or "" for none).
  pub fn load_tagged(ty: Int, ptr: String, volatile: Bool, tag: String): String {
    if tag.size > 0 {
      self.used_tbaa = true
    }
    t = self.tmp()
    line("${t} = load${vol(volatile)} ${llt(ty)}, ptr ${ptr}, align ${align(ty)}${tag}")
    t
  }

  pub fn store(ty: Int, val: String, ptr: String, volatile: Bool) {
    store_tagged(ty, val, ptr, volatile, "")
  }

  pub fn store_tagged(ty: Int, val: String, ptr: String, volatile: Bool, tag: String) {
    line("store${vol(volatile)} ${llt(ty)} ${val}, ptr ${ptr}, align ${align(ty)}${tag}")
  }

  // The address of a place (E5), emitting the loads and GEPs it needs.
  // Sets pa_ty (the place's type), pa_vol (E2: no deref and the local
  // is a slot), pa_tbaa (the access's alias tag, ll_tbaa_tag) and
  // pa_atomic (an Array header's capacity word, whose loads are atomic:
  // see ll_tbaa_last). An index operand is evaluated where its projection
  // is.
  pub fn place_ptr(p: MPlace): String {
    ptr = local_addr(p.local)
    ty = self.f.locals[p.local].ty
    volatile = slot_vol(p.local)
    // The memory the place is in, from its last deref: 0 a local, 1 an
    // element of an element buffer, 2 + f field f of an Array or Buf
    // header, 5 a field of a class or record object (and anything inside
    // that field), -1 anything else (untagged). pend: what the last
    // deref reached (1 an element buffer, 2 an Array or Buf header, 3 a
    // class or record object, -1 other), decided by the projection that
    // follows it.
    region = 0
    pend = 0
    arr = false
    self.pa_cslot = -1
    self.pa_cfield = false
    if self.cslots.size > 0 {
      const_place(p, ty)
    }
    for pr in p.proj {
      mt = self.ts.get(ty)
      if pr.kind == mpk_deref() {
        ptr = load_tagged(mt_ptr(), ptr, volatile, ll_tbaa_tag(region))
        volatile = false
        region = -1
        pend = -1
        if self.ts.is_refkind(ty) && mt.layout >= 0 {
          lk = self.ts.layouts[mt.layout].kind
          arr = lk == mlk_array()
          if lk == mlk_elems() {
            pend = 1
          } else if lk == mlk_array() || lk == mlk_buf() {
            pend = 2
          } else if lk == mlk_class() || lk == mlk_record() {
            pend = 3
          }
          ty = self.ts.agg(mt.layout)
        } else {
          ty = mt.pointee
        }
      } else if pr.kind == mpk_field() {
        t = self.tmp()
        line("${t} = getelementptr inbounds ${llt(ty)}, ptr ${ptr}, i32 0, i32 ${pr.field}")
        ptr = t
        ty = self.ts.layouts[mt.layout].fields[pr.field]
        if pend == 2 {
          region = 2 + pr.field
        } else if pend == 3 {
          region = 5
        } else if region > 1 && region != 5 {
          region = -1
        }
        pend = 0
      } else {
        et = ty
        if mt.kind == mk_agg() && (self.ts.layouts[mt.layout].kind == mlk_elems() || self.ts.layouts[mt.layout].kind == mlk_carray()) {
          et = self.ts.layouts[mt.layout].fields[0]
        }
        idx = "0"
        if o = pr.index {
          idx = index64(o)
        }
        t = self.tmp()
        line("${t} = getelementptr inbounds ${llt(et)}, ptr ${ptr}, i64 ${idx}")
        ptr = t
        ty = et
        if pend == 1 {
          region = 1
        } else if region > 1 && region != 5 {
          region = -1
        }
        pend = 0
      }
    }
    self.pa_ty = ty
    self.pa_vol = volatile
    self.pa_atomic = region == 4 && arr
    self.pa_size = region == 3
    self.pa_tbaa = ll_tbaa_tag(region)
    if self.pa_tbaa.size > 0 {
      self.used_tbaa = true
    }
    ptr
  }

  // A read of a constant computed before main (ll_const_facts): `*_a`
  // with _a a slot's address, or a field of the object loaded from one
  // (`(*_v).f`): an Array's buffer reference or size (not its capacity
  // word, which a task's freeze counts in), or any field of a class
  // object (none is assigned outside initialize).
  fn const_place(p: MPlace, ty: Int) {
    if p.proj.size == 1 && p.proj[0].kind == mpk_deref() && self.cslots.has(p.local) {
      self.pa_cslot = self.ts.get(ty).pointee
      return
    }
    if self.const_fields && p.proj.size == 2 && p.proj[0].kind == mpk_deref() && p.proj[1].kind == mpk_field() && self.cvals.has(p.local) {
      l = self.ts.get(ty).layout
      if l >= 0 {
        lk = self.ts.layouts[l].kind
        self.pa_cfield = lk == mlk_class() || (lk == mlk_array() && p.proj[1].field < 2)
      }
    }
  }

  // The marks of such a read: the slot's value never changes after the
  // start-up (its object is pinned) and, a reference, is never null and
  // spans its layout; a pinned constant object's field never changes.
  fn const_marks: String {
    t = ", !invariant.load !13"
    if self.pa_cslot >= 0 && self.ts.is_refkind(self.pa_cslot) {
      t = "${t}, !nonnull !13, !align !{i64 8}"
      l = self.ts.get(self.pa_cslot).layout
      if l >= 0 && self.ts.layouts[l].size > 0 {
        t = "${t}, !dereferenceable !{i64 ${self.ts.layouts[l].size}}"
      }
    }
    t
  }

  // An index operand as i64 (sign-extended from i32).
  fn index64(o: MOperand): String {
    if o.kind == mok_int() {
      return "${o.ival}"
    }
    x = value(o)
    if self.ov_ty == mt_i64() {
      return x
    }
    t = self.tmp()
    line("${t} = sext i32 ${x} to i64")
    t
  }

  // The type of a place without emitting anything.
  pub fn place_type(p: MPlace): Int {
    self.v.place_ty(p, self.bk, self.si, mir_loc0())
  }

  // ---- operands

  // The value of an operand; sets ov_ty to its type. `copy P` loads P
  // here (E1); constants are immediate.
  pub fn value(o: MOperand): String {
    if p = o.place {
      ptr = place_ptr(p)
      ty = self.pa_ty
      if self.pa_atomic {
        x = self.tmp()
        line("${x} = load atomic ${llt(ty)}, ptr ${ptr} monotonic, align ${align(ty)}")
        self.ov_ty = ty
        return x
      }
      tag = self.pa_tbaa
      if self.pa_size {
        tag = tag + ll_size_range()
      }
      if self.pa_cslot >= 0 || self.pa_cfield {
        tag = tag + const_marks()
      }
      x = load_tagged(ty, ptr, self.pa_vol, tag)
      self.ov_ty = ty
      return x
    }
    self.ov_ty = self.v.op_ty(o, self.bk, self.si, mir_loc0())
    k = o.kind
    if k == mok_int() || k == mok_bool() {
      return int_text(o.ty, o.ival)
    }
    if k == mok_f64() {
      return llvm_f64_text(o.ival)
    }
    if k == mok_null() {
      return "null"
    }
    if k == mok_str() {
      return "getelementptr inbounds (i8, ptr @str.${o.sid}, i64 8)"
    }
    ll_sym(o.text)
  }

  // `<type> <value>` of an operand, as an argument.
  pub fn typed(o: MOperand): String {
    x = value(o)
    "${llt(self.ov_ty)} ${x}"
  }
}

pub fn ll_type_text(ts: MTypes, ty: Int): String {
  k = ts.kind(ty)
  if k == mk_void() {
    return "void"
  }
  if k == mk_bool() {
    return "i1"
  }
  if k == mk_int() {
    return "i${ts.get(ty).bits}"
  }
  if k == mk_f64() {
    if ts.get(ty).bits == 32 {
      return "float"
    }
    return "double"
  }
  if k == mk_agg() {
    return ll_type_name(ts.layouts[ts.get(ty).layout].name)
  }
  "ptr"
}

// Type-based alias tags. Five kinds of memory are told apart: a local
// (an alloca: a collector's slot among them, whose address the frame
// hands to the runtime), an element of an element buffer (any element
// type, reached through a buffer reference: `(*data)[i]` and its fields),
// an Array or Buf header's buffer reference, its size, and a field of a
// class or record object (an object, a captured variable's box, a
// closure's environment, a task's record; with whatever lies inside the
// field: a struct's fields, a union's parts). Heap memory never shares
// bytes with a local (no heap reference points into a frame), an object,
// a header and an element buffer are distinct allocations (no object or
// header is laid out inside another allocation), and a header's two
// fields never share bytes with each other. So LLVM may keep a slot's
// value, a buffer reference, a size or an object's field in a register
// across a store to another kind: the reloads a loop otherwise does after
// every store. One tag serves every object layout, so a parent's and a
// child's view of one object, or a generic one, always may alias. Every
// other access (a Hash's or a String's header, which only the runtime's
// calls read; a raw pointer's; a local's or a field's through its
// address) is untagged and may alias anything. The capacity stays
// untagged: it also holds the count of tasks that hold the array, which
// other threads update. A collection moves a buffer or an object and
// rewrites the header, the fields and the slots only inside a call (a
// collecting call, the poll, a native region), and a buffer grows only
// inside the runtime's calls: LLVM assumes any such call may write any of
// this memory, whatever the tags say, so no tag lets a reference outlive
// a move.
//
// An Array's capacity word is read with an atomic (monotonic) load, a
// plain mov on x86: while tasks hold the array it holds their count, and
// a task's end changes it with a compare-and-swap from that task's
// thread (avant_array_thaw). The thread that owns the array reads it in
// the frozen check before a change it makes through another name; when
// that read is not ordered after the task's end (no join yet) it races
// with the swap, and a plain load that races with a store is undefined
// in LLVM's model. Reading it atomically makes the race a choice between
// two defined values (the program traps, or the change goes ahead after
// the task ended) and keeps every later fact about other memory from
// letting LLVM merge or hoist the read. Stores stay plain: generated code
// writes the word only into a new array, before any task can hold it.
pub fn ll_tbaa_last: Int { 14 }

// An Array's or Buf's size is never negative (at most the runtime's
// ceiling, 2^31 - 1, avant_size_check), so its loads carry the range
// [0, 2^31): LLVM may then drop a sign extension's cost, prove an index
// below the size non-negative and fold bounds checks against it.
pub fn ll_size_range: String {
  ", !range !12"
}

// The tag of an access to region (place_ptr): 0 a local, 1 an element, 2
// a header's buffer reference, 3 its size, 5 an object's field; "" for
// any other.
pub fn ll_tbaa_tag(region: Int): String {
  if region == 5 {
    return ", !tbaa !11"
  }
  if region == 0 {
    return ", !tbaa !9"
  }
  if region == 1 {
    return ", !tbaa !3"
  }
  if region == 2 {
    return ", !tbaa !5"
  }
  if region == 3 {
    return ", !tbaa !7"
  }
  ""
}

pub fn ll_tbaa_nodes: String {
  "!1 = !{!\"avant alias\"}\n!2 = !{!\"element\", !1, i64 0}\n!3 = !{!2, !2, i64 0}\n!4 = !{!\"buffer reference\", !1, i64 0}\n!5 = !{!4, !4, i64 0}\n!6 = !{!\"size\", !1, i64 0}\n!7 = !{!6, !6, i64 0}\n!8 = !{!\"local\", !1, i64 0}\n!9 = !{!8, !8, i64 0}\n!10 = !{!\"object field\", !1, i64 0}\n!11 = !{!10, !10, i64 0}\n!12 = !{i32 0, i32 -2147483648}\n!13 = !{}\n!14 = !{i32 1, i32 -2147483647}\n"
}

pub fn mir_loc0: MLoc {
  mir_loc(0, 0, 0)
}

// LLVM's unquoted identifier characters: [-a-zA-Z$._0-9], not a leading
// digit.
pub fn ll_plain(s: String): Bool {
  if s.size == 0 {
    return false
  }
  for i in 0..s.size {
    c = s[i]
    ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 45 || c == 36 || c == 46 || c == 95
    if !ok && c >= 48 && c <= 57 {
      ok = i > 0
    }
    if !ok {
      return false
    }
  }
  true
}

// A global symbol: mangled names are always quoted; C names bare
// when LLVM allows it.
pub fn ll_sym(name: String): String {
  if name.starts_with("av.") || !ll_plain(name) {
    return "@\"${name}\""
  }
  "@${name}"
}

pub fn ll_local(name: String): String {
  if ll_plain(name) {
    return "%${name}"
  }
  "%\"${name}\""
}

// A layout's LLVM struct type: always quoted.
pub fn ll_type_name(name: String): String {
  "%\"${name}\""
}
