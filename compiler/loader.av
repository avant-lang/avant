import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser

pub fn path_basename(path: String): String {
  i = path.size - 1
  while i >= 0 {
    if path[i] == 47 {
      return str_slice(path, i + 1, path.size)
    }
    i = i - 1
  }
  path
}

pub fn path_dirname(path: String): String {
  i = path.size - 1
  while i >= 0 {
    if path[i] == 47 {
      if i == 0 {
        return "/"
      }
      return str_slice(path, 0, i)
    }
    i = i - 1
  }
  "."
}

pub fn module_name_of(path: String): String {
  base = path_basename(path)
  if base.size > 3 {
    n = base.size
    if base[n - 3] == 46 {
      if base[n - 2] == 97 {
        if base[n - 1] == 118 {
          return str_slice(base, 0, n - 3)
        }
      }
    }
  }
  base
}

pub fn child_av_path(importer: String, name: String): String {
  dir = path_dirname(importer)
  if str_eq(dir, ".") {
    return "${name}.av"
  }
  "${dir}/${name}.av"
}

pub fn path_under(dir: String, path: String): Bool {
  if str_eq(dir, ".") {
    if path.size == 0 {
      return false
    }
    if path[0] == 47 {
      return false
    }
    return true
  }
  prefix = dir.size
  if path.size <= prefix {
    return false
  }
  if str_eq(str_slice(path, 0, prefix), dir) {
    if path[prefix] == 47 {
      return true
    }
  }
  false
}

pub fn join_dir(dir: String, rel: String): String {
  if str_eq(dir, ".") {
    return rel
  }
  if str_eq(dir, "/") {
    return "/${rel}"
  }
  "${dir}/${rel}"
}

pub fn import_rel(name: String): String {
  buf = buf_new()
  i = 0
  while i < name.size {
    if name[i] == 46 {
      buf.push_str("/")
    } else {
      buf.push_str(str_slice(name, i, i + 1))
    }
    i = i + 1
  }
  buf.push_str(".av")
  buf.to_s
}

pub fn rel_module_name(dir: String, path: String): String {
  rel = path
  if str_eq(dir, ".") {
  } else {
    if path_under(dir, path) {
      rel = str_slice(path, dir.size + 1, path.size)
    }
  }
  if rel.size > 3 {
    n = rel.size
    if rel[n - 3] == 46 {
      if rel[n - 2] == 97 {
        if rel[n - 1] == 118 {
          rel = str_slice(rel, 0, n - 3)
        }
      }
    }
  }
  buf = buf_new()
  i = 0
  while i < rel.size {
    if rel[i] == 47 {
      buf.push_str(".")
    } else {
      buf.push_str(str_slice(rel, i, i + 1))
    }
    i = i + 1
  }
  buf.to_s
}

pub fn find_manifest(start: String): String {
  dir = start
  guard = 0
  while guard < 64 {
    guard = guard + 1
    cand = "avant.toml"
    if str_eq(dir, ".") {
    } else {
      cand = "${dir}/avant.toml"
    }
    if file_exists(cand) {
      return dir
    }
    if str_eq(dir, ".") {
      return ""
    }
    parent = path_dirname(dir)
    if str_eq(parent, dir) {
      return ""
    }
    dir = parent
  }
  ""
}

pub fn hit_listed(list: Array(String), path: String): Bool {
  i = 0
  while i < list.size {
    if str_eq(list[i], path) {
      return true
    }
    i = i + 1
  }
  false
}

pub fn tag_module(program: Program, name: String, path: String) {
  program.module_name = name
  program.module_path = path
  i = 0
  while i < program.structs.size {
    sdef = program.structs[i]
    sdef.mod_name = name
    j = 0
    while j < sdef.methods.size {
      sdef.methods[j].mod_name = name
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.classes.size {
    cdef = program.classes[i]
    cdef.mod_name = name
    j = 0
    while j < cdef.methods.size {
      cdef.methods[j].mod_name = name
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.functions.size {
    program.functions[i].mod_name = name
    i = i + 1
  }
  i = 0
  while i < program.interfaces.size {
    idef = program.interfaces[i]
    idef.mod_name = name
    j = 0
    while j < idef.methods.size {
      idef.methods[j].mod_name = name
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.opt_ins.size {
    program.opt_ins[i].mod_name = name
    i = i + 1
  }
  i = 0
  while i < program.libs.size {
    lib_def = program.libs[i]
    lib_def.mod_name = name
    j = 0
    while j < lib_def.layouts.size {
      lib_def.layouts[j].mod_name = name
      lib_def.layouts[j].vis = lib_def.vis
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.quotes.size {
    q = program.quotes[i]
    q.mod_name = name
    j = 0
    while j < q.functions.size {
      q.functions[j].mod_name = name
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.comptimes.size {
    c = program.comptimes[i]
    c.mod_name = name
    c.qdecl.mod_name = name
    j = 0
    while j < c.qdecl.functions.size {
      c.qdecl.functions[j].mod_name = name
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.structs.size {
    sdef = program.structs[i]
    j = 0
    while j < sdef.quotes.size {
      q = sdef.quotes[j]
      q.mod_name = name
      k = 0
      while k < q.functions.size {
        q.functions[k].mod_name = name
        k = k + 1
      }
      j = j + 1
    }
    j = 0
    while j < sdef.comptimes.size {
      c = sdef.comptimes[j]
      c.mod_name = name
      c.qdecl.mod_name = name
      k = 0
      while k < c.qdecl.functions.size {
        c.qdecl.functions[k].mod_name = name
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  i = 0
  while i < program.classes.size {
    cdef = program.classes[i]
    j = 0
    while j < cdef.quotes.size {
      q = cdef.quotes[j]
      q.mod_name = name
      k = 0
      while k < q.functions.size {
        q.functions[k].mod_name = name
        k = k + 1
      }
      j = j + 1
    }
    j = 0
    while j < cdef.comptimes.size {
      c = cdef.comptimes[j]
      c.mod_name = name
      c.qdecl.mod_name = name
      k = 0
      while k < c.qdecl.functions.size {
        c.qdecl.functions[k].mod_name = name
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
}

pub fn path_in_list(list: Array(String), path: String): Bool {
  i = 0
  while i < list.size {
    if str_eq(list[i], path) {
      return true
    }
    i = i + 1
  }
  false
}

pub class Loader {
  loaded: Hash(String, Int)
  programs: Array(Program)
  stack: Array(String)
  order: Array(String)
  mods: Array(ModInfo)
  failed: Bool = false
  err: CompileError? = nil
  errors: DiagBag
  dep_dirs: Array(String)
  project_dir: String = ""
  manifest_dir: String = ""
  mod_paths: Hash(String, String)

  fn initialize {
    h = Hash(String, Int).new
    self.loaded = h
    p: Array(Program) = []
    self.programs = p
    st: Array(String) = []
    self.stack = st
    o: Array(String) = []
    self.order = o
    m: Array(ModInfo) = []
    self.mods = m
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new
    dd: Array(String) = []
    self.dep_dirs = dd
    self.project_dir = ""
    self.manifest_dir = ""
    mp = Hash(String, String).new
    self.mod_paths = mp
  }

  pub fn setup_deps(root_path: String) {
    self.project_dir = path_dirname(root_path)
    self.manifest_dir = find_manifest(self.project_dir)
    deps_at = self.project_dir
    if self.manifest_dir.size > 0 {
      deps_at = self.manifest_dir
    }
    deps_root = "${deps_at}/deps"
    entries = dir_list(deps_root)
    i = 0
    while i < entries.size {
      full = "${deps_root}/${entries[i]}"
      if file_exists("${full}/.git") {
        self.dep_dirs.push(full)
      } else if file_exists("${full}/avant.toml") {
        self.dep_dirs.push(full)
      }
      i = i + 1
    }
  }

  pub fn dep_root_of(path: String): String {
    i = 0
    while i < self.dep_dirs.size {
      if path_under(self.dep_dirs[i], path) {
        return self.dep_dirs[i]
      }
      i = i + 1
    }
    ""
  }

  pub fn logical_name(path: String): String {
    dep = self.dep_root_of(path)
    if dep.size > 0 {
      return rel_module_name(dep, path)
    }
    if path_under(self.project_dir, path) {
      return rel_module_name(self.project_dir, path)
    }
    if str_eq(path_dirname(path), self.project_dir) {
      return rel_module_name(self.project_dir, path)
    }
    if self.manifest_dir.size > 0 {
      if path_under(self.manifest_dir, path) {
        return rel_module_name(self.manifest_dir, path)
      }
      if str_eq(path_dirname(path), self.manifest_dir) {
        return rel_module_name(self.manifest_dir, path)
      }
    }
    module_name_of(path)
  }

  pub fn consider_hit(hits: Array(String), path: String) {
    if file_exists(path) {
      if hit_listed(hits, path) {
      } else {
        hits.push(path)
      }
    }
  }

  pub fn resolve_import(importer: String, name: String, loc: Location): String {
    rel = import_rel(name)
    hits: Array(String) = []
    dep = self.dep_root_of(importer)
    if dep.size > 0 {
      self.consider_hit(hits, join_dir(path_dirname(importer), rel))
      self.consider_hit(hits, join_dir(dep, rel))
      i = 0
      while i < self.dep_dirs.size {
        if str_eq(self.dep_dirs[i], dep) {
        } else {
          self.consider_hit(hits, join_dir(self.dep_dirs[i], rel))
        }
        i = i + 1
      }
    } else {
      self.consider_hit(hits, join_dir(path_dirname(importer), rel))
      self.consider_hit(hits, join_dir(self.project_dir, rel))
      if self.manifest_dir.size > 0 {
        self.consider_hit(hits, join_dir(self.manifest_dir, rel))
      }
      i = 0
      while i < self.dep_dirs.size {
        self.consider_hit(hits, join_dir(self.dep_dirs[i], rel))
        i = i + 1
      }
    }
    if hits.size == 0 {
      anchor = self.project_dir
      if self.manifest_dir.size > 0 {
        anchor = self.manifest_dir
      }
      if file_exists("${anchor}/avant.toml") {
        self.fail(loc, "cannot find ${name}.av next to ${importer} or in fetched deps (run: avant fetch ${anchor})")
      } else {
        if file_exists("${self.project_dir}/avant.toml") {
          self.fail(loc, "cannot find ${name}.av next to ${importer} or in fetched deps (run: avant fetch ${self.project_dir})")
        } else {
          self.fail(loc, "cannot find ${name}.av next to ${importer}")
        }
      }
      return ""
    }
    if hits.size > 1 {
      buf = buf_new()
      buf.push_str("import ${name} is ambiguous:")
      i = 0
      while i < hits.size {
        buf.push_str(" ${hits[i]}")
        i = i + 1
      }
      self.fail(loc, buf.to_s)
      return ""
    }
    hits[0]
  }

  pub fn note_module_path(name: String, path: String, loc: Location) {
    if prev = self.mod_paths.get(name) {
      if str_eq(prev, path) {
      } else {
        self.fail(loc, "module ${name} is both ${prev} and ${path}")
      }
    } else {
      self.mod_paths[name] = path
    }
  }

  pub fn dep_child(name: String): String {
    hit = ""
    hits = 0
    i = 0
    while i < self.dep_dirs.size {
      cand = "${self.dep_dirs[i]}/${name}.av"
      if file_exists(cand) {
        hits = hits + 1
        hit = cand
      }
      i = i + 1
    }
    if hits == 1 {
      return hit
    }
    if hits > 1 {
      return "ambiguous:${hits}"
    }
    ""
  }

  pub fn fail(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(5, message), message)
    if self.errors.count == 0 {
      self.err = e
    }
    self.failed = true
    self.errors.push(e)
  }

  pub fn absorb(bag: DiagBag) {
    i = 0
    while i < bag.items.size {
      e = bag.items[i]
      if self.errors.count == 0 {
        self.err = e
      }
      self.failed = true
      self.errors.push(e)
      i = i + 1
    }
    self.errors.suppressed = self.errors.suppressed + bag.suppressed
  }

  pub fn err_count: Int {
    self.errors.count
  }

  pub fn load_root(path: String): Program? {
    if file_exists(path) {
    } else {
      self.fail(Location.new(path, 1, 1, 0), "cannot read ${path}")
      return nil
    }
    self.setup_deps(path)
    dummy = self.load_file(path)
    if self.failed {
      return nil
    }
    self.merge(path)
  }

  pub fn load_file(path: String): Program? {
    if path_in_list(self.stack, path) {
      buf = buf_new()
      buf.push_str("import cycle: ")
      i = 0
      while i < self.stack.size {
        if i > 0 {
          buf.push_str(" -> ")
        }
        buf.push_str(self.logical_name(self.stack[i]))
        i = i + 1
      }
      buf.push_str(" -> ")
      buf.push_str(self.logical_name(path))
      self.fail(Location.new(path, 1, 1, 0), buf.to_s)
      return nil
    }
    if id = self.loaded.get(path) {
      return self.programs[id]
    }
    self.stack.push(path)
    if file = source_read(path) {
      lex = Lexer.new(file)
      tokens = lex.tokenize
      if e = lex.err {
        dummy2 = self.stack.pop
        self.absorb(lex.errors)
        return nil
      }
      parser = Parser.new(file, tokens)
      program = parser.parse
      if e2 = parser.err {
        dummy3 = self.stack.pop
        self.absorb(parser.errors)
        return nil
      }
      name = self.logical_name(path)
      self.note_module_path(name, path, program.loc)
      tag_module(program, name, path)
      self.programs.push(program)
      self.loaded[path] = self.programs.size - 1
      seen = Hash(String, Int).new
      seen_path = Hash(String, String).new
      imports: Array(String) = []
      i = 0
      while i < program.imports.size {
        imp = program.imports[i]
        if prev = seen.get(imp.name) {
          self.fail(imp.loc, "already imported ${imp.name}")
          i = i + 1
          continue
        }
        seen[imp.name] = 1
        child = self.resolve_import(path, imp.name, imp.loc)
        if str_eq(child, "") {
          i = i + 1
          continue
        }
        if prior = seen_path.get(child) {
          self.fail(imp.loc, "import ${prior} and ${imp.name} open the same file ${child}")
          i = i + 1
          continue
        }
        seen_path[child] = imp.name
        dummy7 = self.load_file(child)
        imports.push(self.logical_name(child))
        i = i + 1
      }
      info = ModInfo.new(name, path)
      info.imports = imports
      self.mods.push(info)
      self.order.push(path)
      dummy8 = self.stack.pop
      return program
    }
    dummy9 = self.stack.pop
    self.fail(Location.new(path, 1, 1, 0), "cannot read ${path}")
    nil
  }

  pub fn merge(root_path: String): Program? {
    if id = self.loaded.get(root_path) {
      root = self.programs[id]
      merged = Program.new(root.loc)
      i = 0
      while i < self.order.size {
        pid = 0
        if found = self.loaded.get(self.order[i]) {
          pid = found
        }
        p = self.programs[pid]
        j = 0
        while j < p.structs.size {
          merged.structs.push(p.structs[j])
          j = j + 1
        }
        j = 0
        while j < p.classes.size {
          merged.classes.push(p.classes[j])
          j = j + 1
        }
        j = 0
        while j < p.functions.size {
          merged.functions.push(p.functions[j])
          j = j + 1
        }
        j = 0
        while j < p.interfaces.size {
          merged.interfaces.push(p.interfaces[j])
          j = j + 1
        }
        j = 0
        while j < p.opt_ins.size {
          merged.opt_ins.push(p.opt_ins[j])
          j = j + 1
        }
        j = 0
        while j < p.libs.size {
          merged.libs.push(p.libs[j])
          j = j + 1
        }
        j = 0
        while j < p.quotes.size {
          merged.quotes.push(p.quotes[j])
          j = j + 1
        }
        j = 0
        while j < p.comptimes.size {
          merged.comptimes.push(p.comptimes[j])
          j = j + 1
        }
        i = i + 1
      }
      merged.imports = root.imports
      merged.module_name = root.module_name
      merged.module_path = root.module_path
      merged.root_module = root.module_name
      merged.mods = self.mods
      return merged
    }
    nil
  }
}

pub fn load_program(path: String): Loader {
  loader = Loader.new()
  dummy = loader.load_root(path)
  loader
}
