import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import prelude_src

lib oslink {
  fun readlink(path: String, buf: String, n: Int): Int
}

// The running compiler's own executable, symlinks resolved
// (/proc/self/exe), else argv[0], else "". argv[0] alone has no directory
// when the compiler is started through PATH.
pub fn self_exe_path: String {
  raw_buf = buf_new()
  for nfill in 0..4096 {
    raw_buf.push_byte(0)
  }
  raw = raw_buf.to_s
  n = oslink.readlink("/proc/self/exe", raw, 4095)
  if n > 0 && n < 4096 {
    return str_slice(raw, 0, n)
  }
  args = argv()
  if args.size > 0 {
    return args[0]
  }
  ""
}

pub fn path_basename(path: String): String {
  i = path.size - 1
  while i >= 0 {
    if path[i] == 47 {
      return str_slice(path, i + 1, path.size)
    }
    i -= 1
  }
  path
}

pub fn path_dirname(path: String): String {
  i = path.size - 1
  while i >= 0 {
    if path[i] == 47 {
      if i == 0 {
        return "/"
      }
      return str_slice(path, 0, i)
    }
    i -= 1
  }
  "."
}

pub fn module_name_of(path: String): String {
  base = path_basename(path)
  if base.size > 3 {
    n = base.size
    if base[n - 3] == 46 && base[n - 2] == 97 && base[n - 1] == 118 {
      return str_slice(base, 0, n - 3)
    }
  }
  base
}

pub fn child_av_path(importer: String, name: String): String {
  dir = path_dirname(importer)
  if dir == "." {
    return "${name}.av"
  }
  "${dir}/${name}.av"
}

pub fn path_under(dir: String, path: String): Bool {
  if dir == "." {
    if path.size == 0 {
      return false
    }
    if path[0] == 47 {
      return false
    }
    return true
  }
  prefix = dir.size
  if path.size <= prefix {
    return false
  }
  if str_slice(path, 0, prefix) == dir && path[prefix] == 47 {
    return true
  }
  false
}

pub fn join_dir(dir: String, rel: String): String {
  if dir == "." {
    return rel
  }
  if dir == "/" {
    return "/${rel}"
  }
  "${dir}/${rel}"
}

pub fn import_rel(name: String): String {
  buf = buf_new()
  i = 0
  while i < name.size {
    if name[i] == 46 {
      buf.push_str("/")
    } else {
      buf.push_str(str_slice(name, i, i + 1))
    }
    i += 1
  }
  buf.push_str(".av")
  buf.to_s
}

pub fn rel_module_name(dir: String, path: String): String {
  rel = path
  if dir == "." {
  } else {
    if path_under(dir, path) {
      rel = str_slice(path, dir.size + 1, path.size)
    }
  }
  if rel.size > 3 {
    n = rel.size
    if rel[n - 3] == 46 && rel[n - 2] == 97 && rel[n - 1] == 118 {
      rel = str_slice(rel, 0, n - 3)
    }
  }
  buf = buf_new()
  i = 0
  while i < rel.size {
    if rel[i] == 47 {
      buf.push_str(".")
    } else {
      buf.push_str(str_slice(rel, i, i + 1))
    }
    i += 1
  }
  buf.to_s
}

pub fn find_manifest(start: String): String {
  dir = start
  guard = 0
  while guard < 64 {
    guard += 1
    cand = "avant.toml"
    if dir == "." {
    } else {
      cand = "${dir}/avant.toml"
    }
    if file_exists(cand) {
      return dir
    }
    if dir == "." {
      return ""
    }
    parent = path_dirname(dir)
    if parent == dir {
      return ""
    }
    dir = parent
  }
  ""
}

pub fn hit_listed(list: Array(String), path: String): Bool {
  for i in 0..list.size {
    if list[i] == path {
      return true
    }
  }
  false
}

pub fn tag_module(program: Program, name: String, path: String) {
  program.module_name = name
  program.module_path = path
  for sdef in program.structs {
    sdef.mod_name = name
    for j in 0..sdef.methods.size {
      sdef.methods[j].mod_name = name
    }
  }
  for cdef in program.classes {
    cdef.mod_name = name
    for j in 0..cdef.methods.size {
      cdef.methods[j].mod_name = name
    }
  }
  for i in 0..program.functions.size {
    program.functions[i].mod_name = name
  }
  for idef in program.interfaces {
    idef.mod_name = name
    for j in 0..idef.methods.size {
      idef.methods[j].mod_name = name
    }
  }
  for i in 0..program.opt_ins.size {
    program.opt_ins[i].mod_name = name
  }
  for lib_def in program.libs {
    lib_def.mod_name = name
    for j in 0..lib_def.layouts.size {
      lib_def.layouts[j].mod_name = name
      lib_def.layouts[j].vis = lib_def.vis
    }
  }
  for q in program.quotes {
    q.mod_name = name
    for j in 0..q.functions.size {
      q.functions[j].mod_name = name
    }
  }
  for c in program.comptimes {
    c.mod_name = name
    c.qdecl.mod_name = name
    for j in 0..c.qdecl.functions.size {
      c.qdecl.functions[j].mod_name = name
    }
  }
  for sdef in program.structs {
    for q in sdef.quotes {
      q.mod_name = name
      for k in 0..q.functions.size {
        q.functions[k].mod_name = name
      }
    }
    for c in sdef.comptimes {
      c.mod_name = name
      c.qdecl.mod_name = name
      for k in 0..c.qdecl.functions.size {
        c.qdecl.functions[k].mod_name = name
      }
    }
  }
  for cdef in program.classes {
    for q in cdef.quotes {
      q.mod_name = name
      for k in 0..q.functions.size {
        q.functions[k].mod_name = name
      }
    }
    for c in cdef.comptimes {
      c.mod_name = name
      c.qdecl.mod_name = name
      for k in 0..c.qdecl.functions.size {
        c.qdecl.functions[k].mod_name = name
      }
    }
  }
}

pub fn path_in_list(list: Array(String), path: String): Bool {
  for i in 0..list.size {
    if list[i] == path {
      return true
    }
  }
  false
}

pub class Loader {
  loaded: Hash(String, Int)
  programs: Array(Program)
  stack: Array(String)
  order: Array(String)
  mods: Array(ModInfo)
  failed: Bool = false
  pub err: CompileError? = nil
  pub errors: DiagBag
  dep_dirs: Array(String)
  project_dir: String = ""
  manifest_dir: String = ""
  mod_paths: Hash(String, String)
  std_names: Hash(String, String)
  wants_prelude: Bool = false
  lib_read: Bool = false
  lib_rec: String = ""

  fn initialize {
    h = Hash(String, Int).new
    self.loaded = h
    self.programs = []
    self.stack = []
    self.order = []
    self.mods = []
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new
    self.dep_dirs = []
    self.project_dir = ""
    self.manifest_dir = ""
    mp = Hash(String, String).new
    self.mod_paths = mp
    sn = Hash(String, String).new
    self.std_names = sn
  }

  pub fn module_label(path: String): String {
    if n = self.std_names.get(path) {
      return n
    }
    logical_name(path)
  }

  pub fn setup_deps(root_path: String) {
    self.project_dir = path_dirname(root_path)
    self.manifest_dir = find_manifest(self.project_dir)
    deps_at = self.project_dir
    if self.manifest_dir.size > 0 {
      deps_at = self.manifest_dir
    }
    deps_root = "${deps_at}/deps"
    entries = dir_list(deps_root) ?? []
    i = 0
    while i < entries.size {
      full = "${deps_root}/${entries[i]}"
      if file_exists("${full}/.git") {
        self.dep_dirs.push(full)
      } else if file_exists("${full}/avant.toml") {
        self.dep_dirs.push(full)
      }
      i += 1
    }
  }

  pub fn dep_root_of(path: String): String {
    for dep_dir in self.dep_dirs {
      if path_under(dep_dir, path) {
        return dep_dir
      }
    }
    ""
  }

  pub fn logical_name(path: String): String {
    dep = dep_root_of(path)
    if dep.size > 0 {
      return rel_module_name(dep, path)
    }
    if path_under(self.project_dir, path) {
      return rel_module_name(self.project_dir, path)
    }
    if path_dirname(path) == self.project_dir {
      return rel_module_name(self.project_dir, path)
    }
    if self.manifest_dir.size > 0 {
      if path_under(self.manifest_dir, path) {
        return rel_module_name(self.manifest_dir, path)
      }
      if path_dirname(path) == self.manifest_dir {
        return rel_module_name(self.manifest_dir, path)
      }
    }
    module_name_of(path)
  }

  pub fn consider_hit(hits: Array(String), path: String) {
    if file_exists(path) && !hit_listed(hits, path) {
      hits.push(path)
    }
  }

  pub fn std_import(name: String): Bool {
    if name == "std" {
      return true
    }
    if name.size > 4 {
      if str_slice(name, 0, 4) == "std." {
        return true
      }
    }
    false
  }

  pub fn exe_path: String {
    self_exe_path()
  }

  // The `lib: PATH` line of EXE.versions.txt, read once; nil without a
  // record or without the line (a release archive's versions.txt, a seed,
  // a bare copy: the climb below).
  pub fn record_lib(exe: String): String? {
    if !self.lib_read {
      self.lib_read = true
      if text = file_read("${exe}.versions.txt") {
        for line in text.split("\n") {
          if line.size > 5 && str_slice(line, 0, 5) == "lib: " {
            self.lib_rec = str_slice(line, 5, line.size)
          }
        }
      }
    }
    if self.lib_rec.size > 0 {
      return self.lib_rec
    }
    nil
  }

  pub fn resolve_std(name: String, loc: Location): String {
    if name == "std" {
      fail(loc, "import std needs a module")
      return ""
    }
    rel = import_rel(name)
    suffix = "lib/${rel}"
    if v = env_get("AVANT_ROOT") {
      path = join_dir(v, suffix)
      if file_exists(path) {
        self.std_names[path] = name
        return path
      }
      fail(loc, "cannot find ${name} in the standard library")
      return ""
    }
    exe = exe_path()
    // The build's record beside the compiler (EXE.versions.txt,
    // tools/letters.sh) names the library it was built from (O617,
    // VALK-TM): a kept or copied compiler reads that one, never the
    // nearest lib/ its path climbs to, and says why when it is gone.
    if libdir = record_lib(exe) {
      if !file_exists(libdir) {
        fail(loc, "cannot find ${name}: ${exe}.versions.txt names the library ${libdir}, which does not exist; set AVANT_ROOT to the checkout whose lib/ this compiler should read")
        return ""
      }
      path = "${libdir}/${rel}"
      if file_exists(path) {
        self.std_names[path] = name
        return path
      }
      fail(loc, "cannot find ${name} in the standard library ${libdir} (named by ${exe}.versions.txt)")
      return ""
    }
    dir = path_dirname(exe)
    for guard in 0..64 {
      cand = join_dir(dir, suffix)
      if file_exists(cand) {
        self.std_names[cand] = name
        return cand
      }
      parent = path_dirname(dir)
      if parent == dir {
        break
      }
      dir = parent
    }
    fail(loc, "cannot find ${name} in the standard library")
    ""
  }

  pub fn resolve_import(importer: String, name: String, loc: Location): String {
    if std_import(name) {
      return resolve_std(name, loc)
    }
    rel = import_rel(name)
    hits: Array(String) = []
    dep = dep_root_of(importer)
    if dep.size > 0 {
      consider_hit(hits, join_dir(path_dirname(importer), rel))
      consider_hit(hits, join_dir(dep, rel))
      for dep_dir in self.dep_dirs {
        if dep_dir != dep {
          consider_hit(hits, join_dir(dep_dir, rel))
        }
      }
    } else {
      consider_hit(hits, join_dir(path_dirname(importer), rel))
      consider_hit(hits, join_dir(self.project_dir, rel))
      if self.manifest_dir.size > 0 {
        consider_hit(hits, join_dir(self.manifest_dir, rel))
      }
      for dep_dir in self.dep_dirs {
        consider_hit(hits, join_dir(dep_dir, rel))
      }
    }
    if hits.size == 0 {
      anchor = self.project_dir
      if self.manifest_dir.size > 0 {
        anchor = self.manifest_dir
      }
      if file_exists("${anchor}/avant.toml") {
        fail(loc, "cannot find ${name}.av next to ${importer} or in fetched deps (run: avant fetch ${anchor})")
      } else {
        if file_exists("${self.project_dir}/avant.toml") {
          fail(loc, "cannot find ${name}.av next to ${importer} or in fetched deps (run: avant fetch ${self.project_dir})")
        } else {
          fail(loc, "cannot find ${name}.av next to ${importer}")
        }
      }
      return ""
    }
    if hits.size > 1 {
      buf = buf_new()
      buf.push_str("import ${name} is ambiguous:")
      for hit in hits {
        buf.push_str(" ${hit}")
      }
      fail(loc, buf.to_s)
      return ""
    }
    hits[0]
  }

  pub fn note_module_path(name: String, path: String, loc: Location) {
    if prev = self.mod_paths.get(name) {
      if prev != path {
        fail(loc, "module ${name} is both ${prev} and ${path}")
      }
    } else {
      self.mod_paths[name] = path
    }
  }

  pub fn dep_child(name: String): String {
    hit = ""
    hits = 0
    for dep_dir in self.dep_dirs {
      cand = "${dep_dir}/${name}.av"
      if file_exists(cand) {
        hits += 1
        hit = cand
      }
    }
    if hits == 1 {
      return hit
    }
    if hits > 1 {
      return "ambiguous:${hits}"
    }
    ""
  }

  pub fn fail(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(5, message), message)
    if self.errors.count == 0 {
      self.err = e
    }
    self.failed = true
    self.errors.push(e)
  }

  pub fn absorb(bag: DiagBag) {
    for e in bag.items {
      if self.errors.count == 0 {
        self.err = e
      }
      self.failed = true
      self.errors.push(e)
    }
    self.errors.note(bag.suppressed, true)
  }

  pub fn err_count: Int {
    self.errors.pushes
  }

  pub fn load_root(path: String): Program? {
    if !file_exists(path) {
      fail(Location.new(path, 1, 1, 0), "cannot read ${path}")
      return nil
    }
    setup_deps(path)
    load_file(path)
    if self.failed {
      return nil
    }
    if merged = merge(path) {
      if self.wants_prelude {
        add_prelude(merged)
      }
      return merged
    }
    nil
  }

  pub fn load_file(path: String): Program? {
    if path_in_list(self.stack, path) {
      buf = buf_new()
      buf.push_str("import cycle: ")
      for i in 0..self.stack.size {
        if i > 0 {
          buf.push_str(" -> ")
        }
        buf.push_str(module_label(self.stack[i]))
      }
      buf.push_str(" -> ")
      buf.push_str(module_label(path))
      fail(Location.new(path, 1, 1, 0), buf.to_s)
      return nil
    }
    if id = self.loaded.get(path) {
      return self.programs[id]
    }
    self.stack.push(path)
    if file = source_read(path) {
      lex = Lexer.new(file)
      tokens = lex.tokenize
      if e = lex.err {
        self.stack.pop
        absorb(lex.errors)
        return nil
      }
      if !self.wants_prelude && prelude_wanted(tokens) {
        self.wants_prelude = true
      }
      parser = Parser.new(file, tokens)
      program = parser.parse
      if e2 = parser.err {
        self.stack.pop
        absorb(parser.errors)
        return nil
      }
      name = module_label(path)
      note_module_path(name, path, program.loc)
      tag_module(program, name, path)
      self.programs.push(program)
      self.loaded[path] = self.programs.size - 1
      seen = Hash(String, Int).new
      seen_path = Hash(String, String).new
      imports: Array(String) = []
      i = 0
      while i < program.imports.size {
        imp = program.imports[i]
        if prev = seen.get(imp.name) {
          fail(imp.loc, "already imported ${imp.name}")
          i += 1
          continue
        }
        seen[imp.name] = 1
        child = resolve_import(path, imp.name, imp.loc)
        if child == "" {
          i += 1
          continue
        }
        if prior = seen_path.get(child) {
          fail(imp.loc, "import ${prior} and ${imp.name} open the same file ${child}")
          i += 1
          continue
        }
        seen_path[child] = imp.name
        load_file(child)
        imports.push(module_label(child))
        i += 1
      }
      info = ModInfo.new(name, path)
      info.imports = imports
      self.mods.push(info)
      self.order.push(path)
      self.stack.pop
      return program
    }
    self.stack.pop
    fail(Location.new(path, 1, 1, 0), "cannot read ${path}")
    nil
  }

  pub fn merge(root_path: String): Program? {
    if id = self.loaded.get(root_path) {
      root = self.programs[id]
      merged = Program.new(root.loc)
      for i in 0..self.order.size {
        pid = 0
        if found = self.loaded.get(self.order[i]) {
          pid = found
        }
        merge_decls(merged, self.programs[pid])
      }
      merged.imports = root.imports
      merged.module_name = root.module_name
      merged.module_path = root.module_path
      merged.root_module = root.module_name
      merged.mods = self.mods
      return merged
    }
    nil
  }
}

// Appends p's declarations to merged, in order.
pub fn merge_decls(merged: Program, p: Program) {
  j = 0
  while j < p.structs.size {
    merged.structs.push(p.structs[j])
    j += 1
  }
  j = 0
  while j < p.classes.size {
    merged.classes.push(p.classes[j])
    j += 1
  }
  j = 0
  while j < p.functions.size {
    merged.functions.push(p.functions[j])
    j += 1
  }
  j = 0
  while j < p.interfaces.size {
    merged.interfaces.push(p.interfaces[j])
    j += 1
  }
  j = 0
  while j < p.opt_ins.size {
    merged.opt_ins.push(p.opt_ins[j])
    j += 1
  }
  j = 0
  while j < p.libs.size {
    merged.libs.push(p.libs[j])
    j += 1
  }
  j = 0
  while j < p.quotes.size {
    merged.quotes.push(p.quotes[j])
    j += 1
  }
  j = 0
  while j < p.comptimes.size {
    merged.comptimes.push(p.comptimes[j])
    j += 1
  }
}

// Adds the prelude module (prelude_src.av) to a merged program: its
// declarations after every other module's, so the program's own types
// keep their order, and an import of it in every module.
pub fn add_prelude(merged: Program) {
  src = Source.new(prelude_path(), prelude_source())
  lex = Lexer.new(src)
  tokens = lex.tokenize
  parser = Parser.new(src, tokens)
  p = parser.parse
  tag_module(p, "prelude", prelude_path())
  merge_decls(merged, p)
  for info in merged.mods {
    info.imports.push("prelude")
  }
  merged.mods.push(ModInfo.new("prelude", prelude_path()))
}

pub fn load_program(path: String): Loader {
  loader = Loader.new()
  loader.load_root(path)
  loader
}
