pub fn (checker_self: Checker) gcap_get(name: String): Int64 {
  best = 0i64 - 1i64
  i = 0
  while i < checker_self.gcap_var.size {
    if checker_self.gcap_live[i] == 1 {
      if str_eq(checker_self.gcap_var[i], name) {
        if best < 0i64 || checker_self.gcap_val[i] < best {
          best = checker_self.gcap_val[i]
        }
      }
    }
    i = i + 1
  }
  best
}

pub fn (checker_self: Checker) cap_of(name: String): Int64 {
  a = checker_self.cap_get(name)
  g = checker_self.gcap_get(name)
  if a < 0i64 {
    return g
  }
  if g < 0i64 {
    return a
  }
  if a < g {
    return a
  }
  g
}

