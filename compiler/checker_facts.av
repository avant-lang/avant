pub fn (checker_self: Checker) collect_cond_nn(e: Expr, into: Array(String)) {
  if e.kind == ex_binary() {
    if e.op == tk_amp_amp() {
      if l = e.left {
        checker_self.collect_cond_nn(l, into)
      }
      if r = e.right {
        checker_self.collect_cond_nn(r, into)
      }
      return
    }
    if e.op == 47 {
      if l = e.left {
        if r = e.right {
          if l.kind == ex_name() {
            if r.kind == ex_int() {
              if r.int_bits == 0u64 {
                into.push(l.ident)
              }
            }
          }
        }
      }
    }
    if e.op == tk_less_eq() {
      if l = e.left {
        if r = e.right {
          if r.kind == ex_name() {
            if l.kind == ex_int() {
              if l.int_bits == 0u64 {
                into.push(r.ident)
              }
            }
          }
        }
      }
    }
  }
}

pub fn (checker_self: Checker) fact_from_cond(e: Expr, body: Array(Stmt), nnl: Array(String)) {
  if e.kind != ex_binary() {
    return
  }
  if e.op == tk_amp_amp() {
    if l = e.left {
      checker_self.fact_from_cond(l, body, nnl)
    }
    if r = e.right {
      checker_self.fact_from_cond(r, body, nnl)
    }
    return
  }
  ivar = ""
  bound: Expr? = nil
  slack = 0
  is_le = false
  if e.op == tk_less() {
    if l = e.left {
      if l.kind == ex_name() {
        ivar = l.ident
        if r = e.right {
          bound = r
        }
      }
    }
  } else if e.op == tk_less_eq() {
    is_le = true
    if l = e.left {
      if l.kind == ex_name() {
        ivar = l.ident
        if r = e.right {
          bound = r
        }
      }
    }
  } else if e.op == 47 {
    if r = e.right {
      if r.kind == ex_name() {
        ivar = r.ident
        if l = e.left {
          bound = l
        }
      }
    }
  } else if e.op == 48 {
    is_le = true
    if r = e.right {
      if r.kind == ex_name() {
        ivar = r.ident
        if l = e.left {
          bound = l
        }
      }
    }
  } else {
    return
  }
  if ivar.size == 0 {
    return
  }
  if b = bound {
    cont = checker_self.bound_cont_of(b)
    if cont.size == 0 {
      if is_le {
        return
      }
      nonneg2 = false
      if checker_self.nn_has(ivar) {
        nonneg2 = true
      }
      if str_index(nnl, ivar) >= 0 {
        nonneg2 = true
      }
      if nonneg2 {
      } else {
        return
      }
      if checker_self.body_ivar_ok(body, ivar) {
        checker_self.fact_var.push(ivar)
        checker_self.fact_cont.push("")
        checker_self.fact_slack.push(0)
        checker_self.fact_live.push(1)
      }
      return
    }
    delta = checker_self.bound_delta_of(b)
    if is_le {
      slack =(0 - delta) - 1
    } else {
      slack = 0 - delta
    }
    if slack < 0 {
      return
    }
    direct = false
    if b.kind == ex_field() {
      direct = true
    }
    nonneg = false
    if checker_self.nn_has(ivar) {
      nonneg = true
    }
    if str_index(nnl, ivar) >= 0 {
      nonneg = true
    }
    if nonneg {
    } else {
      return
    }
    if direct {
    } else {
      if checker_self.body_shrinks(body, cont) {
        return
      }
    }
    if checker_self.body_ivar_ok(body, ivar) {
      checker_self.fact_var.push(ivar)
      checker_self.fact_cont.push(cont)
      checker_self.fact_slack.push(slack)
      checker_self.fact_live.push(1)
    }
  }
}

pub fn (checker_self: Checker) push_loop_facts(cond: Expr, body: Array(Stmt)) {
  nnl: Array(String) = []
  checker_self.collect_cond_nn(cond, nnl)
