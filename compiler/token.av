// Token kinds are Int. Numbers match Crystal `Token::Kind` (src/avant/token.cr).

fn tk_eof: Int { 0 }
fn tk_newline: Int { 1 }
fn tk_ident: Int { 2 }
fn tk_integer: Int { 3 }
fn tk_float: Int { 4 }
fn tk_string: Int { 5 }
fn tk_fn: Int { 6 }
fn tk_if: Int { 7 }
fn tk_else: Int { 8 }
fn tk_return: Int { 9 }
fn tk_struct: Int { 10 }
fn tk_class: Int { 11 }
fn tk_lib: Int { 12 }
fn tk_fun: Int { 13 }
fn tk_self: Int { 14 }
fn tk_while: Int { 15 }
fn tk_true: Int { 16 }
fn tk_false: Int { 17 }
fn tk_nil: Int { 18 }
fn tk_spawn: Int { 19 }
fn tk_break: Int { 20 }
fn tk_continue: Int { 21 }
fn tk_switch: Int { 22 }
fn tk_case: Int { 23 }
fn tk_plus_eq: Int { 24 }
fn tk_minus_eq: Int { 25 }
fn tk_star_eq: Int { 26 }
fn tk_slash_eq: Int { 27 }
fn tk_l_brace: Int { 28 }
fn tk_r_brace: Int { 29 }
fn tk_l_paren: Int { 30 }
fn tk_r_paren: Int { 31 }
fn tk_l_bracket: Int { 32 }
fn tk_r_bracket: Int { 33 }
fn tk_comma: Int { 34 }
fn tk_colon: Int { 35 }
fn tk_dot: Int { 36 }
fn tk_plus: Int { 37 }
fn tk_minus: Int { 38 }
fn tk_star: Int { 39 }
fn tk_slash: Int { 40 }
fn tk_percent: Int { 41 }
fn tk_eq: Int { 42 }
fn tk_eq_eq: Int { 43 }
fn tk_not_eq: Int { 44 }
fn tk_less: Int { 45 }
fn tk_less_eq: Int { 46 }
fn tk_greater: Int { 47 }
fn tk_greater_eq: Int { 48 }
fn tk_bang: Int { 49 }
fn tk_question: Int { 50 }
fn tk_pipe: Int { 51 }
fn tk_pipe_pipe: Int { 52 }
fn tk_amp: Int { 53 }
fn tk_amp_amp: Int { 54 }
fn tk_caret: Int { 55 }
fn tk_tilde: Int { 56 }
fn tk_less_less: Int { 57 }
fn tk_greater_greater: Int { 58 }
fn tk_interp_open: Int { 59 }
fn tk_interp_mid: Int { 60 }
fn tk_interp_close: Int { 61 }

fn token_is_keyword(kind: Int): Bool {
  if kind >= 6 {
    if kind <= 23 {
      return true
    }
  }
  false
}

fn token_is_assign_op(kind: Int): Bool {
  if kind == 42 {
    return true
  }
  if kind >= 24 {
    if kind <= 27 {
      return true
    }
  }
  false
}

fn keyword_table: Hash(String, Int) {
  kw = Hash(String, Int).new
  kw["fn"] = tk_fn()
  kw["if"] = tk_if()
  kw["else"] = tk_else()
  kw["return"] = tk_return()
  kw["struct"] = tk_struct()
  kw["class"] = tk_class()
  kw["lib"] = tk_lib()
  kw["fun"] = tk_fun()
  kw["self"] = tk_self()
  kw["while"] = tk_while()
  kw["true"] = tk_true()
  kw["false"] = tk_false()
  kw["nil"] = tk_nil()
  kw["spawn"] = tk_spawn()
  kw["break"] = tk_break()
  kw["continue"] = tk_continue()
  kw["switch"] = tk_switch()
  kw["case"] = tk_case()
  kw
}

fn fn_op_name(kind: Int): String {
  if kind == tk_plus() {
    return "+"
  }
  if kind == tk_minus() {
    return "-"
  }
  if kind == tk_star() {
    return "*"
  }
  if kind == tk_slash() {
    return "/"
  }
  if kind == tk_percent() {
    return "%"
  }
  if kind == tk_eq_eq() {
    return "=="
  }
  if kind == tk_not_eq() {
    return "!="
  }
  if kind == tk_less() {
    return "<"
  }
  if kind == tk_less_eq() {
    return "<="
  }
  if kind == tk_greater() {
    return ">"
  }
  if kind == tk_greater_eq() {
    return ">="
  }
  ""
}

fn emit_op_name(name: String): String {
  if str_eq(name, "+") {
    return "plus"
  }
  if str_eq(name, "-") {
    return "minus"
  }
  if str_eq(name, "*") {
    return "star"
  }
  if str_eq(name, "/") {
    return "slash"
  }
  if str_eq(name, "%") {
    return "percent"
  }
  if str_eq(name, "==") {
    return "eq"
  }
  if str_eq(name, "!=") {
    return "ne"
  }
  if str_eq(name, "<") {
    return "lt"
  }
  if str_eq(name, "<=") {
    return "le"
  }
  if str_eq(name, ">") {
    return "gt"
  }
  if str_eq(name, ">=") {
    return "ge"
  }
  name
}

class Token {
  kind: Int = 0
  loc: Location
  value: String = ""

  fn initialize(kind: Int, loc: Location, value: String) {
    self.kind = kind
    self.loc = loc
    self.value = value
  }
}
