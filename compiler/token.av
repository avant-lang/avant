pub const tk_dot_dot_eq = 81
// The compound assignments of the other binary operators.
pub const tk_percent_eq = 82
pub const tk_amp_eq = 83
pub const tk_pipe_eq = 84
pub const tk_caret_eq = 85
pub const tk_less_less_eq = 86
pub const tk_greater_greater_eq = 87
pub const tk_amp_plus_eq = 88
pub const tk_amp_minus_eq = 89
pub const tk_amp_star_eq = 90
// `defer`.
pub const tk_defer = 91

pub fn token_is_keyword(kind: Int): Bool {
  if kind >= 6 && kind <= 23 {
    return true
  }
  if kind == tk_import {
    return true
  }
  if kind == tk_pub {
    return true
  }
  if kind == tk_quote {
    return true
  }
  if kind == tk_comptime {
    return true
  }
  if kind == tk_for {
    return true
  }
  if kind == tk_in {
    return true
  }
  if kind == tk_pin {
    return true
  }
  if kind == tk_release {
    return true
  }
  if kind == tk_enum {
    return true
  }
  if kind == tk_const {
    return true
  }
  if kind == tk_defer {
    return true
  }
  false
}

pub fn token_is_assign_op(kind: Int): Bool {
  if kind == 42 {
    return true
  }
  if kind >= 24 && kind <= 27 {
    return true
  }
  kind >= 82 && kind <= 90
}

// A compound assignment's binary operator (`%=` is `%`); 0 for `=` and
// every other token.
pub fn compound_binop(kind: Int): Int {
  if kind == tk_plus_eq {
    return tk_plus
  }
  if kind == tk_minus_eq {
    return tk_minus
  }
  if kind == tk_star_eq {
    return tk_star
  }
  if kind == tk_slash_eq {
    return tk_slash
  }
  if kind == tk_percent_eq {
    return tk_percent
  }
  if kind == tk_amp_eq {
    return tk_amp
  }
  if kind == tk_pipe_eq {
    return tk_pipe
  }
  if kind == tk_caret_eq {
    return tk_caret
  }
  if kind == tk_less_less_eq {
    return tk_less_less
  }
  if kind == tk_greater_greater_eq {
    return tk_greater_greater
  }
  if kind == tk_amp_plus_eq {
    return tk_amp_plus
  }
  if kind == tk_amp_minus_eq {
    return tk_amp_minus
  }
  if kind == tk_amp_star_eq {
    return tk_amp_star
  }
  0
}

// The text of a compound assignment's token (`%=`); "" for any other.
pub fn compound_text(kind: Int): String {
  op = compound_binop(kind)
  if op == 0 {
    return ""
  }
  if op == tk_pipe {
    return "|="
  }
  if op == tk_amp {
    return "&="
  }
  if op == tk_caret {
    return "^="
  }
  if op == tk_less_less {
    return "<<="
  }
  if op == tk_greater_greater {
    return ">>="
  }
  "${fn_op_name(op)}="
}

pub fn keyword_spelling(kind: Int): String {
  if kind == tk_fn {
    return "fn"
  }
  if kind == tk_if {
    return "if"
  }
  if kind == tk_else {
    return "else"
  }
  if kind == tk_return {
    return "return"
  }
  if kind == tk_struct {
    return "struct"
  }
  if kind == tk_class {
    return "class"
  }
  if kind == tk_lib {
    return "lib"
  }
  if kind == tk_fun {
    return "fun"
  }
  if kind == tk_self {
    return "self"
  }
  if kind == tk_while {
    return "while"
  }
  if kind == tk_true {
    return "true"
  }
  if kind == tk_false {
    return "false"
  }
  if kind == tk_nil {
    return "nil"
  }
  if kind == tk_spawn {
    return "spawn"
  }
  if kind == tk_break {
    return "break"
  }
  if kind == tk_continue {
    return "continue"
  }
  if kind == tk_switch {
    return "switch"
  }
  if kind == tk_case {
    return "case"
  }
  if kind == tk_import {
    return "import"
  }
  if kind == tk_pub {
    return "pub"
  }
  if kind == tk_quote {
    return "quote"
  }
  if kind == tk_comptime {
    return "comptime"
  }
  if kind == tk_interface {
    return "interface"
  }
  if kind == tk_for {
    return "for"
  }
  if kind == tk_in {
    return "in"
  }
  if kind == tk_pin {
    return "pin"
  }
  if kind == tk_release {
    return "release"
  }
  if kind == tk_enum {
    return "enum"
  }
  if kind == tk_const {
    return "const"
  }
  if kind == tk_defer {
    return "defer"
  }
  ""
}

// A token kind as a message names it: a keyword or a punctuation mark in
// backticks, any other kind in words ("expected `{`, found a string").
// Before, parser messages printed the kind's number.
pub fn token_name(kind: Int): String {
  spell = keyword_spelling(kind)
  if spell.size > 0 {
    return "`${spell}`"
  }
  if kind == tk_eof {
    return "the end of the file"
  }
  if kind == tk_newline {
    return "the end of the line"
  }
  if kind == tk_ident {
    return "a name"
  }
  if kind == tk_integer {
    return "an integer"
  }
  if kind == tk_float {
    return "a float"
  }
  if kind == tk_string {
    return "a string"
  }
  if kind == tk_interp_open {
    return "an interpolated string"
  }
  if kind == tk_interp_mid {
    return "the middle of an interpolated string"
  }
  if kind == tk_interp_close {
    return "the end of an interpolated string"
  }
  if kind == tk_comment {
    return "a comment"
  }
  if kind == tk_file_line {
    return "a file directive"
  }
  if kind == tk_l_brace {
    return "`{`"
  }
  if kind == tk_r_brace {
    return "`}`"
  }
  if kind == tk_l_paren {
    return "`(`"
  }
  if kind == tk_r_paren {
    return "`)`"
  }
  if kind == tk_l_bracket {
    return "`[`"
  }
  if kind == tk_r_bracket {
    return "`]`"
  }
  if kind == tk_comma {
    return "`,`"
  }
  if kind == tk_colon {
    return "`:`"
  }
  if kind == tk_dot {
    return "`.`"
  }
  if kind == tk_plus {
    return "`+`"
  }
  if kind == tk_minus {
    return "`-`"
  }
  if kind == tk_star {
    return "`*`"
  }
  if kind == tk_slash {
    return "`/`"
  }
  if kind == tk_percent {
    return "`%`"
  }
  if kind == tk_eq {
    return "`=`"
  }
  if kind == tk_eq_eq {
    return "`==`"
  }
  if kind == tk_not_eq {
    return "`!=`"
  }
  if kind == tk_less {
    return "`<`"
  }
  if kind == tk_less_eq {
    return "`<=`"
  }
  if kind == tk_greater {
    return "`>`"
  }
  if kind == tk_greater_eq {
    return "`>=`"
  }
  if kind == tk_bang {
    return "`!`"
  }
  if kind == tk_question {
    return "`?`"
  }
  if kind == tk_pipe {
    return "`|`"
  }
  if kind == tk_pipe_pipe {
    return "`||`"
  }
  if kind == tk_amp {
    return "`&`"
  }
  if kind == tk_amp_amp {
    return "`&&`"
  }
  if kind == tk_caret {
    return "`^`"
  }
  if kind == tk_tilde {
    return "`~`"
  }
  if kind == tk_less_less {
    return "`<<`"
  }
  if kind == tk_greater_greater {
    return "`>>`"
  }
  if kind == tk_plus_eq {
    return "`+=`"
  }
  if kind == tk_minus_eq {
    return "`-=`"
  }
  if kind == tk_star_eq {
    return "`*=`"
  }
  if kind == tk_slash_eq {
    return "`/=`"
  }
  if kind == tk_pound {
    return "`#`"
  }
  if kind == tk_amp_plus {
    return "`&+`"
  }
  if kind == tk_amp_minus {
    return "`&-`"
  }
  if kind == tk_amp_star {
    return "`&*`"
  }
  if kind == tk_dot_dot {
    return "`..`"
  }
  if kind == tk_dot_dot_eq {
    return "`..=`"
  }
  if kind == tk_question_question {
    return "`??`"
  }
  ct = compound_text(kind)
  if ct.size > 0 {
    return "`${ct}`"
  }
  "token ${kind}"
}

pub fn keyword_table: Hash(String, Int) {
  kw = Hash(String, Int).new()
  kw["fn"] = tk_fn
  kw["if"] = tk_if
  kw["else"] = tk_else
  kw["return"] = tk_return
  kw["struct"] = tk_struct
  kw["class"] = tk_class
  kw["lib"] = tk_lib
  kw["fun"] = tk_fun
  kw["self"] = tk_self
  kw["while"] = tk_while
  kw["true"] = tk_true
  kw["false"] = tk_false
  kw["nil"] = tk_nil
  kw["spawn"] = tk_spawn
  kw["break"] = tk_break
  kw["continue"] = tk_continue
  kw["switch"] = tk_switch
  kw["case"] = tk_case
  kw["import"] = tk_import
  kw["pub"] = tk_pub
  kw["quote"] = tk_quote
  kw["comptime"] = tk_comptime
  kw["interface"] = tk_interface
  kw["for"] = tk_for
  kw["in"] = tk_in
  kw["pin"] = tk_pin
  kw["release"] = tk_release
  kw["enum"] = tk_enum
  kw["const"] = tk_const
  kw["defer"] = tk_defer
  kw
}

pub fn fn_op_name(kind: Int): String {
  if kind == tk_amp_plus {
    return "&+"
  }
  if kind == tk_amp_minus {
    return "&-"
  }
  if kind == tk_amp_star {
    return "&*"
  }
  if kind == tk_plus {
    return "+"
  }
  if kind == tk_minus {
    return "-"
  }
  if kind == tk_star {
    return "*"
  }
  if kind == tk_slash {
    return "/"
  }
  if kind == tk_percent {
    return "%"
  }
  if kind == tk_eq_eq {
    return "=="
  }
  if kind == tk_not_eq {
    return "!="
  }
  if kind == tk_less {
    return "<"
  }
  if kind == tk_less_eq {
    return "<="
  }
  if kind == tk_greater {
    return ">"
  }
  if kind == tk_greater_eq {
    return ">="
  }
  if kind == tk_amp {
    return "&"
  }
  if kind == tk_pipe {
    return "|"
  }
  if kind == tk_caret {
    return "^"
  }
  if kind == tk_less_less {
    return "<<"
  }
  if kind == tk_greater_greater {
    return ">>"
  }
  ""
}

pub fn emit_op_name(name: String): String {
  if name == "&" {
    return "amp"
  }
  if name == "|" {
    return "pipe"
  }
  if name == "^" {
    return "caret"
  }
  if name == "<<" {
    return "shl"
  }
  if name == ">>" {
    return "shr"
  }
  if name == "[]" {
    return "index"
  }
  if name == "[]=" {
    return "index_set"
  }
  if name == "&+" {
    return "wplus"
  }
  if name == "&-" {
    return "wminus"
  }
  if name == "&*" {
    return "wstar"
  }
  if name == "+" {
    return "plus"
  }
  if name == "-" {
    return "minus"
  }
  if name == "*" {
    return "star"
  }
  if name == "/" {
    return "slash"
  }
  if name == "%" {
    return "percent"
  }
  if name == "==" {
    return "eq"
  }
  if name == "!=" {
    return "ne"
  }
  if name == "<" {
    return "lt"
  }
  if name == "<=" {
    return "le"
  }
  if name == ">" {
    return "gt"
  }
  if name == ">=" {
    return "ge"
  }
  name
}

pub class Token {
  pub kind: Int = 0
  pub loc: Location
  pub value: String = ""

  fn initialize(kind: Int, loc: Location, value: String) {
    self.kind = kind
    self.loc = loc
    self.value = value
  }
}

// A type name's CamelCase spelling: `value` ->
// `Value`, `http_req` -> `HttpReq`, `_x` -> `X`.
pub fn type_camel(name: String): String {
  buf = Buf.new()
  up = true
  for i in 0..name.size {
    c = name[i]
    if c == 95 {
      up = true
      continue
    }
    if up && c >= 97 && c <= 122 {
      buf.push_byte(c - 32)
    } else {
      buf.push_byte(c)
    }
    up = false
  }
  buf.to_s()
}
