// `avant format --lambdas FILE...`: rewrites the blocks written with
// pipes into lambdas in parentheses, in place.
//
//   { |x| x + 1 }              (x) { x + 1 }          a lambda value
//   f(a) { |x| ... }           f(a, (x) { ... })      a call with a block
//   xs.each { |x| ... }        xs.each (x) { ... }    the only argument
//   if xs.any { |x| p } {      if xs.any((x) { p }) {  in a statement's head
//
// The meaning is kept: a lambda in parentheses returns from itself, as a
// block in pipes given to a function of the program already did; a
// builtin's block in pipes (`each`, `any`, `sort`, `Mutex.with`, ...) is
// a loop body whose `return`, `break`, `continue` and `?` leave the code
// around it, so when its body uses one of them the block becomes a `for`
// (`xs.each { |x| ... return ... }` is `for x in xs { ... return ... }`),
// and where no `for` says the same (a value block, a hash's walk) it is
// left and reported. Which blocks a builtin inlines is the checker's
// knowledge: every file named is loaded and checked first (its errors are
// reported, the rest still rewritten), and a block the checker did not
// reach (a generic function no program instantiates) is rewritten from
// the source alone when its body leaves by none of those four, and
// reported otherwise. Each file is then rewritten from its own parse, so
// code the checker never reaches is rewritten too, and printed by the
// formatter; a result that does not parse leaves the file as it was.

import location
import diagnostic
import source
import token
import lexer
import ast
import parser
import loader
import expand
import checker
import format
import pipeline

pub class LamTally {
  pub kinds: Hash(String, String)
  pub names: Array(String) = []
  pub counts: Hash(String, Int)
  pub left: Array(String) = []

  fn initialize {
    self.kinds = Hash(String, String).new()
    self.counts = Hash(String, Int).new()
  }

  pub fn add(what: String) {
    n = self.counts.get(what) ?? 0
    if n == 0 {
      self.names.push(what)
    }
    self.counts[what] = n + 1
  }
}

pub fn driver_format_lambdas(args: Array(String)) {
  if args.size == 0 {
    diag_puts("format --lambdas needs a .av file")
    diag_exit(1)
  }
  tally = LamTally.new()
  failed = false
  for root in args {
    loader = Loader.new()
    if merged = loader.load_root(root) {
      if e = loader.err {
        diag_puts("${root}: does not load; its blocks are rewritten from the source alone")
        continue
      }
      src = Source.new(root, file_read(root) ?? "")
      expander = Expander.new(src, merged)
      expander.expand()
      if e = expander.err {
        diag_puts("${root}: its macros do not expand; its blocks are rewritten from the source alone")
        continue
      }
      checker = Checker.new(src, merged)
      checker.lambdas_migrate = true
      checker.check()
      for k in checker.inline_kinds.keys() {
        tally.kinds[k] = checker.inline_kinds.get(k) ?? ""
      }
    } else {
      diag_puts("${root}: does not load; its blocks are rewritten from the source alone")
    }
  }
  for p in args {
    if text = file_read(p) {
      before = tally.left.size
      got = migrate_lambdas_text(p, text, tally)
      if got != text {
        if e = write_failure(file_write(p, got)) {
          diag_puts(e.message())
          failed = true
        } else {
          puts("${p}: rewritten")
        }
      }
      if tally.left.size > before {
        failed = true
      }
    } else {
      diag_puts("${p}: not a file")
      failed = true
    }
  }
  for name in tally.names {
    puts("count ${name}: ${tally.counts.get(name) ?? 0}")
  }
  for l in tally.left {
    diag_puts(l)
  }
  if failed {
    diag_exit(1)
  }
}

// The text of one file with its blocks in pipes rewritten (the text
// itself when nothing changes or the result would not parse).
pub fn migrate_lambdas_text(path: String, text: String, tally: LamTally): String {
  src = Source.new(path, text)
  lex = Lexer.new(src)
  ft = lex.tokenize_format()
  if e = lex.err {
    tally.left.push("${path}: does not lex; left")
    return text
  }
  lex2 = Lexer.new(src)
  toks = lex2.tokenize()
  p = Parser.new(src, toks)
  p.parse()
  if e = p.err {
    tally.left.push("${path}: does not parse; left")
    return text
  }
  at = Hash(String, Int).new()
  i = 0
  while i < ft.size {
    k = ft[i].kind
    if k != tk_newline() && k != tk_comment() && k != tk_file_line() && k != tk_eof() {
      at["${ft[i].loc.offset()}"] = i
    }
    i += 1
  }
  n = ft.size
  drop: Array(Bool) = []
  pre: Array(Array(Token)) = []
  post: Array(Array(Token)) = []
  i = 0
  while i < n {
    drop.push(false)
    none: Array(Token) = []
    pre.push(none)
    none2: Array(Token) = []
    post.push(none2)
    i += 1
  }
  changed = 0
  bi = 0
  while bi < p.pipe_blocks.size {
    b = p.pipe_blocks[bi]
    head = p.pipe_heads[bi]
    bi += 1
    ob = at.get("${b.loc.offset()}") ?? -1
    if ob < 0 || ft[ob].kind != tk_l_brace() {
      tally.left.push("${b.loc.show()}: a block whose brace is not found; left")
      continue
    }
    // The parameters: the tokens between the pipes.
    p1 = mg_next(ft, ob)
    params: Array(Token) = []
    // The pipes and the parameters dropped, p1 through pe (none for a
    // block after a call written without them).
    pe = p1
    if ft[p1].kind != tk_pipe() && ft[p1].kind != tk_pipe_pipe() {
      pe = p1 - 1
    }
    if ft[p1].kind == tk_pipe() {
      pe = p1 + 1
      depth = 0
      while pe < n && !(ft[pe].kind == tk_pipe() && depth == 0) {
        k = ft[pe].kind
        if k == tk_l_paren() || k == tk_l_bracket() {
          depth += 1
        } else if k == tk_r_paren() || k == tk_r_bracket() {
          depth -= 1
        }
        if k != tk_newline() && k != tk_comment() {
          params.push(ft[pe])
        }
        pe += 1
      }
      if pe >= n {
        tally.left.push("${b.loc.show()}: a parameter list without its closing pipe; left")
        continue
      }
    }
    cb = mg_close(ft, ob)
    if cb < 0 {
      tally.left.push("${b.loc.show()}: a block without its closing brace; left")
      continue
    }
    kind = tally.kinds.get("${path}|${b.loc.offset()}") ?? ""
    exit = mg_exits(b.body, tally, path, 0)
    pv = mg_prev(ft, ob)
    form = "value"
    if pv >= 0 && ft[pv].kind == tk_r_paren() {
      form = "call"
    } else if pv >= 0 && ft[pv].kind == tk_ident() {
      form = "bare"
    }
    if form != "value" && kind != "fn" && exit.size > 0 {
      // A loop body that leaves the code around it.
      if kind.size == 0 {
        tally.left.push("${b.loc.show()}: a block the checker does not reach whose body leaves with ${exit}: rewrite it by hand (a builtin's loop body becomes a for, a function's lambda keeps its form)")
        tally.add("left: not reached, leaves with ${exit}")
        continue
      }
      start = p.stmt_starts.get("${b.loc.offset()}") ?? -1
      si = at.get("${start}") ?? -1
      dot = -1
      if form == "bare" && pv >= 1 && ft[pv].value == "each" {
        dot = mg_prev(ft, pv)
      }
      typed = false
      for t in params {
        if t.kind == tk_colon() {
          typed = true
        }
      }
      if (kind == "array each" || kind == "set each") && si >= 0 && dot >= 0 && ft[dot].kind == tk_dot() && params.size == 1 && !typed && si < dot {
        // `recv.each { |x| body }` as `for x in recv { body }`.
        pre[si].push(Token.new(tk_for(), ft[si].loc, "for"))
        pre[si].push(params[0])
        pre[si].push(Token.new(tk_in(), ft[si].loc, "in"))
        drop[dot] = true
        drop[pv] = true
        j = p1
        while j <= pe {
          drop[j] = true
          j += 1
        }
        changed += 1
        tally.add("for: ${kind} that leaves with ${exit}")
        continue
      }
      tally.left.push("${b.loc.show()}: a ${kind} block whose body leaves its function with ${exit}: no for says the same; rewrite it by hand")
      tally.add("left: ${kind}, leaves with ${exit}")
      continue
    }
    // The lambda's head in place of the pipes: `(params) {`.
    lam: Array(Token) = []
    lam.push(Token.new(tk_l_paren(), ft[ob].loc, "("))
    for t in params {
      lam.push(t)
    }
    lam.push(Token.new(tk_r_paren(), ft[ob].loc, ")"))
    lam.push(ft[ob])
    drop[ob] = true
    j = p1
    while j <= pe {
      drop[j] = true
      j += 1
    }
    what = kind
    if what.size == 0 {
      what = "not reached"
    }
    if form == "value" {
      tally.add("lambda value")
    } else if form == "bare" {
      if head {
        pre[ob].push(Token.new(tk_l_paren(), ft[ob].loc, "("))
        post[cb].push(Token.new(tk_r_paren(), ft[cb].loc, ")"))
        tally.add("call (${what}), the full form in a head")
      } else {
        tally.add("call (${what}), the shorthand")
      }
    } else {
      // f(args) { |x| ... }: the call's `)` moves after the lambda.
      op = mg_open(ft, pv)
      if op < 0 {
        tally.left.push("${b.loc.show()}: a call whose `(` is not found; left")
        continue
      }
      no_args = mg_next(ft, op) == pv
      drop[pv] = true
      if no_args && !head {
        drop[op] = true
        tally.add("call (${what}), the shorthand")
      } else {
        if !no_args {
          pre[ob].push(Token.new(tk_comma(), ft[pv].loc, ","))
        }
        post[cb].push(Token.new(tk_r_paren(), ft[cb].loc, ")"))
        tally.add("call (${what}), the full form")
      }
    }
    for t in lam {
      pre[ob].push(t)
    }
    changed += 1
  }
  if changed == 0 {
    return text
  }
  out: Array(Token) = []
  i = 0
  while i < n {
    for t in pre[i] {
      out.push(t)
    }
    if !drop[i] {
      out.push(ft[i])
    }
    for t in post[i] {
      out.push(t)
    }
    i += 1
  }
  got = reprint(out)
  // The result must parse.
  src2 = Source.new(path, got)
  lex3 = Lexer.new(src2)
  t3 = lex3.tokenize()
  if e = lex3.err {
    tally.left.push("${path}: the rewritten text does not lex; left")
    return text
  }
  p3 = Parser.new(src2, t3)
  p3.parse()
  if e = p3.err {
    tally.left.push("${path}: the rewritten text does not parse (${e.show()}); left")
    return text
  }
  got
}

// The next token after i that is not a line break or a comment.
pub fn mg_next(ft: Array(Token), i: Int): Int {
  j = i + 1
  while j < ft.size && (ft[j].kind == tk_newline() || ft[j].kind == tk_comment()) {
    j += 1
  }
  j
}

// The token before i on its line (comments skipped), or -1.
pub fn mg_prev(ft: Array(Token), i: Int): Int {
  j = i - 1
  while j >= 0 && ft[j].kind == tk_comment() {
    j -= 1
  }
  if j < 0 || ft[j].kind == tk_newline() || ft[j].kind == tk_file_line() {
    return -1
  }
  j
}

// The `}` that closes the `{` at i, or -1.
pub fn mg_close(ft: Array(Token), i: Int): Int {
  depth = 0
  j = i
  while j < ft.size {
    k = ft[j].kind
    if k == tk_l_brace() {
      depth += 1
    } else if k == tk_r_brace() {
      depth -= 1
      if depth == 0 {
        return j
      }
    }
    j += 1
  }
  -1
}

// The `(` that the `)` at i closes, or -1.
pub fn mg_open(ft: Array(Token), i: Int): Int {
  depth = 0
  j = i
  while j >= 0 {
    k = ft[j].kind
    if k == tk_r_paren() {
      depth += 1
    } else if k == tk_l_paren() {
      depth -= 1
      if depth == 0 {
        return j
      }
    }
    j -= 1
  }
  -1
}

// How a builtin's loop body leaves the code around it: "return", "?",
// "break" or "continue" (the last two only outside its own loops), or
// "" when it does not. A lambda inside is a function of its own; a
// block the checker knows as a builtin's, or did not reach, is walked as
// part of the body (its `return` leaves the same function).
pub fn mg_exits(body: Array(Stmt), tally: LamTally, path: String, loops: Int): String {
  for st in body {
    k = st.kind
    if k == st_return() {
      return "return"
    }
    if (k == st_break() || k == st_continue()) && loops == 0 {
      if k == st_break() {
        return "break"
      }
      return "continue"
    }
    inner = loops
    if k == st_while() {
      inner = loops + 1
    }
    for x in [st.expr, st.value, st.target, st.cond] {
      if y = x {
        got = mg_exits_expr(y, tally, path, inner)
        if got.size > 0 {
          return got
        }
      }
    }
    got2 = mg_exits(st.pre, tally, path, loops)
    if got2.size > 0 {
      return got2
    }
    for part in [st.then_body, st.else_body, st.body] {
      got3 = mg_exits(part, tally, path, inner)
      if got3.size > 0 {
        return got3
      }
    }
  }
  ""
}

pub fn mg_exits_expr(e: Expr, tally: LamTally, path: String, loops: Int): String {
  if e.kind == ex_try() {
    return "?"
  }
  if e.kind == ex_lambda() {
    return ""
  }
  if b = e.block {
    kind = tally.kinds.get("${path}|${b.loc.offset()}") ?? ""
    if kind != "fn" && !(e.kind == ex_call() && e.callee == "spawn") {
      got = mg_exits(b.body, tally, path, loops + 1)
      if got.size > 0 {
        return got
      }
    }
  }
  for x in [e.left, e.right, e.object, e.cond, e.receiver, e.inner, e.size_expr] {
    if y = x {
      got = mg_exits_expr(y, tally, path, loops)
      if got.size > 0 {
        return got
      }
    }
  }
  for a in e.args {
    got = mg_exits_expr(a, tally, path, loops)
    if got.size > 0 {
      return got
    }
  }
  for a in e.elems {
    got = mg_exits_expr(a, tally, path, loops)
    if got.size > 0 {
      return got
    }
  }
  for a in e.field_exprs {
    got = mg_exits_expr(a, tally, path, loops)
    if got.size > 0 {
      return got
    }
  }
  for c in e.cases {
    got = mg_exits(c.body, tally, path, loops)
    if got.size > 0 {
      return got
    }
  }
  mg_exits(e.else_body, tally, path, loops)
}
