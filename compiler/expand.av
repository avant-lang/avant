import location
import diagnostic
import source
import token
import lexer
import type
import ast

pub fn ident_ok(s: String): Bool {
  if s.size == 0 {
    return false
  }
  if !ch_is_ident_start(s[0]) {
    return false
  }
  for i in 1..s.size {
    if !ch_is_ident_continue(s[i]) {
      return false
    }
  }
  true
}

pub class Expander {
  source: Source
  program: Program
  next_id: Int = 0
  ctx_var: String = ""
  ctx_field: Field? = nil
  // The module of the type find_all_fields found last.
  fields_mod: String = ""
  failed: Bool = false
  pub err: CompileError? = nil
  pub errors: DiagBag

  fn initialize(source: Source, program: Program) {
    self.source = source
    self.program = program
    self.errors = DiagBag.new
  }

  pub fn has_err: Bool {
    self.failed
  }

  pub fn fail(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(6, message), message)
    if self.errors.count == 0 {
      self.err = e
    }
    self.failed = true
    self.errors.push(e)
  }

  pub fn expand: Program {
    expand_quotes(self.program.quotes, "")
    empty_q: Array(QuoteDecl) = []
    self.program.quotes = empty_q
    for sdef in self.program.structs {
      expand_quotes(sdef.quotes, sdef.name)
      sq: Array(QuoteDecl) = []
      sdef.quotes = sq
      expand_walks(sdef.comptimes, sdef.name)
      sc: Array(ComptimeWalk) = []
      sdef.comptimes = sc
    }
    for cdef in self.program.classes {
      expand_quotes(cdef.quotes, cdef.name)
      cq: Array(QuoteDecl) = []
      cdef.quotes = cq
      expand_walks(cdef.comptimes, cdef.name)
      cc: Array(ComptimeWalk) = []
      cdef.comptimes = cc
    }
    expand_walks(self.program.comptimes, "")
    empty_c: Array(ComptimeWalk) = []
    self.program.comptimes = empty_c
    fns = program_all_functions(self.program)
    i = 0
    while i < fns.size {
      fns[i].body = expand_stmt_list(fns[i].body)
      i += 1
    }
    self.program
  }

  pub fn expand_quotes(quotes: Array(QuoteDecl), owner: String) {
    for q in quotes {
      own = owner
      if own.size == 0 {
        own = q.owner
      }
      j = 0
      while j < q.functions.size {
        fnn = fill_and_hygiene_fn(clone_function(q.functions[j]))
        inject_function(fnn, own, q.mod_name)
        j += 1
      }
    }
  }

  pub fn expand_walks(walks: Array(ComptimeWalk), owner: String) {
    for walk in walks {
      fields = find_fields(walk.type_name, walk.loc, walk.mod_name)
      own = owner
      if own.size == 0 {
        own = walk.owner
      }
      j = 0
      while j < fields.size {
        self.ctx_var = walk.var_name
        self.ctx_field = fields[j]
        k = 0
        while k < walk.qdecl.functions.size {
          fnn = fill_and_hygiene_fn(clone_function(walk.qdecl.functions[k]))
          inject_function(fnn, own, walk.mod_name)
          k += 1
        }
        self.ctx_var = ""
        self.ctx_field = nil
        j += 1
      }
    }
  }

  pub fn fill_and_hygiene_fn(fnn: Function): Function {
    fill_function(fnn)
    hygiene_function(fnn)
    fnn.body = expand_stmt_list(fnn.body)
    fnn
  }

  pub fn inject_function(fnn: Function, owner: String, mod_name: String) {
    if mod_name.size > 0 {
      fnn.mod_name = mod_name
    }
    if owner.size == 0 {
      fnn.owner = ""
      self.program.functions.push(fnn)
      return
    }
    fnn.owner = owner
    for sdef in self.program.structs {
      if sdef.name == owner {
        sdef.methods.push(fnn)
        return
      }
    }
    for cls in self.program.classes {
      if cls.name == owner {
        cls.methods.push(fnn)
        return
      }
    }
    fail(fnn.loc, "quote owner ${owner} is not a type")
  }

  // A walk over `T.fields` written in another module than T's sees only
  // T's `pub` fields (Stage 29 W3a, D299): the code it writes could name
  // no other.
  pub fn find_fields(type_name: String, loc: Location, from_mod: String): Array(Field) {
    all = find_all_fields(type_name, loc)
    if self.fields_mod.size == 0 || from_mod.size == 0 || self.fields_mod == from_mod {
      return all
    }
    out: Array(Field) = []
    for f in all {
      if f.vis {
        out.push(f)
      }
    }
    out
  }

  pub fn find_all_fields(type_name: String, loc: Location): Array(Field) {
    found: Array(Field) = []
    hits = 0
    self.fields_mod = ""
    for sdef in self.program.structs {
      if sdef.name == type_name {
        if sdef.type_params.size > 0 {
          fail(loc, "comptime cannot walk generic type ${type_name}")
          return found
        }
        found = sdef.fields
        self.fields_mod = sdef.mod_name
        hits += 1
      }
    }
    for cls in self.program.classes {
      if cls.name == type_name {
        if cls.type_params.size > 0 {
          fail(loc, "comptime cannot walk generic type ${type_name}")
          return found
        }
        found = cls.fields
        self.fields_mod = cls.mod_name
        hits += 1
      }
    }
    for lib_def in self.program.libs {
      for lay in lib_def.layouts {
        if lay.name == type_name {
          found = lay.fields
          hits += 1
        }
      }
    }
    if hits == 0 {
      fail(loc, "unknown type ${type_name} for fields")
    }
    if hits > 1 {
      fail(loc, "ambiguous type ${type_name} for fields")
    }
    found
  }

  pub fn fill_function(fnn: Function) {
    if sp = fnn.name_splice {
      fnn.name = splice_to_ident(sp)
      fnn.emit_name = fnn.name
      fnn.name_splice = nil
    }
    if r = fnn.receiver {
      r.type = fill_type_name(r.type)
    }
    if t = fnn.return_type {
      fnn.return_type = fill_type_name(t)
    }
    i = 0
    while i < fnn.params.size {
      fnn.params[i].type = fill_type_name(fnn.params[i].type)
      i += 1
    }
    body: Array(Stmt) = []
    i = 0
    while i < fnn.body.size {
      body.push(fill_stmt(fnn.body[i]))
      i += 1
    }
    fnn.body = body
  }

  pub fn fill_type_name(tn: TypeName): TypeName {
    if sp = tn.splice {
      return splice_to_type(sp)
    }
    args: Array(TypeName) = []
    i = 0
    while i < tn.args.size {
      args.push(fill_type_name(tn.args[i]))
      i += 1
    }
    tn.args = args
    if r = tn.ret {
      tn.ret = fill_type_name(r)
    }
    members: Array(TypeName) = []
    i = 0
    while i < tn.members.size {
      members.push(fill_type_name(tn.members[i]))
      i += 1
    }
    tn.members = members
    tn
  }

  pub fn fill_stmt(s: Stmt): Stmt {
    k = s.kind
    if k == st_expr() {
      if e = s.expr {
        return stmt_expr(s.loc, fill_expr(e))
      }
      return s
    }
    if k == st_return() {
      if e = s.expr {
        return stmt_return_val(s.loc, fill_expr(e))
      }
      return stmt_return_void(s.loc)
    }
    if k == st_if() {
      out = Stmt.new(st_if(), s.loc)
      out.bind = s.bind
      if c = s.cond {
        out.cond = fill_expr(c)
      }
      i = 0
      while i < s.pre.size {
        out.pre.push(fill_stmt(s.pre[i]))
        i += 1
      }
      i = 0
      while i < s.then_body.size {
        out.then_body.push(fill_stmt(s.then_body[i]))
        i += 1
      }
      i = 0
      while i < s.else_body.size {
        out.else_body.push(fill_stmt(s.else_body[i]))
        i += 1
      }
      return out
    }
    if k == st_while() {
      out = Stmt.new(st_while(), s.loc)
      out.for_kind = s.for_kind
      if c = s.cond {
        out.cond = fill_expr(c)
      }
      i = 0
      while i < s.pre.size {
        out.pre.push(fill_stmt(s.pre[i]))
        i += 1
      }
      i = 0
      while i < s.body.size {
        out.body.push(fill_stmt(s.body[i]))
        i += 1
      }
      return out
    }
    if k == st_release() {
      out = Stmt.new(st_release(), s.loc)
      if e = s.expr {
        out.expr = fill_expr(e)
      }
      return out
    }
    if k == st_pin() || k == st_hold() {
      out = Stmt.new(k, s.loc)
      if e = s.expr {
        out.expr = fill_expr(e)
      }
      i = 0
      while i < s.body.size {
        out.body.push(fill_stmt(s.body[i]))
        i += 1
      }
      return out
    }
    if k == st_assign() {
      out = Stmt.new(st_assign(), s.loc)
      out.op = s.op
      if t = s.target {
        out.target = fill_expr(t)
      }
      if v = s.value {
        out.value = fill_expr(v)
      }
      if d = s.declared {
        out.declared = fill_type_name(d)
      }
      return out
    }
    if k == st_quote() {
      return stmt_quote(s.loc, fill_stmt_list(s.body))
    }
    s
  }

  pub fn fill_stmt_list(body: Array(Stmt)): Array(Stmt) {
    out: Array(Stmt) = []
    i = 0
    while i < body.size {
      out.push(fill_stmt(body[i]))
      i += 1
    }
    out
  }

  pub fn fill_expr(e: Expr): Expr {
    k = e.kind
    if k == ex_splice() {
      return splice_to_expr(e)
    }
    if k == ex_call() {
      if sp = e.splice {
        e.callee = splice_to_ident(sp)
        e.splice = nil
      }
      if r = e.receiver {
        e.receiver = fill_expr(r)
      }
      args: Array(Expr) = []
      i = 0
      while i < e.args.size {
        args.push(fill_expr(e.args[i]))
        i += 1
      }
      e.args = args
      if b = e.block {
        b.body = fill_stmt_list(b.body)
      }
      if inner = e.inner {
        e.inner = fill_expr(inner)
      }
      return e
    }
    if k == ex_lambda() {
      if b = e.block {
        i = 0
        while i < b.param_types.size {
          b.param_types[i] = fill_type_name(b.param_types[i])
          i += 1
        }
        b.body = fill_stmt_list(b.body)
      }
      return e
    }
    if k == ex_unary() {
      out = Expr.new(ex_unary(), e.loc)
      out.op = e.op
      if inner = e.inner {
        out.inner = fill_expr(inner)
      }
      return out
    }
    if k == ex_binary() {
      out = Expr.new(ex_binary(), e.loc)
      out.op = e.op
      if l = e.left {
        out.left = fill_expr(l)
      }
      if r = e.right {
        out.right = fill_expr(r)
      }
      return out
    }
    if k == ex_field() {
      if sp = e.splice {
        e.ident = splice_to_ident(sp)
        e.splice = nil
      }
      out = Expr.new(ex_field(), e.loc)
      out.ident = e.ident
      out.method_call = e.method_call
      if obj = e.object {
        out.object = fill_expr(obj)
      }
      return out
    }
    if k == ex_index() {
      out = Expr.new(ex_index(), e.loc)
      if l = e.left {
        out.left = fill_expr(l)
      }
      if r = e.right {
        out.right = fill_expr(r)
      }
      return out
    }
    if k == ex_struct() {
      out = clone_expr(e)
      fe: Array(Expr) = []
      i = 0
      while i < e.field_exprs.size {
        fe.push(fill_expr(e.field_exprs[i]))
        i += 1
      }
      out.field_exprs = fe
      return out
    }
    if k == ex_array() {
      out = Expr.new(ex_array(), e.loc)
      i = 0
      while i < e.elems.size {
        out.elems.push(fill_expr(e.elems[i]))
        i += 1
      }
      return out
    }
    if k == ex_array_new() {
      out = Expr.new(ex_array_new(), e.loc)
      if t = e.elem_type {
        out.elem_type = fill_type_name(t)
      }
      if sz = e.size_expr {
        out.size_expr = fill_expr(sz)
      }
      for fv in e.elems {
        out.elems.push(fill_expr(fv))
      }
      return out
    }
    if k == ex_hash_new() {
      out = Expr.new(ex_hash_new(), e.loc)
      if t = e.key_type {
        out.key_type = fill_type_name(t)
      }
      if t = e.val_type {
        out.val_type = fill_type_name(t)
      }
      return out
    }
    if k == ex_try() {
      out = Expr.new(ex_try(), e.loc)
      if inner = e.inner {
        out.inner = fill_expr(inner)
      }
      return out
    }
    if k == ex_interp() {
      out = clone_expr(e)
      for p in out.parts {
        if inner = p.expr {
          p.expr = fill_expr(inner)
        }
      }
      return out
    }
    if k == ex_switch() {
      out = clone_expr(e)
      if c = e.cond {
        out.cond = fill_expr(c)
      }
      for arm in out.cases {
        arm.body = fill_stmt_list(arm.body)
      }
      eb: Array(Stmt) = []
      i = 0
      while i < e.else_body.size {
        eb.push(fill_stmt(e.else_body[i]))
        i += 1
      }
      out.else_body = eb
      return out
    }
    e
  }

  pub fn splice_payload(sp: Expr): Expr {
    if sp.kind == ex_splice() {
      if inner = sp.inner {
        return inner
      }
    }
    sp
  }

  pub fn splice_to_ident(sp: Expr): String {
    inner = splice_payload(sp)
    if inner.kind == ex_string() {
      return ident_from_string(inner.value_str, inner.loc)
    }
    if inner.kind == ex_name() {
      return inner.ident
    }
    if inner.kind == ex_field() {
      return walk_field_name(inner)
    }
    fail(inner.loc, "splice is a name here")
    ""
  }

  pub fn splice_to_type(sp: Expr): TypeName {
    inner = splice_payload(sp)
    if inner.kind == ex_string() {
      return TypeName.new(inner.loc, ident_from_string(inner.value_str, inner.loc))
    }
    if inner.kind == ex_name() {
      return TypeName.new(inner.loc, inner.ident)
    }
    if inner.kind == ex_field() {
      if !walk_field(inner) {
        fail(inner.loc, "splice f.type needs a field walk")
        return TypeName.new(inner.loc, "Int")
      }
      if inner.ident == "type" {
      } else {
        fail(inner.loc, "f.type is the field type in a walk")
        return TypeName.new(inner.loc, "Int")
      }
      if field = self.ctx_field {
        return clone_type_name(field.type)
      }
      fail(inner.loc, "splice f.type needs a field walk")
      return TypeName.new(inner.loc, "Int")
    }
    fail(inner.loc, "splice is a type here")
    TypeName.new(inner.loc, "Int")
  }

  pub fn splice_to_expr(sp: Expr): Expr {
    inner = splice_payload(sp)
    k = inner.kind
    if k == ex_int() {
      return clone_expr(inner)
    }
    if k == ex_float() {
      return clone_expr(inner)
    }
    if k == ex_string() {
      return clone_expr(inner)
    }
    if k == ex_bool() {
      return clone_expr(inner)
    }
    if k == ex_nil() {
      return clone_expr(inner)
    }
    if k == ex_name() {
      e = Expr.new(ex_name(), inner.loc)
      e.ident = inner.ident
      return e
    }
    if k == ex_field() {
      if !walk_field(inner) {
        fail(inner.loc, "splice f.name needs a field walk")
        return inner
      }
      if field = self.ctx_field {
        if inner.ident == "name" {
          e = Expr.new(ex_string(), inner.loc)
          e.value_str = field.name
          return e
        }
        if inner.ident == "type" {
          fail(inner.loc, "f.type is a type, not an expression")
          return inner
        }
        fail(inner.loc, "field walk splice is f.name or f.type")
        return inner
      }
      fail(inner.loc, "splice f.name needs a field walk")
      return inner
    }
    fail(inner.loc, "splice is a literal, a name, or f.name / f.type")
    inner
  }

  pub fn walk_field(fa: Expr): Bool {
    if self.ctx_var.size == 0 {
      return false
    }
    if obj = fa.object, obj.kind == ex_name() && obj.ident == self.ctx_var {
      if fa.ident == "name" {
        return true
      }
      if fa.ident == "type" {
        return true
      }
    }
    false
  }

  pub fn walk_field_name(fa: Expr): String {
    if !walk_field(fa) {
      fail(fa.loc, "splice f.name needs a field walk")
      return ""
    }
    if fa.ident == "name" {
    } else {
      fail(fa.loc, "f.name is the field name in a walk")
      return ""
    }
    if field = self.ctx_field {
      return field.name
    }
    ""
  }

  pub fn ident_from_string(s: String, loc: Location): String {
    if ident_ok(s) {
      return s
    }
    fail(loc, "splice is not an identifier ${s}")
    s
  }

  pub fn hygiene_function(fnn: Function) {
    introduced: Array(String) = []
    for param in fnn.params {
      if param.name == "self" {
      } else {
        introduced.push(param.name)
      }
    }
    if r = fnn.receiver {
      if r.name == "self" {
      } else {
        introduced.push(r.name)
      }
    }
    collect_introduced(fnn.body, introduced)
    map = rename_map(introduced)
    if map.size == 0 {
      return
    }
    for i in 0..fnn.params.size {
      if mapped = map.get(fnn.params[i].name) {
        fnn.params[i].name = mapped
      }
    }
    if r = fnn.receiver, mapped = map.get(r.name) {
      r.name = mapped
    }
    fnn.body = rename_stmt_list(fnn.body, map)
  }

  pub fn hygiene_stmts(body: Array(Stmt)): Array(Stmt) {
    introduced: Array(String) = []
    collect_introduced(body, introduced)
    map = rename_map(introduced)
    if map.size == 0 {
      return body
    }
    rename_stmt_list(body, map)
  }

  pub fn rename_map(introduced: Array(String)): Hash(String, String) {
    map = Hash(String, String).new
    if introduced.size == 0 {
      return map
    }
    id = self.next_id
    self.next_id += 1
    for name in introduced {
      if name == "self" {
      } else {
        if prev = map.get(name) {
        } else {
          map[name] = "__q${id}_${name}"
        }
      }
    }
    map
  }

  pub fn collect_introduced(body: Array(Stmt), into: Array(String)) {
    for s in body {
      k = s.kind
      if k == st_assign() {
        if t = s.target, t.kind == ex_name() && t.ident != "_" {
          into.push(t.ident)
        }
        if v = s.value {
          collect_introduced_expr(v, into)
        }
      } else if k == st_if() {
        collect_introduced(s.pre, into)
        if s.bind.size > 0 {
          into.push(s.bind)
        }
        if c = s.cond {
          collect_introduced_expr(c, into)
        }
        collect_introduced(s.then_body, into)
        collect_introduced(s.else_body, into)
      } else if k == st_while() {
        collect_introduced(s.pre, into)
        if c = s.cond {
          collect_introduced_expr(c, into)
        }
        collect_introduced(s.body, into)
      } else if k == st_quote() {
        collect_introduced(s.body, into)
      } else if k == st_pin() || k == st_hold() {
        // O131 (Stage 29 W1a): the names a `pin` block assigns are the
        // quote's too (a `gc.hold` block's as well, W1c2).
        if pe = s.expr {
          collect_introduced_expr(pe, into)
        }
        collect_introduced(s.body, into)
      } else if k == st_release() {
        if re = s.expr {
          collect_introduced_expr(re, into)
        }
      } else if k == st_expr() {
        if e = s.expr {
          collect_introduced_expr(e, into)
        }
      } else if k == st_return() {
        if e = s.expr {
          collect_introduced_expr(e, into)
        }
      }
    }
  }

  pub fn collect_introduced_expr(e: Expr, into: Array(String)) {
    k = e.kind
    if k == ex_call() {
      if b = e.block {
        i = 0
        while i < b.params.size {
          into.push(b.params[i])
          i += 1
        }
        collect_introduced(b.body, into)
      }
      if r = e.receiver {
        collect_introduced_expr(r, into)
      }
      i = 0
      while i < e.args.size {
        collect_introduced_expr(e.args[i], into)
        i += 1
      }
      return
    }
    if k == ex_unary() {
      if inner = e.inner {
        collect_introduced_expr(inner, into)
      }
      return
    }
    if k == ex_binary() {
      if l = e.left {
        collect_introduced_expr(l, into)
      }
      if r = e.right {
        collect_introduced_expr(r, into)
      }
      return
    }
    if k == ex_field() {
      if obj = e.object {
        collect_introduced_expr(obj, into)
      }
      return
    }
    if k == ex_index() {
      if l = e.left {
        collect_introduced_expr(l, into)
      }
      if r = e.right {
        collect_introduced_expr(r, into)
      }
      return
    }
    if k == ex_struct() {
      i = 0
      while i < e.field_exprs.size {
        collect_introduced_expr(e.field_exprs[i], into)
        i += 1
      }
      return
    }
    if k == ex_array() {
      i = 0
      while i < e.elems.size {
        collect_introduced_expr(e.elems[i], into)
        i += 1
      }
      return
    }
    if k == ex_array_new() {
      if sz = e.size_expr {
        collect_introduced_expr(sz, into)
      }
      for fv in e.elems {
        collect_introduced_expr(fv, into)
      }
      return
    }
    if k == ex_try() {
      if inner = e.inner {
        collect_introduced_expr(inner, into)
      }
      return
    }
    if k == ex_interp() {
      for p in e.parts {
        if inner = p.expr {
          collect_introduced_expr(inner, into)
        }
      }
      return
    }
    if k == ex_switch() {
      if c = e.cond {
        collect_introduced_expr(c, into)
      }
      i = 0
      while i < e.cases.size {
        collect_introduced(e.cases[i].body, into)
        i += 1
      }
      collect_introduced(e.else_body, into)
      return
    }
    if k == ex_lambda() {
      if b = e.block {
        i = 0
        while i < b.params.size {
          into.push(b.params[i])
          i += 1
        }
        collect_introduced(b.body, into)
      }
    }
  }

  pub fn rename_stmt_list(body: Array(Stmt), map: Hash(String, String)): Array(Stmt) {
    out: Array(Stmt) = []
    i = 0
    while i < body.size {
      out.push(rename_stmt(body[i], map))
      i += 1
    }
    out
  }

  pub fn rename_stmt(s: Stmt, map: Hash(String, String)): Stmt {
    k = s.kind
    if k == st_expr() {
      if e = s.expr {
        return stmt_expr(s.loc, rename_expr(e, map))
      }
      return s
    }
    if k == st_return() {
      if e = s.expr {
        return stmt_return_val(s.loc, rename_expr(e, map))
      }
      return stmt_return_void(s.loc)
    }
    if k == st_if() {
      out = Stmt.new(st_if(), s.loc)
      out.bind = s.bind
      if mapped = map.get(s.bind) {
        out.bind = mapped
      }
      if c = s.cond {
        out.cond = rename_expr(c, map)
      }
      out.pre = rename_stmt_list(s.pre, map)
      out.then_body = rename_stmt_list(s.then_body, map)
      out.else_body = rename_stmt_list(s.else_body, map)
      return out
    }
    if k == st_while() {
      out = Stmt.new(st_while(), s.loc)
      out.for_kind = s.for_kind
      if c = s.cond {
        out.cond = rename_expr(c, map)
      }
      out.pre = rename_stmt_list(s.pre, map)
      out.body = rename_stmt_list(s.body, map)
      return out
    }
    if k == st_assign() {
      out = Stmt.new(st_assign(), s.loc)
      out.op = s.op
      out.declared = s.declared
      if t = s.target {
        out.target = rename_expr(t, map)
      }
      if v = s.value {
        out.value = rename_expr(v, map)
      }
      return out
    }
    if k == st_quote() {
      return stmt_quote(s.loc, rename_stmt_list(s.body, map))
    }
    if k == st_release() {
      out = Stmt.new(st_release(), s.loc)
      if e = s.expr {
        out.expr = rename_expr(e, map)
      }
      return out
    }
    if k == st_pin() || k == st_hold() {
      // O131 (Stage 29 W1a): before, a `pin` block kept its names, so a
      // quote's local inside it captured the paste site's.
      out = Stmt.new(k, s.loc)
      if e = s.expr {
        out.expr = rename_expr(e, map)
      }
      out.body = rename_stmt_list(s.body, map)
      return out
    }
    s
  }

  pub fn rename_expr(e: Expr, map: Hash(String, String)): Expr {
    k = e.kind
    if k == ex_name() {
      if mapped = map.get(e.ident) {
        n = Expr.new(ex_name(), e.loc)
        n.ident = mapped
        n.implicit_field = e.implicit_field
        return n
      }
      return e
    }
    if k == ex_call() {
      out = clone_expr(e)
      if mapped = map.get(e.callee) {
        out.callee = mapped
      }
      if r = e.receiver {
        out.receiver = rename_expr(r, map)
      }
      args: Array(Expr) = []
      i = 0
      while i < e.args.size {
        args.push(rename_expr(e.args[i], map))
        i += 1
      }
      out.args = args
      if b = e.block {
        nb = clone_block(b)
        for i in 0..nb.params.size {
          if mapped = map.get(nb.params[i]) {
            nb.params[i] = mapped
          }
        }
        nb.body = rename_stmt_list(b.body, map)
        out.block = nb
      }
      return out
    }
    if k == ex_unary() {
      out = Expr.new(ex_unary(), e.loc)
      out.op = e.op
      if inner = e.inner {
        out.inner = rename_expr(inner, map)
      }
      return out
    }
    if k == ex_binary() {
      out = Expr.new(ex_binary(), e.loc)
      out.op = e.op
      if l = e.left {
        out.left = rename_expr(l, map)
      }
      if r = e.right {
        out.right = rename_expr(r, map)
      }
      return out
    }
    if k == ex_field() {
      out = Expr.new(ex_field(), e.loc)
      out.ident = e.ident
      out.method_call = e.method_call
      if obj = e.object {
        out.object = rename_expr(obj, map)
      }
      return out
    }
    if k == ex_index() {
      out = Expr.new(ex_index(), e.loc)
      if l = e.left {
        out.left = rename_expr(l, map)
      }
      if r = e.right {
        out.right = rename_expr(r, map)
      }
      return out
    }
    if k == ex_struct() {
      out = clone_expr(e)
      fe: Array(Expr) = []
      i = 0
      while i < e.field_exprs.size {
        fe.push(rename_expr(e.field_exprs[i], map))
        i += 1
      }
      out.field_exprs = fe
      return out
    }
    if k == ex_array() {
      out = Expr.new(ex_array(), e.loc)
      i = 0
      while i < e.elems.size {
        out.elems.push(rename_expr(e.elems[i], map))
        i += 1
      }
      return out
    }
    if k == ex_array_new() {
      out = clone_expr(e)
      if sz = e.size_expr {
        out.size_expr = rename_expr(sz, map)
      }
      for i in 0..e.elems.size {
        out.elems[i] = rename_expr(e.elems[i], map)
      }
      return out
    }
    if k == ex_try() {
      out = Expr.new(ex_try(), e.loc)
      if inner = e.inner {
        out.inner = rename_expr(inner, map)
      }
      return out
    }
    if k == ex_interp() {
      out = clone_expr(e)
      for p in out.parts {
        if inner = p.expr {
          p.expr = rename_expr(inner, map)
        }
      }
      return out
    }
    if k == ex_switch() {
      out = clone_expr(e)
      if c = e.cond {
        out.cond = rename_expr(c, map)
      }
      i = 0
      while i < out.cases.size {
        arm = out.cases[i]
        arm.body = rename_stmt_list(arm.body, map)
        i += 1
      }
      out.else_body = rename_stmt_list(e.else_body, map)
      return out
    }
    if k == ex_lambda() {
      out = clone_expr(e)
      if b = e.block {
        nb = clone_block(b)
        for i in 0..nb.params.size {
          if mapped = map.get(nb.params[i]) {
            nb.params[i] = mapped
          }
        }
        nb.body = rename_stmt_list(b.body, map)
        out.block = nb
      }
      return out
    }
    e
  }

  pub fn expand_stmt_list(body: Array(Stmt)): Array(Stmt) {
    out: Array(Stmt) = []
    for s in body {
      k = s.kind
      if k == st_quote() {
        filled = fill_stmt_list(s.body)
        hygiened = hygiene_stmts(filled)
        nested = expand_stmt_list(hygiened)
        j = 0
        while j < nested.size {
          out.push(nested[j])
          j += 1
        }
      } else if k == st_if() {
        n = Stmt.new(st_if(), s.loc)
        n.bind = s.bind
        n.cond = s.cond
        n.pre = expand_stmt_list(s.pre)
        n.then_body = expand_stmt_list(s.then_body)
        n.else_body = expand_stmt_list(s.else_body)
        out.push(n)
      } else if k == st_while() {
        n = Stmt.new(st_while(), s.loc)
        n.for_kind = s.for_kind
        n.cond = s.cond
        n.pre = expand_stmt_list(s.pre)
        n.body = expand_stmt_list(s.body)
        out.push(n)
      } else if k == st_pin() || k == st_hold() {
        n = Stmt.new(k, s.loc)
        n.expr = s.expr
        n.body = expand_stmt_list(s.body)
        out.push(n)
      } else if k == st_expr() {
        if e = s.expr {
          if e.kind == ex_switch() {
            sw = clone_expr(e)
            j = 0
            while j < sw.cases.size {
              sw.cases[j].body = expand_stmt_list(e.cases[j].body)
              j += 1
            }
            sw.else_body = expand_stmt_list(e.else_body)
            out.push(stmt_expr(s.loc, sw))
          } else {
            out.push(s)
          }
        } else {
          out.push(s)
        }
      } else {
        out.push(s)
      }
    }
    out
  }
}
