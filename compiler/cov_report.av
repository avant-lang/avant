import source
import pipeline

lib cov_posix {
  fun isatty(fd: Int): Int
}

pub class CovSlot {
  kind: String = ""
  path: String = ""
  line: Int = 0
  name: String = ""
  hits: Int = 0
  bare: Bool = false

  fn initialize(kind: String, path: String, line: Int, name: String, hits: Int, bare: Bool) {
    self.kind = kind
    self.path = path
    self.line = line
    self.name = name
    self.hits = hits
    self.bare = bare
  }
}

pub class CovReport {
  anchor: String = ""
  slots: Array(CovSlot)
  excludes: Array(String)

  fn initialize(anchor: String) {
    self.anchor = anchor
    xs: Array(CovSlot) = []
    self.slots = xs
    ex: Array(String) = []
    self.excludes = ex
  }

  pub fn use_excludes(dirs: Array(String)) {
    self.excludes = dirs
  }

  pub fn merge_map(map_path: String) {
    if text = file_read(map_path) {
      hits = ""
      if raw = file_read("${map_path}.hits") {
        hits = raw
      }
      lines = cov_lines(text)
      if lines.size == 0 {
        return
      }
      head = lines[0]
      if str_starts(head, "avant-cov ") {
      } else {
        return
      }
      i = 1
      while i < lines.size {
        parts = cov_tabs(lines[i])
        if parts.size >= 3 {
          kind = parts[0]
          path = cov_rel(self.anchor, parts[1])
          line = cov_parse_u(parts[2])
          name = ""
          if parts.size >= 4 {
            name = parts[3]
          }
          if line >= 0 && kind.size == 1 {
            hit = cov_read_hit(hits, i - 1)
            self.add_slot(kind, path, line, name, hit, false)
          }
        }
        i = i + 1
      }
    }
  }

  pub fn add_tree(dir_abs: String, excludes: Array(String)) {
    self.walk_tree(dir_abs, excludes)
  }

  pub fn has_rows: Bool {
    self.slots.size > 0
  }

  pub fn write_lcov(path: String) {
    b = buf_new()
    paths = self.path_list()
    i = 0
    while i < paths.size {
      p = paths[i]
      bare = self.path_bare(p)
      b.push_str("TN:\n")
      b.push_str("SF:${p}\n")
      if bare {
        self.write_lines(b, p)
      } else {
        self.write_funcs(b, p)
        self.write_branches(b, p)
        self.write_lines(b, p)
      }
      b.push_str("end_of_record\n")
      i = i + 1
    }
    w = file_write(path, b.to_s)
    if w != 0 {
      diag_puts("cannot write ${path}")
    }
  }

  pub fn print_table {
    paths = self.path_list()
    if paths.size == 0 {
      return
    }
    color = cov_color()
    file_w = 10
    i = 0
    while i < paths.size {
      n = paths[i].size
      if n > file_w {
        file_w = n
      }
      i = i + 1
    }
    if file_w > 36 {
      file_w = 36
    }
    puts("")
    cov_border(file_w)
    puts(" ${cov_pad("File", file_w)} | % Stmts | % Branch | % Funcs | % Lines | Uncovered Line #s")
    cov_border(file_w)
    puts(" ${cov_pad("All files", file_w)} |${self.col_stmt("")}|${self.col_branch("")}|${self.col_func("")}|${self.col_line("")}|")
    i = 0
    while i < paths.size {
      p = paths[i]
      shown = p
      if shown.size > file_w {
        shown = str_slice(shown, 0, file_w)
      }
      uncovered = self.uncovered(p)
      puts(" ${cov_pad(shown, file_w)} |${self.col_stmt(p)}|${self.col_branch(p)}|${self.col_func(p)}|${self.col_line(p)}| ${uncovered}")
      i = i + 1
    }
    cov_border(file_w)
  }

  fn add_slot(kind: String, path: String, line: Int, name: String, hits: Int, bare: Bool) {
    if cov_excluded(path, self.excludes) {
      return
    }
    if self.known(path) && bare {
      return
    }
    i = 0
    while i < self.slots.size {
      s = self.slots[i]
      if str_eq(s.kind, kind) {
        if str_eq(s.path, path) {
          if s.line == line {
            if str_eq(s.name, name) {
              s.hits = s.hits + hits
              if bare {
              } else {
                s.bare = false
              }
              self.slots[i] = s
              return
            }
          }
        }
      }
      i = i + 1
    }
    self.slots.push(CovSlot.new(kind, path, line, name, hits, bare))
  }

  fn known(path: String): Bool {
    i = 0
    while i < self.slots.size {
      if str_eq(self.slots[i].path, path) {
        return true
      }
      i = i + 1
    }
    false
  }

  fn walk_tree(dir_abs: String, excludes: Array(String)) {
    names = dir_list(dir_abs)
    i = 0
    while i < names.size {
      name = names[i]
      i = i + 1
      if name.size == 0 {
        continue
      }
      if name[0] == 46 {
        continue
      }
      path = "${dir_abs}/${name}"
      if str_eq(dir_abs, "/") {
        path = "/${name}"
      }
      if file_exists("${path}/.") {
        self.walk_tree(path, excludes)
      } else {
        if str_ends(name, ".av") {
          rel = cov_rel(self.anchor, path)
          if cov_excluded(rel, excludes) {
          } else {
            if self.known(rel) {
            } else {
              self.add_bare(rel, path)
            }
          }
        }
      }
    }
  }

  fn add_bare(rel: String, abs: String) {
    if text = file_read(abs) {
      lines = cov_code_lines(text)
      i = 0
      while i < lines.size {
        self.add_slot("L", rel, lines[i], "", 0, true)
        i = i + 1
      }
      if lines.size == 0 {
        self.add_slot("L", rel, 0, "", 0, true)
      }
    }
  }

  fn path_list: Array(String) {
    out: Array(String) = []
    i = 0
    while i < self.slots.size {
      p = self.slots[i].path
      found = false
      j = 0
      while j < out.size {
        if str_eq(out[j], p) {
          found = true
        }
        j = j + 1
      }
      if found {
      } else {
        out.push(p)
      }
      i = i + 1
    }
    a = 1
    while a < out.size {
      b = a
      while b > 0 {
        if cov_less(out[b], out[b - 1]) {
          tmp = out[b]
          out[b] = out[b - 1]
          out[b - 1] = tmp
          b = b - 1
        } else {
          break
        }
      }
      a = a + 1
    }
    out
  }

  fn path_bare(path: String): Bool {
    i = 0
    seen = false
    while i < self.slots.size {
      s = self.slots[i]
      if str_eq(s.path, path) {
        seen = true
        if s.bare {
        } else {
          return false
        }
      }
      i = i + 1
    }
    seen
  }

  fn count(path: String, kind: String, hit_only: Bool): Int {
    n = 0
    i = 0
    while i < self.slots.size {
      s = self.slots[i]
      if str_eq(s.kind, kind) {
        if path.size == 0 || str_eq(s.path, path) {
          if s.line == 0 && s.bare {
          } else {
            if hit_only {
              if s.hits > 0 {
                n = n + 1
              }
            } else {
              n = n + 1
            }
          }
        }
      }
      i = i + 1
    }
    n
  }

  fn col_stmt(path: String): String {
    self.col(path, "S")
  }

  fn col_branch(path: String): String {
    self.col(path, "B")
  }

  fn col_func(path: String): String {
    self.col(path, "F")
  }

  fn col_line(path: String): String {
    if path.size > 0 && self.path_bare(path) {
      tot = self.count(path, "L", false)
      if tot == 0 {
        return "     0 "
      }
      return "     0 "
    }
    if path.size == 0 {
      tot = self.count("", "L", false)
      hit = self.count("", "L", true)
      if tot == 0 {
        return "     - "
      }
      return cov_pct(hit, tot)
    }
    tot = self.count(path, "L", false)
    hit = self.count(path, "L", true)
    if tot == 0 {
      return "     - "
    }
    cov_pct(hit, tot)
  }

  fn col(path: String, kind: String): String {
    if path.size > 0 && self.path_bare(path) {
      return "     - "
    }
    tot = self.count(path, kind, false)
    if tot == 0 {
      return "     - "
    }
    hit = self.count(path, kind, true)
    cov_pct(hit, tot)
  }

  fn uncovered(path: String): String {
    nums: Array(Int) = []
    i = 0
    while i < self.slots.size {
      s = self.slots[i]
      if str_eq(s.path, path) && str_eq(s.kind, "L") && s.hits == 0 && s.line > 0 {
        have = false
        j = 0
        while j < nums.size {
          if nums[j] == s.line {
            have = true
          }
          j = j + 1
        }
        if have {
        } else {
          nums.push(s.line)
        }
      }
      i = i + 1
    }
    a = 1
    while a < nums.size {
      b = a
      while b > 0 {
        if nums[b] < nums[b - 1] {
          tmp = nums[b]
          nums[b] = nums[b - 1]
          nums[b - 1] = tmp
          b = b - 1
        } else {
          break
        }
      }
      a = a + 1
    }
    out = buf_new()
    i = 0
    while i < nums.size {
      if i > 0 {
        out.push_str(",")
      }
      out.push_str("${nums[i]}")
      if out.to_s.size > 40 {
        out.push_str("...")
        break
      }
      i = i + 1
    }
    out.to_s
  }

  fn write_funcs(b: Buf, path: String) {
    tot = 0
    hit = 0
    i = 0
    while i < self.slots.size {
      s = self.slots[i]
      if str_eq(s.path, path) && str_eq(s.kind, "F") {
        name = s.name
        if name.size == 0 {
          name = "fn"
        }
        b.push_str("FN:${s.line},${name}\n")
      }
      i = i + 1
    }
    i = 0
    while i < self.slots.size {
      s = self.slots[i]
      if str_eq(s.path, path) && str_eq(s.kind, "F") {
        name = s.name
        if name.size == 0 {
          name = "fn"
        }
        b.push_str("FNDA:${s.hits},${name}\n")
        tot = tot + 1
        if s.hits > 0 {
          hit = hit + 1
        }
      }
      i = i + 1
    }
    b.push_str("FNF:${tot}\n")
    b.push_str("FNH:${hit}\n")
  }

  fn write_branches(b: Buf, path: String) {
    tot = 0
    hit = 0
    i = 0
    while i < self.slots.size {
      s = self.slots[i]
      if str_eq(s.path, path) && str_eq(s.kind, "B") {
        if s.hits > 0 {
          b.push_str("BRDA:${s.line},0,${tot},${s.hits}\n")
          hit = hit + 1
        } else {
          b.push_str("BRDA:${s.line},0,${tot},-\n")
        }
        tot = tot + 1
      }
      i = i + 1
    }
    b.push_str("BRF:${tot}\n")
    b.push_str("BRH:${hit}\n")
  }

  fn write_lines(b: Buf, path: String) {
    seen: Array(Int) = []
    tot = 0
    hit = 0
    i = 0
    while i < self.slots.size {
      s = self.slots[i]
      if str_eq(s.path, path) && str_eq(s.kind, "L") && s.line > 0 {
        have = false
        j = 0
        while j < seen.size {
          if seen[j] == s.line {
            have = true
          }
          j = j + 1
        }
        if have {
        } else {
          seen.push(s.line)
          sum = 0
          k = 0
          while k < self.slots.size {
            t = self.slots[k]
            if str_eq(t.path, path) && str_eq(t.kind, "L") && t.line == s.line {
              sum = sum + t.hits
            }
            k = k + 1
          }
          b.push_str("DA:${s.line},${sum}\n")
          tot = tot + 1
          if sum > 0 {
            hit = hit + 1
          }
        }
      }
      i = i + 1
    }
    b.push_str("LF:${tot}\n")
    b.push_str("LH:${hit}\n")
  }
}

fn cov_lines(text: String): Array(String) {
  out: Array(String) = []
  start = 0
  i = 0
  while i <= text.size {
    if i == text.size || text[i] == 10 {
      line = str_slice(text, start, i)
      if line.size > 0 && line[line.size - 1] == 13 {
        line = str_slice(line, 0, line.size - 1)
      }
      out.push(line)
      start = i + 1
    }
    i = i + 1
  }
  out
}

fn cov_tabs(line: String): Array(String) {
  out: Array(String) = []
  start = 0
  i = 0
  while i <= line.size {
    if i == line.size || line[i] == 9 {
      out.push(str_slice(line, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out
}

fn cov_parse_u(s: String): Int {
  if s.size == 0 {
    return -1
  }
  n = 0
  i = 0
  while i < s.size {
    c = s[i]
    if c < 48 || c > 57 {
      return -1
    }
    n = n * 10 + (c - 48)
    i = i + 1
  }
  n
}

fn cov_read_hit(buf: String, slot: Int): Int {
  off = slot * 8
  if off < 0 {
    return 0
  }
  if off + 4 > buf.size {
    return 0
  }
  b0 = buf[off]
  b1 = buf[off + 1]
  b2 = buf[off + 2]
  n = b0 + b1 * 256
  n = n + b2 * 65536
  n
}

pub fn cov_rel(anchor: String, path: String): String {
  p = path
  if p.size > 1 {
    if p[0] == 46 && p[1] == 47 {
      p = str_slice(p, 2, p.size)
    }
  }
  if anchor.size > 0 && p.size > anchor.size && p[0] == 47 {
    if str_eq(str_slice(p, 0, anchor.size), anchor) {
      if p[anchor.size] == 47 {
        return str_slice(p, anchor.size + 1, p.size)
      }
    }
  }
  p
}

pub fn cov_excluded(path: String, dirs: Array(String)): Bool {
  i = 0
  while i < dirs.size {
    d = dirs[i]
    if str_eq(path, d) {
      return true
    }
    pre = d
    if d.size == 0 || d[d.size - 1] != 47 {
      pre = "${d}/"
    }
    if str_starts(path, pre) {
      return true
    }
    i = i + 1
  }
  false
}

fn cov_code_lines(text: String): Array(Int) {
  out: Array(Int) = []
  line = 1
  start = 0
  i = 0
  while i <= text.size {
    if i == text.size || text[i] == 10 {
      raw = str_slice(text, start, i)
      if raw.size > 0 && raw[raw.size - 1] == 13 {
        raw = str_slice(raw, 0, raw.size - 1)
      }
      t = raw.strip()
      if t.size > 0 {
        if t.size >= 2 && t[0] == 47 && t[1] == 47 {
        } else {
          out.push(line)
        }
      }
      line = line + 1
      start = i + 1
    }
    i = i + 1
  }
  out
}

fn cov_less(a: String, b: String): Bool {
  n = a.size
  if b.size < n {
    n = b.size
  }
  i = 0
  while i < n {
    if a[i] < b[i] {
      return true
    }
    if a[i] > b[i] {
      return false
    }
    i = i + 1
  }
  a.size < b.size
}

fn cov_color: Bool {
  if v = env_get("AVANT_COVERAGE_COLOR") {
    if str_eq(v, "0") {
      return false
    }
    if str_eq(v, "1") {
      return true
    }
  }
  cov_posix.isatty(1) == 1
}

fn cov_pct(hit: Int, tot: Int): String {
  if tot <= 0 {
    return "     - "
  }
  pct = ((100 * hit) + (tot / 2)) / tot
  text = "${pct}"
  pad = 6 - text.size
  if pad < 1 {
    pad = 1
  }
  b = buf_new()
  i = 0
  while i < pad {
    b.push_str(" ")
    i = i + 1
  }
  if cov_color() {
    code = "31"
    if pct >= 80 {
      code = "32"
    } else {
      if pct >= 50 {
        code = "33"
      }
    }
    b.push_byte(27)
    b.push_str("[${code}m")
    b.push_str(text)
    b.push_byte(27)
    b.push_str("[0m ")
  } else {
    b.push_str(text)
    b.push_str(" ")
  }
  b.to_s
}

fn cov_pad(s: String, w: Int): String {
  if s.size >= w {
    return s
  }
  b = buf_new()
  b.push_str(s)
  i = s.size
  while i < w {
    b.push_str(" ")
    i = i + 1
  }
  b.to_s
}

fn cov_border(file_w: Int) {
  b = buf_new()
  i = 0
  while i < file_w + 2 {
    b.push_str("-")
    i = i + 1
  }
  b.push_str("|---------|----------|---------|---------|-------------------")
  puts(b.to_s)
}
