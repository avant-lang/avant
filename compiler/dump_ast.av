import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import loader
import checker

// One line per token: kind, line, column, escaped value (the --tokens
// dump, D137).
pub fn dump_tokens(tokens: Array(Token)) {
  for t in tokens {
    loc = t.loc
    puts("${t.kind}\t${loc.line}\t${loc.column}\t${escape_dump(t.value)}")
  }
}

pub fn escape_dump(s: String): String {
  buf = buf_new(s.size)
  i = 0
  while i < s.size {
    c = s[i]
    if c == 92 {
      buf.push_str("\\\\")
    } else if c == 10 {
      buf.push_str("\\n")
    } else if c == 9 {
      buf.push_str("\\t")
    } else {
      buf.push_byte(c)
    }
    i += 1
  }
  buf.to_s
}

pub fn dump_type(t: TypeName): String {
  if sp = t.splice {
    return dump_expr(sp)
  }
  if t.fn_type {
    buf = buf_new()
    buf.push_str("fn(")
    for i in 0..t.args.size {
      if i > 0 {
        buf.push_str(",")
      }
      buf.push_str(dump_type(t.args[i]))
    }
    buf.push_str(")")
    if r = t.ret {
      buf.push_str(":")
      buf.push_str(dump_type(r))
    }
    if t.nilable {
      buf.push_str("?")
    }
    return buf.to_s
  }
  buf = buf_new()
  if t.members.size > 0 {
    i = 0
    while i < t.members.size {
      if i > 0 {
        buf.push_str("|")
      }
      buf.push_str(dump_type(t.members[i]))
      i += 1
    }
  } else {
    buf.push_str(t.name)
    if t.args.size > 0 {
      buf.push_str("(")
      for i in 0..t.args.size {
        if i > 0 {
          buf.push_str(",")
        }
        buf.push_str(dump_type(t.args[i]))
      }
      buf.push_str(")")
    }
  }
  if t.nilable {
    buf.push_str("?")
  }
  buf.to_s
}

pub fn dump_expr(e: Expr): String {
  buf = buf_new()
  k = e.kind
  if k == ex_int() {
    buf.push_str("(int ")
    buf.push_fmt_i(e.int_bits.to_i)
    if e.int_suffix.size > 0 {
      buf.push_str(e.int_suffix)
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_float() {
    buf.push_str("(float)")
    return buf.to_s
  }
  if k == ex_string() {
    buf.push_str("(string ")
    buf.push_str(escape_dump(e.value_str))
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_bool() {
    if e.bool_val {
      buf.push_str("(true)")
    } else {
      buf.push_str("(false)")
    }
    return buf.to_s
  }
  if k == ex_nil() {
    buf.push_str("(nil)")
    return buf.to_s
  }
  if k == ex_name() {
    buf.push_str("(name ")
    buf.push_str(e.ident)
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_call() {
    buf.push_str("(call ")
    if sp = e.splice {
      buf.push_str(dump_expr(sp))
    } else {
      buf.push_str(e.callee)
    }
    if recv = e.receiver {
      buf.push_str(" ")
      buf.push_str(dump_expr(recv))
    }
    for arg in e.args {
      buf.push_str(" ")
      buf.push_str(dump_expr(arg))
    }
    if b = e.block {
      buf.push_str(" (block")
      for param in b.params {
        buf.push_str(" |")
        buf.push_str(param)
      }
      for st in b.body {
        buf.push_str(" ")
        buf.push_str(dump_stmt(st))
      }
      buf.push_str(")")
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_unary() {
    buf.push_str("(unary ")
    buf.push_fmt_i(e.op)
    buf.push_str(" ")
    if inner = e.inner {
      buf.push_str(dump_expr(inner))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_binary() {
    buf.push_str("(binary ")
    buf.push_fmt_i(e.op)
    buf.push_str(" ")
    if l = e.left {
      buf.push_str(dump_expr(l))
    }
    buf.push_str(" ")
    if r = e.right {
      buf.push_str(dump_expr(r))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_field() {
    buf.push_str("(field ")
    if obj = e.object {
      buf.push_str(dump_expr(obj))
    }
    buf.push_str(" ")
    if sp = e.splice {
      buf.push_str(dump_expr(sp))
    } else {
      buf.push_str(e.ident)
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_index() {
    buf.push_str("(index ")
    if l = e.left {
      buf.push_str(dump_expr(l))
    }
    buf.push_str(" ")
    if r = e.right {
      buf.push_str(dump_expr(r))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_try() {
    buf.push_str("(try ")
    if inner = e.inner {
      buf.push_str(dump_expr(inner))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_array() {
    buf.push_str("(array")
    for elem in e.elems {
      buf.push_str(" ")
      buf.push_str(dump_expr(elem))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_switch() {
    buf.push_str("(switch ")
    if c = e.cond {
      buf.push_str(dump_expr(c))
    }
    for arm in e.cases {
      buf.push_str(" (case")
      for label in arm.labels {
        buf.push_str(" ")
        buf.push_fmt_i(label.to_i)
      }
      for st in arm.body {
        buf.push_str(" ")
        buf.push_str(dump_stmt(st))
      }
      buf.push_str(")")
    }
    if e.has_else {
      buf.push_str(" (else")
      for st in e.else_body {
        buf.push_str(" ")
        buf.push_str(dump_stmt(st))
      }
      buf.push_str(")")
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == ex_splice() {
    buf.push_str("(splice ")
    if inner = e.inner {
      buf.push_str(dump_expr(inner))
    }
    buf.push_str(")")
    return buf.to_s
  }
  buf.push_str("(expr)")
  buf.to_s
}

pub fn dump_stmt(s: Stmt): String {
  buf = buf_new()
  k = s.kind
  if k == st_expr() {
    buf.push_str("(expr ")
    if e = s.expr {
      buf.push_str(dump_expr(e))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == st_return() {
    buf.push_str("(return")
    if e = s.expr {
      buf.push_str(" ")
      buf.push_str(dump_expr(e))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == st_if() {
    buf.push_str("(if")
    for el in s.pre {
      buf.push_str(" ")
      buf.push_str(dump_stmt(el))
      buf.push_str(",")
    }
    if s.bind.size > 0 {
      buf.push_str("-assign ")
      buf.push_str(s.bind)
    }
    buf.push_str(" ")
    if c = s.cond {
      buf.push_str(dump_expr(c))
    }
    for stmt in s.then_body {
      buf.push_str(" ")
      buf.push_str(dump_stmt(stmt))
    }
    if s.else_body.size > 0 {
      buf.push_str(" (else")
      for st in s.else_body {
        buf.push_str(" ")
        buf.push_str(dump_stmt(st))
      }
      buf.push_str(")")
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == st_while() {
    buf.push_str("(while ")
    for st in s.pre {
      buf.push_str(" ")
      buf.push_str(dump_stmt(st))
    }
    if c = s.cond {
      buf.push_str(dump_expr(c))
    }
    for st in s.body {
      buf.push_str(" ")
      buf.push_str(dump_stmt(st))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == st_break() {
    return "(break)"
  }
  if k == st_continue() {
    return "(continue)"
  }
  if k == st_release() {
    buf.push_str("(release ")
    if e = s.expr {
      buf.push_str(dump_expr(e))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == st_hold() {
    buf.push_str("(gc.hold")
    for st in s.body {
      buf.push_str(" ")
      buf.push_str(dump_stmt(st))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == st_pin() {
    buf.push_str("(pin ")
    if e = s.expr {
      buf.push_str(dump_expr(e))
    }
    for st in s.body {
      buf.push_str(" ")
      buf.push_str(dump_stmt(st))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == st_assign() {
    buf.push_str("(assign ")
    buf.push_fmt_i(s.op)
    buf.push_str(" ")
    if t = s.target {
      buf.push_str(dump_expr(t))
    }
    buf.push_str(" ")
    if v = s.value {
      buf.push_str(dump_expr(v))
    }
    buf.push_str(")")
    return buf.to_s
  }
  if k == st_quote() {
    buf.push_str("(quote")
    for st in s.body {
      buf.push_str(" ")
      buf.push_str(dump_stmt(st))
    }
    buf.push_str(")")
    return buf.to_s
  }
  buf.push_str("(stmt ")
  buf.push_fmt_i(k)
  buf.push_str(")")
  buf.to_s
}

pub fn dump_fn(fnn: Function): String {
  buf = buf_new()
  buf.push_str("(fn ")
  if sp = fnn.name_splice {
    buf.push_str(dump_expr(sp))
  } else {
    buf.push_str(fnn.name)
  }
  if recv = fnn.receiver {
    buf.push_str(" (recv ")
    buf.push_str(recv.name)
    buf.push_str(" ")
    buf.push_str(dump_type(recv.type))
    buf.push_str(")")
  }
  for p in fnn.params {
    buf.push_str(" (param ")
    buf.push_str(p.name)
    buf.push_str(" ")
    buf.push_str(dump_type(p.type))
    buf.push_str(")")
  }
  if rt = fnn.return_type {
    buf.push_str(" ")
    buf.push_str(dump_type(rt))
  }
  for st in fnn.body {
    buf.push_str(" ")
    buf.push_str(dump_stmt(st))
  }
  buf.push_str(")")
  buf.to_s
}

pub fn dump_program(program: Program): String {
  buf = buf_new()
  buf.push_str("(program")
  for s in program.structs {
    buf.push_str(" (struct ")
    buf.push_str(s.name)
    buf.push_str(")")
  }
  for c in program.classes {
    buf.push_str(" (class ")
    buf.push_str(c.name)
    buf.push_str(")")
  }
  for function in program.functions {
    buf.push_str(" ")
    buf.push_str(dump_fn(function))
  }
  for q in program.quotes {
    buf.push_str(" (quote")
    for function in q.functions {
      buf.push_str(" ")
      buf.push_str(dump_fn(function))
    }
    buf.push_str(")")
  }
  for walk in program.comptimes {
    buf.push_str(" (comptime ")
    buf.push_str(walk.type_name)
    buf.push_str(" ")
    buf.push_str(walk.var_name)
    buf.push_str(" (quote")
    for function in walk.qdecl.functions {
      buf.push_str(" ")
      buf.push_str(dump_fn(function))
    }
    buf.push_str("))")
  }
  buf.push_str(")")
  buf.to_s
}
