import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import enums

pub fn hex_digit_val(c: Int): Int {
  if ch_is_digit(c) {
    return c - 48
  }
  if c >= 97 && c <= 102 {
    return c - 87
  }
  if c >= 65 && c <= 70 {
    return c - 55
  }
  -1
}

// The value of an integer literal's digits in radix 2, 8, 10 or 16 (the
// lexer checked them), or nil when it does not fit in 64 bits (the
// parser said so, where it used to trap).
pub fn parse_u64_digits(s: String, radix: Int): UInt64? {
  n = 0u64
  r = radix.to_u64()
  for i in 0..s.size {
    v = hex_digit_val(s[i])
    if v < 0 || v >= radix {
      return nil
    }
    d = v.to_u64()
    if n > (18446744073709551615 - d) / r {
      return nil
    }
    n = n * r + d
  }
  n
}

// A name in snake_case: a capital letter becomes `_` and its lower case
// (none at the start, none after `_`), so MaxDepth and MAX_DEPTH are
// max_depth.
pub fn snake_case_of(name: String): String {
  b = Buf.new()
  for i in 0..name.size {
    c = name[i]
    if c >= 65 && c <= 90 {
      if i > 0 && name[i - 1] != 95 && !(name[i - 1] >= 65 && name[i - 1] <= 90) {
        b.push_byte(95)
      }
      b.push_byte(c + 32)
    } else {
      b.push_byte(c)
    }
  }
  b.to_s()
}

pub class TypeBody {
  fields: Array(Field) = []
  methods: Array(Function) = []
  quotes: Array(QuoteDecl) = []
  comptimes: Array(ComptimeWalk) = []
}

pub class Parser {
  source: Source
  tokens: Array(Token)
  index: Int = 0
  allow_struct_lit: Bool = true
  // Where a struct literal is not allowed ("a condition", "a `for`"),
  // for the message that says to parenthesize one.
  lit_place: String = ""
  failed: Bool = false
  pub err: CompileError? = nil
  pub errors: DiagBag
  int_bits: UInt64 = 0
  int_suffix: String = ""
  in_quote: Bool = false
  for_id: Int = 0
  // The end of the inclusive range whose body for_advance walks ("" for
  // `..` and an array): its step stops after the last value.
  for_last: String = ""
  // The step of the range whose body for_advance walks (`by k`; 1
  // without one).
  for_by: UInt64 = 1
  // The `defer` statements parsed so far: a `for` whose body holds one
  // has a latch (parse_for).
  defers_seen: Int = 0
  // The nesting bound: depth counts the blocks, expressions and type
  // names open on the parser's stack; peak is the deepest level the
  // expression being parsed reaches, which a chain built in a loop
  // pushes one level down at each operator or postfix step
  // (`a + b + c` and `a.b().c` reach two levels below their own, as
  // the tree the checker walks does). The first place past nest_limit
  // is the one error the parse reports.
  depth: Int = 0
  peak: Int = 0
  too_deep: CompileError? = nil
  deep: Bool = false
  // The names of the last argument list's arguments, parallel to them
  // ("" for a positional one), or empty when none is named: the call
  // that list belongs to takes them (take_arg_names).
  arg_names: Array(String) = []
  // The bounds the last type parameter list wrote (`class Top(T: Ranked)`).
  tparam_bounds: Array(TypeBound) = []
  // The modules this file imports, as written, so a type's qualifier may
  // be a module's last name (whole_qualifier).
  import_names: Array(String) = []

  fn initialize(source: Source, tokens: Array(Token)) {
    self.source = source
    self.import_names = []
    self.tokens = tokens
    self.index = 0
    self.allow_struct_lit = true
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new()
    self.int_bits = 0
    self.int_suffix = ""
    self.in_quote = false
    self.for_id = 0
    self.depth = 0
    self.peak = 0
    self.too_deep = nil
    self.deep = false
  }

  // Valk's bound: a program nested deeper is a compile error, not a
  // stack overflow in the checker or the lowering, where the crash
  // cleanup cannot run. The deepest shape the compiler walks, a block in
  // a block, overflows its 8 MiB stack at about 1,900 levels.
  pub fn nest_limit: Int {
    1000
  }

  // Past the bound: the error, once, and the parse goes to the end of the
  // file, so every loop above it ends; parse keeps this error alone.
  pub fn nest_fail(loc: Location) {
    if !self.deep {
      self.deep = true
      message = "this program nests deeper than ${self.nest_limit()} levels (blocks, groups, calls and operator chains each count one): move the inner part into a function or a local value"
      e = CompileError.new(loc, diag_code(2, message), message)
      self.too_deep = e
      fail(loc, message)
    }
    self.index = self.tokens.size - 1
  }

  // One level more for a block, an expression or a type name; false past
  // the bound (the caller returns at once and does not call nest_leave).
  pub fn nest_enter(loc: Location): Bool {
    if self.deep || self.depth >= self.nest_limit() {
      nest_fail(loc)
      return false
    }
    self.depth += 1
    if self.depth > self.peak {
      self.peak = self.depth
    }
    true
  }

  pub fn nest_leave {
    self.depth -= 1
  }

  // A chain's step (a binary operator, a call, a field, an index, `?`)
  // puts what the chain built so far (which reached left_peak) one level
  // down, beside the step's own operands (which reached self.peak, each
  // one level below the step).
  pub fn nest_step(loc: Location, left_peak: Int): Bool {
    if left_peak + 1 > self.peak {
      self.peak = left_peak + 1
    }
    if self.peak > self.nest_limit() {
      nest_fail(loc)
      return false
    }
    true
  }

  pub fn has_err: Bool {
    self.failed
  }

  // A float literal's value; one too large for Float64 (it would read as
  // an infinity) is an error, as an integer literal out of range is.
  // String.to_f reads the lexer's checked text correctly rounded and is
  // nil past Float64's range; the formatter's lexer keeps the literal's
  // underscores, which to_f does not take.
  pub fn float_lit(tok: Token): Float64 {
    text = tok.value
    if text.contains("_") {
      text = text.replace("_", "")
    }
    if v = text.to_f() {
      return v
    }
    fail(tok.loc, "float literal ${tok.value} is out of range for Float64")
    0.0
  }

  pub fn fail(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(2, message), message)
    if self.errors.count() == 0 {
      self.err = e
    }
    self.failed = true
    self.errors.push(e)
  }

  pub fn err_count: Int {
    self.errors.pushes
  }

  pub fn new_err_since(mark: Int): Bool {
    self.errors.pushes > mark
  }

  pub fn is_top_starter(kind: Int): Bool {
    if kind == tk_fn() {
      return true
    }
    if kind == tk_enum() || kind == tk_const() {
      return true
    }
    if kind == tk_struct() {
      return true
    }
    if kind == tk_class() {
      return true
    }
    if kind == tk_lib() {
      return true
    }
    if kind == tk_interface() {
      return true
    }
    if kind == tk_import() {
      return true
    }
    if kind == tk_pub() {
      return true
    }
    if kind == tk_quote() {
      return true
    }
    if kind == tk_comptime() {
      return true
    }
    if kind == tk_ident() {
      return true
    }
    false
  }

  pub fn sync_top {
    while true {
      if self.current().kind == tk_eof() {
        break
      }
      if is_top_starter(self.current().kind) {
        break
      }
      self.bump()
    }
  }

  pub fn sync_stmt {
    while true {
      if self.current().kind == tk_eof() {
        break
      }
      if self.current().kind == tk_newline() {
        break
      }
      if self.current().kind == tk_r_brace() {
        break
      }
      self.bump()
    }
  }

  pub fn truncate_errors(mark: Int) {
    self.errors.truncate(mark)
    if self.errors.pushes == 0 {
      self.failed = false
      self.err = nil
    } else {
      self.failed = true
      self.err = self.errors.items[0]
    }
  }

  pub fn dummy_type(loc: Location): TypeName {
    TypeName.new(loc, "Int")
  }

  pub fn dummy_expr(loc: Location): Expr {
    Expr.new(ex_nil(), loc)
  }

  pub fn dummy_stmt(loc: Location): Stmt {
    stmt_expr(loc, dummy_expr(loc))
  }

  pub fn dummy_fn(loc: Location): Function {
    Function.new(loc, "")
  }

  pub fn current: Token {
    self.tokens[self.index]
  }

  pub fn bump: Token {
    tok = self.current()
    if tok.kind != tk_eof() {
      self.index += 1
    }
    tok
  }

  pub fn match_tok(kind: Int): Bool {
    if self.current().kind != kind {
      return false
    }
    self.bump()
    true
  }

  pub fn expect(kind: Int): Token {
    tok = self.current()
    if tok.kind != kind {
      if (tok.kind == tk_minus() || tok.kind == tk_plus() || tok.kind == tk_l_bracket()) && self.at_line_start() {
        fail(tok.loc, "expected ${token_name(kind)}, found ${token_name(tok.kind)}: a line starting with `+`, `-` or `[` never continues the line before; to continue it, end that line with the operator or an open bracket (`total = a +` then `b`)")
        return tok
      }
      fail(tok.loc, "expected ${token_name(kind)}, found ${token_name(tok.kind)}")
      return tok
    }
    self.bump()
  }

  // A keyword after a dot is a name. A keyword that starts a phrase stays the keyword.
  pub fn take_name_after_dot: Token {
    tok = self.current()
    if tok.kind == tk_ident() {
      return self.bump()
    }
    spell = keyword_spelling(tok.kind)
    if spell.size > 0 {
      self.bump()
      return Token.new(tk_ident(), tok.loc, spell)
    }
    fail(tok.loc, "expected a name, found ${token_name(tok.kind)}")
    tok
  }

  pub fn skip_newlines {
    while self.current().kind == tk_newline() {
      self.bump()
    }
  }

  pub fn look_ahead_non_nl: Token {
    for i in self.index..self.tokens.size {
      t = self.tokens[i]
      if t.kind != tk_newline() {
        return t
      }
    }
    self.tokens[self.tokens.size - 1]
  }

  // How tightly an infix operator binds, loosest first: `??`, `||`, `&&`,
  // `==` `!=`, `<` `<=` `>` `>=`, `|`, `^`, `&`, the shifts, `+` `-` and
  // the wrapping forms, `*` `/` `%` `&*`. The bitwise operators bind
  // tighter than the comparisons, so `x & 1 == 0` reads `(x & 1) == 0`.
  pub fn infix_prec(kind: Int): Int {
    switch kind {
      case 74 {
        0
      }
      case 52 {
        1
      }
      case 54 {
        2
      }
      case 43, 44 {
        3
      }
      case 45, 46, 47, 48 {
        4
      }
      case 51 {
        5
      }
      case 55 {
        6
      }
      case 53 {
        7
      }
      case 57, 58 {
        8
      }
      case 37, 38, 70, 71 {
        9
      }
      case 39, 40, 41, 72 {
        10
      }
      else {
        -1
      }
    }
  }

  // A line whose first token is `[`, `-` or `+` begins a new
  // statement; it never continues the previous line. Any other infix
  // operator, `.` or `?` that starts a line cannot start a statement,
  // so it still continues the line before.
  pub fn skip_newlines_if_continuing {
    if self.current().kind != tk_newline() {
      return
    }
    kind = self.look_ahead_non_nl().kind
    if kind == tk_minus() || kind == tk_plus() {
      return
    }
    if infix_prec(kind) >= 0 {
      self.skip_newlines()
    }
  }

  pub fn skip_newlines_if_postfix {
    if self.current().kind != tk_newline() {
      return
    }
    kind = self.look_ahead_non_nl().kind
    if kind == tk_dot() || kind == tk_question() {
      self.skip_newlines()
    }
  }

  // The current token is the first of its line.
  pub fn at_line_start: Bool {
    if self.index == 0 {
      return true
    }
    self.tokens[self.index - 1].kind == tk_newline()
  }

  // One statement of a block, remembering a line-leading `-` or `[` for
  // lead_check.
  pub fn parse_lead_stmt: Stmt {
    lead = 0
    k = self.current().kind
    if (k == tk_minus() || k == tk_l_bracket()) && self.at_line_start() {
      lead = k
    }
    s = self.parse_stmt()
    s.lead = lead
    s
  }

  // An expression statement whose value nobody can use: no call, no
  // assignment; a field may be a method call in field form, so it is not
  // inert.
  pub fn inert_expr(e: Expr): Bool {
    k = e.kind
    if k == ex_int() || k == ex_float() || k == ex_string() || k == ex_bool() || k == ex_nil() || k == ex_name() {
      return true
    }
    if k == ex_unary() {
      if inner = e.inner {
        return inert_expr(inner)
      }
      return true
    }
    if k == ex_binary() {
      if l = e.left, r = e.right {
        return inert_expr(l) && inert_expr(r)
      }
      return false
    }
    if k == ex_array() || k == ex_hash_lit() {
      return true
    }
    false
  }

  pub fn lead_text(lead: Int): String {
    if lead == tk_minus() {
      return "-"
    }
    "["
  }

  // Dangling expressions (a line that starts with `-` or `[` begins a
  // new statement): a statement that starts a line with `-` or `[` and
  // whose value nobody uses (it is not the block's last statement), or
  // that follows a value statement nobody uses (the old reading joined
  // the two lines into one expression).
  pub fn lead_check(stmts: Array(Stmt)) {
    i = 0
    while i < stmts.size {
      s = stmts[i]
      if s.lead != 0 {
        t = lead_text(s.lead)
        hint = "to continue the line before, end it with the operator or an open bracket (`total = a -` then `b`)"
        if i > 0 {
          p = stmts[i - 1]
          if p.kind == st_expr() {
            if pe = p.expr, inert_expr(pe) {
              fail(s.loc, "this line starts with `${t}`, so it begins a new statement and leaves the line before as a value nobody uses; ${hint}")
            }
          }
        }
        if i < stmts.size - 1 && s.kind == st_expr() {
          if se = s.expr, se.kind == ex_unary() || se.kind == ex_array() || se.kind == ex_hash_lit() {
            fail(s.loc, "this line starts with `${t}`, so it begins a new statement whose value nobody uses; ${hint}")
          }
        }
      }
      i += 1
    }
    if stmts.size > 0 && stmts[stmts.size - 1].kind == st_defer() {
      // Nothing follows it in its block: it would run at once.
      fail(stmts[stmts.size - 1].loc, "a defer as its block's last statement runs at once, when the block ends; write its statements without defer, or move the defer before the statements it should follow")
    }
  }

  pub fn parse_int_tok(tok: Token): Bool {
    raw = tok.value
    suffix = ""
    if raw.ends_with("u64") {
      if raw.size > 3 {
        suffix = "u64"
        raw = raw[..raw.size - 3]
      }
    } else if raw.ends_with("i64") {
      if raw.size > 3 {
        // One integer spelling: the lexer still reads the suffix so the
        // error can say what to write.
        raw = raw[..raw.size - 3]
        fail(tok.loc, removed_int_message("the i64 suffix", raw))
      }
    }
    radix = 10
    digits = raw
    if raw.size >= 2 && raw[0] == 48 {
      p = raw[1]
      if p == 120 || p == 88 {
        radix = 16
      } else if p == 98 {
        radix = 2
      } else if p == 111 {
        radix = 8
      }
      if radix != 10 {
        digits = raw[2..]
      }
    }
    bits = 0u64
    if got = parse_u64_digits(digits, radix) {
      bits = got
    } else {
      fail(tok.loc, "integer literal does not fit in UInt64, the widest integer type")
      return false
    }
    self.int_bits = bits
    self.int_suffix = suffix
    true
  }

  pub fn parse: Program {
    self.skip_newlines()
    loc = self.current().loc
    program = Program.new(loc)
    while self.current().kind != tk_eof() {
      mark = self.err_count()
      start_idx = self.index
      vis = false
      if self.current().kind == tk_pub() {
        vis = true
        self.bump()
        self.skip_newlines()
      }
      k = self.current().kind
      if k == tk_import() {
        if vis {
          fail(self.current().loc, "import cannot be pub")
        } else {
          program.imports.push(self.parse_import())
        }
      } else if k == tk_struct() {
        program.structs.push(parse_struct(vis))
      } else if k == tk_enum() {
        program.structs.push(parse_enum(vis))
      } else if k == tk_const() {
        if c = parse_const(vis) {
          program.consts.push(c)
        }
      } else if k == tk_class() {
        program.classes.push(parse_class(vis))
      } else if k == tk_lib() {
        ldef = parse_lib(vis)
        program.libs.push(ldef)
        program.structs.concat(ldef.enums)
      } else if k == tk_fn() {
        program.functions.push(parse_fn("", vis))
      } else if k == tk_interface() {
        program.interfaces.push(parse_interface(vis))
      } else if k == tk_ident() && self.current().value == "type" && self.index + 1 < self.tokens.size && self.tokens[self.index + 1].kind == tk_ident() {
        // `type` is a keyword only where it starts a declaration.
        if al = parse_alias(vis) {
          program.aliases.push(al)
        }
      } else if k == tk_ident() && self.err_count() == 0 && module_state_ahead() {
        // No module-level mutable state, on purpose: a value that never
        // changes is a constant. (After an earlier error, a statement
        // here is more likely a function's that a missing brace left
        // outside: the general message stays.)
        name = self.current().value
        fail(self.current().loc, "a module has no variables, on purpose: a value that never changes is `const ${name} = ...`, and state lives in a function's locals or is passed in values")
        while self.current().kind != tk_newline() && self.current().kind != tk_eof() {
          self.bump()
        }
      } else if k == tk_ident() {
        parse_opt_in(program, vis)
      } else if k == tk_quote() {
        if vis {
          fail(self.current().loc, "quote cannot be pub; mark the fns inside")
        } else {
          program.quotes.push(parse_quote_decl(""))
        }
      } else if k == tk_comptime() {
        if vis {
          fail(self.current().loc, "comptime cannot be pub")
        } else {
          program.comptimes.push(parse_comptime_walk(""))
        }
      } else if k == tk_fun() {
        fail(self.current().loc, "fun belongs in a lib block; there is no extern fn")
      } else {
        if vis {
          fail(self.current().loc, "pub prefixes struct, class, enum, const, lib, fn, or interface")
        } else {
          fail(self.current().loc, "expected struct, class, enum, const, lib, fn, interface, import, quote, or comptime, found ${token_name(k)}")
        }
      }
      if new_err_since(mark) {
        self.sync_top()
        if self.index == start_idx && self.current().kind != tk_eof() {
          self.bump()
        }
      }
      self.skip_newlines()
    }
    if e = self.too_deep {
      self.errors = DiagBag.new()
      self.errors.push(e)
      self.err = e
      self.failed = true
    }
    program
  }

  // `type Name = T`.
  pub fn parse_alias(vis: Bool): AliasDef? {
    self.bump()
    tok = expect(tk_ident())
    if self.current().kind == tk_l_paren() {
      fail(self.current().loc, "a type alias takes no type parameters: type ${tok.value} = T names one type")
      return nil
    }
    if self.current().kind != tk_eq() {
      fail(self.current().loc, "expected `=` and the type after type ${tok.value}")
      return nil
    }
    self.bump()
    self.skip_newlines()
    target = parse_type_name()
    al = AliasDef.new(tok.loc, tok.value, target)
    al.vis = vis
    al
  }

  pub fn parse_import: ImportDecl {
    loc = expect(tk_import()).loc
    self.skip_newlines()
    name = expect(tk_ident())
    buf = Buf.new()
    buf.push_str(name.value)
    while self.current().kind == tk_dot() {
      self.bump()
      self.skip_newlines()
      next = self.take_name_after_dot()
      buf.push_str(".")
      buf.push_str(next.value)
    }
    self.import_names.push(buf.to_s())
    ImportDecl.new(loc, buf.to_s())
  }

  // A type's qualifier as the whole module name: `time` in `time.Time`
  // when this file imports std.time and no module named time in whole
  // (the checker's last_name_module reads expressions the same way); two
  // imports ending in the name make it an error naming both.
  pub fn whole_qualifier(qual: String, loc: Location): String {
    if qual.size == 0 {
      return qual
    }
    found = ""
    other = ""
    for imp in self.import_names {
      if imp == qual {
        return qual
      }
      i = imp.size - 1
      while i >= 0 && imp[i] != 46 {
        i -= 1
      }
      if i >= 0 && imp[i + 1..] == qual {
        if found.size == 0 {
          found = imp
        } else if other.size == 0 && imp != found {
          other = imp
        }
      }
    }
    if found == "std.gc" {
      return qual
    }
    if other.size > 0 {
      fail(loc, "${qual} is the last name of both ${found} and ${other}: write the whole name (${found}.… or ${other}.…)")
      return qual
    }
    if found.size > 0 {
      return found
    }
    qual
  }

  pub fn parse_quote_decl(owner: String): QuoteDecl {
    if self.in_quote {
      fail(self.current().loc, "quote cannot nest")
    }
    loc = expect(tk_quote()).loc
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    self.in_quote = true
    q = QuoteDecl.new(loc)
    q.owner = owner
    mark0 = self.err_count()
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      if new_err_since(mark0) {
        break
      }
      vis = false
      if self.current().kind == tk_pub() {
        vis = true
        self.bump()
        self.skip_newlines()
      }
      if self.current().kind == tk_fn() {
        q.functions.push(parse_fn(owner, vis))
      } else {
        fail(self.current().loc, "quote holds fn")
        break
      }
      self.skip_newlines()
    }
    expect(tk_r_brace())
    self.in_quote = false
    q
  }

  pub fn parse_quote_stmt: Stmt {
    if self.in_quote {
      fail(self.current().loc, "quote cannot nest")
    }
    loc = expect(tk_quote()).loc
    self.skip_newlines()
    self.in_quote = true
    body = self.parse_block()
    self.in_quote = false
    stmt_quote(loc, body)
  }

  pub fn parse_comptime_walk(owner: String): ComptimeWalk {
    loc = expect(tk_comptime()).loc
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    for_tok = self.current()
    if for_tok.kind != tk_for() {
      fail(for_tok.loc, "a comptime block is a field walk: comptime { for f in Type.fields { quote { ... } } }")
    }
    self.bump()
    self.skip_newlines()
    var_tok = expect(tk_ident())
    self.skip_newlines()
    in_tok = self.current()
    if in_tok.kind != tk_in() {
      fail(in_tok.loc, "a comptime block is a field walk: comptime { for f in Type.fields { quote { ... } } }")
    }
    self.bump()
    self.skip_newlines()
    type_tok = expect(tk_ident())
    self.skip_newlines()
    expect(tk_dot())
    self.skip_newlines()
    fields_tok = self.take_name_after_dot()
    if fields_tok.value == "fields" {
    } else {
      fail(fields_tok.loc, "a comptime block is a field walk: comptime { for f in Type.fields { quote { ... } } }")
    }
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    if self.current().kind != tk_quote() {
      fail(self.current().loc, "a comptime block is a field walk: comptime { for f in Type.fields { quote { ... } } }")
    }
    qdecl = parse_quote_decl(owner)
    self.skip_newlines()
    expect(tk_r_brace())
    self.skip_newlines()
    expect(tk_r_brace())
    walk = ComptimeWalk.new(loc, var_tok.value, type_tok.value, qdecl)
    walk.owner = owner
    walk
  }

  pub fn parse_splice: Expr {
    loc = expect(tk_pound()).loc
    if !self.in_quote {
      fail(loc, "splice #() only belongs in quote")
    }
    if self.current().kind != tk_l_paren() {
      fail(self.current().loc, "expected ( after #")
    }
    self.bump()
    self.skip_newlines()
    inner = self.parse_splice_payload()
    self.skip_newlines()
    expect(tk_r_paren())
    e = Expr.new(ex_splice(), loc)
    e.inner = inner
    e
  }

  pub fn parse_splice_payload: Expr {
    tok = self.current()
    k = tok.kind
    left = dummy_expr(tok.loc)
    if k == tk_ident() {
      self.bump()
      e = Expr.new(ex_name(), tok.loc)
      e.ident = tok.value
      left = e
    } else if k == tk_self() {
      self.bump()
      e = Expr.new(ex_name(), tok.loc)
      e.ident = "self"
      left = e
    } else if k == tk_string() {
      self.bump()
      e = Expr.new(ex_string(), tok.loc)
      e.value_str = tok.value
      left = e
    } else if k == tk_integer() {
      self.bump()
      ok = parse_int_tok(tok)
      e = Expr.new(ex_int(), tok.loc)
      e.int_bits = self.int_bits
      e.int_suffix = self.int_suffix
      left = e
    } else if k == tk_float() {
      self.bump()
      e = Expr.new(ex_float(), tok.loc)
      e.float_val = float_lit(tok)
      e.value_str = tok.value
      left = e
    } else if k == tk_true() {
      self.bump()
      e = Expr.new(ex_bool(), tok.loc)
      e.bool_val = true
      left = e
    } else if k == tk_false() {
      self.bump()
      e = Expr.new(ex_bool(), tok.loc)
      e.bool_val = false
      left = e
    } else if k == tk_nil() {
      self.bump()
      left = Expr.new(ex_nil(), tok.loc)
    } else {
      fail(tok.loc, "splice is a literal, a name, or f.name / f.type")
    }
    if self.current().kind == tk_dot() {
      at = self.bump().loc
      self.skip_newlines()
      field = self.take_name_after_dot()
      fa = Expr.new(ex_field(), at)
      fa.object = left
      fa.ident = field.value
      return fa
    }
    left
  }

  pub fn parse_type_params(loc: Location): Array(String) {
    names: Array(String) = []
    self.tparam_bounds = []
    if self.current().kind != tk_l_paren() {
      return names
    }
    self.bump()
    self.skip_newlines()
    if self.current().kind == tk_r_paren() {
      fail(loc, "type parameter list is empty")
      self.bump()
      return names
    }
    self.tparam_bounds = []
    while true {
      tok = expect(tk_ident())
      i = 0
      while i < names.size {
        if names[i] == tok.value {
          fail(tok.loc, "duplicate type parameter ${tok.value}")
        }
        i += 1
      }
      names.push(tok.value)
      self.skip_newlines()
      if self.current().kind == tk_colon() {
        // A bound, the form a function's parameter takes: `class Top(T:
        // Ranked)`, `struct Pair(K: Eq(K) + Show, V)`.
        self.bump()
        self.skip_newlines()
        for app in self.parse_iface_apps() {
          self.tparam_bounds.push(TypeBound.new(tok.value, app))
        }
        self.skip_newlines()
      }
      if match_tok(tk_comma()) {
        self.skip_newlines()
      } else {
        break
      }
    }
    expect(tk_r_paren())
    names
  }

  pub fn parse_struct(vis: Bool): StructDef {
    loc = expect(tk_struct()).loc
    name = expect(tk_ident()).value
    params = parse_type_params(loc)
    pbounds = self.tparam_bounds
    opted = parse_opt_clause()
    body = parse_type_body(name)
    for m in body.methods {
      refuse_field_params(m.params)
    }
    defn = StructDef.new(loc, name)
    defn.type_params = params
    defn.param_bounds = pbounds
    defn.fields = body.fields
    defn.methods = body.methods
    defn.quotes = body.quotes
    defn.comptimes = body.comptimes
    defn.opt_ins = opted
    defn.vis = vis
    if error_opted(opted) {
      defn.methods.push(error_text_method(loc, name, defn.fields))
    }
    defn
  }

  // `enum Name [: Error] { member [= value], ... fn ... }`: members
  // separated by commas or line breaks (a trailing comma allowed),
  // lower-case snake_case, each with a value by C's rule (written, else
  // the previous one plus one, the first 0), distinct and within Int32;
  // then the enum's methods. The parser adds the functions every enum has
  // (enums.av).
  pub fn parse_enum(vis: Bool): StructDef {
    loc = expect(tk_enum()).loc
    name_tok = expect(tk_ident())
    name = name_tok.value
    if name.size > 0 && !(name[0] >= 65 && name[0] <= 90) {
      fail(name_tok.loc, "an enum's name is a type name, written with a capital first letter: write ${type_camel(name)}")
    }
    if self.current().kind == tk_l_paren() {
      fail(self.current().loc, "an enum takes no type parameters")
    }
    opted = parse_opt_clause()
    for tn in opted {
      if !(tn.name == "Error" && tn.mod_name.size == 0 && tn.args.size == 0) {
        fail(tn.loc, "an enum can be marked Error; it implements no other interface")
      }
    }
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    decl = EnumDecl.new()
    methods: Array(Function) = []
    next = 0
    builtin = enum_builtin_names()
    mark0 = self.err_count()
    while true {
      k = self.current().kind
      if k == tk_r_brace() || k == tk_eof() {
        break
      }
      if new_err_since(mark0) {
        break
      }
      if k == tk_fn() || k == tk_pub() {
        mvis = false
        if k == tk_pub() {
          mvis = true
          self.bump()
          self.skip_newlines()
          if self.current().kind != tk_fn() {
            fail(self.current().loc, "pub in an enum body prefixes fn")
            break
          }
        }
        fnn = parse_fn(name, mvis)
        refuse_field_params(fnn.params)
        for b in builtin {
          if fnn.name == b {
            fail(fnn.loc, "every enum has ${b}; a method cannot take its name")
          }
        }
        methods.push(fnn)
        self.skip_newlines()
        continue
      }
      if k != tk_ident() {
        fail(self.current().loc, "expected an enum member or fn, found ${token_name(k)}")
        break
      }
      tok = self.bump()
      mname = tok.value
      if methods.size > 0 {
        fail(tok.loc, "an enum's members come before its methods")
        break
      }
      if mname[0] >= 65 && mname[0] <= 90 {
        fail(tok.loc, "an enum member is written in lower case: `${enum_snake(mname)}`")
      }
      for b in builtin {
        if mname == b && b != "name" && b != "to_i" {
          fail(tok.loc, "a member ${mname} would hide ${name}.${mname}; choose another name")
        }
      }
      for prev in decl.names {
        if prev == mname {
          fail(tok.loc, "duplicate member ${mname} in enum ${name}")
        }
      }
      value = next
      fits = true
      vkind = 0
      vname = ""
      vqual = ""
      if match_tok(tk_eq()) {
        self.skip_newlines()
        neg = false
        if self.current().kind == tk_minus() {
          neg = true
          self.bump()
        }
        if self.current().kind == tk_ident() && !neg {
          // A module constant: the checker computes this value and the
          // ones after it (check_enum_consts).
          vkind = 2
          vname = self.bump().value
          if self.current().kind == tk_dot() {
            self.bump()
            vqual = vname
            vname = self.take_name_after_dot().value
          }
          if decl.first_named < 0 {
            decl.first_named = decl.names.size
          }
          value = 0
        } else if self.current().kind != tk_integer() {
          fail(self.current().loc, "an enum member's value is an integer literal or a constant")
          break
        } else {
          vkind = 1
          vt = self.bump()
          if parse_int_tok(vt) {
            if self.int_suffix.size != 0 {
              fail(vt.loc, "an enum member's value is an integer literal without a suffix")
            }
            bits = self.int_bits
            if (neg && bits > 2147483648) || (!neg && bits > 2147483647) {
              fits = false
            } else if neg {
              value = 0 - bits.to_i()
            } else {
              value = bits.to_i()
            }
          }
        }
      } else if next > 2147483647 && decl.first_named < 0 {
        fits = false
      }
      if !fits {
        fail(tok.loc, "the value of ${mname} does not fit in Int32")
        value = 0
      }
      if decl.first_named < 0 {
        for j in 0..decl.vals.size {
          if fits && decl.vals[j] == value {
            fail(tok.loc, "members ${decl.names[j]} and ${mname} of ${name} have the same value ${value}")
          }
        }
      }
      decl.names.push(mname)
      decl.vals.push(value)
      decl.locs.push(tok.loc)
      decl.val_names.push(vname)
      decl.val_quals.push(vqual)
      decl.val_kinds.push(vkind)
      next = value + 1
      if self.current().kind == tk_comma() {
        self.bump()
        self.skip_newlines()
      } else if self.current().kind == tk_newline() {
        self.skip_newlines()
      } else if self.current().kind != tk_r_brace() {
        fail(self.current().loc, "expected `,` or a line break after the enum member ${mname}, found ${token_name(self.current().kind)}")
        break
      }
    }
    expect(tk_r_brace())
    if decl.names.size == 0 && !new_err_since(mark0) {
      fail(loc, "an enum needs a member")
    }
    defn = StructDef.new(loc, name)
    defn.enum_of = decl
    defn.methods = methods
    defn.opt_ins = opted
    defn.vis = vis
    defn.methods.push(enum_name_method(loc, name, decl))
    defn.methods.push(enum_from_i_method(loc, name, decl))
    defn.methods.push(enum_from_name_method(loc, name, decl))
    defn.methods.push(enum_members_method(loc, name, decl))
    if error_opted(opted) {
      has_message = false
      for m in methods {
        if m.name == "message" && !m.type_method {
          has_message = true
        }
      }
      if !has_message {
        defn.methods.push(enum_message_method(loc, name))
      }
      text = error_text_method(loc, name, defn.fields)
      text.lazy = true
      defn.methods.push(text)
    }
    defn
  }

  pub fn parse_class(vis: Bool): ClassDef {
    loc = expect(tk_class()).loc
    name = expect(tk_ident()).value
    params = parse_type_params(loc)
    pbounds = self.tparam_bounds
    opted = parse_opt_clause()
    body = parse_type_body(name)
    field_params(name, body)
    defn = ClassDef.new(loc, name)
    defn.type_params = params
    defn.param_bounds = pbounds
    defn.fields = body.fields
    defn.methods = body.methods
    defn.quotes = body.quotes
    defn.comptimes = body.comptimes
    defn.opt_ins = opted
    defn.vis = vis
    if error_opted(opted) {
      defn.methods.push(error_text_method(loc, name, defn.fields))
    }
    defn
  }

  // Field parameters (`fn initialize(self.loc, self.name)`): each takes
  // its field's type and is assigned to the field before the body, in
  // parameter order: the short form of `loc: Location` with
  // `self.loc = loc` first in the body, and the same code. Only a class's
  // initialize has them (parse_fn refuses them elsewhere).
  pub fn field_params(owner: String, body: TypeBody) {
    for m in body.methods {
      if m.name != "initialize" {
        continue
      }
      sets: Array(Stmt) = []
      for p in m.params {
        if !p.field_param {
          continue
        }
        found: Field? = nil
        for f in body.fields {
          if f.name == p.name {
            found = f
          }
        }
        if f2 = found {
          p.type = clone_type_name(f2.type)
          target = error_self_field(p.loc, p.name)
          value = Expr.new(ex_name(), p.loc)
          value.ident = p.name
          st = Stmt.new(st_assign(), p.loc)
          st.target = target
          st.value = value
          st.op = tk_eq()
          sets.push(st)
        } else {
          fail(p.loc, "${owner} has no field ${p.name}: a field parameter (self.${p.name}) names a field of the class")
        }
      }
      if sets.size > 0 {
        sets.concat(m.body)
        m.body = sets
      }
    }
  }

  pub fn parse_opt_clause: Array(TypeName) {
    empty: Array(TypeName) = []
    self.skip_newlines()
    if self.current().kind == tk_colon() {
      self.bump()
      self.skip_newlines()
      return parse_iface_apps()
    }
    empty
  }

  pub fn parse_iface_apps: Array(TypeName) {
    apps: Array(TypeName) = []
    while true {
      apps.push(self.parse_primary_type())
      self.skip_newlines()
      if match_tok(tk_plus()) {
        self.skip_newlines()
      } else {
        break
      }
    }
    apps
  }

  pub fn parse_bounded_type: TypeName {
    tn = self.parse_type_name()
    self.skip_newlines()
    if self.current().kind == tk_colon() {
      self.bump()
      self.skip_newlines()
      tn.bounds = self.parse_iface_apps()
    }
    tn
  }

  pub fn parse_interface(vis: Bool): InterfaceDef {
    loc = expect(tk_interface()).loc
    name = expect(tk_ident()).value
    params = parse_type_params(loc)
    if self.tparam_bounds.size > 0 {
      fail(loc, "an interface's type parameters take no bounds: bound the type parameters of the functions and types that use it")
    }
    idef = InterfaceDef.new(loc, name)
    idef.type_params = params
    idef.vis = vis
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    mark0 = self.err_count()
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      if new_err_since(mark0) {
        break
      }
      if self.current().kind == tk_fn() {
        idef.methods.push(self.parse_iface_method())
      } else {
        fail(self.current().loc, "interface methods are signatures")
        break
      }
      self.skip_newlines()
    }
    expect(tk_r_brace())
    idef
  }

  pub fn parse_iface_method: Function {
    loc = expect(tk_fn()).loc
    name = self.parse_fn_name()
    fnn = Function.new(loc, name)
    if self.current().kind == tk_l_paren() {
      self.bump()
      self.skip_newlines()
      if self.current().kind == tk_r_paren() {
        refuse_empty_params("fn", name)
      } else {
        while true {
          fnn.params.push(self.parse_param())
          self.skip_newlines()
          if match_tok(tk_comma()) {
            self.skip_newlines()
          } else {
            break
          }
        }
      }
      expect(tk_r_paren())
    }
    if match_tok(tk_colon()) {
      self.skip_newlines()
      fnn.return_type = self.parse_bounded_type()
    }
    self.skip_newlines()
    refuse_field_params(fnn.params)
    if self.current().kind == tk_l_brace() {
      fail(self.current().loc, "interface methods have no body")
      fnn.body = self.parse_block()
    }
    fnn
  }

  // `const name = value`: a snake_case name, no declared type (each use
  // is the value written as a literal, which takes its type from where
  // it stands), the value an expression the checker computes
  // (checker/consts.av).
  pub fn parse_const(vis: Bool): ConstDef? {
    expect(tk_const())
    tok = self.current()
    if tok.kind != tk_ident() {
      fail(tok.loc, "expected a name after const, found ${token_name(tok.kind)}")
      return nil
    }
    self.bump()
    name = tok.value
    snake = snake_case_of(name)
    if snake != name {
      fail(tok.loc, "a constant's name is snake_case, as a function's: const ${snake}")
      return nil
    }
    if self.current().kind == tk_colon() {
      fail(self.current().loc, "a constant has no declared type: each use is its value written as a literal, which takes its type from where it stands (const ${name} = ...)")
      return nil
    }
    if self.current().kind != tk_eq() {
      fail(self.current().loc, "expected `=` and the value after const ${name}")
      return nil
    }
    self.bump()
    // A block after a call is refused here as in a statement.
    value = maybe_trailing_block(parse_expr())
    c = ConstDef.new(tok.loc, name, value)
    c.vis = vis
    c
  }

  // `name = ...`, `name += ...` or `name: Type = ...` at module level: a
  // lower-case name (an opt-in names a type, `Point: Show`) followed by
  // an assignment, or by `:` and an `=` before the line ends.
  pub fn module_state_ahead: Bool {
    name = self.current().value
    if name.size == 0 || (name[0] >= 65 && name[0] <= 90) {
      return false
    }
    i = self.index + 1
    if i >= self.tokens.size {
      return false
    }
    k = self.tokens[i].kind
    if token_is_assign_op(k) {
      return true
    }
    if k != tk_colon() {
      return false
    }
    while i < self.tokens.size {
      k2 = self.tokens[i].kind
      if k2 == tk_newline() || k2 == tk_eof() || k2 == tk_l_brace() {
        return false
      }
      if k2 == tk_eq() {
        return true
      }
      i += 1
    }
    false
  }

  pub fn parse_opt_in(program: Program, vis: Bool) {
    target = self.parse_primary_type()
    self.skip_newlines()
    if self.current().kind != tk_colon() {
      if vis {
        fail(target.loc, "pub prefixes struct, class, enum, const, lib, fn, or interface")
      } else {
        fail(target.loc, "expected struct, class, enum, const, lib, fn, interface, import, quote, or comptime")
      }
      return
    }
    self.bump()
    self.skip_newlines()
    opt = OptIn.new(target.loc, target)
    opt.ifaces = self.parse_iface_apps()
    opt.vis = vis
    program.opt_ins.push(opt)
  }

  pub fn parse_lib(vis: Bool): LibDef {
    loc = expect(tk_lib()).loc
    name = expect(tk_ident()).value
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    defn = LibDef.new(loc, name)
    defn.vis = vis
    mark0 = self.err_count()
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      if self.current().kind == tk_struct() {
        defn.layouts.push(parse_clayout(vis))
        if new_err_since(mark0) {
          break
        }
        self.skip_newlines()
      } else if self.current().kind == tk_enum() {
        // A C enum: C's int wherever it is stored.
        en = parse_enum(vis)
        if decl = en.enum_of {
          decl.c_int = true
        }
        defn.enums.push(en)
        if new_err_since(mark0) {
          break
        }
        self.skip_newlines()
      } else if self.current().kind == tk_fn() {
        // `fn` inside a `lib` block suggests `fun`, with the name when
        // one follows.
        shown = "fun"
        if self.index + 1 < self.tokens.size {
          after = self.tokens[self.index + 1]
          if after.kind == tk_ident() {
            shown = "fun ${after.value}"
          }
        }
        fail(self.current().loc, "inside lib, write ${shown}, not fn: a lib block declares C functions, without a body; an Avant function goes outside the block")
        break
      } else if self.current().kind != tk_fun() {
        fail(self.current().loc, "inside lib, write fun, struct or enum")
        break
      } else {
        defn.funs.push(self.parse_fun_decl())
        if new_err_since(mark0) {
          break
        }
        self.skip_newlines()
      }
    }
    expect(tk_r_brace())
    defn.vis = vis
    defn
  }

  pub fn parse_clayout(vis: Bool): CLayout {
    loc = expect(tk_struct()).loc
    name = expect(tk_ident()).value
    if self.current().kind == tk_l_paren() {
      fail(self.current().loc, "lib structs take no type parameters")
    }
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    layout = CLayout.new(loc, name)
    layout.vis = vis
    mark0 = self.err_count()
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      if self.current().kind == tk_fn() {
        fail(self.current().loc, "C layout fields are name: Type only")
        break
      }
      if self.current().kind == tk_fun() {
        fail(self.current().loc, "C layout fields are name: Type only")
        break
      }
      if self.current().kind == tk_quote() {
        fail(self.current().loc, "C layout fields are name: Type only")
        break
      }
      if self.current().kind == tk_comptime() {
        fail(self.current().loc, "C layout fields are name: Type only")
        break
      }
      if self.current().kind == tk_pub() {
        fail(self.current().loc, "C layout fields are name: Type only")
        break
      }
      field = self.parse_field()
      if d = field.default {
        fail(field.loc, "C layout fields have no defaults")
        break
      }
      if self.current().kind == tk_l_bracket() {
        // `vtype: UInt8[4]`, C's `uint8_t vtype[4]`.
        self.bump()
        field.count = self.parse_prefix()
        expect(tk_r_bracket())
      }
      layout.fields.push(field)
      if new_err_since(mark0) {
        break
      }
      self.skip_newlines()
    }
    if layout.fields.size == 0 && !new_err_since(mark0) {
      fail(loc, "C layout needs a field")
    }
    expect(tk_r_brace())
    layout
  }

  pub fn parse_fun_decl: FunDecl {
    loc = expect(tk_fun()).loc
    name_tok = expect(tk_ident())
    decl = FunDecl.new(loc, name_tok.value)
    if self.current().kind == tk_l_paren() {
      self.bump()
      self.skip_newlines()
      if self.current().kind == tk_r_paren() {
        refuse_empty_params("fun", name_tok.value)
      } else {
        while true {
          decl.params.push(self.parse_param())
          self.skip_newlines()
          if match_tok(tk_comma()) {
            self.skip_newlines()
          } else {
            break
          }
        }
      }
      expect(tk_r_paren())
    }
    if match_tok(tk_colon()) {
      self.skip_newlines()
      decl.return_type = self.parse_type_name()
    }
    self.skip_newlines()
    if self.current().kind == tk_l_brace() {
      fail(self.current().loc, "fun is a C declaration; it has no body")
      return decl
    }
    refuse_field_params(decl.params)
    for p in decl.params {
      if d = p.default {
        fail(p.loc, "fun parameters cannot have defaults")
        return decl
      }
    }
    decl
  }

  pub fn parse_type_body(owner: String): TypeBody {
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    body = TypeBody.new()
    mark0 = self.err_count()
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      if new_err_since(mark0) {
        break
      }
      vis = false
      if self.current().kind == tk_pub() {
        vis = true
        self.bump()
        self.skip_newlines()
        if self.current().kind != tk_fn() && self.current().kind != tk_ident() {
          fail(self.current().loc, "pub in a type body prefixes fn or a field")
          break
        }
      }
      if self.current().kind == tk_fn() {
        body.methods.push(parse_fn(owner, vis))
      } else if self.current().kind == tk_quote() {
        if vis {
          fail(self.current().loc, "pub in a type body prefixes fn or a field")
          break
        }
        body.quotes.push(parse_quote_decl(owner))
      } else if self.current().kind == tk_comptime() {
        if vis {
          fail(self.current().loc, "pub in a type body prefixes fn or a field")
          break
        }
        body.comptimes.push(parse_comptime_walk(owner))
      } else {
        field = self.parse_field()
        field.vis = vis
        body.fields.push(field)
      }
      self.skip_newlines()
    }
    expect(tk_r_brace())
    body
  }

  pub fn parse_field: Field {
    name = expect(tk_ident())
    expect(tk_colon())
    self.skip_newlines()
    type = self.parse_type_name()
    field = Field.new(name.loc, name.value, type)
    if match_tok(tk_eq()) {
      self.skip_newlines()
      field.default = self.parse_expr()
    }
    field
  }

  pub fn parse_fn(owner: String, vis: Bool): Function {
    loc = expect(tk_fn()).loc
    receiver: Param? = nil
    if owner.size > 0 {
      if self.current().kind == tk_l_paren() {
        fail(self.current().loc, "inherent methods do not take a receiver; use fn name(...)")
      }
    } else {
      if self.current().kind == tk_l_paren() {
        self.bump()
        self.skip_newlines()
        recv = self.parse_param()
        if d = recv.default {
          fail(recv.loc, "receiver cannot have a default")
        }
        receiver = recv
        self.skip_newlines()
        expect(tk_r_paren())
        self.skip_newlines()
      }
    }
    name_loc = self.current().loc
    name = ""
    if self.current().kind == tk_pound() {
      fnn_hold = Function.new(loc, "")
      fnn_hold.name_splice = self.parse_splice()
      fnn_hold.receiver = receiver
      fnn_hold.owner = owner
      fnn_hold.vis = vis
      if self.current().kind == tk_l_paren() {
        self.bump()
        self.skip_newlines()
        if self.current().kind == tk_r_paren() {
          refuse_empty_params("fn", "#(...)")
        } else {
          while true {
            fnn_hold.params.push(self.parse_param())
            self.skip_newlines()
            if match_tok(tk_comma()) {
              self.skip_newlines()
            } else {
              break
            }
          }
        }
        expect(tk_r_paren())
      }
      if match_tok(tk_colon()) {
        self.skip_newlines()
        fnn_hold.return_type = self.parse_bounded_type()
      }
      self.skip_newlines()
      fnn_hold.body = self.parse_block()
      return fnn_hold
    }
    type_meth = false
    if owner.size > 0 {
      if self.current().kind == tk_self() {
        self.bump()
        expect(tk_dot())
        name = expect(tk_ident()).value
        type_meth = true
      } else {
        name = self.parse_fn_name()
      }
    } else {
      if self.current().kind == tk_self() {
        fail(self.current().loc, "a type-level function belongs in a type body: fn self.name(...)")
      }
      name = self.parse_fn_name()
    }
    if name == "new" {
      if owner.size > 0 {
        fail(name_loc, "new is reserved; write initialize")
      }
      if r = receiver {
        fail(name_loc, "new is reserved; write initialize")
      }
    }
    fnn = Function.new(loc, name)
    fnn.receiver = receiver
    fnn.owner = owner
    fnn.vis = vis
    fnn.type_method = type_meth
    if self.current().kind == tk_l_paren() {
      self.bump()
      self.skip_newlines()
      if self.current().kind == tk_r_paren() {
        shown = name
        if type_meth {
          shown = "self.${name}"
        }
        refuse_empty_params("fn", shown)
      } else {
        while true {
          fnn.params.push(self.parse_param())
          self.skip_newlines()
          if match_tok(tk_comma()) {
            self.skip_newlines()
          } else {
            break
          }
        }
      }
      expect(tk_r_paren())
    }
    if match_tok(tk_colon()) {
      self.skip_newlines()
      fnn.return_type = self.parse_bounded_type()
    }
    if name != "initialize" || owner.size == 0 {
      refuse_field_params(fnn.params)
    }
    self.skip_newlines()
    fnn.body = self.parse_block()
    fnn
  }

  pub fn refuse_field_params(params: Array(Param)) {
    for p in params {
      if p.field_param {
        fail(p.loc, "a field parameter (self.${p.name}) is a parameter of a class's initialize only")
        return
      }
    }
  }

  // One declaration for a function without parameters: `fn answer: Int`,
  // with no empty parentheses (the call is still `answer()`; a bare
  // `answer` is the function as a value).
  pub fn refuse_empty_params(kw: String, name: String) {
    fail(self.current().loc, "a ${kw} without parameters is declared without parentheses: write ${kw} ${name}, not ${kw} ${name}()")
  }

  pub fn parse_fn_name: String {
    tok = self.current()
    if tok.kind == tk_ident() {
      self.bump()
      return tok.value
    }
    op = fn_op_name(tok.kind)
    if op.size > 0 {
      self.bump()
      return op
    }
    // `fn []` and `fn []=`: indexing, read and write.
    if tok.kind == tk_l_bracket() && self.index + 1 < self.tokens.size && self.tokens[self.index + 1].kind == tk_r_bracket() {
      self.bump()
      self.bump()
      if self.current().kind == tk_eq() {
        self.bump()
        return "[]="
      }
      return "[]"
    }
    fail(tok.loc, "expected function name")
    ""
  }

  pub fn parse_param: Param {
    if self.current().kind == tk_self() {
      // `self.loc`: a field parameter, its type the field's (field_params).
      self.bump()
      expect(tk_dot())
      fname = expect(tk_ident())
      fp = Param.new(fname.loc, fname.value, dummy_type(fname.loc))
      fp.field_param = true
      if self.current().kind == tk_colon() {
        fail(self.current().loc, "a field parameter takes its field's type: write self.${fname.value} without one")
      }
      if match_tok(tk_eq()) {
        self.skip_newlines()
        fp.default = self.parse_expr()
      }
      return fp
    }
    name_tok = expect(tk_ident())
    expect(tk_colon())
    self.skip_newlines()
    type = self.parse_bounded_type()
    p = Param.new(name_tok.loc, name_tok.value, type)
    if match_tok(tk_eq()) {
      self.skip_newlines()
      p.default = self.parse_expr()
    }
    p
  }

  pub fn parse_type_name: TypeName {
    loc = self.current().loc
    if !nest_enter(loc) {
      return dummy_type(loc)
    }
    tn = parse_type_union(loc)
    nest_leave()
    tn
  }

  pub fn parse_type_union(loc: Location): TypeName {
    first = self.parse_nilable_type()
    if self.current().kind != tk_pipe() {
      return first
    }
    first_copy = first
    u = TypeName.new(loc, "")
    u.members.push(first_copy)
    while match_tok(tk_pipe()) {
      self.skip_newlines()
      u.members.push(self.parse_nilable_type())
    }
    u
  }

  pub fn parse_nilable_type: TypeName {
    tn = self.parse_primary_type()
    while self.current().kind == tk_question() {
      self.bump()
      tn.nilable = true
    }
    tn
  }

  pub fn parse_fn_type: TypeName {
    tok = self.bump()
    tn = TypeName.new(tok.loc, "")
    tn.fn_type = true
    expect(tk_l_paren())
    self.skip_newlines()
    if self.current().kind != tk_r_paren() {
      while true {
        tn.args.push(self.parse_type_name())
        self.skip_newlines()
        if match_tok(tk_comma()) {
          self.skip_newlines()
        } else {
          break
        }
      }
    }
    expect(tk_r_paren())
    if self.current().kind == tk_colon() {
      self.bump()
      self.skip_newlines()
      tn.ret = self.parse_type_name()
    }
    tn
  }

  pub fn parse_primary_type: TypeName {
    if self.current().kind == tk_pound() {
      sp = self.parse_splice()
      tn = TypeName.new(sp.loc, "")
      tn.splice = sp
      return tn
    }
    if self.current().kind == tk_fn() {
      return self.parse_fn_type()
    }
    if self.current().kind == tk_l_paren() {
      // Grouping parentheses: `(fn(Int): Int)?` is an optional function,
      // where `fn(Int): Int?` returns an optional; `(A | B)?` is `A | B | Nil`.
      self.bump()
      self.skip_newlines()
      grouped = self.parse_type_name()
      self.skip_newlines()
      expect(tk_r_paren())
      return grouped
    }
    tok = expect(tk_ident())
    parts: Array(String) = []
    parts.push(tok.value)
    while self.current().kind == tk_dot() {
      self.bump()
      self.skip_newlines()
      tok = self.take_name_after_dot()
      parts.push(tok.value)
    }
    qual = ""
    if parts.size > 1 {
      buf = Buf.new()
      i = 0
      while i < parts.size - 1 {
        if i > 0 {
          buf.push_str(".")
        }
        buf.push_str(parts[i])
        i += 1
      }
      qual = buf.to_s()
    }
    tn = TypeName.new(tok.loc, tok.value)
    tn.mod_name = whole_qualifier(qual, tok.loc)
    if self.current().kind == tk_l_paren() {
      self.bump()
      self.skip_newlines()
      if self.current().kind == tk_r_paren() {
        fail(tok.loc, "empty type arguments")
        self.bump()
        return tn
      }
      if self.current().kind != tk_r_paren() {
        while true {
          // A type parameter may take its bound where it is written
          // inside another type (`xs: Array(T: Ranked)`).
          tn.args.push(self.parse_bounded_type())
          self.skip_newlines()
          if match_tok(tk_comma()) {
            self.skip_newlines()
          } else {
            break
          }
        }
      }
      expect(tk_r_paren())
    }
    tn
  }

  pub fn parse_block: Array(Stmt) {
    stmts: Array(Stmt) = []
    if !nest_enter(self.current().loc) {
      return stmts
    }
    expect(tk_l_brace())
    self.skip_newlines()
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      mark = self.err_count()
      start_idx = self.index
      stmts.push(self.parse_lead_stmt())
      if new_err_since(mark) {
        self.sync_stmt()
        if self.index == start_idx && self.current().kind != tk_eof() && self.current().kind != tk_r_brace() {
          self.bump()
        }
      }
      self.skip_newlines()
    }
    lead_check(stmts)
    expect(tk_r_brace())
    nest_leave()
    stmts
  }

  pub fn parse_stmt: Stmt {
    k = self.current().kind
    if k == tk_const() {
      // A constant belongs to the module: a local is a name assigned
      // with `=`.
      loc0 = self.current().loc
      fail(loc0, "const is declared at module level, outside every function; inside one, a local is `name = value`")
      while self.current().kind != tk_newline() && self.current().kind != tk_eof() && self.current().kind != tk_r_brace() {
        self.bump()
      }
      return stmt_expr(loc0, Expr.new(ex_nil(), loc0))
    }
    if k == tk_if() {
      return self.parse_if()
    }
    if k == tk_switch() {
      expr = self.parse_switch()
      return stmt_expr(expr.loc, expr)
    }
    if k == tk_while() {
      return self.parse_while()
    }
    if k == tk_pin() {
      return self.parse_pin()
    }
    if k == tk_release() {
      return self.parse_release()
    }
    if k == tk_defer() {
      return self.parse_defer()
    }
    if k == tk_for() {
      return self.parse_for()
    }
    if k == tk_break() {
      return self.parse_break()
    }
    if k == tk_continue() {
      return self.parse_continue()
    }
    if k == tk_return() {
      return self.parse_return()
    }
    if k == tk_quote() {
      return self.parse_quote_stmt()
    }
    if k == tk_ident() {
      if self.gc_hold_ahead() {
        return self.parse_hold()
      }
      return self.parse_ident_stmt()
    }
    expr = self.parse_expr()
    finish_stmt(expr)
  }

  // `gc.hold { ... }` (std.gc): a statement, the shape of `pin(x) { }`
  // without a value. The checker asks for `import std.gc`. Any other
  // use of `gc.hold` is an ordinary call and the checker refuses it.
  pub fn gc_hold_ahead: Bool {
    if self.current().value != "gc" {
      return false
    }
    i = self.index + 1
    if i + 1 >= self.tokens.size {
      return false
    }
    if self.tokens[i].kind != tk_dot() {
      return false
    }
    if self.tokens[i + 1].kind != tk_ident() || self.tokens[i + 1].value != "hold" {
      return false
    }
    i += 2
    while i < self.tokens.size && self.tokens[i].kind == tk_newline() {
      i += 1
    }
    i < self.tokens.size && self.tokens[i].kind == tk_l_brace()
  }

  pub fn parse_hold: Stmt {
    loc = self.bump().loc
    expect(tk_dot())
    self.bump()
    self.skip_newlines()
    body = self.parse_block()
    s = Stmt.new(st_hold(), loc)
    s.body = body
    s
  }

  pub fn annotated_bind_ahead: Bool {
    if self.current().kind != tk_ident() {
      return false
    }
    for i in self.index + 1..self.tokens.size {
      if self.tokens[i].kind != tk_newline() {
        return self.tokens[i].kind == tk_colon()
      }
    }
    false
  }

  pub fn parse_ident_stmt: Stmt {
    if self.annotated_bind_ahead() {
      loc = self.current().loc
      name = self.bump()
      expect(tk_colon())
      self.skip_newlines()
      declared = self.parse_type_name()
      self.skip_newlines()
      expect(tk_eq())
      self.skip_newlines()
      value = self.parse_else_guard(maybe_trailing_block(self.parse_expr()))
      s = Stmt.new(st_assign(), loc)
      target = Expr.new(ex_name(), name.loc)
      target.ident = name.value
      s.target = target
      s.value = value
      s.declared = declared
      s.op = tk_eq()
      return s
    }
    expr = self.parse_expr()
    finish_stmt(expr)
  }

  pub fn finish_stmt(expr: Expr): Stmt {
    expr2 = maybe_trailing_block(expr)
    self.skip_newlines_if_continuing()
    if token_is_assign_op(self.current().kind) {
      op = self.bump()
      self.skip_newlines()
      value = maybe_trailing_block(self.parse_expr())
      if op.kind == tk_eq() {
        value = self.parse_else_guard(value)
      } else if self.current().kind == tk_else() {
        fail(self.current().loc, "an else guard follows a plain assignment: write `v = f() else e { ... }`, then update with v")
      }
      s = Stmt.new(st_assign(), op.loc)
      s.target = expr2
      s.value = value
      s.op = op.kind
      return s
    }
    // `f() else e { ... }`: the else guard of a call whose success is
    // nothing (`Void | E`), the guard of an assignment without a name.
    if self.current().kind == tk_else() {
      return stmt_expr(expr2.loc, self.parse_else_guard(expr2))
    }
    stmt_expr(expr2.loc, expr2)
  }

  // `n = f() else e { ...; continue }`: the else guard of a plain
  // assignment. It is `f() ?? <the block>`, the block held by the
  // switch node of `?? return` (op tk_return, ast.av) with the
  // failure's name in ident and bool_val set: every walker already
  // visits that node. The checker binds the name to the failure, asks
  // the block to leave, and refuses a guard without a name.
  pub fn parse_else_guard(value: Expr): Expr {
    i = self.index
    while i < self.tokens.size && self.tokens[i].kind == tk_newline() {
      i += 1
    }
    if i >= self.tokens.size || self.tokens[i].kind != tk_else() {
      return value
    }
    self.skip_newlines()
    at = self.bump().loc
    right = Expr.new(ex_switch(), at)
    right.op = tk_return()
    right.has_else = true
    right.bool_val = true
    if self.current().kind == tk_ident() {
      right.ident = self.bump().value
    }
    self.skip_newlines()
    right.else_body = self.parse_block()
    bin = Expr.new(ex_binary(), at)
    bin.op = tk_question_question()
    bin.left = value
    bin.right = right
    bin
  }

  // A block after a call, a field or a function's name, on the line the
  // call ends on (`f(a) { ... }`, `xs.each { |x| ... }`): not Avant. It is
  // refused, with a hint naming the lambda form, and skipped; a block on
  // the next line is a statement of its own.
  pub fn maybe_trailing_block(expr: Expr): Expr {
    if expr.kind == ex_unary() {
      if inner = expr.inner {
        expr.inner = maybe_trailing_block(inner)
      }
      return expr
    }
    i = self.index
    if i >= self.tokens.size {
      return expr
    }
    if self.tokens[i].kind != tk_l_brace() {
      return expr
    }
    // A capitalized name is a type's (a struct literal).
    bare_fn = expr.kind == ex_name() && expr.type_args.size == 0 && expr.ident.size > 0 && !(expr.ident[0] >= 65 && expr.ident[0] <= 90)
    if expr.kind != ex_call() && expr.kind != ex_field() && expr.kind != ex_array_new() && !bare_fn {
      return expr
    }
    // `x = gc.hold { ... }`: the checker says that gc.hold is a statement.
    hold = i >= 3 && self.tokens[i - 1].value == "hold" && self.tokens[i - 2].kind == tk_dot() && self.tokens[i - 3].value == "gc"
    if hold {
      tb = self.parse_trailing_block()
      call = Expr.new(ex_call(), tb.loc)
      call.callee = "hold"
      if obj = expr.object {
        call.receiver = obj
      }
      call.block = tb
      return call
    }
    if !self.pipes_after_brace(i) {
      fail(self.tokens[i].loc, block_after_call_message())
    }
    _ = self.parse_trailing_block()
    if self.current().kind == tk_question() {
      self.bump()
    }
    parse_infix_after(expr)
  }

  pub fn if_assign_ahead: Bool {
    if self.current().kind != tk_ident() {
      return false
    }
    for i in self.index + 1..self.tokens.size {
      if self.tokens[i].kind != tk_newline() {
        return self.tokens[i].kind == tk_eq()
      }
    }
    false
  }

  // One element of an `if` or `while` condition: a binding
  // `name = expr` or a Bool condition, as an st_if without bodies.
  pub fn parse_cond_element(loc: Location): Stmt {
    el = Stmt.new(st_if(), loc)
    if self.if_assign_ahead() {
      name = self.bump()
      self.skip_newlines()
      expect(tk_eq())
      self.skip_newlines()
      el.bind = name.value
    }
    el.cond = self.parse_cond_expr()
    el
  }

  // The condition of an `if` or a `while`: elements separated by commas
  // (a binding chain), evaluated left to right; each binding is in scope
  // for the elements after it and the then-block. The last element is
  // the statement's own cond and bind; the ones before it are `pre`.
  pub fn parse_cond_list(loc: Location): Stmt {
    s = parse_cond_element(loc)
    while self.current().kind == tk_comma() {
      self.bump()
      self.skip_newlines()
      next = parse_cond_element(self.current().loc)
      first = Stmt.new(st_if(), s.loc)
      first.bind = s.bind
      first.cond = s.cond
      s.pre.push(first)
      s.bind = next.bind
      s.cond = next.cond
    }
    s
  }

  pub fn parse_if: Stmt {
    loc = expect(tk_if()).loc
    self.skip_newlines()
    head = parse_cond_list(loc)
    bind = head.bind
    cond = dummy_expr(loc)
    if c = head.cond {
      cond = c
    }
    self.skip_newlines()
    then_body = self.parse_block()
    else_body: Array(Stmt) = []
    else_bind = ""
    self.skip_newlines()
    if self.current().kind == tk_else() {
      self.bump()
      self.skip_newlines()
      if self.current().kind == tk_if() {
        else_body.push(self.parse_if())
      } else {
        if self.current().kind == tk_ident() {
          // `else e { }`: the failure's name.
          else_bind = self.bump().value
          self.skip_newlines()
        }
        else_body = self.parse_block()
      }
    }
    s = Stmt.new(st_if(), loc)
    s.else_bind = else_bind
    s.cond = cond
    s.then_body = then_body
    s.else_body = else_body
    s.bind = bind
    s.pre = head.pre
    s
  }

  pub fn parse_pin: Stmt {
    loc = expect(tk_pin()).loc
    self.skip_newlines()
    expect(tk_l_paren())
    self.skip_newlines()
    value = self.parse_expr()
    self.skip_newlines()
    expect(tk_r_paren())
    self.skip_newlines()
    body = self.parse_block()
    s = Stmt.new(st_pin(), loc)
    s.expr = value
    s.body = body
    s
  }

  // `defer { body }`: the body runs on every way out of the block that
  // holds the statement (checker check_defer, mir lower_defer).
  pub fn parse_defer: Stmt {
    loc = self.bump().loc
    self.skip_newlines()
    if self.current().kind != tk_l_brace() {
      fail(loc, "defer takes a block, `defer { ... }`, run on every way out of the block around it; `defer` is a keyword and cannot be a name")
      while self.current().kind != tk_newline() && self.current().kind != tk_eof() && self.current().kind != tk_r_brace() {
        self.bump()
      }
      return stmt_expr(loc, Expr.new(ex_nil(), loc))
    }
    body = self.parse_block()
    self.defers_seen += 1
    s = Stmt.new(st_defer(), loc)
    s.body = body
    s
  }

  // `release(place)`: a statement, the shape of `pin(x)` without a
  // block.
  pub fn parse_release: Stmt {
    loc = expect(tk_release()).loc
    self.skip_newlines()
    expect(tk_l_paren())
    self.skip_newlines()
    value = self.parse_expr()
    self.skip_newlines()
    expect(tk_r_paren())
    s = Stmt.new(st_release(), loc)
    s.expr = value
    s
  }

  // `while v = x { }` and binding chains are `while true { if
  // <condition> { body } else { break } }`: the condition is evaluated
  // before each iteration (`continue` too), the names it binds live in
  // the body only.
  pub fn parse_while: Stmt {
    loc = expect(tk_while()).loc
    self.skip_newlines()
    head = parse_cond_list(loc)
    self.skip_newlines()
    body = self.parse_block()
    s = Stmt.new(st_while(), loc)
    if head.bind.size == 0 && head.pre.size == 0 {
      s.cond = head.cond
      s.body = body
      return s
    }
    // `while v = f() { } else e { }`: the else block runs once, when
    // the head fails, with the failure in e; then the loop ends.
    if head.bind.size > 0 {
      self.skip_newlines()
      if self.current().kind == tk_else() {
        self.bump()
        self.skip_newlines()
        if self.current().kind == tk_ident() {
          head.else_bind = self.bump().value
          self.skip_newlines()
        } else {
          fail(self.current().loc, "a while's else names the failure it reads: write `while v = f() { } else e { }`; to end the loop at any failure, leave the else out")
        }
        head.else_body = self.parse_block()
      }
    }
    t = Expr.new(ex_bool(), loc)
    t.bool_val = true
    s.cond = t
    head.then_body = body
    head.loop_head = true
    for el in head.pre {
      el.loop_head = true
    }
    head.else_body.push(Stmt.new(st_break(), loc))
    s.body.push(head)
    s
  }

  pub fn for_name_expr(loc: Location, name: String): Expr {
    e = Expr.new(ex_name(), loc)
    e.ident = name
    e
  }

  pub fn for_int_expr(loc: Location, bits: UInt64): Expr {
    e = Expr.new(ex_int(), loc)
    e.int_bits = bits
    e
  }

  // An assignment a `for` loop is made of. It carries for_kind 3 (the
  // loop's own stores: the counter, its end, the hidden array and index)
  // or 4 (the element copied into the loop's variable), which is how the
  // checker tells the loop's stores from the program's: the program may
  // not assign a for variable.
  pub fn for_assign(loc: Location, name: String, value: Expr): Stmt {
    s = Stmt.new(st_assign(), loc)
    s.target = for_name_expr(loc, name)
    s.value = value
    s.op = tk_eq()
    s.for_kind = 3
    s
  }

  pub fn for_binary(loc: Location, op: Int, left: Expr, right: Expr): Expr {
    e = Expr.new(ex_binary(), loc)
    e.op = op
    e.left = left
    e.right = right
    e
  }

  pub fn for_inc(loc: Location, name: String): Stmt {
    for_inc_by(loc, name, 1)
  }

  pub fn for_inc_by(loc: Location, name: String, by: UInt64): Stmt {
    for_assign(loc, name, for_binary(loc, tk_plus(), for_name_expr(loc, name), for_int_expr(loc, by)))
  }

  // The step a range's body takes (Parser.for_last and for_by, read
  // where the body is walked).
  pub fn range_step_now: RangeStep {
    rs = RangeStep.new()
    rs.last = self.for_last
    rs.by = self.for_by
    rs
  }

  pub fn for_step(loc: Location, counter: String, into: Array(Stmt)) {
    range_step_into(range_step_now(), loc, counter, into)
  }

  pub fn for_advance(body: Array(Stmt), counter: String, loc: Location): Array(Stmt) {
    range_advance(range_step_now(), body, counter, loc)
  }

  // `by k` after a range: k an integer literal or a module constant
  // (`by 4`, `by -1`, `by chunk`, `by -m.step`), the stride (the values
  // a, a + k, a + 2k, ... inside the range; a step down gives the same
  // values in reverse). A literal's sign and size are checked here; a
  // constant's when the checker knows its value.
  pub fn parse_for_by: RangeBy {
    rb = RangeBy.new()
    self.bump()
    self.skip_newlines()
    if self.current().kind == tk_minus() {
      rb.down = true
      self.bump()
    }
    if self.current().kind == tk_ident() {
      name_tok = self.bump()
      e = Expr.new(ex_name(), name_tok.loc)
      e.ident = name_tok.value
      if self.current().kind == tk_dot() && self.index + 1 < self.tokens.size && self.tokens[self.index + 1].kind == tk_ident() {
        self.bump()
        field_tok = self.bump()
        q = Expr.new(ex_field(), name_tok.loc)
        q.object = e
        q.ident = field_tok.value
        e = q
      }
      rb.named = e
      return rb
    }
    if self.current().kind != tk_integer() {
      fail(self.current().loc, "for ... by takes an integer literal or a module constant (by 2, by -1, by step): the step is fixed when the loop is compiled; for a step computed at run time, use a while loop")
      return rb
    }
    tok = self.bump()
    ok = parse_int_tok(tok)
    lit = Expr.new(ex_int(), tok.loc)
    lit.int_bits = self.int_bits
    lit.int_suffix = self.int_suffix
    if !ok {
      return rb
    }
    if lit.int_bits == 0 {
      fail(lit.loc, "for ... by 0 would never move: the step is a nonzero integer")
      return rb
    }
    if lit.int_bits > 9223372036854775807 || lit.int_suffix.size > 0 {
      fail(lit.loc, "for ... by takes an Int literal")
      return rb
    }
    rb.by = lit.int_bits
    rb
  }

  pub fn parse_for: Stmt {
    loc = expect(tk_for()).loc
    self.skip_newlines()
    var_tok = expect(tk_ident())
    self.skip_newlines()
    // `for i, x in xs`: the position, then the element.
    pos_name = ""
    if self.current().kind == tk_comma() {
      self.bump()
      self.skip_newlines()
      pos_name = var_tok.value
      var_tok = expect(tk_ident())
      self.skip_newlines()
      if var_tok.value == pos_name {
        fail(var_tok.loc, "for ${pos_name}, ${pos_name} in ...: the position and the element need two names")
      }
    }
    expect(tk_in())
    self.skip_newlines()
    // The array and the range's ends are read like a while or if
    // condition, with no struct literal: before, `for x in xs {` with a
    // first body line `row: Array(Bool) = []` read `xs { row: ... }` as a
    // literal.
    first = self.parse_for_operand()
    self.skip_newlines()
    id = self.for_id
    self.for_id += 1
    if self.current().kind == tk_dot_dot() || self.current().kind == tk_dot_dot_eq() {
      // `a..b` excludes b; `a..=b` includes it: the loop runs while
      // the counter is at most b and stops after b.
      incl = self.current().kind == tk_dot_dot_eq()
      self.bump()
      self.skip_newlines()
      end_expr = self.parse_for_operand()
      self.skip_newlines()
      if pos_name.size > 0 {
        fail(loc, "for ${pos_name}, ${var_tok.value} in a range: a range's loop has one variable, its value (for ${var_tok.value} in ...)")
      }
      rb = RangeBy.new()
      if self.current().kind == tk_ident() && self.current().value == "by" {
        rb = self.parse_for_by()
        self.skip_newlines()
      }
      by = rb.by
      seen_range = self.defers_seen
      raw_body = self.parse_block()
      end_name = "__for${id}_end"
      pending = false
      if _ = rb.named {
        pending = true
      }
      if rb.down || pending {
        return range_loop(loc, var_tok.value, first, end_expr, end_name, incl, rb, raw_body, self.defers_seen > seen_range)
      }
      s = Stmt.new(st_while(), loc)
      s.for_kind = 1
      s.pre.push(for_assign(loc, var_tok.value, first))
      s.pre.push(for_assign(loc, end_name, end_expr))
      op = tk_less()
      self.for_last = ""
      if incl {
        op = tk_less_eq()
        self.for_last = end_name
      }
      s.cond = for_binary(loc, op, for_name_expr(loc, var_tok.value), for_name_expr(loc, end_name))
      self.for_by = by
      if self.defers_seen > seen_range {
        // A body with a defer: its deferred blocks run before the step,
        // which `continue` reaches as the body's end does.
        s.body = raw_body
        n_range = s.body.size
        for_step(loc, var_tok.value, s.body)
        s.latch = s.body.size - n_range
      } else {
        s.body = for_advance(raw_body, var_tok.value, loc)
        for_step(loc, var_tok.value, s.body)
      }
      self.for_last = ""
      self.for_by = 1
      return s
    }
    if self.current().kind == tk_ident() && self.current().value == "by" {
      fail(self.current().loc, "for ... by takes a range (for i in a..b by 2); to visit every k-th element, walk the positions: for i in 0..xs.size by k")
      self.bump()
    }
    seen_walk = self.defers_seen
    raw_body2 = self.parse_block()
    self.for_last = ""
    xs_name = "__for${id}_xs"
    idx_name = "__for${id}_i"
    if pos_name.size > 0 {
      // The position is the loop's own counter, under the program's name.
      idx_name = pos_name
    }
    s2 = Stmt.new(st_while(), loc)
    s2.for_kind = 2
    s2.pre.push(for_assign(loc, xs_name, first))
    s2.pre.push(for_assign(loc, idx_name, for_int_expr(loc, 0)))
    size_expr = Expr.new(ex_field(), loc)
    size_expr.object = for_name_expr(loc, xs_name)
    size_expr.ident = "size"
    s2.cond = for_binary(loc, tk_less(), for_name_expr(loc, idx_name), size_expr)
    elem_expr = Expr.new(ex_index(), loc)
    elem_expr.left = for_name_expr(loc, xs_name)
    elem_expr.right = for_name_expr(loc, idx_name)
    elem_set = for_assign(loc, var_tok.value, elem_expr)
    elem_set.for_kind = 4
    s2.body.push(elem_set)
    latched = self.defers_seen > seen_walk
    if latched {
      s2.body.concat(raw_body2)
    } else {
      adv = for_advance(raw_body2, idx_name, loc)
      s2.body.concat(adv)
    }
    n_walk = s2.body.size
    if pos_name.size > 0 {
      // A step, as a range's: a lambda that captures the position keeps
      // that iteration's value.
      for_step(loc, idx_name, s2.body)
    } else {
      s2.body.push(for_inc(loc, idx_name))
    }
    if latched {
      s2.latch = s2.body.size - n_walk
    }
    s2
  }

  pub fn parse_switch: Expr {
    loc = expect(tk_switch()).loc
    self.skip_newlines()
    cond = self.parse_cond_expr()
    self.skip_newlines()
    expect(tk_l_brace())
    self.skip_newlines()
    expr = Expr.new(ex_switch(), loc)
    expr.cond = cond
    seen_else = false
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      if self.current().kind == tk_case() {
        if seen_else {
          fail(self.current().loc, "else must be the last switch arm")
        }
        expr.cases.push(self.parse_switch_case())
      } else if self.current().kind == tk_else() {
        if seen_else {
          fail(self.current().loc, "duplicate else in switch")
        }
        self.bump()
        self.skip_newlines()
        expr.else_body = self.parse_block()
        expr.has_else = true
        seen_else = true
      } else {
        fail(self.current().loc, "expected case or else, found ${token_name(self.current().kind)}")
        break
      }
      self.skip_newlines()
    }
    expect(tk_r_brace())
    if expr.cases.size == 0 {
      fail(loc, "switch needs a case")
    }
    expr
  }

  pub fn parse_switch_case: SwitchCase {
    loc = expect(tk_case()).loc
    self.skip_newlines()
    arm = SwitchCase.new(loc)
    while true {
      arm.labels.push(self.parse_case_label())
      self.skip_newlines()
      if match_tok(tk_comma()) {
        self.skip_newlines()
      } else {
        break
      }
    }
    self.skip_newlines()
    arm.body = self.parse_block()
    arm
  }

  // A case label: an integer literal, or a name (an enum member,
  // `case eof`; a qualified `case Tok.eof` is kept so the checker can
  // say to write it bare). The checker reads a member label against the
  // discriminant's type.
  pub fn parse_case_label: CaseLabel {
    if self.current().kind == tk_string() {
      // A String switch's label.
      tok0 = self.bump()
      slabel = CaseLabel.new(lb_string(), tok0.loc)
      slabel.text = tok0.value
      return slabel
    }
    if self.current().kind == tk_interp_open() {
      iloc = self.current().loc
      fail(iloc, "a case label is a literal")
      _ = self.parse_interpolated_string()
      return CaseLabel.new(lb_string(), iloc)
    }
    if self.current().kind == tk_true() || self.current().kind == tk_false() {
      // A Bool switch's `case true`.
      btrue = self.current().kind == tk_true()
      bl = CaseLabel.new(lb_bool(), self.bump().loc)
      if btrue {
        bl.int_val = 1
      }
      return bl
    }
    if self.current().kind == tk_nil() {
      // A union switch's `case nil`.
      return CaseLabel.new(lb_nil(), self.bump().loc)
    }
    if self.current().kind == tk_ident() && self.index + 1 < self.tokens.size && self.tokens[self.index + 1].kind == tk_colon() {
      // A union member with a binding: `case n: Int`.
      btok = self.bump()
      self.bump()
      self.skip_newlines()
      blabel = CaseLabel.new(lb_type(), btok.loc)
      blabel.bind = btok.value
      blabel.tname = self.parse_type_name()
      return blabel
    }
    if self.current().kind == tk_ident() && self.label_is_type() {
      // A union member's type without a binding: a capital first
      // letter means a type, as in `case Json`; `case Tok.eof` stays a
      // member label.
      tloc = self.current().loc
      tlabel = CaseLabel.new(lb_type(), tloc)
      tlabel.tname = self.parse_type_name()
      return tlabel
    }
    first = self.parse_case_bound()
    if self.current().kind != tk_dot_dot() && self.current().kind != tk_dot_dot_eq() {
      return first
    }
    // A range label: `lo..hi` excludes hi, `lo..=hi` includes it, as in
    // `for`.
    range = CaseLabel.new(lb_range(), first.loc)
    range.incl = self.current().kind == tk_dot_dot_eq()
    self.bump()
    self.skip_newlines()
    range.lo = first
    range.hi = self.parse_case_bound()
    range
  }

  // A label that may bound a range: an integer literal (a character
  // literal is one), or a name: an enum member, a constant (`case
  // max_depth`, `case limits.max`), checked by the checker.
  pub fn parse_case_bound: CaseLabel {
    if self.current().kind == tk_ident() {
      tok = self.bump()
      label = CaseLabel.new(lb_member(), tok.loc)
      label.text = tok.value
      while self.current().kind == tk_dot() {
        self.bump()
        next = self.take_name_after_dot()
        if label.qual.size > 0 {
          label.qual = "${label.qual}.${label.text}"
        } else {
          label.qual = label.text
        }
        label.text = next.value
      }
      return label
    }
    ilabel = CaseLabel.new(lb_int(), self.current().loc)
    parse_case_int(ilabel)
    ilabel
  }

  // Whether the label at the current token names a type: its last
  // dotted part starts with a capital (`Json`, `json.Json`, `Array(Int)`),
  // where `case Tok.eof` ends in a member.
  pub fn label_is_type: Bool {
    i = self.index
    last = self.tokens[i].value
    while i + 2 < self.tokens.size && self.tokens[i + 1].kind == tk_dot() {
      i += 2
      last = self.tokens[i].value
    }
    if last.size == 0 {
      return false
    }
    c = last[0]
    c >= 65 && c <= 90
  }

  // An integer label (a character literal is one): its magnitude and
  // sign, and int_val its 64 bits. The checker checks it against the
  // discriminant's type, as a literal adopts its context's; a suffix
  // is refused, since the label takes that type.
  pub fn parse_case_int(label: CaseLabel) {
    neg = false
    if self.current().kind == tk_minus() {
      self.bump()
      self.skip_newlines()
      neg = true
    }
    if self.current().kind != tk_integer() {
      if !neg && self.enum_lit_ahead() {
        member = self.tokens[self.index + 1].value
        fail(self.current().loc, "a case label over an enum is its member's bare name: case ${member}, not case :${member}")
        self.bump()
        self.bump()
        return
      }
      fail(self.current().loc, "case label must be an integer literal")
      return
    }
    tok = self.bump()
    if !parse_int_tok(tok) {
      return
    }
    if self.int_suffix.size != 0 {
      fail(tok.loc, "a case label takes the type of the switch's value: write it without the suffix")
      return
    }
    bits = self.int_bits
    label.bits = bits
    label.neg = neg
    if neg {
      label.int_val = (0 &- bits).wrap_i()
    } else {
      label.int_val = bits.wrap_i()
    }
  }

  pub fn parse_for_operand: Expr {
    old = self.allow_struct_lit
    old_place = self.lit_place
    self.allow_struct_lit = false
    self.lit_place = "a `for`"
    expr = self.parse_expr()
    self.allow_struct_lit = old
    self.lit_place = old_place
    expr
  }

  pub fn parse_cond_expr: Expr {
    old = self.allow_struct_lit
    old_place = self.lit_place
    self.allow_struct_lit = false
    self.lit_place = "a condition"
    expr = self.parse_expr()
    if self.pred_block_ahead() {
      expr = maybe_trailing_block(expr)
    }
    self.allow_struct_lit = old
    self.lit_place = old_place
    expr
  }

  // A struct literal where the `{` opens a block (a condition, a `for`'s
  // operand): a type's name, then `{ name: value` where the value cannot
  // start a type (a declaration `{ x: Int`) or is followed by a comma.
  // Reported with the parentheses that fix it, and parsed as the
  // literal, so the block after it is read as written.
  pub fn misplaced_literal_ahead(name: String): Bool {
    if self.allow_struct_lit || name.size == 0 || name[0] < 65 || name[0] > 90 || !self.struct_literal_ahead() {
      return false
    }
    i = self.index + 1
    while i < self.tokens.size && self.tokens[i].kind == tk_newline() {
      i += 1
    }
    if i >= self.tokens.size || self.tokens[i].kind != tk_ident() {
      return false
    }
    i += 1
    while i < self.tokens.size && self.tokens[i].kind == tk_newline() {
      i += 1
    }
    i += 1
    while i < self.tokens.size && self.tokens[i].kind == tk_newline() {
      i += 1
    }
    if i >= self.tokens.size {
      return false
    }
    k = self.tokens[i].kind
    if k == tk_ident() {
      return i + 1 < self.tokens.size && self.tokens[i + 1].kind == tk_comma()
    }
    k != tk_fn() && k != tk_pound()
  }

  pub fn parse_misplaced_literal(tok: Token, qual: String): Expr {
    shown = tok.value
    if qual.size > 0 {
      shown = "${qual}.${tok.value}"
    }
    fail(tok.loc, "a struct literal in ${self.lit_place} needs parentheses around it: (${shown} { ... })")
    self.allow_struct_lit = true
    e = parse_struct_literal(tok, qual)
    self.allow_struct_lit = false
    e
  }

  pub fn pred_block_ahead: Bool {
    i = self.index
    while i < self.tokens.size {
      if self.tokens[i].kind != tk_newline() {
        break
      }
      i += 1
    }
    if i >= self.tokens.size {
      return false
    }
    if self.tokens[i].kind != tk_l_brace() {
      return false
    }
    j = i + 1
    while j < self.tokens.size {
      if self.tokens[j].kind != tk_newline() {
        break
      }
      j += 1
    }
    if j >= self.tokens.size {
      return false
    }
    self.tokens[j].kind == tk_pipe() || self.tokens[j].kind == tk_pipe_pipe()
  }

  pub fn parse_break: Stmt {
    loc = expect(tk_break()).loc
    k = self.current().kind
    if !(k == tk_newline() || k == tk_r_brace() || k == tk_eof()) {
      // break 2, break outer: one message at the word, not a dropped value
      fail(self.current().loc, "break takes nothing after it: it leaves the loop it is in, and labelled or counted breaks (break 2, break outer) are not in the language; to leave several loops, put them in a function and return from it")
      sync_stmt()
    }
    Stmt.new(st_break(), loc)
  }

  pub fn parse_continue: Stmt {
    loc = expect(tk_continue()).loc
    Stmt.new(st_continue(), loc)
  }

  pub fn parse_return: Stmt {
    loc = expect(tk_return()).loc
    expr: Expr? = nil
    k = self.current().kind
    if !(k == tk_newline() || k == tk_r_brace() || k == tk_eof()) {
      expr = maybe_trailing_block(self.parse_expr())
    }
    stmt_return(loc, expr)
  }

  pub fn parse_expr: Expr {
    parse_expr_min(0)
  }

  pub fn parse_expr_min(min_prec: Int): Expr {
    if !nest_enter(self.current().loc) {
      return dummy_expr(self.current().loc)
    }
    outer_peak = self.peak
    self.peak = self.depth
    left = parse_infix_rest(parse_postfix(self.parse_prefix()), min_prec)
    if outer_peak > self.peak {
      self.peak = outer_peak
    }
    nest_leave()
    left
  }

  // An operand already parsed (a call whose refused block was skipped),
  // continued by the operators after it as parse_expr_min continues its
  // first operand.
  pub fn parse_infix_after(left: Expr): Expr {
    if self.current().kind != tk_newline() && infix_prec(self.current().kind) < 0 {
      return left
    }
    if !nest_enter(self.current().loc) {
      return left
    }
    outer_peak = self.peak
    self.peak = self.depth
    got = parse_infix_rest(left, 0)
    if outer_peak > self.peak {
      self.peak = outer_peak
    }
    nest_leave()
    got
  }

  // The operators after left, each with its right operand, by precedence
  // from min_prec.
  pub fn parse_infix_rest(left0: Expr, min_prec: Int): Expr {
    left = left0
    while true {
      self.skip_newlines_if_continuing()
      prec = infix_prec(self.current().kind)
      if prec < min_prec {
        break
      }
      op = self.bump()
      self.skip_newlines()
      left_peak = self.peak
      self.peak = self.depth
      next_prec = prec + 1
      if op.kind == tk_question_question() {
        next_prec = prec
      }
      right = dummy_expr(op.loc)
      k2 = self.current().kind
      if op.kind == tk_question_question() && (k2 == tk_return() || k2 == tk_break() || k2 == tk_continue()) {
        // `x ?? return v`, `?? break`, `?? continue`: the right side is
        // that statement, held by a switch node with op tk_return
        // (ast.av), which every walker already visits.
        st = dummy_stmt(op.loc)
        if k2 == tk_break() {
          st = self.parse_break()
        } else if k2 == tk_continue() {
          st = self.parse_continue()
        } else {
          st = self.parse_return()
        }
        right = Expr.new(ex_switch(), st.loc)
        right.op = tk_return()
        right.has_else = true
        right.else_body.push(st)
      } else {
        right = parse_expr_min(next_prec)
        if op.kind == tk_question_question() && ast_is_exit_call(right) {
          // `x ?? panic("why")`, `?? exit(2)`: a call that never
          // returns leaves as `?? return` does, held the same way.
          st = stmt_expr(right.loc, right)
          right = Expr.new(ex_switch(), st.loc)
          right.op = tk_return()
          right.has_else = true
          right.else_body.push(st)
        }
      }
      bin = Expr.new(ex_binary(), op.loc)
      bin.op = op.kind
      bin.left = left
      bin.right = right
      left = bin
      if !nest_step(op.loc, left_peak) {
        break
      }
    }
    left
  }

  // The rest of a slice `xs[start..stop]` after its start, at the range
  // operator: `..` excludes stop, `..=` includes it, and a slice without
  // a stop (`xs[start..]`) runs to the end. It is the call
  // `xs.slice(start, stop)` (`xs.slice(start)` to the end); `..=` gives
  // `stop + 1`.
  pub fn parse_slice_rest(recv: Expr, at: Location, start: Expr): Expr {
    incl = self.current().kind == tk_dot_dot_eq()
    op_loc = self.bump().loc
    self.skip_newlines()
    call = Expr.new(ex_call(), at)
    call.callee = "slice"
    call.receiver = recv
    call.args.push(start)
    if self.current().kind == tk_r_bracket() {
      if incl {
        fail(op_loc, "an inclusive slice needs its last index: write xs[a..=b], or xs[a..] to the end")
      }
    } else {
      stop = self.parse_expr()
      self.skip_newlines()
      if incl {
        one = Expr.new(ex_int(), op_loc)
        one.int_bits = 1
        sum = Expr.new(ex_binary(), op_loc)
        sum.op = tk_plus()
        sum.left = stop
        sum.right = one
        stop = sum
      }
      call.args.push(stop)
    }
    expect(tk_r_bracket())
    call
  }

  pub fn parse_postfix(left: Expr): Expr {
    cur = left
    keep = true
    while keep {
      self.skip_newlines_if_postfix()
      left_peak = self.peak
      self.peak = self.depth
      k = self.current().kind
      if k == tk_dot() {
        at = self.bump().loc
        self.skip_newlines()
        if self.current().kind == tk_pound() {
          sp = self.parse_splice()
          if self.current().kind == tk_l_paren() {
            args = self.parse_arg_list()
            call = Expr.new(ex_call(), at)
            call.args = args
            take_arg_names(call)
            call.receiver = cur
            call.splice = sp
            cur = call
          } else {
            // Written without parentheses: the name the splice gives is
            // held to the rule for a written name (a method takes them).
            fa = Expr.new(ex_field(), at)
            fa.object = cur
            fa.splice = sp
            fa.bare_name = sp.loc
            cur = fa
          }
        } else {
          field = self.take_name_after_dot()
          if self.current().kind == tk_l_paren() {
            took_type = false
            qual_pre = qual_of(cur)
            // `xs.each (x) { ... }`: a lambda, never a qualified type's
            // literal (`m.Pair(A) { a: ... }`).
            if qual_pre.size > 0 && self.allow_struct_lit && self.lambda_head_at(self.index) >= 0 && !(field.value[0] >= 65 && field.value[0] <= 90) {
              qual_pre = ""
            }
            if qual_pre.size > 0 {
              if app = parse_maybe_type_app(field, qual_pre) {
                cur = app
                took_type = true
              }
            }
            if !took_type {
              args = self.parse_call_args(field.value)
              call = Expr.new(ex_call(), at)
              call.callee = field.value
              call.args = args
              take_arg_names(call)
              call.receiver = cur
              cur = call
            }
          } else if field.value == "new" {
            call = Expr.new(ex_call(), at)
            call.callee = "new"
            call.receiver = cur
            call.bare_name = field.loc
            cur = call
          } else if self.allow_struct_lit {
            if self.struct_literal_ahead() {
              cur = parse_struct_literal(field, qual_of(cur))
            } else {
              fa = Expr.new(ex_field(), at)
              fa.object = cur
              fa.ident = field.value
              fa.bare_name = field.loc
              cur = fa
            }
          } else if misplaced_literal_ahead(field.value) {
            cur = parse_misplaced_literal(field, qual_of(cur))
          } else {
            fa = Expr.new(ex_field(), at)
            fa.object = cur
            fa.ident = field.value
            fa.bare_name = field.loc
            cur = fa
          }
        }
      } else if k == tk_l_bracket() {
        at = self.bump().loc
        self.skip_newlines()
        if self.current().kind == tk_dot_dot() || self.current().kind == tk_dot_dot_eq() {
          // `xs[..stop]`: a slice from the start.
          zero = Expr.new(ex_int(), at)
          zero.int_bits = 0
          cur = self.parse_slice_rest(cur, at, zero)
        } else {
          idxe = self.parse_expr()
          self.skip_newlines()
          if self.current().kind == tk_dot_dot() || self.current().kind == tk_dot_dot_eq() {
            cur = self.parse_slice_rest(cur, at, idxe)
          } else {
            ix = Expr.new(ex_index(), at)
            // `g[x, y]`: the indexes after the first, for a type's `fn []`.
            while match_tok(tk_comma()) {
              self.skip_newlines()
              ix.elems.push(self.parse_expr())
              self.skip_newlines()
            }
            expect(tk_r_bracket())
            ix.left = cur
            ix.right = idxe
            cur = ix
          }
        }
      } else if k == 50 {
        at = self.bump().loc
        tr = Expr.new(ex_try(), at)
        tr.inner = cur
        cur = tr
      } else if k == tk_l_paren() {
        at = self.current().loc
        args = self.parse_arg_list()
        call = Expr.new(ex_call(), at)
        call.indirect = true
        call.inner = cur
        call.args = args
        take_arg_names(call)
        cur = call
      } else {
        keep = false
      }
      if !keep {
        if left_peak > self.peak {
          self.peak = left_peak
        }
      } else if !nest_step(self.current().loc, left_peak) {
        keep = false
      }
    }
    cur
  }

  pub fn parse_prefix: Expr {
    self.skip_newlines()
    tok = self.current()
    k = tok.kind
    if k == tk_integer() {
      self.bump()
      ok = parse_int_tok(tok)
      e = Expr.new(ex_int(), tok.loc)
      e.int_bits = self.int_bits
      e.int_suffix = self.int_suffix
      return e
    }
    if k == tk_float() {
      self.bump()
      e = Expr.new(ex_float(), tok.loc)
      e.float_val = float_lit(tok)
      e.value_str = tok.value
      return e
    }
    if k == tk_string() {
      self.bump()
      e = Expr.new(ex_string(), tok.loc)
      e.value_str = tok.value
      return e
    }
    if k == tk_interp_open() {
      return self.parse_interpolated_string()
    }
    if self.enum_lit_ahead() {
      // `:write`, an enum's member where an enum is expected.
      self.bump()
      nt = self.bump()
      e = Expr.new(ex_enum_lit(), tok.loc)
      e.ident = nt.value
      return e
    }
    if k == tk_true() {
      self.bump()
      e = Expr.new(ex_bool(), tok.loc)
      e.bool_val = true
      return e
    }
    if k == tk_false() {
      self.bump()
      e = Expr.new(ex_bool(), tok.loc)
      e.bool_val = false
      return e
    }
    if k == tk_nil() {
      self.bump()
      return Expr.new(ex_nil(), tok.loc)
    }
    if k == tk_spawn() {
      return parse_spawn(tok)
    }
    if k == tk_if() {
      // An `if` used as a value: held by a switch node with op tk_if
      // (ast.av); it needs an else.
      st = self.parse_if()
      if st.else_body.size == 0 {
        fail(st.loc, "an if used as a value needs an else, so every case gives one")
      }
      ife = Expr.new(ex_switch(), st.loc)
      ife.op = tk_if()
      ife.has_else = true
      ife.else_body.push(st)
      return ife
    }
    if k == tk_switch() {
      return self.parse_switch()
    }
    if k == tk_l_bracket() {
      return self.parse_array_literal()
    }
    if k == tk_ident() {
      return self.parse_ident_expr()
    }
    if k == tk_pound() {
      sp = self.parse_splice()
      if self.current().kind == tk_l_paren() {
        args = self.parse_arg_list()
        call = Expr.new(ex_call(), sp.loc)
        call.args = args
        take_arg_names(call)
        call.splice = sp
        return call
      }
      return sp
    }
    if k == tk_self() {
      self.bump()
      e = Expr.new(ex_name(), tok.loc)
      e.ident = "self"
      return e
    }
    if k == tk_minus() {
      self.bump()
      self.skip_newlines()
      inner = parse_expr_min(11)
      e = Expr.new(ex_unary(), tok.loc)
      e.op = tk_minus()
      e.inner = inner
      return e
    }
    if k == tk_bang() {
      self.bump()
      self.skip_newlines()
      inner = parse_expr_min(11)
      e = Expr.new(ex_unary(), tok.loc)
      e.op = tk_bang()
      e.inner = inner
      return e
    }
    if k == tk_tilde() {
      self.bump()
      self.skip_newlines()
      inner = parse_expr_min(11)
      e = Expr.new(ex_unary(), tok.loc)
      e.op = tk_tilde()
      e.inner = inner
      return e
    }
    if k == tk_amp() {
      // `&x`: the address of a local, only as a C function's argument
      // (the checker says where it may stand).
      self.bump()
      inner = parse_expr_min(11)
      e = Expr.new(ex_unary(), tok.loc)
      e.op = tk_amp()
      e.inner = inner
      return e
    }
    if k == tk_l_paren() && self.paren_lambda_ahead() {
      return self.parse_paren_lambda()
    }
    if k == tk_l_paren() {
      self.bump()
      self.skip_newlines()
      old = self.allow_struct_lit
      self.allow_struct_lit = true
      expr = maybe_trailing_block(self.parse_expr())
      self.allow_struct_lit = old
      self.skip_newlines()
      expect(tk_r_paren())
      return expr
    }
    if k == tk_l_brace() && self.lambda_ahead() {
      e = Expr.new(ex_lambda(), tok.loc)
      lb = self.parse_trailing_block()
      e.block = lb
      return e
    }
    if k == tk_release() {
      fail(tok.loc, "release is a statement, not a value")
      return dummy_expr(tok.loc)
    }
    if k == tk_plus() && self.at_line_start() {
      fail(tok.loc, "a line cannot start with `+`: a line starting with `+`, `-` or `[` begins a new statement; to continue the line before, end it with the operator (`total = a +` then `b`)")
      return Expr.new(ex_int(), tok.loc)
    }
    fail(tok.loc, "expected an expression, found ${token_name(k)}")
    dummy_expr(tok.loc)
  }

  // Whether the `{` at index i is followed by pipes (line breaks
  // between them skipped).
  pub fn pipes_after_brace(i: Int): Bool {
    j = self.skip_nl_at(i + 1)
    j < self.tokens.size && (self.tokens[j].kind == tk_pipe() || self.tokens[j].kind == tk_pipe_pipe())
  }

  pub fn lambda_ahead: Bool {
    if self.current().kind != tk_l_brace() {
      return false
    }
    for i in self.index + 1..self.tokens.size {
      if self.tokens[i].kind != tk_newline() {
        k = self.tokens[i].kind
        if k == tk_pipe() {
          return true
        }
        if k == tk_pipe_pipe() {
          return true
        }
        return false
      }
    }
    false
  }

  pub fn struct_literal_ahead: Bool {
    if self.current().kind != tk_l_brace() {
      return false
    }
    i = self.index + 1
    while i < self.tokens.size {
      if self.tokens[i].kind != tk_newline() {
        break
      }
      i += 1
    }
    if i >= self.tokens.size {
      return false
    }
    if self.tokens[i].kind == tk_r_brace() {
      return true
    }
    if self.tokens[i].kind != tk_ident() {
      return false
    }
    i += 1
    while i < self.tokens.size {
      if self.tokens[i].kind != tk_newline() {
        break
      }
      i += 1
    }
    if i >= self.tokens.size {
      return false
    }
    self.tokens[i].kind == tk_colon()
  }

  pub fn parse_maybe_type_app(tok: Token, qual: String): Expr? {
    if self.current().kind != tk_l_paren() {
      return nil
    }
    saved_index = self.index
    saved_mark = self.err_count()
    self.bump()
    self.skip_newlines()
    args: Array(TypeName) = []
    if self.current().kind != tk_r_paren() {
      while true {
        args.push(self.parse_type_name())
        if new_err_since(saved_mark) {
          self.index = saved_index
          truncate_errors(saved_mark)
          return nil
        }
        self.skip_newlines()
        if match_tok(tk_comma()) {
          self.skip_newlines()
        } else {
          break
        }
      }
    }
    if self.current().kind != tk_r_paren() {
      self.index = saved_index
      truncate_errors(saved_mark)
      return nil
    }
    self.bump()
    if args.size == 0 {
      self.index = saved_index
      truncate_errors(saved_mark)
      return nil
    }
    ahead = self.look_ahead_non_nl()
    if ahead.kind == tk_dot() {
      e = Expr.new(ex_name(), tok.loc)
      e.ident = tok.value
      e.mod_name = whole_qualifier(qual, tok.loc)
      e.type_args = args
      // The same text is also a call followed by a member when the name is
      // not a type (`get(ty).bits`, `f(job.flags).split(" ")`): only the
      // checker can tell. Keep the arguments read as expressions too (the
      // call reading); the checker drops them when it takes the type.
      after = self.index
      self.index = saved_index
      call_mark = self.err_count()
      exprs = self.parse_arg_list()
      if new_err_since(call_mark) {
        truncate_errors(call_mark)
      } else if self.index == after {
        e.args = exprs
        take_arg_names(e)
      }
      self.arg_names = []
      self.index = after
      return e
    }
    if ahead.kind == tk_l_brace() && self.allow_struct_lit {
      self.skip_newlines()
      if self.struct_literal_ahead() {
        e = parse_struct_literal(tok, qual)
        e.type_args = args
        return e
      }
    }
    self.index = saved_index
    truncate_errors(saved_mark)
    nil
  }

  pub fn parse_ident_expr: Expr {
    tok = self.bump()
    if tok.value == "Array" {
      if self.current().kind == tk_l_paren() {
        return parse_array_new(tok)
      }
    }
    if tok.value == "Hash" {
      if self.current().kind == tk_l_paren() {
        return parse_hash_new(tok)
      }
    }
    if tok.value == "Set" {
      if self.current().kind == tk_l_paren() {
        return parse_set_new(tok)
      }
    }
    if self.current().kind == tk_l_paren() {
      if self.allow_struct_lit && self.lambda_head_at(self.index) >= 0 && !(tok.value[0] >= 65 && tok.value[0] <= 90) {
        return parse_call(tok)
      }
      if app = parse_maybe_type_app(tok, "") {
        return app
      }
      return parse_call(tok)
    }
    if self.allow_struct_lit && self.struct_literal_ahead() {
      return parse_struct_literal(tok, "")
    }
    if misplaced_literal_ahead(tok.value) {
      return parse_misplaced_literal(tok, "")
    }
    e = Expr.new(ex_name(), tok.loc)
    e.ident = tok.value
    e.bare_name = tok.loc
    e
  }

  // `Array(T)`, `Hash(K, V)` or `Set(T)` ending an argument (a `,` or
  // the `)` after it): a type given as an argument, which only
  // json.decode reads (`json.decode(text, Array(Point))`); the checker
  // refuses it anywhere else, as before (`Array(T) only supports .new`).
  pub fn type_argument_end: Bool {
    k = self.current().kind
    k == tk_comma() || k == tk_r_paren()
  }

  pub fn type_as_argument(tok: Token, args: Array(TypeName)): Expr {
    e = Expr.new(ex_name(), tok.loc)
    e.ident = tok.value
    e.type_args = args
    e
  }

  pub fn parse_array_new(tok: Token): Expr {
    expect(tk_l_paren())
    self.skip_newlines()
    elem = self.parse_type_name()
    self.skip_newlines()
    expect(tk_r_paren())
    self.skip_newlines()
    if self.type_argument_end() {
      return self.type_as_argument(tok, [elem])
    }
    expect(tk_dot())
    self.skip_newlines()
    meth = self.take_name_after_dot()
    if meth.value == "new" {
    } else {
      fail(meth.loc, "Array(T) only supports .new")
    }
    expect(tk_l_paren())
    self.skip_newlines()
    size = self.parse_expr()
    self.skip_newlines()
    e = Expr.new(ex_array_new(), tok.loc)
    e.elem_type = elem
    e.size_expr = size
    if match_tok(tk_comma()) {
      self.skip_newlines()
      e.elems.push(self.parse_expr())
      self.skip_newlines()
    }
    expect(tk_r_paren())
    // `Array(T).new(n, (i) { ... })`: a lambda written there builds each
    // element (the call named "Array.new" with the block); an array of n
    // copies of one function
    // value takes it from a name.
    if e.elems.size == 1 && e.elems[0].kind == ex_lambda() {
      if lb = e.elems[0].block, lb.paren {
        call = Expr.new(ex_call(), tok.loc)
        call.callee = "Array.new"
        call.elem_type = elem
        call.args.push(size)
        call.block = lb
        return call
      }
    }
    e
  }

  // `Set(T).new()`: the hash-new node with the element as its key type
  // and no value type, ident "Set".
  pub fn parse_set_new(tok: Token): Expr {
    expect(tk_l_paren())
    self.skip_newlines()
    elem = self.parse_type_name()
    self.skip_newlines()
    expect(tk_r_paren())
    self.skip_newlines()
    if self.type_argument_end() {
      return self.type_as_argument(tok, [elem])
    }
    expect(tk_dot())
    self.skip_newlines()
    meth = self.take_name_after_dot()
    if meth.value != "new" {
      fail(meth.loc, "Set(T) only supports .new")
    }
    bare: Location? = meth.loc
    if self.current().kind == tk_l_paren() {
      self.bump()
      self.skip_newlines()
      expect(tk_r_paren())
      bare = nil
    }
    e = Expr.new(ex_hash_new(), tok.loc)
    e.ident = "Set"
    e.key_type = elem
    e.bare_name = bare
    e
  }

  pub fn parse_hash_new(tok: Token): Expr {
    expect(tk_l_paren())
    self.skip_newlines()
    key = self.parse_type_name()
    self.skip_newlines()
    expect(tk_comma())
    self.skip_newlines()
    val = self.parse_type_name()
    self.skip_newlines()
    expect(tk_r_paren())
    self.skip_newlines()
    if self.type_argument_end() {
      return self.type_as_argument(tok, [key, val])
    }
    expect(tk_dot())
    self.skip_newlines()
    meth = self.take_name_after_dot()
    if meth.value == "new" {
    } else {
      fail(meth.loc, "Hash(K, V) only supports .new")
    }
    bare: Location? = meth.loc
    // `Hash(K, V).new(capacity)`: room for that many entries.
    cap: Expr? = nil
    if self.current().kind == tk_l_paren() {
      self.bump()
      self.skip_newlines()
      if self.current().kind != tk_r_paren() {
        cap = self.parse_expr()
        self.skip_newlines()
      }
      expect(tk_r_paren())
      bare = nil
    }
    e = Expr.new(ex_hash_new(), tok.loc)
    e.size_expr = cap
    e.key_type = key
    e.val_type = val
    e.bare_name = bare
    e
  }

  // A colon and a name written together (`:write`): an enum's member
  // written short.
  pub fn enum_lit_ahead: Bool {
    tok = self.current()
    if tok.kind != tk_colon() || self.index + 1 >= self.tokens.size {
      return false
    }
    nt = self.tokens[self.index + 1]
    nt.kind == tk_ident() && nt.loc.line() == tok.loc.line() && nt.loc.offset() == tok.loc.offset() + 1
  }

  pub fn parse_array_literal: Expr {
    loc = expect(tk_l_bracket()).loc
    self.skip_newlines()
    e = Expr.new(ex_array(), loc)
    // `[:]`: the empty hash literal (`[:read]` is an array of an enum's
    // member written short).
    if self.current().kind == tk_colon() && !self.enum_lit_ahead() {
      self.bump()
      self.skip_newlines()
      expect(tk_r_bracket())
      return Expr.new(ex_hash_lit(), loc)
    }
    // Inside the brackets a struct literal is unambiguous, as inside
    // parentheses, also in a condition or a for operand.
    old = self.allow_struct_lit
    self.allow_struct_lit = true
    if self.current().kind != tk_r_bracket() {
      while true {
        e.elems.push(self.parse_expr())
        self.skip_newlines()
        // `key: value`: the first entry decides a hash literal, and then
        // every entry is one.
        if self.current().kind == tk_colon() {
          if e.elems.size == 1 {
            e.kind = ex_hash_lit()
          }
          if e.kind != ex_hash_lit() {
            fail(self.current().loc, "an array literal's elements are values, not key: value entries (a hash literal has one on every entry)")
          }
          self.bump()
          self.skip_newlines()
          e.elems.push(self.parse_expr())
          self.skip_newlines()
        } else if e.kind == ex_hash_lit() {
          fail(self.current().loc, "a hash literal's entries are each key: value")
        }
        if match_tok(tk_comma()) {
          self.skip_newlines()
          if self.current().kind == tk_r_bracket() {
            break
          }
        } else {
          break
        }
      }
    }
    self.allow_struct_lit = old
    expect(tk_r_bracket())
    e
  }

  pub fn collect_idents(expr: Expr, segs: Array(String)): Bool {
    if expr.kind == ex_name() {
      segs.push(expr.ident)
      return true
    }
    if expr.kind == ex_field() {
      if obj = expr.object, collect_idents(obj, segs) {
        segs.push(expr.ident)
        return true
      }
    }
    false
  }

  pub fn qual_of(expr: Expr): String {
    segs: Array(String) = []
    if collect_idents(expr, segs) {
      buf = Buf.new()
      for i in 0..segs.size {
        if i > 0 {
          buf.push_str(".")
        }
        buf.push_str(segs[i])
      }
      return buf.to_s()
    }
    ""
  }

  pub fn parse_struct_literal(name: Token, qual: String): Expr {
    expect(tk_l_brace())
    self.skip_newlines()
    e = Expr.new(ex_struct(), name.loc)
    e.type_name = name.value
    e.mod_name = whole_qualifier(qual, name.loc)
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      field = expect(tk_ident())
      expect(tk_colon())
      self.skip_newlines()
      value = self.parse_expr()
      e.field_names.push(field.value)
      e.field_exprs.push(value)
      self.skip_newlines()
      if match_tok(tk_comma()) {
        self.skip_newlines()
      } else {
        break
      }
    }
    expect(tk_r_brace())
    e
  }

  pub fn parse_spawn(tok: Token): Expr {
    if self.current().kind != tk_eof() {
      self.bump()
    }
    self.skip_newlines()
    block = self.parse_trailing_block()
    e = Expr.new(ex_call(), tok.loc)
    e.callee = "spawn"
    e.block = block
    e
  }

  pub fn parse_call(name: Token): Expr {
    args = self.parse_call_args(name.value)
    e = Expr.new(ex_call(), name.loc)
    e.callee = name.value
    e.args = args
    take_arg_names(e)
    e
  }

  pub fn parse_interpolated_string: Expr {
    open = expect(tk_interp_open())
    e = Expr.new(ex_interp(), open.loc)
    if open.value.size != 0 {
      p = InterpPart.new()
      p.text = open.value
      e.parts.push(p)
    }
    while true {
      if self.current().kind == tk_interp_close() {
        close = self.bump()
        if close.value.size != 0 {
          p = InterpPart.new()
          p.text = close.value
          e.parts.push(p)
        }
        break
      }
      if self.current().kind == tk_interp_mid() {
        fail(self.current().loc, "expected interpolation expression")
        break
      }
      self.skip_newlines()
      inner = self.parse_expr()
      p = InterpPart.new()
      p.expr = inner
      e.parts.push(p)
      self.skip_newlines()
      if self.current().kind == tk_interp_mid() {
        mid = self.bump()
        if mid.value.size != 0 {
          p2 = InterpPart.new()
          p2.text = mid.value
          e.parts.push(p2)
        }
      } else if self.current().kind == tk_interp_close() {
        continue
      } else {
        fail(self.current().loc, "expected end of interpolation")
        break
      }
    }
    e
  }

  // The arguments of a call to the callee just read, at its `(`: the
  // argument list, or, when the parentheses hold a lambda's parameters
  // followed by its `{` (`xs.each (x) { ... }`), that lambda as the only
  // argument (the shorthand that drops the call's own parentheses). Not
  // directly in the head of an `if`, `while`, `for` or `switch`, where
  // the `{` begins the statement's body, and never for a type's name.
  pub fn parse_call_args(callee: String): Array(Expr) {
    if self.allow_struct_lit && callee.size > 0 && !(callee[0] >= 65 && callee[0] <= 90) && self.lambda_head_at(self.index) >= 0 {
      lam: Array(Expr) = [self.parse_paren_lambda()]
      self.arg_names = []
      return lam
    }
    if !self.allow_struct_lit && callee.size > 0 && !(callee[0] >= 65 && callee[0] <= 90) {
      if shown = self.head_shorthand_at(self.index) {
        // `if xs.any (x) { x > 2 } {`: in a statement's head the `{`
        // begins the body, so the shorthand cannot stand there. Said at
        // the call, and the lambda read as the call's one argument so the
        // rest of the statement parses as written.
        fail(self.current().loc, "a lambda in ${self.lit_place} goes inside the call's parentheses: write ${callee}((${shown}) { ... })")
        self.allow_struct_lit = true
        lam2: Array(Expr) = [self.parse_paren_lambda()]
        self.allow_struct_lit = false
        self.arg_names = []
        return lam2
      }
    }
    self.parse_arg_list()
  }

  // In a statement's head, whether the `(` at index i0 begins the lambda
  // shorthand: a lambda's parameter list and body, closed on its line and
  // followed there by more of the head (the body's `{`, an operator), not
  // by what may follow a statement's body (the end of the line, `else`, a
  // closing bracket: a call with arguments, then the body). The parameter list as written, for the message
  // (`x`, `a, b`, or `...` for a typed one); nil when it is not one.
  pub fn head_shorthand_at(i0: Int): String? {
    brace = self.lambda_head_at(i0)
    if brace < 0 {
      return nil
    }
    n = self.tokens.size
    level = 0
    i = brace
    while i < n {
      k = self.tokens[i].kind
      if k == tk_l_brace() {
        level += 1
      } else if k == tk_r_brace() {
        level -= 1
        if level == 0 {
          break
        }
      }
      i += 1
    }
    if i + 1 >= n {
      return nil
    }
    after = self.tokens[i + 1].kind
    if after == tk_newline() || after == tk_else() || after == tk_eof() || after == tk_r_brace() || after == tk_r_paren() || after == tk_r_bracket() || after == tk_comma() {
      return nil
    }
    b = Buf.new()
    j = i0 + 1
    while j < n && self.tokens[j].kind != tk_r_paren() {
      t = self.tokens[j]
      if t.kind == tk_ident() {
        b.push_str(t.value)
      } else if t.kind == tk_comma() {
        b.push_str(", ")
      } else if t.kind != tk_newline() {
        return "..."
      }
      j += 1
    }
    b.to_s()
  }

  // Whether the `(` at the current token begins a lambda: a parameter
  // list, a result type maybe, and the body's `{` on the same line. One
  // bare name in parentheses is an expression when the `{` after it
  // begins a statement's body (a head's operand: `if (ok) { ... }`).
  pub fn paren_lambda_ahead: Bool {
    brace = self.lambda_head_at(self.index)
    if brace < 0 {
      return false
    }
    if !self.allow_struct_lit && brace == self.index + 3 {
      return false
    }
    true
  }

  // The index of the `{` of a lambda whose parameter list opens at the
  // `(` at index i, or -1: `()`, names with or without `: Type`, then an
  // optional `: Result`, then `{` on the line the list ends on, not
  // followed by pipes (`f(a) { |x| ... }`, a block in pipes, refused).
  // Syntactic only: () and a list of two or more names are not
  // expressions (there are no tuples), a typed list is not either, and
  // for one bare name the `{` decides.
  pub fn lambda_head_at(i0: Int): Int {
    n = self.tokens.size
    i = i0
    if i >= n || self.tokens[i].kind != tk_l_paren() {
      return -1
    }
    i = self.skip_nl_at(i + 1)
    if i < n && self.tokens[i].kind != tk_r_paren() {
      while true {
        if i >= n || self.tokens[i].kind != tk_ident() {
          return -1
        }
        i = self.skip_nl_at(i + 1)
        if i < n && self.tokens[i].kind == tk_colon() {
          i = self.skip_type_at(i + 1, false)
          if i < 0 {
            return -1
          }
          i = self.skip_nl_at(i)
        }
        if i < n && self.tokens[i].kind == tk_comma() {
          i = self.skip_nl_at(i + 1)
        } else {
          break
        }
      }
    }
    if i >= n || self.tokens[i].kind != tk_r_paren() {
      return -1
    }
    i += 1
    if i < n && self.tokens[i].kind == tk_colon() {
      i = self.skip_type_at(i + 1, true)
      if i < 0 {
        return -1
      }
    }
    if i >= n || self.tokens[i].kind != tk_l_brace() {
      return -1
    }
    j = self.skip_nl_at(i + 1)
    if j < n && (self.tokens[j].kind == tk_pipe() || self.tokens[j].kind == tk_pipe_pipe()) {
      return -1
    }
    i
  }

  pub fn skip_nl_at(i0: Int): Int {
    i = i0
    while i < self.tokens.size && self.tokens[i].kind == tk_newline() {
      i += 1
    }
    i
  }

  // The index after the type that starts at i0 (a parameter's, up to the
  // `,` or `)` at its own depth; a result's, up to the `{` on its line),
  // or -1 when the tokens cannot be a type.
  pub fn skip_type_at(i0: Int, result: Bool): Int {
    n = self.tokens.size
    i = i0
    if !result {
      i = self.skip_nl_at(i)
    }
    dep = 0
    start = i
    while i < n {
      k = self.tokens[i].kind
      if k == tk_l_paren() || k == tk_l_bracket() {
        dep += 1
      } else if k == tk_r_paren() || k == tk_r_bracket() {
        if dep == 0 {
          if result || k == tk_r_bracket() || i == start {
            return -1
          }
          return i
        }
        dep -= 1
      } else if k == tk_comma() && dep == 0 {
        if result || i == start {
          return -1
        }
        return i
      } else if k == tk_l_brace() {
        if result && dep == 0 && i > start {
          return i
        }
        return -1
      } else if k == tk_newline() {
        if result && dep == 0 {
          return -1
        }
      } else if k == tk_r_brace() || k == tk_eq() || k == tk_eof() {
        return -1
      }
      i += 1
    }
    -1
  }

  // `(a, b) { ... }`, `(x: Int): Int { ... }`, `() { ... }`: a lambda,
  // a function without a name (its parameters with the grammar of a
  // function's, a union type written plainly).
  pub fn parse_paren_lambda: Expr {
    if !nest_enter(self.current().loc) {
      return dummy_expr(self.current().loc)
    }
    open = expect(tk_l_paren())
    block = Block.new(open.loc)
    block.paren = true
    self.skip_newlines()
    if self.current().kind != tk_r_paren() {
      while true {
        name = expect(tk_ident())
        block.params.push(name.value)
        ann = TypeName.new(name.loc, "")
        self.skip_newlines()
        if self.current().kind == tk_colon() {
          self.bump()
          self.skip_newlines()
          ann = self.parse_type_name()
          self.skip_newlines()
        }
        block.param_types.push(ann)
        if match_tok(tk_comma()) {
          self.skip_newlines()
        } else {
          break
        }
      }
    }
    expect(tk_r_paren())
    if self.current().kind == tk_colon() {
      self.bump()
      block.ret_type = self.parse_type_name()
    }
    expect(tk_l_brace())
    self.parse_block_rest(block)
    nest_leave()
    e = Expr.new(ex_lambda(), open.loc)
    e.block = block
    e
  }

  pub fn parse_trailing_block: Block {
    if !nest_enter(self.current().loc) {
      return Block.new(self.current().loc)
    }
    loc = expect(tk_l_brace()).loc
    self.skip_newlines()
    block = Block.new(loc)
    if self.current().kind == tk_pipe() || self.current().kind == tk_pipe_pipe() {
      fail(loc, pipes_message())
    }
    if self.current().kind == tk_pipe_pipe() {
      self.bump()
      self.skip_newlines()
    } else if self.current().kind == tk_pipe() {
      self.bump()
      self.skip_newlines()
      if self.current().kind != tk_pipe() {
        while true {
          name = expect(tk_ident())
          block.params.push(name.value)
          ann = TypeName.new(name.loc, "")
          if self.current().kind == tk_colon() {
            self.bump()
            self.skip_newlines()
            // A following | closes the parameter list. Union types use the
            // same token, so a lambda parameter type stops before that pipe.
            ann = self.parse_nilable_type()
          }
          block.param_types.push(ann)
          self.skip_newlines()
          if match_tok(tk_comma()) {
            self.skip_newlines()
          } else {
            break
          }
        }
      }
      expect(tk_pipe())
      self.skip_newlines()
    }
    self.parse_block_rest(block)
    nest_leave()
    block
  }

  // A block's statements after its `{` (and its parameters), through
  // the closing `}`.
  pub fn parse_block_rest(block: Block) {
    self.skip_newlines()
    while true {
      if self.current().kind == tk_r_brace() {
        break
      }
      if self.current().kind == tk_eof() {
        break
      }
      mark = self.err_count()
      start_idx = self.index
      block.body.push(self.parse_lead_stmt())
      if new_err_since(mark) {
        self.sync_stmt()
        if self.index == start_idx && self.current().kind != tk_eof() && self.current().kind != tk_r_brace() {
          self.bump()
        }
      }
      self.skip_newlines()
    }
    lead_check(block.body)
    expect(tk_r_brace())
  }

  pub fn parse_arg_list: Array(Expr) {
    expect(tk_l_paren())
    self.skip_newlines()
    args: Array(Expr) = []
    names: Array(String) = []
    named = false
    // A struct literal is unambiguous inside the parentheses, also in a
    // condition or a for operand.
    old = self.allow_struct_lit
    self.allow_struct_lit = true
    if self.current().kind != tk_r_paren() {
      while true {
        // A named argument, `loops: 4`: a name and a colon, which no
        // expression starts with. Names follow the positional arguments.
        name = ""
        if self.current().kind == tk_ident() && self.index + 1 < self.tokens.size && self.tokens[self.index + 1].kind == tk_colon() {
          name = self.bump().value
          self.bump()
          self.skip_newlines()
          named = true
        } else if named {
          fail(self.current().loc, "a positional argument cannot follow a named one: write the positional arguments first")
        }
        args.push(maybe_trailing_block(self.parse_expr()))
        names.push(name)
        self.skip_newlines()
        if match_tok(tk_comma()) {
          self.skip_newlines()
        } else {
          break
        }
      }
    }
    self.allow_struct_lit = old
    expect(tk_r_paren())
    if named {
      self.arg_names = names
    } else {
      self.arg_names = []
    }
    args
  }

  // The call gets the names of the argument list just read (Expr.field_names,
  // parallel to its arguments, when one is named).
  pub fn take_arg_names(call: Expr) {
    if self.arg_names.size > 0 {
      call.field_names = self.arg_names
      self.arg_names = []
    }
  }
}

// What the interpolation of an error prints (`"${e}"`): a method the
// parser adds to a type marked `Error`, reading its message (a field or a
// method; the checker requires one, checker/lambda.av mark_error). With a
// field `cause`, its own text follows after ": " when it is there:
// `"${message}: ${cause}"`, so a chain prints outermost first (`cannot
// load config: bad json: unexpected end`).
pub fn error_text_method(loc: Location, owner: String, fields: Array(Field)): Function {
  fnn = Function.new(loc, "__avant_error_text")
  fnn.owner = owner
  fnn.vis = true
  fnn.return_type = TypeName.new(loc, "String")
  cause: Field? = nil
  for f in fields {
    if f.name == "cause" {
      cause = f
    }
  }
  if cf = cause {
    optional = cf.type.nilable
    for m in cf.type.members {
      if m.name == "Nil" {
        optional = true
      }
    }
    if optional {
      // if c = self.cause { return "${self.message}: ${c}" }
      c = Expr.new(ex_name(), loc)
      c.ident = "__avant_cause"
      ret = stmt_return(loc, error_chain_text(loc, c))
      st = Stmt.new(st_if(), loc)
      st.bind = "__avant_cause"
      st.cond = error_self_field(loc, "cause")
      st.then_body.push(ret)
      fnn.body.push(st)
    } else {
      fnn.body.push(stmt_expr(loc, error_chain_text(loc, error_self_field(loc, "cause"))))
      return fnn
    }
  }
  fnn.body.push(stmt_expr(loc, error_self_field(loc, "message")))
  fnn
}

// "${self.message}: ${c}"
pub fn error_chain_text(loc: Location, c: Expr): Expr {
  e = Expr.new(ex_interp(), loc)
  p1 = InterpPart.new()
  p1.expr = error_self_field(loc, "message")
  p2 = InterpPart.new()
  p2.text = ": "
  p3 = InterpPart.new()
  p3.expr = c
  e.parts.push(p1)
  e.parts.push(p2)
  e.parts.push(p3)
  e
}

pub fn error_self_field(loc: Location, name: String): Expr {
  me = Expr.new(ex_name(), loc)
  me.ident = "self"
  fa = Expr.new(ex_field(), loc)
  fa.object = me
  fa.ident = name
  fa
}

// The step of a range `for` (`for i in a..b by k`), as its body is
// walked: `last` is the inclusive range's end ("" for `..`), `by` the
// step's size, `down` a step down (`by -k`), whose values are those of
// `by k` in reverse, ending at `lo`, the range's start.
pub class RangeStep {
  pub last: String = ""
  pub by: UInt64 = 1
  pub down: Bool = false
  pub lo: String = ""
}

pub fn range_name(loc: Location, name: String): Expr {
  e = Expr.new(ex_name(), loc)
  e.ident = name
  e
}

pub fn range_int(loc: Location, bits: UInt64): Expr {
  e = Expr.new(ex_int(), loc)
  e.int_bits = bits
  e
}

pub fn range_binary(loc: Location, op: Int, left: Expr, right: Expr): Expr {
  e = Expr.new(ex_binary(), loc)
  e.op = op
  e.left = left
  e.right = right
  e
}

pub fn range_call0(loc: Location, recv: Expr, name: String): Expr {
  e = Expr.new(ex_call(), loc)
  e.callee = name
  e.receiver = recv
  e
}

pub fn range_assign(loc: Location, name: String, value: Expr): Stmt {
  s = Stmt.new(st_assign(), loc)
  s.target = range_name(loc, name)
  s.value = value
  s.op = tk_eq()
  s.for_kind = 3
  s
}

// The step of a `for` loop to its next value: the counter's increment;
// over an inclusive range (`a..=b`), a break after the last value
// first, so a range that ends at the type's maximum never computes the
// value after it (the increment would overflow and trap).
// With a step `by k` (k above 1), the break comes when fewer than k
// values are left before the end (`end - i < k`), which never
// overflows either: i is at most the end.
// A step down breaks at the range's start (`i == lo`), or when fewer
// than k values are left above it (`(i &- lo)` read as a UInt64, below
// k: the distance is exact even beyond Int's range), and then
// subtracts k, which never goes below the start.
pub fn range_step_into(rs: RangeStep, loc: Location, counter: String, into: Array(Stmt)) {
  if rs.down {
    stop0 = Stmt.new(st_if(), loc)
    if rs.by == 1 {
      stop0.cond = range_binary(loc, tk_eq_eq(), range_name(loc, counter), range_name(loc, rs.lo))
    } else {
      dist = range_call0(loc, range_binary(loc, tk_amp_minus(), range_name(loc, counter), range_name(loc, rs.lo)), "wrap_u64")
      stop0.cond = range_binary(loc, tk_less(), dist, range_int(loc, rs.by))
    }
    stop0.then_body.push(Stmt.new(st_break(), loc))
    into.push(stop0)
    dec = range_assign(loc, counter, range_binary(loc, tk_minus(), range_name(loc, counter), range_int(loc, rs.by)))
    dec.step = true
    into.push(dec)
    return
  }
  if rs.last.size > 0 {
    stop = Stmt.new(st_if(), loc)
    if rs.by == 1 {
      stop.cond = range_binary(loc, tk_eq_eq(), range_name(loc, counter), range_name(loc, rs.last))
    } else {
      left = range_binary(loc, tk_minus(), range_name(loc, rs.last), range_name(loc, counter))
      stop.cond = range_binary(loc, tk_less(), left, range_int(loc, rs.by))
    }
    stop.then_body.push(Stmt.new(st_break(), loc))
    into.push(stop)
  }
  inc = range_assign(loc, counter, range_binary(loc, tk_plus(), range_name(loc, counter), range_int(loc, rs.by)))
  inc.step = true
  into.push(inc)
}

pub fn range_advance(rs: RangeStep, body: Array(Stmt), counter: String, loc: Location): Array(Stmt) {
  out: Array(Stmt) = []
  for s in body {
    if s.kind == st_continue() {
      range_step_into(rs, loc, counter, out)
      out.push(s)
    } else if s.kind == st_while() {
      // A nested loop's `continue` is its own.
      out.push(s)
    } else {
      if s.kind == st_if() {
        s.then_body = range_advance(rs, s.then_body, counter, loc)
        s.else_body = range_advance(rs, s.else_body, counter, loc)
        for el in s.pre {
          range_advance_opt(rs, el.cond, counter, loc)
        }
      }
      if s.kind == st_pin() || s.kind == st_hold() {
        s.body = range_advance(rs, s.body, counter, loc)
      }
      range_advance_opt(rs, s.expr, counter, loc)
      range_advance_opt(rs, s.value, counter, loc)
      range_advance_opt(rs, s.target, counter, loc)
      range_advance_opt(rs, s.cond, counter, loc)
      out.push(s)
    }
  }
  out
}

// The statements an expression holds (a switch's arms; `?? continue`
// and an `if` used as a value), outside lambdas.
pub fn range_advance_opt(rs: RangeStep, e: Expr?, counter: String, loc: Location) {
  if x = e {
    range_advance_expr(rs, x, counter, loc)
  }
}

pub fn range_advance_expr(rs: RangeStep, e: Expr, counter: String, loc: Location) {
  if e.kind == ex_lambda() {
    return
  }
  if e.kind == ex_switch() {
    for ci in 0..e.cases.size {
      e.cases[ci].body = range_advance(rs, e.cases[ci].body, counter, loc)
    }
    e.else_body = range_advance(rs, e.else_body, counter, loc)
  }
  range_advance_opt(rs, e.left, counter, loc)
  range_advance_opt(rs, e.right, counter, loc)
  range_advance_opt(rs, e.object, counter, loc)
  range_advance_opt(rs, e.cond, counter, loc)
  range_advance_opt(rs, e.receiver, counter, loc)
  range_advance_opt(rs, e.inner, counter, loc)
  for a in e.args {
    range_advance_expr(rs, a, counter, loc)
  }
  for x in e.elems {
    range_advance_expr(rs, x, counter, loc)
  }
  for f in e.field_exprs {
    range_advance_expr(rs, f, counter, loc)
  }
  // A `Mutex.with` block runs in place, and its `continue` is the
  // enclosing loop's; a builtin's block (`each`) is a loop of its own,
  // like a nested while.
  if e.callee == "with" || e.callee == "try_with" {
    if b = e.block {
      b.body = range_advance(rs, b.body, counter, loc)
    }
  }
}

// A range `for`'s `by`, as parsed: a literal's size and sign, or the
// constant it names (`named`), whose value the checker reads.
pub class RangeBy {
  pub by: UInt64 = 1
  pub down: Bool = false
  pub named: Expr? = nil
}

pub fn range_kind_pending: Int { 10 }

// A range `for` with a step down (`by -k`) or a constant step (`by
// step`). A step named by a constant is a loop of for_kind 10 until the
// checker knows its value (range_resolve): its set-up stores, the body
// as written, the step in `expr` (negated for `by -step`) and the
// range's form in `op`. A literal step down is built at once: the
// values of `by k` in reverse, from the last one inside the range down
// to its start, which is always visited (a non-empty range). The first
// value is computed only for a range that is not empty, so an empty one
// computes nothing that traps; the loop runs while the range is not
// empty and leaves by its step's break at the start.
pub fn range_loop(loc: Location, var: String, first: Expr, end_expr: Expr, end_name: String, incl: Bool, rb: RangeBy, raw_body: Array(Stmt), latched: Bool): Stmt {
  s = Stmt.new(st_while(), loc)
  s.pre.push(range_assign(loc, var, first))
  s.pre.push(range_assign(loc, end_name, end_expr))
  if named = rb.named {
    s.for_kind = range_kind_pending()
    step = named
    if rb.down {
      step = Expr.new(ex_unary(), named.loc)
      step.op = tk_minus()
      step.inner = named
    }
    s.expr = step
    s.op = if incl { tk_dot_dot_eq() } else { tk_dot_dot() }
    yes = Expr.new(ex_bool(), loc)
    yes.bool_val = true
    s.cond = yes
    s.body = raw_body
    // A body with a defer takes its step as a latch (below); 1 marks it
    // until the step is built.
    s.latch = if latched { 1 } else { 0 }
    return s
  }
  range_build(s, loc, var, end_name, incl, rb.by, rb.down, raw_body, latched)
  s
}

// Fills s (a range loop with its two set-up stores) with the loop of
// step `by` (down when `down`): the same loop the parser builds for a
// literal step.
// A body with a defer (latched) keeps its `continue`s as written: the
// step is the body's last statements, its latch, where `continue` goes
// after the body's deferred blocks have run.
pub fn range_build(s: Stmt, loc: Location, var: String, end_name: String, incl: Bool, by: UInt64, down: Bool, raw_body: Array(Stmt), latched: Bool) {
  s.for_kind = 1
  s.expr = nil
  s.op = 0
  s.latch = 0
  rs = RangeStep.new()
  rs.by = by
  op = if incl { tk_less_eq() } else { tk_less() }
  if !down {
    if incl {
      rs.last = end_name
    }
    s.cond = range_binary(loc, op, range_name(loc, var), range_name(loc, end_name))
    range_body(s, rs, raw_body, var, loc, latched)
    return
  }
  lo_name = "${end_name}_lo"
  rs.down = true
  rs.lo = lo_name
  s.pre.push(range_assign(loc, lo_name, range_name(loc, var)))
  // The first value, set only when the range is not empty (so `end -
  // 1` never goes below Int's least value): the top, the end itself
  // (`..=`) or the value before it (`..`), lowered to the last value of
  // the walk up from the start; the distance from the start is read as
  // a UInt64, exact even beyond Int's range, and what is taken off it
  // is less than the step, so the value is never below the start.
  top = range_name(loc, end_name)
  if !incl {
    top = range_binary(loc, tk_minus(), range_name(loc, end_name), range_int(loc, 1))
  }
  start = top
  if by != 1 {
    top2 = range_name(loc, end_name)
    if !incl {
      top2 = range_binary(loc, tk_minus(), range_name(loc, end_name), range_int(loc, 1))
    }
    dist = range_call0(loc, range_binary(loc, tk_amp_minus(), top2, range_name(loc, lo_name)), "wrap_u64")
    extra = range_call0(loc, range_binary(loc, tk_percent(), dist, range_int(loc, by)), "wrap_i")
    start = range_binary(loc, tk_minus(), top, extra)
  }
  first_set = Stmt.new(st_if(), loc)
  first_set.cond = range_binary(loc, op, range_name(loc, lo_name), range_name(loc, end_name))
  first_set.then_body.push(range_assign(loc, var, start))
  s.pre.push(first_set)
  s.cond = range_binary(loc, op, range_name(loc, lo_name), range_name(loc, end_name))
  range_body(s, rs, raw_body, var, loc, latched)
}

pub fn range_body(s: Stmt, rs: RangeStep, raw_body: Array(Stmt), var: String, loc: Location, latched: Bool) {
  if latched {
    s.body = raw_body
    n = s.body.size
    range_step_into(rs, loc, var, s.body)
    s.latch = s.body.size - n
    return
  }
  s.body = range_advance(rs, raw_body, var, loc)
  range_step_into(rs, loc, var, s.body)
}

// The refusal of a block in pipes (`{ |x| ... }`, `{ || ... }`).
pub fn pipes_message: String {
  "a block in pipes is not Avant: write a lambda in parentheses, `(x) { ... }` (`xs.each((x) { ... })`, or `xs.each (x) { ... }` when it is the call's only argument); a block that leaves its function with `return`, `break` or `?` is a `for` loop (`for x in xs { ... }`)"
}

// The refusal of a block written after a call (`f(a) { ... }`,
// `t.group { ... }`).
pub fn block_after_call_message: String {
  "a block after a call is not an argument: pass a lambda in parentheses, `f(a, (x) { ... })`, or `f (x) { ... }` when it is the call's only argument; a block that leaves its function with `return`, `break` or `?` is a `for` loop"
}
