import location
import diagnostic
import source
import token
import lexer
import std.process

pub class FormatResult {
  pub ok: Bool = false
  pub text: String = ""
  pub err: String = ""

  fn initialize(ok: Bool, text: String, err: String) {
    self.ok = ok
    self.text = text
    self.err = err
  }
}

pub fn token_text(t: Token): String {
  k = t.kind
  if k == tk_ident() {
    return t.value
  }
  if k == tk_integer() {
    return t.value
  }
  if k == tk_float() {
    return t.value
  }
  if k == tk_string() {
    return t.value
  }
  if k == tk_comment() {
    return t.value
  }
  if k == tk_file_line() {
    return t.value
  }
  if k == tk_interp_open() {
    return t.value
  }
  if k == tk_interp_mid() {
    return t.value
  }
  if k == tk_interp_close() {
    return t.value
  }
  if k == tk_fn() {
    return "fn"
  }
  if k == tk_if() {
    return "if"
  }
  if k == tk_else() {
    return "else"
  }
  if k == tk_return() {
    return "return"
  }
  if k == tk_struct() {
    return "struct"
  }
  if k == tk_class() {
    return "class"
  }
  if k == tk_lib() {
    return "lib"
  }
  if k == tk_fun() {
    return "fun"
  }
  if k == tk_self() {
    return "self"
  }
  if k == tk_while() {
    return "while"
  }
  if k == tk_true() {
    return "true"
  }
  if k == tk_false() {
    return "false"
  }
  if k == tk_nil() {
    return "nil"
  }
  if k == tk_spawn() {
    return "spawn"
  }
  if k == tk_break() {
    return "break"
  }
  if k == tk_continue() {
    return "continue"
  }
  if k == tk_switch() {
    return "switch"
  }
  if k == tk_case() {
    return "case"
  }
  if k == tk_import() {
    return "import"
  }
  if k == tk_pub() {
    return "pub"
  }
  if k == tk_quote() {
    return "quote"
  }
  if k == tk_comptime() {
    return "comptime"
  }
  if k == tk_interface() {
    return "interface"
  }
  if k == tk_plus_eq() {
    return "+="
  }
  if k == tk_minus_eq() {
    return "-="
  }
  if k == tk_star_eq() {
    return "*="
  }
  if k == tk_slash_eq() {
    return "/="
  }
  ct = compound_text(k)
  if ct.size > 0 {
    return ct
  }
  if k == tk_l_brace() {
    return "{"
  }
  if k == tk_r_brace() {
    return "}"
  }
  if k == tk_l_paren() {
    return "("
  }
  if k == tk_r_paren() {
    return ")"
  }
  if k == tk_l_bracket() {
    return "["
  }
  if k == tk_r_bracket() {
    return "]"
  }
  if k == tk_comma() {
    return ","
  }
  if k == tk_colon() {
    return ":"
  }
  if k == tk_dot() {
    return "."
  }
  if k == tk_plus() {
    return "+"
  }
  if k == tk_minus() {
    return "-"
  }
  if k == tk_star() {
    return "*"
  }
  if k == tk_slash() {
    return "/"
  }
  if k == tk_percent() {
    return "%"
  }
  if k == tk_eq() {
    return "="
  }
  if k == tk_eq_eq() {
    return "=="
  }
  if k == tk_not_eq() {
    return "!="
  }
  if k == tk_less() {
    return "<"
  }
  if k == tk_less_eq() {
    return "<="
  }
  if k == tk_greater() {
    return ">"
  }
  if k == tk_greater_eq() {
    return ">="
  }
  if k == tk_bang() {
    return "!"
  }
  if k == tk_question() {
    return "?"
  }
  if k == tk_question_question() {
    return "??"
  }
  if k == tk_dot_dot() {
    return ".."
  }
  if k == tk_dot_dot_eq() {
    return "..="
  }
  if k == tk_for() {
    return "for"
  }
  if k == tk_in() {
    return "in"
  }
  if k == tk_pin() {
    return "pin"
  }
  if k == tk_release() {
    return "release"
  }
  if k == tk_enum() {
    return "enum"
  }
  if k == tk_const() {
    return "const"
  }
  if k == tk_defer() {
    return "defer"
  }
  if k == tk_pipe() {
    return "|"
  }
  if k == tk_pipe_pipe() {
    return "||"
  }
  if k == tk_amp() {
    return "&"
  }
  if k == tk_amp_amp() {
    return "&&"
  }
  if k == tk_amp_plus() {
    return "&+"
  }
  if k == tk_amp_minus() {
    return "&-"
  }
  if k == tk_amp_star() {
    return "&*"
  }
  if k == tk_caret() {
    return "^"
  }
  if k == tk_tilde() {
    return "~"
  }
  if k == tk_less_less() {
    return "<<"
  }
  if k == tk_greater_greater() {
    return ">>"
  }
  if k == tk_pound() {
    return "#"
  }
  ""
}

pub fn push_token(buf: Buf, t: Token) {
  k = t.kind
  if k == tk_interp_mid() {
    buf.push_byte(125)
  } else if k == tk_interp_close() {
    buf.push_byte(125)
  }
  buf.push_str(token_text(t))
}

pub fn tight_before(k: Int): Bool {
  if k == tk_dot_dot() || k == tk_dot_dot_eq() {
    return true
  }
  if k == tk_colon() {
    return true
  }
  if k == tk_comma() {
    return true
  }
  if k == tk_l_paren() {
    return true
  }
  if k == tk_dot() {
    return true
  }
  if k == tk_question() {
    return true
  }
  if k == tk_r_paren() {
    return true
  }
  if k == tk_r_bracket() {
    return true
  }
  if k == tk_interp_mid() {
    return true
  }
  k == tk_interp_close()
}

pub fn tight_after_kind(k: Int): Bool {
  if k == tk_dot_dot() || k == tk_dot_dot_eq() {
    return true
  }
  if k == tk_l_paren() {
    return true
  }
  if k == tk_l_bracket() {
    return true
  }
  if k == tk_dot() {
    return true
  }
  if k == tk_pound() {
    return true
  }
  if k == tk_bang() {
    return true
  }
  if k == tk_tilde() {
    return true
  }
  if k == tk_interp_open() {
    return true
  }
  k == tk_interp_mid()
}

pub fn value_end(k: Int): Bool {
  if k == tk_ident() {
    return true
  }
  if k == tk_integer() {
    return true
  }
  if k == tk_float() {
    return true
  }
  if k == tk_string() {
    return true
  }
  if k == tk_true() {
    return true
  }
  if k == tk_false() {
    return true
  }
  if k == tk_nil() {
    return true
  }
  if k == tk_self() {
    return true
  }
  if k == tk_r_paren() {
    return true
  }
  if k == tk_r_bracket() {
    return true
  }
  if k == tk_r_brace() {
    return true
  }
  if k == tk_question() {
    return true
  }
  k == tk_interp_close()
}

pub fn minus_is_prefix(prev: Int, at_start: Bool): Bool {
  if at_start {
    return true
  }
  if prev < 0 {
    return true
  }
  if prev == tk_newline() {
    return true
  }
  if value_end(prev) {
    return false
  }
  true
}

pub fn next_significant(tokens: Array(Token), i: Int): Int {
  for j in i + 1..tokens.size {
    k = tokens[j].kind
    if k == tk_newline() {
    } else if k == tk_comment() {
    } else if k != tk_file_line() {
      return k
    }
  }
  tk_eof()
}

// Whether the `(` at i begins the shorthand call `callee (params) {`:
// after a function's name (not a type's), a lambda's parameter list,
// maybe its result type, then `{` on the same line. Set off by the caller in the head of an `if`, `while`, `for`
// or `switch` (reprint's head_depth), where the parser reads a call.
pub fn shorthand_at(tokens: Array(Token), i: Int): Bool {
  p = prev_significant(tokens, i)
  if p < 0 || tokens[p].kind != tk_ident() {
    return false
  }
  name = tokens[p].value
  if name.size == 0 || (name[0] >= 65 && name[0] <= 90) {
    return false
  }
  // A declaration's parameters (`fn (c: Counter) scaled(s: Float64)`):
  // a line that starts with `fn`, `pub` or `fun`.
  j = p
  while j > 0 && tokens[j - 1].kind != tk_newline() && tokens[j - 1].kind != tk_file_line() {
    j -= 1
  }
  while j < p && tokens[j].kind == tk_comment() {
    j += 1
  }
  first = tokens[j].kind
  if first == tk_fn() || first == tk_pub() || first == tk_fun() {
    return false
  }
  lambda_head_brace(tokens, i) >= 0
}

// The index of the `{` of a lambda whose parameter list opens at the
// `(` at i, or -1 (the parser's lambda_head_at over the formatter's
// tokens, comments skipped).
pub fn lambda_head_brace(tokens: Array(Token), i0: Int): Int {
  n = tokens.size
  i = fmt_skip(tokens, i0 + 1, true)
  if i < n && tokens[i].kind != tk_r_paren() {
    while true {
      if i >= n || tokens[i].kind != tk_ident() {
        return -1
      }
      i = fmt_skip(tokens, i + 1, true)
      if i < n && tokens[i].kind == tk_colon() {
        depth = 0
        i = fmt_skip(tokens, i + 1, true)
        start = i
        while i < n {
          k = tokens[i].kind
          if k == tk_l_paren() || k == tk_l_bracket() {
            depth += 1
          } else if (k == tk_r_paren() || k == tk_comma()) && depth == 0 {
            break
          } else if k == tk_r_paren() || k == tk_r_bracket() {
            depth -= 1
          } else if k == tk_l_brace() || k == tk_r_brace() || k == tk_eq() || k == tk_eof() {
            return -1
          }
          i += 1
        }
        if i == start {
          return -1
        }
      }
      if i < n && tokens[i].kind == tk_comma() {
        i = fmt_skip(tokens, i + 1, true)
      } else {
        break
      }
    }
  }
  if i >= n || tokens[i].kind != tk_r_paren() {
    return -1
  }
  i = fmt_skip(tokens, i + 1, false)
  if i < n && tokens[i].kind == tk_colon() {
    i += 1
    while i < n && tokens[i].kind != tk_l_brace() {
      k = tokens[i].kind
      if k == tk_newline() || k == tk_r_brace() || k == tk_eq() || k == tk_eof() {
        return -1
      }
      i += 1
    }
  }
  if i >= n || tokens[i].kind != tk_l_brace() {
    return -1
  }
  i
}

// The next index from i that is not a comment (nor a line break when
// lines is true).
pub fn fmt_skip(tokens: Array(Token), i0: Int, lines: Bool): Int {
  i = i0
  while i < tokens.size {
    k = tokens[i].kind
    if k == tk_comment() || (lines && k == tk_newline()) {
      i += 1
    } else {
      return i
    }
  }
  i
}

pub fn must_separate(prev: Int, prev2: Int, curr: Int, nextk: Int): Bool {
  if prev == tk_bang() && curr == tk_eq() {
    return true
  }
  if prev == tk_minus() && curr == tk_eq() {
    return true
  }
  if prev == tk_dot() {
    if curr == tk_integer() {
      if prev2 == tk_integer() {
        return true
      }
      if prev2 == tk_float() {
        return true
      }
    }
    if curr == tk_float() {
      if prev2 == tk_integer() {
        return true
      }
      if prev2 == tk_float() {
        return true
      }
    }
  }
  if curr == tk_dot() {
    if prev == tk_integer() {
      if nextk == tk_integer() {
        return true
      }
      if nextk == tk_float() {
        return true
      }
    }
    if prev == tk_float() {
      if nextk == tk_integer() {
        return true
      }
      if nextk == tk_float() {
        return true
      }
    }
  }
  false
}

pub fn nth_significant(tokens: Array(Token), i: Int, n: Int): Int {
  j = i + 1
  seen = 0
  while j < tokens.size {
    k = tokens[j].kind
    if k == tk_newline() {
    } else if k == tk_comment() {
    } else if k != tk_file_line() {
      seen += 1
      if seen == n {
        return k
      }
    }
    j += 1
  }
  tk_eof()
}

pub fn fn_receiver_space(tokens: Array(Token), i: Int, prev: Int): Bool {
  if prev != tk_fn() {
    return false
  }
  if tokens[i].kind != tk_l_paren() {
    return false
  }
  depth = 1
  saw_colon = false
  j = i + 1
  while j < tokens.size {
    k = tokens[j].kind
    if k == tk_newline() {
    } else if k == tk_comment() {
    } else if k == tk_file_line() {
    } else if k == tk_l_paren() {
      depth += 1
    } else if k == tk_r_paren() {
      depth -= 1
      if depth == 0 {
        if saw_colon {
          nxt = nth_significant(tokens, j, 1)
          if nxt != tk_colon() {
            return true
          }
        }
        return false
      }
    } else if k == tk_colon() {
      if depth == 1 {
        saw_colon = true
      }
    }
    j += 1
  }
  false
}

pub fn prev_significant(tokens: Array(Token), i: Int): Int {
  j = i - 1
  while j >= 0 {
    k = tokens[j].kind
    if k == tk_newline() {
    } else if k == tk_comment() {
    } else if k != tk_file_line() {
      return j
    }
    j -= 1
  }
  -1
}

// The token before the `(` at i is the name of an operator method:
// `fn +(` or `fn (v: Vec2) +(`.
pub fn names_operator_method(tokens: Array(Token), i: Int): Bool {
  op = prev_significant(tokens, i)
  if op < 0 {
    return false
  }
  j = prev_significant(tokens, op)
  if j < 0 {
    return false
  }
  if tokens[j].kind == tk_fn() {
    return true
  }
  if tokens[j].kind != tk_r_paren() {
    return false
  }
  depth = 0
  while j >= 0 {
    k = tokens[j].kind
    if k == tk_r_paren() {
      depth += 1
    } else if k == tk_l_paren() {
      depth -= 1
      if depth == 0 {
        before = prev_significant(tokens, j)
        if before < 0 {
          return false
        }
        return tokens[before].kind == tk_fn()
      }
    }
    j -= 1
  }
  false
}

// A `(` hugs what came before it only when that opens a call or a type
// application (a value, `fn`, `pin`, `release`, or the operator name of
// `fn +(`); after an operator, `=`, a compound assignment, `,` or a
// keyword it is a grouping and keeps its space (`j = (r % n)` had
// become `j =(r % n)`).
pub fn paren_hugs(tokens: Array(Token), i: Int, prev: Int): Bool {
  if value_end(prev) {
    return true
  }
  if prev == tk_fn() || prev == tk_pin() || prev == tk_release() {
    return true
  }
  if prev == tk_eq() && index_op_name_at(tokens, prev_significant(tokens, i)) {
    return true
  }
  names_operator_method(tokens, i)
}

// Whether the token at i ends `fn [ ]` or `fn [ ] =`, the name of an
// indexing operator method (`fn [](i: Int)`, `fn []=(i: Int, v: T)`).
pub fn index_op_name_at(tokens: Array(Token), i: Int): Bool {
  j = i
  if j >= 0 && tokens[j].kind == tk_eq() {
    j = prev_significant(tokens, j)
  }
  if j < 0 || tokens[j].kind != tk_r_bracket() {
    return false
  }
  j = prev_significant(tokens, j)
  if j < 0 || tokens[j].kind != tk_l_bracket() {
    return false
  }
  j = prev_significant(tokens, j)
  j >= 0 && tokens[j].kind == tk_fn()
}

pub fn no_space(tokens: Array(Token), i: Int, prev: Int, curr: Int, after_tight: Bool, separate: Bool): Bool {
  if separate {
    return false
  }
  if curr == tk_l_paren() && shorthand_at(tokens, i) {
    // `xs.each (x) { ... }`: the lambda that is the call's only argument,
    // its parameters apart from the callee (parser.av parse_call_args).
    return false
  }
  if curr == tk_l_paren() {
    if fn_receiver_space(tokens, i, prev) {
      return false
    }
    if after_tight {
      return true
    }
    return paren_hugs(tokens, i, prev)
  }
  if after_tight {
    return true
  }
  if curr == tk_eq() && prev == tk_r_bracket() && index_op_name_at(tokens, prev_significant(tokens, i)) {
    return true
  }
  if curr == tk_l_bracket() && value_end(prev) {
    return true
  }
  if curr == tk_colon() && enum_lit_at(tokens, i) {
    // `:write`, an enum's member written short: spaced from what is
    // before it (`on: :write`, `= :read`), joined to its name.
    return tight_after_kind(prev)
  }
  if prev == tk_colon() && enum_lit_at(tokens, prev_significant(tokens, i)) {
    return true
  }
  if tight_before(curr) {
    return true
  }
  if tight_after_kind(prev) {
    return true
  }
  false
}

// The colon at i begins an enum's member written short (`:write`): the
// name follows it with no space, and what is before it ends no value (a
// type annotation `x:Int` follows a name).
pub fn enum_lit_at(tokens: Array(Token), i: Int): Bool {
  if i < 0 || i + 1 >= tokens.size || tokens[i].kind != tk_colon() {
    return false
  }
  nt = tokens[i + 1]
  t = tokens[i]
  if nt.kind != tk_ident() || nt.loc.line() != t.loc.line() || nt.loc.offset() != t.loc.offset() + 1 {
    return false
  }
  p = prev_significant(tokens, i)
  p < 0 || !value_end(tokens[p].kind)
}

// Bytes that can end one token and begin the next as one longer token:
// a punctuation byte beside another (`.` `..` become `...`, `?` `?`
// become `??`, `!` `==` become `!=` `=`), a word byte (a letter, a
// digit, `_`) beside a word byte or a quote (`r` `"x"` become a raw
// string), and a digit beside a `.` (`5.` `..` become `5` `...`).
pub fn punct_byte(c: Int): Bool {
  if c == 33 || c == 35 || c == 37 || c == 38 || c == 42 || c == 43 || c == 45 || c == 46 || c == 47 {
    return true
  }
  if c == 58 || c == 60 || c == 61 || c == 62 || c == 63 || c == 64 || c == 94 || c == 124 || c == 126 {
    return true
  }
  false
}

pub fn word_byte(c: Int): Bool {
  if c >= 48 && c <= 57 {
    return true
  }
  if c >= 65 && c <= 90 {
    return true
  }
  if c >= 97 && c <= 122 {
    return true
  }
  c == 95
}

pub fn digit_byte(c: Int): Bool {
  c >= 48 && c <= 57
}

pub fn may_join(a: Int, b: Int): Bool {
  if punct_byte(a) && punct_byte(b) {
    return true
  }
  if word_byte(a) && (word_byte(b) || b == 34 || b == 39) {
    return true
  }
  if digit_byte(a) && b == 46 {
    return true
  }
  a == 46 && digit_byte(b)
}

pub fn structural_kind(k: Int): Bool {
  if k == tk_interp_open() || k == tk_interp_mid() || k == tk_interp_close() {
    return true
  }
  k == tk_comment() || k == tk_file_line() || k == tk_newline() || k == tk_eof()
}

// Two tokens printed with nothing between them stay the same two tokens
// (the formatter deletes nothing a token needs): when their facing
// bytes could join, the pair is lexed as it would be printed, and a
// space goes between them unless that gives the two tokens back. Before
// `. ..` was printed `...`, `? ?` was `??` and `! ==` was `!==`.
pub fn tokens_join(prev: Token, curr: Token): Bool {
  if structural_kind(prev.kind) || structural_kind(curr.kind) {
    return false
  }
  a = token_text(prev)
  b = token_text(curr)
  if a.size == 0 || b.size == 0 {
    return false
  }
  if !may_join(a[a.size - 1], b[0]) {
    return false
  }
  lex = Lexer.new(Source.new("", a + b))
  got = lex.tokenize()
  if lex.has_err() || got.size != 3 {
    return true
  }
  if got[0].kind != prev.kind || got[0].value != prev.value {
    return true
  }
  got[1].kind != curr.kind || got[1].value != curr.value
}

pub fn collapse_newlines(n: Int): Int {
  if n > 2 {
    return 2
  }
  n
}

pub fn push_newlines(buf: Buf, n: Int) {
  for j in 0..n {
    buf.push_byte(10)
  }
}

pub fn push_indent(buf: Buf, depth: Int) {
  pad = depth * 2
  for p in 0..pad {
    buf.push_byte(32)
  }
}

// Whether k opens a bracket: `{`, `(` or `[`.
pub fn opens_bracket(k: Int): Bool {
  k == tk_l_brace() || k == tk_l_paren() || k == tk_l_bracket()
}

// Whether k closes one.
pub fn closes_bracket(k: Int): Bool {
  k == tk_r_brace() || k == tk_r_paren() || k == tk_r_bracket()
}

// The canonical text of the tokens. A line's indent: one level more than
// the line that opened the innermost bracket still open at its start
// (`{`, `(` or `[`), so a block's statements and the elements, arguments
// and fields of a bracket that spans lines sit one level in; a line that
// starts with a closing bracket sits at the indent of the line that
// opened it. Brackets opened on one line give the lines inside one level
// together (`f(Box {` and its fields, closed by `})`).
pub fn reprint(tokens: Array(Token)): String {
  buf = Buf.new()
  // The indent of the line each open bracket was opened on, innermost
  // last, and the current line's own.
  opened: Array(Int) = []
  line_indent = 0
  at_start = true
  prev = -1
  prev2 = -1
  prev_i = -1
  after_tight = false
  // The bracket depth of the head of the `if`, `while`, `for` or
  // `switch` being printed, up to its body's `{`; -1 outside one.
  head_depth = -1
  pending = 0
  i = 0
  while i < tokens.size {
    t = tokens[i]
    k = t.kind
    if k == tk_eof() {
      break
    }
    if k == tk_newline() {
      pending += 1
      i += 1
      continue
    }
    if pending > 0 {
      push_newlines(buf, collapse_newlines(pending))
      pending = 0
      at_start = true
      after_tight = false
      prev2 = prev
      prev = tk_newline()
    }
    started = at_start
    if started {
      line_indent = 0
      if opened.size > 0 {
        line_indent = opened[opened.size - 1] + 1
        if closes_bracket(k) {
          line_indent = opened[opened.size - 1]
        }
      }
      if k == tk_file_line() {
        buf.push_str(t.value)
      } else {
        push_indent(buf, line_indent)
        push_token(buf, t)
      }
      at_start = false
    } else if k == tk_comment() {
      buf.push_byte(32)
      buf.push_str(t.value)
    } else {
      nextk = next_significant(tokens, i)
      separate = must_separate(prev, prev2, k, nextk)
      tight = no_space(tokens, i, prev, k, after_tight, separate)
      if k == tk_l_paren() && !separate && head_depth == opened.size && shorthand_at(tokens, i) {
        // Directly in a statement's head the `{` begins its body: a call.
        tight = after_tight || paren_hugs(tokens, i, prev)
      }
      if tight && prev_i >= 0 && tokens_join(tokens[prev_i], t) {
        tight = false
      }
      if tight {
        push_token(buf, t)
      } else {
        buf.push_byte(32)
        push_token(buf, t)
      }
    }
    if k == tk_l_brace() && head_depth == opened.size {
      head_depth = -1
    }
    if (k == tk_if() || k == tk_while() || k == tk_for() || k == tk_switch()) && head_depth < 0 {
      head_depth = opened.size
    }
    if opens_bracket(k) {
      opened.push(line_indent)
    } else if closes_bracket(k) && opened.size > 0 {
      opened.pop()
    }
    if k == tk_comment() {
    } else if k == tk_file_line() {
    } else if k == tk_l_brace() || k == tk_r_brace() {
      after_tight = false
    } else if k == tk_minus() || k == tk_amp() {
      after_tight = minus_is_prefix(prev, started)
    } else {
      after_tight = tight_after_kind(k)
    }
    prev2 = prev
    prev = k
    prev_i = i
    i += 1
  }
  if pending > 0 {
    push_newlines(buf, collapse_newlines(pending))
  }
  buf.to_s()
}

pub fn format_source(path: String, text: String): FormatResult {
  src = Source.new(path, text)
  lex = Lexer.new(src)
  tokens = lex.tokenize_format()
  if e = lex.err {
    return FormatResult.new(false, "", e.show())
  }
  out = fault_for_test(reprint(tokens))
  if e = self_check(path, text, out) {
    return FormatResult.new(false, "", e)
  }
  FormatResult.new(true, out, "")
}

// AVANT_FORMAT_FAULT (the suite's only, not a user knob): `line`
// turns the canonical text's first line break into a space and
// `space` drops its first space between two word bytes, so
// tests/cases/test_format.av can show the self-check refusing a text
// that is not the same program.
pub fn fault_for_test(out: String): String {
  if v = process.env("AVANT_FORMAT_FAULT") {
    for i in 1..out.size - 1 {
      if v == "line" && out[i] == 10 {
        return out[..i] + " " + out[i + 1..]
      }
      if v == "space" && out[i] == 32 && word_byte(out[i - 1]) && word_byte(out[i + 1]) {
        return out[..i] + out[i + 1..]
      }
    }
  }
  out
}

pub fn token_shown(t: Token): String {
  if t.kind == tk_newline() {
    return "a line break"
  }
  if t.kind == tk_eof() {
    return "the end of the file"
  }
  text = token_text(t)
  if text.size == 0 {
    return token_name(t.kind)
  }
  "`${text}`"
}

// The formatter's self-check: the canonical text must be the same
// program. Both texts are lexed by the compiler's own lexer, the one
// compile and run use (comments dropped, blank lines folded into one
// line break), and the two token lists must be equal: every token's
// kind and spelling, and every line break where it was, since a line
// that starts with `[`, `-` or `+` begins a new statement. Before,
// format_source returned the reprint unchecked. A difference is a
// formatter bug: the file is left as it is and the error names the
// first token that would change. A canonical text equal to the source
// byte for byte is the same program without lexing either (the lexer
// reads nothing but the text and the path): the corpus's files are
// mostly canonical already, and a second pass formats only canonical
// texts, so this skips two of every three lexes there.
pub fn self_check(path: String, before: String, after: String): String? {
  if before == after {
    return nil
  }
  la = Lexer.new(Source.new(path, before))
  ta = la.tokenize()
  lb = Lexer.new(Source.new(path, after))
  tb = lb.tokenize()
  n = ta.size
  if tb.size < n {
    n = tb.size
  }
  for i in 0..n {
    a = ta[i]
    b = tb[i]
    if a.kind != b.kind || a.value != b.value {
      return "${a.loc.show()}: format would change this program: ${token_shown(a)} would become ${token_shown(b)}; the file is left as it is (a formatter bug)"
    }
  }
  if ta.size != tb.size {
    at = ta[n - 1]
    return "${at.loc.show()}: format would change this program: the canonical text has ${tb.size} tokens, the source ${ta.size}; the file is left as it is (a formatter bug)"
  }
  if la.has_err() != lb.has_err() {
    return "${path}: format would change this program: the canonical text does not lex as the source does; the file is left as it is (a formatter bug)"
  }
  nil
}

pub fn print_format(text: String) {
  if text.size == 0 {
    return
  }
  if text[text.size - 1] == 10 {
    puts(text[..text.size - 1])
  } else {
    puts(text)
  }
}
