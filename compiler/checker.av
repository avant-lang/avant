        return self.t_buf()
      }
      if expr.args.size == 0 {
        return self.t_buf()
      }
      if expr.args.size == 1 {
        cap = self.check_expr_as(expr.args[0], self.t_int())
        if cap.is_int {
        } else {
          self.fail(expr.args[0].loc, "capacity must be Int")
        }
        return self.t_buf()
      }
      self.fail(expr.loc, "buf_new takes an optional Int capacity")
      return self.t_buf()
    }
    expected: Ty? = nil
    if has_want {
      expected = want
    }
    return self.dispatch_call(expr, expected)
  }

  pub fn fit_call_arg(expr: Expr, got: Ty, want: Ty): Ty {
    if ty_assignable(got, want) {
      return got
    }
    if expr.kind == ex_int() {
      widened = self.check_integer(expr, true, want)
      if ty_assignable(widened, want) {
        expr.ty = widened
        return widened
      }
    }
    got
  }

  pub fn check_args(expr: Expr, params: Array(Ty), label: String) {
    if expr.args.size != params.size {
      self.fail(expr.loc, "${label} takes ${params.size} arguments, got ${expr.args.size}")
      return
    }
    i = 0
    while i < expr.args.size {
      call_arg = expr.args[i]
      got = self.t_int()
      if params[i].is_fn {
        if call_arg.kind == ex_name() {
          if local = self.lookup(call_arg.ident) {
            got = self.check_expr_as(call_arg, params[i])
          } else {
            got = self.check_fn_arg(call_arg, params[i])
          }
        } else {
          got = self.check_fn_arg(call_arg, params[i])
        }
      } else {
        got = self.check_expr_as(call_arg, params[i])
      }
      if ty_assignable(got, params[i]) {
      } else {
        n = i + 1
        self.fail(call_arg.loc, "argument ${n} of ${label} is ${got.show}, expected ${params[i].show}")
      }
      i = i + 1
    }
  }

  pub fn check_constructor(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    if recv.kind == ex_name() {
      if cdef = self.find_class_template(recv.ident) {
        if recv.type_args.size > 0 {
          tn = TypeName.new(recv.loc, recv.ident)
          tn.mod_name = recv.mod_name
          i = 0
          while i < recv.type_args.size {
            tn.args.push(recv.type_args[i])
            i = i + 1
          }
          ty = self.resolve_in_module(tn)
          self.pull_resolve
          if self.has_err {
          } else {
            recv.ty = ty
          }
          empty: Array(Ty) = []
          return self.finish_constructor(expr, ty, false, empty)
        }
        return self.infer_new(expr, recv, cdef, recv.mod_name, has_want, want)
      }
    }
    if recv.kind == ex_field() {
      if obj = recv.object {
        if obj.kind == ex_name() {
          if cdef = self.find_class_template(recv.ident) {
            return self.infer_new(expr, recv, cdef, obj.ident, has_want, want)
          }
        }
      }
    }
    if ty = self.type_from_recv(recv, expr.loc) {
      recv.ty = ty
      if ty.template {
        self.fail(expr.loc, "${ty.name} needs type arguments")
        return self.t_int()
      }
      empty: Array(Ty) = []
      return self.finish_constructor(expr, ty, false, empty)
    }
    self.t_int()
  }

  pub fn template_initialize(cdef: ClassDef): Function? {
    i = 0
    while i < cdef.methods.size {
      if str_eq(cdef.methods[i].name, "initialize") {
        return cdef.methods[i]
      }
      i = i + 1
    }
    nil
  }

  pub fn infer_new(expr: Expr, recv: Expr, cdef: ClassDef, mod_name: String, has_want: Bool, want: Ty): Ty {
    params = cdef.type_params
    keys: Array(String) = []
    vals: Array(Ty) = []
    if self.apply_want_args(cdef.name, params, has_want, want, keys, vals) {
    } else {
      self.fail(expr.loc, "conflicting type arguments")
      return self.t_int()
    }
    pre: Array(Ty) = []
    if init = self.template_initialize(cdef) {
      self.resolver.set_tparams(params)
      pats: Array(Ty) = []
      i = 0
      while i < init.params.size {
        pats.push(self.resolver.resolve_value(init.params[i].type))
        self.pull_resolve
        i = i + 1
      }
      self.resolver.clear_tparams
      i = 0
      while i < expr.args.size {
        got = self.t_int()
        if i < pats.size {
          pat_ty = self.subst_ty(pats[i], keys, vals)
          got = self.check_expr_flag(expr.args[i], true, pat_ty)
          if self.unify_ty(pat_ty, got, keys, vals) {
          } else {
            self.fail(expr.args[i].loc, "conflicting type arguments")
          }
        } else {
          got = self.check_expr(expr.args[i])
        }
        pre.push(got)
        i = i + 1
      }
    } else {
      if expr.args.size != 0 {
        self.fail(expr.loc, "${cdef.name}.new takes no arguments")
        return self.t_int()
      }
    }
    if solved = self.solved_args(params, keys, vals, expr.loc) {
      ty = self.instantiate_applied(cdef.name, mod_name, solved, expr.loc)
      if self.has_err {
        return self.t_int()
      }
      recv.ty = ty
      return self.finish_constructor(expr, ty, true, pre)
    }
    self.fail(expr.loc, "cannot infer type argument; write ${cdef.name}(...)")
    self.t_int()
  }

  pub fn finish_constructor(expr: Expr, ty: Ty, has_pre: Bool, pre: Array(Ty)): Ty {
    if self.has_err {
      return self.t_int()
    }
    if ty.is_class {
      shown = ty.show
      has_init = false
      mi = 0
      while mi < self.methods.size {
        ms = self.methods[mi]
        if str_eq(ms.owner, ty.name) {
          if str_eq(ms.name, "initialize") {
            has_init = true
          }
        }
        mi = mi + 1
      }
      if has_init {
        arg_tys: Array(Ty) = []
        if has_pre {
          i = 0
          while i < pre.size {
            arg_tys.push(pre[i])
            i = i + 1
          }
        } else {
          ai = 0
          while ai < expr.args.size {
            arg_tys.push(self.check_expr(expr.args[ai]))
            ai = ai + 1
          }
        }
        none: Ty? = nil
        if sig = self.match_method(ty.name, "initialize", arg_tys, none, expr.loc, shown) {
          self.fill_defaults(expr, sig.node)
          i = 0
          while i < expr.args.size {
            got = self.t_int()
            if has_pre {
              if i < pre.size {
                got = pre[i]
              } else {
                got = self.check_expr_as(expr.args[i], sig.params[i])
              }
            } else {
              if i < arg_tys.size {
                got = arg_tys[i]
              } else {
                got = self.check_expr_as(expr.args[i], sig.params[i])
              }
            }
            if i < sig.params.size {
              got = self.fit_call_arg(expr.args[i], got, sig.params[i])
              if ty_assignable(got, sig.params[i]) {
              } else {
                n = i + 1
                self.fail(expr.args[i].loc, "argument ${n} of ${shown}.new is ${got.show}, expected ${sig.params[i].show}")
              }
            }
            i = i + 1
          }
        }
      } else {
        if expr.args.size == 0 {
        } else {
          self.fail(expr.loc, "${shown}.new takes no arguments")
        }
      }
      expr.resolved = "${ty.name}__new"
      return ty
    }
    shown = ty.show
    self.fail(expr.loc, "structs are constructed with ${shown} { fields }, not .new")
    ty
  }

  pub fn check_lib_call(expr: Expr, lib_name: String): Ty {
    key = "${lib_name}.${expr.callee}"
    if id = self.cfun_index.get(key) {
      sig = self.cfuns[id]
      self.check_args(expr, sig.params, "${lib_name}.${expr.callee}")
      if self.has_err {
        return sig.ret
      }
      i = 0
      while i < expr.args.size {
        if sig.params[i].is_fn {
          arg = expr.args[i]
          if arg.kind == ex_lambda() {
            if arg.cap_names.size > 0 {
              self.fail(arg.loc, "C callback cannot capture ${arg.cap_names[0]}")
            }
          } else if arg.fn_ref {
          } else {
            self.fail(arg.loc, "C callback must be a function name or a lambda that captures nothing")
          }
        }
        i = i + 1
      }
      expr.lib_name = lib_name
      return sig.ret
    }
    self.fail(expr.loc, "unknown function ${lib_name}.${expr.callee}")
    self.t_int()
  }

  pub fn type_name_as_expr(arg: TypeName): Expr {
    if arg.fn_type {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.nilable {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.members.size > 0 {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.args.size == 0 {
      n = Expr.new(ex_name(), arg.loc)
      n.ident = arg.name
      n.mod_name = arg.mod_name
      return n
    }
    call = Expr.new(ex_call(), arg.loc)
    call.callee = arg.name
    if arg.mod_name.size > 0 {
      mod = Expr.new(ex_name(), arg.loc)
      mod.ident = arg.mod_name
      call.receiver = mod
    }
    i = 0
    while i < arg.args.size {
      call.args.push(self.type_name_as_expr(arg.args[i]))
      i = i + 1
    }
    call
  }

  pub fn type_app_as_call(recv: Expr): Expr {
    call = Expr.new(ex_call(), recv.loc)
    call.callee = recv.ident
    if recv.mod_name.size > 0 {
      mod = Expr.new(ex_name(), recv.loc)
      mod.ident = recv.mod_name
      call.receiver = mod
    }
    i = 0
    while i < recv.type_args.size {
      call.args.push(self.type_name_as_expr(recv.type_args[i]))
      i = i + 1
    }
    call
  }

  pub fn rewrite_type_app_call(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    call = self.type_app_as_call(recv)
    expr.receiver = call
    self.check_method_call(expr, call, has_want, want)
  }

  pub fn check_method_call(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    if recv.kind == ex_name() {
      if recv.type_args.size > 0 {
        if self.is_generic_template(recv.ident) {
          if str_eq(expr.callee, "new") {
          } else {
            self.fail(recv.loc, "${recv.ident} is a type")
            return self.t_int()
          }
        } else {
          return self.rewrite_type_app_call(expr, recv, has_want, want)
        }
      }
    }
    if recv.kind == ex_name() {
      if found = self.lookup(recv.ident) {
      } else {
        if recv.type_args.size > 0 {
        } else {
          if id = self.lib_names.get(recv.ident) {
            if self.lib_is_visible(recv.ident, self.current_module) {
              return self.check_lib_call(expr, recv.ident)
            }
            self.fail(recv.loc, "unknown name ${recv.ident}")
            return self.t_int()
          }
          if k = self.known_mods.get(recv.ident) {
            if self.qualifier_ok(recv.ident, self.current_module) {
              return self.dispatch_qualified_call(expr, recv.ident)
            }
          }
        }
      }
    }
    if str_eq(expr.callee, "new") {
      return self.check_constructor(expr, recv, has_want, want)
    }
    if str_eq(expr.callee, "bump") {
      ty = self.check_constructor(expr, recv, has_want, want)
      if self.has_err {
        return ty
      }
      if ty.is_class {
        expr.resolved = "${ty.name}__bump"
        return ty_nilable(ty)
      }
      return ty
    }
    if str_eq(expr.callee, "send") {
      i = 0
      while i < expr.args.size {
        if self.expr_is_place(expr.args[i]) {
          self.fail(expr.args[i].loc, "mutex place cannot escape")
          return self.t_void()
        }
        i = i + 1
      }
    }
    if recv.kind == ex_name() {
      if str_eq(recv.ident, "String") {
        if str_eq(expr.callee, "from_utf8") {
          if expr.args.size == 1 {
          } else {
            self.fail(expr.loc, "String.from_utf8 takes one Bytes")
            return ty_nilable(self.t_string())
          }
          got = self.check_expr_as(expr.args[0], self.t_bytes())
          if got.is_bytes {
          } else {
            self.fail(expr.args[0].loc, "String.from_utf8 expects Bytes")
          }
          return ty_nilable(self.t_string())
        }
      }
    }
    object = self.check_expr(recv)
    if str_eq(expr.callee, "or") {
      if b = expr.block {
        self.fail(expr.loc, "or does not take a block")
        return object
      }
      if expr.args.size == 1 {
        if object.is_nilable {
          return self.coalesce_result(object, expr.args[0], expr.loc, "or")
        }
        dummy = self.check_expr(expr.args[0])
        self.fail(expr.loc, "or needs a nilable receiver, got ${object.show}")
        return object
      }
      self.fail(expr.loc, "or takes one fallback")
      return object
    }
    if str_eq(expr.callee, "with") {
      if self.is_mutex_ty(object) {
        return self.check_mutex_with(expr, object)
      }
    }
    if object.is_float {
      return self.check_float_method(expr)
    }
    if object.is_integer {
      return self.check_int_method(expr, object)
    }
    if object.is_string {
      return self.check_string_method(expr)
    }
    if object.is_bytes {
      return self.check_bytes_method(expr)
    }
    if object.is_array {
      return self.check_array_method(expr, object)
    }
    if object.is_hash {
      return self.check_hash_method(expr, object)
    }
    if object.is_buf {
      return self.check_buf_method(expr)
    }
    if object.is_join {
      return self.check_join(expr, object)
    }
    expected: Ty? = nil
    if has_want {
      expected = want
    }
    if object.is_agg {
      return self.dispatch_method(expr, object, expected)
    }
    if object.is_ptr {
      return self.dispatch_method(expr, object, expected)
    }
    self.fail(expr.loc, "cannot call ${expr.callee} on ${object.show}")
    self.t_int()
  }

  pub fn check_block_void(block: Block, pname: String, pty: Ty) {
    self.push_scope
    self.bind(pname, pty)
    self.check_body(block.body, self.t_void(), false)
    self.pop_scope
  }

  pub fn check_switch(expr: Expr, has_want: Bool, want: Ty): Ty {
    if cond = expr.cond {
      ct = self.check_expr(cond)
      if ct.is_int {
      } else {
        if ct.is_bool {
        } else {
          self.fail(cond.loc, "switch discriminant must be Int or Bool, got ${ct.show}")
        }
      }
    }
    seen = Hash(Int, Int).new
    i = 0
    while i < expr.cases.size {
      arm = expr.cases[i]
      if arm.labels.size == 0 {
        self.fail(arm.loc, "case needs a label")
      }
      j = 0
      while j < arm.labels.size {
        lab = arm.labels[j].to_i
        if prev = seen.get(lab) {
          self.fail(arm.loc, "duplicate case ${lab}")
        }
        seen[lab] = 1
        j = j + 1
      }
      i = i + 1
    }
    branch_tys: Array(Ty) = []
    i = 0
    while i < expr.cases.size {
      branch_tys.push(self.check_switch_branch(expr.cases[i].body, has_want, want))
      i = i + 1
    }
    if expr.has_else {
      branch_tys.push(self.check_switch_branch(expr.else_body, has_want, want))
    }
    all_void = true
    any_void = false
    i = 0
    while i < branch_tys.size {
      if branch_tys[i].is_void {
        any_void = true
      } else {
        all_void = false
      }
      i = i + 1
    }
    if all_void {
      return self.t_void()
    }
    if any_void {
      self.fail(expr.loc, "switch cases must all produce a value, or none")
      return self.t_int()
    }
    if expr.has_else {
    } else {
      self.fail(expr.loc, "switch expression needs else")
      return self.t_int()
    }
    if has_want {
      if want.is_void {
      } else {
        i = 0
        while i < branch_tys.size {
          if ty_assignable(branch_tys[i], want) {
          } else {
            self.fail(expr.loc, "switch branch is ${branch_tys[i].show}, expected ${want.show}")
          }
          i = i + 1
        }
        return want
      }
    }
    if branch_tys.size == 0 {
      return self.t_void()
    }
    result = branch_tys[0]
    i = 0
    while i < branch_tys.size {
      if branch_tys[i].same_as(result) {
      } else {
        self.fail(expr.loc, "switch branches have different types ${result.show} and ${branch_tys[i].show}")
      }
      i = i + 1
    }
    result
  }

  pub fn check_spawn(expr: Expr): Ty {
    if expr.args.size == 0 {
    } else {
      self.fail(expr.loc, "spawn takes a block, not arguments")
      return ty_join(self.t_int())
    }
    if b = expr.block {
      if b.params.size == 0 {
      } else {
        self.fail(b.loc, "spawn { } does not take block parameters; use items.parallel")
        return ty_join(self.t_int())
      }
      self.in_task = self.in_task + 1
      result = self.check_block_value(b)
      self.in_task = self.in_task - 1
      if result.is_int {
      } else {
        self.fail(b.loc, "spawn result must be Int")
      }
      self.collect_spawn_captures(expr, b.body)
      return ty_join(result)
    }
    self.fail(expr.loc, "spawn needs a block")
    ty_join(self.t_int())
  }

  pub fn check_block_value(block: Block): Ty {
    if block.body.size == 0 {
      self.fail(block.loc, "block needs a value")
      return self.t_int()
    }
    self.push_scope
    last = block.body[block.body.size - 1]
    i = 0
    while i < block.body.size {
      stmt = block.body[i]
      if i == block.body.size - 1 {
        if stmt.kind == st_return() {
          if self.place_depth > 0 {
            self.fail(stmt.loc, "return inside Mutex.with")
            self.pop_scope
            return self.t_int()
          }
        }
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            ty = self.check_expr(e)
            if ty.is_void {
              self.fail(stmt.loc, "block must end with a value")
              self.pop_scope
              return self.t_int()
            }
            self.pop_scope
            return ty
          }
        }
        self.fail(stmt.loc, "block must end with a value")
        self.pop_scope
        return self.t_int()
      }
      self.check_stmt(stmt, self.t_void(), false)
      i = i + 1
    }
    self.pop_scope
    self.t_int()
  }

  pub fn expr_is_place(expr: Expr): Bool {
    if self.place_depth > 0 {
      if expr.kind == ex_name() {
        if str_eq(expr.ident, self.place_name) {
          return true
        }
      }
    }
    false
  }

  pub fn reject_place_assign(stmt: Stmt): Bool {
    if self.place_depth > 0 {
    } else {
      return false
    }
    if value = stmt.value {
      if self.expr_is_place(value) {
      } else {
        return false
      }
    } else {
      return false
    }
    if target = stmt.target {
      if target.kind == ex_name() {
        if str_eq(target.ident, self.place_name) {
          return false
        }
      }
      if target.kind == ex_field() {
        if obj = target.object {
          if obj.kind == ex_name() {
            if str_eq(obj.ident, self.place_name) {
              return false
            }
          }
        }
      }
    }
    self.fail(stmt.loc, "mutex place cannot escape")
    true
  }

  pub fn is_mutex_ty(ty: Ty): Bool {
    if str_eq(ty.origin, "Mutex") {
      return true
    }
    str_eq(ty.name, "Mutex")
  }

  pub fn check_mutex_with(expr: Expr, object: Ty): Ty {
    if expr.args.size != 0 {
      self.fail(expr.loc, "Mutex.with takes a block")
      return self.t_void()
    }
    if b = expr.block {
      if b.params.size == 1 {
      } else {
        self.fail(b.loc, "Mutex.with { |x| } takes one block parameter")
        return self.t_void()
      }
      if object.ty_args.size == 1 {
      } else {
        self.fail(expr.loc, "Mutex needs one type argument")
        return self.t_void()
      }
      t = object.ty_args[0]
      if cell = object.field_named("cell") {
        if cell.same_as(t) {
        } else {
          self.fail(expr.loc, "Mutex cell has the wrong type")
          return self.t_void()
        }
      } else {
        self.fail(expr.loc, "Mutex needs a cell field")
        return self.t_void()
      }
      if gate = object.field_named("gate") {
        if gate.is_uint64 {
        } else {
          self.fail(expr.loc, "Mutex needs a gate field")
          return self.t_void()
        }
      } else {
        self.fail(expr.loc, "Mutex needs a gate field")
        return self.t_void()
      }
      saved_name = self.place_name
      saved_depth = self.place_depth
      self.push_scope
      self.bind(b.params[0], t)
      self.place_name = b.params[0]
      self.place_depth = self.place_depth + 1
      result = self.check_block_value(b)
      self.place_name = saved_name
      self.place_depth = saved_depth
      self.pop_scope
      return result
    }
    self.fail(expr.loc, "Mutex.with needs a block")
    self.t_void()
  }

  pub fn check_gate_call(expr: Expr): Ty? {
    if str_eq(expr.callee, "avant_gate_new") {
      if expr.args.size == 0 {
        if b = expr.block {
          self.fail(expr.loc, "avant_gate_new takes no arguments")
          return self.t_uint64()
        }
        return self.t_uint64()
      }
      self.fail(expr.loc, "avant_gate_new takes no arguments")
      return self.t_uint64()
    }
    is_gate = false
    if str_eq(expr.callee, "avant_gate_lock") {
      is_gate = true
    }
    if str_eq(expr.callee, "avant_gate_unlock") {
      is_gate = true
    }
    if str_eq(expr.callee, "avant_gate_wait") {
      is_gate = true
    }
    if str_eq(expr.callee, "avant_gate_signal") {
      is_gate = true
    }
    if str_eq(expr.callee, "avant_gate_broadcast") {
      is_gate = true
    }
    if is_gate {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "${expr.callee} takes one UInt64")
          return self.t_void()
        }
      } else {
        self.fail(expr.loc, "${expr.callee} takes one UInt64")
        return self.t_void()
      }
      got = self.check_expr_as(expr.args[0], self.t_uint64())
      if got.is_uint64 {
      } else {
        self.fail(expr.args[0].loc, "${expr.callee} expects UInt64")
      }
      return self.t_void()
    }
    nil
  }

  pub fn check_join(expr: Expr, handle: Ty): Ty {
    if str_eq(expr.callee, "join") {
      if self.in_task > 0 {
        self.fail(expr.loc, "join inside a pool worker")
      }
    } else {
      self.fail(expr.loc, "no method ${expr.callee} on JoinHandle")
      if inner = handle.inner {
        return inner
      }
      return self.t_int()
    }
    if expr.args.size == 0 {
      if b = expr.block {
        self.fail(expr.loc, "join takes no arguments")
      }
    } else {
      self.fail(expr.loc, "join takes no arguments")
    }
    if inner = handle.inner {
      return inner
    }
    self.t_int()
  }

  pub fn check_switch_branch(body: Array(Stmt), has_want: Bool, want: Ty): Ty {
    self.push_scope
    if body.size == 0 {
      self.pop_scope
      return self.t_void()
    }
    i = 0
    while i < body.size {
      stmt = body[i]
      if i == body.size - 1 {
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            use_want = false
            use_ty = self.t_int()
            if has_want {
              if want.is_void {
              } else {
                use_want = true
                use_ty = want
              }
            }
            ty = self.check_expr_flag(e, use_want, use_ty)
            self.pop_scope
            return ty
          }
        }
        self.check_stmt(stmt, self.t_void(), false)
        self.pop_scope
        return self.t_void()
      }
      self.check_stmt(stmt, self.t_void(), false)
      i = i + 1
    }
    self.pop_scope
    self.t_void()
  }
}
