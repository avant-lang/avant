  fn check_codec_call(expr: Expr): Ty? {
    if str_eq(expr.callee, "b64_encode") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "b64_decode") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "zlib_compress") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "zlib_uncompress") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "sha256") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "b64_encode_buf") {
      return self.check_buf_string(expr)
    }
    if str_eq(expr.callee, "b64_decode_buf") {
      return self.check_buf_string(expr)
    }
    if str_eq(expr.callee, "crc32_bytes") {
      return self.check_i32_bytes(expr)
    }
    if str_eq(expr.callee, "sha256_word0") {
      return self.check_i32_bytes(expr)
    }
    if str_eq(expr.callee, "re_count") {
      if expr.args.size == 3 {
        if b = expr.block {
          self.fail(expr.loc, "re_count takes pattern, text, and caseless")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "re_count takes pattern, text, and caseless")
        return self.t_int()
      }
      pat = self.check_expr_as(expr.args[0], self.t_string())
      text = self.check_expr_as(expr.args[1], self.t_string())
      flags = self.check_expr_as(expr.args[2], self.t_int())
      if ty_assignable(pat, self.t_string()) {
        if ty_assignable(text, self.t_string()) {
        } else {
          self.fail(expr.loc, "re_count expects String pattern and text")
        }
      } else {
        self.fail(expr.loc, "re_count expects String pattern and text")
      }
      if flags.is_int {
      } else {
        self.fail(expr.args[2].loc, "caseless must be Int")
      }
      return self.t_int()
    }
    nil
  }

  fn check_one_string(expr: Expr, ret: Ty): Ty {
    if expr.args.size == 1 {
      if b = expr.block {
        self.fail(expr.loc, "${expr.callee} takes one String")
        return ret
