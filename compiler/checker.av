  pub fn check_switch_branch(body: Array(Stmt), has_want: Bool, want: Ty): Ty {
    self.push_scope
    if body.size == 0 {
      self.pop_scope
      return self.t_void()
    }
    i = 0
    while i < body.size {
      stmt = body[i]
      if i == body.size - 1 {
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            use_want = false
            use_ty = self.t_int()
            if has_want {
              if want.is_void {
              } else {
                use_want = true
                use_ty = want
              }
            }
            ty = self.check_expr_flag(e, use_want, use_ty)
            self.pop_scope
            return ty
          }
        }
        self.check_stmt(stmt, self.t_void(), false)
        self.pop_scope
        return self.t_void()
      }
      self.check_stmt(stmt, self.t_void(), false)
      i = i + 1
    }
    self.pop_scope
    self.t_void()
  }

  pub fn fn_compatible(got: Ty, want: Ty): Bool {
    if want.is_fn {
      if got.is_fn {
        if want.members.size != got.members.size {
          return false
        }
        i = 0
        while i < want.members.size {
          if want.members[i].is_var {
          } else {
            if want.members[i].same_as(got.members[i]) {
            } else {
              return false
            }
          }
          i = i + 1
        }
        if wr = want.inner {
          if wr.is_var {
            return true
          }
          if gr = got.inner {
            return wr.same_as(gr)
          }
        }
        return true
      }
    }
    false
  }

  pub fn sig_is_instance(sig: FuncSig): Bool {
    j = 0
