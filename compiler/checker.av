pub class FuncSig {
  name: String = ""
  node: Function
  params: Array(Ty)
  ret: Ty
  owner: String = ""

  fn initialize(name: String, node: Function, params: Array(Ty), ret: Ty) {
    self.name = name
    self.node = node
    self.params = params
    self.ret = ret
    self.owner = ""
  }

  pub fn mangled: String {
    self.node.emit_name
  }
}

pub fn required_arity(fnn: Function): Int {
  i = 0
  while i < fnn.params.size {
    if d = fnn.params[i].default {
      return i
    }
    i = i + 1
  }
  fnn.params.size
}

pub fn arity_ok(fnn: Function, argc: Int): Bool {
  req = required_arity(fnn)
  if argc < req {
    return false
  }
  argc <= fnn.params.size
}

pub fn params_same(a: Array(Ty), b: Array(Ty)): Bool {
  if a.size != b.size {
    return false
  }
  i = 0
  while i < a.size {
    if a[i].same_as(b[i]) {
    } else {
      return false
    }
    i = i + 1
  }
  true
}

pub fn is_op_fn_name(name: String): Bool {
  if str_eq(name, "+") {
    return true
  }
  if str_eq(name, "-") {
    return true
  }
  if str_eq(name, "*") {
    return true
  }
  if str_eq(name, "/") {
    return true
  }
  if str_eq(name, "%") {
    return true
  }
  if str_eq(name, "==") {
    return true
  }
  if str_eq(name, "!=") {
    return true
  }
  if str_eq(name, "<") {
    return true
  }
  if str_eq(name, "<=") {
    return true
  }
  if str_eq(name, ">") {
    return true
  }
  if str_eq(name, ">=") {
    return true
  }
  false
}

pub fn binary_op_method_name(op: Int): String {
  fn_op_name(op)
}

pub fn mangle_ty(ty: Ty): String {
  k = ty.kind
  if k == tyk_int() {
    return "Int"
  }
  if k == tyk_int64() {
    return "Int64"
  }
  if k == tyk_uint64() {
    return "UInt64"
  }
  if k == tyk_bool() {
    return "Bool"
  }
  if k == tyk_float() {
    return "Float64"
  }
  if k == tyk_string() {
    return "String"
  }
  if k == tyk_void() {
    return "Void"
  }
  if k == tyk_nil() {
    return "Nil"
  }
  if k == tyk_buf() {
    return "Buf"
  }
  if k == tyk_array() {
    if e = ty.inner {
      return "Array_${mangle_ty(e)}"
    }
    return "Array"
  }
  if k == tyk_ptr() {
    if e = ty.inner {
      return "Ptr_${mangle_ty(e)}"
    }
    return "Ptr"
  }
  if k == tyk_join() {
    if e = ty.inner {
      return "JoinHandle_${mangle_ty(e)}"
    }
    return "JoinHandle"
  }
  if k == tyk_hash() {
    buf = buf_new()
    buf.push_str("Hash")
    if ke = ty.key {
      buf.push_str("_")
      buf.push_str(mangle_ty(ke))
    }
    if va = ty.val {
      buf.push_str("_")
      buf.push_str(mangle_ty(va))
    }
    return buf.to_s
  }
  if k == tyk_union() {
    buf = buf_new()
    i = 0
    while i < ty.members.size {
      if i > 0 {
        buf.push_str("_")
      }
      buf.push_str(mangle_ty(ty.members[i]))
      i = i + 1
    }
    return buf.to_s
  }
  ty.name
}

pub fn ty_to_type_name(ty: Ty, loc: Location): TypeName {
  if ty.is_union {
    if ty.is_nilable {
      inner = ty_without_nil(ty)
      tn = ty_to_type_name(inner, loc)
      if tn.nilable {
      } else {
        tn.nilable = true
      }
      return tn
    }
    out = TypeName.new(loc, "")
    i = 0
    while i < ty.members.size {
      out.members.push(ty_to_type_name(ty.members[i], loc))
      i = i + 1
    }
    return out
  }
  k = ty.kind
  if k == tyk_int() {
    return TypeName.new(loc, "Int")
  }
  if k == tyk_int64() {
    return TypeName.new(loc, "Int64")
  }
  if k == tyk_uint64() {
    return TypeName.new(loc, "UInt64")
  }
  if k == tyk_bool() {
    return TypeName.new(loc, "Bool")
  }
  if k == tyk_float() {
    return TypeName.new(loc, "Float64")
  }
  if k == tyk_string() {
    return TypeName.new(loc, "String")
  }
  if k == tyk_buf() {
    return TypeName.new(loc, "Buf")
  }
  if k == tyk_nil() {
    return TypeName.new(loc, "Nil")
  }
  if k == tyk_void() {
    return TypeName.new(loc, "Void")
  }
  if k == tyk_array() {
    tn = TypeName.new(loc, "Array")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_hash() {
    tn = TypeName.new(loc, "Hash")
    if ke = ty.key {
      tn.args.push(ty_to_type_name(ke, loc))
    }
    if va = ty.val {
      tn.args.push(ty_to_type_name(va, loc))
    }
    return tn
  }
  if k == tyk_ptr() {
    tn = TypeName.new(loc, "Ptr")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_join() {
    tn = TypeName.new(loc, "JoinHandle")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  TypeName.new(loc, ty.name)
}

pub class CFunSig {
  name: String = ""
  lib_name: String = ""
  params: Array(Ty)
  ret: Ty

  fn initialize(name: String, lib_name: String, params: Array(Ty), ret: Ty) {
    self.name = name
    self.lib_name = lib_name
    self.params = params
    self.ret = ret
  }
}

