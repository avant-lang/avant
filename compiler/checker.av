  pub fn check_codec_call(expr: Expr): Ty? {
    if str_eq(expr.callee, "b64_encode") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "b64_decode") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "zlib_compress") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "zlib_uncompress") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "sha256") {
      return self.check_one_string(expr, self.t_string())
    }
    if str_eq(expr.callee, "b64_encode_buf") {
      return self.check_buf_string(expr)
    }
    if str_eq(expr.callee, "b64_decode_buf") {
      return self.check_buf_string(expr)
    }
    if str_eq(expr.callee, "crc32_bytes") {
      return self.check_i32_bytes(expr)
    }
    if str_eq(expr.callee, "sha256_word0") {
      return self.check_i32_bytes(expr)
    }
    if str_eq(expr.callee, "re_count") {
      if expr.args.size == 3 {
        if b = expr.block {
          self.fail(expr.loc, "re_count takes pattern, text, and caseless")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "re_count takes pattern, text, and caseless")
        return self.t_int()
      }
      pat = self.check_expr_as(expr.args[0], self.t_string())
      text = self.check_expr_as(expr.args[1], self.t_string())
      flags = self.check_expr_as(expr.args[2], self.t_int())
      if ty_assignable(pat, self.t_string()) {
        if ty_assignable(text, self.t_string()) {
        } else {
          self.fail(expr.loc, "re_count expects String pattern and text")
        }
      } else {
        self.fail(expr.loc, "re_count expects String pattern and text")
      }
      if flags.is_int {
      } else {
        self.fail(expr.args[2].loc, "caseless must be Int")
      }
      return self.t_int()
    }
    if str_eq(expr.callee, "re_compile") {
      if expr.args.size == 2 {
        if b = expr.block {
          self.fail(expr.loc, "re_compile takes a pattern and flags")
          return ty_ptr(self.t_void())
        }
      } else {
        self.fail(expr.loc, "re_compile takes a pattern and flags")
        return ty_ptr(self.t_void())
      }
      pat = self.check_expr_as(expr.args[0], self.t_string())
      flags = self.check_expr_as(expr.args[1], self.t_int())
      if ty_assignable(pat, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "re_compile expects String")
      }
      if flags.is_int {
      } else {
        self.fail(expr.args[1].loc, "flags must be Int")
      }
      return ty_ptr(self.t_void())
    }
    if str_eq(expr.callee, "re_find") {
      if expr.args.size == 3 {
        if b = expr.block {
          self.fail(expr.loc, "re_find takes a pattern, a string, and a start")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "re_find takes a pattern, a string, and a start")
        return self.t_int()
      }
      re = self.check_expr(expr.args[0])
      if re.is_ptr {
      } else {
        self.fail(expr.args[0].loc, "re_find expects Ptr(Void)")
      }
      text = self.check_expr_as(expr.args[1], self.t_string())
      from = self.check_expr_as(expr.args[2], self.t_int())
      if ty_assignable(text, self.t_string()) {
      } else {
        self.fail(expr.args[1].loc, "re_find expects String")
      }
      if from.is_int {
      } else {
        self.fail(expr.args[2].loc, "start must be Int")
      }
      return self.t_int()
    }
    if self.re_mark_name(expr.callee) {
      if expr.args.size == 0 {
        if b = expr.block {
          self.fail(expr.loc, "${expr.callee} takes no arguments")
          return self.t_int()
        }
        return self.t_int()
      }
      self.fail(expr.loc, "${expr.callee} takes no arguments")
      return self.t_int()
    }
    nil
  }

  pub fn re_mark_name(name: String): Bool {
    if str_eq(name, "re_m0") {
      return true
    }
    if str_eq(name, "re_m1") {
      return true
    }
    if str_eq(name, "re_c0") {
      return true
    }
    str_eq(name, "re_c1")
  }

  pub fn check_one_string(expr: Expr, ret: Ty): Ty {
    if expr.args.size == 1 {
      if b = expr.block {
        self.fail(expr.loc, "${expr.callee} takes one String")
        return ret
      }
    } else {
      self.fail(expr.loc, "${expr.callee} takes one String")
      return ret
    }
    got = self.check_expr_as(expr.args[0], self.t_string())
    if ty_assignable(got, self.t_string()) {
    } else {
      self.fail(expr.args[0].loc, "${expr.callee} expects String")
    }
    ret
  }

  pub fn check_buf_string(expr: Expr): Ty {
    if expr.args.size == 2 {
      if b = expr.block {
        self.fail(expr.loc, "${expr.callee} takes Buf and String")
        return self.t_void()
      }
    } else {
      self.fail(expr.loc, "${expr.callee} takes Buf and String")
      return self.t_void()
    }
    buf = self.check_expr(expr.args[0])
    if buf.is_buf {
    } else {
      self.fail(expr.args[0].loc, "${expr.callee} expects Buf")
    }
    s = self.check_expr_as(expr.args[1], self.t_string())
    if ty_assignable(s, self.t_string()) {
    } else {
      self.fail(expr.args[1].loc, "${expr.callee} expects String")
    }
    self.t_void()
  }

  pub fn check_i32_bytes(expr: Expr): Ty {
    if expr.args.size == 1 {
      if b = expr.block {
        self.fail(expr.loc, "${expr.callee} takes Array(Int)")
        return self.t_int()
      }
    } else {
      self.fail(expr.loc, "${expr.callee} takes Array(Int)")
      return self.t_int()
    }
    got = self.check_expr(expr.args[0])
    ok = false
    if got.is_array {
      if e = got.inner {
        if e.is_int {
          ok = true
        }
      }
    }
    if ok {
    } else {
      self.fail(expr.args[0].loc, "${expr.callee} expects Array(Int)")
    }
    self.t_int()
  }

  pub fn check_langarena_call(expr: Expr): Ty? {
    if str_eq(expr.callee, "now_us") {
      if expr.args.size == 0 {
        if b = expr.block {
          self.fail(expr.loc, "now_us takes no arguments")
          return self.t_int()
        }
        return self.t_int()
      }
      self.fail(expr.loc, "now_us takes no arguments")
      return self.t_int()
    }
    if str_eq(expr.callee, "repeat_byte") {
      if expr.args.size == 2 {
        if b = expr.block {
          self.fail(expr.loc, "repeat_byte takes a byte and a count")
          return self.t_string()
        }
      } else {
        self.fail(expr.loc, "repeat_byte takes a byte and a count")
        return self.t_string()
      }
      bty = self.check_expr_as(expr.args[0], self.t_int())
      n = self.check_expr_as(expr.args[1], self.t_int())
      if bty.is_int {
      } else {
        self.fail(expr.args[0].loc, "repeat_byte expects Int byte")
      }
      if n.is_int {
      } else {
        self.fail(expr.args[1].loc, "repeat_byte expects Int count")
      }
      return self.t_string()
    }
    if str_eq(expr.callee, "bytes_to_str") {
      return self.check_i32_bytes_to_str(expr)
    }
    if str_eq(expr.callee, "fmt_float") {
      if expr.args.size == 2 {
        if b = expr.block {
          self.fail(expr.loc, "fmt_float takes Float64 and Int")
          return self.t_string()
        }
      } else {
        self.fail(expr.loc, "fmt_float takes Float64 and Int")
        return self.t_string()
      }
      got = self.check_expr(expr.args[0])
      if got.is_numeric {
      } else {
        self.fail(expr.args[0].loc, "fmt_float expects Float64")
      }
      if got.is_float {
