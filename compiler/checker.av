class FuncSig {
  name: String = ""
  node: Function
  params: Array(Ty)
  ret: Ty
  owner: String = ""

  fn initialize(name: String, node: Function, params: Array(Ty), ret: Ty) {
    self.name = name
    self.node = node
    self.params = params
    self.ret = ret
    self.owner = ""
  }

  fn mangled: String {
    if self.owner.size > 0 {
      return "${self.owner}__${self.name}"
    }
    self.name
  }
}

class CFunSig {
  name: String = ""
  lib_name: String = ""
  params: Array(Ty)
  ret: Ty

  fn initialize(name: String, lib_name: String, params: Array(Ty), ret: Ty) {
    self.name = name
    self.lib_name = lib_name
    self.params = params
    self.ret = ret
  }
}

