import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import loader
import typed_ir
import checker.names

pub class Scope {
  pub names: Hash(String, Int)
  // The names a failed statement bound to a failed value's Int (the
  // cascade rule): reading one reports nothing more.
  pub failed: Hash(String, Int)? = nil

  fn initialize {
    n = Hash(String, Int).new()
    self.names = n
  }
}

// The flow facts the checker proves inside one function body (bounds,
// non-nil, capacity, positivity; checker/facts.av), reset per function.
// Their own object, not Checker's payload: while the v0.34.0 seed builds B,
// its type maps lose every reference word past payload word 63 (a fault of
// that seed, fixed in the tree since), so no compiler class may have a
// reference field there (test_fixed_point checks it). Relax after a
// re-seed.
pub class FlowFacts {
  pub fact_var: Array(String) = []
  pub fact_cont: Array(String) = []
  pub fact_slack: Array(Int) = []
  pub fact_live: Array(Int) = []
  pub sv_var: Array(String) = []
  pub sv_cont: Array(String) = []
  pub bv_var: Array(String) = []
  pub bv_cont: Array(String) = []
  pub bv_delta: Array(Int) = []
  pub cs_cont: Array(String) = []
  pub cs_var: Array(String) = []
  pub cs_delta: Array(Int) = []
  pub nn_var: Array(String) = []
  pub cap_var: Array(String) = []
  pub cap_val: Array(Int) = []
  pub gcap_var: Array(String) = []
  pub gcap_val: Array(Int) = []
  pub gcap_live: Array(Int) = []
  pub gnn_var: Array(String) = []
  pub gnn_live: Array(Int) = []
  pub gpos_var: Array(String) = []
  pub gpos_live: Array(Int) = []
  pub gne_var: Array(String) = []
  pub gne_live: Array(Int) = []
  // Where each bound was read (checker/facts.av, "Anchors"): a stamp per
  // fact and per size relation, the proofs made from them, and the
  // containers whose size a statement may have changed.
  pub stamp: Int = 0
  pub fact_anchor: Array(Int) = []
  pub fact_cty: Array(Ty) = []
  pub sv_stamp: Array(Int) = []
  pub bv_stamp: Array(Int) = []
  pub cs_stamp: Array(Int) = []
  pub use_cont: Array(String) = []
  pub use_cty: Array(Ty) = []
  pub use_anchor: Array(Int) = []
  pub use_expr: Array(Expr) = []
  pub kill_cont: Array(String) = []
  // The names a lambda of this function assigns (checker/facts.av lw_has).
  pub lam_written: Array(String) = []
  // Set by a walker that calls fact_after_stmt after the statement it
  // hands to check_block_stmt (checker/spawn.av), which reads and clears it.
  pub after_follows: Bool = false
  // ty_reaches's answers by the two types' mangled names, kept from one
  // function's facts to the next.
  pub reach_memo: Hash(String, Bool) = Hash(String, Bool).new()
}

// The context of a deferred block's statements (Checker.try_in).
pub fn defer_context: String {
  "a deferred block"
}

// The refusal of what would leave a deferred block.
pub fn defer_exit_message(what: String): String {
  way = "a loop or a lambda inside it may use them for itself"
  if what == "postfix ?" {
    way = "handle the failure there with if-assign or ??"
  }
  "${what} inside a deferred block: the block runs on the way out of the block around the defer and cannot leave it (return, ?, and a break or continue of a loop outside the deferred block are refused there); ${way}"
}

pub class Checker {
  source: Source
  pub program: Program
  pub resolver: TypeResolver
  pub functions: Array(FuncSig)
  pub fn_index: Hash(String, Int)
  pub methods: Array(FuncSig)
  pub method_index: Hash(String, Int)
  // Every index of functions (from 1) and of methods by name,
  // ascending: the scans that look for a name visit only these. (a
  // name's list is lists[k], k its entry in the Hash).
  pub fns_named: Hash(String, Int)
  pub methods_named: Hash(String, Int)
  pub fn_lists: Array(Array(Int))
  pub method_lists: Array(Array(Int))
  pub none_named: Array(Int)
  pub cfuns: Array(CFunSig)
  pub cfun_index: Hash(String, Int)
  pub lib_names: Hash(String, Int)
  pub c_symbols: Hash(String, String)
  pub reserved: Set(String)
  pub scopes: Array(Scope)
  failed: Bool = false
  pub err: CompileError? = nil
  pub errors: DiagBag
  resolver_pulled: Int = 0
  // How much of the resolver's bag the checker has seen: its pushes, its
  // hidden errors, and its kept items as of the last pull.
  resolver_pushes: Int = 0
  resolver_hidden: Int = 0
  resolver_kept: Int = 0
  poisoned: Bool = false
  // The error count just after a generic `expected T, got U` (an
  // operand that does not fit the type it is checked with), 0 when the
  // last error is another: the cascade rule lets the reader's own message
  // replace it.
  weak_at: Int = 0
  // The bounds of generic types' instances (checker/lambda.av
  // check_bound_uses): tested once the opt-ins are known, the resolver's
  // list read up to bound_done.
  pub bounds_ready: Bool = false
  pub bound_done: Int = 0
  pub in_bounds: Bool = false
  // The resolver's Hash types with a struct key (checker/equality.av
  // check_hash_key_uses), read up to hash_key_done once bounds_ready.
  pub hash_key_done: Int = 0
  // The type parameters of the function being inferred that are bounded
  // by Error (`E: Error`): in a union they take the members marked Error.
  pub infer_err_params: Array(String) = []
  // Set while a constructor's arguments are matched against initialize:
  // its messages name the call as written, T.new.
  pub in_new: Bool = false
  // The target of the assignment being checked: `x.name = v` with name a
  // method is refused as an assignment, not taken for a call.
  pub target_expr: Expr? = nil
  pub return_type: Ty
  pub loop_depth: Int = 0
  pub self_ty: Ty? = nil
  // Set while the receiver of `x.f` or `x.f(...)` is checked, a bare
  // name: an unknown name there that names a type leaves the type's name
  // in recv_type for the caller's message.
  pub recv_name: Bool = false
  // The C array field the next field read names (`r.vtype`, a `T[N]`) is
  // allowed: its reader is `r.vtype[i]`, `r.vtype.size` or
  // `r.vtype.to_s()`, which sets this for its own object only.
  pub carray_ok: Bool = false
  pub recv_type: String = ""
  pub self_name: String = ""
  pub pending: Array(Function)
  pub instances: Array(Function)
  next_ol: Int = 1
  pub current_module: String = ""
  pub call_mod: String = ""
  pub root_module: String = ""
  pub type_mod: Hash(String, String)
  pub type_vis: Hash(String, Int)
  pub type_list: Hash(String, String)
  pub type_multi: Hash(String, Int)
  // Each type alias's type by type_slot(module, name), resolved once where
  // it is declared (check_aliases); an alias whose body failed is absent.
  pub alias_tys: Hash(String, Ty)
  pub lib_mod: Hash(String, String)
  pub lib_vis: Hash(String, Int)
  pub known_mods: Hash(String, Int)
  // The last names of the imports that have a dot (std.time: time), so a
  // name that is none of them is not looked at twice (qualify_last_name).
  pub last_names: Hash(String, Int)
  // The module constants (checker/consts.av), and each one's index
  // there by module and name (const_slot).
  pub const_list: Array(ConstVal)
  pub const_vals: Hash(String, Int)
  // The start-up order of the constant whose value is being checked
  // (checker/const_values.av), -1 elsewhere.
  pub const_checking: Int = -1
  pub current_fn: Function? = nil
  // The `Mutex(T).new(name)` calls of the function being checked, whose
  // names they consume (checker/guard.av check_consumes).
  pub consumes: Array(Expr) = []
  // For each, the name it consumes, the type it is taken as and where
  // (a spawn's: the class moved into the task, and the block's first use
  // of the name).
  pub consume_names: Array(String) = []
  pub consume_tys: Array(Ty) = []
  pub consume_locs: Array(Location) = []
  // The types `Mutex(T).new` guards and where, checked once the whole
  // program is (checker/guard.av check_guarded_types), and the types
  // already found fit.
  pub guarded: Array(Ty) = []
  pub guarded_at: Array(Location) = []
  // "spawn" for a class a spawn takes by move, else "".
  pub guarded_by: Array(String) = []
  pub guarded_ok: Set(String) = Set(String).new()
  // The method calls on an element of an Array a running task reads
  // (`xs[0].bump`), in a spawn block (1), in the sender (2) or in a
  // `.parallel` body (3), with the
  // array's name: refused once the whole program is checked when the
  // method changes its receiver (checker/spawn.av
  // check_element_writes).
  pub elem_calls: Array(Expr) = []
  pub elem_roots: Array(String) = []
  pub elem_sides: Array(Int) = []
  // The classes of Mutex and Channel fields that crossed a task as a
  // handle, where, and the name or value that crossed: refused once the
  // whole program is checked if a field of one is assigned outside its
  // initialize (checker/spawn.av check_handle_classes).
  pub handle_tys: Array(Ty) = []
  pub handle_at: Array(Location) = []
  pub handle_what: Array(String) = []
  pub lam_exprs: Array(Expr)
  pub lam_scopes: Array(Int)
  pub lambda_infer: Bool = false
  pub inferred_ret: Ty
  // In a lambda whose result is inferred: whether a `return` or its end
  // gave the result yet, where, and whether that was a bare `return` or
  // an end without a value (every one must agree: note_inferred).
  pub inferred_seen: Bool = false
  pub inferred_at: String = ""
  pub inferred_tail: Bool = false
  // A lambda a builtin inlines as a loop (`xs.each((x) { ... })`,
  // Block.paren): the builtin's name for the messages, and the block
  // whose `return` ends one run of the body (checker/lambda.av
  // inline_enter). Empty and nil in a function or a lambda of its own.
  pub inline_what: String = ""
  pub inline_target: Block? = nil
  pub spawn_skip: Array(String)
  pub pending_handles: Array(String)
  pub pending_arrays: Array(String)
  pub facts: FlowFacts
  pub adopted: Hash(String, Int)
  pub adopt_pending: Bool = false
  pub ready_adopt: Bool = false
  pub in_adopt: Bool = false
  pub in_task: Int = 0
  // Where a postfix `?` stands when it cannot return from the body around it
  // ("a spawn block"); empty in a function or lambda body.
  pub try_in: String = ""
  // The failures a spawn block's `?` passes up (check_spawn): the
  // block's value is a union with them.
  pub spawn_fails: Array(Ty) = []
  // Checking a field default (evaluated before initialize, with no
  // receiver).
  pub in_default: Bool = false
  // The names of the named arguments of the call being matched
  // (check_call), for fail_no_fit's message.
  pub named_now: Array(String) = []
  // The arguments of that call, so fail_no_fit shows a `[]` or a wide
  // integer literal as written, not as its stand-in type.
  pub args_now: Array(Expr) = []
  // The class whose field defaults are being checked: a bare name of
  // one of its fields gets its own message.
  pub default_owner: Ty? = nil
  // What a postfix `?` returns from, for its messages.
  pub try_body: String = "the function"
  // The position of a `with` call used as a statement (check_stmt): its
  // block's value is dropped, so the block ends however it likes.
  pub with_drop: String = ""
  // Set by check_stmt for a switch used as a statement: its arms are
  // statements, as an `if`'s; check_switch reads and clears it.
  pub switch_stmt: Bool = false
  // A function's last switch, checked against the result type: when
  // every arm gives one type, that type is the switch's, converted once
  // at the tail as before.
  pub switch_tail: Bool = false
  // A switch's discriminant already typed (a union's text,
  // checker/printing.av union_text): check_switch takes it instead of
  // checking the discriminant again, and clears it.
  pub switch_pre: Ty? = nil
  // Checking the body of a `fn main: Void | E` (checker/entry.av): a bare
  // return returns 0; a lambda's body clears it.
  pub entry_void: Bool = false
  // Why the last inference failed, when a union's type parameters split
  // the argument in more than one way (checker/match.av infer_subst):
  // added to "cannot infer type argument".
  pub infer_note: String = ""
  // The receiver of the method call being matched when it is an Array,
  // a Hash or a Set (dispatch_method): a program's method on one of them
  // fits by its receiver's declared type, a pattern when it is generic.
  pub match_recv: Ty? = nil
  // True while a call's bare integer literal argument is checked before
  // its parameter is known: a value above Int's range is then a UInt64,
  // and the parameter's type decides (fit_call_arg).
  pub lit_arg: Bool = false
  // True while check_if_value checks the final if/else of a lambda whose
  // result type is inferred: branches that all give nothing make it a
  // statement (Void) rather than an error.
  pub if_void_ok: Bool = false
  // Inside the block of `Array(T).new(n, (i) { ... })` (how deep): a
  // `break` or `continue` there gets its own message.
  pub in_build: Int = 0
  // The calls whose defaults name an earlier parameter, counted
  // (fill_defaults): each gets the next number as its argument frame.
  pub arg_frames: Int = 0
  // The variables of the `for` loops being checked: each one's name,
  // the scope that holds it, and 3 for a range's counter or 4 for an
  // array's element (the parser's for_kind of the loop's own store).
  // The program may not assign one.
  pub for_names: Array(String) = []
  pub for_scopes: Array(Int) = []
  pub for_kinds: Array(Int) = []
  // The places being checked (checker/receiver.av): a `for` variable or
  // an inlined block's parameter over an Array of structs is the element
  // itself. Each one's name and scope, the hidden names of the walked
  // array and of the counter, the walked array's path as written ("" when
  // it is not a name or a field path), and the lambda and task depths
  // where it is bound.
  pub place_names: Array(String) = []
  pub place_scopes: Array(Int) = []
  pub place_arrs: Array(String) = []
  pub place_idxs: Array(String) = []
  pub place_walked: Array(String) = []
  pub place_lams: Array(Int) = []
  pub place_tasks: Array(Int) = []
  pub place_count: Int = 0
  // The arrays walked here whose element is not a place (a `for` or an
  // `each`, `any` or `all` over plain values), as written: a sort or a
  // reverse of one through its own name inside its walk is refused.
  pub walk_texts: Array(String) = []
  // A walk's hidden array by name, and the name of the array it holds
  // (its root): the task rules read a write through the place as one
  // through that name.
  pub place_roots: Hash(String, String) = Hash(String, String).new()
  // Calls of a struct method on a copy that would be lost (a comparator's
  // parameter, a Hash walk's value, a .parallel body's element), and what
  // each parameter is: refused once every method is checked when the
  // method changes its receiver.
  pub copy_calls: Array(Expr) = []
  pub copy_call_names: Array(String) = []
  pub copy_call_kinds: Array(Int) = []
  pub witness_note: String = ""
  pub impls: Array(ImplFact)
  pub sig_params: Array(Ty)
  pub sig_ret: Ty
  pub sig_vars: Array(String)
  pub wit_params: Array(Ty)
  pub wit_ret: Ty
  pub wit_vars: Array(String)

  fn initialize(source: Source, program: Program) {
    self.source = source
    self.program = program
    self.resolver = TypeResolver.new()
    fns: Array(FuncSig) = []
    dummy_fn = Function.new(program.loc, "")
    dummy_params: Array(Ty) = []
    fns.push(FuncSig.new("", dummy_fn, dummy_params, ty_void()))
    self.functions = fns
    fi = Hash(String, Int).new()
    self.fn_index = fi
    self.methods = []
    mi = Hash(String, Int).new()
    self.method_index = mi
    self.fns_named = Hash(String, Int).new()
    self.methods_named = Hash(String, Int).new()
    self.fn_lists = []
    self.method_lists = []
    self.none_named = []
    self.cfuns = []
    cfi = Hash(String, Int).new()
    self.cfun_index = cfi
    ln = Hash(String, Int).new()
    self.lib_names = ln
    cs = Hash(String, String).new()
    self.c_symbols = cs
    self.reserved = reserved_c_names()
    self.scopes = []
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new()
    self.resolver_pulled = 0
    self.resolver_pushes = 0
    self.resolver_hidden = 0
    self.resolver_kept = 0
    self.poisoned = false
    self.return_type = ty_void()
    self.loop_depth = 0
    self.self_name = ""
    self.pending = []
    self.instances = []
    self.next_ol = 1
    self.current_module = ""
    self.root_module = ""
    tm = Hash(String, String).new()
    self.type_mod = tm
    tv = Hash(String, Int).new()
    self.type_vis = tv
    tl = Hash(String, String).new()
    self.type_list = tl
    tmu = Hash(String, Int).new()
    self.type_multi = tmu
    ats = Hash(String, Ty).new()
    self.alias_tys = ats
    lm = Hash(String, String).new()
    self.lib_mod = lm
    lv = Hash(String, Int).new()
    self.lib_vis = lv
    km = Hash(String, Int).new()
    self.known_mods = km
    lnm = Hash(String, Int).new()
    self.last_names = lnm
    self.const_list = []
    self.const_vals = Hash(String, Int).new()
    self.lam_exprs = []
    self.lam_scopes = []
    self.lambda_infer = false
    self.inferred_ret = ty_void()
    self.spawn_skip = []
    self.pending_handles = []
    self.pending_arrays = []
    self.facts = FlowFacts.new()
    ad = Hash(String, Int).new()
    self.adopted = ad
    self.adopt_pending = false
    self.ready_adopt = false
    self.in_adopt = false
    self.in_task = 0
    self.impls = []
    self.sig_params = []
    self.sig_ret = ty_void()
    self.sig_vars = []
    self.wit_params = []
    self.wit_ret = ty_void()
    self.wit_vars = []
  }

  pub fn has_err: Bool {
    self.poisoned
  }

  pub fn any_err: Bool {
    self.failed
  }

  // Every error counts, kept or not: see Resolver.
  pub fn err_count: Int {
    self.errors.pushes
  }

  pub fn new_err_since(mark: Int): Bool {
    self.errors.pushes > mark
  }

  pub fn clear_poison {
    self.poisoned = false
    self.weak_at = 0
  }

  // The cascade rule: an expression whose type already failed is not
  // reported again. Once a statement has an error (poisoned, cleared
  // before each statement), what reads the failed part (an operator, a
  // call, a condition, an assignment) adds no message of its own; a name
  // the statement bound is failed too (bind), so a later statement that
  // reads it reports nothing either (check_name). The silenced error still
  // counts as a repeat, so every mark (new_err_since) sees it, and the
  // compile still fails. One exception keeps the clearer message: when the
  // statement's error is the generic `expected T, got U` of an operand
  // (check_expr_flag), the reader's own message about it (`binary operator
  // expects matching types`, `cannot assign`, `return type is`) takes its
  // place. A name that does not exist (`unknown function f`) reads no type
  // and is never a cascade: it is reported in a statement that already
  // failed too.
  pub fn cascaded(message: String): Bool {
    if !self.poisoned || names_missing(message) {
      return false
    }
    if self.weak_at > 0 && self.weak_at == self.errors.pushes {
      self.errors.truncate(self.weak_at - 1)
      self.weak_at = 0
      if self.errors.count() == 0 {
        self.err = nil
      }
      return false
    }
    self.errors.note(1, false)
    true
  }

  pub fn names_missing(message: String): Bool {
    for w in ["unknown name ", "unknown function ", "unknown type ", "unknown module "] {
      if message.size > w.size && message.starts_with(w) {
        return true
      }
    }
    false
  }

  pub fn fail(loc: Location, message: String) {
    if cascaded(message) {
      return
    }
    e = CompileError.new(loc, diag_code(4, message), message)
    if self.errors.count() == 0 {
      self.err = e
    }
    self.failed = true
    self.poisoned = true
    self.errors.push(e)
  }

  // An error that makes no type fail: the checker goes on with the type
  // it has (a field that is private still has its type, and a literal
  // with a private field is still of its type). It poisons nothing, so a
  // second, independent mistake in the same statement is reported too,
  // and it is reported in a statement that already failed (it reads no
  // failed type, as an unknown name reads none).
  pub fn fail_alone(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(4, message), message)
    if self.errors.count() == 0 {
      self.err = e
    }
    self.failed = true
    self.errors.push(e)
  }

  // An error with a hint after it (" (did you mean `x`?)"): the
  // code is the message's, whatever the hint says.
  pub fn fail_hint(loc: Location, message: String, hint: String) {
    if cascaded(message) {
      return
    }
    e = CompileError.new(loc, diag_code(4, message), "${message}${hint}")
    if self.errors.count() == 0 {
      self.err = e
    }
    self.failed = true
    self.poisoned = true
    self.errors.push(e)
  }

  pub fn pull_resolve {
    while self.resolver_pulled < self.resolver.errors.count() {
      re = self.resolver.errors.items[self.resolver_pulled]
      if self.errors.count() == 0 {
        self.err = re
      }
      self.failed = true
      self.poisoned = true
      self.errors.push(re)
      self.resolver_pulled += 1
    }
    if self.resolver_pushes < self.resolver.errors.pushes {
      // The resolver's errors it did not keep: repeats and those past its
      // cap are errors here too, and the ones past the cap count in "and
      // N more errors".
      hidden = self.resolver.errors.suppressed - self.resolver_hidden
      kept = self.resolver_pulled - self.resolver_kept
      repeats = self.resolver.errors.pushes - self.resolver_pushes - hidden - kept
      self.errors.note(hidden, true)
      self.errors.note(repeats, false)
      self.failed = true
      self.poisoned = true
      self.resolver_hidden = self.resolver.errors.suppressed
      self.resolver_pushes = self.resolver.errors.pushes
    }
    self.resolver_kept = self.resolver_pulled
    if self.bounds_ready && !self.in_bounds && (self.bound_done < self.resolver.bound_uses.size || self.hash_key_done < self.resolver.hash_key_uses.size) {
      check_bound_uses()
    }
    if self.ready_adopt && !self.in_adopt {
      saved: Array(String) = []
      saved.concat(self.resolver.tparam_names)
      self.resolver.clear_tparams()
      self.adopt_new_types()
      self.resolver.set_tparams(saved)
    }
  }

  pub fn intern(ty: Ty): Int {
    self.resolver.intern(ty)
  }

  pub fn push_scope {
    self.scopes.push(Scope.new())
  }

  pub fn pop_scope {
    self.scopes.pop()
  }

  pub fn bind(name: String, ty: Ty) {
    // A new variable, maybe hiding another of its name: the facts are
    // keyed by name, and none of the hidden one's holds for it.
    forget_facts(name)
    id = intern(ty)
    last = self.scopes[self.scopes.size - 1]
    last.names[name] = id
    if self.poisoned && ty.is_int() {
      if fs = last.failed {
        fs[name] = 1
      } else {
        fs2 = Hash(String, Int).new()
        fs2[name] = 1
        last.failed = fs2
      }
    } else if fs3 = last.failed {
      fs3.delete(name)
    }
  }

  // A name assigned a value that checked (or declared with a type that
  // resolved) is no longer failed.
  pub fn unfail(name: String) {
    i = lookup_index(name)
    if i >= 0 {
      if fs = self.scopes[i].failed {
        fs.delete(name)
      }
    }
  }

  // Marks a bound name failed, as bind does after a failed statement:
  // its readers add no message (a for loop's operand that cannot be
  // walked, whose element reads would each say so again).
  pub fn mark_failed(name: String) {
    i = lookup_index(name)
    if i < 0 {
      return
    }
    if fs = self.scopes[i].failed {
      fs[name] = 1
    } else {
      fs2 = Hash(String, Int).new()
      fs2[name] = 1
      self.scopes[i].failed = fs2
    }
  }

  // A name bound by a statement that failed (bind), in the scope that
  // binds it now.
  pub fn name_failed(name: String): Bool {
    i = lookup_index(name)
    if i < 0 {
      return false
    }
    if fs = self.scopes[i].failed {
      if _ = fs.get(name) {
        return true
      }
    }
    false
  }

  // A failed name is one a statement bound to the type a failed
  // expression is given (Int: what every check returns after its error).
  // Reading a failed name (the cascade rule): the statement is poisoned
  // without a message of its own, so what reads the name adds none.
  pub fn read_failed_name {
    self.failed = true
    self.poisoned = true
    self.errors.note(1, false)
  }

  pub fn lookup(name: String): Ty? {
    i = self.scopes.size - 1
    while i >= 0 {
      sc = self.scopes[i]
      if id = sc.names.get(name) {
        return self.resolver.ty_at(id)
      }
      i -= 1
    }
    nil
  }

  pub fn lookup_index(name: String): Int {
    i = self.scopes.size - 1
    while i >= 0 {
      sc = self.scopes[i]
      if id = sc.names.get(name) {
        return i
      }
      i -= 1
    }
    -1
  }

  pub fn alloc_ol(fnn: Function) {
    fnn.ol_index = self.next_ol
    self.next_ol += 1
  }

  pub fn t_int: Ty { self.resolver.t_int }
  pub fn t_uint64: Ty { self.resolver.t_uint64 }
  pub fn t_bool: Ty { self.resolver.t_bool }
  pub fn t_float: Ty { self.resolver.t_float }
  pub fn t_string: Ty { self.resolver.t_string }
  pub fn t_void: Ty { self.resolver.t_void }
  pub fn t_nil: Ty { self.resolver.t_nil }
  pub fn t_buf: Ty { self.resolver.t_buf }
  pub fn t_bytes: Ty { self.resolver.t_bytes }

  pub fn is_ordered_ty(ty: Ty): Bool {
    if ty.is_integer() {
      return true
    }
    if ty.is_uint64() {
      return true
    }
    if ty.is_float() {
      return true
    }
    if ty.is_string() {
      return true
    }
    if ty.is_bool() {
      return true
    }
    ty.is_bytes()
  }

  pub fn is_numeric_ty(ty: Ty): Bool {
    if ty.is_integer() {
      return true
    }
    if ty.is_uint64() {
      return true
    }
    ty.is_float()
  }

  pub fn check_function(fnn: Function) {
    self.clear_poison()
    saved_mod = self.current_module
    self.current_module = fnn.mod_name
    ret = t_void()
    params: Array(Ty) = []
    if sig = find_sig_by_node(fnn) {
      ret = sig.ret
      params = sig.params
    } else {
      fail(fnn.loc, "unknown function ${fnn.name}")
      self.current_module = saved_mod
      return
    }
    self.return_type = ret
    self.pending_handles = []
    self.pending_arrays = []
    memo = self.facts.reach_memo
    self.facts = FlowFacts.new()
    self.facts.reach_memo = memo
    // `fn main: Void | E` ends returning 0 (checker/entry.av).
    self.entry_void = fnn.entry_void
    if fnn.entry_void && fallthrough(fnn.body) {
      fnn.body.push(stmt_expr(fnn.loc, entry_zero(fnn.loc)))
    }
    // A `Void | E` result: the end of the body is the success, as a bare
    // `return` is (check_stmt).
    if !fnn.entry_void && ret.is_union() && ret.includes_void() && fallthrough(fnn.body) {
      fnn.body.push(stmt_expr(fnn.loc, Expr.new(ex_void(), fnn.loc)))
    }
    if !ret.is_void() && fnn.body.size == 0 {
      fail(fnn.loc, "missing return value")
      self.current_module = saved_mod
      return
    }
    self.self_ty = nil
    self.self_name = ""
    self.for_names = []
    self.for_scopes = []
    self.for_kinds = []
    self.clear_places()
    self.walk_texts = []
    self.push_scope()
    if fn_is_method(fnn) && !fnn.type_method {
      got_owner = false
      owner = t_int()
      if fnn.owner_mod.size > 0 {
        if o = self.resolver.get_named_in(fnn.owner_mod, fnn.owner) {
          owner = o
          got_owner = true
        }
      }
      if !got_owner {
        if o2 = self.resolver.get_named(fnn.owner) {
          owner = o2
          got_owner = true
        }
      }
      if got_owner {
        self.self_ty = owner
        self.self_name = fn_self_name(fnn)
        if existing = lookup(self.self_name) {
          fail(fnn.loc, "duplicate parameter ${self.self_name}")
          self.pop_scope()
          self.current_module = saved_mod
          return
        }
        bind(self.self_name, owner)
      } else {
        if recv = fnn.receiver {
          ty = resolve_in_module(recv.type)
          self.pull_resolve()
          if ptr_method_ok(ty) || builtin_receiver_ok(ty) || container_owner(ty).size > 0 {
            self.self_name = recv.name
            if existing = lookup(self.self_name) {
              fail(fnn.loc, "duplicate parameter ${self.self_name}")
              self.pop_scope()
              self.current_module = saved_mod
              return
            }
            bind(self.self_name, ty)
          }
        }
      }
    }
    i = 0
    while i < fnn.params.size {
      param = fnn.params[i]
      if existing = lookup(param.name) {
        fail(param.loc, "duplicate parameter ${param.name}")
        self.pop_scope()
        self.current_module = saved_mod
        return
      }
      bind(param.name, params[i])
      if default = param.default {
        earlier: Array(String) = []
        j = 0
        while j < i {
          earlier.push(fnn.params[j].name)
          j += 1
        }
        hit = default_assigns(default, earlier)
        if hit.size > 0 {
          fail(default.loc, "the default of ${param.name} assigns to the earlier parameter ${hit}: a default only reads the parameters before it (the assignment would change a copy no one else sees); compute the new value in the function's body")
          self.pop_scope()
          self.current_module = saved_mod
          return
        }
        saved = self.self_ty
        self.self_ty = nil
        got = check_expr_as(default, params[i])
        self.self_ty = saved
        if !ty_assignable(got, params[i]) {
          fail(default.loc, "cannot assign ${got.show()} to ${params[i].show()}")
          self.pop_scope()
          self.current_module = saved_mod
          return
        }
      }
      i += 1
    }
    self.current_fn = fnn
    saved_consumes = self.consumes
    saved_cn = self.consume_names
    saved_ct = self.consume_tys
    saved_cl = self.consume_locs
    self.consumes = []
    self.consume_names = []
    self.consume_tys = []
    self.consume_locs = []
    check_body(fnn.body, ret, true)
    if self.consumes.size > 0 && !self.has_err() {
      check_consumes(fnn.body)
    }
    self.consumes = saved_consumes
    self.consume_names = saved_cn
    self.consume_tys = saved_ct
    self.consume_locs = saved_cl
    self.current_fn = nil
    self.pop_scope()
    self.self_ty = nil
    self.self_name = ""
    self.current_module = saved_mod
  }

  // The value of a module constant computed before main
  // (checker/const_values.av), checked as the body of fnn, a function
  // with no parameters whose result is the value's type: the state a
  // function's check starts from, the value checked with no type
  // expected. Its type, or nil after an error.
  pub fn check_const_value(fnn: Function, value: Expr): Ty? {
    self.clear_poison()
    saved_mod = self.current_module
    self.current_module = fnn.mod_name
    self.return_type = t_void()
    self.pending_handles = []
    self.pending_arrays = []
    memo = self.facts.reach_memo
    self.facts = FlowFacts.new()
    self.facts.reach_memo = memo
    self.entry_void = false
    self.self_ty = nil
    self.self_name = ""
    self.for_names = []
    self.for_scopes = []
    self.for_kinds = []
    self.clear_places()
    self.walk_texts = []
    self.push_scope()
    self.current_fn = fnn
    mark = self.err_count()
    got = check_expr(value)
    self.current_fn = nil
    self.pop_scope()
    self.current_module = saved_mod
    if new_err_since(mark) || self.has_err() {
      return nil
    }
    got
  }

  // A result of a lambda whose result type is inferred: the first one
  // met is the result; every later `return` and the end must give the
  // same type (before, the last one met won, and a bare `return` beside
  // a value, or a `return "one"` beside an `Int` end, reached the MIR
  // verifier). A difference names both and asks for the result type.
  pub fn note_inferred(got: Ty, loc: Location, by_return: Bool) {
    if !self.inferred_seen {
      self.inferred_seen = true
      self.inferred_ret = got
      self.inferred_at = "${inferred_how(got, by_return)} at ${loc.line()}:${loc.column()}"
      return
    }
    if got.same_as(self.inferred_ret) {
      return
    }
    if self.inferred_ret.is_void() {
      // The value, so the uses of the lambda are not reported again.
      self.inferred_ret = got
    }
    fail(loc, "this lambda ${inferred_how(got, by_return)} here and ${self.inferred_at}: every return and its end give one result; write the result type, as (x: Int): Int? { ... }, or make them agree")
  }

  pub fn inferred_how(t: Ty, by_return: Bool): String {
    if by_return {
      if t.is_void() {
        return "returns nothing"
      }
      return "returns ${t.show()}"
    }
    if t.is_void() {
      return "ends without a value"
    }
    "ends with ${t.show()}"
  }

  // The refusal of a `break`, a `continue` or a `?` in a lambda a
  // builtin inlines (checker/lambda.av inline_enter).
  pub fn inline_exit_message(what: String, builtin: String): String {
    way = "handle it with if-assign or ??"
    if inline_walks(builtin) {
      way = "to leave the walk or the function early, write it as a for loop (for x in xs { ... })"
    }
    if what == "?" {
      if inline_walks(builtin) {
        way = "write the walk as a for loop, where ? returns from the function (for x in xs { ... }), or handle it with if-assign or ??"
      }
      return "postfix ? inside a lambda given to ${builtin} has nowhere to return its failure (return there ends only the lambda's run); ${way}"
    }
    if what == "continue" {
      return "continue inside a lambda given to ${builtin}: the lambda has no loop of its own; return ends this run of it"
    }
    "break inside a lambda given to ${builtin}: the lambda has no loop of its own to leave; ${way}"
  }

  pub fn check_body(body: Array(Stmt), expected: Ty, at_tail: Bool) {
    i = 0
    while i < body.size {
      last = false
      if at_tail && i == body.size - 1 {
        last = true
      }
      if body[i].kind == st_while() && i > 0 {
        annotate_vstep(body[i - 1], body[i])
      }
      self.clear_poison()
      self.facts.after_follows = true
      check_block_stmt(body[i], expected, last)
      if !self.has_err() {
        fact_after_stmt(body[i])
      }
      i += 1
    }
  }

  pub fn check_block(body: Array(Stmt), expected: Ty, at_tail: Bool) {
    // A block's statements have their own errors: after it the statement
    // that holds it is failed only if its own parts are (a condition), so
    // its later checks (a missing return value) are not taken for
    // cascades of an error inside the block.
    saved_poison = self.poisoned
    saved_weak = self.weak_at
    self.push_scope()
    check_body(body, expected, at_tail)
    self.pop_scope()
    self.poisoned = saved_poison
    self.weak_at = saved_weak
  }

  // `defer { body }`: the body runs later, on the way out of the block
  // around it, so it is checked where it is written without the flow
  // facts of the code around it (a size or a bound proven there may not
  // hold by then), as a block that cannot leave: `return`, `?`, and a
  // `break` or `continue` of a loop outside it are refused (try_in and
  // loop_depth, which a lambda or a task inside it sets for itself).
  // What the body changes reaches the code around it as a statement's
  // changes do: the loop around it reads the containers it shrinks, and
  // the names its lambdas assign carry no fact after it.
  pub fn check_defer(stmt: Stmt) {
    saved_try = self.try_in
    saved_loops = self.loop_depth
    outer = self.facts
    inner = FlowFacts.new()
    inner.reach_memo = outer.reach_memo
    inner.lam_written.concat(outer.lam_written)
    known = inner.lam_written.size
    self.facts = inner
    self.try_in = defer_context()
    self.loop_depth = 0
    check_block(stmt.body, t_void(), false)
    self.try_in = saved_try
    self.loop_depth = saved_loops
    self.facts = outer
    outer.kill_cont.concat(inner.kill_cont)
    if inner.lam_written.size > known {
      written: Array(String) = []
      for wi in known..inner.lam_written.size {
        written.push(inner.lam_written[wi])
      }
      lambda_writes(written)
    }
  }

  pub fn fallthrough(body: Array(Stmt)): Bool {
    if body.size == 0 {
      return true
    }
    last = body[body.size - 1]
    if last.kind == st_return() || ast_stmt_exits(last) {
      return false
    }
    if last.kind == st_hold() || last.kind == st_pin() {
      // A `gc.hold` or `pin(x)` block ends its function when its own
      // body does (before, a `pin` block whose body returned was
      // "missing return value" at a function's tail).
      return fallthrough(last.body)
    }
    if last.kind == st_if() {
      if last.else_body.size == 0 {
        return true
      }
      if fallthrough(last.then_body) {
        return true
      }
      if fallthrough(last.else_body) {
        return true
      }
      return false
    }
    true
  }

  pub fn check_stmt(stmt: Stmt, expected: Ty, at_tail: Bool) {
    if self.has_err() {
      return
    }
    k = stmt.kind
    if k == st_return() {
      if self.try_in == defer_context() {
        fail(stmt.loc, defer_exit_message("return"))
        return
      }
      if self.try_in == "a spawn block" || self.try_in == "a parallel block" {
        // A spawn or `.parallel` block cannot return: its value is its
        // last expression. Before, its statements were checked against
        // Void, so `return 3` was a type mismatch and a bare `return`
        // reached the MIR verifier.
        fail(stmt.loc, "return inside ${self.try_in}: ${self.try_in} cannot return; its value is its last expression")
        return
      }
      if t = self.inline_target {
        t.returns = true
        if self.return_type.is_var() {
          fail(stmt.loc, "return inside a lambda given to ${self.inline_what}, whose value is its last expression: to return early, write the lambda's result type, as (x): Int { ... }")
          return
        }
      }
      if self.lambda_infer {
        if expr = stmt.expr {
          note_inferred(check_expr(expr), stmt.loc, true)
        } else {
          note_inferred(t_void(), stmt.loc, true)
        }
        return
      }
      if expr = stmt.expr {
        got = check_expr_as(expr, expected)
        if reject_clayout_value(got, expr.loc) {
          return
        }
        if !ty_assignable(got, expected) {
          fail(stmt.loc, "return type is ${got.show()}, expected ${expected.show()}")
        }
      } else if self.entry_void {
        // A bare return of `fn main: Void | E` returns 0.
        zero = entry_zero(stmt.loc)
        stmt.expr = zero
        check_expr_as(zero, expected)
      } else if expected.is_union() && expected.includes_void() {
        // A bare return of a `Void | E` result is the success.
        none = Expr.new(ex_void(), stmt.loc)
        stmt.expr = none
        check_expr_as(none, expected)
      } else {
        if !expected.is_void() {
          fail(stmt.loc, "return needs a value of type ${expected.show()}")
        }
      }
      return
    }
    if k == st_if() {
      if at_tail && stmt.else_body.size > 0 && self.lambda_infer && (fallthrough(stmt.then_body) || fallthrough(stmt.else_body)) {
        // The final if/else of a lambda whose result type is inferred is
        // its value when its branches end in values, as in a function
        // with a declared result; branches that give nothing keep it a
        // statement.
        self.if_void_ok = true
        got = check_if_value(stmt, false, t_void())
        if t2 = got, !t2.is_void() {
          stmt.tail_value = true
          note_inferred(t2, stmt.loc, false)
          self.inferred_tail = true
        }
        return
      }
      if at_tail && stmt.else_body.size > 0 && !expected.is_void() && !self.lambda_infer && (fallthrough(stmt.then_body) || fallthrough(stmt.else_body)) {
        // A final if/else whose branches end in values is the function's
        // value (before, "missing return value").
        stmt.tail_value = true
        if t2 = check_if_value(stmt, true, expected) {
          return
        }
        fail(stmt.loc, "missing return value")
        return
      }
      if stmt.pre.size > 0 {
        check_if_chain(stmt, expected, at_tail)
        return
      }
      if stmt.bind.size > 0 {
        check_if_assign(stmt, expected, at_tail)
        return
      }
      saved_facts = self.facts.fact_var.size
      if cond = stmt.cond {
        push_loop_facts(cond, stmt.then_body)
      }
      if cond = stmt.cond {
        ct = check_expr(cond)
        if !ct.is_bool() {
          fail(cond.loc, "if condition must be Bool, got ${ct.show()}")
        }
      }
      saved_gcap = self.facts.gcap_var.size
      saved_gnn = self.facts.gnn_var.size
      saved_gpos = self.facts.gpos_var.size
      saved_gne = self.facts.gne_var.size
      if cond = stmt.cond {
        push_loop_facts(cond, stmt.then_body)
        push_guard_facts(cond)
        for fi in saved_facts..self.facts.fact_var.size {
          if body_shrinks(stmt.then_body, self.facts.fact_cont[fi]) {
            self.facts.fact_live[fi] = 0
          }
        }
      }
      check_block(stmt.then_body, expected, false)
      cap_kill_assigned_in(stmt.then_body)
      pop_guard_facts(saved_gcap, saved_gnn, saved_gpos, saved_gne)
      pop_loop_facts(saved_facts)
      if stmt.else_bind.size > 0 {
        check_else_bind(stmt)
        return
      }
      if stmt.else_body.size > 0 {
        check_block(stmt.else_body, expected, false)
        cap_kill_assigned_in(stmt.else_body)
      }
      if at_tail && !expected.is_void() {
        ok = false
        if stmt.else_body.size > 0 && !fallthrough(stmt.then_body) && !fallthrough(stmt.else_body) {
          ok = true
        }
        if !ok {
          fail(stmt.loc, "missing return value")
        }
      }
      return
    }
    if k == st_release() {
      if e = stmt.expr {
        et = check_expr(e)
        if !self.has_err() {
          check_release(e, et)
        }
      }
      if at_tail && !expected.is_void() {
        fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_defer() {
      check_defer(stmt)
      return
    }
    if k == st_hold() {
      check_hold(stmt)
      check_block(stmt.body, expected, false)
      if at_tail && !(expected.is_void() || !fallthrough(stmt.body)) {
        fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_pin() {
      if e = stmt.expr {
        et = check_expr(e)
        heap = et.is_string() || et.is_bytes() || et.is_buf() || et.is_array() || et.is_hash() || et.is_class() || et.is_fn() || et.is_join()
        if !heap {
          fail(e.loc, "pin needs a heap value, got ${et.show()}")
        }
      }
      check_block(stmt.body, expected, false)
      if at_tail && !(expected.is_void() || !fallthrough(stmt.body)) {
        fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_while() {
      if stmt.for_kind == range_kind_pending() {
        resolve_range_step(stmt)
      }
      has_pre = stmt.pre.size > 0
      saved_for = self.for_names.size
      walk_problem = ""
      if has_pre {
        refuse_for_outer_name(stmt)
        self.push_scope()
        pi = 0
        while pi < stmt.pre.size {
          annotate_vstep(stmt.pre[pi], stmt)
          self.clear_poison()
          check_stmt(stmt.pre[pi], t_void(), false)
          if stmt.for_kind == 2 && pi == 0 && !hash_for_walk(stmt) {
            set_for_operand(stmt.pre[0])
            walk_problem = for_walk_operand(stmt)
          }
          if !self.has_err() && pi < stmt.pre.size {
            fact_after_stmt(stmt.pre[pi])
          }
          pi += 1
        }
        if stmt.for_kind == 1 {
          if pt = stmt.pre[0].target, pty = lookup(pt.ident), !pty.is_int() {
            fail(stmt.loc, "for range bounds must be Int, got ${pty.show()}")
          }
          if stmt.pre.size > 1 {
            if pt2 = stmt.pre[1].target, pty2 = lookup(pt2.ident), !pty2.is_int() {
              fail(stmt.loc, "for range bounds must be Int, got ${pty2.show()}")
            }
          }
        }
        if stmt.for_kind == 2 {
          // The array's own error, if it failed, is the loop's (the
          // cascade rule): the hidden name holds the failed value.
          if walk_problem.size > 0 {
            fail(stmt.loc, walk_problem)
            if pt = stmt.pre[0].target {
              mark_failed(pt.ident)
            }
          }
          note_for_position(stmt)
        }
      }
      saved_places = self.place_names.size
      saved_walks = self.walk_texts.size
      if stmt.for_kind == 2 && !self.has_err() {
        begin_for_place(stmt)
        begin_plain_walk(stmt)
      }
      // The loop's own reads start here, after a for loop's set-up.
      region_stamp = self.facts.stamp
      region_uses = self.facts.use_cont.size
      region_kills = self.facts.kill_cont.size
      saved_facts = self.facts.fact_var.size
      if cond = stmt.cond {
        push_loop_facts(cond, stmt.body)
      }
      if cond = stmt.cond {
        ct = check_expr(cond)
        if !ct.is_bool() {
          fail(cond.loc, "while condition must be Bool, got ${ct.show()}")
        }
      }
      saved_gcap = self.facts.gcap_var.size
      saved_gnn = self.facts.gnn_var.size
      saved_gpos = self.facts.gpos_var.size
      saved_gne = self.facts.gne_var.size
      if cond = stmt.cond {
        push_guard_facts(cond)
      }
      cap_kill_assigned_in(stmt.body)
      self.loop_depth += 1
      check_block(stmt.body, expected, false)
      self.loop_depth -= 1
      if !self.has_err() {
        loop_region_end(region_stamp, region_uses, region_kills)
      }
      cap_kill_assigned_in(stmt.body)
      pop_guard_facts(saved_gcap, saved_gnn, saved_gpos, saved_gne)
      pop_loop_facts(saved_facts)
      if at_tail && !expected.is_void() {
        fail(stmt.loc, "missing return value")
      }
      while self.for_names.size > saved_for {
        self.for_names.pop()
        self.for_scopes.pop()
        self.for_kinds.pop()
      }
      end_places(saved_places)
      end_plain_walks(saved_walks)
      if has_pre {
        self.pop_scope()
      }
      return
    }
    if k == st_break() {
      if self.loop_depth == 0 {
        if self.try_in == defer_context() {
          fail(stmt.loc, defer_exit_message("break"))
        } else if self.inline_what.size > 0 {
          fail(stmt.loc, inline_exit_message("break", self.inline_what))
        } else if self.in_build > 0 {
          fail(stmt.loc, "break inside the lambda of Array(T).new(n, (i) { ... }) would leave elements unbuilt; every index gets a value")
        } else {
          fail(stmt.loc, "break is only valid inside a loop")
        }
      }
      if at_tail && !expected.is_void() {
        fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_continue() {
      if self.loop_depth == 0 {
        if self.try_in == defer_context() {
          fail(stmt.loc, defer_exit_message("continue"))
        } else if self.inline_what.size > 0 {
          fail(stmt.loc, inline_exit_message("continue", self.inline_what))
        } else if self.in_build > 0 {
          fail(stmt.loc, "continue inside the lambda of Array(T).new(n, (i) { ... }) would leave elements unbuilt; every index gets a value")
        } else {
          fail(stmt.loc, "continue is only valid inside a loop")
        }
      }
      if at_tail && !expected.is_void() {
        fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_assign() {
      check_assign(stmt)
      if at_tail && !expected.is_void() {
        fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_expr() {
      if expr = stmt.expr {
        if at_tail {
          if expr.kind == ex_lambda() && !expected.is_void() {
            got = check_expr_as(expr, expected)
            return
          }
          if self.lambda_infer {
            note_inferred(check_expr(expr), stmt.loc, false)
            self.inferred_tail = true
            return
          }
        }
        got = t_int()
        if expr.kind == ex_call() && expr.callee == "with" && (!at_tail || expected.is_void()) {
          // A `with` whose value nobody uses: its block ends
          // without a value (check_mutex_with).
          self.with_drop = expr.loc.show()
        }
        if expr.kind == ex_switch() && expr.op != tk_if() && expr.op != tk_return() && (!at_tail || expected.is_void()) {
          self.switch_stmt = true
        }
        tail_switch = at_tail && !expected.is_void() && expr.kind == ex_switch() && expr.op != tk_return()
        if at_tail && !expected.is_void() && is_int_literal(expr) {
          // A literal tail adopts the result type, as `return 0` does
          // (an Int32 function may end in `0`).
          got = check_expr_as(expr, expected)
        } else if tail_switch && !switch_arms_leave(expr) {
          // A last switch (or if used as a value) sees the result type,
          // so its arms may give different members of a union result.
          self.switch_tail = true
          got = check_expr_as(expr, expected)
          self.switch_tail = false
        } else {
          got = check_expr(expr)
        }
        if !self.has_err() && (!at_tail || expected.is_void()) {
          refuse_dropped_error(got, stmt.loc)
        }
        if !self.has_err() && !got.is_void() && expr.kind == ex_binary() && expr.op == tk_question_question() {
          if r = expr.right, expr_is_else_guard(r) {
            // `f() else e { ... }` as a statement is for a success that is
            // nothing (Void | E); a value is named (`v = f() else e`).
            fail(stmt.loc, "an else guard without a name to assign is for a result whose success is nothing (Void | E); this success is ${got.show()}: write `v = ... else ${r.ident} { ... }`, or `_ = ... else ${r.ident} { ... }` to drop it")
          }
        }
        if at_tail {
          if expected.is_void() {
            // The uniform void tail: a value at the end of a function
            // that returns nothing is a statement, as it is in the
            // middle. A line starting with `-` or `[` there is a
            // dangling line (such a line always begins a new
            // statement), as in the middle.
            if !got.is_void() && stmt.lead != 0 && (expr.kind == ex_unary() || expr.kind == ex_array() || expr.kind == ex_hash_lit()) {
              fail(stmt.loc, "this line starts with `${lead_spelling(stmt.lead)}`, so it begins a new statement whose value nobody uses; to continue the line before, end it with the operator or an open bracket (`total = a -` then `b`)")
            }
          } else if got.is_void() && tail_switch && block_leaves([stmt]) {
            // Every arm leaves: the switch gives no value and needs
            // none.
          } else if got.is_void() && ast_is_exit_call(expr) {
            // exit never returns: nothing follows it, so no value does.
          } else {
            if !ty_assignable(got, expected) {
              fail(stmt.loc, "last expression is ${got.show()}, expected ${expected.show()}")
            }
          }
        }
        if !self.has_err() && (!at_tail || expected.is_void()) && no_effect(expr) {
          refuse_no_effect(expr, stmt, got, at_tail)
        }
      }
      return
    }
    fail(stmt.loc, "unknown statement")
  }

  pub fn check_if_assign(stmt: Stmt, expected: Ty, at_tail: Bool) {
    if cond = stmt.cond {
      got = check_expr(cond)
      if stmt.for_kind == 7 && !(got.is_nilable() && ty_failures(got).size == 1) && !self.has_err() {
        // A for loop's step over a type with next (checker/places.av).
        // A step that can fail is the while form's, which reads it.
        hint = ""
        for m in ty_failures(got) {
          if !m.is_nil() {
            hint = ": a walk whose step can fail (${m.show()}) is written while v = it.${cond.callee}() { ... } else e { ... }, whose else reads the failure"
            break
          }
        }
        fail(stmt.loc, "for calls ${cond.callee} at each step: it must return T?, nil ending the loop, got ${got.show()}${hint}")
      }
      success = if_assign_success(got, cond.loc)
      if stmt.loop_head && stmt.else_bind.size == 0 && !self.has_err() {
        loop_drops_error(got, cond.loc)
      }
      refuse_bind_outer_name(stmt, stmt.loc)
      self.push_scope()
      bind(stmt.bind, success)
      if stmt.for_kind == 7 {
        note_for_var(stmt.bind, 11)
      }
      check_body(stmt.then_body, expected, false)
      self.pop_scope()
      if stmt.else_bind.size > 0 {
        if fty = check_else_bind(stmt) {
          self.push_scope()
          bind(stmt.else_bind, fty)
          check_body(stmt.else_body, expected, false)
          self.pop_scope()
        }
      } else if stmt.else_body.size > 0 {
        check_block(stmt.else_body, expected, false)
      }
      if at_tail && !expected.is_void() {
        ok = false
        if stmt.else_body.size > 0 && !fallthrough(stmt.then_body) && !fallthrough(stmt.else_body) {
          ok = true
        }
        if !ok {
          fail(stmt.loc, "missing return value")
        }
      }
    }
  }

  // A `while v = f()` whose value can be an error would end on it as it
  // ends at nil, the error dropped: the loop must read it with
  // `else e { }`, which runs once when the head fails.
  pub fn loop_drops_error(got: Ty, loc: Location) {
    for m in ty_failures(got) {
      if !m.is_nil() {
        fail(loc, "this while would end silently when the value is an error (${m.show()}): read it with `while v = f() { ... } else e { ... }`, whose else runs once when the loop ends, with the failure in e")
        return
      }
    }
  }

  // `if v = f() { } else e { }`: the failure the else block reads, of
  // the if-assign's one binding (checked first), or nil after an error:
  // a condition list has several failures, and an if without a binding
  // has none.
  pub fn check_else_bind(stmt: Stmt): Ty? {
    n = stmt.else_bind
    if n != "_" && !n.starts_with("__") {
      if old = lookup(n) {
        // As the condition's own binding: the else block's name is that
        // block's own, so an existing name would be hidden in it.
        form = if stmt.loop_head { "while" } else { "if" }
        fail(stmt.loc, "${form} ... else ${n}: ${n} already names a variable here; the name an else binds is its block's own and ends with it (it would hide ${n} there): give the failure a new name")
        return nil
      }
    }
    if stmt.pre.size > 0 {
      fail(stmt.loc, "else ${n} reads the failure of an if-assign's one binding, and this condition has several elements: bind them one by one, or switch over the value")
      return nil
    }
    if stmt.bind.size == 0 {
      fail(stmt.loc, "else ${n} names the failure of an if-assign (if v = f() { } else ${n} { }); this if binds nothing")
      return nil
    }
    if c = stmt.cond, ct = c.ty {
      if stmt.loop_head && ct.is_union() {
        fails = ty_failures(ct)
        if fails.size == 1 && fails[0].is_nil() {
          fail(c.loc, "else ${n} on ${ct.show()}: its only failure is nil, which carries nothing to read, and the loop ends at it by itself: leave the else out")
          return nil
        }
      }
      return else_failure(ct, c.loc, "else ${n}")
    }
    nil
  }

  // `m.f` read as a value, m a module this one may qualify with and not a
  // local, a field or a parameter: m's function f (lambda.av), or nil.
  pub fn check_module_fn_value(expr: Expr, has_want: Bool, want: Ty): Ty? {
    if obj = expr.object, obj.kind == ex_name() && obj.type_args.size == 0 {
      if v = lookup(obj.ident) {
        return nil
      }
      if f = implicit_field(obj.ident) {
        return nil
      }
      if k = self.known_mods.get(obj.ident), qualifier_ok(obj.ident, self.current_module) {
        if module_is_method(obj.ident, obj.loc) {
          return t_int()
        }
        return check_qualified_fn_value(expr, obj.ident, has_want, want)
      }
    }
    nil
  }

  // A module name used as a bare qualifier that is also a method of the
  // receiver: nothing wins silently; an error naming both ways out, and
  // true.
  pub fn module_is_method(name: String, loc: Location): Bool {
    if st = self.bare_receiver(), receiver_method_fits(st, name, 0) {
      fail(loc, "${name} is both a module and a method of ${st.show()}; write ${self.self_name}.${name} for the method, or give the method another name to use the module")
      return true
    }
    if st2 = self.bare_receiver(), f = st2.field_named(name) {
      fail(loc, "${name} is both a module and a field of ${st2.show()}; write ${self.self_name}.${name} for the field, or give the field another name to use the module")
      return true
    }
    false
  }

  // `_ = expr`: the value is computed and dropped on purpose, an error
  // included; `_` binds nothing and cannot be read.
  pub fn check_discard(stmt: Stmt) {
    if stmt.op != tk_eq() {
      fail(stmt.loc, "_ discards a value with _ = ...; it holds nothing to read or update")
      return
    }
    if d = stmt.declared {
      fail(stmt.loc, "_ = ... discards a value; it takes no type")
      return
    }
    if v = stmt.value {
      got = check_expr(v)
      if !self.has_err() && got.is_void() {
        fail(stmt.loc, "there is no value to discard: this expression has none")
      }
    }
  }

  // Discarding an error is a compile error: a statement whose value can
  // be an Error (a type marked Error, or a union holding one) is refused,
  // naming the ways out. An expression whose value is all it does
  // (checked first): a literal, a name, a field read, an operator over
  // such operands, or a literal array, struct or lambda; nothing that
  // calls (a method, a function, an operator method, a conversion) or
  // leaves (`?`, `?? return`).
  pub fn no_effect(e: Expr): Bool {
    k = e.kind
    if k == ex_int() || k == ex_float() || k == ex_bool() || k == ex_nil() || k == ex_string() || k == ex_name() || k == ex_lambda() {
      return true
    }
    if k == ex_interp() {
      for part in e.parts {
        if pe = part.expr, !no_effect(pe) {
          return false
        }
      }
      return true
    }
    if e.method_call || e.resolved.size > 0 || e.op_form != 0 {
      return false
    }
    if k == ex_field() {
      if o = e.object {
        return no_effect(o)
      }
      return e.implicit_field
    }
    if k == ex_unary() {
      if inner = e.inner {
        return no_effect(inner)
      }
      return false
    }
    if k == ex_binary() {
      if l = e.left, r = e.right {
        return no_effect(l) && no_effect(r)
      }
      return false
    }
    if k == ex_index() {
      if o = e.left, i = e.right {
        return no_effect(o) && no_effect(i)
      }
      return false
    }
    if k == ex_array() || k == ex_hash_lit() {
      for el in e.elems {
        if !no_effect(el) {
          return false
        }
      }
      return true
    }
    if k == ex_struct() {
      for fe in e.field_exprs {
        if !no_effect(fe) {
          return false
        }
      }
      return true
    }
    false
  }

  // A statement with no effect is an error anywhere (it computes a value
  // nobody uses); at the end of a function with no result type the likely
  // cause is the missing result, and a bare function name a missing call.
  pub fn refuse_no_effect(e: Expr, stmt: Stmt, got: Ty, at_tail: Bool) {
    at = start_loc(e)
    if e.kind == ex_name() && e.fn_ref {
      fail(at, "${e.ident} alone is the function as a value; to call it, write ${e.ident}()")
      return
    }
    if at_tail && self.lam_exprs.size == 0 && !got.is_void() && !got.is_nil() {
      // An entry point's result can only be an Int (or a failure).
      if cf = self.current_fn, !((cf.name == "main" || cf.name == "run") && cf.owner.size == 0 && !got.is_int()) {
        if rt = cf.return_type {
        } else {
          fail(at, "this line computes ${a_type(got)} and drops it: ${cf.name} has no result type; to return it, declare fn ${cf.name}: ${got.show()}")
          return
        }
      }
    }
    fail(at, "this line computes a value and drops it; use it, or remove the line")
  }

  // Where an expression starts in the source: its leftmost operand's
  // position (an operator's own position is its operator's).
  pub fn start_loc(e: Expr): Location {
    if e.kind == ex_binary() || e.kind == ex_index() {
      if l = e.left {
        return start_loc(l)
      }
    }
    if e.kind == ex_field() {
      if o = e.object {
        return start_loc(o)
      }
    }
    e.loc
  }

  // After "cannot bind a Void value": the called function's name when it
  // was declared with no result type (`fn two { 2 }`), the likely cause.
  pub fn void_callee_note(value: Expr): String {
    if value.kind != ex_call() || value.resolved.size == 0 {
      return ""
    }
    for sig in self.functions {
      if sig.node.emit_name == value.resolved {
        if rt = sig.node.return_type {
          return ""
        }
        return ": ${sig.node.name} has no result type"
      }
    }
    for msig in self.methods {
      if msig.node.emit_name == value.resolved {
        if rt2 = msig.node.return_type {
          return ""
        }
        return ": ${msig.node.name} has no result type"
      }
    }
    ""
  }

  // `an Int`, `a String`: a type's name with its article.
  pub fn a_type(t: Ty): String {
    s = t.show()
    if s.size > 0 && (s[0] == 65 || s[0] == 69 || s[0] == 73 || s[0] == 79 || s[0] == 85) {
      return "an ${s}"
    }
    "a ${s}"
  }

  pub fn refuse_dropped_error(got: Ty, loc: Location) {
    can = got.error_mark
    if got.is_union() {
      for m in got.members {
        if m.error_mark {
          can = true
        }
      }
    }
    if can && got.is_union() && got.includes_void() {
      fail(loc, "this statement drops a value that can be an error (${got.show()}); read the error with `else e { ... }`, pass it up with ?, or discard it on purpose with _ = ...")
      return
    }
    if can && (!got.is_union() || !ty_has_success(got)) {
      // An optional error (`E?`), or a bare error: no success to pass
      // on, so `?` does not apply.
      fail(loc, "this statement drops a value that can be an error (${got.show()}); read the error with `if e = ... { }`, or discard it on purpose with _ = ...")
      return
    }
    if can {
      fail(loc, "this statement drops a value that can be an error (${got.show()}); handle it (if-assign or ??), pass it up with ?, or discard it on purpose with _ = ...")
    }
  }

  // One element of a condition list: a binding (bound in the current
  // scope to the success part) or a Bool test.
  pub fn check_cond_element(el: Stmt) {
    if cond = el.cond {
      got = check_expr(cond)
      if el.bind.size > 0 {
        success = if_assign_success(got, cond.loc)
        if el.loop_head && el.else_bind.size == 0 && !self.has_err() {
          loop_drops_error(got, cond.loc)
        }
        refuse_bind_outer_name(el, el.loc)
        bind(el.bind, success)
      } else if !got.is_bool() {
        fail(cond.loc, "if condition must be Bool, got ${got.show()}")
      }
    }
  }

  // `if a = x, b = y, cond { } else { }`: the elements left to right,
  // each binding in scope for the elements after it and the
  // then-block; the else-block sees none of them.
  pub fn check_if_chain(stmt: Stmt, expected: Ty, at_tail: Bool) {
    self.push_scope()
    for el in stmt.pre {
      check_cond_element(el)
    }
    check_cond_element(stmt)
    check_body(stmt.then_body, expected, false)
    self.pop_scope()
    if stmt.else_bind.size > 0 {
      check_else_bind(stmt)
      return
    }
    if stmt.else_body.size > 0 {
      check_block(stmt.else_body, expected, false)
    }
    if at_tail && !expected.is_void() {
      if !(stmt.else_body.size > 0 && !fallthrough(stmt.then_body) && !fallthrough(stmt.else_body)) {
        fail(stmt.loc, "missing return value")
      }
    }
  }

  // The success part an if-assign binds: the members of got that are
  // not failures (type.av ty_failures).
  pub fn if_assign_success(got: Ty, loc: Location): Ty {
    if success = failure_split(got, loc, "if-assign") {
      if success.is_void() {
        fail(loc, "if-assign on ${got.show()}: its success is nothing, so there is no value to bind; read the failure with `f() else e { ... }`, pass it up with `?`, or switch over the result")
        return t_int()
      }
      return success
    }
    t_int()
  }

  // The success part of got under the one failure rule, or nil after
  // an error that names what is missing; what is the operator's name
  // for the message.
  pub fn failure_split(got: Ty, loc: Location, what: String): Ty? {
    if !got.is_union() {
      fail(loc, "${what} needs a value that can fail (T? or T | E with E marked Error), got ${got.show()}")
      return nil
    }
    if ty_failures(got).size == 0 {
      if !ty_has_success(got) {
        fail(loc, "${what} on ${got.show()}: it has no success value, every member is a failure (Nil or marked Error)")
      } else {
        fail(loc, "${what} on ${got.show()}: it has no failure member; a failure is Nil or a type marked Error (class E: Error)")
      }
      return nil
    }
    if success = ty_success_part(got) {
      return success
    }
    fail(loc, "${what} on ${got.show()}: it has no success value, every member is a failure (Nil or marked Error)")
    nil
  }

  pub fn check_assign(stmt: Stmt) {
    if t0 = stmt.target, t0.kind == ex_name() && t0.ident == "_" {
      check_discard(stmt)
      return
    }
    if stmt.for_kind == 5 {
      // The element's store of a `for` whose variable is a place: the
      // loop bound the name (begin_for_place) and the store is not made.
      return
    }
    if stmt.for_kind >= 3 {
      // A `for` loop's own store: once checked, its target is a for
      // variable until the loop ends.
      check_assign_stmt(stmt)
      if t1 = stmt.target, !self.has_err() {
        note_for_var(t1.ident, stmt.for_kind)
      }
      return
    }
    if t2 = stmt.target, t2.kind == ex_name() && self.place_names.size > 0 && place_at(t2.ident) >= 0 {
      // `p = other` on the element itself: a whole-element store, the
      // index of the walk taking the value (checker/places.av).
      mark = self.err_count()
      pt = place_use(t2, false, t_int())
      if new_err_since(mark) {
        return
      }
    }
    if refuse_for_assign(stmt) {
      return
    }
    check_assign_stmt(stmt)
  }

  pub fn check_assign_stmt(stmt: Stmt) {
    if stmt.op != tk_eq() {
      check_compound_assign(stmt)
      return
    }
    if target = stmt.target, value = stmt.value {
      if refuse_const_write(target) {
        return
      }
      if target.kind == ex_name() {
        if target.ident == "self" {
          fail(stmt.loc, "cannot assign to self")
          return
        }
        if declared = stmt.declared {
          ann_mark = self.err_count()
          want = resolve_in_module(declared)
          self.pull_resolve()
          ann_ok = !new_err_since(ann_mark)
          if reject_clayout_value(want, declared.loc) {
            return
          }
          if existing = lookup(target.ident) {
            fail(stmt.loc, "cannot shadow ${target.ident}")
            return
          }
          if field_ty = implicit_field(target.ident) {
            fail(stmt.loc, "cannot shadow ${target.ident}")
            return
          }
          early = false
          if value.kind == ex_lambda() {
            bind(target.ident, want)
            target.ty = want
            early = true
          }
          got = check_expr_as(value, want)
          if !ty_assignable(got, want) && !fn_compatible(got, want) {
            fail(value.loc, "cannot assign ${got.show()} to ${want.show()}")
          }
          if !early {
            bind(target.ident, want)
            target.ty = want
          }
          if ann_ok {
            unfail(target.ident)
          }
          return
        }
        if existing = lookup(target.ident) {
          note_capture(target.ident, existing, target.loc)
          got = check_expr_as(value, existing)
          if !ty_assignable(got, existing) {
            fail(value.loc, "cannot assign ${got.show()} to ${existing.show()}")
          }
          if !self.poisoned {
            unfail(target.ident)
          }
          target.ty = existing
          return
        }
        if field_ty = implicit_field(target.ident) {
          // A field is written self.name = ...
          refuse_bare_field_write(target, stmt.loc)
          return
        }
        got = check_expr(value)
        if got.is_void() {
          fail(stmt.loc, "cannot bind a Void value${void_callee_note(value)}")
          return
        }
        if reject_clayout_value(got, value.loc) {
          return
        }
        bind(target.ident, got)
        target.ty = got
        return
      }
      if extra = stmt.declared {
        fail(stmt.loc, "type annotation only belongs on a new name")
        return
      }
      if target.kind == ex_index() {
        if arr = target.left, ix = target.right {
          self.carray_ok = true
          container = check_expr(arr)
          self.carray_ok = false
          if container.is_agg() {
            if user_op(container, "[]=") {
              // `c[i] = v` is the call `c.[]=(i, v)`.
              set_args = index_args(target)
              set_args.push(value)
              call = op_method_call(target.loc, arr, "[]=", set_args)
              stmt.kind = st_expr()
              stmt.expr = call
              stmt.target = nil
              stmt.value = nil
              check_expr(call)
              return
            }
            if user_op(container, "[]") {
              fail(stmt.loc, "cannot assign to an element of ${container.show()}: it defines [] but not []=; define fn []=(index, value) on it")
              return
            }
          }
          if target.elems.size > 0 {
            fail(target.elems[0].loc, "${container.show()} takes one index; several (g[x, y]) are for a type that defines fn []= with as many parameters and the value")
            return
          }
          if container.is_set() {
            fail(stmt.loc, "a Set has no [ ]=: s.add(v) puts v in it, s.delete(v) takes it out")
            return
          }
          if container.is_hash() {
            if k = container.key {
              key = check_expr_as(ix, k)
              if !ty_assignable(key, k) {
                fail(ix.loc, "hash key must be ${k.show()}, got ${key.show()}")
              }
            }
            if v = container.val {
              got = check_expr_as(value, v)
              if !ty_assignable(got, v) {
                fail(value.loc, "cannot assign ${got.show()} to ${v.show()}")
              }
              target.ty = v
              return
            }
          }
        }
      }
      self.target_expr = target
      place = check_expr(target)
      self.target_expr = nil
      if (target.kind == ex_field() && target.method_call) || target.kind == ex_call() {
        fail(stmt.loc, "cannot assign to a method")
        return
      }
      if target.kind == ex_name() && target.implicit_field {
        refuse_bare_field_write(target, stmt.loc)
        return
      }
      refuse_copy_write(target, stmt.loc)
      if refuse_for_field_write(target, stmt.loc) {
        return
      }
      if reject_clayout_value(place, target.loc) {
        return
      }
      got = check_expr_as(value, place)
      if !ty_assignable(got, place) {
        fail(value.loc, "cannot assign ${got.show()} to ${place.show()}")
      }
      return
    }
    fail(stmt.loc, "cannot assign to this expression")
  }

  // `x op= v` where x's type defines the operator: `x = x op v`, the
  // place written once more as it is read (a name, a field, an element
  // at a name or a literal, so reading it twice is reading it once), the
  // same call the hand-written assignment makes.
  pub fn compound_through_method(stmt: Stmt, target: Expr, value: Expr, binop: Int, place: Ty) {
    if !simple_place(target) {
      fail(stmt.loc, "compound assignment through ${place.show()}.${fn_op_name(binop)} needs a place read without side effects (a name, a field, an element at a name); write the assignment out: x = x ${fn_op_name(binop)} v")
      return
    }
    read = clone_expr(target)
    opx = Expr.new(ex_binary(), stmt.loc)
    opx.op = binop
    opx.left = read
    opx.right = value
    stmt.op = tk_eq()
    stmt.value = opx
    check_assign_stmt(stmt)
  }

  // A place whose reading has no side effect and gives the same value
  // twice in a row: a name, a field of such a place, an element of one at
  // a name or a literal.
  pub fn simple_place(e: Expr): Bool {
    if e.kind == ex_name() {
      return true
    }
    if e.kind == ex_field() && !e.method_call {
      if o = e.object {
        return simple_place(o)
      }
      return false
    }
    if e.kind == ex_index() {
      if l = e.left {
        for x in index_args(e) {
          if !(x.kind == ex_name() || x.kind == ex_int()) {
            return false
          }
        }
        return simple_place(l)
      }
    }
    false
  }

  pub fn check_compound_assign(stmt: Stmt) {
    if declared = stmt.declared {
      fail(stmt.loc, "type annotation only belongs on a new name")
      return
    }
    if target = stmt.target, value = stmt.value {
      if refuse_const_write(target) {
        return
      }
      if target.kind == ex_name() {
        if target.ident == "self" {
          fail(stmt.loc, "cannot assign to self")
          return
        }
      }
      orig = clone_expr(target)
      self.target_expr = target
      place = check_expr(target)
      self.target_expr = nil
      binop = compound_binop(stmt.op)
      if target.kind == ex_call() && target.callee == "[]" && orig.kind == ex_index() {
        // `c[i] op= v` on a type with [] and []=: `c[i] = c[i] op v`.
        if !simple_place(orig) {
          fail(stmt.loc, "compound assignment to an element of a type's [] needs an index read without side effects (a name or a literal); write the assignment out: c[i] = c[i] ${fn_op_name(binop)} v")
          return
        }
        opx = Expr.new(ex_binary(), stmt.loc)
        opx.op = binop
        opx.left = target
        opx.right = value
        stmt.op = tk_eq()
        stmt.target = orig
        stmt.value = opx
        check_assign_stmt(stmt)
        return
      }
      if (target.kind == ex_field() && target.method_call) || target.kind == ex_call() {
        fail(stmt.loc, "cannot assign to a method")
        return
      }
      if target.kind == ex_name() && target.implicit_field {
        refuse_bare_field_write(target, stmt.loc)
        return
      }
      refuse_copy_write(target, stmt.loc)
      if refuse_for_field_write(target, stmt.loc) {
        return
      }
      if reject_clayout_value(place, target.loc) {
        return
      }
      if place.is_agg() && user_op(place, fn_op_name(binop)) {
        compound_through_method(stmt, target, value, binop, place)
        return
      }
      if place.is_agg() {
        fail(stmt.loc, "compound assignment ${compound_text(stmt.op)} needs ${place.show()} to define fn ${fn_op_name(binop)}")
        return
      }
      if place.is_string() && binop == tk_plus() {
        // `s += t` is `s = s + t`: a new string.
        compound_through_method(stmt, target, value, binop, place)
        return
      }
      got = place
      if shift_op(binop) {
        // A shift's amount is an Int whatever the shifted type, as in the
        // operator.
        got = check_expr(value)
      } else {
        got = check_expr_as(value, place)
        if !got.same_as(place) {
          fail(value.loc, "cannot assign ${got.show()} to ${place.show()}")
          return
        }
      }
      if !place.is_numeric() {
        fail(stmt.loc, "compound assignment expects a numeric target, got ${place.show()}")
        return
      }
      // The operator's own rules (`%=` and the bitwise forms on integers
      // only, a shift's amount), checked as the binary expression is.
      opx = Expr.new(ex_binary(), stmt.loc)
      opx.op = binop
      res = binary_typed(opx, target, value, binop, place, got)
      if self.has_err() {
        return
      }
      if !res.same_as(place) {
        fail(stmt.loc, "cannot assign ${res.show()} to ${place.show()}")
        return
      }
      if binop == tk_percent() || shift_op(binop) || bitwise_op(binop) {
        stmt.proven = opx.proven
      }
      if target.kind == ex_name() {
        if value.kind == ex_int() {
          if stmt.op == tk_plus_eq() {
            s = fact_any_slack(target.ident)
            if s >= 0 && value.int_bits <= s.to_u64() + 1 {
              stmt.proven = true
            }
          }
          if stmt.op == tk_minus_eq() && (fact_any_slack(target.ident) >= 0 || nn_has(target.ident)) {
            stmt.proven = true
          }
        }
        if (stmt.op == tk_plus_eq() || stmt.op == tk_minus_eq() || stmt.op == tk_star_eq()) && compound_proven(stmt.op, target.ident, value, place) {
          stmt.proven = true
        }
        if stmt.op == tk_slash_eq() && divisor_proven(value) {
          stmt.proven = true
        }
      }
      return
    }
  }

  pub fn check_expr(expr: Expr): Ty {
    check_expr_flag(expr, false, t_int())
  }

  pub fn check_expr_as(expr: Expr, want: Ty): Ty {
    check_expr_flag(expr, true, want)
  }

  pub fn check_expr_flag(expr: Expr, has_want: Bool, want: Ty): Ty {
    if self.has_err() {
      return t_int()
    }
    mark = self.err_count()
    kind = check_expr_core(expr, has_want, want)
    if new_err_since(mark) {
      expr.ty = kind
      return kind
    }
    if has_want && !type.ty_has_var(want) && !ty_assignable(kind, want) && !fn_compatible(kind, want) {
      fail(expr.loc, "expected ${want.show()}, got ${kind.show()}")
      // The generic message: the reader's own replaces it (fail).
      self.weak_at = self.errors.pushes
    }
    expr.ty = kind
    kind
  }

  pub fn check_expr_core(expr: Expr, has_want: Bool, want: Ty): Ty {
    k = expr.kind
    if k == ex_name() || k == ex_field() || k == ex_call() {
      qualify_last_name(expr)
    }
    // Only the expression a C array's reader names directly may be one.
    carray_flag = self.carray_ok
    self.carray_ok = false
    if k == ex_field() && layout_size_form(expr) {
      return check_integer(expr, has_want, want)
    }
    if k == ex_int() {
      return check_integer(expr, has_want, want)
    }
    if k == ex_float() {
      return t_float()
    }
    if k == ex_string() {
      return t_string()
    }
    if k == ex_bool() {
      return t_bool()
    }
    if k == ex_nil() {
      return t_nil()
    }
    if k == ex_void() {
      return t_void()
    }
    if k == ex_name() {
      return check_name(expr, has_want, want)
    }
    if k == ex_enum_lit() {
      return check_enum_lit(expr, has_want, want)
    }
    if k == ex_const_ref() {
      return const_ref_ty(expr)
    }
    if k == ex_lambda() {
      return check_lambda(expr, has_want, want)
    }
    if k == ex_call() {
      if b0 = expr.bare_name {
        // `T.new` written without parentheses.
        bare_call(expr, b0, "new")
      }
      return check_call(expr, has_want, want)
    }
    if k == ex_unary() {
      return check_unary(expr, has_want, want)
    }
    if k == ex_binary() {
      return check_binary(expr, has_want, want)
    }
    if k == ex_switch() {
      return check_switch(expr, has_want, want)
    }
    if k == ex_field() {
      if inline_const(expr) {
        return check_expr_core(expr, has_want, want)
      }
      if ct = const_read(expr) {
        return ct
      }
      if got = check_module_fn_value(expr, has_want, want) {
        return got
      }
      at = expr.bare_name
      written = expr.ident
      self.carray_ok = carray_flag
      got_field = check_field(expr)
      if b0 = at, member_is_call(expr) {
        bare_call(expr, b0, written)
      }
      return got_field
    }
    if k == ex_struct() {
      return check_struct_literal(expr, has_want, want)
    }
    if k == ex_index() {
      return check_index(expr)
    }
    if k == ex_array_new() {
      return check_array_new(expr)
    }
    if k == ex_array() {
      return check_array_literal(expr, has_want, want)
    }
    if k == ex_hash_lit() {
      return check_hash_literal(expr, has_want, want)
    }
    if k == ex_hash_new() {
      if b0 = expr.bare_name {
        // `Hash(K, V).new` written without parentheses.
        bare_call(expr, b0, "new")
      }
      return check_hash_new(expr)
    }
    if k == ex_try() {
      return check_try(expr)
    }
    if k == ex_interp() {
      return check_interp(expr)
    }
    fail(expr.loc, "unknown expression")
    t_int()
  }

  pub fn check_try(expr: Expr): Ty {
    if inner = expr.inner {
      got = check_expr(inner)
      return split_try_success(got, expr.loc)
    }
    t_int()
  }

  // Whether `??` and `.or` take left: a union with a failure member and
  // a success part (the error otherwise is failure_split's).
  pub fn can_coalesce(left: Ty): Bool {
    if left.is_union() && ty_failures(left).size > 0 {
      if s = ty_success_part(left) {
        return true
      }
    }
    false
  }

  // The failure an `else e` reads: the one failure member of got, or the
  // union of them, read with `switch`; nil after an error when got has
  // no failure to read (none, or only `nil`). what names the form for
  // the messages.
  pub fn else_failure(got: Ty, loc: Location, what: String): Ty? {
    if success = failure_split(got, loc, what) {
      fails = ty_failures(got)
      if fails.size == 1 && fails[0].is_nil() {
        fail(loc, "${what} on ${got.show()}: its only failure is nil, which carries nothing to read; leave with `?? return`, `?? break` or `?? continue`")
        return nil
      }
      if fails.size == 1 {
        return fails[0]
      }
      return ty_union_build(fails)
    }
    nil
  }

  // `n = f() else e { ... }` (parser.av parse_else_guard): on a failure
  // the block runs with e holding it and must leave (return, break,
  // continue), so after the statement the value is the success part. The
  // name is required: a guard that does not read the failure is
  // `?? return`, `?? break` or `?? continue`.
  pub fn check_else_guard(l: Expr, guard: Expr): Ty {
    left = check_expr(l)
    if self.has_err() {
      return left
    }
    if guard.ident.size == 0 {
      fail(guard.loc, "an else guard names the failure it reads: write `else e { ... }`; to leave without reading it, write `?? return`, `?? break` or `?? continue`")
      return left
    }
    if guard.ident != "_" && !guard.ident.starts_with("__") {
      if old = lookup(guard.ident) {
        fail(guard.loc, "else ${guard.ident}: ${guard.ident} already names a variable here; the name an else guard binds is its block's own and ends with it (it would hide ${guard.ident} there): give the failure a new name")
        return left
      }
    }
    payload = left
    if fty = else_failure(left, guard.loc, "else ${guard.ident}") {
      if s = ty_success_part(left) {
        payload = s
      }
      self.push_scope()
      bind(guard.ident, fty)
      check_body(guard.else_body, self.return_type, false)
      self.pop_scope()
      if !self.has_err() && !block_leaves(guard.else_body) {
        fail(guard.loc, "the block of else ${guard.ident} must leave (return, break, continue or exit): after the guard the value is the success, so a failure cannot go on")
      }
    }
    guard.ty = payload
    payload
  }

  // Whether a block always leaves its function or loop iteration: its
  // last statement is return, break, continue or exit(status) (which
  // ends the program, ast_is_exit_call), an if/else whose two
  // branches leave, a gc.hold or pin block that leaves, or a switch
  // statement whose every arm leaves (with an else, or over an enum or
  // a union, whose switch without else the checker has made cover every
  // member).
  pub fn block_leaves(body: Array(Stmt)): Bool {
    if body.size == 0 {
      return false
    }
    last = body[body.size - 1]
    k = last.kind
    if k == st_return() || k == st_break() || k == st_continue() || ast_stmt_exits(last) {
      return true
    }
    if k == st_hold() || k == st_pin() {
      return block_leaves(last.body)
    }
    if k == st_if() {
      return last.else_body.size > 0 && block_leaves(last.then_body) && block_leaves(last.else_body)
    }
    if k == st_expr() {
      if e = last.expr, e.kind == ex_switch() && e.op != tk_return() && e.op != tk_if() {
        for cs in e.cases {
          if !block_leaves(cs.body) {
            return false
          }
        }
        if e.has_else {
          return block_leaves(e.else_body)
        }
        if c = e.cond, ct = c.ty {
          return ct.is_enum() || ct.is_union() || ct.is_bool()
        }
      }
    }
    false
  }

  // Whether every arm of a switch (and its else) leaves (block_leaves):
  // read before the switch is checked.
  pub fn switch_arms_leave(e: Expr): Bool {
    for cs in e.cases {
      if !block_leaves(cs.body) {
        return false
      }
    }
    if e.has_else {
      return block_leaves(e.else_body)
    }
    e.cases.size > 0
  }

  pub fn coalesce_result(left: Ty, right_expr: Expr, loc: Location, opname: String): Ty {
    fails = ty_failures(left)
    if right_expr.kind == ex_switch() && right_expr.op == tk_return() {
      // `x ?? return v`, `?? break`, `?? continue`: the statement runs
      // on any failure and leaves; the value is the success part.
      payload = ty_without_nil(left)
      if s = ty_success_part(left) {
        payload = s
      }
      for st in right_expr.else_body {
        check_block_stmt(st, self.return_type, false)
      }
      right_expr.ty = payload
      return payload
    }
    if !(fails.size == 1 && fails[0].is_nil()) || !left.is_nilable() {
      // A failure other than nil, or a success part of several
      // members: the fallback is a value of the success part.
      payload = left
      if s = ty_success_part(left) {
        payload = s
      }
      right = check_expr_as(right_expr, payload)
      if ty_assignable(right, payload) {
        return payload
      }
      fail(loc, "${opname} fallback must be ${payload.show()}, got ${right.show()}")
      return payload
    }
    payload = ty_without_nil(left)
    if right_expr.kind == ex_nil() {
      check_expr(right_expr)
      return left
    }
    right = check_expr_as(right_expr, payload)
    if right.is_nil() {
      return left
    }
    if right.is_nilable() {
      rp = ty_without_nil(right)
      if rp.same_as(payload) {
        return left
      }
      fail(loc, "${opname} fallback must be ${payload.show()}, got ${right.show()}")
      return left
    }
    if ty_assignable(right, payload) {
      return payload
    }
    fail(loc, "${opname} fallback must be ${payload.show()}, got ${right.show()}")
    payload
  }

  // `x?`: the failures of x (nil and the members marked Error, type.av
  // ty_failures) go up only where the body's result can hold each of
  // them; the value is the success part (one type or a smaller union).
  // Anything else is a compile error that names what would be returned
  // and the ways out (before, a `nil` silently became `0` in an `Int`
  // function, and the failure was whichever member the result type
  // happened to hold).
  pub fn split_try_success(got: Ty, loc: Location): Ty {
    if self.try_in == defer_context() {
      fail(loc, defer_exit_message("postfix ?"))
      return t_int()
    }
    if self.try_in == "a spawn block" || self.try_in == "a parallel block" || self.try_in == "a lambda given to parallel" {
      // A spawn block's `?` ends the task with the failure, which the
      // join gives: the block's value becomes a union with it (a
      // .parallel body's, that element of the result, whether the body
      // is a block or a lambda in parentheses).
      if got.is_union() && ty_failures(got).size > 0 && !ty_has_success(got) {
        fail(loc, "postfix ? on ${got.show()}: it has no success value (every member but nil is marked Error), so ? would pass up nil and continue with the error; open it with if-assign or ??")
        return t_int()
      }
      if success = failure_split(got, loc, "postfix ?") {
        for f in ty_failures(got) {
          self.spawn_fails.push(f)
        }
        return success
      }
      return t_int()
    }
    if self.inline_what.size > 0 {
      // A lambda in parentheses whose written result type holds every
      // failure (`m.with((x): Int | ParseError { parse(x)? })`): `?`
      // ends this run of its body with the failure as the lambda's
      // value, as `return` would (inline_try_returns); any other is
      // refused, with the way out.
      if inline_try_returns(got) {
        if t = self.inline_target {
          t.returns = true
        }
        if success = failure_split(got, loc, "postfix ?") {
          return success
        }
        return t_int()
      }
      fail(loc, inline_exit_message("?", self.inline_what))
      return t_int()
    }
    if self.try_in == "a lambda whose result type is inferred" {
      fail(loc, "postfix ? inside a lambda whose result type is inferred cannot return the failure: write the result type with the failure in it, as (): Int | ParseError { ... }, or handle it with if-assign or ??")
      return t_int()
    }
    if self.try_in.size > 0 {
      fail(loc, "postfix ? inside ${self.try_in} cannot return the failure; handle it with if-assign or ??")
      return t_int()
    }
    ret = self.return_type
    ret_shown = ret.show()
    if self.entry_void {
      if cf = self.current_fn {
        ret_shown = cf.entry_shown
      }
    }
    if got.is_union() && ty_failures(got).size > 0 && !ty_has_success(got) {
      fail(loc, "postfix ? on ${got.show()}: it has no success value (every member but nil is marked Error), so ? would pass up nil and continue with the error; open it with if-assign or ??")
      return t_int()
    }
    if success = failure_split(got, loc, "postfix ?") {
      fails = ty_failures(got)
      missing: Array(Ty) = []
      for f in fails {
        if !ty_assignable(f, ret) {
          missing.push(f)
        }
      }
      if missing.size == 0 {
        return success
      }
      if fails.size == 1 && fails[0].is_nil() {
        if ret.is_void() {
          fail(loc, "postfix ? would return nil, but ${self.try_body} returns nothing; give it a result that includes nil, or handle the nil with if-assign or ??")
        } else if self.entry_void {
          fail(loc, "postfix ? would return nil, but ${self.try_body} returns ${ret_shown}, which holds no nil; handle the nil with if-assign or ??")
        } else {
          fail(loc, "postfix ? would return nil, but ${self.try_body} returns ${ret_shown}; declare the result ${ty_nilable(ret).show()}, or handle the nil with if-assign or ??")
        }
        return t_int()
      }
      what = ty_union_build(missing).show()
      if ret.is_void() {
        fail(loc, "postfix ? on ${got.show()} would return ${what}, but ${self.try_body} returns nothing; give it a result that includes ${what}, or handle the failure with if-assign or ??")
      } else {
        fail(loc, "postfix ? on ${got.show()} would return ${what}, but ${self.try_body} returns ${ret_shown}; give it a result that includes ${what}, or handle the failure with if-assign or ??")
      }
    }
    t_int()
  }

  // Whether `?` on got, in a lambda a builtin inlines, returns its
  // failure from the lambda: the lambda's result type is written and is
  // a union that holds every failure of got (an error union, or an
  // optional for a nil), and got has a success value.
  pub fn inline_try_returns(got: Ty): Bool {
    ret = self.return_type
    if ret.is_var() || ret.is_void() || !ret.is_union() {
      return false
    }
    if !got.is_union() || !ty_has_success(got) {
      return false
    }
    fails = ty_failures(got)
    if fails.size == 0 {
      return false
    }
    for f in fails {
      if !ty_assignable(f, ret) {
        return false
      }
    }
    true
  }

  pub fn check_interp(expr: Expr): Ty {
    for part in expr.parts {
      if inner = part.expr {
        ty = check_expr(inner)
        if (ty.is_agg() || ty.is_enum()) && !ty.error_mark && !self.has_err() && user_op(ty, "to_s") {
          // A type that defines `fn to_s: String` prints its text.
          if call = own_text_call(inner, ty) {
            part.expr = call
          }
          continue
        }
        if ty.error_mark && !self.has_err() {
          // An error prints its message: the part becomes the call of
          // the method the parser added to the type (parser.av
          // error_text_method); inner is checked once.
          fa = Expr.new(ex_field(), inner.loc)
          fa.object = inner
          fa.ident = "__avant_error_text"
          arg_tys: Array(Ty) = []
          none: Ty? = nil
          if sig = match_method(ty.name, fa.ident, arg_tys, none, inner.loc, ty.name, ty.mod_name, no_int_literals()) {
            fa.method_call = true
            fa.resolved = sig.node.emit_name
            fa.ty = sig.ret
            part.expr = fa
          }
          continue
        }
        if ty.is_enum() && !self.has_err() {
          // An enum prints its member's name.
          if call = enum_text_call(inner, ty) {
            part.expr = call
          }
          continue
        }
        if ty.is_union() && !self.has_err() {
          // A union prints its member.
          if sw = union_text(inner, ty) {
            part.expr = sw
          }
          continue
        }
        ok = false
        if ty.is_integer() {
          ok = true
        }
        if ty.is_string() {
          ok = true
        }
        if ty.is_float() {
          ok = true
        }
        if ty.is_bool() {
          ok = true
        }
        if !ok {
          fail(inner.loc, "cannot interpolate ${ty.show()}")
        }
      }
    }
    t_string()
  }

  // Whether `x.to_s` of a value of ty is the text interpolation prints,
  // "${x}": every type that prints and does not define to_s itself (a
  // scalar's is the builtin_method's); an optional is opened first, as
  // interpolation says.
  pub fn text_to_s(ty: Ty): Bool {
    if ty.is_enum() || ty.error_mark {
      return !user_op(ty, "to_s")
    }
    ty.is_union()
  }

  // The call of ty's own `fn to_s: String` on inner (checked already),
  // the text interpolation prints; nil, with the error given, when the
  // method is not that signature.
  pub fn own_text_call(inner: Expr, ty: Ty): Expr? {
    fa = Expr.new(ex_field(), inner.loc)
    fa.object = inner
    fa.ident = "to_s"
    arg_tys: Array(Ty) = []
    none: Ty? = nil
    if sig = match_method(ty.name, "to_s", arg_tys, none, inner.loc, ty.name, ty.mod_name, no_int_literals()) {
      if !sig.ret.is_string() {
        fail(inner.loc, "cannot interpolate ${ty.show()}: its to_s returns ${sig.ret.show()}, and the text it prints is fn to_s: String")
        return nil
      }
      fa.method_call = true
      fa.resolved = sig.node.emit_name
      fa.ty = sig.ret
      return fa
    }
    nil
  }

  // What printing a value of the enum ty prints: the call of its `name`
  // (an enum marked Error: its error text), checked; inner is checked
  // already.
  pub fn enum_text_call(inner: Expr, ty: Ty): Expr? {
    fa = Expr.new(ex_field(), inner.loc)
    fa.object = inner
    fa.ident = "name"
    if ty.error_mark {
      fa.ident = "__avant_error_text"
    }
    arg_tys: Array(Ty) = []
    none: Ty? = nil
    if sig = match_method(ty.name, fa.ident, arg_tys, none, inner.loc, ty.name, ty.mod_name, no_int_literals()) {
      fa.method_call = true
      fa.resolved = sig.node.emit_name
      fa.ty = sig.ret
      return fa
    }
    nil
  }

  pub fn check_float_field(expr: Expr): Ty {
    if float_math_unary(expr.ident).size > 0 {
      expr.method_call = true
      return t_float()
    }
    if expr.ident == "to_bits" {
      expr.method_call = true
      return t_uint64()
    }
    if expr.ident == "to_i" {
      expr.method_call = true
      return t_int()
    }
    field_as_call(expr, t_float())
  }

  pub fn check_int_field(expr: Expr, object: Ty): Ty {
    if expr.ident == "to_f" {
      expr.method_call = true
      return t_float()
    }
    if expr.ident == "abs" {
      expr.method_call = true
      if object.is_unsigned() {
        fail(expr.loc, "abs of a ${object.show()} is the value itself")
      }
      return object
    }
    if rt = int_conversion_ty(expr.ident) {
      expr.method_call = true
      return rt
    }
    if int_bit_count(expr.ident).size > 0 {
      expr.method_call = true
      return t_int()
    }
    now = removed_int_conversion(expr.ident)
    if now.size > 0 {
      fail(expr.loc, removed_int_message(expr.ident, now))
      return t_int()
    }
    field_as_call(expr, object)
  }

  // One rule for empty parentheses: a builtin method without arguments may
  // be written without `()`. A field form the lists above do not name
  // becomes the call `recv.name()` and is checked as one (its receiver is
  // already checked), so `s.strip` is `s.strip()` and an unknown name
  // reads "no method name on T".
  pub fn field_as_call(expr: Expr, object: Ty): Ty {
    if obj = expr.object {
      expr.kind = ex_call()
      expr.callee = expr.ident
      expr.receiver = obj
      expr.object = nil
      return builtin_method(expr, object)
    }
    fail_hint(expr.loc, "${object.show()} has no field ${expr.ident}", builtin_hint(object, expr.ident))
    t_int()
  }

  // A Bool as a number (`alive.to_i32`): 1 for true, 0 for false, in the
  // integer type the conversion names; nil for another name. It counts
  // without a branch (the value is zero-extended).
  pub fn bool_conversion_ty(name: String): Ty? {
    if name == "to_i" || name == "to_i32" || name == "to_u32" || name == "to_u64" {
      return int_conversion_ty(name)
    }
    nil
  }

  // The method checkers of the builtin receiver types.
  pub fn builtin_method(expr: Expr, object: Ty): Ty {
    if object.is_array() || object.is_hash() || object.is_set() {
      absorb_lambda_arg(expr, object)
    }
    if got = check_shared_verb(expr, object) {
      return got
    }
    // `n.to_s(base)`: the formatting part's function (prelude_src.av
    // fmt_prelude_source), called as written.
    if expr.callee == "to_s" && object.is_integer() && expr.args.size == 1 && expr.field_exprs.size == 0 {
      if b0 = expr.block {
      } else if recv = expr.receiver {
        base = expr.args[0]
        parts: Array(Expr) = []
        parts.push(recv)
        parts.push(base)
        expr.receiver = nil
        expr.callee = "__avant_to_s_base"
        expr.args = parts
        return check_call(expr, false, t_int())
      }
    }
    // One text for every scalar.
    if expr.callee == "to_s" && (object.is_integer() || object.is_float() || object.is_bool() || object.is_string()) {
      return scalar_to_s(expr, object)
    }
    if object.is_float() {
      return check_float_method(expr)
    }
    if object.is_integer() {
      return check_int_method(expr, object)
    }
    if object.is_string() {
      return check_string_method(expr)
    }
    if object.is_bytes() {
      return check_bytes_method(expr)
    }
    if object.is_array() {
      return check_array_method(expr, object)
    }
    if object.is_set() {
      return check_set_method(expr, object)
    }
    if object.is_hash() {
      return check_hash_method(expr, object)
    }
    if object.is_buf() {
      return check_buf_method(expr)
    }
    check_join(expr, object)
  }

  // Whether the member `x.name`, written without parentheses and now
  // checked, is a method call: the checker made it a call (or what a
  // call becomes: `n.to_s` is the interpolation "${n}"), or marked it
  // one; a builtin read-only property (`size`, `bytes`) is not one.
  pub fn member_is_call(expr: Expr): Bool {
    if expr.kind == ex_int() || expr.kind == ex_float() || expr.kind == ex_unary() {
      // A C array's `.size`, or a type's constant (`Int.min`,
      // `Float64.pi`), written in place as its literal.
      return false
    }
    if expr.kind == ex_call() && expr.callee == "message" && expr.args.size == 0 {
      // An error's message is read as `e.message` on every type marked
      // Error, whether the type keeps it in a field or computes it in a
      // method: the one thing every error has, spelled one way.
      if recv = expr.receiver, rt = recv.ty, rt.error_mark {
        return false
      }
    }
    if expr.kind != ex_field() {
      return true
    }
    if !expr.method_call {
      return false
    }
    if obj = expr.object, ot = obj.ty, is_builtin_property(ot, expr.ident) {
      return false
    }
    if expr.ident == "message" {
      if obj2 = expr.object, ot2 = obj2.ty, ot2.error_mark {
        return false
      }
    }
    true
  }

  // A method call written without parentheses (at is its name's place,
  // name the name as written: the check may have renamed the call) is
  // refused: every method call takes them, and a name without them is a
  // field or one of the builtin read-only properties (`size` of a String,
  // Bytes, Buf, Array or Hash; `bytes` of a String). Not in a statement
  // that already has an error: a failed
  // receiver reads as an Int, whose members are all methods.
  pub fn bare_call(expr: Expr, at: Location, name: String) {
    if self.has_err() {
      return
    }
    if t = self.target_expr, t.loc.line() == expr.loc.line() && t.loc.column() == expr.loc.column() && t.loc.path == expr.loc.path {
      return
    }
    fail(at, "a method call takes parentheses: write ${name}()")
  }

  // `Int.max`, `Int32.min`, `UInt64.max`, `Float64.pi`, `Float64.e`: the
  // bounds of the four integer types and the two float constants. The
  // expression becomes its literal (a negative one is the negation of
  // its magnitude, as `-9223372036854775808` is written); nil for any
  // other name.
  pub fn builtin_type_constant(obj: Expr, expr: Expr): Ty? {
    if obj.kind != ex_name() || obj.type_args.size > 0 {
      return nil
    }
    if v = lookup(obj.ident) {
      return nil
    }
    n = obj.ident
    f = expr.ident
    if n == "Float64" && (f == "pi" || f == "e") {
      expr.kind = ex_float()
      expr.object = nil
      if f == "pi" {
        expr.float_val = 3.141592653589793
        expr.value_str = "3.141592653589793"
      } else {
        expr.float_val = 2.718281828459045
        expr.value_str = "2.718281828459045"
      }
      return t_float()
    }
    if f != "max" && f != "min" {
      return nil
    }
    ty = t_int()
    max = 9223372036854775807u64
    min = 9223372036854775808u64
    if n == "Int32" {
      ty = Ty.new(tyk_int32())
      max = 2147483647u64
      min = 2147483648u64
    } else if n == "UInt32" {
      ty = Ty.new(tyk_uint32())
      max = 4294967295u64
      min = 0u64
    } else if n == "UInt64" {
      ty = t_uint64()
      max = 18446744073709551615u64
      min = 0u64
    } else if n != "Int" {
      return nil
    }
    expr.object = nil
    if f == "max" || min == 0 {
      expr.kind = ex_int()
      expr.int_bits = max
      if f == "min" {
        expr.int_bits = 0
      }
      return ty
    }
    mag = Expr.new(ex_int(), expr.loc)
    mag.int_bits = min
    mag.ty = ty
    expr.kind = ex_unary()
    expr.op = tk_minus()
    expr.inner = mag
    ty
  }

  pub fn check_field(expr: Expr): Ty {
    carray_here = self.carray_ok
    self.carray_ok = false
    if obj = expr.object {
      // An enum's member (`Tok.eof`): a value of the enum, marked
      // type_call for the lowering.
      if et = enum_type_named(obj) {
        if et.enum_index(expr.ident) >= 0 {
          expr.type_call = true
          return et
        }
        if tc = type_call_target(obj, expr.ident) {
        } else {
          fail_hint(expr.loc, "${et.show()} has no member ${expr.ident}", member_hint(et, expr.ident, false))
          return et
        }
      }
      if ty = type_call_target(obj, expr.ident) {
        // A type-level function in field form (`Money.zero`, declared
        // `fn self.zero: Money`), as a method without parameters is called
        // `a.twice`: the expression becomes that call.
        expr.kind = ex_call()
        expr.callee = expr.ident
        expr.receiver = obj
        expr.object = nil
        return check_type_call(expr, ty)
      }
      if obj.kind == ex_name() && obj.type_args.size > 0 {
        if is_generic_template_in(obj.ident, obj.mod_name) {
          take_type_app(obj)
        } else {
          call = type_app_as_call(obj)
          expr.object = call
          obj = call
        }
      }
      if ct = builtin_type_constant(obj, expr) {
        return ct
      }
      // `T.name` on a type without that type-level function.
      tn = receiver_type_name(obj)
      if tn.size > 0 {
        fail_no_type_fn(expr.loc, obj, tn, expr.ident)
        return t_int()
      }
      mark = err_count()
      self.recv_name = obj.kind == ex_name()
      self.recv_type = ""
      self.carray_ok = expr.ident == "size"
      object = check_expr(obj)
      self.carray_ok = false
      self.recv_name = false
      if object.is_carray() {
        if expr.ident == "size" {
          // `r.vtype.size`: N, a constant.
          expr.kind = ex_int()
          expr.int_bits = object.count.to_u64()
          expr.object = nil
          return t_int()
        }
        fail(expr.loc, "${object.show()} is a C array: read it with [i] and .size (.to_s() reads an Int8 or UInt8 array as text)")
        return t_int()
      }
      if self.recv_type.size > 0 {
        fail_no_type_fn(expr.loc, obj, self.recv_type, expr.ident)
        return t_int()
      }
      if new_err_since(mark) && is_ident_chain(obj) {
        return t_int()
      }
      if object.is_enum() {
        // `t.to_i`, `t.name` and the enum's methods, as calls.
        return paren_call_of(expr)
      }
      if object.is_float() {
        return check_float_field(expr)
      }
      if object.is_integer() {
        return check_int_field(expr, object)
      }
      if object.is_bool() && expr.ident == "to_s" {
        return field_as_call(expr, object)
      }
      if object.is_bool() {
        if bt = bool_conversion_ty(expr.ident) {
          expr.method_call = true
          return bt
        }
      }
      if object.is_string() {
        if expr.ident == "size" {
          return t_int()
        }
        if expr.ident == "bytes" {
          expr.method_call = true
          return t_bytes()
        }
        if expr.ident == "chars" {
          expr.method_call = true
          return ty_array(t_string())
        }
        if got = builtin_ext_call(expr, object) {
          return got
        }
        return field_as_call(expr, object)
      }
      if object.is_bytes() {
        if expr.ident == "size" {
          return t_int()
        }
        if expr.ident == "to_buf" {
          expr.method_call = true
          return t_buf()
        }
        if expr.ident == "chars" {
          expr.method_call = true
          return ty_array(t_string())
        }
        if got = builtin_ext_call(expr, object) {
          return got
        }
        return field_as_call(expr, object)
      }
      if object.is_array() {
        if expr.ident == "size" {
          return t_int()
        }
        if expr.ident == "pop" {
          expr.method_call = true
          if e = object.inner {
            return ty_nilable(e)
          }
          return ty_nilable(t_int())
        }
        if expr.ident == "clear" {
          expr.method_call = true
          return t_void()
        }
        if (expr.ident == "sort" || expr.ident == "sorted" || expr.ident == "min" || expr.ident == "max") && user_ordered(object) {
          // By the element's own <: as calls.
          return field_as_call(expr, object)
        }
        if expr.ident == "sort" {
          expr.method_call = true
          if e = object.inner, !is_ordered_ty(e) {
            fail(expr.loc, "Array.sort needs an ordered element type or a comparator block")
          }
          return t_void()
        }
        if expr.ident == "sorted" {
          expr.method_call = true
          if e = object.inner {
            if !is_ordered_ty(e) {
              fail(expr.loc, "Array.sorted needs an ordered element type or a comparator block")
            }
            return ty_array(e)
          }
          return ty_array(t_int())
        }
        if expr.ident == "reverse" {
          expr.method_call = true
          return t_void()
        }
        if expr.ident == "min" {
          expr.method_call = true
          if e = object.inner {
            if is_ordered_ty(e) {
              if e.is_bool() {
                fail(expr.loc, "Array.min needs an ordered element type")
              }
            } else {
              fail(expr.loc, "Array.min needs an ordered element type")
            }
            return ty_nilable(e)
          }
          return ty_nilable(t_int())
        }
        if expr.ident == "max" {
          expr.method_call = true
          if e = object.inner {
            if is_ordered_ty(e) {
              if e.is_bool() {
                fail(expr.loc, "Array.max needs an ordered element type")
              }
            } else {
              fail(expr.loc, "Array.max needs an ordered element type")
            }
            return ty_nilable(e)
          }
          return ty_nilable(t_int())
        }
        if expr.ident == "sum" {
          expr.method_call = true
          if e = object.inner {
            if is_numeric_ty(e) {
              return e
            }
            fail(expr.loc, "Array.sum needs a numeric element type")
            return e
          }
          return t_int()
        }
        return field_as_call(expr, object)
      }
      if object.is_hash() {
        if expr.ident == "size" {
          return t_int()
        }
        if expr.ident == "keys" && !object.is_set() {
          expr.method_call = true
          if k = object.key {
            return ty_array(k)
          }
          return ty_array(t_int())
        }
        if expr.ident == "values" {
          expr.method_call = true
          if v = object.val {
            return ty_array(v)
          }
          return ty_array(t_int())
        }
        if expr.ident == "clear" {
          expr.method_call = true
          return t_void()
        }
        return field_as_call(expr, object)
      }
      if object.is_buf() {
        if expr.ident == "size" {
          return t_int()
        }
        if expr.ident == "to_bytes" {
          expr.method_call = true
          return t_bytes()
        }
        if expr.ident == "to_s" {
          expr.method_call = true
          return t_string()
        }
        if expr.ident == "clear" {
          expr.method_call = true
          return t_void()
        }
        if got = builtin_ext_call(expr, object) {
          return got
        }
        return field_as_call(expr, object)
      }
      if object.is_join() {
        if expr.ident == "join" {
          expr.method_call = true
          if inner = object.inner {
            return join_result(inner)
          }
          return join_result(t_int())
        }
        return field_as_call(expr, object)
      }
      if expr.ident == "to_s" && text_to_s(object) {
        return paren_call_of(expr)
      }
      if object.is_bool() && owner_has_method("Bool", expr.ident) {
        return paren_call_of(expr)
      }
      if object.is_agg() {
        if field_ty = object.field_named(expr.ident) {
          if user_op(object, expr.ident) {
            fail(expr.loc, "${object.name}.${expr.ident} is both a field and a method")
            return field_ty
          }
          check_field_visible(object, expr.ident, expr.loc)
          return field_ty
        }
        has_zero = false
        for ms in self.methods {
          owner_hit = false
          if ms.is_method_of(object) {
            owner_hit = true
          } else {
            if object.origin.size > 0 && ms.node.generic && ms.owner == object.origin {
              owner_hit = true
            }
          }
          if owner_hit && ms.name == expr.ident && arity_ok(ms.node, 0) {
            has_zero = true
          }
        }
        if has_zero {
          arg_tys: Array(Ty) = []
          none: Ty? = nil
          if sig = match_method(object.name, expr.ident, arg_tys, none, expr.loc, object.name, object.mod_name, no_int_literals()) {
            if sig.node.params.size > 0 {
              return paren_call_of(expr)
            }
            expr.method_call = true
            expr.resolved = sig.node.emit_name
            return sig.ret
          }
          return t_int()
        }
        has_method = false
        for ms in self.methods {
          owner_hit = false
          if ms.is_method_of(object) {
            owner_hit = true
          } else {
            if object.origin.size > 0 && ms.node.generic && ms.owner == object.origin {
              owner_hit = true
            }
          }
          if owner_hit && ms.name == expr.ident {
            has_method = true
          }
        }
        if has_method {
          fail(expr.loc, "methods are not values")
        } else {
          fail_hint(expr.loc, "no field ${expr.ident} on ${object.name}", field_hint(object, expr.ident))
        }
        return t_int()
      }
      if object.is_ptr() {
        return carray_member(expr, check_ptr_member(expr, object), carray_here)
      }
      if object.is_clayout() {
        return carray_member(expr, check_clayout_member(expr, object), carray_here)
      }
      if object.is_module() {
        // A qualified name that is no function, constant or type of the
        // module (it read as a field of the module).
        fail_hint(expr.loc, "unknown name ${object.name}.${expr.ident}", module_name_hint(object.name, expr.ident))
        return t_int()
      }
      fail_hint(expr.loc, "cannot read field ${expr.ident} on ${object.show()}", open_hint(obj, object))
      return t_int()
    }
    t_int()
  }

  pub fn clayout_value_name(ty: Ty): String {
    if ty.is_clayout() {
      return ty.show()
    }
    if ty.is_array() {
      if e = ty.inner {
        return clayout_value_name(e)
      }
    }
    if ty.is_union() {
      if !ty_walk_enter(ty, wk_clayout()) {
        return ""
      }
      found = ""
      i = 0
      while i < ty.members.size && found.size == 0 {
        found = clayout_value_name(ty.members[i])
        i += 1
      }
      ty_walk_leave(ty, wk_clayout())
      return found
    }
    ""
  }

  pub fn reject_clayout_value(ty: Ty, loc: Location): Bool {
    name = clayout_value_name(ty)
    if name.size > 0 {
      fail(loc, "${name} is a C layout; use Ptr(${name})")
      return true
    }
    false
  }

  pub fn builtin_ext_call(expr: Expr, object: Ty): Ty? {
    owner = object.show()
    has_zero = false
    for ms in self.methods {
      if ms.owner == owner && ms.name == expr.ident && arity_ok(ms.node, 0) && method_is_visible(ms.node, self.current_module) {
        has_zero = true
      }
    }
    if has_zero {
      arg_tys: Array(Ty) = []
      none: Ty? = nil
      if sig = match_method(owner, expr.ident, arg_tys, none, expr.loc, object.show_bare(), "", no_int_literals()) {
        if sig.node.params.size > 0 {
          return paren_call_of(expr)
        }
        expr.method_call = true
        expr.resolved = sig.node.emit_name
        return sig.ret
      }
    }
    nil
  }

  // `release(place)`: a field of a C layout that holds a reference (a
  // `String`, or a nested layout with one), or a `Ptr` to a C layout
  // with such a field (the whole struct).
  pub fn check_release(e: Expr, et: Ty) {
    in_c = false
    name = ""
    if e.kind == ex_field() && !e.method_call {
      if obj = e.object, ot = obj.ty {
        in_c = ot.is_ptr() || ot.is_clayout()
      }
      name = e.ident
    }
    if in_c {
      if et.is_string() {
        return
      }
      if r = ty_opt_ref(et), r.is_string() {
        return
      }
      if et.is_clayout() {
        if !clayout_holds_ref(et) {
          fail(e.loc, "nothing to release: ${name} is ${et.show()}, which has no String field")
        }
        return
      }
      hint = ""
      if et.is_ptr() {
        if inner = et.inner, inner.is_clayout() && clayout_holds_ref(inner) {
          hint = " (to release the struct it points to, name the pointer first: p = x.${name}, then release(p))"
        }
      }
      fail(e.loc, "nothing to release: ${name} is ${et.show()}${hint}")
      return
    }
    if et.is_ptr() {
      if inner = et.inner, inner.is_clayout() {
        if !clayout_holds_ref(inner) {
          fail(e.loc, "nothing to release: ${inner.show()} has no String field")
        }
        return
      }
      fail(e.loc, "release needs the fields of a C layout; Avant knows no fields of ${et.show()}")
      return
    }
    heap = et.is_string() || et.is_bytes() || et.is_buf() || et.is_array() || et.is_hash() || et.is_class() || et.is_fn() || et.is_join()
    if heap {
      fail(e.loc, "release takes the C field the value was stored in; for a scoped pin use pin(x) { }")
      return
    }
    fail(e.loc, "release takes a C-layout field or a Ptr to a C layout, got ${et.show()}")
  }

  // `c.recv` where every parameter of `recv` has a default: the call
  // `c.recv()`. The member node becomes that call, so its defaults are
  // spliced and checked, and every later walk sees them, as for the form
  // with parentheses (before, the member was lowered as a call without
  // its arguments, and the MIR verifier stopped the build).
  pub fn paren_call_of(expr: Expr): Ty {
    if recv = expr.object {
      expr.kind = ex_call()
      expr.callee = expr.ident
      expr.receiver = recv
      expr.object = nil
      return check_method_call(expr, recv, false, t_int())
    }
    t_int()
  }

  // `p.as(T)`: a Ptr(Void) as a Ptr(T) (C's cast of a `void *`), T any
  // type a Ptr points to, written as a type (`v.as(Pair)`, `v.as(UInt8)`,
  // `v.as(Ptr(Node)?)`). A Ptr(T) passes as a Ptr(Void) without it.
  pub fn check_ptr_as(expr: Expr, object: Ty): Ty {
    if inner = object.inner, !inner.is_void() {
      fail(expr.loc, "as converts a Ptr(Void); ${object.show()} is already typed (it passes as a Ptr(Void) as it is)")
      return object
    }
    if expr.args.size != 1 {
      fail(expr.loc, "as takes one type: p.as(Pair)")
      return object
    }
    if tn = expr_type_name(expr.args[0]) {
      wrap = TypeName.new(expr.args[0].loc, "Ptr")
      wrap.args.push(tn)
      t = resolve_in_module(wrap)
      self.pull_resolve()
      expr.resolved = "ptr.as"
      expr.args[0].ty = t
      return t
    }
    fail(expr.args[0].loc, "as takes a type: p.as(Pair), p.as(UInt8), p.as(Ptr(Node))")
    object
  }

  // The type name an argument written as a type spells (`Pair`, `UInt8`,
  // `Ptr(Node)`, `Ptr(Node)?`, `mod.Pair`), or nil.
  pub fn expr_type_name(e: Expr): TypeName? {
    if e.kind == ex_try() {
      // `Ptr(Node)?` reads as a `?` after the type: an optional pointer.
      if i = e.inner, tn0 = expr_type_name(i) {
        tn0.nilable = true
        return tn0
      }
      return nil
    }
    if e.kind == ex_name() && e.type_args.size == 0 {
      tn = TypeName.new(e.loc, e.ident)
      tn.mod_name = e.mod_name
      return tn
    }
    if e.kind == ex_name() && e.type_args.size > 0 {
      tn2 = TypeName.new(e.loc, e.ident)
      tn2.mod_name = e.mod_name
      tn2.args.concat(e.type_args)
      return tn2
    }
    if e.kind == ex_call() && e.args.size == 1 {
      if r = e.receiver {
        return nil
      }
      if inner = expr_type_name(e.args[0]) {
        tn3 = TypeName.new(e.loc, e.callee)
        tn3.args.push(inner)
        return tn3
      }
    }
    nil
  }

  // A field of C memory that is a C array (`T[N]`) is read only by its
  // readers (carray_ok); anywhere else it is refused, since it is no value.
  pub fn carray_member(expr: Expr, got: Ty, ok: Bool): Ty {
    if got.is_carray() && !ok {
      fail(expr.loc, "${expr.ident} is a C array (${got.show()}), not a value: read its elements with .${expr.ident}[i], its length with .${expr.ident}.size, an Int8 or UInt8 array's text with .${expr.ident}.to_s()")
      return t_int()
    }
    got
  }

  // Whether the method ms (its owner's name already matched) takes a
  // receiver of type object: a Ptr's owner name does not say which
  // module's C layout it points to, its receiver's type does.
  pub fn ptr_method_of(ms: FuncSig, object: Ty): Bool {
    if r = ms.node.receiver {
      return recv_ty_of(ms.node).same_as(object)
    }
    true
  }

  pub fn check_ptr_member(expr: Expr, object: Ty): Ty {
    owner = method_owner_name(object)
    pointee = object
    if inner = object.inner {
      pointee = inner
    }
    if pointee.is_clayout() {
      if field_ty = pointee.field_named(expr.ident) {
        for ms0 in self.methods {
          if ms0.owner == owner && ms0.name == expr.ident && ptr_method_of(ms0, object) {
            fail(expr.loc, "${pointee.name}.${expr.ident} is both a field and a method")
            return ty_c_view(field_ty)
          }
        }
        return ty_c_view(field_ty)
      }
    }
    has_zero = false
    for ms in self.methods {
      if ms.owner == owner && ms.name == expr.ident && arity_ok(ms.node, 0) && ptr_method_of(ms, object) {
        has_zero = true
      }
    }
    if has_zero {
      arg_tys: Array(Ty) = []
      none: Ty? = nil
      if sig = match_method(owner, expr.ident, arg_tys, none, expr.loc, object.show(), object.mod_name, no_int_literals()) {
        if sig.node.params.size > 0 {
          return paren_call_of(expr)
        }
        expr.method_call = true
        expr.resolved = sig.node.emit_name
        return sig.ret
      }
      return t_int()
    }
    fail(expr.loc, "no field ${expr.ident} on ${object.show()}")
    t_int()
  }

  pub fn check_clayout_member(expr: Expr, object: Ty): Ty {
    if field_ty = object.field_named(expr.ident) {
      return ty_c_view(field_ty)
    }
    fail(expr.loc, "no field ${expr.ident} on ${object.show()}")
    t_int()
  }

  // `p[i]` through a Ptr to a C scalar or a pointer: element i of the C
  // array at p, of the element's Avant type (a narrow C scalar reads as
  // its view). C gives no length, so i is not checked; a NULL p traps.
  pub fn check_ptr_index(expr: Expr, container: Ty, ix: Expr): Ty {
    got = check_expr_as(ix, t_int())
    if !got.is_int() {
      fail(ix.loc, "a Ptr's index must be Int, got ${got.show()}")
    }
    if inner = container.inner {
      if ptr_elem_ok(inner) {
        return ty_c_view(inner)
      }
      if inner.is_clayout() {
        fail(expr.loc, "cannot index ${container.show()}: p[i] reads C scalars and pointers; a layout's fields are read through the pointer (p.x)")
        return t_int()
      }
      fail(expr.loc, "cannot index ${container.show()}: it points to no elements Avant knows; give it a type first (p.as(UInt8))")
      return t_int()
    }
    fail(expr.loc, "cannot index ${container.show()}")
    t_int()
  }

  pub fn check_index(expr: Expr): Ty {
    if arr = expr.left, ix = expr.right {
      if arr.kind == ex_name() && !arr.implicit_field {
        cont = arr.ident
        if ix.kind == ex_name() {
          fi = fact_best(ix.ident, cont)
          if fi >= 0 {
            expr.proven = true
            log_use(fi, expr)
          }
        } else if ix.kind == ex_binary() {
          if ix.op == tk_plus() {
            if il = ix.left, ir = ix.right {
              if il.kind == ex_name() && lit_small(ir) {
                fi = fact_best(il.ident, cont)
                if fi >= 0 && ir.int_bits <= self.facts.fact_slack[fi].to_u64() {
                  expr.proven = true
                  ix.proven = true
                  log_use(fi, expr)
                }
              }
              if ir.kind == ex_name() && lit_small(il) {
                fi = fact_best(ir.ident, cont)
                if fi >= 0 && il.int_bits <= self.facts.fact_slack[fi].to_u64() {
                  expr.proven = true
                  ix.proven = true
                  log_use(fi, expr)
                }
              }
            }
          }
        }
      }
      if ix.kind == ex_binary() && (ix.op == tk_plus() || ix.op == tk_minus()) {
        if il = ix.left, ir = ix.right, il.kind == ex_int() || ir.kind == ex_int() {
          ix.proven = true
        }
      }
      self.carray_ok = true
      container = check_expr(arr)
      self.carray_ok = false
      if container.is_carray() {
        got = check_expr_as(ix, t_int())
        if !got.is_int() {
          fail(ix.loc, "a C array's index must be Int, got ${got.show()}")
        }
        if ce = container.inner {
          return ty_c_view(ce)
        }
        return t_int()
      }
      if container.is_agg() && user_op(container, "[]") {
        // `c[i]` is the call `c.[](i)`.
        rewrite_op_call(expr, arr, "[]", index_args(expr))
        return check_expr_core(expr, false, t_int())
      }
      if expr.elems.size > 0 {
        fail(expr.elems[0].loc, "${container.show()} takes one index; several (g[x, y]) are for a type that defines fn [] with as many parameters")
        return t_int()
      }
      if container.is_string() || container.is_buf() || container.is_bytes() {
        got = check_expr_as(ix, t_int())
        if !got.is_int() {
          fail(ix.loc, "index must be Int, got ${got.show()}")
        }
        return t_int()
      }
      if container.is_set() {
        fail(expr.loc, "a Set has no [ ]: s.has(v) says whether v is in it")
        return t_bool()
      }
      if container.is_hash() {
        if k = container.key {
          key = check_expr_as(ix, k)
          if !ty_assignable(key, k) {
            fail(ix.loc, "hash key must be ${k.show()}, got ${key.show()}")
          }
        }
        if v = container.val {
          return ty_nilable(v)
        }
        return t_int()
      }
      if container.is_array() {
        got = check_expr_as(ix, t_int())
        if !got.is_int() {
          fail(ix.loc, "array index must be Int, got ${got.show()}")
        }
        if e = container.inner {
          return e
        }
        return t_int()
      }
      if container.is_agg() {
        fail(expr.loc, "cannot index ${container.show()}: define fn [](index) on it")
        return t_int()
      }
      if container.is_ptr() {
        return check_ptr_index(expr, container, ix)
      }
      fail(expr.loc, "cannot index ${container.show()}")
      return t_int()
    }
    t_int()
  }

  pub fn check_array_new(expr: Expr): Ty {
    elem = t_int()
    if tn = expr.elem_type {
      elem = resolve_in_module(tn)
      self.pull_resolve()
      if reject_clayout_value(elem, tn.loc) {
        return t_int()
      }
    }
    if size = expr.size_expr {
      st = check_expr_as(size, t_int())
      if !st.is_int() {
        fail(size.loc, "Array(T).new expects Int size")
      }
    }
    // Every element starts at the element type's zero or at the given
    // value; no element is read unset.
    if expr.elems.size == 1 {
      vt = check_expr_as(expr.elems[0], elem)
      if !ty_assignable(vt, elem) {
        fail(expr.elems[0].loc, "Array(${elem.show()}).new's element value must be ${elem.show()}, got ${vt.show()}")
      }
      // One value for every element: when it is a reference to an
      // object that can change, the elements would share that object
      // (a grid built this way had one row). `nil` shares nothing.
      if !self.has_err() && expr.elems[0].kind != ex_nil() && type.ty_holds_mutable_ref(elem) {
        fail(expr.elems[0].loc, "Array(${elem.show()}).new(n, value) would put the same object in every element (${elem.show()} is, or holds, a reference: a change through one element would show in all); build one per element: Array(${elem.show()}).new(n, (i) { ... })")
      }
    } else if !ty_has_zero(elem) && !type.ty_has_var(elem) {
      // The way out it names must exist: a reference type's elements
      // are built one by one, any other type's take a value.
      if type.ty_holds_mutable_ref(elem) {
        fail(expr.loc, "Array(${elem.show()}).new(n) needs its elements built: ${elem.show()} has no zero value; write Array(${elem.show()}).new(n, (i) { ... }), or start from [] and push")
      } else {
        fail(expr.loc, "Array(${elem.show()}).new(n) needs an element value: ${elem.show()} has no zero value; write Array(${elem.show()}).new(n, value), or start from [] and push")
      }
    }
    ty_array(elem)
  }

  // `Array(T).new(n, (i) { ... })`: the block is run once per index, 0 to
  // n - 1 in order, and its value is that element. The parser hands it
  // over as a call named "Array.new" with n as its argument and T as its
  // elem_type. The block is inlined like those of `each` and `any` (a
  // `return` leaves the function); `break` and `continue` would leave
  // elements unbuilt and are refused.
  pub fn check_array_build(expr: Expr): Ty {
    elem = t_int()
    if tn = expr.elem_type {
      elem = resolve_in_module(tn)
      self.pull_resolve()
      if reject_clayout_value(elem, tn.loc) {
        return t_int()
      }
    }
    if expr.args.size == 1 {
      st = check_expr_as(expr.args[0], t_int())
      if !st.is_int() {
        fail(expr.args[0].loc, "Array(T).new expects Int size")
      }
    }
    if b = expr.block {
      if b.params.size != 1 {
        fail(b.loc, "Array(T).new(n, (i) { ... }) takes a lambda of one parameter, the index")
        return ty_array(elem)
      }
      refuse_block_param_outer(b, "Array.new")
      self.push_scope()
      bind(b.params[0], t_int())
      saved_loops = self.loop_depth
      self.loop_depth = 0
      saved_build = self.in_build
      self.in_build += 1
      bt = t_int()
      if b.paren {
        s = inline_enter(b, "Array(T).new", elem)
        bt = check_block_value_as(b, true, elem)
        inline_leave(s)
      } else {
        bt = check_block_value_as(b, true, elem)
      }
      self.in_build = saved_build
      self.loop_depth = saved_loops
      self.pop_scope()
      if !self.has_err() && !ty_assignable(bt, elem) {
        fail(b.body[b.body.size - 1].loc, "the lambda of Array(${elem.show()}).new(n, (i) { ... }) must end with a ${elem.show()}, got ${bt.show()}")
      }
    }
    ty_array(elem)
  }

  pub fn check_array_literal(expr: Expr, has_want: Bool, want: Ty): Ty {
    if has_want && want.is_set() && !type.ty_has_var(want) {
      return check_set_literal(expr, want)
    }
    if expr.elems.size == 0 {
      if has_want && want.is_array() {
        return want
      }
      fail(expr.loc, "empty array needs a type, e.g. xs: Array(Int) = []")
      return t_int()
    }
    elem_ty = t_int()
    forced = false
    if has_want && want.is_array() {
      if e = want.inner, !type.ty_has_var(e) {
        elem_ty = e
        forced = true
      }
    }
    if !forced {
      elem_ty = check_expr(expr.elems[0])
    }
    for el in expr.elems {
      got = check_expr_as(el, elem_ty)
      if !ty_assignable(got, elem_ty) {
        fail(el.loc, "array element is ${got.show()}, expected ${elem_ty.show()}")
      }
    }
    ty_array(elem_ty)
  }

  // `["tea": 12, "milk": 3]`: a new Hash(K, V) holding the entries, set
  // in the written order (a later equal key replaces an earlier one, as
  // `h[k] = v` does). K and V are a declared type's, else the first
  // entry's key and value; `[:]` needs a declared type.
  pub fn check_hash_literal(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.elems.size == 0 {
      if has_want && want.is_hash() {
        if wk0 = want.key {
          key_fns(wk0, expr.loc)
        }
        return want
      }
      fail(expr.loc, "an empty hash literal needs a type, e.g. h: Hash(String, Int) = [:]")
      return t_int()
    }
    key = t_int()
    val = t_int()
    forced = false
    if has_want && want.is_hash() {
      if wk = want.key, wv = want.val, !type.ty_has_var(wk) && !type.ty_has_var(wv) {
        key = wk
        val = wv
        forced = true
      }
    }
    if !forced {
      key = check_expr(expr.elems[0])
      val = check_expr(expr.elems[1])
      if self.has_err() {
        return t_int()
      }
      why = hash_type_problem(key, val)
      if why.size == 0 && key.is_struct() {
        seen: Array(String) = []
        why = hash_key_problem(key, seen, "")
      }
      if why.size > 0 {
        fail(expr.loc, why)
        return t_int()
      }
    }
    i = 0
    while i + 1 < expr.elems.size {
      gk = check_expr_as(expr.elems[i], key)
      if !ty_assignable(gk, key) {
        fail(expr.elems[i].loc, "hash literal key is ${gk.show()}, expected ${key.show()}")
      }
      gv = check_expr_as(expr.elems[i + 1], val)
      if !ty_assignable(gv, val) {
        fail(expr.elems[i + 1].loc, "hash literal value is ${gv.show()}, expected ${val.show()}")
      }
      i += 2
    }
    key_fns(key, expr.loc)
    ty_hash(key, val)
  }

  // `for v in s` over a Set walks `s.values()`, an array of its elements
  // made once before the loop (as `s.each` walks its keys): once the
  // for's hidden array is checked and found a Set, its value becomes that
  // call and the hidden name the array (the operand is checked once more
  // only then, so a failed operand reports once).
  pub fn set_for_operand(pre: Stmt) {
    if v = pre.value, t = pre.target, st = lookup(t.ident), st.is_set() {
      call = Expr.new(ex_call(), v.loc)
      call.callee = "values"
      call.receiver = v
      pre.value = call
      arr = check_expr(call)
      t.ty = arr
      bind(t.ident, arr)
    }
  }

  // An array literal where a Set(T) is wanted (`s: Set(Int) = [1, 2]`,
  // `[]` with a declared type): each element is a T, and the literal makes
  // the set (lowered as Set(T).new() and an add of each element).
  pub fn check_set_literal(expr: Expr, want: Ty): Ty {
    if elem = want.key {
      key_fns(elem, expr.loc)
      for el in expr.elems {
        got = check_expr_as(el, elem)
        if !ty_assignable(got, elem) {
          fail(el.loc, "set element is ${got.show()}, expected ${elem.show()}")
        }
      }
    }
    want
  }

  pub fn check_hash_new(expr: Expr): Ty {
    if expr.ident == "Set" {
      return check_set_new(expr)
    }
    key = t_int()
    val = t_int()
    if kn = expr.key_type {
      key = resolve_value_in_module(kn)
      self.pull_resolve()
    }
    if vn = expr.val_type {
      val = resolve_value_in_module(vn)
      self.pull_resolve()
    }
    why = hash_type_problem(key, val)
    if why.size == 0 && key.is_struct() {
      seen: Array(String) = []
      why = hash_key_problem(key, seen, "")
    }
    if why.size > 0 {
      fail(expr.loc, why)
      return t_int()
    }
    key_fns(key, expr.loc)
    if x = expr.size_expr {
      cap = check_expr_as(x, t_int())
      if !cap.is_int() {
        fail(x.loc, "Hash(K, V).new's capacity must be Int, got ${cap.show()}")
        return t_int()
      }
    }
    ty_hash(key, val)
  }

  // `Set(T).new()`: an empty Set(T), T one of a Hash key's types.
  pub fn check_set_new(expr: Expr): Ty {
    elem = t_int()
    if kn = expr.key_type {
      elem = resolve_value_in_module(kn)
      self.pull_resolve()
    }
    why = set_type_problem(elem)
    if why.size == 0 && elem.is_struct() {
      seen: Array(String) = []
      why = key_problem(elem, seen, "", "a Set element")
    }
    if why.size > 0 {
      fail(expr.loc, why)
      return t_int()
    }
    key_fns(elem, expr.loc)
    ty_set(elem, t_bool())
  }

  pub fn check_struct_literal(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.derived {
      if tn = expr.elem_type {
        // A literal the typed decode wrote (checker/json_codec.av): its
        // type is carried, pinned.
        drop_struct_defaults(expr)
        ty = resolve_in_module(tn)
        self.pull_resolve()
        if self.has_err() {
          return t_int()
        }
        return check_struct_fields(expr, ty, true)
      }
    }
    if expr.mod_name.size == 0 && expr.type_args.size == 0 {
      // A struct literal through a type alias (`type P = geo.Point`,
      // `P { x: 1, y: 2 }`) builds the type the alias names.
      if t = alias_value_target(expr.type_name, expr.loc) {
        expr.type_name = t.name
        expr.mod_name = t.mod_name
        expr.type_args = t.args
      }
    }
    drop_struct_defaults(expr)
    if expr.type_name == "Hasher" && expr.mod_name.size == 0 {
      fail(expr.loc, hasher_made_text())
      return t_int()
    }
    if expr.type_args.size > 0 {
      tn = TypeName.new(expr.loc, expr.type_name)
      tn.mod_name = expr.mod_name
      tn.args.concat(expr.type_args)
      ty = resolve_in_module(tn)
      self.pull_resolve()
      if self.has_err() {
        return t_int()
      }
      return check_struct_fields(expr, ty, true)
    }
    if tmpl = find_struct_template(expr.type_name, expr.mod_name) {
      return infer_struct_literal(expr, tmpl, has_want, want)
    }
    if ty = lookup_named_type(expr.type_name, expr.loc, expr.mod_name) {
      return check_struct_fields(expr, ty, true)
    }
    // lookup_named_type said why (unknown, or ambiguous).
    t_int()
  }

  pub fn check_struct_fields(expr: Expr, ty: Ty, check_values: Bool): Ty {
    if ty.template {
      fail(expr.loc, "${ty.name} needs type arguments")
      return t_int()
    }
    if ty.is_class() && !expr.derived {
      shown = ty.show()
      fail(expr.loc, "classes are constructed with ${shown}.new, not ${shown} { }")
      return ty
    }
    if reject_clayout_value(ty, expr.loc) {
      return ty
    }
    seen = Hash(String, Int).new()
    i = 0
    while i < expr.field_names.size {
      fname = expr.field_names[i]
      value = expr.field_exprs[i]
      if prev = seen.get(fname) {
        fail(value.loc, "duplicate field ${fname}")
      }
      seen[fname] = 1
      if field_ty = ty.field_named(fname) {
        check_field_visible(ty, fname, value.loc)
        if check_values {
          got = check_expr_as(value, field_ty)
          if !ty_assignable(got, field_ty) && !type.ty_has_var(field_ty) {
            fail(value.loc, "field ${fname} is ${got.show()}, expected ${field_ty.show()}")
          }
        }
      } else {
        label = ty.show()
        fail(value.loc, "no field ${fname} on ${label}")
      }
      i += 1
    }
    // Once per literal: the first private field it leaves out.
    private_said = false
    for f in ty.fields {
      if prev = seen.get(f.name) {
      } else if field_hidden(ty, f.name) {
        if !private_said {
          fail_alone(expr.loc, "${ty.show()} has private fields (${f.name}); a literal outside module ${ty.mod_name} cannot build it")
          private_said = true
        }
      } else if f.defaulted {
        splice_struct_default(expr, ty, f)
      } else {
        fail(expr.loc, "missing field ${f.name}${missing_field_hint(ty)}")
      }
    }
    ty
  }

  // A struct literal leaves out exactly the fields that declare a default
  // (`Opts { port: 80 }` with `loops: Int = 4`): each is the default's
  // expression, spliced into the literal after the written fields (so the
  // written ones are evaluated first, left to right, then the defaults in
  // declaration order) and marked (Expr.is_default), so a literal checked
  // again drops them first. A default belongs to the struct's
  // declaration: it is checked in the struct's module, with no local of
  // the literal's scope and no receiver, as a parameter's default is.
  pub fn drop_struct_defaults(expr: Expr) {
    n = expr.field_exprs.size
    while n > 0 && expr.field_exprs[n - 1].is_default {
      expr.field_exprs.pop()
      expr.field_names.pop()
      n -= 1
    }
  }

  pub fn struct_field_default(ty: Ty, name: String): Expr? {
    for sdef in self.program.structs {
      if sdef.name == ty.name && sdef.mod_name == ty.mod_name {
        for f in sdef.fields {
          if f.name == name {
            return f.default
          }
        }
      }
    }
    // A class literal (one the checker writes, Expr.derived) leaves out
    // the fields with a default as a struct literal does.
    for cdef in self.program.classes {
      if cdef.name == ty.name && cdef.mod_name == ty.mod_name {
        for f in cdef.fields {
          if f.name == name {
            return f.default
          }
        }
      }
    }
    nil
  }

  pub fn splice_struct_default(expr: Expr, ty: Ty, f: TyField) {
    if d = struct_field_default(ty, f.name) {
      v = clone_expr(d)
      v.is_default = true
      expr.field_names.push(f.name)
      expr.field_exprs.push(v)
      saved_mod = self.current_module
      saved_scopes = self.scopes
      saved_self = self.self_ty
      saved_name = self.self_name
      saved_floors = self.lam_scopes
      saved_in = self.in_default
      saved_owner = self.default_owner
      fresh: Array(Scope) = []
      self.scopes = fresh
      push_scope()
      floors: Array(Int) = []
      for fl in saved_floors {
        floors.push(0)
      }
      self.lam_scopes = floors
      self.current_module = ty.mod_name
      self.self_ty = nil
      self.self_name = ""
      self.in_default = true
      self.default_owner = ty
      got = check_expr_as(v, f.ty)
      if !ty_assignable(got, f.ty) {
        fail(v.loc, "cannot assign ${got.show()} to ${f.ty.show()}")
      }
      self.in_default = saved_in
      self.default_owner = saved_owner
      self.self_name = saved_name
      self.self_ty = saved_self
      self.current_module = saved_mod
      self.lam_scopes = saved_floors
      self.scopes = saved_scopes
      return
    }
    fail(expr.loc, "missing field ${f.name}")
  }

  // ": a literal leaves out only a field that declares a default" when
  // the struct has one, so the rule shows where it is met.
  pub fn missing_field_hint(ty: Ty): String {
    for f in ty.fields {
      if f.defaulted {
        return " (a literal leaves out only a field that declares a default)"
      }
    }
    ""
  }

  pub fn find_struct_template(name: String, mod_name: String): StructDef? {
    found: StructDef? = nil
    count = 0
    for sdef in self.program.structs {
      if sdef.name == name && sdef.type_params.size > 0 {
        if mod_name.size > 0 {
          if sdef.mod_name == mod_name {
            return sdef
          }
        } else {
          count += 1
          found = sdef
        }
      }
    }
    if mod_name.size > 0 {
      return nil
    }
    if count == 1 {
      return found
    }
    // Two modules' templates of one name: the one this module sees.
    if count > 1 {
      seen = visible_type_mod(name, self.current_module, "")
      if seen.size > 0 {
        return find_struct_template(name, seen)
      }
    }
    nil
  }

  pub fn find_class_template(name: String, mod_name: String): ClassDef? {
    found: ClassDef? = nil
    count = 0
    for cdef in self.program.classes {
      if cdef.name == name && cdef.type_params.size > 0 {
        if mod_name.size > 0 {
          if cdef.mod_name == mod_name {
            return cdef
          }
        } else {
          count += 1
          found = cdef
        }
      }
    }
    if mod_name.size > 0 {
      return nil
    }
    if count == 1 {
      return found
    }
    // Two modules' templates of one name: the one this module sees.
    if count > 1 {
      seen = visible_type_mod(name, self.current_module, "")
      if seen.size > 0 {
        return find_class_template(name, seen)
      }
    }
    nil
  }

  pub fn is_generic_template(name: String): Bool {
    is_generic_template_in(name, "")
  }

  // The same, for a name written with its module (`m.Cell(Int)`), "" for
  // a bare one.
  pub fn is_generic_template_in(name: String, mod_name: String): Bool {
    if s = find_struct_template(name, mod_name) {
      return true
    }
    if c = find_class_template(name, mod_name) {
      return true
    }
    false
  }

  pub fn apply_want_args(origin: String, params: Array(String), has_want: Bool, want: Ty, keys: Array(String), vals: Array(Ty)): Bool {
    if has_want && want.origin == origin && want.ty_args.size == params.size {
      i = 0
      while i < params.size {
        warg = want.ty_args[i]
        if !type.ty_has_var(warg) && !unify_ty(ty_var(params[i]), warg, keys, vals) {
          return false
        }
        i += 1
      }
    }
    true
  }

  pub fn solved_args(params: Array(String), keys: Array(String), vals: Array(Ty), loc: Location): Array(Ty)? {
    out: Array(Ty) = []
    i = 0
    while i < params.size {
      if got = subst_get(keys, vals, params[i]) {
        out.push(got)
      } else {
        return nil
      }
      i += 1
    }
    out
  }

  pub fn instantiate_applied(name: String, mod_name: String, args: Array(Ty), loc: Location): Ty {
    tn = TypeName.new(loc, name)
    tn.mod_name = mod_name
    i = 0
    while i < args.size {
      tn.args.push(ty_to_type_name(args[i], loc))
      i += 1
    }
    ty = resolve_in_module(tn)
    self.pull_resolve()
    ty
  }

  pub fn infer_struct_literal(expr: Expr, tmpl: StructDef, has_want: Bool, want: Ty): Ty {
    params = tmpl.type_params
    self.resolver.set_tparams(params)
    patterns: Array(Ty) = []
    names: Array(String) = []
    i = 0
    while i < tmpl.fields.size {
      names.push(tmpl.fields[i].name)
      patterns.push(self.resolver.resolve_value(tmpl.fields[i].type))
      self.pull_resolve()
      i += 1
    }
    self.resolver.clear_tparams()
    if self.has_err() {
      return t_int()
    }
    keys: Array(String) = []
    vals: Array(Ty) = []
    if !apply_want_args(tmpl.name, params, has_want, want, keys, vals) {
      fail(expr.loc, "conflicting type arguments")
      return t_int()
    }
    seen = Hash(String, Int).new()
    gots: Array(Ty) = []
    got_names: Array(String) = []
    i = 0
    while i < expr.field_names.size {
      fname = expr.field_names[i]
      value = expr.field_exprs[i]
      if prev = seen.get(fname) {
        fail(value.loc, "duplicate field ${fname}")
      }
      seen[fname] = 1
      pat: Ty? = nil
      for j in 0..names.size {
        if names[j] == fname {
          pat = patterns[j]
        }
      }
      if p = pat {
        pat_ty = subst_ty(p, keys, vals)
        got = check_expr_flag(value, true, pat_ty)
        gots.push(got)
        got_names.push(fname)
        if !unify_ty(pat_ty, got, keys, vals) {
          fail(value.loc, "conflicting type arguments")
        }
      } else {
        fail(value.loc, "no field ${fname} on ${tmpl.name}")
      }
      i += 1
    }
    if solved = solved_args(params, keys, vals, expr.loc) {
      ty = instantiate_applied(tmpl.name, expr.mod_name, solved, expr.loc)
      if self.has_err() {
        return t_int()
      }
      for i2 in 0..got_names.size {
        if field_ty = ty.field_named(got_names[i2]) {
          check_field_visible(ty, got_names[i2], expr.loc)
          if !ty_assignable(gots[i2], field_ty) {
            fail(expr.loc, "field ${got_names[i2]} is ${gots[i2].show()}, expected ${field_ty.show()}")
          }
        }
      }
      // Once per literal: the first private field it leaves out.
      private_said = false
      for f in ty.fields {
        if prev = seen.get(f.name) {
        } else if field_hidden(ty, f.name) {
          if !private_said {
            fail_alone(expr.loc, "${ty.show()} has private fields (${f.name}); a literal outside module ${ty.mod_name} cannot build it")
            private_said = true
          }
        } else if f.defaulted {
          splice_struct_default(expr, ty, f)
        } else {
          fail(expr.loc, "missing field ${f.name}${missing_field_hint(ty)}")
        }
      }
      return ty
    }
    fail(expr.loc, "cannot infer type argument; write ${tmpl.name}(...)")
    t_int()
  }

  pub fn check_name(expr: Expr, has_want: Bool, want: Ty): Ty {
    as_recv = self.recv_name
    self.recv_name = false
    if self.place_names.size > 0 {
      if pt = place_use(expr, has_want, want) {
        return pt
      }
    }
    if expr.ident == "self" {
      if cf = self.current_fn, cf.type_method {
        fail(expr.loc, "self is not available in a type-level function")
        return t_int()
      }
      if st = self.self_ty {
      } else {
        if existing = lookup("self") {
          return existing
        }
        if self.in_default {
          fail(expr.loc, "a field default cannot use self: defaults are evaluated before initialize; set the field in initialize instead")
          return t_int()
        }
        fail(expr.loc, "self is only valid in a method")
        return t_int()
      }
    }
    if self.lam_exprs.size > 0 && self.self_name.size > 0 && expr.ident == self.self_name {
      // A lambda in a method captures self, by value (self is never
      // reassigned): a class receiver's reference, a struct receiver's
      // copy.
      if st2 = capture_receiver(expr.loc) {
        return st2
      }
      return t_int()
    }
    if existing = lookup(expr.ident) {
      if name_failed(expr.ident) {
        read_failed_name()
      }
      note_capture(expr.ident, existing, expr.loc)
      return existing
    }
    if field_ty = implicit_field(expr.ident) {
      if k0 = self.known_mods.get(expr.ident), qualifier_ok(expr.ident, self.current_module) {
        // A field and a module of one name: neither wins silently.
        if module_is_method(expr.ident, expr.loc) {
          return t_int()
        }
      }
      if st = self.self_ty {
        check_field_visible(st, expr.ident, expr.loc)
      }
      if self.lam_exprs.size > 0 {
        // Inside a lambda a bare field reads it through the captured
        // receiver: the name becomes self.name.
        r0 = Expr.new(ex_name(), expr.loc)
        r0.ident = self.self_name
        dummy0 = check_expr(r0)
        expr.kind = ex_field()
        expr.object = r0
        return field_ty
      }
      expr.implicit_field = true
      return field_ty
    }
    if k = self.known_mods.get(expr.ident), qualifier_ok(expr.ident, self.current_module) {
      if module_is_method(expr.ident, expr.loc) {
        return t_int()
      }
      return ty_module(expr.ident)
    }
    // A bare method name is a call on the receiver.
    if r = bare_method_call(expr, expr.ident, 0) {
      expr.kind = ex_call()
      expr.callee = expr.ident
      expr.receiver = r
      if b0 = expr.bare_name {
        bare_call(expr, b0, expr.ident)
      }
      return check_method_call(expr, r, has_want, want)
    }
    // A module constant: its value, written as a literal.
    if inline_const(expr) {
      return check_expr_core(expr, has_want, want)
    }
    // One computed before main: a read of its slot.
    if ct = const_read(expr) {
      return ct
    }
    if has_want && want.is_fn() {
      return check_fn_ref(expr, want)
    }
    if got = check_fn_ref_bare(expr) {
      return got
    }
    if as_recv {
      // The receiver of `T.f` names a type, not a value: the caller
      // reports the missing type-level function; a type two modules
      // publish is ambiguous here.
      clash = receiver_clash(expr)
      if clash.size > 0 {
        fail(expr.loc, clash)
        return t_int()
      }
      tn = type_receiver(expr)
      if tn.size > 0 {
        self.recv_type = tn
        return t_int()
      }
    }
    if expr.type_args.size > 0 && expr.mod_name.size == 0 && (expr.ident == "Array" || expr.ident == "Hash" || expr.ident == "Set") {
      // A builtin collection's type written as a value (parser.av
      // type_as_argument): json.decode reads one, nothing else does.
      shown = "Array(T)"
      if expr.ident == "Hash" {
        shown = "Hash(K, V)"
      } else if expr.ident == "Set" {
        shown = "Set(T)"
      }
      fail(expr.loc, "${shown} only supports .new")
      return t_int()
    }
    if is_generic_template(expr.ident) {
      fail(expr.loc, "${expr.ident} needs type arguments")
      return t_int()
    }
    if self.in_default {
      if owner = self.default_owner, ft = owner.field_named(expr.ident) {
        fail(expr.loc, "a field default cannot read another field (${expr.ident} of ${owner.show()}): defaults are evaluated before initialize, in declaration order; compute it in initialize instead")
        return t_int()
      }
    }
    spelled = std_type_bare_spelling(expr.ident)
    if spelled.size > 0 {
      fail(expr.loc, "${expr.ident} needs its module's name: write ${spelled}; a std module's types are not named bare")
      return t_int()
    }
    fail_hint(expr.loc, "unknown name ${expr.ident}", name_hint(expr.ident))
    t_int()
  }

  // An integer literal's type: its suffix (u64), else the integer type
  // the context wants (UInt64, Int32, UInt32), else Int, a 64-bit
  // integer.
  pub fn literal_int_ty(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.int_suffix == "u64" {
      return t_uint64()
    }
    if has_want {
      if want.is_uint64() {
        return t_uint64()
      }
      if want.is_int32() {
        return ty_int32()
      }
      if want.is_uint32() {
        return ty_uint32()
      }
    }
    t_int()
  }

  // The largest magnitude a literal of ty may have (a negated one may
  // reach the minimum, max + 1).
  pub fn literal_int_max(ty: Ty): UInt64 {
    if ty.is_uint64() {
      return 18446744073709551615
    }
    if ty.is_int32() {
      return 2147483647
    }
    if ty.is_uint32() {
      return 4294967295
    }
    9223372036854775807
  }

  pub fn check_integer(expr: Expr, has_want: Bool, want: Ty): Ty {
    if has_want && want.is_float() {
      return t_float()
    }
    ty = literal_int_ty(expr, has_want, want)
    if expr.int_bits <= literal_int_max(ty) {
      return ty
    }
    if !has_want && self.lit_arg && expr.value_str.size == 0 {
      return t_uint64()
    }
    if expr.value_str.size > 0 {
      // A constant written here as its value (checker/consts.av).
      fail(expr.loc, "${expr.value_str} does not fit in ${ty.show()}")
    } else if ty.is_int() {
      fail(expr.loc, "integer literal does not fit in Int; use ${expr.int_bits}u64")
    } else {
      fail(expr.loc, "integer literal does not fit in ${ty.show()}")
    }
    ty
  }

  // A negated integer literal: typed like the literal, and its magnitude
  // may be the minimum's (-2147483648 as Int32, -9223372036854775808 as
  // Int); an unsigned type has no negative literal.
  pub fn check_negated_literal(expr: Expr, lit: Expr, has_want: Bool, want: Ty): Ty {
    if has_want && want.is_float() {
      lit.ty = t_float()
      return t_float()
    }
    ty = literal_int_ty(lit, has_want, want)
    if ty.is_unsigned() {
      // An unsigned type has no negative value: the literal does not fit,
      // whether the type is its suffix's or the context's
      // (`a: UInt32 = -1` said `cannot assign Int to UInt32`).
      if lit.value_str.size > 0 {
        fail(expr.loc, "${lit.value_str} does not fit in ${ty.show()}")
      } else {
        fail(expr.loc, "a negative literal does not fit in ${ty.show()}")
      }
      lit.ty = ty
      return ty
    }
    if lit.int_bits > literal_int_max(ty) + 1 {
      if lit.value_str.size > 0 {
        fail(expr.loc, "${lit.value_str} does not fit in ${ty.show()}")
      } else {
        fail(expr.loc, "integer literal does not fit in ${ty.show()}")
      }
    }
    lit.ty = ty
    ty
  }

  // An integer literal, or a negated one: its type adopts the other
  // operand's.
  pub fn is_int_literal(e: Expr): Bool {
    if e.kind == ex_int() {
      return true
    }
    // A constant is its value written as a literal (checker/consts.av),
    // so it adopts the other operand's type as one.
    if (e.kind == ex_name() || e.kind == ex_field()) && inline_const(e) {
      return is_int_literal(e)
    }
    if e.kind == ex_unary() && e.op == tk_minus() {
      if inner = e.inner {
        if (inner.kind == ex_name() || inner.kind == ex_field()) && inline_const(inner) {
          return inner.kind == ex_int()
        }
        return inner.kind == ex_int()
      }
    }
    false
  }

  // An expression made only of integer literals (and constants): a
  // literal, or a negation, `~`, or an arithmetic, bitwise or shift
  // operator whose operands are such expressions (`2 - 1`, `~0`, `1 << 40`).
  // It takes the integer type its context gives, as one literal does.
  pub fn is_lit_expr(e: Expr): Bool {
    if is_int_literal(e) {
      return true
    }
    if e.kind == ex_unary() && (e.op == tk_minus() || e.op == tk_tilde()) {
      if inner = e.inner {
        return is_lit_expr(inner)
      }
      return false
    }
    if e.kind == ex_binary() && (arith_op(e.op) || shift_op(e.op)) {
      if l = e.left, r = e.right {
        return is_lit_expr(l) && is_lit_expr(r)
      }
    }
    false
  }

  // `[]` written with no element, or `[:]`.
  pub fn is_empty_array(e: Expr): Bool {
    (e.kind == ex_array() || e.kind == ex_hash_lit()) && e.elems.size == 0
  }

  // The stand-in of `[:]` as `empty_array_ty` is of `[]`: a hash of Void
  // keys and values.
  pub fn empty_hash_ty: Ty {
    ty_hash(t_void(), t_void())
  }

  // Whether a `[]` or `[:]` argument (its stand-in t) fits a parameter of
  // type p: an array or a Set parameter takes `[]`, a hash parameter `[:]`.
  pub fn empty_fits(t: Ty, p: Ty): Bool {
    if t.is_enum() {
      // `:name`: a parameter whose enum has that member.
      if et = enum_lit_target(p) {
        return et.enum_index(t.name.slice(1)) >= 0
      }
      return false
    }
    (t.is_array() && (p.is_array() || p.is_set())) || (t.is_hash() && p.is_hash() && !p.is_set())
  }

  // The stand-in type of a `:name` argument before its parameter is
  // known: an enum without members named `:name`, which no value has.
  pub fn enum_lit_arg_ty(name: String): Ty {
    t = Ty.new(tyk_enum())
    t.name = ":${name}"
    t
  }

  // The enum a `:name` stands for where p is expected: p itself, or the
  // one enum among a union's members (an optional enum); nil otherwise.
  pub fn enum_lit_target(p: Ty): Ty? {
    if p.is_enum() && !p.name.starts_with(":") {
      return p
    }
    if p.is_union() {
      found: Array(Ty) = []
      for m in p.members {
        if m.is_enum() {
          found.push(m)
        }
      }
      if found.size == 1 {
        return found[0]
      }
    }
    nil
  }

  // The stand-in type of a `[]` argument before its parameter is known
  // (no value has it: an array of Void).
  pub fn empty_array_ty: Ty {
    ty_array(t_void())
  }

  pub fn is_empty_array_ty(t: Ty): Bool {
    if t.is_enum() && t.name.starts_with(":") {
      return true
    }
    if t.is_array() {
      if e = t.inner {
        return e.is_void()
      }
    }
    if t.is_hash() {
      if k = t.key {
        return k.is_void()
      }
    }
    false
  }

  // A call's argument, checked before the call picks its function: a bare
  // integer literal may be above Int's range (the parameter decides).
  pub fn check_call_arg(e: Expr): Ty {
    if e.kind == ex_enum_lit() {
      // `:name` takes its parameter's enum (fit_call_arg).
      return enum_lit_arg_ty(e.ident)
    }
    if is_empty_array(e) {
      // `[]` takes its parameter's type (fit_call_arg); until the call
      // picks its function it stands for an array of any element (`[:]`
      // for a hash of any key and value).
      if e.kind == ex_hash_lit() {
        return empty_hash_ty()
      }
      return empty_array_ty()
    }
    if e.kind == ex_array() && e.elems.size > 0 {
      // `[1, 2]` may still become the Set its parameter asks for: its
      // type is marked as a literal's until the call picks its function.
      got = check_expr(e)
      if got.is_array() {
        if elem = got.inner {
          t = ty_array(elem)
          t.lit_arr = true
          return t
        }
      }
      return got
    }
    if e.kind != ex_int() {
      return check_expr(e)
    }
    saved = self.lit_arg
    self.lit_arg = true
    got = check_expr(e)
    self.lit_arg = saved
    got
  }

  // A call of the operator method name on recv with args, for an operator
  // a type defines (`c[i]`, `c[i] = v`, `-x`).
  pub fn op_method_call(loc: Location, recv: Expr, name: String, args: Array(Expr)): Expr {
    call = Expr.new(ex_call(), loc)
    call.callee = name
    call.receiver = recv
    call.args = args
    call
  }

  // The indexes of an index expression, in order (`g[x, y]`: x, y).
  pub fn index_args(e: Expr): Array(Expr) {
    out: Array(Expr) = []
    if r = e.right {
      out.push(r)
    }
    out.concat(e.elems)
    out
  }

  // expr, in place, becomes the call of the operator method name on recv.
  pub fn rewrite_op_call(expr: Expr, recv: Expr, name: String, args: Array(Expr)) {
    expr.kind = ex_call()
    expr.callee = name
    expr.receiver = recv
    expr.args = args
    expr.left = nil
    expr.right = nil
    expr.inner = nil
    expr.elems = []
    expr.op = 0
    expr.proven = false
  }

  pub fn check_unary(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.op == tk_amp() {
      // `&x` was checked with the C call it is an argument of
      // (check_out_args); anywhere else it is refused.
      if t = expr.ty, expr.proven {
        return t
      }
      fail(expr.loc, "&x is only an argument of a C function (a fun of a lib block), which writes the local x through the pointer")
      return t_int()
    }
    if inner = expr.inner {
      if inner.kind == ex_name() || inner.kind == ex_field() {
        _ = inline_const(inner)
      }
      if expr.op == tk_minus() && inner.kind == ex_int() {
        return check_negated_literal(expr, inner, has_want, want)
      }
      got = t_int()
      if has_want && (want.is_integer() || (want.is_float() && expr.op == tk_minus())) && is_lit_expr(inner) {
        // `-(2 - 1)` and `~0` take their context's type (`u: UInt64 = ~0`).
        got = check_expr_as(inner, want)
      } else {
        got = check_expr(inner)
      }
      if expr.op == tk_minus() {
        if got.is_unsigned() {
          // As a negated literal is: an unsigned type has no negatives.
          fail(expr.loc, "unary minus of an unsigned value: ${got.show()} has no negative values (to wrap, write 0 &- x)")
          return got
        }
        if got.is_numeric() {
          return got
        }
        if got.is_agg() && user_op(got, "-") {
          // `-x` is the call `x.-()`, the method `-` without parameters.
          no_args: Array(Expr) = []
          rewrite_op_call(expr, inner, "-", no_args)
          return check_expr_core(expr, false, t_int())
        }
        fail(expr.loc, "unary minus expects Int or Float64")
        return t_int()
      }
      if expr.op == tk_bang() {
        if got.is_bool() {
          return t_bool()
        }
        fail(expr.loc, "! expects Bool")
        return t_bool()
      }
      if expr.op == tk_tilde() {
        if got.is_integer() {
          return got
        }
        fail(expr.loc, "~ expects an integer")
        return t_int()
      }
      fail(expr.loc, "unsupported unary operator")
      return t_int()
    }
    t_int()
  }

  pub fn bitwise_op(op: Int): Bool {
    if op == tk_amp() {
      return true
    }
    if op == tk_pipe() {
      return true
    }
    if op == tk_caret() {
      return true
    }
    if op == tk_less_less() {
      return true
    }
    op == tk_greater_greater()
  }

  // + - * / % & | ^ and the wrapping operators: their result is their
  // operands' type.
  pub fn arith_op(op: Int): Bool {
    if op == tk_plus() || op == tk_minus() || op == tk_star() || op == tk_slash() || op == tk_percent() {
      return true
    }
    if op == tk_amp() || op == tk_pipe() || op == tk_caret() {
      return true
    }
    op == tk_amp_plus() || op == tk_amp_minus() || op == tk_amp_star()
  }

  pub fn shift_op(op: Int): Bool {
    if op == tk_less_less() {
      return true
    }
    op == tk_greater_greater()
  }

  // A shift by a literal amount outside 0..width - 1 (a negated literal
  // included) is a compile-time error; any other amount is checked when
  // the shift runs.
  pub fn check_shift_amount(r: Expr, left: Ty, loc: Location) {
    neg = false
    lit = r
    if r.kind == ex_unary() && r.op == tk_minus() {
      if inner = r.inner, inner.kind == ex_int() {
        neg = true
        lit = inner
      }
    }
    if lit.kind != ex_int() {
      return
    }
    top = 63u64
    if left.is_int32() || left.is_uint32() {
      top = 31u64
    }
    if neg {
      if lit.int_bits != 0 {
        fail(loc, "shift amount -${lit.int_bits} out of range for ${left.show()} (0..${top})")
      }
      return
    }
    if lit.int_bits > top {
      fail(loc, "shift amount ${lit.int_bits} out of range for ${left.show()} (0..${top})")
    }
  }

  pub fn int_binary(op: Int, ty: Ty): Ty {
    if op == tk_plus() {
      return ty
    }
    if op == tk_minus() {
      return ty
    }
    if op == tk_star() {
      return ty
    }
    if op == tk_slash() {
      return ty
    }
    if op == tk_eq_eq() {
      return t_bool()
    }
    if op == tk_not_eq() {
      return t_bool()
    }
    if op == tk_less() {
      return t_bool()
    }
    if op == tk_less_eq() {
      return t_bool()
    }
    if op == tk_greater() {
      return t_bool()
    }
    if op == tk_greater_eq() {
      return t_bool()
    }
    fail(self.program.loc, "unsupported operator")
    ty
  }

  pub fn float_binary(op: Int, loc: Location): Ty {
    if op == tk_plus() {
      return t_float()
    }
    if op == tk_minus() {
      return t_float()
    }
    if op == tk_star() {
      return t_float()
    }
    if op == tk_slash() {
      return t_float()
    }
    if op == tk_eq_eq() {
      return t_bool()
    }
    if op == tk_not_eq() {
      return t_bool()
    }
    if op == tk_less() {
      return t_bool()
    }
    if op == tk_less_eq() {
      return t_bool()
    }
    if op == tk_greater() {
      return t_bool()
    }
    if op == tk_greater_eq() {
      return t_bool()
    }
    fail(loc, "unsupported operator on Float64")
    t_float()
  }

  pub fn check_binary(expr: Expr, has_want: Bool, want: Ty): Ty {
    if l = expr.left, r = expr.right {
      op = expr.op
      if op == tk_question_question() {
        if expr_is_else_guard(r) {
          return check_else_guard(l, r)
        }
        left = check_expr(l)
        if can_coalesce(left) {
          return coalesce_result(left, r, expr.loc, "??")
        }
        check_expr(r)
        if !self.has_err() {
          failure_split(left, expr.loc, "??")
        }
        return left
      }
      if op == tk_amp_amp() {
        left = check_expr(l)
        right = check_expr(r)
        if left.is_bool() && right.is_bool() {
          return t_bool()
        }
        fail(expr.loc, "&& expects Bool operands")
        return t_bool()
      }
      if op == tk_pipe_pipe() {
        left = check_expr(l)
        right = check_expr(r)
        if left.is_bool() && right.is_bool() {
          return t_bool()
        }
        fail(expr.loc, "|| expects Bool operands")
        return t_bool()
      }
      // `t == :write`: the short member takes the other operand's enum.
      if (op == tk_eq_eq() || op == tk_not_eq()) && (l.kind == ex_enum_lit()) != (r.kind == ex_enum_lit()) {
        known = if l.kind == ex_enum_lit() { r } else { l }
        short = if l.kind == ex_enum_lit() { l } else { r }
        kt = check_expr(known)
        st = check_expr_as(short, kt)
        if l.kind == ex_enum_lit() {
          return binary_typed(expr, l, r, op, st, kt)
        }
        return binary_typed(expr, l, r, op, kt, st)
      }
      // An integer literal on the left adopts the right operand's
      // integer type, as one on the right adopts the left's (`1 + x`
      // types as `x + 1`).
      left_lit = is_lit_expr(l) && !is_lit_expr(r)
      if left_lit {
        rfirst = check_expr(r)
        if rfirst.is_integer() || rfirst.is_float() {
          left = check_expr_as(l, rfirst)
          right = rfirst
          return binary_typed(expr, l, r, op, left, right)
        }
        left = check_expr(l)
        return binary_typed(expr, l, r, op, left, rfirst)
      }
      // Two literals take the integer type the context wants (`x:
      // Int32 = 46340 * 46340`), as one literal does.
      left = t_int()
      if has_want && is_lit_expr(l) && is_lit_expr(r) && ((want.is_integer() && (arith_op(op) || shift_op(op))) || (want.is_float() && arith_op(op))) {
        left = check_expr_as(l, want)
      } else {
        left = check_expr(l)
      }
      opname = binary_op_method_name(op)
      expr.op_form = 0
      if opname.size > 0 && left.is_agg() {
        // The type's operator method, or a derived comparison
        // (checker/equality.av).
        if t = check_agg_compare(expr, r, op, opname, left) {
          return t
        }
      }
      right_has = false
      right_want = t_int()
      if left.is_integer() && !shift_op(op) {
        right_has = true
        right_want = left
      } else if left.is_float() {
        right_has = true
        right_want = left
      } else if left.is_string() {
        right_has = true
        right_want = left
      } else if left.is_bytes() {
        right_has = true
        right_want = left
      }
      right = check_expr_flag(r, right_has, right_want)
      return binary_typed(expr, l, r, op, left, right)
    }
    t_int()
  }

  // The typing of a binary operator once both operands are typed (the
  // part of check_binary after the operands, split off so a literal on
  // the left can adopt the right's type first).
  pub fn binary_typed(expr: Expr, l: Expr, r: Expr, op: Int, left: Ty, right: Ty): Ty {
    // Two values of one enum compare with == and !=; an enum has no
    // order and no arithmetic, and is never a number.
    if left.is_enum() && right.is_enum() && left.same_as(right) {
      if op == tk_eq_eq() || op == tk_not_eq() {
        return t_bool()
      }
      fail(expr.loc, "only == and != apply to ${left.show()}: an enum has no order and no arithmetic")
      return t_bool()
    }
    if left.is_enum() || right.is_enum() {
      if op == tk_eq_eq() || op == tk_not_eq() {
        fail(expr.loc, "cannot compare ${left.show()} with ${right.show()}: == and != compare two values of one enum")
      } else {
        et = left
        if !left.is_enum() {
          et = right
        }
        fail(expr.loc, "only == and != apply to ${et.show()}: an enum has no order and no arithmetic")
      }
      return t_bool()
    }
    if left.is_fn() {
      if op == tk_eq_eq() {
        fail(expr.loc, "cannot compare fn values")
        return t_bool()
      }
      if op == tk_not_eq() {
        fail(expr.loc, "cannot compare fn values")
        return t_bool()
      }
    }
    if right.is_fn() {
      if op == tk_eq_eq() {
        fail(expr.loc, "cannot compare fn values")
        return t_bool()
      }
      if op == tk_not_eq() {
        fail(expr.loc, "cannot compare fn values")
        return t_bool()
      }
    }
    if left.is_bool() && right.is_bool() {
      if op == tk_eq_eq() {
        return t_bool()
      }
      if op == tk_not_eq() {
        return t_bool()
      }
      fail(expr.loc, "unsupported operator on Bool (== and != compare Bools; &&, || and ! combine them)")
      return t_bool()
    }
    if left.is_string() && right.is_string() {
      if op == tk_plus() {
        return t_string()
      }
      // == and != compare the bytes; <, <=, > and >= order them byte by
      // byte, a prefix first, as sort does.
      if eq_is_compare(op) {
        return t_bool()
      }
      fail(expr.loc, "unsupported operator on String (+ joins two Strings; ==, !=, <, <=, > and >= compare them)")
      return t_string()
    }
    if left.is_bytes() && right.is_bytes() {
      if op == tk_eq_eq() {
        return t_bool()
      }
      if op == tk_not_eq() {
        return t_bool()
      }
      fail(expr.loc, "unsupported operator on Bytes")
      return t_bool()
    }
    if op == tk_amp_plus() || op == tk_amp_minus() || op == tk_amp_star() {
      if left.is_integer() && right.same_as(left) {
        return left
      }
      fail(expr.loc, "wrapping operator expects matching integer operands")
      return left
    }
    if op == tk_percent() {
      if left.is_integer() && right.same_as(left) {
        if divisor_proven(r) {
          expr.proven = true
        }
        return left
      }
      fail(expr.loc, "% expects matching integer operands")
      return left
    }
    if bitwise_op(op) {
      if shift_op(op) {
        if left.is_integer() {
          check_shift_amount(r, left, expr.loc)
        }
        // The amount may be an Int whatever the shifted type (UInt64,
        // Int32 and UInt32 values shift by an Int).
        if left.is_integer() && right.is_int() {
          return left
        }
      }
      if left.is_integer() && right.same_as(left) {
        return left
      }
      fail(expr.loc, "bitwise operator expects matching integer operands")
      return left
    }
    if left.is_integer() && right.is_integer() {
      if left.same_as(right) {
        if op == tk_plus() {
          if l.kind == ex_name() && r.kind == ex_int() {
            s = fact_any_slack(l.ident)
            if s >= 0 && r.int_bits <= s.to_u64() + 1 {
              expr.proven = true
            }
          }
          if r.kind == ex_name() && l.kind == ex_int() {
            s = fact_any_slack(r.ident)
            if s >= 0 && l.int_bits <= s.to_u64() + 1 {
              expr.proven = true
            }
          }
        }
        if op == tk_minus() && l.kind == ex_name() && r.kind == ex_int() && (fact_any_slack(l.ident) >= 0 || nn_has(l.ident)) {
          expr.proven = true
        }
        if (op == tk_plus() || op == tk_star() || op == tk_minus()) && arith_proven(op, l, r, left) {
          expr.proven = true
        }
        if op == tk_slash() && divisor_proven(r) {
          expr.proven = true
        }
        return int_binary(op, left)
      }
      fail(expr.loc, "binary operator expects matching types, got ${left.show()} and ${right.show()}")
      return left
    }
    if left.is_numeric() && right.is_numeric() && left.is_float() != right.is_float() {
      // An integer and a Float64 neither mix nor compare: the operator
      // converts neither side, so the conversion is written and no
      // precision is lost silently above 2^53.
      if eq_is_compare(op) {
        fail(expr.loc, "cannot compare ${left.show()} with ${right.show()}: ${fn_op_name(op)} compares two values of one type; ${int_float_hint(l, left, r, right)}")
        return t_bool()
      }
      fail(expr.loc, "binary operator expects matching types, got ${left.show()} and ${right.show()}: an integer and a Float64 do not mix; ${int_float_hint(l, left, r, right)}")
      if left.is_float() {
        return left
      }
      return right
    }
    if left.is_float() && right.is_float() {
      return float_binary(op, expr.loc)
    }
    if op == tk_eq_eq() || op == tk_not_eq() {
      // `x == nil`: an optional is opened or tested, not compared.
      if right.is_nil() && left.is_nilable() {
        fail(expr.loc, nil_compare_text(l, left))
        return t_bool()
      }
      if left.is_nil() && right.is_nilable() {
        fail(expr.loc, nil_compare_text(r, right))
        return t_bool()
      }
      // Two arrays, hashes, sets or optionals of one type
      // (checker/equality.av).
      if left.same_as(right) && (left.is_array() || left.is_nilable() || left.is_hash() || left.is_set()) {
        seen: Array(String) = []
        missing = eq_missing(left, seen)
        if missing.size > 0 {
          fail(expr.loc, eq_refusal(left, missing))
        } else {
          eq_by_function(expr, left)
        }
        return t_bool()
      }
    }
    if op == tk_plus() && left.is_array() && right.is_array() {
      if left.same_as(right) {
        return array_join(expr, l, r, left)
      }
      fail(expr.loc, "cannot join ${left.show()} and ${right.show()}: + joins two arrays of one element type")
      return left
    }
    hint = open_hint(l, left)
    if hint.size == 0 {
      hint = open_hint(r, right)
    }
    // A comparison of types that do not compare (the old text said
    // "numeric operands" for every type).
    if eq_is_compare(op) {
      opname = fn_op_name(op)
      if !left.same_as(right) {
        fail_hint(expr.loc, "cannot compare ${left.show()} with ${right.show()}: ${opname} compares two values of one type", hint)
      } else if op == tk_eq_eq() || op == tk_not_eq() {
        seen2: Array(String) = []
        fail_hint(expr.loc, eq_refusal(left, eq_missing(left, seen2)), hint)
      } else {
        fail_hint(expr.loc, "${left.show()} has no order: <, <=, > and >= compare numbers and Strings", hint)
      }
      return t_bool()
    }
    fail_hint(expr.loc, "binary operator expects numeric operands, got ${left.show()} and ${right.show()}", hint)
    return t_int()
  }

  pub fn check_call(expr: Expr, has_want: Bool, want: Ty): Ty {
    saved_args = self.args_now
    got = check_call_named(expr, has_want, want)
    self.args_now = saved_args
    got
  }

  pub fn check_call_named(expr: Expr, has_want: Bool, want: Ty): Ty {
    split_named_args(expr)
    self.args_now = expr.args
    if expr.field_exprs.size == 0 {
      return check_call_parts(expr, has_want, want)
    }
    if !named_callee_possible(expr) {
      // Refused once, and checked on as the positional arguments they
      // would be, so no other error follows from the refusal.
      stash_names = expr.field_names
      stash = expr.field_exprs
      expr.args.concat(stash)
      expr.field_names = []
      expr.field_exprs = []
      got0 = check_call_parts(expr, has_want, want)
      expr.field_names = stash_names
      expr.field_exprs = stash
      refuse_named_args(expr)
      return got0
    }
    mark = err_count()
    saved = self.named_now
    self.named_now = expr.field_names
    got = check_call_parts(expr, has_want, want)
    self.named_now = saved
    if new_err_since(mark) {
      // The call's own error said what failed (fail_no_fit names a
      // parameter without a default that a name was given to).
      expr.field_exprs = []
      expr.field_names = []
    } else {
      refuse_named_args(expr)
    }
    got
  }

  // Whether a call with named arguments may reach a declared function or
  // method that takes them: one of that name exists. A function value,
  // and a name no declaration has (a builtin), takes none.
  pub fn named_callee_possible(expr: Expr): Bool {
    if expr.indirect {
      return false
    }
    if r = expr.receiver {
    } else if existing = lookup(expr.callee), existing.is_fn() {
      return false
    }
    if expr.callee == "new" || expr.callee == "decode" {
      // json.decode's options are named (checker/json_codec.av).
      return true
    }
    if fn_indices_named(expr.callee).size > 0 || method_indices_named(expr.callee).size > 0 {
      return true
    }
    // A generic type's methods are registered with its first instance.
    for sdef in self.program.structs {
      for m in sdef.methods {
        if m.name == expr.callee {
          return true
        }
      }
    }
    for cdef in self.program.classes {
      for m2 in cdef.methods {
        if m2.name == expr.callee {
          return true
        }
      }
    }
    false
  }

  // A named argument, checked against the parameter it was placed at
  // (checker/match.av place_named_args), as a positional one would be.
  pub fn check_named_arg(arg: Expr, param: Ty): Ty {
    if param.is_fn() {
      if arg.kind == ex_name() {
        if local = lookup(arg.ident) {
          return check_expr_as(arg, param)
        }
      }
      return check_fn_arg(arg, param)
    }
    check_expr_as(arg, param)
  }

  pub fn check_call_parts(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.indirect {
      if inner = expr.inner {
        callee = check_expr(inner)
        return check_indirect_call(expr, callee)
      }
    }
    if recv = expr.receiver {
      return check_method_call(expr, recv, has_want, want)
    }
    if expr.callee == "Array.new" {
      return check_array_build(expr)
    }
    if is_generic_template(expr.callee) {
      fail(expr.loc, "type argument expected")
      return t_int()
    }
    if self.current_module == "std.json" && json_codec_callee(expr.callee) {
      // std.json's own calls of its typed encode (JsonBuilder.value).
      return check_json_call(expr)
    }
    if existing = lookup(expr.callee), existing.is_fn() {
      note_capture(expr.callee, existing, expr.loc)
      expr.indirect = true
      return check_indirect_call(expr, existing)
    }
    // A bare call of a method of the receiver.
    argc = expr.args.size
    if b0 = expr.block {
      argc += 1
    }
    if r = bare_method_call(expr, expr.callee, argc) {
      expr.receiver = r
      return check_method_call(expr, r, has_want, want)
    }
    if refuse_moved_io(expr) {
      return t_int()
    }
    if expr.callee == "puts" || expr.callee == "print" || expr.callee == "eputs" || expr.callee == "eprint" {
      return check_output_call(expr)
    }
    if expr.callee == "exit" {
      return check_exit_call(expr)
    }
    if expr.callee == "panic" {
      return check_panic_call(expr)
    }
    if expr.callee == "spawn" {
      return check_spawn(expr)
    }
    if expr.callee == "now_ms" {
      if expr.args.size == 0 {
        if b = expr.block {
          fail(expr.loc, "now_ms takes no arguments")
          return t_int()
        }
        return t_int()
      }
      fail(expr.loc, "now_ms takes no arguments")
      return t_int()
    }
    if expr.callee == "argv" {
      if expr.args.size == 0 {
        if b = expr.block {
          fail(expr.loc, "argv takes no arguments")
          return ty_array(t_string())
        }
        return ty_array(t_string())
      }
      fail(expr.loc, "argv takes no arguments")
      return ty_array(t_string())
    }
    if expr.callee == "env_get" {
      if expr.args.size == 1 {
        if b = expr.block {
          fail(expr.loc, "env_get takes one String")
          return ty_nilable(t_string())
        }
      } else {
        fail(expr.loc, "env_get takes one String")
        return ty_nilable(t_string())
      }
      got = check_expr_as(expr.args[0], t_string())
      if !ty_assignable(got, t_string()) {
        fail(expr.args[0].loc, "env_get expects String")
      }
      return ty_nilable(t_string())
    }
    if expr.callee == "file_exists" {
      if expr.args.size == 1 {
        if b = expr.block {
          fail(expr.loc, "file_exists takes one String")
          return t_bool()
        }
      } else {
        fail(expr.loc, "file_exists takes one String")
        return t_bool()
      }
      got = check_expr_as(expr.args[0], t_string())
      if !ty_assignable(got, t_string()) {
        fail(expr.args[0].loc, "file_exists expects String")
      }
      return t_bool()
    }
    if ty = check_codec_call(expr) {
      return ty
    }
    if ty = check_langarena_call(expr) {
      return ty
    }
    if ty = check_gate_call(expr) {
      return ty
    }
    if expr.callee == "chr" {
      if expr.args.size == 1 {
        if b = expr.block {
          fail(expr.loc, "chr takes one Int")
          return t_string()
        }
      } else {
        fail(expr.loc, "chr takes one Int")
        return t_string()
      }
      got = check_expr_as(expr.args[0], t_int())
      if !got.is_int() {
        fail(expr.args[0].loc, "chr expects Int")
      }
      return t_string()
    }
    if expr.callee == "str_slice" {
      if expr.args.size == 3 {
        if b = expr.block {
          fail(expr.loc, "str_slice takes String, start, stop")
          return t_string()
        }
      } else {
        fail(expr.loc, "str_slice takes String, start, stop")
        return t_string()
      }
      s = check_expr_as(expr.args[0], t_string())
      if !ty_assignable(s, t_string()) {
        fail(expr.args[0].loc, "str_slice expects String")
      }
      start = check_expr_as(expr.args[1], t_int())
      stop = check_expr_as(expr.args[2], t_int())
      if !start.is_int() {
        fail(expr.args[1].loc, "start must be Int")
      }
      if !stop.is_int() {
        fail(expr.args[2].loc, "stop must be Int")
      }
      return t_string()
    }
    if expr.callee == "buf_new" {
      if b = expr.block {
        fail(expr.loc, "buf_new does not take a block")
        return t_buf()
      }
      if expr.args.size == 0 {
        return t_buf()
      }
      if expr.args.size == 1 {
        cap = check_expr_as(expr.args[0], t_int())
        if !cap.is_int() {
          fail(expr.args[0].loc, "capacity must be Int")
        }
        return t_buf()
      }
      if expr.args.size == 2 {
        // `Buf.new(n, byte)`: n bytes, each byte.
        size = check_expr_as(expr.args[0], t_int())
        if !size.is_int() {
          fail(expr.args[0].loc, "size must be Int")
        }
        byte = check_expr_as(expr.args[1], t_int())
        if !byte.is_int() {
          fail(expr.args[1].loc, "byte must be Int")
        }
        return t_buf()
      }
      fail(expr.loc, "Buf.new takes an optional Int capacity, or a size and a byte")
      return t_buf()
    }
    expected: Ty? = nil
    if has_want {
      expected = want
    }
    return dispatch_call(expr, expected)
  }

  // Whether an array literal's argument type t (check_call_arg) fits the
  // Set parameter p: its elements fit p's element type.
  pub fn lit_set_fits(t: Ty, p: Ty): Bool {
    if !t.lit_arr || !p.is_set() || type.ty_has_var(p) {
      return false
    }
    if e = t.inner, k = p.key {
      return ty_assignable(e, k) || (e.is_integer() && k.is_integer())
    }
    false
  }

  // A non-empty array literal given to a Set parameter becomes that Set,
  // as `s: Set(Int) = [1, 2]` does: its elements were checked as the
  // call's argument; an integer literal among them takes the element type.
  pub fn adopt_set_literal(expr: Expr, want: Ty): Ty {
    if elem = want.key {
      key_fns(elem, expr.loc)
      for el in expr.elems {
        got = t_int()
        if t = el.ty {
          got = t
        }
        if !ty_assignable(got, elem) && is_lit_expr(el) {
          got = check_expr_as(el, elem)
        }
        if !ty_assignable(got, elem) {
          fail(el.loc, "set element is ${got.show()}, expected ${elem.show()}")
        }
      }
    }
    expr.ty = want
    want
  }

  pub fn fit_call_arg(expr: Expr, got: Ty, want: Ty): Ty {
    if expr.kind == ex_enum_lit() {
      return check_expr_as(expr, want)
    }
    if got.lit_arr && expr.kind == ex_array() {
      if lit_set_fits(got, want) {
        return adopt_set_literal(expr, want)
      }
      if t = expr.ty {
        return t
      }
    }
    if is_empty_array(expr) && is_empty_array_ty(got) {
      // `[]` takes the parameter's array type, `[:]` its hash type.
      if empty_fits(got, want) && !type.ty_has_var(want) && !is_empty_array_ty(want) {
        return check_expr_as(expr, want)
      }
      if expr.kind == ex_hash_lit() {
        if !want.is_hash() && !type.ty_has_var(want) {
          fail(expr.loc, "[:] is a hash, expected ${want.show()}")
          return want
        }
        fail(expr.loc, "an empty hash literal needs a type, e.g. h: Hash(String, Int) = [:]")
        return want
      }
      if !want.is_array() && !type.ty_has_var(want) {
        fail(expr.loc, "[] is an array, expected ${want.show()}")
        return want
      }
      fail(expr.loc, "empty array needs a type, e.g. xs: Array(Int) = []")
      return want
    }
    if ty_assignable(got, want) {
      return got
    }
    if expr.kind == ex_int() {
      widened = check_integer(expr, true, want)
      if ty_assignable(widened, want) {
        expr.ty = widened
        return widened
      }
    }
    // A negated literal adopts the parameter too (`f(-5)` with an Int32
    // parameter was refused).
    if is_int_literal(expr) && expr.kind == ex_unary() && want.is_integer() {
      if inner = expr.inner {
        widened = check_negated_literal(expr, inner, true, want)
        if ty_assignable(widened, want) {
          expr.ty = widened
          return widened
        }
      }
    }
    // So does an expression of literals (`f(2 - 1)`, `f(~0)`).
    if (want.is_integer() || want.is_float()) && !type.ty_has_var(want) && is_lit_expr(expr) && got.is_numeric() {
      return check_expr_as(expr, want)
    }
    got
  }

  pub fn check_args(expr: Expr, params: Array(Ty), label: String) {
    if expr.args.size != params.size {
      fail(expr.loc, "${label} takes ${args_word(params.size)}, given ${expr.args.size}")
      return
    }
    i = 0
    while i < expr.args.size {
      call_arg = expr.args[i]
      got = t_int()
      if params[i].is_fn() {
        if call_arg.kind == ex_name() {
          if local = lookup(call_arg.ident) {
            got = check_expr_as(call_arg, params[i])
          } else {
            got = check_fn_arg(call_arg, params[i])
          }
        } else {
          got = check_fn_arg(call_arg, params[i])
        }
      } else {
        got = check_expr_as(call_arg, params[i])
      }
      if !ty_assignable(got, params[i]) {
        n = i + 1
        fail(call_arg.loc, "argument ${n} of ${label} is ${got.show()}, expected ${params[i].show()}")
      }
      i += 1
    }
  }

  pub fn check_constructor(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    recv = flatten_type_chain(recv)
    if recv.kind == ex_name() && recv.ident == "Hasher" && recv.mod_name.size == 0 {
      fail(expr.loc, hasher_made_text())
      return t_int()
    }
    if recv.kind == ex_name() && recv.ident == "Buf" && recv.type_args.size == 0 && recv.mod_name.size == 0 {
      // `Buf.new`, `Buf.new(cap)` and `Buf.new(n, byte)` are `buf_new()`,
      // `buf_new(cap)` and `buf_new(n, byte)` (before, "unknown type
      // Buf").
      expr.callee = "buf_new"
      expr.derived = true
      expr.receiver = nil
      return check_call(expr, has_want, want)
    }
    if recv.kind == ex_name() {
      if cdef = find_class_template(recv.ident, recv.mod_name), recv.mod_name.size > 0 || cdef.mod_name == self.current_module || !cdef.mod_name.starts_with("std.") {
        if recv.type_args.size > 0 {
          tn = TypeName.new(recv.loc, recv.ident)
          tn.mod_name = recv.mod_name
          tn.args.concat(recv.type_args)
          ty = resolve_in_module(tn)
          self.pull_resolve()
          if !self.has_err() {
            recv.ty = ty
          }
          empty: Array(Ty) = []
          return finish_constructor(expr, ty, false, empty)
        }
        return infer_new(expr, recv, cdef, cdef.mod_name, has_want, want)
      }
    }
    if recv.kind == ex_field() {
      if obj = recv.object, obj.kind == ex_name(), cdef = find_class_template(recv.ident, obj.ident) {
        return infer_new(expr, recv, cdef, obj.ident, has_want, want)
      }
    }
    if ty = type_from_recv(recv, expr.loc) {
      recv.ty = ty
      if ty.template {
        fail(expr.loc, "${ty.name} needs type arguments")
        return t_int()
      }
      empty: Array(Ty) = []
      return finish_constructor(expr, ty, false, empty)
    }
    t_int()
  }

  pub fn template_initialize(cdef: ClassDef): Function? {
    for method in cdef.methods {
      if method.name == "initialize" {
        return method
      }
    }
    nil
  }

  pub fn infer_new(expr: Expr, recv: Expr, cdef: ClassDef, mod_name: String, has_want: Bool, want: Ty): Ty {
    params = cdef.type_params
    keys: Array(String) = []
    vals: Array(Ty) = []
    if !apply_want_args(cdef.name, params, has_want, want, keys, vals) {
      fail(expr.loc, "conflicting type arguments")
      return t_int()
    }
    pre: Array(Ty) = []
    if init = template_initialize(cdef) {
      self.resolver.set_tparams(params)
      saved_scope = self.resolver.scope_mod
      self.resolver.scope_mod = cdef.mod_name
      pats: Array(Ty) = []
      i = 0
      while i < init.params.size {
        pats.push(self.resolver.resolve_value(init.params[i].type))
        self.pull_resolve()
        i += 1
      }
      self.resolver.scope_mod = saved_scope
      self.resolver.clear_tparams()
      i = 0
      while i < expr.args.size {
        got = t_int()
        if i < pats.size {
          pat_ty = subst_ty(pats[i], keys, vals)
          got = check_expr_flag(expr.args[i], true, pat_ty)
          if !unify_ty(pat_ty, got, keys, vals) {
            fail(expr.args[i].loc, "conflicting type arguments")
          }
        } else {
          got = check_expr(expr.args[i])
        }
        pre.push(got)
        i += 1
      }
    } else {
      if expr.args.size != 0 {
        fail(expr.loc, "${cdef.name}.new takes no arguments")
        return t_int()
      }
    }
    if solved = solved_args(params, keys, vals, expr.loc) {
      ty = instantiate_applied(cdef.name, mod_name, solved, expr.loc)
      if self.has_err() {
        return t_int()
      }
      recv.ty = ty
      return finish_constructor(expr, ty, true, pre)
    }
    fail(expr.loc, "cannot infer type argument; write ${cdef.name}(...)")
    t_int()
  }

  pub fn finish_constructor(expr: Expr, ty: Ty, has_pre: Bool, pre: Array(Ty)): Ty {
    if self.has_err() {
      return t_int()
    }
    if ty.is_class() {
      shown = ty.show()
      has_init = false
      for ms in self.methods {
        if ms.is_method_of(ty) {
          if ms.name == "initialize" {
            has_init = true
          }
        }
      }
      if has_init {
        arg_tys: Array(Ty) = []
        if has_pre {
          arg_tys.concat(pre)
        } else {
          ai = 0
          while ai < expr.args.size {
            arg_tys.push(check_call_arg(expr.args[ai]))
            ai += 1
          }
        }
        none: Ty? = nil
        self.in_new = true
        found = match_method(ty.name, "initialize", arg_tys, none, expr.loc, shown, ty.mod_name, int_literal_flags(expr.args))
        self.in_new = false
        if sig = found {
          fill_defaults(expr, sig.node)
          i = 0
          while i < expr.args.size {
            got = t_int()
            if has_pre {
              if i < pre.size {
                got = pre[i]
              } else {
                got = check_default_arg(expr, i, sig.params, sig.node)
              }
            } else {
              if i < arg_tys.size {
                got = arg_tys[i]
              } else {
                got = check_default_arg(expr, i, sig.params, sig.node)
              }
            }
            if i < sig.params.size {
              got = fit_call_arg(expr.args[i], got, sig.params[i])
              if !ty_assignable(got, sig.params[i]) {
                n = i + 1
                fail(expr.args[i].loc, "argument ${n} of ${shown}.new is ${got.show()}, expected ${sig.params[i].show()}")
              }
            }
            i += 1
          }
        }
      } else {
        if expr.args.size != 0 {
          fail(expr.loc, "${shown}.new takes no arguments")
        }
      }
      expr.resolved = ty_owned_symbol(ty, "new")
      if is_mutex_ty(ty) {
        // The value given to a Mutex is its own from now on
        // (checker/guard.av).
        check_mutex_new(expr, ty)
      }
      return ty
    }
    shown = ty.show()
    fail(expr.loc, "structs are constructed with ${shown} { fields }, not .new")
    ty
  }

  // The `&x` arguments of a C call: x a local whose type is the
  // parameter's pointee (a C scalar as its Avant type, or a pointer), so
  // C's write through the pointer lands in x when the call returns. Only
  // a local: a field, an element or a heap value would give C an address
  // the collector may move. Each is marked checked with the parameter's
  // type; false after an error.
  pub fn check_out_args(expr: Expr, params: Array(Ty), what: String): Bool {
    for i in 0..expr.args.size {
      arg = expr.args[i]
      if arg.kind == ex_unary() && arg.op == tk_amp() {
        if i >= params.size {
          return true
        }
        p = params[i]
        pointee = t_int()
        ok = false
        if p.is_ptr() {
          if inner = p.inner, ptr_elem_ok(inner) {
            pointee = inner
            ok = true
          }
        }
        if !ok {
          fail(arg.loc, "&x passes the address of a local to a parameter Ptr(T), T a C scalar or a pointer; ${what}'s parameter ${i + 1} is ${p.show()}")
          return false
        }
        if x = arg.inner {
          if x.kind != ex_name() || x.implicit_field || x.ident == "self" {
            fail(x.loc, "&x takes a local, not a field, an element or a value: copy it into a local, pass &local, then store it back")
            return false
          }
          if refuse_const_write(x) {
            return false
          }
          if lt = lookup(x.ident) {
            view = ty_c_view(pointee)
            if !lt.same_as(view) {
              fail(x.loc, "&${x.ident} passes ${x.ident} to ${p.show()}: ${x.ident} must be ${view.show()}, not ${lt.show()}")
              return false
            }
            note_capture(x.ident, lt, x.loc)
            x.ty = lt
            arg.ty = p
            arg.proven = true
          } else {
            fail(x.loc, "&${x.ident} needs a local ${x.ident} declared before the call (${x.ident}: ${ty_c_view(pointee).show()} = ...)")
            return false
          }
        }
      }
    }
    true
  }

  // `String.from_c(p, n)` and `Bytes.from_c(p, n)`: n bytes of C memory
  // at p (any Ptr, or a Ptr that may be NULL) copied into a new String or
  // Bytes, NULs kept; a negative n, or a NULL p with n above 0, traps.
  pub fn check_from_c(expr: Expr, what: String): Ty {
    res = t_string()
    if what == "Bytes" {
      res = t_bytes()
    }
    if expr.args.size != 2 {
      fail(expr.loc, "${what}.from_c takes a Ptr and a length: ${what}.from_c(p, n)")
      return res
    }
    pt = check_expr(expr.args[0])
    ok = pt.is_ptr()
    if r = ty_opt_ref(pt), r.is_ptr() {
      ok = true
    }
    if !ok {
      fail(expr.args[0].loc, "${what}.from_c reads C memory through a Ptr, got ${pt.show()}")
    }
    nt = check_expr_as(expr.args[1], t_int())
    if !nt.is_int() {
      fail(expr.args[1].loc, "${what}.from_c's length must be Int, got ${nt.show()}")
    }
    res
  }

  pub fn check_lib_call(expr: Expr, lib_name: String): Ty {
    key = "${lib_name}.${expr.callee}"
    if id = self.cfun_index.get(key) {
      sig = self.cfuns[id]
      // A callback parameter is checked as Avant code sees it: its narrow
      // C scalars are their Avant views (fn(UInt8) takes fn(Int)).
      params: Array(Ty) = []
      for p in sig.params {
        params.push(ty_cb_view(p))
      }
      if !check_out_args(expr, sig.params, "${lib_name}.${expr.callee}") {
        return ty_c_view(sig.ret)
      }
      check_args(expr, params, "${lib_name}.${expr.callee}")
      if self.has_err() {
        return ty_c_view(sig.ret)
      }
      for i in 0..expr.args.size {
        if sig.params[i].is_fn() {
          arg = expr.args[i]
          if arg.kind == ex_lambda() {
            if arg.cap_names.size > 0 {
              fail(arg.loc, "C callback cannot capture ${arg.cap_names[0]}")
            }
          } else if !arg.fn_ref {
            fail(arg.loc, "C callback must be a function name or a lambda that captures nothing")
          }
        }
      }
      expr.lib_name = lib_name
      return ty_c_view(sig.ret)
    }
    fail(expr.loc, "unknown function ${lib_name}.${expr.callee}")
    t_int()
  }

  pub fn type_name_as_expr(arg: TypeName): Expr {
    if arg.fn_type {
      fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.nilable {
      fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.members.size > 0 {
      fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.args.size == 0 {
      n = Expr.new(ex_name(), arg.loc)
      n.ident = arg.name
      n.mod_name = arg.mod_name
      return n
    }
    call = Expr.new(ex_call(), arg.loc)
    call.callee = arg.name
    if arg.mod_name.size > 0 {
      mod = Expr.new(ex_name(), arg.loc)
      mod.ident = arg.mod_name
      call.receiver = mod
    }
    i = 0
    while i < arg.args.size {
      call.args.push(type_name_as_expr(arg.args[i]))
      i += 1
    }
    call
  }

  // The call reading of `name(args).member` (the parser could not tell it
  // from a type application `Name(T).member`, parse_maybe_type_app). The
  // qualifier is the receiver path as written (the parser takes one only
  // from a chain of names), rebuilt as that chain: `self.ts.get(ty)` is a
  // method call on `self.ts`, `m.f(x)` a call in module `m`
  // (flatten_module_receiver). The arguments are the parser's expression
  // reading when it had one (`o.node`, `x?`), else rebuilt from the types.
  pub fn type_app_as_call(recv: Expr): Expr {
    call = Expr.new(ex_call(), recv.loc)
    call.callee = recv.ident
    if recv.mod_name.size > 0 {
      segs = recv.mod_name.split(".")
      path = Expr.new(ex_name(), recv.loc)
      path.ident = segs[0]
      for i in 1..segs.size {
        fa = Expr.new(ex_field(), recv.loc)
        fa.object = path
        fa.ident = segs[i]
        path = fa
      }
      call.receiver = path
    }
    if recv.args.size == recv.type_args.size {
      call.args.concat(recv.args)
      return call
    }
    for type_arg in recv.type_args {
      call.args.push(type_name_as_expr(type_arg))
    }
    call
  }

  // The type reading of `Name(T).member`: the parser's call reading of the
  // arguments (type_app_as_call) is dropped so no later walk meets it.
  pub fn take_type_app(recv: Expr) {
    if recv.kind == ex_name() && recv.type_args.size > 0 {
      none: Array(Expr) = []
      recv.args = none
    }
  }

  pub fn rewrite_type_app_call(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    call = type_app_as_call(recv)
    expr.receiver = call
    check_method_call(expr, call, has_want, want)
  }

  pub fn ident_chain(expr: Expr, segs: Array(String)): Bool {
    if expr.kind == ex_name() {
      segs.push(expr.ident)
      return true
    }
    if expr.kind == ex_field() {
      if obj = expr.object, ident_chain(obj, segs) {
        segs.push(expr.ident)
        return true
      }
    }
    false
  }

  // A name or a chain of names (`a`, `m.T`): what an unknown name stands
  // for, so a failure in it is not reported again by what reads it.
  pub fn is_ident_chain(expr: Expr): Bool {
    segs: Array(String) = []
    ident_chain(expr, segs)
  }

  pub fn join_segs(segs: Array(String), n: Int): String {
    buf = buf_new()
    for i in 0..n {
      if i > 0 {
        buf.push_str(".")
      }
      buf.push_str(segs[i])
    }
    buf.to_s()
  }

  pub fn longest_module(segs: Array(String), allow_full: Bool): Int {
    limit = segs.size
    if !allow_full {
      if segs.size == 0 {
        return 0
      }
      limit = segs.size - 1
    }
    best = 0
    n = 1
    while n <= limit {
      mod = join_segs(segs, n)
      if qualifier_ok(mod, self.current_module) {
        best = n
      }
      n += 1
    }
    best
  }

  pub fn flatten_module_receiver(recv: Expr): Expr {
    segs: Array(String) = []
    if ident_chain(recv, segs) && segs.size > 1 {
      best = longest_module(segs, true)
      if best == segs.size {
        mod = join_segs(segs, best)
        name_expr = Expr.new(ex_name(), recv.loc)
        name_expr.ident = mod
        return name_expr
      }
    }
    recv
  }

  // A receiver naming an alias of a generic type with type arguments
  // (`type Mutex = sync.Mutex`, then `Mutex(Int).new(1)`) is rewritten
  // in place to the generic's own name and module.
  pub fn expand_generic_alias_recv(recv: Expr) {
    if recv.kind != ex_name() || recv.type_args.size == 0 {
      return
    }
    tn = TypeName.new(recv.loc, recv.ident)
    tn.mod_name = recv.mod_name
    saved = self.resolver.scope_mod
    self.resolver.scope_mod = self.current_module
    got = self.resolver.generic_alias_target(tn)
    self.resolver.scope_mod = saved
    if g = got {
      recv.ident = g.name
      recv.mod_name = g.mod_name
    }
  }

  pub fn flatten_type_chain(recv: Expr): Expr {
    segs: Array(String) = []
    if ident_chain(recv, segs) && segs.size > 2 {
      best = longest_module(segs, false)
      if best > 0 && best == segs.size - 1 {
        mod = join_segs(segs, best)
        name_expr = Expr.new(ex_name(), recv.loc)
        name_expr.ident = mod
        flat = Expr.new(ex_field(), recv.loc)
        flat.object = name_expr
        flat.ident = segs[best]
        return flat
      }
    }
    recv
  }

  pub fn check_method_call(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    got = check_method_call_of(expr, recv, has_want, want)
    if !self.has_err() {
      if r0 = expr.receiver {
        note_copy_call(expr, r0)
      }
    }
    if !self.has_err() && handler_method(expr.callee) {
      if r = expr.receiver, rt = r.ty, is_http_server(rt) {
        // The server runs a handler on each of its loop threads at once
        // (checker/spawn.av).
        check_handler_args(expr)
      }
    }
    if !self.has_err() && expr.callee == "recover" && expr.args.size == 1 {
      if r = expr.receiver, rt = r.ty, is_mutex_ty(rt) {
        // `m.recover(v)` gives the mutex v as `Mutex(T).new(v)` does: the
        // same rule for what v may be (checker/guard.av).
        check_mutex_value(expr, rt, "recover")
      }
    }
    got
  }

  pub fn check_method_call_of(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    recv = flatten_module_receiver(recv)
    if recv.kind == ex_name() && recv.mod_name.size == 0 && recv.type_args.size == 0 {
      // A type alias used as a value stands for the type it names.
      if t = alias_value_target(recv.ident, recv.loc) {
        if t.mod_name.size > 0 && t.args.size == 0 {
          // Written as the qualified name it stands for (`regex.Regex`).
          m = Expr.new(ex_name(), recv.loc)
          m.ident = t.mod_name
          q = Expr.new(ex_field(), recv.loc)
          q.object = m
          q.ident = t.name
          recv = q
        } else {
          recv.ident = t.name
          recv.mod_name = t.mod_name
          recv.type_args = t.args
        }
      } else {
        why = alias_not_value_text(recv.ident, recv.loc)
        if why.size > 0 {
          fail(recv.loc, why)
          return t_int()
        }
      }
    }
    if expr.callee == "new" {
      recv = flatten_type_chain(recv)
    }
    expr.receiver = recv
    expand_generic_alias_recv(recv)
    if recv.kind == ex_name() && recv.type_args.size > 0 && recv.mod_name.size == 0 {
      // A std module's generic type named bare (`Mutex(Int).new`): the
      // program's own or an import's is meant, else the qualified
      // spelling is asked for (`sync.Mutex(Int).new`).
      sm = self.resolver.std_owner_of(recv.ident, self.current_module)
      if sm.size > 0 && self.resolver.template_in(sm, recv.ident) {
        saved_scope = self.resolver.scope_mod
        self.resolver.scope_mod = self.current_module
        owners = self.resolver.template_owners(recv.ident)
        self.resolver.scope_mod = saved_scope
        if owners.size == 1 {
          recv.mod_name = owners[0]
        } else if owners.size == 0 {
          fail(recv.loc, self.resolver.std_bare_text(recv.ident, sm))
          return t_int()
        }
      }
    }
    if recv.kind == ex_name() && recv.type_args.size > 0 {
      if is_generic_template_in(recv.ident, recv.mod_name) {
        take_type_app(recv)
        if expr.callee == "new" {
        } else {
          fail(recv.loc, "${recv.ident} is a type")
          return t_int()
        }
      } else {
        if expr.callee == "new" {
          if f = find_fn(recv.ident) {
          } else if v = lookup(recv.ident) {
          } else {
            // `Channel(Int).new` with no such generic type: before, the
            // call reading said "new is a type constructor". Two
            // modules' generic types of that name are named both.
            clash = clash_message(recv.ident, self.current_module)
            if clash.size > 0 {
              fail(recv.loc, clash)
            } else if recv.mod_name.size > 0 {
              fail(recv.loc, "unknown type ${recv.mod_name}.${recv.ident}")
            } else {
              fail(recv.loc, unknown_type_text(recv.ident))
            }
            return t_int()
          }
        }
        return rewrite_type_app_call(expr, recv, has_want, want)
      }
    }
    if recv.kind == ex_name() {
      if found = lookup(recv.ident) {
      } else {
        if !(recv.type_args.size > 0) {
          if recv.ident == "gc" && imported_by(self.current_module, "std.gc") {
            // A field named gc beside `import std.gc`: neither wins.
            if f0 = implicit_field("gc"), module_is_method(recv.ident, recv.loc) {
              return t_int()
            }
          }
          if names_std_gc(recv.ident) {
            if module_is_method(recv.ident, recv.loc) {
              return t_int()
            }
            return check_gc_call(expr)
          }
          if id = self.lib_names.get(recv.ident) {
            if lib_is_visible(recv.ident, self.current_module) {
              return check_lib_call(expr, recv.ident)
            }
            spelled = std_type_bare_spelling(recv.ident)
            if spelled.size > 0 {
              fail(recv.loc, "${recv.ident} needs its module's name: write ${spelled}; a std module's types are not named bare")
            } else {
              fail(recv.loc, "unknown name ${recv.ident}")
            }
            return t_int()
          }
          if k = self.known_mods.get(recv.ident), qualifier_ok(recv.ident, self.current_module) {
            if module_is_method(recv.ident, recv.loc) {
              return t_int()
            }
            if recv.ident == "std.json" && json_codec_callee(expr.callee) {
              // The typed decode and encode (checker/json_codec.av).
              expr.receiver = nil
              return check_json_call(expr)
            }
            return dispatch_qualified_call(expr, recv.ident)
          }
        }
      }
    }
    if expr.callee == "new" {
    } else {
      if ty = type_call_target(recv, expr.callee) {
        return check_type_call(expr, ty)
      }
    }
    if expr.callee == "new" {
      return check_constructor(expr, recv, has_want, want)
    }
    if recv.kind == ex_name() && (recv.ident == "String" || recv.ident == "Bytes") && expr.callee == "from_c" {
      if found = lookup(recv.ident) {
      } else {
        return check_from_c(expr, recv.ident)
      }
    }
    if recv.kind == ex_name() && recv.ident == "Float64" && expr.callee == "from_bits" {
      if found = lookup(recv.ident) {
      } else {
        // `Float64.from_bits(u)`: the float whose 64 bits are u.
        if expr.args.size != 1 {
          fail(expr.loc, "Float64.from_bits takes one UInt64")
          return t_float()
        }
        got = check_expr_as(expr.args[0], t_uint64())
        if !got.is_uint64() {
          fail(expr.args[0].loc, "Float64.from_bits expects UInt64, got ${got.show()}")
        }
        return t_float()
      }
    }
    if recv.kind == ex_name() {
      if recv.ident == "String" {
        if expr.callee == "from_utf8" {
          if expr.args.size != 1 {
            fail(expr.loc, "String.from_utf8 takes one Bytes")
            return ty_nilable(t_string())
          }
          got = check_expr_as(expr.args[0], t_bytes())
          if !got.is_bytes() {
            fail(expr.args[0].loc, "String.from_utf8 expects Bytes")
          }
          return ty_nilable(t_string())
        }
        if expr.callee == "from_code_point" {
          if expr.args.size != 1 {
            fail(expr.loc, "String.from_code_point takes one Int")
            return t_string()
          }
          got = check_expr_as(expr.args[0], t_int())
          if !got.is_int() {
            fail(expr.args[0].loc, "String.from_code_point expects Int")
          }
          return t_string()
        }
      }
    }
    // A type without that type-level function: before, its name was
    // checked as a value ("unknown name T") and the call then read as a
    // method of Int.
    tn = receiver_type_name(recv)
    mark = err_count()
    object = t_int()
    if tn.size == 0 {
      self.recv_name = recv.kind == ex_name()
      self.recv_type = ""
      self.carray_ok = expr.callee == "to_s" && expr.args.size == 0
      object = check_expr(recv)
      self.carray_ok = false
      self.recv_name = false
      tn = self.recv_type
    }
    if tn.size > 0 {
      for a in expr.args {
        check_expr(a)
      }
      fail_no_type_fn(expr.loc, recv, tn, expr.callee)
      return t_int()
    }
    if object.is_ptr() && expr.callee == "as" {
      return check_ptr_as(expr, object)
    }
    if object.is_carray() {
      // `r.message.to_s()`: a C char array's text, up to its first NUL
      // or its N bytes.
      if ce = object.inner, ce.c_scalar == cs_int8() || ce.c_scalar == cs_uint8() {
        if expr.callee == "to_s" && expr.args.size == 0 {
          expr.resolved = "carray.to_s"
          return t_string()
        }
      }
      fail(expr.loc, "${object.show()} is a C array: read it with [i] and .size (.to_s() reads an Int8 or UInt8 array as text)")
      return t_int()
    }
    if new_err_since(mark) && is_ident_chain(recv) {
      // An unknown name is reported once, not again as a method of the
      // Int that stands for it.
      for a in expr.args {
        check_expr(a)
      }
      return t_int()
    }
    if expr.callee == "clone" {
      // The derived deep copy (checker/clone.av), on every type.
      cexp: Ty? = nil
      if has_want {
        cexp = want
      }
      return check_clone_call(expr, object, cexp)
    }
    if expr.callee == "or" {
      if b = expr.block {
        fail(expr.loc, "or does not take a block")
        return object
      }
      if expr.args.size == 1 {
        if can_coalesce(object) {
          return coalesce_result(object, expr.args[0], expr.loc, "or")
        }
        check_expr(expr.args[0])
        if !self.has_err() {
          failure_split(object, expr.loc, "or")
        }
        return object
      }
      fail(expr.loc, "or takes one fallback")
      return object
    }
    if expr.callee == "expect" && object.is_union() {
      return check_expect(expr, object)
    }
    if expr.callee == "with" {
      if is_mutex_ty(object) {
        absorb_lambda_arg(expr, object)
        return check_mutex_with(expr, object)
      }
    }
    if expr.callee == "try_with" {
      if is_mutex_ty(object) {
        absorb_lambda_arg(expr, object)
        // `with` that gives the block's value, or a MutexError when the
        // mutex is poisoned (a task trapped holding it): T | MutexError.
        got = check_mutex_with(expr, object)
        if self.has_err() {
          return got
        }
        if me = self.resolver.get_named_in("std.sync", "MutexError") {
          parts: Array(Ty) = []
          parts.push(got)
          parts.push(me)
          return ty_union_build(parts)
        }
        return got
      }
    }
    if expr.callee == "to_s" && text_to_s(object) {
      // The text interpolation prints: an enum's name, an error's text,
      // a union's member, a type's own to_s.
      return scalar_to_s(expr, object)
    }
    if expr.callee == "size" && expr.args.size == 0 {
      if b = expr.block {
      } else if object.is_string() || object.is_bytes() || object.is_array() || object.is_hash() || object.is_buf() {
        // A builtin read-only property is read without parentheses.
        fail(expr.loc, "size is read without parentheses: write .size")
        return t_int()
      }
    }
    if object.is_float() || object.is_integer() || object.is_string() || object.is_bytes() || object.is_array() || object.is_hash() || object.is_buf() || object.is_join() {
      return builtin_method(expr, object)
    }
    if object.is_hasher() {
      return check_hasher_method(expr)
    }
    if expr.callee == "equals" && expr.args.size == 1 && (object.is_struct() || object.is_class()) && !self.user_op(object, "equals") {
      if bl = expr.block {
      } else {
        return check_equals_call(expr, object)
      }
    }
    if object.is_bool() && expr.callee == "to_s" {
      return scalar_to_s(expr, object)
    }
    if object.is_bool() && expr.args.size == 0 {
      if bt = bool_conversion_ty(expr.callee) {
        return bt
      }
    }
    expected: Ty? = nil
    if has_want {
      expected = want
    }
    if object.is_bool() && owner_has_method("Bool", expr.callee) {
      return dispatch_method(expr, object, expected)
    }
    if object.is_enum() {
      // `t.to_i`: the member's value as an Int, extended by the
      // lowering; every other name is a method (the ones every enum
      // has, enums.av, and the enum's own).
      if expr.callee == "to_i" && expr.args.size == 0 {
        if b = expr.block {
        } else {
          expr.method_call = true
          return t_int()
        }
      }
      return dispatch_method(expr, object, expected)
    }
    if object.is_agg() {
      if expr.callee == "send" && is_sync_ty(object, "Channel") {
        // What a send carries crosses a task (checker/guard.av).
        sent = dispatch_method(expr, object, expected)
        check_send(expr)
        return sent
      }
      return dispatch_method(expr, object, expected)
    }
    if object.is_ptr() {
      return dispatch_method(expr, object, expected)
    }
    // A method of the value inside an optional: open it first.
    fail_hint(expr.loc, "cannot call ${expr.callee} on ${object.show()}", open_hint(recv, object))
    t_int()
  }

  // `x.expect("why")` on an optional: the value, or when x is nil a trap
  // that prints why and the call's position. Only an optional: a union
  // with an error member says what failed, which ?, if-assign, ?? and
  // switch read.
  pub fn check_expect(expr: Expr, object: Ty): Ty {
    payload = ty_without_nil(object)
    if s = ty_success_part(object) {
      payload = s
    }
    fails = ty_failures(object)
    if !object.is_nilable() || fails.size != 1 || !fails[0].is_nil() {
      for a in expr.args {
        check_expr(a)
      }
      fail(expr.loc, "expect opens an optional (T?), and ${object.show()} can fail with an error: read it with ?, if-assign, ?? or switch")
      return payload
    }
    if b = expr.block {
      fail(expr.loc, "expect takes no block: x.expect(\"why\")")
      return payload
    }
    if expr.args.size != 1 {
      for a in expr.args {
        check_expr(a)
      }
      fail(expr.loc, "expect takes one String, why the value cannot be nil: x.expect(\"why\")")
      return payload
    }
    check_expr_as(expr.args[0], t_string())
    payload
  }

  // An `each` block: its statements are checked as the code around it,
  // so a `return` leaves the function with the function's result type.
  pub fn check_switch(expr: Expr, has_want: Bool, want: Ty): Ty {
    stmt_mode = self.switch_stmt
    self.switch_stmt = false
    tail_mode = self.switch_tail
    self.switch_tail = false
    if expr.op == tk_if() && expr.else_body.size == 1 {
      if t = check_if_value(expr.else_body[0], has_want, want) {
        return t
      }
      fail(expr.loc, "an if used as a value leaves in every branch, so it has no value")
      return t_int()
    }
    // The discriminant's countable cases: an enum's members, a union's
    // members, Bool's true and false. A switch over a countable type
    // without else names every case.
    countable = false
    disc = t_int()
    if cond = expr.cond {
      ct = t_int()
      if pre = self.switch_pre {
        self.switch_pre = nil
        ct = pre
      } else {
        ct = check_expr(cond)
      }
      disc = ct
      if ct.is_enum() || ct.is_union() || ct.is_bool() {
        countable = true
      } else if !ct.is_integer() && !ct.is_bool() && !ct.is_string() {
        fail(cond.loc, "switch discriminant must be an integer (Int, Int32, UInt32, UInt64), Bool, String, an enum or a union, got ${ct.show()}")
      }
    }
    covered = Set(Int).new()
    seen = Hash(Int, Int).new()
    seen_str = Hash(String, Int).new()
    // An integer switch's labels, for the overlaps of its ranges.
    ranges: Array(CaseLabel) = []
    has_range = false
    for arm in expr.cases {
      if arm.labels.size == 0 {
        fail(arm.loc, "case needs a label")
      }
      if arm.labels.size > 1 {
        for bl in arm.labels {
          if bl.bind.size > 0 {
            fail(bl.loc, "a case that binds a value has one label: write `case ${bl.bind}: ...` as its own arm")
          }
        }
      }
      for label in arm.labels {
        if !check_case_label(label, disc) {
          continue
        }
        if label.kind == lb_range() {
          ranges.push(label)
          has_range = true
          continue
        }
        if disc.is_integer() {
          ranges.push(label)
        }
        if label.kind == lb_string() {
          if prev_s = seen_str.get(label.text) {
            fail(label.loc, "duplicate case ${quote_label(label.text)}")
          }
          seen_str[label.text] = 1
          continue
        }
        lab = label.int_val
        if prev = seen.get(lab) {
          if label.kind == lb_type() || label.kind == lb_nil() {
            fail(label.loc, "duplicate case ${union_case_name(disc, lab)}")
          } else if label.kind == lb_member() {
            fail(label.loc, "duplicate case ${label.text}")
          } else if label.kind == lb_bool() {
            fail(label.loc, "duplicate case ${label.int_val != 0}")
          } else {
            fail(arm.loc, "duplicate case ${int_label_text(label)}")
          }
        }
        seen[lab] = 1
        covered.add(lab)
      }
    }
    if has_range && !self.has_err() {
      check_label_overlaps(ranges, disc)
    }
    if countable && !self.has_err() {
      missing = switch_missing_cases(disc, covered)
      if !expr.has_else && missing.size > 0 {
        fail(expr.loc, "switch over ${disc.show()} does not cover ${join_names(missing)}: name them or add else")
      }
      if expr.has_else && missing.size == 0 {
        if disc.is_bool() {
          fail(expr.loc, "both true and false are named; remove the else")
        } else {
          fail(expr.loc, "every member of ${disc.show()} is named; remove the else")
        }
      }
    }
    // An arm that leaves (its last statement a return, break or
    // continue) gives no value and joins nothing.
    if stmt_mode {
      // A switch used as a statement: every arm is a block of
      // statements, as an `if`'s branches; a value an arm ends with is
      // dropped under the discard rule.
      for sarm in expr.cases {
        check_switch_stmts(sarm.body, arm_binding(sarm), arm_binding_ty(sarm, disc))
      }
      if expr.has_else {
        check_switch_stmts(expr.else_body, "", t_void())
      }
      return t_void()
    }
    branch_tys: Array(Ty) = []
    branch_locs: Array(Location) = []
    i = 0
    while i < expr.cases.size {
      bt = check_switch_branch_bound(expr.cases[i].body, has_want, want, arm_binding(expr.cases[i]), arm_binding_ty(expr.cases[i], disc))
      if !arm_leaves(expr.cases[i].body) {
        branch_tys.push(bt)
        branch_locs.push(arm_value_loc(expr.cases[i].body, expr.loc))
      }
      i += 1
    }
    if expr.has_else {
      et = check_switch_branch(expr.else_body, has_want, want)
      if !arm_leaves(expr.else_body) {
        branch_tys.push(et)
        branch_locs.push(arm_value_loc(expr.else_body, expr.loc))
      }
    }
    all_void = true
    any_void = false
    for ix in 0..branch_tys.size {
      if branch_tys[ix].is_void() {
        any_void = true
      } else {
        all_void = false
      }
    }
    if all_void {
      return t_void()
    }
    if any_void {
      fail(expr.loc, "switch cases must all produce a value, or none")
      return t_int()
    }
    if !expr.has_else && !countable {
      fail(expr.loc, "switch expression needs else")
      return t_int()
    }
    if has_want && !want.is_void() {
      one = true
      for bi in 0..branch_tys.size {
        branch_ty = branch_tys[bi]
        if !ty_assignable(branch_ty, want) {
          fail(branch_locs[bi], "switch branch is ${branch_ty.show()}, expected ${want.show()}")
        }
        if !branch_ty.same_as(branch_tys[0]) {
          one = false
        }
      }
      if tail_mode && one && branch_tys.size > 0 {
        return branch_tys[0]
      }
      return want
    }
    if branch_tys.size == 0 {
      return t_void()
    }
    if joined = nil_join(branch_tys) {
      return joined
    }
    result = branch_tys[0]
    for branch_ty in branch_tys {
      if !branch_ty.same_as(result) {
        fail(expr.loc, "switch branches have different types ${result.show()} and ${branch_ty.show()}")
      }
    }
    result
  }

  // A case label against the discriminant's type: an enum's labels
  // are its bare member names, each getting its value in int_val; an
  // integer discriminant's are integer literals. False when the label
  // was refused.
  pub fn check_case_label(label: CaseLabel, disc: Ty): Bool {
    if label.kind == lb_range() {
      return check_range_label(label, disc)
    }
    if disc.is_union() {
      return check_union_label(label, disc)
    }
    if label.kind == lb_type() || label.kind == lb_nil() {
      fail(label.loc, "a member-type or nil label needs a union to switch over, got ${disc.show()}")
      return false
    }
    if disc.is_enum() {
      if label.kind != lb_member() {
        fail(label.loc, "a case label of a switch over ${disc.show()} is one of its members, written bare (case ${disc.enum_names()[0]})")
        return false
      }
      if label.qual.size > 0 {
        fail(label.loc, "write the member without its type in a case label: `case ${label.text}`")
        return false
      }
      idx = disc.enum_index(label.text)
      if idx < 0 {
        fail_hint(label.loc, "${disc.show()} has no member ${label.text}", member_hint(disc, label.text, true))
        return false
      }
      label.int_val = disc.enum_vals()[idx]
      return true
    }
    if disc.is_bool() {
      // `case true` and `case false`.
      if label.kind == lb_bool() {
        return true
      }
      if label.kind == lb_member() {
        return check_const_label(label, disc)
      }
      if label.kind == lb_int() && !label.neg && label.bits <= 1 {
        word = "false"
        if label.bits == 1 {
          word = "true"
        }
        fail(label.loc, "a case label of a switch over Bool is true or false: write `case ${word}`")
        return false
      }
      fail(label.loc, "a case label of a switch over Bool is true or false")
      return false
    }
    if label.kind == lb_bool() {
      fail(label.loc, "true and false label a switch over Bool, not ${disc.show()}")
      return false
    }
    if disc.is_string() {
      if label.kind != lb_string() {
        fail(label.loc, "a case label of a switch over String is a string literal")
        return false
      }
      return true
    }
    if label.kind == lb_member() && label.value_of.size > 0 && disc.is_int() {
      return check_enum_value_label(label)
    }
    if label.kind == lb_member() {
      return check_const_label(label, disc)
    }
    if label.kind != lb_int() {
      fail(label.loc, "case label must be an integer literal")
      return false
    }
    check_int_label(label, disc)
  }

  // A label of an enum's from_i: the value of the
  // member label.text of the enum label.value_of, known once the
  // constants are (consts.av check_enum_consts), as an integer label.
  pub fn check_enum_value_label(label: CaseLabel): Bool {
    if et = lookup_named_type(label.value_of, label.loc, "") {
      idx = et.enum_index(label.text)
      if et.is_enum() && idx >= 0 {
        v = et.enum_vals()[idx]
        label.int_val = v
        label.neg = v < 0
        if v < 0 {
          label.bits = (0 &- v).wrap_u64()
        } else {
          label.bits = v.to_u64()
        }
        return true
      }
    }
    fail(label.loc, "${label.value_of} has no member ${label.text}")
    false
  }

  // A range label: over an integer, its bounds labels of the value's
  // type; `lo..hi` holds lo to hi - 1, `lo..=hi` lo to hi, and an empty
  // range is an error. int_val becomes its first value and hi_val its
  // last.
  pub fn check_range_label(label: CaseLabel, disc: Ty): Bool {
    if !disc.is_integer() {
      fail(label.loc, "a range label needs a switch over an integer, got ${disc.show()}")
      return false
    }
    first = 0
    last = 0
    if a = label.lo, z = label.hi {
      if !check_case_label(a, disc) || !check_case_label(z, disc) {
        return false
      }
      first = a.int_val
      last = z.int_val
    } else {
      return false
    }
    if label.incl {
      if case_ord(last, disc) < case_ord(first, disc) {
        fail(label.loc, "the range ${case_label_text(label)} is empty")
        return false
      }
    } else {
      if case_ord(last, disc) <= case_ord(first, disc) {
        fail(label.loc, "the range ${case_label_text(label)} is empty")
        return false
      }
      last = last &- 1
    }
    label.int_val = first
    label.hi_val = last
    true
  }

  // A label's value in the order of the discriminant's type: a UInt64's
  // 64 bits are held in an Int, so its order is the Int's with the sign
  // bit flipped.
  pub fn case_ord(v: Int, disc: Ty): Int {
    if disc.is_uint64() {
      return v &+ (-9223372036854775807 - 1)
    }
    v
  }

  // An integer, name or range label as written, for messages.
  pub fn case_label_text(label: CaseLabel): String {
    if label.kind == lb_range() {
      op = ".."
      if label.incl {
        op = "..="
      }
      lo_text = ""
      hi_text = ""
      if a = label.lo {
        lo_text = case_label_text(a)
      }
      if z = label.hi {
        hi_text = case_label_text(z)
      }
      return "${lo_text}${op}${hi_text}"
    }
    if label.kind == lb_member() {
      if label.qual.size > 0 {
        return "${label.qual}.${label.text}"
      }
      return label.text
    }
    int_label_text(label)
  }

  // Two labels of an integer switch that share a value: an error naming
  // both, where one is a range (two equal values are the duplicate
  // error).
  pub fn check_label_overlaps(labels: Array(CaseLabel), disc: Ty) {
    for j in 0..labels.size {
      b = labels[j]
      for i in 0..j {
        a = labels[i]
        if a.kind != lb_range() && b.kind != lb_range() {
          continue
        }
        a_hi = a.int_val
        if a.kind == lb_range() {
          a_hi = a.hi_val
        }
        b_hi = b.int_val
        if b.kind == lb_range() {
          b_hi = b.hi_val
        }
        lo = case_ord(a.int_val, disc)
        if case_ord(b.int_val, disc) > lo {
          lo = case_ord(b.int_val, disc)
        }
        hi = case_ord(a_hi, disc)
        if case_ord(b_hi, disc) < hi {
          hi = case_ord(b_hi, disc)
        }
        if lo <= hi {
          fail(b.loc, "case ${case_label_text(b)} overlaps case ${case_label_text(a)}")
          return
        }
      }
    }
  }

  // An integer label as written (its sign and magnitude).
  pub fn int_label_text(label: CaseLabel): String {
    if label.neg && label.bits != 0 {
      return "-${label.bits}"
    }
    "${label.bits}"
  }

  // An integer label against an integer discriminant's type: it adopts
  // that type, as a literal does, and must fit in it.
  pub fn check_int_label(label: CaseLabel, disc: Ty): Bool {
    if !disc.is_integer() {
      return true
    }
    if label.neg && disc.is_unsigned() && label.bits != 0 {
      fail(label.loc, "case label ${int_fit_text(label)} does not fit in ${disc.show()}")
      return false
    }
    max = literal_int_max(disc)
    if label.neg {
      max = max + 1
    }
    if label.bits > max {
      fail(label.loc, "case label ${int_fit_text(label)} does not fit in ${disc.show()}")
      return false
    }
    true
  }

  // A label in a message about its value: as written, and a constant's
  // value beside its name.
  pub fn int_fit_text(label: CaseLabel): String {
    if label.kind == lb_member() {
      return "${case_label_text(label)} = ${int_label_text(label)}"
    }
    int_label_text(label)
  }

  // A union switch's label: a member type, with or without a binding,
  // or `nil`; int_val becomes the member's index in the union (its
  // tag).
  pub fn check_union_label(label: CaseLabel, disc: Ty): Bool {
    if label.kind == lb_nil() {
      if !disc.includes_nil() {
        fail(label.loc, "case nil: ${disc.show()} has no nil member")
        return false
      }
      label.int_val = disc.tag_of(ty_nil())
      return true
    }
    if label.kind != lb_type() {
      fail(label.loc, "a case label of a switch over ${disc.show()} is one of its member types, with or without a binding (case n: ${union_case_name(disc, first_payload_index(disc))}), or nil")
      return false
    }
    if label.bind == "_" {
      fail(label.loc, "write the type alone to name a member without a binding: `case ...`")
      return false
    }
    t = t_int()
    if tn = label.tname {
      t = resolve_in_module(tn)
    } else {
      return false
    }
    self.pull_resolve()
    if self.has_err() {
      return false
    }
    if t.is_nil() {
      fail(label.loc, "write `case nil` for the nil member")
      return false
    }
    if !disc.includes_member(t) {
      fail(label.loc, "${t.show()} is not a member of ${disc.show()}")
      return false
    }
    label.int_val = disc.tag_of(t)
    true
  }

  // A union member as a label names it: its type, or nil.
  pub fn union_case_name(disc: Ty, idx: Int): String {
    if idx < 0 || idx >= disc.members.size {
      return "nil"
    }
    m = disc.members[idx]
    if m.is_nil() {
      return "nil"
    }
    m.show()
  }

  pub fn first_payload_index(disc: Ty): Int {
    for i in 0..disc.members.size {
      if !disc.members[i].is_nil() {
        return i
      }
    }
    0
  }

  // The name an arm's one label binds ("" for none), and its type: the
  // union member it names.
  pub fn arm_binding(arm: SwitchCase): String {
    if arm.labels.size == 1 && arm.labels[0].kind == lb_type() && arm.labels[0].bind != "_" {
      return arm.labels[0].bind
    }
    ""
  }

  pub fn arm_binding_ty(arm: SwitchCase, disc: Ty): Ty {
    if arm.labels.size == 1 && arm.labels[0].kind == lb_type() && disc.is_union() {
      idx = arm.labels[0].int_val
      if idx >= 0 && idx < disc.members.size {
        return disc.members[idx]
      }
    }
    t_void()
  }

  // A statement switch's arm: its statements, the binding in scope
  // for them only.
  pub fn check_switch_stmts(body: Array(Stmt), name: String, ty: Ty) {
    self.push_scope()
    if name.size > 0 {
      bind(name, ty)
    }
    for stmt in body {
      check_block_stmt(stmt, self.return_type, false)
    }
    self.pop_scope()
  }

  // A String label as written in a message: quoted, its quote and
  // backslash escaped.
  pub fn quote_label(text: String): String {
    buf = buf_new()
    buf.push_str("\"")
    for i in 0..text.size {
      c = text[i]
      if c == 34 || c == 92 {
        buf.push_byte(92)
      }
      buf.push_byte(c)
    }
    buf.push_str("\"")
    buf.to_s()
  }

  // The countable cases of a discriminant type that the labels in
  // covered (by value) leave out, in declaration order (an enum's
  // members, a union's members, Bool's true and false).
  pub fn switch_missing_cases(disc: Ty, covered: Set(Int)): Array(String) {
    missing: Array(String) = []
    if disc.is_bool() {
      if !covered.has(1) {
        missing.push("true")
      }
      if !covered.has(0) {
        missing.push("false")
      }
    }
    if disc.is_union() {
      for ui in 0..disc.members.size {
        if !covered.has(ui) {
          missing.push(union_case_name(disc, ui))
        }
      }
    }
    if disc.is_enum() {
      names = disc.enum_names()
      vals = disc.enum_vals()
      for i in 0..names.size {
        if covered.has(vals[i]) {
          continue
        }
        missing.push(names[i])
      }
    }
    missing
  }

  pub fn join_names(names: Array(String)): String {
    buf = buf_new()
    for i in 0..names.size {
      if i > 0 {
        buf.push_str(", ")
      }
      buf.push_str(names[i])
    }
    buf.to_s()
  }

  pub fn check_spawn(expr: Expr): Ty {
    if expr.args.size != 0 {
      fail(expr.loc, "spawn takes a block, not arguments")
      return ty_join(t_int())
    }
    if b = expr.block {
      if b.params.size != 0 {
        fail(b.loc, "spawn { } does not take block parameters; use items.parallel")
        return ty_join(t_int())
      }
      self.in_task += 1
      saved_loops = self.loop_depth
      self.loop_depth = 0
      saved_try = self.try_in
      self.try_in = "a spawn block"
      saved_fails = self.spawn_fails
      self.spawn_fails = []
      // A spawn inside the block runs no longer than the block's task
      // (its join waits for it): what it keeps frozen is the block's own
      // business, under the block's names.
      saved_ph = self.pending_handles
      saved_pa = self.pending_arrays
      self.pending_handles = []
      self.pending_arrays = []
      result = check_spawn_value(b)
      self.pending_handles = saved_ph
      self.pending_arrays = saved_pa
      fails = self.spawn_fails
      self.spawn_fails = saved_fails
      self.try_in = saved_try
      self.loop_depth = saved_loops
      self.in_task -= 1
      if fails.size > 0 && !self.has_err() {
        // A `?` in the block: the join gives the value or the failure.
        parts: Array(Ty) = []
        parts.push(result)
        parts.concat(fails)
        result = ty_union_build(parts)
      }
      if !self.has_err() && ty_holds_ptr(result) && !ptrs_cross_here(result) {
        fail(b.loc, "a spawn block's value cannot be a ${result.show()}: a Ptr is C memory, and it crosses to another task only in the module whose lib block declares its C type")
      }
      collect_spawn_captures(expr, b.body)
      return ty_join(result)
    }
    fail(expr.loc, "spawn needs a block")
    ty_join(t_int())
  }

  // A spawn block's value: its last expression's type, or Void when it
  // ends with a statement or a call that gives nothing (the join then
  // gives `Void | TaskError`).
  pub fn check_spawn_value(block: Block): Ty {
    if block.body.size > 0 {
      last = block.body[block.body.size - 1]
      gives = last.kind == st_expr() || (last.kind == st_if() && last.else_body.size > 0)
      if !gives {
        self.push_scope()
        for stmt in block.body {
          check_block_stmt(stmt, self.return_type, false)
        }
        self.pop_scope()
        return t_void()
      }
      if last.kind == st_expr() {
        if e = last.expr, e.kind == ex_call() || e.kind == ex_field() {
          // A call that gives nothing ends a Void block.
          self.push_scope()
          i = 0
          while i < block.body.size - 1 {
            check_block_stmt(block.body[i], self.return_type, false)
            i += 1
          }
          scan_pending_expr(e)
          ty = check_expr(e)
          self.pop_scope()
          return ty
        }
      }
    }
    check_block_value(block)
  }

  pub fn check_block_value(block: Block): Ty {
    check_block_value_as(block, false, t_int())
  }

  // The value of a block; with has_want its last expression is checked
  // against the wanted type, so a literal takes it (`[]`, `nil`, `0`).
  // A last `if` with an else is the block's value: it becomes the node
  // of an `if` used as a value (ast.av ex_switch, op tk_if), which every
  // walker and the lowering already know. The other statements are
  // checked as the code around them: a `return` leaves the function, so
  // it takes the function's result type.
  pub fn check_block_value_as(block: Block, has_want: Bool, want: Ty): Ty {
    if block.body.size == 0 {
      fail(block.loc, "block needs a value")
      return t_int()
    }
    tail = block.body[block.body.size - 1]
    if tail.kind == st_if() && tail.else_body.size > 0 {
      ife = Expr.new(ex_switch(), tail.loc)
      ife.op = tk_if()
      ife.has_else = true
      ife.else_body.push(tail)
      block.body[block.body.size - 1] = stmt_expr(tail.loc, ife)
    }
    self.push_scope()
    last = block.body[block.body.size - 1]
    i = 0
    while i < block.body.size {
      stmt = block.body[i]
      if i == block.body.size - 1 {
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            scan_pending_expr(e)
            ty = check_expr_flag(e, has_want, want)
            if ty.is_void() {
              fail(stmt.loc, "block must end with a value")
              self.pop_scope()
              return t_int()
            }
            self.pop_scope()
            return ty
          }
        }
        if stmt.kind == st_return() && self.inline_what.size > 0 {
          // A lambda's last statement may be its `return`.
          if x = stmt.expr {
            check_block_stmt(stmt, self.return_type, false)
            self.pop_scope()
            return self.return_type
          }
        }
        fail(stmt.loc, "block must end with a value")
        self.pop_scope()
        return t_int()
      }
      check_block_stmt(stmt, self.return_type, false)
      i += 1
    }
    self.pop_scope()
    t_int()
  }

  // std.sync's Mutex: a class of another module with that name is an
  // ordinary class, and `with` an ordinary method. A `with` block's
  // statements, checked as the code around it would check them (return
  // against the function's result, break and continue against its
  // loops); the value is the last expression's when want_value, else
  // Void.
  pub fn check_with_body(b: Block, want_value: Bool): Ty {
    n = b.body.size
    i = 0
    while i < n {
      st = b.body[i]
      if i == n - 1 && want_value && st.kind == st_expr() {
        if e = st.expr {
          scan_pending_expr(e)
          return check_expr(e)
        }
      }
      if st.kind == st_while() && i > 0 {
        annotate_vstep(b.body[i - 1], st)
      }
      self.clear_poison()
      self.facts.after_follows = true
      check_block_stmt(st, self.return_type, false)
      if self.has_err() {
        return t_void()
      }
      fact_after_stmt(st)
      i += 1
    }
    t_void()
  }

  // Whether a `return` or a postfix `?` appears in body (outside lambdas,
  // which return from themselves).
  pub fn leaves_by_return(body: Array(Stmt)): Bool {
    for st in body {
      if st.kind == st_return() {
        return true
      }
      if leaves_by_return(st.pre) || leaves_by_return(st.then_body) || leaves_by_return(st.else_body) || leaves_by_return(st.body) {
        return true
      }
      if e = st.expr, expr_has_try(e) {
        return true
      }
      if e2 = st.value, expr_has_try(e2) {
        return true
      }
      if e3 = st.cond, expr_has_try(e3) {
        return true
      }
    }
    false
  }

  pub fn expr_has_try(e: Expr): Bool {
    if e.kind == ex_try() || e.kind == ex_lambda() {
      return e.kind == ex_try()
    }
    if e.kind == ex_switch() && e.op == tk_return() {
      return leaves_by_return(e.else_body)
    }
    if x1 = e.left, expr_has_try(x1) {
      return true
    }
    if x2 = e.right, expr_has_try(x2) {
      return true
    }
    if x3 = e.object, expr_has_try(x3) {
      return true
    }
    if x4 = e.receiver, expr_has_try(x4) {
      return true
    }
    if x5 = e.inner, expr_has_try(x5) {
      return true
    }
    if x6 = e.cond, expr_has_try(x6) {
      return true
    }
    for el in e.elems {
      if expr_has_try(el) {
        return true
      }
    }
    for fe in e.field_exprs {
      if expr_has_try(fe) {
        return true
      }
    }
    for part in e.parts {
      if pe = part.expr, expr_has_try(pe) {
        return true
      }
    }
    for a in e.args {
      if expr_has_try(a) {
        return true
      }
    }
    for c in e.cases {
      if leaves_by_return(c.body) {
        return true
      }
    }
    if leaves_by_return(e.else_body) {
      return true
    }
    if b = e.block {
      return leaves_by_return(b.body)
    }
    false
  }

  pub fn is_mutex_ty(ty: Ty): Bool {
    is_sync_ty(ty, "Mutex")
  }

  pub fn is_sync_ty(ty: Ty, name: String): Bool {
    ty.is_class() && ty.mod_name == "std.sync" && (ty.origin == name || ty.name == name)
  }

  pub fn check_mutex_with(expr: Expr, object: Ty): Ty {
    if expr.args.size != 0 {
      fail(expr.loc, "sync.Mutex.with takes a block")
      return t_void()
    }
    if b = expr.block {
      if b.params.size != 1 {
        fail(b.loc, "sync.Mutex.with takes a lambda of one parameter: m.with (x) { ... }")
        return t_void()
      }
      if object.ty_args.size != 1 {
        fail(expr.loc, "Mutex needs one type argument")
        return t_void()
      }
      t = object.ty_args[0]
      if cell = object.field_named("cell") {
        if !cell.same_as(t) {
          fail(expr.loc, "Mutex cell has the wrong type")
          return t_void()
        }
      } else {
        fail(expr.loc, "Mutex needs a cell field")
        return t_void()
      }
      if gate = object.field_named("gate") {
        if !gate.is_uint64() {
          fail(expr.loc, "Mutex needs a gate field")
          return t_void()
        }
      } else {
        fail(expr.loc, "Mutex needs a gate field")
        return t_void()
      }
      dropped = self.with_drop == expr.loc.show()
      self.with_drop = ""
      if self.try_in.size > 0 && self.try_in != "a lambda whose result type is inferred" && self.try_in != "a spawn block" && self.try_in != "a parallel block" && self.inline_what.size == 0 && !b.paren {
        // `return` and `?` leave a `with` as they leave the code around
        // it, which here cannot return (a spawn or parallel block, a
        // field default): refused there as before.
        if leaves_by_return(b.body) {
          fail(b.loc, "return or ? inside sync.Mutex.with inside ${self.try_in}: ${self.try_in} cannot return")
          return t_void()
        }
      }
      refuse_block_param_outer(b, expr.callee)
      self.push_scope()
      bind(b.params[0], t)
      // `return`, `break`, `continue` and `?` leave the block as they
      // leave any block, and the lowering releases the lock on every way
      // out (mir/lower_task.av lower_mutex_with), as a `gc.hold` ends.
      // Used as a statement, the block ends without a value; used as a
      // value, its last expression is the value.
      result = t_void()
      if b.paren {
        res = t_void()
        if !dropped {
          res = inline_result(b)
        }
        s = inline_enter(b, expr.callee, res)
        result = check_with_body(b, !dropped)
        inline_leave(s)
        if !dropped && !res.is_var() && !self.has_err() {
          if !ty_assignable(result, res) {
            fail(b.body[b.body.size - 1].loc, "the lambda's result is ${res.show()}, its last expression ${result.show()}")
          }
          result = res
        }
      } else {
        result = check_with_body(b, !dropped)
      }
      self.pop_scope()
      // The block's value leaves the lock: it may not be, or hold, a
      // reference to mutable state (two tasks raced on a class handed out
      // this way and lost updates).
      if !self.has_err() && !result.is_void() && !leaves_mutex_with(result) && !with_value_leaves(b) {
        fail(b.body[b.body.size - 1].loc, "sync.Mutex.with's value cannot be ${result.show()}: it may be the guarded value or a part of it, which the lock no longer protects outside the block; end the block with a plain value (a number, a Bool, a String, Bytes, a struct or an optional of those, a Channel or a Mutex), a clone (x.clone()) or a new object built from those (a constructor call or a literal)")
      }
      // Nor may a statement hand the guarded value out
      // (checker/guard.av).
      guard_with_block(b.params[0], b, !dropped)
      return result
    }
    fail(expr.loc, "sync.Mutex.with needs a block")
    t_void()
  }

  pub fn check_gate_call(expr: Expr): Ty? {
    if !is_gate_name(expr.callee) {
      return nil
    }
    // The gates are std.sync's: a name of `std` modules only, not of
    // a program's.
    if str_slice(self.current_module, 0, 4) != "std." {
      fail(expr.loc, "${expr.callee} is internal to the standard library: use sync.Channel(T) and sync.Mutex(T) from std.sync (import std.sync)")
      return t_void()
    }
    if expr.callee == "avant_gate_new" {
      if expr.args.size == 0 {
        if b = expr.block {
          fail(expr.loc, "avant_gate_new takes no arguments")
          return t_uint64()
        }
        return t_uint64()
      }
      fail(expr.loc, "avant_gate_new takes no arguments")
      return t_uint64()
    }
    is_gate = false
    if expr.callee == "avant_gate_lock" {
      is_gate = true
    }
    if expr.callee == "avant_gate_unlock" {
      is_gate = true
    }
    if expr.callee == "avant_gate_wait" {
      is_gate = true
    }
    if expr.callee == "avant_gate_signal" {
      is_gate = true
    }
    if expr.callee == "avant_gate_broadcast" {
      is_gate = true
    }
    if expr.callee == "avant_gate_poisoned" {
      is_gate = true
    }
    if expr.callee == "avant_gate_clear_poison" {
      is_gate = true
    }
    if is_gate {
      if expr.args.size == 1 {
        if b = expr.block {
          fail(expr.loc, "${expr.callee} takes one UInt64")
          return t_void()
        }
      } else {
        fail(expr.loc, "${expr.callee} takes one UInt64")
        return t_void()
      }
      got = check_expr_as(expr.args[0], t_uint64())
      if !got.is_uint64() {
        fail(expr.args[0].loc, "${expr.callee} expects UInt64")
        return t_void()
      }
      // The gate is a word in its object: the call takes the field, whose
      // address the lowering passes.
      a = expr.args[0]
      if !(a.kind == ex_field() || (a.kind == ex_name() && a.implicit_field)) {
        fail(a.loc, "${expr.callee} takes the object's gate field (a UInt64 field holding avant_gate_new())")
      }
      if expr.callee == "avant_gate_poisoned" {
        return t_bool()
      }
      return t_void()
    }
    nil
  }

  pub fn is_gate_name(name: String): Bool {
    name == "avant_gate_new" || name == "avant_gate_lock" || name == "avant_gate_unlock" || name == "avant_gate_wait" || name == "avant_gate_signal" || name == "avant_gate_broadcast" || name == "avant_gate_poisoned" || name == "avant_gate_clear_poison"
  }

  pub fn check_join(expr: Expr, handle: Ty): Ty {
    if expr.callee != "join" {
      fail_hint(expr.loc, "no method ${expr.callee} on JoinHandle", builtin_hint(handle, expr.callee))
      if inner = handle.inner {
        return inner
      }
      return t_int()
    }
    if expr.args.size == 0 {
      if b = expr.block {
        fail(expr.loc, "join takes no arguments")
      }
    } else {
      fail(expr.loc, "join takes no arguments")
    }
    if inner = handle.inner {
      return join_result(inner)
    }
    join_result(t_int())
  }

  // What `h.join` gives: the block's value,
  // or the TaskError of the trap that ended the task (the task module's
  // class, prelude_src.av; a program that spawns has it).
  pub fn join_result(inner: Ty): Ty {
    if te = self.resolver.get_named_in("task", "TaskError") {
      parts: Array(Ty) = []
      parts.push(inner)
      parts.push(te)
      return ty_union_build(parts)
    }
    inner
  }

  // Where an arm's value is: its last statement (the branch a message
  // about the value's type points at), else at.
  pub fn arm_value_loc(body: Array(Stmt), at: Location): Location {
    if body.size == 0 {
      return at
    }
    last = body[body.size - 1]
    if e = last.expr {
      return e.loc
    }
    last.loc
  }

  pub fn check_switch_branch(body: Array(Stmt), has_want: Bool, want: Ty): Ty {
    check_switch_branch_bound(body, has_want, want, "", t_void())
  }

  // A value switch's arm, with the name its label binds in scope for
  // the arm only.
  pub fn check_switch_branch_bound(body: Array(Stmt), has_want: Bool, want: Ty, name: String, bty: Ty): Ty {
    self.push_scope()
    if name.size > 0 {
      bind(name, bty)
    }
    if body.size == 0 {
      self.pop_scope()
      return t_void()
    }
    i = 0
    while i < body.size {
      stmt = body[i]
      if i == body.size - 1 {
        if stmt.kind == st_expr() && !ast_stmt_exits(stmt) {
          if e = stmt.expr {
            use_want = false
            use_ty = t_int()
            if has_want && !want.is_void() {
              use_want = true
              use_ty = want
            }
            scan_pending_expr(e)
            ty = check_expr_flag(e, use_want, use_ty)
            self.pop_scope()
            return ty
          }
        }
        check_block_stmt(stmt, self.return_type, false)
        self.pop_scope()
        return t_void()
      }
      check_block_stmt(stmt, self.return_type, false)
      i += 1
    }
    self.pop_scope()
    t_void()
  }

  // An `if` used as a value: the condition (a list, bindings in scope
  // for the then-block), then each branch's value; the branches' types
  // join as a value switch's do. nil when every branch leaves (return,
  // break, continue, exit, panic).
  pub fn check_if_value(stmt: Stmt, has_want: Bool, want: Ty): Ty? {
    void_ok = self.if_void_ok
    self.if_void_ok = false
    self.push_scope()
    for el in stmt.pre {
      check_cond_element(el)
    }
    check_cond_element(stmt)
    t1 = check_value_branch(stmt.then_body, has_want, want)
    self.pop_scope()
    t2: Ty? = nil
    if stmt.else_bind.size > 0 {
      if fty = check_else_bind(stmt) {
        self.push_scope()
        bind(stmt.else_bind, fty)
        t2 = check_value_branch(stmt.else_body, has_want, want)
        self.pop_scope()
      }
    } else {
      t2 = check_value_branch(stmt.else_body, has_want, want)
    }
    if self.has_err() {
      return t_int()
    }
    tys: Array(Ty) = []
    if a = t1 {
      tys.push(a)
    }
    if b = t2 {
      tys.push(b)
    }
    if tys.size == 0 {
      return nil
    }
    if void_ok {
      all_void = true
      for tv in tys {
        if !tv.is_void() {
          all_void = false
        }
      }
      if all_void {
        return t_void()
      }
    }
    for t in tys {
      if t.is_void() {
        fail(stmt.loc, "an if used as a value needs a value at the end of each branch")
        return t_int()
      }
    }
    if has_want && !want.is_void() {
      for t2b in tys {
        if !ty_assignable(t2b, want) {
          fail(stmt.loc, "if branch is ${t2b.show()}, expected ${want.show()}")
        }
      }
      return want
    }
    if joined = nil_join(tys) {
      return joined
    }
    result = tys[0]
    for t3 in tys {
      if !t3.same_as(result) {
        fail(stmt.loc, "if branches have different types ${result.show()} and ${t3.show()}")
      }
    }
    result
  }

  // Branches where some give nil and the others one type T (or T?), with
  // no declared type to take: together they are T?, as a declared T?
  // would make them. nil when the branches are not of that shape.
  pub fn nil_join(tys: Array(Ty)): Ty? {
    has_nil = false
    other: Ty? = nil
    for t in tys {
      if t.is_nil() {
        has_nil = true
      } else {
        inner = t
        if t.is_nilable() {
          inner = ty_without_nil(t)
        } else if t.is_union() {
          return nil
        }
        if o = other {
          if !o.same_as(inner) {
            return nil
          }
        } else {
          other = inner
        }
      }
    }
    if has_nil {
      if o2 = other {
        return ty_nilable(o2)
      }
    }
    nil
  }

  // A branch of an `if` used as a value: its last expression is the value
  // (a last `if` with an else gives its own); nil when it leaves.
  pub fn check_value_branch(body: Array(Stmt), has_want: Bool, want: Ty): Ty? {
    self.push_scope()
    result: Ty? = t_void()
    i = 0
    while i < body.size {
      st = body[i]
      if i == body.size - 1 {
        k = st.kind
        if k == st_expr() && !ast_stmt_exits(st) {
          if e = st.expr {
            use_want = false
            use_ty = t_int()
            if has_want && !want.is_void() {
              use_want = true
              use_ty = want
            }
            scan_pending_expr(e)
            result = check_expr_flag(e, use_want, use_ty)
          }
        } else if k == st_if() && st.else_body.size > 0 {
          scan_pending_if_head(st)
          result = check_if_value(st, has_want, want)
        } else {
          check_block_stmt(st, self.return_type, false)
          if k == st_return() || k == st_break() || k == st_continue() || ast_stmt_exits(st) {
            result = nil
          }
        }
      } else {
        check_block_stmt(st, self.return_type, false)
      }
      i += 1
    }
    self.pop_scope()
    result
  }
}

// Whether a C layout has a field that holds a reference (a `String`,
// directly or in a nested layout): what `release` gives back.
pub fn clayout_holds_ref(t: Ty): Bool {
  for field in t.fields {
    ft = field.ty
    if ft.is_string() {
      return true
    }
    if r = ty_opt_ref(ft), r.is_string() {
      return true
    }
    if ft.is_clayout() && clayout_holds_ref(ft) {
      return true
    }
  }
  false
}

// Whether a block's last statement leaves it (return, break, continue,
// exit).
pub fn arm_leaves(body: Array(Stmt)): Bool {
  if body.size == 0 {
    return false
  }
  k = body[body.size - 1].kind
  k == st_return() || k == st_break() || k == st_continue() || ast_stmt_exits(body[body.size - 1])
}

pub fn lead_spelling(lead: Int): String {
  if lead == tk_minus() {
    return "-"
  }
  "["
}
