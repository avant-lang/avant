    if value = stmt.value {
      if self.expr_is_place(value) {
      } else {
        return false
      }
    } else {
      return false
    }
    if target = stmt.target {
      if target.kind == ex_name() {
        if str_eq(target.ident, self.place_name) {
          return false
        }
      }
      if target.kind == ex_field() {
        if obj = target.object {
          if obj.kind == ex_name() {
            if str_eq(obj.ident, self.place_name) {
              return false
            }
          }
        }
      }
    }
    self.fail(stmt.loc, "mutex place cannot escape")
    true
  }

