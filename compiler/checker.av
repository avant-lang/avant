import location
import diagnostic
import source
import token
import lexer
import type
import ast
import resolve
import parser
import loader
import typed_ir
import checker.names

pub class Scope {
  names: Hash(String, Int)

  fn initialize {
    n = Hash(String, Int).new
    self.names = n
  }
}

// The flow facts the checker proves inside one function body (bounds,
// non-nil, capacity, positivity; checker/facts.av), reset per function.
// Their own object, not Checker's payload: while the v0.34.0 seed builds B,
// its type maps lose every reference word past payload word 63 (audit
// 8.4, fixed by W1b in the tree only), so no compiler class may have a
// reference field there (D188; test_fixed_point checks it). Relax after a
// re-seed (D178).
pub class FlowFacts {
  pub fact_var: Array(String)
  pub fact_cont: Array(String)
  pub fact_slack: Array(Int)
  pub fact_live: Array(Int)
  pub sv_var: Array(String)
  pub sv_cont: Array(String)
  pub bv_var: Array(String)
  pub bv_cont: Array(String)
  pub bv_delta: Array(Int)
  pub cs_cont: Array(String)
  pub cs_var: Array(String)
  pub cs_delta: Array(Int)
  pub nn_var: Array(String)
  pub cap_var: Array(String)
  pub cap_val: Array(Int64)
  pub gcap_var: Array(String)
  pub gcap_val: Array(Int64)
  pub gcap_live: Array(Int)
  pub gnn_var: Array(String)
  pub gnn_live: Array(Int)
  pub gpos_var: Array(String)
  pub gpos_live: Array(Int)
  pub gne_var: Array(String)
  pub gne_live: Array(Int)

  fn initialize {
    self.fact_var = []
    self.fact_cont = []
    self.fact_slack = []
    self.fact_live = []
    self.sv_var = []
    self.sv_cont = []
    self.bv_var = []
    self.bv_cont = []
    self.bv_delta = []
    self.cs_cont = []
    self.cs_var = []
    self.cs_delta = []
    self.nn_var = []
    self.cap_var = []
    self.cap_val = []
    self.gcap_var = []
    self.gcap_val = []
    self.gcap_live = []
    self.gnn_var = []
    self.gnn_live = []
    self.gpos_var = []
    self.gpos_live = []
    self.gne_var = []
    self.gne_live = []
  }
}

pub class Checker {
  source: Source
  pub program: Program
  pub resolver: TypeResolver
  pub functions: Array(FuncSig)
  pub fn_index: Hash(String, Int)
  pub methods: Array(FuncSig)
  pub method_index: Hash(String, Int)
  // Every index of functions (from 1) and of methods by name, ascending
  // (Stage 28 W18P): the scans that look for a name visit only these.
  // (a name's list is lists[k], k its entry in the Hash).
  pub fns_named: Hash(String, Int)
  pub methods_named: Hash(String, Int)
  pub fn_lists: Array(Array(Int))
  pub method_lists: Array(Array(Int))
  pub none_named: Array(Int)
  pub cfuns: Array(CFunSig)
  pub cfun_index: Hash(String, Int)
  pub lib_names: Hash(String, Int)
  pub c_symbols: Hash(String, String)
  pub reserved: Hash(String, Int)
  pub scopes: Array(Scope)
  failed: Bool = false
  pub err: CompileError? = nil
  pub errors: DiagBag
  resolver_pulled: Int = 0
  // How much of the resolver's bag the checker has seen (O163): its pushes,
  // its hidden errors, and its kept items as of the last pull.
  resolver_pushes: Int = 0
  resolver_hidden: Int = 0
  resolver_kept: Int = 0
  poisoned: Bool = false
  pub return_type: Ty
  pub loop_depth: Int = 0
  pub self_ty: Ty? = nil
  pub self_name: String = ""
  pub pending: Array(Function)
  pub instances: Array(Function)
  next_ol: Int = 1
  pub current_module: String = ""
  pub call_mod: String = ""
  pub root_module: String = ""
  pub type_mod: Hash(String, String)
  pub type_vis: Hash(String, Int)
  pub type_list: Hash(String, String)
  pub type_multi: Hash(String, Int)
  pub lib_mod: Hash(String, String)
  pub lib_vis: Hash(String, Int)
  pub known_mods: Hash(String, Int)
  pub current_fn: Function? = nil
  pub lam_exprs: Array(Expr)
  pub lam_scopes: Array(Int)
  pub lambda_infer: Bool = false
  pub inferred_ret: Ty
  pub spawn_skip: Array(String)
  pub pending_handles: Array(String)
  pub pending_arrays: Array(String)
  pub facts: FlowFacts
  pub adopted: Hash(String, Int)
  pub adopt_pending: Bool = false
  pub ready_adopt: Bool = false
  pub in_adopt: Bool = false
  pub in_task: Int = 0
  // Where a postfix `?` stands when it cannot return from the body around it
  // ("a spawn block"); empty in a function or lambda body (Stage 29 W1a, A3).
  pub try_in: String = ""
  // Stage 29 W3b: checking a field default (evaluated before initialize,
  // with no receiver).
  pub in_default: Bool = false
  // What a postfix `?` returns from, for its messages.
  pub try_body: String = "the function"
  pub place_name: String = ""
  pub place_depth: Int = 0
  pub witness_note: String = ""
  pub impls: Array(ImplFact)
  pub sig_params: Array(Ty)
  pub sig_ret: Ty
  pub sig_vars: Array(String)
  pub wit_params: Array(Ty)
  pub wit_ret: Ty
  pub wit_vars: Array(String)

  fn initialize(source: Source, program: Program) {
    self.source = source
    self.program = program
    self.resolver = TypeResolver.new
    fns: Array(FuncSig) = []
    dummy_fn = Function.new(program.loc, "")
    dummy_params: Array(Ty) = []
    fns.push(FuncSig.new("", dummy_fn, dummy_params, ty_void()))
    self.functions = fns
    fi = Hash(String, Int).new
    self.fn_index = fi
    self.methods = []
    mi = Hash(String, Int).new
    self.method_index = mi
    self.fns_named = Hash(String, Int).new
    self.methods_named = Hash(String, Int).new
    self.fn_lists = []
    self.method_lists = []
    self.none_named = []
    self.cfuns = []
    cfi = Hash(String, Int).new
    self.cfun_index = cfi
    ln = Hash(String, Int).new
    self.lib_names = ln
    cs = Hash(String, String).new
    self.c_symbols = cs
    self.reserved = reserved_c_names()
    self.scopes = []
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new
    self.resolver_pulled = 0
    self.resolver_pushes = 0
    self.resolver_hidden = 0
    self.resolver_kept = 0
    self.poisoned = false
    self.return_type = ty_void()
    self.loop_depth = 0
    self.self_name = ""
    self.pending = []
    self.instances = []
    self.next_ol = 1
    self.current_module = ""
    self.root_module = ""
    tm = Hash(String, String).new
    self.type_mod = tm
    tv = Hash(String, Int).new
    self.type_vis = tv
    tl = Hash(String, String).new
    self.type_list = tl
    tmu = Hash(String, Int).new
    self.type_multi = tmu
    lm = Hash(String, String).new
    self.lib_mod = lm
    lv = Hash(String, Int).new
    self.lib_vis = lv
    km = Hash(String, Int).new
    self.known_mods = km
    self.lam_exprs = []
    self.lam_scopes = []
    self.lambda_infer = false
    self.inferred_ret = ty_void()
    self.spawn_skip = []
    self.pending_handles = []
    self.pending_arrays = []
    self.facts = FlowFacts.new
    ad = Hash(String, Int).new
    self.adopted = ad
    self.adopt_pending = false
    self.ready_adopt = false
    self.in_adopt = false
    self.in_task = 0
    self.place_name = ""
    self.place_depth = 0
    self.impls = []
    self.sig_params = []
    self.sig_ret = ty_void()
    self.sig_vars = []
    self.wit_params = []
    self.wit_ret = ty_void()
    self.wit_vars = []
  }

  pub fn has_err: Bool {
    self.poisoned
  }

  pub fn any_err: Bool {
    self.failed
  }

  // Every error counts, kept or not (O163, Stage 29 W1a): see Resolver.
  pub fn err_count: Int {
    self.errors.pushes
  }

  pub fn new_err_since(mark: Int): Bool {
    self.errors.pushes > mark
  }

  pub fn clear_poison {
    self.poisoned = false
  }

  pub fn fail(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(4, message), message)
    if self.errors.count == 0 {
      self.err = e
    }
    self.failed = true
    self.poisoned = true
    self.errors.push(e)
  }

  pub fn pull_resolve {
    while self.resolver_pulled < self.resolver.errors.count {
      re = self.resolver.errors.items[self.resolver_pulled]
      if self.errors.count == 0 {
        self.err = re
      }
      self.failed = true
      self.poisoned = true
      self.errors.push(re)
      self.resolver_pulled += 1
    }
    if self.resolver_pushes < self.resolver.errors.pushes {
      // The resolver's errors it did not keep (O163): repeats and those
      // past its cap are errors here too, and the ones past the cap count
      // in "and N more errors".
      hidden = self.resolver.errors.suppressed - self.resolver_hidden
      kept = self.resolver_pulled - self.resolver_kept
      repeats = self.resolver.errors.pushes - self.resolver_pushes - hidden - kept
      self.errors.note(hidden, true)
      self.errors.note(repeats, false)
      self.failed = true
      self.poisoned = true
      self.resolver_hidden = self.resolver.errors.suppressed
      self.resolver_pushes = self.resolver.errors.pushes
    }
    self.resolver_kept = self.resolver_pulled
    if self.ready_adopt && !self.in_adopt {
      saved: Array(String) = []
      for tparam_name in self.resolver.tparam_names {
        saved.push(tparam_name)
      }
      self.resolver.clear_tparams
      self.adopt_new_types
      self.resolver.set_tparams(saved)
    }
  }

  pub fn intern(ty: Ty): Int {
    self.resolver.intern(ty)
  }

  pub fn push_scope {
    self.scopes.push(Scope.new)
  }

  pub fn pop_scope {
    dummy = self.scopes.pop
  }

  pub fn bind(name: String, ty: Ty) {
    id = self.intern(ty)
    last = self.scopes[self.scopes.size - 1]
    last.names[name] = id
  }

  pub fn lookup(name: String): Ty? {
    i = self.scopes.size - 1
    while i >= 0 {
      sc = self.scopes[i]
      if id = sc.names.get(name) {
        return self.resolver.ty_at(id)
      }
      i -= 1
    }
    nil
  }

  pub fn lookup_index(name: String): Int {
    i = self.scopes.size - 1
    while i >= 0 {
      sc = self.scopes[i]
      if id = sc.names.get(name) {
        return i
      }
      i -= 1
    }
    -1
  }

  pub fn alloc_ol(fnn: Function) {
    fnn.ol_index = self.next_ol
    self.next_ol += 1
  }

  pub fn t_int: Ty { self.resolver.t_int }
  pub fn t_int64: Ty { self.resolver.t_int64 }
  pub fn t_uint64: Ty { self.resolver.t_uint64 }
  pub fn t_bool: Ty { self.resolver.t_bool }
  pub fn t_float: Ty { self.resolver.t_float }
  pub fn t_string: Ty { self.resolver.t_string }
  pub fn t_void: Ty { self.resolver.t_void }
  pub fn t_nil: Ty { self.resolver.t_nil }
  pub fn t_buf: Ty { self.resolver.t_buf }
  pub fn t_bytes: Ty { self.resolver.t_bytes }

  pub fn is_ordered_ty(ty: Ty): Bool {
    if ty.is_int {
      return true
    }
    if ty.is_int64 {
      return true
    }
    if ty.is_uint64 {
      return true
    }
    if ty.is_float {
      return true
    }
    if ty.is_string {
      return true
    }
    if ty.is_bool {
      return true
    }
    ty.is_bytes
  }

  pub fn is_numeric_ty(ty: Ty): Bool {
    if ty.is_int {
      return true
    }
    if ty.is_int64 {
      return true
    }
    if ty.is_uint64 {
      return true
    }
    ty.is_float
  }

  pub fn is_eq_ty(ty: Ty): Bool {
    if self.is_ordered_ty(ty) {
      return true
    }
    if ty.is_class {
      return true
    }
    if ty.is_array {
      return true
    }
    if ty.is_hash {
      return true
    }
    if ty.is_buf {
      return true
    }
    ty.is_bytes
  }

  pub fn check_function(fnn: Function) {
    self.clear_poison
    saved_mod = self.current_module
    self.current_module = fnn.mod_name
    ret = self.t_void()
    params: Array(Ty) = []
    if sig = self.find_sig_by_node(fnn) {
      ret = sig.ret
      params = sig.params
    } else {
      self.fail(fnn.loc, "unknown function ${fnn.name}")
      self.current_module = saved_mod
      return
    }
    self.return_type = ret
    self.pending_handles = []
    self.pending_arrays = []
    self.facts = FlowFacts.new
    if !ret.is_void && fnn.body.size == 0 {
      self.fail(fnn.loc, "missing return value")
      self.current_module = saved_mod
      return
    }
    self.self_ty = nil
    self.self_name = ""
    self.push_scope
    if fn_is_method(fnn) && !fnn.type_method {
      got_owner = false
      owner = self.t_int()
      if fnn.owner_mod.size > 0 {
        if o = self.resolver.get_named_in(fnn.owner_mod, fnn.owner) {
          owner = o
          got_owner = true
        }
      }
      if !got_owner {
        if o2 = self.resolver.get_named(fnn.owner) {
          owner = o2
          got_owner = true
        }
      }
      if got_owner {
        self.self_ty = owner
        self.self_name = fn_self_name(fnn)
        if existing = self.lookup(self.self_name) {
          self.fail(fnn.loc, "duplicate parameter ${self.self_name}")
          self.pop_scope
          self.current_module = saved_mod
          return
        }
        self.bind(self.self_name, owner)
      } else {
        if recv = fnn.receiver {
          ty = self.resolve_in_module(recv.type)
          self.pull_resolve
          if self.ptr_method_ok(ty) || ty.is_bytes || ty.is_string || ty.is_buf {
            self.self_name = recv.name
            if existing = self.lookup(self.self_name) {
              self.fail(fnn.loc, "duplicate parameter ${self.self_name}")
              self.pop_scope
              self.current_module = saved_mod
              return
            }
            self.bind(self.self_name, ty)
          }
        }
      }
    }
    i = 0
    while i < fnn.params.size {
      param = fnn.params[i]
      if existing = self.lookup(param.name) {
        self.fail(param.loc, "duplicate parameter ${param.name}")
        self.pop_scope
        self.current_module = saved_mod
        return
      }
      self.bind(param.name, params[i])
      if default = param.default {
        saved = self.self_ty
        self.self_ty = nil
        got = self.check_expr_as(default, params[i])
        self.self_ty = saved
        if !ty_assignable(got, params[i]) {
          self.fail(default.loc, "cannot assign ${got.show} to ${params[i].show}")
          self.pop_scope
          self.current_module = saved_mod
          return
        }
      }
      i += 1
    }
    self.current_fn = fnn
    self.check_body(fnn.body, ret, true)
    self.current_fn = nil
    self.pop_scope
    self.self_ty = nil
    self.self_name = ""
    self.current_module = saved_mod
  }

  pub fn check_body(body: Array(Stmt), expected: Ty, at_tail: Bool) {
    i = 0
    while i < body.size {
      last = false
      if at_tail && i == body.size - 1 {
        last = true
      }
      if body[i].kind == st_while() && i > 0 {
        self.annotate_vstep(body[i - 1], body[i])
      }
      self.clear_poison
      self.scan_pending_stmt(body[i])
      self.check_stmt(body[i], expected, last)
      if !self.has_err {
        self.register_spawn_pending(body[i])
        self.fact_after_stmt(body[i])
      }
      i += 1
    }
  }

  pub fn check_block(body: Array(Stmt), expected: Ty, at_tail: Bool) {
    self.push_scope
    self.check_body(body, expected, at_tail)
    self.pop_scope
  }

  pub fn fallthrough(body: Array(Stmt)): Bool {
    if body.size == 0 {
      return true
    }
    last = body[body.size - 1]
    if last.kind == st_return() {
      return false
    }
    if last.kind == st_hold() || last.kind == st_pin() {
      // A `gc.hold` or `pin(x)` block ends its function when its own
      // body does (Stage 29 W1c2; before, a `pin` block whose body
      // returned was "missing return value" at a function's tail).
      return self.fallthrough(last.body)
    }
    if last.kind == st_if() {
      if last.else_body.size == 0 {
        return true
      }
      if self.fallthrough(last.then_body) {
        return true
      }
      if self.fallthrough(last.else_body) {
        return true
      }
      return false
    }
    true
  }

  pub fn check_stmt(stmt: Stmt, expected: Ty, at_tail: Bool) {
    if self.has_err {
      return
    }
    k = stmt.kind
    if k == st_return() {
      if self.place_depth > 0 {
        self.fail(stmt.loc, "return inside Mutex.with")
        return
      }
      if self.lambda_infer {
        if expr = stmt.expr {
          self.inferred_ret = self.check_expr(expr)
        } else {
          self.inferred_ret = self.t_void()
        }
        return
      }
      if expr = stmt.expr {
        got = self.check_expr_as(expr, expected)
        if self.reject_clayout_value(got, expr.loc) {
          return
        }
        if !ty_assignable(got, expected) {
          self.fail(stmt.loc, "return type is ${got.show}, expected ${expected.show}")
        }
      } else {
        if !expected.is_void {
          self.fail(stmt.loc, "return needs a value of type ${expected.show}")
        }
      }
      return
    }
    if k == st_if() {
      if stmt.bind.size > 0 {
        self.check_if_assign(stmt, expected, at_tail)
        return
      }
      saved_facts = self.facts.fact_var.size
      if cond = stmt.cond {
        self.push_loop_facts(cond, stmt.then_body)
      }
      if cond = stmt.cond {
        ct = self.check_expr(cond)
        if !ct.is_bool {
          self.fail(cond.loc, "if condition must be Bool, got ${ct.show}")
        }
      }
      saved_gcap = self.facts.gcap_var.size
      saved_gnn = self.facts.gnn_var.size
      saved_gpos = self.facts.gpos_var.size
      saved_gne = self.facts.gne_var.size
      if cond = stmt.cond {
        self.push_loop_facts(cond, stmt.then_body)
        self.push_guard_facts(cond)
        for fi in saved_facts..self.facts.fact_var.size {
          if self.body_shrinks(stmt.then_body, self.facts.fact_cont[fi]) {
            self.facts.fact_live[fi] = 0
          }
        }
      }
      self.check_block(stmt.then_body, expected, false)
      self.cap_kill_assigned_in(stmt.then_body)
      self.pop_guard_facts(saved_gcap, saved_gnn, saved_gpos, saved_gne)
      self.pop_loop_facts(saved_facts)
      if stmt.else_body.size > 0 {
        self.check_block(stmt.else_body, expected, false)
        self.cap_kill_assigned_in(stmt.else_body)
      }
      if at_tail && !expected.is_void {
        ok = false
        if stmt.else_body.size > 0 && !self.fallthrough(stmt.then_body) && !self.fallthrough(stmt.else_body) {
          ok = true
        }
        if !ok {
          self.fail(stmt.loc, "missing return value")
        }
      }
      return
    }
    if k == st_release() {
      if e = stmt.expr {
        et = self.check_expr(e)
        if !self.has_err {
          self.check_release(e, et)
        }
      }
      if at_tail && !expected.is_void {
        self.fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_hold() {
      self.check_hold(stmt)
      self.check_block(stmt.body, expected, false)
      if at_tail && !(expected.is_void || !self.fallthrough(stmt.body)) {
        self.fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_pin() {
      if e = stmt.expr {
        et = self.check_expr(e)
        heap = et.is_string || et.is_bytes || et.is_buf || et.is_array || et.is_hash || et.is_class || et.is_fn || et.is_join
        if !heap {
          self.fail(e.loc, "pin needs a heap value, got ${et.show}")
        }
      }
      self.check_block(stmt.body, expected, false)
      if at_tail && !(expected.is_void || !self.fallthrough(stmt.body)) {
        self.fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_while() {
      has_pre = stmt.pre.size > 0
      if has_pre {
        self.push_scope
        pi = 0
        while pi < stmt.pre.size {
          self.annotate_vstep(stmt.pre[pi], stmt)
          self.clear_poison
          self.check_stmt(stmt.pre[pi], self.t_void(), false)
          if !self.has_err {
            self.fact_after_stmt(stmt.pre[pi])
          }
          pi += 1
        }
        if stmt.for_kind == 1 {
          if pt = stmt.pre[0].target {
            if pty = self.lookup(pt.ident) {
              if !pty.is_int {
                self.fail(stmt.loc, "for range bounds must be Int, got ${pty.show}")
              }
            }
          }
          if stmt.pre.size > 1 {
            if pt2 = stmt.pre[1].target {
              if pty2 = self.lookup(pt2.ident) {
                if !pty2.is_int {
                  self.fail(stmt.loc, "for range bounds must be Int, got ${pty2.show}")
                }
              }
            }
          }
        }
        if stmt.for_kind == 2 {
          if pt = stmt.pre[0].target {
            if pty = self.lookup(pt.ident) {
              if !pty.is_array {
                self.fail(stmt.loc, "for needs a range (a..b) or an Array, got ${pty.show}")
              }
            }
          }
        }
      }
      saved_facts = self.facts.fact_var.size
      if cond = stmt.cond {
        self.push_loop_facts(cond, stmt.body)
      }
      if cond = stmt.cond {
        ct = self.check_expr(cond)
        if !ct.is_bool {
          self.fail(cond.loc, "while condition must be Bool, got ${ct.show}")
        }
      }
      saved_gcap = self.facts.gcap_var.size
      saved_gnn = self.facts.gnn_var.size
      saved_gpos = self.facts.gpos_var.size
      saved_gne = self.facts.gne_var.size
      if cond = stmt.cond {
        self.push_guard_facts(cond)
      }
      self.cap_kill_assigned_in(stmt.body)
      self.loop_depth += 1
      self.check_block(stmt.body, expected, false)
      self.loop_depth -= 1
      self.cap_kill_assigned_in(stmt.body)
      self.pop_guard_facts(saved_gcap, saved_gnn, saved_gpos, saved_gne)
      self.pop_loop_facts(saved_facts)
      if at_tail && !expected.is_void {
        self.fail(stmt.loc, "missing return value")
      }
      if has_pre {
        self.pop_scope
      }
      return
    }
    if k == st_break() {
      if self.loop_depth == 0 {
        if self.place_depth > 0 {
          self.fail(stmt.loc, "break inside Mutex.with")
        } else {
          self.fail(stmt.loc, "break is only valid inside a loop")
        }
      }
      if at_tail && !expected.is_void {
        self.fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_continue() {
      if self.loop_depth == 0 {
        if self.place_depth > 0 {
          self.fail(stmt.loc, "continue inside Mutex.with")
        } else {
          self.fail(stmt.loc, "continue is only valid inside a loop")
        }
      }
      if at_tail && !expected.is_void {
        self.fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_assign() {
      self.check_assign(stmt)
      if at_tail && !expected.is_void {
        self.fail(stmt.loc, "missing return value")
      }
      return
    }
    if k == st_expr() {
      if expr = stmt.expr {
        if at_tail {
          if expr.kind == ex_lambda() && !expected.is_void {
            got = self.check_expr_as(expr, expected)
            return
          }
          if self.lambda_infer {
            self.inferred_ret = self.check_expr(expr)
            return
          }
        }
        got = self.check_expr(expr)
        if at_tail {
          if expected.is_void {
            if !got.is_void {
              if stmt.lead != 0 {
                self.fail(stmt.loc, "unused ${got.show} value at the end of a void function: a line starting with `-` or `[` begins a new statement; to continue the line before, end it with the operator or an open bracket")
              } else {
                self.fail(stmt.loc, "unused ${got.show} value at the end of a void function")
              }
            }
          } else {
            if !ty_assignable(got, expected) {
              self.fail(stmt.loc, "last expression is ${got.show}, expected ${expected.show}")
            }
          }
        }
      }
      return
    }
    self.fail(stmt.loc, "unknown statement")
  }

  pub fn check_if_assign(stmt: Stmt, expected: Ty, at_tail: Bool) {
    if cond = stmt.cond {
      got = self.check_expr(cond)
      success = self.if_assign_success(got, cond.loc)
      self.push_scope
      self.bind(stmt.bind, success)
      self.check_body(stmt.then_body, expected, false)
      self.pop_scope
      if stmt.else_body.size > 0 {
        self.check_block(stmt.else_body, expected, false)
      }
      if at_tail && !expected.is_void {
        ok = false
        if stmt.else_body.size > 0 && !self.fallthrough(stmt.then_body) && !self.fallthrough(stmt.else_body) {
          ok = true
        }
        if !ok {
          self.fail(stmt.loc, "missing return value")
        }
      }
    }
  }

  pub fn if_assign_success(got: Ty, loc: Location): Ty {
    if got.is_union {
      if success = if_assign_payload(got) {
        return success
      }
      if got.includes_nil {
        self.fail(loc, "if-assign needs a single success type, got ${got.show}")
        return self.t_int()
      }
    }
    self.fail(loc, "if-assign expects T? or T | Error, got ${got.show}")
    self.t_int()
  }

  pub fn check_assign(stmt: Stmt) {
    if self.reject_place_assign(stmt) {
      return
    }
    if stmt.op != tk_eq() {
      self.check_compound_assign(stmt)
      return
    }
    if target = stmt.target {
      if value = stmt.value {
        if target.kind == ex_name() {
          if target.ident == "self" {
            self.fail(stmt.loc, "cannot assign to self")
            return
          }
          if declared = stmt.declared {
            want = self.resolve_in_module(declared)
            self.pull_resolve
            if self.reject_clayout_value(want, declared.loc) {
              return
            }
            if existing = self.lookup(target.ident) {
              self.fail(stmt.loc, "cannot shadow ${target.ident}")
              return
            }
            if field_ty = self.implicit_field(target.ident) {
              self.fail(stmt.loc, "cannot shadow ${target.ident}")
              return
            }
            early = false
            if value.kind == ex_lambda() {
              self.bind(target.ident, want)
              target.ty = want
              early = true
            }
            got = self.check_expr_as(value, want)
            if !ty_assignable(got, want) && !self.fn_compatible(got, want) {
              self.fail(value.loc, "cannot assign ${got.show} to ${want.show}")
            }
            if !early {
              self.bind(target.ident, want)
              target.ty = want
            }
            return
          }
          if existing = self.lookup(target.ident) {
            self.note_capture(target.ident, existing)
            got = self.check_expr_as(value, existing)
            if !ty_assignable(got, existing) {
              self.fail(value.loc, "cannot assign ${got.show} to ${existing.show}")
            }
            target.ty = existing
            return
          }
          if field_ty = self.implicit_field(target.ident) {
            // Stage 29 W3b (B6, D292): a field is written self.name = ...
            self.refuse_bare_field_write(target, stmt.loc)
            return
          }
          got = self.check_expr(value)
          if got.is_void {
            self.fail(stmt.loc, "cannot bind a Void value")
            return
          }
          if self.reject_clayout_value(got, value.loc) {
            return
          }
          self.bind(target.ident, got)
          target.ty = got
          return
        }
        if extra = stmt.declared {
          self.fail(stmt.loc, "type annotation only belongs on a new name")
          return
        }
        if target.kind == ex_index() {
          if arr = target.left {
            if ix = target.right {
              container = self.check_expr(arr)
              if container.is_hash {
                if k = container.key {
                  key = self.check_expr_as(ix, k)
                  if !ty_assignable(key, k) {
                    self.fail(ix.loc, "hash key must be ${k.show}, got ${key.show}")
                  }
                }
                if v = container.val {
                  got = self.check_expr_as(value, v)
                  if !ty_assignable(got, v) {
                    self.fail(value.loc, "cannot assign ${got.show} to ${v.show}")
                  }
                  target.ty = v
                  return
                }
              }
            }
          }
        }
        place = self.check_expr(target)
        if target.kind == ex_field() && target.method_call {
          self.fail(stmt.loc, "cannot assign to a method")
          return
        }
        if target.kind == ex_name() && target.implicit_field {
          self.refuse_bare_field_write(target, stmt.loc)
          return
        }
        if self.reject_clayout_value(place, target.loc) {
          return
        }
        got = self.check_expr_as(value, place)
        if !ty_assignable(got, place) {
          self.fail(value.loc, "cannot assign ${got.show} to ${place.show}")
        }
        return
      }
    }
    self.fail(stmt.loc, "cannot assign to this expression")
  }

  pub fn check_compound_assign(stmt: Stmt) {
    if declared = stmt.declared {
      self.fail(stmt.loc, "type annotation only belongs on a new name")
      return
    }
    if target = stmt.target {
      if value = stmt.value {
        if target.kind == ex_name() {
          if target.ident == "self" {
            self.fail(stmt.loc, "cannot assign to self")
            return
          }
        }
        place = self.check_expr(target)
        if target.kind == ex_field() && target.method_call {
          self.fail(stmt.loc, "cannot assign to a method")
          return
        }
        if target.kind == ex_name() && target.implicit_field {
          self.refuse_bare_field_write(target, stmt.loc)
          return
        }
        if self.reject_clayout_value(place, target.loc) {
          return
        }
        got = self.check_expr_as(value, place)
        if !got.same_as(place) {
          self.fail(value.loc, "cannot assign ${got.show} to ${place.show}")
        }
        if !place.is_numeric {
          self.fail(stmt.loc, "compound assignment expects a numeric target, got ${place.show}")
        }
        if target.kind == ex_name() {
          if value.kind == ex_int() {
            if stmt.op == tk_plus_eq() {
              s = self.fact_any_slack(target.ident)
              if s >= 0 && value.int_bits <= s.to_u64 + 1u64 {
                stmt.proven = true
              }
            }
            if stmt.op == tk_minus_eq() && (self.fact_any_slack(target.ident) >= 0 || self.nn_has(target.ident)) {
              stmt.proven = true
            }
          }
          if (stmt.op == tk_plus_eq() || stmt.op == tk_minus_eq() || stmt.op == tk_star_eq()) && self.compound_proven(stmt.op, target.ident, value, place) {
            stmt.proven = true
          }
          if stmt.op == tk_slash_eq() && self.divisor_proven(value) {
            stmt.proven = true
          }
        }
        return
      }
    }
  }

  pub fn check_expr(expr: Expr): Ty {
    self.check_expr_flag(expr, false, self.t_int())
  }

  pub fn check_expr_as(expr: Expr, want: Ty): Ty {
    self.check_expr_flag(expr, true, want)
  }

  pub fn check_expr_flag(expr: Expr, has_want: Bool, want: Ty): Ty {
    if self.has_err {
      return self.t_int()
    }
    mark = self.err_count
    kind = self.check_expr_core(expr, has_want, want)
    if self.new_err_since(mark) {
      expr.ty = kind
      return kind
    }
    if has_want && !type.ty_has_var(want) && !ty_assignable(kind, want) && !self.fn_compatible(kind, want) {
      self.fail(expr.loc, "expected ${want.show}, got ${kind.show}")
    }
    expr.ty = kind
    kind
  }

  pub fn check_expr_core(expr: Expr, has_want: Bool, want: Ty): Ty {
    k = expr.kind
    if k == ex_int() {
      return self.check_integer(expr, has_want, want)
    }
    if k == ex_float() {
      return self.t_float()
    }
    if k == ex_string() {
      return self.t_string()
    }
    if k == ex_bool() {
      return self.t_bool()
    }
    if k == ex_nil() {
      return self.t_nil()
    }
    if k == ex_name() {
      return self.check_name(expr, has_want, want)
    }
    if k == ex_lambda() {
      return self.check_lambda(expr, has_want, want)
    }
    if k == ex_call() {
      return self.check_call(expr, has_want, want)
    }
    if k == ex_unary() {
      return self.check_unary(expr)
    }
    if k == ex_binary() {
      return self.check_binary(expr)
    }
    if k == ex_switch() {
      return self.check_switch(expr, has_want, want)
    }
    if k == ex_field() {
      return self.check_field(expr)
    }
    if k == ex_struct() {
      return self.check_struct_literal(expr, has_want, want)
    }
    if k == ex_index() {
      return self.check_index(expr)
    }
    if k == ex_array_new() {
      return self.check_array_new(expr)
    }
    if k == ex_array() {
      return self.check_array_literal(expr, has_want, want)
    }
    if k == ex_hash_new() {
      return self.check_hash_new(expr)
    }
    if k == ex_try() {
      return self.check_try(expr)
    }
    if k == ex_interp() {
      return self.check_interp(expr)
    }
    self.fail(expr.loc, "unknown expression")
    self.t_int()
  }

  pub fn check_try(expr: Expr): Ty {
    if inner = expr.inner {
      got = self.check_expr(inner)
      return self.split_try_success(got, expr.loc)
    }
    self.t_int()
  }

  pub fn coalesce_result(left: Ty, right_expr: Expr, loc: Location, opname: String): Ty {
    payload = ty_without_nil(left)
    if right_expr.kind == ex_nil() {
      self.check_expr(right_expr)
      return left
    }
    right = self.check_expr_as(right_expr, payload)
    if right.is_nil {
      return left
    }
    if right.is_nilable {
      rp = ty_without_nil(right)
      if rp.same_as(payload) {
        return left
      }
      self.fail(loc, "${opname} fallback must be ${payload.show}, got ${right.show}")
      return left
    }
    if ty_assignable(right, payload) {
      return payload
    }
    self.fail(loc, "${opname} fallback must be ${payload.show}, got ${right.show}")
    payload
  }

  // `x?` (Stage 29 W1a, A3): the failure goes up only where the body's
  // result can hold it. A nilable operand fails on `nil`, so the result must
  // include `Nil`; a union without `Nil` fails on the members the result
  // holds, and exactly one member is left as the success. Anything else is a
  // compile error that names the result type and the ways out (before, a
  // `nil` silently became `0` in an `Int` function, and a `String` or void
  // result broke the MIR verifier).
  pub fn split_try_success(got: Ty, loc: Location): Ty {
    if self.place_depth > 0 {
      self.fail(loc, "postfix ? inside Mutex.with cannot return; handle the failure with if-assign or ??")
      return self.t_int()
    }
    if self.try_in.size > 0 {
      self.fail(loc, "postfix ? inside ${self.try_in} cannot return the failure; handle it with if-assign or ??")
      return self.t_int()
    }
    ret = self.return_type
    if got.is_union {
      if got.includes_nil {
        if ret.is_union && ret.includes_nil {
          return ty_without_nil(got)
        }
        if ret.is_void {
          self.fail(loc, "postfix ? would return nil, but ${self.try_body} returns nothing; give it a result that includes nil, or handle the nil with if-assign or ??")
        } else {
          self.fail(loc, "postfix ? would return nil, but ${self.try_body} returns ${ret.show}; declare the result ${ty_nilable(ret).show}, or handle the nil with if-assign or ??")
        }
        return self.t_int()
      }
      if ret.is_union {
        succ: Array(Ty) = []
        fails: Array(Ty) = []
        for m in got.members {
          if ret.includes_member(m) {
            fails.push(m)
          } else {
            succ.push(m)
          }
        }
        if succ.size == 1 && fails.size > 0 {
          return succ[0]
        }
        self.fail(loc, "cannot use postfix ? on ${got.show} in a function returning ${ret.show}")
        return self.t_int()
      }
      if ret.is_void {
        self.fail(loc, "postfix ? on ${got.show} would return the failure, but ${self.try_body} returns nothing; give it a union result that includes the failure, or handle it with if-assign or ??")
      } else {
        self.fail(loc, "postfix ? on ${got.show} would return the failure, but ${self.try_body} returns ${ret.show}; give it a union result that includes the failure, or handle it with if-assign or ??")
      }
      return self.t_int()
    }
    self.fail(loc, "postfix ? expects a union, got ${got.show}")
    self.t_int()
  }

  pub fn check_interp(expr: Expr): Ty {
    for part in expr.parts {
      if inner = part.expr {
        ty = self.check_expr(inner)
        ok = false
        if ty.is_integer {
          ok = true
        }
        if ty.is_string {
          ok = true
        }
        if ty.is_float {
          ok = true
        }
        if ty.is_bool {
          ok = true
        }
        if !ok {
          self.fail(inner.loc, "cannot interpolate ${ty.show}")
        }
      }
    }
    self.t_string()
  }

  pub fn check_float_field(expr: Expr): Ty {
    if expr.ident == "sqrt" {
      expr.method_call = true
      return self.t_float()
    }
    if expr.ident == "abs" {
      expr.method_call = true
      return self.t_float()
    }
    if expr.ident == "floor" {
      expr.method_call = true
      return self.t_float()
    }
    if expr.ident == "exp" {
      expr.method_call = true
      return self.t_float()
    }
    if expr.ident == "to_i" {
      expr.method_call = true
      return self.t_int()
    }
    self.field_as_call(expr, self.t_float())
  }

  pub fn check_int_field(expr: Expr, object: Ty): Ty {
    if expr.ident == "to_f" {
      expr.method_call = true
      return self.t_float()
    }
    if expr.ident == "abs" {
      expr.method_call = true
      return object
    }
    if expr.ident == "to_i" {
      expr.method_call = true
      return self.t_int()
    }
    if expr.ident == "to_i64" {
      expr.method_call = true
      return self.t_int64()
    }
    if expr.ident == "to_u64" {
      expr.method_call = true
      return self.t_uint64()
    }
    self.field_as_call(expr, object)
  }

  // One rule for empty parentheses (Stage 29 W1a, A5): a builtin method
  // without arguments may be written without `()`. A field form the lists
  // above do not name becomes the call `recv.name()` and is checked as one
  // (its receiver is already checked), so `s.strip` is `s.strip()` and an
  // unknown name reads "no method name on T".
  pub fn field_as_call(expr: Expr, object: Ty): Ty {
    if obj = expr.object {
      expr.kind = ex_call()
      expr.callee = expr.ident
      expr.receiver = obj
      expr.object = nil
      return self.builtin_method(expr, object)
    }
    self.fail(expr.loc, "${object.show} has no field ${expr.ident}")
    self.t_int()
  }

  // The method checkers of the builtin receiver types.
  pub fn builtin_method(expr: Expr, object: Ty): Ty {
    if object.is_float {
      return self.check_float_method(expr)
    }
    if object.is_integer {
      return self.check_int_method(expr, object)
    }
    if object.is_string {
      return self.check_string_method(expr)
    }
    if object.is_bytes {
      return self.check_bytes_method(expr)
    }
    if object.is_array {
      return self.check_array_method(expr, object)
    }
    if object.is_hash {
      return self.check_hash_method(expr, object)
    }
    if object.is_buf {
      return self.check_buf_method(expr)
    }
    self.check_join(expr, object)
  }

  pub fn check_field(expr: Expr): Ty {
    if obj = expr.object {
      if ty = self.type_call_target(obj, expr.ident) {
        // A type-level function in field form (`Money.zero`, declared
        // `fn self.zero: Money`), as a method without parameters is called
        // `a.twice`: the expression becomes that call.
        expr.kind = ex_call()
        expr.callee = expr.ident
        expr.receiver = obj
        expr.object = nil
        return self.check_type_call(expr, ty)
      }
      if obj.kind == ex_name() && obj.type_args.size > 0 {
        if self.is_generic_template(obj.ident) {
          self.take_type_app(obj)
        } else {
          call = self.type_app_as_call(obj)
          expr.object = call
          obj = call
        }
      }
      object = self.check_expr(obj)
      if object.is_float {
        return self.check_float_field(expr)
      }
      if object.is_integer {
        return self.check_int_field(expr, object)
      }
      if object.is_string {
        if expr.ident == "size" {
          return self.t_int()
        }
        if expr.ident == "bytes" {
          expr.method_call = true
          return self.t_bytes()
        }
        if expr.ident == "chars" {
          expr.method_call = true
          return ty_array(self.t_string())
        }
        if expr.ident == "to_f" {
          expr.method_call = true
          return self.t_float()
        }
        if expr.ident == "to_i" {
          expr.method_call = true
          return self.t_int()
        }
        if got = self.builtin_ext_call(expr, object) {
          return got
        }
        return self.field_as_call(expr, object)
      }
      if object.is_bytes {
        if expr.ident == "size" {
          return self.t_int()
        }
        if expr.ident == "to_buf" {
          expr.method_call = true
          return self.t_buf()
        }
        if expr.ident == "chars" {
          expr.method_call = true
          return ty_array(self.t_string())
        }
        if got = self.builtin_ext_call(expr, object) {
          return got
        }
        return self.field_as_call(expr, object)
      }
      if object.is_array {
        if expr.ident == "size" {
          return self.t_int()
        }
        if expr.ident == "pop" {
          expr.method_call = true
          if e = object.inner {
            return e
          }
          return self.t_int()
        }
        if expr.ident == "clear" {
          expr.method_call = true
          return self.t_void()
        }
        if expr.ident == "sort" {
          expr.method_call = true
          if e = object.inner {
            if !self.is_ordered_ty(e) {
              self.fail(expr.loc, "Array.sort needs an ordered element type or a comparator block")
            }
          }
          return self.t_void()
        }
        if expr.ident == "sorted" {
          expr.method_call = true
          if e = object.inner {
            if !self.is_ordered_ty(e) {
              self.fail(expr.loc, "Array.sorted needs an ordered element type or a comparator block")
            }
            return ty_array(e)
          }
          return ty_array(self.t_int())
        }
        if expr.ident == "reverse" {
          expr.method_call = true
          return self.t_void()
        }
        if expr.ident == "min" {
          expr.method_call = true
          if e = object.inner {
            if self.is_ordered_ty(e) {
              if e.is_bool {
                self.fail(expr.loc, "Array.min needs an ordered element type")
              }
            } else {
              self.fail(expr.loc, "Array.min needs an ordered element type")
            }
            return ty_nilable(e)
          }
          return ty_nilable(self.t_int())
        }
        if expr.ident == "max" {
          expr.method_call = true
          if e = object.inner {
            if self.is_ordered_ty(e) {
              if e.is_bool {
                self.fail(expr.loc, "Array.max needs an ordered element type")
              }
            } else {
              self.fail(expr.loc, "Array.max needs an ordered element type")
            }
            return ty_nilable(e)
          }
          return ty_nilable(self.t_int())
        }
        if expr.ident == "sum" {
          expr.method_call = true
          if e = object.inner {
            if self.is_numeric_ty(e) {
              return e
            }
            self.fail(expr.loc, "Array.sum needs a numeric element type")
            return e
          }
          return self.t_int()
        }
        return self.field_as_call(expr, object)
      }
      if object.is_hash {
        if expr.ident == "size" {
          return self.t_int()
        }
        if expr.ident == "keys" {
          expr.method_call = true
          if k = object.key {
            return ty_array(k)
          }
          return ty_array(self.t_int())
        }
        if expr.ident == "values" {
          expr.method_call = true
          if v = object.val {
            return ty_array(v)
          }
          return ty_array(self.t_int())
        }
        if expr.ident == "clear" {
          expr.method_call = true
          return self.t_void()
        }
        return self.field_as_call(expr, object)
      }
      if object.is_buf {
        if expr.ident == "size" {
          return self.t_int()
        }
        if expr.ident == "to_bytes" {
          expr.method_call = true
          return self.t_bytes()
        }
        if expr.ident == "to_s" {
          expr.method_call = true
          return self.t_string()
        }
        if expr.ident == "clear" {
          expr.method_call = true
          return self.t_void()
        }
        if got = self.builtin_ext_call(expr, object) {
          return got
        }
        return self.field_as_call(expr, object)
      }
      if object.is_join {
        if expr.ident == "join" {
          expr.method_call = true
          if self.in_task > 0 {
            self.fail(expr.loc, "join inside a pool worker")
          }
          if inner = object.inner {
            return inner
          }
          return self.t_int()
        }
        return self.field_as_call(expr, object)
      }
      if object.is_agg {
        if field_ty = object.field_named(expr.ident) {
          if sig = self.find_method(object.name, expr.ident) {
            self.fail(expr.loc, "${object.name}.${expr.ident} is both a field and a method")
            return field_ty
          }
          self.check_field_visible(object, expr.ident, expr.loc)
          return field_ty
        }
        has_zero = false
        for ms in self.methods {
          owner_hit = false
          if ms.owner == object.name {
            owner_hit = true
          } else {
            if object.origin.size > 0 && ms.node.generic && ms.owner == object.origin {
              owner_hit = true
            }
          }
          if owner_hit && ms.name == expr.ident && arity_ok(ms.node, 0) {
            has_zero = true
          }
        }
        if has_zero {
          arg_tys: Array(Ty) = []
          none: Ty? = nil
          if sig = self.match_method(object.name, expr.ident, arg_tys, none, expr.loc, object.name, object.mod_name) {
            expr.method_call = true
            expr.resolved = sig.node.emit_name
            return sig.ret
          }
          return self.t_int()
        }
        has_method = false
        for ms in self.methods {
          owner_hit = false
          if ms.owner == object.name {
            owner_hit = true
          } else {
            if object.origin.size > 0 && ms.node.generic && ms.owner == object.origin {
              owner_hit = true
            }
          }
          if owner_hit && ms.name == expr.ident {
            has_method = true
          }
        }
        if has_method {
          self.fail(expr.loc, "methods are not values")
        } else {
          self.fail(expr.loc, "no field ${expr.ident} on ${object.name}")
        }
        return self.t_int()
      }
      if object.is_ptr {
        return self.check_ptr_member(expr, object)
      }
      if object.is_clayout {
        return self.check_clayout_member(expr, object)
      }
      self.fail(expr.loc, "cannot read field ${expr.ident} on ${object.show}")
      return self.t_int()
    }
    self.t_int()
  }

  pub fn clayout_value_name(ty: Ty): String {
    if ty.is_clayout {
      return ty.show
    }
    if ty.is_array {
      if e = ty.inner {
        return self.clayout_value_name(e)
      }
    }
    if ty.is_union {
      i = 0
      while i < ty.members.size {
        name = self.clayout_value_name(ty.members[i])
        if name.size > 0 {
          return name
        }
        i += 1
      }
    }
    ""
  }

  pub fn reject_clayout_value(ty: Ty, loc: Location): Bool {
    name = self.clayout_value_name(ty)
    if name.size > 0 {
      self.fail(loc, "${name} is a C layout; use Ptr(${name})")
      return true
    }
    false
  }

  pub fn builtin_ext_call(expr: Expr, object: Ty): Ty? {
    owner = object.show
    has_zero = false
    for ms in self.methods {
      if ms.owner == owner && ms.name == expr.ident && arity_ok(ms.node, 0) && self.method_is_visible(ms.node, self.current_module) {
        has_zero = true
      }
    }
    if has_zero {
      arg_tys: Array(Ty) = []
      none: Ty? = nil
      if sig = self.match_method(owner, expr.ident, arg_tys, none, expr.loc, object.show, "") {
        expr.method_call = true
        expr.resolved = sig.node.emit_name
        return sig.ret
      }
    }
    nil
  }

  // `release(place)` (Stage 28 W16c, D266): a field of a C layout that
  // holds a reference (a `String`, or a nested layout with one), or a
  // `Ptr` to a C layout with such a field (the whole struct).
  pub fn check_release(e: Expr, et: Ty) {
    in_c = false
    name = ""
    if e.kind == ex_field() && !e.method_call {
      if obj = e.object {
        if ot = obj.ty {
          in_c = ot.is_ptr || ot.is_clayout
        }
      }
      name = e.ident
    }
    if in_c {
      if et.is_string {
        return
      }
      if et.is_clayout {
        if !clayout_holds_ref(et) {
          self.fail(e.loc, "nothing to release: ${name} is ${et.show}, which has no String field")
        }
        return
      }
      hint = ""
      if et.is_ptr {
        if inner = et.inner {
          if inner.is_clayout && clayout_holds_ref(inner) {
            hint = " (to release the struct it points to, name the pointer first: p = x.${name}, then release(p))"
          }
        }
      }
      self.fail(e.loc, "nothing to release: ${name} is ${et.show}${hint}")
      return
    }
    if et.is_ptr {
      if inner = et.inner {
        if inner.is_clayout {
          if !clayout_holds_ref(inner) {
            self.fail(e.loc, "nothing to release: ${inner.show} has no String field")
          }
          return
        }
      }
      self.fail(e.loc, "release needs the fields of a C layout; Avant knows no fields of ${et.show}")
      return
    }
    heap = et.is_string || et.is_bytes || et.is_buf || et.is_array || et.is_hash || et.is_class || et.is_fn || et.is_join
    if heap {
      self.fail(e.loc, "release takes the C field the value was stored in; for a scoped pin use pin(x) { }")
      return
    }
    self.fail(e.loc, "release takes a C-layout field or a Ptr to a C layout, got ${et.show}")
  }

  pub fn check_ptr_member(expr: Expr, object: Ty): Ty {
    owner = self.method_owner_name(object)
    pointee = object
    if inner = object.inner {
      pointee = inner
    }
    if pointee.is_clayout {
      if field_ty = pointee.field_named(expr.ident) {
        if sig = self.find_method(owner, expr.ident) {
          self.fail(expr.loc, "${pointee.name}.${expr.ident} is both a field and a method")
          return ty_c_view(field_ty)
        }
        return ty_c_view(field_ty)
      }
    }
    has_zero = false
    for ms in self.methods {
      if ms.owner == owner && ms.name == expr.ident && arity_ok(ms.node, 0) {
        has_zero = true
      }
    }
    if has_zero {
      arg_tys: Array(Ty) = []
      none: Ty? = nil
      if sig = self.match_method(owner, expr.ident, arg_tys, none, expr.loc, object.show, object.mod_name) {
        expr.method_call = true
        expr.resolved = sig.node.emit_name
        return sig.ret
      }
      return self.t_int()
    }
    self.fail(expr.loc, "no field ${expr.ident} on ${object.show}")
    self.t_int()
  }

  pub fn check_clayout_member(expr: Expr, object: Ty): Ty {
    if field_ty = object.field_named(expr.ident) {
      return ty_c_view(field_ty)
    }
    self.fail(expr.loc, "no field ${expr.ident} on ${object.show}")
    self.t_int()
  }

  pub fn check_index(expr: Expr): Ty {
    if arr = expr.left {
      if ix = expr.right {
        if arr.kind == ex_name() && !arr.implicit_field {
          cont = arr.ident
          if ix.kind == ex_name() {
            if self.fact_slack_of(ix.ident, cont) >= 0 {
              expr.proven = true
            }
          } else if ix.kind == ex_binary() {
            if ix.op == tk_plus() {
              if il = ix.left {
                if ir = ix.right {
                  if il.kind == ex_name() && self.lit_small(ir) {
                    sl = self.fact_slack_of(il.ident, cont)
                    if sl >= 0 && ir.int_bits <= sl.to_u64 {
                      expr.proven = true
                      ix.proven = true
                    }
                  }
                  if ir.kind == ex_name() && self.lit_small(il) {
                    sl = self.fact_slack_of(ir.ident, cont)
                    if sl >= 0 && il.int_bits <= sl.to_u64 {
                      expr.proven = true
                      ix.proven = true
                    }
                  }
                }
              }
            }
          }
        }
        if ix.kind == ex_binary() && (ix.op == tk_plus() || ix.op == tk_minus()) {
          if il = ix.left {
            if ir = ix.right {
              if il.kind == ex_int() || ir.kind == ex_int() {
                ix.proven = true
              }
            }
          }
        }
        container = self.check_expr(arr)
        if container.is_string || container.is_buf || container.is_bytes {
          got = self.check_expr_as(ix, self.t_int())
          if !got.is_int {
            self.fail(ix.loc, "index must be Int, got ${got.show}")
          }
          return self.t_int()
        }
        if container.is_hash {
          if k = container.key {
            key = self.check_expr_as(ix, k)
            if !ty_assignable(key, k) {
              self.fail(ix.loc, "hash key must be ${k.show}, got ${key.show}")
            }
          }
          if v = container.val {
            return ty_nilable(v)
          }
          return self.t_int()
        }
        if container.is_array {
          got = self.check_expr_as(ix, self.t_int())
          if !got.is_int {
            self.fail(ix.loc, "array index must be Int, got ${got.show}")
          }
          if e = container.inner {
            return e
          }
          return self.t_int()
        }
        self.fail(expr.loc, "cannot index ${container.show}")
        return self.t_int()
      }
    }
    self.t_int()
  }

  pub fn check_array_new(expr: Expr): Ty {
    elem = self.t_int()
    if tn = expr.elem_type {
      elem = self.resolve_in_module(tn)
      self.pull_resolve
      if self.reject_clayout_value(elem, tn.loc) {
        return self.t_int()
      }
    }
    if size = expr.size_expr {
      st = self.check_expr_as(size, self.t_int())
      if !st.is_int {
        self.fail(size.loc, "Array(T).new expects Int size")
      }
    }
    ty_array(elem)
  }

  pub fn check_array_literal(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.elems.size == 0 {
      if has_want && want.is_array {
        return want
      }
      self.fail(expr.loc, "empty array needs a type, e.g. xs: Array(Int) = []")
      return self.t_int()
    }
    elem_ty = self.t_int()
    forced = false
    if has_want && want.is_array {
      if e = want.inner {
        if !type.ty_has_var(e) {
          elem_ty = e
          forced = true
        }
      }
    }
    if !forced {
      elem_ty = self.check_expr(expr.elems[0])
    }
    for el in expr.elems {
      got = self.check_expr_as(el, elem_ty)
      if !ty_assignable(got, elem_ty) {
        self.fail(el.loc, "array element is ${got.show}, expected ${elem_ty.show}")
      }
    }
    ty_array(elem_ty)
  }

  pub fn check_hash_new(expr: Expr): Ty {
    key = self.t_int()
    val = self.t_int()
    if kn = expr.key_type {
      key = self.resolve_value_in_module(kn)
      self.pull_resolve
    }
    if vn = expr.val_type {
      val = self.resolve_value_in_module(vn)
      self.pull_resolve
    }
    if !key.is_string && !key.is_int {
      self.fail(expr.loc, "Hash keys must be String or Int")
      return self.t_int()
    }
    if !val.is_int && !val.is_string {
      self.fail(expr.loc, "Hash values must be Int or String")
      return self.t_int()
    }
    if key.is_int && val.is_string {
      self.fail(expr.loc, "Hash(Int, String) is not in this stage")
      return self.t_int()
    }
    ty_hash(key, val)
  }

  pub fn check_struct_literal(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.type_args.size > 0 {
      tn = TypeName.new(expr.loc, expr.type_name)
      tn.mod_name = expr.mod_name
      for type_arg in expr.type_args {
        tn.args.push(type_arg)
      }
      ty = self.resolve_in_module(tn)
      self.pull_resolve
      if self.has_err {
        return self.t_int()
      }
      return self.check_struct_fields(expr, ty, true)
    }
    if tmpl = self.find_struct_template(expr.type_name, expr.mod_name) {
      return self.infer_struct_literal(expr, tmpl, has_want, want)
    }
    if ty = self.lookup_named_type(expr.type_name, expr.loc, expr.mod_name) {
      return self.check_struct_fields(expr, ty, true)
    }
    self.fail(expr.loc, "unknown type ${expr.type_name}")
    self.t_int()
  }

  pub fn check_struct_fields(expr: Expr, ty: Ty, check_values: Bool): Ty {
    if ty.template {
      self.fail(expr.loc, "${ty.name} needs type arguments")
      return self.t_int()
    }
    if ty.is_class {
      shown = ty.show
      self.fail(expr.loc, "classes are constructed with ${shown}.new, not ${shown} { }")
      return ty
    }
    if self.reject_clayout_value(ty, expr.loc) {
      return ty
    }
    seen = Hash(String, Int).new
    i = 0
    while i < expr.field_names.size {
      fname = expr.field_names[i]
      value = expr.field_exprs[i]
      if prev = seen.get(fname) {
        self.fail(value.loc, "duplicate field ${fname}")
      }
      seen[fname] = 1
      if field_ty = ty.field_named(fname) {
        self.check_field_visible(ty, fname, value.loc)
        if check_values {
          got = self.check_expr_as(value, field_ty)
          if !ty_assignable(got, field_ty) && !type.ty_has_var(field_ty) {
            self.fail(value.loc, "field ${fname} is ${got.show}, expected ${field_ty.show}")
          }
        }
      } else {
        label = ty.show
        self.fail(value.loc, "no field ${fname} on ${label}")
      }
      i += 1
    }
    for f in ty.fields {
      if prev = seen.get(f.name) {
      } else if self.field_hidden(ty, f.name) {
        self.fail(expr.loc, "${ty.show} has private fields (${f.name}); a literal outside module ${ty.mod_name} cannot build it")
      } else {
        self.fail(expr.loc, "missing field ${f.name}")
      }
    }
    ty
  }

  pub fn find_struct_template(name: String, mod_name: String): StructDef? {
    found: StructDef? = nil
    count = 0
    for sdef in self.program.structs {
      if sdef.name == name && sdef.type_params.size > 0 {
        if mod_name.size > 0 {
          if sdef.mod_name == mod_name {
            return sdef
          }
        } else {
          count += 1
          found = sdef
        }
      }
    }
    if mod_name.size > 0 {
      return nil
    }
    if count == 1 {
      return found
    }
    nil
  }

  pub fn find_class_template(name: String, mod_name: String): ClassDef? {
    found: ClassDef? = nil
    count = 0
    for cdef in self.program.classes {
      if cdef.name == name && cdef.type_params.size > 0 {
        if mod_name.size > 0 {
          if cdef.mod_name == mod_name {
            return cdef
          }
        } else {
          count += 1
          found = cdef
        }
      }
    }
    if mod_name.size > 0 {
      return nil
    }
    if count == 1 {
      return found
    }
    nil
  }

  pub fn is_generic_template(name: String): Bool {
    if s = self.find_struct_template(name, "") {
      return true
    }
    if c = self.find_class_template(name, "") {
      return true
    }
    false
  }

  pub fn apply_want_args(origin: String, params: Array(String), has_want: Bool, want: Ty, keys: Array(String), vals: Array(Ty)): Bool {
    if has_want && want.origin == origin && want.ty_args.size == params.size {
      i = 0
      while i < params.size {
        warg = want.ty_args[i]
        if !type.ty_has_var(warg) && !self.unify_ty(ty_var(params[i]), warg, keys, vals) {
          return false
        }
        i += 1
      }
    }
    true
  }

  pub fn solved_args(params: Array(String), keys: Array(String), vals: Array(Ty), loc: Location): Array(Ty)? {
    out: Array(Ty) = []
    i = 0
    while i < params.size {
      if got = self.subst_get(keys, vals, params[i]) {
        out.push(got)
      } else {
        return nil
      }
      i += 1
    }
    out
  }

  pub fn instantiate_applied(name: String, mod_name: String, args: Array(Ty), loc: Location): Ty {
    tn = TypeName.new(loc, name)
    tn.mod_name = mod_name
    i = 0
    while i < args.size {
      tn.args.push(ty_to_type_name(args[i], loc))
      i += 1
    }
    ty = self.resolve_in_module(tn)
    self.pull_resolve
    ty
  }

  pub fn infer_struct_literal(expr: Expr, tmpl: StructDef, has_want: Bool, want: Ty): Ty {
    params = tmpl.type_params
    self.resolver.set_tparams(params)
    patterns: Array(Ty) = []
    names: Array(String) = []
    i = 0
    while i < tmpl.fields.size {
      names.push(tmpl.fields[i].name)
      patterns.push(self.resolver.resolve_value(tmpl.fields[i].type))
      self.pull_resolve
      i += 1
    }
    self.resolver.clear_tparams
    if self.has_err {
      return self.t_int()
    }
    keys: Array(String) = []
    vals: Array(Ty) = []
    if !self.apply_want_args(tmpl.name, params, has_want, want, keys, vals) {
      self.fail(expr.loc, "conflicting type arguments")
      return self.t_int()
    }
    seen = Hash(String, Int).new
    gots: Array(Ty) = []
    got_names: Array(String) = []
    i = 0
    while i < expr.field_names.size {
      fname = expr.field_names[i]
      value = expr.field_exprs[i]
      if prev = seen.get(fname) {
        self.fail(value.loc, "duplicate field ${fname}")
      }
      seen[fname] = 1
      pat: Ty? = nil
      for j in 0..names.size {
        if names[j] == fname {
          pat = patterns[j]
        }
      }
      if p = pat {
        pat_ty = self.subst_ty(p, keys, vals)
        got = self.check_expr_flag(value, true, pat_ty)
        gots.push(got)
        got_names.push(fname)
        if !self.unify_ty(pat_ty, got, keys, vals) {
          self.fail(value.loc, "conflicting type arguments")
        }
      } else {
        self.fail(value.loc, "no field ${fname} on ${tmpl.name}")
      }
      i += 1
    }
    if solved = self.solved_args(params, keys, vals, expr.loc) {
      ty = self.instantiate_applied(tmpl.name, expr.mod_name, solved, expr.loc)
      if self.has_err {
        return self.t_int()
      }
      for i in 0..got_names.size {
        if field_ty = ty.field_named(got_names[i]) {
          self.check_field_visible(ty, got_names[i], expr.loc)
          if !ty_assignable(gots[i], field_ty) {
            self.fail(expr.loc, "field ${got_names[i]} is ${gots[i].show}, expected ${field_ty.show}")
          }
        }
      }
      for f in ty.fields {
        if prev = seen.get(f.name) {
        } else if self.field_hidden(ty, f.name) {
          self.fail(expr.loc, "${ty.show} has private fields (${f.name}); a literal outside module ${ty.mod_name} cannot build it")
        } else {
          self.fail(expr.loc, "missing field ${f.name}")
        }
      }
      return ty
    }
    self.fail(expr.loc, "cannot infer type argument; write ${tmpl.name}(...)")
    self.t_int()
  }

  pub fn check_name(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.ident == "self" {
      if cf = self.current_fn {
        if cf.type_method {
          self.fail(expr.loc, "self is not available in a type-level function")
          return self.t_int()
        }
      }
      if st = self.self_ty {
      } else {
        if existing = self.lookup("self") {
          return existing
        }
        if self.in_default {
          self.fail(expr.loc, "a field default cannot use self: defaults are evaluated before initialize; set the field in initialize instead")
          return self.t_int()
        }
        self.fail(expr.loc, "self is only valid in a method")
        return self.t_int()
      }
    }
    if self.lam_exprs.size > 0 && self.self_name.size > 0 && expr.ident == self.self_name {
      self.fail(expr.loc, "a lambda cannot capture the method receiver")
      return self.t_int()
    }
    if existing = self.lookup(expr.ident) {
      self.note_capture(expr.ident, existing)
      return existing
    }
    if field_ty = self.implicit_field(expr.ident) {
      if st = self.self_ty {
        self.check_field_visible(st, expr.ident, expr.loc)
      }
      if self.lam_exprs.size > 0 {
        self.fail(expr.loc, "a lambda cannot capture the method receiver")
        return self.t_int()
      }
      expr.implicit_field = true
      return field_ty
    }
    if k = self.known_mods.get(expr.ident) {
      if self.qualifier_ok(expr.ident, self.current_module) {
        return ty_module(expr.ident)
      }
    }
    // Stage 29 W3b (B6): a bare method name is a call on the receiver.
    if r = self.bare_method_call(expr, expr.ident, 0) {
      if self.lam_exprs.size > 0 {
        self.fail(expr.loc, "a lambda cannot capture the method receiver")
        return self.t_int()
      }
      expr.kind = ex_call()
      expr.callee = expr.ident
      expr.receiver = r
      return self.check_method_call(expr, r, has_want, want)
    }
    if has_want && want.is_fn {
      return self.check_fn_ref(expr, want)
    }
    if got = self.check_fn_ref_bare(expr) {
      return got
    }
    if self.is_generic_template(expr.ident) {
      self.fail(expr.loc, "${expr.ident} needs type arguments")
      return self.t_int()
    }
    self.fail(expr.loc, "unknown name ${expr.ident}")
    self.t_int()
  }

  pub fn check_integer(expr: Expr, has_want: Bool, want: Ty): Ty {
    if has_want && want.is_float {
      return self.t_float()
    }
    if expr.int_suffix == "u64" {
      return self.t_uint64()
    }
    if expr.int_suffix == "i64" {
      return self.t_int64()
    }
    if has_want {
      if want.is_uint64 {
        return self.t_uint64()
      }
      if want.is_int64 {
        return self.t_int64()
      }
    }
    max = 2147483647u64
    if expr.int_bits <= max {
      return self.t_int()
    }
    self.fail(expr.loc, "integer literal does not fit in Int; use ${expr.int_bits}i64 or ${expr.int_bits}u64")
    self.t_int()
  }

  pub fn check_unary(expr: Expr): Ty {
    if inner = expr.inner {
      got = self.check_expr(inner)
      if expr.op == tk_minus() {
        if got.is_numeric {
          return got
        }
        self.fail(expr.loc, "unary minus expects Int or Float64")
        return self.t_int()
      }
      if expr.op == tk_bang() {
        if got.is_bool {
          return self.t_bool()
        }
        self.fail(expr.loc, "! expects Bool")
        return self.t_bool()
      }
      if expr.op == tk_tilde() {
        if got.is_integer {
          return got
        }
        self.fail(expr.loc, "~ expects an integer")
        return self.t_int()
      }
      self.fail(expr.loc, "unsupported unary operator")
      return self.t_int()
    }
    self.t_int()
  }

  pub fn bitwise_op(op: Int): Bool {
    if op == tk_amp() {
      return true
    }
    if op == tk_pipe() {
      return true
    }
    if op == tk_caret() {
      return true
    }
    if op == tk_less_less() {
      return true
    }
    op == tk_greater_greater()
  }

  pub fn shift_op(op: Int): Bool {
    if op == tk_less_less() {
      return true
    }
    op == tk_greater_greater()
  }

  // A shift by a literal amount outside 0..width - 1 (a negated literal
  // included) is a compile-time error (C1, W11b); any other amount is
  // checked when the shift runs.
  pub fn check_shift_amount(r: Expr, left: Ty, loc: Location) {
    neg = false
    lit = r
    if r.kind == ex_unary() && r.op == tk_minus() {
      if inner = r.inner {
        if inner.kind == ex_int() {
          neg = true
          lit = inner
        }
      }
    }
    if lit.kind != ex_int() {
      return
    }
    top = 31u64
    if left.is_int64 || left.is_uint64 {
      top = 63u64
    }
    if neg {
      if lit.int_bits != 0u64 {
        self.fail(loc, "shift amount -${lit.int_bits} out of range for ${left.show} (0..${top})")
      }
      return
    }
    if lit.int_bits > top {
      self.fail(loc, "shift amount ${lit.int_bits} out of range for ${left.show} (0..${top})")
    }
  }

  pub fn int_binary(op: Int, ty: Ty): Ty {
    if op == tk_plus() {
      return ty
    }
    if op == tk_minus() {
      return ty
    }
    if op == tk_star() {
      return ty
    }
    if op == tk_slash() {
      return ty
    }
    if op == tk_eq_eq() {
      return self.t_bool()
    }
    if op == tk_not_eq() {
      return self.t_bool()
    }
    if op == tk_less() {
      return self.t_bool()
    }
    if op == tk_less_eq() {
      return self.t_bool()
    }
    if op == tk_greater() {
      return self.t_bool()
    }
    if op == tk_greater_eq() {
      return self.t_bool()
    }
    self.fail(self.program.loc, "unsupported operator")
    ty
  }

  pub fn float_binary(op: Int, loc: Location): Ty {
    if op == tk_plus() {
      return self.t_float()
    }
    if op == tk_minus() {
      return self.t_float()
    }
    if op == tk_star() {
      return self.t_float()
    }
    if op == tk_slash() {
      return self.t_float()
    }
    if op == tk_eq_eq() {
      return self.t_bool()
    }
    if op == tk_not_eq() {
      return self.t_bool()
    }
    if op == tk_less() {
      return self.t_bool()
    }
    if op == tk_less_eq() {
      return self.t_bool()
    }
    if op == tk_greater() {
      return self.t_bool()
    }
    if op == tk_greater_eq() {
      return self.t_bool()
    }
    self.fail(loc, "unsupported operator on Float64")
    self.t_float()
  }

  pub fn check_binary(expr: Expr): Ty {
    if l = expr.left {
      if r = expr.right {
        op = expr.op
        if op == tk_question_question() {
          left = self.check_expr(l)
          if left.is_nilable {
            return self.coalesce_result(left, r, expr.loc, "??")
          }
          self.check_expr(r)
          self.fail(expr.loc, "?? needs a nilable left side, got ${left.show}")
          return left
        }
        if op == tk_amp_amp() {
          left = self.check_expr(l)
          right = self.check_expr(r)
          if left.is_bool && right.is_bool {
            return self.t_bool()
          }
          self.fail(expr.loc, "&& expects Bool operands")
          return self.t_bool()
        }
        if op == tk_pipe_pipe() {
          left = self.check_expr(l)
          right = self.check_expr(r)
          if left.is_bool && right.is_bool {
            return self.t_bool()
          }
          self.fail(expr.loc, "|| expects Bool operands")
          return self.t_bool()
        }
        left = self.check_expr(l)
        opname = binary_op_method_name(op)
        if opname.size > 0 && left.is_agg {
          has_op = false
          for ms in self.methods {
            if ms.owner == left.name && ms.name == opname {
              has_op = true
            }
          }
          if has_op {
            right = self.check_expr(r)
            arg_tys: Array(Ty) = []
            arg_tys.push(right)
            none: Ty? = nil
            if sig = self.match_method(left.name, opname, arg_tys, none, expr.loc, left.name, left.mod_name) {
              expr.resolved = sig.node.emit_name
              return sig.ret
            }
            return self.t_int()
          }
        }
        right_has = false
        right_want = self.t_int()
        if left.is_integer {
          right_has = true
          right_want = left
        } else if left.is_float {
          right_has = true
          right_want = left
        } else if left.is_string {
          right_has = true
          right_want = left
        } else if left.is_bytes {
          right_has = true
          right_want = left
        }
        right = self.check_expr_flag(r, right_has, right_want)
        if left.is_fn {
          if op == tk_eq_eq() {
            self.fail(expr.loc, "cannot compare fn values")
            return self.t_bool()
          }
          if op == tk_not_eq() {
            self.fail(expr.loc, "cannot compare fn values")
            return self.t_bool()
          }
        }
        if right.is_fn {
          if op == tk_eq_eq() {
            self.fail(expr.loc, "cannot compare fn values")
            return self.t_bool()
          }
          if op == tk_not_eq() {
            self.fail(expr.loc, "cannot compare fn values")
            return self.t_bool()
          }
        }
        if left.is_bool && right.is_bool {
          if op == tk_eq_eq() {
            return self.t_bool()
          }
          if op == tk_not_eq() {
            return self.t_bool()
          }
          self.fail(expr.loc, "unsupported operator on Bool (== and != compare Bools; &&, || and ! combine them)")
          return self.t_bool()
        }
        if left.is_string && right.is_string {
          if op == tk_plus() {
            return self.t_string()
          }
          if op == tk_eq_eq() {
            return self.t_bool()
          }
          if op == tk_not_eq() {
            return self.t_bool()
          }
          self.fail(expr.loc, "unsupported operator on String")
          return self.t_string()
        }
        if left.is_bytes && right.is_bytes {
          if op == tk_eq_eq() {
            return self.t_bool()
          }
          if op == tk_not_eq() {
            return self.t_bool()
          }
          self.fail(expr.loc, "unsupported operator on Bytes")
          return self.t_bool()
        }
        if op == tk_amp_plus() || op == tk_amp_minus() || op == tk_amp_star() {
          if left.is_integer && right.same_as(left) {
            return left
          }
          self.fail(expr.loc, "wrapping operator expects matching integer operands")
          return left
        }
        if op == tk_percent() {
          if left.is_integer && right.same_as(left) {
            if self.divisor_proven(r) {
              expr.proven = true
            }
            return left
          }
          self.fail(expr.loc, "% expects matching integer operands")
          return left
        }
        if self.bitwise_op(op) {
          if self.shift_op(op) {
            if left.is_integer {
              self.check_shift_amount(r, left, expr.loc)
            }
            if left.is_uint64 && right.is_int {
              return left
            }
            if left.is_int64 && right.is_int {
              return left
            }
          }
          if left.is_integer && right.same_as(left) {
            return left
          }
          self.fail(expr.loc, "bitwise operator expects matching integer operands")
          return left
        }
        if left.is_integer && right.is_integer {
          if left.same_as(right) {
            if op == tk_plus() {
              if l.kind == ex_name() && r.kind == ex_int() {
                s = self.fact_any_slack(l.ident)
                if s >= 0 && r.int_bits <= s.to_u64 + 1u64 {
                  expr.proven = true
                }
              }
              if r.kind == ex_name() && l.kind == ex_int() {
                s = self.fact_any_slack(r.ident)
                if s >= 0 && l.int_bits <= s.to_u64 + 1u64 {
                  expr.proven = true
                }
              }
            }
            if op == tk_minus() && l.kind == ex_name() && r.kind == ex_int() && (self.fact_any_slack(l.ident) >= 0 || self.nn_has(l.ident)) {
              expr.proven = true
            }
            if (op == tk_plus() || op == tk_star() || op == tk_minus()) && self.arith_proven(op, l, r, left) {
              expr.proven = true
            }
            if op == tk_slash() && self.divisor_proven(r) {
              expr.proven = true
            }
            return self.int_binary(op, left)
          }
          self.fail(expr.loc, "binary operator expects matching types, got ${left.show} and ${right.show}")
          return left
        }
        if left.is_numeric && right.is_numeric {
          if !left.is_float {
            l.ty = self.t_float()
          }
          if !right.is_float {
            r.ty = self.t_float()
          }
          return self.float_binary(op, expr.loc)
        }
        self.fail(expr.loc, "binary operator expects numeric operands, got ${left.show} and ${right.show}")
        return self.t_int()
      }
    }
    self.t_int()
  }

  pub fn check_call(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.indirect {
      if inner = expr.inner {
        callee = self.check_expr(inner)
        return self.check_indirect_call(expr, callee)
      }
    }
    if recv = expr.receiver {
      return self.check_method_call(expr, recv, has_want, want)
    }
    if self.is_generic_template(expr.callee) {
      self.fail(expr.loc, "type argument expected")
      return self.t_int()
    }
    if existing = self.lookup(expr.callee) {
      if existing.is_fn {
        self.note_capture(expr.callee, existing)
        expr.indirect = true
        return self.check_indirect_call(expr, existing)
      }
    }
    // Stage 29 W3b (B6): a bare call of a method of the receiver.
    argc = expr.args.size
    if b0 = expr.block {
      argc += 1
    }
    if r = self.bare_method_call(expr, expr.callee, argc) {
      if self.lam_exprs.size > 0 {
        self.fail(expr.loc, "a lambda cannot capture the method receiver")
        return self.t_int()
      }
      expr.receiver = r
      return self.check_method_call(expr, r, has_want, want)
    }
    if expr.callee == "puts" {
      if expr.args.size != 1 {
        self.fail(expr.loc, "puts takes one argument")
        return self.t_void()
      }
      if b = expr.block {
        self.fail(expr.loc, "puts does not take a block")
        return self.t_void()
      }
      printed = self.check_expr(expr.args[0])
      ok = false
      if printed.is_integer {
        ok = true
      }
      if printed.is_string {
        ok = true
      }
      if printed.is_float {
        ok = true
      }
      if printed.is_bool {
        ok = true
      }
      if ok {
        return self.t_void()
      }
      self.fail(expr.args[0].loc, "puts cannot print ${printed.show}")
      return self.t_void()
    }
    if expr.callee == "spawn" {
      return self.check_spawn(expr)
    }
    if expr.callee == "now_ms" {
      if expr.args.size == 0 {
        if b = expr.block {
          self.fail(expr.loc, "now_ms takes no arguments")
          return self.t_int()
        }
        return self.t_int()
      }
      self.fail(expr.loc, "now_ms takes no arguments")
      return self.t_int()
    }
    if expr.callee == "file_read" {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "file_read takes one String")
          return ty_nilable(self.t_string())
        }
      } else {
        self.fail(expr.loc, "file_read takes one String")
        return ty_nilable(self.t_string())
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if !ty_assignable(got, self.t_string()) {
        self.fail(expr.args[0].loc, "file_read expects String")
      }
      return ty_nilable(self.t_string())
    }
    if expr.callee == "file_write" {
      if expr.args.size == 2 {
        if b = expr.block {
          self.fail(expr.loc, "file_write takes a path and a body")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "file_write takes a path and a body")
        return self.t_int()
      }
      path = self.check_expr_as(expr.args[0], self.t_string())
      if !ty_assignable(path, self.t_string()) {
        self.fail(expr.args[0].loc, "file_write path must be String")
      }
      body = self.check_expr_as(expr.args[1], self.t_string())
      if !ty_assignable(body, self.t_string()) {
        self.fail(expr.args[1].loc, "file_write body must be String")
      }
      return self.t_int()
    }
    if expr.callee == "argv" {
      if expr.args.size == 0 {
        if b = expr.block {
          self.fail(expr.loc, "argv takes no arguments")
          return ty_array(self.t_string())
        }
        return ty_array(self.t_string())
      }
      self.fail(expr.loc, "argv takes no arguments")
      return ty_array(self.t_string())
    }
    if expr.callee == "process_run" {
      if expr.args.size == 2 {
        if b = expr.block {
          self.fail(expr.loc, "process_run takes a path and args")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "process_run takes a path and args")
        return self.t_int()
      }
      path = self.check_expr_as(expr.args[0], self.t_string())
      if !ty_assignable(path, self.t_string()) {
        self.fail(expr.args[0].loc, "process_run path must be String")
      }
      args_ty = ty_array(self.t_string())
      got = self.check_expr_as(expr.args[1], args_ty)
      if !ty_assignable(got, args_ty) {
        self.fail(expr.args[1].loc, "process_run args must be Array(String)")
      }
      return self.t_int()
    }
    if expr.callee == "process_run_out" {
      if expr.args.size == 3 {
        if b = expr.block {
          self.fail(expr.loc, "process_run_out takes a path, args, and an output path")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "process_run_out takes a path, args, and an output path")
        return self.t_int()
      }
      path = self.check_expr_as(expr.args[0], self.t_string())
      if !ty_assignable(path, self.t_string()) {
        self.fail(expr.args[0].loc, "process_run_out path must be String")
      }
      args_ty = ty_array(self.t_string())
      got = self.check_expr_as(expr.args[1], args_ty)
      if !ty_assignable(got, args_ty) {
        self.fail(expr.args[1].loc, "process_run_out args must be Array(String)")
      }
      outp = self.check_expr_as(expr.args[2], self.t_string())
      if !ty_assignable(outp, self.t_string()) {
        self.fail(expr.args[2].loc, "process_run_out output path must be String")
      }
      return self.t_int()
    }
    if expr.callee == "env_get" {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "env_get takes one String")
          return ty_nilable(self.t_string())
        }
      } else {
        self.fail(expr.loc, "env_get takes one String")
        return ty_nilable(self.t_string())
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if !ty_assignable(got, self.t_string()) {
        self.fail(expr.args[0].loc, "env_get expects String")
      }
      return ty_nilable(self.t_string())
    }
    if expr.callee == "file_exists" {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "file_exists takes one String")
          return self.t_bool()
        }
      } else {
        self.fail(expr.loc, "file_exists takes one String")
        return self.t_bool()
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if !ty_assignable(got, self.t_string()) {
        self.fail(expr.args[0].loc, "file_exists expects String")
      }
      return self.t_bool()
    }
    if expr.callee == "dir_list" {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "dir_list takes one String")
          return ty_array(self.t_string())
        }
      } else {
        self.fail(expr.loc, "dir_list takes one String")
        return ty_array(self.t_string())
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if !ty_assignable(got, self.t_string()) {
        self.fail(expr.args[0].loc, "dir_list expects String")
      }
      return ty_array(self.t_string())
    }
    if ty = self.check_codec_call(expr) {
      return ty
    }
    if ty = self.check_langarena_call(expr) {
      return ty
    }
    if ty = self.check_gate_call(expr) {
      return ty
    }
    if expr.callee == "chr" {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "chr takes one Int")
          return self.t_string()
        }
      } else {
        self.fail(expr.loc, "chr takes one Int")
        return self.t_string()
      }
      got = self.check_expr_as(expr.args[0], self.t_int())
      if !got.is_int {
        self.fail(expr.args[0].loc, "chr expects Int")
      }
      return self.t_string()
    }
    if expr.callee == "str_slice" {
      if expr.args.size == 3 {
        if b = expr.block {
          self.fail(expr.loc, "str_slice takes String, start, stop")
          return self.t_string()
        }
      } else {
        self.fail(expr.loc, "str_slice takes String, start, stop")
        return self.t_string()
      }
      s = self.check_expr_as(expr.args[0], self.t_string())
      if !ty_assignable(s, self.t_string()) {
        self.fail(expr.args[0].loc, "str_slice expects String")
      }
      start = self.check_expr_as(expr.args[1], self.t_int())
      stop = self.check_expr_as(expr.args[2], self.t_int())
      if !start.is_int {
        self.fail(expr.args[1].loc, "start must be Int")
      }
      if !stop.is_int {
        self.fail(expr.args[2].loc, "stop must be Int")
      }
      return self.t_string()
    }
    if expr.callee == "buf_new" {
      if b = expr.block {
        self.fail(expr.loc, "buf_new does not take a block")
        return self.t_buf()
      }
      if expr.args.size == 0 {
        return self.t_buf()
      }
      if expr.args.size == 1 {
        cap = self.check_expr_as(expr.args[0], self.t_int())
        if !cap.is_int {
          self.fail(expr.args[0].loc, "capacity must be Int")
        }
        return self.t_buf()
      }
      self.fail(expr.loc, "buf_new takes an optional Int capacity")
      return self.t_buf()
    }
    expected: Ty? = nil
    if has_want {
      expected = want
    }
    return self.dispatch_call(expr, expected)
  }

  pub fn fit_call_arg(expr: Expr, got: Ty, want: Ty): Ty {
    if ty_assignable(got, want) {
      return got
    }
    if expr.kind == ex_int() {
      widened = self.check_integer(expr, true, want)
      if ty_assignable(widened, want) {
        expr.ty = widened
        return widened
      }
    }
    got
  }

  pub fn check_args(expr: Expr, params: Array(Ty), label: String) {
    if expr.args.size != params.size {
      self.fail(expr.loc, "${label} takes ${params.size} arguments, got ${expr.args.size}")
      return
    }
    i = 0
    while i < expr.args.size {
      call_arg = expr.args[i]
      got = self.t_int()
      if params[i].is_fn {
        if call_arg.kind == ex_name() {
          if local = self.lookup(call_arg.ident) {
            got = self.check_expr_as(call_arg, params[i])
          } else {
            got = self.check_fn_arg(call_arg, params[i])
          }
        } else {
          got = self.check_fn_arg(call_arg, params[i])
        }
      } else {
        got = self.check_expr_as(call_arg, params[i])
      }
      if !ty_assignable(got, params[i]) {
        n = i + 1
        self.fail(call_arg.loc, "argument ${n} of ${label} is ${got.show}, expected ${params[i].show}")
      }
      i += 1
    }
  }

  pub fn check_constructor(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    recv = self.flatten_type_chain(recv)
    if recv.kind == ex_name() && recv.ident == "Buf" && recv.type_args.size == 0 && recv.mod_name.size == 0 {
      // `Buf.new` and `Buf.new(cap)` are `buf_new()` and `buf_new(cap)`
      // (Stage 29 W1a, A5; before, "unknown type Buf").
      expr.callee = "buf_new"
      expr.receiver = nil
      return self.check_call(expr, has_want, want)
    }
    if recv.kind == ex_name() {
      if cdef = self.find_class_template(recv.ident, recv.mod_name) {
        if recv.type_args.size > 0 {
          tn = TypeName.new(recv.loc, recv.ident)
          tn.mod_name = recv.mod_name
          for type_arg in recv.type_args {
            tn.args.push(type_arg)
          }
          ty = self.resolve_in_module(tn)
          self.pull_resolve
          if !self.has_err {
            recv.ty = ty
          }
          empty: Array(Ty) = []
          return self.finish_constructor(expr, ty, false, empty)
        }
        return self.infer_new(expr, recv, cdef, recv.mod_name, has_want, want)
      }
    }
    if recv.kind == ex_field() {
      if obj = recv.object {
        if obj.kind == ex_name() {
          if cdef = self.find_class_template(recv.ident, obj.ident) {
            return self.infer_new(expr, recv, cdef, obj.ident, has_want, want)
          }
        }
      }
    }
    if ty = self.type_from_recv(recv, expr.loc) {
      recv.ty = ty
      if ty.template {
        self.fail(expr.loc, "${ty.name} needs type arguments")
        return self.t_int()
      }
      empty: Array(Ty) = []
      return self.finish_constructor(expr, ty, false, empty)
    }
    self.t_int()
  }

  pub fn template_initialize(cdef: ClassDef): Function? {
    for method in cdef.methods {
      if method.name == "initialize" {
        return method
      }
    }
    nil
  }

  pub fn infer_new(expr: Expr, recv: Expr, cdef: ClassDef, mod_name: String, has_want: Bool, want: Ty): Ty {
    params = cdef.type_params
    keys: Array(String) = []
    vals: Array(Ty) = []
    if !self.apply_want_args(cdef.name, params, has_want, want, keys, vals) {
      self.fail(expr.loc, "conflicting type arguments")
      return self.t_int()
    }
    pre: Array(Ty) = []
    if init = self.template_initialize(cdef) {
      self.resolver.set_tparams(params)
      pats: Array(Ty) = []
      i = 0
      while i < init.params.size {
        pats.push(self.resolver.resolve_value(init.params[i].type))
        self.pull_resolve
        i += 1
      }
      self.resolver.clear_tparams
      i = 0
      while i < expr.args.size {
        got = self.t_int()
        if i < pats.size {
          pat_ty = self.subst_ty(pats[i], keys, vals)
          got = self.check_expr_flag(expr.args[i], true, pat_ty)
          if !self.unify_ty(pat_ty, got, keys, vals) {
            self.fail(expr.args[i].loc, "conflicting type arguments")
          }
        } else {
          got = self.check_expr(expr.args[i])
        }
        pre.push(got)
        i += 1
      }
    } else {
      if expr.args.size != 0 {
        self.fail(expr.loc, "${cdef.name}.new takes no arguments")
        return self.t_int()
      }
    }
    if solved = self.solved_args(params, keys, vals, expr.loc) {
      ty = self.instantiate_applied(cdef.name, mod_name, solved, expr.loc)
      if self.has_err {
        return self.t_int()
      }
      recv.ty = ty
      return self.finish_constructor(expr, ty, true, pre)
    }
    self.fail(expr.loc, "cannot infer type argument; write ${cdef.name}(...)")
    self.t_int()
  }

  pub fn finish_constructor(expr: Expr, ty: Ty, has_pre: Bool, pre: Array(Ty)): Ty {
    if self.has_err {
      return self.t_int()
    }
    if ty.is_class {
      shown = ty.show
      has_init = false
      for ms in self.methods {
        if ms.owner == ty.name {
          if ms.name == "initialize" {
            has_init = true
          }
        }
      }
      if has_init {
        arg_tys: Array(Ty) = []
        if has_pre {
          i = 0
          while i < pre.size {
            arg_tys.push(pre[i])
            i += 1
          }
        } else {
          ai = 0
          while ai < expr.args.size {
            arg_tys.push(self.check_expr(expr.args[ai]))
            ai += 1
          }
        }
        none: Ty? = nil
        if sig = self.match_method(ty.name, "initialize", arg_tys, none, expr.loc, shown, ty.mod_name) {
          self.fill_defaults(expr, sig.node)
          i = 0
          while i < expr.args.size {
            got = self.t_int()
            if has_pre {
              if i < pre.size {
                got = pre[i]
              } else {
                got = self.check_expr_as(expr.args[i], sig.params[i])
              }
            } else {
              if i < arg_tys.size {
                got = arg_tys[i]
              } else {
                got = self.check_expr_as(expr.args[i], sig.params[i])
              }
            }
            if i < sig.params.size {
              got = self.fit_call_arg(expr.args[i], got, sig.params[i])
              if !ty_assignable(got, sig.params[i]) {
                n = i + 1
                self.fail(expr.args[i].loc, "argument ${n} of ${shown}.new is ${got.show}, expected ${sig.params[i].show}")
              }
            }
            i += 1
          }
        }
      } else {
        if expr.args.size != 0 {
          self.fail(expr.loc, "${shown}.new takes no arguments")
        }
      }
      expr.resolved = ty_owned_symbol(ty, "new")
      return ty
    }
    shown = ty.show
    self.fail(expr.loc, "structs are constructed with ${shown} { fields }, not .new")
    ty
  }

  pub fn check_lib_call(expr: Expr, lib_name: String): Ty {
    key = "${lib_name}.${expr.callee}"
    if id = self.cfun_index.get(key) {
      sig = self.cfuns[id]
      self.check_args(expr, sig.params, "${lib_name}.${expr.callee}")
      if self.has_err {
        return ty_c_view(sig.ret)
      }
      for i in 0..expr.args.size {
        if sig.params[i].is_fn {
          arg = expr.args[i]
          if arg.kind == ex_lambda() {
            if arg.cap_names.size > 0 {
              self.fail(arg.loc, "C callback cannot capture ${arg.cap_names[0]}")
            }
          } else if !arg.fn_ref {
            self.fail(arg.loc, "C callback must be a function name or a lambda that captures nothing")
          }
        }
      }
      expr.lib_name = lib_name
      return ty_c_view(sig.ret)
    }
    self.fail(expr.loc, "unknown function ${lib_name}.${expr.callee}")
    self.t_int()
  }

  pub fn type_name_as_expr(arg: TypeName): Expr {
    if arg.fn_type {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.nilable {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.members.size > 0 {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.args.size == 0 {
      n = Expr.new(ex_name(), arg.loc)
      n.ident = arg.name
      n.mod_name = arg.mod_name
      return n
    }
    call = Expr.new(ex_call(), arg.loc)
    call.callee = arg.name
    if arg.mod_name.size > 0 {
      mod = Expr.new(ex_name(), arg.loc)
      mod.ident = arg.mod_name
      call.receiver = mod
    }
    i = 0
    while i < arg.args.size {
      call.args.push(self.type_name_as_expr(arg.args[i]))
      i += 1
    }
    call
  }

  // The call reading of `name(args).member` (the parser could not tell it
  // from a type application `Name(T).member`, parse_maybe_type_app). The
  // qualifier is the receiver path as written (the parser takes one only
  // from a chain of names), rebuilt as that chain: `self.ts.get(ty)` is a
  // method call on `self.ts`, `m.f(x)` a call in module `m`
  // (flatten_module_receiver). The arguments are the parser's expression
  // reading when it had one (`o.node`, `x?`), else rebuilt from the types.
  pub fn type_app_as_call(recv: Expr): Expr {
    call = Expr.new(ex_call(), recv.loc)
    call.callee = recv.ident
    if recv.mod_name.size > 0 {
      segs = recv.mod_name.split(".")
      path = Expr.new(ex_name(), recv.loc)
      path.ident = segs[0]
      for i in 1..segs.size {
        fa = Expr.new(ex_field(), recv.loc)
        fa.object = path
        fa.ident = segs[i]
        path = fa
      }
      call.receiver = path
    }
    if recv.args.size == recv.type_args.size {
      i = 0
      while i < recv.args.size {
        call.args.push(recv.args[i])
        i += 1
      }
      return call
    }
    for type_arg in recv.type_args {
      call.args.push(self.type_name_as_expr(type_arg))
    }
    call
  }

  // The type reading of `Name(T).member`: the parser's call reading of the
  // arguments (type_app_as_call) is dropped so no later walk meets it.
  pub fn take_type_app(recv: Expr) {
    if recv.kind == ex_name() && recv.type_args.size > 0 {
      none: Array(Expr) = []
      recv.args = none
    }
  }

  pub fn rewrite_type_app_call(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    call = self.type_app_as_call(recv)
    expr.receiver = call
    self.check_method_call(expr, call, has_want, want)
  }

  pub fn ident_chain(expr: Expr, segs: Array(String)): Bool {
    if expr.kind == ex_name() {
      segs.push(expr.ident)
      return true
    }
    if expr.kind == ex_field() {
      if obj = expr.object {
        if self.ident_chain(obj, segs) {
          segs.push(expr.ident)
          return true
        }
      }
    }
    false
  }

  pub fn join_segs(segs: Array(String), n: Int): String {
    buf = buf_new()
    for i in 0..n {
      if i > 0 {
        buf.push_str(".")
      }
      buf.push_str(segs[i])
    }
    buf.to_s
  }

  pub fn longest_module(segs: Array(String), allow_full: Bool): Int {
    limit = segs.size
    if !allow_full {
      if segs.size == 0 {
        return 0
      }
      limit = segs.size - 1
    }
    best = 0
    n = 1
    while n <= limit {
      mod = self.join_segs(segs, n)
      if self.qualifier_ok(mod, self.current_module) {
        best = n
      }
      n += 1
    }
    best
  }

  pub fn flatten_module_receiver(recv: Expr): Expr {
    segs: Array(String) = []
    if self.ident_chain(recv, segs) && segs.size > 1 {
      best = self.longest_module(segs, true)
      if best == segs.size {
        mod = self.join_segs(segs, best)
        name_expr = Expr.new(ex_name(), recv.loc)
        name_expr.ident = mod
        return name_expr
      }
    }
    recv
  }

  pub fn flatten_type_chain(recv: Expr): Expr {
    segs: Array(String) = []
    if self.ident_chain(recv, segs) && segs.size > 2 {
      best = self.longest_module(segs, false)
      if best > 0 && best == segs.size - 1 {
        mod = self.join_segs(segs, best)
        name_expr = Expr.new(ex_name(), recv.loc)
        name_expr.ident = mod
        flat = Expr.new(ex_field(), recv.loc)
        flat.object = name_expr
        flat.ident = segs[best]
        return flat
      }
    }
    recv
  }

  pub fn check_method_call(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    recv = self.flatten_module_receiver(recv)
    if expr.callee == "new" {
      recv = self.flatten_type_chain(recv)
    }
    expr.receiver = recv
    if recv.kind == ex_name() && recv.type_args.size > 0 {
      if self.is_generic_template(recv.ident) {
        self.take_type_app(recv)
        if expr.callee == "new" {
        } else {
          self.fail(recv.loc, "${recv.ident} is a type")
          return self.t_int()
        }
      } else {
        if expr.callee == "new" {
          if f = self.find_fn(recv.ident) {
          } else if v = self.lookup(recv.ident) {
          } else {
            // `Channel(Int).new` with no such generic type (Stage 29
            // W1a): before, the call reading said "new is a type
            // constructor".
            self.fail(recv.loc, "unknown type ${recv.ident}")
            return self.t_int()
          }
        }
        return self.rewrite_type_app_call(expr, recv, has_want, want)
      }
    }
    if recv.kind == ex_name() {
      if found = self.lookup(recv.ident) {
      } else {
        if !(recv.type_args.size > 0) {
          if self.names_std_gc(recv.ident) {
            return self.check_gc_call(expr)
          }
          if id = self.lib_names.get(recv.ident) {
            if self.lib_is_visible(recv.ident, self.current_module) {
              return self.check_lib_call(expr, recv.ident)
            }
            self.fail(recv.loc, "unknown name ${recv.ident}")
            return self.t_int()
          }
          if k = self.known_mods.get(recv.ident) {
            if self.qualifier_ok(recv.ident, self.current_module) {
              return self.dispatch_qualified_call(expr, recv.ident)
            }
          }
        }
      }
    }
    if expr.callee == "new" {
    } else {
      if ty = self.type_call_target(recv, expr.callee) {
        return self.check_type_call(expr, ty)
      }
    }
    if expr.callee == "new" {
      return self.check_constructor(expr, recv, has_want, want)
    }
    if expr.callee == "send" {
      for arg in expr.args {
        if self.expr_is_place(arg) {
          self.fail(arg.loc, "mutex place cannot escape")
          return self.t_void()
        }
      }
    }
    if recv.kind == ex_name() {
      if recv.ident == "String" {
        if expr.callee == "from_utf8" {
          if expr.args.size != 1 {
            self.fail(expr.loc, "String.from_utf8 takes one Bytes")
            return ty_nilable(self.t_string())
          }
          got = self.check_expr_as(expr.args[0], self.t_bytes())
          if !got.is_bytes {
            self.fail(expr.args[0].loc, "String.from_utf8 expects Bytes")
          }
          return ty_nilable(self.t_string())
        }
      }
    }
    object = self.check_expr(recv)
    if expr.callee == "or" {
      if b = expr.block {
        self.fail(expr.loc, "or does not take a block")
        return object
      }
      if expr.args.size == 1 {
        if object.is_nilable {
          return self.coalesce_result(object, expr.args[0], expr.loc, "or")
        }
        self.check_expr(expr.args[0])
        self.fail(expr.loc, "or needs a nilable receiver, got ${object.show}")
        return object
      }
      self.fail(expr.loc, "or takes one fallback")
      return object
    }
    if expr.callee == "with" {
      if self.is_mutex_ty(object) {
        return self.check_mutex_with(expr, object)
      }
    }
    if expr.callee == "size" && expr.args.size == 0 {
      if b = expr.block {
      } else if object.is_string || object.is_bytes || object.is_array || object.is_hash || object.is_buf {
        // `xs.size()` is `xs.size` (A5: one rule for empty parentheses).
        expr.kind = ex_field()
        expr.ident = "size"
        expr.object = recv
        expr.receiver = nil
        return self.t_int()
      }
    }
    if object.is_float || object.is_integer || object.is_string || object.is_bytes || object.is_array || object.is_hash || object.is_buf || object.is_join {
      return self.builtin_method(expr, object)
    }
    expected: Ty? = nil
    if has_want {
      expected = want
    }
    if object.is_agg {
      return self.dispatch_method(expr, object, expected)
    }
    if object.is_ptr {
      return self.dispatch_method(expr, object, expected)
    }
    self.fail(expr.loc, "cannot call ${expr.callee} on ${object.show}")
    self.t_int()
  }

  pub fn check_block_void(block: Block, pname: String, pty: Ty) {
    self.push_scope
    self.bind(pname, pty)
    self.check_body(block.body, self.t_void(), false)
    self.pop_scope
  }

  pub fn check_switch(expr: Expr, has_want: Bool, want: Ty): Ty {
    if cond = expr.cond {
      ct = self.check_expr(cond)
      if !ct.is_int && !ct.is_bool {
        self.fail(cond.loc, "switch discriminant must be Int or Bool, got ${ct.show}")
      }
    }
    seen = Hash(Int, Int).new
    for arm in expr.cases {
      if arm.labels.size == 0 {
        self.fail(arm.loc, "case needs a label")
      }
      for label in arm.labels {
        lab = label.to_i
        if prev = seen.get(lab) {
          self.fail(arm.loc, "duplicate case ${lab}")
        }
        seen[lab] = 1
      }
    }
    branch_tys: Array(Ty) = []
    i = 0
    while i < expr.cases.size {
      branch_tys.push(self.check_switch_branch(expr.cases[i].body, has_want, want))
      i += 1
    }
    if expr.has_else {
      branch_tys.push(self.check_switch_branch(expr.else_body, has_want, want))
    }
    all_void = true
    any_void = false
    for i in 0..branch_tys.size {
      if branch_tys[i].is_void {
        any_void = true
      } else {
        all_void = false
      }
    }
    if all_void {
      return self.t_void()
    }
    if any_void {
      self.fail(expr.loc, "switch cases must all produce a value, or none")
      return self.t_int()
    }
    if !expr.has_else {
      self.fail(expr.loc, "switch expression needs else")
      return self.t_int()
    }
    if has_want && !want.is_void {
      for branch_ty in branch_tys {
        if !ty_assignable(branch_ty, want) {
          self.fail(expr.loc, "switch branch is ${branch_ty.show}, expected ${want.show}")
        }
      }
      return want
    }
    if branch_tys.size == 0 {
      return self.t_void()
    }
    result = branch_tys[0]
    for branch_ty in branch_tys {
      if !branch_ty.same_as(result) {
        self.fail(expr.loc, "switch branches have different types ${result.show} and ${branch_ty.show}")
      }
    }
    result
  }

  pub fn check_spawn(expr: Expr): Ty {
    if expr.args.size != 0 {
      self.fail(expr.loc, "spawn takes a block, not arguments")
      return ty_join(self.t_int())
    }
    if b = expr.block {
      if b.params.size != 0 {
        self.fail(b.loc, "spawn { } does not take block parameters; use items.parallel")
        return ty_join(self.t_int())
      }
      self.in_task += 1
      saved_loops = self.loop_depth
      self.loop_depth = 0
      saved_try = self.try_in
      self.try_in = "a spawn block"
      result = self.check_block_value(b)
      self.try_in = saved_try
      self.loop_depth = saved_loops
      self.in_task -= 1
      if !result.is_int {
        self.fail(b.loc, "spawn result must be Int")
      }
      self.collect_spawn_captures(expr, b.body)
      return ty_join(result)
    }
    self.fail(expr.loc, "spawn needs a block")
    ty_join(self.t_int())
  }

  pub fn check_block_value(block: Block): Ty {
    if block.body.size == 0 {
      self.fail(block.loc, "block needs a value")
      return self.t_int()
    }
    self.push_scope
    last = block.body[block.body.size - 1]
    i = 0
    while i < block.body.size {
      stmt = block.body[i]
      if i == block.body.size - 1 {
        if stmt.kind == st_return() && self.place_depth > 0 {
          self.fail(stmt.loc, "return inside Mutex.with")
          self.pop_scope
          return self.t_int()
        }
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            ty = self.check_expr(e)
            if ty.is_void {
              self.fail(stmt.loc, "block must end with a value")
              self.pop_scope
              return self.t_int()
            }
            self.pop_scope
            return ty
          }
        }
        self.fail(stmt.loc, "block must end with a value")
        self.pop_scope
        return self.t_int()
      }
      self.check_stmt(stmt, self.t_void(), false)
      i += 1
    }
    self.pop_scope
    self.t_int()
  }

  pub fn expr_is_place(expr: Expr): Bool {
    if self.place_depth > 0 && expr.kind == ex_name() && expr.ident == self.place_name {
      return true
    }
    false
  }

  pub fn reject_place_assign(stmt: Stmt): Bool {
    if !(self.place_depth > 0) {
      return false
    }
    if value = stmt.value {
      if !self.expr_is_place(value) {
        return false
      }
    } else {
      return false
    }
    if target = stmt.target {
      if target.kind == ex_name() && target.ident == self.place_name {
        return false
      }
      if target.kind == ex_field() {
        if obj = target.object {
          if obj.kind == ex_name() && obj.ident == self.place_name {
            return false
          }
        }
      }
    }
    self.fail(stmt.loc, "mutex place cannot escape")
    true
  }

  pub fn is_mutex_ty(ty: Ty): Bool {
    if ty.origin == "Mutex" {
      return true
    }
    ty.name == "Mutex"
  }

  pub fn check_mutex_with(expr: Expr, object: Ty): Ty {
    if expr.args.size != 0 {
      self.fail(expr.loc, "Mutex.with takes a block")
      return self.t_void()
    }
    if b = expr.block {
      if b.params.size != 1 {
        self.fail(b.loc, "Mutex.with { |x| } takes one block parameter")
        return self.t_void()
      }
      if object.ty_args.size != 1 {
        self.fail(expr.loc, "Mutex needs one type argument")
        return self.t_void()
      }
      t = object.ty_args[0]
      if cell = object.field_named("cell") {
        if !cell.same_as(t) {
          self.fail(expr.loc, "Mutex cell has the wrong type")
          return self.t_void()
        }
      } else {
        self.fail(expr.loc, "Mutex needs a cell field")
        return self.t_void()
      }
      if gate = object.field_named("gate") {
        if !gate.is_uint64 {
          self.fail(expr.loc, "Mutex needs a gate field")
          return self.t_void()
        }
      } else {
        self.fail(expr.loc, "Mutex needs a gate field")
        return self.t_void()
      }
      saved_name = self.place_name
      saved_depth = self.place_depth
      self.push_scope
      self.bind(b.params[0], t)
      self.place_name = b.params[0]
      self.place_depth += 1
      // As `return`, a `break` or `continue` cannot leave the block: the
      // lock is released at its end only (W10b: both back ends hung).
      saved_loops = self.loop_depth
      self.loop_depth = 0
      result = self.check_block_value(b)
      self.loop_depth = saved_loops
      self.place_name = saved_name
      self.place_depth = saved_depth
      self.pop_scope
      return result
    }
    self.fail(expr.loc, "Mutex.with needs a block")
    self.t_void()
  }

  pub fn check_gate_call(expr: Expr): Ty? {
    if expr.callee == "avant_gate_new" {
      if expr.args.size == 0 {
        if b = expr.block {
          self.fail(expr.loc, "avant_gate_new takes no arguments")
          return self.t_uint64()
        }
        return self.t_uint64()
      }
      self.fail(expr.loc, "avant_gate_new takes no arguments")
      return self.t_uint64()
    }
    is_gate = false
    if expr.callee == "avant_gate_lock" {
      is_gate = true
    }
    if expr.callee == "avant_gate_unlock" {
      is_gate = true
    }
    if expr.callee == "avant_gate_wait" {
      is_gate = true
    }
    if expr.callee == "avant_gate_signal" {
      is_gate = true
    }
    if expr.callee == "avant_gate_broadcast" {
      is_gate = true
    }
    if is_gate {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "${expr.callee} takes one UInt64")
          return self.t_void()
        }
      } else {
        self.fail(expr.loc, "${expr.callee} takes one UInt64")
        return self.t_void()
      }
      got = self.check_expr_as(expr.args[0], self.t_uint64())
      if !got.is_uint64 {
        self.fail(expr.args[0].loc, "${expr.callee} expects UInt64")
      }
      return self.t_void()
    }
    nil
  }

  pub fn check_join(expr: Expr, handle: Ty): Ty {
    if expr.callee == "join" {
      if self.in_task > 0 {
        self.fail(expr.loc, "join inside a pool worker")
      }
    } else {
      self.fail(expr.loc, "no method ${expr.callee} on JoinHandle")
      if inner = handle.inner {
        return inner
      }
      return self.t_int()
    }
    if expr.args.size == 0 {
      if b = expr.block {
        self.fail(expr.loc, "join takes no arguments")
      }
    } else {
      self.fail(expr.loc, "join takes no arguments")
    }
    if inner = handle.inner {
      return inner
    }
    self.t_int()
  }

  pub fn check_switch_branch(body: Array(Stmt), has_want: Bool, want: Ty): Ty {
    self.push_scope
    if body.size == 0 {
      self.pop_scope
      return self.t_void()
    }
    i = 0
    while i < body.size {
      stmt = body[i]
      if i == body.size - 1 {
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            use_want = false
            use_ty = self.t_int()
            if has_want && !want.is_void {
              use_want = true
              use_ty = want
            }
            ty = self.check_expr_flag(e, use_want, use_ty)
            self.pop_scope
            return ty
          }
        }
        self.check_stmt(stmt, self.t_void(), false)
        self.pop_scope
        return self.t_void()
      }
      self.check_stmt(stmt, self.t_void(), false)
      i += 1
    }
    self.pop_scope
    self.t_void()
  }
}

// Whether a C layout has a field that holds a reference (a `String`,
// directly or in a nested layout): what `release` gives back (D266).
pub fn clayout_holds_ref(t: Ty): Bool {
  for field in t.fields {
    ft = field.ty
    if ft.is_string {
      return true
    }
    if ft.is_clayout && clayout_holds_ref(ft) {
      return true
    }
  }
  false
}
