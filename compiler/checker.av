  pub fn check_mutex_with(expr: Expr, object: Ty): Ty {
    if expr.args.size != 0 {
      self.fail(expr.loc, "Mutex.with takes a block")
      return self.t_void()
    }
    if b = expr.block {
      if b.params.size == 1 {
      } else {
        self.fail(b.loc, "Mutex.with { |x| } takes one block parameter")
        return self.t_void()
      }
      if object.ty_args.size == 1 {
      } else {
        self.fail(expr.loc, "Mutex needs one type argument")
        return self.t_void()
      }
      t = object.ty_args[0]
      if cell = object.field_named("cell") {
        if cell.same_as(t) {
        } else {
          self.fail(expr.loc, "Mutex cell has the wrong type")
          return self.t_void()
        }
      } else {
        self.fail(expr.loc, "Mutex needs a cell field")
        return self.t_void()
      }
      if gate = object.field_named("gate") {
        if gate.is_uint64 {
        } else {
          self.fail(expr.loc, "Mutex needs a gate field")
          return self.t_void()
        }
      } else {
        self.fail(expr.loc, "Mutex needs a gate field")
        return self.t_void()
      }
      saved_name = self.place_name
      saved_depth = self.place_depth
      self.push_scope
      self.bind(b.params[0], t)
      self.place_name = b.params[0]
      self.place_depth = self.place_depth + 1
      result = self.check_block_value(b)
      self.place_name = saved_name
      self.place_depth = saved_depth
      self.pop_scope
      return result
    }
    self.fail(expr.loc, "Mutex.with needs a block")
    self.t_void()
  }

