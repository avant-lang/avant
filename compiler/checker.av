pub class ImplFact {
  type_key: String = ""
  iface_key: String = ""
  mod_name: String = ""
  vis: Bool = false

  fn initialize {
  }
}

pub fn str_index(names: Array(String), name: String): Int {
  i = 0
  while i < names.size {
    if str_eq(names[i], name) {
      return i
    }
    i = i + 1
  }
  0 - 1
}

pub fn iface_key_of(name: String, args: Array(Ty)): String {
  if args.size == 0 {
    return name
  }
  buf = buf_new()
  buf.push_str(name)
  i = 0
  while i < args.size {
    buf.push_str("__")
    buf.push_str(mangle_ty(args[i]))
    i = i + 1
  }
  buf.to_s
}

pub fn impl_type_key(ty: Ty): String {
  if ty.is_ptr {
    return mangle_ty(ty)
  }
  ty.name
}

pub fn ty_eq_sig(a: Ty, b: Ty, ap: Array(String), bp: Array(String)): Bool {
  if a.is_var {
    if b.is_var {
      ia = str_index(ap, a.name)
      ib = str_index(bp, b.name)
      if ia < 0 {
        return false
      }
      return ia == ib
    }
    return false
  }
  if b.is_var {
    return false
  }
  if a.kind != b.kind {
    return false
  }
  if a.is_fn {
    if a.members.size != b.members.size {
      return false
    }
    i = 0
    while i < a.members.size {
      if ty_eq_sig(a.members[i], b.members[i], ap, bp) {
      } else {
        return false
      }
      i = i + 1
    }
    if ar = a.inner {
      if br = b.inner {
        return ty_eq_sig(ar, br, ap, bp)
      }
    }
    return false
  }
  if a.is_union {
    if a.members.size != b.members.size {
      return false
    }
    i = 0
    while i < a.members.size {
      if ty_eq_sig(a.members[i], b.members[i], ap, bp) {
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  if a.is_ptr {
    if ae = a.inner {
      if be = b.inner {
        return ty_eq_sig(ae, be, ap, bp)
      }
    }
    return false
  }
  if a.is_array {
    if ae = a.inner {
      if be = b.inner {
        return ty_eq_sig(ae, be, ap, bp)
      }
    }
    return false
  }
  if a.is_join {
    if ae = a.inner {
      if be = b.inner {
        return ty_eq_sig(ae, be, ap, bp)
      }
    }
    return false
  }
  if a.is_hash {
    if ak = a.key {
      if av = a.val {
        if bk = b.key {
          if bv = b.val {
            if ty_eq_sig(ak, bk, ap, bp) {
              return ty_eq_sig(av, bv, ap, bp)
            }
          }
        }
      }
    }
    return false
  }
  a.same_as(b)
}

pub class Scope {
  names: Hash(String, Int)

  fn initialize {
    n = Hash(String, Int).new
    self.names = n
  }
}

pub class Checker {
  source: Source
  program: Program
  resolver: TypeResolver
  functions: Array(FuncSig)
  fn_index: Hash(String, Int)
  methods: Array(FuncSig)
  method_index: Hash(String, Int)
  cfuns: Array(CFunSig)
  cfun_index: Hash(String, Int)
  lib_names: Hash(String, Int)
  c_symbols: Hash(String, String)
  reserved: Hash(String, Int)
  scopes: Array(Scope)
  failed: Bool = false
  err: CompileError? = nil
  errors: DiagBag
  resolver_pulled: Int = 0
  poisoned: Bool = false
  return_type: Ty
  loop_depth: Int = 0
  self_ty: Ty? = nil
  self_name: String = ""
  pending: Array(Function)
  instances: Array(Function)
  next_ol: Int = 1
  current_module: String = ""
  root_module: String = ""
  type_mod: Hash(String, String)
  type_vis: Hash(String, Int)
  lib_mod: Hash(String, String)
  lib_vis: Hash(String, Int)
  known_mods: Hash(String, Int)
  current_fn: Function? = nil
  lam_exprs: Array(Expr)
  lam_scopes: Array(Int)
  lambda_infer: Bool = false
  inferred_ret: Ty
  spawn_skip: Array(String)
  pending_handles: Array(String)
  pending_arrays: Array(String)
  fact_var: Array(String)
  fact_cont: Array(String)
  fact_slack: Array(Int)
  fact_live: Array(Int)
  sv_var: Array(String)
  sv_cont: Array(String)
  bv_var: Array(String)
  bv_cont: Array(String)
  bv_delta: Array(Int)
  cs_cont: Array(String)
  cs_var: Array(String)
  cs_delta: Array(Int)
  nn_var: Array(String)
  adopted: Hash(String, Int)
  adopt_pending: Bool = false
  ready_adopt: Bool = false
  in_adopt: Bool = false
  in_task: Int = 0
  place_name: String = ""
  place_depth: Int = 0
  witness_note: String = ""
  impls: Array(ImplFact)
  sig_params: Array(Ty)
  sig_ret: Ty
  sig_vars: Array(String)
  wit_params: Array(Ty)
  wit_ret: Ty
  wit_vars: Array(String)

  fn initialize(source: Source, program: Program) {
    self.source = source
    self.program = program
    self.resolver = TypeResolver.new
    fns: Array(FuncSig) = []
    dummy_fn = Function.new(program.loc, "")
    dummy_params: Array(Ty) = []
    fns.push(FuncSig.new("", dummy_fn, dummy_params, ty_void()))
    self.functions = fns
    fi = Hash(String, Int).new
    self.fn_index = fi
    ms: Array(FuncSig) = []
    self.methods = ms
    mi = Hash(String, Int).new
    self.method_index = mi
    cf: Array(CFunSig) = []
    self.cfuns = cf
    cfi = Hash(String, Int).new
    self.cfun_index = cfi
    ln = Hash(String, Int).new
    self.lib_names = ln
    cs = Hash(String, String).new
    self.c_symbols = cs
    self.reserved = reserved_c_names()
    sc: Array(Scope) = []
    self.scopes = sc
    self.failed = false
    self.err = nil
    self.errors = DiagBag.new
    self.resolver_pulled = 0
    self.poisoned = false
    self.return_type = ty_void()
    self.loop_depth = 0
    self.self_name = ""
    pend: Array(Function) = []
    self.pending = pend
    insts: Array(Function) = []
    self.instances = insts
    self.next_ol = 1
    self.current_module = ""
    self.root_module = ""
    tm = Hash(String, String).new
    self.type_mod = tm
    tv = Hash(String, Int).new
    self.type_vis = tv
    lm = Hash(String, String).new
    self.lib_mod = lm
    lv = Hash(String, Int).new
    self.lib_vis = lv
    km = Hash(String, Int).new
    self.known_mods = km
    le: Array(Expr) = []
    self.lam_exprs = le
    ls: Array(Int) = []
    self.lam_scopes = ls
    self.lambda_infer = false
    self.inferred_ret = ty_void()
    ss: Array(String) = []
    self.spawn_skip = ss
    ph: Array(String) = []
    self.pending_handles = ph
    pa: Array(String) = []
    self.pending_arrays = pa
    fv: Array(String) = []
    self.fact_var = fv
    fc: Array(String) = []
    self.fact_cont = fc
    fs: Array(Int) = []
    self.fact_slack = fs
    fl: Array(Int) = []
    self.fact_live = fl
    svv: Array(String) = []
    self.sv_var = svv
    svc: Array(String) = []
    self.sv_cont = svc
    bvv: Array(String) = []
    self.bv_var = bvv
    bvc: Array(String) = []
    self.bv_cont = bvc
    bvd: Array(Int) = []
    self.bv_delta = bvd
    csc: Array(String) = []
    self.cs_cont = csc
    csvv: Array(String) = []
    self.cs_var = csvv
    csd: Array(Int) = []
    self.cs_delta = csd
    nnv: Array(String) = []
    self.nn_var = nnv
    ad = Hash(String, Int).new
    self.adopted = ad
    self.adopt_pending = false
    self.ready_adopt = false
    self.in_adopt = false
    self.in_task = 0
    self.place_name = ""
    self.place_depth = 0
    im: Array(ImplFact) = []
    self.impls = im
    sp: Array(Ty) = []
    self.sig_params = sp
    self.sig_ret = ty_void()
    sv: Array(String) = []
    self.sig_vars = sv
    wp: Array(Ty) = []
    self.wit_params = wp
    self.wit_ret = ty_void()
    wv: Array(String) = []
    self.wit_vars = wv
  }

  pub fn has_err: Bool {
    self.poisoned
  }

  pub fn any_err: Bool {
    self.failed
  }

  pub fn err_count: Int {
    self.errors.count
  }

  pub fn new_err_since(mark: Int): Bool {
    self.errors.count > mark
  }

  pub fn clear_poison {
    self.poisoned = false
  }

  pub fn fail(loc: Location, message: String) {
    e = CompileError.new(loc, diag_code(4, message), message)
    if self.errors.count == 0 {
      self.err = e
    }
    self.failed = true
    self.poisoned = true
    self.errors.push(e)
  }

  pub fn pull_resolve {
    while self.resolver_pulled < self.resolver.errors.count {
      re = self.resolver.errors.items[self.resolver_pulled]
      if self.errors.count == 0 {
        self.err = re
      }
      self.failed = true
      self.poisoned = true
      self.errors.push(re)
      self.resolver_pulled = self.resolver_pulled + 1
    }
    if self.ready_adopt {
      if self.in_adopt {
      } else {
        saved: Array(String) = []
        i = 0
        while i < self.resolver.tparam_names.size {
          saved.push(self.resolver.tparam_names[i])
          i = i + 1
        }
        self.resolver.clear_tparams
        self.adopt_new_types
        self.resolver.set_tparams(saved)
      }
    }
  }

  pub fn intern(ty: Ty): Int {
    self.resolver.intern(ty)
  }

  pub fn push_scope {
    self.scopes.push(Scope.new)
  }

  pub fn pop_scope {
    dummy = self.scopes.pop
  }

  pub fn bind(name: String, ty: Ty) {
    id = self.intern(ty)
    last = self.scopes[self.scopes.size - 1]
    last.names[name] = id
  }

  pub fn lookup(name: String): Ty? {
    i = self.scopes.size - 1
    while i >= 0 {
      sc = self.scopes[i]
      if id = sc.names.get(name) {
        return self.resolver.ty_at(id)
      }
      i = i - 1
    }
    nil
  }

  pub fn lookup_index(name: String): Int {
    i = self.scopes.size - 1
    while i >= 0 {
      sc = self.scopes[i]
      if id = sc.names.get(name) {
        return i
      }
      i = i - 1
    }
    0 - 1
  }

  pub fn note_modules {
    self.root_module = self.program.root_module
    self.current_module = self.root_module
    km = Hash(String, Int).new
    i = 0
    while i < self.program.mods.size {
      info = self.program.mods[i]
      km[info.name] = 1
      j = 0
      while j < info.imports.size {
        km[info.imports[j]] = 1
        j = j + 1
      }
      i = i + 1
    }
    self.known_mods = km
    tm = Hash(String, String).new
    tv = Hash(String, Int).new
    i = 0
    while i < self.program.structs.size {
      sdef = self.program.structs[i]
      tm[sdef.name] = sdef.mod_name
      if sdef.vis {
        tv[sdef.name] = 1
      } else {
        tv[sdef.name] = 0
      }
      i = i + 1
    }
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      tm[cdef.name] = cdef.mod_name
      if cdef.vis {
        tv[cdef.name] = 1
      } else {
        tv[cdef.name] = 0
      }
      i = i + 1
    }
    i = 0
    while i < self.program.interfaces.size {
      idef = self.program.interfaces[i]
      tm[idef.name] = idef.mod_name
      if idef.vis {
        tv[idef.name] = 1
      } else {
        tv[idef.name] = 0
      }
      i = i + 1
    }
    i = 0
    while i < self.program.libs.size {
      lib_def = self.program.libs[i]
      j = 0
      while j < lib_def.layouts.size {
        lay = lib_def.layouts[j]
        tm[lay.name] = lib_def.mod_name
        if lib_def.vis {
          tv[lay.name] = 1
        } else {
          tv[lay.name] = 0
        }
        j = j + 1
      }
      i = i + 1
    }
    self.type_mod = tm
    self.type_vis = tv
  }

  pub fn imported_by(from_mod: String, target: String): Bool {
    if str_eq(from_mod, target) {
      return true
    }
    i = 0
    while i < self.program.mods.size {
      info = self.program.mods[i]
      if str_eq(info.name, from_mod) {
        j = 0
        while j < info.imports.size {
          if str_eq(info.imports[j], target) {
            return true
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    false
  }

  pub fn qualifier_ok(qual: String, from_mod: String): Bool {
    if str_eq(qual, from_mod) {
      return true
    }
    self.imported_by(from_mod, qual)
  }

  pub fn type_is_visible(name: String, from_mod: String, qual: String): Bool {
    if named = self.resolver.get_named(name) {
    } else {
      return true
    }
    owner = from_mod
    if o = self.type_mod.get(name) {
      owner = o
    }
    if qual.size > 0 {
      if str_eq(owner, qual) {
      } else {
        return false
      }
      if self.qualifier_ok(qual, from_mod) {
      } else {
        return false
      }
      if str_eq(owner, from_mod) {
        return true
      }
      if v = self.type_vis.get(name) {
        return v == 1
      }
      return false
    }
    if str_eq(owner, from_mod) {
      return true
    }
    if v = self.type_vis.get(name) {
      if v == 1 {
        return self.imported_by(from_mod, owner)
      }
    }
    false
  }

  pub fn lib_is_visible(name: String, from_mod: String): Bool {
    owner = from_mod
    if o = self.lib_mod.get(name) {
      owner = o
    }
    if str_eq(owner, from_mod) {
      return true
    }
    if v = self.lib_vis.get(name) {
      if v == 1 {
        return self.imported_by(from_mod, owner)
      }
    }
    false
  }

  pub fn fn_is_visible(fnn: Function, from_mod: String): Bool {
    if str_eq(fnn.mod_name, from_mod) {
      return true
    }
    if fnn.mod_name.size == 0 {
      return true
    }
    if from_mod.size == 0 {
      return true
    }
    if fnn.vis {
      return self.imported_by(from_mod, fnn.mod_name)
    }
    false
  }

  pub fn method_is_visible(fnn: Function, from_mod: String): Bool {
    if fnn.vis {
      return true
    }
    if str_eq(fnn.name, "initialize") {
      return true
    }
    if str_eq(fnn.mod_name, from_mod) {
      return true
    }
    if fnn.mod_name.size == 0 {
      return true
    }
    if from_mod.size == 0 {
      return true
    }
    false
  }

  pub fn clash_unqualified(name: String, from_mod: String): Bool {
    origins: Array(String) = []
    if o = self.type_mod.get(name) {
      if self.type_is_visible(name, from_mod, "") {
        origins.push("type:${o}")
      }
    }
    if id = self.lib_names.get(name) {
      if self.lib_is_visible(name, from_mod) {
        owner = from_mod
        if o = self.lib_mod.get(name) {
          owner = o
        }
        origins.push("lib:${owner}")
      }
    }
    fn_mods = Hash(String, Int).new
    i = 1
    while i < self.functions.size {
      sig = self.functions[i]
      if str_eq(sig.name, name) {
        if self.fn_is_visible(sig.node, from_mod) {
          if seen = fn_mods.get(sig.node.mod_name) {
          } else {
            fn_mods[sig.node.mod_name] = 1
            origins.push("fn:${sig.node.mod_name}")
          }
        }
      }
      i = i + 1
    }
    type_owners = 0
    has_type = false
    has_fn = false
    i = 0
    while i < origins.size {
      o = origins[i]
      if o.size >= 5 {
        if str_eq(str_slice(o, 0, 5), "type:") {
          type_owners = type_owners + 1
          has_type = true
        } else if str_eq(str_slice(o, 0, 4), "lib:") {
          type_owners = type_owners + 1
          has_type = true
        } else if str_eq(str_slice(o, 0, 3), "fn:") {
          has_fn = true
        }
      }
      i = i + 1
    }
    if type_owners > 1 {
      return true
    }
    if type_owners >= 1 {
      if has_fn {
        return true
      }
    }
    false
  }

  pub fn lookup_named_type(name: String, loc: Location, qual: String): Ty? {
    if self.clash_unqualified(name, self.current_module) {
      if qual.size == 0 {
        self.fail(loc, "ambiguous name ${name}; qualify it")
        return nil
      }
    }
    if ty = self.resolver.get_named(name) {
      if self.type_is_visible(name, self.current_module, qual) {
      } else {
        self.fail(loc, "unknown type ${name}")
        return nil
      }
      if qual.size > 0 {
        owner = ""
        if o = self.type_mod.get(name) {
          owner = o
        }
        if str_eq(owner, qual) {
        } else {
          self.fail(loc, "unknown type ${qual}.${name}")
          return nil
        }
      }
      return ty
    }
    self.fail(loc, "unknown type ${name}")
    nil
  }

  pub fn resolve_in_module(tn: TypeName): Ty {
    if tn.mod_name.size > 0 {
      if self.qualifier_ok(tn.mod_name, self.current_module) {
      } else {
        self.fail(tn.loc, "unknown module ${tn.mod_name}")
        return self.t_int()
      }
      if named = self.resolver.get_named(tn.name) {
        owner = ""
        if o = self.type_mod.get(tn.name) {
          owner = o
        }
        if str_eq(owner, tn.mod_name) {
        } else {
          self.fail(tn.loc, "unknown type ${tn.mod_name}.${tn.name}")
          return self.t_int()
        }
        if self.type_is_visible(tn.name, self.current_module, tn.mod_name) {
        } else {
          self.fail(tn.loc, "unknown type ${tn.mod_name}.${tn.name}")
          return self.t_int()
        }
      } else {
        self.fail(tn.loc, "unknown type ${tn.mod_name}.${tn.name}")
        return self.t_int()
      }
    } else {
      if named = self.resolver.get_named(tn.name) {
        if self.clash_unqualified(tn.name, self.current_module) {
          self.fail(tn.loc, "ambiguous name ${tn.name}; qualify it")
          return self.t_int()
        }
        if self.type_is_visible(tn.name, self.current_module, "") {
        } else {
          self.fail(tn.loc, "unknown type ${tn.name}")
          return self.t_int()
        }
      }
    }
    self.resolver.resolve(tn)
  }

  pub fn resolve_value_in_module(tn: TypeName): Ty {
    if tn.mod_name.size > 0 {
      if self.qualifier_ok(tn.mod_name, self.current_module) {
      } else {
        self.fail(tn.loc, "unknown module ${tn.mod_name}")
        return self.t_int()
      }
    } else {
      if named = self.resolver.get_named(tn.name) {
        if self.type_is_visible(tn.name, self.current_module, "") {
        } else {
          self.fail(tn.loc, "unknown type ${tn.name}")
          return self.t_int()
        }
        if self.clash_unqualified(tn.name, self.current_module) {
          self.fail(tn.loc, "ambiguous name ${tn.name}; qualify it")
          return self.t_int()
        }
      }
    }
    self.resolver.resolve_value(tn)
  }

  pub fn ensure_pub_sig_ty(ty: Ty, loc: Location, fnn: Function) {
    if fnn.vis {
    } else {
      return
    }
    if ty.is_agg {
      owner = fnn.mod_name
      if o = self.type_mod.get(ty.name) {
        owner = o
      }
      if str_eq(owner, fnn.mod_name) {
      } else {
        vis = 0
        if flag = self.type_vis.get(ty.name) {
          vis = flag
        }
        if vis == 1 {
        } else {
          self.fail(loc, "pub signature cannot use private type ${ty.name}")
        }
      }
      return
    }
    if ty.is_array {
      if elem = ty.inner {
        self.ensure_pub_sig_ty(elem, loc, fnn)
      }
      return
    }
    if ty.is_hash {
      if hk = ty.key {
        self.ensure_pub_sig_ty(hk, loc, fnn)
      }
      if hv = ty.val {
        self.ensure_pub_sig_ty(hv, loc, fnn)
      }
      return
    }
    if ty.is_ptr {
      if pin = ty.inner {
        self.ensure_pub_sig_ty(pin, loc, fnn)
      }
      return
    }
    if ty.is_clayout {
      owner = fnn.mod_name
      if o = self.type_mod.get(ty.name) {
        owner = o
      }
      if str_eq(owner, fnn.mod_name) {
      } else {
        vis = 0
        if flag = self.type_vis.get(ty.name) {
          vis = flag
        }
        if vis == 1 {
        } else {
          self.fail(loc, "pub signature cannot use private type ${ty.name}")
        }
      }
      return
    }
    if ty.is_join {
      if jin = ty.inner {
        self.ensure_pub_sig_ty(jin, loc, fnn)
      }
      return
    }
    if ty.is_union {
      i = 0
      while i < ty.members.size {
        self.ensure_pub_sig_ty(ty.members[i], loc, fnn)
        i = i + 1
      }
      return
    }
    if ty.is_fn {
      i = 0
      while i < ty.members.size {
        self.ensure_pub_sig_ty(ty.members[i], loc, fnn)
        i = i + 1
      }
      if r = ty.inner {
        self.ensure_pub_sig_ty(r, loc, fnn)
      }
    }
  }

  pub fn lookup_module_type(mod: String, name: String, loc: Location): Ty? {
    if ty = self.resolver.get_named(name) {
      owner = ""
      if o = self.type_mod.get(name) {
        owner = o
      }
      if str_eq(owner, mod) {
        if self.type_is_visible(name, self.current_module, mod) {
          return ty
        }
      }
    }
    self.fail(loc, "unknown type ${mod}.${name}")
    nil
  }

  pub fn type_from_recv(recv: Expr, loc: Location): Ty? {
    if recv.kind == ex_name() {
      return self.lookup_named_type(recv.ident, recv.loc, "")
    }
    if recv.kind == ex_field() {
      if obj = recv.object {
        object = self.check_expr(obj)
        if object.is_module {
        } else {
          self.fail(loc, "new is a type constructor")
          return nil
        }
        return self.lookup_module_type(object.name, recv.ident, recv.loc)
      }
    }
    self.fail(loc, "new is a type constructor")
    nil
  }

  pub fn dispatch_qualified_call(expr: Expr, mod: String): Ty {
    if str_eq(expr.callee, "new") {
      self.fail(expr.loc, "new is a type constructor")
      return self.t_int()
    }
    saved = self.current_module
    arg_tys: Array(Ty) = []
    i = 0
    while i < expr.args.size {
      arg_tys.push(self.check_expr(expr.args[i]))
      i = i + 1
    }
    self.current_module = mod
    none: Ty? = nil
    if sig = self.match_func(expr.callee, arg_tys, none, expr.loc) {
      if str_eq(sig.node.mod_name, mod) {
      } else {
        self.fail(expr.loc, "unknown function ${mod}.${expr.callee}")
        self.current_module = saved
        return self.t_int()
      }
      self.fill_defaults(expr, sig.node)
      i = 0
      while i < expr.args.size {
        got = self.t_int()
        if i < arg_tys.size {
          got = arg_tys[i]
        } else {
          got = self.check_expr_as(expr.args[i], sig.params[i])
        }
        got = self.fit_call_arg(expr.args[i], got, sig.params[i])
        if ty_assignable(got, sig.params[i]) {
        } else {
          n = i + 1
          self.fail(expr.args[i].loc, "argument ${n} of ${expr.callee} is ${got.show}, expected ${sig.params[i].show}")
        }
        i = i + 1
      }
      expr.resolved = sig.node.emit_name
      expr.receiver = nil
      self.current_module = saved
      return sig.ret
    }
    self.current_module = saved
    self.t_int()
  }

  pub fn find_fn(name: String): FuncSig? {
    if id = self.fn_index.get(name) {
      return self.functions[id]
    }
    nil
  }

  pub fn find_method(owner: String, name: String): FuncSig? {
    key = "${owner}__${name}"
    if id = self.method_index.get(key) {
      return self.methods[id]
    }
    nil
  }

  pub fn symbol_table: SymbolTable {
    table = SymbolTable.new(self.resolver)
    i = 1
    while i < self.functions.size {
      sig = self.functions[i]
      if sig.node.generic {
      } else {
        table.add_function(sig)
      }
      i = i + 1
    }
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      if sig.node.generic {
      } else if self.resolver.has_template(sig.owner) {
      } else {
        table.add_method(sig)
      }
      i = i + 1
    }
    i = 0
    while i < self.cfuns.size {
      table.add_cfun(self.cfuns[i])
      i = i + 1
    }
    table
  }

  pub fn alloc_ol(fnn: Function) {
    fnn.ol_index = self.next_ol
    self.next_ol = self.next_ol + 1
  }

  pub fn check_trailing_defaults(fnn: Function) {
    seen = false
    i = 0
    while i < fnn.params.size {
      p = fnn.params[i]
      if d = p.default {
        seen = true
      } else {
        if seen {
          self.fail(p.loc, "default arguments must be trailing")
          return
        }
      }
      i = i + 1
    }
  }

  pub fn count_named_fns(name: String): Int {
    n = 0
    i = 1
    while i < self.functions.size {
      if str_eq(self.functions[i].name, name) {
        n = n + 1
      }
      i = i + 1
    }
    n
  }

  pub fn count_named_methods(owner: String, name: String): Int {
    n = 0
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      if str_eq(sig.owner, owner) {
        if str_eq(sig.name, name) {
          n = n + 1
        }
      }
      i = i + 1
    }
    n
  }

  pub fn find_sig_by_node(fnn: Function): FuncSig? {
    i = 1
    while i < self.functions.size {
      sig = self.functions[i]
      if sig.node.ol_index == fnn.ol_index {
        return sig
      }
      i = i + 1
    }
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      if sig.node.ol_index == fnn.ol_index {
        return sig
      }
      i = i + 1
    }
    nil
  }

  pub fn find_instance(emit: String): Function? {
    i = 0
    while i < self.instances.size {
      inst = self.instances[i]
      if str_eq(inst.emit_name, emit) {
        return inst
      }
      i = i + 1
    }
    nil
  }

  pub fn subst_get(keys: Array(String), vals: Array(Ty), name: String): Ty? {
    i = 0
    while i < keys.size {
      if str_eq(keys[i], name) {
        return vals[i]
      }
      i = i + 1
    }
    nil
  }

  pub fn subst_put(keys: Array(String), vals: Array(Ty), name: String, ty: Ty): Bool {
    if existing = self.subst_get(keys, vals, name) {
      return existing.same_as(ty)
    }
    keys.push(name)
    vals.push(ty)
    true
  }

  pub fn unify_ty(pattern: Ty, actual: Ty, keys: Array(String), vals: Array(Ty)): Bool {
    if pattern.is_var {
      return self.subst_put(keys, vals, pattern.name, actual)
    }
    if pattern.is_array {
      if actual.is_array {
        if pe = pattern.inner {
          if ae = actual.inner {
            return self.unify_ty(pe, ae, keys, vals)
          }
        }
      }
      return false
    }
    if pattern.is_hash {
      if actual.is_hash {
        if pk = pattern.key {
          if ak = actual.key {
            if pv = pattern.val {
              if av = actual.val {
                if self.unify_ty(pk, ak, keys, vals) {
                  return self.unify_ty(pv, av, keys, vals)
                }
              }
            }
          }
        }
      }
      return false
    }
    if pattern.is_ptr {
      if actual.is_ptr {
        if pe = pattern.inner {
          if ae = actual.inner {
            return self.unify_ty(pe, ae, keys, vals)
          }
        }
      }
      return false
    }
    if pattern.is_join {
      if actual.is_join {
        if pe = pattern.inner {
          if ae = actual.inner {
            return self.unify_ty(pe, ae, keys, vals)
          }
        }
      }
      return false
    }
    if pattern.is_fn {
      if actual.is_fn {
        if pattern.members.size != actual.members.size {
          return false
        }
        i = 0
        while i < pattern.members.size {
          if self.unify_ty(pattern.members[i], actual.members[i], keys, vals) {
          } else {
            return false
          }
          i = i + 1
        }
        if pe = pattern.inner {
          if ae = actual.inner {
            return self.unify_ty(pe, ae, keys, vals)
          }
        }
      }
      return false
    }
    if pattern.origin.size > 0 {
      if str_eq(pattern.origin, actual.origin) {
        if pattern.ty_args.size == actual.ty_args.size {
          i = 0
          while i < pattern.ty_args.size {
            if self.unify_ty(pattern.ty_args[i], actual.ty_args[i], keys, vals) {
            } else {
              return false
            }
            i = i + 1
          }
          return true
        }
      }
      return false
    }
    actual.same_as(pattern)
  }

  pub fn infer_subst(tparams: Array(String), params: Array(Ty), arg_tys: Array(Ty), ret: Ty, expected: Ty?): Array(Ty)? {
    keys: Array(String) = []
    vals: Array(Ty) = []
    i = 0
    while i < params.size {
      if i < arg_tys.size {
        if self.unify_ty(params[i], arg_tys[i], keys, vals) {
        } else {
          return nil
        }
      }
      i = i + 1
    }
    i = 0
    while i < tparams.size {
      name = tparams[i]
      if got = self.subst_get(keys, vals, name) {
      } else {
        if e = expected {
          if e.is_void {
          } else {
            if self.unify_ty(ret, e, keys, vals) {
            } else {
              return nil
            }
          }
        }
      }
      i = i + 1
    }
    out: Array(Ty) = []
    i = 0
    while i < tparams.size {
      if got = self.subst_get(keys, vals, tparams[i]) {
        out.push(got)
      } else {
        return nil
      }
      i = i + 1
    }
    out
  }

  pub fn infer_subst_recv(tparams: Array(String), params: Array(Ty), arg_tys: Array(Ty), ret: Ty, expected: Ty?, pat: Ty, act: Ty): Array(Ty)? {
    keys: Array(String) = []
    vals: Array(Ty) = []
    if str_eq(pat.origin, act.origin) {
      if pat.ty_args.size == act.ty_args.size {
        i = 0
        while i < pat.ty_args.size {
          if self.unify_ty(pat.ty_args[i], act.ty_args[i], keys, vals) {
          } else {
            return nil
          }
          i = i + 1
        }
      } else {
        return nil
      }
    } else {
      return nil
    }
    i = 0
    while i < params.size {
      if i < arg_tys.size {
        if self.unify_ty(params[i], arg_tys[i], keys, vals) {
        } else {
          return nil
        }
      }
      i = i + 1
    }
    i = 0
    while i < tparams.size {
      name = tparams[i]
      if got = self.subst_get(keys, vals, name) {
      } else {
        if e = expected {
          if e.is_void {
          } else {
            if self.unify_ty(ret, e, keys, vals) {
            } else {
              return nil
            }
          }
        }
      }
      i = i + 1
    }
    out: Array(Ty) = []
    i = 0
    while i < tparams.size {
      if got = self.subst_get(keys, vals, tparams[i]) {
        out.push(got)
      } else {
        return nil
      }
      i = i + 1
    }
    out
  }

  pub fn subst_for_method(sig: FuncSig, call_owner: String, arg_tys: Array(Ty), expected: Ty?): Array(Ty)? {
    if recv = sig.node.receiver {
      if str_eq(sig.owner, call_owner) {
      } else {
        if act = self.resolver.get_named(call_owner) {
          self.resolver.set_tparams(sig.node.type_params)
          pat = self.resolver.resolve(recv.type)
          self.pull_resolve
          self.resolver.clear_tparams
          return self.infer_subst_recv(sig.node.type_params, sig.params, arg_tys, sig.ret, expected, pat, act)
        }
      }
    }
    self.infer_subst(sig.node.type_params, sig.params, arg_tys, sig.ret, expected)
  }

  pub fn fill_defaults(expr: Expr, fnn: Function) {
    while expr.args.size < fnn.params.size {
      i = expr.args.size
      if d = fnn.params[i].default {
        cloned = clone_expr(d)
        from: Array(String) = []
        to: Array(Expr) = []
        j = 0
        while j < i {
          from.push(fnn.params[j].name)
          to.push(expr.args[j])
          j = j + 1
        }
        expr.args.push(rewrite_expr_names(cloned, from, to))
      } else {
        self.fail(expr.loc, "${fnn.name} takes ${fnn.params.size} arguments, got ${expr.args.size}")
        return
      }
    }
  }

  pub fn attach_method_fn(fnn: Function) {
    owner = fnn.owner
    i = 0
    while i < self.program.structs.size {
      sdef = self.program.structs[i]
      if str_eq(sdef.name, owner) {
        sdef.methods.push(fnn)
        return
      }
      i = i + 1
    }
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if str_eq(cdef.name, owner) {
        cdef.methods.push(fnn)
        return
      }
      i = i + 1
    }
    self.program.functions.push(fnn)
  }

  pub fn instantiate_function(sig: FuncSig, subst: Array(Ty), loc: Location): FuncSig? {
    if self.bounds_hold(sig.node, subst, loc) {
    } else {
      return nil
    }
    from = sig.node.type_params
    to: Array(TypeName) = []
    i = 0
    while i < from.size {
      to.push(ty_to_type_name(subst[i], loc))
      i = i + 1
    }
    emit = sig_mangle(sig.node.name, subst)
    if existing = self.find_instance(emit) {
      return self.find_sig_by_node(existing)
    }
    inst = clone_function(sig.node)
    subst_function_types(inst, from, to)
    inst.generic = false
    tp: Array(String) = []
    inst.type_params = tp
    inst.emit_name = emit
    self.alloc_ol(inst)
    self.resolver.clear_tparams
    params: Array(Ty) = []
    i = 0
    while i < inst.params.size {
      params.push(self.resolver.resolve_value(inst.params[i].type))
      self.pull_resolve
      i = i + 1
    }
    ret = self.t_void()
    if t = inst.return_type {
      ret = self.resolver.resolve(t)
      self.pull_resolve
    }
    self.program.functions.push(inst)
    nsig = FuncSig.new(inst.name, inst, params, ret)
    self.functions.push(nsig)
    self.instances.push(inst)
    self.pending.push(inst)
    nsig
  }

  pub fn instantiate_method(sig: FuncSig, subst: Array(Ty), loc: Location): FuncSig? {
    if self.bounds_hold(sig.node, subst, loc) {
    } else {
      return nil
    }
    from = sig.node.type_params
    to: Array(TypeName) = []
    buf = buf_new()
    buf.push_str(sig.owner)
    buf.push_str("__")
    buf.push_str(emit_op_name(sig.name))
    i = 0
    while i < from.size {
      to.push(ty_to_type_name(subst[i], loc))
      buf.push_str("__")
      buf.push_str(mangle_ty(subst[i]))
      i = i + 1
    }
    emit = buf.to_s
    if existing = self.find_instance(emit) {
      return self.find_sig_by_node(existing)
    }
    inst = clone_function(sig.node)
    subst_function_types(inst, from, to)
    inst.generic = false
    tp: Array(String) = []
    inst.type_params = tp
    inst.emit_name = emit
    inst.owner = sig.owner
    self.alloc_ol(inst)
    self.resolver.clear_tparams
    params: Array(Ty) = []
    i = 0
    while i < inst.params.size {
      params.push(self.resolver.resolve_value(inst.params[i].type))
      self.pull_resolve
      i = i + 1
    }
    ret = self.t_void()
    if t = inst.return_type {
      ret = self.resolver.resolve(t)
      self.pull_resolve
    }
    if recv = inst.receiver {
      self.resolver.clear_tparams
      rty = self.resolver.resolve(recv.type)
      self.pull_resolve
      if rty.is_agg {
        if rty.template {
        } else {
          if rty.name.size > 0 {
            inst.owner = rty.name
          }
        }
      }
    }
    self.attach_method_fn(inst)
    nsig = FuncSig.new(inst.name, inst, params, ret)
    nsig.owner = inst.owner
    self.methods.push(nsig)
    self.instances.push(inst)
    self.pending.push(inst)
    nsig
  }

  pub fn match_func(name: String, arg_tys: Array(Ty), expected: Ty?, loc: Location): FuncSig? {
    cands: Array(FuncSig) = []
    saw_generic = false
    i = 1
    while i < self.functions.size {
      sig = self.functions[i]
      if str_eq(sig.name, name) {
        is_inst = false
        j = 0
        while j < self.instances.size {
          if self.instances[j].ol_index == sig.node.ol_index {
            is_inst = true
          }
          j = j + 1
        }
        if is_inst {
        } else {
          if self.fn_is_visible(sig.node, self.current_module) {
          if arity_ok(sig.node, arg_tys.size) {
            if sig.node.generic {
              saw_generic = true
              if subst = self.infer_subst(sig.node.type_params, sig.params, arg_tys, sig.ret, expected) {
                cands.push(sig)
              }
            } else {
              ok = true
              k = 0
              while k < arg_tys.size {
                if ty_assignable(arg_tys[k], sig.params[k]) {
                } else {
                  ok = false
                }
                k = k + 1
              }
              if ok {
                cands.push(sig)
              }
            }
          }
          }
        }
      }
      i = i + 1
    }
    if cands.size == 0 {
      if saw_generic {
        self.fail(loc, "cannot infer type argument")
        return nil
      }
      only: FuncSig? = nil
      n = 0
      i = 1
      while i < self.functions.size {
        sig = self.functions[i]
        if str_eq(sig.name, name) {
          if self.fn_is_visible(sig.node, self.current_module) {
            if self.sig_is_instance(sig) {
            } else {
              if sig.node.generic {
              } else {
                if arity_ok(sig.node, arg_tys.size) {
                  only = sig
                  n = n + 1
                }
              }
            }
          }
        }
        i = i + 1
      }
      if n == 1 {
        if one = only {
          return one
        }
      }
      if n > 1 {
        self.fail(loc, "no matching function ${name}")
      } else {
        self.fail(loc, "unknown function ${name}")
      }
      return nil
    }
    if cands.size > 1 {
      self.fail(loc, "ambiguous call to ${name}")
      return nil
    }
    chosen = cands[0]
    if chosen.node.generic {
      if subst = self.infer_subst(chosen.node.type_params, chosen.params, arg_tys, chosen.ret, expected) {
        return self.instantiate_function(chosen, subst, loc)
      }
      self.fail(loc, "cannot infer type argument")
      return nil
    }
    chosen
  }

  pub fn match_method(owner: String, name: String, arg_tys: Array(Ty), expected: Ty?, loc: Location, shown: String): FuncSig? {
    cands: Array(FuncSig) = []
    saw_generic = false
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      if str_eq(sig.owner, owner) {
        if str_eq(sig.name, name) {
          is_inst = false
          j = 0
          while j < self.instances.size {
            if self.instances[j].ol_index == sig.node.ol_index {
              is_inst = true
            }
            j = j + 1
          }
          if is_inst {
          } else {
            if self.method_is_visible(sig.node, self.current_module) {
            if arity_ok(sig.node, arg_tys.size) {
              if sig.node.generic {
                saw_generic = true
                if subst = self.infer_subst(sig.node.type_params, sig.params, arg_tys, sig.ret, expected) {
                  cands.push(sig)
                }
              } else {
                ok = true
                k = 0
                while k < arg_tys.size {
                  if ty_assignable(arg_tys[k], sig.params[k]) {
                  } else {
                    ok = false
                  }
                  k = k + 1
                }
                if ok {
                  cands.push(sig)
                }
              }
            }
            }
          }
        }
      }
      i = i + 1
    }
    if act = self.resolver.get_named(owner) {
      if act.origin.size > 0 {
        i = 0
        while i < self.methods.size {
          sig = self.methods[i]
          if str_eq(sig.owner, owner) {
          } else {
            if sig.node.generic {
              if str_eq(sig.name, name) {
                if recv = sig.node.receiver {
                  if self.method_is_visible(sig.node, self.current_module) {
                    if arity_ok(sig.node, arg_tys.size) {
                      is_inst = false
                      j = 0
                      while j < self.instances.size {
                        if self.instances[j].ol_index == sig.node.ol_index {
                          is_inst = true
                        }
                        j = j + 1
                      }
                      if is_inst {
                      } else {
                        saw_generic = true
                        if subst = self.subst_for_method(sig, owner, arg_tys, expected) {
                          cands.push(sig)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          i = i + 1
        }
      }
    }
    if cands.size == 0 {
      if saw_generic {
        self.fail(loc, "cannot infer type argument")
      } else {
        self.fail(loc, "no method ${name} on ${shown}")
      }
      return nil
    }
    if cands.size > 1 {
      self.fail(loc, "ambiguous call to ${shown}.${name}")
      return nil
    }
    chosen = cands[0]
    if chosen.node.generic {
      if subst = self.subst_for_method(chosen, owner, arg_tys, expected) {
        return self.instantiate_method(chosen, subst, loc)
      }
      self.fail(loc, "cannot infer type argument")
      return nil
    }
    chosen
  }

  pub fn dispatch_call(expr: Expr, expected: Ty?): Ty {
    self.absorb_fn_block(expr)
    if got = self.dispatch_deferred(expr, expected) {
      return got
    }
    arg_tys: Array(Ty) = []
    i = 0
    while i < expr.args.size {
      arg_tys.push(self.check_expr(expr.args[i]))
      i = i + 1
    }
    visible = false
    i = 1
    while i < self.functions.size {
      sig = self.functions[i]
      if str_eq(sig.name, expr.callee) {
        if self.fn_is_visible(sig.node, self.current_module) {
          visible = true
        }
      }
      i = i + 1
    }
    if visible {
    } else {
      self.fail(expr.loc, "unknown function ${expr.callee}")
      return self.t_int()
    }
    if sig = self.match_func(expr.callee, arg_tys, expected, expr.loc) {
      self.fill_defaults(expr, sig.node)
      i = 0
      while i < expr.args.size {
        got = self.t_int()
        if i < arg_tys.size {
          got = arg_tys[i]
        } else {
          got = self.check_expr_as(expr.args[i], sig.params[i])
        }
        got = self.fit_call_arg(expr.args[i], got, sig.params[i])
        if ty_assignable(got, sig.params[i]) {
        } else {
          n = i + 1
          self.fail(expr.args[i].loc, "argument ${n} of ${expr.callee} is ${got.show}, expected ${sig.params[i].show}")
        }
        i = i + 1
      }
      expr.resolved = sig.node.emit_name
      return sig.ret
    }
    self.t_int()
  }

  pub fn method_targets_owner(sig: FuncSig, owner: String): Bool {
    if str_eq(sig.owner, owner) {
      return true
    }
    if sig.node.generic {
      if recv = sig.node.receiver {
        if act = self.resolver.get_named(owner) {
          if act.origin.size > 0 {
            return str_eq(sig.owner, act.origin)
          }
        }
      }
    }
    false
  }

  pub fn absorb_method_block(expr: Expr, owner: String) {
    if b = expr.block {
    } else {
      return
    }
    want_n = expr.args.size + 1
    take = false
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      if str_eq(sig.name, expr.callee) {
        if self.method_is_visible(sig.node, self.current_module) {
          if self.sig_is_instance(sig) {
          } else {
            if self.method_targets_owner(sig, owner) {
              if sig.params.size == want_n {
                last = sig.params[want_n - 1]
                if last.is_fn {
                  take = true
                }
              }
            }
          }
        }
      }
      i = i + 1
    }
    if take {
      if b = expr.block {
        lam = Expr.new(ex_lambda(), b.loc)
        lam.block = b
        expr.args.push(lam)
        expr.block = nil
      }
    }
  }

  pub fn expr_has_deferred(expr: Expr): Bool {
    i = 0
    while i < expr.args.size {
      if self.arg_is_deferred(expr.args[i]) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn seed_method_subst(sig: FuncSig, owner: String, keys: Array(String), vals: Array(Ty)): Bool {
    if str_eq(sig.owner, owner) {
      return true
    }
    if recv = sig.node.receiver {
      if act = self.resolver.get_named(owner) {
        self.resolver.set_tparams(sig.node.type_params)
        pat = self.resolver.resolve(recv.type)
        self.pull_resolve
        self.resolver.clear_tparams
        if self.has_err {
          return false
        }
        if str_eq(pat.origin, act.origin) {
          if pat.ty_args.size == act.ty_args.size {
            i = 0
            while i < pat.ty_args.size {
              if self.unify_ty(pat.ty_args[i], act.ty_args[i], keys, vals) {
              } else {
                return false
              }
              i = i + 1
            }
            return true
          }
        }
      }
    }
    false
  }

  pub fn method_deferred_ok(sig: FuncSig, owner: String, deferred: Array(Int), ctypes: Array(Ty)): Bool {
    if self.method_targets_owner(sig, owner) {
    } else {
      return false
    }
    if self.deferred_slots_are_fn(sig, deferred) {
    } else {
      return false
    }
    if arity_ok(sig.node, deferred.size) {
    } else {
      return false
    }
    keys: Array(String) = []
    vals: Array(Ty) = []
    if self.seed_method_subst(sig, owner, keys, vals) {
    } else {
      return false
    }
    i = 0
    while i < deferred.size {
      if deferred[i] == 0 {
        if i < sig.params.size {
          pty = self.subst_ty(sig.params[i], keys, vals)
          if self.unify_ty(pty, ctypes[i], keys, vals) {
          } else {
            if ty_assignable(ctypes[i], pty) {
            } else {
              return false
            }
          }
        }
      }
      i = i + 1
    }
    i = 0
    while i < deferred.size {
      if deferred[i] == 1 {
        if i < sig.params.size {
          pty = self.subst_ty(sig.params[i], keys, vals)
          if pty.is_fn {
            if self.fn_param_needs_type(pty) {
              return false
            }
          } else {
            return false
          }
        }
      }
      i = i + 1
    }
    true
  }

  pub fn collect_method_deferred(expr: Expr, owner: String, deferred: Array(Int), ctypes: Array(Ty)): Array(FuncSig) {
    cands: Array(FuncSig) = []
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      if str_eq(sig.name, expr.callee) {
        if self.method_is_visible(sig.node, self.current_module) {
          if self.sig_is_instance(sig) {
          } else {
            if self.method_deferred_ok(sig, owner, deferred, ctypes) {
              cands.push(sig)
            }
          }
        }
      }
      i = i + 1
    }
    cands
  }

  pub fn finish_method_deferred(expr: Expr, chosen: FuncSig, owner: String, deferred: Array(Int), ctypes: Array(Ty), expected: Ty?, shown: String): Ty {
    sig = chosen
    keys: Array(String) = []
    vals: Array(Ty) = []
    if self.seed_method_subst(sig, owner, keys, vals) {
    } else {
      self.fail(expr.loc, "cannot infer type argument")
      return self.t_int()
    }
    i = 0
    while i < deferred.size {
      if deferred[i] == 0 {
        if i < sig.params.size {
          pty = self.subst_ty(sig.params[i], keys, vals)
          if self.unify_ty(pty, ctypes[i], keys, vals) {
          } else {
            if ty_assignable(ctypes[i], pty) {
            } else {
              n = i + 1
              self.fail(expr.args[i].loc, "argument ${n} of ${shown}.${expr.callee} is ${ctypes[i].show}, expected ${pty.show}")
              return self.t_int()
            }
          }
        }
      }
      i = i + 1
    }
    i = 0
    while i < expr.args.size {
      if deferred[i] == 1 {
        pty = self.t_int()
        if i < sig.params.size {
          pty = self.subst_ty(sig.params[i], keys, vals)
        }
        got = self.check_fn_arg(expr.args[i], pty)
        if self.unify_ty(pty, got, keys, vals) {
        } else {
          if ty_assignable(got, pty) {
          } else {
            if self.fn_compatible(got, pty) {
            } else {
              n = i + 1
              self.fail(expr.args[i].loc, "argument ${n} of ${shown}.${expr.callee} is ${got.show}, expected ${pty.show}")
              return self.t_int()
            }
          }
        }
      }
      i = i + 1
    }
    if self.has_err {
      return self.t_int()
    }
    if sig.node.generic {
      if e = expected {
        if e.is_void {
        } else {
          ret_pat = self.subst_ty(sig.ret, keys, vals)
          if self.unify_ty(ret_pat, e, keys, vals) {
          } else {
            self.fail(expr.loc, "cannot infer type argument")
            return self.t_int()
          }
        }
      }
      subst: Array(Ty) = []
      ti = 0
      while ti < sig.node.type_params.size {
        name = sig.node.type_params[ti]
        if g = self.subst_get(keys, vals, name) {
          subst.push(g)
        } else {
          self.fail(expr.loc, "cannot infer type argument")
          return self.t_int()
        }
        ti = ti + 1
      }
      if inst = self.instantiate_method(sig, subst, expr.loc) {
        sig = inst
      } else {
        return self.t_int()
      }
    }
    base = deferred.size
    self.fill_defaults(expr, sig.node)
    i = base
    while i < expr.args.size {
      if i < sig.params.size {
        got = self.check_expr_as(expr.args[i], sig.params[i])
        if ty_assignable(got, sig.params[i]) {
        } else {
          n = i + 1
          self.fail(expr.args[i].loc, "argument ${n} of ${shown}.${expr.callee} is ${got.show}, expected ${sig.params[i].show}")
        }
      }
      i = i + 1
    }
    expr.resolved = sig.node.emit_name
    sig.ret
  }

  pub fn dispatch_method(expr: Expr, object: Ty, expected: Ty?): Ty {
    owner = object.name
    shown = object.show
    field_owner = object
    if object.is_ptr {
      owner = self.method_owner_name(object)
      if inner = object.inner {
        if inner.is_clayout {
          field_owner = inner
        }
      }
    }
    if field_ty = field_owner.field_named(expr.callee) {
      label = field_owner.name
      if label.size == 0 {
        label = shown
      }
      self.fail(expr.loc, "${label}.${expr.callee} is a field, not a method")
      return field_ty
    }
    self.absorb_method_block(expr, owner)
    if self.expr_has_deferred(expr) {
      deferred: Array(Int) = []
      ctypes: Array(Ty) = []
      i = 0
      while i < expr.args.size {
        if self.arg_is_deferred(expr.args[i]) {
          deferred.push(1)
          ctypes.push(self.t_int())
        } else {
          deferred.push(0)
          ctypes.push(self.check_expr(expr.args[i]))
        }
        i = i + 1
      }
      if self.has_err {
        return self.t_int()
      }
      cands = self.collect_method_deferred(expr, owner, deferred, ctypes)
      if cands.size > 1 {
        self.fail(expr.loc, "ambiguous call to ${shown}.${expr.callee}")
        return self.t_int()
      }
      if cands.size == 1 {
        return self.finish_method_deferred(expr, cands[0], owner, deferred, ctypes, expected, shown)
      }
    }
    arg_tys: Array(Ty) = []
    i = 0
    while i < expr.args.size {
      arg_tys.push(self.check_expr(expr.args[i]))
      i = i + 1
    }
    if sig = self.match_method(owner, expr.callee, arg_tys, expected, expr.loc, shown) {
      self.fill_defaults(expr, sig.node)
      i = 0
      while i < expr.args.size {
        got = self.t_int()
        if i < arg_tys.size {
          got = arg_tys[i]
        } else {
          got = self.check_expr_as(expr.args[i], sig.params[i])
        }
        got = self.fit_call_arg(expr.args[i], got, sig.params[i])
        if ty_assignable(got, sig.params[i]) {
        } else {
          n = i + 1
          self.fail(expr.args[i].loc, "argument ${n} of ${shown}.${expr.callee} is ${got.show}, expected ${sig.params[i].show}")
        }
        i = i + 1
      }
      expr.resolved = sig.node.emit_name
      return sig.ret
    }
    self.t_int()
  }

  pub fn assign_emit_names {
    i = 1
    while i < self.functions.size {
      sig = self.functions[i]
      if sig.node.generic {
      } else {
      name = sig.name
      if str_eq(name, "main") {
        nroot = 0
        j = 1
        while j < self.functions.size {
          other = self.functions[j]
          if other.node.generic {
          } else {
            if str_eq(other.name, name) {
              if str_eq(other.node.mod_name, self.root_module) {
                nroot = nroot + 1
              } else {
                if self.root_module.size == 0 {
                  nroot = nroot + 1
                } else {
                  if other.node.mod_name.size == 0 {
                    nroot = nroot + 1
                  }
                }
              }
            }
          }
          j = j + 1
        }
        if nroot > 1 {
          self.fail(sig.node.loc, "function ${name} is already defined")
          return
        }
      }
      if str_eq(name, "run") {
        nroot = 0
        j = 1
        while j < self.functions.size {
          other = self.functions[j]
          if other.node.generic {
          } else {
            if str_eq(other.name, name) {
              if str_eq(other.node.mod_name, self.root_module) {
                nroot = nroot + 1
              } else {
                if self.root_module.size == 0 {
                  nroot = nroot + 1
                } else {
                  if other.node.mod_name.size == 0 {
                    nroot = nroot + 1
                  }
                }
              }
            }
          }
          j = j + 1
        }
        if nroot > 1 {
          self.fail(sig.node.loc, "function ${name} is already defined")
          return
        }
      }
      mods: Array(String) = []
      j = 1
      while j < self.functions.size {
        other = self.functions[j]
        if other.node.generic {
        } else {
          if str_eq(other.name, name) {
            found = false
            m = 0
            while m < mods.size {
              if str_eq(mods[m], other.node.mod_name) {
                found = true
              }
              m = m + 1
            }
            if found {
            } else {
              mods.push(other.node.mod_name)
            }
          }
        }
        j = j + 1
      }
      base = name
      if mods.size > 1 {
        if sig.node.vis {
        } else {
          if sig.node.mod_name.size > 0 {
            base = "${sig.node.mod_name}__${name}"
          }
        }
      }
      g = 0
      j = 1
      while j < self.functions.size {
        other = self.functions[j]
        if other.node.generic {
        } else {
          if str_eq(other.name, name) {
            if sig.node.vis {
              if other.node.vis {
                g = g + 1
              }
            } else {
              if other.node.vis {
              } else {
                if str_eq(other.node.mod_name, sig.node.mod_name) {
                  g = g + 1
                }
              }
            }
          }
        }
        j = j + 1
      }
      if g == 0 {
        j = 1
        while j < self.functions.size {
          other = self.functions[j]
          if other.node.generic {
          } else {
            if str_eq(other.name, name) {
              g = g + 1
            }
          }
          j = j + 1
        }
      }
      if g <= 1 {
        sig.node.emit_name = base
      } else {
        sig.node.emit_name = sig_mangle(base, sig.params)
      }
      }
      i = i + 1
    }
    i = 0
    while i < self.methods.size {
      sig = self.methods[i]
      if sig.node.generic {
      } else {
      name = sig.name
      owner = sig.owner
      if str_eq(name, "initialize") {
        if self.count_named_methods(owner, name) > 1 {
          self.fail(sig.node.loc, "initialize cannot be overloaded")
          return
        }
      }
      n = 0
      j = 0
      while j < self.methods.size {
        other = self.methods[j]
        if other.node.generic {
        } else {
          if str_eq(other.owner, owner) {
            if str_eq(other.name, name) {
              n = n + 1
            }
          }
        }
        j = j + 1
      }
      sanitized = emit_op_name(name)
      if n <= 1 {
        sig.node.emit_name = "${owner}__${sanitized}"
      } else {
        sig.node.emit_name = sig_mangle("${owner}__${sanitized}", sig.params)
      }
      }
      i = i + 1
    }
  }

  pub fn implicit_field(name: String): Ty? {
    if st = self.self_ty {
      return st.field_named(name)
    }
    nil
  }

  pub fn t_int: Ty { self.resolver.t_int }
  pub fn t_int64: Ty { self.resolver.t_int64 }
  pub fn t_uint64: Ty { self.resolver.t_uint64 }
  pub fn t_bool: Ty { self.resolver.t_bool }
  pub fn t_float: Ty { self.resolver.t_float }
  pub fn t_string: Ty { self.resolver.t_string }
  pub fn t_void: Ty { self.resolver.t_void }
  pub fn t_nil: Ty { self.resolver.t_nil }
  pub fn t_buf: Ty { self.resolver.t_buf }
  pub fn t_bytes: Ty { self.resolver.t_bytes }

  pub fn is_ordered_ty(ty: Ty): Bool {
    if ty.is_int {
      return true
    }
    if ty.is_int64 {
      return true
    }
    if ty.is_uint64 {
      return true
    }
    if ty.is_float {
      return true
    }
    if ty.is_string {
      return true
    }
    if ty.is_bool {
      return true
    }
    ty.is_bytes
  }

  pub fn is_numeric_ty(ty: Ty): Bool {
    if ty.is_int {
      return true
    }
    if ty.is_int64 {
      return true
    }
    if ty.is_uint64 {
      return true
    }
    ty.is_float
  }

  pub fn is_eq_ty(ty: Ty): Bool {
    if self.is_ordered_ty(ty) {
      return true
    }
    if ty.is_class {
      return true
    }
    if ty.is_array {
      return true
    }
    if ty.is_hash {
      return true
    }
    if ty.is_buf {
      return true
    }
    ty.is_bytes
  }

  pub fn check: Program {
    self.resolver = load_types(self.program)
    self.pull_resolve
    self.note_modules
    i = 0
    while i < self.program.libs.size {
      self.clear_poison
      self.register_lib(self.program.libs[i])
      i = i + 1
    }
    i = 0
    while i < self.program.functions.size {
      self.clear_poison
      fnn = self.program.functions[i]
      if fn_is_method(fnn) {
        self.register_method(fnn)
      } else {
        self.register_function(fnn)
      }
      i = i + 1
    }
    self.ready_adopt = true
    self.clear_poison
    self.check_interface_sigs
    self.clear_poison
    self.adopt_new_types
    self.clear_poison
    self.apply_late_opt_ins
    self.clear_poison
    self.reserve_constructors
    self.clear_poison
    self.assign_emit_names
    self.clear_poison
    self.check_field_defaults
    if self.any_err {
      return self.program
    }
    has_entry = false
    i = 1
    while i < self.functions.size {
      sig = self.functions[i]
      if str_eq(sig.name, "main") {
        if str_eq(sig.node.mod_name, self.root_module) {
          has_entry = true
        } else {
          if self.root_module.size == 0 {
            has_entry = true
          }
        }
      }
      if str_eq(sig.name, "run") {
        if str_eq(sig.node.mod_name, self.root_module) {
          has_entry = true
        } else {
          if self.root_module.size == 0 {
            has_entry = true
          }
        }
      }
      i = i + 1
    }
    if has_entry {
    } else {
      self.fail(self.program.loc, "program needs fn main or fn run")
      return self.program
    }
    fns = program_all_functions(self.program)
    self.adopt_pending = true
    i = 0
    while i < fns.size {
      fnn = fns[i]
      if fnn.generic {
      } else {
        self.check_function(fnn)
      }
      i = i + 1
    }
    i = 0
    while i < self.pending.size {
      self.check_function(self.pending[i])
      i = i + 1
    }
    self.program
  }

  pub fn register_lib(lib_def: LibDef) {
    if id = self.lib_names.get(lib_def.name) {
      self.fail(lib_def.loc, "lib ${lib_def.name} is already defined")
      return
    }
    if named = self.resolver.get_named(lib_def.name) {
      self.fail(lib_def.loc, "lib ${lib_def.name} collides with a type")
      return
    }
    self.lib_names[lib_def.name] = 1
    j = 0
    while j < lib_def.funs.size {
      cfun = lib_def.funs[j]
      key = "${lib_def.name}.${cfun.name}"
      if taken = self.cfun_index.get(key) {
        self.fail(cfun.loc, "fun ${cfun.name} is already defined in lib ${lib_def.name}")
        return
      }
      if existing = self.find_fn(cfun.name) {
        self.fail(cfun.loc, "C function ${cfun.name} collides with an Avant function")
        return
      }
      if id = self.method_index.get(cfun.name) {
        self.fail(cfun.loc, "C function ${cfun.name} collides with an Avant function")
        return
      }
      if bound = self.c_symbols.get(cfun.name) {
        self.fail(cfun.loc, "C function ${cfun.name} is already bound as ${bound}")
        return
      }
      if rid = self.reserved.get(cfun.name) {
        self.fail(cfun.loc, "C function ${cfun.name} is reserved")
        return
      }
      params: Array(Ty) = []
      k = 0
      while k < cfun.params.size {
        pty = self.resolver.resolve_value(cfun.params[k].type)
        self.pull_resolve
        if pty.is_fn {
          self.fail(cfun.params[k].loc, "C function pointers are not supported")
          return
        }
        params.push(pty)
        k = k + 1
      }
      ret = self.t_void()
      if t = cfun.return_type {
        ty = self.resolver.resolve(t)
        self.pull_resolve
        if ty.is_opaque {
          self.fail(t.loc, "${ty.show} is opaque; use Ptr(${ty.show})")
          return
        }
        if ty.is_clayout {
          self.fail(t.loc, "${ty.show} is a C layout; use Ptr(${ty.show})")
          return
        }
        if ty.is_fn {
          self.fail(t.loc, "C function pointers are not supported")
          return
        }
        ret = ty
      }
      sig = CFunSig.new(cfun.name, lib_def.name, params, ret)
      self.cfuns.push(sig)
      self.cfun_index[key] = self.cfuns.size - 1
      self.c_symbols[cfun.name] = key
      j = j + 1
    }
    self.lib_mod[lib_def.name] = lib_def.mod_name
    if lib_def.vis {
      self.lib_vis[lib_def.name] = 1
    } else {
      self.lib_vis[lib_def.name] = 0
    }
  }

  pub fn register_function(fnn: Function) {
    if is_op_fn_name(fnn.name) {
      self.fail(fnn.loc, "operator methods need a receiver")
      return
    }
    if str_eq(fnn.name, "main") {
      if self.root_module.size > 0 {
        if str_eq(fnn.mod_name, self.root_module) {
        } else {
          if fnn.mod_name.size > 0 {
            self.fail(fnn.loc, "fn ${fnn.name} is program entry; keep it in the root")
            return
          }
        }
      }
    }
    if str_eq(fnn.name, "run") {
      if self.root_module.size > 0 {
        if str_eq(fnn.mod_name, self.root_module) {
        } else {
          if fnn.mod_name.size > 0 {
            self.fail(fnn.loc, "fn ${fnn.name} is program entry; keep it in the root")
            return
          }
        }
      }
    }
    if id = self.lib_names.get(fnn.name) {
      self.fail(fnn.loc, "function ${fnn.name} collides with a lib")
      return
    }
    if bound = self.c_symbols.get(fnn.name) {
      self.fail(fnn.loc, "function ${fnn.name} collides with a C function")
      return
    }
    if named = self.resolver.get_named(fnn.name) {
      owner = ""
      if o = self.type_mod.get(fnn.name) {
        owner = o
      }
      collide = false
      if owner.size == 0 {
        collide = true
      }
      if str_eq(owner, fnn.mod_name) {
        collide = true
      }
      if fnn.mod_name.size == 0 {
        collide = true
      }
      if collide {
        self.fail(fnn.loc, "function ${fnn.name} collides with a type")
        return
      }
    }
    self.check_trailing_defaults(fnn)
    if self.has_err {
      return
    }
    tparams = collect_fn_type_params(fnn, self.resolver.named)
    if str_eq(fnn.name, "main") {
      if tparams.size > 0 {
        self.fail(fnn.loc, "main cannot be generic")
        return
      }
    }
    if str_eq(fnn.name, "run") {
      if tparams.size > 0 {
        self.fail(fnn.loc, "run cannot be generic")
        return
      }
    }
    fnn.type_params = tparams
    fnn.generic = tparams.size > 0
    self.attach_bounds(fnn)
    if self.has_err {
      return
    }
    saved_mod = self.current_module
    self.current_module = fnn.mod_name
    self.resolver.set_tparams(tparams)
    params: Array(Ty) = []
    i = 0
    while i < fnn.params.size {
      params.push(self.resolve_value_in_module(fnn.params[i].type))
      self.pull_resolve
      i = i + 1
    }
    ret = self.t_void()
    if t = fnn.return_type {
      ty = self.resolve_in_module(t)
      self.pull_resolve
      if ty.is_opaque {
        self.fail(t.loc, "${ty.show} is opaque; use Ptr(${ty.show})")
        self.resolver.clear_tparams
        self.current_module = saved_mod
        return
      }
      if ty.is_clayout {
        self.fail(t.loc, "${ty.show} is a C layout; use Ptr(${ty.show})")
        self.resolver.clear_tparams
        self.current_module = saved_mod
        return
      }
      ret = ty
    }
    self.resolver.clear_tparams
    i = 0
    while i < params.size {
      self.ensure_pub_sig_ty(params[i], fnn.params[i].loc, fnn)
      i = i + 1
    }
    self.ensure_pub_sig_ty(ret, fnn.loc, fnn)
    self.current_module = saved_mod
    i = 1
    while i < self.functions.size {
      existing = self.functions[i]
      if str_eq(existing.name, fnn.name) {
        if params_same(existing.params, params) {
          same_mod = false
          if str_eq(existing.node.mod_name, fnn.mod_name) {
            same_mod = true
          }
          if existing.node.mod_name.size == 0 {
            same_mod = true
          }
          if fnn.mod_name.size == 0 {
            same_mod = true
          }
          if same_mod {
            self.fail(fnn.loc, "function ${fnn.name} is already defined")
            return
          }
          if existing.node.vis {
            self.fail(fnn.loc, "function ${fnn.name} is already defined")
            return
          }
          if fnn.vis {
            self.fail(fnn.loc, "function ${fnn.name} is already defined")
            return
          }
        }
      }
      i = i + 1
    }
    self.alloc_ol(fnn)
    sig = FuncSig.new(fnn.name, fnn, params, ret)
    self.functions.push(sig)
    if taken = self.fn_index.get(fnn.name) {
    } else {
      self.fn_index[fnn.name] = self.functions.size - 1
    }
  }

  pub fn ptr_method_ok(ty: Ty): Bool {
    if ty.is_ptr {
      if inner = ty.inner {
        if inner.is_void {
          return true
        }
        if inner.is_opaque {
          return true
        }
        if inner.is_clayout {
          return true
        }
      }
    }
    false
  }

  pub fn method_owner_name(ty: Ty): String {
    if ty.is_ptr {
      return mangle_ty(ty)
    }
    ty.name
  }

  pub fn register_method(fnn: Function) {
    saved_mod = self.current_module
    self.current_module = fnn.mod_name
    owner_ty = self.t_int()
    owner_key = ""
    has_owner = false
    tparams = collect_fn_type_params(fnn, self.resolver.named)
    self.resolver.set_tparams(tparams)
    if fnn.owner.size > 0 {
      if found = self.lookup_named_type(fnn.owner, fnn.loc, "") {
        owner_ty = found
        owner_key = found.name
        has_owner = true
      } else {
        self.resolver.clear_tparams
        self.current_module = saved_mod
        return
      }
    } else {
      if recv = fnn.receiver {
        ty = self.resolve_in_module(recv.type)
        self.pull_resolve
        if ty.is_agg {
          fnn.owner = ty.name
          owner_ty = ty
          owner_key = ty.name
          has_owner = true
        } else if self.ptr_method_ok(ty) {
          if tparams.size > 0 {
            self.fail(recv.loc, "Ptr methods are not generic")
            self.resolver.clear_tparams
            self.current_module = saved_mod
            return
          }
          owner_key = self.method_owner_name(ty)
          fnn.owner = owner_key
          owner_ty = ty
          has_owner = true
        } else if ty.is_ptr {
          self.fail(recv.loc, "methods on ${ty.show} are not Stage 18 Ptr methods")
          self.resolver.clear_tparams
          self.current_module = saved_mod
          return
        } else {
          self.fail(recv.loc, "methods can only extend a struct or class, not ${ty.show}")
          self.resolver.clear_tparams
          self.current_module = saved_mod
          return
        }
      } else {
        self.fail(fnn.loc, "unknown type")
        self.resolver.clear_tparams
        self.current_module = saved_mod
        return
      }
    }
    if has_owner {
    } else {
      self.resolver.clear_tparams
      self.current_module = saved_mod
      return
    }
    if str_eq(fnn.name, "new") {
      self.fail(fnn.loc, "new is reserved; write initialize")
      self.resolver.clear_tparams
      self.current_module = saved_mod
      return
    }
    field_owner = owner_ty
    if owner_ty.is_ptr {
      if inner = owner_ty.inner {
        field_owner = inner
      }
    }
    if field_ty = field_owner.field_named(fnn.name) {
      self.fail(fnn.loc, "${field_owner.name}.${fnn.name} is both a field and a method")
      self.resolver.clear_tparams
      self.current_module = saved_mod
      return
    }
    self.check_trailing_defaults(fnn)
    if self.has_err {
      self.resolver.clear_tparams
      self.current_module = saved_mod
      return
    }
    fnn.type_params = tparams
    fnn.generic = tparams.size > 0
    self.attach_bounds(fnn)
    if self.has_err {
      self.resolver.clear_tparams
      self.current_module = saved_mod
      return
    }
    params: Array(Ty) = []
    i = 0
    while i < fnn.params.size {
      params.push(self.resolve_value_in_module(fnn.params[i].type))
      self.pull_resolve
      i = i + 1
    }
    ret = self.t_void()
    if t = fnn.return_type {
      ty = self.resolve_in_module(t)
      self.pull_resolve
      if ty.is_opaque {
        self.fail(t.loc, "${ty.show} is opaque; use Ptr(${ty.show})")
        self.resolver.clear_tparams
        self.current_module = saved_mod
        return
      }
      if ty.is_clayout {
        self.fail(t.loc, "${ty.show} is a C layout; use Ptr(${ty.show})")
        self.resolver.clear_tparams
        self.current_module = saved_mod
        return
      }
      ret = ty
    }
    self.resolver.clear_tparams
    i = 0
    while i < params.size {
      self.ensure_pub_sig_ty(params[i], fnn.params[i].loc, fnn)
      i = i + 1
    }
    self.ensure_pub_sig_ty(ret, fnn.loc, fnn)
    self.current_module = saved_mod
    if str_eq(fnn.name, "initialize") {
      if ret.is_void {
      } else {
        self.fail(fnn.loc, "initialize cannot return a value")
        return
      }
      if fnn.generic {
        self.fail(fnn.loc, "initialize cannot be generic")
        return
      }
    }
    i = 0
    while i < self.methods.size {
      existing = self.methods[i]
      if str_eq(existing.owner, owner_key) {
        if str_eq(existing.name, fnn.name) {
          if params_same(existing.params, params) {
            self.fail(fnn.loc, "method ${owner_key}.${fnn.name} is already defined")
            return
          }
        }
      }
      i = i + 1
    }
    self.alloc_ol(fnn)
    sig = FuncSig.new(fnn.name, fnn, params, ret)
    sig.owner = owner_key
    self.methods.push(sig)
    key = "${owner_key}__${fnn.name}"
    if taken = self.method_index.get(key) {
    } else {
      self.method_index[key] = self.methods.size - 1
    }
    if self.adopt_pending {
      if fnn.generic {
      } else {
        self.assign_one_method_emit(sig)
        self.pending.push(fnn)
      }
    }
  }

  pub fn adopt_one_struct(sdef: StructDef) {
    j = 0
    while j < sdef.methods.size {
      if sdef.type_params.size > 0 {
        sdef.methods[j].generic = true
      } else {
        self.register_method(sdef.methods[j])
        if self.has_err {
          return
        }
      }
      j = j + 1
    }
    if sdef.type_params.size > 0 {
      return
    }
    self.check_decl_opts(sdef.name, sdef.opt_ins, sdef.mod_name, sdef.loc)
  }

  pub fn adopt_one_class(cdef: ClassDef) {
    j = 0
    while j < cdef.methods.size {
      if cdef.type_params.size > 0 {
        cdef.methods[j].generic = true
      } else {
        self.register_method(cdef.methods[j])
        if self.has_err {
          return
        }
      }
      j = j + 1
    }
    if cdef.type_params.size > 0 {
      return
    }
    self.check_decl_opts(cdef.name, cdef.opt_ins, cdef.mod_name, cdef.loc)
    if self.has_err {
      return
    }
    if self.adopt_pending {
      name = "${cdef.name}__new"
      if taken = self.find_fn(name) {
        self.fail(cdef.loc, "${name} collides with the synthesized constructor")
        return
      }
      if id = self.method_index.get(name) {
        self.fail(cdef.loc, "${name} collides with the synthesized constructor")
      }
    }
  }

  pub fn note_type_owner(name: String, mod_name: String, vis: Bool) {
    if o = self.type_mod.get(name) {
      return
    }
    self.type_mod[name] = mod_name
    if vis {
      self.type_vis[name] = 1
    } else {
      self.type_vis[name] = 0
    }
  }

  pub fn adopt_new_types {
    if self.in_adopt {
      return
    }
    if self.has_err {
      return
    }
    self.in_adopt = true
    grow = true
    while grow {
      grow = false
      i = 0
      while i < self.program.structs.size {
        sdef = self.program.structs[i]
        if seen = self.adopted.get(sdef.name) {
        } else {
          self.adopted[sdef.name] = 1
          self.note_type_owner(sdef.name, sdef.mod_name, sdef.vis)
          self.adopt_one_struct(sdef)
          self.clear_poison
          grow = true
        }
        i = i + 1
      }
      i = 0
      while i < self.program.classes.size {
        cdef = self.program.classes[i]
        if seen = self.adopted.get(cdef.name) {
        } else {
          self.adopted[cdef.name] = 1
          self.note_type_owner(cdef.name, cdef.mod_name, cdef.vis)
          self.adopt_one_class(cdef)
          self.clear_poison
          grow = true
        }
        i = i + 1
      }
    }
    self.in_adopt = false
  }

  pub fn assign_one_method_emit(sig: FuncSig) {
    name = sig.name
    owner = sig.owner
    n = 0
    j = 0
    while j < self.methods.size {
      other = self.methods[j]
      if other.node.generic {
      } else {
        if str_eq(other.owner, owner) {
          if str_eq(other.name, name) {
            n = n + 1
          }
        }
      }
      j = j + 1
    }
    if str_eq(name, "initialize") {
      if n > 1 {
        self.fail(sig.node.loc, "initialize cannot be overloaded")
        return
      }
    }
    sanitized = emit_op_name(name)
    j = 0
    while j < self.methods.size {
      other = self.methods[j]
      if other.node.generic {
      } else {
        if str_eq(other.owner, owner) {
          if str_eq(other.name, name) {
            if n <= 1 {
              other.node.emit_name = "${owner}__${sanitized}"
            } else {
              other.node.emit_name = sig_mangle("${owner}__${sanitized}", other.params)
            }
          }
        }
      }
      j = j + 1
    }
  }

  pub fn reserve_constructors {
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if cdef.type_params.size > 0 {
        i = i + 1
        continue
      }
      name = "${cdef.name}__new"
      if taken = self.find_fn(name) {
        self.fail(cdef.loc, "${name} collides with the synthesized constructor")
      }
      if id = self.method_index.get(name) {
        self.fail(cdef.loc, "${name} collides with the synthesized constructor")
      }
      i = i + 1
    }
  }

  pub fn trivial_default(expr: Expr): Bool {
    k = expr.kind
    if k == ex_int() {
      return true
    }
    if k == ex_float() {
      return true
    }
    if k == ex_string() {
      return true
    }
    if k == ex_bool() {
      return true
    }
    if k == ex_nil() {
      return true
    }
    if k == ex_unary() {
      if expr.op == tk_minus() {
        if inner = expr.inner {
          return inner.kind == ex_int()
        }
      }
    }
    false
  }

  pub fn check_field_defaults {
    saved = self.self_ty
    saved_name = self.self_name
    self.self_ty = nil
    self.self_name = ""
    i = 0
    while i < self.program.classes.size {
      defn = self.program.classes[i]
      if defn.type_params.size > 0 {
        i = i + 1
        continue
      }
      self.current_module = defn.mod_name
      if ty = self.resolver.get_named(defn.name) {
        j = 0
        while j < defn.fields.size {
          field = defn.fields[j]
          if default = field.default {
            if self.trivial_default(default) {
            } else {
              self.fail(default.loc, "field default must be a literal or nil")
              return
            }
            if want = ty.field_named(field.name) {
              self.push_scope
              got = self.check_expr_as(default, want)
              if ty_assignable(got, want) {
              } else {
                self.fail(default.loc, "cannot assign ${got.show} to ${want.show}")
              }
              self.pop_scope
            }
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    self.self_ty = saved
    self.self_name = saved_name
  }

  pub fn check_function(fnn: Function) {
    self.clear_poison
    saved_mod = self.current_module
    self.current_module = fnn.mod_name
    ret = self.t_void()
    params: Array(Ty) = []
    if sig = self.find_sig_by_node(fnn) {
      ret = sig.ret
      params = sig.params
    } else {
      self.fail(fnn.loc, "unknown function ${fnn.name}")
      self.current_module = saved_mod
      return
    }
    self.return_type = ret
    ph0: Array(String) = []
    self.pending_handles = ph0
    pa0: Array(String) = []
    self.pending_arrays = pa0
    fv0: Array(String) = []
    self.fact_var = fv0
    fc0: Array(String) = []
    self.fact_cont = fc0
    fs0: Array(Int) = []
    self.fact_slack = fs0
    fl0: Array(Int) = []
    self.fact_live = fl0
    svv0: Array(String) = []
    self.sv_var = svv0
    svc0: Array(String) = []
    self.sv_cont = svc0
    bvv0: Array(String) = []
    self.bv_var = bvv0
    bvc0: Array(String) = []
    self.bv_cont = bvc0
    bvd0: Array(Int) = []
    self.bv_delta = bvd0
    csc0: Array(String) = []
    self.cs_cont = csc0
    csvv0: Array(String) = []
    self.cs_var = csvv0
    csd0: Array(Int) = []
    self.cs_delta = csd0
    nnv0: Array(String) = []
    self.nn_var = nnv0
    if ret.is_void {
    } else {
      if fnn.body.size == 0 {
        self.fail(fnn.loc, "missing return value")
        self.current_module = saved_mod
        return
      }
    }
    self.self_ty = nil
    self.self_name = ""
    self.push_scope
    if fn_is_method(fnn) {
      if owner = self.resolver.get_named(fnn.owner) {
        self.self_ty = owner
        self.self_name = fn_self_name(fnn)
        if existing = self.lookup(self.self_name) {
          self.fail(fnn.loc, "duplicate parameter ${self.self_name}")
          self.pop_scope
          self.current_module = saved_mod
          return
        }
        self.bind(self.self_name, owner)
      } else {
        if recv = fnn.receiver {
          ty = self.resolve_in_module(recv.type)
          self.pull_resolve
          if self.ptr_method_ok(ty) {
            self.self_name = recv.name
            if existing = self.lookup(self.self_name) {
              self.fail(fnn.loc, "duplicate parameter ${self.self_name}")
              self.pop_scope
              self.current_module = saved_mod
              return
            }
            self.bind(self.self_name, ty)
          }
        }
      }
    }
    i = 0
    while i < fnn.params.size {
      param = fnn.params[i]
      if existing = self.lookup(param.name) {
        self.fail(param.loc, "duplicate parameter ${param.name}")
        self.pop_scope
        self.current_module = saved_mod
        return
      }
      self.bind(param.name, params[i])
      if default = param.default {
        saved = self.self_ty
        self.self_ty = nil
        got = self.check_expr_as(default, params[i])
        self.self_ty = saved
        if ty_assignable(got, params[i]) {
        } else {
          self.fail(default.loc, "cannot assign ${got.show} to ${params[i].show}")
          self.pop_scope
          self.current_module = saved_mod
          return
        }
      }
      i = i + 1
    }
    self.current_fn = fnn
    self.check_body(fnn.body, ret, true)
    self.current_fn = nil
    self.pop_scope
    self.self_ty = nil
    self.self_name = ""
    self.current_module = saved_mod
  }

  pub fn annotate_vstep(prev: Stmt, stmt: Stmt) {
    if prev.kind != st_assign() {
      return
    }
    if prev.op != tk_eq() {
      return
    }
    if t = prev.target {
      if v = prev.value {
        if t.kind == ex_name() {
          if v.kind == ex_int() {
            if v.int_bits <= 1000000u64 {
              ivar = t.ident
              if c = stmt.cond {
                cc = c
                if cc.kind == ex_binary() {
                  if cc.op == tk_amp_amp() {
                    if cl0 = cc.left {
                      cc = cl0
                    }
                  }
                }
                if cc.kind == ex_binary() {
                  is_le = false
                  coff = 0
                  matched = false
                  if cc.op == tk_less() || cc.op == tk_less_eq() {
                    if cc.op == tk_less_eq() {
                      is_le = true
                    }
                    if cl = cc.left {
                      if cl.kind == ex_name() {
                        if str_eq(cl.ident, ivar) {
                          matched = true
                        }
                      } else if cl.kind == ex_binary() {
                        if cl.op == tk_plus() {
                          if cll = cl.left {
                            if clr = cl.right {
                              if cll.kind == ex_name() {
                                if str_eq(cll.ident, ivar) {
                                  if self.lit_small(clr) {
                                    coff = clr.int_bits.to_i
                                    matched = true
                                  }
                                }
                              }
                              if clr.kind == ex_name() {
                                if str_eq(clr.ident, ivar) {
                                  if self.lit_small(cll) {
                                    coff = cll.int_bits.to_i
                                    matched = true
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  if matched {
                    step = self.body_vstep(stmt.body, ivar)
                    if step > 0 {
                      stmt.vstep = step
                      stmt.vstart = v.int_bits.to_i
                      stmt.vle = is_le
                      stmt.vcoff = coff
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn body_vstep(body: Array(Stmt), ivar: String): Int {
    step = 0 - 1
    i = 0
    while i < body.size {
      got = self.stmt_vstep(body[i], ivar)
      if got == 0 - 2 {
        return 0 - 1
      }
      if got > 0 {
        if step < 0 {
          step = got
        } else if step == got {
        } else {
          return 0 - 1
        }
      }
      i = i + 1
    }
    step
  }

  pub fn stmt_vstep(s: Stmt, ivar: String): Int {
    if s.kind == st_assign() {
      if t = s.target {
        if t.kind == ex_name() {
          if str_eq(t.ident, ivar) {
            if s.op == tk_plus_eq() {
              if v = s.value {
                if v.kind == ex_int() {
                  if v.int_bits >= 1u64 {
                    if v.int_bits <= 1000000u64 {
                      return v.int_bits.to_i
                    }
                  }
                }
              }
              return 0 - 2
            }
            if s.op == tk_eq() {
              if v = s.value {
                if v.kind == ex_binary() {
                  if v.op == tk_plus() {
                    if l = v.left {
                      if r = v.right {
                        if l.kind == ex_name() {
                          if str_eq(l.ident, ivar) {
                            if r.kind == ex_int() {
                              if r.int_bits >= 1u64 {
                                if r.int_bits <= 1000000u64 {
                                  return r.int_bits.to_i
                                }
                              }
                            }
                          }
                        }
                        if r.kind == ex_name() {
                          if str_eq(r.ident, ivar) {
                            if l.kind == ex_int() {
                              if l.int_bits >= 1u64 {
                                if l.int_bits <= 1000000u64 {
                                  return l.int_bits.to_i
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              return 0 - 2
            }
            return 0 - 2
          }
        }
      }
    }
    i = 0
    while i < s.then_body.size {
      got = self.stmt_vstep(s.then_body[i], ivar)
      if got == 0 - 2 {
        return 0 - 2
      }
      if got > 0 {
        return got
      }
      i = i + 1
    }
    i = 0
    while i < s.else_body.size {
      got = self.stmt_vstep(s.else_body[i], ivar)
      if got == 0 - 2 {
        return 0 - 2
      }
      if got > 0 {
        return got
      }
      i = i + 1
    }
    i = 0
    while i < s.body.size {
      got = self.stmt_vstep(s.body[i], ivar)
      if got == 0 - 2 {
        return 0 - 2
      }
      if got > 0 {
        return got
      }
      i = i + 1
    }
    0 - 1
  }

  pub fn check_body(body: Array(Stmt), expected: Ty, at_tail: Bool) {
    i = 0
    while i < body.size {
      last = false
      if at_tail {
        if i == body.size - 1 {
          last = true
        }
      }
      if body[i].kind == st_while() {
        if i > 0 {
          self.annotate_vstep(body[i - 1], body[i])
        }
      }
      self.clear_poison
      self.scan_pending_stmt(body[i])
      self.check_stmt(body[i], expected, last)
      if self.has_err {
      } else {
        self.register_spawn_pending(body[i])
        self.fact_after_stmt(body[i])
      }
      i = i + 1
    }
  }

  pub fn check_block(body: Array(Stmt), expected: Ty, at_tail: Bool) {
    self.push_scope
    self.check_body(body, expected, at_tail)
    self.pop_scope
  }

  pub fn fallthrough(body: Array(Stmt)): Bool {
    if body.size == 0 {
      return true
    }
    last = body[body.size - 1]
    if last.kind == st_return() {
      return false
    }
    if last.kind == st_if() {
      if last.else_body.size == 0 {
        return true
      }
      if self.fallthrough(last.then_body) {
        return true
      }
      if self.fallthrough(last.else_body) {
        return true
      }
      return false
    }
    true
  }

  pub fn check_stmt(stmt: Stmt, expected: Ty, at_tail: Bool) {
    if self.has_err {
      return
    }
    k = stmt.kind
    if k == st_return() {
      if self.place_depth > 0 {
        self.fail(stmt.loc, "return inside Mutex.with")
        return
      }
      if self.lambda_infer {
        if expr = stmt.expr {
          self.inferred_ret = self.check_expr(expr)
        } else {
          self.inferred_ret = self.t_void()
        }
        return
      }
      if expr = stmt.expr {
        got = self.check_expr_as(expr, expected)
        if self.reject_clayout_value(got, expr.loc) {
          return
        }
        if ty_assignable(got, expected) {
        } else {
          self.fail(stmt.loc, "return type is ${got.show}, expected ${expected.show}")
        }
      } else {
        if expected.is_void {
        } else {
          self.fail(stmt.loc, "return needs a value of type ${expected.show}")
        }
      }
      return
    }
    if k == st_if() {
      if stmt.bind.size > 0 {
        self.check_if_assign(stmt, expected, at_tail)
        return
      }
      saved_facts = self.fact_var.size
      if cond = stmt.cond {
        self.push_loop_facts(cond, stmt.then_body)
      }
      if cond = stmt.cond {
        ct = self.check_expr(cond)
        if ct.is_bool {
        } else {
          self.fail(cond.loc, "if condition must be Bool, got ${ct.show}")
        }
      }
      if cond = stmt.cond {
        self.push_loop_facts(cond, stmt.then_body)
        fi = saved_facts
        while fi < self.fact_var.size {
          if self.body_shrinks(stmt.then_body, self.fact_cont[fi]) {
            self.fact_live[fi] = 0
          }
          fi = fi + 1
        }
      }
      self.check_block(stmt.then_body, expected, false)
      self.pop_loop_facts(saved_facts)
      if stmt.else_body.size > 0 {
        self.check_block(stmt.else_body, expected, false)
      }
      if at_tail {
        if expected.is_void {
        } else {
          ok = false
          if stmt.else_body.size > 0 {
            if self.fallthrough(stmt.then_body) {
            } else {
              if self.fallthrough(stmt.else_body) {
              } else {
                ok = true
              }
            }
          }
          if ok {
          } else {
            self.fail(stmt.loc, "missing return value")
          }
        }
      }
      return
    }
    if k == st_while() {
      has_pre = stmt.pre.size > 0
      if has_pre {
        self.push_scope
        pi = 0
        while pi < stmt.pre.size {
          self.annotate_vstep(stmt.pre[pi], stmt)
          self.clear_poison
          self.check_stmt(stmt.pre[pi], self.t_void(), false)
          if self.has_err {
          } else {
            self.fact_after_stmt(stmt.pre[pi])
          }
          pi = pi + 1
        }
        if stmt.for_kind == 1 {
          if pt = stmt.pre[0].target {
            if pty = self.lookup(pt.ident) {
              if pty.is_int {
              } else {
                self.fail(stmt.loc, "for range bounds must be Int, got ${pty.show}")
              }
            }
          }
          if stmt.pre.size > 1 {
            if pt2 = stmt.pre[1].target {
              if pty2 = self.lookup(pt2.ident) {
                if pty2.is_int {
                } else {
                  self.fail(stmt.loc, "for range bounds must be Int, got ${pty2.show}")
                }
              }
            }
          }
        }
        if stmt.for_kind == 2 {
          if pt = stmt.pre[0].target {
            if pty = self.lookup(pt.ident) {
              if pty.is_array {
              } else {
                self.fail(stmt.loc, "for needs a range (a..b) or an Array, got ${pty.show}")
              }
            }
          }
        }
      }
      saved_facts = self.fact_var.size
      if cond = stmt.cond {
        self.push_loop_facts(cond, stmt.body)
      }
      if cond = stmt.cond {
        ct = self.check_expr(cond)
        if ct.is_bool {
        } else {
          self.fail(cond.loc, "while condition must be Bool, got ${ct.show}")
        }
      }
      self.loop_depth = self.loop_depth + 1
      self.check_block(stmt.body, expected, false)
      self.loop_depth = self.loop_depth - 1
      self.pop_loop_facts(saved_facts)
      if at_tail {
        if expected.is_void {
        } else {
          self.fail(stmt.loc, "missing return value")
        }
      }
      if has_pre {
        self.pop_scope
      }
      return
    }
    if k == st_break() {
      if self.loop_depth == 0 {
        self.fail(stmt.loc, "break is only valid inside while")
      }
      if at_tail {
        if expected.is_void {
        } else {
          self.fail(stmt.loc, "missing return value")
        }
      }
      return
    }
    if k == st_continue() {
      if self.loop_depth == 0 {
        self.fail(stmt.loc, "continue is only valid inside while")
      }
      if at_tail {
        if expected.is_void {
        } else {
          self.fail(stmt.loc, "missing return value")
        }
      }
      return
    }
    if k == st_assign() {
      self.check_assign(stmt)
      if at_tail {
        if expected.is_void {
        } else {
          self.fail(stmt.loc, "missing return value")
        }
      }
      return
    }
    if k == st_expr() {
      if expr = stmt.expr {
        if at_tail {
          if expr.kind == ex_lambda() {
            if expected.is_void {
            } else {
              got = self.check_expr_as(expr, expected)
              return
            }
          }
          if self.lambda_infer {
            self.inferred_ret = self.check_expr(expr)
            return
          }
        }
        got = self.check_expr(expr)
        if at_tail {
          if expected.is_void {
            if got.is_void {
            } else {
              self.fail(stmt.loc, "unused ${got.show} value at the end of a void function")
            }
          } else {
            if ty_assignable(got, expected) {
            } else {
              self.fail(stmt.loc, "last expression is ${got.show}, expected ${expected.show}")
            }
          }
        }
      }
      return
    }
    self.fail(stmt.loc, "unknown statement")
  }

  pub fn check_if_assign(stmt: Stmt, expected: Ty, at_tail: Bool) {
    if cond = stmt.cond {
      got = self.check_expr(cond)
      success = self.if_assign_success(got, cond.loc)
      self.push_scope
      self.bind(stmt.bind, success)
      self.check_body(stmt.then_body, expected, false)
      self.pop_scope
      if stmt.else_body.size > 0 {
        self.check_block(stmt.else_body, expected, false)
      }
      if at_tail {
        if expected.is_void {
        } else {
          ok = false
          if stmt.else_body.size > 0 {
            if self.fallthrough(stmt.then_body) {
            } else {
              if self.fallthrough(stmt.else_body) {
              } else {
                ok = true
              }
            }
          }
          if ok {
          } else {
            self.fail(stmt.loc, "missing return value")
          }
        }
      }
    }
  }

  pub fn if_assign_success(got: Ty, loc: Location): Ty {
    if got.is_union {
      if got.includes_nil {
        success = ty_without_nil(got)
        if success.is_union {
          self.fail(loc, "if-assign needs a single success type, got ${got.show}")
          return self.t_int()
        }
        return success
      }
    }
    self.fail(loc, "if-assign expects T?, got ${got.show}")
    self.t_int()
  }

  pub fn check_assign(stmt: Stmt) {
    if self.reject_place_assign(stmt) {
      return
    }
    if stmt.op != tk_eq() {
      self.check_compound_assign(stmt)
      return
    }
    if target = stmt.target {
      if value = stmt.value {
        if target.kind == ex_name() {
          if str_eq(target.ident, "self") {
            self.fail(stmt.loc, "cannot assign to self")
            return
          }
          if declared = stmt.declared {
            want = self.resolve_in_module(declared)
            self.pull_resolve
            if self.reject_clayout_value(want, declared.loc) {
              return
            }
            if existing = self.lookup(target.ident) {
              self.fail(stmt.loc, "cannot shadow ${target.ident}")
              return
            }
            if field_ty = self.implicit_field(target.ident) {
              self.fail(stmt.loc, "cannot shadow ${target.ident}")
              return
            }
            early = false
            if value.kind == ex_lambda() {
              self.bind(target.ident, want)
              target.ty = want
              early = true
            }
            got = self.check_expr_as(value, want)
            if ty_assignable(got, want) {
            } else {
              if self.fn_compatible(got, want) {
              } else {
                self.fail(value.loc, "cannot assign ${got.show} to ${want.show}")
              }
            }
            if early {
            } else {
              self.bind(target.ident, want)
              target.ty = want
            }
            return
          }
          if existing = self.lookup(target.ident) {
            self.note_capture(target.ident, existing)
            got = self.check_expr_as(value, existing)
            if ty_assignable(got, existing) {
            } else {
              self.fail(value.loc, "cannot assign ${got.show} to ${existing.show}")
            }
            target.ty = existing
            return
          }
          if field_ty = self.implicit_field(target.ident) {
            target.implicit_field = true
            target.ty = field_ty
            got = self.check_expr_as(value, field_ty)
            if ty_assignable(got, field_ty) {
            } else {
              self.fail(value.loc, "cannot assign ${got.show} to ${field_ty.show}")
            }
            return
          }
          got = self.check_expr(value)
          if got.is_void {
            self.fail(stmt.loc, "cannot bind a Void value")
            return
          }
          if self.reject_clayout_value(got, value.loc) {
            return
          }
          self.bind(target.ident, got)
          target.ty = got
          return
        }
        if extra = stmt.declared {
          self.fail(stmt.loc, "type annotation only belongs on a new name")
          return
        }
        if target.kind == ex_index() {
          if arr = target.left {
            if ix = target.right {
              container = self.check_expr(arr)
              if container.is_hash {
                if k = container.key {
                  key = self.check_expr_as(ix, k)
                  if ty_assignable(key, k) {
                  } else {
                    self.fail(ix.loc, "hash key must be ${k.show}, got ${key.show}")
                  }
                }
                if v = container.val {
                  got = self.check_expr_as(value, v)
                  if ty_assignable(got, v) {
                  } else {
                    self.fail(value.loc, "cannot assign ${got.show} to ${v.show}")
                  }
                  target.ty = v
                  return
                }
              }
            }
          }
        }
        place = self.check_expr(target)
        if target.kind == ex_field() {
          if target.method_call {
            self.fail(stmt.loc, "cannot assign to a method")
            return
          }
        }
        if self.reject_clayout_value(place, target.loc) {
          return
        }
        got = self.check_expr_as(value, place)
        if ty_assignable(got, place) {
        } else {
          self.fail(value.loc, "cannot assign ${got.show} to ${place.show}")
        }
        return
      }
    }
    self.fail(stmt.loc, "cannot assign to this expression")
  }

  pub fn check_compound_assign(stmt: Stmt) {
    if declared = stmt.declared {
      self.fail(stmt.loc, "type annotation only belongs on a new name")
      return
    }
    if target = stmt.target {
      if value = stmt.value {
        if target.kind == ex_name() {
          if str_eq(target.ident, "self") {
            self.fail(stmt.loc, "cannot assign to self")
            return
          }
        }
        place = self.check_expr(target)
        if target.kind == ex_field() {
          if target.method_call {
            self.fail(stmt.loc, "cannot assign to a method")
            return
          }
        }
        if self.reject_clayout_value(place, target.loc) {
          return
        }
        got = self.check_expr_as(value, place)
        if got.same_as(place) {
        } else {
          self.fail(value.loc, "cannot assign ${got.show} to ${place.show}")
        }
        if place.is_numeric {
        } else {
          self.fail(stmt.loc, "compound assignment expects a numeric target, got ${place.show}")
        }
        if target.kind == ex_name() {
          if value.kind == ex_int() {
            if stmt.op == tk_plus_eq() {
              s = self.fact_any_slack(target.ident)
              if s >= 0 {
                if value.int_bits <= s.to_u64 + 1u64 {
                  stmt.proven = true
                }
              }
            }
            if stmt.op == tk_minus_eq() {
              if self.fact_any_slack(target.ident) >= 0 || self.nn_has(target.ident) {
                stmt.proven = true
              }
            }
          }
        }
        return
      }
    }
  }

  pub fn check_expr(expr: Expr): Ty {
    self.check_expr_flag(expr, false, self.t_int())
  }

  pub fn check_expr_as(expr: Expr, want: Ty): Ty {
    self.check_expr_flag(expr, true, want)
  }

  pub fn check_expr_flag(expr: Expr, has_want: Bool, want: Ty): Ty {
    if self.has_err {
      return self.t_int()
    }
    mark = self.err_count
    kind = self.check_expr_core(expr, has_want, want)
    if self.new_err_since(mark) {
      expr.ty = kind
      return kind
    }
    if has_want {
      if ty_has_var(want) {
      } else {
        if ty_assignable(kind, want) {
        } else {
          if self.fn_compatible(kind, want) {
          } else {
            self.fail(expr.loc, "expected ${want.show}, got ${kind.show}")
          }
        }
      }
    }
    expr.ty = kind
    kind
  }

  pub fn check_expr_core(expr: Expr, has_want: Bool, want: Ty): Ty {
    k = expr.kind
    if k == ex_int() {
      return self.check_integer(expr, has_want, want)
    }
    if k == ex_float() {
      return self.t_float()
    }
    if k == ex_string() {
      return self.t_string()
    }
    if k == ex_bool() {
      return self.t_bool()
    }
    if k == ex_nil() {
      return self.t_nil()
    }
    if k == ex_name() {
      return self.check_name(expr, has_want, want)
    }
    if k == ex_lambda() {
      return self.check_lambda(expr, has_want, want)
    }
    if k == ex_call() {
      return self.check_call(expr, has_want, want)
    }
    if k == ex_unary() {
      return self.check_unary(expr)
    }
    if k == ex_binary() {
      return self.check_binary(expr)
    }
    if k == ex_switch() {
      return self.check_switch(expr, has_want, want)
    }
    if k == ex_field() {
      return self.check_field(expr)
    }
    if k == ex_struct() {
      return self.check_struct_literal(expr, has_want, want)
    }
    if k == ex_index() {
      return self.check_index(expr)
    }
    if k == ex_array_new() {
      return self.check_array_new(expr)
    }
    if k == ex_array() {
      return self.check_array_literal(expr, has_want, want)
    }
    if k == ex_hash_new() {
      return self.check_hash_new(expr)
    }
    if k == ex_try() {
      return self.check_try(expr)
    }
    if k == ex_interp() {
      return self.check_interp(expr)
    }
    self.fail(expr.loc, "unknown expression")
    self.t_int()
  }

  pub fn check_try(expr: Expr): Ty {
    if inner = expr.inner {
      got = self.check_expr(inner)
      return self.split_try_success(got, expr.loc)
    }
    self.t_int()
  }

  pub fn coalesce_result(left: Ty, right_expr: Expr, loc: Location, opname: String): Ty {
    payload = ty_without_nil(left)
    if right_expr.kind == ex_nil() {
      dummy = self.check_expr(right_expr)
      return left
    }
    right = self.check_expr_as(right_expr, payload)
    if right.is_nil {
      return left
    }
    if right.is_nilable {
      rp = ty_without_nil(right)
      if rp.same_as(payload) {
        return left
      }
      self.fail(loc, "${opname} fallback must be ${payload.show}, got ${right.show}")
      return left
    }
    if ty_assignable(right, payload) {
      return payload
    }
    self.fail(loc, "${opname} fallback must be ${payload.show}, got ${right.show}")
    payload
  }

  pub fn split_try_success(got: Ty, loc: Location): Ty {
    if got.is_union {
      if got.includes_nil {
        return ty_without_nil(got)
      }
      ret = self.return_type
      if ret.is_union {
        succ: Array(Ty) = []
        fails: Array(Ty) = []
        i = 0
        while i < got.members.size {
          m = got.members[i]
          if ret.includes_member(m) {
            fails.push(m)
          } else {
            succ.push(m)
          }
          i = i + 1
        }
        if succ.size == 1 {
          if fails.size > 0 {
            return succ[0]
          }
        }
        self.fail(loc, "cannot use postfix ? on ${got.show} in a function returning ${ret.show}")
        return self.t_int()
      }
      self.fail(loc, "postfix ? needs the function to return a union that includes the failure")
      return self.t_int()
    }
    self.fail(loc, "postfix ? expects a union, got ${got.show}")
    self.t_int()
  }

  pub fn check_interp(expr: Expr): Ty {
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      if inner = part.expr {
        ty = self.check_expr(inner)
        ok = false
        if ty.is_integer {
          ok = true
        }
        if ty.is_string {
          ok = true
        }
        if ty.is_float {
          ok = true
        }
        if ty.is_bool {
          ok = true
        }
        if ok {
        } else {
          self.fail(inner.loc, "cannot interpolate ${ty.show}")
        }
      }
      i = i + 1
    }
    self.t_string()
  }

  pub fn check_float_field(expr: Expr): Ty {
    if str_eq(expr.ident, "sqrt") {
      expr.method_call = true
      return self.t_float()
    }
    if str_eq(expr.ident, "abs") {
      expr.method_call = true
      return self.t_float()
    }
    if str_eq(expr.ident, "floor") {
      expr.method_call = true
      return self.t_float()
    }
    if str_eq(expr.ident, "to_i") {
      expr.method_call = true
      return self.t_int()
    }
    self.fail(expr.loc, "Float64 has no field ${expr.ident}")
    self.t_float()
  }

  pub fn check_int_field(expr: Expr, object: Ty): Ty {
    if str_eq(expr.ident, "to_f") {
      expr.method_call = true
      return self.t_float()
    }
    if str_eq(expr.ident, "abs") {
      expr.method_call = true
      return object
    }
    if str_eq(expr.ident, "to_i") {
      expr.method_call = true
      return self.t_int()
    }
    if str_eq(expr.ident, "to_i64") {
      expr.method_call = true
      return self.t_int64()
    }
    if str_eq(expr.ident, "to_u64") {
      expr.method_call = true
      return self.t_uint64()
    }
    self.fail(expr.loc, "${object.show} has no field ${expr.ident}")
    object
  }

  pub fn check_field(expr: Expr): Ty {
    if obj = expr.object {
      if obj.kind == ex_name() {
        if obj.type_args.size > 0 {
          if self.is_generic_template(obj.ident) {
          } else {
            call = self.type_app_as_call(obj)
            expr.object = call
            obj = call
          }
        }
      }
      object = self.check_expr(obj)
      if object.is_float {
        return self.check_float_field(expr)
      }
      if object.is_integer {
        return self.check_int_field(expr, object)
      }
      if object.is_string {
        if str_eq(expr.ident, "size") {
          return self.t_int()
        }
        if str_eq(expr.ident, "bytes") {
          expr.method_call = true
          return self.t_bytes()
        }
        if str_eq(expr.ident, "chars") {
          expr.method_call = true
          return ty_array(self.t_string())
        }
        if str_eq(expr.ident, "to_f") {
          expr.method_call = true
          return self.t_float()
        }
        if str_eq(expr.ident, "to_i") {
          expr.method_call = true
          return self.t_int()
        }
        self.fail(expr.loc, "String has no field ${expr.ident} (did you mean size?)")
        return self.t_int()
      }
      if object.is_bytes {
        if str_eq(expr.ident, "size") {
          return self.t_int()
        }
        if str_eq(expr.ident, "to_buf") {
          expr.method_call = true
          return self.t_buf()
        }
        if str_eq(expr.ident, "chars") {
          expr.method_call = true
          return ty_array(self.t_string())
        }
        self.fail(expr.loc, "Bytes has no field ${expr.ident} (did you mean size?)")
        return self.t_int()
      }
      if object.is_array {
        if str_eq(expr.ident, "size") {
          return self.t_int()
        }
        if str_eq(expr.ident, "pop") {
          expr.method_call = true
          if e = object.inner {
            return e
          }
          return self.t_int()
        }
        if str_eq(expr.ident, "clear") {
          expr.method_call = true
          return self.t_void()
        }
        if str_eq(expr.ident, "sort") {
          expr.method_call = true
          if e = object.inner {
            if self.is_ordered_ty(e) {
            } else {
              self.fail(expr.loc, "Array.sort needs an ordered element type or a comparator block")
            }
          }
          return self.t_void()
        }
        if str_eq(expr.ident, "sorted") {
          expr.method_call = true
          if e = object.inner {
            if self.is_ordered_ty(e) {
            } else {
              self.fail(expr.loc, "Array.sorted needs an ordered element type or a comparator block")
            }
            return ty_array(e)
          }
          return ty_array(self.t_int())
        }
        if str_eq(expr.ident, "reverse") {
          expr.method_call = true
          return self.t_void()
        }
        if str_eq(expr.ident, "min") {
          expr.method_call = true
          if e = object.inner {
            if self.is_ordered_ty(e) {
              if e.is_bool {
                self.fail(expr.loc, "Array.min needs an ordered element type")
              }
            } else {
              self.fail(expr.loc, "Array.min needs an ordered element type")
            }
            return ty_nilable(e)
          }
          return ty_nilable(self.t_int())
        }
        if str_eq(expr.ident, "max") {
          expr.method_call = true
          if e = object.inner {
            if self.is_ordered_ty(e) {
              if e.is_bool {
                self.fail(expr.loc, "Array.max needs an ordered element type")
              }
            } else {
              self.fail(expr.loc, "Array.max needs an ordered element type")
            }
            return ty_nilable(e)
          }
          return ty_nilable(self.t_int())
        }
        if str_eq(expr.ident, "sum") {
          expr.method_call = true
          if e = object.inner {
            if self.is_numeric_ty(e) {
              return e
            }
            self.fail(expr.loc, "Array.sum needs a numeric element type")
            return e
          }
          return self.t_int()
        }
        self.fail(expr.loc, "${object.show} has no field ${expr.ident} (did you mean size?)")
        return self.t_int()
      }
      if object.is_hash {
        if str_eq(expr.ident, "size") {
          return self.t_int()
        }
        if str_eq(expr.ident, "keys") {
          expr.method_call = true
          if k = object.key {
            return ty_array(k)
          }
          return ty_array(self.t_int())
        }
        if str_eq(expr.ident, "values") {
          expr.method_call = true
          if v = object.val {
            return ty_array(v)
          }
          return ty_array(self.t_int())
        }
        if str_eq(expr.ident, "clear") {
          expr.method_call = true
          return self.t_void()
        }
        self.fail(expr.loc, "${object.show} has no field ${expr.ident} (did you mean size?)")
        return self.t_int()
      }
      if object.is_buf {
        if str_eq(expr.ident, "size") {
          return self.t_int()
        }
        if str_eq(expr.ident, "to_bytes") {
          expr.method_call = true
          return self.t_bytes()
        }
        if str_eq(expr.ident, "to_s") {
          expr.method_call = true
          return self.t_string()
        }
        if str_eq(expr.ident, "clear") {
          expr.method_call = true
          return self.t_void()
        }
        self.fail(expr.loc, "Buf has no field ${expr.ident}")
        return self.t_int()
      }
      if object.is_join {
        if str_eq(expr.ident, "join") {
          expr.method_call = true
          if self.in_task > 0 {
            self.fail(expr.loc, "join inside a pool worker")
          }
          if inner = object.inner {
            return inner
          }
          return self.t_int()
        }
        self.fail(expr.loc, "JoinHandle has no field ${expr.ident} (did you mean join?)")
        return self.t_int()
      }
      if object.is_agg {
        if field_ty = object.field_named(expr.ident) {
          if sig = self.find_method(object.name, expr.ident) {
            self.fail(expr.loc, "${object.name}.${expr.ident} is both a field and a method")
            return field_ty
          }
          return field_ty
        }
        has_zero = false
        mi = 0
        while mi < self.methods.size {
          ms = self.methods[mi]
          owner_hit = false
          if str_eq(ms.owner, object.name) {
            owner_hit = true
          } else {
            if object.origin.size > 0 {
              if ms.node.generic {
                if str_eq(ms.owner, object.origin) {
                  owner_hit = true
                }
              }
            }
          }
          if owner_hit {
            if str_eq(ms.name, expr.ident) {
              if arity_ok(ms.node, 0) {
                has_zero = true
              }
            }
          }
          mi = mi + 1
        }
        if has_zero {
          arg_tys: Array(Ty) = []
          none: Ty? = nil
          if sig = self.match_method(object.name, expr.ident, arg_tys, none, expr.loc, object.name) {
            expr.method_call = true
            expr.resolved = sig.node.emit_name
            return sig.ret
          }
          return self.t_int()
        }
        has_method = false
        mi = 0
        while mi < self.methods.size {
          ms = self.methods[mi]
          owner_hit = false
          if str_eq(ms.owner, object.name) {
            owner_hit = true
          } else {
            if object.origin.size > 0 {
              if ms.node.generic {
                if str_eq(ms.owner, object.origin) {
                  owner_hit = true
                }
              }
            }
          }
          if owner_hit {
            if str_eq(ms.name, expr.ident) {
              has_method = true
            }
          }
          mi = mi + 1
        }
        if has_method {
          self.fail(expr.loc, "methods are not values")
        } else {
          self.fail(expr.loc, "no field ${expr.ident} on ${object.name}")
        }
        return self.t_int()
      }
      if object.is_ptr {
        return self.check_ptr_member(expr, object)
      }
      if object.is_clayout {
        return self.check_clayout_member(expr, object)
      }
      self.fail(expr.loc, "cannot read field ${expr.ident} on ${object.show}")
      return self.t_int()
    }
    self.t_int()
  }

  pub fn clayout_value_name(ty: Ty): String {
    if ty.is_clayout {
      return ty.show
    }
    if ty.is_array {
      if e = ty.inner {
        return self.clayout_value_name(e)
      }
    }
    if ty.is_union {
      i = 0
      while i < ty.members.size {
        name = self.clayout_value_name(ty.members[i])
        if name.size > 0 {
          return name
        }
        i = i + 1
      }
    }
    ""
  }

  pub fn reject_clayout_value(ty: Ty, loc: Location): Bool {
    name = self.clayout_value_name(ty)
    if name.size > 0 {
      self.fail(loc, "${name} is a C layout; use Ptr(${name})")
      return true
    }
    false
  }

  pub fn check_ptr_member(expr: Expr, object: Ty): Ty {
    owner = self.method_owner_name(object)
    pointee = object
    if inner = object.inner {
      pointee = inner
    }
    if pointee.is_clayout {
      if field_ty = pointee.field_named(expr.ident) {
        if sig = self.find_method(owner, expr.ident) {
          self.fail(expr.loc, "${pointee.name}.${expr.ident} is both a field and a method")
          return field_ty
        }
        return field_ty
      }
    }
    has_zero = false
    mi = 0
    while mi < self.methods.size {
      ms = self.methods[mi]
      if str_eq(ms.owner, owner) {
        if str_eq(ms.name, expr.ident) {
          if arity_ok(ms.node, 0) {
            has_zero = true
          }
        }
      }
      mi = mi + 1
    }
    if has_zero {
      arg_tys: Array(Ty) = []
      none: Ty? = nil
      if sig = self.match_method(owner, expr.ident, arg_tys, none, expr.loc, object.show) {
        expr.method_call = true
        expr.resolved = sig.node.emit_name
        return sig.ret
      }
      return self.t_int()
    }
    self.fail(expr.loc, "no field ${expr.ident} on ${object.show}")
    self.t_int()
  }

  pub fn check_clayout_member(expr: Expr, object: Ty): Ty {
    if field_ty = object.field_named(expr.ident) {
      return field_ty
    }
    self.fail(expr.loc, "no field ${expr.ident} on ${object.show}")
    self.t_int()
  }

  pub fn check_index(expr: Expr): Ty {
    if arr = expr.left {
      if ix = expr.right {
        if arr.kind == ex_name() {
          if arr.implicit_field {
          } else {
            cont = arr.ident
            if ix.kind == ex_name() {
              if self.fact_slack_of(ix.ident, cont) >= 0 {
                expr.proven = true
              }
            } else if ix.kind == ex_binary() {
              if ix.op == tk_plus() {
                if il = ix.left {
                  if ir = ix.right {
                    if il.kind == ex_name() {
                      if self.lit_small(ir) {
                        sl = self.fact_slack_of(il.ident, cont)
                        if sl >= 0 {
                          if ir.int_bits <= sl.to_u64 {
                            expr.proven = true
                            ix.proven = true
                          }
                        }
                      }
                    }
                    if ir.kind == ex_name() {
                      if self.lit_small(il) {
                        sl = self.fact_slack_of(ir.ident, cont)
                        if sl >= 0 {
                          if il.int_bits <= sl.to_u64 {
                            expr.proven = true
                            ix.proven = true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        if ix.kind == ex_binary() {
          if ix.op == tk_plus() || ix.op == tk_minus() {
            if il = ix.left {
              if ir = ix.right {
                if il.kind == ex_int() || ir.kind == ex_int() {
                  ix.proven = true
                }
              }
            }
          }
        }
        container = self.check_expr(arr)
        if container.is_string || container.is_buf || container.is_bytes {
          got = self.check_expr_as(ix, self.t_int())
          if got.is_int {
          } else {
            self.fail(ix.loc, "index must be Int, got ${got.show}")
          }
          return self.t_int()
        }
        if container.is_hash {
          if k = container.key {
            key = self.check_expr_as(ix, k)
            if ty_assignable(key, k) {
            } else {
              self.fail(ix.loc, "hash key must be ${k.show}, got ${key.show}")
            }
          }
          if v = container.val {
            return ty_nilable(v)
          }
          return self.t_int()
        }
        if container.is_array {
          got = self.check_expr_as(ix, self.t_int())
          if got.is_int {
          } else {
            self.fail(ix.loc, "array index must be Int, got ${got.show}")
          }
          if e = container.inner {
            return e
          }
          return self.t_int()
        }
        self.fail(expr.loc, "cannot index ${container.show}")
        return self.t_int()
      }
    }
    self.t_int()
  }

  pub fn check_array_new(expr: Expr): Ty {
    elem = self.t_int()
    if tn = expr.elem_type {
      elem = self.resolve_in_module(tn)
      self.pull_resolve
      if self.reject_clayout_value(elem, tn.loc) {
        return self.t_int()
      }
    }
    if size = expr.size_expr {
      st = self.check_expr_as(size, self.t_int())
      if st.is_int {
      } else {
        self.fail(size.loc, "Array(T).new expects Int size")
      }
    }
    ty_array(elem)
  }

  pub fn check_array_literal(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.elems.size == 0 {
      if has_want {
        if want.is_array {
          return want
        }
      }
      self.fail(expr.loc, "empty array needs a type, e.g. xs: Array(Int) = []")
      return self.t_int()
    }
    elem_ty = self.t_int()
    forced = false
    if has_want {
      if want.is_array {
        if e = want.inner {
          if ty_has_var(e) {
          } else {
            elem_ty = e
            forced = true
          }
        }
      }
    }
    if forced {
    } else {
      elem_ty = self.check_expr(expr.elems[0])
    }
    i = 0
    while i < expr.elems.size {
      el = expr.elems[i]
      got = self.check_expr_as(el, elem_ty)
      if ty_assignable(got, elem_ty) {
      } else {
        self.fail(el.loc, "array element is ${got.show}, expected ${elem_ty.show}")
      }
      i = i + 1
    }
    ty_array(elem_ty)
  }

  pub fn check_hash_new(expr: Expr): Ty {
    key = self.t_int()
    val = self.t_int()
    if kn = expr.key_type {
      key = self.resolve_value_in_module(kn)
      self.pull_resolve
    }
    if vn = expr.val_type {
      val = self.resolve_value_in_module(vn)
      self.pull_resolve
    }
    if key.is_string {
    } else {
      if key.is_int {
      } else {
        self.fail(expr.loc, "Hash keys must be String or Int")
        return self.t_int()
      }
    }
    if val.is_int {
    } else {
      if val.is_string {
      } else {
        self.fail(expr.loc, "Hash values must be Int or String")
        return self.t_int()
      }
    }
    if key.is_int {
      if val.is_string {
        self.fail(expr.loc, "Hash(Int, String) is not in this stage")
        return self.t_int()
      }
    }
    ty_hash(key, val)
  }

  pub fn check_struct_literal(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.type_args.size > 0 {
      tn = TypeName.new(expr.loc, expr.type_name)
      tn.mod_name = expr.mod_name
      i = 0
      while i < expr.type_args.size {
        tn.args.push(expr.type_args[i])
        i = i + 1
      }
      ty = self.resolve_in_module(tn)
      self.pull_resolve
      if self.has_err {
        return self.t_int()
      }
      return self.check_struct_fields(expr, ty, true)
    }
    if tmpl = self.find_struct_template(expr.type_name) {
      return self.infer_struct_literal(expr, tmpl, has_want, want)
    }
    if ty = self.lookup_named_type(expr.type_name, expr.loc, expr.mod_name) {
      return self.check_struct_fields(expr, ty, true)
    }
    self.fail(expr.loc, "unknown type ${expr.type_name}")
    self.t_int()
  }

  pub fn check_struct_fields(expr: Expr, ty: Ty, check_values: Bool): Ty {
    if ty.template {
      self.fail(expr.loc, "${ty.name} needs type arguments")
      return self.t_int()
    }
    if ty.is_class {
      shown = ty.show
      self.fail(expr.loc, "classes are constructed with ${shown}.new, not ${shown} { }")
      return ty
    }
    if self.reject_clayout_value(ty, expr.loc) {
      return ty
    }
    seen = Hash(String, Int).new
    i = 0
    while i < expr.field_names.size {
      fname = expr.field_names[i]
      value = expr.field_exprs[i]
      if prev = seen.get(fname) {
        self.fail(value.loc, "duplicate field ${fname}")
      }
      seen[fname] = 1
      if field_ty = ty.field_named(fname) {
        if check_values {
          got = self.check_expr_as(value, field_ty)
          if ty_assignable(got, field_ty) {
          } else {
            if ty_has_var(field_ty) {
            } else {
              self.fail(value.loc, "field ${fname} is ${got.show}, expected ${field_ty.show}")
            }
          }
        }
      } else {
        label = ty.show
        self.fail(value.loc, "no field ${fname} on ${label}")
      }
      i = i + 1
    }
    i = 0
    while i < ty.fields.size {
      f = ty.fields[i]
      if prev = seen.get(f.name) {
      } else {
        self.fail(expr.loc, "missing field ${f.name}")
      }
      i = i + 1
    }
    ty
  }

  pub fn find_struct_template(name: String): StructDef? {
    i = 0
    while i < self.program.structs.size {
      sdef = self.program.structs[i]
      if str_eq(sdef.name, name) {
        if sdef.type_params.size > 0 {
          return sdef
        }
      }
      i = i + 1
    }
    nil
  }

  pub fn find_class_template(name: String): ClassDef? {
    i = 0
    while i < self.program.classes.size {
      cdef = self.program.classes[i]
      if str_eq(cdef.name, name) {
        if cdef.type_params.size > 0 {
          return cdef
        }
      }
      i = i + 1
    }
    nil
  }

  pub fn is_generic_template(name: String): Bool {
    if s = self.find_struct_template(name) {
      return true
    }
    if c = self.find_class_template(name) {
      return true
    }
    false
  }

  pub fn apply_want_args(origin: String, params: Array(String), has_want: Bool, want: Ty, keys: Array(String), vals: Array(Ty)): Bool {
    if has_want {
      if str_eq(want.origin, origin) {
        if want.ty_args.size == params.size {
          i = 0
          while i < params.size {
            warg = want.ty_args[i]
            if ty_has_var(warg) {
            } else {
              if self.unify_ty(ty_var(params[i]), warg, keys, vals) {
              } else {
                return false
              }
            }
            i = i + 1
          }
        }
      }
    }
    true
  }

  pub fn solved_args(params: Array(String), keys: Array(String), vals: Array(Ty), loc: Location): Array(Ty)? {
    out: Array(Ty) = []
    i = 0
    while i < params.size {
      if got = self.subst_get(keys, vals, params[i]) {
        out.push(got)
      } else {
        return nil
      }
      i = i + 1
    }
    out
  }

  pub fn instantiate_applied(name: String, mod_name: String, args: Array(Ty), loc: Location): Ty {
    tn = TypeName.new(loc, name)
    tn.mod_name = mod_name
    i = 0
    while i < args.size {
      tn.args.push(ty_to_type_name(args[i], loc))
      i = i + 1
    }
    ty = self.resolve_in_module(tn)
    self.pull_resolve
    ty
  }

  pub fn infer_struct_literal(expr: Expr, tmpl: StructDef, has_want: Bool, want: Ty): Ty {
    params = tmpl.type_params
    self.resolver.set_tparams(params)
    patterns: Array(Ty) = []
    names: Array(String) = []
    i = 0
    while i < tmpl.fields.size {
      names.push(tmpl.fields[i].name)
      patterns.push(self.resolver.resolve_value(tmpl.fields[i].type))
      self.pull_resolve
      i = i + 1
    }
    self.resolver.clear_tparams
    if self.has_err {
      return self.t_int()
    }
    keys: Array(String) = []
    vals: Array(Ty) = []
    if self.apply_want_args(tmpl.name, params, has_want, want, keys, vals) {
    } else {
      self.fail(expr.loc, "conflicting type arguments")
      return self.t_int()
    }
    seen = Hash(String, Int).new
    gots: Array(Ty) = []
    got_names: Array(String) = []
    i = 0
    while i < expr.field_names.size {
      fname = expr.field_names[i]
      value = expr.field_exprs[i]
      if prev = seen.get(fname) {
        self.fail(value.loc, "duplicate field ${fname}")
      }
      seen[fname] = 1
      pat: Ty? = nil
      j = 0
      while j < names.size {
        if str_eq(names[j], fname) {
          pat = patterns[j]
        }
        j = j + 1
      }
      if p = pat {
        pat_ty = self.subst_ty(p, keys, vals)
        got = self.check_expr_flag(value, true, pat_ty)
        gots.push(got)
        got_names.push(fname)
        if self.unify_ty(pat_ty, got, keys, vals) {
        } else {
          self.fail(value.loc, "conflicting type arguments")
        }
      } else {
        self.fail(value.loc, "no field ${fname} on ${tmpl.name}")
      }
      i = i + 1
    }
    if solved = self.solved_args(params, keys, vals, expr.loc) {
      ty = self.instantiate_applied(tmpl.name, expr.mod_name, solved, expr.loc)
      if self.has_err {
        return self.t_int()
      }
      i = 0
      while i < got_names.size {
        if field_ty = ty.field_named(got_names[i]) {
          if ty_assignable(gots[i], field_ty) {
          } else {
            self.fail(expr.loc, "field ${got_names[i]} is ${gots[i].show}, expected ${field_ty.show}")
          }
        }
        i = i + 1
      }
      i = 0
      while i < ty.fields.size {
        f = ty.fields[i]
        if prev = seen.get(f.name) {
        } else {
          self.fail(expr.loc, "missing field ${f.name}")
        }
        i = i + 1
      }
      return ty
    }
    self.fail(expr.loc, "cannot infer type argument; write ${tmpl.name}(...)")
    self.t_int()
  }

  pub fn check_name(expr: Expr, has_want: Bool, want: Ty): Ty {
    if str_eq(expr.ident, "self") {
      if st = self.self_ty {
      } else {
        if existing = self.lookup("self") {
          return existing
        }
        self.fail(expr.loc, "self is only valid in a method")
        return self.t_int()
      }
    }
    if self.lam_exprs.size > 0 {
      if self.self_name.size > 0 {
        if str_eq(expr.ident, self.self_name) {
          self.fail(expr.loc, "a lambda cannot capture the method receiver")
          return self.t_int()
        }
      }
    }
    if existing = self.lookup(expr.ident) {
      self.note_capture(expr.ident, existing)
      return existing
    }
    if field_ty = self.implicit_field(expr.ident) {
      if self.lam_exprs.size > 0 {
        self.fail(expr.loc, "a lambda cannot capture the method receiver")
        return self.t_int()
      }
      expr.implicit_field = true
      return field_ty
    }
    if k = self.known_mods.get(expr.ident) {
      if self.qualifier_ok(expr.ident, self.current_module) {
        return ty_module(expr.ident)
      }
    }
    if has_want {
      if want.is_fn {
        return self.check_fn_ref(expr, want)
      }
    }
    if got = self.check_fn_ref_bare(expr) {
      return got
    }
    if self.is_generic_template(expr.ident) {
      self.fail(expr.loc, "${expr.ident} needs type arguments")
      return self.t_int()
    }
    self.fail(expr.loc, "unknown name ${expr.ident}")
    self.t_int()
  }

  pub fn check_integer(expr: Expr, has_want: Bool, want: Ty): Ty {
    if has_want {
      if want.is_float {
        return self.t_float()
      }
    }
    if str_eq(expr.int_suffix, "u64") {
      return self.t_uint64()
    }
    if str_eq(expr.int_suffix, "i64") {
      return self.t_int64()
    }
    if has_want {
      if want.is_uint64 {
        return self.t_uint64()
      }
      if want.is_int64 {
        return self.t_int64()
      }
    }
    max = 2147483647u64
    if expr.int_bits <= max {
      return self.t_int()
    }
    self.fail(expr.loc, "integer literal does not fit in Int; use ${expr.int_bits}i64 or ${expr.int_bits}u64")
    self.t_int()
  }

  pub fn check_unary(expr: Expr): Ty {
    if inner = expr.inner {
      got = self.check_expr(inner)
      if expr.op == tk_minus() {
        if got.is_numeric {
          return got
        }
        self.fail(expr.loc, "unary minus expects Int or Float64")
        return self.t_int()
      }
      if expr.op == tk_bang() {
        if got.is_bool {
          return self.t_bool()
        }
        self.fail(expr.loc, "! expects Bool")
        return self.t_bool()
      }
      if expr.op == tk_tilde() {
        if got.is_integer {
          return got
        }
        self.fail(expr.loc, "~ expects an integer")
        return self.t_int()
      }
      self.fail(expr.loc, "unsupported unary operator")
      return self.t_int()
    }
    self.t_int()
  }

  pub fn bitwise_op(op: Int): Bool {
    if op == tk_amp() {
      return true
    }
    if op == tk_pipe() {
      return true
    }
    if op == tk_caret() {
      return true
    }
    if op == tk_less_less() {
      return true
    }
    op == tk_greater_greater()
  }

  pub fn shift_op(op: Int): Bool {
    if op == tk_less_less() {
      return true
    }
    op == tk_greater_greater()
  }

  pub fn int_binary(op: Int, ty: Ty): Ty {
    if op == tk_plus() {
      return ty
    }
    if op == tk_minus() {
      return ty
    }
    if op == tk_star() {
      return ty
    }
    if op == tk_slash() {
      return ty
    }
    if op == tk_eq_eq() {
      return self.t_bool()
    }
    if op == tk_not_eq() {
      return self.t_bool()
    }
    if op == tk_less() {
      return self.t_bool()
    }
    if op == tk_less_eq() {
      return self.t_bool()
    }
    if op == tk_greater() {
      return self.t_bool()
    }
    if op == tk_greater_eq() {
      return self.t_bool()
    }
    self.fail(self.program.loc, "unsupported operator")
    ty
  }

  pub fn float_binary(op: Int, loc: Location): Ty {
    if op == tk_plus() {
      return self.t_float()
    }
    if op == tk_minus() {
      return self.t_float()
    }
    if op == tk_star() {
      return self.t_float()
    }
    if op == tk_slash() {
      return self.t_float()
    }
    if op == tk_eq_eq() {
      return self.t_bool()
    }
    if op == tk_not_eq() {
      return self.t_bool()
    }
    if op == tk_less() {
      return self.t_bool()
    }
    if op == tk_less_eq() {
      return self.t_bool()
    }
    if op == tk_greater() {
      return self.t_bool()
    }
    if op == tk_greater_eq() {
      return self.t_bool()
    }
    self.fail(loc, "unsupported operator on Float64")
    self.t_float()
  }

  pub fn check_binary(expr: Expr): Ty {
    if l = expr.left {
      if r = expr.right {
        op = expr.op
        if op == tk_question_question() {
          left = self.check_expr(l)
          if left.is_nilable {
            return self.coalesce_result(left, r, expr.loc, "??")
          }
          dummy = self.check_expr(r)
          self.fail(expr.loc, "?? needs a nilable left side, got ${left.show}")
          return left
        }
        if op == tk_amp_amp() {
          left = self.check_expr(l)
          right = self.check_expr(r)
          if left.is_bool {
            if right.is_bool {
              return self.t_bool()
            }
          }
          self.fail(expr.loc, "&& expects Bool operands")
          return self.t_bool()
        }
        if op == tk_pipe_pipe() {
          left = self.check_expr(l)
          right = self.check_expr(r)
          if left.is_bool {
            if right.is_bool {
              return self.t_bool()
            }
          }
          self.fail(expr.loc, "|| expects Bool operands")
          return self.t_bool()
        }
        left = self.check_expr(l)
        opname = binary_op_method_name(op)
        if opname.size > 0 {
          if left.is_agg {
            has_op = false
            mi = 0
            while mi < self.methods.size {
              ms = self.methods[mi]
              if str_eq(ms.owner, left.name) {
                if str_eq(ms.name, opname) {
                  has_op = true
                }
              }
              mi = mi + 1
            }
            if has_op {
              right = self.check_expr(r)
              arg_tys: Array(Ty) = []
              arg_tys.push(right)
              none: Ty? = nil
              if sig = self.match_method(left.name, opname, arg_tys, none, expr.loc, left.name) {
                expr.resolved = sig.node.emit_name
                return sig.ret
              }
              return self.t_int()
            }
          }
        }
        right_has = false
        right_want = self.t_int()
        if left.is_integer {
          right_has = true
          right_want = left
        } else if left.is_float {
          right_has = true
          right_want = left
        } else if left.is_string {
          right_has = true
          right_want = left
        } else if left.is_bytes {
          right_has = true
          right_want = left
        }
        right = self.check_expr_flag(r, right_has, right_want)
        if left.is_fn {
          if op == tk_eq_eq() {
            self.fail(expr.loc, "cannot compare fn values")
            return self.t_bool()
          }
          if op == tk_not_eq() {
            self.fail(expr.loc, "cannot compare fn values")
            return self.t_bool()
          }
        }
        if right.is_fn {
          if op == tk_eq_eq() {
            self.fail(expr.loc, "cannot compare fn values")
            return self.t_bool()
          }
          if op == tk_not_eq() {
            self.fail(expr.loc, "cannot compare fn values")
            return self.t_bool()
          }
        }
        if left.is_string {
          if right.is_string {
            if op == tk_plus() {
              return self.t_string()
            }
            if op == tk_eq_eq() {
              return self.t_bool()
            }
            if op == tk_not_eq() {
              return self.t_bool()
            }
            self.fail(expr.loc, "unsupported operator on String")
            return self.t_string()
          }
        }
        if left.is_bytes {
          if right.is_bytes {
            if op == tk_eq_eq() {
              return self.t_bool()
            }
            if op == tk_not_eq() {
              return self.t_bool()
            }
            self.fail(expr.loc, "unsupported operator on Bytes")
            return self.t_bool()
          }
        }
        if op == tk_amp_plus() || op == tk_amp_minus() || op == tk_amp_star() {
          if left.is_integer {
            if right.same_as(left) {
              return left
            }
          }
          self.fail(expr.loc, "wrapping operator expects matching integer operands")
          return left
        }
        if op == tk_percent() {
          if left.is_integer {
            if right.same_as(left) {
              return left
            }
          }
          self.fail(expr.loc, "% expects matching integer operands")
          return left
        }
        if self.bitwise_op(op) {
          if self.shift_op(op) {
            if left.is_uint64 {
              if right.is_int {
                return left
              }
            }
            if left.is_int64 {
              if right.is_int {
                return left
              }
            }
          }
          if left.is_integer {
            if right.same_as(left) {
              return left
            }
          }
          self.fail(expr.loc, "bitwise operator expects matching integer operands")
          return left
        }
        if left.is_integer {
          if right.is_integer {
            if left.same_as(right) {
              if op == tk_plus() {
                if l.kind == ex_name() {
                  if r.kind == ex_int() {
                    s = self.fact_any_slack(l.ident)
                    if s >= 0 {
                      if r.int_bits <= s.to_u64 + 1u64 {
                        expr.proven = true
                      }
                    }
                  }
                }
                if r.kind == ex_name() {
                  if l.kind == ex_int() {
                    s = self.fact_any_slack(r.ident)
                    if s >= 0 {
                      if l.int_bits <= s.to_u64 + 1u64 {
                        expr.proven = true
                      }
                    }
                  }
                }
              }
              if op == tk_minus() {
                if l.kind == ex_name() {
                  if r.kind == ex_int() {
                    if self.fact_any_slack(l.ident) >= 0 || self.nn_has(l.ident) {
                      expr.proven = true
                    }
                  }
                }
              }
              return self.int_binary(op, left)
            }
            self.fail(expr.loc, "binary operator expects matching types, got ${left.show} and ${right.show}")
            return left
          }
        }
        if left.is_numeric {
          if right.is_numeric {
            if left.is_float {
            } else {
              l.ty = self.t_float()
            }
            if right.is_float {
            } else {
              r.ty = self.t_float()
            }
            return self.float_binary(op, expr.loc)
          }
        }
        self.fail(expr.loc, "binary operator expects numeric operands, got ${left.show} and ${right.show}")
        return self.t_int()
      }
    }
    self.t_int()
  }

  pub fn check_call(expr: Expr, has_want: Bool, want: Ty): Ty {
    if expr.indirect {
      if inner = expr.inner {
        callee = self.check_expr(inner)
        return self.check_indirect_call(expr, callee)
      }
    }
    if recv = expr.receiver {
      return self.check_method_call(expr, recv, has_want, want)
    }
    if self.is_generic_template(expr.callee) {
      self.fail(expr.loc, "type argument expected")
      return self.t_int()
    }
    if existing = self.lookup(expr.callee) {
      if existing.is_fn {
        self.note_capture(expr.callee, existing)
        expr.indirect = true
        return self.check_indirect_call(expr, existing)
      }
    }
    if str_eq(expr.callee, "nursery_reclaim") {
      if expr.args.size != 0 {
        self.fail(expr.loc, "nursery_reclaim takes no arguments")
        return self.t_void()
      }
      return self.t_void()
    }
    if str_eq(expr.callee, "puts") {
      if expr.args.size != 1 {
        self.fail(expr.loc, "puts takes one argument")
        return self.t_void()
      }
      if b = expr.block {
        self.fail(expr.loc, "puts does not take a block")
        return self.t_void()
      }
      printed = self.check_expr(expr.args[0])
      ok = false
      if printed.is_integer {
        ok = true
      }
      if printed.is_string {
        ok = true
      }
      if printed.is_float {
        ok = true
      }
      if printed.is_bool {
        ok = true
      }
      if ok {
        return self.t_void()
      }
      self.fail(expr.args[0].loc, "puts cannot print ${printed.show}")
      return self.t_void()
    }
    if str_eq(expr.callee, "spawn") {
      return self.check_spawn(expr)
    }
    if str_eq(expr.callee, "now_ms") {
      if expr.args.size == 0 {
        if b = expr.block {
          self.fail(expr.loc, "now_ms takes no arguments")
          return self.t_int()
        }
        return self.t_int()
      }
      self.fail(expr.loc, "now_ms takes no arguments")
      return self.t_int()
    }
    if str_eq(expr.callee, "json_parse") {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "json_parse takes one String")
          return ty_ptr(self.t_void())
        }
      } else {
        self.fail(expr.loc, "json_parse takes one String")
        return ty_ptr(self.t_void())
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(got, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "json_parse expects String")
      }
      return ty_ptr(self.t_void())
    }
    if str_eq(expr.callee, "json_int") {
      return self.check_json_get(expr, self.t_int())
    }
    if str_eq(expr.callee, "json_str") {
      return self.check_json_get(expr, self.t_string())
    }
    if str_eq(expr.callee, "http_roundtrip") {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "http_roundtrip takes one String")
          return self.t_string()
        }
      } else {
        self.fail(expr.loc, "http_roundtrip takes one String")
        return self.t_string()
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(got, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "http_roundtrip expects String")
      }
      return self.t_string()
    }
    if str_eq(expr.callee, "file_read") {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "file_read takes one String")
          return ty_nilable(self.t_string())
        }
      } else {
        self.fail(expr.loc, "file_read takes one String")
        return ty_nilable(self.t_string())
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(got, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "file_read expects String")
      }
      return ty_nilable(self.t_string())
    }
    if str_eq(expr.callee, "file_write") {
      if expr.args.size == 2 {
        if b = expr.block {
          self.fail(expr.loc, "file_write takes a path and a body")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "file_write takes a path and a body")
        return self.t_int()
      }
      path = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(path, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "file_write path must be String")
      }
      body = self.check_expr_as(expr.args[1], self.t_string())
      if ty_assignable(body, self.t_string()) {
      } else {
        self.fail(expr.args[1].loc, "file_write body must be String")
      }
      return self.t_int()
    }
    if str_eq(expr.callee, "argv") {
      if expr.args.size == 0 {
        if b = expr.block {
          self.fail(expr.loc, "argv takes no arguments")
          return ty_array(self.t_string())
        }
        return ty_array(self.t_string())
      }
      self.fail(expr.loc, "argv takes no arguments")
      return ty_array(self.t_string())
    }
    if str_eq(expr.callee, "process_run") {
      if expr.args.size == 2 {
        if b = expr.block {
          self.fail(expr.loc, "process_run takes a path and args")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "process_run takes a path and args")
        return self.t_int()
      }
      path = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(path, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "process_run path must be String")
      }
      args_ty = ty_array(self.t_string())
      got = self.check_expr_as(expr.args[1], args_ty)
      if ty_assignable(got, args_ty) {
      } else {
        self.fail(expr.args[1].loc, "process_run args must be Array(String)")
      }
      return self.t_int()
    }
    if str_eq(expr.callee, "process_run_out") {
      if expr.args.size == 3 {
        if b = expr.block {
          self.fail(expr.loc, "process_run_out takes a path, args, and an output path")
          return self.t_int()
        }
      } else {
        self.fail(expr.loc, "process_run_out takes a path, args, and an output path")
        return self.t_int()
      }
      path = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(path, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "process_run_out path must be String")
      }
      args_ty = ty_array(self.t_string())
      got = self.check_expr_as(expr.args[1], args_ty)
      if ty_assignable(got, args_ty) {
      } else {
        self.fail(expr.args[1].loc, "process_run_out args must be Array(String)")
      }
      outp = self.check_expr_as(expr.args[2], self.t_string())
      if ty_assignable(outp, self.t_string()) {
      } else {
        self.fail(expr.args[2].loc, "process_run_out output path must be String")
      }
      return self.t_int()
    }
    if str_eq(expr.callee, "env_get") {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "env_get takes one String")
          return ty_nilable(self.t_string())
        }
      } else {
        self.fail(expr.loc, "env_get takes one String")
        return ty_nilable(self.t_string())
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(got, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "env_get expects String")
      }
      return ty_nilable(self.t_string())
    }
    if str_eq(expr.callee, "file_exists") {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "file_exists takes one String")
          return self.t_bool()
        }
      } else {
        self.fail(expr.loc, "file_exists takes one String")
        return self.t_bool()
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(got, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "file_exists expects String")
      }
      return self.t_bool()
    }
    if str_eq(expr.callee, "dir_list") {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "dir_list takes one String")
          return ty_array(self.t_string())
        }
      } else {
        self.fail(expr.loc, "dir_list takes one String")
        return ty_array(self.t_string())
      }
      got = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(got, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "dir_list expects String")
      }
      return ty_array(self.t_string())
    }
    if ty = self.check_json_walk_call(expr) {
      return ty
    }
    if ty = self.check_codec_call(expr) {
      return ty
    }
    if ty = self.check_langarena_call(expr) {
      return ty
    }
    if ty = self.check_gate_call(expr) {
      return ty
    }
    if str_eq(expr.callee, "chr") {
      if expr.args.size == 1 {
        if b = expr.block {
          self.fail(expr.loc, "chr takes one Int")
          return self.t_string()
        }
      } else {
        self.fail(expr.loc, "chr takes one Int")
        return self.t_string()
      }
      got = self.check_expr_as(expr.args[0], self.t_int())
      if got.is_int {
      } else {
        self.fail(expr.args[0].loc, "chr expects Int")
      }
      return self.t_string()
    }
    if str_eq(expr.callee, "str_slice") {
      if expr.args.size == 3 {
        if b = expr.block {
          self.fail(expr.loc, "str_slice takes String, start, stop")
          return self.t_string()
        }
      } else {
        self.fail(expr.loc, "str_slice takes String, start, stop")
        return self.t_string()
      }
      s = self.check_expr_as(expr.args[0], self.t_string())
      if ty_assignable(s, self.t_string()) {
      } else {
        self.fail(expr.args[0].loc, "str_slice expects String")
      }
      start = self.check_expr_as(expr.args[1], self.t_int())
      stop = self.check_expr_as(expr.args[2], self.t_int())
      if start.is_int {
      } else {
        self.fail(expr.args[1].loc, "start must be Int")
      }
      if stop.is_int {
      } else {
        self.fail(expr.args[2].loc, "stop must be Int")
      }
      return self.t_string()
    }
    if str_eq(expr.callee, "buf_new") {
      if b = expr.block {
        self.fail(expr.loc, "buf_new does not take a block")
        return self.t_buf()
      }
      if expr.args.size == 0 {
        return self.t_buf()
      }
      if expr.args.size == 1 {
        cap = self.check_expr_as(expr.args[0], self.t_int())
        if cap.is_int {
        } else {
          self.fail(expr.args[0].loc, "capacity must be Int")
        }
        return self.t_buf()
      }
      self.fail(expr.loc, "buf_new takes an optional Int capacity")
      return self.t_buf()
    }
    expected: Ty? = nil
    if has_want {
      expected = want
    }
    return self.dispatch_call(expr, expected)
  }

  pub fn fit_call_arg(expr: Expr, got: Ty, want: Ty): Ty {
    if ty_assignable(got, want) {
      return got
    }
    if expr.kind == ex_int() {
      widened = self.check_integer(expr, true, want)
      if ty_assignable(widened, want) {
        expr.ty = widened
        return widened
      }
    }
    got
  }

  pub fn check_args(expr: Expr, params: Array(Ty), label: String) {
    if expr.args.size != params.size {
      self.fail(expr.loc, "${label} takes ${params.size} arguments, got ${expr.args.size}")
      return
    }
    i = 0
    while i < expr.args.size {
      call_arg = expr.args[i]
      got = self.check_expr_as(call_arg, params[i])
      if ty_assignable(got, params[i]) {
      } else {
        n = i + 1
        self.fail(call_arg.loc, "argument ${n} of ${label} is ${got.show}, expected ${params[i].show}")
      }
      i = i + 1
    }
  }

  pub fn check_constructor(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    if recv.kind == ex_name() {
      if cdef = self.find_class_template(recv.ident) {
        if recv.type_args.size > 0 {
          tn = TypeName.new(recv.loc, recv.ident)
          tn.mod_name = recv.mod_name
          i = 0
          while i < recv.type_args.size {
            tn.args.push(recv.type_args[i])
            i = i + 1
          }
          ty = self.resolve_in_module(tn)
          self.pull_resolve
          if self.has_err {
          } else {
            recv.ty = ty
          }
          empty: Array(Ty) = []
          return self.finish_constructor(expr, ty, false, empty)
        }
        return self.infer_new(expr, recv, cdef, recv.mod_name, has_want, want)
      }
    }
    if recv.kind == ex_field() {
      if obj = recv.object {
        if obj.kind == ex_name() {
          if cdef = self.find_class_template(recv.ident) {
            return self.infer_new(expr, recv, cdef, obj.ident, has_want, want)
          }
        }
      }
    }
    if ty = self.type_from_recv(recv, expr.loc) {
      recv.ty = ty
      if ty.template {
        self.fail(expr.loc, "${ty.name} needs type arguments")
        return self.t_int()
      }
      empty: Array(Ty) = []
      return self.finish_constructor(expr, ty, false, empty)
    }
    self.t_int()
  }

  pub fn template_initialize(cdef: ClassDef): Function? {
    i = 0
    while i < cdef.methods.size {
      if str_eq(cdef.methods[i].name, "initialize") {
        return cdef.methods[i]
      }
      i = i + 1
    }
    nil
  }

  pub fn infer_new(expr: Expr, recv: Expr, cdef: ClassDef, mod_name: String, has_want: Bool, want: Ty): Ty {
    params = cdef.type_params
    keys: Array(String) = []
    vals: Array(Ty) = []
    if self.apply_want_args(cdef.name, params, has_want, want, keys, vals) {
    } else {
      self.fail(expr.loc, "conflicting type arguments")
      return self.t_int()
    }
    pre: Array(Ty) = []
    if init = self.template_initialize(cdef) {
      self.resolver.set_tparams(params)
      pats: Array(Ty) = []
      i = 0
      while i < init.params.size {
        pats.push(self.resolver.resolve_value(init.params[i].type))
        self.pull_resolve
        i = i + 1
      }
      self.resolver.clear_tparams
      i = 0
      while i < expr.args.size {
        got = self.t_int()
        if i < pats.size {
          pat_ty = self.subst_ty(pats[i], keys, vals)
          got = self.check_expr_flag(expr.args[i], true, pat_ty)
          if self.unify_ty(pat_ty, got, keys, vals) {
          } else {
            self.fail(expr.args[i].loc, "conflicting type arguments")
          }
        } else {
          got = self.check_expr(expr.args[i])
        }
        pre.push(got)
        i = i + 1
      }
    } else {
      if expr.args.size != 0 {
        self.fail(expr.loc, "${cdef.name}.new takes no arguments")
        return self.t_int()
      }
    }
    if solved = self.solved_args(params, keys, vals, expr.loc) {
      ty = self.instantiate_applied(cdef.name, mod_name, solved, expr.loc)
      if self.has_err {
        return self.t_int()
      }
      recv.ty = ty
      return self.finish_constructor(expr, ty, true, pre)
    }
    self.fail(expr.loc, "cannot infer type argument; write ${cdef.name}(...)")
    self.t_int()
  }

  pub fn finish_constructor(expr: Expr, ty: Ty, has_pre: Bool, pre: Array(Ty)): Ty {
    if self.has_err {
      return self.t_int()
    }
    if ty.is_class {
      shown = ty.show
      has_init = false
      mi = 0
      while mi < self.methods.size {
        ms = self.methods[mi]
        if str_eq(ms.owner, ty.name) {
          if str_eq(ms.name, "initialize") {
            has_init = true
          }
        }
        mi = mi + 1
      }
      if has_init {
        arg_tys: Array(Ty) = []
        if has_pre {
          i = 0
          while i < pre.size {
            arg_tys.push(pre[i])
            i = i + 1
          }
        } else {
          ai = 0
          while ai < expr.args.size {
            arg_tys.push(self.check_expr(expr.args[ai]))
            ai = ai + 1
          }
        }
        none: Ty? = nil
        if sig = self.match_method(ty.name, "initialize", arg_tys, none, expr.loc, shown) {
          self.fill_defaults(expr, sig.node)
          i = 0
          while i < expr.args.size {
            got = self.t_int()
            if has_pre {
              if i < pre.size {
                got = pre[i]
              } else {
                got = self.check_expr_as(expr.args[i], sig.params[i])
              }
            } else {
              if i < arg_tys.size {
                got = arg_tys[i]
              } else {
                got = self.check_expr_as(expr.args[i], sig.params[i])
              }
            }
            if i < sig.params.size {
              got = self.fit_call_arg(expr.args[i], got, sig.params[i])
              if ty_assignable(got, sig.params[i]) {
              } else {
                n = i + 1
                self.fail(expr.args[i].loc, "argument ${n} of ${shown}.new is ${got.show}, expected ${sig.params[i].show}")
              }
            }
            i = i + 1
          }
        }
      } else {
        if expr.args.size == 0 {
        } else {
          self.fail(expr.loc, "${shown}.new takes no arguments")
        }
      }
      expr.resolved = "${ty.name}__new"
      return ty
    }
    shown = ty.show
    self.fail(expr.loc, "structs are constructed with ${shown} { fields }, not .new")
    ty
  }

  pub fn check_lib_call(expr: Expr, lib_name: String): Ty {
    key = "${lib_name}.${expr.callee}"
    if id = self.cfun_index.get(key) {
      sig = self.cfuns[id]
      self.check_args(expr, sig.params, "${lib_name}.${expr.callee}")
      expr.lib_name = lib_name
      return sig.ret
    }
    self.fail(expr.loc, "unknown function ${lib_name}.${expr.callee}")
    self.t_int()
  }

  pub fn type_name_as_expr(arg: TypeName): Expr {
    if arg.fn_type {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.nilable {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.members.size > 0 {
      self.fail(arg.loc, "type argument expected")
      return Expr.new(ex_name(), arg.loc)
    }
    if arg.args.size == 0 {
      n = Expr.new(ex_name(), arg.loc)
      n.ident = arg.name
      n.mod_name = arg.mod_name
      return n
    }
    call = Expr.new(ex_call(), arg.loc)
    call.callee = arg.name
    if arg.mod_name.size > 0 {
      mod = Expr.new(ex_name(), arg.loc)
      mod.ident = arg.mod_name
      call.receiver = mod
    }
    i = 0
    while i < arg.args.size {
      call.args.push(self.type_name_as_expr(arg.args[i]))
      i = i + 1
    }
    call
  }

  pub fn type_app_as_call(recv: Expr): Expr {
    call = Expr.new(ex_call(), recv.loc)
    call.callee = recv.ident
    if recv.mod_name.size > 0 {
      mod = Expr.new(ex_name(), recv.loc)
      mod.ident = recv.mod_name
      call.receiver = mod
    }
    i = 0
    while i < recv.type_args.size {
      call.args.push(self.type_name_as_expr(recv.type_args[i]))
      i = i + 1
    }
    call
  }

  pub fn rewrite_type_app_call(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    call = self.type_app_as_call(recv)
    expr.receiver = call
    self.check_method_call(expr, call, has_want, want)
  }

  pub fn check_method_call(expr: Expr, recv: Expr, has_want: Bool, want: Ty): Ty {
    if recv.kind == ex_name() {
      if recv.type_args.size > 0 {
        if self.is_generic_template(recv.ident) {
          if str_eq(expr.callee, "new") {
          } else {
            self.fail(recv.loc, "${recv.ident} is a type")
            return self.t_int()
          }
        } else {
          return self.rewrite_type_app_call(expr, recv, has_want, want)
        }
      }
    }
    if recv.kind == ex_name() {
      if found = self.lookup(recv.ident) {
      } else {
        if recv.type_args.size > 0 {
        } else {
          if id = self.lib_names.get(recv.ident) {
            if self.lib_is_visible(recv.ident, self.current_module) {
              return self.check_lib_call(expr, recv.ident)
            }
            self.fail(recv.loc, "unknown name ${recv.ident}")
            return self.t_int()
          }
          if k = self.known_mods.get(recv.ident) {
            if self.qualifier_ok(recv.ident, self.current_module) {
              return self.dispatch_qualified_call(expr, recv.ident)
            }
          }
        }
      }
    }
    if str_eq(expr.callee, "new") {
      return self.check_constructor(expr, recv, has_want, want)
    }
    if str_eq(expr.callee, "bump") {
      ty = self.check_constructor(expr, recv, has_want, want)
      if self.has_err {
        return ty
      }
      if ty.is_class {
        expr.resolved = "${ty.name}__bump"
        return ty_nilable(ty)
      }
      return ty
    }
    if str_eq(expr.callee, "send") {
      i = 0
      while i < expr.args.size {
        if self.expr_is_place(expr.args[i]) {
          self.fail(expr.args[i].loc, "mutex place cannot escape")
          return self.t_void()
        }
        i = i + 1
      }
    }
    if recv.kind == ex_name() {
      if str_eq(recv.ident, "String") {
        if str_eq(expr.callee, "from_utf8") {
          if expr.args.size == 1 {
          } else {
            self.fail(expr.loc, "String.from_utf8 takes one Bytes")
            return ty_nilable(self.t_string())
          }
          got = self.check_expr_as(expr.args[0], self.t_bytes())
          if got.is_bytes {
          } else {
            self.fail(expr.args[0].loc, "String.from_utf8 expects Bytes")
          }
          return ty_nilable(self.t_string())
        }
      }
    }
    object = self.check_expr(recv)
    if str_eq(expr.callee, "or") {
      if b = expr.block {
        self.fail(expr.loc, "or does not take a block")
        return object
      }
      if expr.args.size == 1 {
        if object.is_nilable {
          return self.coalesce_result(object, expr.args[0], expr.loc, "or")
        }
        dummy = self.check_expr(expr.args[0])
        self.fail(expr.loc, "or needs a nilable receiver, got ${object.show}")
        return object
      }
      self.fail(expr.loc, "or takes one fallback")
      return object
    }
    if str_eq(expr.callee, "with") {
      if self.is_mutex_ty(object) {
        return self.check_mutex_with(expr, object)
      }
    }
    if object.is_float {
      return self.check_float_method(expr)
    }
    if object.is_integer {
      return self.check_int_method(expr, object)
    }
    if object.is_string {
      return self.check_string_method(expr)
    }
    if object.is_bytes {
      return self.check_bytes_method(expr)
    }
    if object.is_array {
      return self.check_array_method(expr, object)
    }
    if object.is_hash {
      return self.check_hash_method(expr, object)
    }
    if object.is_buf {
      return self.check_buf_method(expr)
    }
    if object.is_join {
      return self.check_join(expr, object)
    }
    expected: Ty? = nil
    if has_want {
      expected = want
    }
    if object.is_agg {
      return self.dispatch_method(expr, object, expected)
    }
    if object.is_ptr {
      return self.dispatch_method(expr, object, expected)
    }
    self.fail(expr.loc, "cannot call ${expr.callee} on ${object.show}")
    self.t_int()
  }

  pub fn check_block_void(block: Block, pname: String, pty: Ty) {
    self.push_scope
    self.bind(pname, pty)
    self.check_body(block.body, self.t_void(), false)
    self.pop_scope
  }

  pub fn check_float_method(expr: Expr): Ty {
    if b = expr.block {
      self.fail(expr.loc, "Float64.${expr.callee} does not take a block")
      return self.t_float()
    }
    if str_eq(expr.callee, "sqrt") {
      if expr.args.size == 0 {
        return self.t_float()
      }
      self.fail(expr.loc, "Float64.${expr.callee} takes no arguments")
      return self.t_float()
    }
    if str_eq(expr.callee, "abs") {
      if expr.args.size == 0 {
        return self.t_float()
      }
      self.fail(expr.loc, "Float64.${expr.callee} takes no arguments")
      return self.t_float()
    }
    if str_eq(expr.callee, "floor") {
      if expr.args.size == 0 {
        return self.t_float()
      }
      self.fail(expr.loc, "Float64.${expr.callee} takes no arguments")
      return self.t_float()
    }
    if str_eq(expr.callee, "exp") {
      if expr.args.size == 0 {
        return self.t_float()
      }
      self.fail(expr.loc, "Float64.${expr.callee} takes no arguments")
      return self.t_float()
    }
    if str_eq(expr.callee, "to_i") {
      if expr.args.size == 0 {
        return self.t_int()
      }
      self.fail(expr.loc, "Float64.to_i takes no arguments")
      return self.t_int()
    }
    self.fail(expr.loc, "no method ${expr.callee} on Float64")
    self.t_float()
  }

  pub fn check_int_method(expr: Expr, object: Ty): Ty {
    if b = expr.block {
      self.fail(expr.loc, "${object.show}.${expr.callee} does not take a block")
      return object
    }
    if str_eq(expr.callee, "to_f") {
      if expr.args.size == 0 {
        return self.t_float()
      }
      self.fail(expr.loc, "${object.show}.to_f takes no arguments")
      return self.t_float()
    }
    if str_eq(expr.callee, "abs") {
      if expr.args.size == 0 {
        return object
      }
      self.fail(expr.loc, "${object.show}.abs takes no arguments")
      return object
    }
    if str_eq(expr.callee, "to_i") {
      if expr.args.size == 0 {
        return self.t_int()
      }
      self.fail(expr.loc, "${object.show}.to_i takes no arguments")
      return self.t_int()
    }
    if str_eq(expr.callee, "to_i64") {
      if expr.args.size == 0 {
        return self.t_int64()
      }
      self.fail(expr.loc, "${object.show}.to_i64 takes no arguments")
