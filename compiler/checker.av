  fn check_switch_branch(body: Array(Stmt), has_want: Bool, want: Ty): Ty {
    self.push_scope
    if body.size == 0 {
      self.pop_scope
      return self.t_void()
    }
    i = 0
    while i < body.size {
      stmt = body[i]
      if i == body.size - 1 {
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            use_want = false
            use_ty = self.t_int()
            if has_want {
              if want.is_void {
              } else {
                use_want = true
                use_ty = want
              }
            }
            ty = self.check_expr_flag(e, use_want, use_ty)
            self.pop_scope
            return ty
          }
        }
        self.check_stmt(stmt, self.t_void(), false)
        self.pop_scope
        return self.t_void()
      }
      self.check_stmt(stmt, self.t_void(), false)
      i = i + 1
    }
    self.pop_scope
    self.t_void()
  }
}
