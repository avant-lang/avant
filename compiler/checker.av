  pub fn check_switch(expr: Expr, has_want: Bool, want: Ty): Ty {
    if cond = expr.cond {
      ct = self.check_expr(cond)
      if ct.is_int {
      } else {
        if ct.is_bool {
        } else {
          self.fail(cond.loc, "switch discriminant must be Int or Bool, got ${ct.show}")
        }
      }
    }
    seen = Hash(Int, Int).new
    i = 0
    while i < expr.cases.size {
      arm = expr.cases[i]
      if arm.labels.size == 0 {
        self.fail(arm.loc, "case needs a label")
      }
      j = 0
      while j < arm.labels.size {
        lab = arm.labels[j].to_i
        if prev = seen.get(lab) {
          self.fail(arm.loc, "duplicate case ${lab}")
        }
        seen[lab] = 1
        j = j + 1
      }
      i = i + 1
    }
    branch_tys: Array(Ty) = []
    i = 0
    while i < expr.cases.size {
      branch_tys.push(self.check_switch_branch(expr.cases[i].body, has_want, want))
      i = i + 1
    }
    if expr.has_else {
      branch_tys.push(self.check_switch_branch(expr.else_body, has_want, want))
    }
    all_void = true
    any_void = false
    i = 0
    while i < branch_tys.size {
      if branch_tys[i].is_void {
        any_void = true
      } else {
        all_void = false
      }
      i = i + 1
    }
    if all_void {
      return self.t_void()
    }
    if any_void {
      self.fail(expr.loc, "switch cases must all produce a value, or none")
      return self.t_int()
    }
    if expr.has_else {
    } else {
      self.fail(expr.loc, "switch expression needs else")
      return self.t_int()
    }
    if has_want {
      if want.is_void {
      } else {
        i = 0
        while i < branch_tys.size {
          if ty_assignable(branch_tys[i], want) {
          } else {
            self.fail(expr.loc, "switch branch is ${branch_tys[i].show}, expected ${want.show}")
          }
          i = i + 1
        }
        return want
      }
    }
    if branch_tys.size == 0 {
      return self.t_void()
    }
    result = branch_tys[0]
    i = 0
    while i < branch_tys.size {
      if branch_tys[i].same_as(result) {
      } else {
        self.fail(expr.loc, "switch branches have different types ${result.show} and ${branch_tys[i].show}")
      }
      i = i + 1
    }
    result
  }

  pub fn check_spawn(expr: Expr): Ty {
    if expr.args.size == 0 {
    } else {
      self.fail(expr.loc, "spawn takes a block, not arguments")
      return ty_join(self.t_int())
    }
    if b = expr.block {
      if b.params.size == 0 {
      } else {
        self.fail(b.loc, "spawn { } does not take block parameters; use items.parallel")
        return ty_join(self.t_int())
      }
      self.in_task = self.in_task + 1
      result = self.check_block_value(b)
      self.in_task = self.in_task - 1
      if result.is_int {
      } else {
        self.fail(b.loc, "spawn result must be Int")
      }
      self.collect_spawn_captures(expr, b.body)
      return ty_join(result)
    }
    self.fail(expr.loc, "spawn needs a block")
    ty_join(self.t_int())
  }

  pub fn check_block_value(block: Block): Ty {
    if block.body.size == 0 {
      self.fail(block.loc, "block needs a value")
      return self.t_int()
    }
    self.push_scope
    last = block.body[block.body.size - 1]
    i = 0
    while i < block.body.size {
      stmt = block.body[i]
      if i == block.body.size - 1 {
        if stmt.kind == st_return() {
          if self.place_depth > 0 {
            self.fail(stmt.loc, "return inside Mutex.with")
            self.pop_scope
            return self.t_int()
          }
        }
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            ty = self.check_expr(e)
            if ty.is_void {
              self.fail(stmt.loc, "block must end with a value")
              self.pop_scope
              return self.t_int()
            }
            self.pop_scope
            return ty
          }
        }
        self.fail(stmt.loc, "block must end with a value")
        self.pop_scope
        return self.t_int()
      }
      self.check_stmt(stmt, self.t_void(), false)
      i = i + 1
    }
    self.pop_scope
    self.t_int()
  }

  pub fn is_share_ty(ty: Ty): Bool {
    if str_eq(ty.origin, "Channel") {
      return true
    }
    if str_eq(ty.name, "Channel") {
      return true
    }
    if str_eq(ty.origin, "Mutex") {
      return true
    }
    str_eq(ty.name, "Mutex")
  }

  pub fn copyable_for_spawn(ty: Ty): Bool {
    if self.is_share_ty(ty) {
      return true
    }
    if ty.is_array {
      return true
    }
    self.copyable_bits(ty)
  }

  pub fn copyable_bits(ty: Ty): Bool {
    if ty.is_int {
      return true
    }
    if ty.is_int64 {
      return true
    }
    if ty.is_uint64 {
      return true
    }
    if ty.is_bool {
      return true
    }
    if ty.is_float {
      return true
    }
    if ty.is_string {
      return true
    }
    if ty.is_struct {
      i = 0
      while i < ty.fields.size {
        if self.copyable_bits(ty.fields[i].ty) {
        } else {
          return false
        }
        i = i + 1
      }
      return true
    }
    false
  }

  pub fn collect_spawn_captures(expr: Expr, body: Array(Stmt)) {
    seen = Hash(String, Int).new
    self.walk_spawn_stmts(body, expr, seen)
  }

  pub fn walk_spawn_stmts(body: Array(Stmt), node: Expr, seen: Hash(String, Int)) {
    i = 0
    while i < body.size {
      self.walk_spawn_stmt(body[i], node, seen)
      i = i + 1
    }
  }

  pub fn walk_spawn_stmt(stmt: Stmt, node: Expr, seen: Hash(String, Int)) {
    k = stmt.kind
    if k == st_return() {
      if e = stmt.expr {
        self.walk_spawn_expr(e, node, seen)
      }
      return
    }
    if k == st_if() {
      if c = stmt.cond {
        self.walk_spawn_expr(c, node, seen)
      }
      self.walk_spawn_stmts(stmt.then_body, node, seen)
      self.walk_spawn_stmts(stmt.else_body, node, seen)
      return
    }
    if k == st_while() {
      self.walk_spawn_stmts(stmt.pre, node, seen)
      if c = stmt.cond {
        self.walk_spawn_expr(c, node, seen)
      }
      self.walk_spawn_stmts(stmt.body, node, seen)
      return
    }
    if k == st_assign() {
      if target = stmt.target {
        if target.kind == ex_name() {
          if ty = self.lookup(target.ident) {
            self.fail(target.loc, "spawn cannot assign to ${target.ident}; copy at send is read-only (D35)")
          }
        } else if self.spawn_array_frozen(target) {
          root = self.expr_root_name(target)
          self.fail(target.loc, "spawn cannot mutate captured Array ${root}; it is read-only until join (Q74-A)")
          self.walk_spawn_expr(target, node, seen)
        } else {
          self.walk_spawn_expr(target, node, seen)
        }
      }
      if v = stmt.value {
        self.walk_spawn_expr(v, node, seen)
      }
      return
    }
    if k == st_expr() {
      if e = stmt.expr {
        self.walk_spawn_expr(e, node, seen)
      }
    }
  }

  pub fn walk_spawn_expr(expr: Expr, node: Expr, seen: Hash(String, Int)) {
    k = expr.kind
    if k == ex_name() {
      self.note_spawn_capture(expr, node, seen)
      return
    }
    if k == ex_call() {
      if inner = expr.inner {
        self.walk_spawn_expr(inner, node, seen)
      }
      if expr.indirect {
        if expr.callee.size > 0 {
          name = Expr.new(ex_name(), expr.loc)
          name.ident = expr.callee
          self.note_spawn_capture(name, node, seen)
        }
      }
      if recv = expr.receiver {
        if self.array_mutator(expr.callee) {
          if self.spawn_array_frozen(recv) {
            root = self.expr_root_name(recv)
            self.fail(expr.loc, "spawn cannot mutate captured Array ${root}; it is read-only until join (Q74-A)")
          }
        }
        self.walk_spawn_expr(recv, node, seen)
      }
      i = 0
      while i < expr.args.size {
        self.walk_spawn_expr(expr.args[i], node, seen)
        i = i + 1
      }
      if b = expr.block {
        self.walk_spawn_stmts(b.body, node, seen)
      }
      return
    }
    if k == ex_unary() {
      if inner = expr.inner {
        self.walk_spawn_expr(inner, node, seen)
      }
      return
    }
    if k == ex_binary() {
      if l = expr.left {
        self.walk_spawn_expr(l, node, seen)
      }
      if r = expr.right {
        self.walk_spawn_expr(r, node, seen)
      }
      return
    }
    if k == ex_field() {
      if obj = expr.object {
        self.walk_spawn_expr(obj, node, seen)
      }
      return
    }
    if k == ex_index() {
      if l = expr.left {
        self.walk_spawn_expr(l, node, seen)
      }
      if r = expr.right {
        self.walk_spawn_expr(r, node, seen)
      }
      return
    }
    if k == ex_struct() {
      i = 0
      while i < expr.field_exprs.size {
        self.walk_spawn_expr(expr.field_exprs[i], node, seen)
        i = i + 1
      }
      return
    }
    if k == ex_array() {
      i = 0
      while i < expr.elems.size {
        self.walk_spawn_expr(expr.elems[i], node, seen)
        i = i + 1
      }
      return
    }
    if k == ex_array_new() {
      if size = expr.size_expr {
        self.walk_spawn_expr(size, node, seen)
      }
      return
    }
    if k == ex_try() {
      if inner = expr.inner {
        self.walk_spawn_expr(inner, node, seen)
      }
      return
    }
    if k == ex_interp() {
      i = 0
      while i < expr.parts.size {
        part = expr.parts[i]
        if inner = part.expr {
          self.walk_spawn_expr(inner, node, seen)
        }
        i = i + 1
      }
      return
    }
    if k == ex_switch() {
      if c = expr.cond {
        self.walk_spawn_expr(c, node, seen)
      }
      i = 0
      while i < expr.cases.size {
        self.walk_spawn_stmts(expr.cases[i].body, node, seen)
        i = i + 1
      }
      if expr.has_else {
        self.walk_spawn_stmts(expr.else_body, node, seen)
      }
      return
    }
    if k == ex_lambda() {
      if b = expr.block {
        mark = self.spawn_skip.size
        i = 0
        while i < b.params.size {
          self.spawn_skip.push(b.params[i])
          i = i + 1
        }
        self.walk_spawn_stmts(b.body, node, seen)
        while self.spawn_skip.size > mark {
          dropped = self.spawn_skip.pop
        }
      }
    }
  }

  pub fn spawn_skip_has(name: String): Bool {
    i = 0
    while i < self.spawn_skip.size {
      if str_eq(self.spawn_skip[i], name) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn expr_root_name(expr: Expr): String {
    k = expr.kind
    if k == ex_name() {
      return expr.ident
    }
    if k == ex_field() {
      if obj = expr.object {
        return self.expr_root_name(obj)
      }
    }
    if k == ex_index() {
      if l = expr.left {
        return self.expr_root_name(l)
      }
    }
    ""
  }

  pub fn array_mutator(name: String): Bool {
    if str_eq(name, "push") {
      return true
    }
    if str_eq(name, "pop") {
      return true
    }
    if str_eq(name, "clear") {
      return true
    }
    if str_eq(name, "fill") {
      return true
    }
    if str_eq(name, "sort") {
      return true
    }
    if str_eq(name, "reverse") {
      return true
    }
    str_eq(name, "reserve")
  }

  pub fn spawn_array_frozen(expr: Expr): Bool {
    root = self.expr_root_name(expr)
    if root.size == 0 {
      return false
    }
    if self.spawn_skip_has(root) {
      return false
    }
    if ty = self.lookup(root) {
      return ty.is_array
    }
    false
  }

  pub fn pending_has_array(name: String): Bool {
    i = 0
    while i < self.pending_arrays.size {
      if str_eq(self.pending_arrays[i], name) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn pending_join(handle: String) {
    kept_h: Array(String) = []
    kept_a: Array(String) = []
    i = 0
    while i < self.pending_handles.size {
      if str_eq(self.pending_handles[i], handle) {
      } else {
        kept_h.push(self.pending_handles[i])
        kept_a.push(self.pending_arrays[i])
      }
      i = i + 1
    }
    self.pending_handles = kept_h
    self.pending_arrays = kept_a
  }

  pub fn scan_pending_stmt(stmt: Stmt) {
    if e = stmt.expr {
      self.scan_pending_expr(e)
    }
    if c = stmt.cond {
      self.scan_pending_expr(c)
    }
    if t = stmt.target {
      self.scan_pending_target(t)
    }
    if v = stmt.value {
      self.scan_pending_expr(v)
    }
    i = 0
    while i < stmt.then_body.size {
      self.scan_pending_stmt(stmt.then_body[i])
      i = i + 1
    }
    i = 0
    while i < stmt.else_body.size {
      self.scan_pending_stmt(stmt.else_body[i])
      i = i + 1
    }
    i = 0
    while i < stmt.body.size {
      self.scan_pending_stmt(stmt.body[i])
      i = i + 1
    }
  }

  pub fn scan_pending_target(target: Expr) {
    if target.kind == ex_name() {
      return
    }
    root = self.expr_root_name(target)
    if root.size > 0 {
      if self.pending_has_array(root) {
        self.fail(target.loc, "cannot mutate ${root} while a spawn using it is running; join first (Q74-A)")
      }
    }
    self.scan_pending_expr(target)
  }

  pub fn scan_pending_expr(expr: Expr) {
    k = expr.kind
    if k == ex_field() {
      if str_eq(expr.ident, "join") {
        if obj = expr.object {
          if obj.kind == ex_name() {
            self.pending_join(obj.ident)
            return
          }
        }
      }
    }
    if k == ex_call() {
      if str_eq(expr.callee, "join") {
        if recv = expr.receiver {
          if recv.kind == ex_name() {
            self.pending_join(recv.ident)
          }
        }
      }
      if recv = expr.receiver {
        if self.array_mutator(expr.callee) {
          root = self.expr_root_name(recv)
          if root.size > 0 {
            if self.pending_has_array(root) {
              self.fail(expr.loc, "cannot mutate ${root} while a spawn using it is running; join first (Q74-A)")
            }
          }
        }
      }
    }
    if inner = expr.inner {
      self.scan_pending_expr(inner)
    }
    if l = expr.left {
      self.scan_pending_expr(l)
    }
    if r = expr.right {
      self.scan_pending_expr(r)
    }
    if obj = expr.object {
      self.scan_pending_expr(obj)
    }
    if recv = expr.receiver {
      self.scan_pending_expr(recv)
    }
    i = 0
    while i < expr.args.size {
      self.scan_pending_expr(expr.args[i])
      i = i + 1
    }
    i = 0
    while i < expr.elems.size {
      self.scan_pending_expr(expr.elems[i])
      i = i + 1
    }
    i = 0
    while i < expr.field_exprs.size {
      self.scan_pending_expr(expr.field_exprs[i])
      i = i + 1
    }
    if sz = expr.size_expr {
      self.scan_pending_expr(sz)
    }
    if c = expr.cond {
      self.scan_pending_expr(c)
    }
    if b = expr.block {
      j = 0
      while j < b.body.size {
        self.scan_pending_stmt(b.body[j])
        j = j + 1
      }
    }
    i = 0
    while i < expr.cases.size {
      cs = expr.cases[i]
      j = 0
      while j < cs.body.size {
        self.scan_pending_stmt(cs.body[j])
        j = j + 1
      }
      i = i + 1
    }
    i = 0
    while i < expr.else_body.size {
      self.scan_pending_stmt(expr.else_body[i])
      i = i + 1
    }
    i = 0
    while i < expr.parts.size {
      part = expr.parts[i]
      if inner = part.expr {
        self.scan_pending_expr(inner)
      }
      i = i + 1
    }
  }

  pub fn register_spawn_pending(stmt: Stmt) {
    if stmt.kind == st_assign() {
      if v = stmt.value {
        if v.kind == ex_call() {
          if str_eq(v.callee, "spawn") {
            handle = ""
            if t = stmt.target {
              if t.kind == ex_name() {
                handle = t.ident
              }
            }
            i = 0
            while i < v.cap_names.size {
              if v.cap_tys[i].is_array {
                self.pending_handles.push(handle)
                self.pending_arrays.push(v.cap_names[i])
              }
              i = i + 1
            }
            return
          }
        }
      }
    }
    if e = stmt.expr {
      if e.kind == ex_call() {
        if str_eq(e.callee, "spawn") {
          i = 0
          while i < e.cap_names.size {
            if e.cap_tys[i].is_array {
              self.pending_handles.push("")
              self.pending_arrays.push(e.cap_names[i])
            }
            i = i + 1
          }
        }
      }
    }
  }

  pub fn nn_has(name: String): Bool {
    str_index(self.nn_var, name) >= 0
  }

  pub fn nn_add(name: String) {
    if self.nn_has(name) {
      return
    }
    self.nn_var.push(name)
  }

  pub fn nn_remove(name: String) {
    kept: Array(String) = []
    i = 0
    while i < self.nn_var.size {
      if str_eq(self.nn_var[i], name) {
      } else {
        kept.push(self.nn_var[i])
      }
      i = i + 1
    }
    self.nn_var = kept
  }

  pub fn sv_put(v: String, cont: String) {
    i = 0
    while i < self.sv_var.size {
      if str_eq(self.sv_var[i], v) {
        self.sv_cont[i] = cont
        return
      }
      i = i + 1
    }
    self.sv_var.push(v)
    self.sv_cont.push(cont)
  }

  pub fn sv_get(v: String): String {
    i = 0
    while i < self.sv_var.size {
      if str_eq(self.sv_var[i], v) {
        return self.sv_cont[i]
      }
      i = i + 1
    }
    ""
  }

  pub fn sv_remove_var(v: String) {
    kept_v: Array(String) = []
    kept_c: Array(String) = []
    i = 0
    while i < self.sv_var.size {
      if str_eq(self.sv_var[i], v) {
      } else {
        kept_v.push(self.sv_var[i])
        kept_c.push(self.sv_cont[i])
      }
      i = i + 1
    }
    self.sv_var = kept_v
    self.sv_cont = kept_c
  }

  pub fn fact_slack_of(v: String, cont: String): Int {
    best = 0 - 1
    i = 0
    while i < self.fact_var.size {
      if self.fact_live[i] == 1 {
        if str_eq(self.fact_var[i], v) {
          if str_eq(self.fact_cont[i], cont) {
            if self.fact_slack[i] > best {
              best = self.fact_slack[i]
            }
          }
        }
      }
      i = i + 1
    }
    best
  }

  pub fn fact_any_slack(v: String): Int {
    best = 0 - 1
    i = 0
    while i < self.fact_var.size {
      if self.fact_live[i] == 1 {
        if str_eq(self.fact_var[i], v) {
          if self.fact_slack[i] > best {
            best = self.fact_slack[i]
          }
        }
      }
      i = i + 1
    }
    best
  }

  pub fn kill_facts_for(v: String) {
    i = 0
    while i < self.fact_var.size {
      if str_eq(self.fact_var[i], v) {
        self.fact_live[i] = 0
      }
      if str_eq(self.fact_cont[i], v) {
        self.fact_live[i] = 0
      }
      i = i + 1
    }
  }

  pub fn bv_put(v: String, cont: String, delta: Int) {
    i = 0
    while i < self.bv_var.size {
      if str_eq(self.bv_var[i], v) {
        self.bv_cont[i] = cont
        self.bv_delta[i] = delta
        return
      }
      i = i + 1
    }
    self.bv_var.push(v)
    self.bv_cont.push(cont)
    self.bv_delta.push(delta)
  }

  pub fn bv_get(v: String): String {
    i = 0
    while i < self.bv_var.size {
      if str_eq(self.bv_var[i], v) {
        return self.bv_cont[i]
      }
      i = i + 1
    }
    ""
  }

  pub fn bv_delta_of(v: String): Int {
    i = 0
    while i < self.bv_var.size {
      if str_eq(self.bv_var[i], v) {
        return self.bv_delta[i]
      }
      i = i + 1
    }
    0
  }

  pub fn bv_remove_var(v: String) {
    kept_v: Array(String) = []
    kept_c: Array(String) = []
    kept_d: Array(Int) = []
    i = 0
    while i < self.bv_var.size {
      if str_eq(self.bv_var[i], v) {
      } else {
        kept_v.push(self.bv_var[i])
        kept_c.push(self.bv_cont[i])
        kept_d.push(self.bv_delta[i])
      }
      i = i + 1
    }
    self.bv_var = kept_v
    self.bv_cont = kept_c
    self.bv_delta = kept_d
  }

  pub fn cs_put(cont: String, v: String, delta: Int) {
    i = 0
    while i < self.cs_cont.size {
      if str_eq(self.cs_cont[i], cont) {
        self.cs_var[i] = v
        self.cs_delta[i] = delta
        return
      }
      i = i + 1
    }
    self.cs_cont.push(cont)
    self.cs_var.push(v)
    self.cs_delta.push(delta)
  }

  pub fn cs_cont_of_var(v: String): String {
    i = 0
    while i < self.cs_var.size {
      if str_eq(self.cs_var[i], v) {
        return self.cs_cont[i]
      }
      i = i + 1
    }
    ""
  }

  pub fn cs_delta_of_var(v: String): Int {
    i = 0
    while i < self.cs_var.size {
      if str_eq(self.cs_var[i], v) {
        return self.cs_delta[i]
      }
      i = i + 1
    }
    0
  }

  pub fn bound_cont_of(e: Expr): String {
    if e.kind == ex_field() {
      if str_eq(e.ident, "size") {
        if obj = e.object {
          if obj.kind == ex_name() {
            if obj.implicit_field {
              return ""
            }
            return obj.ident
          }
        }
      }
      return ""
    }
    if e.kind == ex_name() {
      got = self.sv_get(e.ident)
      if got.size > 0 {
        return got
      }
      gotb = self.bv_get(e.ident)
      if gotb.size > 0 {
        return gotb
      }
      return self.cs_cont_of_var(e.ident)
    }
    if e.kind == ex_binary() {
      if e.op == tk_minus() || e.op == tk_plus() {
        if l = e.left {
          return self.bound_cont_of(l)
        }
      }
    }
    ""
  }

  pub fn bound_delta_of(e: Expr): Int {
    if e.kind == ex_field() {
      return 0
    }
    if e.kind == ex_name() {
      got = self.sv_get(e.ident)
      if got.size > 0 {
        return 0
      }
      bg = self.bv_get(e.ident)
      if bg.size > 0 {
        return self.bv_delta_of(e.ident)
      }
      cc = self.cs_cont_of_var(e.ident)
      if cc.size > 0 {
        return 0 - self.cs_delta_of_var(e.ident)
      }
      return 0
    }
    if e.kind == ex_binary() {
      if l = e.left {
        if r = e.right {
          base = self.bound_delta_of(l)
          if self.lit_small(r) {
            if e.op == tk_minus() {
              return base - r.int_bits.to_i
            }
            return base + r.int_bits.to_i
          }
        }
      }
    }
    0
  }

  pub fn lit_small(e: Expr): Bool {
    if e.kind == ex_int() {
      return e.int_bits <= 1000000u64
    }
    false
  }

  pub fn value_is_nonneg(val: Expr, selfname: String): Bool {
    if val.kind == ex_int() {
      return true
    }
    if val.kind == ex_field() {
      if str_eq(val.ident, "size") {
        return true
      }
    }
    if val.kind == ex_name() {
      return self.nn_has(val.ident)
    }
    if val.kind == ex_binary() {
      if val.op == tk_star() {
        if l = val.left {
          if r = val.right {
            lok = false
            if l.kind == ex_int() {
              lok = true
            } else if l.kind == ex_name() {
              if self.nn_has(l.ident) {
                lok = true
              }
            }
            rok = false
            if r.kind == ex_int() {
              rok = true
            } else if r.kind == ex_name() {
              if self.nn_has(r.ident) {
                rok = true
              }
            }
            if lok {
              return rok
            }
            return false
          }
        }
      }
      if val.op == tk_plus() || val.op == tk_minus() {
        if l = val.left {
          if r = val.right {
            lok = false
            if l.kind == ex_int() {
              lok = true
            } else if l.kind == ex_name() {
              if self.nn_has(l.ident) {
                lok = true
              }
              if str_eq(l.ident, selfname) {
                if self.nn_has(selfname) {
                  lok = true
                }
              }
            }
            rok = false
            if r.kind == ex_int() {
              rok = true
            } else if r.kind == ex_name() {
              if self.nn_has(r.ident) {
                rok = true
              }
            }
            if val.op == tk_minus() {
              if r.kind == ex_int() {
                return lok
              }
              return false
            }
            if lok {
              return rok
            }
          }
        }
      }
    }
    false
  }

  pub fn fact_after_stmt(stmt: Stmt) {
    if stmt.kind == st_assign() {
      if t = stmt.target {
        if t.kind == ex_name() {
          v = t.ident
          self.kill_facts_for(v)
          if val = stmt.value {
            if self.value_is_nonneg(val, v) {
              self.nn_add(v)
            } else {
              self.nn_remove(v)
            }
            sv_done = false
            if val.kind == ex_field() {
              if str_eq(val.ident, "size") {
                if obj = val.object {
                  if obj.kind == ex_name() {
                    self.sv_put(v, obj.ident)
                    sv_done = true
                  }
                }
              }
            }
            if val.kind == ex_array_new() {
              if sz = val.size_expr {
                if sz.kind == ex_name() {
                  self.sv_put(sz.ident, v)
                  self.cs_put(v, sz.ident, 0)
                  sv_done = true
                } else if sz.kind == ex_binary() {
                  if sz.op == tk_plus() || sz.op == tk_minus() {
                    if sl2 = sz.left {
                      if sr2 = sz.right {
                        if sl2.kind == ex_name() {
                          if self.lit_small(sr2) {
                            d = sr2.int_bits.to_i
                            if sz.op == tk_minus() {
                              d = 0 - d
                            }
                            self.cs_put(v, sl2.ident, d)
                          }
                        }
                        if sr2.kind == ex_name() {
                          if self.lit_small(sl2) {
                            if sz.op == tk_plus() {
                              self.cs_put(v, sr2.ident, sl2.int_bits.to_i)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            if sv_done {
            } else {
              self.sv_remove_var(v)
            }
            bc = self.bound_cont_of(val)
            if bc.size > 0 {
              self.bv_put(v, bc, self.bound_delta_of(val))
            } else {
              self.bv_remove_var(v)
            }
          }
        }
      }
    }
    i = 0
    while i < self.fact_var.size {
      if self.fact_live[i] == 1 {
        if self.deep_shrinks_stmt(stmt, self.fact_cont[i]) {
          self.fact_live[i] = 0
        }
      }
      i = i + 1
    }
  }

  pub fn deep_shrinks_stmt(s: Stmt, cont: String): Bool {
    if s.kind == st_assign() {
      if t = s.target {
        if t.kind == ex_name() {
          if str_eq(t.ident, cont) {
            return true
          }
        }
      }
    }
    if e = s.expr {
      if self.deep_shrinks_expr(e, cont) {
        return true
      }
    }
    if c = s.cond {
      if self.deep_shrinks_expr(c, cont) {
        return true
      }
    }
    if t = s.target {
      if self.deep_shrinks_expr(t, cont) {
        return true
      }
    }
    if v = s.value {
      if self.deep_shrinks_expr(v, cont) {
        return true
      }
    }
    i = 0
    while i < s.then_body.size {
      if self.deep_shrinks_stmt(s.then_body[i], cont) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < s.else_body.size {
      if self.deep_shrinks_stmt(s.else_body[i], cont) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < s.body.size {
      if self.deep_shrinks_stmt(s.body[i], cont) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn deep_shrinks_expr(e: Expr, cont: String): Bool {
    if e.kind == ex_call() {
      if str_eq(e.callee, "pop") || str_eq(e.callee, "clear") {
        if recv = e.receiver {
          if str_eq(self.expr_root_name(recv), cont) {
            return true
          }
        }
      }
    }
    if inner = e.inner {
      if self.deep_shrinks_expr(inner, cont) {
        return true
      }
    }
    if l = e.left {
      if self.deep_shrinks_expr(l, cont) {
        return true
      }
    }
    if r = e.right {
      if self.deep_shrinks_expr(r, cont) {
        return true
      }
    }
    if obj = e.object {
      if self.deep_shrinks_expr(obj, cont) {
        return true
      }
    }
    if recv = e.receiver {
      if self.deep_shrinks_expr(recv, cont) {
        return true
      }
    }
    i = 0
    while i < e.args.size {
      if self.deep_shrinks_expr(e.args[i], cont) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < e.elems.size {
      if self.deep_shrinks_expr(e.elems[i], cont) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < e.field_exprs.size {
      if self.deep_shrinks_expr(e.field_exprs[i], cont) {
        return true
      }
      i = i + 1
    }
    if sz = e.size_expr {
      if self.deep_shrinks_expr(sz, cont) {
        return true
      }
    }
    if c = e.cond {
      if self.deep_shrinks_expr(c, cont) {
        return true
      }
    }
    if b = e.block {
      j = 0
      while j < b.body.size {
        if self.deep_shrinks_stmt(b.body[j], cont) {
          return true
        }
        j = j + 1
      }
    }
    i = 0
    while i < e.cases.size {
      cs = e.cases[i]
      j = 0
      while j < cs.body.size {
        if self.deep_shrinks_stmt(cs.body[j], cont) {
          return true
        }
        j = j + 1
      }
      i = i + 1
    }
    i = 0
    while i < e.else_body.size {
      if self.deep_shrinks_stmt(e.else_body[i], cont) {
        return true
      }
      i = i + 1
    }
    i = 0
    while i < e.parts.size {
      part = e.parts[i]
      if inner = part.expr {
        if self.deep_shrinks_expr(inner, cont) {
          return true
        }
      }
      i = i + 1
    }
    false
  }

  pub fn step_is_nonneg(v: Expr): Bool {
    if v.kind == ex_int() {
      return true
    }
    if v.kind == ex_name() {
      return self.nn_has(v.ident)
    }
    false
  }

  pub fn deep_ivar_ok_stmt(s: Stmt, ivar: String): Bool {
    if s.kind == st_assign() {
      if t = s.target {
        if t.kind == ex_name() {
          if str_eq(t.ident, ivar) {
            if s.op == tk_plus_eq() {
              if v = s.value {
                if self.step_is_nonneg(v) {
                  return self.deep_ivar_ok_rest(s, ivar)
                }
              }
              return false
            }
            if s.op == tk_eq() {
              if v = s.value {
                if v.kind == ex_binary() {
                  if v.op == tk_plus() {
                    if l = v.left {
                      if r = v.right {
                        if l.kind == ex_name() {
                          if str_eq(l.ident, ivar) {
                            if self.step_is_nonneg(r) {
                              return self.deep_ivar_ok_rest(s, ivar)
                            }
                          }
                        }
                        if r.kind == ex_name() {
                          if str_eq(r.ident, ivar) {
                            if self.step_is_nonneg(l) {
                              return self.deep_ivar_ok_rest(s, ivar)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              return false
            }
            return false
          }
        }
      }
    }
    self.deep_ivar_ok_rest(s, ivar)
  }

  pub fn deep_ivar_ok_rest(s: Stmt, ivar: String): Bool {
    if e = s.expr {
      if self.deep_ivar_ok_expr(e, ivar) {
      } else {
        return false
      }
    }
    if c = s.cond {
      if self.deep_ivar_ok_expr(c, ivar) {
      } else {
        return false
      }
    }
    if v = s.value {
      if self.deep_ivar_ok_expr(v, ivar) {
      } else {
        return false
      }
    }
    i = 0
    while i < s.then_body.size {
      if self.deep_ivar_ok_stmt(s.then_body[i], ivar) {
      } else {
        return false
      }
      i = i + 1
    }
    i = 0
    while i < s.else_body.size {
      if self.deep_ivar_ok_stmt(s.else_body[i], ivar) {
      } else {
        return false
      }
      i = i + 1
    }
    i = 0
    while i < s.body.size {
      if self.deep_ivar_ok_stmt(s.body[i], ivar) {
      } else {
        return false
      }
      i = i + 1
    }
    true
  }

  pub fn deep_ivar_ok_expr(e: Expr, ivar: String): Bool {
    if inner = e.inner {
      if self.deep_ivar_ok_expr(inner, ivar) {
      } else {
        return false
      }
    }
    if l = e.left {
      if self.deep_ivar_ok_expr(l, ivar) {
      } else {
        return false
      }
    }
    if r = e.right {
      if self.deep_ivar_ok_expr(r, ivar) {
      } else {
        return false
      }
    }
    if obj = e.object {
      if self.deep_ivar_ok_expr(obj, ivar) {
      } else {
        return false
      }
    }
    if recv = e.receiver {
      if self.deep_ivar_ok_expr(recv, ivar) {
      } else {
        return false
      }
    }
    i = 0
    while i < e.args.size {
      if self.deep_ivar_ok_expr(e.args[i], ivar) {
      } else {
        return false
      }
      i = i + 1
    }
    i = 0
    while i < e.elems.size {
      if self.deep_ivar_ok_expr(e.elems[i], ivar) {
      } else {
        return false
      }
      i = i + 1
    }
    i = 0
    while i < e.field_exprs.size {
      if self.deep_ivar_ok_expr(e.field_exprs[i], ivar) {
      } else {
        return false
      }
      i = i + 1
    }
    if sz = e.size_expr {
      if self.deep_ivar_ok_expr(sz, ivar) {
      } else {
        return false
      }
    }
    if c = e.cond {
      if self.deep_ivar_ok_expr(c, ivar) {
      } else {
        return false
      }
    }
    if b = e.block {
      j = 0
      while j < b.body.size {
        if self.deep_ivar_ok_stmt(b.body[j], ivar) {
        } else {
          return false
        }
        j = j + 1
      }
    }
    i = 0
    while i < e.cases.size {
      cs = e.cases[i]
      j = 0
      while j < cs.body.size {
        if self.deep_ivar_ok_stmt(cs.body[j], ivar) {
        } else {
          return false
        }
        j = j + 1
      }
      i = i + 1
    }
    i = 0
    while i < e.else_body.size {
      if self.deep_ivar_ok_stmt(e.else_body[i], ivar) {
      } else {
        return false
      }
      i = i + 1
    }
    true
  }

  pub fn body_ivar_ok(body: Array(Stmt), ivar: String): Bool {
    i = 0
    while i < body.size {
      if self.deep_ivar_ok_stmt(body[i], ivar) {
      } else {
        return false
      }
      i = i + 1
    }
    true
  }

  pub fn body_shrinks(body: Array(Stmt), cont: String): Bool {
    i = 0
    while i < body.size {
      if self.deep_shrinks_stmt(body[i], cont) {
        return true
      }
      i = i + 1
    }
    false
  }

  pub fn collect_cond_nn(e: Expr, into: Array(String)) {
    if e.kind == ex_binary() {
      if e.op == tk_amp_amp() {
        if l = e.left {
          self.collect_cond_nn(l, into)
        }
        if r = e.right {
          self.collect_cond_nn(r, into)
        }
        return
      }
      if e.op == 47 {
        if l = e.left {
          if r = e.right {
            if l.kind == ex_name() {
              if r.kind == ex_int() {
                if r.int_bits == 0u64 {
                  into.push(l.ident)
                }
              }
            }
          }
        }
      }
      if e.op == tk_less_eq() {
        if l = e.left {
          if r = e.right {
            if r.kind == ex_name() {
              if l.kind == ex_int() {
                if l.int_bits == 0u64 {
                  into.push(r.ident)
                }
              }
            }
          }
        }
      }
    }
  }

  pub fn fact_from_cond(e: Expr, body: Array(Stmt), nnl: Array(String)) {
    if e.kind != ex_binary() {
      return
    }
    if e.op == tk_amp_amp() {
      if l = e.left {
        self.fact_from_cond(l, body, nnl)
      }
      if r = e.right {
        self.fact_from_cond(r, body, nnl)
      }
      return
    }
    ivar = ""
    bound: Expr? = nil
    slack = 0
    is_le = false
    if e.op == tk_less() {
      if l = e.left {
        if l.kind == ex_name() {
          ivar = l.ident
          if r = e.right {
            bound = r
          }
        }
      }
    } else if e.op == tk_less_eq() {
      is_le = true
      if l = e.left {
        if l.kind == ex_name() {
          ivar = l.ident
          if r = e.right {
            bound = r
          }
        }
      }
    } else if e.op == 47 {
      if r = e.right {
        if r.kind == ex_name() {
          ivar = r.ident
          if l = e.left {
            bound = l
          }
        }
      }
    } else if e.op == 48 {
      is_le = true
      if r = e.right {
        if r.kind == ex_name() {
          ivar = r.ident
          if l = e.left {
            bound = l
          }
        }
      }
    } else {
      return
    }
    if ivar.size == 0 {
      return
    }
    if b = bound {
      cont = self.bound_cont_of(b)
      if cont.size == 0 {
        if is_le {
          return
        }
        nonneg2 = false
        if self.nn_has(ivar) {
          nonneg2 = true
        }
        if str_index(nnl, ivar) >= 0 {
          nonneg2 = true
        }
        if nonneg2 {
        } else {
          return
        }
        if self.body_ivar_ok(body, ivar) {
          self.fact_var.push(ivar)
          self.fact_cont.push("")
          self.fact_slack.push(0)
          self.fact_live.push(1)
        }
        return
      }
      delta = self.bound_delta_of(b)
      if is_le {
        slack = (0 - delta) - 1
      } else {
        slack = 0 - delta
      }
      if slack < 0 {
        return
      }
      direct = false
      if b.kind == ex_field() {
        direct = true
      }
      nonneg = false
      if self.nn_has(ivar) {
        nonneg = true
      }
      if str_index(nnl, ivar) >= 0 {
        nonneg = true
      }
      if nonneg {
      } else {
        return
      }
      if direct {
      } else {
        if self.body_shrinks(body, cont) {
          return
        }
      }
      if self.body_ivar_ok(body, ivar) {
        self.fact_var.push(ivar)
        self.fact_cont.push(cont)
        self.fact_slack.push(slack)
        self.fact_live.push(1)
      }
    }
  }

  pub fn push_loop_facts(cond: Expr, body: Array(Stmt)) {
    nnl: Array(String) = []
    self.collect_cond_nn(cond, nnl)
    self.fact_from_cond(cond, body, nnl)
  }

  pub fn pop_loop_facts(saved: Int) {
    while self.fact_var.size > saved {
      dropped_s = self.fact_var.pop
      dropped_c = self.fact_cont.pop
      dropped_k = self.fact_slack.pop
      dropped_l = self.fact_live.pop
    }
  }

  pub fn note_spawn_capture(expr: Expr, node: Expr, seen: Hash(String, Int)) {
    if self.spawn_skip_has(expr.ident) {
      return
    }
    if self.place_depth > 0 {
      if str_eq(expr.ident, self.place_name) {
        self.fail(expr.loc, "mutex place cannot escape")
        return
      }
    }
    if ty = self.lookup(expr.ident) {
      if self.copyable_for_spawn(ty) {
      } else {
        self.fail(expr.loc, "spawn cannot capture ${expr.ident}: ${ty.show} is not copied at send (D35)")
        return
      }
      if prev = seen.get(expr.ident) {
        return
      }
      seen[expr.ident] = 1
      node.cap_names.push(expr.ident)
      node.cap_tys.push(ty)
    }
  }

