        self.fail(expr.args[0].loc, "reserve expects Int")
      }
      return self.t_void()
    }
    self.fail(expr.loc, "no method ${expr.callee} on Array")
    self.t_int()
  }

  pub fn check_hash_method(expr: Expr, hash: Ty): Ty {
    if str_eq(expr.callee, "get") {
      if expr.args.size == 1 {
