pub fn is_op_fn_name(name: String): Bool {
  if str_eq(name, "&+") {
    return true
  }
  if str_eq(name, "&-") {
    return true
  }
  if str_eq(name, "&*") {
    return true
  }
  if str_eq(name, "+") {
    return true
  }
  if str_eq(name, "-") {
    return true
  }
  if str_eq(name, "*") {
    return true
  }
  if str_eq(name, "/") {
    return true
  }
  if str_eq(name, "%") {
    return true
  }
  if str_eq(name, "==") {
    return true
  }
  if str_eq(name, "!=") {
    return true
  }
  if str_eq(name, "<") {
    return true
  }
  if str_eq(name, "<=") {
    return true
  }
  if str_eq(name, ">") {
    return true
  }
  if str_eq(name, ">=") {
    return true
  }
  false
}

pub fn binary_op_method_name(op: Int): String {
  fn_op_name(op)
}

pub fn ty_to_type_name(ty: Ty, loc: Location): TypeName {
  if ty.is_union {
    if ty.is_nilable {
      inner = ty_without_nil(ty)
      tn = ty_to_type_name(inner, loc)
      if tn.nilable {
      } else {
        tn.nilable = true
      }
      return tn
    }
    out = TypeName.new(loc, "")
    i = 0
    while i < ty.members.size {
      out.members.push(ty_to_type_name(ty.members[i], loc))
      i = i + 1
    }
    return out
  }
  k = ty.kind
  if k == tyk_int() {
    return TypeName.new(loc, "Int")
  }
  if k == tyk_int64() {
    return TypeName.new(loc, "Int64")
  }
  if k == tyk_uint64() {
    return TypeName.new(loc, "UInt64")
  }
  if k == tyk_bool() {
    return TypeName.new(loc, "Bool")
  }
  if k == tyk_float() {
    return TypeName.new(loc, "Float64")
  }
  if k == tyk_string() {
    return TypeName.new(loc, "String")
  }
  if k == tyk_buf() {
    return TypeName.new(loc, "Buf")
  }
  if k == tyk_bytes() {
    return TypeName.new(loc, "Bytes")
  }
  if k == tyk_nil() {
    return TypeName.new(loc, "Nil")
  }
  if k == tyk_void() {
    return TypeName.new(loc, "Void")
  }
  if k == tyk_array() {
    tn = TypeName.new(loc, "Array")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_hash() {
    tn = TypeName.new(loc, "Hash")
    if ke = ty.key {
      tn.args.push(ty_to_type_name(ke, loc))
    }
    if va = ty.val {
      tn.args.push(ty_to_type_name(va, loc))
    }
    return tn
  }
  if k == tyk_ptr() {
    tn = TypeName.new(loc, "Ptr")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_join() {
    tn = TypeName.new(loc, "JoinHandle")
    if e = ty.inner {
      tn.args.push(ty_to_type_name(e, loc))
    }
    return tn
  }
  if k == tyk_fn() {
    tn = TypeName.new(loc, "")
    tn.fn_type = true
    i = 0
    while i < ty.members.size {
      tn.args.push(ty_to_type_name(ty.members[i], loc))
      i = i + 1
    }
    if r = ty.inner {
      if r.is_void {
      } else {
        tn.ret = ty_to_type_name(r, loc)
      }
    }
    return tn
  }
  TypeName.new(loc, ty.name)
}

