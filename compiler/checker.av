      if e = array.inner {
        if e.is_int {
        } else {
          self.fail(expr.loc, "Array.fill is Int-only")
        }
      }
      got = self.check_expr_as(expr.args[0], self.t_int())
      if got.is_int {
      } else {
        self.fail(expr.args[0].loc, "fill expects Int")
      }
      return self.t_void()
    }
    if str_eq(expr.callee, "reserve") {
      if b = expr.block {
