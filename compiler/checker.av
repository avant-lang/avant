  pub fn check_join(expr: Expr, handle: Ty): Ty {
    if str_eq(expr.callee, "join") {
    } else {
      self.fail(expr.loc, "no method ${expr.callee} on JoinHandle")
      if inner = handle.inner {
        return inner
      }
      return self.t_int()
    }
    if expr.args.size == 0 {
      if b = expr.block {
        self.fail(expr.loc, "join takes no arguments")
      }
    } else {
      self.fail(expr.loc, "join takes no arguments")
    }
    if inner = handle.inner {
      return inner
    }
    self.t_int()
  }

  pub fn check_switch_branch(body: Array(Stmt), has_want: Bool, want: Ty): Ty {
    self.push_scope
    if body.size == 0 {
      self.pop_scope
      return self.t_void()
    }
    i = 0
    while i < body.size {
      stmt = body[i]
      if i == body.size - 1 {
        if stmt.kind == st_expr() {
          if e = stmt.expr {
            use_want = false
            use_ty = self.t_int()
            if has_want {
              if want.is_void {
              } else {
                use_want = true
                use_ty = want
              }
            }
            ty = self.check_expr_flag(e, use_want, use_ty)
            self.pop_scope
            return ty
          }
        }
        self.check_stmt(stmt, self.t_void(), false)
        self.pop_scope
        return self.t_void()
      }
      self.check_stmt(stmt, self.t_void(), false)
      i = i + 1
    }
    self.pop_scope
    self.t_void()
  }
}
