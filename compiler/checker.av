    } else {
      self.fail(expr.loc, "${expr.callee} takes one String")
      return ret
    }
    got = self.check_expr_as(expr.args[0], self.t_string())
    if ty_assignable(got, self.t_string()) {
    } else {
      self.fail(expr.args[0].loc, "${expr.callee} expects String")
    }
    ret
  }

