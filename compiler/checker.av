  pub fn check_parallel(expr: Expr, array: Ty): Ty {
    if self.in_task > 0 {
      self.fail(expr.loc, "parallel inside a pool worker")
      return ty_array(self.t_int())
    }
    if b = expr.block {
      if expr.args.size == 0 {
      } else {
        self.fail(expr.loc, "parallel takes a block, not arguments")
        return ty_array(self.t_int())
      }
      if b.params.size == 1 {
      } else {
        self.fail(b.loc, "parallel { |x| ... } takes one block parameter")
        return ty_array(self.t_int())
      }
      if e = array.inner {
        self.push_scope
        self.bind(b.params[0], e)
        self.in_task = self.in_task + 1
        result = self.check_block_value(b)
        self.in_task = self.in_task - 1
        self.pop_scope
        self.collect_spawn_captures(expr, b.body)
        return ty_array(result)
      }
      self.fail(expr.loc, "parallel needs an element type")
      return ty_array(self.t_int())
    }
    self.fail(expr.loc, "parallel needs a block")
    ty_array(self.t_int())
  }

