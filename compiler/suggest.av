// "Did you mean": the one mechanism behind every suggestion the compiler
// offers for a name it cannot find (Stage 29 W5c1, O257, O340): types,
// names, functions, fields, methods, enum members, case labels and
// type-level functions. The caller offers the names in scope at the
// place of the error, each with its rank (its place in the order a name
// is resolved there: a local before a field before a method before a
// constant before a function); the nearest one within the bound is the
// suggestion, at most one, and only from what was offered.
//
// The distance is the edit distance in half steps: inserting, deleting
// or replacing a letter is two, swapping two neighbours is two, changing
// only a letter's case is one (so `string` is nearest `String`). The bound is the type rule of Stage 29
// W3a: at most a third of the name's length in whole steps, rounded up,
// and at least one (`cuont` -> `count`, `Strng` -> `String`), and less
// than the whole name: a suggestion keeps a letter of what was written,
// so a one-letter name gets only a change of case (`n` is not "did you
// mean `e`"). A tie goes to the smaller distance in
// half steps, then the lower rank, then the name first in byte order, so
// the result never depends on the order a table is walked in.
//
// The cost is paid only by a compile that fails: the checker asks for a
// suggestion only when it reports the error, a candidate whose length
// differs from the name's by more than the bound is skipped without the
// distance, and the distance itself is one row of the table at a time.

pub class Suggest {
  pub name: String = ""
  best: String = ""
  best_half: Int = 0
  best_rank: Int = 0
  limit: Int = 0
  // The distance's three rows, kept across candidates: a failed compile
  // offers thousands of names, and fresh rows for each were megabytes.
  row2: Array(Int) = []
  row1: Array(Int) = []
  row0: Array(Int) = []

  fn initialize(name: String) {
    self.name = name
    b = name.size / 3
    if b < 1 {
      b = 1
    }
    self.limit = b
    self.best = ""
    self.best_half = 2 * b + 1
    self.best_rank = 0
  }

  // Consider cand, a name in scope, with its rank.
  pub fn offer(cand: String, rank: Int) {
    if cand.size == 0 || cand == self.name {
      return
    }
    // A compiler-made name (`__avant_error_text`) is never in scope for
    // the programmer.
    if cand.size >= 2 && cand[0] == 95 && cand[1] == 95 {
      return
    }
    diff = cand.size - self.name.size
    if diff < 0 {
      diff = -diff
    }
    if diff > self.limit {
      return
    }
    h = distance(cand)
    if h >= 2 * self.limit + 1 || h >= 2 * self.name.size {
      return
    }
    better = false
    if h < self.best_half {
      better = true
    } else if h == self.best_half {
      if self.best.size == 0 || rank < self.best_rank {
        better = true
      } else if rank == self.best_rank && bytes_before(cand, self.best) {
        better = true
      }
    }
    if better {
      self.best = cand
      self.best_half = h
      self.best_rank = rank
    }
  }

  // Whether cand's length lets it be near: the caller's cheap test before
  // the work of finding out whether cand is in scope.
  pub fn could(cand: String): Bool {
    diff = cand.size - self.name.size
    if diff < 0 {
      diff = -diff
    }
    diff <= self.limit
  }

  // Each name of a space-separated list, with one rank.
  pub fn offer_list(names: String, rank: Int) {
    start = 0
    i = 0
    while i <= names.size {
      if i == names.size || names[i] == 32 {
        if i > start {
          offer(str_slice(names, start, i), rank)
        }
        start = i + 1
      }
      i += 1
    }
  }

  // name_distance_half(self.name, cand), in the kept rows.
  pub fn distance(cand: String): Int {
    half_distance_in(self.name, cand, self.row2, self.row1, self.row0)
  }

  pub fn found: String {
    self.best
  }

  // " (did you mean `count`?)", or "" when nothing offered is near.
  pub fn hint: String {
    if self.best.size == 0 {
      return ""
    }
    " (did you mean `${self.best}`?)"
  }
}

// The builtin type names, for a type's suggestion.
pub fn builtin_type_names: String {
  "Int Int32 UInt32 UInt64 Bool Float64 String Array Hash Buf Bytes Ptr Void Nil"
}

// Whether a sorts before b, byte by byte.
pub fn bytes_before(a: String, b: String): Bool {
  n = a.size
  if b.size < n {
    n = b.size
  }
  for i in 0..n {
    if a[i] != b[i] {
      return a[i] < b[i]
    }
  }
  a.size < b.size
}

// Edit distance between two names in half steps: a letter inserted,
// deleted or replaced is two, two neighbours swapped are two (`cuont`,
// `widht`: the commonest slip of the fingers), a letter whose case alone
// differs is one. Three rows of the table are kept.
pub fn name_distance_half(a: String, b: String): Int {
  r2: Array(Int) = []
  r1: Array(Int) = []
  r0: Array(Int) = []
  half_distance_in(a, b, r2, r1, r0)
}

// The distance with three rows the caller provides (their contents are
// overwritten; their storage is reused).
pub fn half_distance_in(a: String, b: String, r2: Array(Int), r1: Array(Int), r0: Array(Int)): Int {
  prev2 = r2
  prev = r1
  cur = r0
  prev2.clear
  prev.clear
  for j in 0..b.size + 1 {
    prev.push(j * 2)
    prev2.push(j * 2)
  }
  for i in 1..a.size + 1 {
    cur.clear
    cur.push(i * 2)
    for j in 1..b.size + 1 {
      x = a[i - 1]
      y = b[j - 1]
      cost = 2
      if x == y {
        cost = 0
      } else if (x >= 65 && x <= 90 && y == x + 32) || (y >= 65 && y <= 90 && x == y + 32) {
        cost = 1
      }
      best = prev[j - 1] + cost
      if prev[j] + 2 < best {
        best = prev[j] + 2
      }
      if cur[j - 1] + 2 < best {
        best = cur[j - 1] + 2
      }
      if i > 1 && j > 1 && x != y && x == b[j - 2] && a[i - 2] == y && prev2[j - 2] + 2 < best {
        best = prev2[j - 2] + 2
      }
      cur.push(best)
    }
    t = prev2
    prev2 = prev
    prev = cur
    cur = t
  }
  prev[b.size]
}

// The same distance in whole steps, rounded up.
pub fn name_distance(a: String, b: String): Int {
  (name_distance_half(a, b) + 1) / 2
}
