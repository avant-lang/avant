pub fn (checker_self: Checker) note_modules {
  checker_self.root_module = checker_self.program.root_module
  checker_self.current_module = checker_self.root_module
  km = Hash(String, Int).new
  i = 0
  while i < checker_self.program.mods.size {
    info = checker_self.program.mods[i]
    km[info.name] = 1
    j = 0
    while j < info.imports.size {
      km[info.imports[j]] = 1
      j = j + 1
    }
    i = i + 1
  }
  checker_self.known_mods = km
  tm = Hash(String, String).new
  tv = Hash(String, Int).new
  checker_self.type_mod = tm
  checker_self.type_vis = tv
  tlist = Hash(String, String).new
  checker_self.type_list = tlist
  tmulti = Hash(String, Int).new
  checker_self.type_multi = tmulti
  i = 0
  while i < checker_self.program.structs.size {
    sdef = checker_self.program.structs[i]
    checker_self.remember_type(sdef.name, sdef.mod_name, sdef.vis)
    i = i + 1
  }
  i = 0
  while i < checker_self.program.classes.size {
    cdef = checker_self.program.classes[i]
    checker_self.remember_type(cdef.name, cdef.mod_name, cdef.vis)
    i = i + 1
  }
  i = 0
  while i < checker_self.program.interfaces.size {
    idef = checker_self.program.interfaces[i]
    checker_self.remember_type(idef.name, idef.mod_name, idef.vis)
    i = i + 1
  }
  i = 0
  while i < checker_self.program.libs.size {
    lib_def = checker_self.program.libs[i]
    j = 0
    while j < lib_def.layouts.size {
      lay = lib_def.layouts[j]
      checker_self.remember_type(lay.name, lib_def.mod_name, lib_def.vis)
      j = j + 1
    }
    i = i + 1
  }
}

pub fn type_slot(mod_name: String, name: String): String {
  "${mod_name}@@${name}"
}

pub fn (checker_self: Checker) remember_type(name: String, mod_name: String, vis: Bool) {
  slot = type_slot(mod_name, name)
  if prev = checker_self.type_mod.get(slot) {
    return
  }
  checker_self.type_mod[slot] = mod_name
  if vis {
    checker_self.type_vis[slot] = 1
  } else {
    checker_self.type_vis[slot] = 0
  }
  if listed = checker_self.type_list.get(name) {
    checker_self.type_list[name] = "${listed}\n${mod_name}"
    checker_self.type_multi[name] = 1
  } else {
    checker_self.type_list[name] = mod_name
    checker_self.type_mod[name] = mod_name
    if vis {
      checker_self.type_vis[name] = 1
    } else {
      checker_self.type_vis[name] = 0
    }
  }
}

pub fn (checker_self: Checker) mods_of_type(name: String): Array(String) {
  out: Array(String) = []
  if s = checker_self.type_list.get(name) {
    start = 0
    i = 0
    while i <= s.size {
      brk = false
      if i == s.size {
        brk = true
      } else {
        if s[i] == 10 {
          brk = true
        }
      }
      if brk {
        if i > start {
          out.push(str_slice(s, start, i))
        }
        start = i + 1
      }
      i = i + 1
    }
  }
  out
}

pub fn (checker_self: Checker) type_slot_visible(name: String, mod_name: String, from_mod: String): Bool {
  if str_eq(mod_name, from_mod) {
    return true
  }
  if v = checker_self.type_vis.get(type_slot(mod_name, name)) {
    if v == 1 {
      return checker_self.imported_by(from_mod, mod_name)
    }
  }
  false
}

pub fn (checker_self: Checker) imported_by(from_mod: String, target: String): Bool {
  if str_eq(from_mod, target) {
    return true
  }
  i = 0
  while i < checker_self.program.mods.size {
    info = checker_self.program.mods[i]
    if str_eq(info.name, from_mod) {
      j = 0
      while j < info.imports.size {
        if str_eq(info.imports[j], target) {
          return true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  false
}

pub fn (checker_self: Checker) qualifier_ok(qual: String, from_mod: String): Bool {
  if str_eq(qual, from_mod) {
    return true
  }
  checker_self.imported_by(from_mod, qual)
}

pub fn (checker_self: Checker) visible_type_mod(name: String, from_mod: String, qual: String): String {
  if qual.size > 0 {
    if o = checker_self.type_mod.get(type_slot(qual, name)) {
      if checker_self.qualifier_ok(qual, from_mod) {
        if checker_self.type_slot_visible(name, qual, from_mod) {
          return qual
        }
      }
    }
    return ""
  }
  owners = checker_self.mods_of_type(name)
  found = ""
  n = 0
  i = 0
  while i < owners.size {
    if checker_self.type_slot_visible(name, owners[i], from_mod) {
      n = n + 1
      found = owners[i]
    }
    i = i + 1
  }
  if n == 1 {
    return found
  }
  ""
}

pub fn (checker_self: Checker) type_is_visible(name: String, from_mod: String, qual: String): Bool {
  if checker_self.mods_of_type(name).size == 0 {
    return true
  }
  checker_self.visible_type_mod(name, from_mod, qual).size > 0
}

pub fn (checker_self: Checker) lib_is_visible(name: String, from_mod: String): Bool {
  owner = from_mod
  if o = checker_self.lib_mod.get(name) {
    owner = o
  }
  if str_eq(owner, from_mod) {
    return true
  }
  if v = checker_self.lib_vis.get(name) {
    if v == 1 {
      return checker_self.imported_by(from_mod, owner)
    }
  }
  false
}

pub fn (checker_self: Checker) fn_is_visible(fnn: Function, from_mod: String): Bool {
  if str_eq(fnn.mod_name, from_mod) {
    return true
  }
  if fnn.mod_name.size == 0 {
    return true
  }
  if from_mod.size == 0 {
    return true
  }
  if fnn.vis {
    return checker_self.imported_by(from_mod, fnn.mod_name)
  }
  false
}

pub fn (checker_self: Checker) method_is_visible(fnn: Function, from_mod: String): Bool {
  if fnn.vis {
    return true
  }
  if str_eq(fnn.name, "initialize") {
    return true
  }
  if str_eq(fnn.mod_name, from_mod) {
    return true
  }
  if fnn.mod_name.size == 0 {
    return true
  }
  if from_mod.size == 0 {
    return true
  }
  false
}

pub fn (checker_self: Checker) clash_unqualified(name: String, from_mod: String): Bool {
  origins: Array(String) = []
  type_mods = checker_self.mods_of_type(name)
  ti = 0
  while ti < type_mods.size {
    if checker_self.type_slot_visible(name, type_mods[ti], from_mod) {
      origins.push("type:${type_mods[ti]}")
    }
    ti = ti + 1
  }
  if id = checker_self.lib_names.get(name) {
    if checker_self.lib_is_visible(name, from_mod) {
      owner = from_mod
      if o = checker_self.lib_mod.get(name) {
        owner = o
      }
      origins.push("lib:${owner}")
    }
  }
  fn_mods = Hash(String, Int).new
  i = 1
  while i < checker_self.functions.size {
    sig = checker_self.functions[i]
    if str_eq(sig.name, name) {
      if checker_self.fn_is_visible(sig.node, from_mod) {
        if seen = fn_mods.get(sig.node.mod_name) {
        } else {
          fn_mods[sig.node.mod_name] = 1
          origins.push("fn:${sig.node.mod_name}")
        }
      }
    }
    i = i + 1
  }
  owner_count = 0
  has_type = false
  has_fn = false
  i = 0
  while i < origins.size {
    o = origins[i]
    if o.size >= 5 {
      if str_eq(str_slice(o, 0, 5), "type:") {
        owner_count = owner_count + 1
        has_type = true
      } else if str_eq(str_slice(o, 0, 4), "lib:") {
        owner_count = owner_count + 1
        has_type = true
      } else if str_eq(str_slice(o, 0, 3), "fn:") {
        has_fn = true
      }
    }
    i = i + 1
  }
  if owner_count > 1 {
    return true
  }
  if owner_count >= 1 {
    if has_fn {
      return true
    }
  }
  false
}

pub fn (checker_self: Checker) lookup_named_type(name: String, loc: Location, qual: String): Ty? {
  if checker_self.clash_unqualified(name, checker_self.current_module) {
    if qual.size == 0 {
      checker_self.fail(loc, "ambiguous name ${name}; qualify it")
      return nil
    }
  }
  owner = checker_self.visible_type_mod(name, checker_self.current_module, qual)
  if owner.size > 0 {
    if ty = checker_self.resolver.get_named_in(owner, name) {
      return ty
    }
  }
  if ty = checker_self.resolver.get_named(name) {
    if checker_self.type_is_visible(name, checker_self.current_module, qual) {
      return ty
    }
  }
  if qual.size > 0 {
    checker_self.fail(loc, "unknown type ${qual}.${name}")
  } else {
    checker_self.fail(loc, "unknown type ${name}")
  }
  nil
}

pub fn (checker_self: Checker) resolve_in_module(tn: TypeName): Ty {
  if tn.mod_name.size > 0 {
    if checker_self.qualifier_ok(tn.mod_name, checker_self.current_module) {
    } else {
      checker_self.fail(tn.loc, "unknown module ${tn.mod_name}")
      return checker_self.t_int()
    }
    owners = checker_self.mods_of_type(tn.name)
    if owners.size > 0 {
      if checker_self.type_is_visible(tn.name, checker_self.current_module, tn.mod_name) {
      } else {
        checker_self.fail(tn.loc, "unknown type ${tn.mod_name}.${tn.name}")
        return checker_self.t_int()
      }
    }
  } else {
    owners = checker_self.mods_of_type(tn.name)
    if owners.size > 0 {
      if checker_self.clash_unqualified(tn.name, checker_self.current_module) {
        checker_self.fail(tn.loc, "ambiguous name ${tn.name}; qualify it")
        return checker_self.t_int()
      }
      if checker_self.type_is_visible(tn.name, checker_self.current_module, "") {
      } else {
        checker_self.fail(tn.loc, "unknown type ${tn.name}")
        return checker_self.t_int()
      }
      if flag = checker_self.type_multi.get(tn.name) {
        owner = checker_self.visible_type_mod(tn.name, checker_self.current_module, "")
        use = TypeName.new(tn.loc, tn.name)
        use.mod_name = owner
        use.nilable = tn.nilable
        use.fn_type = tn.fn_type
        use.args = tn.args
        use.members = tn.members
        use.bounds = tn.bounds
        use.ret = tn.ret
        return checker_self.resolver.resolve(use)
      }
    }
  }
  checker_self.resolver.resolve(tn)
}

pub fn (checker_self: Checker) resolve_value_in_module(tn: TypeName): Ty {
  if tn.mod_name.size > 0 {
    if checker_self.qualifier_ok(tn.mod_name, checker_self.current_module) {
    } else {
      checker_self.fail(tn.loc, "unknown module ${tn.mod_name}")
      return checker_self.t_int()
    }
  } else {
    if named = checker_self.resolver.get_named(tn.name) {
      if checker_self.type_is_visible(tn.name, checker_self.current_module, "") {
      } else {
        checker_self.fail(tn.loc, "unknown type ${tn.name}")
        return checker_self.t_int()
      }
      if checker_self.clash_unqualified(tn.name, checker_self.current_module) {
        checker_self.fail(tn.loc, "ambiguous name ${tn.name}; qualify it")
        return checker_self.t_int()
      }
    }
  }
  checker_self.resolver.resolve_value(tn)
}

pub fn (checker_self: Checker) ensure_pub_sig_ty(ty: Ty, loc: Location, fnn: Function) {
  if fnn.vis {
  } else {
    return
  }
  if ty.is_agg {
    owner = fnn.mod_name
    if ty.mod_name.size > 0 {
      owner = ty.mod_name
    } else {
      if o = checker_self.type_mod.get(ty.name) {
        owner = o
      }
    }
    if str_eq(owner, fnn.mod_name) {
    } else {
      vis = 0
      if flag = checker_self.type_vis.get(type_slot(owner, ty.name)) {
        vis = flag
      } else {
        if flag2 = checker_self.type_vis.get(ty.name) {
          vis = flag2
        }
      }
      if vis == 1 {
      } else {
        checker_self.fail(loc, "pub signature cannot use private type ${ty.name}")
      }
    }
    return
  }
  if ty.is_array {
    if elem = ty.inner {
      checker_self.ensure_pub_sig_ty(elem, loc, fnn)
    }
    return
  }
  if ty.is_hash {
    if hk = ty.key {
      checker_self.ensure_pub_sig_ty(hk, loc, fnn)
    }
    if hv = ty.val {
      checker_self.ensure_pub_sig_ty(hv, loc, fnn)
    }
    return
  }
  if ty.is_ptr {
    if inner = ty.inner {
      checker_self.ensure_pub_sig_ty(inner, loc, fnn)
    }
    return
  }
  if ty.is_clayout {
    owner = fnn.mod_name
    if ty.mod_name.size > 0 {
      owner = ty.mod_name
    } else {
      if o = checker_self.type_mod.get(ty.name) {
        owner = o
      }
    }
    if str_eq(owner, fnn.mod_name) {
    } else {
      vis = 0
      if flag = checker_self.type_vis.get(type_slot(owner, ty.name)) {
        vis = flag
      } else {
        if flag2 = checker_self.type_vis.get(ty.name) {
          vis = flag2
        }
      }
      if vis == 1 {
      } else {
        checker_self.fail(loc, "pub signature cannot use private type ${ty.name}")
      }
    }
    return
  }
  if ty.is_join {
    if jin = ty.inner {
      checker_self.ensure_pub_sig_ty(jin, loc, fnn)
    }
    return
  }
  if ty.is_union {
    i = 0
    while i < ty.members.size {
      checker_self.ensure_pub_sig_ty(ty.members[i], loc, fnn)
      i = i + 1
    }
    return
  }
  if ty.is_fn {
    i = 0
    while i < ty.members.size {
      checker_self.ensure_pub_sig_ty(ty.members[i], loc, fnn)
      i = i + 1
    }
    if r = ty.inner {
      checker_self.ensure_pub_sig_ty(r, loc, fnn)
    }
  }
}

pub fn (checker_self: Checker) lookup_module_type(mod: String, name: String, loc: Location): Ty? {
  if ty = checker_self.resolver.get_named_in(mod, name) {
    if checker_self.type_is_visible(name, checker_self.current_module, mod) {
      return ty
    }
  }
  checker_self.fail(loc, "unknown type ${mod}.${name}")
  nil
}

pub fn (checker_self: Checker) type_from_recv(recv: Expr, loc: Location): Ty? {
  if recv.kind == ex_name() {
    return checker_self.lookup_named_type(recv.ident, recv.loc, "")
  }
  if recv.kind == ex_field() {
    if obj = recv.object {
      object = checker_self.check_expr(obj)
      if object.is_module {
      } else {
        checker_self.fail(loc, "new is a type constructor")
        return nil
      }
      return checker_self.lookup_module_type(object.name, recv.ident, recv.loc)
    }
  }
  checker_self.fail(loc, "new is a type constructor")
  nil
}

pub fn (checker_self: Checker) dispatch_qualified_call(expr: Expr, mod: String): Ty {
  if str_eq(expr.callee, "new") {
    checker_self.fail(expr.loc, "new is a type constructor")
    return checker_self.t_int()
  }
  saved = checker_self.current_module
  arg_tys: Array(Ty) = []
  i = 0
  while i < expr.args.size {
    arg_tys.push(checker_self.check_expr(expr.args[i]))
    i = i + 1
  }
  checker_self.current_module = mod
  none: Ty? = nil
  if sig = checker_self.match_func(expr.callee, arg_tys, none, expr.loc) {
    if str_eq(sig.node.mod_name, mod) {
    } else {
      checker_self.fail(expr.loc, "unknown function ${mod}.${expr.callee}")
      checker_self.current_module = saved
      return checker_self.t_int()
    }
    checker_self.fill_defaults(expr, sig.node)
    i = 0
    while i < expr.args.size {
      got = checker_self.t_int()
      if i < arg_tys.size {
        got = arg_tys[i]
      } else {
        got = checker_self.check_expr_as(expr.args[i], sig.params[i])
      }
      got = checker_self.fit_call_arg(expr.args[i], got, sig.params[i])
      if ty_assignable(got, sig.params[i]) {
      } else {
        n = i + 1
        checker_self.fail(expr.args[i].loc, "argument ${n} of ${expr.callee} is ${got.show}, expected ${sig.params[i].show}")
      }
      i = i + 1
    }
    expr.resolved = sig.node.emit_name
    expr.receiver = nil
    checker_self.current_module = saved
    return sig.ret
  }
  checker_self.current_module = saved
  checker_self.t_int()
}
